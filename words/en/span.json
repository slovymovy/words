                },
                {
                    "sense_id": "0ca33cca-68de-3a48-8100-6db8f0f72315",
                    "sense_definition": "The full extent of something from end to end, or the distance between two supports of a structure like a bridge or arch.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "distance_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The central <w>span</w> of the bridge collapsed during the severe storm.",
                            "target_lang_translations": {
                                "ru": "Центральный <w>пролёт</w> моста обрушился во время сильного шторма.",
                                "zh": "那座桥的中央<w>桥跨</w>在猛烈的暴风雨中坍塌了。",
                                "nl": "De centrale <w>overspanning</w> van de brug stortte in tijdens de zware storm."
                            }
                        },
                        {
                            "text": "The eagle has an impressive wing <w>span</w> of over two meters.",
                            "target_lang_translations": {
                                "ru": "У орла внушительный <w>размах</w> крыльев — более двух метров.",
                                "zh": "那只老鹰的<w>翼展</w>超过两米，十分惊人。",
                                "nl": "De adelaar heeft een indrukwekkende <w>spanwijdte</w> van meer dan twee meter."
                            }
                        }
                    ],
                    "synonyms": [
                        "width",
                        "breadth",
                        "reach",
                        "extent"
                    ],
                    "common_phrases": [
                        "wing span",
                        "bridge span",
                        "clear span"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полная протяженность чего-либо от края до края или расстояние между двумя опорами конструкции, например моста или арки.",
                        "zh": "某物从一端到另一端的全部长度，或桥梁、拱等结构两个支撑点之间的距离。",
                        "nl": "De volledige afstand van het ene uiteinde naar het andere, of de overspanning tussen twee steunpunten van een brug of boog."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пролёт",
                                "target_lang_sense_clarification": "моста или конструкции"
                            },
                            {
                                "target_lang_word": "размах",
                                "target_lang_sense_clarification": "крыльев или рук"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "桥跨",
                                "target_lang_sense_clarification": "桥梁、拱形结构等两端支撑之间的部分"
                            },
                            {
                                "target_lang_word": "跨度",
                                "target_lang_sense_clarification": "从一端到另一端的宽度或距离"
                            },
                            {
                                "target_lang_word": "翼展",
                                "target_lang_sense_clarification": "专指翅膀展开时两端之间的距离"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "overspanning",
                                "target_lang_sense_clarification": "van een brug of constructie"
                            },
                            {
                                "target_lang_word": "wijdte",
                                "target_lang_sense_clarification": "van vleugels, spanwijdte"
                            },
                            {
                                "target_lang_word": "spanwijdte",
                                "target_lang_sense_clarification": "breedte van vleugels of bogen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "214dfdd9-ed5c-3937-a9ac-2f3c0cd437af",
                    "sense_definition": "The width of an open hand from the tip of the thumb to the tip of the little finger, used as a rough unit of measurement.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "distance_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He estimated the length of the fish to be about one <w>span</w>.",
                            "target_lang_translations": {
                                "ru": "Он оценил длину рыбы примерно в одну <w>пядь</w>.",
                                "zh": "他估计那条鱼大约有一<w>拃</w>长。",
                                "nl": "Hij schatte de lengte van de vis op ongeveer één <w>span</w>."
                            }
                        },
                        {
                            "text": "The table was only a <w>span</w> wide, making it useless for dinner.",
                            "target_lang_translations": {
                                "ru": "Стол был шириной всего в <w>пядь</w>, что делало его бесполезным для обеда.",
                                "zh": "这张桌子只有一<w>拃</w>宽，根本没法用来吃饭。",
                                "nl": "De tafel was maar een <w>span</w> breed, waardoor hij nutteloos was voor het diner."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "measurement unit"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ширина раскрытой ладони от кончика большого пальца до кончика мизинца, используемая как приблизительная мера длины.",
                        "zh": "张开手掌时，从拇指尖到小指尖的宽度，用作一种粗略的长度单位。",
                        "nl": "De afstand tussen de toppen van de duim en de pink van een gespreide hand, gebruikt als oude lengtemaat."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пядь",
                                "target_lang_sense_clarification": "старинная мера длины"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拃",
                                "target_lang_sense_clarification": "张开手掌时从拇指尖到小指尖的大致长度单位，较旧或口语化"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "span",
                                "target_lang_sense_clarification": "oude lengtemaat (gespreide hand)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "da4b0cfd-ab47-387e-9ff4-a34a9f770299",
                    "sense_definition": "The set of all linear combinations of vectors within a specific set.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "math_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>span</w> of these two vectors forms a plane in three-dimensional space.",
                            "target_lang_translations": {
                                "ru": "<w>Линейная оболочка</w> этих двух векторов образует плоскость в трехмерном пространстве.",
                                "zh": "这两个向量的<w>张成</w>在三维空间中构成一个平面。",
                                "nl": "Het <w>lineair opspansel</w> van deze twee vectoren vormt een vlak in de driedimensionale ruimte."
                            }
                        },
                        {
                            "text": "Students learned how to calculate the linear <w>span</w> of the set.",
                            "target_lang_translations": {
                                "ru": "Студенты учились вычислять линейную <w>оболочку</w> множества.",
                                "zh": "学生们学习了如何计算这个集合的线性<w>张成</w>。",
                                "nl": "Studenten leerden hoe ze het lineaire <w>opspansel</w> van de verzameling moesten berekenen."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Множество всех линейных комбинаций векторов из определенного набора.",
                        "zh": "数学上指由某组向量的所有线性组合构成的集合。",
                        "nl": "De verzameling van alle lineaire combinaties van een stel vectoren."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "линейная оболочка",
                                "target_lang_sense_clarification": "математический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "张成",
                                "target_lang_sense_clarification": "数学中指一组向量所有线性组合构成的集合"
                            },
                            {
                                "target_lang_word": "线性张成",
                                "target_lang_sense_clarification": "更完整的数学说法"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "lineair opspansel",
                                "target_lang_sense_clarification": "wiskundige term"
                            },
                            {
                                "target_lang_word": "opspansel",
                                "target_lang_sense_clarification": "wiskunde"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f65ad101-a229-330b-9017-93878fa94f3a",
                    "sense_definition": "To extend across a distance or connect two sides of something.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "space_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A magnificent suspension bridge <w>spans</w> the river near the city.",
                            "target_lang_translations": {
                                "ru": "Великолепный подвесной мост <w>пересекает</w> реку недалеко от города.",
                                "zh": "一座宏伟的悬索桥<w>横跨</w>城市附近的河流。",
                                "nl": "Een prachtige hangbrug <w>overspant</w> de rivier nabij de stad."
                            }
                        },
                        {
                            "text": "Her influence <w>spanned</w> the globe during the height of her career.",
                            "target_lang_translations": {
                                "ru": "Ее влияние <w>охватывало</w> весь земной шар в разгар ее карьеры.",
                                "zh": "在她事业的巅峰时期，她的影响力<w>遍及</w>全球。",
                                "nl": "Haar invloed <w>omspande</w> de hele wereld tijdens het hoogtepunt van haar carrière."
                            }
                        }
                    ],
                    "synonyms": [
                        "cross",
                        "bridge",
                        "traverse"
                    ],
                    "common_phrases": [
                        "span the river",
                        "span the globe"
                    ],
                    "target_lang_definitions": {
                        "ru": "Простираться на определенное расстояние или соединять две стороны чего-либо.",
                        "zh": "跨越一段距离，或把某物的两边连接起来。",
                        "nl": "Zich over een bepaalde afstand uitstrekken of twee zijden met elkaar verbinden."
                    },
