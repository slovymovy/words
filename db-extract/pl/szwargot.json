                        "source_sense_id": "7c3c9035-6d39-3891-a704-01b68a809fce",
                        "target_lang_word": "gibberish",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gibberish",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6db09de8-cd6c-365d-adfa-4d0e69d8a1ff",
                                        "entry_id": "37130845-ab67-3688-8b79-5514fb5da0d4",
                                        "glosses": [
                                            "Speech or writing that is unintelligible, incoherent or meaningless."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "236e72dd-cdab-46b6-92ef-5495b18039bb",
                                                "sense_id": "6db09de8-cd6c-365d-adfa-4d0e69d8a1ff",
                                                "text": "Such gibberish as children may be heard amusing themselves with."
                                            },
                                            {
                                                "example_id": "3a12d1b1-8755-4ea4-81f5-8273d4f8bd71",
                                                "sense_id": "6db09de8-cd6c-365d-adfa-4d0e69d8a1ff",
                                                "text": "Could it be, after all, that the whole story was true, and the writing on the sherd was not a forgery, or the invention of some crack-brained, long-forgotten individual? And if so, could it be that Leo was the man that She was waiting for - the dead man who was to be born again! Impossible! The whole thing was gibberish! Who ever heard of a man being born again?"
                                            },
                                            {
                                                "example_id": "5bc7ed63-c3c3-4db3-bc7b-c622ec3637db",
                                                "sense_id": "6db09de8-cd6c-365d-adfa-4d0e69d8a1ff",
                                                "text": "The Game of Thrones novels were best sellers without fleshed-out Dothraki; the languages in Star Wars, one of the most successful franchises ever, are mostly gibberish, even if Han Solo claims to understand Chewbacca’s bestial warbling."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8dcd9d6-33e9-31f0-964d-0c31a0712d11",
                                        "entry_id": "37130845-ab67-3688-8b79-5514fb5da0d4",
                                        "glosses": [
                                            "Needlessly obscure or overly technical language."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8e09070b-c4fe-3abe-9dd7-63a90f473bf7",
                                        "entry_id": "37130845-ab67-3688-8b79-5514fb5da0d4",
                                        "glosses": [
                                            "A language game, comparable to pig Latin, in which one inserts a nonsense syllable before the first vowel in each syllable of a word."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
