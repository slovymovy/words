        "fr-extract.jsonl": [
            {
                "entry_id": "b59bcb3b-faf6-3589-bc31-294d3d38f4e0",
                "word": "communément",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "cb4ce31a-1b78-3035-a37e-36a0736e68d5",
                        "entry_id": "b59bcb3b-faf6-3589-bc31-294d3d38f4e0",
                        "glosses": [
                            "Le plus ordinairement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "588199c8-721d-4e97-a52c-6b03f09e7cee",
                                "sense_id": "cb4ce31a-1b78-3035-a37e-36a0736e68d5",
                                "text": "On les trouve communément dans les rues."
                            },
                            {
                                "example_id": "69c9d627-7f46-4a37-a1cf-ab07388d1df2",
                                "sense_id": "cb4ce31a-1b78-3035-a37e-36a0736e68d5",
                                "text": "L'oxalide petite oseille, oxalis acetosella, Lin., porte vulgairement les noms de surette, alléluia, etc. Elle croit assez communément dans les bois et les lieux couverts de presque toute la France."
                            }
                        ]
                    },
                    {
                        "sense_id": "710cdd7e-8d3f-3a4d-9388-4a97cc8eb7e0",
                        "entry_id": "b59bcb3b-faf6-3589-bc31-294d3d38f4e0",
                        "glosses": [
                            "D’après l’usage commun."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ac5be6b-5804-4a93-879a-ed01e115de93",
                                "sense_id": "710cdd7e-8d3f-3a4d-9388-4a97cc8eb7e0",
                                "text": "La psychorigidité forme un couple bien assorti avec l’égocentrisme qui peut se définir comme un rapport privilégié, voire univoque à soi, à ses préoccupations, différent de ce que l'on entend communément par égoïsme."
                            },
                            {
                                "example_id": "b1aaaa44-538f-452e-a028-835fd8418c15",
                                "sense_id": "710cdd7e-8d3f-3a4d-9388-4a97cc8eb7e0",
                                "text": "Ces dépenses injustifiées et excessives sont communément appelées, reprenant ainsi le terme de la jurisprudence des juridictions du contentieux de la tarification, abusives."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e2b1bd0e-915c-43f4-8e4d-2c1786bb2922",
                        "source_entry_id": "b59bcb3b-faf6-3589-bc31-294d3d38f4e0",
                        "source_sense_id": "cb4ce31a-1b78-3035-a37e-36a0736e68d5",
                        "source_sense_description": "Le plus ordinairement.",
                        "target_lang_word": "gewöhnlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gewöhnlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d90e5ab9-0a36-35e1-973f-6ba68f210cf6",
                                        "entry_id": "d64866d2-e272-357d-aea8-9062249b5f69",
                                        "glosses": [
                                            "so, wie unter diesen Umständen meist oder immer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73cc8492-2ee0-4285-b949-487c64a94afa",
                                                "sense_id": "d90e5ab9-0a36-35e1-973f-6ba68f210cf6",
                                                "text": "Sie antwortete wie gewöhnlich."
                                            },
                                            {
                                                "example_id": "4b933060-adcc-45a2-9f3f-100af430f620",
                                                "sense_id": "d90e5ab9-0a36-35e1-973f-6ba68f210cf6",
                                                "text": "Für gewöhnlich sind sie pünktlich."
                                            },
                                            {
                                                "example_id": "ff0e8436-8d02-4b12-b2a3-b4d4f45e846d",
                                                "sense_id": "d90e5ab9-0a36-35e1-973f-6ba68f210cf6",
                                                "text": "Das ist ein für eine Mutter ganz gewöhnliches Verhalten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4c1b6de5-e564-3994-bb36-33df2746ea3a",
                                        "entry_id": "d64866d2-e272-357d-aea8-9062249b5f69",
                                        "glosses": [
                                            "keine besonderen Merkmale aufweisend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d429e30e-a582-450e-8487-c0737079b56d",
                                                "sense_id": "4c1b6de5-e564-3994-bb36-33df2746ea3a",
                                                "text": "Wir alle sind gewöhnliche Sterbliche."
                                            },
                                            {
                                                "example_id": "1e2a1a3a-3c38-4563-a88d-a12abe3c3e0a",
                                                "sense_id": "4c1b6de5-e564-3994-bb36-33df2746ea3a",
                                                "text": "Wie kann aus einem ganz gewöhnlichen Menschen plötzlich ein Verbrecher werden?"
                                            },
                                            {
                                                "example_id": "ce71aafb-f960-437f-9e03-a8a53156196b",
                                                "sense_id": "4c1b6de5-e564-3994-bb36-33df2746ea3a",
                                                "text": "„Schließlich waren die Richter des Athener Gerichts, der Heliaia ebenso wie die Teilnehmer an der Volksversammlung keine Rechtsexperten, sondern gewöhnliche Bürger.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "31287f72-57d0-3dfa-9237-a9cff7619999",
                                        "entry_id": "d64866d2-e272-357d-aea8-9062249b5f69",
                                        "glosses": [
                                            "von niederer Erziehung seiend"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c3e45ea-74df-413e-b214-62f71fff0413",
                                                "sense_id": "31287f72-57d0-3dfa-9237-a9cff7619999",
                                                "text": "Das Benehmen dieses Kerls ist mir zu gewöhnlich (= zu unfein, grob)."
                                            },
                                            {
                                                "example_id": "860e7544-33e3-442d-a3ed-bf581b6eb6f4",
                                                "sense_id": "31287f72-57d0-3dfa-9237-a9cff7619999",
                                                "text": "Er hat gar zu gewöhnliche Manieren."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5e62add3-6e03-4603-b9f0-fa1061c8aff5",
                        "source_entry_id": "b59bcb3b-faf6-3589-bc31-294d3d38f4e0",
