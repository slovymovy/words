                "senses": [
                    {
                        "sense_id": "01b8ab1e-afe9-3b9f-b55f-9f57b6764db3",
                        "entry_id": "bf89fa90-7a6b-3bb4-90b3-60643799c686",
                        "glosses": [
                            "nichtwissenschaftliche Diagnostik, die auf unsystematische, punktuelle Beobachtung und subjektive Beurteilung beruht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a406260-0a50-4d8f-9703-c882179dd22b",
                                "sense_id": "01b8ab1e-afe9-3b9f-b55f-9f57b6764db3",
                                "text": "„Der Alltagsdiagnostik steht die formelle Diagnostik des Psychologen gegenüber, die u.a. dadurch gekennzeichnet ist, dass die angewendeten Verfahren bestimmte Gütekriterien erfüllen.“"
                            },
                            {
                                "example_id": "2b3e058f-3d8e-4940-8687-87c7a17546f4",
                                "sense_id": "01b8ab1e-afe9-3b9f-b55f-9f57b6764db3",
                                "text": "„Fehlende Objektivität, z.B. durch Beobachtungsfehler, ist einer der Faktoren, die Alltagsdiagnostik problematisch machen […].“"
                            },
                            {
                                "example_id": "0e4751b5-3c89-44ac-85ef-73dcd9dc00a1",
                                "sense_id": "01b8ab1e-afe9-3b9f-b55f-9f57b6764db3",
                                "text": "„Für eine ökonomische Alltagsdiagnostik wäre es wünschenswert, dass Diagnosespiele für einzelne Kinder weiter entwickelt würden zu Verfahren, die eine differenzierte Sprachbeobachtung in Gruppen ermöglichen.“"
                            },
                            {
                                "example_id": "8c4bdba4-1a51-4e8e-8919-8932f55e1dd9",
                                "sense_id": "01b8ab1e-afe9-3b9f-b55f-9f57b6764db3",
                                "text": "„Die Qualität dieser Alltagsdiagnostik wird in empirischen Studien unterschiedlich bewertet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
