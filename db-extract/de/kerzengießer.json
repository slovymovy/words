                                        "entry_id": "633c86e0-6a85-316c-9164-22d152cb1de7",
                                        "glosses": [
                                            "Artisan qui travaille en cire, qui fait et vend toutes sortes de cierges et de bougies."
                                        ],
                                        "tags": [
                                            "Métier"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ded85631-a758-42fd-86de-d19850933fba",
                                                "sense_id": "b8d51a6d-76fd-3577-8477-a4535b7cc7db",
                                                "text": "Sylvain Brevot, maître cirier à Auribeau-sur-Siagne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de721923-a566-39dd-afd9-547c66fdeffa",
                                        "entry_id": "633c86e0-6a85-316c-9164-22d152cb1de7",
                                        "glosses": [
                                            "Artiste plasticien qui travaille en cire."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd0e06c5-e155-45c3-8991-542f35405338",
                                                "sense_id": "de721923-a566-39dd-afd9-547c66fdeffa",
                                                "text": "Le Musée Grévin a une grâce à vous demander. Notre artiste cirier a besoin de vous voir pour le coloris de votre visage, chose à laquelle j’attache une extrême importance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "881c224f-10da-397b-9b88-8b8d6092c862",
                                        "entry_id": "633c86e0-6a85-316c-9164-22d152cb1de7",
                                        "glosses": [
                                            "Nom vernaculaire de divers arbres qui produisent une cire présentant l’aspect de la cire des abeilles."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07b1a196-57c3-4bcc-89a2-81350ae369d1",
                                                "sense_id": "881c224f-10da-397b-9b88-8b8d6092c862",
                                                "text": "Le Myrica cerifera d’Amérique du Sud est aussi appelé cirier."
                                            }
                                        ]
                                    }
