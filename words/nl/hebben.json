                                "target_lang_word": "supporter",
                                "target_lang_sense_clarification": "endurer ou tolérer"
                            },
                            {
                                "target_lang_word": "tolérer",
                                "target_lang_sense_clarification": "accepter patiemment"
                            }
                        ]
                    }
                },
