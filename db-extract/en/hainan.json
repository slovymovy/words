    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "91d41db6-7cc7-3e4d-9a89-e0f3303f38c3",
                "word": "Hainan",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c1d96e36-d7d2-3269-82a0-11cb80f6f55f",
                        "entry_id": "91d41db6-7cc7-3e4d-9a89-e0f3303f38c3",
                        "glosses": [
                            "A province off the coast of southern China, primarily made up of Hainan Island. Capital: Haikou."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62b0f513-b7a2-42d5-ae8f-1212e16048eb",
                                "sense_id": "c1d96e36-d7d2-3269-82a0-11cb80f6f55f",
                                "text": "These were a business family, in Hainan province, who, along with other South China merchants, had interests in America, where the multitude of little shops and businesses owned by Chinese had assumed the appearance of a department store chain, representing the invested outlay of controlling families in the Orient."
                            },
                            {
                                "example_id": "5965cac3-e956-4eb9-b551-a7706251fa6f",
                                "sense_id": "c1d96e36-d7d2-3269-82a0-11cb80f6f55f",
                                "text": "After Hainan separated from Guangdong to become its own province in 1988, a development boom was quickly followed by a bust that left many building projects on the island half-finished. In the last few years, Hainan has welcomed back investors and become a fashionable draw for Russian tourists looking to escape winter — entire blocks in Sanya have signs lettered in Russian for their benefit."
                            },
                            {
                                "example_id": "33232fe7-735e-4348-a6c8-f4c9c4c1950e",
                                "sense_id": "c1d96e36-d7d2-3269-82a0-11cb80f6f55f",
                                "text": "The Tianzhou-4 spacecraft was slung into space atop a Long March-7 Y5 rocket at 1:56 a.m. from the Wenchang Launch Base in the southern island province of Hainan. State media said it docked with the station about seven hours later."
                            }
                        ]
                    },
                    {
                        "sense_id": "6f2b75e5-719e-3a3f-a11f-7bd56fb72dde",
                        "entry_id": "91d41db6-7cc7-3e4d-9a89-e0f3303f38c3",
                        "glosses": [
                            "An island off the coast of southern China."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2007d8f-9654-404b-b79a-daf35dc5beae",
                                "sense_id": "6f2b75e5-719e-3a3f-a11f-7bd56fb72dde",
                                "text": "Near to the Iſland Hainan are caught Whales,after the ſame manner as the Hollanders and Engliſh in the North about Greenland, whereof they make Oyl which ſerves for ſeveral uſes."
                            },
                            {
                                "example_id": "c7d9ff88-f699-4d5a-add5-91a6da289330",
                                "sense_id": "6f2b75e5-719e-3a3f-a11f-7bd56fb72dde",
                                "text": "KIungcheufu lies on an Iſland, generally call'd Hainan, or is rather the Iſland it ſelf ; Hainan ſignifies, To the South of the Sea, for Nan denotes South, and Hai, The Sea."
                            },
                            {
                                "example_id": "931fb05a-2fd2-4772-9dfd-51a344ec649e",
                                "sense_id": "6f2b75e5-719e-3a3f-a11f-7bd56fb72dde",
                                "text": "Several thousand retired servicemen on Hainan Island demonstrated against Teng Hsiao-ping's economic policies last month at the instigation of Hsu Shih-yu, deputy chairman of the Chinese Communist Party's Central Advisory Committee and a standing member of the party's Military Affairs Commission, according to an official report intercepted by the Republic of China's intelligence workers on the mainland."
                            },
                            {
                                "example_id": "717237cc-2c84-4906-acd9-56de223238a4",
                                "sense_id": "6f2b75e5-719e-3a3f-a11f-7bd56fb72dde",
                                "text": "On April 1, 2001, an American surveillance plane known as an EP-3 collided with a Chinese aircraft and made an emergency landing on Hainan Island. The Chinese pilot ejected from the cockpit and died. Our twenty-four-person crew was held at a military barracks on the island and interrogated. The Iranian hostage crisis was at the forefront of my mind. This was not the way I wanted to start my relationship with China."
                            }
                        ]
                    },
                    {
                        "sense_id": "213cb14d-1a4a-355a-ba3a-6cec4d885c7b",
                        "entry_id": "91d41db6-7cc7-3e4d-9a89-e0f3303f38c3",
                        "glosses": [
                            "A Tibetan autonomous prefecture of Qinghai, China. Official name: Hainan Tibetan Autonomous Prefecture."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3015bc12-ec1d-4d80-b795-3ab2a43bb986",
                                "sense_id": "213cb14d-1a4a-355a-ba3a-6cec4d885c7b",
                                "text": "China Central Television reported that the quake, centered in the Hainan Tibetan Autonomous Prefecture of Qinghai province, left 5,000 people homeless. Hundreds of people slept on the ground, wrapped in heavy blankets to ward off cold."
                            }
                        ]
                    },
                    {
                        "sense_id": "13c8b557-ffdd-3d62-a42a-15dba3e0132f",
                        "entry_id": "91d41db6-7cc7-3e4d-9a89-e0f3303f38c3",
                        "glosses": [
                            "A district of Wuhai, Inner Mongolia autonomous region, China."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c18c6f86-737e-4bf2-af4b-21da1a28c818",
                                "sense_id": "13c8b557-ffdd-3d62-a42a-15dba3e0132f",
                                "text": "Public tops play a crucial role in discovering cover-ups. For example, on 19 August 2011, the Changfu Coal Mine in Hainan District, Wuhai City, Inner Mongolia, flooded. Fearing that the mine would be closed and penalized, the mine managers organized a rescue effort by themselves and did not report the case to any relevant authorities. On 20 August, at 9:16 a.m., citizens called the police hotline of Wuhai City to report the accident."
                            }
                        ]
                    }
                ],
