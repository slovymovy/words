                        "sense_id": "6beee2cb-9ada-36cc-bcdc-d5659458a070",
                        "entry_id": "bfc624ac-9bef-3d8f-8022-767ca21c588a",
                        "glosses": [
                            "A prefecture-level city, the provincial capital of Anhui, in central China."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1fdfaaa3-23d9-4d06-bbad-73a8237eeb97",
                                "sense_id": "6beee2cb-9ada-36cc-bcdc-d5659458a070",
                                "text": "Some 10,000 people took the streets in the eastern city of Hefei this week in what appears to have been the largest student demonstration since the Tiananmen Square human rights protests of 1989."
                            },
                            {
                                "example_id": "db6bbef6-942a-4d53-b80d-9a0df0845d13",
                                "sense_id": "6beee2cb-9ada-36cc-bcdc-d5659458a070",
                                "text": "The other case, surnamed Zhang, was in close contact with Li during a training class Li led in the city of Luan, near Anhui's provincial capital Hefei, Xinhua reported.[…]\nTwo areas in Luan city and one part of Feixi county were declared \"medium-risk\" regions by local authorities in response to the cases. State media reported mass testing being carried out in main urban area in Luan and some areas in Hefei."
                            },
                            {
                                "example_id": "86f809c9-f936-49ed-9fa8-526c37bea52a",
                                "sense_id": "6beee2cb-9ada-36cc-bcdc-d5659458a070",
                                "text": "The vaccination campaign in the Luyang district of Hefei city is currently operating in an orderly and efficient manner, with all vaccination points running smoothly, thanks in large part to the effective utilization of A.I. technology."
                            }
                        ]
                    }
