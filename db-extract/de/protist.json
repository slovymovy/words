                                "target_senses": [
                                    {
                                        "sense_id": "11586a4b-34c9-3501-b61d-fc473e4a6a5a",
                                        "entry_id": "457605a5-34f0-30a0-ae00-1068c687bac7",
                                        "glosses": [
                                            "Any of the eukaryotic, usually unicellular organisms—including protozoans, slime molds and some algae—historically grouped into the kingdom Protista (or Protoctista), now distributed over several clades; any eukaryote that is not a plant, animal or fungus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5403ebb0-f250-4c68-a707-8f3b82e04485",
                                                "sense_id": "11586a4b-34c9-3501-b61d-fc473e4a6a5a",
                                                "text": "Besides the hundreds or thousands of metres of fungal mycelium in a teaspoon of healthy soil, there are more bacteria, protists, insects and arthropods than the number of humans who have ever lived on Earth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5defd918-41cb-3883-a7c3-8075b4719a15",
