                ],
                "translations": [
                    {
                        "translation_id": "fbc9ab45-ee12-412f-b381-5cd9c7005863",
                        "source_entry_id": "cb6c6673-cf92-3c18-a86a-d7f590a3122f",
                        "source_sense_id": "2c8e798b-da54-3a99-b378-04f5b4f755bf",
                        "source_sense_description": "bedoeld om in het oog te vallen, vaak op banale wijze",
                        "target_lang_word": "pretentious",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pretentious",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "46cd539f-e49f-317f-8fd0-966cbc4720a4",
                                        "entry_id": "a54f539a-6153-3622-8aa3-14add6393fee",
                                        "glosses": [
                                            "Motivated by an inappropriate, excessive, or unjustified desire to impress others."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a569c19b-599b-4012-9f0d-0f849692faa4",
                                                "sense_id": "46cd539f-e49f-317f-8fd0-966cbc4720a4",
                                                "text": "Her dress was obviously more pretentious than comfortable."
                                            },
                                            {
                                                "example_id": "c0487ad9-b8e1-4d5f-bd4e-f9114d9f91d9",
                                                "sense_id": "46cd539f-e49f-317f-8fd0-966cbc4720a4",
                                                "text": "I recall the height of comfort attained by the green-cushioned \"first\" with starched white antimacassars and a pretentious grey floor mat on which it seemed a sacrilege to stand, as it was embellished with the North Western conception of Britannia, complete with trident."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c6576c7-003b-3f98-ba9b-7dc95ff409f8",
                                        "entry_id": "a54f539a-6153-3622-8aa3-14add6393fee",
                                        "glosses": [
                                            "Marked by an unwarranted claim to importance or distinction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69ad8230-3ee1-43cc-81ba-286954219ed4",
                                                "sense_id": "1c6576c7-003b-3f98-ba9b-7dc95ff409f8",
                                                "text": "Their song titles are pretentious in the context of their basic lyrics."
                                            },
                                            {
                                                "example_id": "1325e290-00b5-4c76-9591-6a5023548eb7",
                                                "sense_id": "1c6576c7-003b-3f98-ba9b-7dc95ff409f8",
                                                "text": "The station (1840) was originally Cheltenham but the more grandiose Cheltenham Spa since 1925, which feels a bit pretentious as the town has never allowed itself to assume such airs and graces."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
