                                "target_senses": [
                                    {
                                        "sense_id": "fd00b0f4-2295-3e8c-9426-8b8bea1560b9",
                                        "entry_id": "a600cc7a-3a57-3c16-b7ab-11756d020b8b",
                                        "glosses": [
                                            "To fall asleep unintentionally."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20bc9509-3193-4de2-8890-391c1355def2",
                                                "sense_id": "fd00b0f4-2295-3e8c-9426-8b8bea1560b9",
                                                "text": "Therefore, what the train of the future must do is offer a comfortable and enjoyable experience in well-designed carriages that (for example) have pleasant lighting, have seats that align with windows, and which are comfortable enough so that you can doze off without having to call your oesteopath as soon as you wake up."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "doze off",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e0ed6d1b-7f51-341f-a02e-b147075d17df",
                                        "entry_id": "fbf3c36a-33a8-3775-be28-db566919ab12",
                                        "glosses": [
                                            "A short unintentional nap, an instance of dozing off."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "86ea29ac-3497-499d-8d64-292ef6e623d8",
                        "source_entry_id": "a72fa383-020e-3c17-a70a-7f8eccc15711",
                        "source_sense_id": "d72ef390-8262-3e9b-b23c-608840bce5cb",
