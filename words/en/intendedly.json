                    "sense_definition": "In an intended manner; intentionally.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "intention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The changes were <w>intendedly</w> subtle to avoid drawing too much attention from the public.",
                            "target_lang_translations": {
                                "ru": "Изменения были <w>намеренно</w> сделаны едва заметными, чтобы не привлекать лишнего внимания общественности."
                            }
                        },
                        {
                            "text": "He <w>intendedly</w> left the door unlocked so that his friend could enter the house easily.",
                            "target_lang_translations": {
                                "ru": "Он <w>специально</w> оставил дверь незапертой, чтобы его друг мог легко войти в дом."
                            }
                        }
                    ],
                    "synonyms": [
                        "intentionally",
                        "deliberately",
                        "purposely"
                    ],
                    "antonyms": [
                        "accidentally",
                        "unintentionally"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделанный намеренно, сознательно или специально."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "намеренно",
                                "target_lang_sense_clarification": "выражает осознанное действие с определенной целью"
                            },
                            {
                                "target_lang_word": "умышленно",
                                "target_lang_sense_clarification": "часто используется в контексте действий, имеющих последствия"
