                                        "entry_id": "a6277976-a984-39bd-bd17-7bb318c6da26",
                                        "glosses": [
                                            "To make a mess of; to untidy, disorder, soil, or muss."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "424790f5-310b-4889-9c11-5bc064490095",
                                                "sense_id": "7ec04e0a-5ce9-33e9-a861-16a1b76c813a",
                                                "text": "The afternoon breeze messed up my hair."
                                            },
                                            {
                                                "example_id": "9ad31905-d071-4fc5-a88d-3ad02f4e43be",
                                                "sense_id": "7ec04e0a-5ce9-33e9-a861-16a1b76c813a",
                                                "text": "[…] kwatumas, those aggressive and sharp-toothed eels that so thoroughly mess up one's tackle when hooked […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e58e2eaf-2a3a-3707-abfb-1e867e182e05",
                                        "entry_id": "a6277976-a984-39bd-bd17-7bb318c6da26",
                                        "glosses": [
                                            "To cause a problem with; to introduce an error or mistake in; to make muddled or confused; spoil; ruin."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7028202e-07fb-4832-a032-26337acfaa4d",
                                                "sense_id": "e58e2eaf-2a3a-3707-abfb-1e867e182e05",
                                                "text": "The change messed something up, and it's not working anymore."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c01664d-1230-3b78-a287-1607e3b928f3",
                                        "entry_id": "a6277976-a984-39bd-bd17-7bb318c6da26",
                                        "glosses": [
                                            "To botch, bungle; to perform poorly on."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1f6f05c-431d-46a5-8017-ab4721507bda",
                                                "sense_id": "7c01664d-1230-3b78-a287-1607e3b928f3",
                                                "text": "Well, I messed up my solo, but otherwise it was a good concert."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54056ac3-8a76-306f-a684-dcc5d2236030",
                                        "entry_id": "a6277976-a984-39bd-bd17-7bb318c6da26",
                                        "glosses": [
                                            "To make a mistake; to do something incorrectly; to perform poorly."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fea0b5e2-c421-405e-9fae-26571e99e2f3",
                                                "sense_id": "54056ac3-8a76-306f-a684-dcc5d2236030",
                                                "text": "She messed up on her final exam."
                                            },
                                            {
                                                "example_id": "f969f4be-8112-4d50-9f4f-30ad96333d4f",
                                                "sense_id": "54056ac3-8a76-306f-a684-dcc5d2236030",
                                                "text": "He has a hard time getting started because he's afraid he'll mess up."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93dc3ab5-bb5c-371b-bc60-e840ec1c18c2",
                                        "entry_id": "a6277976-a984-39bd-bd17-7bb318c6da26",
                                        "glosses": [
                                            "To cause (another person) to make unwanted mistakes in a given task, usually through distraction or obnoxious behavior."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79f80382-30ab-4268-b420-26ae615cd343",
                                                "sense_id": "93dc3ab5-bb5c-371b-bc60-e840ec1c18c2",
                                                "text": "Stop bumping me! You keep messing me up!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b7ffc95-c074-3336-b3cd-3b6e9e89def9",
                                        "entry_id": "a6277976-a984-39bd-bd17-7bb318c6da26",
                                        "glosses": [
                                            "To damage; injure."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26509552-ad85-44a5-b87e-5e5acdeae799",
                                                "sense_id": "6b7ffc95-c074-3336-b3cd-3b6e9e89def9",
                                                "text": "He messed up his elbow at the track meet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5544605-0159-3905-88ab-dc1c126b23bf",
                                        "entry_id": "a6277976-a984-39bd-bd17-7bb318c6da26",
                                        "glosses": [
                                            "To manhandle; beat up; rough up."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c70cf063-bf41-481f-8515-302362c58eb3",
                                                "sense_id": "f5544605-0159-3905-88ab-dc1c126b23bf",
                                                "text": "Her brother's friends messed him up a little after he cheated on her."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "466121f9-b29c-366e-89ca-650e37c94b93",
                                        "entry_id": "a6277976-a984-39bd-bd17-7bb318c6da26",
                                        "glosses": [
                                            "To discombobulate, utterly confuse, or confound psychologically; to throw into a state of mental disarray."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "afccd7bb-bd88-4b08-a046-2f487fe5facd",
                                                "sense_id": "466121f9-b29c-366e-89ca-650e37c94b93",
                                                "text": "That girl totally messed me up, man. I'm not sure who I am anymore."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4b73e1dc-5845-4f83-9879-bdeab02f24f5",
