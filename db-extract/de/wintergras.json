                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5354fe2d-921c-4d0c-9299-caf82d21f4b8",
                                "sense_id": "886ddee4-2ae4-380d-9498-0bb5302df84a",
                                "text": "„Nachmittags zogen sie durch ein üppiges Tal, wo das Wintergras den Pferden bis an den Bauch reichte.“"
                            },
                            {
                                "example_id": "59ee5c15-8a87-4d8c-b5ce-5239d7f5aefb",
                                "sense_id": "886ddee4-2ae4-380d-9498-0bb5302df84a",
                                "text": "„Er wurde immer menschenscheuer, schweigsamer, sprach nicht einmal mehr zu seiner Katze und wäre wahrscheinlich ohne Würde ins leblose Wintergras gesunken, wenn Margrét Lúna nicht im Traum erschienen wäre.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
