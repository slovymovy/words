                },
                {
                    "sense_id": "b97bec60-608f-3d7f-955a-7b4584b22040",
                    "sense_definition": "Quartier intégré à une ville qui constituait autrefois une zone périphérique hors de ses murs.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "espace_urbain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet ancien <w>faubourg</w> est devenu un quartier très animé et très prisé par les artistes."
                        },
                        {
                            "text": "Elle habite dans un vieux <w>faubourg</w> réputé pour ses ateliers d'artisans."
