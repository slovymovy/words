                "senses": [
                    {
                        "sense_id": "dcacae12-e56b-3176-a62d-2e5ce315036d",
                        "entry_id": "645be6f8-790e-3f6d-9289-614d059ac7e4",
                        "glosses": [
                            "hearth, fireplace or firepit"
                        ],
                        "tags": [
                            "neuter"
                        ],
                        "examples": [
                            {
                                "example_id": "411c3264-2979-4457-b6f1-d6c68110dc67",
                                "sense_id": "dcacae12-e56b-3176-a62d-2e5ce315036d",
                                "text": "[...] Heniuś wlazł na komin i o mały włos nie wpadł w gorejące palenisko.",
                                "translation": "...Heniuś climbed onto the chimney and nearly fell into the burning fireplace.",
                                "english": "...Heniuś climbed onto the chimney and nearly fell into the burning fireplace."
                            },
                            {
                                "example_id": "505df7e7-065d-4ef0-b396-57beb0e6e98d",
                                "sense_id": "dcacae12-e56b-3176-a62d-2e5ce315036d",
                                "text": "[...]na zewnątrz wykonano palenisko grillowe, które miało w przyszłości urozmaicić czas mieszkającym w budynku letnikom.",
                                "translation": "... outside, they built a firepit for grilling, which was meant to add variety to the time of vacationers living in the building in the future.",
                                "english": "... outside, they built a firepit for grilling, which was meant to add variety to the time of vacationers living in the building in the future."
                            },
                            {
                                "example_id": "e3d8288d-52f7-4245-8455-04bdac00e253",
                                "sense_id": "dcacae12-e56b-3176-a62d-2e5ce315036d",
                                "text": "[...] towarzyszący dowódcom wojowie rozłożyli więc niewielki obóz u stóp wzgórza, bracia zaś sami weszli na szczyt. Gdy go zdobyli, okazało się, że obawy Kraka nie były chybione. - Widzisz? - zawołał, rozglądając się wokół. - Niczego tu nie ma! Dawno wygasłe kamienne palenisko i uschły dąb rozszczepiony piorunem. Przybyliśmy tu na próżno.",
                                "translation": "...so the knights accompanying the leaders set up a small camp at the foot of the hill, while the brothers themselves went up to the peak. When they reached it, it turned out that Krak's fears had not been wrong. \"See?\" he shouted, looking around. \"There is nothing here! Just a long-dead stone firepit and a withered oak split by lightning. We came here for nothing.\"",
                                "english": "...so the knights accompanying the leaders set up a small camp at the foot of the hill, while the brothers themselves went up to the peak. When they reached it, it turned out that Krak's fears had not been wrong. \"See?\" he shouted, looking around. \"There is nothing here! Just a long-dead stone firepit and a withered oak split by lightning. We came here for nothing.\""
                            },
                            {
                                "example_id": "fe19c7a7-4b69-4859-9f95-0d4e153aac28",
                                "sense_id": "dcacae12-e56b-3176-a62d-2e5ce315036d",
                                "text": "Jeśli z komina unosi się gęsty dym, palenisko ma ściany pokryte sadzą, a przez szybę kominka nie widać ognia - to coś jest nie tak[...]",
                                "translation": "If thick smoke is rising from the chimney, the fireplace has its walls covered with soot, and you can't see the fire through the opening in the fireplace, then something is wrong...",
                                "english": "If thick smoke is rising from the chimney, the fireplace has its walls covered with soot, and you can't see the fire through the opening in the fireplace, then something is wrong..."
                            }
                        ]
                    },
                    {
                        "sense_id": "860a4a63-c31d-3b38-855b-d48bbc7e3f50",
                        "entry_id": "645be6f8-790e-3f6d-9289-614d059ac7e4",
