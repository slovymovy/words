                                            {
                                                "example_id": "d75953b0-c92b-42da-8fc8-e5d7e04f6c78",
                                                "sense_id": "8b60cc20-aee5-3eb9-856c-8ba933d66301",
                                                "text": "Gece yarısını geçmiş olmasına rağmen, hiç olmazsa, arkadaşım pekâlâ beni bekleyebilirdi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5cc5e16f-6252-33a4-b9db-1e55e0040853",
                                        "entry_id": "945d222e-a8b8-3e4f-a374-926d94ce8565",
                                        "glosses": [
                                            "gecenin ilerlemiş saatleri, gecenin ortası"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94db8ad9-30aa-487a-99fe-77047b6b8f7b",
                                                "sense_id": "5cc5e16f-6252-33a4-b9db-1e55e0040853",
                                                "text": "Çok soğuk bir gece yarısı köye varıyor, muhtarın evine iniyorduk."
                                            }
                                        ]
