                "translations": [
                    {
                        "translation_id": "de1d1c22-1025-4ca7-af8a-ed527c4a0de7",
                        "source_entry_id": "a4dbd7c2-460c-39d3-ac25-b541e4d261d2",
                        "source_sense_id": "6e1b4611-5cea-30ea-af24-e8d2745c8208",
                        "target_lang_word": "archiepiscopal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "archiepiscopal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e9afa575-f3e1-3b5d-aa8f-44efcdcb147e",
                                        "entry_id": "1c240e4f-498e-389d-9825-727ab6601534",
                                        "glosses": [
                                            "Of or relating to an archbishop or an archbishopric."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "923051f3-4018-476e-8783-b478c88b6c5f",
                                                "sense_id": "e9afa575-f3e1-3b5d-aa8f-44efcdcb147e",
                                                "text": "In 960 or 961, the notorious Dunstan entered our archiepiscopal chair, which he occupied till death called him to another world in 968."
                                            },
                                            {
                                                "example_id": "6f547328-d919-4ed3-8ecc-d2cb3dfc84b6",
                                                "sense_id": "e9afa575-f3e1-3b5d-aa8f-44efcdcb147e",
                                                "text": "This city and chair of Ailbe has been constantly understood by our old writers as that of Emly; but it is doubted whether it ought to be honoured with the title of an archiepiscopal see."
                                            },
                                            {
                                                "example_id": "7552bb2c-ec0d-457d-b8e0-26e9e4166fed",
                                                "sense_id": "e9afa575-f3e1-3b5d-aa8f-44efcdcb147e",
                                                "text": "It also determined an archiepiscopal and primatial hierarchy: two archiepiscopal provinces with metropolitan sees located at Armagh and at Cashel were recognised, under each of which there were to be twelve episcopal sees, with primacy accorded to Armagh."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "063451bf-1088-4a27-b250-f975122ba20b",
                        "source_entry_id": "a4dbd7c2-460c-39d3-ac25-b541e4d261d2",
                        "source_sense_id": "6e1b4611-5cea-30ea-af24-e8d2745c8208",
