                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The governess was hired to <w>manner</w> the unruly children.",
                            "target_lang_translations": {
                                "ru": "Гувернантку наняли, чтобы <w>научить манерам</w> непослушных детей.",
                                "tr": "Mürebbiye, söz dinlemeyen çocukları <w>terbiye etmek</w> için tutuldu."
                            }
                        },
                        {
                            "text": "Society attempts to <w>manner</w> us into acceptable citizens.",
