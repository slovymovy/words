                        "entry_id": "33b92850-957a-34b9-aa8a-363dbb98e045",
                        "glosses": [
                            "Maternité ou paternité en parlant de parents (en particulier adoptifs) dont l’un au moins est homosexuel ou bisexuel ou transgenre (altersexuel)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb193b74-7602-4e8b-b035-b03f0a743bce",
                                "sense_id": "8914a7d8-4520-37e5-96f7-45cf752cfe1e",
                                "text": "Des études portant sur l’homoparentalité ont la même qualité que les études portant sur l’adoption ou les enfants de parents divorcés."
                            },
                            {
                                "example_id": "648d80e6-90f8-4ebf-8a3b-32ef65da76f0",
                                "sense_id": "8914a7d8-4520-37e5-96f7-45cf752cfe1e",
                                "text": "Par ailleurs, je distingue homoparentalité adoptive et procréative."
                            }
                        ]
                    }
                ],
