                            {
                                "example_id": "c9e2488b-f3fb-48f9-85f6-631c3c007aef",
                                "sense_id": "90d27518-bdd0-3940-83ee-e14aaa0e0312",
                                "text": "Le terme de pixelisation a une connotation péjorative parce qu’on l’emploie à tort pour qualifier une image de basse résolution. Pourtant, quasiment toutes les images qui sont sur ordinateur sont pixelisées, c’est-à-dire représentées par des pixels."
                            },
                            {
                                "example_id": "978e8af0-42ec-4f07-8675-f9410bac471d",
                                "sense_id": "90d27518-bdd0-3940-83ee-e14aaa0e0312",
                                "text": "Le spécialiste en informatique du groupe était vêtu d’un tee-shirt représentant un vieil ordinateur au graphisme pixelisé."
                            }
                        ]
                    }
