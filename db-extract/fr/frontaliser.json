                "senses": [
                    {
                        "sense_id": "9f9f65f7-5824-3e38-83a2-8350e2065ab2",
                        "entry_id": "009e8a7a-1c93-3b2c-a433-3e5fadb4337c",
                        "glosses": [
                            "Donner un caractère frontal à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3ff867d-dd23-4f67-95ee-93104b7aec63",
                                "sense_id": "9f9f65f7-5824-3e38-83a2-8350e2065ab2",
                                "text": "Ils peuvent aider à reprendre l’abyssal, sans jamais frontaliser le processus, toujours en diagonale, en travers, en déplaçant avec insistance les possibilités et les prétextes de la relation « duelle » enseignante."
                            },
                            {
                                "example_id": "8913179d-aff5-42ff-9d9d-1ee7e3474746",
                                "sense_id": "9f9f65f7-5824-3e38-83a2-8350e2065ab2",
                                "text": "Ce plan a pour fonction d’articuler l’ensemble au lieu de présentation, de manière à frontaliser le point de vue du spectateur et à en orienter les déplacements."
                            }
                        ]
                    }
