                    },
                    {
                        "sense_id": "6acfb290-4843-3e29-b231-bf3d3d888fc5",
                        "entry_id": "194ad990-edcc-3eed-8fbe-c581e7915fd1",
                        "glosses": [
                            "комп.устар. то же, что браузер"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "234eedf5-3aae-485d-9789-4d1c8d331ccb",
                                "sense_id": "6acfb290-4843-3e29-b231-bf3d3d888fc5",
                                "text": "Обозреватель Internet Explorer встроен в операционную систему Windows 98."
