            "senses": [
                {
                    "sense_id": "6c0ab610-e135-3b59-a12e-3180edc0b4b5",
                    "sense_definition": "minder duidelijk of scherp worden",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "onduidelijk worden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De herinneringen aan die vakantie <w>vervagen</w> naarmate de jaren verstrijken.",
                            "target_lang_translations": {
                                "en": "The memories of that holiday <w>fade</w> as the years go by."
                            }
                        },
                        {
                            "text": "Door de dichte mist begon de horizon langzaam te <w>vervagen</w>.",
                            "target_lang_translations": {
                                "en": "Due to the thick fog, the horizon slowly began to <w>blur</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "verbleken",
                        "vervloeien"
                    ],
                    "antonyms": [
                        "verscherpen"
                    ],
                    "common_phrases": [
                        "herinneringen vervagen",
                        "langzaam vervagen"
                    ],
                    "target_lang_definitions": {
                        "en": "to become less clear or sharp"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fade",
                                "target_lang_sense_clarification": "of memories, colors, or sounds"
                            },
                            {
                                "target_lang_word": "blur",
                                "target_lang_sense_clarification": "to become indistinct or hazy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "745d2302-f74a-3ad6-bc04-5125afa57dd3",
                    "sense_definition": "iets minder duidelijk of scherp maken",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "onduidelijk maken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kunstenaar besloot de achtergrond te <w>vervagen</w> om de aandacht op het portret te vestigen.",
                            "target_lang_translations": {
                                "en": "The artist decided to <w>blur</w> the background to draw attention to the portrait."
                            }
                        },
                        {
                            "text": "Je kunt de randen van de foto <w>vervagen</w> met dit computerprogramma.",
                            "target_lang_translations": {
                                "en": "You can <w>blur</w> the edges of the photo with this computer program."
                            }
                        }
                    ],
                    "synonyms": [
                        "blurren",
                        "onscherp maken"
                    ],
                    "antonyms": [
                        "accentueren",
                        "benadrukken"
                    ],
                    "common_phrases": [
                        "de achtergrond vervagen",
                        "grenzen vervagen"
                    ],
                    "target_lang_definitions": {
                        "en": "to make something less clear or sharp"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "blur",
                                "target_lang_sense_clarification": "to make an image or boundary less distinct"
                            },
                            {
                                "target_lang_word": "fade",
                                "target_lang_sense_clarification": "to cause something to lose brightness or clarity"
                            }
                        ]
                    }
                }
            ]
        }
    ]
