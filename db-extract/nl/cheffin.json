                "senses": [
                    {
                        "sense_id": "fee76b2e-4a24-3adb-b2b7-22d2a735f66b",
                        "entry_id": "21bc5343-5778-33f2-b6af-ef9ee9b226a9",
                        "glosses": [
                            "weibliche Person, die eine Abteilung leitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc3c12f8-4b7e-4828-a0af-20ad3db981d0",
                                "sense_id": "fee76b2e-4a24-3adb-b2b7-22d2a735f66b",
                                "text": "Mijn chef heeft mij gepromoveerd tot de cheffin van de dienst.",
                                "translation": "Mein Chef hat mich zur Dienststellenleiterin befördert."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1fab52d3-c99f-4458-b313-5724182cd2f1",
                        "source_entry_id": "21bc5343-5778-33f2-b6af-ef9ee9b226a9",
                        "source_sense_id": "fee76b2e-4a24-3adb-b2b7-22d2a735f66b",
                        "source_sense_description": "weibliche Person, die eine Abteilung leitet",
                        "target_lang_word": "Chefin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Chefin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2d67c465-c634-35b6-b890-fa41660884a2",
                                        "entry_id": "4271421a-6101-3f0c-9d01-8bb6f39773fc",
                                        "glosses": [
                                            "Frau mit Weisungsbefugnis über nachgeordnetes Personal, Inhaberin, Vorgesetzte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5c5dfa1-e05f-4133-b7a9-d7d3fcb4f939",
                                                "sense_id": "2d67c465-c634-35b6-b890-fa41660884a2",
                                                "text": "Ihre Chefin ist sehr umgänglich."
                                            },
                                            {
                                                "example_id": "d2ea7e19-dc9b-4b90-8998-eb8a24ce5802",
                                                "sense_id": "2d67c465-c634-35b6-b890-fa41660884a2",
                                                "text": "„Diese Tradition wird von der derzeitigen Chefin und geschäftsführenden Gesellschafterin, Waltraud Kolbitsch, fortgesetzt.“"
                                            },
                                            {
                                                "example_id": "879e849b-ea02-4306-8cf8-77140b060c5e",
                                                "sense_id": "2d67c465-c634-35b6-b890-fa41660884a2",
                                                "text": "„Die Chefin des Ladens bewirtete mich mit Kaffee und Gebäck und tat ihr Bestes, um mich zu unterhalten.“"
                                            },
                                            {
                                                "example_id": "c41d688b-97c2-4130-94d2-da4c6fd8f792",
                                                "sense_id": "2d67c465-c634-35b6-b890-fa41660884a2",
                                                "text": "„Während wir noch darüber sinnieren, wie man Feste feiern soll oder auch nicht, steht die Chefin wieder an unserem Tisch.“"
                                            },
                                            {
                                                "example_id": "d6438109-f0e3-49a6-9b2a-ee974621cd94",
                                                "sense_id": "2d67c465-c634-35b6-b890-fa41660884a2",
                                                "text": "„Wenn er sagt, ich sei die gütigste aller Chefinnen und es sei ein Privileg, für mich zu arbeiten, dann meint er es auch so.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "689b8a5c-60df-383a-bc25-a44608044e84",
                                        "entry_id": "4271421a-6101-3f0c-9d01-8bb6f39773fc",
                                        "glosses": [
                                            "Frau des Chefs"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "557e5ad3-1711-4747-b7d9-0ff9c3102e20",
                                                "sense_id": "689b8a5c-60df-383a-bc25-a44608044e84",
                                                "text": "„Dieser Breselmeier und dieser Chef, und dann sie, die Chefin, und das ganze Bureauwesen da, da gibts wirklich chronique scandaleuse von allen Seiten.“ (1862)"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4f35f985-323e-4c30-83c4-4851f77e14f9",
                        "source_entry_id": "21bc5343-5778-33f2-b6af-ef9ee9b226a9",
                        "source_sense_id": "fee76b2e-4a24-3adb-b2b7-22d2a735f66b",
                        "source_sense_description": "weibliche Person, die eine Abteilung leitet",
                        "target_lang_word": "Leiterin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Leiterin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a3bae429-29a2-3c2f-a216-159efd1e95ac",
                                        "entry_id": "3a43ba27-746d-3d5f-bea2-aeb75c350a7d",
                                        "glosses": [
                                            "weibliche Person, die in leitender Funktion tätig ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "446275f6-3386-429d-ac06-e7389b0f55c1",
                                                "sense_id": "a3bae429-29a2-3c2f-a216-159efd1e95ac",
                                                "text": "Das gesamte Team wartete auf das Eintreffen der Leiterin."
                                            },
                                            {
                                                "example_id": "e7f04ee8-5103-45d7-b977-b5b695153d29",
                                                "sense_id": "a3bae429-29a2-3c2f-a216-159efd1e95ac",
                                                "text": "„Eingeladen waren rund 170 Leiterinnen und Leiter unterschiedlichster Einrichtungen wie etwa Stiftungen, Museen oder Gedenkstätten.“"
                                            },
                                            {
                                                "example_id": "362fd733-b24a-463c-8474-3eef27d07a34",
                                                "sense_id": "a3bae429-29a2-3c2f-a216-159efd1e95ac",
                                                "text": "„Die alte fromme Leiterin der Schule, die sich am Anfang gleichgültig gegen die Freundschaft gezeigt hatte, die ich offenkundig für Angela hegte, nahm schließlich meine häufigen Besuche übel und hinterbrachte sie dem Pfarrer Tosello, Angelas Onkel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9e69aee2-7ff8-4ed8-be7f-f5e9029b6e18",
                        "source_entry_id": "21bc5343-5778-33f2-b6af-ef9ee9b226a9",
                        "source_sense_id": "fee76b2e-4a24-3adb-b2b7-22d2a735f66b",
                        "source_sense_description": "weibliche Person, die eine Abteilung leitet",
                        "target_lang_word": "chiefess",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chiefess",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aeeeb3d1-83bc-3bde-b9ed-9c616de850d5",
                                        "entry_id": "a73bb3ea-034b-31ff-b78c-2eecffbb8227",
                                        "glosses": [
                                            "Synonym of chieftainess, a female chief."
                                        ],
                                        "tags": [
                                            "Hawaii"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0e680c5-37ef-4dba-9811-5ad5e7ba9bbd",
                                                "sense_id": "aeeeb3d1-83bc-3bde-b9ed-9c616de850d5",
                                                "text": "Although Lili‘u was born a high chiefess, with lineage that reached back to the high chiefs under Kamehameha the Great, at the time of her birth it would never have seemed possible that she would someday become queen."
                                            }
                                        ]
                                    }
                                ]
