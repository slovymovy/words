            {
                "entry_id": "be03de36-24e5-3a9e-8be6-3d643a408d7f",
                "word": "despond",
                "pos": "verb",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "980146ce-9cc9-4e9d-a9d1-2e35059fd283",
                        "entry_id": "be03de36-24e5-3a9e-8be6-3d643a408d7f",
                        "tags": [
                            "present",
                            "singular",
                            "third-person"
                        ],
                        "form": "desponds"
                    },
                    {
                        "form_id": "4af6b11a-4ad4-450e-8fc1-b9f82b0f1c68",
                        "entry_id": "be03de36-24e5-3a9e-8be6-3d643a408d7f",
