                "senses": [
                    {
                        "sense_id": "faf68f95-3f4f-31ea-a7ac-27620f7dfb9b",
                        "entry_id": "96d0feaa-3ebb-344f-a131-ce669622e518",
                        "glosses": [
                            "Gitter, durch das Luft frei hindurchströmt, angesaugt oder ausgeblasen wird"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "3bf12bb3-e2b0-4ec8-b8f2-c8e907cede2d",
                                "sense_id": "faf68f95-3f4f-31ea-a7ac-27620f7dfb9b",
                                "text": "„Wird ein Lüftungsgitter in einer Seitenwand unmittelbar unter der Decke eingelassen, so legt sich der Strahl an die Decke an.“"
                            },
                            {
                                "example_id": "d460a1fa-5677-4611-99ce-f89ea132960f",
                                "sense_id": "faf68f95-3f4f-31ea-a7ac-27620f7dfb9b",
                                "text": "„Durch Lüftungsgitter oder genau berechnete Türspalte strömt die Luft weiter in Flur und Treppenhaus, bis sie schließlich in Küche, Bad und WC ankommt.“"
                            },
                            {
                                "example_id": "5072e201-4365-4bd0-a74d-1378bb7e9ef1",
                                "sense_id": "faf68f95-3f4f-31ea-a7ac-27620f7dfb9b",
                                "text": "„Die Lüftungsgitter PA1 und PA3 sind aus Aluminium-Profilen präzise gearbeitet und zeichnen sich besonders durch ihre hohe Oberflächengüte aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
