                "senses": [
                    {
                        "sense_id": "1ab09bfc-1257-35fe-8649-808c32c4fc73",
                        "entry_id": "728b5c25-2e66-31bb-b485-bbac4f9814d8",
                        "glosses": [
                            "een mannelijke persoon die romans schrijft"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "fa44b153-5fc7-4155-bd59-066d875772e9",
                                "sense_id": "1ab09bfc-1257-35fe-8649-808c32c4fc73",
                                "text": "De Noorse romanschrijver Jonas Lie, die sinds jaren te Parijs woont, zal daar op 6 November 1903 zijn 70ste verjaardag vieren."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6aaf913c-0987-4433-a3e9-99c2de4b4e08",
                        "source_entry_id": "728b5c25-2e66-31bb-b485-bbac4f9814d8",
                        "source_sense_id": "1ab09bfc-1257-35fe-8649-808c32c4fc73",
                        "source_sense_description": "een mannelijke persoon die romans schrijft",
                        "target_lang_word": "Schriftsteller",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schriftsteller",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f89e9612-d1aa-336e-b6f2-427ae442d3ec",
                                        "entry_id": "81a91744-538a-3ba6-b7da-63270d7b67bc",
                                        "glosses": [
                                            "Person, die im Verfassen eigener literarischer Texte ihren beruflichen Schwerpunkt setzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "288643f8-76cf-4ea0-82d1-aad3961c9e64",
                                                "sense_id": "f89e9612-d1aa-336e-b6f2-427ae442d3ec",
                                                "text": "Ah, das Buch scheint von demselben Schriftsteller zu sein wie das andere."
                                            },
                                            {
                                                "example_id": "0e127c39-c261-496a-81d9-0eeabef9232a",
                                                "sense_id": "f89e9612-d1aa-336e-b6f2-427ae442d3ec",
                                                "text": "„Auf jeden Fall war das bestimmt nichts, was sich einer der berühmtesten Schriftsteller des zwanzigsten Jahrhunderts kaufen würde.“"
                                            },
                                            {
                                                "example_id": "46c410d1-4dff-4e4d-9938-137e52a6b30d",
                                                "sense_id": "f89e9612-d1aa-336e-b6f2-427ae442d3ec",
                                                "text": "„Außerdem hatte ich ihm in einem meiner Briefe mitgeteilt, dass ich das Chemiestudium zwar zu Ende führen würde, aber dann lieber Schriftsteller werden wolle.“"
                                            },
                                            {
                                                "example_id": "5ba0f742-2f7d-4914-bfe9-5aa693d04ebf",
                                                "sense_id": "f89e9612-d1aa-336e-b6f2-427ae442d3ec",
                                                "text": "„Den Schriftsteller Seume gäbe es nicht, wäre der Mensch Seume nicht immer auf dem Sprung gewesen.“"
                                            },
                                            {
                                                "example_id": "0cb473e0-43d8-48b7-a140-a26cfbc94d3b",
                                                "sense_id": "f89e9612-d1aa-336e-b6f2-427ae442d3ec",
                                                "text": "„Ein Schriftsteller buhlt auf ebenso schmähliche Weise wie ein Politiker oder sonst ein Scharlatan um sein Publikum.“"
                                            },
                                            {
                                                "example_id": "96689ffb-170a-438a-94f1-4d40a14c7c54",
                                                "sense_id": "f89e9612-d1aa-336e-b6f2-427ae442d3ec",
                                                "text": "„Die maskilischen Schriftsteller jedoch griffen sowohl die reichen Oberhäupter des ‚Kahal‘, der jüdischen Gemeinde, wie auch die Wunderrabbis an.“"
                                            },
                                            {
                                                "example_id": "f7b63b50-ff76-42b9-b00f-f618966c2f57",
                                                "sense_id": "f89e9612-d1aa-336e-b6f2-427ae442d3ec",
                                                "text": "„Der Schriftsteller arbeitete vor dem Ersten Weltkrieg als Reichtagsstenograf in Berlin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f40807ae-ccde-49d3-9d41-8e18ff6550a1",
                        "source_entry_id": "728b5c25-2e66-31bb-b485-bbac4f9814d8",
                        "source_sense_id": "1ab09bfc-1257-35fe-8649-808c32c4fc73",
                        "source_sense_description": "een mannelijke persoon die romans schrijft",
                        "target_lang_word": "Romanautor",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Romanautor",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8680560c-cfc0-3017-a177-e6edfa6cf0c0",
                                        "entry_id": "8aa49f2c-75ae-3418-84d5-deaec64d1d75",
                                        "glosses": [
                                            "jemand, der einen Roman verfasst hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06521b83-1774-4085-99ae-3fe8a1f31efe",
                                                "sense_id": "8680560c-cfc0-3017-a177-e6edfa6cf0c0",
                                                "text": "„Man kann sie selbstverständlich »bloß so« lesen und wird sie mögen, aber wer sich um ein Verständnis bemühen will, das ihrer Komplexität gerecht wird, sollte allerlei, was im Zusammenhang der Romane noch zur Sprache kommen wird, mitdenken, und wer Wieland als Romanautor begreifen will, der sollte das wissen.“"
                                            },
                                            {
                                                "example_id": "446596f9-f8b2-4751-8c3c-09933ae4a47b",
                                                "sense_id": "8680560c-cfc0-3017-a177-e6edfa6cf0c0",
                                                "text": "„Frank Thies, zehn Jahre jünger als Walter von Molo, Theaterkritiker, Redakteur, seit den Zwanzigerjahren erfolgreicher Romanautor, nach 1933 unvermindert aktiv, 1936 mit dem Buch »Tsushima«.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e3c9bea8-346f-4c87-ae93-d84f3e96adc4",
                        "source_entry_id": "728b5c25-2e66-31bb-b485-bbac4f9814d8",
