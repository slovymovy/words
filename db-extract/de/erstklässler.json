                    {
                        "form_id": "9397adec-2a7e-46eb-ad4d-18436716d67c",
                        "entry_id": "e3572d26-d910-3d9d-bf57-ae89bc8d3ed0",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Erstklässler"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b753b81d-c8aa-3c71-b455-9a3e94542c4c",
                        "entry_id": "e3572d26-d910-3d9d-bf57-ae89bc8d3ed0",
                        "glosses": [
                            "ein Schüler, der die erste Klasse besucht (in Österreich auch einer weiterführenden Schule)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0821be5-db2d-4153-b3a8-89e8119bad28",
                                "sense_id": "b753b81d-c8aa-3c71-b455-9a3e94542c4c",
                                "text": "„Während einige Kinder mit den Arbeitskarten arbeiten, lautieren zum Beispiel Erstklässler […] mit mir im Nebenraum und machen vielfältige Basisübungen zur phonologischen Bewusstheit und spielerische Übungen zur Satzbildung.“"
                            },
                            {
                                "example_id": "f6626e7c-794f-4267-9b07-df79447b2aee",
                                "sense_id": "b753b81d-c8aa-3c71-b455-9a3e94542c4c",
                                "text": "„Am deutschen Altstädter Gymnasium besuchen beispielsweise im Schuljahr 1891/92 nur zwei der neun tschechischen Erstklässler das Wahlfach Tschechisch, 1893/94 nur fünf der dreizehn Erstklässler.“"
                            },
                            {
                                "example_id": "0ca2fb3a-6b0f-43cd-89ad-13f415e21413",
                                "sense_id": "b753b81d-c8aa-3c71-b455-9a3e94542c4c",
                                "text": "„Auch mit dem Binär- und Hexadezimalsystem wusste er dann später als Erstklässler seine Lehrerin zu verblüffen.“"
                            },
                            {
                                "example_id": "d7ef6c1a-ede5-4494-9504-48ee7f2de5f7",
                                "sense_id": "b753b81d-c8aa-3c71-b455-9a3e94542c4c",
                                "text": "„Baba ab dad. Papa gab Wasser, der Satz, mit dem alle iranischen Erstklässler schreiben lernen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "00e7b8eb-d945-40c9-b8c2-224c36098bc1",
                        "source_entry_id": "e3572d26-d910-3d9d-bf57-ae89bc8d3ed0",
                        "source_sense_id": "b753b81d-c8aa-3c71-b455-9a3e94542c4c",
                        "source_sense_description": "Schüler, der die erste Klasse besucht",
                        "target_lang_word": "первоклассник",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "первоклассник",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "984fc242-adcf-38e8-b2f4-004b459b434b",
                                        "entry_id": "dc6ac278-46a5-3484-b3d1-36996dfa22a6",
                                        "glosses": [
                                            "школьник первого года обучения"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10a11e74-e9a1-4ed6-a274-d1656f9ef055",
                                                "sense_id": "984fc242-adcf-38e8-b2f4-004b459b434b",
                                                "text": "Как не похож этот грязный, оборванный парень на чистенького первоклассника-реалиста, который читал еженедельный журнал «Задушевное слово», учил закон божий, ездил с мамашей в гости, шаркал ножкой и целовал ручки у тетушек…"
                                            },
                                            {
                                                "example_id": "c9da55ea-a31c-4b80-a437-e18f667443df",
                                                "sense_id": "984fc242-adcf-38e8-b2f4-004b459b434b",
                                                "text": "И те проблемы, что составляют человеческую жизнь, для нас ― что расстройства первоклассника от косо нарисованных в тетрадке палочек."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "622bc906-0ec6-3b34-8bb0-6969f62c8294",
                                        "entry_id": "dc6ac278-46a5-3484-b3d1-36996dfa22a6",
                                        "glosses": [
                                            "разг. простофиля, несмышлёныш"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb79d491-7953-499c-b6a9-b0f466f384f5",
                                                "sense_id": "622bc906-0ec6-3b34-8bb0-6969f62c8294",
                                                "text": "Земля ― шар! Да ведь это знает любой первоклассник!"
                                            },
                                            {
                                                "example_id": "798dc93d-75fe-4ad9-97cb-3ca89c538977",
                                                "sense_id": "622bc906-0ec6-3b34-8bb0-6969f62c8294",
                                                "text": "А я, представьте, купился на этот фокус, как первоклассник."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "48759b5d-4244-404d-87d0-65e2a4a79266",
                        "source_entry_id": "e3572d26-d910-3d9d-bf57-ae89bc8d3ed0",
                        "source_sense_id": "b753b81d-c8aa-3c71-b455-9a3e94542c4c",
                        "source_sense_description": "Schüler, der die erste Klasse besucht",
