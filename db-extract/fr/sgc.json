                                        "sense_id": "73fc47e4-5113-399c-9485-e30dcd2d50a9",
                                        "entry_id": "3796f8ac-7ed3-3349-9f6c-34b9fccd4cf1",
                                        "glosses": [
                                            "Initialism of Charles Martel Society."
                                        ],
