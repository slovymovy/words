                "senses": [
                    {
                        "sense_id": "3d2d03b7-3c7b-3350-b04d-af71d76e4bb6",
                        "entry_id": "c95c88d8-77bd-31ef-9333-686b91bdfc0a",
                        "glosses": [
                            "het onderzoeken van een selectie uit een totale populatie, waarmee eigenschappen van de totale populatie bepaald worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "489faede-fa1c-45ef-8ccd-5d5099e62534",
                                "sense_id": "3d2d03b7-3c7b-3350-b04d-af71d76e4bb6",
                                "text": "De kleine steekproef onder mijn vrienden was niet representatief."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2bd018a1-b882-424a-965a-cfc1c0c8807d",
                        "source_entry_id": "c95c88d8-77bd-31ef-9333-686b91bdfc0a",
                        "source_sense_id": "3d2d03b7-3c7b-3350-b04d-af71d76e4bb6",
                        "target_lang_word": "Stichprobe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stichprobe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8d05e2ad-d3d4-3d14-a06c-a2361687359c",
                                        "entry_id": "7f32716c-88c4-3d8d-b721-8c38ff44879f",
                                        "glosses": [
                                            "der zufällig gewonnene Anteil einer gesamten Menge von Fällen, der für alle Fälle repräsentativ sein soll"
                                        ],
                                        "tags": [
                                            "Statistik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "228777f2-de1b-47eb-bcb2-af6ea1ad1fed",
                                                "sense_id": "8d05e2ad-d3d4-3d14-a06c-a2361687359c",
                                                "text": "Sie machten Qualitäts-Stichproben bei der Produktion des Gerätes."
                                            },
                                            {
                                                "example_id": "c06629de-cdf7-4f38-bc5a-28f5572cd141",
                                                "sense_id": "8d05e2ad-d3d4-3d14-a06c-a2361687359c",
                                                "text": "„Dieser Einwand zur ungenügend großen Stichprobe von Markov und seine Anspielung auf das Gesetz der Großen Zahlen ist in seiner Bedeutung und Relevanz für die weitere Entwicklung quantitativer Verfahren in der russischen Sprach- und Literaturwissenschaft nicht zu unterschätzen und sollte noch Generationen von Wissenschaftlern beschäftigen.“"
                                            },
                                            {
                                                "example_id": "b07cf7bf-cc51-439f-9642-3874fc2a4b6c",
                                                "sense_id": "8d05e2ad-d3d4-3d14-a06c-a2361687359c",
                                                "text": "„Die Stichprobe soll Aufschluß über die Grundgesamtheit G geben, die man aus finanziellen, zeitlichen oder prinzipiellen Gründen nicht als Ganzes untersuchen kann (…).“"
                                            },
                                            {
                                                "example_id": "fb8a7379-725f-42bf-abe5-662ba211bb58",
                                                "sense_id": "8d05e2ad-d3d4-3d14-a06c-a2361687359c",
                                                "text": "„Bei der Erhebung der Stichprobe stellte die statistische Zuverlässigkeit der Daten ein besonderes Ziel dar.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0608b295-f7f8-353b-a45f-320f6294b6f5",
                                        "entry_id": "7f32716c-88c4-3d8d-b721-8c38ff44879f",
                                        "glosses": [
                                            "Überprüfung eines willkürlich ausgewählten Teils aus einer Menge"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd0f8840-2216-4300-9d63-6dfc30488194",
                                                "sense_id": "0608b295-f7f8-353b-a45f-320f6294b6f5",
                                                "text": "Aufgrund Zeitmangels konnte nur eine kleine Stichprobe aus der gesamten Lieferung genauer überprüft werden."
                                            },
                                            {
                                                "example_id": "c9cdf148-c580-49d9-aca8-e8d5b5613a31",
                                                "sense_id": "0608b295-f7f8-353b-a45f-320f6294b6f5",
                                                "text": "„Eine Stichprobe im Internet förderte weit über tausend solcher Schmähvokabeln allein für die Kanzlerin zutage.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "388ae2eb-bf1f-447e-9f5c-dc7ed1ec7b3a",
                        "source_entry_id": "c95c88d8-77bd-31ef-9333-686b91bdfc0a",
                        "source_sense_id": "3d2d03b7-3c7b-3350-b04d-af71d76e4bb6",
                        "target_lang_word": "spot check",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spot check",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4cad65e7-7793-3f72-b546-7eca7ca0ab9a",
                                        "entry_id": "86f4219b-c302-3cf0-9ac2-ccb13ff0e60a",
                                        "glosses": [
                                            "A cursory inspection or examination, especially of a sample of something."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0dc7894-22d2-4943-8ad4-9d13ad4c87cc",
                                                "sense_id": "4cad65e7-7793-3f72-b546-7eca7ca0ab9a",
                                                "text": "They do not measure each one, but they do a spot check on a few parts before shipping."
                                            },
                                            {
                                                "example_id": "68e7ddbd-faa1-48c2-a50d-f38459d7b671",
                                                "sense_id": "4cad65e7-7793-3f72-b546-7eca7ca0ab9a",
                                                "text": "Though the author consulted with two doctors (a spot check with another doctor reveals some medical information to be stale by at least five years), […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "spot check",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ef6463e6-4f46-3102-b2e9-5a2c62ebfedd",
                                        "entry_id": "4b481fd5-b7ab-3c40-b01f-bec46fdae3e8",
                                        "glosses": [
                                            "To inspect or examine briefly, or by sampling."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "747fba3f-1f37-4a60-ad88-8b5e560367d2",
                                                "sense_id": "ef6463e6-4f46-3102-b2e9-5a2c62ebfedd",
                                                "text": "They spot check the rooms periodically for problems."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
