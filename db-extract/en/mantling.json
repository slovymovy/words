                    {
                        "translation_id": "d8bf6b5a-06af-42d7-b539-c35186bfa743",
                        "source_entry_id": "d37a7338-b3ea-3e30-9b11-153144c01a48",
                        "source_sense_description": "heraldry: drapery behind and around a coat of arms",
                        "target_lang_word": "lambrequin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lambrequin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2c96a0b8-a3e8-3a60-8935-4bab3e27ba60",
                                        "entry_id": "f681dacd-7d1f-3af9-a2db-354b696b5ba8",
                                        "glosses": [
                                            "Ornement qui pend du casque et entoure l’écu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bddf361f-c09c-4952-bea6-546aa0dc50b3",
                                                "sense_id": "2c96a0b8-a3e8-3a60-8935-4bab3e27ba60",
                                                "text": "Les armes du nouveau gentilhomme étaient « d'azur à la fasce d'or et pour cimier: lion issant d'argent, tenant en ses pattes une boule du même et d'un torty d'or et d'azur, le tout porté d'un avinet mort avec les lambrequins et couleurs susdites »."
                                            },
                                            {
                                                "example_id": "368a3bf7-a71d-43ce-a6c6-fd6c82e564f1",
                                                "sense_id": "2c96a0b8-a3e8-3a60-8935-4bab3e27ba60",
                                                "text": "Quand il voulait prendre l’air, il ôtait son casque, et se couvrait du bonnet. Alors les lambrequins retombaient sur ses épaules."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38db0538-8901-3dd1-b59f-eec22051b402",
                                        "entry_id": "f681dacd-7d1f-3af9-a2db-354b696b5ba8",
                                        "glosses": [
                                            "Découpure de bois ou de tôle, couronnant un pavillon, une tente, un store, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2e7a7cd-c365-482e-a13b-ec0883d0d269",
                                                "sense_id": "38db0538-8901-3dd1-b59f-eec22051b402",
                                                "text": "Ce perron, aux marches larges et basses, était abrité par une vaste marquise vitrée, bordée d’un lambrequin à franges et à glands d’or."
                                            },
                                            {
                                                "example_id": "a109087b-6e96-4651-a3e0-c7e4767754c7",
                                                "sense_id": "38db0538-8901-3dd1-b59f-eec22051b402",
                                                "text": "Portail en fer défoncé, croix et stèle déplacées, colonnes fissurées, lambrequins arrachés, il ne les a pas vus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4c08fae-3ec6-30d0-af11-1708a8258f22",
                                        "entry_id": "f681dacd-7d1f-3af9-a2db-354b696b5ba8",
                                        "glosses": [
                                            "Bandeau décoratif d’étoffe qui surmonte un décor de tapisserie ou des rideaux de fenêtre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e117714c-ac9a-473e-a772-f02e28c8d082",
                                                "sense_id": "f4c08fae-3ec6-30d0-af11-1708a8258f22",
                                                "text": "Les lambrequins de l’atelier étaient baissés."
                                            },
                                            {
                                                "example_id": "dd6e497e-e32d-4835-9775-8da45324caf8",
                                                "sense_id": "f4c08fae-3ec6-30d0-af11-1708a8258f22",
                                                "text": "Trois lits en forme de corbillards et garnis de lambrequins jaunes fanés occupaient deux faces de la muraille."
                                            },
                                            {
                                                "example_id": "dd95a5b8-fb05-4315-aa00-72053755ee5c",
                                                "sense_id": "f4c08fae-3ec6-30d0-af11-1708a8258f22",
                                                "text": "Les avant-scènes restaient vides, drapées de lambrequins à longues franges."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
