                        "examples": [
                            {
                                "example_id": "391803df-659b-4efc-9105-aa563bb431a3",
                                "sense_id": "cee939fe-b601-3736-8e28-25f114b16e5f",
                                "text": "Philosophie, doctrine atomistique. Philosophie, doctrine qui explique la formation du monde par le moyen des atomes."
                            },
                            {
                                "example_id": "15bc9b1b-89d2-4648-b046-0fb575dfdaf8",
                                "sense_id": "cee939fe-b601-3736-8e28-25f114b16e5f",
                                "text": "Que ton bonheur soit divisé en fulgurations. Ainsi ta part de joie sera égale à celle des autres.\nAie la contemplation atomistique de l’univers."
                            }
                        ]
                    }
