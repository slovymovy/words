                    {
                        "sense_id": "4b68c87c-b2ea-3132-b278-3a41f462e391",
                        "entry_id": "b285cef2-24e9-377c-81fa-5c1ce2c6f8fe",
                        "glosses": [
                            "Anhänger einer illegalen politischen Bewegung im Osmanischen Reich, die eine konstitutionelle Staatsform forderte"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "5664ecfb-d775-4546-b6ec-26e910b328c0",
                                "sense_id": "4b68c87c-b2ea-3132-b278-3a41f462e391",
                                "text": "„Die Jungtürken verfolgten eine ehrgeizige Modernisierungspolitik im Inneren und propagierten eine panislamische Politik nach außen.“"
                            },
                            {
                                "example_id": "255016d8-d4e5-4300-a16e-f3c4d84a7b69",
                                "sense_id": "4b68c87c-b2ea-3132-b278-3a41f462e391",
                                "text": "„Die Großtürken waren fort, die Jungtürken, die den letzten Sultan gestürzt hatten, bald auch, und die Briten, die an ihre Stelle getreten waren, würden nicht lange durchhalten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
