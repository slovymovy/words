                "senses": [
                    {
                        "sense_id": "9e04dafa-3a3f-3f1a-9e1c-e044ce6dae52",
                        "entry_id": "a0aa9fd7-b8fd-3975-a825-4bd1f076c720",
                        "glosses": [
                            "boot waarmee toeristen vanaf het water een stad of landschap kunnen bezichtigen d.m.v. een boottocht die weer eindigt bij de startplaats"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "998c4df2-96ac-4e8a-a277-44374dede649",
                                "sense_id": "9e04dafa-3a3f-3f1a-9e1c-e044ce6dae52",
                                "text": "Na een tocht door de schilderachtige Ha Longbaai in het noorden van Vietnam is een rondvaartboot met 14 buitenlandse vakantiegangers compleet uitgebrand. De toeristen konden door een andere boot nog tijdig gered worden, net zoals de zeven bemanningsleden. De brand was dinsdagmorgen rond 6.30 uur uitgebroken, toen het schip terugkeerde van een tweedaagse trip. De oorzaak van de brand is nog niet bekend."
                            },
                            {
                                "example_id": "70476f2d-7272-4a89-a53b-025c585d22e3",
                                "sense_id": "9e04dafa-3a3f-3f1a-9e1c-e044ce6dae52",
                                "text": "Bajema's Paradevoorstelling op locatie is een originele toevoeging aan het programma dat verder volledig in de tenten op het terrein in het Martin Luther Kingpark plaatsvindt. Spanning en sensatie op een rondvaartboot is de titel, maar in wezen is het een vermakelijke komedie. De voorstelling is nog het best te omschrijven als een persiflage op een thriller in de Amsterdamse grachten."
                            }
                        ]
                    }
