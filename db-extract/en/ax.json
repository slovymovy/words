                    },
                    {
                        "sense_id": "54d0a929-b48f-3941-9e04-9619f389e2c5",
                        "entry_id": "4fad98ac-57f8-3454-8526-a20fbe766a94",
                        "glosses": [
                            "Coupe sombre."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "c10f6b31-326e-4347-9bf0-9b5e122c9215",
                                "sense_id": "54d0a929-b48f-3941-9e04-9619f389e2c5",
                                "text": "To apply the ax to : Porter la hache dans."
                            },
                            {
                                "example_id": "3dd1236e-5f80-4969-97ee-0fa1baa1b64d",
                                "sense_id": "54d0a929-b48f-3941-9e04-9619f389e2c5",
                                "text": "To have an ax to grind : Prêcher, travailler pour son saint."
                            },
                            {
                                "example_id": "5bdaa8cc-38dd-4fd0-b113-a6f8129f2b89",
                                "sense_id": "54d0a929-b48f-3941-9e04-9619f389e2c5",
                                "text": "To put the ax in the helve : Trouver le joint."
                            },
                            {
                                "example_id": "3a9a8b3b-5731-491c-94fb-435ebce2347d",
                                "sense_id": "54d0a929-b48f-3941-9e04-9619f389e2c5",
                                "text": "To get the ax : Passer au couperet."
                            }
                        ]
                    }
                ],
