                "senses": [
                    {
                        "sense_id": "165ec1d9-70b7-352c-9b93-4e0181c9ad63",
                        "entry_id": "ce90ddbf-a7bb-3975-860e-4585fbcabc4c",
                        "glosses": [
                            "Écrire sous forme d’alexandrins."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1933cc9-fb19-4047-aa32-bb8843b3be27",
                                "sense_id": "165ec1d9-70b7-352c-9b93-4e0181c9ad63",
                                "text": "Elle n’est même, à vrai dire, que trop facile : alexandriniser un décasyllabe n’exige pas d’autre effort que l’addition de deux pieds supplémentaires aux quatre premiers pour en faire un hémistiche classique."
                            },
                            {
                                "example_id": "68d6053f-1d78-466f-a6da-4950a4c2048a",
                                "sense_id": "165ec1d9-70b7-352c-9b93-4e0181c9ad63",
                                "text": "Vous ne pourriez pas dire plutôt : L’hiver se dissipe, et annonce la brise printanière ? Ou quelque chose de ce genre ? Non, monsieur doit alexandriniser."
                            }
                        ]
                    }
                ],
