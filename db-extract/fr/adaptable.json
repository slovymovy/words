                "senses": [
                    {
                        "sense_id": "593c5c56-da93-3a5d-be6d-7acc052b8cec",
                        "entry_id": "503a8526-d59f-3d5c-b769-0a0ec29868ad",
                        "glosses": [
                            "Qui peut être adapté."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7009920f-d1e4-4799-ac1b-942447ab9e5d",
                                "sense_id": "593c5c56-da93-3a5d-be6d-7acc052b8cec",
                                "text": "Zara a copié des défilés, H&M et Uniqlo ont multiplié les collaborations, et les consommateurs découvert des vestiaires adaptables à toutes les silhouettes de mode et à bas prix."
                            },
                            {
                                "example_id": "4ddc6b92-a776-48ec-8e8f-ac94a8989530",
                                "sense_id": "593c5c56-da93-3a5d-be6d-7acc052b8cec",
                                "text": "Pour se rapprocher au plus près de la cinématique individuelle du patient, Hanau propose, en 1921, le Kinoscope, premier articulateur totalement adaptable."
                            },
                            {
                                "example_id": "e6f7adc1-22ce-47dd-bd9d-a281e28d919a",
                                "sense_id": "593c5c56-da93-3a5d-be6d-7acc052b8cec",
                                "text": "Dreeft est une paire de roues équipées d’un système de freinage par rétropédalage, adaptable à tout fauteuil roulant manuel."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "11214e34-1d37-4d96-b2e1-01919c81c811",
                        "source_entry_id": "503a8526-d59f-3d5c-b769-0a0ec29868ad",
                        "source_sense_id": "593c5c56-da93-3a5d-be6d-7acc052b8cec",
                        "source_sense_description": "Qui peut être adapté",
                        "target_lang_word": "anpassbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anpassbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3b33806a-3cb7-37dd-865a-716f2d8a9143",
                                        "entry_id": "3a793bd8-770f-3984-952d-1a687957019f",
                                        "glosses": [
                                            "so, dass es angepasst werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e0a8737-35c2-4f4b-938f-836b4b51e7c4",
                                                "sense_id": "3b33806a-3cb7-37dd-865a-716f2d8a9143",
                                                "text": "„In der 2004 von der Schweizer Fachstelle publizierten Richtlinie ist dargestellt, welche baulichen Voraussetzungen eine hindernisfreie und anpassbare Wohnung aufzuweisen hat.“"
                                            },
                                            {
                                                "example_id": "8253d02b-0ccf-43ca-999c-16a6c40a012a",
                                                "sense_id": "3b33806a-3cb7-37dd-865a-716f2d8a9143",
                                                "text": "„[Die Nanoleaf-Lichtpaneele] sind auch nicht nur im Muster anpassbar, sondern auch in der Beleuchtung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
