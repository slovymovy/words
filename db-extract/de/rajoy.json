                "senses": [
                    {
                        "sense_id": "c512b2f1-bb30-3e7c-9624-32aea993cef1",
                        "entry_id": "c9b6725d-d2a7-3671-b460-c59ba182dabd",
                        "glosses": [
                            "spanischsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7de1ae5c-4bf0-4e10-872e-0a2f1e266a60",
                                "sense_id": "c512b2f1-bb30-3e7c-9624-32aea993cef1",
                                "text": "Frau Rajoy ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "7887f5d1-1966-4bb5-8a73-e80222babad4",
                                "sense_id": "c512b2f1-bb30-3e7c-9624-32aea993cef1",
                                "text": "Herr Rajoy wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "87794596-8220-47da-b3c2-a256b9771019",
                                "sense_id": "c512b2f1-bb30-3e7c-9624-32aea993cef1",
                                "text": "Die Rajoys fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "50b4390c-e07c-40bf-bf1a-005332e0f824",
                                "sense_id": "c512b2f1-bb30-3e7c-9624-32aea993cef1",
                                "text": "Der Rajoy trägt nie die Schals, die die Rajoy ihm strickt."
                            },
                            {
                                "example_id": "5288111c-0d24-4170-ae3d-fa50d19893d2",
                                "sense_id": "c512b2f1-bb30-3e7c-9624-32aea993cef1",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Rajoy kommt, geht der Herr Rajoy.“"
                            },
                            {
                                "example_id": "c6aaa176-3b66-4fa6-a728-59ab87ca0c73",
                                "sense_id": "c512b2f1-bb30-3e7c-9624-32aea993cef1",
                                "text": "Rajoy kommt und geht."
                            },
                            {
                                "example_id": "025ea6cc-70fe-46f4-9f24-cab51fa21b75",
                                "sense_id": "c512b2f1-bb30-3e7c-9624-32aea993cef1",
                                "text": "Rajoys kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
