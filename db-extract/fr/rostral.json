                "senses": [
                    {
                        "sense_id": "f77098d4-1738-346c-b808-c94e75ff05c1",
                        "entry_id": "d8032267-dcff-3ce3-87ff-1c9bfcdbfffa",
                        "glosses": [
                            "Relatif au rostre."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "dcf04e3e-b4dc-47dd-9056-c8d98057666c",
                                "sense_id": "f77098d4-1738-346c-b808-c94e75ff05c1",
                                "text": "Couronne, colonne rostrale, couronne, colonne ornée de proues de navires."
                            },
                            {
                                "example_id": "92990690-26ec-4791-b5b7-c2211ff1141b",
                                "sense_id": "f77098d4-1738-346c-b808-c94e75ff05c1",
                                "text": "On décernait la couronne rostrale à celui qui s’était élancé le premier dans le vaisseau ennemi."
                            },
                            {
                                "example_id": "80b35147-74e1-4f00-ae7b-43b9513e6d1a",
                                "sense_id": "f77098d4-1738-346c-b808-c94e75ff05c1",
                                "text": "On érigeait des colonnes rostrales pour consacrer le souvenir des victoires remportées sur mer."
                            }
                        ]
                    },
                    {
                        "sense_id": "900d7704-8d10-3392-800a-c5d6296cb853",
                        "entry_id": "d8032267-dcff-3ce3-87ff-1c9bfcdbfffa",
                        "glosses": [
                            "Relatif au rostre, au haut ou à l'avant de la tête."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4cb8474f-1fec-4bbb-a093-25f3ef67d2cc",
                                "sense_id": "900d7704-8d10-3392-800a-c5d6296cb853",
                                "text": "Ce qui est rostral est supérieur chez les bipèdes et antérieur chez les quadrupèdes."
                            }
                        ]
                    }
