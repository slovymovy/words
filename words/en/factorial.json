{
    "word_family": [
        "factor",
        "factory",
        "factorize",
        "factorization"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bf2e97a9-08a7-3a17-a4fe-075ae7b4133c",
                    "sense_definition": "The mathematical product of an integer and all the positive integers below it, indicated by an exclamation mark.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>factorial</w> of four is calculated as four times three times two times one.",
                            "target_lang_translations": {
                                "zh": "四的<w>阶乘</w>计算为四乘三乘二乘一。"
                            }
                        },
                        {
                            "text": "In mathematics, we write an exclamation mark immediately after a number to represent its <w>factorial</w>.",
                            "target_lang_translations": {
                                "zh": "在数学中，我们在数字后面紧跟一个感叹号来表示它的<w>阶乘</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一个正整数与所有小于它的正整数的乘积，通常用感叹号表示。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "阶乘",
                                "target_lang_sense_clarification": "数学术语，指连乘积"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "182226f5-b141-3413-bc23-f4f41c0525eb",
                    "sense_definition": "Of or relating to mathematical factors or factorials.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The students learned how to compute values using a simple recursive <w>factorial</w> function.",
                            "target_lang_translations": {
                                "zh": "学生们学习了如何使用一个简单的递归<w>阶乘</w>函数来计算数值。"
                            }
                        },
                        {
                            "text": "We can write the product of consecutive integers using standard <w>factorial</w> notation.",
                            "target_lang_translations": {
                                "zh": "我们可以使用标准的<w>阶乘</w>符号来表示连续整数的乘积。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "factorial notation",
                        "factorial function",
                        "factorial experiment",
                        "factorial design"
                    ],
                    "target_lang_definitions": {
                        "zh": "阶乘的；因子的；因子试验的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "阶乘的",
                                "target_lang_sense_clarification": "与阶乘相关的"
                            },
                            {
                                "target_lang_word": "析因的",
                                "target_lang_sense_clarification": "统计学中的因子设计或析因设计"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "89dcb1bc-b93d-3265-ac46-657d7b1a35ff",
                    "sense_definition": "Of or relating to a factor acting as a commercial agent.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "agency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The agent was operating strictly in his <w>factorial</w> capacity when negotiating the sale.",
                            "target_lang_translations": {
                                "zh": "该代理人在商谈销售事宜时，完全是以其<w>代理人</w>身份行事的。"
                            }
                        },
                        {
                            "text": "The merchants reviewed the <w>factorial</w> accounts submitted by their foreign representatives.",
                            "target_lang_translations": {
                                "zh": "商人们审查了其国外代表提交的<w>代理人</w>账目。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "factorial capacity"
                    ],
                    "target_lang_definitions": {
                        "zh": "（商业）代理人的，代销人的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "代理人的",
                                "target_lang_sense_clarification": "与商品代理人或中间人相关的"
                            },
                            {
                                "target_lang_word": "代销人的",
                                "target_lang_sense_clarification": "与商业代销身份相关的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b5d8c8c3-39be-3007-9398-e2c256ce99b9",
                    "sense_definition": "Of or relating to a factory or manufacturing plant.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "industrial",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government introduced new reforms to improve poor <w>factorial</w> working conditions.",
                            "target_lang_translations": {
                                "zh": "政府推行了新的改革以改善恶劣的<w>工厂</w>劳动条件。"
                            }
                        },
                        {
                            "text": "Many rural workers migrated to industrial towns looking for <w>factorial</w> employment.",
                            "target_lang_translations": {
                                "zh": "许多农村劳动力迁徙到工业城镇寻找<w>工厂</w>就业机会。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English in reference to factories"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "工厂的；制造厂的（古旧用法）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "工厂的",
                                "target_lang_sense_clarification": "与工厂或工场相关的（罕用）"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}