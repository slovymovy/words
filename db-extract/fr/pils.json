            {
                "entry_id": "76760099-82df-3d6e-8249-0299ac90bcc5",
                "word": "pils",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1d171fdf-e8b8-3f4f-bd0a-17259caea4dc",
                        "entry_id": "76760099-82df-3d6e-8249-0299ac90bcc5",
                        "glosses": [
                            "Bière blonde de basse fermentation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1558b64f-df6b-481a-a2be-63efe142474f",
                                "sense_id": "1d171fdf-e8b8-3f4f-bd0a-17259caea4dc",
                                "text": "Ramène-moi un bac de pils, s'il-te-plait."
                            },
                            {
                                "example_id": "6a879b3f-8ae5-41ce-aefa-b0e2b06e2514",
                                "sense_id": "1d171fdf-e8b8-3f4f-bd0a-17259caea4dc",
                                "text": "La pils, bière blonde la plus consommée dans le monde, doit son nom à la ville tchèque de Pilsen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "04540359-7900-4bbe-bf09-cd932dca13fe",
                        "source_entry_id": "76760099-82df-3d6e-8249-0299ac90bcc5",
                        "source_sense_id": "1d171fdf-e8b8-3f4f-bd0a-17259caea4dc",
                        "target_lang_word": "Pils",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pils",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a2d27437-c71a-3aaa-b459-0e2d972e3aaf",
                                        "entry_id": "5ccd2775-ca1c-3c21-af69-ebfb7340cf1b",
                                        "glosses": [
                                            "kurz für „Bier nach Pilsener Brauart“, ein untergäriges Bier mit erhöhtem Hopfengehalt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b3c51cc-03d6-41a9-a56d-73c4047a413c",
                                                "sense_id": "a2d27437-c71a-3aaa-b459-0e2d972e3aaf",
                                                "text": "Was darf es sein? - Ein Pils bitte."
                                            },
                                            {
                                                "example_id": "07aac9e0-15cb-4da1-a525-6af0ecea5899",
                                                "sense_id": "a2d27437-c71a-3aaa-b459-0e2d972e3aaf",
                                                "text": "Sollen wir noch ein Pils trinken?"
                                            },
                                            {
                                                "example_id": "71bd54dc-9683-4a32-854d-85724cfc73e9",
                                                "sense_id": "a2d27437-c71a-3aaa-b459-0e2d972e3aaf",
                                                "text": "Zwischen Leber und Milz passt immer ein Pils."
                                            },
                                            {
                                                "example_id": "17330dec-046f-49ad-8744-bc02f498452c",
                                                "sense_id": "a2d27437-c71a-3aaa-b459-0e2d972e3aaf",
                                                "text": "„Nach und nach wurde es am Stammtisch enger und ohne zu fragen, erfüllte Herbert die tausendfach geäußerten Wünsche der gewichtigen Herren, die sich wie eh und je mit Pils und Klarem auf die ernsthaften Wirtshausdebatten kommunaler und globaler Politik einstimmten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3e18f004-1096-4402-9790-5d0813d24996",
                        "source_entry_id": "76760099-82df-3d6e-8249-0299ac90bcc5",
                        "source_sense_id": "1d171fdf-e8b8-3f4f-bd0a-17259caea4dc",
