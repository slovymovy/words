                "senses": [
                    {
                        "sense_id": "33f7c700-2be2-3dd6-bae2-c2fa777ad004",
                        "entry_id": "e84f568f-2860-3012-9fed-eeeb408d2dc3",
                        "glosses": [
                            "Faire perdre son caractère écrit (littéraire, non spontané) à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "276e27b2-88e2-4dce-be0f-d32fc1945977",
                                "sense_id": "33f7c700-2be2-3dd6-bae2-c2fa777ad004",
                                "text": "Plus j’écris, plus le matériau devient littéraire et il faut alors « désécrire » certains passages sur scène qui ne fonctionnent pas."
                            }
                        ]
                    },
                    {
                        "sense_id": "968ae5c6-f612-35ef-9799-ceb053fab22c",
                        "entry_id": "e84f568f-2860-3012-9fed-eeeb408d2dc3",
                        "glosses": [
                            "Écrire en s'émancipant des règles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a7cdb06-0a54-44f7-a070-f043802bd04c",
                                "sense_id": "968ae5c6-f612-35ef-9799-ceb053fab22c",
                                "text": "Le fait même que des auteurs prétendent écrire en s’émancipant des règles – ce qu’on appelle « désécrire » – prouve l’existence de règles."
                            }
                        ]
                    },
                    {
                        "sense_id": "a8c6d676-56bc-3e2e-bc7a-6617b4aa3f7f",
                        "entry_id": "e84f568f-2860-3012-9fed-eeeb408d2dc3",
                        "glosses": [
                            "Défaire (ce qui a été écrit)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0372be97-f8dc-4e87-ae72-4e04534f9986",
                                "sense_id": "a8c6d676-56bc-3e2e-bc7a-6617b4aa3f7f",
                                "text": "Alors, inlassablement, les mots sarclent, tentent de désécrire ce qui s’écrit, si vite que la phrase se met à courir."
                            },
                            {
                                "example_id": "8f20ab41-b2ff-4d69-a0fb-1c59fc522627",
                                "sense_id": "a8c6d676-56bc-3e2e-bc7a-6617b4aa3f7f",
                                "text": "Or il peut arriver qu’écrire soit désécrire, soit soudain un peu dédire l’injustice, contredire la mal-diction, rectifier l’énonciation."
                            }
                        ]
                    }
