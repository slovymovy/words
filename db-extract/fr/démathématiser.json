                        "glosses": [
                            "Ne plus considérer (ou plus uniquement) d'un point de vue mathématique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52acd889-5370-4826-8f95-40bd959116c0",
                                "sense_id": "e1b0af2e-daf0-3390-abe7-ddd4d23c6a49",
                                "text": "Il semble, à première vue, que Bloch ait eu raison de démathématiser le temps afin de marquer la différence de densité entre le temps de l'histoire humaine (...)"
                            },
                            {
                                "example_id": "17104070-249e-4be5-91e3-1649401bcd97",
                                "sense_id": "e1b0af2e-daf0-3390-abe7-ddd4d23c6a49",
                                "text": "Aussi Condillac cherche-t-il moins à « démathématiser » qu'à découvrir le véritable esprit des mathématiques."
                            }
                        ]
                    }
