                                                "sense_id": "ec47896a-7f81-31be-8066-9def4b39adc0",
                                                "text": "Seine Enttäuschung über das Ergebnis war an seinem Gesichtsausdruck abzulesen."
                                            },
                                            {
                                                "example_id": "4738b157-0a1e-466d-8bd9-cd019ce56e85",
                                                "sense_id": "ec47896a-7f81-31be-8066-9def4b39adc0",
                                                "text": "„Zur Enttäuschung gehört die Erkenntnis, dass man sich hat täuschen lassen.“"
                                            },
                                            {
                                                "example_id": "b5cb0803-e666-497a-ac33-6b96d6cf57da",
                                                "sense_id": "ec47896a-7f81-31be-8066-9def4b39adc0",
                                                "text": "„Zu Bolívars Enttäuschung waren die Meinungen gespalten.“"
                                            },
                                            {
                                                "example_id": "84a99927-6c90-4e47-b664-c6947ae8bd66",
                                                "sense_id": "ec47896a-7f81-31be-8066-9def4b39adc0",
                                                "text": "„Doch trotz Barths Enttäuschung beim ersten Anblick Timbuktus ist seine Reise eine Zäsur.“"
                                            },
                                            {
                                                "example_id": "b803400e-4d9c-4d8e-b6d0-61a757bb292b",
                                                "sense_id": "ec47896a-7f81-31be-8066-9def4b39adc0",
                                                "text": "„Ihr Blick spiegelt ihre Enttäuschung wider.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "28674adf-f6c9-3f9e-b11c-73e92fbcf2ae",
                                        "entry_id": "97175493-5ecc-3b77-a477-705cf4ae6093",
                                        "glosses": [
                                            "der Verursacher oder das Objekt der Enttäuschung (nach [1])"
