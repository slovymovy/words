                "senses": [
                    {
                        "sense_id": "04f6594c-8112-3751-b5ea-c4583d83f828",
                        "entry_id": "671c9cbc-98d9-37d1-8bf1-e4596349957a",
                        "glosses": [
                            "To sense or foreshadow impending disaster."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c8185a7-4078-413b-8109-045ea6bf815f",
                                "sense_id": "04f6594c-8112-3751-b5ea-c4583d83f828",
                                "text": "So, on the other hand, when the Day of Grace is set, 'tis easy to imagine how much that Conscience' that now misbodes and condemns us, will be filled with greater and intolerable Despair ;"
                            },
                            {
                                "example_id": "f9b58cab-7fa2-4daa-b7cf-4f7ce0b26f5a",
                                "sense_id": "04f6594c-8112-3751-b5ea-c4583d83f828",
                                "text": "My only desire to be with you, if possibly I could, is to knowe what you must not or dare not write, for I misbode some greate matter."
                            }
                        ]
                    },
                    {
                        "sense_id": "a8a551ef-a7a2-379b-864e-6a20a7a37fed",
                        "entry_id": "671c9cbc-98d9-37d1-8bf1-e4596349957a",
                        "glosses": [
                            "To foreshadow the future incorrectly."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a426fa6f-e800-423d-8a49-5254abe746ab",
                                "sense_id": "a8a551ef-a7a2-379b-864e-6a20a7a37fed",
                                "text": "This was similar to the Rambam's comment that the prophets would be misboded when they would want to attain prophecy, suggesting a link between davening and the prophetic state."
                            }
                        ]
                    }
