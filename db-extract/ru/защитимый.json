                    {
                        "translation_id": "db7d1919-5afe-4d02-a6fb-6a0dca573f78",
                        "source_entry_id": "363883a4-28f2-3d6c-a369-d700ea49ead9",
                        "source_sense_id": "ba96df0d-9aee-3064-a021-789f39b4a660",
                        "target_lang_word": "défendable",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "défendable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cad0d805-1219-3f4d-b7ca-d958cbd3643a",
                                        "entry_id": "ae0634e6-f961-3e9c-85d2-15170f7fe6d7",
                                        "glosses": [
                                            "Qui peut être défendu contre une agression."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14e332bf-22b0-4c69-ae6c-29e45f2589d6",
                                                "sense_id": "cad0d805-1219-3f4d-b7ca-d958cbd3643a",
                                                "text": "L’Empire romain, qui s’étendait des sables d'Arabie jusqu'aux neiges d'Écosse, fut constamment à la recherche de frontières défendables."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8730c47c-f6ba-3b0c-a8c9-06a563d040b5",
                                        "entry_id": "ae0634e6-f961-3e9c-85d2-15170f7fe6d7",
                                        "glosses": [
                                            "Qui peut être soutenu, justifiable, soutenable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f601fcd-4699-4fbd-8277-bd1d59e5699c",
                                                "sense_id": "8730c47c-f6ba-3b0c-a8c9-06a563d040b5",
                                                "text": "L'opinion, la thèse que vous soutenez est défendable."
                                            },
                                            {
                                                "example_id": "28344ee0-4ff7-4012-a0d0-b654b8dabff7",
                                                "sense_id": "8730c47c-f6ba-3b0c-a8c9-06a563d040b5",
                                                "text": "Il y a dix-huit mois, un jeune physicien américain, M. David Bohm, a repris, d'ailleurs avec talent, mes anciennes idées sous la forme tronquée et peu défendable de l'onde-pilote."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
