    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "dc7f69cd-35c5-37c6-93b6-a9b96a2abb73",
                "word": "skerrick",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "c24abd77-9b86-473d-844f-3ba1a4fc9e90",
                        "entry_id": "dc7f69cd-35c5-37c6-93b6-a9b96a2abb73",
                        "tags": [
                            "plural"
                        ],
                        "form": "skerricks"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7f646fe8-b53d-36a6-9279-81064ce544b1",
                        "entry_id": "dc7f69cd-35c5-37c6-93b6-a9b96a2abb73",
                        "glosses": [
                            "A very small amount or portion; the least bit."
                        ],
                        "tags": [
                            "Australia",
                            "New-Zealand"
                        ],
                        "examples": [
                            {
                                "example_id": "1eae9bd3-f18b-4a76-859f-7e1412659920",
                                "sense_id": "7f646fe8-b53d-36a6-9279-81064ce544b1",
                                "text": "He stood in front of Vonnie Kyle and his eyes examined hers with every skerrick of judgment he could muster.’"
                            },
                            {
                                "example_id": "5bf05380-faf6-4dff-9136-aebe2488734e",
                                "sense_id": "7f646fe8-b53d-36a6-9279-81064ce544b1",
                                "text": "When he reached this point in his madness, it disabled whatever skerrick of common sense he might have had even to save himself."
                            },
                            {
                                "example_id": "84c3edd7-7e80-4356-9196-2c101369f594",
                                "sense_id": "7f646fe8-b53d-36a6-9279-81064ce544b1",
                                "text": "\"And all I can think is that they're seeing a crumb, a skerrick of what it once was\"."
                            }
                        ]
                    }
                ],
                "translations": [],
