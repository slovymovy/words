                    {
                        "sense_id": "512b9f97-6c68-3870-879b-ce008f3342b0",
                        "entry_id": "10fdc2d4-3193-3bfb-8ea8-b310640d4a20",
                        "glosses": [
                            "Cépage originaire d'Italie, donnant du raisin noir. Il a été utilisé par la famille Bouschet pour créer par hybridation de nombreux autres cépages."
                        ],
                        "tags": [
                            "Viticulture"
                        ],
                        "examples": [
                            {
                                "example_id": "bca17626-f477-4b96-933e-c3f474f3b901",
                                "sense_id": "512b9f97-6c68-3870-879b-ce008f3342b0",
                                "text": "On devine la colère dans laquelle entra le docteur, en retrouvant sur le gazon le cadavre d'une bouteille de tokai, les cadavres de deux bouteilles de johannisberg et de trois bouteilles d’alicante."
                            },
                            {
                                "example_id": "0b793b9b-2c62-40f7-8c86-a258435772ea",
                                "sense_id": "512b9f97-6c68-3870-879b-ce008f3342b0",
                                "text": "Deux laquais firent le tour de la table, versant de l’alicante et du tokai."
                            }
                        ]
                    },
                    {
                        "sense_id": "091b1957-a26d-310e-a14a-19fb727c8518",
                        "entry_id": "10fdc2d4-3193-3bfb-8ea8-b310640d4a20",
                        "glosses": [
                            "Synonyme de nombreux autres cépages selon les régions : merlot noir, muscat d'Alexandrie, teinturier, de monastrell, etc."
