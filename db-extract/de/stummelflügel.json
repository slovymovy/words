                "senses": [
                    {
                        "sense_id": "c167e5c8-7bb5-3144-923e-5ac33c7bb2a7",
                        "entry_id": "f76c7f16-265a-37b8-b9f8-afea40acff39",
                        "glosses": [
                            "kurzer, stummelartiger Flügel eines Vogels"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06039490-0d6f-4ea4-ad03-7a5e84948f17",
                                "sense_id": "c167e5c8-7bb5-3144-923e-5ac33c7bb2a7",
                                "text": "„Auf der öden Küste und der hochragenden Eisbarriere im Hintergrund kreischten Myriaden grotesker Pinguine und schlugen mit ihren Stummelflügeln, während sich im Wasser fette Seehunde tummelten, die umherschwammen oder über große Schollen langsam treibenden Eises robbten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3b9c54de-6d56-31e0-b47f-18654b43bc40",
                        "entry_id": "f76c7f16-265a-37b8-b9f8-afea40acff39",
                        "glosses": [
                            "kurzer Flügel eines Luftfahrzeugs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13a44cdb-acae-4163-bb54-4f83599b14a1",
                                "sense_id": "3b9c54de-6d56-31e0-b47f-18654b43bc40",
                                "text": "„Der Z-10 war die chinesische Entsprechung zum AH-64 Apache, ein Kampfhubschrauber mit einem abgestuften Cockpit, einer 30-Millimeter-Bugkanone und Stummelflügeln, unter denen eine Auswahl an Panzerabwehr- und Luft-Luft-Raketen montiert war.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
