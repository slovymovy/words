                    }
                ],
                "translations": [
                    {
                        "translation_id": "b8c5009f-aa24-40b6-aa1d-11ee824df9ad",
                        "source_entry_id": "8e22b7f4-3ee9-3d0c-9532-881ab1d9db76",
                        "source_sense_id": "b0257ae8-d281-3ed7-b93f-417c36a27dcf",
                        "target_lang_word": "khaki green",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "khaki green",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b949805c-418e-3792-ba47-539ec388223e",
                                        "entry_id": "a36cbd1f-9b21-3ae8-b117-309bba944ebb",
                                        "glosses": [
                                            "A colour between khaki and green; light olive drab."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f0b37fe-8f32-4524-ab83-063e9c35f984",
                                                "sense_id": "b949805c-418e-3792-ba47-539ec388223e",
                                                "text": "Rae wore khaki-green. Khaki-green and khaki-brown were his favourite colours, his image."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "khaki green",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "124b64e7-0117-3ee6-aad0-dc9feb3dfed9",
                                        "entry_id": "c9837b73-2d00-3410-911a-7add2fc12e0d",
                                        "glosses": [
                                            "Of a khaki green colour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f96a68a-71e2-4bdf-bc5e-39e5f1b6e44a",
                                                "sense_id": "124b64e7-0117-3ee6-aad0-dc9feb3dfed9",
                                                "text": "Roll ⅓ oz (10 g) khaki green fondant into a ball and flatten it to make the cap."
                                            },
                                            {
                                                "example_id": "8b585b64-ca21-41f2-b861-b90320e4407b",
                                                "sense_id": "124b64e7-0117-3ee6-aad0-dc9feb3dfed9",
                                                "text": "The trim number for the khaki green models was 1-201, and for the bronze green models, 2-201."
                                            },
                                            {
                                                "example_id": "6f68d557-6383-40d4-9243-d17f73b0acc3",
                                                "sense_id": "124b64e7-0117-3ee6-aad0-dc9feb3dfed9",
                                                "text": "The young man wore [...] a khaki-green t-shirt and shorts."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d3a0ca06-39cf-435b-961a-44556119fe9e",
                        "source_entry_id": "8e22b7f4-3ee9-3d0c-9532-881ab1d9db76",
                        "source_sense_id": "3a8e5b86-9243-3d96-8850-10500f343440",
                        "target_lang_word": "khaki",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "khaki",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "955093b7-258a-3045-9fce-f3dd80da9f47",
                                        "entry_id": "c2ad6fa6-1ced-3687-b9bf-fc907d7b7912",
                                        "glosses": [
                                            "A dull, yellowish-brown colour, the colour of dust."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "596118cf-1c95-4245-bb33-f8151c4e6de8",
                                                "sense_id": "955093b7-258a-3045-9fce-f3dd80da9f47",
                                                "text": "When you've shouted \"Rule Britannia\", when you've sung \"God Save The Queen\",\nWhen you've finished killing Kruger with your mouth;\nWill you kindly drop a shilling in my little tambourine\nFor a gentleman in khaki ordered South?"
                                            },
                                            {
                                                "example_id": "bcf2a5bd-d91c-43d4-8f8f-413fab59fa7f",
                                                "sense_id": "955093b7-258a-3045-9fce-f3dd80da9f47",
                                                "text": "But being the right shade of khaki or shit-brown is not enough."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd8339f8-6bb0-3806-97f7-699404a410ee",
                                        "entry_id": "c2ad6fa6-1ced-3687-b9bf-fc907d7b7912",
                                        "glosses": [
                                            "Khaki green, a dull green colour."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a1cdbc7-0788-4731-9e71-219bd2063a7b",
                                                "sense_id": "dd8339f8-6bb0-3806-97f7-699404a410ee",
                                                "text": "1921, War work of the Bureau of Standards, no. 46, page 54.\nThe English Government for a long time has used a type of pigmented dope cover, khaki colored by iron pigments and lampblack, which is called P. C. 10."
                                            },
                                            {
                                                "example_id": "818a96a2-2494-4115-bdbb-c7ef6789e20c",
                                                "sense_id": "dd8339f8-6bb0-3806-97f7-699404a410ee",
                                                "text": "2007, Yuji Matsuki, American Fighters Over Europe: Colors & Markings of USAAF Fighters in WWII, page 4, →ISBN.\nAt the end of World War I, the U.S. Army Air Service painted everything khaki. This khaki was practically the same as British PC10 and can be considered the basis of the later olive drab color."
                                            },
                                            {
                                                "example_id": "1f0d8564-2982-4cc0-9d47-11300192bdea",
                                                "sense_id": "dd8339f8-6bb0-3806-97f7-699404a410ee",
                                                "text": "In these notes we have used the British rather than the US terms for colours: i.e. 'khaki' here means the drab brown - US 'olive drab' - used for woolen uniforms and 'khaki drill' for the pale yellowish tan - US 'khaki' - used for lightweight summer/tropical dress."
                                            },
                                            {
                                                "example_id": "0062eca6-5e94-4aa6-93bd-41f1e7674afb",
                                                "sense_id": "dd8339f8-6bb0-3806-97f7-699404a410ee",
                                                "text": "The very loose seroual trousers were made in both sand-khaki drill, and in winter-weight khaki wool for wear with the M1946 battledress blouse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4896e513-8a32-33a2-ae6c-805de086464f",
                                        "entry_id": "c2ad6fa6-1ced-3687-b9bf-fc907d7b7912",
                                        "glosses": [
                                            "A strong cloth of wool or cotton, often used for military or other uniforms."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e105a5a7-6296-3378-b266-1e08da3070fd",
                                        "entry_id": "c2ad6fa6-1ced-3687-b9bf-fc907d7b7912",
                                        "glosses": [
                                            "A soldier wearing a khaki uniform."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rare",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "306275f5-4db8-3223-8d5d-801524c9c6bc",
                                        "entry_id": "c2ad6fa6-1ced-3687-b9bf-fc907d7b7912",
                                        "glosses": [
                                            "A British person."
                                        ],
                                        "tags": [
                                            "South-Africa",
                                            "countable",
                                            "derogatory",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87cf7860-ae5b-405c-afe4-0cb5ab089a1f",
                                                "sense_id": "306275f5-4db8-3223-8d5d-801524c9c6bc",
                                                "text": "\"Frank, it's a khaki,\" I whisper, \"keep straight on.\""
                                            },
                                            {
                                                "example_id": "03cd9da5-6ed2-4021-a4b6-f004f5221bc7",
                                                "sense_id": "306275f5-4db8-3223-8d5d-801524c9c6bc",
                                                "text": "War and then victory raised patriotic sentiment inside Britain and brought the Colonial Secretary national popularity. Unionists were quick to milk this with a 'khaki' election in 1900 at which they won a massive landslide."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8dd25875-3a49-3577-9d4d-d745f0682abe",
                                        "entry_id": "c2ad6fa6-1ced-3687-b9bf-fc907d7b7912",
                                        "glosses": [
                                            "Khaki clothing or uniform."
                                        ],
                                        "tags": [
                                            "countable",
                                            "in-plural",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba8e4669-a45f-4c3e-83fa-3afc147f98cd",
                                                "sense_id": "8dd25875-3a49-3577-9d4d-d745f0682abe",
                                                "text": "1915 Out West magazine\nThe porter in going through the rear coach, which was almost empty, noticed one of the occupants, a muscular, soldierly man in khakies to be apparently asleep in his seat."
                                            }
                                        ]
                                    }
                                ]
                            },
