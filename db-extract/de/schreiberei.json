                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "aef642d1-aca4-443c-83c3-2c31cd0abfda",
                                "sense_id": "3807c6ab-bcaa-331b-8848-80980acbb24e",
                                "text": "„Und immer wieder musste ich den vielen Freunden und Verwandten eine neue Adresse melden und hatte doch schon an meinem Tagebuch genug Schreiberei.“"
                            },
                            {
                                "example_id": "cf5e0c13-aa26-4952-8dfa-ac81069c7471",
                                "sense_id": "3807c6ab-bcaa-331b-8848-80980acbb24e",
                                "text": "„An diesem Sonntag wurde es mit der weiteren Schreiberei nichts, die begonnene Karte blieb unvollendet in dem Radiobastelbuch Ottochens liegen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
