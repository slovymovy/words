                ],
                "translations": [
                    {
                        "translation_id": "8263cce1-2a02-4a4d-9ae4-b319c4c8dc82",
                        "source_entry_id": "f150d6e3-8987-3a95-9925-b5512e3d80f0",
                        "source_sense_id": "7474063b-f848-3275-b75f-a5889173be4e",
                        "target_lang_word": "moonshine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "moonshine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "11f37a6b-4768-3ed3-9938-3c6aa4995d91",
                                        "entry_id": "5cf79f20-9d39-38b2-a62f-4acd22fb224c",
                                        "glosses": [
                                            "The light of the moon."
                                        ],
                                        "tags": [
                                            "countable",
                                            "literally",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b50462f-ba6b-4a1c-b803-5c789af22c52",
                                                "sense_id": "11f37a6b-4768-3ed3-9938-3c6aa4995d91",
                                                "text": "[…] her Waggon Spokes made of long Spinners legs: the Couer of the wings of Graſhoppers, her Traces of the ſmalleſt Spiders web, her coullers of the Moonſhines watry Beames […]"
                                            },
                                            {
                                                "example_id": "1e0963be-f20b-4bad-a996-ac72ce202bd6",
                                                "sense_id": "11f37a6b-4768-3ed3-9938-3c6aa4995d91",
                                                "text": "[…] the newes coming every moment of the growth of the fire; so as we were forced to begin to pack up our owne goods; and prepare for their removal; and did by moonshine (it being brave dry, and moonshine, and warm weather) carry much of my goods into the garden […]"
                                            },
                                            {
                                                "example_id": "7786b7d1-93cf-4025-95d6-c0d709bbd921",
                                                "sense_id": "11f37a6b-4768-3ed3-9938-3c6aa4995d91",
                                                "text": "[…] I have been in an Ague fit, ever ſince ſhut of Evening; what with the fright of Trees by the High-way, which look'd maliciouſly like Thieves, by Moon-ſhine: and what with Bulruſhes by the River-ſide, that ſhak'd like Spears, and Lances at me."
                                            },
                                            {
                                                "example_id": "09cbe86f-e855-431c-86ba-5f924d488a42",
                                                "sense_id": "11f37a6b-4768-3ed3-9938-3c6aa4995d91",
                                                "text": "[…] O Nymph more bright than moon-ſhine night, like Kidlings blithe and merry […]"
                                            },
                                            {
                                                "example_id": "dcac703a-622c-4286-9fed-a52c890e2ec3",
                                                "sense_id": "11f37a6b-4768-3ed3-9938-3c6aa4995d91",
                                                "text": "In mist or cloud on mast or shroud / It perch’d for vespers nine, / Whiles all the night thro’ fog smoke-white / Glimmer’d the white moon-shine."
                                            },
                                            {
                                                "example_id": "9e0d9bde-16ed-4d10-b876-572e200ecb4d",
                                                "sense_id": "11f37a6b-4768-3ed3-9938-3c6aa4995d91",
                                                "text": "So I came forth of the sea and sat down on the edge of an island in the moonshine, where a passer-by found me and, carrying me to the his house, besought me of love-liesse; but I smote him on the head, so that he all but died; whereupon he carried me forth and sold me to the merchant from whom thou hadst me, […]"
                                            },
                                            {
                                                "example_id": "7114cc56-acca-4d92-accd-5068ad04601b",
                                                "sense_id": "11f37a6b-4768-3ed3-9938-3c6aa4995d91",
                                                "text": "“[…] it would be lovely to sleep in a wild cherry-tree all white with bloom in the moonshine, don’t you think? […]”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9bc70a71-903b-3d6b-ac1f-c06c06ba8b2a",
                                        "entry_id": "5cf79f20-9d39-38b2-a62f-4acd22fb224c",
                                        "glosses": [
                                            "High-proof alcohol (especially whiskey) that is often, but not always, produced illegally."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64788f5d-847e-478e-9658-4fb85f34cc41",
                                                "sense_id": "9bc70a71-903b-3d6b-ac1f-c06c06ba8b2a",
                                                "text": "They watered down the moonshine."
                                            },
                                            {
                                                "example_id": "7ebe9d06-14a6-4bf4-b34a-cb4da6d45e01",
                                                "sense_id": "9bc70a71-903b-3d6b-ac1f-c06c06ba8b2a",
                                                "text": "“Wish I'd been more polite to that girl,” the sheriff remarked regretfully. […] I know she’d have give me another drink of that old moonshine she has.”"
                                            },
                                            {
                                                "example_id": "0e927e8e-c195-423e-9bde-9f9461c065c0",
                                                "sense_id": "9bc70a71-903b-3d6b-ac1f-c06c06ba8b2a",
                                                "text": "My great grandpa was a blues lover / He'd be rockin' his moonshine to B.B. King and Jimmy Reed"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d8bee3f-9003-3fc4-a279-6cdbfefc7c37",
                                        "entry_id": "5cf79f20-9d39-38b2-a62f-4acd22fb224c",
                                        "glosses": [
                                            "smuggled spirits, often with a specific sense; (Kent, Sussex) white brandy; (Yorkshire) gin."
                                        ],
                                        "tags": [
                                            "England",
                                            "archaic",
                                            "countable",
                                            "dialectal",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3122ecf3-e0c8-3369-a8fb-e2761ba26e30",
                                        "entry_id": "5cf79f20-9d39-38b2-a62f-4acd22fb224c",
                                        "glosses": [
                                            "Nonsense."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4f306cc-60af-4e4c-aa97-42c6c29f3744",
                                                "sense_id": "3122ecf3-e0c8-3369-a8fb-e2761ba26e30",
                                                "text": "He was talking moonshine."
                                            },
                                            {
                                                "example_id": "920bbf58-8422-4bc4-be16-14c49d26c9c7",
                                                "sense_id": "3122ecf3-e0c8-3369-a8fb-e2761ba26e30",
                                                "text": "“[…] But sometimes you might make the wrong decisions, comrades, and then where should we be? Suppose you had decided to follow Snowball, with his moonshine of windmills—Snowball, who, as we now know, was no better than a criminal?”"
                                            },
                                            {
                                                "example_id": "db1c5c89-c971-4610-8b20-2f2d8f58094c",
                                                "sense_id": "3122ecf3-e0c8-3369-a8fb-e2761ba26e30",
                                                "text": "We forget what we have learned in the last 60 years. At university I once asked one of my lecturers why he was not talking to us about continental drift and I was told, sneeringly, that if I could I prove there was a force that could move continents, then he might think about it. The idea was moonshine, I was informed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76a9d3d1-f17e-32eb-8374-203dc15733b7",
                                        "entry_id": "5cf79f20-9d39-38b2-a62f-4acd22fb224c",
                                        "glosses": [
                                            "A branch of pure mathematics relating the Monster group to an invariant of elliptic functions."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ebde20f0-8ff2-3c80-841c-d82645472277",
                                        "entry_id": "5cf79f20-9d39-38b2-a62f-4acd22fb224c",
                                        "glosses": [
                                            "A spiced dish of eggs and fried onions."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5c98904a-f169-37ce-832f-4cdb29b62d38",
                                        "entry_id": "5cf79f20-9d39-38b2-a62f-4acd22fb224c",
                                        "glosses": [
                                            "A month."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c88dac63-5306-47b1-9689-4050e7c36f20",
                                                "sense_id": "5c98904a-f169-37ce-832f-4cdb29b62d38",
                                                "text": "[…] wherefore ſhould I / Stand in the plague of cuſtome, and permit / The curioſity of Nations to depriue me? / For that I am ſome twelue, or fourteene Moonſhines / Lag of a brother?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "moonshine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "283deddd-e78c-3d5b-8b9a-0e7cc1de93be",
                                        "entry_id": "c8e130a6-1e88-3bc1-a4b4-bd6917d8e27f",
                                        "glosses": [
                                            "To make homemade (especially, illicit) alcohol, especially distilled spirits."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "780d4d87-0978-424a-8a15-3f2a5d94dc52",
                                                "sense_id": "283deddd-e78c-3d5b-8b9a-0e7cc1de93be",
                                                "text": "His grandfather started to moonshine when things got really bad in 1933; when he got caught moonshining, he did a bit of time."
                                            },
                                            {
                                                "example_id": "7e880409-034e-4709-8e0b-0d169213a5de",
                                                "sense_id": "283deddd-e78c-3d5b-8b9a-0e7cc1de93be",
                                                "text": "Tommy is seventy-seven years old. He started moonshining at the age of seven. He was working for an outfit by the age of eight. He worked for the outfit fulltime until he was sixteen. He moonshined off and on until his mid-twenties. He works at a sawmill now as well."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c95f6a05-cb65-34c1-8e10-11e9efbc562c",
                                        "entry_id": "c8e130a6-1e88-3bc1-a4b4-bd6917d8e27f",
                                        "glosses": [
                                            "To make (an ingredient) into such a drink."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa44681a-7a2d-40b2-a094-f12e53a7933b",
                                                "sense_id": "c95f6a05-cb65-34c1-8e10-11e9efbc562c",
                                                "text": "A more practical critic notes that paleolithic man had a very sweet tooth, which he sated with honey. Worse, he moonshined the honey into metheglin, an alcoholic brew. Booze and junk food, in other words, are hardly modern inventions."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "18623d87-950b-4bf7-912a-f7652220d661",
                        "source_entry_id": "f150d6e3-8987-3a95-9925-b5512e3d80f0",
                        "source_sense_id": "7474063b-f848-3275-b75f-a5889173be4e",
                        "target_lang_word": "самогон",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "самогон",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "312c0333-4f7b-3208-baf9-e079e91360fe",
                                        "entry_id": "359bd2cb-9795-3eba-9a3a-ac2df866c13a",
                                        "glosses": [
                                            "алкогольный напиток высокой крепости домашнего приготовления"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38669c5e-cc29-498f-bca1-5e0ec7bc7651",
                                                "sense_id": "312c0333-4f7b-3208-baf9-e079e91360fe",
                                                "text": "Большевики всё время разъезжают по Лебяжьем пьют самогон и курей жарют и запалили квартиры служащих от казармы и до краю."
                                            },
                                            {
                                                "example_id": "6776c02b-ebb4-41cb-9868-08963394eb51",
                                                "sense_id": "312c0333-4f7b-3208-baf9-e079e91360fe",
                                                "text": "Удалось, наконец, повидать, как изготовляют самогон."
                                            },
                                            {
                                                "example_id": "702e1ab4-ca0e-4355-856d-8e6d8852de8c",
                                                "sense_id": "312c0333-4f7b-3208-baf9-e079e91360fe",
                                                "text": "Выпил комиссар чашку самогону и уехал: спасибо, говорит, товарищ Пашинцев."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
