                "senses": [
                    {
                        "sense_id": "faab26cd-18ae-3f7a-9eaf-57737d03005e",
                        "entry_id": "2e8b53e7-fc07-3bee-be33-d69aa8875523",
                        "glosses": [
                            "van iemand dat hij of zij fijngebouwd is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "216f0635-69aa-40d8-8962-4700b829e3f2",
                                "sense_id": "faab26cd-18ae-3f7a-9eaf-57737d03005e",
                                "text": "De wissel van Paolo Fernandes, die volgens Vreven een goede wedstrijd speelde, was ingegeven door kramp. De frêle linkspoot maakte na een uur plaats voor Mitchell te Vrede."
                            },
                            {
                                "example_id": "ddc21619-6cd1-4a5c-b673-8ae8ae6d3c72",
                                "sense_id": "faab26cd-18ae-3f7a-9eaf-57737d03005e",
                                "text": "Mexico Stad: frêle crimefighter: Je moet het maar durven, burgemeester worden van Mexico's hoofdstad. Tijdens de meest recente verkiezingscampagne (1 juli waren verkiezingen voor zowel de burgemeester als de president van het land) zijn meer dan 130 kandidaten vermoord, veelal door drugsbendes, die een bevriende politicus in het zadel probeerden te helpen. Claudia Sheinbaum Pardo (56) bood kiezers die het geweld en de corruptie van de gevestigde macht beu zijn een alternatief."
                            },
                            {
                                "example_id": "0b384195-d0b5-4859-a6f6-324007945907",
                                "sense_id": "faab26cd-18ae-3f7a-9eaf-57737d03005e",
                                "text": "Hij knipoogde vet en gebaarde zogenaamd opvallend met zijn dikke hoofd in de richting van de deur, waar op dat moment de frêle gedaante van een lange, magere vrouw in een lange, witte jurk de Chinese kamer binnenzweefde."
                            }
                        ]
                    }
