                "senses": [
                    {
                        "sense_id": "bd12d0c1-a049-3df1-933a-206c35f8c485",
                        "entry_id": "7e700562-6be3-3d9f-bb2f-da6a49b57b99",
                        "glosses": [
                            "The property of being scrupulous; excessive attention to scruples."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "18f197af-3d13-4ae9-ac29-bdde83aed986",
                                "sense_id": "bd12d0c1-a049-3df1-933a-206c35f8c485",
                                "text": "So then the whole scripture of God, being true, whence soever this be delivered and gathered, it skilleth not: And it is of us to be taken without curious scrupulosity, as sacred and undoubted scripture, seeing it was written by the holy apostle, into whom the holy Ghost was inspired, as is witnessed."
                            },
                            {
                                "example_id": "6cda7954-e817-4d35-9888-c2506a57967f",
                                "sense_id": "bd12d0c1-a049-3df1-933a-206c35f8c485",
                                "text": "Age looks with anger on the temerity of youth, and youth with contempt on the scrupulosity of age."
                            },
                            {
                                "example_id": "feea45d6-5b61-4d6e-ab92-ab04e7653454",
                                "sense_id": "bd12d0c1-a049-3df1-933a-206c35f8c485",
                                "text": "Why should an auctioneer and appraiser thirty years ago, who had as good as forgotten his free-school Latin, be expected to manifest a delicate scrupulosity which is not always exhibited by gentlemen of the learned professions, even in our present advanced stage of morality?"
                            },
                            {
                                "example_id": "05e8622f-9a99-4b3b-8abe-14a8fdce83d4",
                                "sense_id": "bd12d0c1-a049-3df1-933a-206c35f8c485",
                                "text": "His queer air of listening to himself, the way he had of responding to his own idea in a complex sequence of feelings by a wavering, then pinched smile and a line of doubt drawn on his forehead—such scrupulosity vaguely irritated me."
                            }
                        ]
                    }
                ],
