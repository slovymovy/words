                    {
                        "sense_id": "e4d04b16-30ca-356b-b466-9faf77fbb29a",
                        "entry_id": "895124c8-701a-343c-bfb4-a05403f58cb1",
                        "glosses": [
                            "Pronom démonstratif utilisé pour référer à des personnes dont le genre social est non-binaire ou inconnu."
                        ],
                        "tags": [
                            "Variations diaéthiques"
                        ],
                        "examples": [
                            {
                                "example_id": "e2d06262-c103-4330-bd4e-1b867ab34e55",
                                "sense_id": "e4d04b16-30ca-356b-b466-9faf77fbb29a",
                                "text": "Merci aux activistes-expert·e·s qui m’ont appris toutes ces choses, merci à çauz qui m’ont aidée à réviser ce lexique, et merci aux personnes des communautés LGBTQIA2S+."
                            },
                            {
                                "example_id": "2bfe5159-4b67-4690-8d44-08de9c6d5ca0",
                                "sense_id": "e4d04b16-30ca-356b-b466-9faf77fbb29a",
                                "text": "Après chaque discussion, on garde une trace : pour y revenir quand on a oublié, pour çauz qui n’étaient pas là, pour çauz qui n’y sont pas encore."
                            },
                            {
                                "example_id": "82fa30eb-a9fd-4deb-bf08-39a2b20dc6ec",
                                "sense_id": "e4d04b16-30ca-356b-b466-9faf77fbb29a",
                                "text": "En tout cas, ces groupes non-mixtes sont souvent décriés par çauz qui trouve qu'une tribune ou une direction d'entreprise exclusivement masculine est normal et résulte de compétences individuelles."
                            }
                        ]
                    }
