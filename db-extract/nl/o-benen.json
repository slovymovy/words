                        "source_sense_id": "b979beaa-82ff-372d-a8e2-9baa090b8ceb",
                        "source_sense_description": "afwijking van de normale stand van de benen, waarbij de knieën naar buiten staan",
                        "target_lang_word": "O-Beine",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "O-Beine",
