                "senses": [
                    {
                        "sense_id": "edcf6187-50e9-3810-ad3a-cecce7881b19",
                        "entry_id": "d8ac6738-e867-31d7-9cf3-bbf01b170cd5",
                        "glosses": [
                            "Wendemöglichkeit für ein Fahrzeug"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c77d8530-6393-49cb-8e01-fc2b9985034b",
                                "sense_id": "edcf6187-50e9-3810-ad3a-cecce7881b19",
                                "text": "„In der Wendeanlage am Klinikum Großhadern wurde jeder Zug immer wieder mit Sprengstoffhunden abgesucht, bevor er sich erneut auf den Weg zum Stadion machte.“"
                            },
                            {
                                "example_id": "d17f9e68-3018-4066-8d21-dc39cc945d27",
                                "sense_id": "edcf6187-50e9-3810-ad3a-cecce7881b19",
                                "text": "„Dort ist der Einstieg verboten, damit das Fahrzeug die Wendeanlage ohne Fahrgäste befahren kann und dem Personal eine Ruhepause ermöglicht wird.“"
                            },
                            {
                                "example_id": "8046cfcd-4852-407b-a156-988e1d24127f",
                                "sense_id": "edcf6187-50e9-3810-ad3a-cecce7881b19",
                                "text": "„Der zunehmende Messeverkehr erforderte den Bau einer sehr großzügig ausgelegten Wendeanlage am nördlichen Ende des Messegeländes (1961).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
