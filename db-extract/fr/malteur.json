                "senses": [
                    {
                        "sense_id": "c4b822f6-48a1-32a1-b153-79f2a03e4a13",
                        "entry_id": "3de1ce80-3f7b-3277-9eb1-59a8dae994a4",
                        "glosses": [
                            "Ouvrier chargé de la préparation du malt pour les brasseurs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4df3669-f0ab-43a6-8c00-a82b00b73fc1",
                                "sense_id": "c4b822f6-48a1-32a1-b153-79f2a03e4a13",
                                "text": "Non sans peine, il a fini par trouver un malteur, en Belgique, qui accepte de traiter sa récolte pour en faire du malt."
                            }
                        ]
                    },
                    {
                        "sense_id": "33938524-ae18-3ab2-9c76-e460b1bb7edd",
                        "entry_id": "3de1ce80-3f7b-3277-9eb1-59a8dae994a4",
                        "glosses": [
                            "Propriétaire ou tenancier d’une brasserie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c82f0973-0121-44c7-a37c-1110b0001627",
                                "sense_id": "33938524-ae18-3ab2-9c76-e460b1bb7edd",
                                "text": "Je ne puis pas faire proposer à la Chambre de faire ce qu’a fait le parlement anglais : en 1883, en face d’une situation analogue, il a décidé que tous les commissionnaires, les marchands, les malteurs, les brasseurs seraient obligés de déclarer à un agent spécial de la reine, la quantité, le poids, le prix des grains qu’ils auraient achetés dans la semaine."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5f1eeaae-4641-4882-8945-978e207ebc0b",
                        "source_entry_id": "3de1ce80-3f7b-3277-9eb1-59a8dae994a4",
                        "target_lang_word": "Mälzer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mälzer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3786f9f3-c4ab-3d3c-b48f-8542f7cc7b54",
                                        "entry_id": "2c730683-e905-3c48-9ff5-a9ca08facd4f",
                                        "glosses": [
                                            "Person, die Malz herstellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27006a6b-361b-4761-b338-902a767d66a7",
                                                "sense_id": "3786f9f3-c4ab-3d3c-b48f-8542f7cc7b54",
                                                "text": "„Ein qualifizierter Schulabschluss genügt als Voraussetzung für eine drei Jahre dauernde Ausbildung zum Brauer und Mälzer.“"
                                            },
                                            {
                                                "example_id": "6f081352-f6c5-43ec-b8ba-b3dc13a9c59f",
                                                "sense_id": "3786f9f3-c4ab-3d3c-b48f-8542f7cc7b54",
                                                "text": "„Die Lehrabschlußprüfung im Lehrberuf Brauer und Mälzer gliedert sich in eine praktische und in eine theoretische Prüfung.“"
                                            },
                                            {
                                                "example_id": "3f5902de-ae99-4fbf-9622-89712083bff2",
                                                "sense_id": "3786f9f3-c4ab-3d3c-b48f-8542f7cc7b54",
                                                "text": "„Dadurch, daß der Mälzer die wärmere Lage der Haufen höher oder weniger hoch wirft, vermag er eine stärkere oder weniger starke Abkühlung derselben zu erreichen, je nachdem dies erforderlich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Mälzer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c8ac84b5-8439-3037-84f5-90d11170dd9f",
                                        "entry_id": "2ff68422-0018-3e9d-8bde-02b1d5ba6548",
                                        "glosses": [
                                            "deutscher Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25ad0da8-8b5d-449b-af80-e945fd1e3e6f",
                                                "sense_id": "c8ac84b5-8439-3037-84f5-90d11170dd9f",
                                                "text": "Frau Mälzer ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "a9b49ea8-b3f9-48c1-b01e-ca7762f22ba3",
                                                "sense_id": "c8ac84b5-8439-3037-84f5-90d11170dd9f",
                                                "text": "Herr Mälzer wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "6bd3e825-cbdb-4f96-b0fa-df64aa55cf68",
                                                "sense_id": "c8ac84b5-8439-3037-84f5-90d11170dd9f",
                                                "text": "Die Mälzers fliegen heute nach La Paz."
                                            },
                                            {
                                                "example_id": "2a3375be-fa1d-4873-838d-a33ed8548f91",
                                                "sense_id": "c8ac84b5-8439-3037-84f5-90d11170dd9f",
                                                "text": "Der Mälzer trägt nie die Schals, die die Mälzer ihm strickt."
                                            },
                                            {
                                                "example_id": "c55f21d8-a3db-42bc-9d13-71ea43c97811",
                                                "sense_id": "c8ac84b5-8439-3037-84f5-90d11170dd9f",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Mälzer kommt, geht der Herr Mälzer.“"
                                            },
                                            {
                                                "example_id": "9fb50541-751c-414c-ad2f-f4016024ee78",
                                                "sense_id": "c8ac84b5-8439-3037-84f5-90d11170dd9f",
                                                "text": "Mälzer kommt und geht."
                                            },
                                            {
                                                "example_id": "32e19f46-4aa8-477d-a022-165150381619",
                                                "sense_id": "c8ac84b5-8439-3037-84f5-90d11170dd9f",
                                                "text": "Mälzers kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a082a4bf-6659-4e00-a5eb-167883655b33",
                        "source_entry_id": "3de1ce80-3f7b-3277-9eb1-59a8dae994a4",
