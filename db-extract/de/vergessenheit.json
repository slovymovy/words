                ],
                "senses": [
                    {
                        "sense_id": "48618425-b118-3f58-a35e-ae05945d15e4",
                        "entry_id": "17836b76-9f56-3e10-9003-36f16a240c60",
                        "glosses": [
                            "der Zustand, dass man sich an etwas nicht mehr erinnert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b77c6fc7-47da-42d4-8906-5ff9c8831dcd",
                                "sense_id": "48618425-b118-3f58-a35e-ae05945d15e4",
                                "text": "Der politische Skandal des Abgeordneten geriet schon bald in Vergessenheit."
                            },
                            {
                                "example_id": "472535dc-5490-42b1-9aaa-f325fa16c3d6",
                                "sense_id": "48618425-b118-3f58-a35e-ae05945d15e4",
                                "text": "„Deltafliegen, die ursprüngliche Art des Hängegleitens, ist mit dem Aufkommen des Gleitschirmes etwas in Vergessenheit geraten.“"
                            },
                            {
                                "example_id": "c0f18c4a-a280-4a5f-9ee4-dd2ea0816009",
                                "sense_id": "48618425-b118-3f58-a35e-ae05945d15e4",
                                "text": "„Die Schusterjungenwitze sind nach dem Ersten Weltkrieg in Vergessenheit geraten, ebenso wie der Eckensteher Nante.“"
                            },
                            {
                                "example_id": "eccd665b-b305-4da4-9f77-51a92dc7f795",
                                "sense_id": "48618425-b118-3f58-a35e-ae05945d15e4",
                                "text": "„Etwa 25 Prozent der punjabischen Bevölkerung hat Mohajirin-Wurzeln, wenngleich sich als Identitätsmoment Punjabi und nicht Mohajir durchsetzte. Ein gutes Beispiel hierfür ist Zia-ul-Haq, dessen punjabische Identität immer wieder betont wird, wobei jedoch schnell in Vergessenheit gerät, dass er aus dem indischen Jalandhar stammt.“"
                            },
                            {
                                "example_id": "3de46eca-d727-4997-9c58-2b28eb36d588",
                                "sense_id": "48618425-b118-3f58-a35e-ae05945d15e4",
                                "text": "„Das in Vergessenheit geratene Ostpreußen, über Jahrhunderte Streitball verschiedener Nationen, gerät wieder ins aktuelle Blickfeld.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "616ebc02-06f3-4658-a335-2207b7e61801",
                        "source_entry_id": "17836b76-9f56-3e10-9003-36f16a240c60",
                        "source_sense_id": "48618425-b118-3f58-a35e-ae05945d15e4",
                        "source_sense_description": "der Zustand, dass man sich an etwas nicht mehr erinnert",
                        "target_lang_word": "oblivion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oblivion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8517773e-db0a-3f02-a3b8-6111a9164a0a",
                                        "entry_id": "e2f79a0d-153f-330e-af8b-6f0ab94b0ca1",
                                        "glosses": [
                                            "The state of forgetting completely, of being oblivious, unconscious, unaware, as when sleeping, drunk, or dead."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d515dd09-beec-41b4-b597-1cee75e25f46",
                                                "sense_id": "8517773e-db0a-3f02-a3b8-6111a9164a0a",
                                                "text": "He regularly drank himself into oblivion."
                                            },
                                            {
                                                "example_id": "1e33bf8f-2de9-40aa-9ac1-6ad94b3095e7",
                                                "sense_id": "8517773e-db0a-3f02-a3b8-6111a9164a0a",
                                                "text": "Only the oblivion of sleep can heal the greatest traumas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5eb212af-7c4d-376a-b2f7-892df60cbb61",
                                        "entry_id": "e2f79a0d-153f-330e-af8b-6f0ab94b0ca1",
                                        "glosses": [
                                            "The state of being completely forgotten, of being reduced to a state of non-existence, extinction, or nothingness, including through war and destruction. (Figuratively) for an area like hell, a wasteland."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9fcc4512-5711-4eac-97b7-7700615b0d06",
                                                "sense_id": "5eb212af-7c4d-376a-b2f7-892df60cbb61",
                                                "text": "Due to modern technology, many more people and much more information will not slip into oblivion, contrary to what happened throughout history until now."
                                            },
                                            {
                                                "example_id": "65e8ed12-3697-49c4-96ca-8f9edb6a48e8",
                                                "sense_id": "5eb212af-7c4d-376a-b2f7-892df60cbb61",
                                                "text": "They tried to bomb them into oblivion."
                                            },
                                            {
                                                "example_id": "3303516e-e8a3-4ff6-a7cf-be499e2ce9e4",
                                                "sense_id": "5eb212af-7c4d-376a-b2f7-892df60cbb61",
                                                "text": "I will cast them into oblivion!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "acfbf37e-23ff-3fd8-bc04-0390b034939d",
                                        "entry_id": "e2f79a0d-153f-330e-af8b-6f0ab94b0ca1",
                                        "glosses": [
                                            "A form of purgatory."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b613ec07-200b-345e-9865-de9124b8ee85",
                                        "entry_id": "e2f79a0d-153f-330e-af8b-6f0ab94b0ca1",
                                        "glosses": [
                                            "Amnesty."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "oblivion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "86a0c6da-61c0-3085-906f-3a6ed7c86885",
