                    },
                    {
                        "form_id": "17d85ecd-0119-45ee-8821-63d7703f6d71",
                        "entry_id": "2544653f-bd2a-319b-909f-9d1956f2da11",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "кре́пах"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a6360bd9-2dec-35bc-a332-4bb4c4450974",
                        "entry_id": "2544653f-bd2a-319b-909f-9d1956f2da11",
                        "glosses": [
                            "текст. тонкая, подобно кисее, шёлковая или бумажная слегка морщинистая ткань"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9027bef0-6cfd-4084-a4fa-1a7f8e08b9d0",
                                "sense_id": "a6360bd9-2dec-35bc-a332-4bb4c4450974",
                                "text": "Летние шляпы и платья очень воздушны, требуют нежного материала: кружев, шиффона, крепа."
                            }
                        ]
                    },
                    {
                        "sense_id": "d810aa3c-7dc3-3e01-bee0-12bade7fe04b",
                        "entry_id": "2544653f-bd2a-319b-909f-9d1956f2da11",
                        "glosses": [
                            "разг. изделия из такой ткани"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0681ba25-6372-46f5-a763-312c6c63370c",
                                "sense_id": "d810aa3c-7dc3-3e01-bee0-12bade7fe04b",
                                "text": "По отцу и матери носили траур два года: первый ― шерсть и креп, в большие праздники можно было надевать что-нибудь дикое шерстяное, но не слишком светлое."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "197ef354-dd80-436b-9038-805f175075f6",
                        "source_entry_id": "2544653f-bd2a-319b-909f-9d1956f2da11",
                        "source_sense_description": "ткань",
                        "target_lang_word": "crêpe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "crêpe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "95e84f2a-5554-37f0-b240-5cef4b09e52d",
                                        "entry_id": "5429ec9a-83a2-3f0c-bb44-a7757babc536",
                                        "glosses": [
                                            "Étoffe claire, légère et comme frisée, faite de laine fine ou de soie crue et gommée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a7cc406-85df-44cd-b16d-a8e98af34c12",
                                                "sense_id": "95e84f2a-5554-37f0-b240-5cef4b09e52d",
                                                "text": "Ils feront aussi des crêpes unis et gros crêpes, de la même façon et qualité que ceux qui viennent de Boulogne,"
                                            },
                                            {
                                                "example_id": "d51dc419-5619-4a0f-a0c8-2d054676f810",
                                                "sense_id": "95e84f2a-5554-37f0-b240-5cef4b09e52d",
                                                "text": "Voiles, crêpes, habits, lugubres ornements."
                                            },
                                            {
                                                "example_id": "57e70f2b-d425-4e85-ab19-5f6d61b4fdc8",
                                                "sense_id": "95e84f2a-5554-37f0-b240-5cef4b09e52d",
                                                "text": "Pourquoi flotte à longs plis ce crêpe menaçant ?"
                                            },
                                            {
                                                "example_id": "f810d933-eadf-42e6-89a3-51150be19e6b",
                                                "sense_id": "95e84f2a-5554-37f0-b240-5cef4b09e52d",
                                                "text": "[Il] trouva un manant habillé de noir : ses quatre cheveux étaient ras, un crêpe pendait derrière son chapeau dégrafé."
                                            },
                                            {
                                                "example_id": "712e8714-5db3-4d42-be2f-3b0605165e10",
                                                "sense_id": "95e84f2a-5554-37f0-b240-5cef4b09e52d",
                                                "text": "Crêpe blanc, noir, rose."
                                            },
                                            {
                                                "example_id": "ca4c3302-82e6-4bd7-a2b9-e7ee961d9c5c",
                                                "sense_id": "95e84f2a-5554-37f0-b240-5cef4b09e52d",
                                                "text": "Robe, voile de crêpe."
                                            },
                                            {
                                                "example_id": "d1ede237-9e3a-4516-a487-8237fe00883b",
                                                "sense_id": "95e84f2a-5554-37f0-b240-5cef4b09e52d",
                                                "text": "Crêpe lisse : Celui qui n’est pas frisé."
                                            },
                                            {
                                                "example_id": "ac7b817e-fa9b-4d25-911d-f92f3df8f5f4",
                                                "sense_id": "95e84f2a-5554-37f0-b240-5cef4b09e52d",
                                                "text": "Bon-papa mourut à la fin de l’automne, après une interminable agonie ; ma mère s’enveloppa de crêpe et fit teindre en noir mes vêtements."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3210542a-316e-3afe-9192-f64bd67d8584",
                                        "entry_id": "5429ec9a-83a2-3f0c-bb44-a7757babc536",
                                        "glosses": [
                                            "Symbole consistant en un crêpe noir au chapeau, au bras ou à l’épée, porté en signe de deuil."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "813c53b2-1ac5-4f98-a47c-6d5233b51ea8",
                                                "sense_id": "3210542a-316e-3afe-9192-f64bd67d8584",
                                                "text": "Les tambours étaient couverts de crêpe."
                                            },
                                            {
                                                "example_id": "b7b96330-6bcb-493e-bfc6-13e97c98ef27",
                                                "sense_id": "3210542a-316e-3afe-9192-f64bd67d8584",
                                                "text": "La plupart des souverains de l’Europe mirent des crêpes funèbres pour pleurer la mort d’un régicide [Cromwell]."
                                            },
                                            {
                                                "example_id": "5bd29e72-8983-41bd-ad24-110fc5df16c9",
                                                "sense_id": "3210542a-316e-3afe-9192-f64bd67d8584",
                                                "text": "Mais si, d’un long crêpe voilée,\nMon amante dans la vallée\nVenait pleurer quand le jour fuit […]"
                                            },
                                            {
                                                "example_id": "b40efe60-3b2d-4178-8c77-174dbf4e1868",
                                                "sense_id": "3210542a-316e-3afe-9192-f64bd67d8584",
                                                "text": "Nous jouissons par avance du plaisir de vous avoir ; cette espérance a dissipé un crêpe noir que votre absence avait mis sur ma vie."
                                            },
                                            {
                                                "example_id": "49c4bc8e-b7d0-47c3-8ed1-1f791a6814ee",
                                                "sense_id": "3210542a-316e-3afe-9192-f64bd67d8584",
                                                "text": "Le cirque de montagnes s’emplit de ténèbres, et les formes du burg disparurent bientôt sous le crêpe de la nuit."
                                            },
                                            {
                                                "example_id": "3b6ddd36-a79b-4919-8809-5c534689ecbc",
                                                "sense_id": "3210542a-316e-3afe-9192-f64bd67d8584",
                                                "text": "Nous la ramenâmes à la maison, où elle s’emporta contre son deuil neuf, son crêpe encombrant qu’elle accrochait à toutes les clefs de tiroirs et de portes, sa robe de cachemire qui l’étouffait."
                                            },
                                            {
                                                "example_id": "fca8b4ba-0fe0-4455-90d2-7d8a801da47e",
                                                "sense_id": "3210542a-316e-3afe-9192-f64bd67d8584",
                                                "text": "Quelques hommes seulement prirent part aux obsèques et peu de femmes même, de celles qui profitent de toutes les occasions pour sortir leurs vêtements noirs, leurs toquets de crêpe et qui aiment renifler l’odeur de l’encens."
                                            },
                                            {
                                                "example_id": "4f518118-88db-4c6f-b630-f5fa4398e48a",
                                                "sense_id": "3210542a-316e-3afe-9192-f64bd67d8584",
                                                "text": "Derrière le corbillard […] les hommes de la famille, tout de noir vêtus, un large crêpe au bras gauche et au chapeau. Puis venaient les femmes dont le visage était dissimulé par un voile de crêpe fixé au chapeau, descendant, selon le degré de parenté avec le défunt, jusqu’à la taille ou jusqu’au bas de la robe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "643596ba-f5f5-3d09-a6fd-2d891b8351cf",
                                        "entry_id": "5429ec9a-83a2-3f0c-bb44-a7757babc536",
                                        "glosses": [
                                            "Cheveux nattés et frisés par le bout."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "crêpe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5064b8dd-2484-3046-a866-f09438dc82f3",
                                        "entry_id": "e98c8cf6-8fed-3db4-9908-fec20bd85352",
                                        "glosses": [
                                            "Plat culinaire constitué d’une fine couche de pâte liquide que l’on fait cuire dans une poêle sur les deux faces avant de la recouvrir de garniture, et qui peut être salée comme sucrée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84e18cb2-4254-4018-9179-4e1b9b4ad45b",
                                                "sense_id": "5064b8dd-2484-3046-a866-f09438dc82f3",
                                                "text": "Mère Barberin donne une tape sur la queue de la poêle, puis d’un coup de main elle fait sauter la crêpe au grand effroi de Mattia ; mais il n’y a rien à craindre ; après avoir été faire une courte promenade dans la cheminée, la crêpe retombe dans la poêle sens dessus dessous, montrant sa face rissolée.\nJe n’ai que le temps de prendre une assiette et la crêpe glisse dedans."
                                            },
                                            {
                                                "example_id": "ea03ef6c-5ec2-46cb-945e-a908d2535247",
                                                "sense_id": "5064b8dd-2484-3046-a866-f09438dc82f3",
                                                "text": "Il s'en vantait souvent auprès de ses amis : personne ne pouvait faire des crêpes mieux et plus rapidement que lui."
                                            },
                                            {
                                                "example_id": "6cc4061b-5811-4a7c-b7f8-bf9f0cbdc2e5",
                                                "sense_id": "5064b8dd-2484-3046-a866-f09438dc82f3",
                                                "text": "Vers six heures, elle se mettait au travail, faisait une soixantaine de crêpes, mais laissait suffisamment de pâte pour que chacun fît la sienne, avec une pièce d’or dans sa poche. […] La pièce d’or était un double napoléon, les premières économies de ma mère jeune fille. Un jour, elle dit à mes frères qu’elle me la donnerait parce que j’étais le plus jeune et la garderais plus longtemps.\n« Conserve-la. Pourtant, pour sauver la vie d’un des tiens, n’hésite pas à t’en servir. »"
                                            },
                                            {
                                                "example_id": "7dbe061c-fd15-41fc-8787-ce55caa21eed",
                                                "sense_id": "5064b8dd-2484-3046-a866-f09438dc82f3",
                                                "text": "Dans ces dernières, il faut distinguer les crêpes cuites sur le bilig et les crêpes à la poêle confectionnées dans les familles, particulièrement à la Chandeleur ou au Mardi-Gras."
                                            },
                                            {
                                                "example_id": "6a2e0e6b-60f7-4092-9363-50accd6f71f5",
                                                "sense_id": "5064b8dd-2484-3046-a866-f09438dc82f3",
                                                "text": "Bonjour, mon petit Petzi : comme tu as grandi. Tu vas être content, justement je faisais des crêpes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "crêpe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a107280f-fa02-320c-a67c-77a194f5009b",
                                        "entry_id": "20dee008-5974-3675-be3a-692221d4eb2d",
                                        "glosses": [
                                            "Caoutchouc obtenu par coagulation du latex et qui sert à la confection de semelles épaisses, et souvent débordantes, appréciées pour leur souplesse et leur durabilité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2220a2db-ed16-4453-add4-10af06afaaae",
                                                "sense_id": "a107280f-fa02-320c-a67c-77a194f5009b",
                                                "text": "[…] elle avait un pull bleu ciel rayé de blanc, sans col, et les manches roulées au coude, et des petites chaussettes blanches dans des souliers à grosses semelles de crêpe."
                                            },
                                            {
                                                "example_id": "4a2a8627-0ad2-4fed-9ae9-baad0f3f9877",
                                                "sense_id": "a107280f-fa02-320c-a67c-77a194f5009b",
                                                "text": "Alain mène cette fois le jeu, s’éloigne, bloquant en raccourci la courte perspective, collant alternativement ses crêpes en ventouses sur la roche grenue qui mord et retient ferme."
                                            }
                                        ]
                                    }
                                ]
                            },
