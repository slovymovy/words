                    {
                        "sense_id": "49c11a05-c7e5-3c09-90f8-b8a9f5b8d392",
                        "entry_id": "3ffb46c3-c557-39a3-a7d8-01fc80404a8b",
                        "glosses": [
                            "Any of several species of Asian ungulates of the genus Capricornis."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55f00885-bf5c-432d-adf6-9598fd33d9a9",
                                "sense_id": "49c11a05-c7e5-3c09-90f8-b8a9f5b8d392",
                                "text": "The peninsula is home to an estimated four hundred macaques, the world's most northerly colony of wild monkeys, and a growing population of red-haired, goat-like serow, both of which are a protected species."
                            },
                            {
                                "example_id": "ac6f65f4-d88a-477d-99d5-506f2a682caf",
                                "sense_id": "49c11a05-c7e5-3c09-90f8-b8a9f5b8d392",
                                "text": "The serow differs in being larger, at least 32 inches (81 cm) tall, whereas gorals are never more than 28 inches (71 cm). Serows are also distinguished in having small face glands that give out a duikerlike odor."
                            },
                            {
                                "example_id": "4ce3944d-a820-4ac9-bb69-f7bc092d94a7",
                                "sense_id": "49c11a05-c7e5-3c09-90f8-b8a9f5b8d392",
                                "text": "Where official protection is accorded, it is usually on paper only, as the serow is hunted for meat and its body parts, which are used in local medicine. (For example, it is believed that the broth obtained by boiling a serow head is a remedy for arthritis.)"
                            }
                        ]
                    }
                ],
