                "senses": [
                    {
                        "sense_id": "4e9d6a40-6854-3837-9004-b10d7ac1a89e",
                        "entry_id": "c4d93f0e-ffcc-38d9-b82f-b7f23f813794",
                        "glosses": [
                            "Personne de genre inconnu, ou groupe de personnes, qui voyage."
                        ],
                        "tags": [
                            "Très rare"
                        ],
                        "examples": [
                            {
                                "example_id": "538ce848-968c-4721-9c13-f18cd96385ac",
                                "sense_id": "4e9d6a40-6854-3837-9004-b10d7ac1a89e",
                                "text": "LAe voyageurEuse (c’est-à-dire lAe travailleurEuse) est tombéE aux mains des voleurEuses, et lAe prêtreSse ou lae lévite ont passé leur chemin; ou peut-être, dans notre cas, ont-illes même jeté une pierre ou deux à l’individuE blesséE: il fallut pour l’aider unE samaritainE, unE paria, unE personnE peu respectable."
                            },
                            {
                                "example_id": "7ee55265-e1e5-42d7-afa9-dbfb36f54f91",
                                "sense_id": "4e9d6a40-6854-3837-9004-b10d7ac1a89e",
                                "text": "Mise en place d’un carnet de voyageureuse expliquant le dispositif et permettant de rassurer accueillant·e·s et accueilli·e·s tout en communiquant sur le dispositif"
                            },
                            {
                                "example_id": "af68e45f-019d-4bea-a563-7b649a6cff20",
                                "sense_id": "4e9d6a40-6854-3837-9004-b10d7ac1a89e",
                                "text": "Certains paysages vous sembleront peut-être familiers, peut-être parce que certaines histoires traversent les époques et les univers, ou peut-être parce que vous êtes vous-mêmes un.e voyageureuse intergalactique."
                            },
                            {
                                "example_id": "2df1947c-625b-44bd-9a44-3ec8bd67ada6",
                                "sense_id": "4e9d6a40-6854-3837-9004-b10d7ac1a89e",
                                "text": "Parleriez-vous avec un.e ami.e ? Un.e voyageureuse déjà revenu.e de son périple ?"
                            },
                            {
                                "example_id": "2bc29d05-55e3-4724-9802-fb6061d1f7bd",
                                "sense_id": "4e9d6a40-6854-3837-9004-b10d7ac1a89e",
                                "text": "voyageureuse"
                            },
                            {
                                "example_id": "15d5fcea-b436-43f1-a4ef-2c361b010106",
                                "sense_id": "4e9d6a40-6854-3837-9004-b10d7ac1a89e",
                                "text": "Ce sont les difficultés et les inattendus qui forgent le mieux le caractère du/de la voyageureuse et font les passages les plus intéressants du récit de ses péripéties."
                            },
                            {
                                "example_id": "f114e6f0-bc88-4d7a-8e45-eabf1aa39978",
                                "sense_id": "4e9d6a40-6854-3837-9004-b10d7ac1a89e",
                                "text": "Chaque porte d'embarquement est repérée par une couleur, ce qui permet aux voyageureuse.s d’estimer la distance à parcourir d’une porte à l’autre."
                            }
                        ]
                    },
