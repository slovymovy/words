                        "examples": [
                            {
                                "example_id": "2857077d-50a9-4495-8d2d-73814fe7e12e",
                                "sense_id": "153d8739-71fa-34ed-ae05-3204c44133a2",
                                "text": "Zowel een loonsverhoging als een bijstorting in het pensioenfonds van de piloten noemt hij onverantwoord. \"Het gaat beter ten opzichte van wat het was\", zegt Elbers, om eraan toe te voegen: \"Maar dat is ook hard nodig.\""
                            },
                            {
                                "example_id": "c1d569fd-e098-404d-a291-55d7b6f24dec",
                                "sense_id": "153d8739-71fa-34ed-ae05-3204c44133a2",
                                "text": "De bank heeft bovendien tegen ongunstiger voorwaarden het geld aan Vestia geleend en vraagt nu om bijstorting of extra garanties. Dat aanzuiveren heeft betrekking op de lagere marktwaarde van die derivaten, maar soms ook op de leencontracten of het onderpand waarvoor de lening is verstrekt."
                            }
                        ]
