{
    "word_family": [
        "corruption",
        "corruptible",
        "corruptive",
        "corruptly",
        "corruptness",
        "incorruptible"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "79f1ee2d-d678-35bf-a129-bcfa904486ff",
                    "sense_definition": "Willing to act dishonestly for personal gain, especially by accepting bribes.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "dishonesty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>corrupt</w> official was eventually caught taking money from the construction company.",
                            "target_lang_translations": {
                                "ru": "<w>Коррумпированный</w> чиновник в конце концов был пойман на получении денег от строительной компании."
                            }
                        },
                        {
                            "text": "Many citizens are tired of dealing with <w>corrupt</w> politicians who ignore the law.",
                            "target_lang_translations": {
                                "ru": "Многие граждане устали иметь дело с <w>продажными</w> политиками, которые игнорируют закон."
                            }
                        }
                    ],
                    "antonyms": [
                        "honest",
                        "ethical"
                    ],
                    "common_phrases": [
                        "corrupt official",
                        "corrupt politician"
                    ],
                    "target_lang_definitions": {
                        "ru": "Готовность действовать нечестно ради личной выгоды, особенно путем принятия взяток."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "коррумпированный",
                                "target_lang_sense_clarification": "о должностных лицах или организациях"
                            },
                            {
                                "target_lang_word": "продажный",
                                "target_lang_sense_clarification": "готовый на бесчестные поступки ради денег"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fde7835e-bd7f-3b49-9b96-93a1c07de3f3",
                    "sense_definition": "Containing errors or being in an invalid state, especially regarding digital data or texts.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "invalidity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I could not open the attachment because the file was <w>corrupt</w> and unreadable.",
                            "target_lang_translations": {
                                "ru": "Я не смог открыть вложение, так как файл был <w>повреждён</w> и не читался."
                            }
                        },
                        {
                            "text": "The <w>corrupt</w> data caused the entire computer system to crash unexpectedly.",
                            "target_lang_translations": {
                                "ru": "<w>Испорченные</w> данные привели к неожиданному сбою всей компьютерной системы."
                            }
                        }
                    ],
                    "synonyms": [
                        "corrupted"
                    ],
                    "antonyms": [
                        "valid",
                        "intact"
                    ],
                    "common_phrases": [
                        "corrupt file",
                        "corrupt data"
                    ],
                    "target_lang_definitions": {
                        "ru": "Содержащий ошибки или находящийся в недействительном состоянии, особенно в отношении цифровых данных или текстов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "повреждённый",
                                "target_lang_sense_clarification": "о файлах или данных"
                            },
                            {
                                "target_lang_word": "испорченный",
                                "target_lang_sense_clarification": "содержащий ошибки, нечитаемый"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3823d4dc-4902-30a7-8c31-fa08d5f6fe70",
                    "sense_definition": "Morally degenerate, depraved, or perverted in character.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "morality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The novel depicts a <w>corrupt</w> society where greed is valued more than human life.",
                            "target_lang_translations": {
                                "ru": "В романе изображено <w>порочное</w> общество, где жадность ценится выше человеческой жизни."
                            }
                        },
                        {
                            "text": "He warned that such violent entertainment would lead to a <w>corrupt</w> mind.",
                            "target_lang_translations": {
                                "ru": "Он предупредил, что подобные жестокие развлечения приведут к <w>развращённому</w> уму."
                            }
                        }
                    ],
                    "antonyms": [
                        "pure",
                        "virtuous"
                    ],
                    "common_phrases": [
                        "corrupt society",
                        "corrupt mind"
                    ],
                    "target_lang_definitions": {
                        "ru": "Морально разложившийся, порочный или извращенный по характеру."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "порочный",
                                "target_lang_sense_clarification": "морально разложившийся"
                            },
                            {
                                "target_lang_word": "развращённый",
                                "target_lang_sense_clarification": "испорченный дурным влиянием"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ebf996a9-63d3-31f0-809c-5bad8799d576",
                    "sense_definition": "In a state of decay, putrid, or spoiled.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "decay",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The air in the abandoned cellar was thick with the smell of <w>corrupt</w> meat.",
                            "target_lang_translations": {
                                "ru": "Воздух в заброшенном подвале был пропитан запахом <w>протухшего</w> мяса."
                            }
                        },
                        {
                            "text": "They were forced to survive on <w>corrupt</w> food during the long voyage.",
                            "target_lang_translations": {
                                "ru": "Во время долгого плавания они были вынуждены выживать на <w>испорченной</w> еде."
                            }
                        }
                    ],
                    "antonyms": [
                        "fresh",
                        "wholesome"
                    ],
                    "common_phrases": [
                        "corrupt air"
                    ],
                    "target_lang_definitions": {
                        "ru": "Находящийся в состоянии гниения, зловонный или испорченный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "протухший",
                                "target_lang_sense_clarification": "о еде или мясе"
                            },
                            {
                                "target_lang_word": "гнилой",
                                "target_lang_sense_clarification": "находящийся в процессе разложения"
                            },
                            {
                                "target_lang_word": "затхлый",
                                "target_lang_sense_clarification": "о воздухе или запахе"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a826cadd-d953-3441-a95a-797777ca5328",
                    "sense_definition": "To cause someone to become dishonest or morally bad.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "influence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The older students tried to <w>corrupt</w> the younger ones by teaching them how to cheat.",
                            "target_lang_translations": {
                                "ru": "Старшие ученики пытались <w>развратить</w> младших, обучая их жульничеству."
                            }
                        },
                        {
                            "text": "Some people believe that extreme wealth can easily <w>corrupt</w> a person's character.",
                            "target_lang_translations": {
                                "ru": "Некоторые люди верят, что огромное богатство может легко <w>испортить</w> характер человека."
                            }
                        }
                    ],
                    "antonyms": [
                        "purify",
                        "reform"
                    ],
                    "common_phrases": [
                        "corrupt the youth",
                        "power corrupts"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заставлять кого-либо стать нечестным или морально плохим."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "развращать",
                                "target_lang_sense_clarification": "прививать безнравственность"
                            },
                            {
                                "target_lang_word": "портить",
                                "target_lang_sense_clarification": "неправильно воспитывать, ухудшать характер"
                            },
                            {
                                "target_lang_word": "разлагать",
                                "target_lang_sense_clarification": "доводить до морального упадка"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "687416fd-73b8-3fe6-b221-1af91cc41929",
                    "sense_definition": "To introduce errors into a computer file or data, making it unusable.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "invalidity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A sudden power outage can <w>corrupt</w> the data you are currently saving.",
                            "target_lang_translations": {
                                "ru": "Внезапное отключение электричества может <w>повредить</w> данные, которые вы сохраняете в данный момент."
                            }
                        },
                        {
                            "text": "Be careful not to <w>corrupt</w> the database by entering the wrong commands.",
                            "target_lang_translations": {
                                "ru": "Будьте осторожны, чтобы не <w>испортить</w> базу данных, вводя неправильные команды."
                            }
                        }
                    ],
                    "common_phrases": [
                        "corrupt the data",
                        "corrupt a file"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вносить ошибки в компьютерный файл или данные, делая их непригодными для использования."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "повреждать",
                                "target_lang_sense_clarification": "делать файл или данные нечитаемыми"
                            },
                            {
                                "target_lang_word": "портить",
                                "target_lang_sense_clarification": "вносить ошибки в структуру данных"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f2cf90c9-a1f0-3275-8d42-98be50b3cf6f",
                    "sense_definition": "To change a language or a text from its original, correct form into an inferior one.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "alteration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Over the centuries, local dialects began to <w>corrupt</w> the original Latin text.",
                            "target_lang_translations": {
                                "ru": "На протяжении веков местные диалекты начали <w>искажать</w> оригинальный латинский текст."
                            }
                        },
                        {
                            "text": "The editor was careful not to <w>corrupt</w> the author's unique style with too many changes.",
                            "target_lang_translations": {
                                "ru": "Редактор старался не <w>испортить</w> уникальный стиль автора слишком большим количеством правок."
                            }
                        }
                    ],
                    "common_phrases": [
                        "corrupt the language"
                    ],
                    "target_lang_definitions": {
                        "ru": "Изменять язык или текст из его оригинальной, правильной формы в худшую."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "искажать",
                                "target_lang_sense_clarification": "менять первоначальный смысл или форму"
                            },
                            {
                                "target_lang_word": "портить",
                                "target_lang_sense_clarification": "ухудшать чистоту языка или стиля"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "63700273-6fe8-3c17-9e4a-e419708f5be5",
                    "sense_definition": "To rot, putrefy, or become impure.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "decay",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Without proper refrigeration, the organic matter will quickly begin to <w>corrupt</w>.",
                            "target_lang_translations": {
                                "ru": "Без надлежащего охлаждения органические вещества быстро начнут <w>гнить</w>."
                            }
                        },
                        {
                            "text": "The wound began to <w>corrupt</w> because it had not been cleaned properly.",
                            "target_lang_translations": {
                                "ru": "Рана начала <w>разлагаться</w>, потому что её не очистили должным образом."
                            }
                        }
                    ],
                    "synonyms": [
                        "corrupted"
                    ],
                    "target_lang_definitions": {
                        "ru": "Гнить, разлагаться или становиться нечистым."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гнить",
                                "target_lang_sense_clarification": "подвергаться органическому разложению"
                            },
                            {
                                "target_lang_word": "разлагаться",
                                "target_lang_sense_clarification": "распадаться, портиться"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}