        "fr-extract.jsonl": [
            {
                "entry_id": "23206f82-4328-3954-81f7-5e87a701ca88",
                "word": "journalistique",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8deeb273-5e6f-4a1b-b4d1-6dea97ce1dce",
                        "entry_id": "23206f82-4328-3954-81f7-5e87a701ca88",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "journalistiques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ad4d43a6-e092-360f-a85f-ded1af064a09",
                        "entry_id": "23206f82-4328-3954-81f7-5e87a701ca88",
                        "glosses": [
                            "Relatif au journalisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5130503b-3ac5-4f17-9cd6-8a23d86c11ae",
                                "sense_id": "ad4d43a6-e092-360f-a85f-ded1af064a09",
                                "text": "Ah! ces marchands de papier ! Dire que j'ai ramé toute mon existence dans cette galère journalistique…"
                            },
                            {
                                "example_id": "573f0084-e088-43a9-b800-0703d0911774",
                                "sense_id": "ad4d43a6-e092-360f-a85f-ded1af064a09",
                                "text": "Les plus audacieux ont suivi au Québec une tendance qui a balayé les États-Unis et l'Europe et se sont lancés carrément dans l’aventure des cybermédias, créant des magazines ou autres hybrides des produits journalistiques traditionnels."
                            },
                            {
                                "example_id": "d601bfa1-adae-4479-a5e6-e9499d8820f4",
                                "sense_id": "ad4d43a6-e092-360f-a85f-ded1af064a09",
                                "text": "L’intégrité journalistique repose largement sur l'absence de conflits de loyautés, et même sur l'absence d'apparence de tels conflits."
                            },
                            {
                                "example_id": "f83b238f-0932-46b4-90c8-7089cdd03892",
                                "sense_id": "ad4d43a6-e092-360f-a85f-ded1af064a09",
                                "text": "Lorsque des journalistes de presse écrite ou de télévision réalisent un poisson d'avril, ils doivent mimer au plus près l'approche journalistique du réel et utiliser tous les codes vraisemblables pour accréditer la croyance en une information fausse."
                            },
                            {
                                "example_id": "1c72022d-efee-4f2a-bb68-27cbd118931e",
                                "sense_id": "ad4d43a6-e092-360f-a85f-ded1af064a09",
                                "text": "Elle disait : « Compte tenu de votre situation, la Commission a décidé de vous accorder la carte de presse en qualité de pigiste bien que la moyenne mensuelle de vos revenus journalistiques se situe bien en deçà du seuil requis. »"
                            },
                            {
                                "example_id": "bac29f22-4dec-4172-8c0a-8c608c17a0eb",
                                "sense_id": "ad4d43a6-e092-360f-a85f-ded1af064a09",
                                "text": "Chaque année, au printemps, dans bon nombre d’établissements de la maternelle au lycée, la Semaine de la presse et des médias dans l’école permet de « développer le goût pour l’actualité », tout en abordant avec les élèves des notions clés du travail journalistique, du décryptage de l’information, à travers des présentations du paysage médiatique ou des rencontres de rédactions."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1f05d0eb-ad19-428c-8275-12f6ce66f3ad",
                        "source_entry_id": "23206f82-4328-3954-81f7-5e87a701ca88",
                        "source_sense_id": "ad4d43a6-e092-360f-a85f-ded1af064a09",
                        "target_lang_word": "journalistisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "journalistisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c0c9d237-5514-3dcf-8023-369af52238c4",
                                        "entry_id": "b41405eb-3242-3b39-a86a-4ae43690f02a",
                                        "glosses": [
                                            "den Journalismus betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4eb5b337-330a-48a7-be54-d7143c636f6a",
                                                "sense_id": "c0c9d237-5514-3dcf-8023-369af52238c4",
                                                "text": "Bei der Recherche müssen Autoren die journalistische Sorgfaltspflicht beachten."
                                            },
                                            {
                                                "example_id": "ed617588-9893-4ef5-bee2-64496372b934",
                                                "sense_id": "c0c9d237-5514-3dcf-8023-369af52238c4",
                                                "text": "Der journalistische Sprachstil unterscheidet sich stark vom wissenschaftlichen Stil."
                                            },
                                            {
                                                "example_id": "78acb3c3-973c-45ce-9956-75c2f18de041",
                                                "sense_id": "c0c9d237-5514-3dcf-8023-369af52238c4",
                                                "text": "„Einen Fortsetzungsroman für Dave's Rag zu schreiben, machte Spaß, doch meine übrigen journalistischen Pflichten langweilten mich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a091232d-dd62-4926-8601-1dd8640ea735",
                        "source_entry_id": "23206f82-4328-3954-81f7-5e87a701ca88",
                        "source_sense_id": "ad4d43a6-e092-360f-a85f-ded1af064a09",
                        "target_lang_word": "news",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "news",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fcbb89d5-57be-3a93-8953-860f3d6dc386",
                                        "entry_id": "f951dbbf-3ec6-33bc-847b-8d8b6e2e24fb",
                                        "glosses": [
                                            "New information of interest."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b3f0fcd-9688-48c3-bf86-40c689d84053",
                                                "sense_id": "fcbb89d5-57be-3a93-8953-860f3d6dc386",
                                                "text": "Is there any news about the storm?"
                                            },
                                            {
                                                "example_id": "1aea41bc-1a57-47f7-9f62-bbd25e9043b1",
                                                "sense_id": "fcbb89d5-57be-3a93-8953-860f3d6dc386",
                                                "text": "That was not much news in the press release."
                                            },
                                            {
                                                "example_id": "94a5bbf7-2ec9-491d-984c-b5db56aa09d1",
                                                "sense_id": "fcbb89d5-57be-3a93-8953-860f3d6dc386",
                                                "text": "VVith speede let vs impart the newes vnto my Lord the King,\nThe fearefull newes that whilſt the flame doth but begin,\nSad pollicie may ſerue to quench the fire: […]"
                                            },
                                            {
                                                "example_id": "d9daf56e-a816-49ac-865a-f0f812356258",
                                                "sense_id": "fcbb89d5-57be-3a93-8953-860f3d6dc386",
                                                "text": "Sirra, your Lord and maſters married, there's newes for you: you haue a new Miſtris."
                                            },
                                            {
                                                "example_id": "a31671a3-9a5c-45f2-9b7e-c1febd631313",
                                                "sense_id": "fcbb89d5-57be-3a93-8953-860f3d6dc386",
                                                "text": "When theſe news were brought to him, ſome counſelled him to go to Stirlin, where the King was, and where he would be the ſtronger."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed53c7f4-ea3e-3ba4-bf66-96e3251175ad",
                                        "entry_id": "f951dbbf-3ec6-33bc-847b-8d8b6e2e24fb",
                                        "glosses": [
                                            "Information about current events disseminated by the media."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "049d62b4-ef41-4045-91b4-4a10443ec853",
                                                "sense_id": "ed53c7f4-ea3e-3ba4-bf66-96e3251175ad",
                                                "text": "Did you hear/read/see the latest news?"
                                            },
                                            {
                                                "example_id": "a36a518c-07f8-4142-b678-67dba67d9a1c",
                                                "sense_id": "ed53c7f4-ea3e-3ba4-bf66-96e3251175ad",
                                                "text": "The news is that a new leader will be elected in one month."
                                            },
                                            {
                                                "example_id": "d48ad57e-16a6-4d6c-8f5a-27e13f2aeb02",
                                                "sense_id": "ed53c7f4-ea3e-3ba4-bf66-96e3251175ad",
                                                "text": "I heard about the earthquake on the morning news."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f37c860-de67-33bd-9e16-f77369edeaa3",
                                        "entry_id": "f951dbbf-3ec6-33bc-847b-8d8b6e2e24fb",
                                        "glosses": [
                                            "Messages posted on newsgroups."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2e51134-0655-40f0-aa2e-9b0cc63628b4",
                                                "sense_id": "9f37c860-de67-33bd-9e16-f77369edeaa3",
                                                "text": "The Usenet news system brings people together from around the world and forms social groups on the basis of common interest. Usenet news is a domain that is suffering badly from information overload."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "news",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0eb6f30d-459f-3eab-baeb-69959d6bbe77",
                                        "entry_id": "841c3b75-498b-34ec-a03c-cb9b57e6af30",
                                        "glosses": [
