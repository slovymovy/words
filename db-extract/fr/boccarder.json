                "senses": [
                    {
                        "sense_id": "c10a8e2b-21e5-3650-9e9c-20641132b558",
                        "entry_id": "29672131-34b8-3c32-82fb-6953d455d3d9",
                        "glosses": [
                            "Variante orthographique de bocarder (passer au boccard, machine servant à broyer)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c791140-bd8b-4e6e-9a5e-5cb914ef5eef",
                                "sense_id": "c10a8e2b-21e5-3650-9e9c-20641132b558",
                                "text": "Il s’agit seulement, en employant le boccard humide, de boccarder avec un sol profond d’environ deux pieds & demi, afin d’obtenir les matières bien menues, de ne point faire écouler les eaux du boccard que tout ne soit entièrement boccardé, & ne se soit déposé."
                            },
                            {
                                "example_id": "056717b4-e2d2-4a7c-99c1-9511f67712a7",
                                "sense_id": "c10a8e2b-21e5-3650-9e9c-20641132b558",
                                "text": "Le bout ferré du pilon frappe,en tombant dans une auge G, où l’on jette la mine à boccarder, et l’écrase."
                            }
                        ]
                    },
                    {
                        "sense_id": "065de96e-274f-3695-b283-e14386e58675",
                        "entry_id": "29672131-34b8-3c32-82fb-6953d455d3d9",
                        "glosses": [
                            "Variante orthographique de bocarder (obstruer un passage, en particulier un béta)."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "14220c61-bb38-4dbe-a3e9-a77e6ee0631b",
                                "sense_id": "065de96e-274f-3695-b283-e14386e58675",
                                "text": "Les missaires nablatent chaque fois qu'il faut nablater, boccardent, gigonnent, déboccardent, sesquitent, roudoutent et bètatisent à longueur de journée."
                            }
                        ]
                    }
                ],
