                ],
                "senses": [
                    {
                        "sense_id": "14f41c06-e23b-39cc-9862-e14cf271d68b",
                        "entry_id": "ce5a8998-c8f3-315f-a26c-c270b99657b0",
                        "glosses": [
                            "матем. действие по значению гл. дифференцировать, дифференцироваться; операция взятия полной или частной производной функции"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d4d62e0-4995-4567-8d76-71a5cee6990e",
                                "sense_id": "14f41c06-e23b-39cc-9862-e14cf271d68b",
                                "text": "И. Ньютон и Г. Лейбниц впервые в общем виде рассмотрели основные для нового исчисления операции дифференцирования и интегрирования функций, установили связь между этими операциями (т. н. формула Ньютона ― Лейбница) и разработали для них общий единообразный алгоритм."
                            }
                        ]
                    },
                    {
                        "sense_id": "618ad1b4-7d71-3462-a0b4-d5ec2169ef42",
                        "entry_id": "ce5a8998-c8f3-315f-a26c-c270b99657b0",
                        "glosses": [
                            "научн. то же, что дифференциация; расчленение, различение, выделение составляющих элементов при рассмотрении"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "798e80f8-99c2-43dd-83e4-01b6737b20c3",
                                "sense_id": "618ad1b4-7d71-3462-a0b4-d5ec2169ef42",
                                "text": "Рядом с таким дифференцированием речи происходит дифференцирование в обычаях, идеях и т. д. части выселившейся и части оставшейся."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "775eb974-13a7-4d81-abd8-7a117defb3e7",
                        "source_entry_id": "ce5a8998-c8f3-315f-a26c-c270b99657b0",
                        "target_lang_word": "Differenzierung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Differenzierung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dc1828bc-8fee-3e65-a4fd-4ff3da0367be",
                                        "entry_id": "17a10684-fbf9-3f34-a64d-d65fda2d1606",
                                        "glosses": [
                                            "bis ins Einzelne gehende feine Unterscheidung von etwas"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e384f08-c863-4db2-9e41-245187fb3ffd",
                                                "sense_id": "dc1828bc-8fee-3e65-a4fd-4ff3da0367be",
                                                "text": "Die \"Süddeutsche Zeitung\" kritisiert die Vorstellung von einer eindeutigen deutschen Identität als überholt und mahnt zu mehr Differenzierung."
                                            },
                                            {
                                                "example_id": "09d5b936-0527-4a00-969a-d32340657a28",
                                                "sense_id": "dc1828bc-8fee-3e65-a4fd-4ff3da0367be",
                                                "text": "Vermeintliche Differenzierungen […] dienen häufig dazu, die Wirklichkeit so aufzuweichen und in Einzelheiten verschwimmen zu lassen, dass am Ende schon irgendwas hängen bleibt, auch wenn es faktisch nicht stimmt."
                                            },
                                            {
                                                "example_id": "f4fbded1-c522-47a8-972d-35b5fa17d2d3",
                                                "sense_id": "dc1828bc-8fee-3e65-a4fd-4ff3da0367be",
                                                "text": "Botschafter Issacharoff hat Recht: Der Unterschied zwischen legitimer Kritik und antisemitischer Hetze ist schwer zu definieren. Doch dieser Aufgabe muss man sich immer wieder stellen - mit dem Mut zur Differenzierung."
                                            },
                                            {
                                                "example_id": "b211977f-1339-405a-8640-284a5c2d1931",
                                                "sense_id": "dc1828bc-8fee-3e65-a4fd-4ff3da0367be",
                                                "text": "„In der Wirklichkeit existiert Differenzierung, das ist ein Faktum."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ca8023b7-a4c1-3dd5-aab8-0f4927b54a79",
                                        "entry_id": "17a10684-fbf9-3f34-a64d-d65fda2d1606",
                                        "glosses": [
                                            "aus ursprünglich gleichartigen Zellen gebildete, verschiedenartige Gewebe"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "5c4dfe1b-237a-3be5-9701-74dd4c667055",
                                        "entry_id": "17a10684-fbf9-3f34-a64d-d65fda2d1606",
                                        "glosses": [
                                            "Behandlung einer Funktion nach den Regeln der Differenzialrechnung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "818ef06c-d56f-49d8-becb-d7d28e83e58d",
                                                "sense_id": "5c4dfe1b-237a-3be5-9701-74dd4c667055",
                                                "text": "Bei der Differenzierung einer Funktion wird die 1. Ableitung bestimmt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
