                                "target_senses": [
                                    {
                                        "sense_id": "7a69f7d8-c2f7-3868-90dc-9bf0ba5e1695",
                                        "entry_id": "8e9aaecf-fdfb-32a5-8864-7cb891896657",
                                        "glosses": [
                                            "Apropiación ilícita y divulgación parcial o total de obras ajenas."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0284e12c-f41b-3566-a7f0-d069577350b7",
                                        "entry_id": "8e9aaecf-fdfb-32a5-8864-7cb891896657",
                                        "glosses": [
                                            "Infracción al derecho de autor acerca de una obra artística o intelectual de cualquier tipo, en la que se incurre cuando se presenta una obra ajena como propia u original."
                                        ],
                                        "tags": [
                                            "Derecho"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "84806895-c6cd-38b5-8a57-5f1485ce03d1",
                                        "entry_id": "8e9aaecf-fdfb-32a5-8864-7cb891896657",
                                        "glosses": [
                                            "Por extensión, la obra plagiada."
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "175dc181-2e36-4346-ab4b-08484e3fc7bb",
                                                "sense_id": "84806895-c6cd-38b5-8a57-5f1485ce03d1",
                                                "text": "El plagio como una de las bellas artes. ¿Todo lo que no es autobiografía es plagio? Uno de los temas más morbosos, además de oscuros, del mundo editorial contemporáneo es el del plagio. Abundando en el título de Quincey, el insinuar que un escritor plagia es el crimen más imperdonable que se le pueda achacar, ya que, además de ser constitutivo de delito por apropiación del trabajo ajeno, es el crimen nefando de quienes pretendidamente fundamentan su prestigio en la originalidad de su obra"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "96361923-ea11-35f8-92a9-f9ffaa89fab6",
                                        "entry_id": "8e9aaecf-fdfb-32a5-8864-7cb891896657",
                                        "glosses": [
                                            "Secuestro de personas con el fin de obtener dinero para dejarlas libres."
                                        ],
                                        "tags": [
                                            "America"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47d9ef2b-b129-4309-8b46-2b5a59666955",
                                                "sense_id": "96361923-ea11-35f8-92a9-f9ffaa89fab6",
                                                "text": "Segob, sin confirmar plagio masivo de migrantes en Veracruz"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
