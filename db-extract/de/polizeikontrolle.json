                "senses": [
                    {
                        "sense_id": "0880ae2d-334f-3518-947b-70d0159ee370",
                        "entry_id": "e5614693-6578-30b2-b4b3-e23ce9f25d8f",
                        "glosses": [
                            "Überprüfung von Personen, Sachen oder Sachverhalten durch Polizeibeamte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4884d6f5-643c-4325-b6b7-61844e30abfe",
                                "sense_id": "0880ae2d-334f-3518-947b-70d0159ee370",
                                "text": "„Eines Tages sei der jugendliche Sohn dieser Familie durch die Altstadt gegangen und in eine Polizeikontrolle geraten.“"
                            },
                            {
                                "example_id": "3a42dbee-50a1-4bfe-8b30-0565e1852980",
                                "sense_id": "0880ae2d-334f-3518-947b-70d0159ee370",
                                "text": "„Angel hatte den Anruf erledigt, sie wusste zwar nicht genau, mit wem sie gesprochen hatte, aber dieser Jemand hatte ihr versichert, dass man uns bei der Polizeikontrolle am Stadtrand erwartete.“"
                            },
                            {
                                "example_id": "6530bd86-9053-4570-a25f-8b4871966bce",
                                "sense_id": "0880ae2d-334f-3518-947b-70d0159ee370",
                                "text": "„Bis vor Kurzem schaffte sie es dank ihres schönen Gesichts und ihres mädchenhaften Lächelns mit ihrem ungültigen Führerschein durch jede Polizeikontrolle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
