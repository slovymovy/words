                        "cross_references": [
                            {
                                "target_word": "cytogénétique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4dab445c-dd65-3ac4-b0c6-c193b73c7a10",
                                        "entry_id": "be850b33-a1e0-399e-9314-96812f1a3111",
                                        "glosses": [
                                            "Relatif à l'étude des phénomènes génétiques au niveau de la cellule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fbc6ff4d-6313-40fa-9166-751021c2a466",
                                                "sense_id": "4dab445c-dd65-3ac4-b0c6-c193b73c7a10",
                                                "text": "Par des recherches cytogénétiques, on a mis en évidence la présence de la chromatine sexuelle chez environ 82 p. 100 des cellules examinées chez tous les intersexes qui appartiennent du point de vue anatomo-clinique à cette dysgénésie."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cytogénétique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b995045e-c80a-32e1-855c-dfe8657e3f7e",
                                        "entry_id": "a1ab0835-1c46-38a5-bbf4-4057d582ecd4",
                                        "glosses": [
                                            "Étude des phénomènes génétiques au niveau de la cellule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68079ab2-d69b-4242-b913-fc6fac323768",
                                                "sense_id": "b995045e-c80a-32e1-855c-dfe8657e3f7e",
                                                "text": "La cytogénétique permet d'évaluer la constitution chromosomique d'un individu, soit la composition en chromosomes des cellules d’un individu."
                                            },
                                            {
                                                "example_id": "d2c0068e-f2d9-4380-a969-d8c1dd780639",
                                                "sense_id": "b995045e-c80a-32e1-855c-dfe8657e3f7e",
                                                "text": "La cytogénétique animale, l’une des branches de la génétique, connaît un développement remarquable depuis une vingtaine d’années."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
