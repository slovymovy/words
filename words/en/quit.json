    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "493848a6-21ef-3cc4-87a2-e14319fcd012",
                    "sense_definition": "To stop or give up an activity or habit.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "stop_activity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He decided to <w>quit</w> smoking after his doctor warned him about his health.",
                            "target_lang_translations": {
                                "ru": "Он решил <w>бросить</w> курить после того, как врач предупредил его о здоровье."
                            }
                        },
                        {
                            "text": "If you <w>quit</w> trying now, you will never know if you could have succeeded.",
                            "target_lang_translations": {
                                "ru": "Если ты <w>прекратишь</w> попытки сейчас, ты никогда не узнаешь, мог ли ты добиться успеха."
                            }
                        }
                    ],
                    "synonyms": [
                        "finish",
                        "quit"
                    ],
                    "antonyms": [
                        "start",
                        "begin",
                        "persevere"
                    ],
                    "common_phrases": [
                        "quit smoking",
                        "quit trying",
                        "quit cold turkey"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прекратить или бросить какое-либо занятие или привычку."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бросать",
                                "target_lang_sense_clarification": "прекращать привычку или занятие"
                            },
                            {
                                "target_lang_word": "бросить",
                                "target_lang_sense_clarification": "окончательно прекратить что-либо делать"
                            },
                            {
                                "target_lang_word": "прекращать",
                                "target_lang_sense_clarification": "переставать делать что-либо"
                            }
                        ]
                    }
                },
                {
