                                                "sense_id": "8836b74f-b52e-358c-8283-46efcdd63f6e",
                                                "text": "Mir ist die Vase heruntergefallen."
                                            },
                                            {
                                                "example_id": "91e66056-3557-43c7-a399-066d53e62fc4",
                                                "sense_id": "8836b74f-b52e-358c-8283-46efcdd63f6e",
                                                "text": "Auf dem Kaminsims stehen wertvolle Vasen aus verschiedenen Epochen."
                                            },
                                            {
                                                "example_id": "b46abd9b-beb6-4b64-9367-14dd579d8830",
                                                "sense_id": "8836b74f-b52e-358c-8283-46efcdd63f6e",
