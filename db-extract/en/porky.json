                        "examples": [
                            {
                                "example_id": "5f98475f-a5e7-4de9-9621-f67778afc8b3",
                                "sense_id": "a7d797ef-e260-37a8-935f-3661621cd7de",
                                "text": "When she turned up at the lab, she gave us a sprawling prepared presentation relying heavily on anecdotal evidence, where it wasn't relying on skewed statistics, unfounded claims and outright porkies."
                            }
                        ]
                    },
                    {
                        "sense_id": "cf83b819-4317-30fd-b4f6-d01934af7dee",
                        "entry_id": "1207d180-b153-3d10-a24c-b65467998c20",
                        "glosses": [
