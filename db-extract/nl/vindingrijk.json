                                    {
                                        "sense_id": "050c5602-5a17-31d6-ac39-b80ae41442d2",
                                        "entry_id": "0e8a031c-3b0e-3df0-91b8-953974767bc2",
                                        "glosses": [
                                            "schlau, einfallsreich bei der Problembewältigung, voller praktischer Ideen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2738ad8d-e715-47ac-a97d-dea4b4ad0f50",
                                                "sense_id": "050c5602-5a17-31d6-ac39-b80ae41442d2",
                                                "text": "Davina macht aber einen gewitzten Eindruck."
                                            }
                                        ],
