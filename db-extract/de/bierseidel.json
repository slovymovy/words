                        "glosses": [
                            "Glas oder Krug für Bier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b08fae83-42c8-43ce-ace2-426783d5c9d5",
                                "sense_id": "b653ba9c-a8cd-309f-a2ef-dc8d46fd8235",
                                "text": "Holst du bitte drei Bierseidel aus dem Schrank?"
                            },
                            {
                                "example_id": "b3c47071-6af3-4a36-a136-139a7e1fefcd",
                                "sense_id": "b653ba9c-a8cd-309f-a2ef-dc8d46fd8235",
                                "text": "Unter der Linde meines Gasthofes saßen alle Bänke voll Menschen und die Bierseidel klapperten dazu; ein ganzes Rudel Jenenser Studenten, deren bunte Käppchen im Lichte der Laterne aufleuchteten, sangen da ihre Lieder, eine ausgelassene Gesellschaft."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
