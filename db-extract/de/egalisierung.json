                        "glosses": [
                            "das Angleichen oder Ausgleichen; die Tatsache, dass etwas aneinander angeglichen oder miteinander ausgeglichen wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "540c69e7-14fb-40b8-8147-f5b051752988",
                                "sense_id": "d4ce70d6-e80b-3915-94a7-8e4b5417336f",
                                "text": "Mit diesen wunderbaren Toren gelang die Egalisierung des Rückstandes. Nun haben wir wieder Hoffnung auf einen Verbleib in der Liga."
                            }
                        ],
                        "sense_index_json": "\"1\""
