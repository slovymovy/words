                "senses": [
                    {
                        "sense_id": "cf671475-a71b-3b4c-93bb-1e1604227c1c",
                        "entry_id": "a7331bbe-97aa-36c3-8ef5-e3d6be6f6feb",
                        "glosses": [
                            "etwas das hängt"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "1ac337de-7346-4e73-8dcb-d15d6c766f81",
                                "sense_id": "cf671475-a71b-3b4c-93bb-1e1604227c1c",
                                "text": "Am Weihnachtsbaum hängen Kugeln, Engelchen und anderes Gehänge."
                            },
                            {
                                "example_id": "29ef1247-6f6f-439d-b42c-19b9e0f15a23",
                                "sense_id": "cf671475-a71b-3b4c-93bb-1e1604227c1c",
                                "text": "„Sie trug am Gehänge ihrer Uhr unter anderem ein kleines Fläschchen aus Bergkristall, völlig das gleiche, wie ich es an der Kette der meinen trug.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6cab2b01-d19d-39a2-90f3-ebddb10156e6",
                        "entry_id": "a7331bbe-97aa-36c3-8ef5-e3d6be6f6feb",
                        "glosses": [
                            "Vorrichtung, an der ein Degen getragen wird"
                        ],
                        "tags": [
                            "special"
                        ],
                        "examples": [
                            {
                                "example_id": "f7fd082b-c806-4f27-8caf-318d32f92b8c",
                                "sense_id": "6cab2b01-d19d-39a2-90f3-ebddb10156e6",
                                "text": "Er steckte den Degen zurück ins Gehänge."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "cb9e2db7-cf8a-360b-832f-3cc6dbac7bc2",
                        "entry_id": "a7331bbe-97aa-36c3-8ef5-e3d6be6f6feb",
                        "glosses": [
                            "herabhängende Schmuckstücke"
                        ],
                        "tags": [
                            "special"
                        ],
                        "examples": [
                            {
                                "example_id": "c309bc3e-a0e2-4440-ba89-cc8517aa5dc3",
                                "sense_id": "cb9e2db7-cf8a-360b-832f-3cc6dbac7bc2",
                                "text": "Die Damen waren mit allerlei Gehängen geschmückt."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "5259b372-82b5-30ff-8725-66037f34042f",
                        "entry_id": "a7331bbe-97aa-36c3-8ef5-e3d6be6f6feb",
                        "glosses": [
                            "männliche primäre Geschlechtsorgane"
                        ],
                        "tags": [
                            "special",
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "62a99fcf-ca73-4c46-abc6-50030a931dfd",
                                "sense_id": "5259b372-82b5-30ff-8725-66037f34042f",
                                "text": "Pass auf, dass du dir nicht das Gehänge einklemmst."
                            }
                        ],
                        "sense_index_json": "\"4\""
                    },
                    {
                        "sense_id": "d9ec5464-93a1-302c-a4e3-25b7d92b9c67",
                        "entry_id": "a7331bbe-97aa-36c3-8ef5-e3d6be6f6feb",
                        "glosses": [
                            "Stahlkonstruktion, mit der die Gondel einer Pendelbahn am Laufwerk befestigt ist"
                        ],
                        "tags": [
                            "special"
                        ],
                        "examples": [
                            {
                                "example_id": "cd33dd83-782f-4b6d-b445-38204c16708b",
