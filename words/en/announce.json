{
    "word_family": [
        "announcement",
        "announcer",
        "unannounced"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2f59fdab-ae57-3a9c-803c-b1ed37dba0fe",
                    "sense_definition": "To make something known publicly or officially, especially for the first time.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "public_notice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company will <w>announce</w> its new product at the conference tomorrow.",
                            "target_lang_translations": {
                                "ru": "Компания <w>объявит</w> о своем новом продукте на завтрашней конференции."
                            }
                        },
                        {
                            "text": "They are planning to <w>announce</w> their engagement to the whole family during dinner.",
                            "target_lang_translations": {
                                "ru": "Они планируют <w>объявить</w> о своей помолвке всей семье во время ужина."
                            }
                        }
                    ],
                    "synonyms": [
                        "proclaim",
                        "publish",
                        "make known",
                        "declare",
                        "disclose"
                    ],
                    "antonyms": [
                        "withhold"
                    ],
                    "common_phrases": [
                        "announce the winner",
                        "announce a decision",
                        "officially announce"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделать что-либо известным публично или официально, особенно впервые."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "объявлять",
                                "target_lang_sense_clarification": "сообщать что-то официально или публично"
                            },
                            {
                                "target_lang_word": "объявить",
                                "target_lang_sense_clarification": "сообщить официально (совершенный вид)"
                            },
                            {
                                "target_lang_word": "сообщать",
                                "target_lang_sense_clarification": "передавать информацию"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "046f0b12-b175-36fe-913c-e272499794e5",
                    "sense_definition": "To provide a spoken commentary or act as the presenter for a broadcast or event.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "broadcasting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was hired to <w>announce</w> the football games on the local radio station.",
                            "target_lang_translations": {
                                "ru": "Его наняли <w>комментировать</w> футбольные матчи на местной радиостанции."
                            }
                        },
                        {
                            "text": "The retired player will <w>announce</w> the games for the upcoming season.",
                            "target_lang_translations": {
                                "ru": "Игрок, завершивший карьеру, будет <w>комментировать</w> матчи в предстоящем сезоне."
                            }
                        }
                    ],
                    "common_phrases": [
                        "announce the game",
                        "announce the play-by-play"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предоставлять устный комментарий или выступать в качестве ведущего трансляции или мероприятия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "комментировать",
                                "target_lang_sense_clarification": "вести репортаж о ходе игры или события"
                            },
                            {
                                "target_lang_word": "объявлять",
                                "target_lang_sense_clarification": "называть участников или события в эфире"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "56178c69-1d15-3d48-aeca-ead8b37d7347",
                    "sense_definition": "To formally declare or pronounce a legal or judicial sentence.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "legal_declaration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The judge will <w>announce</w> the final verdict after the jury finishes their deliberation.",
                            "target_lang_translations": {
                                "ru": "Судья <w>огласит</w> окончательный вердикт после того, как присяжные закончат совещание."
                            }
                        },
                        {
                            "text": "It is the duty of the court to <w>announce</w> the sentence in a public hearing.",
                            "target_lang_translations": {
                                "ru": "Обязанностью суда является <w>огласить</w> приговор на публичном слушании."
                            }
                        }
                    ],
                    "synonyms": [
                        "adjudicate",
                        "judge",
                        "declare",
                        "promulgate"
                    ],
                    "common_phrases": [
                        "announce the verdict",
                        "announce a sentence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Формально заявить или произнести юридический или судебный приговор."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оглашать",
                                "target_lang_sense_clarification": "публично зачитывать решение суда"
                            },
                            {
                                "target_lang_word": "объявлять",
                                "target_lang_sense_clarification": "официально сообщать вердикт"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ad5f381d-0c5a-34bc-9a5a-ada7793bc6ae",
                    "sense_definition": "To work or perform the duties of a professional announcer.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "broadcasting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After leaving the field, the athlete decided to <w>announce</w> for a major network.",
                            "target_lang_translations": {
                                "ru": "Уйдя из спорта, атлет решил <w>работать комментатором</w> на крупном телеканале."
                            }
                        },
                        {
                            "text": "She has been <w>announcing</w> for over twenty years and is very well-known.",
                            "target_lang_translations": {
                                "ru": "Она <w>работает диктором</w> уже более двадцати лет и очень известна."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Работать или выполнять обязанности профессионального диктора или комментатора."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "работать диктором",
                                "target_lang_sense_clarification": "профессиональная деятельность на радио или ТВ"
                            },
                            {
                                "target_lang_word": "вести передачи",
                                "target_lang_sense_clarification": "выступать в роли ведущего"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}