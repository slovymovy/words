                                                "sense_id": "ef000e5c-9282-3964-892c-aaf83f0de954",
                                                "text": "Die Verfügbarkeit eines Servers in einem Rechenzentrum ist ein wichtiges Kriterium, wenn man einen Dienstleistungsvertrag abschließen will."
                                            },
                                            {
                                                "example_id": "21f790aa-71cf-49b8-a2ee-d0f5a5c1ded8",
                                                "sense_id": "ef000e5c-9282-3964-892c-aaf83f0de954",
                                                "text": "Verfügbarkeit bezeichnet Systemzuverlässigkeit in Bezug auf das Bereitsein zur Benutzung."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2eca63c6-79c2-3b69-b737-4ef95b342116",
                                        "entry_id": "2727d24d-9c90-371a-8eaa-5ce8ec365256",
                                        "glosses": [
                                            "Existenz und Nutzbarkeit eines Gegenstandes oder einer Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ea2413b-1f97-407a-83f2-2c37efe1a5f9",
                                                "sense_id": "2eca63c6-79c2-3b69-b737-4ef95b342116",
                                                "text": "Die Verfügbarkeit eines Entscheidungsträgers bei der betriebswirtschaftlichen Planung sollte vor dem Beginn der Planungsphase sichergestellt werden."
                                            },
                                            {
                                                "example_id": "92e42364-d166-41b9-a651-65f57ab5b882",
                                                "sense_id": "2eca63c6-79c2-3b69-b737-4ef95b342116",
                                                "text": "Bei der Geldanlage spielt die Verfügbarkeit neben der Zinshöhe eine große Rolle."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
