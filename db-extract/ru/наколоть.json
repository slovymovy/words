                        ],
                        "form": "наколо́в"
                    },
                    {
                        "form_id": "1ce22d63-8001-4de7-bd55-8e54ac82110b",
                        "entry_id": "a79b789d-16d7-3b2e-b71b-757cc0f7d86f",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "наколо́вши"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "592b0fb8-4f9e-3573-96e9-f3f30f5f001e",
                        "entry_id": "a79b789d-16d7-3b2e-b71b-757cc0f7d86f",
                        "glosses": [
                            "нанизать на что-либо острое"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c016ec22-3d74-4a75-a0b5-97ccb0caeba0",
                                "sense_id": "592b0fb8-4f9e-3573-96e9-f3f30f5f001e",
                                "text": "Колтунов лихо махнул стаканчик, наколол пластмассовой вилкой кусок селёдки, закусил."
                            }
                        ]
                    },
                    {
                        "sense_id": "95453be0-3cf9-3af4-a61d-3b26b6dad3bf",
                        "entry_id": "a79b789d-16d7-3b2e-b71b-757cc0f7d86f",
                        "glosses": [
                            "расколоть на части"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85266ebb-be64-42c7-b1ac-2759d84ed106",
                                "sense_id": "95453be0-3cf9-3af4-a61d-3b26b6dad3bf",
                                "text": "Это была ночная работа — после своего рабочего забойного дня надо было напилить и наколоть дров на сутки."
                            }
                        ]
                    },
                    {
                        "sense_id": "26f4983d-d610-36fd-834a-f9b26893a965",
                        "entry_id": "a79b789d-16d7-3b2e-b71b-757cc0f7d86f",
                        "glosses": [
                            "нанести ряд уколов, исколоть"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c347b619-9401-481b-b472-793d95565c9d",
                                "sense_id": "26f4983d-d610-36fd-834a-f9b26893a965",
                                "text": "Плоды очистить от оболочки, удалить горячей водой налёт, протереть, наколоть и плотно уложить в банки."
                            }
                        ]
                    },
                    {
                        "sense_id": "3d5eb8a5-d93b-3ba7-bf83-d7a54b72f38c",
                        "entry_id": "a79b789d-16d7-3b2e-b71b-757cc0f7d86f",
                        "glosses": [
                            "разг. повредить уколом, поранить чем-нибудь острым"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5baf48dc-e994-4fd0-8fe1-9a94f0b79c91",
                                "sense_id": "3d5eb8a5-d93b-3ba7-bf83-d7a54b72f38c",
                                "text": "Босиком можно ножку наколоть на какой-нибудь ржавый гвоздь."
                            }
                        ]
                    },
                    {
                        "sense_id": "7d137447-4ba2-343c-b5f1-6e9600a52fe6",
                        "entry_id": "a79b789d-16d7-3b2e-b71b-757cc0f7d86f",
                        "glosses": [
                            "прикрепить к чему-нибудь булавкой, иголкой"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06ef3abe-8276-47d3-946a-6857e56d9589",
                                "sense_id": "7d137447-4ba2-343c-b5f1-6e9600a52fe6",
                                "text": "Он сходил в спальню, где у него на настенном покрывале были наколоты десятки брелоков для автомобилей."
                            }
                        ]
                    },
                    {
                        "sense_id": "ca2c4aba-eb80-352b-ac91-02d221cc58ba",
                        "entry_id": "a79b789d-16d7-3b2e-b71b-757cc0f7d86f",
                        "glosses": [
                            "разг. сделать татуировку"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0cf21c4-737d-42c3-8265-963ec243e420",
                                "sense_id": "ca2c4aba-eb80-352b-ac91-02d221cc58ba",
                                "text": "Игорь, по возвращении в Москву, собирается наколоть себе такого же в специальной мастерской разноцветными чернилами, но не с одной головой, а с двумя."
                            }
                        ]
                    },
                    {
                        "sense_id": "27ca3eb0-6620-378c-8cb4-0745c76d9f72",
                        "entry_id": "a79b789d-16d7-3b2e-b71b-757cc0f7d86f",
                        "glosses": [
                            "разг. обмануть"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32de7c87-9f3d-4b1a-a3b8-2be4d9f4f7bf",
                                "sense_id": "27ca3eb0-6620-378c-8cb4-0745c76d9f72",
                                "text": "Нас накололи, а мы делаем вид, что всё в порядке."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
