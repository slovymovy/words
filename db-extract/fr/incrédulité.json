        "fr-extract.jsonl": [
            {
                "entry_id": "b3882dcb-f3e0-3e30-8c2f-b12a2c26c33b",
                "word": "incrédulité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "543cf398-6feb-456f-9ca3-8a39a774367c",
                        "entry_id": "b3882dcb-f3e0-3e30-8c2f-b12a2c26c33b",
                        "tags": [
                            "plural"
                        ],
                        "form": "incrédulités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1c96e672-dfec-3217-89d5-e3e5fa91ef5b",
                        "entry_id": "b3882dcb-f3e0-3e30-8c2f-b12a2c26c33b",
                        "glosses": [
                            "Absence de crédulité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c63f84c3-a85a-4a3c-89ab-bdacc3f5960d",
                                "sense_id": "1c96e672-dfec-3217-89d5-e3e5fa91ef5b",
                                "text": "L’incrédulité de Bert était ébranlée. Il posait des questions, et le soldat y répondait complaisamment."
                            },
                            {
                                "example_id": "72b1d8b6-5fa7-44d0-8bf7-531e7c9e1032",
                                "sense_id": "1c96e672-dfec-3217-89d5-e3e5fa91ef5b",
                                "text": "Dans l'espèce humaine, la Parthénogénèse n'a été vue que par les yeux de la foi ; il n'en est pas ainsi dans les rangs inférieurs de l'animalité, et même à ce degré, la chose est si extraordinaire qu'elle a dû, au début, être accueillie par les esprits prudents avec certaines réserves, sinon même avec incrédulité, […] ."
                            }
                        ]
                    },
                    {
                        "sense_id": "02c25383-7338-3002-9cb3-ae0ebb319d1a",
                        "entry_id": "b3882dcb-f3e0-3e30-8c2f-b12a2c26c33b",
                        "glosses": [
                            "Manque de foi, de croyance dans les choses religieuses."
                        ],
                        "tags": [
                            "Plus rare"
                        ],
                        "examples": [
                            {
                                "example_id": "39562b8e-207b-4484-b9db-ddaa7f76c735",
                                "sense_id": "02c25383-7338-3002-9cb3-ae0ebb319d1a",
                                "text": "L’incrédulité est quelquefois le vice d’un sot, et la crédulité le défaut d’un homme d’esprit. L’homme d’esprit voit loin dans l’immensité des possibles ; le sot ne voit guère de possible que ce qui est."
                            },
                            {
                                "example_id": "258396e0-f897-446b-8f6e-139e8f201f43",
                                "sense_id": "02c25383-7338-3002-9cb3-ae0ebb319d1a",
                                "text": "[…], je médite longtemps parmi les derniers tronçons d'une humble église qui put avoir ses beautés ; […], peu à peu le séculaire édifice tomba, détruit d’année en année par l'eau du ciel et l’incrédulité des hommes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4ceac101-843f-468a-9096-56c24512df6c",
                        "source_entry_id": "b3882dcb-f3e0-3e30-8c2f-b12a2c26c33b",
                        "target_lang_word": "incredulity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "incredulity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4d42f089-f312-3945-b4d4-46b5e0f895d8",
                                        "entry_id": "066b0394-ce23-3878-800f-61c82876292a",
                                        "glosses": [
                                            "Unwillingness or inability to believe; doubt about the truth or verisimilitude of something; disbelief."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9d7626d-12bc-4dd1-8555-0d6918af2702",
                                                "sense_id": "4d42f089-f312-3945-b4d4-46b5e0f895d8",
                                                "text": "Wide went her eyes in wonder and incredulity, as she beheld this seeming apparition risen from the dead."
                                            },
                                            {
                                                "example_id": "a2bdd224-cc1a-4dc1-8270-b5e0c6c9f430",
                                                "sense_id": "4d42f089-f312-3945-b4d4-46b5e0f895d8",
                                                "text": "It was a casual sneer, obviously one of a long line. There was hatred behind it, but of a quiet, chronic type, nothing new or unduly virulent, and he was taken aback by the flicker of amazed incredulity that passed over the younger man's ravaged face."
                                            },
                                            {
                                                "example_id": "0434d5c8-ecc9-4539-abfc-0eafd6c2f0fc",
                                                "sense_id": "4d42f089-f312-3945-b4d4-46b5e0f895d8",
                                                "text": "At any other time Jessamy would have laughed at the expressions that chased each other over his freckled face: crossness left over from his struggle with the baby; incredulity; distress; and finally delight."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85a4be68-2bcf-3cb3-9014-b725b94823f7",
                                        "entry_id": "066b0394-ce23-3878-800f-61c82876292a",
                                        "glosses": [
                                            "Religious disbelief; lack of faith."
                                        ],
                                        "tags": [
                                            "rare",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c8fb9074-2581-4576-acb4-7898f0cee4cf",
                        "source_entry_id": "b3882dcb-f3e0-3e30-8c2f-b12a2c26c33b",
                        "target_lang_word": "incredulità",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "incredulità",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "211ac2ef-c07f-34d6-9e26-1a16a9294ff4",
                                        "entry_id": "c11aa070-7267-3ff0-8e80-342365ea3f1e",
                                        "glosses": [
                                            "reazione immediata per qualcosa di inaspettato o non corretto"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7e3302f-0b47-4cc8-b2a8-2ba5a86575b3",
                                                "sense_id": "211ac2ef-c07f-34d6-9e26-1a16a9294ff4",
                                                "text": "poté riflettere in seguito all'incredulità vissuta"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ba02b22-a4b6-3276-88d1-cca7112b8aca",
                                        "entry_id": "c11aa070-7267-3ff0-8e80-342365ea3f1e",
