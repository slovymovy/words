                "senses": [
                    {
                        "sense_id": "ae685a23-0466-364f-a857-3c691a5d43d7",
                        "entry_id": "580f428e-85a8-313d-97f0-1ebdf772646f",
                        "glosses": [
                            "сделаться гладким, ровным, годным для езды"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb3a9d5e-4075-4e0b-88d5-d28a914eface",
                                "sense_id": "ae685a23-0466-364f-a857-3c691a5d43d7",
                                "text": "Дорога обкаталась."
                            }
                        ]
                    },
                    {
                        "sense_id": "e93de1fc-7a04-3cc9-b069-0206e2c071f2",
                        "entry_id": "580f428e-85a8-313d-97f0-1ebdf772646f",
                        "glosses": [
                            "спец. пройти пробные испытания, обкатку"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3621831-2bde-4a99-8443-036b8794b8d7",
                                "sense_id": "e93de1fc-7a04-3cc9-b069-0206e2c071f2",
                                "text": "Комбайн обкатался. Двигатель обкатался."
                            }
                        ]
                    },
                    {
                        "sense_id": "9df02c6e-c77e-3ded-b1b7-f015b78808ac",
                        "entry_id": "580f428e-85a8-313d-97f0-1ebdf772646f",
                        "glosses": [
                            "разг. после многократного повторения, обсуждения и т. п. стать слаженным, отработанным"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18e65da3-f94e-45e0-9dc4-87378303cf30",
                                "sense_id": "9df02c6e-c77e-3ded-b1b7-f015b78808ac",
                                "text": "Спектакль обкатался. Вопрос обкатался."
                            }
                        ]
                    },
                    {
                        "sense_id": "b9b15e87-0a07-343d-9d1a-1f53246031ae",
                        "entry_id": "580f428e-85a8-313d-97f0-1ebdf772646f",
                        "glosses": [
                            "разг. усвоить общепринятую манеру поведения, приспособиться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "346d041c-a30c-484b-a2a7-63becb77cd02",
                                "sense_id": "b9b15e87-0a07-343d-9d1a-1f53246031ae",
                                "text": "Он ещё скован в своих действиях, но ничего, обкатается со временем."
                            },
                            {
                                "example_id": "9bd488a3-3f76-4f52-a9c0-a17b13639075",
                                "sense_id": "b9b15e87-0a07-343d-9d1a-1f53246031ae",
                                "text": "Испугало, ибо я считал, что, прежде чем начинать работать в таких городах, как Москва и Ленинград, хорошо бы побольше обкататься в провинции, а обрадовало тем, что я предвкушал удовольствие от встреч с однополчанами-ленинградцами, с которыми не виделся более трех лет."
                            }
                        ]
                    }
