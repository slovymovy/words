        "nl-extract.jsonl": [
            {
                "entry_id": "a73d4f6b-f66c-3b7c-b851-5e3b9ec0dd1f",
                "word": "schooien",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "48f72f91-c6b1-3e28-b9e1-8c21e3355c87",
                        "entry_id": "a73d4f6b-f66c-3b7c-b851-5e3b9ec0dd1f",
                        "glosses": [
                            "iets vragen zonder iets terug te willen geven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "787e569a-2690-499a-b75e-7e495e403106",
                                "sense_id": "48f72f91-c6b1-3e28-b9e1-8c21e3355c87",
                                "text": "Pas op, ik kan volledig begrijpen waarom ik door niemand word meegevraagd op reis. Het is alsof je met Gargamel op ­vakantie bent. Ik ben een aan technologie verslaafde luxepony en bovendien een flinke zeur. Zomervakantie, ik snap niet hoe dat moet. Leg mij twee minuten in een hangmat of aan een strand en ik krijg een milde angstaanval. Overal loop ik te schooien om het paswoord van de wifi."
                            },
                            {
                                "example_id": "5b6c2e22-b716-434e-8e35-a510f310e71c",
                                "sense_id": "48f72f91-c6b1-3e28-b9e1-8c21e3355c87",
                                "text": "Uit het artikel People at zoos: the sociological approach blijkt dat bezoekers van dierenparken vrijwel uitsluitend geïnteresseerd zijn in dieren die: om eten vragen, schooien; eten; pas geboren zijn; geluid maken; of menselijk gedrag imiteren. Voor rustende dieren of dieren die zich verstoppen, is geen aandacht."
                            }
                        ]
                    },
                    {
                        "sense_id": "a941c6a7-19c3-360c-90b8-78a5c8b3b455",
                        "entry_id": "a73d4f6b-f66c-3b7c-b851-5e3b9ec0dd1f",
                        "glosses": [
                            "rondzwerven zonder duidelijk plan"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ccd7beaa-6060-4040-a513-f3ad36dd3e52",
                        "source_entry_id": "a73d4f6b-f66c-3b7c-b851-5e3b9ec0dd1f",
                        "source_sense_id": "48f72f91-c6b1-3e28-b9e1-8c21e3355c87",
                        "source_sense_description": "bedelen",
                        "target_lang_word": "beg",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "beg",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1787b040-7895-3a17-a579-a57f03b1210f",
                                        "entry_id": "cd5a30c5-7320-30ab-b4af-9d73b00eafc2",
                                        "glosses": [
                                            "To request the help of someone, often in the form of money."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "102c4463-50a8-45d8-8454-434616552a36",
                                                "sense_id": "1787b040-7895-3a17-a579-a57f03b1210f",
                                                "text": "He begged on the street corner from passers-by."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c136a8f3-dee7-3ad3-a7b4-94e14a0c3ce9",
                                        "entry_id": "cd5a30c5-7320-30ab-b4af-9d73b00eafc2",
                                        "glosses": [
                                            "To plead with someone for help, a favor, etc.; to entreat."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4049c50f-d647-4460-820d-5712ff8d1a1a",
                                                "sense_id": "c136a8f3-dee7-3ad3-a7b4-94e14a0c3ce9",
                                                "text": "I beg your pardon. I didn’t mean to cause offence."
                                            },
                                            {
                                                "example_id": "b94bee76-1050-40b8-b6c6-1cf775a1f603",
                                                "sense_id": "c136a8f3-dee7-3ad3-a7b4-94e14a0c3ce9",
                                                "text": "He begged her to go to the prom with him."
                                            },
                                            {
                                                "example_id": "62a1b8ad-0ad1-4d91-8bde-0f3005a84d89",
                                                "sense_id": "c136a8f3-dee7-3ad3-a7b4-94e14a0c3ce9",
                                                "text": "you do beg your good will in this case."
                                            },
                                            {
                                                "example_id": "d3e52b40-cc7a-4334-bc51-cec61ccf0308",
                                                "sense_id": "c136a8f3-dee7-3ad3-a7b4-94e14a0c3ce9",
                                                "text": "[Joseph] begged the body of Jesus."
                                            },
                                            {
                                                "example_id": "d2e4d4a6-ef4c-403f-bf85-6463eaf75d9c",
                                                "sense_id": "c136a8f3-dee7-3ad3-a7b4-94e14a0c3ce9",
                                                "text": "But that same day came Sam Tewkesbury to the Why Not? about nightfall, and begged a glass of rum, being, as he said, 'all of a shake' [...]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "615da720-ffae-3a3b-94e1-8e495c6c3c17",
                                        "entry_id": "cd5a30c5-7320-30ab-b4af-9d73b00eafc2",
                                        "glosses": [
                                            "To unwillingly provoke a negative, often violent, reaction."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12118b51-40be-4e04-8410-a12786f48874",
                                                "sense_id": "615da720-ffae-3a3b-94e1-8e495c6c3c17",
                                                "text": "The way you keep eating raw meat, you're just begging to get tapeworms."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c349e3c9-65e9-3013-b3dd-ce8b45393769",
                                        "entry_id": "cd5a30c5-7320-30ab-b4af-9d73b00eafc2",
                                        "glosses": [
                                            "To obviously lack or be in need of something."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a1538d5-b7ce-47b3-b1f7-6ef74b046df1",
                                                "sense_id": "c349e3c9-65e9-3013-b3dd-ce8b45393769",
                                                "text": "A captivating novel that just begs for a movie adaptation"
                                            },
                                            {
                                                "example_id": "de519b6c-db11-421d-aa3a-aaaa7bf88446",
                                                "sense_id": "c349e3c9-65e9-3013-b3dd-ce8b45393769",
                                                "text": "The colors in this cell are as dull as its architects must have been. An endless expanse of drab-green textured walls, contrasting with the gray concrete floor. It begs redecoration."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35f6cb85-97bc-33d1-808a-4f39c819aaa4",
                                        "entry_id": "cd5a30c5-7320-30ab-b4af-9d73b00eafc2",
                                        "glosses": [
                                            "In the phrase beg the question: to assume."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1024521c-ccd9-3921-abd0-508fe0c32efe",
                                        "entry_id": "cd5a30c5-7320-30ab-b4af-9d73b00eafc2",
                                        "glosses": [
                                            "In the phrase beg the question: to raise (a question)."
                                        ],
                                        "tags": [
                                            "proscribed",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6c6a5255-42bf-33fc-ad5b-fd37aafbdafe",
                                        "entry_id": "cd5a30c5-7320-30ab-b4af-9d73b00eafc2",
                                        "glosses": [
                                            "To ask to be appointed guardian for, or to ask to have a guardian appointed for."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63f71ee2-73c8-4d12-bb60-be1223a5c96d",
                                                "sense_id": "6c6a5255-42bf-33fc-ad5b-fd37aafbdafe",
                                                "text": "Else some will beg thee, in the court of wards."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "beg",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "65159572-450c-310e-a215-00c4e5236f6f",
