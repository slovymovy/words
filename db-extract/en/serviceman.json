                                "target_senses": [
                                    {
                                        "sense_id": "89ba108b-ead3-3039-ad57-7951ef681d83",
                                        "entry_id": "ef46b4d6-9c21-3d01-b63d-c8d80a639949",
                                        "glosses": [
                                            "Person, die dem Militär angehört"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "558dcc7a-c581-4f21-8620-9e75b14ba156",
                                                "sense_id": "89ba108b-ead3-3039-ad57-7951ef681d83",
                                                "text": "„Sechs Jahre später erhob ein anonymer britischer Militärangehöriger über die Medien den Vorwurf, die Armee habe mit dem Angriff den Konflikt zwischen katholischen und protestantischen Milizen anheizen wollen, um Druck von der Armee zu nehmen.“"
                                            },
                                            {
                                                "example_id": "448d6c23-9573-4645-a59e-bd2d265a3587",
                                                "sense_id": "89ba108b-ead3-3039-ad57-7951ef681d83",
                                                "text": "„Neben der Bereitstellung von Land und Wohneigentum sowohl während des Dienstes als auch nach der Pensionierung verfügt die Armee über qualitativ vergleichsweise hochwertige Gesundheits-, Bildungs- und Freizeiteinrichtungen, deren Nutzung exklusiv Militärangehörigen und ihren Familien offenstehen.“"
                                            },
                                            {
                                                "example_id": "92fac680-57fe-4b85-b45f-985e11e89726",
                                                "sense_id": "89ba108b-ead3-3039-ad57-7951ef681d83",
                                                "text": "„Militärangehörige durften sich in der Öffentlichkeit nicht mehr in Uniform zeigen, und für die Fahrten zwischen der eigenen Wohnung und der Botschaft musste jeden Tag eine andere Strecke gewählt werden, wenn man nicht gleich von einem gepanzerten Fahrzeug abgeholt wurde.“"
                                            },
                                            {
                                                "example_id": "50b13f98-a1d8-43c8-ae07-2c826d19662d",
                                                "sense_id": "89ba108b-ead3-3039-ad57-7951ef681d83",
                                                "text": "„In der neuen »Gartenstadt Stablack« lebten Militärangehörige.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
