            {
                "entry_id": "d27f4889-b889-332a-ab99-b79f5531722d",
                "word": "verboden",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5da57ee8-f16d-38cb-9103-071fa55a61bf",
                        "entry_id": "d27f4889-b889-332a-ab99-b79f5531722d",
                        "glosses": [
                            "dat iets niet is toegestaan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dab0d8ca-7795-4d45-86fe-74a94f8700f0",
                                "sense_id": "5da57ee8-f16d-38cb-9103-071fa55a61bf",
                                "text": "Het is toch raar als je dingen krijgt waar je niet om hebt gevraagd? Het is een inbreuk, het betreden van verboden terrein."
                            },
                            {
                                "example_id": "4cf742b1-83ad-4519-980b-1cabd371ee7c",
                                "sense_id": "5da57ee8-f16d-38cb-9103-071fa55a61bf",
                                "text": "Als ze zich Hanna's opmerking over de burgemeesters en de verboden popjes voor Kerstmis herinnert, vraagt ze zich af of de miniatuurmaakster haar ooit nog iets zal sturen."
                            },
                            {
                                "example_id": "ed60dfcf-7585-4a30-a1c1-62a2b5bde230",
                                "sense_id": "5da57ee8-f16d-38cb-9103-071fa55a61bf",
                                "text": "Nella voelt de ijskoude Jack tegen haar been, en het verboden voorwerp maakt een donkere, vochtige kring in de wol."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
