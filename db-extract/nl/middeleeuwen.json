                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3c4620ce-a373-3c8b-bba8-73d29107481b",
                                        "entry_id": "452de687-2c12-3efa-bd66-e3ee7598e9b2",
                                        "glosses": [
                                            "mittlere Epoche in der Geschichte"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "507cd27c-8894-4f35-a26e-deb6db190b93",
                                                "sense_id": "3c4620ce-a373-3c8b-bba8-73d29107481b",
                                                "text": "Im Geschichtsunterricht befassen wir uns gerade mit dem Mittelalter."
                                            },
                                            {
                                                "example_id": "6a5b884f-0f24-4a00-b953-1150f8b043fa",
                                                "sense_id": "3c4620ce-a373-3c8b-bba8-73d29107481b",
                                                "text": "„Das Mittelalter verwandelte die Landschaft um der Burgen und Mauern, der Wehr- und Wachttürme willen, die in den Anschauungen, im Leben der Menschen eine so große Rolle spielten, in einen Aufbau von Bastionen, die die Natur ihm zuliebe gleichsam anbot und ausgebildet hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f0c98bf7-31da-33f2-b839-fff326cfb267",
                                        "entry_id": "452de687-2c12-3efa-bd66-e3ee7598e9b2",
                                        "glosses": [
                                            "mittlere Epoche in der Geschichte",
                                            "Epoche in der europäischen Geschichte zwischen der Antike und der Neuzeit, die christliche, antike und keltische, germanische und slawische Entwicklungen zusammenführt"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c89e2de-8ee1-409c-a06e-95b35c95a21a",
                                                "sense_id": "f0c98bf7-31da-33f2-b839-fff326cfb267",
                                                "text": "„Im Mittelalter waren Pfründen mit einem kirchlichen Amt verbundene Einnahmen.“"
                                            },
                                            {
                                                "example_id": "2661dd22-2e50-407c-a452-dbd158272226",
                                                "sense_id": "f0c98bf7-31da-33f2-b839-fff326cfb267",
                                                "text": "„Natürlich sind wir uns der immensen Kluft bewusst, die uns in technologischer Hinsicht vom Mittelalter trennt.“"
                                            },
                                            {
                                                "example_id": "5eeac1ad-52c1-4df5-a84a-c0edb484e54e",
                                                "sense_id": "f0c98bf7-31da-33f2-b839-fff326cfb267",
                                                "text": "„Die Übernahme lateinischen Wortgutes wird durch das Mittelalter fortgesetzt.“"
                                            },
                                            {
                                                "example_id": "76e5025d-8ac8-40b1-ab76-bbcc910159f9",
                                                "sense_id": "f0c98bf7-31da-33f2-b839-fff326cfb267",
                                                "text": "„Cividale hat Glück gehabt, dass es im Mittelalter in relative Bedeutungslosigkeit versank.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1a\""
                                    },
                                    {
                                        "sense_id": "f1d70d53-88a6-3696-997b-65d5a5f9ff58",
                                        "entry_id": "452de687-2c12-3efa-bd66-e3ee7598e9b2",
                                        "glosses": [
                                            "mittlere Epoche in der Geschichte",
                                            "Epoche in der japanischen Geschichte, die sich von ca. 1200 bis ca. 1600 erstreckt und durch eine starke Dominanz des Buddhismus und des Feudalismus auszeichnet"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [],
