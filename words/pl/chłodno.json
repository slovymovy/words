                    "sense_definition": "o temperaturze powietrza lub otoczenia: w sposób odczuwalnie zimny",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "temperatura",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W pokoju jest <w>chłodno</w>, więc lepiej załóż cieplejszy sweter.",
                            "target_lang_translations": {
                                "en": "It is <w>chilly</w> in the room, so you had better put on a warmer sweater.",
                                "ru": "В комнате <w>прохладно</w>, так что лучше надень свитер потеплее.",
                                "nl": "Het is <w>fris</w> in de kamer, dus trek maar een warmere trui aan.",
                                "de": "Im Zimmer ist es <w>kühl</w>, zieh dir also lieber einen wärmeren Pullover an.",
                                "fr": "Il <w>fait frais</w> dans la chambre, tu ferais donc mieux de mettre un pull plus chaud.",
                                "it": "In stanza fa <w>fresco</w>, quindi è meglio che ti metta un maglione più pesante.",
                                "cs": "V pokoji je <w>chladno</w>, takže si raději vezmi teplejší svetr.",
                                "tr": "Oda <w>serin</w>, bu yüzden daha kalın bir kazak giysen iyi olur.",
                                "es": "Hace <w>fresco</w> en la habitación, así que mejor ponte un suéter más abrigado.",
                                "zh": "房间里有点<w>凉</w>，你最好穿件更暖和的毛衣。"
                            }
                        },
                        {
                            "text": "Wieczorem na dworze zrobiło się bardzo <w>chłodno</w>.",
                            "target_lang_translations": {
                                "en": "In the evening, it became very <w>cold</w> outside.",
                                "ru": "Вечером на улице стало очень <w>холодно</w>.",
                                "nl": "'s Avonds werd het buiten erg <w>koud</w>.",
                                "de": "Am Abend ist es draußen sehr <w>kühl</w> geworden.",
                                "fr": "Le soir, il s'est mis à faire très <w>frais</w> dehors.",
                                "it": "La sera fuori ha iniziato a fare molto <w>freddo</w>.",
                                "cs": "Večer se venku udělalo velmi <w>chladno</w>.",
                                "tr": "Akşamleyin dışarısı çok <w>soğuk</w> oldu.",
                                "es": "Por la noche se puso muy <w>frío</w> afuera.",
                                "zh": "到了晚上，外面变得非常<w>凉</w>。"
                            }
                        }
