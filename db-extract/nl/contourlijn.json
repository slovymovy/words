                "senses": [
                    {
                        "sense_id": "12e967aa-c97e-376d-b315-539cb57f43d4",
                        "entry_id": "1db5da34-3ad7-370b-8dd1-a938201b32ba",
                        "glosses": [
                            "verzameling van punten waar een functie met twee variabelen een gelijke waarde heeft"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "4f303355-a848-38f7-8eae-8c6999b7e3ba",
                        "entry_id": "1db5da34-3ad7-370b-8dd1-a938201b32ba",
                        "glosses": [
                            "lijn die een figuur scherp afgrenst ten opzichte van de omgeving"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76caa279-b9d5-48c3-a89f-f86dee4e51b7",
                                "sense_id": "4f303355-a848-38f7-8eae-8c6999b7e3ba",
                                "text": "Hun meubelen bestaan uit contourlijnen en kleurvlakken, alsof het eenvoudige potloodtekeningen in de ruimte zijn. ‘Of we nu een rek of een stoel ontwerpen, we zoeken altijd een dialoog op met de ruimte’, vertelt Van Severen. ‘Daarom zijn onze objecten op een zekere manier transparant.’ De ontwerpers willen niet dat de ruimte achter hun meubelen ‘verdwijnt’."
                            },
                            {
                                "example_id": "a9262295-59dc-4640-b68f-d8d96f2be962",
                                "sense_id": "4f303355-a848-38f7-8eae-8c6999b7e3ba",
                                "text": "Een leuke extra is het peneffect, waarmee je een reguliere schets verandert in een kunstzinnig uitziende, omdat de app alle contourlijnen behoudt en achtergrondkleuren verwijdert."
                            },
                            {
                                "example_id": "21c5d710-0982-46b5-b280-771f8d74d9ba",
                                "sense_id": "4f303355-a848-38f7-8eae-8c6999b7e3ba",
                                "text": "Ook vandaag blijft Nijntje nawerken. „Alle hedendaagse tekenaars zijn opgegroeid met Nijntje, onbewust neem je zijn erfenis mee. Zijn werk blijft nog altijd overeind”, zegt de Vlaamse illustrator en grafisch vormgever Pieter Gaudesaboos. „Van Bruna leerde ik vooral dat je met weinig veel kan doen. Hij slaagt erin om een hele wereld op te roepen met één contourlijn.” De Standaard van 30 juli 2014"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a484cad0-be13-41ba-a7be-25b81c13c817",
                        "source_entry_id": "1db5da34-3ad7-370b-8dd1-a938201b32ba",
                        "source_sense_id": "12e967aa-c97e-376d-b315-539cb57f43d4",
                        "target_lang_word": "contour",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "contour",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f475f6ab-cc91-3b92-ae31-5308b53cccfb",
                                        "entry_id": "dbb063d5-d54d-3b6c-bd16-3d3f2cde1e40",
                                        "glosses": [
                                            "An outline, boundary or border, usually of curved shape."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86161b6e-a734-4ac3-858b-409be3f37bf3",
                                                "sense_id": "f475f6ab-cc91-3b92-ae31-5308b53cccfb",
                                                "text": "the low drag contour of a modern automobile"
                                            },
                                            {
                                                "example_id": "d473d297-09f6-4570-9c64-e36ffa32ee1c",
                                                "sense_id": "f475f6ab-cc91-3b92-ae31-5308b53cccfb",
                                                "text": "The semi-streamlined contour of the earlier G.W.R. railcars has been given up in favour of a more utilitarian blunt-nose end, and effective floor space gained thereby."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "293005fd-f7db-3fdf-bf80-6cec9524eadf",
                                        "entry_id": "dbb063d5-d54d-3b6c-bd16-3d3f2cde1e40",
                                        "glosses": [
                                            "A line on a map or chart delineating those points which have the same altitude or other plotted quantity: a contour line or isopleth; (metonymically) the landform or its surface."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "64fc5948-df9e-394a-a08e-0fb02150d446",
                                        "entry_id": "dbb063d5-d54d-3b6c-bd16-3d3f2cde1e40",
                                        "glosses": [
                                            "a speech sound which behaves as a single segment, but which makes an internal transition from one quality, place, or manner to another."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d90a43e2-d54f-3b4f-879f-e2dc4c8a3f0b",
                                        "entry_id": "dbb063d5-d54d-3b6c-bd16-3d3f2cde1e40",
                                        "glosses": [
                                            "A general description giving the most important points."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e50b1e7-b0c0-4d1b-9689-f8cf2d01cd16",
                                                "sense_id": "d90a43e2-d54f-3b4f-879f-e2dc4c8a3f0b",
                                                "text": "Contours of a deal with conservative holdouts who had been blocking McCarthy’s rise had emerged the night before, and took hold after four dismal days and 14 failed votes in an intraparty standoff unseen in modern times."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "contour",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b459ad59-680f-3b6e-8cc6-28ecc98e2cde",
                                        "entry_id": "865291b3-1a91-35de-a2e4-7a2b7c17bc9b",
                                        "glosses": [
                                            "To form a more or less curved boundary or border upon."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d4367321-ead2-3ad1-b287-a9869e6e2228",
                                        "entry_id": "865291b3-1a91-35de-a2e4-7a2b7c17bc9b",
                                        "glosses": [
                                            "To mark with contour lines."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "15307d70-7265-3a17-8eda-2c807321c333",
                                        "entry_id": "865291b3-1a91-35de-a2e4-7a2b7c17bc9b",
                                        "glosses": [
                                            "To practise the makeup technique of contouring."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2d22b2a-9483-474e-a164-940fda237c2d",
                                                "sense_id": "15307d70-7265-3a17-8eda-2c807321c333",
                                                "text": "What is the French-preferred method to add dimension to the skin, if not to contour?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f96e9161-f013-366d-8557-36759dcccc71",
                                        "entry_id": "865291b3-1a91-35de-a2e4-7a2b7c17bc9b",
                                        "glosses": [
                                            "To shape conditions regarding salient points."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a349284-3d3a-4e34-92bf-af2d586fdc79",
                                                "sense_id": "f96e9161-f013-366d-8557-36759dcccc71",
                                                "text": "But the bill will exact a heavy cost — one that will complicate its prospects even if it passes the full House this week and will contour the political climate ahead of 2026 midterm elections."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
