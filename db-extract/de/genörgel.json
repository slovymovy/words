                        "sense_id": "380030fc-f776-3260-bf06-090c799940cd",
                        "entry_id": "d323ab14-fd10-3fef-9a8f-f4610b2c22d3",
                        "glosses": [
                            "anhaltende Äußerung von Unmut, fortwährendes Meckern"
                        ],
