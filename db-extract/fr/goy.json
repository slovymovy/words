                    {
                        "sense_id": "510b4fce-a61a-34ef-83bb-328c3ee5850e",
                        "entry_id": "f344ff30-5cfc-37e1-bcbe-b3d111da63e2",
                        "glosses": [
                            "Non juif."
                        ],
                        "tags": [
                            "Judaism"
                        ],
                        "examples": [
                            {
                                "example_id": "23e3b385-38a1-493e-a56e-93bc168941c4",
                                "sense_id": "510b4fce-a61a-34ef-83bb-328c3ee5850e",
                                "text": "C'est fini, Laurent, c'est fini. Je ne serai pas le Messie.\n− Pourquoi? fis-je, la voix chargée de reproches sincères.\nIl [Justin Weill] secoua la tête : − J'aime une fille goye."
                            }
                        ]
                    }
                ],
