                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8cc125a8-1a22-3c4b-a4f8-79618259b909",
                                        "entry_id": "45b27085-ba83-3a27-8c08-8ec072649d5e",
                                        "glosses": [
                                            "Habitant ou natif du Limousin."
