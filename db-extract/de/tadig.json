                "senses": [
                    {
                        "sense_id": "ade2f174-4d5e-3710-8594-54223bc2ea9d",
                        "entry_id": "29bc7290-713f-341c-b621-684b6930f884",
                        "glosses": [
                            "persisches Reisgericht, die Kruste, die der Reis am Topfboden gebildet hat"
                        ],
                        "tags": [
                            "oft auch speziell"
                        ],
                        "examples": [
                            {
                                "example_id": "87fcc432-2999-4a07-bd6f-2c441cfdb637",
                                "sense_id": "ade2f174-4d5e-3710-8594-54223bc2ea9d",
                                "text": "„Habt ihr schon mal Tadig probiert? Das ist eine herrliche goldgelbe Kruste, die durch die spezielle Art des Garens entsteht! Sie macht das Reisessen zu einem neuen Erlebnis.“"
                            },
                            {
                                "example_id": "5abe82ff-fb84-416e-b6ed-69f7596cdcab",
                                "sense_id": "ade2f174-4d5e-3710-8594-54223bc2ea9d",
                                "text": "„Der beste Teil vom Reis ist die knusprige Kruste (oder Tadig, wörtlich übersetzt: „am Topfboden“), die entsteht, wenn man den Reis im Topf oder im Reiskocher zubereitet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "84b8bcf2-9112-432f-a460-d9d263b1e596",
                        "source_entry_id": "29bc7290-713f-341c-b621-684b6930f884",
                        "source_sense_id": "ade2f174-4d5e-3710-8594-54223bc2ea9d",
                        "source_sense_description": "persisches Reisgericht, oft auch speziell: die Kruste, die der Reis am Topfboden gebildet hat",
                        "target_lang_word": "tadig",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tadig",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "05175813-98a9-3fd6-a34d-a233602859e5",
                                        "entry_id": "4d69f9c6-60a1-3365-8962-1d41b281dfa5",
                                        "glosses": [
                                            "In Iranian cuisine, crisp rice taken from the bottom of the pot."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3959831b-7da1-471f-b46a-1dbf3a23198b",
                                                "sense_id": "05175813-98a9-3fd6-a34d-a233602859e5",
                                                "text": "Perfectly made tadig will slip out, golden crust and all, onto the serving dish. Enjoy hot. Potato tadig: Another kind of tadig can be made by layering the bottom of the pot with thin slices of potato."
                                            },
                                            {
                                                "example_id": "c9657af1-5f1c-4b24-9311-aaa887042a89",
                                                "sense_id": "05175813-98a9-3fd6-a34d-a233602859e5",
                                                "text": "This should produce a crunchy layer of rice at the bottom, which is called Tadig in Persian."
                                            },
                                            {
                                                "example_id": "d43f7f31-0900-4feb-9069-bd94e9eca7ca",
                                                "sense_id": "05175813-98a9-3fd6-a34d-a233602859e5",
                                                "text": "The bottom of rice will be a thick crust of rice, called \"Tadig\"."
                                            },
                                            {
                                                "example_id": "b74008fe-c8bd-470b-a13e-af80be9ab854",
                                                "sense_id": "05175813-98a9-3fd6-a34d-a233602859e5",
                                                "text": "What I really like is the tadig…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
