                        "cross_references": [
                            {
                                "target_word": "lintel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "35d70a70-5ad9-303b-afe2-0e4b514e8458",
                                        "entry_id": "34901cef-d724-3bef-8ae3-9ff306f31ae8",
                                        "glosses": [
                                            "A horizontal structural beam spanning an opening, such as between the uprights of a door or a window, and which supports the wall above."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bcddff24-daca-44a3-a78f-bb9d9a364749",
                                                "sense_id": "35d70a70-5ad9-303b-afe2-0e4b514e8458",
                                                "text": "Athelny had told him that he lived in a house built by Inigo Jones; he had raved, as he raved over everything, over the balustrade of old oak; and when he came down to open the door for Philip he made him at once admire the elegant carving of the lintel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "989e54f5-6610-4708-8d38-4f3dd767ecea",
                        "source_entry_id": "627ba2bd-09f4-319b-92cd-74daf6f4aa61",
                        "source_sense_id": "f4e5542b-ba3b-3de1-9f32-b8a97d7966d0",
                        "source_sense_description": "latei",
                        "target_lang_word": "linteau",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "linteau",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3973c3e2-64d7-34e3-9ed5-7a328e2757ca",
                                        "entry_id": "4c8f1b19-eb6a-3f62-b4ff-88777568c87f",
                                        "glosses": [
                                            "Traverse horizontale reposant sur deux points d'appui au-dessus d'une ouverture, d’une baie, pour soutenir la maçonnerie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5872f7c-500d-46c3-a57d-027e69d72a94",
                                                "sense_id": "3973c3e2-64d7-34e3-9ed5-7a328e2757ca",
                                                "text": "Ses murs longs, indestructibles, étaient bâtis d’un sombre travertin, une corniche colossale, magnifiquement assemblée, couronnait le sommet, des linteaux de marbre encadraient le portail et les fenêtres étaient grandioses, chargées de magnifiques ornements architecturaux ; […]."
                                            },
                                            {
                                                "example_id": "e61e334e-f379-4910-bcc3-8470e2429ee7",
                                                "sense_id": "3973c3e2-64d7-34e3-9ed5-7a328e2757ca",
                                                "text": "L’ensemble du linteau, de deux poteaux d’huisserie et de l’appui E, constitue l’huisserie d’une porte ou d’une fenêtre."
                                            },
                                            {
                                                "example_id": "7a84db31-a490-4ec7-a574-3d129f4c1e72",
                                                "sense_id": "3973c3e2-64d7-34e3-9ed5-7a328e2757ca",
                                                "text": "Nous devons citer comme curiosité botanique de Mont-Saint-Martin l'énorme touffe de Joubarbe (Sempervivum tectorum), garnissant le linteau de la porte de l'une des maisons du village."
                                            },
                                            {
                                                "example_id": "c1798bf4-26aa-40e3-9f22-acc35b34553e",
                                                "sense_id": "3973c3e2-64d7-34e3-9ed5-7a328e2757ca",
                                                "text": "Il poussa la porte si fort que le fer à cheval suspendu au linteau de chêne tinta faiblement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49ce2242-4c5c-3688-a2c8-508965448fec",
                                        "entry_id": "4c8f1b19-eb6a-3f62-b4ff-88777568c87f",
                                        "glosses": [
                                            "Morceau de fer placé au haut d’une porte ou d’une grille, pour recevoir les tourillons."
                                        ],
                                        "tags": [
                                            "Serrurerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58aac5ae-65b4-41c3-8592-c7791bfa3190",
                                                "sense_id": "49ce2242-4c5c-3688-a2c8-508965448fec",
                                                "text": "Le montant du derrière des portes, est à pivot par le bas, & à tourillon par le haut. Le pivot entre dans une crapaudine, & le tourillon passe au travers du linteau."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
