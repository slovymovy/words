                ],
                "senses": [
                    {
                        "sense_id": "f1bb80c2-a1cf-3da8-8dea-9e1d08369b3f",
                        "entry_id": "83f7d7a9-b26d-3b1c-b13c-2faac655df1c",
                        "glosses": [
                            "An electrical device that detects short circuits and isolates them."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "39588865-1d6b-3ac5-867b-0adf59af1267",
                        "entry_id": "83f7d7a9-b26d-3b1c-b13c-2faac655df1c",
                        "glosses": [
                            "A device that isolates something from the surrounding environment to keep it sterile."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43fb73a8-23ad-4347-b91a-4af13c56652c",
                                "sense_id": "39588865-1d6b-3ac5-867b-0adf59af1267",
                                "text": "The term ‘Isolator’ as used in the Pharmaceutical Industry covers a variety of pieces of equipment. One group has the main objective of providing containment for the handling of dangerous materials either aseptically or not. Another group has the main objective of providing a microbiologically controlled environment within which aseptic operations can be carried out."
                            },
                            {
                                "example_id": "5b76b6e9-8ec3-4d18-9c8f-e0bb606d733e",
                                "sense_id": "39588865-1d6b-3ac5-867b-0adf59af1267",
                                "text": "The use of isolator technology to minimize human interventions in processing areas may result in a significant decrease in the risk of microbial contamination of aseptically manufactured products from the environment. There are many possible designs of isolators and transfer devices ."
                            }
                        ]
                    },
                    {
                        "sense_id": "b2a0914b-c7a3-3cb9-8341-837d80c6a424",
                        "entry_id": "83f7d7a9-b26d-3b1c-b13c-2faac655df1c",
                        "glosses": [
                            "A transparent box for holding small live animals."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8fb24122-b128-4c0d-9ec4-08821a60161f",
                                "sense_id": "b2a0914b-c7a3-3cb9-8341-837d80c6a424",
                                "text": "2009, Official Journal of the European Union, DIRECTIVE 2009/41/EC OF THE EUROPEAN PARLIAMENT AND OF THE COUNCIL of 6 May 2009 on the contained use of genetically modified micro-organisms, DIRECTIVES, eur-lex.europa.eu\nFilters on isolators or isolated room. Isolators: transparent boxes where small animals are contained within or outside a cage; for large animals, isolated rooms may be more appropriate."
                            }
                        ]
                    }
                ],
