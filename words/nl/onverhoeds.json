                            "target_lang_translations": {
                                "en": "The cyclist had to swerve <w>unexpectedly</w> for a car door opening."
                            }
                        },
                        {
                            "text": "Toen de regisseur <w>onverhoeds</w> binnenkwam, stopten de acteurs direct met hun gesprek.",
                            "target_lang_translations": {
                                "en": "When the director entered <w>abruptly</w>, the actors immediately stopped their conversation."
                            }
                        }
