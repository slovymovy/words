            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e96d53f7-d4da-3f75-aded-9d01024102bd",
                    "sense_definition": "Warunki materialne, środki finansowe i zasoby niezbędne do życia oraz utrzymania się na odpowiednim poziomie.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "material_conditions",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Rodzice ciężko pracują, aby zapewnić swoim dzieciom godny i bezpieczny <byt>.",
                            "target_lang_translations": {
                                "ru": "Родители много работают, чтобы обеспечить своим детям достойное и безопасное <существование>.",
                                "en": "Parents work hard to provide their children with a dignified and secure <w>existence</w>."
                            }
                        },
                        {
                            "text": "Znane powiedzenie filozoficzne mówi, że <byt> określa świadomość człowieka.",
                            "target_lang_translations": {
                                "ru": "Известное философское изречение гласит, что <бытие> определяет сознание человека.",
                                "en": "A famous philosophical saying states that <w>being</w> determines human consciousness."
                            }
                        }
                    ],
                    "synonyms": [
                        "utrzymanie",
                        "egzystencja",
                        "życie"
                    ],
                    "antonyms": [
                        "nędza",
                        "ubóstwo"
                    ],
                    "common_phrases": [
                        "zapewnić byt",
                        "godny byt",
                        "polepszyć byt",
                        "byt określa świadomość"
                    ],
                    "target_lang_definitions": {
                        "ru": "Материальные условия, финансовые средства и ресурсы, необходимые для жизни и поддержания достойного уровня.",
                        "en": "Material conditions, financial means, and resources necessary for living and maintaining an appropriate standard of life."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "существование",
                                "target_lang_sense_clarification": "средства к жизни, материальное обеспечение"
                            },
                            {
                                "target_lang_word": "бытие",
                                "target_lang_sense_clarification": "философское понятие материальной жизни"
                            },
                            {
                                "target_lang_word": "жизнь",
                                "target_lang_sense_clarification": "условия проживания"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "existence",
                                "target_lang_sense_clarification": "material means and standard of living"
                            },
                            {
                                "target_lang_word": "livelihood",
                                "target_lang_sense_clarification": "means of securing the necessities of life"
                            },
                            {
                                "target_lang_word": "living",
                                "target_lang_sense_clarification": "financial means to support oneself"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "51109a06-91d2-326d-8b5f-92c813489ae0",
                    "sense_definition": "Fakt istnienia, trwania w rzeczywistości; samo życie jako proces biologiczny lub filozoficzny.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "existence_abstract",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wielu myślicieli przez wieki zastanawiało się nad sensem ludzkiego <bytu>.",
                            "target_lang_translations": {
                                "ru": "Многие мыслители веками размышляли над смыслом человеческого <бытия>.",
                                "en": "Many thinkers over the centuries have wondered about the meaning of human <w>existence</w>."
                            }
                        },
                        {
                            "text": "Ciągła walka o <byt> jest nieodłącznym elementem świata dzikiej przyrody.",
                            "target_lang_translations": {
                                "ru": "Постоянная борьба за <существование> является неотъемлемой частью мира дикой природы.",
                                "en": "The constant struggle for <w>survival</w> is an inherent element of the world of wild nature."
                            }
                        }
                    ],
                    "synonyms": [
                        "istnienie",
                        "egzystencja",
                        "trwanie"
                    ],
                    "antonyms": [
                        "niebyt",
                        "nicość",
                        "śmierć"
                    ],
                    "common_phrases": [
                        "walka o byt",
                        "sens bytu",
                        "prawo bytu"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often literary or philosophical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Факт существования, пребывания в действительности; жизнь как биологический или философский процесс.",
                        "en": "The fact of existing or continuing in reality; life itself as a biological or philosophical process."
                    },
                    "translations": {
