                ],
                "senses": [
                    {
                        "sense_id": "8727f28c-dfb1-3bbf-8dc6-f9e7336c7640",
                        "entry_id": "5bf888ff-08fe-3c34-8d99-29374d2aff38",
                        "glosses": [
                            "kleiner Mantel, kurze Jacke"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c52ab4e5-1ce5-4de2-b112-5315d5d95b0d",
                                "sense_id": "8727f28c-dfb1-3bbf-8dc6-f9e7336c7640",
                                "text": "Du hast aber ein hübsches Mäntelchen an."
                            },
                            {
                                "example_id": "4d5092d6-df7f-4399-89be-7a7a5960152f",
                                "sense_id": "8727f28c-dfb1-3bbf-8dc6-f9e7336c7640",
                                "text": "„Auch die Grenzen von Captagon, Rosimon und AN I testete er aus, so seine Diktion, immer bemüht, sich ein wissenschaftliches Mäntelchen umzuhängen.“"
                            },
                            {
                                "example_id": "87f622b2-cb05-452b-a876-080e6a3d4884",
                                "sense_id": "8727f28c-dfb1-3bbf-8dc6-f9e7336c7640",
                                "text": "„Sie zogen sich an, und während wir auf den Kaffee warteten, gab ich Irene zwölf doppelte Louis und noch vier weitere, um ihr Mäntelchen auszulösen.“"
                            },
                            {
                                "example_id": "8879de24-28aa-4d6f-9983-4cc7ea322a30",
                                "sense_id": "8727f28c-dfb1-3bbf-8dc6-f9e7336c7640",
                                "text": "„Es trug ein schmutziges Mäntelchen.“"
                            },
                            {
                                "example_id": "e504cad1-485f-421b-8d17-118c16d32306",
                                "sense_id": "8727f28c-dfb1-3bbf-8dc6-f9e7336c7640",
                                "text": "„Dieser Lamm hatte sich eine hübsche Idee ausgedacht, um seinen Schiebergeschäften ein wirtschaftspolitisches Mäntelchen umzuhängen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
