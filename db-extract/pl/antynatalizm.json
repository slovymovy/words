                "senses": [
                    {
                        "sense_id": "737838ac-3e82-3945-b1ee-fa65f7d834e7",
                        "entry_id": "5655938d-2dc8-394e-a5c6-31507ad24812",
                        "glosses": [
                            "stanowisko przypisujące negatywną wartość ludzkiej prokreacji"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aefe06dc-b54d-4d6e-8101-b147df52e66a",
                                "sense_id": "737838ac-3e82-3945-b1ee-fa65f7d834e7",
                                "text": "(…) za antynatalizmem przemawiają te same argumenty, które są stosowane w rozważaniach o teodycei. To nie jest najlepszy ze światów"
                            },
                            {
                                "example_id": "007c9162-9769-47d4-95f4-0380e02d80a9",
                                "sense_id": "737838ac-3e82-3945-b1ee-fa65f7d834e7",
                                "text": "(…) twórca serialu „Detektyw”, przyznał, że jedną z inspiracji dla postaci nihilistycznego detektywa Rusta Cohle'a był właśnie antynatalizm"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ecb3712c-260e-4b3c-a379-fb6af0616711",
                        "source_entry_id": "5655938d-2dc8-394e-a5c6-31507ad24812",
                        "source_sense_id": "737838ac-3e82-3945-b1ee-fa65f7d834e7",
                        "target_lang_word": "antinatalism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antinatalism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7452f872-b9d7-3ce3-a58c-9c832a5bb775",
                                        "entry_id": "a580eae0-63d8-3578-9999-e258b6472e51",
                                        "glosses": [
                                            "A philosophical view that deems procreation as immoral."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d263dabd-f706-43fd-a299-f1ad70cccdf8",
                                                "sense_id": "7452f872-b9d7-3ce3-a58c-9c832a5bb775",
                                                "text": "Antinatalism is a negative view toward human fertility (and perhaps the fertility of other sentient life forms). Philanthropic antinatalism is the belief that humans should not have children for the good of the (unborn) children—that it is better, for humans, not to be born (Benatar, 2006)."
                                            },
                                            {
                                                "example_id": "92051595-5a43-40c9-8445-b42c519aad1e",
                                                "sense_id": "7452f872-b9d7-3ce3-a58c-9c832a5bb775",
                                                "text": "Efilism, a form of antinatalism also linked to promortalism, gets its name by spelling “life” backwards."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
