                        "entry_id": "7dacf6aa-4d7c-3ac5-b764-91d518d8df80",
                        "glosses": [
                            "grote tafel waaraan meerdere mensen kunnen zitten om met elkaar te kunnen overleggen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5d21bb1-bff9-44fa-96ed-4dd7fdf2d8fa",
                                "sense_id": "e747037f-8fcf-3c61-bec2-c085d388a87f",
                                "text": "Tijdens conferentie gebruikt men vaak een ronde vergadertafel zodat alle partijen een gelijkwaardige plaats hebben."
                            },
                            {
                                "example_id": "84e378f1-afe6-49a3-abb6-8b23874edfc2",
                                "sense_id": "e747037f-8fcf-3c61-bec2-c085d388a87f",
                                "text": "Een statige vergadertafel in een statige vergaderzaal is passend voor een belangrijk bestuur."
                            },
                            {
                                "example_id": "ce730fc3-f7ad-43e8-8a26-1a9c4746eb01",
                                "sense_id": "e747037f-8fcf-3c61-bec2-c085d388a87f",
                                "text": "Toen ze plaatsnamen aan het ene uiteinde van de buitenproportionele vergadertafel knipte ze plechtig het slot open van haar zwarte aktetas met het gouden logo en haalde de documenten eruit, het kwartaalrapport en de balans, die ze snel uitdeelde."
                            }
                        ]
                    }
