                        "glosses": [
                            "уменьш.-ласк. к косяк"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd1965fd-3409-44ee-937f-8f7e4332ccbb",
                                "sense_id": "89ed5381-0323-383d-813c-3e734bab09ed",
                                "text": "— Есть косячок! — первым заметил рыбу Щекал."
                            },
                            {
                                "example_id": "efedc6e8-a0c8-452f-8446-e787ae57fb6d",
                                "sense_id": "89ed5381-0323-383d-813c-3e734bab09ed",
                                "text": "Ева затягивается косячком, и усаживаясь на диван включает очередную серию, очередного сериала, параллельно открывает ноутбук и долгие часы до самой ночи, почти до утра, бесцельно серфит."
                            }
                        ]
                    }
