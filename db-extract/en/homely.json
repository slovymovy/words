                    },
                    {
                        "translation_id": "185c1e9c-7008-41c2-a71a-2ddab08895b9",
                        "source_entry_id": "0a2b10ca-5ffb-3ca4-9bfc-ea6088ed2683",
                        "source_sense_description": "characteristic of or belonging to home",
                        "target_lang_word": "heimatlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "heimatlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e9bb4c82-2713-3859-a2ed-59da09f8d688",
                                        "entry_id": "e67c48f9-16ec-3e50-b1b2-20dc0e7cedac",
                                        "glosses": [
                                            "den Umkreis der Herkunft betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aee3c450-f9f5-431d-9e5e-f0fcbff93d9b",
                                                "sense_id": "e9bb4c82-2713-3859-a2ed-59da09f8d688",
                                                "text": "„Er sammelte heimatliche Materialien und begründete 1934 (mit Unterstützung des Bezirksvorsteher) im Amtshaus für den elften Bezirk ein bescheidenes Heimatmuseum, in das er sein privates Sammelgut einbrachte.“"
                                            },
                                            {
                                                "example_id": "8bf65d42-537d-49d9-ad00-46e551d35bdd",
                                                "sense_id": "e9bb4c82-2713-3859-a2ed-59da09f8d688",
                                                "text": "„Der Bundesverkehrsminister, aus Bayern stammend, schont den heimatlichen Autokonzern nicht mehr.“"
                                            },
                                            {
                                                "example_id": "a4a53a57-735a-4620-aea2-0b1a8a98dd74",
                                                "sense_id": "e9bb4c82-2713-3859-a2ed-59da09f8d688",
                                                "text": "„Wo ist unser heimatlicher Herd der Ruhe?“"
                                            },
                                            {
                                                "example_id": "f9342e13-fde7-4d40-961f-4d38cdd8b8c5",
                                                "sense_id": "e9bb4c82-2713-3859-a2ed-59da09f8d688",
                                                "text": "„Die Ich-Gestalt und Bruder Otho (Ernst und Friedrich Georg Jünger) ziehen sich angesichts der Einäscherung mauretanischer Hauptstädte in heimatlichere Gefilde zurück.“"
                                            },
                                            {
                                                "example_id": "0c1f13e1-be1d-4c0e-98f2-0a48bb5ebf4a",
                                                "sense_id": "e9bb4c82-2713-3859-a2ed-59da09f8d688",
                                                "text": "„Denn sie ist in ihrer seltsamen Mischung aus schlicht und prätentiös, nah und entlegen für mich einer der heimatlichsten Orte in Hamburg.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
