                        "form": "diagnosetjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "38bebc7d-f083-334c-b816-9f08c0b6517b",
                        "entry_id": "9524cd60-0ab4-3500-bba3-70c5107e25e7",
                        "glosses": [
                            "vaststelling van een ziekte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fbe19d2c-1f88-44df-9d70-5102afd4c0c6",
                                "sense_id": "38bebc7d-f083-334c-b816-9f08c0b6517b",
                                "text": "De dokter heeft de verkeerde diagnose gesteld."
                            },
                            {
                                "example_id": "5a853b23-ff35-40ab-a628-85108933340f",
                                "sense_id": "38bebc7d-f083-334c-b816-9f08c0b6517b",
                                "text": "„Wij zien sinds enkele jaren steeds vaker hoogbegaafde kinderen en jongeren met een psychiatrische diagnose”, zegt Hoogeveen, een gz-psychologe die veel hoogbegaafde leerlingen begeleidt. „In veel van die gevallen twijfelen wij of die diagnose terecht gesteld is.”"
                            },
                            {
                                "example_id": "0794690f-f7b5-4a70-af1f-6efb5359e872",
                                "sense_id": "38bebc7d-f083-334c-b816-9f08c0b6517b",
                                "text": "Een bezoek aan haar huisarts en de apotheek. De diagnose en de medicatie waren wat haar betrof twee zaken onder dezelfde noemer."
                            }
                        ]
                    },
                    {
                        "sense_id": "f36c2b5e-cbe3-3f87-b896-36cff7170c9d",
                        "entry_id": "9524cd60-0ab4-3500-bba3-70c5107e25e7",
                        "glosses": [
                            "vaststelling (van de oorzaak van een probleem)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b0f35c6-f8d0-479e-a906-ab01f870f149",
                                "sense_id": "f36c2b5e-cbe3-3f87-b896-36cff7170c9d",
                                "text": "Zijn diagnose was simpel: het monetaire beleid heeft onder Draghi gedaan wat het kon; meer is nauwelijks mogelijk."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "99f5dd5f-5753-4930-973c-b5978b29870e",
                        "source_entry_id": "9524cd60-0ab4-3500-bba3-70c5107e25e7",
                        "source_sense_id": "38bebc7d-f083-334c-b816-9f08c0b6517b",
                        "source_sense_description": "vaststelling van een ziekte",
                        "target_lang_word": "Diagnose",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Diagnose",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cb786564-e18c-3aa9-8fc5-cbfca6133061",
                                        "entry_id": "cffa958a-a7c3-3b1e-b61b-6c8f30cbeca9",
                                        "glosses": [
                                            "Bestimmung einer körperlichen oder psychischen Krankheit durch einen Arzt oder Psychotherapeuten; in Berufen der Gesundheit (Arzt, Pfleger, Physiotherapeut, Psychologe) die genaue Zuordnung von Befunden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c613385-19d1-4da5-bd43-b5a8172a5234",
                                                "sense_id": "cb786564-e18c-3aa9-8fc5-cbfca6133061",
                                                "text": "Der Befund der Bluttests führte zu einer unheilvollen Diagnose."
                                            },
                                            {
                                                "example_id": "a733e154-a675-4ec5-96bd-9d511031b3e3",
                                                "sense_id": "cb786564-e18c-3aa9-8fc5-cbfca6133061",
                                                "text": "Den Vorwürfen der Anklagevertreter, der frühere Chefarzt und Klinikleiter habe eine unzureichende Diagnose gestellt und Fehler bei der Operation begangen, folgte das Gericht nicht."
                                            },
                                            {
                                                "example_id": "d142e99d-1669-403e-a4d9-56e8a227be18",
                                                "sense_id": "cb786564-e18c-3aa9-8fc5-cbfca6133061",
                                                "text": "„Ich würde die Diagnose gerne geheim halten.“"
                                            },
                                            {
                                                "example_id": "50002ee7-9bf9-41c1-b9cf-c864c21c1f46",
                                                "sense_id": "cb786564-e18c-3aa9-8fc5-cbfca6133061",
                                                "text": "„Diskussionen über die Diagnose helfen weder ihm noch seinem Patienten.“"
                                            },
                                            {
                                                "example_id": "ef141cdf-7632-4952-898c-26a160b482d5",
                                                "sense_id": "cb786564-e18c-3aa9-8fc5-cbfca6133061",
                                                "text": "„Zwischen ihnen stand die Gräfin Bellin als La Vallière, mit dem Gesicht eines gefallenen Engels und vielen Rubinen; Ravic erinnerte sich, ihr vor einem Jahr die Eierstöcke operiert zu haben – auf eine Diagnose Durants hin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "229c5e26-2af8-3438-94c9-e26a29e4465f",
                                        "entry_id": "cffa958a-a7c3-3b1e-b61b-6c8f30cbeca9",
                                        "glosses": [
                                            "Zuordnung eines Phänomens zu einer Kategorie"
                                        ],
                                        "tags": [
                                            "im weiteren Sinn"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "866b33dd-7e6b-4779-9387-571a611ee1a3",
                                                "sense_id": "229c5e26-2af8-3438-94c9-e26a29e4465f",
                                                "text": "Führe bitte eine Diagnose des Netzwerkes durch."
                                            },
                                            {
                                                "example_id": "6b013faf-8479-4523-bd6d-c0d7d7e67d6b",
                                                "sense_id": "229c5e26-2af8-3438-94c9-e26a29e4465f",
                                                "text": "„Doch die Diagnose muss in keinem Desaster enden.“"
                                            },
                                            {
                                                "example_id": "4f056e09-a136-4dba-9e20-dfc3ec1a8a98",
                                                "sense_id": "229c5e26-2af8-3438-94c9-e26a29e4465f",
                                                "text": "„Er sah mich scharf an, als wolle er die Diagnose meiner Leidenschaft stellen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "86fe39ad-88d5-4dc4-bbc0-55acd1613489",
                        "source_entry_id": "9524cd60-0ab4-3500-bba3-70c5107e25e7",
                        "source_sense_id": "38bebc7d-f083-334c-b816-9f08c0b6517b",
                        "source_sense_description": "vaststelling van een ziekte",
                        "target_lang_word": "diagnosis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "diagnosis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "076d140d-8fe1-305a-a87e-9a1963c7484b",
                                        "entry_id": "d1ceb971-e275-3213-b163-6e3eae1b6418",
                                        "glosses": [
                                            "The process of, or an instance of, identification of the nature and cause of a medical condition or illness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32c7dfde-9917-4da9-a326-f86550002adb",
                                                "sense_id": "076d140d-8fe1-305a-a87e-9a1963c7484b",
                                                "text": "Diagnosis is a challenging art informed by wide-ranging science."
                                            },
                                            {
                                                "example_id": "be5a993f-c7cb-438c-998c-ddd5ff978f1e",
                                                "sense_id": "076d140d-8fe1-305a-a87e-9a1963c7484b",
                                                "text": "He was given the wrong treatment due to an erroneous diagnosis."
                                            },
                                            {
                                                "example_id": "b2241477-d92a-441b-b793-af5a18bdf519",
                                                "sense_id": "076d140d-8fe1-305a-a87e-9a1963c7484b",
                                                "text": "Her diagnoses include type 2 diabetes mellitus, primary hypertension, diabetic retinopathy, and generalized anxiety disorder."
                                            },
                                            {
                                                "example_id": "27e32b79-6391-451d-a65d-c258a7ee99e3",
                                                "sense_id": "076d140d-8fe1-305a-a87e-9a1963c7484b",
                                                "text": "In an era when political leaders promise deliverance from decline through America’s purported preeminence in scientific research, the news that science is in deep trouble in the United States has been as unwelcome as a diagnosis of leukemia following the loss of health insurance."
                                            },
                                            {
                                                "example_id": "232cdcaa-9cf9-43d8-9744-84bd4d0d3c46",
                                                "sense_id": "076d140d-8fe1-305a-a87e-9a1963c7484b",
                                                "text": "In 1995, 2% of schizophrenia diagnoses in the country were associated with cannabis use disorder. In 2000, it increased to around 4%. Since 2010, that figure increased to 8%, the study found."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4451bb3-8754-324b-a24a-9dcf0171bfe1",
                                        "entry_id": "d1ceb971-e275-3213-b163-6e3eae1b6418",
                                        "glosses": [
                                            "The process of, or an instance of, identification of the nature and cause of something (of any nature)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0bdf1077-d66e-4d6c-aaeb-7c39181866e0",
                                                "sense_id": "c4451bb3-8754-324b-a24a-9dcf0171bfe1",
                                                "text": "Diagnosis is part of being an automotive mechanic."
                                            },
                                            {
                                                "example_id": "20bae976-7150-4cd9-9f99-8237580cdcfe",
                                                "sense_id": "c4451bb3-8754-324b-a24a-9dcf0171bfe1",
                                                "text": "Her diagnosis of the current economic situation is that central banks are overcorrecting."
                                            },
                                            {
                                                "example_id": "b8c89c40-68fb-477e-9221-604e9d3b649c",
                                                "sense_id": "c4451bb3-8754-324b-a24a-9dcf0171bfe1",
                                                "text": "The quick eye for effects, the clear diagnosis of men's minds, and the love of epigram."
                                            },
                                            {
                                                "example_id": "809ccacf-fec7-4300-906f-bc71f37114f8",
                                                "sense_id": "c4451bb3-8754-324b-a24a-9dcf0171bfe1",
                                                "text": "My diagnosis of his character proved correct."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "806c3f9b-c9f0-368a-8bf9-0195860c50b7",
                                        "entry_id": "d1ceb971-e275-3213-b163-6e3eae1b6418",
                                        "glosses": [
                                            "A written description of a species or other taxon serving to distinguish that species from all others; especially a description written and published in Latin."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "148e10a4-9ab8-430b-b7de-6ef7549db6af",
                                                "sense_id": "806c3f9b-c9f0-368a-8bf9-0195860c50b7",
                                                "text": "The repeated exposure, over decades, to most taxa here treated has resulted in repeated modifications of both diagnoses and discussions, as initial ideas of the various taxa underwent—often repeated—conceptual modification."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "diagnosis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dcf0576e-3656-311d-aa4e-e767feceb219",
                                        "entry_id": "4c4e1599-f6bf-3703-99f6-ec9f6d9f2496",
                                        "glosses": [
                                            "Synonym of diagnose."
                                        ],
                                        "tags": [
                                            "nonstandard",
                                            "proscribed",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28568916-1948-4b02-9a5d-4d82bbaaebfa",
                                                "sense_id": "dcf0576e-3656-311d-aa4e-e767feceb219",
                                                "text": "Experienced mechanics can diagnosis the condition of machinery just by listening."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "70d92ddf-61b5-466f-9858-7aa84e6f63b6",
                        "source_entry_id": "9524cd60-0ab4-3500-bba3-70c5107e25e7",
                        "source_sense_id": "38bebc7d-f083-334c-b816-9f08c0b6517b",
                        "source_sense_description": "vaststelling van een ziekte",
                        "target_lang_word": "diagnostic",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "diagnostic",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8085dc8b-07ef-384a-b1b3-b4d2aad3613b",
                                        "entry_id": "ed7ec72d-bf19-34bb-925c-06bb75cc5d0e",
                                        "glosses": [
                                            "Partie de la médecine qui a pour objet la distinction des maladies, l'identification d’une maladie à partir de symptômes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "980ccd76-27bc-4f1b-8449-681cbe66b472",
                                                "sense_id": "8085dc8b-07ef-384a-b1b3-b4d2aad3613b",
                                                "text": "Il rappelle aux gens qui ne se sentent pas interpellés par la gravité de la situation que «tous les diagnostics seront touchés», que ce soit des «traumas, des arrêts cardiaques, ou une défaillance d’organe»."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f189986-1d1a-3013-82d2-069046da859e",
                                        "entry_id": "ed7ec72d-bf19-34bb-925c-06bb75cc5d0e",
                                        "glosses": [
                                            "Conclusion de cette identification : avis médical sur la nature de la maladie à l’origine des symptômes observés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9427e9f-5e5f-4a1d-a532-26fbf54c2f2e",
                                                "sense_id": "3f189986-1d1a-3013-82d2-069046da859e",
                                                "text": "À la fin d'août 1897, 4 jours après des rapports avec une femme suspecte, il se forma chez le malade deux petites ulcérations dans le sillon rétroglandulaire qui selon le diagnostic du médecin local, présentait toutes les propriétés des chancres mous ; […]."
                                            },
                                            {
                                                "example_id": "6712c16d-8d69-4274-a6b6-9b72589d5819",
                                                "sense_id": "3f189986-1d1a-3013-82d2-069046da859e",
                                                "text": "Le diagnostic d’otacariose est confirmé par la mise en évidence d’otodectes dans le cérumen grâce aux examens otoscopique et microscopique."
                                            },
                                            {
                                                "example_id": "fd06d5cc-5d12-482f-984d-9001458181ec",
                                                "sense_id": "3f189986-1d1a-3013-82d2-069046da859e",
                                                "text": "L’échographie cardiaque transthoracique (présence de valves remaniées ou/et de végétations) et les hémocultures confirment le diagnostic évoqué par la clinique : streptococcémies, staphylococcémies, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "04aab324-9c37-3400-b669-9455a69f1940",
                                        "entry_id": "ed7ec72d-bf19-34bb-925c-06bb75cc5d0e",
                                        "glosses": [
                                            "Conclusion d'une étude technique."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ba15cb8-eec8-4165-b5dd-7e919f5ca332",
                                                "sense_id": "04aab324-9c37-3400-b669-9455a69f1940",
                                                "text": "Son diagnostic était que le mal dont souffrait la société islamique contemporaine était la modernité, dans laquelle les lois et la domination de l'homme ont remplacé celles de Dieu."
                                            },
                                            {
                                                "example_id": "ad7948a8-de0e-4597-a9f1-4493feff7d2f",
                                                "sense_id": "04aab324-9c37-3400-b669-9455a69f1940",
                                                "text": "Ce rapport rassemble des éléments de diagnostic portant sur le partage de la valeur ajoutée, le partage des profits et les écarts de rémunérations en France."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36a118c3-7052-3cd1-85af-404361b489db",
                                        "entry_id": "ed7ec72d-bf19-34bb-925c-06bb75cc5d0e",
                                        "glosses": [
                                            "Les étapes, le processus, utilisé pour déterminer la cause, l'origine, d'une situation, d'un évènement, d'un problème."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "217f62c0-ebf8-445e-b7bd-e58ba0e7ff31",
                        "source_entry_id": "9524cd60-0ab4-3500-bba3-70c5107e25e7",
