                                        "glosses": [
                                            "Chez les Anciens, interdiction qui était faite aux étrangers de séjourner dans une ville lorsqu'ils étaient indésirables."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce3418f7-c342-4fd3-8d51-7a7d5e11ef3c",
                                                "sense_id": "25db2155-6d8a-3127-9110-1a211987b309",
                                                "text": "— Alors j’exige, entendez-vous ? j’exige la xénélasie de ce zinjanthrope zigzageur."
                                            }
                                        ]
