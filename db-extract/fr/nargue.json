                                "sense_id": "1ab3b1a7-aad3-3593-8c94-4c0c7f292f9a",
                                "text": "Nargue du chagrin !"
                            },
                            {
                                "example_id": "8507d7d2-3ca3-4c85-bd2b-d54b9079db8d",
                                "sense_id": "1ab3b1a7-aad3-3593-8c94-4c0c7f292f9a",
                                "text": "Nargue à nos ennemis."
                            }
                        ]
                    }
