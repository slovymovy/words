                "senses": [
                    {
                        "sense_id": "0f76c0fb-7236-38e2-a750-a4333d6245cf",
                        "entry_id": "6806e0b8-f0c1-321c-bfdd-435207feb146",
                        "glosses": [
                            "weibliche Person, die in derselben Partei ist wie jemand anderes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e55817a-b201-435f-99c4-a34e129cd8e6",
                                "sense_id": "0f76c0fb-7236-38e2-a750-a4333d6245cf",
                                "text": "Ihre Parteifreundin erklärte ihr die Geschäftsordnung für die Sitzung."
                            },
                            {
                                "example_id": "c8a02108-80d3-4d42-80d8-be4e6895e35e",
                                "sense_id": "0f76c0fb-7236-38e2-a750-a4333d6245cf",
                                "text": "„Adenauer wandte sich in diesem Zusammenhang noch einmal direkt an seine alte Parteifreundin Weber.“"
                            },
                            {
                                "example_id": "33e7fa15-f68f-4af5-8271-f3b9eb2a00b2",
                                "sense_id": "0f76c0fb-7236-38e2-a750-a4333d6245cf",
                                "text": "„Eine Parteifreundin will einen alten Mann mit Krückstock von den Vorzügen der Sozialdemokratie überzeugen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
