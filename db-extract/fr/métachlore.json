                "forms": [],
                "senses": [
                    {
                        "sense_id": "d0e742cf-0e1c-3444-8e9d-7fa4ec3c4862",
                        "entry_id": "a16ced18-4568-3b0c-b4e1-7e6e341ebf52",
                        "glosses": [
                            "Substance phytosanitaire, de formule chimique C₁₄H₂₀ClNO₂, à usage d'herbicide des graminées et de certaines dicotylédones et sélectif des cultures de maïs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4226ef3d-a9c3-4d37-a5c6-33517a4e3425",
                                "sense_id": "d0e742cf-0e1c-3444-8e9d-7fa4ec3c4862",
                                "text": "La dose optimale de métachlore (alachlor) est de 2,6 kg de substance active/ha. La préparation est efficace contre les Monocotylédones et Dicotylédones annuelles mais n'agit pratiquement pas sur les plantes vivaces."
                            },
                            {
                                "example_id": "16ab5ad4-74ab-4f0c-a664-ee89f6c47c49",
                                "sense_id": "d0e742cf-0e1c-3444-8e9d-7fa4ec3c4862",
                                "text": "Citons également dans ce groupe l’alachlore (ou métachlore). Il est assez utilisé dans le désherbage du maïs et du soja contre les graminées estivales et beaucoup de dicotylédones (amarante, morelle noire…)."
                            }
                        ]
                    }
