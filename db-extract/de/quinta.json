                ],
                "senses": [
                    {
                        "sense_id": "6d4b7366-a87c-39ea-a780-33b7c33e6bfe",
                        "entry_id": "498563fd-288f-3d8a-aed3-8267bef8b664",
                        "glosses": [
                            "zweite Klasse am Gymnasium, siehe auch Prima"
                        ],
                        "tags": [
                            "veraltet oder veraltend",
                            "nach alter Zählweise"
                        ],
                        "examples": [
                            {
                                "example_id": "1403da53-8a05-46fc-a18f-2ba6588a7315",
                                "sense_id": "6d4b7366-a87c-39ea-a780-33b7c33e6bfe",
                                "text": "„Gott sei Dank hatte er, bevor er ins Internat kam, in der Quinta ja etwas Englisch auf der Schule gelernt.“"
                            },
                            {
                                "example_id": "04f87684-8f19-4f81-bb64-14117230ebf4",
                                "sense_id": "6d4b7366-a87c-39ea-a780-33b7c33e6bfe",
                                "text": "„Roman und Cesar Bertini wurden Ostern 1934 in die Quinta versetzt, nicht jubelnd, nicht gerade an der Spitze der Klasse, aber der Ältere mit einer 2, der Jüngere mit einer 3 in Latein.“"
                            },
                            {
                                "example_id": "a08176fd-fa1c-492b-8107-f0c201cf4b08",
                                "sense_id": "6d4b7366-a87c-39ea-a780-33b7c33e6bfe",
                                "text": "„Kurz nachdem er in die Quinta versetzt worden war, hatte ich ihn beiseite genommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a6b70051-4673-3187-8eb6-8cbadf038324",
                        "entry_id": "498563fd-288f-3d8a-aed3-8267bef8b664",
                        "glosses": [
                            "die fünfte Klasse am Gymnasium"
                        ],
                        "tags": [
                            "in Österreich"
                        ],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8d2a0838-4ec8-4f98-85cd-fb27c586142c",
                        "source_entry_id": "498563fd-288f-3d8a-aed3-8267bef8b664",
                        "source_sense_id": "6d4b7366-a87c-39ea-a780-33b7c33e6bfe",
                        "source_sense_description": "veraltet oder veraltend, nach alter Zählweise: zweite Klasse am Gymnasium, siehe auch Prima",
                        "target_lang_word": "quinta",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quinta",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "961d3913-9ca6-3728-9e64-1be22f16bc20",
                                        "entry_id": "d9b7089e-26aa-3fe1-847e-57eb214aac5e",
                                        "glosses": [
                                            "Finca rural, sobre la cual los arrendatarios pagaban un canon de una quinta₁ parte de la cosecha."
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "abbb48a1-ddd1-465d-8ad9-604604a06073",
                                                "sense_id": "961d3913-9ca6-3728-9e64-1be22f16bc20",
                                                "text": "Las guardas española y tudesca estavan esperando junto a una quinta que el Prior de San Juan tiene al Prado de San Gerónimo."
                                            },
                                            {
                                                "example_id": "a787eb53-10c5-49c4-8246-f5b1b988338e",
                                                "sense_id": "961d3913-9ca6-3728-9e64-1be22f16bc20",
                                                "text": "Alzase sobre todas orgullosa de esconder en su falda los antiguos dominios del árabe Musa y los bellos restos de antigüedad romana que el Emmo. Despuig, amigo y protector de las artes, atesoró en Raxa, para que no faltase en su patria una quinta que compitiese con las famosas villas de Italia."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e200f2cd-276c-3e72-a683-7629d03e6d9b",
                                        "entry_id": "d9b7089e-26aa-3fe1-847e-57eb214aac5e",
                                        "glosses": [
                                            "Por extensión, finca rural de pequeño tamaño destinada a la agricultura."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9b56fc1-e3ed-41ff-9e73-27b2e1a57aef",
                                                "sense_id": "e200f2cd-276c-3e72-a683-7629d03e6d9b",
                                                "text": "Lindante con esa huerta, había una quinta de duraznos y una pequeña plantación de paraísos."
                                            },
                                            {
                                                "example_id": "8d2ab38f-0161-4823-ba22-77ff24f7a544",
                                                "sense_id": "e200f2cd-276c-3e72-a683-7629d03e6d9b",
                                                "text": "Era el viejo Antonio, un italiano que tenía una quinta de frutas."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d3e24104-92af-3202-a509-ddf676624647",
                                        "entry_id": "d9b7089e-26aa-3fe1-847e-57eb214aac5e",
                                        "glosses": [
                                            "Por extensión, casa rodeada de jardines."
                                        ],
                                        "tags": [
                                            "Colombia",
                                            "Venezuela"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "8a2170bb-3560-3566-9f96-3d090abef07c",
                                        "entry_id": "d9b7089e-26aa-3fe1-847e-57eb214aac5e",
                                        "glosses": [
                                            "Acción o efecto de quintar."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "26e9ff8c-8171-33d3-9552-7fe522260ef8",
                                        "entry_id": "d9b7089e-26aa-3fe1-847e-57eb214aac5e",
                                        "glosses": [
                                            "Por extensión, cada camada de reclutas que se quinta o sortea en un determinado año."
                                        ],
                                        "tags": [
                                            "Spain"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79874568-f88e-422d-b306-51a823190066",
                                                "sense_id": "26e9ff8c-8171-33d3-9552-7fe522260ef8",
                                                "text": "Con el rescate, se hacen mercenarios el ejército y la marina; y no puede ser de otra manera, porque cuando un Gobierno saca una quinta de cien mil hombres, y en lugar de ellos se encuentra con cien mil talegas de doblones, podrá comprar un ejército, pero ese ejército no es del país, no es del siglo XIX; es un ejército del siglo XV o de Condottieri."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "c93551ae-58ac-3e50-83c3-3f9ac4749b8d",
                                        "entry_id": "d9b7089e-26aa-3fe1-847e-57eb214aac5e",
                                        "glosses": [
                                            "Por metonimia, año de nacimiento."
                                        ],
                                        "tags": [
                                            "Spain"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c70ec7e-e9a4-4bd0-82fc-6a1d856c7f80",
                                                "sense_id": "c93551ae-58ac-3e50-83c3-3f9ac4749b8d",
                                                "text": "Es que, además, sucede una cosa. Somos de la misma quinta. Cuando vemos a un amigo de nuestra edad sortear la muerte, nos sentimos desmoralizados."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "d9cdab86-f17c-3a0f-a327-0954326353e4",
                                        "entry_id": "d9b7089e-26aa-3fe1-847e-57eb214aac5e",
                                        "glosses": [
                                            "En el juego de naipes de los cientos, conjunto de cinco naipes consecutivos del mismo palo."
                                        ],
                                        "tags": [
                                            "Naipes"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"7\""
                                    },
                                    {
                                        "sense_id": "2679b5d6-8b62-3052-bdbd-d3dcdb368ff7",
                                        "entry_id": "d9b7089e-26aa-3fe1-847e-57eb214aac5e",
                                        "glosses": [
                                            "Quinta₁ marcha de la transmisión de un automóvil."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d3553de-4cd7-4709-9150-702f4822fd15",
                                                "sense_id": "2679b5d6-8b62-3052-bdbd-d3dcdb368ff7",
                                                "text": "Cuando oprimió el cloche para poner la quinta, ya el auto se desplazaba a 75 millas por hora."
                                            }
                                        ],
                                        "sense_index_json": "\"8\""
                                    },
                                    {
                                        "sense_id": "c42a9d30-814b-3e6f-a5c0-68ea9a0d6e14",
                                        "entry_id": "d9b7089e-26aa-3fe1-847e-57eb214aac5e",
                                        "glosses": [
                                            "Intervalo de siete semitonos, que cubre cinco notas de la escala."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c91d5a9a-778e-439c-9fb9-21cdc358a2a4",
                                                "sense_id": "c42a9d30-814b-3e6f-a5c0-68ea9a0d6e14",
                                                "text": "Coteja d'esta manera todas tus codicias y, como quien cantando lleva una quinta sobre los otros, levanta el tiple del coraçón, que es el ferviente desseo, hasta codiciar a Dios por sí y en sí mesmo."
                                            },
                                            {
                                                "example_id": "64fd82d2-ea01-4451-9029-fc46c853990c",
                                                "sense_id": "c42a9d30-814b-3e6f-a5c0-68ea9a0d6e14",
                                                "text": "Tanto en una como en otra forma, la voz, al principio del grupo fónico, partiendo de una nota grave, que suele ser por término medio una cuarta o una quinta más baja que el tono normal."
                                            }
                                        ],
                                        "sense_index_json": "\"9\""
                                    }
                                ]
                            },
                            {
                                "target_word": "quinta",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "d7bd3bd8-b155-3951-9f25-94826c54706d",
                                        "entry_id": "e24d32a1-bfba-356c-8457-f11bee5e632f",
                                        "glosses": [
                                            "Forma del femenino de quinto."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96fa3980-b5a5-4d55-8038-9e7f4cb8c687",
                                                "sense_id": "d7bd3bd8-b155-3951-9f25-94826c54706d",
                                                "text": "Sobre toda esta obra se haçía un pequeño poyo para las estatuas dençima que tubiese en alto tres vezes tanto como la cornisa, y las estatuas que aquí se ponían heran mayores que las que estauan sobre las colunas, a lo menos una sesta y a lo más una quinta."
                                            },
                                            {
                                                "example_id": "6011146a-b015-4f5d-aaef-f8d213ea3978",
                                                "sense_id": "d7bd3bd8-b155-3951-9f25-94826c54706d",
                                                "text": "Cuatro galerías de arcos, revestidas de nichos, habitados en su mayor parte, encierran un vastísimo cuadrilongo, sembrado de lápidas y cruces, y dividido por una quinta galería."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
