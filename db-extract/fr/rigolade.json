                                "target_senses": [
                                    {
                                        "sense_id": "a2d872c5-aaa7-3307-81fe-85fb69074baf",
                                        "entry_id": "a59ecf3e-db4f-3dc2-9971-25efcf857d66",
                                        "glosses": [
                                            "Spiel für Kinder"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2876f76d-67c4-45e8-bb8f-2807b8f200e1",
                                                "sense_id": "a2d872c5-aaa7-3307-81fe-85fb69074baf",
                                                "text": "Als Grundschullehrerin sollte man verschiedene Kinderspiele kennen."
