                    },
                    {
                        "translation_id": "e1124eac-90f0-439c-9bfb-915dcffd3950",
                        "source_entry_id": "1a7f5769-db68-3275-afa7-bc8582d80536",
                        "source_sense_id": "ed1a248f-79c6-3af6-b372-a1b3fef7cbaa",
                        "target_lang_word": "codeína",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "codeína",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "2f3d4a04-01fc-3cb2-8ff5-f0ba4cc7083b",
                                        "entry_id": "35aa6b15-d07c-3d15-9862-174beba87aa7",
                                        "glosses": [
                                            "Alcaloide que se encuentra de forma natural en el opio. Se utiliza con fines médicos como analgésico, sedante y antitusígeno. También se le considera un narcótico."
                                        ],
                                        "tags": [
                                            "drogas"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cff215c5-9251-4419-85da-51468f852a20",
                                                "sense_id": "2f3d4a04-01fc-3cb2-8ff5-f0ba4cc7083b",
                                                "text": "Y si traés la codeína ina-ina-ina (-ina),\nque no te olvides de la lima-lima-lima-lima (Lima).\nEsa puta ni se imagina ina-ina-ina (-ina),\nrecién salío' de la esquina ina-ina-ina (-ina)."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d3ed06db-b477-412f-a6ed-ce0a98338206",
                        "source_entry_id": "1a7f5769-db68-3275-afa7-bc8582d80536",
                        "source_sense_id": "ed1a248f-79c6-3af6-b372-a1b3fef7cbaa",
                        "target_lang_word": "codeina",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "codeina",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "699e1796-b24e-37a3-81e3-8a401d9112e7",
                                        "entry_id": "42be52a4-5f8e-3b3a-bc80-e161c7cdacf9",
                                        "glosses": [
                                            "alcaloide ottenuto in prevalenza per metilazione della morfina, usato in medicina per inibire il dolore"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c8a60a66-1375-4482-b19a-839143a4ad09",
                        "source_entry_id": "1a7f5769-db68-3275-afa7-bc8582d80536",
                        "source_sense_id": "ed1a248f-79c6-3af6-b372-a1b3fef7cbaa",
                        "target_lang_word": "codéine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "codéine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7bf99169-6cc3-307d-82cd-9ade421a711c",
                                        "entry_id": "a9d5511e-5fde-354f-841a-564ac7871432",
                                        "glosses": [
                                            "Alcaloïde que l’on tire de l’opium. Cette molécule est utilisée en pharmacie pour sa propriété antitussive."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10337847-b116-489b-9e24-7d0012c35949",
                                                "sense_id": "7bf99169-6cc3-307d-82cd-9ade421a711c",
                                                "text": "Ils disent : \"Madame la comtesse est grosse, il est probable que sa délivrance déterminera une crise favorable. Qu'on la tienne en bon air, à la campagne, du petit-lait, de la codéine…\""
                                            },
                                            {
                                                "example_id": "d9ff3105-a557-42d0-b917-f76adf501b23",
                                                "sense_id": "7bf99169-6cc3-307d-82cd-9ade421a711c",
                                                "text": "Ces substances, comme la codéine qui se transforme en acétylcodéine par exemple, peuvent également subir des modifications structurelles lors des différentes étapes d’extraction, de transformation et de purification du stupéfiant."
                                            },
                                            {
                                                "example_id": "7113811c-6e44-4959-9337-a307d11ec233",
                                                "sense_id": "7bf99169-6cc3-307d-82cd-9ade421a711c",
                                                "text": "Je dois encore juste prendre un Dafalgan Forte vers midi et un Dafalgan codéine le soir."
                                            },
                                            {
                                                "example_id": "293de52d-3fb6-4a3f-9a2e-50c3e427d476",
                                                "sense_id": "7bf99169-6cc3-307d-82cd-9ade421a711c",
                                                "text": "À huit heures, comme un ressort, il tendit un sac à du Lac : « Il y a ce qu’il vous faut : codéine, opioïdes, buprénorphine, morphine. Si vous êtes blessés, vous mélangez tout, c’est explosif : de-la-bombe-a-to-mique ! »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
