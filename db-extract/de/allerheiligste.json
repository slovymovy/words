                    }
                ],
                "senses": [
                    {
                        "sense_id": "998bd217-2fd9-3085-b56c-643c29e364fd",
                        "entry_id": "bcabd457-762b-3069-83d1-a77859dcca1f",
                        "glosses": [
                            "heilig/heiligste"
                        ],
                        "tags": [
                            "verstärkend für"
                        ],
                        "examples": [
                            {
                                "example_id": "a15f92e4-4f45-45fa-9745-dd05f850319b",
                                "sense_id": "998bd217-2fd9-3085-b56c-643c29e364fd",
                                "text": "„Dieses Buch war mit Erlaubnis der allerheiligsten und allerschrecklichsten Inquisition gedruckt.“"
                            },
                            {
                                "example_id": "c0000fb5-0185-4ed1-92a4-a0b9e37363ca",
                                "sense_id": "998bd217-2fd9-3085-b56c-643c29e364fd",
                                "text": "„Allerheiligster Vater, Euere Heiligkeit wird geruhen, Mitleid mit diesem armen Menschen zu haben.“"
                            },
                            {
                                "example_id": "5edd6c79-3b7b-467a-9198-878510474764",
                                "sense_id": "998bd217-2fd9-3085-b56c-643c29e364fd",
                                "text": "„Ob wohl dort der Herr Jesus, denk' ich, mit seinem allerheiligsten Füßchen meine Nummer übergangen hat, oder was? “"
                            },
                            {
                                "example_id": "ac6d5279-ee91-46ce-ab97-ba8aa3ba7267",
                                "sense_id": "998bd217-2fd9-3085-b56c-643c29e364fd",
                                "text": "„Redete er auch von den bösen Geistern und ihrer Macht, und sagte er aus: im Anfang habe der Herrgott das ganze Gezücht in einer großen Tonne verschlossen gehalten und den Luzifer, der damalen noch ein allerheiligster Erzengel gewesen, darauf als Wacht gesetzet, auf daß kein Unhuld ausschlüpfe.“"
                            },
                            {
                                "example_id": "a8afa1e4-4a37-491d-ac46-5debc276c244",
                                "sense_id": "998bd217-2fd9-3085-b56c-643c29e364fd",
                                "text": "„Am Ufer war ein allerheiligster Platz, dort flackerten Scheiterhaufen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
