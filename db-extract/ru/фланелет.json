                                    {
                                        "sense_id": "1e42ddcc-952f-3d2b-8582-1cb133122f2e",
                                        "entry_id": "26250ec7-a536-3997-8c58-773470cb3adc",
                                        "glosses": [
                                            "A type of soft, woven fabric, made to imitate flannel by raising or brushing the fibers in the weft. Frequently used in sleepwear, pillows, and bedding."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "863a1d51-847b-4cbb-835d-03c7657d5ca3",
                                                "sense_id": "1e42ddcc-952f-3d2b-8582-1cb133122f2e",
                                                "text": "I am a draper mad with love. I love you more than all the flannelette and calico, candlewick, dimity, crash and merino, tussore, cretonne, crepon, muslin, poplin, ticking and twill in the whole Cloth Hall of the world."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0874c13e-ae5c-32a2-9336-99afff59ef01",
                                        "entry_id": "26250ec7-a536-3997-8c58-773470cb3adc",
                                        "glosses": [
                                            "Something made from this fabric."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94b837e4-1abc-4468-96a0-61c4c66f40a1",
                                                "sense_id": "0874c13e-ae5c-32a2-9336-99afff59ef01",
                                                "text": "Our flannelettes provide an extra layer between the underquilt and sheets."
                                            }
                                        ]
                                    }
                                ]
                            }
