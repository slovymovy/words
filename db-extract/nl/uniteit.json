                                "target_senses": [
                                    {
                                        "sense_id": "1c2fbf58-eab0-323a-9ce3-8cc06699ae0b",
                                        "entry_id": "6b296a8a-dfba-3968-8003-c949b57181a6",
                                        "glosses": [
                                            "Oneness; the state or fact of being one undivided entity."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b5879d2-7ace-4b69-bea0-90d5a09344cb",
                                                "sense_id": "1c2fbf58-eab0-323a-9ce3-8cc06699ae0b",
                                                "text": "If any literary work is too long to be read at one sitting, we must be content to dispense with the immensely important effect derivable from unity of impression - for, if two sittings be required, the affairs of the world interfere, and everything like totality is at once destroyed."
                                            },
                                            {
                                                "example_id": "a7c946c1-9bc7-45d9-865a-c950771c92c7",
                                                "sense_id": "1c2fbf58-eab0-323a-9ce3-8cc06699ae0b",
                                                "text": "Alan Pardew's current squad has been put together with a relatively low budget but the resolve and unity within the team is priceless."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94302911-a266-3702-8010-5e09117e4a64",
                                        "entry_id": "6b296a8a-dfba-3968-8003-c949b57181a6",
                                        "glosses": [
                                            "Agreement; harmony."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bdc7540f-951c-39d9-8e9b-bebe2e182408",
                                        "entry_id": "6b296a8a-dfba-3968-8003-c949b57181a6",
                                        "glosses": [
                                            "A single undivided thing, seen as complete in itself."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "349d8a56-98f6-4f93-bc71-94359cde3b8d",
                                                "sense_id": "bdc7540f-951c-39d9-8e9b-bebe2e182408",
                                                "text": "If a single day has brought us two or more experiences suitable to initiate a dream, the dream will unite references to them both into a single whole; it obeys a compulsion to form a unity [translating Einheit] out of them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9e8ab28-6b93-3ff1-be30-95d9b518f163",
                                        "entry_id": "6b296a8a-dfba-3968-8003-c949b57181a6",
                                        "glosses": [
                                            "Any of the three classical rules of drama: unity of action (nothing should be admitted not directly relevant to the development of the plot), unity of place (the scenes should be set in the same place), and unity of time (all the events should be such as might happen within a single day)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "50382e1c-8b2c-3689-9478-33201c5ab34c",
                                        "entry_id": "6b296a8a-dfba-3968-8003-c949b57181a6",
                                        "glosses": [
                                            "The number 1 or any element of a set or field that behaves under a given operation as the number 1 behaves under multiplication."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7403fd41-0730-48b0-8511-86b6350a8377",
                                                "sense_id": "50382e1c-8b2c-3689-9478-33201c5ab34c",
                                                "text": "the cube roots of unity"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d25c62b2-cd97-398f-882a-9adb4aa7f2f0",
                                        "entry_id": "6b296a8a-dfba-3968-8003-c949b57181a6",
                                        "glosses": [
                                            "The peculiar characteristics of an estate held by several in joint tenancy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "62b6c19a-b972-3b51-8004-4992d2e42db7",
                                        "entry_id": "6b296a8a-dfba-3968-8003-c949b57181a6",
                                        "glosses": [
                                            "The form of consensus in a Quaker meeting for business which signals that a decision has been reached. In order to achieve unity, everyone who does not agree with the decision must explicitly stand aside, possibly being recorded in the minutes as doing so."
                                        ],
                                        "tags": [
                                            "Quakerism",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8db588a9-f664-40a1-b207-75bf011c1fdd",
                        "source_entry_id": "c7be79a6-d370-3c96-86b4-dfec538b9933",
                        "source_sense_id": "9cebfede-c06e-32e5-ab77-07737977f872",
                        "target_lang_word": "unité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d09d0dba-88ef-311f-ba93-0ea0e99a0019",
                                        "entry_id": "aba9ad86-8774-36a0-8a7c-b9acef8875f7",
                                        "glosses": [
                                            "Élément singulier, qui a le nombre un."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "10b7503c-99b1-39ce-96e2-2bb4e34a510b",
                                        "entry_id": "aba9ad86-8774-36a0-8a7c-b9acef8875f7",
                                        "glosses": [
                                            "Quantité élémentaire qui est à la base d’un calcul."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d78dafc8-67c4-447f-953f-1c550d664b1b",
                                                "sense_id": "10b7503c-99b1-39ce-96e2-2bb4e34a510b",
                                                "text": "La première classe comprend les centaines, les dizaines et les unités simples ; la seconde classe comprend les centaines, les dizaines et les unités de mille; la troisième classe comprend les centaines, les dizaines et les unités de millions, etc., etc."
                                            },
                                            {
                                                "example_id": "654109b1-fdc7-47a3-8e8e-9a43bfa7af08",
                                                "sense_id": "10b7503c-99b1-39ce-96e2-2bb4e34a510b",
                                                "text": "Il s’ensuit un prix nettement supérieur au coût de la dernière unité produite, ce qui va permettre de maximiser le profit en situation d’oligopole."
                                            },
                                            {
                                                "example_id": "854ace5f-0231-4a23-8629-58b5eede86d2",
                                                "sense_id": "10b7503c-99b1-39ce-96e2-2bb4e34a510b",
                                                "text": "Plusieurs unités font un nombre."
                                            },
                                            {
                                                "example_id": "2afa62be-2e7e-4df4-9f55-7bb7726ddf9c",
                                                "sense_id": "10b7503c-99b1-39ce-96e2-2bb4e34a510b",
                                                "text": "Tout nombre est composé d’unités."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "381def8f-e29f-3094-8928-0914f7000f87",
                                        "entry_id": "aba9ad86-8774-36a0-8a7c-b9acef8875f7",
                                        "glosses": [
                                            "Grandeur finie, choisie arbitrairement pour servir de terme de comparaison aux autres grandeurs de même espèce."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9388c9e8-384f-46d4-af8f-d0c4e0d0968d",
                                                "sense_id": "381def8f-e29f-3094-8928-0914f7000f87",
                                                "text": "Unité de volume, de poids."
                                            },
                                            {
                                                "example_id": "b4c01abc-5710-4a77-ad04-267dfb1daabf",
                                                "sense_id": "381def8f-e29f-3094-8928-0914f7000f87",
                                                "text": "Unité de mesure."
                                            },
                                            {
                                                "example_id": "ad928fef-7f30-4fe7-8e19-18404b49d7da",
                                                "sense_id": "381def8f-e29f-3094-8928-0914f7000f87",
                                                "text": "Le mètre a été adopté en France comme unité de longueur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "031488f3-47f8-3032-9160-891c5c9db786",
                                        "entry_id": "aba9ad86-8774-36a0-8a7c-b9acef8875f7",
                                        "glosses": [
                                            "Caractère de ce qui est singulier, par opposition à pluralité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d070089a-adab-49de-8179-e6633aa761df",
                                                "sense_id": "031488f3-47f8-3032-9160-891c5c9db786",
                                                "text": "L’unité de Dieu."
                                            },
                                            {
                                                "example_id": "feb52472-08f3-4cab-b305-62cf889be007",
                                                "sense_id": "031488f3-47f8-3032-9160-891c5c9db786",
                                                "text": "L’unité de l’église."
                                            },
                                            {
                                                "example_id": "7ebfd383-f375-42e5-90f8-23d5b0bd0efc",
                                                "sense_id": "031488f3-47f8-3032-9160-891c5c9db786",
                                                "text": "L’unité du moi."
                                            },
                                            {
                                                "example_id": "a058db49-751e-4fae-9abc-e7e8995fb702",
                                                "sense_id": "031488f3-47f8-3032-9160-891c5c9db786",
                                                "text": "Unité de sentiments."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d818e7fa-5451-307e-b677-27bc0e7b8ae2",
                                        "entry_id": "aba9ad86-8774-36a0-8a7c-b9acef8875f7",
                                        "glosses": [
                                            "Caractère de ce qui offre un ensemble, une suite où tout se tient."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8ae1fdb-86df-4701-813f-bff94f6c584f",
                                                "sense_id": "d818e7fa-5451-307e-b677-27bc0e7b8ae2",
                                                "text": "L’unité physionomique d’un paysage provient de ce que certaines plantes se répétant très fréquemment lui impriment une allure particulière."
                                            },
                                            {
                                                "example_id": "36f9b917-dd70-4b60-b09f-c39e9e6623f2",
                                                "sense_id": "d818e7fa-5451-307e-b677-27bc0e7b8ae2",
                                                "text": "En dépit du morcellement législatif des coutumes, nous avons une unité remarquable de législation en cette matière, car c’est l’Église qui seule légifère et juge."
                                            },
                                            {
                                                "example_id": "e92f50b1-ea67-48aa-b41f-a7d3801390ac",
                                                "sense_id": "d818e7fa-5451-307e-b677-27bc0e7b8ae2",
                                                "text": "Les trois unités : l’unité d’action, l’unité de lieu et l’unité de temps, les règles du théâtre classique veulent qu’il n’y ait qu’une action dans une pièce, que cette action se passe dans le même lieu et qu’elle ne dure pas plus de vingt-quatre heures."
                                            },
                                            {
                                                "example_id": "651ecde3-85da-4c7b-b40d-073739a82759",
                                                "sense_id": "d818e7fa-5451-307e-b677-27bc0e7b8ae2",
                                                "text": "Nous allons user des mêmes droits sans avoir le même génie, nous ne voulons pas nous asseoir plus que lui sur le trépied des unités, et jetant les yeux sur Paris et sur le vieux et noir palais du Louvre, nous passerons tout à coup l’espace de deux cents lieues et le temps de deux années."
                                            },
                                            {
                                                "example_id": "224e6bb4-f38b-4898-bbad-c04ca00e1054",
                                                "sense_id": "d818e7fa-5451-307e-b677-27bc0e7b8ae2",
                                                "text": "Aux fameuses « trois unités », volontiers j’ajouterais une quatrième : « l’unité du spectateur ». Elle impliquerait qu’il importe que, pièce ou livre, la création poétique s’adresse, d’un bout à l’autre de sa durée, au même lecteur ou auditeur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e63bea1-3868-3b49-87ff-680d86c3f579",
                                        "entry_id": "aba9ad86-8774-36a0-8a7c-b9acef8875f7",
                                        "glosses": [
                                            "Unité de composition, Principe d’après lequel les animaux et les végétaux les plus différents par leur forme, leur volume, leur couleur, etc., peuvent se ramener à un type commun."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c564326a-c5bb-3881-a297-cf6452644ac2",
                                        "entry_id": "aba9ad86-8774-36a0-8a7c-b9acef8875f7",
                                        "glosses": [
                                            "Groupe constitué de soldats, gendarmes ou policiers commandés par un chef."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "246ebe28-a8d4-4cb9-aed8-23f6a51035ab",
                                                "sense_id": "c564326a-c5bb-3881-a297-cf6452644ac2",
                                                "text": "Les chefs d’unité finissaient par ne plus savoir de qui ils dépendaient. Ils recevaient en haussant les épaules les ordres inexécutables."
                                            },
                                            {
                                                "example_id": "d0072d1f-6a55-4d6e-a6f2-d7c0dae0822c",
                                                "sense_id": "c564326a-c5bb-3881-a297-cf6452644ac2",
                                                "text": "Dans un document diffusé dans la matinée, le parquet s’adresse à « toutes les unités de police », la Garde civile, la police nationale et les Mossos d’Esquadra, dépendant du gouvernement catalan, et leur ordonne d’agir contre les autorités, fonctionnaires ou particuliers « afin d’éviter la commission de délits »."
                                            },
                                            {
                                                "example_id": "297e3ee4-992f-406c-a046-8310c6a243a1",
                                                "sense_id": "c564326a-c5bb-3881-a297-cf6452644ac2",
                                                "text": "L’administration américaine a également annoncé des sanctions financières contre une unité d'intervention spéciale saoudienne ainsi que l'ancien numéro deux du renseignement saoudien, Ahmed Al-Assiri, proche du prince héritier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a31a666-fe2e-3337-bfdc-f6c29dbe9e87",
                                        "entry_id": "aba9ad86-8774-36a0-8a7c-b9acef8875f7",
                                        "glosses": [
                                            "Personnage, objet ou groupe de personnages ou d’objets manipulable."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "407d4ee5-8651-4fbb-9be0-98de8744ca1c",
                                                "sense_id": "8a31a666-fe2e-3337-bfdc-f6c29dbe9e87",
                                                "text": "S’il faut retenir une seule chose à propos des unités, c’est que vous les recrutez dans la caserne, et vous les améliorez grâce à l’académie. Il y a 4 différents paliers pour les unités et à chaque palier il est possible d’engager une unité d’infanterie, une d’archèterie, une de cavalerie et une de siège."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8d82f71-dea2-33ce-8adc-1d998e8ae385",
                                        "entry_id": "aba9ad86-8774-36a0-8a7c-b9acef8875f7",
                                        "glosses": [
                                            "Composant d’un appareil électronique (ordinateur, etc.) qui exécute une opération particulière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1096d6c-d944-41b2-8bf8-dc166a8f43e9",
                                                "sense_id": "d8d82f71-dea2-33ce-8adc-1d998e8ae385",
                                                "text": "Unité centrale ; Unité de contrôle ; etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "241923d2-a8e7-3760-b311-44a1a4a2a6bf",
                                        "entry_id": "aba9ad86-8774-36a0-8a7c-b9acef8875f7",
                                        "glosses": [
                                            "Partie d’une organisation ou d’une société."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e31a4967-fa0e-4d2b-94a7-3aa0862836e7",
                                                "sense_id": "241923d2-a8e7-3760-b311-44a1a4a2a6bf",
                                                "text": "U.F.R. : Unité de formation et de recherche ; U.E.R. : Unité d’enseignement et de recherche."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b31248d1-ebf9-3689-a182-d137418941e0",
                                        "entry_id": "aba9ad86-8774-36a0-8a7c-b9acef8875f7",
                                        "glosses": [
                                            "Véhicule."
                                        ],
                                        "tags": [
                                            "Administration"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dbedd7a3-3947-4019-8ec8-9d208ff7fdfa",
                                                "sense_id": "b31248d1-ebf9-3689-a182-d137418941e0",
                                                "text": "— Voulez-vous que je vous fasse visiter l'unité, monsieur Breakdown?\n— L'unité de quoi, capt'ain Zec?\n— Je veux dire : le bateau..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f307e38-48dc-3a51-b241-3feb3350fbf2",
                                        "entry_id": "aba9ad86-8774-36a0-8a7c-b9acef8875f7",
                                        "glosses": [
                                            "Élément neutre de la multiplication dans une structure algébrique (1 dans le cadre des nombres)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4a2e684a-f156-3041-9aa0-d647830a97d0",
                                        "entry_id": "aba9ad86-8774-36a0-8a7c-b9acef8875f7",
                                        "glosses": [
                                            "Million."
                                        ],
                                        "tags": [
                                            "dated",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cfe77cf1-40a0-4eee-8632-8a4067b817ef",
                                                "sense_id": "4a2e684a-f156-3041-9aa0-d647830a97d0",
                                                "text": "Il raconta à Joseph qu’il avait garé « deux petits millions » – on ne disait pas encore deux unités – et qu’il allait « se payer, vieux, un yotte et une villa à la mer. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa204d0d-4ef1-33a5-a127-2557f95d5552",
                                        "entry_id": "aba9ad86-8774-36a0-8a7c-b9acef8875f7",
                                        "glosses": [
                                            "Valeur attribuée à une certaine durée lors d’une communication téléphonique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9092cef7-edc3-48f7-98e5-082310f4173f",
                                                "sense_id": "fa204d0d-4ef1-33a5-a127-2557f95d5552",
                                                "text": "— Une communication de trois minutes ?\n— Non ! Trois unités ! Autrement dit neuf minutes."
                                            },
                                            {
                                                "example_id": "1e389957-210b-4c77-9844-044bae5b3d84",
                                                "sense_id": "fa204d0d-4ef1-33a5-a127-2557f95d5552",
                                                "text": "la carte magnétique à retrouver entre les tickets de métro et le permis de conduire – contient-elle encore assez d’unités ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
