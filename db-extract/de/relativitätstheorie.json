                        "form": "die Relativitätstheorie"
                    },
                    {
                        "form_id": "b53bcbf5-d4ac-41d9-9aa3-46295e0cfffa",
                        "entry_id": "d20b2c27-34d5-3286-891d-07e12d9a2e0d",
                        "tags": [
