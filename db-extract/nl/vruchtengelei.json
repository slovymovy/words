                                            {
                                                "example_id": "8b60a818-901c-4448-9e59-861aa1c48651",
                                                "sense_id": "4417e2dd-1cc4-367c-93ca-ac9f3461f17d",
                                                "text": "My foot got jammed in a gap between the rocks."
                                            },
                                            {
                                                "example_id": "ed30e2d4-d832-48a5-8877-a1077643c0ea",
                                                "sense_id": "4417e2dd-1cc4-367c-93ca-ac9f3461f17d",
                                                "text": "Her poor little baby toe got jammed in the door."
                                            },
                                            {
                                                "example_id": "25ff129f-b0f6-415a-8300-d74592f9af1e",
                                                "sense_id": "4417e2dd-1cc4-367c-93ca-ac9f3461f17d",
                                                "text": "I jammed the top knuckle of my ring finger."
                                            },
                                            {
                                                "example_id": "8d924a2f-f13a-4d08-a168-efa6252d4a8a",
                                                "sense_id": "4417e2dd-1cc4-367c-93ca-ac9f3461f17d",
                                                "text": "The Ship, which by its Building was Spanish, stuck fast, jaum’d in between two Rocks; all the Stern and Quarter of her was beaten to Pieces with the Sea […]"
                                            }
