                "senses": [
                    {
                        "sense_id": "fb8c771b-7401-3af3-9778-6004ad231c3c",
                        "entry_id": "5829441b-42e3-31e3-9a19-e9753fbe75ac",
                        "glosses": [
                            "Gerät, das elektrische Energie speichern kann; Anlage, mit deren Hilfe elektrische Energie gespeichert werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b71888a-7514-4e23-be15-8fce2a9d4b96",
                                "sense_id": "fb8c771b-7401-3af3-9778-6004ad231c3c",
                                "text": "„Die Batterien von Elektroautos stellen nämlich bei entsprechender Verbreitung einen gewaltigen Stromspeicher dar.“"
                            },
                            {
                                "example_id": "1dc8e99f-47df-489a-a118-c07cbf277a1f",
                                "sense_id": "fb8c771b-7401-3af3-9778-6004ad231c3c",
                                "text": "„Ende 2017 ging im abgelegenen Südaustralien der damals grösste Stromspeicher der Welt ans Netz.“"
                            },
                            {
                                "example_id": "55a012d8-32a8-4f6a-ac1f-428000e95c3d",
                                "sense_id": "fb8c771b-7401-3af3-9778-6004ad231c3c",
                                "text": "„Aktuell baut [das Unternehmen] im niedersächsischen Alfeld einen Stromspeicher mit 275 Megawattstunden Speicherkapazität.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
