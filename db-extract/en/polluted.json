    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "87d6c68c-dd94-3446-9a65-1e2afb3ef7ff",
                "word": "polluted",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "2ee79c20-86d7-410d-bb19-b8523b6af9f9",
                        "entry_id": "87d6c68c-dd94-3446-9a65-1e2afb3ef7ff",
                        "tags": [
                            "comparative"
                        ],
