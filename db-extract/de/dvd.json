                        "sense_id": "0fb267fb-3132-321a-8df2-d8a6c73790bc",
                        "entry_id": "fd79016f-5708-32b1-8690-36a18ea46e63",
                        "glosses": [
                            "einer CD ähnliche Speicherplatte für Audio- und Videosignale mit höherer Speicherkapazität"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9cfc51b-eac8-425d-b172-77d9b87aea4c",
                                "sense_id": "0fb267fb-3132-321a-8df2-d8a6c73790bc",
                                "text": "Ich habe mir eine neue DVD gekauft."
                            },
                            {
                                "example_id": "68b74e91-dbd5-4a3f-8bf9-11a9b9951b29",
                                "sense_id": "0fb267fb-3132-321a-8df2-d8a6c73790bc",
                                "text": "„Das Fernsehprogramm besteht nur aus zwei Sendern und alle DVDs sind irgendwann geguckt.“"
                            },
                            {
                                "example_id": "b52dfda3-80a2-4bce-a967-462fa9e4a496",
                                "sense_id": "0fb267fb-3132-321a-8df2-d8a6c73790bc",
                                "text": "„Also fragte ich sie, warum keine deutsche DVD darunter sei bzw. warum Hollywoodfilme ihrer Meinung nach hierzulande so viel beliebter seien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
