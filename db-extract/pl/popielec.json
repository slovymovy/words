                ],
                "senses": [
                    {
                        "sense_id": "f77c30b5-645e-309a-aabe-9ca0a36bc4bb",
                        "entry_id": "31a46d47-2df4-360f-ac0d-3878d9b9692d",
                        "glosses": [
                            "zob. Środa Popielcowa"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56d5a3c9-14b3-4039-9357-4d1665c106b0",
                                "sense_id": "f77c30b5-645e-309a-aabe-9ca0a36bc4bb",
                                "text": "Dopiero we wstępną środę, w Popielec, nie szykując nawet śniadania, ogarnęła się, jak mogła najlepiej, dzieci dała pod Weronczyną opiekę i zabierała się do wyjścia."
                            },
                            {
                                "example_id": "b9d06fef-8f14-44f7-ae4b-7a438a751a45",
                                "sense_id": "f77c30b5-645e-309a-aabe-9ca0a36bc4bb",
                                "text": "Na ten popielec zjeżdżali się i schodzili do kościołów wszyscy katolickiego wyznania, panowie nawet najwięksi nigdy go nie opuszczali."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
