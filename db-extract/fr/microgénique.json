                        "examples": []
                    },
                    {
                        "sense_id": "367346a6-7a1b-3568-b3da-30ed7672d17a",
                        "entry_id": "7b129c6b-b2d5-3b57-af1e-000abc3bd3ef",
                        "glosses": [
                            "Qualifie une œuvre qui se prête bien à l’enregistrement et à la diffusion radiophonique."
                        ],
                        "tags": [
                            "familiar",
                            "rare"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "1fc4795f-1c3b-3d08-9e88-ede8aea74fdf",
                        "entry_id": "7b129c6b-b2d5-3b57-af1e-000abc3bd3ef",
                        "glosses": [
                            "Qualifie un son (timbre de voix notamment) qui passe bien au microphone, qu’il est agréable d’écouter après son passage par des équipements d’enregistrement et de reproduction du son."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "cb6d86f9-700e-4c10-af95-7bd5d60af20d",
                                "sense_id": "1fc4795f-1c3b-3d08-9e88-ede8aea74fdf",
                                "text": "On ne redira jamais assez qu’il n’y a pas plus de chanteurs ou d’instrumentistes ou d’acteurs radiophoniques que d’orchestres ou de chefs microgéniques."
                            },
                            {
                                "example_id": "cdcff881-b59e-47ad-bad5-21c643e5cc1b",
                                "sense_id": "1fc4795f-1c3b-3d08-9e88-ede8aea74fdf",
                                "text": "Ruben ne glousse pas, ne se crispe pas, ne s’émeut pas. Il parle comme à sa conférence hebdomadaire. Une voix qui ferait merveille derrière un guichet. Les intonations mesurées, calmes. L’articulation microgénique. Le speaker parfait."
                            },
                            {
                                "example_id": "44106a48-f614-4624-8afd-e08110482bdc",
                                "sense_id": "1fc4795f-1c3b-3d08-9e88-ede8aea74fdf",
                                "text": "Avoir une voix microgénique est un avantage indéniable dans le métier d’animateur de radio."
                            }
                        ]
                    }
