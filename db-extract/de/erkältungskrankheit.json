                "senses": [
                    {
                        "sense_id": "0cee766a-1dfc-37b2-af56-2ecb5b29581a",
                        "entry_id": "5b7ce7a5-ffc1-393c-8a70-cd40e8ca3db0",
                        "glosses": [
                            "Erkrankung der oberen Atemwege, oft mit Husten und Schnupfen einhergehend; meist eine durch Viren ausgelöste Infektionskrankheit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0599ac9a-44ca-47b1-a15b-9f533669152d",
                                "sense_id": "0cee766a-1dfc-37b2-af56-2ecb5b29581a",
                                "text": "Typische Symptome einer Erkältungskrankheit sind Husten, Schnupfen und Heiserkeit."
                            },
                            {
                                "example_id": "fc0c9d5d-eebf-45a6-8c12-feb1fd97f435",
                                "sense_id": "0cee766a-1dfc-37b2-af56-2ecb5b29581a",
                                "text": "Durch eine saisonale, ausgewogene und vitaminreiche Ernährung kann man das Immunsystem stärken und somit Erkältungskrankheiten vorbeugen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
