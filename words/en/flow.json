                            {
                                "target_lang_word": "подниматься",
                                "target_lang_sense_clarification": "увеличиваться в уровне"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "vloeien",
                                "target_lang_sense_clarification": "het opkomen van de vloed"
                            },
                            {
                                "target_lang_word": "opkomen",
                                "target_lang_sense_clarification": "stijgen van het water"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1fd73b5f-febb-375a-9dd7-dd728dd5a59d",
                    "sense_definition": "To come from a source or be caused by something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "emanate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Great wealth often <w>flows</w> from hard work and innovation.",
                            "target_lang_translations": {
                                "ru": "Большое богатство часто <w>вытекает</w> из упорного труда и инноваций.",
                                "nl": "Grote rijkdom <w>vloeit</w> vaak <w>voort</w> uit hard werken en innovatie."
                            }
                        },
                        {
                            "text": "Many benefits <w>flow</w> from living a healthy lifestyle.",
                            "target_lang_translations": {
                                "ru": "Из здорового образа жизни <w>вытекает</w> много преимуществ.",
                                "nl": "Veel voordelen <w>vloeien voort</w> uit een gezonde levensstijl."
                            }
                        }
                    ],
                    "synonyms": [
                        "come in"
                    ],
                    "common_phrases": [
                        "flow from"
                    ],
                    "target_lang_definitions": {
                        "ru": "Происходить из источника или быть вызванным чем-либо.",
                        "nl": "Voortkomen uit een bron of veroorzaakt worden door iets."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вытекать",
                                "target_lang_sense_clarification": "быть следствием чего-либо"
                            },
                            {
                                "target_lang_word": "проистекать",
                                "target_lang_sense_clarification": "брать начало, происходить"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "voortvloeien",
                                "target_lang_sense_clarification": "het logische gevolg zijn van"
                            },
                            {
                                "target_lang_word": "komen",
                                "target_lang_sense_clarification": "ontstaan uit"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a4d46a3c-eebd-3df9-8b1b-8f52e609e087",
                    "sense_definition": "The steady and continuous movement of a liquid, gas, or electricity.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "fluid_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>flow</w> of water was blocked by a large stone.",
                            "target_lang_translations": {
                                "ru": "<w>Поток</w> воды был заблокирован большим камнем.",
                                "nl": "De <w>stroom</w> van het water werd geblokkeerd door een grote steen."
                            }
