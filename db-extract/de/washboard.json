                                                "sense_id": "7bf947f0-4558-3ee5-97c4-274ebd963ccf",
                                                "text": "Doug came up with a half-guilty smile and washboarded his forehead at her."
                                            },
                                            {
                                                "example_id": "6ba9139d-2620-4fbc-8eb2-b6cc449c85df",
                                                "sense_id": "7bf947f0-4558-3ee5-97c4-274ebd963ccf",
                                                "text": "The rip that was generated by each change of tide had scoured the bottom white and washboarded the sand where it was still layered over the hardpan coral floor."
                                            },
                                            {
                                                "example_id": "da43a4a0-1699-4426-8c45-ffd4e79a2d1b",
                                                "sense_id": "7bf947f0-4558-3ee5-97c4-274ebd963ccf",
                                                "text": "The low bass brruummmp of 20-mm slugs going out washboarded the bulkheads."
                                            },
                                            {
                                                "example_id": "7b1ca852-ab0c-4223-9d95-fbe410f246fc",
                                                "sense_id": "7bf947f0-4558-3ee5-97c4-274ebd963ccf",
                                                "text": "She drove as fast as she dared, braking for the frost heaves that washboarded the blacktop and on her dirt road, bouncing in and out of the clay ruts cut by the flow of runoff."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0451849e-13ca-32ff-916a-c2abef576991",
                                        "entry_id": "afbd2f80-7b81-347e-90c6-896613bdc941",
                                        "glosses": [
                                            "To play a washboard."
