                ],
                "senses": [
                    {
                        "sense_id": "339df2d2-d45b-3a4f-8a3c-1f87cfcb4aaa",
                        "entry_id": "565c5c96-5777-3a09-844e-50cc7528244d",
                        "glosses": [
                            "Qui cause, qui annonce l’orage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eab2952a-cecb-42d8-a13d-260e9daaf753",
                                "sense_id": "339df2d2-d45b-3a4f-8a3c-1f87cfcb4aaa",
                                "text": "Le temps, le ciel est orageux."
                            }
                        ]
                    },
                    {
                        "sense_id": "40e88382-2a60-3b3d-826e-051ecab0f3f9",
                        "entry_id": "565c5c96-5777-3a09-844e-50cc7528244d",
                        "glosses": [
                            "Qui est sujet aux orages."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9332945-7618-457a-abb4-dbb07aeea980",
                                "sense_id": "40e88382-2a60-3b3d-826e-051ecab0f3f9",
                                "text": "Une fois engagé dans ces mers orageuses et ignorées, sa perte était certaine. Une tempête jeta dix-sept navires sur la côte d’Irlande […]"
                            },
                            {
                                "example_id": "a3ed1749-3867-4612-b5eb-3d44da71984a",
                                "sense_id": "40e88382-2a60-3b3d-826e-051ecab0f3f9",
                                "text": "La Hollande était un pays presque inhabitable. C'étaient de vastes lacs orageux, semblables à une série de mers."
                            }
                        ]
                    },
                    {
                        "sense_id": "5ccd801b-b93f-3e26-ada4-6b6bdb316775",
                        "entry_id": "565c5c96-5777-3a09-844e-50cc7528244d",
                        "glosses": [
                            "Qui est touché par l’orage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e805eb0e-c903-4e0d-a134-8c70d0ece05d",
                                "sense_id": "5ccd801b-b93f-3e26-ada4-6b6bdb316775",
                                "text": "Des ondées orageuses touchent les régions méditerranéennes l’après-midi."
                            },
                            {
                                "example_id": "7ce69495-59ab-4571-aa4a-b4e643730b83",
                                "sense_id": "5ccd801b-b93f-3e26-ada4-6b6bdb316775",
                                "text": "Juillet avait été particulièrement chaud et orageux et ce premier jour d’août ne le contredisait pas."
                            }
                        ]
                    },
                    {
                        "sense_id": "8582125e-55e7-3019-9445-f1a03aa10f76",
                        "entry_id": "565c5c96-5777-3a09-844e-50cc7528244d",
                        "glosses": [
                            "Qui est troublé, tumultueux, sujet aux agitations du cœur."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "970bf649-a6f1-4687-b696-811c9424cdd6",
                                "sense_id": "8582125e-55e7-3019-9445-f1a03aa10f76",
                                "text": "La véritable affaire n’était pas encore commencée. On n’entendait ni les cris antidynastiques qui étaient attendus ni le grondement orageux de La Marseillaise."
                            },
                            {
                                "example_id": "ce8d60ec-9125-4754-b8a5-1fba4a0d9316",
                                "sense_id": "8582125e-55e7-3019-9445-f1a03aa10f76",
                                "text": "Après de nombreuses séances orageuses, on finit cependant par décider la création de tabors chérifiens dans les ports ouverts. Ces forces ne devaient pas excéder 2.500 hommes au total […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f5d97eb8-2897-4411-aee7-366edae37910",
                        "source_entry_id": "565c5c96-5777-3a09-844e-50cc7528244d",
                        "source_sense_description": "Qui cause, qui annonce l’orage",
