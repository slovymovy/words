                "senses": [
                    {
                        "sense_id": "ad12b7bd-68b0-3bb1-92ca-9f604a21f807",
                        "entry_id": "4a28befb-ca3e-35f1-8148-716c8b5bed99",
                        "glosses": [
                            "S’accabler soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7cfe8de4-ab2f-4ddb-85a5-ebec5d2ade21",
                                "sense_id": "ad12b7bd-68b0-3bb1-92ca-9f604a21f807",
                                "text": "Je prendrais bien un exemple personnel, mais non, ça servirait à rien à part m'autoaccabler une fois de plus."
                            },
                            {
                                "example_id": "91ffa007-ab96-47fa-b060-e8c775db0fe2",
                                "sense_id": "ad12b7bd-68b0-3bb1-92ca-9f604a21f807",
                                "text": "C'est de l'humour, mais sans plus, je ne vais pas m'autoaccabler."
                            },
                            {
                                "example_id": "aebb1cd5-bfc0-4ad0-a4dd-4be1979dda0f",
                                "sense_id": "ad12b7bd-68b0-3bb1-92ca-9f604a21f807",
                                "text": "Nan, je vais pas accabler Pendu, il le mérite pas - je vais m'autoaccabler, comme une grande fille."
                            }
                        ]
                    }
