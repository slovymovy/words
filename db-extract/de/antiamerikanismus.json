                        "form": "des Antiamerikanismus"
                    },
                    {
                        "form_id": "fce2daff-7081-4631-b7f7-a11f0fc8df1f",
                        "entry_id": "88c9780d-3bee-370a-ad8c-df64959e6de2",
                        "tags": [
                            "dative",
                            "singular"
                        ],
                        "form": "dem Antiamerikanismus"
                    },
                    {
                        "form_id": "c9ee4c57-6cfd-47ed-90f5-9f8ded82b11d",
                        "entry_id": "88c9780d-3bee-370a-ad8c-df64959e6de2",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Antiamerikanismus"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "27d4330d-429e-360d-82b1-d7ba2d4746b5",
                        "entry_id": "88c9780d-3bee-370a-ad8c-df64959e6de2",
                        "glosses": [
                            "Haltung, die gegen die Politik, Kultur und den Lebensstil in den Vereinigten Staaten von Amerika gerichtet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "619ac077-659f-4d85-aab9-b172b3920c0f",
                                "sense_id": "27d4330d-429e-360d-82b1-d7ba2d4746b5",
                                "text": "„Soeben beklagte General David Petraeus vor dem Verteidigungsausschuss des Senats, dass der Streit zwischen Israelis und Palästinensern und die Besatzung des Westjordanlands den Antiamerikanismus schürten.“"
                            },
                            {
                                "example_id": "3cb23143-df49-4e70-a74d-cffee2bf6793",
                                "sense_id": "27d4330d-429e-360d-82b1-d7ba2d4746b5",
                                "text": "„Es gibt wohl nur wenige Länder in der Welt, die so sehr wie Pakistan auf der einen Seite durch einen ausgeprägten, schichtenübergreifenden Antiamerikanismus geprägt sind, auf der anderen Seite durch eine derart starke Anlehnung an die USA.“"
                            },
                            {
                                "example_id": "b5ed65d5-d6cc-4ce5-a0df-884d0a09a6ce",
                                "sense_id": "27d4330d-429e-360d-82b1-d7ba2d4746b5",
                                "text": "„Der deutsche Antiamerikanismus und die Einbildung, sie seien noch viel intelligenter und geistreicher als damals, nämlich geradezu übermenschlich intelligent, führte dazu, dass die Deutschen genau den gleichen Fehler im Zweiten Weltkrieg noch mal wiederholten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1ebe08d7-3362-4f3c-8785-2110769e048c",
                        "source_entry_id": "88c9780d-3bee-370a-ad8c-df64959e6de2",
                        "source_sense_id": "27d4330d-429e-360d-82b1-d7ba2d4746b5",
                        "source_sense_description": "Haltung, die gegen die Politik, Kultur und den Lebensstil in USA gerichtet ist",
                        "target_lang_word": "anti-Americanism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anti-Americanism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9a7eab44-2231-364c-873f-eb0cd0c57457",
                                        "entry_id": "2d5e8c4c-d2f2-37f2-b4c5-fb1100af12ba",
                                        "glosses": [
                                            "The fear or dislike of the people, policies, culture or government of the United States."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43f0e7ca-7b32-483f-9459-45638cb1609f",
                                                "sense_id": "9a7eab44-2231-364c-873f-eb0cd0c57457",
                                                "text": "As Salman Rushdie says, you don't have to travel far to find anti-Americanism (Op-Ed, Feb. 4). Teaching at a Canadian university, I have been astounded by some students who say the Al Qaeda attacks, inside or outside the United States, were justified because only Americans were targeted. Remaking Osama bin Laden in their own anti-American image, they insist he has no quarrel with Canada or others, just the United States.\nThese apologists may yet discover that this movement is profoundly anti-Western as well as anti-American."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "76d78a40-5bd3-4a46-8d4f-8fe93bba0974",
                        "source_entry_id": "88c9780d-3bee-370a-ad8c-df64959e6de2",
                        "source_sense_id": "27d4330d-429e-360d-82b1-d7ba2d4746b5",
                        "source_sense_description": "Haltung, die gegen die Politik, Kultur und den Lebensstil in USA gerichtet ist",
                        "target_lang_word": "antiaméricanisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antiaméricanisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dd136eee-9a3b-394d-9eb4-79b29d65089e",
                                        "entry_id": "84878b64-ae61-395e-9b7f-721a8d534345",
                                        "glosses": [
                                            "Position dédaigneuse, méfiante ou hostile vis-à-vis de la politique des États-Unis d’Amérique, de la société, de l’histoire, de la culture ou du peuple nord-américain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6337fd55-e2a1-4b09-a1dd-91efbcff74a2",
                                                "sense_id": "dd136eee-9a3b-394d-9eb4-79b29d65089e",
                                                "text": "Un antiaméricanisme primaire."
                                            },
                                            {
                                                "example_id": "8402b1d3-9d6a-4723-9ca2-15fd27315854",
                                                "sense_id": "dd136eee-9a3b-394d-9eb4-79b29d65089e",
                                                "text": "Elle donne l’image d’un monde musulman figé dans un antiaméricanisme irréductible."
                                            },
                                            {
                                                "example_id": "3ffdc9b1-9329-47ae-8541-b7f3773832ea",
                                                "sense_id": "dd136eee-9a3b-394d-9eb4-79b29d65089e",
                                                "text": "L’antiaméricanisme est une maladie française. Comme la grippe, elle se propage à l’automne, mais tous les quatre ans seulement, à l’occasion de l’élection présidentielle américaine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
