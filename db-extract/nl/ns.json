                            {
                                "example_id": "ac22b2fc-a865-40a8-b3e9-57f0936f7ae1",
                                "sense_id": "e7d8eec2-3ec5-37e0-b55d-82823aeff660",
                                "text": "De NS heeft zijn Britse dochteronderneming Abellio UK verkocht aan het management van het bedrijf."
                            },
                            {
                                "example_id": "07127f27-799f-43cc-8eb1-94dcf500cdef",
                                "sense_id": "e7d8eec2-3ec5-37e0-b55d-82823aeff660",
