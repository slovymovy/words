                "senses": [
                    {
                        "sense_id": "6b8c9c7f-1aa4-37ae-a0dd-6ba105f09eaa",
                        "entry_id": "a5c33e15-7430-3c21-a955-1644c42fd139",
                        "glosses": [
                            "Technologie zur Effizienzsteigerung, bei der der Arbeitstakt vorher selektierter Zylinder eines Verbrennungsmotors ohne Kraftstoffeinspritzung erfolgt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4aa21cb2-72c3-4a9f-9bf6-66f4689455e4",
                                "sense_id": "6b8c9c7f-1aa4-37ae-a0dd-6ba105f09eaa",
                                "text": "„Gerade Audi kann es sich nicht leisten, beim Vorsprung durch Technik das Nachsehen zu haben. Deshalb suchen die Audianer jetzt in vielen Details vom Matrix- und Laserlicht bis zu virtuellem Cockpit und Zylinderabschaltung nach Lösungen.“"
                            },
                            {
                                "example_id": "66f723e9-c5a1-4419-84b7-c57d1fa8477b",
                                "sense_id": "6b8c9c7f-1aa4-37ae-a0dd-6ba105f09eaa",
                                "text": "„Seat wertet den Ibiza zum Modelljahr 2015 auf und bietet nun auch den 1.4 TSI ACT (140 PS) mit Zylinderabschaltung, Start-Stopp-Automatik und Bremsenergie-Rückgewinnung an (Preis ab 19 905 Euro).“"
                            }
                        ],
