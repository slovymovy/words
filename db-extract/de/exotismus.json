                ],
                "senses": [
                    {
                        "sense_id": "e5cf5f2a-2431-33a5-9d1a-d601a2ebbc3d",
                        "entry_id": "d7c13383-705c-36ff-93c4-97cd33c61bfa",
                        "glosses": [
                            "eine bestimmte Form des eurozentristischen Blicks auf Fremde, die alleine deren \\\"exotische\\\" Aspekte betrachtet, beziehungsweise sie zu \\\"edlen Wilden\\\" stilisiert; Sehnsucht nach fremden Ländern"
                        ],
                        "tags": [
                            "Soziologie"
                        ],
                        "examples": [
                            {
                                "example_id": "4353c40f-9866-4edf-9b43-52a3b1beae53",
                                "sense_id": "e5cf5f2a-2431-33a5-9d1a-d601a2ebbc3d",
                                "text": "„Die deutsche Kolonialliteratur steht an der Schnittstelle zwischen dem Exotismus als literarischer Bewegung und der kolonialen Begeisterung, die die wilhelminische Ära kennzeichnet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d3d76f4b-470a-35c9-97e4-68af866a2374",
                        "entry_id": "d7c13383-705c-36ff-93c4-97cd33c61bfa",
                        "glosses": [
                            "eine Gruppe von Lehnwörtern, die Dinge und Gewohnheiten bezeichnen, die nur in der Kultur der Gebersprache verbreitet sind"
                        ],
                        "tags": [
                            "Sprachwissenschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "7e8a9b9a-4dc5-4fb0-8238-34dd6bda5c2c",
                                "sense_id": "d3d76f4b-470a-35c9-97e4-68af866a2374",
                                "text": "Die Wörter Iglu und Cowboy sind gute Beispiele für Exotismen."
                            },
                            {
                                "example_id": "8322c183-9185-4555-a30e-306bfa5637a0",
                                "sense_id": "d3d76f4b-470a-35c9-97e4-68af866a2374",
                                "text": "„Eine Abgrenzung ist auch notwendig gegenüber den sogenannten Exotismen oder Fremdbegriffen, das sind Wörter fremder Sprachen, die Gegenstände und Einrichtungen bezeichnen, die es bei uns nicht gibt, die viele Sprecher aber aus Reiseberichten und ähnlichem kennen (…).“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "dc194cb4-c060-3292-aeca-fd7164cd48ef",
                        "entry_id": "d7c13383-705c-36ff-93c4-97cd33c61bfa",
                        "glosses": [
                            "Kunstströmung der Malerei während der Fin de Siècle, die sich mit der Darstellung exotischer Motive befasst"
                        ],
                        "tags": [
                            "Malerei"
                        ],
                        "examples": [],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "85826921-8aa8-4e99-b75e-db27df24bccf",
                        "source_entry_id": "d7c13383-705c-36ff-93c4-97cd33c61bfa",
                        "source_sense_id": "e5cf5f2a-2431-33a5-9d1a-d601a2ebbc3d",
                        "target_lang_word": "exoticism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exoticism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fe5000a3-6eba-3d04-9e47-803644e3df1c",
                                        "entry_id": "e736dcfd-8a78-37e1-8dba-59dca4b9ac3e",
                                        "glosses": [
                                            "The state of being exotic."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18522215-7155-4384-a115-12df5ea15304",
                                                "sense_id": "fe5000a3-6eba-3d04-9e47-803644e3df1c",
                                                "text": "For all the exoticism of the images, they possess a phenomenal immediacy and even contemporaneity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f8434f0-6d8e-32eb-84db-adb0974d97a1",
                                        "entry_id": "e736dcfd-8a78-37e1-8dba-59dca4b9ac3e",
                                        "glosses": [
                                            "Something exotic."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "878f6ad5-ce07-45b1-aa8e-9aa213279d8f",
                                                "sense_id": "1f8434f0-6d8e-32eb-84db-adb0974d97a1",
                                                "text": "Chinese restaurants, now dotting this peninsula like azaleas at Cypress Gardens, have introduced thousands of us Occidentals to the delights of moo goo gai pan. As a result, attempts to produce such exoticisms in our own homes have multiplied."
                                            },
                                            {
                                                "example_id": "d434109a-8dbe-4b53-86b7-cdff615bdcc3",
                                                "sense_id": "1f8434f0-6d8e-32eb-84db-adb0974d97a1",
                                                "text": "The distribution of instruments is fairly traditional, but with piccolo trumpet and bass trombone to explore extremes, and bells, gongs and tam-tams to variegate the sound. Such exoticisms as the xylorimba (Richard Fitz) and glockenspiel (Jeffrey Milarsky) are introduced along with the sounds of shifting sand."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe1c00b9-bab7-3f55-99a1-5e809f2889ab",
                                        "entry_id": "e736dcfd-8a78-37e1-8dba-59dca4b9ac3e",
                                        "glosses": [
                                            "A word changed in spelling or pronunciation to look or sound more exotic or foreign."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e11ca74e-62ed-42c5-8a88-071a02b5b5db",
                                                "sense_id": "fe1c00b9-bab7-3f55-99a1-5e809f2889ab",
                                                "text": "The English pronunciations of Beijing and Chumash with French-like j and ch are exoticisms, as is the spelling T'Sou-ke for the original Anglicization Sooke."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e209cfc3-dcf7-4a37-99b8-12ef86a22e34",
                        "source_entry_id": "d7c13383-705c-36ff-93c4-97cd33c61bfa",
                        "source_sense_id": "e5cf5f2a-2431-33a5-9d1a-d601a2ebbc3d",
                        "target_lang_word": "exotism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exotism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6d30d54f-8023-380a-8e41-9d8fb9548211",
                                        "entry_id": "e2aefc1f-b54c-3e59-9bd3-20ae8c2fcfa8",
                                        "glosses": [
                                            "Synonym of exoticism."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69807383-5de9-4744-9bda-9fbee35f953b",
                                                "sense_id": "6d30d54f-8023-380a-8e41-9d8fb9548211",
                                                "text": "But there remains Fédora. Once more, Oh, exotism!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1405da00-4582-4aa5-b159-159ea2fcbf34",
                        "source_entry_id": "d7c13383-705c-36ff-93c4-97cd33c61bfa",
                        "source_sense_id": "e5cf5f2a-2431-33a5-9d1a-d601a2ebbc3d",
                        "target_lang_word": "exotisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exotisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d71398e4-0aeb-3b69-9b73-8ced7e75aa6e",
                                        "entry_id": "15c23393-b038-3091-9a8f-90599b512e45",
                                        "glosses": [
                                            "Caractère de ce qui est exotique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f96d9e38-a770-44dd-94b8-20838c2a09e2",
                                                "sense_id": "d71398e4-0aeb-3b69-9b73-8ced7e75aa6e",
                                                "text": "Or, l’exotisme, depuis que tout le monde passe ses week-ends aux Seychelles, je mesurais qu’il était allé se cacher dans des coins introuvables."
                                            },
                                            {
                                                "example_id": "aae5536b-69af-4917-bdb2-6a4733308dad",
                                                "sense_id": "d71398e4-0aeb-3b69-9b73-8ced7e75aa6e",
                                                "text": "Du thé de Chine infusant dans une théière et des tasses en porcelaine : voilà une scène d’intérieur bourgeois dont l’exotisme asiatique originel a été totalement effacé de la mémoire collective."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1344d81-f522-3772-aca9-68a86559c5ae",
                                        "entry_id": "15c23393-b038-3091-9a8f-90599b512e45",
                                        "glosses": [
                                            "Dans une œuvre, thématique évoquant des contrées lointaines de l’Occident."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48bd44c2-d18d-433d-ac9c-6d5adbaa18e1",
                                                "sense_id": "e1344d81-f522-3772-aca9-68a86559c5ae",
                                                "text": "Selon Ann Mullen Hohl qui se base sur les travaux de Jean Hytier, il y a trois sortes d’exotismes: un exotisme relatif aux éléments linguistiques, culturels et artistiques conventionnels, un exotisme qui prend la forme fantaisiste d’une recherche de soi et un exotisme à caractère réaliste qui cherche à reproduire le portrait fidèle de ce à quoi le lecteur est habitué."
                                            },
                                            {
                                                "example_id": "28891a1a-b3ab-4ad1-9a4b-70c68ccdf4d3",
                                                "sense_id": "e1344d81-f522-3772-aca9-68a86559c5ae",
                                                "text": "Paul Gauguin (1848 - 1903). Amoureux de l’exotisme"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d7e7dc68-6aba-4654-b779-46d10ffcd914",
                        "source_entry_id": "d7c13383-705c-36ff-93c4-97cd33c61bfa",
                        "source_sense_id": "e5cf5f2a-2431-33a5-9d1a-d601a2ebbc3d",
