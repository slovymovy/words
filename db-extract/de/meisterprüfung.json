                "senses": [
                    {
                        "sense_id": "1be942c4-f726-3951-8523-696feaaa5c0a",
                        "entry_id": "7e65a57c-9979-3d66-8a69-89e9a5e441e7",
                        "glosses": [
                            "Abschlussprüfung der beruflichen Aufstiegsfortbildung zum Meister in Deutschland"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af15c337-1165-41e5-ba8a-d9bf05930d4a",
                                "sense_id": "1be942c4-f726-3951-8523-696feaaa5c0a",
                                "text": "„Die Meisterprüfung ist die wichtigste Fortbildungsprüfung im Handwerk. Sie dokumentiert den Erfolg eines Meisterlehrgangs und ist das Qualitätssiegel für Unternehmer/innen und Führungskräfte im Handwerk.“"
                            },
                            {
                                "example_id": "59873bfb-99a9-42b9-ac08-f429ca716cd5",
                                "sense_id": "1be942c4-f726-3951-8523-696feaaa5c0a",
                                "text": "„Im fachpraktischen Teil einer Meisterprüfung ist in der Regel ein Meisterprüfungsprojekt durchzuführen.“"
                            },
                            {
                                "example_id": "61849162-df8c-4ed3-a7cf-07f807d6b170",
                                "sense_id": "1be942c4-f726-3951-8523-696feaaa5c0a",
                                "text": "„Bei dem Meisterbrief handelt es sich um den höchsten Abschluss des deutschen Handwerks. Seine Meisterprüfung abzulegen ist mit Kosten verbunden, dafür berechtigt der Meisterbrief aber u.a. dazu, einen eigenen Handwerksbetrieb gründen zu können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
