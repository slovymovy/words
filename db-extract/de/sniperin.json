                        "examples": [
                            {
                                "example_id": "2403956e-12e7-4416-93d5-fef19697a2da",
                                "sense_id": "b649f1cc-e13c-3983-8c67-ea7d204cf57e",
                                "text": "„Und dann war ihm klar, dass Jenny Bitterling die Sniperin gewesen sein muss.“"
                            },
                            {
                                "example_id": "21c81d0b-66f0-4dcd-8b79-4adff76f5375",
                                "sense_id": "b649f1cc-e13c-3983-8c67-ea7d204cf57e",
                                "text": "„Du baust eine Treppe, läufst übers Dach und hackst dir dann den Weg nach unten frei. Der Sniper trägt den Skin Strampler und ist eine Sniperin. Das verlängert ihr Leben aber auch nicht.“"
                            },
                            {
                                "example_id": "f7d1497c-20ec-4682-b2d7-45dec6a1a430",
                                "sense_id": "b649f1cc-e13c-3983-8c67-ea7d204cf57e",
                                "text": "„Wie eine Sniperin würde sie aus dem Hinterhalt Schüsse auf bewegliche Ziele abgeben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
