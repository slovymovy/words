                                "target_senses": [
                                    {
                                        "sense_id": "828563c5-4205-3d5e-97e1-9362ce6140ee",
                                        "entry_id": "82f475aa-4c53-32bb-802a-33502fed464f",
                                        "glosses": [
                                            "die Situation, zu konkurrieren"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1653bf4-c35b-475f-9d29-ef2388de6987",
                                                "sense_id": "828563c5-4205-3d5e-97e1-9362ce6140ee",
                                                "text": "Die Konkurrenz ist in diesem Geschäft besonders hart."
                                            },
                                            {
                                                "example_id": "bf532fbe-95b4-4e62-93a4-00a81b348ffe",
                                                "sense_id": "828563c5-4205-3d5e-97e1-9362ce6140ee",
                                                "text": "„Anstelle der bahnfreundlichen Generaldirektion Verkehr ist nun der Wettbewerbskommissar Joaquín Almunia zuständig - der endlich mehr Konkurrenz auf der Schiene durchsetzen will.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "79fc802f-faa5-316e-a936-06c695217d41",
                                        "entry_id": "82f475aa-4c53-32bb-802a-33502fed464f",
                                        "glosses": [
                                            "die Mitbewerber, Konkurrenten"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26050bfb-1615-47a6-88a4-724f10f25b56",
                                                "sense_id": "79fc802f-faa5-316e-a936-06c695217d41",
                                                "text": "Mir scheint, das hast du bei der Konkurrenz gekauft!"
                                            },
                                            {
                                                "example_id": "4ba71cef-9323-45c3-9e37-f7265b5a68ce",
                                                "sense_id": "79fc802f-faa5-316e-a936-06c695217d41",
                                                "text": "„Grundsätzlich gilt die Namensregelung, wonach SUV ungerade Ziffern (Q1, Q3, Q5, etc.) erhalten, die geraden Zahlen dagegen den sportlicheren, eleganteren Crossover-Modellen vorbehalten bleiben. Das gilt auch für den Q6, der ab 2016 als Konkurrenz zum BMW X4 kommen wird.“"
                                            },
                                            {
                                                "example_id": "165fc1ce-aa82-4363-b5db-296856bbcb59",
                                                "sense_id": "79fc802f-faa5-316e-a936-06c695217d41",
                                                "text": "„Doch nicht nur sie ist eine gefährliche Konkurrenz für die talmudischen Schriftgelehrten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "cf92cf91-5f05-3498-8f0b-c9e945e98ca7",
                                        "entry_id": "82f475aa-4c53-32bb-802a-33502fed464f",
                                        "glosses": [
                                            "ein Wettbewerb, zum Beispiel im Sport"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63b38df6-e24a-4796-9f79-10e08678c604",
                                                "sense_id": "cf92cf91-5f05-3498-8f0b-c9e945e98ca7",
                                                "text": "Er läuft außer Konkurrenz mit."
                                            },
                                            {
                                                "example_id": "b81437db-c674-4a4c-aa12-d7c339743c5a",
                                                "sense_id": "cf92cf91-5f05-3498-8f0b-c9e945e98ca7",
                                                "text": "Es finden Konkurrenzen in verschiedenen Disziplinen statt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f17c3ea5-ac77-40fc-8040-f24f4a5d2be7",
                        "source_entry_id": "832346fe-30f7-3a83-adbf-72de88964eea",
                        "source_sense_id": "fab11490-ff1a-3cbe-be14-032307a28f4d",
                        "target_lang_word": "competition",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "competition",
