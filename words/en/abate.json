                            {
                                "target_lang_word": "ослаблять",
                                "target_lang_sense_clarification": "интенсивность чего-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "240196b6-ca60-31a4-a2bb-5461483619ff",
                    "sense_definition": "To reduce (something) in amount or size.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "reduce_amount",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company had to <w>abate</w> its production levels due to the sudden shortage of raw materials.",
                            "target_lang_translations": {
                                "cs": "Společnost musela <w>snížit</w> úroveň své produkce kvůli náhlému nedostatku surovin.",
                                "ru": "Компании пришлось <w>снизить</w> объёмы производства из-за внезапной нехватки сырья."
                            }
                        },
                        {
                            "text": "They agreed to <w>abate</w> the noise levels during the late evening hours.",
                            "target_lang_translations": {
                                "cs": "Dohodli se, že v pozdních večerních hodinách <w>omezí</w> hluk.",
                                "ru": "Они договорились <w>уменьшить</w> уровень шума в поздние вечерние часы."
                            }
