                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab1e074d-65fa-43e1-b49d-50c38d9c0d41",
                                "sense_id": "5e80f552-e509-3622-8f77-e54dfb93b553",
                                "text": "When all is o'er, out to the door they run, With new comb'd sleeky hair, and glist'ning cheeks, Each with some little project in his head."
                            },
                            {
                                "example_id": "3c31aebd-53b5-4b75-9d03-6c3e9895d2aa",
                                "sense_id": "5e80f552-e509-3622-8f77-e54dfb93b553",
                                "text": "He thought that the moulting season was over, and that he was rejoicing in the fulness of a sleeky plumage, and by his side was a Java sparrowess, chirping and hopping about, rendering the cage as populous to him as though he were the tenant of a bird-fancier's shop."
                            },
                            {
                                "example_id": "166d8528-9e93-4779-bd50-904e4fa444db",
                                "sense_id": "5e80f552-e509-3622-8f77-e54dfb93b553",
                                "text": "Even when with heavy / Plume and pall / The sleeky coaches roll by, / Coffin, flowers and all, / He laughs, for he sees / Crouched on the coffin a small / Yellowy shape go by— / Death, uneasy and melancholy."
                            }
                        ]
                    },
                    {
                        "sense_id": "8a2284e8-672d-3c0a-80af-a102ca19aaed",
                        "entry_id": "d5739d81-8d58-3a54-8427-bef67d731d69",
                        "glosses": [
                            "slick; sly; untrustworthy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "448652dd-3f98-451a-83ce-3c74d1dab22b",
                                "sense_id": "8a2284e8-672d-3c0a-80af-a102ca19aaed",
                                "text": "Why, I thought he was a straight-haired, sleeky, canting snake of a man."
                            }
                        ]
                    }
