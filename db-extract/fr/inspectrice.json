                                "example_id": "a327f1d2-05cf-47d3-9c95-bdbbc2264e43",
                                "sense_id": "d5bd8e5b-60b2-3269-8653-bd4777356ea5",
                                "text": "Inspectrice des impôts."
                            },
                            {
                                "example_id": "85f1458f-c535-4533-99d9-692db2214085",
                                "sense_id": "d5bd8e5b-60b2-3269-8653-bd4777356ea5",
                                "text": "Inspectrice d’Académie."
                            },
                            {
                                "example_id": "6fe3d668-5840-419a-96f3-4bb5663ce0ac",
                                "sense_id": "d5bd8e5b-60b2-3269-8653-bd4777356ea5",
                                "text": "Inspectrice des fraudes."
