                        "form": "fêne"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4791395a-651d-3ffa-b8fa-39a3b577e7f8",
                        "entry_id": "98edaaa6-65f1-3011-86b6-a45b2cf9cedb",
                        "glosses": [
                            "Fruit du hêtre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dfbd4257-51e5-4517-bdf9-b530376b18d7",
                                "sense_id": "4791395a-651d-3ffa-b8fa-39a3b577e7f8",
                                "text": "La malédiction de saint Withold soit sur ces damnés pourceaux ! dit le porcher après avoir violemment soufflé dans sa corne pour rassembler la troupe éparse des porcs, lesquels répondirent à son appel sur des tons également mélodieux, mais ne s’empressèrent pas toutefois de quitter le banquet luxurieux de faines et de glands dont ils s’engraissaient."
                            },
                            {
                                "example_id": "8238222f-e58a-4587-9438-e18f328e1334",
                                "sense_id": "4791395a-651d-3ffa-b8fa-39a3b577e7f8",
                                "text": "II y a cinq jours cependant, un petit garçon, qui cherchait des faines dans le bois communal, fut soudain assailli et mordu à la joue par une créature à moitié nue, aux yeux de feu, qui tenta de l'égorger."
                            },
                            {
                                "example_id": "a77e6a68-3e9c-41da-83a0-6f3197df61cb",
                                "sense_id": "4791395a-651d-3ffa-b8fa-39a3b577e7f8",
                                "text": "Amadou se souciait peu des champignons et croquait les premières faines râpeuses que l’orage avait fait tomber sous les hêtres, dont elles sont la châtaigne ou l’amande."
                            },
                            {
                                "example_id": "fc607511-3e65-4df8-a108-98917a032b1e",
                                "sense_id": "4791395a-651d-3ffa-b8fa-39a3b577e7f8",
                                "text": "Le Hêtre emploie les gros moyens en enfermant ses faines dans une gangue hérissée de piquants qui s’accrocheront à la première fourrure venue."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "09ee5adf-7c23-439b-b3e4-e8b129a72908",
                        "source_entry_id": "98edaaa6-65f1-3011-86b6-a45b2cf9cedb",
                        "source_sense_id": "4791395a-651d-3ffa-b8fa-39a3b577e7f8",
                        "source_sense_description": "fruit",
                        "target_lang_word": "Buchecker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Buchecker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0c689019-f526-3497-94ca-0febe14a09e9",
                                        "entry_id": "aec8cc4f-6f81-35fa-ab1f-cccf1190aeaf",
                                        "glosses": [
                                            "dreikantige Frucht der Buche"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1228b9b-9a1d-4a4d-b98d-6c5d03e40629",
                                                "sense_id": "0c689019-f526-3497-94ca-0febe14a09e9",
                                                "text": "Aus Bucheckern kann man Öl gewinnen."
                                            },
                                            {
                                                "example_id": "05320101-6a07-4aa6-a970-c1906b0c1782",
                                                "sense_id": "0c689019-f526-3497-94ca-0febe14a09e9",
                                                "text": "Früher wurden Bucheckern häufig geröstet und gegessen."
                                            },
                                            {
                                                "example_id": "bdd22312-6cad-4e96-9c8c-94d7ca1b20ab",
                                                "sense_id": "0c689019-f526-3497-94ca-0febe14a09e9",
                                                "text": "„Während wir unsere Beutel mit Bucheckern füllten, kam ein Forstbeamter des Wegs, mit seinem Hund.“"
                                            },
                                            {
                                                "example_id": "707eb4fc-a55a-479c-8ea9-5c84b4f1b122",
                                                "sense_id": "0c689019-f526-3497-94ca-0febe14a09e9",
                                                "text": "„Das Interessanteste war, wenn sie im Herbst den ganzen Tag Bucheckern sammelten, aus denen später Öl gepresst wurde.“"
                                            },
                                            {
                                                "example_id": "7294839a-0c98-481f-825f-14ea32dbb83f",
                                                "sense_id": "0c689019-f526-3497-94ca-0febe14a09e9",
                                                "text": "„Viereinhalb Kilo Bucheckern ergaben einen Liter ungereinigtes Öl.“"
                                            },
                                            {
                                                "example_id": "1c5e9216-5d24-4acf-973c-cd1451b6fd05",
                                                "sense_id": "0c689019-f526-3497-94ca-0febe14a09e9",
                                                "text": "„Und wenn ich etwas wie den frisch-feuchten Geruch der Wasserpumpe rieche, dann fühle ich mich einen Moment lang sowohl traurig als auch geborgen, und ich spüre geradezu die Wurzeln und Bucheckern in meinen Rücken zwicken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
