{
    "word_family": [
        "prerogative"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6993f311-4975-34e8-8f0a-115e9dc12618",
                    "sense_definition": "An exclusive right or privilege held by a person or group due to their position or status.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "rights_and_privileges",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is the <w>prerogative</w> of the board to make final decisions on company policy."
                        },
                        {
                            "text": "The manager exercised her <w>prerogative</w> to change the meeting time without prior notice."
                        }
                    ],
                    "synonyms": [
                        "privilege",
                        "right",
                        "entitlement"
                    ],
                    "common_phrases": [
                        "exercise one's prerogative"
                    ]
                },
                {
                    "sense_id": "762d9bc5-cc75-36b3-b405-523962a22da8",
                    "sense_definition": "A personal choice or right that someone has to do something in their own way.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "rights_and_privileges",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you want to dress differently, that is entirely your <w>prerogative</w>."
                        },
                        {
                            "text": "Choosing which path to take in life is a personal <w>prerogative</w>."
                        }
                    ],
                    "synonyms": [
                        "choice",
                        "discretion",
                        "option"
                    ],
                    "common_phrases": [
                        "that is your prerogative"
                    ]
                },
                {
                    "sense_id": "9aa1302b-7e1a-3e5e-ad86-7765335ddce7",
                    "sense_definition": "A special power or authority held by a monarch or head of state.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "rights_and_privileges",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The king used his royal <w>prerogative</w> to grant a pardon to the prisoner."
                        },
                        {
                            "text": "Historically, the monarch held the <w>prerogative</w> to declare war without parliamentary approval."
                        }
                    ],
                    "synonyms": [
                        "authority",
                        "power"
                    ],
                    "common_phrases": [
                        "royal prerogative"
                    ]
                },
                {
                    "sense_id": "6b8b6559-4ca0-3480-9b61-c32efd051040",
                    "sense_definition": "An inherent advantage or superior quality that gives someone an edge over others.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her natural talent for languages was a unique <w>prerogative</w> that helped her succeed abroad."
                        },
                        {
                            "text": "The team viewed their advanced technology as a competitive <w>prerogative</w> in the market."
                        }
                    ],
                    "synonyms": [
                        "advantage",
                        "edge"
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0169dab9-cd52-3f44-8d2a-b7cfead91962",
                    "sense_definition": "Relating to or possessing a hereditary or official right or privilege.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "rights_and_privileges",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>prerogative</w> powers of the crown are strictly defined by constitutional law."
                        },
                        {
                            "text": "He claimed a <w>prerogative</w> status based on his noble ancestry."
                        }
                    ],
                    "synonyms": [
                        "privileged",
                        "exclusive"
                    ]
                },
                {
                    "sense_id": "063939b9-868b-31fb-9c3c-b69111ac6a0f",
                    "sense_definition": "Relating to lawless or unchecked state actions that bypass standard legal procedures.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government engaged in <w>prerogative</w> actions that undermined the rule of law."
                        },
                        {
                            "text": "Critics warned against the rise of a <w>prerogative</w> state where executive power is absolute."
                        }
                    ],
                    "common_phrases": [
                        "prerogative state"
                    ]
                }
            ]
        }
    ]
}