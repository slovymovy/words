                                        "entry_id": "36d07a9d-98ce-3c32-948b-a64c2f10f4cb",
                                        "glosses": [
                                            "Action de parer, en verrerie, préparation du verre sur le marbre avant soufflage ou moulage, après l’avoir cueilli du creuset."
                                        ],
                                        "tags": [
                                            "Miroiterie",
                                            "Vitrerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7452f293-602f-4a0a-b0cb-d240d6a1c2d5",
                                                "sense_id": "af98d4a7-2a25-38fc-b96d-e7b3ce339483",
                                                "text": "Verre doublé. —On appelle ainsi un verre différemment coloré sur les deux faces. Pour l’obtenir, on fait une première paraison avec un verre de couleur, puis, au-dessus, on cueille du verre blanc et l’on pare de nouveau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c28df15-3325-3b58-8164-a23bfa1731d9",
                                        "entry_id": "36d07a9d-98ce-3c32-948b-a64c2f10f4cb",
                                        "glosses": [
                                            "Masse de verre en fusion destinée à être mise en forme."
                                        ],
                                        "tags": [
                                            "Verrerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c8bec50-fa36-45d1-b62e-07ccf1421b8c",
                                                "sense_id": "2c28df15-3325-3b58-8164-a23bfa1731d9",
                                                "text": "La paraison peut atteindre une température de 1100 °C."
                                            },
                                            {
                                                "example_id": "15d49a06-9271-428e-82f7-d1bf59bf7298",
                                                "sense_id": "2c28df15-3325-3b58-8164-a23bfa1731d9",
                                                "text": "Cette boule de verre, dite paraison, est façonnée sur un marbre pour lui donner une forme tronconique et esquisser le col."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3265e40-25be-39da-8223-bda7720f782b",
