                "senses": [
                    {
                        "sense_id": "b97d53d1-0897-3fb0-9ba4-332d0fc3bf19",
                        "entry_id": "2a105783-350d-36e7-8867-b55271a1c204",
                        "glosses": [
                            "Continuer à se plaindre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "077a9fa4-7cc6-4bf8-8021-8df16dfd6ab5",
                                "sense_id": "b97d53d1-0897-3fb0-9ba4-332d0fc3bf19",
                                "text": "Mais voilà le piano qui regeint, et l'énorme blonde, l'éléphant en falbalas, se lève et s'avance à son tour."
                            },
                            {
                                "example_id": "b203aa93-98d6-4999-8f13-727c06b39d89",
                                "sense_id": "b97d53d1-0897-3fb0-9ba4-332d0fc3bf19",
                                "text": "Ça y est, il geint, il regeint. Tais-toi, j’ai l’impression d’être de nouveau à Londres. Monsieur la Plainte."
                            }
                        ]
                    }
