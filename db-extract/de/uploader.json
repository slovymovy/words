                "senses": [
                    {
                        "sense_id": "45226d41-6ffe-3c2b-b050-393a9af58e72",
                        "entry_id": "9b092492-2ab6-3965-ac8a-e75ec1b33993",
                        "glosses": [
                            "jemand, der Dateien ins Internet hochlädt"
                        ],
                        "tags": [
                            "EDV"
                        ],
                        "examples": [
                            {
                                "example_id": "edeca6f7-eba7-4d5a-ba3f-7bfece0a90a7",
                                "sense_id": "45226d41-6ffe-3c2b-b050-393a9af58e72",
                                "text": "„Das liegt Hubrig zufolge auch daran, dass die mutmaßlichen Uploader häufig auf Grundlage von Daten ermittelt würden, deren Qualität er für fragwürdig hält.“"
                            },
                            {
                                "example_id": "24e6c0aa-4987-4f3d-be29-e9e920b29c8e",
                                "sense_id": "45226d41-6ffe-3c2b-b050-393a9af58e72",
                                "text": "„Öffentlich ist sie demnach nicht schon durch den Upload, sondern erst durch die Veröffentlichung des Links zur Datei - und die geschieht durch den Uploader und die Sammelseite, auf der der Link steht, nicht durch den Filehoster.“"
                            },
                            {
                                "example_id": "ed4927d2-28bf-427a-9819-71a75462141f",
                                "sense_id": "45226d41-6ffe-3c2b-b050-393a9af58e72",
                                "text": "„Illegal ist ihr Angebot, weil die, die heraufladen (die Uploader), ohne Erlaubnis urheberrechtlich geschützte Werke anbieten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
