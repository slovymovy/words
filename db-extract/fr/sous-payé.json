                        "entry_id": "2e9f7b1b-2bca-3f7a-9a03-ca2ce80a7e07",
                        "glosses": [
                            "Qui est payé moins que ce qu’il ne devrait l’être."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd4f8570-bead-4f4f-8163-84262d2a0d91",
                                "sense_id": "0f46821e-3f7d-39ce-927d-ce48a720ceae",
                                "text": "Dans leur monde où n’existe qu’un syndicat de patrons, ce personnel surqualifié et sous-payé ne parle jamais à visage découvert de son quotidien."
                            }
                        ]
                    }
                ],
