                                            {
                                                "example_id": "7a1ae5b8-73d2-458f-9764-9c354d5f3a38",
                                                "sense_id": "b67802f3-f17c-33d8-9459-2f6aaf6c83bc",
                                                "text": "„Die von dem Dienstmädchen betreute Kleine liegt in ihrem Bettchen.“"
                                            },
                                            {
                                                "example_id": "8804b0d1-1f46-4954-b0ef-a528655c5d16",
                                                "sense_id": "b67802f3-f17c-33d8-9459-2f6aaf6c83bc",
                                                "text": "„Und die Kinder weinten oft abends in ihren Bettchen.“"
                                            },
                                            {
                                                "example_id": "39bff96d-d8e0-4734-b36b-559227887d18",
                                                "sense_id": "b67802f3-f17c-33d8-9459-2f6aaf6c83bc",
                                                "text": "„Erwachend und von meinem Bettchen die Zimmerdecke anstarrend fiel mir zuerst Herr Jackopp wieder ein.“"
                                            },
                                            {
                                                "example_id": "aa4504b0-7a54-44da-adb1-68b9da4503b7",
                                                "sense_id": "b67802f3-f17c-33d8-9459-2f6aaf6c83bc",
                                                "text": "„Neben dem Bettchen stand Prinzessin Marja.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
