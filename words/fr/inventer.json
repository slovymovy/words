                    "frequency": "High",
                    "semantic_group_id": "technique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Thomas Edison a <w>inventé</w> de nombreux appareils électriques au cours de sa vie."
                        },
                        {
                            "text": "Les ingénieurs cherchent à <w>inventer</w> un procédé plus écologique pour produire de l'énergie."
                        }
                    ],
                    "synonyms": [
