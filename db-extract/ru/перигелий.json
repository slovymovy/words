                                        "sense_id": "e4f0ecff-5742-3970-8db9-c451ea3be997",
                                        "entry_id": "7f8409f7-782b-394f-83fe-57be1bd85b0b",
                                        "glosses": [
                                            "Punto más cercano al Sol en la órbita heliocéntrica de un cuerpo celeste."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aa49e559-26d0-4234-912e-c39bf12d1ad3",
                        "source_entry_id": "50f87cdb-4847-3eb4-b44f-d6645defabb0",
                        "source_sense_id": "96ecc1f0-bbf5-3549-9def-ba808b616e0d",
                        "target_lang_word": "Perihel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Perihel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4eb812a3-3c62-3511-97a6-fe57cb376b4f",
                                        "entry_id": "6d8995de-268f-321c-a98e-21c30224bfdc",
                                        "glosses": [
                                            "sonnennächster Punkt einer Planetenbahn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "819ed684-94f1-462f-ae7a-da447d922cc0",
                                                "sense_id": "4eb812a3-3c62-3511-97a6-fe57cb376b4f",
                                                "text": "Die Bahngeschwindigkeit eines Planeten ist im Perihel am höchsten."
                                            },
                                            {
                                                "example_id": "acb5c851-f84e-46d7-8cd0-e7a7e7665d28",
                                                "sense_id": "4eb812a3-3c62-3511-97a6-fe57cb376b4f",
                                                "text": "„Auch die Erde kam in eine größte Nähe zur Sonne, ihr Perihel, und in eine größte Ferne, ihr Aphel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8206de17-91db-4f2b-bec8-11b4caa6c6c3",
                        "source_entry_id": "50f87cdb-4847-3eb4-b44f-d6645defabb0",
                        "source_sense_id": "96ecc1f0-bbf5-3549-9def-ba808b616e0d",
                        "target_lang_word": "Sonnennähe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sonnennähe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bfa1af3f-c41f-3959-a71c-4d6316d5f875",
                                        "entry_id": "9c1fde0e-80d0-3f07-a4df-2d3f2bc74ae1",
                                        "glosses": [
                                            "der von der Sonne nächstgelegene Punkt einer Planeten- oder Kometenbahn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f55bd144-26fe-4af4-9f8e-d1213e0cab0b",
                                                "sense_id": "bfa1af3f-c41f-3959-a71c-4d6316d5f875",
                                                "text": "„In Sonnennähe verdampft ein Teil der vereisten Substanzen, und diese Gase reißen feine Staubteilchen mit sich.“"
                                            },
                                            {
                                                "example_id": "d846c1dd-81bc-44b8-9640-a81237fa5a60",
                                                "sense_id": "bfa1af3f-c41f-3959-a71c-4d6316d5f875",
                                                "text": "„Das sind rund fünf Millionen Kilometer mehr als Anfang Januar, wenn die Erde im Perihel (Sonnennähe) steht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
