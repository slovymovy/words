                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0a00277-6fd7-4687-b571-5c74a7e546c4",
                                "sense_id": "63befc70-4bb3-3602-9ec6-d68360857b93",
                                "text": "„Dann hob er die Tasche auf, hängte sich die Uzi über die Schulter, überquerte die Straße und humpelte weiter auf den Hotelparkplatz, wo er seinen Wagen hatte stehenlassen.“"
                            },
                            {
                                "example_id": "7b4dbcdd-af44-4bef-84f7-547ee2cdbf87",
                                "sense_id": "63befc70-4bb3-3602-9ec6-d68360857b93",
                                "text": "„Wu bat den Fahrer, sie später auf dem Hotelparkplatz abzuholen.“"
                            },
                            {
                                "example_id": "23250841-6e6d-4430-95f0-21944c22f365",
                                "sense_id": "63befc70-4bb3-3602-9ec6-d68360857b93",
                                "text": "„Nach zwei lang gestreckten Blocks südlich des Hauptplatzes, wo Gentry dem gehandicapten Pfleger dabei helfen musste, sich auf den Beinen zu halten, stießen sie auf einen unbewachten Hotelparkplatz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
