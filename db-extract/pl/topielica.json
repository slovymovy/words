                        "entry_id": "43c6d4a0-c9cb-3548-b41c-95e4c0668737",
                        "glosses": [
                            "zwłoki kobiety, która utopiła się, także kobieta uratowana od utonięcia"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "2b56bcae-03e2-48c0-ac58-1087654aaea8",
                                "sense_id": "2b03e0bd-d925-3f9e-bc84-db302fe30d19",
                                "text": "Policjanci wyciągnęli spod mostu topielicę."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "4a837db8-f1a5-35ee-be12-56c5ea0a1ec5",
                        "entry_id": "43c6d4a0-c9cb-3548-b41c-95e4c0668737",
                        "glosses": [
                            "upiór, rzekomy duch utopionej kobiety"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e36bd7b-c3a2-4b07-842a-f79773f49494",
                                "sense_id": "4a837db8-f1a5-35ee-be12-56c5ea0a1ec5",
                                "text": "Tylko mgławice nad nurtem Narewu skłębiły się gęściej i ukryły w swej płachcie bladolice boginki, zielonookie rusałki-wodnice, topielice upiorne, unoszone wartem bieżnym, rogany-latawice, na pruską Szatrję dążące."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
