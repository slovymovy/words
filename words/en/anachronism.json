{
    "word_family": [
        "anachronistic",
        "anachronistically"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2412a3ea-42b8-3120-934c-02a57c8b6cee",
                    "sense_definition": "A person, object, or custom that seems to belong to a different time period than the one in which it exists.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "time_error",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In today's digital age, using a manual typewriter feels like a complete <w>anachronism</w>."
                        },
                        {
                            "text": "He was a true <w>anachronism</w>, wearing a Victorian suit to a modern business meeting."
                        }
                    ],
                    "synonyms": [
                        "misfit"
                    ],
                    "common_phrases": [
                        "a complete anachronism",
                        "seemed like an anachronism"
                    ]
                },
                {
                    "sense_id": "df68c685-c03c-332a-8372-c364be64efeb",
                    "sense_definition": "An error in chronology, especially a chronological misplacement of persons, events, objects, or customs in regard to each other.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "time_error",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The appearance of a wristwatch in a movie set in ancient Rome is a glaring <w>anachronism</w>."
                        },
                        {
                            "text": "The historian pointed out a chronological <w>anachronism</w> in the novel's description of medieval warfare."
                        }
                    ],
                    "synonyms": [
                        "misdate",
                        "prochronism"
                    ],
                    "common_phrases": [
                        "chronological anachronism",
                        "glaring anachronism"
                    ]
                },
                {
                    "sense_id": "32e48d93-2c4f-3f6d-a588-b50d05923a86",
                    "sense_definition": "The act of projecting modern values, ideas, or perspectives onto historical periods.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "time_error",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Judging historical figures by modern ethical standards is a common form of historical <w>anachronism</w>."
                        },
                        {
                            "text": "The critic warned against the danger of <w>anachronism</w> when analyzing ancient philosophical texts."
                        }
                    ],
                    "synonyms": [
                        "presentism"
                    ],
                    "common_phrases": [
                        "historical anachronism"
                    ]
                }
            ]
        }
    ]
}