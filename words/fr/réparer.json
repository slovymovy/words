{
    "word_family": [
        "réparation",
        "réparateur",
        "réparable",
        "irréparable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6b3a5e05-0921-3f59-a4d5-84b7e55516b4",
                    "sense_definition": "Remettre en bon état ce qui a été abîmé, cassé ou détérioré.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "materiel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le mécanicien a promis de <w>réparer</w> ma voiture avant la fin de la semaine."
                        },
                        {
                            "text": "Mon père passe souvent son samedi à <w>réparer</w> de vieux objets dans le garage."
                        }
                    ],
                    "synonyms": [
                        "rafistoler"
                    ],
                    "common_phrases": [
                        "réparer une voiture",
                        "réparer un vélo",
                        "faire réparer"
                    ]
                },
                {
                    "sense_id": "b00586b3-a7fb-322b-93be-c6528a3927d7",
                    "sense_definition": "Corriger ou compenser une faute, une erreur ou une maladresse.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "moral",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a immédiatement présenté des excuses pour tenter de <w>réparer</w> son erreur."
                        },
                        {
                            "text": "Après cette dispute stupide, elle a tout fait pour <w>réparer</w> ses torts."
                        }
                    ],
                    "common_phrases": [
                        "réparer une erreur",
                        "réparer une faute",
                        "réparer ses torts"
                    ]
                },
                {
                    "sense_id": "29669523-48f4-3ae7-8316-60befe3fee51",
                    "sense_definition": "Dédommager ou accorder une compensation pour un préjudice ou une injustice.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "juridique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le tribunal a exigé que l'entreprise verse une somme pour <w>réparer</w> le préjudice causé aux victimes."
                        },
                        {
                            "text": "L'accusé a exprimé des regrets sincères et a proposé de <w>réparer</w> le dommage matériel."
                        }
                    ],
                    "common_phrases": [
                        "réparer le préjudice",
                        "réparer le dommage"
                    ]
                },
                {
                    "sense_id": "d741469e-3a88-38c3-b665-3bf3d41e13d9",
                    "sense_definition": "Rétablir ou reconstituer ce qui a été affaibli ou diminué, comme les forces ou la santé.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vitalite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une longue nuit de sommeil lui a enfin permis de <w>réparer</w> ses forces épuisées par la maladie."
                        },
                        {
                            "text": "Le voyageur s'est arrêté dans une auberge accueillante pour se reposer et <w>réparer</w> ses forces."
                        }
                    ],
                    "common_phrases": [
                        "réparer ses forces"
                    ]
                },
                {
                    "sense_id": "7a7dd6c9-7ffa-332d-a64c-e6f561b1571e",
                    "sense_definition": "Faire disparaître les imperfections d'aspect d'un ouvrage pour en soigner la finition.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "artisanat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le sculpteur prend le temps de <w>réparer</w> minutieusement les bavures du bronze avant le polissage final."
                        },
                        {
                            "text": "L'artisan utilise un grattoir fin pour <w>réparer</w> les détails délicats de la statue en plâtre."
                        }
                    ],
                    "common_phrases": [
                        "réparer un moule"
                    ]
                }
            ]
        }
    ]
}