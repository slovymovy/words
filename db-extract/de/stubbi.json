                "senses": [
                    {
                        "sense_id": "2d08ba30-a7f6-30e3-8e31-1bfb9f81461e",
                        "entry_id": "7ec3da90-fc8f-3971-9358-9cefd288ea94",
                        "glosses": [
                            "volkstümliche Bezeichnung für eine kleine, gedrungene, stabil stehende Flasche Bier"
                        ],
                        "tags": [
                            "Rheinland"
                        ],
                        "examples": [
                            {
                                "example_id": "265d1eb8-21e7-43d0-aa8a-c550e1db1f0e",
                                "sense_id": "2d08ba30-a7f6-30e3-8e31-1bfb9f81461e",
                                "text": "„Sie bestellte für sich einen Weißwein und für Leyendecker eine kleine Flasche Bier, ein Stubbi, wie man hier sagt.“"
                            },
                            {
                                "example_id": "08090756-9f4b-47a7-9f98-ecc0cccd9ef8",
                                "sense_id": "2d08ba30-a7f6-30e3-8e31-1bfb9f81461e",
                                "text": "„Bis in den frühen Morgen hing er in seiner Ecke am Tresen, rauchte, trank Stubbis und Korn, […]“"
                            },
                            {
                                "example_id": "0de8377f-a31e-4113-80b8-35940f4a4623",
                                "sense_id": "2d08ba30-a7f6-30e3-8e31-1bfb9f81461e",
                                "text": "„[…] die eigentliche Darreichungsform des Bitburgers ist in einer gedrungenen 0,33-Liter-Flasche, die in der Eifel »Stubbi« genannt wird.“"
                            },
                            {
                                "example_id": "b0924de2-afda-4bf0-bc19-049f2edc7852",
                                "sense_id": "2d08ba30-a7f6-30e3-8e31-1bfb9f81461e",
                                "text": "„Der Neusiedler, erfreut ob des durchreisenden Fremden, bot mir ein „Stubbi“ an, wie die Eingeborenen hierzuland ein Fläschchen Bier zu bezeichnen pflegen, und verdarb mir zugleich dessen Genuß, […]“"
                            },
                            {
                                "example_id": "886abee1-106f-4196-9498-c7a54ec7835b",
                                "sense_id": "2d08ba30-a7f6-30e3-8e31-1bfb9f81461e",
                                "text": "Auf dem Fastnachtszug habe ich zwei Stubbis getrunken."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d2c2fc2a-f448-419f-bb3a-17f3f3acfd5a",
                        "source_entry_id": "7ec3da90-fc8f-3971-9358-9cefd288ea94",
                        "source_sense_id": "2d08ba30-a7f6-30e3-8e31-1bfb9f81461e",
                        "source_sense_description": "Rheinland: volkstümliche Bezeichnung für eine kleine, gedrungene, stabil stehende Flasche Bier",
                        "target_lang_word": "stubby",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stubby",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fc0f720b-b08d-3e56-a655-5b57951b830d",
                                        "entry_id": "7f2bf7cb-02ff-3efe-a12d-f21262b95ca5",
                                        "glosses": [
                                            "Abounding with stubs."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "671565b7-b885-3c14-8ae7-6ec3c2c539dc",
                                        "entry_id": "7f2bf7cb-02ff-3efe-a12d-f21262b95ca5",
                                        "glosses": [
                                            "Like a stub; short, especially cut short, thick and stiff; stunted; stubbed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "309ab5b1-4c32-493d-8891-1df7f413a8b3",
                                                "sense_id": "671565b7-b885-3c14-8ae7-6ec3c2c539dc",
                                                "text": "St Cuthbert's stands among trees at one corner of the green, and has a 17th-century bellcote decorated with stone balls and a stubby spire."
                                            },
                                            {
                                                "example_id": "6dc97030-90ad-4935-9e79-576aca21f1ac",
                                                "sense_id": "671565b7-b885-3c14-8ae7-6ec3c2c539dc",
                                                "text": "The mouth with its bright, shiny grimace exposes a stubby row of teeth, from left to right growing stubbier and stubbier, with more and more cavities."
                                            },
                                            {
                                                "example_id": "a3b6bdd3-f693-4fa1-a5b5-e07d59c7c94c",
                                                "sense_id": "671565b7-b885-3c14-8ae7-6ec3c2c539dc",
                                                "text": "For instance, long, thin hands generally indicate that a person is creative and intuitive, while shorter, stubbier hands typically connote a hardworking or athletic type of person."
                                            },
                                            {
                                                "example_id": "37ee2e1f-a6bc-4da8-bc35-88445daf8a48",
                                                "sense_id": "671565b7-b885-3c14-8ae7-6ec3c2c539dc",
                                                "text": "The front-most spines are the shortest, stubbiest, and most forward directed."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "stubby",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cc7afab6-f66d-389d-963a-0f254062c3a6",
                                        "entry_id": "ffc4e0d2-36c6-3bc2-9868-1e530d9cb721",
                                        "glosses": [
                                            "A small, squat beer bottle."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "Canada",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae9ccf44-1f47-4d98-90ab-85f77a2484b4",
                                                "sense_id": "cc7afab6-f66d-389d-963a-0f254062c3a6",
                                                "text": "While most stubbies looked alike, there was one distinct stubby brought out by Carling-O′Keefe.[…]The era of the stubby was short, however. Although a superior container, it was not chic enough for the 1980s drinker."
                                            },
                                            {
                                                "example_id": "4b51c63a-4190-427e-a7c6-31d3dbb47534",
                                                "sense_id": "cc7afab6-f66d-389d-963a-0f254062c3a6",
                                                "text": "Annie looked at him a bit surprised and came in, and he realized she carried a bottle of beer with her. Not a stubby, but a long neck."
                                            },
                                            {
                                                "example_id": "cb0c4e22-90ff-4814-8f99-8eb71cdf7d2b",
                                                "sense_id": "cc7afab6-f66d-389d-963a-0f254062c3a6",
                                                "text": "Near the memorial were some wine casks and an unopened stubby of beer, whose label was yet to fade, which had been left to slake the thirst of the deceased."
                                            },
                                            {
                                                "example_id": "72aaedf4-0351-4f89-b73b-790676381af6",
                                                "sense_id": "cc7afab6-f66d-389d-963a-0f254062c3a6",
                                                "text": "Another notable thing that happens this month is the debut of Spycatcher on Star TV.[…]But come Wednesday night, he sits in the TV room with his stubby of Foster′s beer and watches Steve Nolan catch dirty foreigners (called Commies) selling secrets to some Russian organization called the KGB."
                                            },
                                            {
                                                "example_id": "14dec005-2fb6-4b66-8553-e40db436ce7a",
                                                "sense_id": "cc7afab6-f66d-389d-963a-0f254062c3a6",
                                                "text": "I had everything planned, and later I kept a stubby behind the spare tire of my ′37 Ford until the bottle was better aged than the beer. I don′t know what happened to it but I′m surprised that it didn′t explode with the heat of that summer."
                                            },
                                            {
                                                "example_id": "250a36a1-476d-4de2-a67a-f3404899403c",
                                                "sense_id": "cc7afab6-f66d-389d-963a-0f254062c3a6",
                                                "text": "A schooner (425ml in Queensland), when you allow for the collar, is not much more beer than a stubby. A stubby of home brew costs me 25 cents."
                                            },
                                            {
                                                "example_id": "2c5f97c8-3a78-40c9-8add-8657381cfeac",
                                                "sense_id": "cc7afab6-f66d-389d-963a-0f254062c3a6",
                                                "text": "The Liquor Trades Union member concedes that both dogs are quite clever, but says his is even cleverer. His dog, named Measure, is told to go and fetch a stubby of beer and pour seven ounces into a ten-ounce glass. It does this perfectly."
                                            },
                                            {
                                                "example_id": "60d83346-eb27-4c83-b22c-84581109dbe6",
                                                "sense_id": "cc7afab6-f66d-389d-963a-0f254062c3a6",
                                                "text": "Anyhow, so I goes into the bar and there′s the donkey having a beer with a tourist. See, the way they done it was, they′d hold up the stubby and the donkey would just guzzle it down, like there was no tomorrow."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c7aa9e93-88cb-45f5-8a8f-5e27aed86b92",
                        "source_entry_id": "7ec3da90-fc8f-3971-9358-9cefd288ea94",
                        "source_sense_id": "2d08ba30-a7f6-30e3-8e31-1bfb9f81461e",
                        "source_sense_description": "Rheinland: volkstümliche Bezeichnung für eine kleine, gedrungene, stabil stehende Flasche Bier",
                        "target_lang_word": "stubbie",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stubbie",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b04cc9b3-8dfb-31ca-b395-69081d57c57b",
                                        "entry_id": "217d2465-94c1-39df-bea3-66aa88debd9c",
                                        "glosses": [
                                            "A small beer bottle with a distinctive squat shape; a stubby."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "New-Zealand"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93e672d4-b5de-4947-9cd4-23b1e7cd0187",
                                                "sense_id": "b04cc9b3-8dfb-31ca-b395-69081d57c57b",
                                                "text": "2006, Tom Conyers, Morse Code for Cats, 2008, Zeus Publications, Australia, page 59,\nJoe drank his lone stubbie of light beer like it was poison – which isn′t far wrong."
                                            },
                                            {
                                                "example_id": "296d6f1a-a008-47dd-afe0-8beb182371ac",
                                                "sense_id": "b04cc9b3-8dfb-31ca-b395-69081d57c57b",
                                                "text": "Every time you throw your Coke can or your stubbie, or leave your McDonald′s wrapper on the beach, you spoil our beautiful pristine coastline."
                                            },
                                            {
                                                "example_id": "463d6ffb-14c4-410e-82a2-b81db1e8e393",
                                                "sense_id": "b04cc9b3-8dfb-31ca-b395-69081d57c57b",
                                                "text": "The communal area is constantly cruisey, whether you′re slung low in a hammock or sipping your BYO stubbie in the cool, cushioned area with a frayed map in hand."
                                            },
                                            {
                                                "example_id": "c2b262a0-84a7-4502-9754-9fa054211185",
                                                "sense_id": "b04cc9b3-8dfb-31ca-b395-69081d57c57b",
                                                "text": "In PNG we would buy beer wholesale at around 10 cents per stubbie or can, and sell it to ourselves at 20 cents per stubbie or can."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
