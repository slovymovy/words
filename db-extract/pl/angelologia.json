                "senses": [
                    {
                        "sense_id": "a07afa20-c35d-354d-b3bb-69750da7dc19",
                        "entry_id": "ed4f06ec-5790-3e18-8594-53617672626f",
                        "glosses": [
                            "w teologii chrześcijańskiej: nauka o aniołach"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c19a1721-587e-4f22-9b79-2385ae50c4d0",
                                "sense_id": "a07afa20-c35d-354d-b3bb-69750da7dc19",
                                "text": "Diakoni zdali wczoraj angelologię."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "2cb3783b-4128-37a0-add6-ed31cb3dad86",
                        "entry_id": "ed4f06ec-5790-3e18-8594-53617672626f",
                        "glosses": [
                            "w religioznawstwie: nauka o duchach dobrych, dział demonologii"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "996fd150-1666-4f0d-9d2e-ffbb8e1f1680",
                                "sense_id": "2cb3783b-4128-37a0-add6-ed31cb3dad86",
                                "text": "Kupiłem sobie książkę o angelologii."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "a74cd0d8-db33-3a1d-9703-ee84a404ac12",
                        "entry_id": "ed4f06ec-5790-3e18-8594-53617672626f",
                        "glosses": [
                            "ogół wierzeń, także ludowych, dotyczących aniołów i ich wpływu na rzeczywistość"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3d41cec-3b21-4d76-ac75-03fc78e69511",
                                "sense_id": "a74cd0d8-db33-3a1d-9703-ee84a404ac12",
                                "text": "Profesor zajmował się ludową angelologią ludów Kaukazu."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "134d4e14-4b3b-3c4b-97bc-6ad22b271f86",
                        "entry_id": "ed4f06ec-5790-3e18-8594-53617672626f",
                        "glosses": [
                            "bujanie w obłokach"
                        ],
                        "tags": [
                            "broadly",
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "7827f545-8f89-4eb1-abb3-123f011f63d9",
                                "sense_id": "134d4e14-4b3b-3c4b-97bc-6ad22b271f86",
                                "text": "To jego gadanie o warunkach jakie mają to istna angelologia."
                            },
                            {
                                "example_id": "5047f2be-f2ee-43f6-89f8-8a82a509897d",
                                "sense_id": "134d4e14-4b3b-3c4b-97bc-6ad22b271f86",
                                "text": "Sam nie rozumiem, skąd to mi się bierze, • że jestem mitologiczne zwierzę, • ni to świnio-byk ni to koto-pies, • w ogóle z moich stron: liryka, liryka, • tkliwa dynamika, • angelologia • i dal."
                            }
                        ],
                        "sense_index_json": "\"1.4\""
                    }
                ],
