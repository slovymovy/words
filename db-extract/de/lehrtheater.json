                "senses": [
                    {
                        "sense_id": "b1c2da6e-cba8-35b0-b2b4-1c7aea98b60d",
                        "entry_id": "c7338391-f703-3690-9e5e-9293e4465408",
                        "glosses": [
                            "Schaubühne mit didaktischer Intention"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e10bc2ba-ce39-407a-9eae-aed59e28ad5b",
                                "sense_id": "b1c2da6e-cba8-35b0-b2b4-1c7aea98b60d",
                                "text": "„Das Theater bleibt Theater, auch wenn es Lehrtheater ist, und soweit es gutes Theater ist, ist es amüsant.“"
                            },
                            {
                                "example_id": "2298aa98-58b4-47d2-a99a-864ce54b3842",
                                "sense_id": "b1c2da6e-cba8-35b0-b2b4-1c7aea98b60d",
                                "text": "„Das ist Lehrtheater im Sinne Brechts.“"
                            },
                            {
                                "example_id": "46c8e091-ff92-4a80-9d1a-6902cf2a2508",
                                "sense_id": "b1c2da6e-cba8-35b0-b2b4-1c7aea98b60d",
                                "text": "„Frühere Stücke von mir waren eine bewußte Degradierung des Boulevard-Theaters, dann des politischen Lehrtheaters.“"
                            },
                            {
                                "example_id": "ccae648d-c1db-40c1-b39e-f197ebce64bc",
                                "sense_id": "b1c2da6e-cba8-35b0-b2b4-1c7aea98b60d",
                                "text": "„Im Lehrtheater lernt das Kind, wie eine Ampel funktioniert, wie man sicher eine Straße überquert, welche Verkehrszeichen, Einrichtungen oder Menschen helfen, wo Verführer und Gefahren lauern und wie man sich gegen sie wehren kann.“"
                            },
                            {
                                "example_id": "caab2114-5dfd-49e5-9706-1df044eb8bf1",
                                "sense_id": "b1c2da6e-cba8-35b0-b2b4-1c7aea98b60d",
                                "text": "„Brechts Lehrtheater ist ein Welttheater, in welchem die unendliche Welt sonderbar klein und viereckig geworden ist: etwas größer vielleicht als eine Zigarrenkiste, kaum größer als eine deutsche Schulstube.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
