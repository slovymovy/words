                "senses": [
                    {
                        "sense_id": "a1e90d1c-871e-3626-bdb2-2561f8ca4fda",
                        "entry_id": "a4d9554a-6cf6-3466-92e8-151d01f9d623",
                        "glosses": [
                            "Tonsignal im Telefon, das anzeigt, dass der/die Angerufene gerade einen anderen Anruf hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dcc9c0b6-7cba-4d1b-a7d2-9621c4d8c021",
                                "sense_id": "a1e90d1c-871e-3626-bdb2-2561f8ca4fda",
                                "text": "„Zuschauer hatten sich darüber beschwert, dass trotz Besetztzeichen Gebühren verrechnet wurden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7a3f770c-8886-3b6c-beac-272e0888e049",
                        "entry_id": "a4d9554a-6cf6-3466-92e8-151d01f9d623",
                        "glosses": [
                            "optisches Zeichen, dass ein bestimmter Raum momentan nicht zugänglich ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c32523c-5cd0-43d6-a430-186220a53f47",
                                "sense_id": "7a3f770c-8886-3b6c-beac-272e0888e049",
                                "text": "„Das Besetzzeichen wurde rot, die Eins leuchtete auf, die Zwei, ich starrte nervös auf die Ziffern, bis ich plötzlich bemerkte, daß jemand neben mir stand.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
