                ],
                "senses": [
                    {
                        "sense_id": "1a8049cc-70b3-3bd0-b88f-5f5d36081fb4",
                        "entry_id": "009e5601-ab33-3b7d-abca-b3f42c2b7f63",
                        "glosses": [
                            "żołnierz uzbrojony w procę"
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "0097f4d0-8943-4901-bc14-f7dce842fed1",
                                "sense_id": "1a8049cc-70b3-3bd0-b88f-5f5d36081fb4",
                                "text": "Na wyspie widać bitewne przygotowania. Nad brzegiem pojawiają się łucznicy i procarze. W dalszych szeregach miotacze oszczepów i ciężkozbrojni."
                            },
                            {
                                "example_id": "50d89dad-ce11-4bd8-89d3-14ddc9c283db",
                                "sense_id": "1a8049cc-70b3-3bd0-b88f-5f5d36081fb4",
                                "text": "Konnica podzieliła się na dwie części, procarze i łucznicy szli przed wojskiem, a w pierwszym szeregu byli sami najbardziej waleczni"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "18f189d4-0346-439c-865a-e83a2c6005de",
                        "source_entry_id": "009e5601-ab33-3b7d-abca-b3f42c2b7f63",
                        "source_sense_id": "1a8049cc-70b3-3bd0-b88f-5f5d36081fb4",
                        "target_lang_word": "slinger",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "slinger",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "23126e87-5fb4-35b1-bd55-f6d640f50db8",
                                        "entry_id": "6790fb0b-a215-3cdd-aeb2-45d4c67936a3",
                                        "glosses": [
                                            "Someone who slings or who uses a sling."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f3b5957e-f5b7-3472-9e2d-dc40e040dd9c",
                                        "entry_id": "6790fb0b-a215-3cdd-aeb2-45d4c67936a3",
                                        "glosses": [
                                            "An American Midwest diner meal consisting of typically two eggs, hash browns, and a ground meat patty, all covered in chili con carne and topped with cheese and onions."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3507f60c-fafa-4757-b2a1-2ad88a630e6a",
                        "source_entry_id": "009e5601-ab33-3b7d-abca-b3f42c2b7f63",
                        "source_sense_id": "1a8049cc-70b3-3bd0-b88f-5f5d36081fb4",
                        "target_lang_word": "frondeur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "frondeur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "77b40929-a970-3113-aac9-4a930911c80d",
                                        "entry_id": "77f404ed-5505-3396-8e5a-c007e65c6569",
                                        "glosses": [
                                            "Celui qui lance des pierres, des balles, avec une fronde."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71df7f6a-c013-41c5-9f99-e78011f4379b",
                                                "sense_id": "77b40929-a970-3113-aac9-4a930911c80d",
                                                "text": "On avait pris quelques précautions pour mettre ces entrées sous la protection des angles saillants, au moyen desquels on pouvait, en cas de besoin, les flanquer d’archers et de frondeurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98af286e-3ba6-3dd5-a084-d26f06a87ad4",
                                        "entry_id": "77f404ed-5505-3396-8e5a-c007e65c6569",
                                        "glosses": [
                                            "Celui qui fronde, qui critique les autorités établies ou les opinions reçues."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bddc6113-b760-4daa-829f-b683099d63fd",
                                                "sense_id": "98af286e-3ba6-3dd5-a084-d26f06a87ad4",
                                                "text": "C’est un frondeur éternel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a7da68d-39fe-304e-8415-f6b4e7c4d369",
                                        "entry_id": "77f404ed-5505-3396-8e5a-c007e65c6569",
                                        "glosses": [
                                            "Opposant politique sous Louis XIV."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a2fa3253-8fe8-3ff2-a1ce-f13c0a65744a",
                                        "entry_id": "77f404ed-5505-3396-8e5a-c007e65c6569",
                                        "glosses": [
                                            "Parlementaire contestant la ligne politique de son groupe politique."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0450f6c4-d513-4924-a846-babf85622623",
                                                "sense_id": "a2fa3253-8fe8-3ff2-a1ce-f13c0a65744a",
                                                "text": "« Je découvre avec inquiétude qu’un site d’extrême droite, qui appelle à tuer des élus de gauche et avocats, publie mon adresse… Ces menaces doivent cesser », a réagi le député LFI (frondeur) Alexis Corbière."
                                            },
                                            {
                                                "example_id": "de96df28-3042-45dd-b7b1-c3bcabb52210",
                                                "sense_id": "a2fa3253-8fe8-3ff2-a1ce-f13c0a65744a",
                                                "text": "L’histoire de ces députés socialistes aura marqué le quinquennat Hollande. Ces frondeurs étaient persuadés d’agir en vigie de la gauche face à un gouvernement qui reniait ses valeurs (contre le crédit d’impôt pour la compétitivité et l’emploi ou la loi Travail) mais ils ont été considérés comme des traîtres par leurs camarades qui estimaient qu’ils jouaient contre leur propre camp."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7f44e63-e881-30be-8594-60ec1ce17fdc",
                                        "entry_id": "77f404ed-5505-3396-8e5a-c007e65c6569",
                                        "glosses": [
                                            "Celui qui contredit, qui critique, qui blâme."
                                        ],
                                        "tags": [
                                            "Simplement"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a88bdc9c-1750-4bb3-8ab7-4c1b153204a5",
                                                "sense_id": "c7f44e63-e881-30be-8594-60ec1ce17fdc",
                                                "text": "Ce ministre a rencontré presque autant de frondeurs que d’approbateurs."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "frondeur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1bbf3987-34ff-386b-931d-533ca0c69a6b",
                                        "entry_id": "768f858c-7416-3975-b23c-5136ca2672d8",
                                        "glosses": [
                                            "Qui désapprouve, qui blâme, qui critique, qui contredit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "584a3d9e-c9ba-452b-a4c3-40ab3fda11c2",
                                                "sense_id": "1bbf3987-34ff-386b-931d-533ca0c69a6b",
                                                "text": "Un esprit frondeur."
                                            },
                                            {
                                                "example_id": "1487f4ff-ae95-4639-ab76-80667cde87d9",
                                                "sense_id": "1bbf3987-34ff-386b-931d-533ca0c69a6b",
                                                "text": "Une jeunesse frondeuse."
                                            },
                                            {
                                                "example_id": "2d3aa700-45f4-437f-821b-8ed9e2267acf",
                                                "sense_id": "1bbf3987-34ff-386b-931d-533ca0c69a6b",
                                                "text": "Tu y seras accueilli comme un frère, nous t’y saluerons roi de ces esprits frondeurs que rien n’épouvante."
                                            },
                                            {
                                                "example_id": "8fc35e40-9518-49e5-b2a1-ec8ddb074581",
                                                "sense_id": "1bbf3987-34ff-386b-931d-533ca0c69a6b",
                                                "text": "Par ailleurs, l'UEFA \"est en contact avec les ligues domestiques\", qui pourraient décider d'exclure les clubs frondeurs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
