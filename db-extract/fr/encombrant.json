                        "entry_id": "7e2d0e82-eaa9-3829-9a3c-72dd60a8fd81",
                        "glosses": [
                            "Qui encombre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e28c1a95-0748-4a56-8744-fe7ca81bc9a7",
                                "sense_id": "2b0a5de8-072c-36b3-aa79-515be819812b",
                                "text": "Des objets encombrants."
                            },
                            {
                                "example_id": "4a615bd5-68f3-4593-a357-c03284a6ac02",
                                "sense_id": "2b0a5de8-072c-36b3-aa79-515be819812b",
                                "text": "Des marchandises encombrantes."
                            },
                            {
                                "example_id": "30f4b096-6fb7-4b44-ad2c-3ba09032c190",
                                "sense_id": "2b0a5de8-072c-36b3-aa79-515be819812b",
                                "text": "C'est devenu une véritable plaie pour des automobilistes aux voitures toujours plus encombrantes: se garer devient de plus en plus difficile."
                            }
                        ]
                    },
                    {
                        "sense_id": "b13f8c77-8e41-39d2-92fc-60fcb728d1b6",
                        "entry_id": "7e2d0e82-eaa9-3829-9a3c-72dd60a8fd81",
                        "glosses": [
                            "Qui est envahissant, importun, gênant."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "99015e09-371b-49f7-96dd-ce25a6076429",
                                "sense_id": "b13f8c77-8e41-39d2-92fc-60fcb728d1b6",
                                "text": "Il songeait, d’autre part, […] à se débarrasser de ses deux encombrants gardes du corps qui le tenaient chacun par un bras après lui avoir mis les poucettes."
                            }
                        ]
                    },
                    {
                        "sense_id": "242671f2-6bf1-3a44-819a-793448d3b27b",
                        "entry_id": "7e2d0e82-eaa9-3829-9a3c-72dd60a8fd81",
                        "glosses": [
                            "Dont les conséquences pèsent sur le présent et sur l’avenir."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "32b93f97-e547-4253-8390-9cc4ad89d5fa",
                                "sense_id": "242671f2-6bf1-3a44-819a-793448d3b27b",
                                "text": "Un passé encombrant."
                            },
                            {
                                "example_id": "bbeb336a-bd17-4dc6-a589-6690497eac0b",
                                "sense_id": "242671f2-6bf1-3a44-819a-793448d3b27b",
                                "text": "Un bijou encombrant"
                            }
                        ]
                    }
