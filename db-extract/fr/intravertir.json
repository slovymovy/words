                ],
                "senses": [
                    {
                        "sense_id": "6e9e5e9f-98ab-342a-b7da-c4bbe3f85605",
                        "entry_id": "c93fcd51-559c-39b6-a076-24958f71b522",
                        "glosses": [
                            "Diriger vers soi-même, vers l’intérieur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81c9428a-8475-4d3d-81f1-153fe9e819b4",
                                "sense_id": "6e9e5e9f-98ab-342a-b7da-c4bbe3f85605",
                                "text": "Il faut, pour cela, intravertir la grande firme, l’intégrer à l’économie du territoire d’implantation en procédant par étapes et donnant des modalités qui tiennent compte des situations concrètes."
                            },
                            {
                                "example_id": "9b940e85-c120-4f7a-a2b4-f8b749e91a5c",
                                "sense_id": "6e9e5e9f-98ab-342a-b7da-c4bbe3f85605",
                                "text": "Il convient de l’intravertir, c’est-à-dire de relier les moteurs puissants que sont les F.T. aux unités domestiques par les canaux de l’investissement et de l’innovation productive."
                            }
                        ]
                    }
                ],
