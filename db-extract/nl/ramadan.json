                        "glosses": [
                            "de negende maand van het islamitische jaar, waarin men vast (d.w.z. zich onthoudt van voedsel, drinken, roken en seksueel genot) van zonsopgang tot zonsondergang"
                        ],
                        "tags": [],
                        "examples": [
