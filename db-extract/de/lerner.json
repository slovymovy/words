                                "sense_id": "ee143234-4e36-3659-b464-ef9aad58ecbc",
                                "text": "Der Lerner büffelt neue Vokabeln."
                            },
                            {
                                "example_id": "0bef01be-fe87-4d6d-b271-50379ca5c21f",
                                "sense_id": "ee143234-4e36-3659-b464-ef9aad58ecbc",
                                "text": "„Ein dreigliedriges Schulsystem tut […] so, als ob es drei Kategorien von Lernern geben würde, die jeweils verschiedenen Unterricht benötigen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
