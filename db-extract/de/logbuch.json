                                                "text": "Kenara iri zeytin kütükleri istif edilmişti."
                                            },
                                            {
                                                "example_id": "18acc4c7-465f-4bb1-a5aa-3706d1cff9fa",
                                                "sense_id": "ac05f7e3-3f7a-34f2-a5fc-20d2b6af9eb9",
