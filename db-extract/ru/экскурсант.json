                "translations": [
                    {
                        "translation_id": "e67cd705-cfbe-4b02-8b7f-01ad48c0d315",
                        "source_entry_id": "ed909c95-51ea-3d0d-b52a-5e6838f4c82b",
                        "source_sense_id": "08a98fbb-1ac9-30d4-bf4d-58d30575c3e6",
                        "target_lang_word": "excursionist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "excursionist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a61ddcf1-ba81-3a78-8c21-89f23c791114",
                                        "entry_id": "2da23c33-b764-3b27-bba6-c4f7ce93a9cb",
                                        "glosses": [
                                            "A person who goes on an excursion; a traveller or tourist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eac58395-5f4a-460b-8bcf-4880a054a34a",
                                                "sense_id": "a61ddcf1-ba81-3a78-8c21-89f23c791114",
                                                "text": "I was provided with a receipt and duly and officially accepted as an excursionist."
                                            },
                                            {
                                                "example_id": "97a36d1e-e15c-45d3-aa39-869062770693",
                                                "sense_id": "a61ddcf1-ba81-3a78-8c21-89f23c791114",
                                                "text": "Coming home, a party of excursionists from Chertsey or Isleworth passed us singing and playing music."
                                            },
                                            {
                                                "example_id": "7cf29f8f-a280-4a62-a346-4cd8a65d872c",
                                                "sense_id": "a61ddcf1-ba81-3a78-8c21-89f23c791114",
                                                "text": "The main line of the L.N.W.R. passed to the west of the Potteries, and it is recorded that in August, 1846, two trains were run from Whitmore (the nearest station to Stoke) to Liverpool for the benefit of excursionists."
                                            },
                                            {
                                                "example_id": "db048c79-3c4a-4d4d-989d-472aa2913826",
                                                "sense_id": "a61ddcf1-ba81-3a78-8c21-89f23c791114",
                                                "text": "A 40-carriage train in 1840 taking 1,250 excursionists from Leeds to Hull was typical, while Brighton commonly received trains of 60 carriages and over 1,700 passengers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9903cb81-b91b-4356-9722-9b25d3f507cd",
                        "source_entry_id": "ed909c95-51ea-3d0d-b52a-5e6838f4c82b",
