                        "examples": [
                            {
                                "example_id": "1c8831d2-affd-440b-8580-d1627b398d79",
                                "sense_id": "58d99c7a-658d-3379-ba89-4fa852b74bcd",
                                "text": "Besac ? Oui enfin Besançon si vous préférez."
                            },
                            {
                                "example_id": "7c599fcb-6ecd-4aa6-8485-0312b59cba57",
                                "sense_id": "58d99c7a-658d-3379-ba89-4fa852b74bcd",
                                "text": "Franc-Comtoise, vous? Alors compatriote, car je suis née dans ce vieux Besac que vous devez connaître?"
                            },
                            {
                                "example_id": "cd989929-1237-4335-96c8-adb583186b0b",
                                "sense_id": "58d99c7a-658d-3379-ba89-4fa852b74bcd",
                                "text": "Une collaboration concrétisée par deux jours par semaine à Besac avec pour objectif de développer le secteur sponsoring bloqué alors à 45 000 Euros par saison"
                            },
                            {
                                "example_id": "ed66cb4d-825b-4205-bcf7-6e67ada00644",
                                "sense_id": "58d99c7a-658d-3379-ba89-4fa852b74bcd",
                                "text": "Il avait un penchant pour le pontarlier, une sorte de pastis de son pays, là-bas, à Besac comme il disait, à Besançon, mais elle le connaissait"
                            },
                            {
                                "example_id": "7ad693e3-5771-48aa-a99a-a2e8823e6a14",
                                "sense_id": "58d99c7a-658d-3379-ba89-4fa852b74bcd",
                                "text": "Vaughan et Staples, stars du comics, en dédicace à Besac et Nancy."
                            }
                        ]
                    }
