                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c4e4034d-c7bf-4df4-a311-2415ed5d9082",
                        "source_entry_id": "02146ce4-e924-351b-8b2e-0017a28fbff5",
                        "source_sense_id": "53f721d5-2e4a-3416-9e30-5f11aee96d90",
                        "source_sense_description": "Pflicht zum Dienst in den Streitkräften",
                        "target_lang_word": "military service",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "military service",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d2dc5e17-480a-3b70-a4f3-5ab19e3088eb",
                                        "entry_id": "82079236-84fd-360d-b3ef-9e4dc8133934",
                                        "glosses": [
                                            "Service in an army or other military organisation, whether as a chosen job (volunteering) or as a result of an involuntary draft (conscription)."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0bee498-57c2-4dc0-8e0b-62b793ba1ea6",
                                                "sense_id": "d2dc5e17-480a-3b70-a4f3-5ab19e3088eb",
                                                "text": "The virtues of national service, including military service, were extolled in the evening's presentations."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "14d9d0fc-b66e-4b01-a182-0fdc004dec95",
                        "source_entry_id": "02146ce4-e924-351b-8b2e-0017a28fbff5",
                        "source_sense_id": "53f721d5-2e4a-3416-9e30-5f11aee96d90",
                        "source_sense_description": "Pflicht zum Dienst in den Streitkräften",
                        "target_lang_word": "conscription",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conscription",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d97fb6bf-17de-3468-a6e0-8e7c0d09f8e6",
                                        "entry_id": "191bdec6-8711-3a82-8294-8ec485b0347f",
                                        "glosses": [
                                            "Inscription et levée annuelle des citoyens qui sont appelés au service militaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94f5ae85-29be-4801-8b96-e8b036562987",
                                                "sense_id": "d97fb6bf-17de-3468-a6e0-8e7c0d09f8e6",
                                                "text": "Les Forces européennes de défense sont constituées de personnels recrutés par conscription et de personnels de métier ou servant à long terme par engagements volontaires."
                                            },
                                            {
                                                "example_id": "73924cef-8be9-43b2-a0d5-80cb7cbc25a2",
                                                "sense_id": "d97fb6bf-17de-3468-a6e0-8e7c0d09f8e6",
                                                "text": "Canalis (baron de), Constant Cyr Melchior, membre de l’Académie française, né en 1800, à Canalis (Corrèze), taille de cinq pieds quatre pouces, en très bon état, vacciné, de race pure, a satisfait à la conscription, […]."
                                            },
                                            {
                                                "example_id": "628514be-ba14-438d-a50f-a6d081134fff",
                                                "sense_id": "d97fb6bf-17de-3468-a6e0-8e7c0d09f8e6",
                                                "text": "Il échappa à la conscription, à titre de fils aîné d’une femme veuve."
                                            },
                                            {
                                                "example_id": "a3897623-8f74-48b3-a163-3ee4329fa689",
                                                "sense_id": "d97fb6bf-17de-3468-a6e0-8e7c0d09f8e6",
                                                "text": "La Commune décréta le 29 mars l'abolition de la conscription et l'enrôlement dans la garde nationale de tous les citoyens valides ; […]."
                                            },
                                            {
                                                "example_id": "d9d92f16-a430-4004-bf20-bbc7be882c76",
                                                "sense_id": "d97fb6bf-17de-3468-a6e0-8e7c0d09f8e6",
                                                "text": "[…]; ce que je voyais de plus clair, c’est que nous allions bientôt avoir une nouvelle conscription, comme après toutes les campagnes, et que cette fois les boiteux pourraient bien en être."
                                            },
                                            {
                                                "example_id": "e0fd88c9-4075-483b-9bd7-4a0f8eb3a62c",
                                                "sense_id": "d97fb6bf-17de-3468-a6e0-8e7c0d09f8e6",
                                                "text": "Pour se garantir de la conscription, Théodore avait épousé une vieille femme très riche, Mme Lehoussais, de Toucques."
                                            },
                                            {
                                                "example_id": "120b7c23-f490-41bf-a226-fedc1c5a8890",
                                                "sense_id": "d97fb6bf-17de-3468-a6e0-8e7c0d09f8e6",
                                                "text": "Encore aujourd'hui, les citoyens américains mâles doivent s'inscrire au SSS entre 18 et 25 ans, afin que le gouvernement ait en main leurs coordonnées et puisse éventuellement les appeler sous les drapeaux lors d'un conflit armé (conscription)."
                                            },
                                            {
                                                "example_id": "5e42f3fe-786b-4ee7-91f9-226765387f7a",
                                                "sense_id": "d97fb6bf-17de-3468-a6e0-8e7c0d09f8e6",
                                                "text": "— Imaginez ! Un sergent citant Shakespeare !\nIl parut sur le point de recommencer à rire, mais se domina.\n— Cela n’a rien d’extraordinaire. Je ne suis pas sergent dans le civil.\n— Oui, dit Gabet, la conscription. Et maintenant que j’y pense, même chez nous, il doit arriver des choses de ce genre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "09b92af2-3e4a-4fca-933c-e580610105bd",
                        "source_entry_id": "02146ce4-e924-351b-8b2e-0017a28fbff5",
                        "source_sense_id": "53f721d5-2e4a-3416-9e30-5f11aee96d90",
                        "source_sense_description": "Pflicht zum Dienst in den Streitkräften",
                        "target_lang_word": "service militaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "service militaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c96bb0c2-8fdb-38c4-bd84-609b2d080712",
                                        "entry_id": "4c9bfad1-ef90-3022-a9f5-0ddb371aeb6c",
                                        "glosses": [
                                            "Obligation de servir les armées de son pays, faite à tout homme (et parfois aux femmes) d’une certaine tranche d’âge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "085df8a0-6b0a-404c-88ba-c5b7561842c0",
                                                "sense_id": "c96bb0c2-8fdb-38c4-bd84-609b2d080712",
                                                "text": "En général, les Bas-Bretons ne s’acclimataient pas si facilement. On en voit qui, après leur service militaire, oublient en rentrant au pays tout ce qu’ils ont appris au régiment, y compris la langue française."
                                            },
                                            {
                                                "example_id": "0865f13d-4203-4643-8473-06cf2ed83286",
                                                "sense_id": "c96bb0c2-8fdb-38c4-bd84-609b2d080712",
                                                "text": "Le service militaire, qui avait été un devoir de la noblesse, était abandonné à ceux qui ne pouvaient faire l’achat d’un remplaçant."
                                            },
                                            {
                                                "example_id": "47b89ba8-0390-4e79-a7b6-d027bf82b308",
                                                "sense_id": "c96bb0c2-8fdb-38c4-bd84-609b2d080712",
                                                "text": "Les peuples supportent très volontiers le service militaire, qui, sans être délicieux, correspond à l’instinct violent et ingénu de la plupart des hommes, s’impose à eux comme l’expression la plus simple, la plus rude et la plus forte du devoir, les domine par la grandeur et l’éclat de l’appareil, par l’abondance du métal qui y est employé, les exalte, enfin, par les seules images de puissance, de grandeur et de gloire qu’ils soient capables de se représenter."
                                            },
                                            {
                                                "example_id": "2e679cbd-488e-4bec-8a51-e9f284670911",
                                                "sense_id": "c96bb0c2-8fdb-38c4-bd84-609b2d080712",
                                                "text": "Le service militaire aussi l’avait perverti, l’initiant à une mollesse d’existence, qu’il n’avait pas connue auparavant. On était bien nourri et on ne travaillait pas. C’est un dicton des paysans dont la vie est si dure, qu’on devient « feignant » à faire des métiers pareils. Et le séjour dans une grande ville de l’Est lui avait révélé le goût des distractions, les habitudes d’oisiveté, les stations dans les cafés, toute une vie molle dont la nostalgie lui gonflait le cœur."
                                            },
                                            {
                                                "example_id": "1e670176-50be-4975-a122-4008037b8c9f",
                                                "sense_id": "c96bb0c2-8fdb-38c4-bd84-609b2d080712",
                                                "text": "Si, lors d’une déclaration de guerre, la mobilisation était facultative, bien peu d’hommes partiraient ; c’est du reste pour cette raison que les gouvernements ont institué le service militaire obligatoire."
                                            },
                                            {
                                                "example_id": "aa19f9c3-b615-46b7-b730-f5d14727a446",
                                                "sense_id": "c96bb0c2-8fdb-38c4-bd84-609b2d080712",
                                                "text": "Le fond était un petit lac de terre – une « planette » – où les rudes paysans d’autrefois avaient cultivé la vigne, le blé noir, et les pois chiches. Mais depuis la triste invention du service militaire obligatoire, leurs ﬁls, libérés des casernes, étaient restés prisonniers des villes, où ils avaient fondé des dynasties de gardes-barrière, de cantonniers, et de facteurs : si bien qu’au jour même de la mort des vieux, la colline, qui n'attendait que ça, avait lancé sur les champs abandonnés des vagues concentriques de thym, puis de fenouils, puis de cistes et d'aubépines."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
