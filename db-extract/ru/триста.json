                                        "entry_id": "f9789e28-6a01-30f2-b0ff-c10e9c5c6a46",
                                        "glosses": [
                                            "Kardinalzahl, die sich durch Multiplikation der Zahl drei mit der Zahl hundert ergibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c066a65-3e26-46a7-a6ee-79b777a7a7b2",
                                                "sense_id": "bbe93f82-a5b0-3928-9e57-7fe0d3381b27",
                                                "text": "Leonidas kämpfte mit dreihundert Spartanern an den Thermopylen gegen eine Übermacht der Perser einen heroischen, jedoch aussichtslosen Kampf."
                                            },
                                            {
                                                "example_id": "6c2bd80b-016d-46ae-9a85-f4ce0413e315",
                                                "sense_id": "bbe93f82-a5b0-3928-9e57-7fe0d3381b27",
                                                "text": "Die Galeeren waren bis zu vierzig Meter lang und wurden je nach Größe von achtzig bis zu dreihundert Ruderern angetrieben."
                                            },
                                            {
                                                "example_id": "0b10e89f-b46b-49a5-bf57-1b4e0dcb7838",
                                                "sense_id": "bbe93f82-a5b0-3928-9e57-7fe0d3381b27",
                                                "text": "„Der Eisberg an Steuerbord hat Ähnlichkeit mit dem Opernhaus von Sydney und ist bestimmt dreihundert Meter lang und einhundert Meter groß.“"
                                            },
                                            {
                                                "example_id": "95e7ddb5-b7c4-4fb0-91dc-e22dd5ce919c",
                                                "sense_id": "bbe93f82-a5b0-3928-9e57-7fe0d3381b27",
                                                "text": "„In manchen Jahren mussten die Soldaten über dreihundert Kämpfe bestehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
