                ],
                "senses": [
                    {
                        "sense_id": "d1258bf1-009d-3c20-a3aa-b14e6b149737",
                        "entry_id": "a744f8a5-c3a6-303e-8704-9f93b857e6c4",
                        "glosses": [
                            "Thema, über das nicht gesprochen wird / nicht gesprochen werden darf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32bbd23b-136a-4c6b-a0c5-1c4c735fb781",
                                "sense_id": "d1258bf1-009d-3c20-a3aa-b14e6b149737",
                                "text": "„Auch Steuern müssten steigen, so gut wie immer, wenn US-Präsidenten die Staatsfinanzen sanieren wollten. Doch dieser Vorschlag ist auf konservativer Seite längst zum Tabuthema geworden.“"
                            },
                            {
                                "example_id": "ad1b8cfd-5f64-4354-8fed-9dbcb3903df9",
                                "sense_id": "d1258bf1-009d-3c20-a3aa-b14e6b149737",
                                "text": "„Lange war es ein Tabuthema. Doch nun diskutieren auch die Euro-Finanzminister eine Pleite Griechenlands.“"
                            },
                            {
                                "example_id": "7a3c5b9f-9e4d-4c18-926c-7ccfde57c78a",
                                "sense_id": "d1258bf1-009d-3c20-a3aa-b14e6b149737",
                                "text": "„Meine Herkunft, meine Familiengeschichte sind keine Tabuthemen.“"
                            },
                            {
                                "example_id": "33c8a131-2344-4dc8-848a-082f3cc589db",
                                "sense_id": "d1258bf1-009d-3c20-a3aa-b14e6b149737",
                                "text": "„Oft ist das Thema Testament und das Erbe selbst ein Tabuthema in der Familie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
