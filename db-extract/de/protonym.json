                                        "sense_id": "1b7cc94c-ccc1-3f0b-aa41-2a310dc537c2",
                                        "entry_id": "89672aba-ebe7-3b10-a5d1-d33527e30602",
                                        "glosses": [
                                            "The first legitimate name of a taxon, on which the currently accepted name is based."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66b30b5c-8570-4199-b950-a1c33e05609f",
                                                "sense_id": "1b7cc94c-ccc1-3f0b-aa41-2a310dc537c2",
                                                "text": "The protonym of Macroscyphus appears to be Nees von Esenbeck's (1817) [genus] Peziza ..."
                                            },
                                            {
                                                "example_id": "5f0555ad-94bd-4c2f-abf2-03afa77d992c",
                                                "sense_id": "1b7cc94c-ccc1-3f0b-aa41-2a310dc537c2",
                                                "text": "Protonyms form the name for later revised opinions on a taxon concept as implicitly or explicitly circumscribed in a subsequent publication..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca2fa5ad-5c4f-3694-b8a7-0fe4810a8f1a",
                                        "entry_id": "89672aba-ebe7-3b10-a5d1-d33527e30602",
                                        "glosses": [
                                            "The first/original entity after which another entity is named without the entities being related. If the entities are related, then the original entity is the eponym of the subsequent entities."
                                        ],
