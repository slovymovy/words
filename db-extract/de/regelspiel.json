                "senses": [
                    {
                        "sense_id": "65d4b8f0-e6b7-3c58-92dc-f979ee7d57f9",
                        "entry_id": "92c93234-c56f-38ee-8587-14e0bfff469d",
                        "glosses": [
                            "Spielgeschehen, bei dem verbindliche Vorgaben hinsichtlich der Abläufe zu beachten sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "faa49509-bba2-4c26-997b-3729c93eca67",
                                "sense_id": "65d4b8f0-e6b7-3c58-92dc-f979ee7d57f9",
                                "text": "„In den selbstgeschaffenen Regelspielen jüngerer Kinder wird auf die Beachtung der Spielregel ebenso großer Wert gelegt wie in den traditionsgebundenen Spielen des Schulkindes.“"
                            },
                            {
                                "example_id": "86b16a53-9bbd-4d7d-a96d-f2b7893f6fab",
                                "sense_id": "65d4b8f0-e6b7-3c58-92dc-f979ee7d57f9",
                                "text": "„Das Regelspiel hat seinen eigentlichen Lebensbereich nicht im einzelnen spielenden Kinde, auch nicht in den wechselnden Spielgruppen, sondern in der die Generationen überdauernden Kindergemeinschaft.“"
                            },
                            {
                                "example_id": "b6586ef1-4106-420a-94f2-ff854a767da7",
                                "sense_id": "65d4b8f0-e6b7-3c58-92dc-f979ee7d57f9",
                                "text": "„Aus Amerika ist jetzt ein Buch zu uns gekommen, das dieser Auffassung gründlich widerspricht, das die Auffassung vertritt, für das soziale Lernen des Kindes könne es außerordentlich hilfreich und gewinnbringend sein, wenn es die dem Regelspiel innewohnenden Lernmöglichkeiten rechtzeitig erfährt, erlebt und erkennt.“"
                            },
                            {
                                "example_id": "36f67ef8-df31-43ff-a3ce-3cd4a47d1d7f",
                                "sense_id": "65d4b8f0-e6b7-3c58-92dc-f979ee7d57f9",
                                "text": "„In der Tat ist Crattys Buch auch der Versuch, die kognitiven, emotionalen und sozialen Dimensionen von Regelspielen insbesondere im Sport ans Licht zu rücken.“"
                            },
                            {
                                "example_id": "7d94d352-a282-4055-9f16-7b166b99bbbb",
                                "sense_id": "65d4b8f0-e6b7-3c58-92dc-f979ee7d57f9",
                                "text": "„Ab dem siebten Lebensjahr gewinnt das Regelspiel an Bedeutung und das Reproduzieren von Szenen des realen Lebens.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
