                "senses": [
                    {
                        "sense_id": "ea3c72b7-f305-319e-a1a9-16d7e16dd5eb",
                        "entry_id": "cf5848fc-71d3-3eee-9712-d4ab29c09a9d",
                        "glosses": [
                            "het niet bij iets of iemand in de buurt kunnen komen (zodat je er niet mee kunt communiceren)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8cf99cb-9d65-4499-9d09-70b44b7b3119",
                                "sense_id": "ea3c72b7-f305-319e-a1a9-16d7e16dd5eb",
                                "text": "ze ziet er niet gevaarlijk, arrogant of onbenaderbaar uit, maar vriendelijk, mooi op een uiterst verdachte manier"
                            },
                            {
                                "example_id": "a15a5882-7daf-4c83-87c6-75e5afa0968d",
                                "sense_id": "ea3c72b7-f305-319e-a1a9-16d7e16dd5eb",
                                "text": "In het CDA werd amper nagedacht over de opvolging van J. P.Balkenende;volgens de commissie werd hij tegen zijn zin weer lijsttrekker. Zijn campagneboodschap was onduidelijk. Verder was de sfeer in het kabinet met PvdA en ChristenUnie slecht en was het CDA niet herkenbaar, terwijl de partijtop onbenaderbaar was."
                            }
                        ]
                    }
