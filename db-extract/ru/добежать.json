                                            "o czasie: nadejść, nastać"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "4579affe-3690-34d2-ad37-aec0329bbb45",
                                        "entry_id": "1392cfca-41d9-3cd0-b2a7-5b27fd73f56a",
                                        "glosses": [
                                            "o głosie, dźwięku: dotrzeć z pewnej odległości"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5658697b-ac24-4436-b4c5-77302f61cdfd",
                                                "sense_id": "4579affe-3690-34d2-ad37-aec0329bbb45",
                                                "text": "W nocnej ciszy dobiegły mnie stłumione odgłosy awantury."
                                            }
                                        ],
                                        "sense_index_json": "\"1.3\""
                                    },
                                    {
                                        "sense_id": "3b6fc127-a4eb-3d0d-9cef-5d000af5d3c9",
                                        "entry_id": "1392cfca-41d9-3cd0-b2a7-5b27fd73f56a",
