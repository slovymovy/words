                ],
                "senses": [
                    {
                        "sense_id": "2e1d9ae4-92b8-3625-b70d-fd6ff7574c13",
                        "entry_id": "f97ab8a1-70fc-3bda-ab6b-00528507eb8f",
                        "glosses": [
                            "kleine Gruppe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44ca4b72-641e-4d60-aef1-9859a9535287",
                                "sense_id": "2e1d9ae4-92b8-3625-b70d-fd6ff7574c13",
                                "text": "„Während sie sprach, sah Anat sich nach Pierre um, der lächelnd von einem Grüppchen zum anderen ging.“"
                            },
                            {
                                "example_id": "43af4b90-e9de-4cbc-a56b-cf983294aa64",
                                "sense_id": "2e1d9ae4-92b8-3625-b70d-fd6ff7574c13",
                                "text": "„Die Hinauseilenden gingen in Grüppchen, in Gespräche vertieft oder ganz für sich in die Schrift.“"
                            },
                            {
                                "example_id": "4a5f5ab9-87d0-453e-8033-2ff4153469b3",
                                "sense_id": "2e1d9ae4-92b8-3625-b70d-fd6ff7574c13",
                                "text": "„Als der Tanz verebbt, teilt Freddy die Touristen in Grüppchen von je vier Personen ein.“"
                            },
                            {
                                "example_id": "4165b0dd-6a0c-4af6-8039-1e9b1e88ed85",
                                "sense_id": "2e1d9ae4-92b8-3625-b70d-fd6ff7574c13",
                                "text": "„Die übrigen Anwesenden plauderten, in kleine Grüppchen zerstreut.“"
                            },
                            {
                                "example_id": "dced19b9-d8fa-44ef-9418-05d3fd83930b",
                                "sense_id": "2e1d9ae4-92b8-3625-b70d-fd6ff7574c13",
                                "text": "„Zweitens, zusammen mit der Handvoll Rallye-Damen und einigen verschleierten Tunesierinnen waren wir Frauen ein verschwindend kleines Grüppchen an Bord.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
