{
    "word_family": [
        "renunciation",
        "renouncer"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "54ec6143-44cc-3121-8ab5-c29b757af390",
                    "sense_definition": "To formally give up or surrender a right, title, or possession.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "give_up",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The prince decided to <w>renounce</w> his claim to the throne to live a quiet life.",
                            "target_lang_translations": {
                                "zh": "王子决定<w>放弃</w>王位继承权，去过平静的生活。"
                            }
                        },
                        {
                            "text": "She chose to <w>renounce</w> her inheritance rather than deal with the legal complications.",
                            "target_lang_translations": {
                                "zh": "她选择<w>放弃</w>继承权，而不愿处理那些法律纠纷。"
                            }
                        }
                    ],
                    "synonyms": [
                        "disclaim"
                    ],
                    "common_phrases": [
                        "renounce a title"
                    ],
                    "target_lang_definitions": {
                        "zh": "正式放弃权利、头衔或财产。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "放弃",
                                "target_lang_sense_clarification": "指正式放弃权利或要求。"
                            },
                            {
                                "target_lang_word": "声明放弃",
                                "target_lang_sense_clarification": "指通过正式声明来放弃某项权利。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8b0f4caa-3659-316d-af3f-df33f104330f",
                    "sense_definition": "To abandon or discontinue a habit, belief, or way of life.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "give_up",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He decided to <w>renounce</w> his old habits and start living a healthier lifestyle.",
                            "target_lang_translations": {
                                "zh": "他决定<w>摒弃</w>旧习，开始过上更健康的生活。"
                            }
                        },
                        {
                            "text": "Many people <w>renounce</w> their former beliefs after experiencing a major life change.",
                            "target_lang_translations": {
                                "zh": "许多人在经历重大人生变故后会<w>摒弃</w>以前的信仰。"
                            }
                        }
                    ],
                    "synonyms": [
                        "abjure",
                        "forswear"
                    ],
                    "target_lang_definitions": {
                        "zh": "抛弃或停止某种习惯、信仰或生活方式。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "摒弃",
                                "target_lang_sense_clarification": "指坚决地抛弃某种习惯或观念。"
                            },
                            {
                                "target_lang_word": "戒除",
                                "target_lang_sense_clarification": "特指戒掉某种不良习惯。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a1b80cba-6f83-3ce8-bdab-bbf2096d4f31",
                    "sense_definition": "To reject or refuse to be associated with someone or something.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "reject",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The family felt forced to <w>renounce</w> their son after his criminal actions became public.",
                            "target_lang_translations": {
                                "zh": "在儿子的犯罪行为曝光后，家人感到被迫与他<w>断绝关系</w>。"
                            }
                        },
                        {
                            "text": "The politician had to <w>renounce</w> the extremist views of his former supporters.",
                            "target_lang_translations": {
                                "zh": "这位政客不得不公开<w>否定</w>其前支持者的极端观点。"
                            }
                        }
                    ],
                    "synonyms": [
                        "disown",
                        "repudiate",
                        "disavow"
                    ],
                    "target_lang_definitions": {
                        "zh": "拒绝或声明不再与某人或某事有联系。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "断绝关系",
                                "target_lang_sense_clarification": "指正式宣布与某人断绝往来。"
                            },
                            {
                                "target_lang_word": "否认",
                                "target_lang_sense_clarification": "指拒绝承认与某事物的关联。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5a8f4cc9-e848-30ed-9df5-81f79edd869c",
                    "sense_definition": "To fail to follow suit in a card game when one has no cards of the suit led.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "game_term",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you <w>renounce</w> during the game, you must be certain you are truly out of that suit.",
                            "target_lang_translations": {
                                "zh": "如果你在游戏中<w>垫牌</w>，必须确保你确实没有该花色的牌。"
                            }
                        },
                        {
                            "text": "The player was penalized for <w>renouncing</w> when they actually held a card of the required suit.",
                            "target_lang_translations": {
                                "zh": "该玩家因在手中有牌却未跟牌而受到处罚。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "在纸牌游戏中，当手中没有所出花色的牌时，未能按规则跟牌。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "垫牌",
                                "target_lang_sense_clarification": "手中无所出花色，改出其他花色的牌"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fcd25f35-cd0b-3237-b64e-e902ae4c3fb6",
                    "sense_definition": "The act of formally giving up or rejecting something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "give_up",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His public <w>renounce</w> of the organization surprised all of his colleagues.",
                            "target_lang_translations": {
                                "zh": "他公开<w>放弃</w>该组织的行为令所有同事感到惊讶。"
                            }
                        },
                        {
                            "text": "The document served as a formal <w>renounce</w> of all previous claims to the property.",
                            "target_lang_translations": {
                                "zh": "这份文件作为对该财产所有先前主张的正式<w>放弃</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This noun usage is rare and often replaced by 'renunciation'."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "正式放弃或拒绝某事的行为。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "放弃",
                                "target_lang_sense_clarification": "指放弃权利或主张的行为。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}