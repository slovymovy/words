                                                "sense_id": "f8d32444-99c9-36dc-aa69-6ad387782bb6",
                                                "text": "Dance, boogie wonderland / Sound fly through the night / I chase my vinyl dreams to boogie wonderland"
                                            },
                                            {
                                                "example_id": "9d97e711-f738-4922-88e8-5cec33be9498",
                                                "sense_id": "f8d32444-99c9-36dc-aa69-6ad387782bb6",
                                                "text": "After being gifted a turntable and investing in relatively inexpensive speakers, he talks about becoming reacquainted with the Impulse vinyl version of John Coltrane's celebrated jazz album, A Love Supreme."
                                            }
                                        ]
                                    }
                                ]
