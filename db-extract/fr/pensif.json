                        "sense_id": "320a34e5-ab86-392e-885e-e7c0c4dedd16",
                        "entry_id": "711a5359-1cf5-3a14-9a01-7bd716c308cb",
                        "glosses": [
                            "in seinen Gedanken versunken; nachdenklich"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "97bceef3-6525-361c-abd3-48be1e39dc45",
                        "entry_id": "711a5359-1cf5-3a14-9a01-7bd716c308cb",
                        "glosses": [
                            "von Nachdenklichkeit zeugend; nachdenklich"
                        ],
                        "tags": [
                            "figurative"
                        ],
