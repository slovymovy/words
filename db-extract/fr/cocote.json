                    {
                        "sense_id": "dd67ccfd-6545-3fef-98bf-3168ab27c4b6",
                        "entry_id": "07b4f4fc-6341-3c46-bfac-131631482303",
                        "glosses": [
                            "Ancienne variante orthographique de cocotte (poule…)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b3c6174-1c99-45d6-a844-8b0af963508d",
                                "sense_id": "dd67ccfd-6545-3fef-98bf-3168ab27c4b6",
                                "text": "Peut-être Armand en fera-t-il des cocotes pour ses régiments alignés sur mes tapis ou des vaisseaux pour les flottes qui voguent sur son bain."
                            },
                            {
                                "example_id": "5f47ba3d-25d6-4e84-b275-68ca34472b8f",
                                "sense_id": "dd67ccfd-6545-3fef-98bf-3168ab27c4b6",
                                "text": "Monsieur Guillaumet, continue Lolo, faites-moi des cocotes, ou je vous donne un grand coup de sabre dans le dos."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
