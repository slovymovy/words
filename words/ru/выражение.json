    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d38f3ba1-4037-328b-9d4e-bbf2e222f1ae",
                    "sense_definition": "Внешний вид лица, мимика, которые отражают внутреннее состояние, настроение или характер человека.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "У него было очень серьёзное <w>выражение</w> лица, когда он читал письмо.",
                            "target_lang_translations": {
                                "en": "He had a very serious <w>expression</w> on his face when he read the letter.",
                                "tr": "Mektubu okurken yüzünde çok ciddi bir <w>ifade</w> vardı.",
                                "zh": "他读信时，脸上的<w>表情</w>非常严肃。"
                            }
                        },
                        {
                            "text": "Только рот его сохранял иногда почти детское <w>выражение</w>.",
                            "target_lang_translations": {
                                "en": "Only his mouth sometimes kept an almost childish <w>expression</w>.",
                                "tr": "Sadece ağzı bazen neredeyse çocuksu bir <w>ifadeyi</w> koruyordu.",
                                "zh": "只有他的嘴有时还保留着一种近乎孩子气的<w>神色</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "выражение лица",
                        "выражение глаз",
                        "странное выражение",
                        "сменить выражение"
                    ],
                    "target_lang_definitions": {
                        "en": "The look on a person's face or mimicry that reflects their internal state, mood, or character.",
                        "tr": "Bir kişinin iç durumunu, ruh halini veya karakterini yansıtan yüz görünümü, mimik.",
                        "zh": "指人的面部表情或神态，反映其内心状态、情绪或性格。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "expression",
                                "target_lang_sense_clarification": "facial appearance"
                            },
                            {
                                "target_lang_word": "look",
                                "target_lang_sense_clarification": "facial appearance"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ifade",
                                "target_lang_sense_clarification": "yüz ifadesi, mimik"
                            },
                            {
                                "target_lang_word": "çehre",
                                "target_lang_sense_clarification": "yüzün aldığı şekil"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "表情",
                                "target_lang_sense_clarification": "面部神态"
                            },
                            {
                                "target_lang_word": "神色",
                                "target_lang_sense_clarification": "面部流露出的神情"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1db828a0-4c39-3b90-8dae-10daaddd8022",
                    "sense_definition": "Устойчивое сочетание слов, фраза или оборот речи, имеющие определённый смысл.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Это <w>выражение</w> стало крылатым и теперь используется повсюду.",
                            "target_lang_translations": {
                                "en": "This <w>expression</w> became a catchphrase and is now used everywhere.",
                                "tr": "Bu <w>ifade</w> dilden dile dolaşan bir söz haline geldi ve şimdi her yerde kullanılıyor.",
                                "zh": "这种<w>说法</w>已经广为流传，现在到处都在用。"
                            }
                        },
                        {
                            "text": "Отец попросил сына выбирать <w>выражения</w> при разговоре со старшими.",
                            "target_lang_translations": {
                                "en": "The father asked his son to choose his <w>words</w> carefully when speaking to elders.",
                                "tr": "Baba, oğlundan büyüklerle konuşurken <w>kelimelerini</w> seçmesini istedi.",
                                "zh": "父亲要求儿子在和长辈交谈时要<w>注意用词</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "крылатое выражение",
                        "устойчивое выражение",
                        "выбирать выражения",
                        "в выражениях"
                    ],
                    "target_lang_definitions": {
                        "en": "A fixed combination of words, a phrase, or a figure of speech that has a specific meaning.",
                        "tr": "Belirli bir anlamı olan kalıplaşmış söz grubu, deyim veya söz öbeği.",
                        "zh": "指具有特定含义的固定词组、短语或习语。"
                    },
                    "translations": {
