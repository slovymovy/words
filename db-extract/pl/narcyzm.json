                                    {
                                        "sense_id": "462b2218-e553-3f91-9415-144fa77bd64c",
                                        "entry_id": "c7dad9d2-da1a-3c24-90ea-5531aa337b41",
                                        "glosses": [
                                            "Complacimiento exagerado acerca de galanura de la imagen y de las capacidades de la propia persona."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef6d7490-7582-4b4a-8ef6-ea4e89a7f664",
                                                "sense_id": "462b2218-e553-3f91-9415-144fa77bd64c",
                                                "text": "El narcisismo o trastorno narcisista es un diagnóstico dentro de la clasificación de los trastornos de la personalidad. La rabia narcisista se produce cuando una persona con narcisismo percibe que está siendo atacada por otra."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b26d83af-97bf-4619-9759-17a8d3fc9134",
                        "source_entry_id": "705cfe75-381a-328d-9773-b1a6f0d961ec",
                        "source_sense_id": "1f682ee3-476c-36d5-ac6b-769d04eca30d",
                        "target_lang_word": "Narzissmus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Narzissmus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fcb7716c-b08e-3075-b7aa-d75438bc7e9d",
                                        "entry_id": "cf5c5370-1592-332a-b61d-c80c0b07c0f2",
                                        "glosses": [
                                            "übertriebene (krankhafte) Selbstliebe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a24827c-ad59-4477-9cad-943b844bca85",
                                                "sense_id": "fcb7716c-b08e-3075-b7aa-d75438bc7e9d",
                                                "text": "Narzissmus ist nicht nur Selbstliebe, denn er geht Hand in Hand mit mangelndem Mitgefühl für und fehlender Solidarität mit anderen."
                                            },
                                            {
                                                "example_id": "3c49c4f9-9af3-471d-8534-2f93bfc73d70",
                                                "sense_id": "fcb7716c-b08e-3075-b7aa-d75438bc7e9d",
                                                "text": "„Auffällig erschien dem Gutachter der Narzissmus des Angeklagten.“"
                                            },
                                            {
                                                "example_id": "c330a0bb-64ec-4a50-a087-37175d7db3a5",
                                                "sense_id": "fcb7716c-b08e-3075-b7aa-d75438bc7e9d",
                                                "text": "„Bis dahin war alles beherrscht gewesen von Narzissmus und Exhibitionismus, seltsam leblos, trotz der Kühnheit und der Zurschaustellung von Energie.“"
                                            },
                                            {
                                                "example_id": "12b10f27-6f53-4a94-b0df-550fed36644d",
                                                "sense_id": "fcb7716c-b08e-3075-b7aa-d75438bc7e9d",
                                                "text": "„Weiterhin zeichnet solche Personen ein hoher Grad an Verantwortungslosigkeit, Angst, Schuldgefühlen, Perfektionismus und Narzissmus aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
