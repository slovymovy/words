                    },
                    {
                        "form_id": "2cfe97db-68f9-4f45-a227-5f0ee9ccbd55",
                        "entry_id": "78cb9580-4105-3bd3-bf76-1f41f85d0d5c",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "запихну́в"
                    },
                    {
                        "form_id": "1d7eb518-ed52-4959-a5f9-38648e9641a2",
                        "entry_id": "78cb9580-4105-3bd3-bf76-1f41f85d0d5c",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "запихну́вши"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c1d0e7e7-b7a4-3cc9-b8fe-84204217f1e4",
                        "entry_id": "78cb9580-4105-3bd3-bf76-1f41f85d0d5c",
                        "glosses": [
                            "однокр. к запихивать"
                        ],
                        "tags": [
                            "semelefactive"
                        ],
                        "examples": [
                            {
                                "example_id": "6faefa94-93f2-4f41-a19b-8c6550e67044",
                                "sense_id": "c1d0e7e7-b7a4-3cc9-b8fe-84204217f1e4",
                                "text": "Сказавши это, она запихнула ей за спину подушку, на которой был вышит шерстью рыцарь таким образом, как их всегда вышивают по канве: нос вышел лестницею, а губы четвероугольником."
                            },
                            {
                                "example_id": "eb1ef537-3927-468a-8d0d-311f4dce494b",
                                "sense_id": "c1d0e7e7-b7a4-3cc9-b8fe-84204217f1e4",
                                "text": "Это я вам две таблетки аспирина запихнул."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "378b7858-9be6-4422-8b65-76f28664dc74",
                        "source_entry_id": "78cb9580-4105-3bd3-bf76-1f41f85d0d5c",
                        "source_sense_id": "c1d0e7e7-b7a4-3cc9-b8fe-84204217f1e4",
                        "target_lang_word": "fourrer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fourrer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1e1c159f-6d18-3b4b-a797-22905c6df38a",
                                        "entry_id": "9c6300f3-3b97-3d2b-84c0-906934325d4f",
                                        "glosses": [
                                            "Introduire, mettre dans."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1df9a86-638c-4ccc-b0a9-71e985eac9f7",
                                                "sense_id": "1e1c159f-6d18-3b4b-a797-22905c6df38a",
                                                "text": "Je fourre l’énorme pistolet dans mon froc et voilà le canon qui glisse dans mon slip. Je n'arrive pas, assis, à l’extirper."
                                            },
                                            {
                                                "example_id": "db57411c-0dea-4720-8ffc-4e5fbe919519",
                                                "sense_id": "1e1c159f-6d18-3b4b-a797-22905c6df38a",
                                                "text": "Soudain, le chat, Guillaume, surgissant de nulle part, qui bondit sur la table, qui vient lécher le sang du lapin. Combien de fois il lui a interdit, à cette satanée bestiole, de venir fourrer son sale museau dans la nourriture ?"
                                            },
                                            {
                                                "example_id": "ba792bb2-fd13-4a8e-8fb2-34baaa7720f2",
                                                "sense_id": "1e1c159f-6d18-3b4b-a797-22905c6df38a",
                                                "text": "— La belle affaire ! En vérité, n'êtes-vous pas un couple qui tribadez sous notre toit et jouez nuitamment de la fricarelle en vous fourrant le museau dans vos parties vergogneuses ?"
                                            },
                                            {
                                                "example_id": "02c12b70-70f6-4755-a7ff-0a172dee31d2",
                                                "sense_id": "1e1c159f-6d18-3b4b-a797-22905c6df38a",
                                                "text": "Fourrer quelque chose dans l’esprit, dans la tête de quelqu’un, Parvenir à lui faire comprendre quelque chose."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28926f7e-f577-3dd9-bb12-bedca68df7e2",
                                        "entry_id": "9c6300f3-3b97-3d2b-84c0-906934325d4f",
                                        "glosses": [
                                            "Cacher."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb8eb734-58f0-4943-8c06-c6efd6a343f6",
                                                "sense_id": "28926f7e-f577-3dd9-bb12-bedca68df7e2",
                                                "text": "Puis, cela fait, il acheva de se déshabiller, non sans inspecter les poches de ses autres vêtements, à seule fin de s'assurer qu'on n'y avait rien fourré à son insu."
                                            },
                                            {
                                                "example_id": "b1970ce7-d6d5-4ee2-8555-6de1005e5e05",
                                                "sense_id": "28926f7e-f577-3dd9-bb12-bedca68df7e2",
                                                "text": "C’est pas tout ça, mais où avez-vous fourré les victuailles qui étaient dans le kiosque ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a22b3140-db73-352a-ae9c-2cc359510bad",
                                        "entry_id": "9c6300f3-3b97-3d2b-84c0-906934325d4f",
                                        "glosses": [
                                            "Mettre en prison."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56107e97-40ec-47ff-81dd-b6b64a5c2d02",
                                                "sense_id": "a22b3140-db73-352a-ae9c-2cc359510bad",
                                                "text": "Muserolle, à part.– Je vais vous faire fourrer tous en police correctionnelle."
                                            },
                                            {
                                                "example_id": "b8d336ef-cde4-41ef-b6af-284a79369106",
                                                "sense_id": "a22b3140-db73-352a-ae9c-2cc359510bad",
                                                "text": "— Il n’y a pas de mais enfin, Monsieur… Et vous m’embêtez, c’est clair ça !… Et vous savez, rentrez vite à Senonches ou je vous fais fourrer au bloc…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec3d1336-f115-3b08-9d8b-af281e6d220c",
                                        "entry_id": "9c6300f3-3b97-3d2b-84c0-906934325d4f",
                                        "glosses": [
                                            "Donner avec excès et sans réflexion."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6d8eeca-2f70-4cf0-8ef7-846bce391852",
                                                "sense_id": "ec3d1336-f115-3b08-9d8b-af281e6d220c",
                                                "text": "Elle gâte cet enfant, elle lui fourre des sucreries à le rendre malade."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a527ff47-83a9-3ee1-ad29-92e3731067b9",
                                        "entry_id": "9c6300f3-3b97-3d2b-84c0-906934325d4f",
                                        "glosses": [
                                            "Insérer hors de propos."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "916cabf7-7ef0-4cf5-ab27-51b73a1a0f5e",
                                                "sense_id": "a527ff47-83a9-3ee1-ad29-92e3731067b9",
                                                "text": "Fourrer un tas de digressions dans un récit."
                                            },
                                            {
                                                "example_id": "701cb1c0-788d-4ba2-95c7-32d9197c2163",
                                                "sense_id": "a527ff47-83a9-3ee1-ad29-92e3731067b9",
                                                "text": "Il a fait un livre où il a fourré tout ce qu’il savait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15894c82-2268-3502-aa70-78fc0a57f510",
                                        "entry_id": "9c6300f3-3b97-3d2b-84c0-906934325d4f",
                                        "glosses": [
                                            "Garnir, doubler de fourrure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3780f82b-9643-42d3-bb12-abbf9d9fcd12",
                                                "sense_id": "15894c82-2268-3502-aa70-78fc0a57f510",
                                                "text": "Fourrer une robe de martre."
                                            },
                                            {
                                                "example_id": "458c26fe-bc74-4165-8f2f-4b0ca0707357",
                                                "sense_id": "15894c82-2268-3502-aa70-78fc0a57f510",
                                                "text": "Tu n’es pas un de ceux qui nourrissent la flamme, mais tu la protèges de tes pauvres mains, et j’ai la rage au cœur de les voir pleines d’engelures, parce que tu n’as jamais pu te payer ces gants de peau grise fourrée de lapin que tu regardes depuis trois ans dans la vitrine d’un magasin."
                                            },
                                            {
                                                "example_id": "0011fbee-1e6b-465f-ae57-0ec650359a5a",
                                                "sense_id": "15894c82-2268-3502-aa70-78fc0a57f510",
                                                "text": "Chat fourré se dit par dérision des magistrats revêtus de leur hermine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d95b75e-043b-3367-937c-d20fec6c0bb3",
                                        "entry_id": "9c6300f3-3b97-3d2b-84c0-906934325d4f",
                                        "glosses": [
                                            "Garnir l’intérieur d’un aliment avec un autre comestible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a49b8585-b82f-4c39-9804-51778010a70c",
                                                "sense_id": "0d95b75e-043b-3367-937c-d20fec6c0bb3",
                                                "text": "Un bonbon fourré."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0eafab47-fef6-3d2e-a7b4-cecebffd9d11",
                                        "entry_id": "9c6300f3-3b97-3d2b-84c0-906934325d4f",
                                        "glosses": [
                                            "Avoir une relation sexuelle dénuée de sentiment."
                                        ],
                                        "tags": [
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21454925-ff55-484c-95c9-4ea13960706d",
                                                "sense_id": "0eafab47-fef6-3d2e-a7b4-cecebffd9d11",
                                                "text": "On ne veut pas être méchants, ni vulgaires, mais elle a bien de la misère à se faire fourrer gratis."
                                            },
                                            {
                                                "example_id": "d015b75e-a724-47b5-b8d3-9ffaa07f1dec",
                                                "sense_id": "0eafab47-fef6-3d2e-a7b4-cecebffd9d11",
                                                "text": "… je me voyais déjà à fourrer la petite vorace ; elle doit sucer terriblement, la façon qu'elle absorbe tout ; bon. C'est râpé. Je suis presque tenté de courir la putain."
                                            },
                                            {
                                                "example_id": "9a7c7892-00eb-46ce-9385-4367b18cb862",
                                                "sense_id": "0eafab47-fef6-3d2e-a7b4-cecebffd9d11",
                                                "text": "— T’as fourré Kosmas tout l'hiver, tu fourres des drogués pis un paquet d'autres losers pis tout le monde dit que t'es une pute. T'aimes ça, les queues, fait que pourquoi pas ma queue?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9a2f01a-daf9-35eb-b452-364f98e69a6a",
                                        "entry_id": "9c6300f3-3b97-3d2b-84c0-906934325d4f",
                                        "glosses": [
                                            "Doubler ; mettre une doublure, en parlant d’un cahier, d’un livre."
                                        ],
                                        "tags": [
                                            "Suisse"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8f518119-d02b-3816-ad3c-82548323f8e8",
                                        "entry_id": "9c6300f3-3b97-3d2b-84c0-906934325d4f",
                                        "glosses": [
                                            "Arnaquer, tromper."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27723eae-18ca-4440-ab61-81eb12aefeb9",
                                                "sense_id": "8f518119-d02b-3816-ad3c-82548323f8e8",
                                                "text": "Je me suis fait fourrer par mon avocat."
                                            },
                                            {
                                                "example_id": "6a59d674-b4e2-4874-a038-444a64f79b77",
                                                "sense_id": "8f518119-d02b-3816-ad3c-82548323f8e8",
                                                "text": "« Je n’en donne à personne des pièces fausses, attendu que je ne m’en laisse fourrer par personne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2df72ca-1e1b-398c-a950-e4fc5c879f35",
                                        "entry_id": "9c6300f3-3b97-3d2b-84c0-906934325d4f",
                                        "glosses": [
                                            "Avoir des rapports sexuels sans sentiments."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4690fd77-bec0-4a04-b1a2-85a76fc41c73",
                                                "sense_id": "b2df72ca-1e1b-398c-a950-e4fc5c879f35",
                                                "text": "Heureux donc d'avoir la santé et de fourrer équitablement, M. Félicien emplâtrait la petite pute avec toute sa probité de queutard bonhomme lorsque la chose se produisit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
