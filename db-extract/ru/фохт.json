                "senses": [
                    {
                        "sense_id": "7b823685-0ae6-3fbb-897d-bcbf03318548",
                        "entry_id": "e8324450-6ff0-38ba-a68b-9a09e088566f",
                        "glosses": [
                            "истор. то же, что фогт"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68ec676e-2458-40eb-81fc-c1f5100cba9a",
                                "sense_id": "7b823685-0ae6-3fbb-897d-bcbf03318548",
                                "text": "Многосложное, разделённое правительство было слабо до крайности: пять епископов, магистр, орденский маршал, восемь командоров и восемь фохтов владели землёю; каждый имел свои города, волости, уставы и права; каждый думал о частных выгодах, мало заботясь о пользе общей."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0ad1295a-50f4-4541-a8b1-abb5fca6dca5",
                        "source_entry_id": "e8324450-6ff0-38ba-a68b-9a09e088566f",
                        "source_sense_id": "7b823685-0ae6-3fbb-897d-bcbf03318548",
                        "target_lang_word": "Voigt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Voigt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3cf88cf6-55b1-3fc1-8066-fca600eda992",
                                        "entry_id": "9486941d-9ee1-30b6-ae02-760d3ab428d6",
                                        "glosses": [
                                            "deutschsprachiger Nachname, Familienname, häufig im ostmitteldeutschen Gebiet auftretend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b6aa9fe-1864-4d84-90b3-874dd48ecb4b",
                                                "sense_id": "3cf88cf6-55b1-3fc1-8066-fca600eda992",
                                                "text": "Frau Voigt ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "61a92218-19f0-4f3b-bdb0-bbd9dd99ce45",
                                                "sense_id": "3cf88cf6-55b1-3fc1-8066-fca600eda992",
                                                "text": "Herr Voigt wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "0f12aadd-6da7-44de-acb6-4bd9966b9776",
                                                "sense_id": "3cf88cf6-55b1-3fc1-8066-fca600eda992",
                                                "text": "Die Voigts fliegen heute nach Mallorca."
                                            },
                                            {
                                                "example_id": "c0b0a097-3f3c-4025-9c33-68c20f3800cb",
                                                "sense_id": "3cf88cf6-55b1-3fc1-8066-fca600eda992",
                                                "text": "Der Voigt trägt nie die Pullover, die die Voigt ihm strickt."
                                            },
                                            {
                                                "example_id": "e584fa98-3851-45a8-a884-37187b28228d",
                                                "sense_id": "3cf88cf6-55b1-3fc1-8066-fca600eda992",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Voigt kommt, geht der Herr Voigt.“"
                                            },
                                            {
                                                "example_id": "3781a9da-8eaa-4d77-92d9-6e694b5f5c85",
                                                "sense_id": "3cf88cf6-55b1-3fc1-8066-fca600eda992",
                                                "text": "Voigt kommt und geht."
                                            },
                                            {
                                                "example_id": "1625cf60-3364-4be6-92da-30ded69a23eb",
                                                "sense_id": "3cf88cf6-55b1-3fc1-8066-fca600eda992",
                                                "text": "Voigts kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0c69f4a0-892e-48a2-826a-eadccb0b19d9",
                        "source_entry_id": "e8324450-6ff0-38ba-a68b-9a09e088566f",
                        "source_sense_id": "7b823685-0ae6-3fbb-897d-bcbf03318548",
                        "target_lang_word": "Vogt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vogt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "43b1777b-4e3b-3b04-8395-b2662c51ad87",
                                        "entry_id": "4bdd31f2-8ac9-3e48-9a5f-33b85ce941b0",
                                        "glosses": [
                                            "herrschaftlicher, meist adeliger Beamter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39e27f00-ab8f-42d5-920b-6245cfdee278",
                                                "sense_id": "43b1777b-4e3b-3b04-8395-b2662c51ad87",
                                                "text": "Es sind das die kaiserlichen Beamten: der Vogt, der Schultheiss und der Meier."
                                            },
                                            {
                                                "example_id": "7404b126-3573-4dab-9288-d11203acdc04",
                                                "sense_id": "43b1777b-4e3b-3b04-8395-b2662c51ad87",
                                                "text": "Der Ort selbst aber wurde wohl damals, wie andere, durch einen staufenschen Vogt regiert."
                                            },
                                            {
                                                "example_id": "c796c1f0-1da2-49a9-ab1e-fb728209e475",
                                                "sense_id": "43b1777b-4e3b-3b04-8395-b2662c51ad87",
                                                "text": "„Der Vogt (advocatus) war der Gehilfe oder Beistand des Herren, gegebenenfalls auch sein Vertreter.“"
                                            },
                                            {
                                                "example_id": "16e91eda-9c0a-4917-bbdc-9c11309efc1f",
                                                "sense_id": "43b1777b-4e3b-3b04-8395-b2662c51ad87",
                                                "text": "„Der Vogt hatte einen Boten zu seinen Dienern geschickt, daß sie der Tochter des Richters ihr Nachtlager bereiteten und sie bedienten, und sie kamen mit Braten und Wein, als der Richter Abschied von seiner Tochter nahm und zu seiner Thingbude und seinen Gästen zurückging.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e3d0d242-511b-382e-b5a9-1511716c55bc",
                                        "entry_id": "4bdd31f2-8ac9-3e48-9a5f-33b85ce941b0",
                                        "glosses": [
                                            "schweizerisch, veraltet: Vormund"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Vogt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "14100363-7b32-3d4e-85b9-fa27c40f7798",
                                        "entry_id": "7f05e974-f376-36d1-b213-a3aeb4fc1dfa",
                                        "glosses": [
                                            "deutscher Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "221a9a9d-3863-4235-9e52-d4ffa60a3a8a",
                                                "sense_id": "14100363-7b32-3d4e-85b9-fa27c40f7798",
                                                "text": "Die Titelpartie im neuen Parsifal soll in vier Jahren Tenor Klaus Florian Vogt singen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0ffc6484-fa0d-4167-96d4-ae39836bb5f1",
                        "source_entry_id": "e8324450-6ff0-38ba-a68b-9a09e088566f",
