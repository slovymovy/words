                        "tags": [],
                        "examples": [
                            {
                                "example_id": "565d2468-3e3d-45de-bfff-eb5740d35abb",
                                "sense_id": "323141f8-e0ea-370d-bdeb-4ba63071bd9c",
                                "text": "Atteinte des yeux ou des voies respiratoires (rhinite, asthme) : le latex peut se comporter comme un pneumallergène et être mis en suspension dans l’air avec les poudres contenues dans les gants de latex."
                            },
                            {
                                "example_id": "057c6b12-eec9-4cca-8d46-88f00d655318",
                                "sense_id": "323141f8-e0ea-370d-bdeb-4ba63071bd9c",
                                "text": "La taille des pneumallergènes mesurée selon leur diamètre aérodynamique est très importante car les particules se déposent au niveau des fosses nasales (grosses particules de plus de 10 à 20 μm), de l'arbre trachéo-bronchique ou des alvéoles (très petite particules de 1 μm)."
                            }
                        ]
                    }
