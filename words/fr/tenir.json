                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "gestion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ses parents ont su <w>tenir</w> un commerce dans le centre pendant quarante ans."
                        },
                        {
                            "text": "Le comptable doit soigneusement <w>tenir</w> les comptes de la petite entreprise."
                        }
                    ],
                    "common_phrases": [
                        "tenir un commerce",
                        "tenir la maison",
                        "tenir les comptes"
                    ]
                },
                {
                    "sense_id": "5fbe3b02-4b6a-32e0-9ce2-2e66be7c4149",
                    "sense_definition": "Avoir une attitude ou une conduite convenable.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "posture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les enfants doivent apprendre à bien se <w>tenir</w> à table chez des invités."
                        },
                        {
                            "text": "Pendant la cérémonie, tout le monde a su se <w>tenir</w> correctement."
                        }
                    ],
                    "synonyms": [
