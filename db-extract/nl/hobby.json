                        "entry_id": "e35dc38a-8a33-347c-9140-669440483bb7",
                        "glosses": [
                            "een liefhebberij of bezigheid ter ontspanning voor in de vrije tijd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26e096e1-6460-4c2f-92df-3bd29d4a9c34",
                                "sense_id": "5d70a9a0-9ab2-35a1-b0df-f430ad9a08cd",
                                "text": "Mijn hobby is het maken van websites en computerprogramma's."
