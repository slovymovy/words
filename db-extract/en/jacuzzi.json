                        "entry_id": "c48fe713-fd8d-3346-b4a1-50407f55636a",
                        "glosses": [
                            "A hot tub or whirlpool bath with underwater jets that massage the body."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "687660a0-d53b-4cc3-92fb-8857d85aed3f",
                                "sense_id": "49222663-06c2-3759-8d41-4505826e62e0",
                                "text": "The jacuzzi’s powerful jets created a swirling current that massaged his back."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "16a2ab62-e0de-4d9f-8204-c27feac202be",
                        "source_entry_id": "c48fe713-fd8d-3346-b4a1-50407f55636a",
                        "source_sense_id": "49222663-06c2-3759-8d41-4505826e62e0",
                        "source_sense_description": "hot tub or whirlpool bath with underwater jets that massage the body",
                        "target_lang_word": "vířivka",
                        "target_lang_code": "cs",
