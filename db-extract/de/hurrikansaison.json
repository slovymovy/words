                        "glosses": [
                            "Zeitraum von Mai/Juni bis November/Dezember, in dem die meisten Hurrikans entstehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d340f85e-8775-479c-a6f4-0869b638a26d",
                                "sense_id": "2d198c71-9388-3cd2-b854-3dec625cb124",
                                "text": "„Der Hurrikan erstaunt Meteorologen zunächst wegen seiner Ausmaße: 3000 Kilometer weit reichten seine Wolken, berichtet die Nasa. Er sei damit einer der größten Wirbelstürme, die je über dem Atlantik beobachtet worden wären - und das, obwohl die Hurrikansaison ihrem Ende entgegen geht.“"
                            }
                        ],
