                "senses": [
                    {
                        "sense_id": "4ed154b8-41a8-33ab-9492-1bbd096f111b",
                        "entry_id": "b7fa0273-7234-38e8-9c6e-60d7dd689d8b",
                        "glosses": [
                            "kleiner Hund; junger Hund"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6786ba16-9a17-409c-951c-03ef7656bace",
                                "sense_id": "4ed154b8-41a8-33ab-9492-1bbd096f111b",
                                "text": "„Manchmal ging sie am Morgen los und kam erst um Mitternacht zurück, mit einer streunenden Katze oder einem Hundchen, die sie auf der Straße aufgelesen hatte.“"
                            },
                            {
                                "example_id": "fc1a7fd6-bf59-4a9f-9bea-ca39834e3645",
                                "sense_id": "4ed154b8-41a8-33ab-9492-1bbd096f111b",
                                "text": "„Damit auch das Hundchen der Begeisterung von Herrchen folgt, ist der Feuer-Hydrant mit den entsprechenden Duftnoten imprägniert. Erfunden wurde dieses Kleinod in den USA.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
