                "senses": [
                    {
                        "sense_id": "4a4a120b-e815-3a93-8b9b-d94623be75af",
                        "entry_id": "04f1d25f-5556-35a4-8ad7-fa8848c430e5",
                        "glosses": [
                            "geheel van apparaten dat men nodig heeft voor het verzenden van radiografische signalen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3799f057-f649-4e68-a696-67502f58d1f1",
                                "sense_id": "4a4a120b-e815-3a93-8b9b-d94623be75af",
                                "text": "Volgens een woordvoerder van Enexis waren er problemen met de zendinstallatie die het signaal moest afgeven dat de verlichting aangaat. Dat signaal is niet, of niet goed, gegeven."
                            },
                            {
                                "example_id": "55330aa2-830b-4e87-8bb2-bcd3871d851e",
                                "sense_id": "4a4a120b-e815-3a93-8b9b-d94623be75af",
                                "text": "De onbemande en op afstand bestuurbare zendinstallatie van zendpiraat C.M.F. & Marantz werd tijdens een uitzending opgespoord door het Agentschap Telecom. Uitgerekend op de eerste vrijdag van de bouwvak, traditioneel een topdag voor illegale zenders in de regio. \"De onbekende eigenaar mag hem bij ons komen ophalen\", zegt politieman Withag."
                            },
                            {
                                "example_id": "e7fc6a22-ced9-4816-a442-2c35278ef602",
                                "sense_id": "4a4a120b-e815-3a93-8b9b-d94623be75af",
                                "text": "De mastodont van gewapend beton liep geen schrammetje op. Wel namen de Duitsers en passant de zendinstallatie mee, maar die werd teruggevonden en in 1947 herplaatst."
                            }
                        ]
                    }
