                "senses": [
                    {
                        "sense_id": "8c67f4f4-9bc7-39b6-8320-a82b0426b9c8",
                        "entry_id": "d87e6be7-a3ad-3805-9dff-e60914aba8c7",
                        "glosses": [
                            "Hirsch mit in sechzehn Enden auslaufendem Geweih beziehungsweise dieses selbst"
                        ],
                        "tags": [
                            "Jägersprache"
                        ],
                        "examples": [
                            {
                                "example_id": "48fcec76-ed04-4f4e-80d5-e82a9397fa87",
                                "sense_id": "8c67f4f4-9bc7-39b6-8320-a82b0426b9c8",
                                "text": "„Dann und wann rieselt auch der Schnee, ein Sechzehnender wird erlegt, und man trägt fellbesetzte Umhänge à la „Game of Thrones“.“"
                            },
                            {
                                "example_id": "8f0c0a2f-e6bd-4a67-8a21-71bffc7f2430",
                                "sense_id": "8c67f4f4-9bc7-39b6-8320-a82b0426b9c8",
                                "text": "„Und tatsächlich gibt es nahe der Millionenstadt Wien Besonderes zu erleben: einen majestätischen Sechzehnender in der Morgendämmerung, Grau- und Silberreiher, die minutenlang stillstehen und dann plötzlich mit einem gezielten Stoß einen Fisch erlegen, Froschbabys, die sich am Rande von Tümpeln tummeln und im satten Grün nur für die besonders Aufmerksamen sichtbar werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
