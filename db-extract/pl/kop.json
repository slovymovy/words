                        ],
                        "examples": [
                            {
                                "example_id": "e7e39549-183b-45aa-b26c-84a2eb932ffe",
                                "sense_id": "05caf943-5f29-37df-9dc5-f726b04ccdd2",
                                "text": "Po potańcówie w remizie Jacek sprzedał Wieśkowi kilka kopów za chamskie podwalanie się do Bronki."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
