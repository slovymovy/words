                        "entry_id": "c3e25026-7783-3343-b249-7dba2a7b8759",
                        "glosses": [
                            "Haarwasser, das aus Birkensaft besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f36466b9-9753-4100-93a7-6fe3ddf34739",
                                "sense_id": "86d38557-1e8e-3f9e-8c4b-2fc28f53a184",
                                "text": "Beim Friseur wurde mir Birkenwasser für mein Haar angeboten."
                            }
                        ],
                        "sense_index_json": "\"2\""
