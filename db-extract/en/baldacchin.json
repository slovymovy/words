                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c7ded4a-6002-43e9-8662-946613350424",
                                                "sense_id": "efe6b492-4b4c-31cf-ad26-0741a6c0724a",
                                                "text": "Następca szedł pod baldachimem, przed nim kapłan z puszką, w której paliły się kadzidła – wreszcie kilka młodych dziewcząt rzucających róże na ścieżkę, którą książę miał przechodzić."
                                            }
