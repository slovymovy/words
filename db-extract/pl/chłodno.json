                    {
                        "translation_id": "f9de6bf3-ba4d-4499-ad9e-ef7fb6567ea2",
                        "source_entry_id": "82aab7aa-c8b1-3359-bf58-d8bcda737792",
                        "source_sense_id": "46bce1cd-f98b-3d42-9ba2-9166f2e832c7",
                        "target_lang_word": "fraîchement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fraîchement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a1f0399f-001a-3fd4-bdda-0d0b6c0784e6",
                                        "entry_id": "9155dddd-53f1-361f-8f34-d05d6d9a5ffd",
                                        "glosses": [
                                            "Avec une fraîcheur agréable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f62add51-21f5-4974-89ad-a2c39fff04fd",
                                                "sense_id": "a1f0399f-001a-3fd4-bdda-0d0b6c0784e6",
                                                "text": "Marcher la nuit pour voyager fraîchement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1dc9fadc-4dd2-3b8c-a252-83a61a053525",
                                        "entry_id": "9155dddd-53f1-361f-8f34-d05d6d9a5ffd",
                                        "glosses": [
                                            "Au frais, dans un endroit frais."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a11769fb-799a-4703-9eaa-2f954f6e5ae1",
                                                "sense_id": "1dc9fadc-4dd2-3b8c-a252-83a61a053525",
                                                "text": "Être logé fraîchement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90d76527-7284-33ca-9224-bba0895b2b8b",
                                        "entry_id": "9155dddd-53f1-361f-8f34-d05d6d9a5ffd",
                                        "glosses": [
                                            "Récemment, depuis peu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70ae1fea-9efe-42fd-8b49-35ef122d84d5",
                                                "sense_id": "90d76527-7284-33ca-9224-bba0895b2b8b",
                                                "text": "Jean Donnard et Pierre Kerhuon embarquaient les filets dans la chaloupe, amarrée au quai, près de la cale qu’ensanglantaient des débris de poissons fraîchement éventrés."
                                            },
                                            {
                                                "example_id": "59e367fa-155c-43d2-b46f-ce4c00f5ddb7",
                                                "sense_id": "90d76527-7284-33ca-9224-bba0895b2b8b",
                                                "text": "Cet illustre personnage qui venait de perdre fraîchement deux de ses enfants."
                                            },
                                            {
                                                "example_id": "b42a946a-c1e0-47d4-9f92-4adbd6935003",
                                                "sense_id": "90d76527-7284-33ca-9224-bba0895b2b8b",
                                                "text": "Il tient quelque moineau qu’il a pris fraîchement."
                                            },
                                            {
                                                "example_id": "e7196411-36fc-4633-b67c-8b093b965297",
                                                "sense_id": "90d76527-7284-33ca-9224-bba0895b2b8b",
                                                "text": "Cet étranger extravague ; il vient sans doute tout fraîchement de l’autre monde."
                                            },
                                            {
                                                "example_id": "3816f09c-29ce-4c1d-8916-100c96a33e5d",
                                                "sense_id": "90d76527-7284-33ca-9224-bba0895b2b8b",
                                                "text": "Ce qui inspirait à l’un tant de hardiesse, et à l’autre tant de docilité, était la nouvelle qu’on avait reçue tout fraîchement de la grande victoire que les Romains avaient remportée sur Persée, roi de Macédoine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a10372a6-a609-3b40-b4c1-bf8bb3130f45",
                                        "entry_id": "9155dddd-53f1-361f-8f34-d05d6d9a5ffd",
                                        "glosses": [
                                            "Avec quelque froideur (c'est un adoucissement de froidement)."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0cd85264-5b46-496a-a7b1-f7d5a1de10f5",
                                                "sense_id": "a10372a6-a609-3b40-b4c1-bf8bb3130f45",
                                                "text": "Il aperçut seulement alors que madame Grandet le recevait très fraîchement ; il en fut amusé."
                                            },
                                            {
                                                "example_id": "e4b913e2-4d48-449d-8b76-079ef7a76b5c",
                                                "sense_id": "a10372a6-a609-3b40-b4c1-bf8bb3130f45",
                                                "text": "Mais un grand escogriffe en smoking et coiffé d'une casquette à carreaux sortait de la limousine et accourait vers les trois femmes qui l'accueillirent fraîchement."
                                            },
                                            {
                                                "example_id": "75abd60a-de2a-4189-9061-59791d222586",
                                                "sense_id": "a10372a6-a609-3b40-b4c1-bf8bb3130f45",
                                                "text": "Le compliment [de la duchesse de Lauzun] fut d’abord fraîchement reçu ; incontinent la marée monta, et voilà la duchesse du Maine aux reproches."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bb0ca672-f3bd-4737-a2bc-3ebfc7de5295",
                        "source_entry_id": "82aab7aa-c8b1-3359-bf58-d8bcda737792",
                        "source_sense_id": "46bce1cd-f98b-3d42-9ba2-9166f2e832c7",
