                "forms": [],
                "senses": [
                    {
                        "sense_id": "f4c06534-4e68-3965-9e49-516b00689ca6",
                        "entry_id": "851c7041-42a9-39f8-b6c2-7d455755f5f4",
                        "glosses": [
                            "erzgebirgisch, fränkisch, süddeutsch, oberdeutsch, drückt aus, dass man annimmt, dass die oder der Angesprochene das Gesagte noch nicht weiß"
                        ],
                        "tags": [
                            "umgangssprachlich,"
                        ],
                        "examples": [
                            {
                                "example_id": "30f60806-537c-466c-81bf-bec422801b30",
                                "sense_id": "f4c06534-4e68-3965-9e49-516b00689ca6",
                                "text": "Des kann man fei sagen.",
                                "translation": "Das kann man übrigens sagen."
                            },
                            {
                                "example_id": "f6013b35-5b42-4168-a197-d9d598188ea7",
                                "sense_id": "f4c06534-4e68-3965-9e49-516b00689ca6",
                                "text": "Des tut fei weh.",
                                "translation": "Hör mal, das tut weh! / Das tut übrigens weh. / Zu deiner Information: das schmerzt! / Damit du es weißt: Das tut (übrigens) weh. / Bitte richte deine Aufmerksamkeit darauf, dass das schmerzt."
                            },
                            {
                                "example_id": "416b5828-322b-4843-a87c-e1ec2c9679fb",
                                "sense_id": "f4c06534-4e68-3965-9e49-516b00689ca6",
                                "text": "Fränkisch: Des wor fei schee!",
                                "translation": "Hör', das war schön! / Das war übrigens schön (im Gegensatz zu dem, was du glaub(te)st)."
                            },
                            {
                                "example_id": "97299b17-3070-498c-9846-24d4e9e3bfff",
                                "sense_id": "f4c06534-4e68-3965-9e49-516b00689ca6",
                                "text": "Schwäbisch: Dia hends fei ned!",
                                "translation": "Hör mal / Übrigens, die haben das nicht!!!"
                            },
                            {
                                "example_id": "4aef614c-79f0-4969-8b88-a2b1c2997023",
                                "sense_id": "f4c06534-4e68-3965-9e49-516b00689ca6",
                                "text": "Vogtländisch: Des is fei ned schei!",
                                "translation": "Das ist aber nicht schön!"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "698ee0ea-e631-3a3d-a32e-6800c517df56",
                        "entry_id": "851c7041-42a9-39f8-b6c2-7d455755f5f4",
                        "glosses": [
                            "erzgebirgisch, fränkisch, süddeutsch, oberdeutsch, wohl"
