                "translations": [
                    {
                        "translation_id": "2d1ec2a9-e91f-4d2f-9e4f-0729b71fc9d1",
                        "source_entry_id": "717bbc2f-5986-3b7f-a8bc-18d443a61cae",
                        "source_sense_description": "tramp's or itinerant's bundle",
                        "target_lang_word": "knapzak",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "knapzak",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "13be2d70-8ef2-3c4b-9563-d29b39175a1d",
                                        "entry_id": "5e0d0a07-15c7-337a-ac8d-baacc879f9ab",
                                        "glosses": [
                                            "een zak waarin men proviand voor een tocht kan bewaren en meenemen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1249918-450d-47e0-92a3-0e3cc8deb0ba",
                                                "sense_id": "13be2d70-8ef2-3c4b-9563-d29b39175a1d",
                                                "text": "De Losserse parochie Maria Geboorte kwam met een beeld van Maria en Overdinkel met dat van Gerardus Majella. Glanerbrug droeg een rozenkrans aan en Lonneker een knapzak aan een stok, die de pelgrimstas van Jacobus symboliseerde. De Martinus uit Losser bracht een mantel mee, die de Heilige volgens de overlevering in tweeën scheurde en deelde met een bedelaar."
                                            },
                                            {
                                                "example_id": "d31907ba-bd33-40e7-9344-5b23095da9da",
                                                "sense_id": "13be2d70-8ef2-3c4b-9563-d29b39175a1d",
                                                "text": "Als puber was ik enorm geboeid door het FKK-gebeuren en gebruikte ik mijn Tienertoerkaart hoofdzakelijk om naakstranden te bezoeken, met de bammetjes van mama en de fles Exota in de knapzak."
                                            },
                                            {
                                                "example_id": "d8e4d948-9be4-4750-a31e-3fee93f5275d",
                                                "sense_id": "13be2d70-8ef2-3c4b-9563-d29b39175a1d",
                                                "text": "De gebroeders Josiah en Dusty Bindle maken en verkopen ‘bindles’. Een bindle herkennen we als een knapzak: een doek die wat bagage bij elkaar geknoopt houdt en over de schouder aan een stok wordt gedragen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a5e2077b-8b26-48e1-bb7a-dd51bb50bc5a",
                        "source_entry_id": "717bbc2f-5986-3b7f-a8bc-18d443a61cae",
                        "source_sense_description": "tramp's or itinerant's bundle",
                        "target_lang_word": "balluchon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "balluchon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e53d6689-0f81-312c-a222-52e91ec65c99",
                                        "entry_id": "446b8906-e036-3f4f-9d8c-7ceeb42b325b",
                                        "glosses": [
                                            "Petit paquet de hardes que l’on porte le plus souvent à la main."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60c0f9f4-3ea7-4aa2-8284-538a67840a3d",
                                                "sense_id": "e53d6689-0f81-312c-a222-52e91ec65c99",
                                                "text": "Il me fit la courte échelle et je pus atteindre la corde qui devait révéler mon départ et qui assura mon retour. Puis il me fit passer mon balluchon."
                                            },
                                            {
                                                "example_id": "1358b078-a85d-42a5-9da0-9972f02c486e",
                                                "sense_id": "e53d6689-0f81-312c-a222-52e91ec65c99",
                                                "text": "Le clochard, qui tenait son balluchon à la main, le posa avec force par terre."
                                            },
                                            {
                                                "example_id": "2c12fe65-bd2e-4094-8956-f11784fae532",
                                                "sense_id": "e53d6689-0f81-312c-a222-52e91ec65c99",
                                                "text": "On me prépara mon balluchon et le soir même je m’en allai avec mon oncle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05c6a254-502e-35db-8a14-cc416767d753",
                                        "entry_id": "446b8906-e036-3f4f-9d8c-7ceeb42b325b",
                                        "glosses": [
                                            "Équipement de voyage composé d'un sac (souvent en toile) attaché au bout d'un bâton, le bâton étant posé sur l'épaule et le sac pend à l'arrière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43f7e521-98e7-40d9-a543-59bd3d135d90",
                                                "sense_id": "05c6a254-502e-35db-8a14-cc416767d753",
                                                "text": "Antoine avait eu de la chance, il avait tiré un bon numéro. Avec le 76, en revanche, Pierrot allait devoir faire son balluchon et rejoindre le plus rapidement possible son régiment, faute de quoi il encourait le peloton pour fait de désertion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce8b8c09-52e4-3693-85aa-4658752b204a",
                                        "entry_id": "446b8906-e036-3f4f-9d8c-7ceeb42b325b",
                                        "glosses": [
                                            "Tout ce qui rappelle cette forme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "660c32a8-f7da-40ec-addc-0a2245a8dabc",
                                                "sense_id": "ce8b8c09-52e4-3693-85aa-4658752b204a",
                                                "text": "Déposez la semoule dans un torchon propre, formez un petit balluchon et pressez pour extraire l’eau."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c5113657-71df-4398-ad6a-fa882623a668",
                        "source_entry_id": "717bbc2f-5986-3b7f-a8bc-18d443a61cae",
                        "source_sense_description": "tramp's or itinerant's bundle",
                        "target_lang_word": "Bündel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bündel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3b41ba17-f2b8-3839-b889-714b6078aa76",
                                        "entry_id": "7d5dfa4e-52a4-37b6-947f-9ad9920a90ec",
                                        "glosses": [
                                            "etwas Zusammengebundenes oder Zusammengefasstes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1034ab4-e6d7-4446-9550-64c6e8c4f814",
                                                "sense_id": "3b41ba17-f2b8-3839-b889-714b6078aa76",
                                                "text": "Er nahm sein Bündel und zog davon."
                                            },
                                            {
                                                "example_id": "9ec041ca-c2b7-49d5-82bb-e9bd998acc6c",
                                                "sense_id": "3b41ba17-f2b8-3839-b889-714b6078aa76",
                                                "text": "Aus dem Koffer nahm sie ein Bündel Banknoten."
                                            },
                                            {
                                                "example_id": "19918ac2-9736-4694-84d4-2f65970682bb",
                                                "sense_id": "3b41ba17-f2b8-3839-b889-714b6078aa76",
                                                "text": "„Im Hauptpostamt händigte man ihr ein Bündel Briefe von Lorenz aus.“"
                                            },
                                            {
                                                "example_id": "b068fb2a-45ff-441c-9511-4bc077321abf",
                                                "sense_id": "3b41ba17-f2b8-3839-b889-714b6078aa76",
                                                "text": "„Die teilweise über einen Zentner schweren Bündel sind so riesig, dass die von der Last gebeugten Frauen oft fast die ganze Straße einnehmen.“"
                                            },
                                            {
                                                "example_id": "90eaf9f7-c52e-43b2-9f7e-b83c6831c2ee",
                                                "sense_id": "3b41ba17-f2b8-3839-b889-714b6078aa76",
                                                "text": "„Als ich glaubte, genug Kleidung gesammelt zu haben, schnürte ich alles zu einem Bündel zusammen und trug es zum Schoner.“"
                                            },
                                            {
                                                "example_id": "ee7bd598-2efd-46d0-8696-1d5da2b48416",
                                                "sense_id": "3b41ba17-f2b8-3839-b889-714b6078aa76",
                                                "text": "„Lichatschow stand auf, wühlte in einem Bündel herum, und bald darauf hörte Petja das kriegerische Geräusch von Stahl und Schleifstein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
