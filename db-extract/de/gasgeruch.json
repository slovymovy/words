                ],
                "senses": [
                    {
                        "sense_id": "db98c93b-c42d-3b04-8f6f-31dda75eb871",
                        "entry_id": "affe5e6d-090f-3b6b-8366-608b9a7f0669",
                        "glosses": [
                            "geruchliche Wahrnehmung von Gas in der Luft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "476e7c89-86f5-4955-b87a-a3a772b128fa",
                                "sense_id": "db98c93b-c42d-3b04-8f6f-31dda75eb871",
                                "text": "Verschiedene Gase haben keinen wahrnehmbaren Gasgeruch und töten, ohne Voranmeldung oder geruchlicher Wahrnehmung Mensch und Tier!"
                            },
                            {
                                "example_id": "a5f992db-1474-42a7-9f90-560654707afb",
                                "sense_id": "db98c93b-c42d-3b04-8f6f-31dda75eb871",
                                "text": "Das im Haushalt verwendete Stadtgas wird geruchlich mit einem Geruchsstoff versehen, damit undichte Stellen im Rohrnetz als Geruchsgas zur Warnung wahrgenommen und sofort gemeldet werden."
                            },
                            {
                                "example_id": "256b8362-bb7e-4be1-960e-7c33c117c359",
                                "sense_id": "db98c93b-c42d-3b04-8f6f-31dda75eb871",
                                "text": "„Trotzdem war der Gasgeruch noch recht stark.“"
                            },
                            {
                                "example_id": "b71396c7-681c-448e-8874-d55f1438890f",
                                "sense_id": "db98c93b-c42d-3b04-8f6f-31dda75eb871",
                                "text": "„Die öffentliche Kurzrufnummer 128 dient zur Meldung von Gasgeruch, Gasaustritt und jeder Form von Gasgebrechen, wenn dadurch eine akute oder unmittelbar drohende Gefahr für Leben, körperliche Unversehrtheit, Umwelt oder Vermögen besteht.“"
                            },
                            {
                                "example_id": "d7711d28-af48-453d-b731-a34405e56f0b",
                                "sense_id": "db98c93b-c42d-3b04-8f6f-31dda75eb871",
                                "text": "„Fündig wurden die Kollegen in Wentorf: In der Hauptstraße und in der Hamburger Landstraße nahmen ihre Suchgeräte einen leichten Gasgeruch wahr. Um die Lecks genau zu lokalisieren, legte man die Gasrohre nach und nach frei.“"
                            },
                            {
                                "example_id": "5e78b112-7b2e-4c1e-8317-30a29dcaee20",
                                "sense_id": "db98c93b-c42d-3b04-8f6f-31dda75eb871",
                                "text": "„Zuweilen zog der süßliche Schwaden eines faden Gasgeruchs an ihm vorüber, so daß sich eine zunehmende Betäubung auf seine Sinne legte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
