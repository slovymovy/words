                        "target_lang_word": "faszinierend",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "faszinierend",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bdbbb435-1f7f-3831-8c7a-13f0628ce457",
                                        "entry_id": "a01d3bd7-a2a6-3670-ba52-002ead29e37a",
                                        "glosses": [
                                            "Faszination ausübend; anziehend, begeisternd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4341862-e4e0-4f44-887a-e7f45eed299a",
                                                "sense_id": "bdbbb435-1f7f-3831-8c7a-13f0628ce457",
                                                "text": "„Jedes deutsche Auto ist ein Importwagen - nur nicht in Deutschland. Anders formuliert sind Modelle mit ausländischem Pass immer eine Geschichte wert - oder gleich ganz viele, wie in unserem Themenschwerpunkt über faszinierende Autos aus aller Welt.“"
                                            },
                                            {
                                                "example_id": "1af618df-fcc9-4d2a-b61e-9de9459333d3",
                                                "sense_id": "bdbbb435-1f7f-3831-8c7a-13f0628ce457",
                                                "text": "Was für eine faszinierende Geschichte, ich würde gerne mehr darüber hören."
                                            },
                                            {
                                                "example_id": "a89e2e47-3bc6-4268-adc2-cbe82f781609",
                                                "sense_id": "bdbbb435-1f7f-3831-8c7a-13f0628ce457",
                                                "text": "Die Loren war zu ihrer Zeit eine der faszinierendsten Frauen Europas."
                                            },
                                            {
                                                "example_id": "ebdc4c4c-290f-4c90-832d-c27d264eeb02",
                                                "sense_id": "bdbbb435-1f7f-3831-8c7a-13f0628ce457",
                                                "text": "Am faszinierendsten an dieser ganzen Affäre finde ich noch, dass er mit seinen dummen Ausreden durchgekommen ist."
                                            },
                                            {
                                                "example_id": "de5efd4e-4447-446b-8727-4bd81de5c2de",
                                                "sense_id": "bdbbb435-1f7f-3831-8c7a-13f0628ce457",
                                                "text": "„Solarzellen sind eine faszinierende Technik. Kein Lärm, keine Abgase, nicht einmal bewegliche Teile, die verschleißen können und gewartet werden müssen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
