                                                "sense_id": "9782d7b1-3b2e-3c7d-95c3-c26e1b74d5a6",
                                                "text": "The Energy Research Institute under the Industrial Technological Research Institute has decided to build the nation’s first solar energy plant at Chutung Township in Hsinchu county.",
                                                "translation": "Free China Weekly",
                                                "english": "Free China Weekly"
                                            },
                                            {
                                                "example_id": "a6630cc3-00cc-4888-aa12-e5538dea33b5",
                                                "sense_id": "9782d7b1-3b2e-3c7d-95c3-c26e1b74d5a6",
                                                "text": "Oxygen levels on Earth skyrocketed 2.4 billion years ago, when cyanobacteria evolved photosynthesis: the ability to convert water and carbon dioxide into carbohydrates and waste oxygen using solar energy."
                                            }
                                        ]
                                    }
                                ]
