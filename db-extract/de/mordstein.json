                "senses": [
                    {
                        "sense_id": "4977a575-2fe9-348c-a29b-68d87ccdfdd6",
                        "entry_id": "60bc3586-05e2-3a48-b0c7-cf8757f8bc39",
                        "glosses": [
                            "gehauener Stein, der an einen feigen Mord erinnert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c47f2645-5fd5-438e-8f22-e6ee54714f0a",
                                "sense_id": "4977a575-2fe9-348c-a29b-68d87ccdfdd6",
                                "text": "„Denn die mordenden Bauernbrüder mussten nicht ins Gefängnis, sondern einen Mordstein aufstellen.“"
                            },
                            {
                                "example_id": "3fcee684-ae8a-4f12-875d-2d46087302df",
                                "sense_id": "4977a575-2fe9-348c-a29b-68d87ccdfdd6",
                                "text": "„Den Nachkommen der Brüder war die Geschichte des Mordsteins vermutlich so peinlich, dass sie den Stein heimlich in einer Graft (Wassergraben) versenkten, wo er später wieder auftauchte.“"
                            },
                            {
                                "example_id": "4d33e64f-8dd6-46a4-9a52-e2224f9264a2",
                                "sense_id": "4977a575-2fe9-348c-a29b-68d87ccdfdd6",
                                "text": "„Der Verfasser hat als junger Lehrer in Badersleben auf dem dem Dorfe südlich vorgelagerten Kuhberge den sogenannten Mordstein mit der Inschrift vorgefunden: \"Hier ist Fritz Seiler aus Stiege im Harz von Heinz Rabe am 6. Oktober 1826 ermordet worden\".“"
                            },
                            {
                                "example_id": "a6a5d568-26fc-4850-a28b-d722befbbd4d",
                                "sense_id": "4977a575-2fe9-348c-a29b-68d87ccdfdd6",
                                "text": "„Man folgt ihm wenige Meter, bis man auf der linken Seite ein Hinweisschild zu den so genannten Mordsteinen erblickt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
