                        "glosses": [
                            "Genre de bactéries majeur au sein du groupe des bacilles Gram-négatifs anaérobies, et l’un des genres principaux de l’entérotype (genre Bacteroides spp.)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75dfdf7e-eab8-4d6f-85f8-49da3e12f4fd",
                                "sense_id": "38953b5a-0351-35e2-a187-b2cdfae5a9e4",
                                "text": "Les bactéroïdes, les bifidobactéries et les clostridies produisent des hydrolases capables de déconjuguer les sels biliaires et de produire des sels biliaires libres."
                            },
                            {
                                "example_id": "b2f9c40b-bf4d-449e-b369-4e299dd1d485",
                                "sense_id": "38953b5a-0351-35e2-a187-b2cdfae5a9e4",
                                "text": "Les bactéroides comportent un vaste groupe de bactéries, habituellement gramnégatives, ne formant pas de spores; ils sont anaérobes stricts et sont très pléomorphiques."
                            }
                        ]
                    }
