                    "semantic_group_id": "ancien : personnes d'expérience ou d'ancienneté",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les <w>anciens</w> du village racontent de belles histoires."
                        },
                        {
                            "text": "Il faut respecter les <w>anciens</w> et écouter leurs conseils."
