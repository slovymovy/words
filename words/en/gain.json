                            "target_lang_translations": {
                                "ru": "Я встретил семью с фамилией <w>Гейн</w>.",
                                "tr": "Soyadı <w>Gain</w> olan bir aileyle tanıştım."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "tr": "Bir soyadı."
                    },
                    "translations": {
                        "ru": [
