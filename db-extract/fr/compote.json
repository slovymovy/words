        "fr-extract.jsonl": [
            {
                "entry_id": "88e51a47-0195-3a43-99b8-9eeb24b18dae",
                "word": "compote",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7eaa326f-5d23-423f-ad10-2b0ed114ebe2",
                        "entry_id": "88e51a47-0195-3a43-99b8-9eeb24b18dae",
                        "tags": [
                            "plural"
                        ],
                        "form": "compotes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6321d4f5-187c-39c3-bf95-ea691f96d1a1",
                        "entry_id": "88e51a47-0195-3a43-99b8-9eeb24b18dae",
                        "glosses": [
                            "Entremets sucré fait avec des fruits entiers ou en quartiers et qui est moins cuit que les confitures faites pour être gardées."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e041acd-0a4f-41e1-8723-639d42268216",
                                "sense_id": "6321d4f5-187c-39c3-bf95-ea691f96d1a1",
                                "text": "Une compote de poires, de pommes, d’abricots, de cerises, etc."
                            },
                            {
                                "example_id": "49a0b727-837e-48dc-b421-cf536af68482",
                                "sense_id": "6321d4f5-187c-39c3-bf95-ea691f96d1a1",
                                "text": "Une compote bien faite."
                            },
                            {
                                "example_id": "989711e5-1b81-4e17-b52a-7a6b31ffb801",
                                "sense_id": "6321d4f5-187c-39c3-bf95-ea691f96d1a1",
                                "text": "Vous avez bien vu les vieux ; ils pleurent quand ils n’aiment pas la compote d’abricots."
                            }
                        ]
                    },
                    {
                        "sense_id": "f77630c6-4c9c-30dc-9cdd-7588d6852744",
                        "entry_id": "88e51a47-0195-3a43-99b8-9eeb24b18dae",
                        "glosses": [
                            "Manière d’accommoder la viande en ragout. Viande trop cuite."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "152beaca-c8f4-4e84-891f-8d9443aa2f1a",
                                "sense_id": "f77630c6-4c9c-30dc-9cdd-7588d6852744",
                                "text": "Mettre des pigeonneaux en compote."
                            },
                            {
                                "example_id": "71036e99-5108-46e9-9026-06f5c101ef51",
                                "sense_id": "f77630c6-4c9c-30dc-9cdd-7588d6852744",
                                "text": "Viande en compote"
                            }
                        ]
                    },
                    {
                        "sense_id": "e2707b94-ca63-38e7-b334-6558f0809c82",
                        "entry_id": "88e51a47-0195-3a43-99b8-9eeb24b18dae",
                        "glosses": [
                            "Composition."
                        ],
                        "tags": [
                            "dated",
                            "slang"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5b04dbd9-be20-40c0-aef8-e4b64104f882",
                        "source_entry_id": "88e51a47-0195-3a43-99b8-9eeb24b18dae",
                        "source_sense_description": "fruits cuits au sirop léger",
                        "target_lang_word": "Kompott",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kompott",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7692f184-ec15-3f1e-befe-b4a258f9f5a9",
                                        "entry_id": "0459ea96-808d-3cfd-9f18-a82d95fd803d",
                                        "glosses": [
                                            "eingemachtes oder (mit Zucker) gekochtes Obst, das als Beilage oder Nachtisch serviert wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad8414d8-6978-435a-a108-7ebb13e283b1",
                                                "sense_id": "7692f184-ec15-3f1e-befe-b4a258f9f5a9",
                                                "text": "Die Äpfel sind schon etwas verschrumpelt, ich werde ein Kompott aus ihnen machen."
                                            },
                                            {
                                                "example_id": "02bcd388-4433-47b7-ad4d-08df8cb42261",
                                                "sense_id": "7692f184-ec15-3f1e-befe-b4a258f9f5a9",
                                                "text": "Heute essen wir einen opulenten Nachtisch: Kaiserschmarren mit einem Kompott aus Zwetschgen und Mirabellen."
                                            },
                                            {
                                                "example_id": "4f783b95-bb1e-4c88-a36a-9fcec24388c5",
                                                "sense_id": "7692f184-ec15-3f1e-befe-b4a258f9f5a9",
                                                "text": "„Nachdem das Kompott verzehrt war, wurden Käse und Salzgebäck herumgereicht, währenddessen die vier unauffällig und verzweifelt versuchten, neuen Gesprächsstoff zu finden.“"
                                            },
                                            {
                                                "example_id": "1ec631fb-8d20-43ab-9f99-eb9c8255f84f",
                                                "sense_id": "7692f184-ec15-3f1e-befe-b4a258f9f5a9",
                                                "text": "„Graeber schüttete das Fleisch und das Kompott in zwei Schüsseln, die Frau Witte ihnen gegeben hatte.“"
                                            },
                                            {
                                                "example_id": "59c23c83-31f2-4044-b553-2232774d983d",
                                                "sense_id": "7692f184-ec15-3f1e-befe-b4a258f9f5a9",
                                                "text": "„Adrienne hatte bereits wie eine Weltmeiserin für die Eröffnungsparty gekocht und gebacken; Sylvia hatte keine Ahnung, wer all diese Mousses und Kräcker und Kompotte und Pasteten essen sollte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
