                        "examples": [
                            {
                                "example_id": "58c2375e-47b9-4b59-9a1c-1206f8e418ac",
                                "sense_id": "410de32b-6378-3ca8-9cf1-6c6f37825cc2",
                                "text": "Von den zwei Sigma ward eines weggelassen, wie in der vorigen Nummer."
                            },
                            {
                                "example_id": "b68468a6-2bae-4851-ab95-e515f28228da",
                                "sense_id": "410de32b-6378-3ca8-9cf1-6c6f37825cc2",
                                "text": "Aus zwei Sigma zwei Tau, z. B. πραττειν – πρασσειν zu sprechen, ahmt der Deütsche auch dem Griechen nach, z. B. Splitter und Splisser."
                            }
                        ]
                    }
