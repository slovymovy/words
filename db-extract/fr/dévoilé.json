                "senses": [
                    {
                        "sense_id": "a241bd14-f389-3e8f-94cd-d0db80303843",
                        "entry_id": "523428b9-4824-3dc0-bcfd-c04f8c6655ff",
                        "glosses": [
                            "Qui ne porte plus de voile."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0eeedb9f-a2f8-491d-8382-f1db0bebfb0f",
                                "sense_id": "a241bd14-f389-3e8f-94cd-d0db80303843",
                                "text": "— Je me suis échappé de l’hôpital, s’écria Ouroz, parce qu’on m’y avait livré aux soins d’une femme étrangère, infidèle, dévoilée, qui avait droit de voir et toucher ma nudité."
                            },
                            {
                                "example_id": "1bb9980e-daf1-4b99-ba3b-64ea5f96ce33",
                                "sense_id": "a241bd14-f389-3e8f-94cd-d0db80303843",
                                "text": "Quelques têtes dévoilées, de rares jambes et bras nus, pas de seins… Gelara, vendu 100 afghanis (1,30 $) dans la rue, s’abstient de provoquer."
                            },
                            {
                                "example_id": "283ae039-0812-460d-9e3f-a68db6de99da",
                                "sense_id": "a241bd14-f389-3e8f-94cd-d0db80303843",
                                "text": "Un policier iranien apostrophe une jeune femme qui marche dévoilée dans la rue : \"Si ton père était un homme honorable, il ne t’aurait pas permis de marcher nue dans la rue\""
                            }
                        ]
                    }
                ],
