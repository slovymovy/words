                    },
                    {
                        "translation_id": "3e3db287-d3d8-4304-bd6c-85c19c645582",
                        "source_entry_id": "8dd59eee-0073-3e7e-8a91-cf5eb1efedc0",
                        "source_sense_description": "punish by dragging under the keel of a ship",
                        "target_lang_word": "kielholen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kielholen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4a6e304d-9408-3ea2-a3a3-fc8db91cb193",
                                        "entry_id": "9ecb8ec6-e7cd-31b0-ade3-77e41c3aaf34",
                                        "glosses": [
                                            "eine Person an einem Tau unter einem Segelschiff von der linken/Backbord- zur rechten/Steuerbord- Seite (oder andersrum oder vom Bug zum Heck) hindurchziehen"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea16645e-8013-4c0a-b582-616e0543cc7d",
                                                "sense_id": "4a6e304d-9408-3ea2-a3a3-fc8db91cb193",
                                                "text": "„Dreimaliges Kielholen ist die Regel. Die Strafe kann tödlich sein, wenn der Kopf an den Schiffskiel stößt und das Kommando zum Heraufziehen: ‚Haal up!‘ zu plötzlich geschieht.“"
                                            },
                                            {
                                                "example_id": "9e6ee19f-344d-4aa6-963e-34cc88d67ecf",
                                                "sense_id": "4a6e304d-9408-3ea2-a3a3-fc8db91cb193",
                                                "text": "„Wer durch Zänkerei, Trunk oder Fluchen auffiel, bekam Arrest, wer beim Wachtdienst einschlief, wurde ‚gekielholt‘ oder durch Spießrutenlaufen bestraft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2c49589f-0ecf-3d54-b5cd-22ada6d71d49",
                                        "entry_id": "9ecb8ec6-e7cd-31b0-ade3-77e41c3aaf34",
                                        "glosses": [
                                            "ein Schiff kippen/umlegen, so dass man am Unterboden (und Kiel) arbeiten kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2200000-f3eb-4f96-a885-53a3b278cae3",
                                                "sense_id": "2c49589f-0ecf-3d54-b5cd-22ada6d71d49",
                                                "text": "„Das Bremer Schiff ‚Lucia Margreta‘, Kommandeur J. Mangels, Directeur D. Lankenau, kam am 13. März 1787 wegen Sturmes mit einem Leck zurück und wurde gekielholt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
