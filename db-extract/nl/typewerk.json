                "senses": [
                    {
                        "sense_id": "cbc6682f-fec3-3de3-a2f9-196ce2e1c912",
                        "entry_id": "8324fd1d-5fb7-39bc-8469-72f815ce2fd0",
                        "glosses": [
                            "arbeid die bestaat uit tikken op een toetsenbord"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88f18595-344b-4280-a2f1-f6547cb17c3a",
                                "sense_id": "cbc6682f-fec3-3de3-a2f9-196ce2e1c912",
                                "text": "Het schermtoetsenbord van Windows neemt de helft van het scherm in beslag. Goed te gebruiken voor een mailtje of een url of een bericht intikken, maar voor het echte typewerk wil je toch een echt toetsenbord."
                            },
                            {
                                "example_id": "fcf05eae-e78a-492f-9d30-0d810901ef37",
                                "sense_id": "cbc6682f-fec3-3de3-a2f9-196ce2e1c912",
                                "text": "Wie gaat deze MacBook kopen? Mensen die veel reizen, licht typewerk doen en niet te veel programma’s tegelijk hoeven te gebruiken. En die het geen probleem vinden om zoveel geld voor een kleine laptop uit te trekken."
                            },
                            {
                                "example_id": "2fb4f117-da11-4765-b56d-98755e9b4365",
                                "sense_id": "cbc6682f-fec3-3de3-a2f9-196ce2e1c912",
                                "text": "In tegenstelling tot wat de naam laat vermoeden, is WiFi Scanner geen app om draadloze netwerken te detecteren. Dat doe je als vanouds handmatig, via de instellingen van je iPhone. Wel neemt WiFi Scanner je al het daaropvolgende typewerk uit handen: op plaatsen waar het wifi-wachtwoord zichtbaar is, op een A4’tje aan de muur of gewoon neergepend op een bierviltje, volstaat het om er met de smartphonecamera even een ‘scan’ van te maken."
                            }
                        ]
                    }
