                "senses": [
                    {
                        "sense_id": "706b0c4b-b091-349d-8be0-66feb189bcf9",
                        "entry_id": "a0a3a803-c127-3814-a0d4-b315e7277e88",
                        "glosses": [
                            "Fait qu’un joueur ou une joueuse réussisse à remporter un jeu sur le service de son adversaire, après avoir perdu son propre jeu de service précédemment."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d31c353c-a9d7-4ca9-b722-49ff73a6f28d",
                                "sense_id": "706b0c4b-b091-349d-8be0-66feb189bcf9",
                                "text": "Très solide au service, Djokovic a ensuite pris une nouvelle fois sa mise en jeu avant d’égaliser grâce à un débreak obtenu après une légère baisse de régime de Ruud qui a offert le jeu sur un smash envoyé dans le filet (4-3)."
                            },
                            {
                                "example_id": "d3c8e854-396e-4dac-8b0a-d0765b148ca9",
                                "sense_id": "706b0c4b-b091-349d-8be0-66feb189bcf9",
                                "text": "La première balle de débreak est écartée d'un service gagnant au T."
                            },
                            {
                                "example_id": "5c3879bd-4947-457d-b76e-c6372d5d6150",
                                "sense_id": "706b0c4b-b091-349d-8be0-66feb189bcf9",
                                "text": "La rencontre est alors devenue plus débridée, les débreaks succédant aux breaks, mais un sursaut d'énergie de l'équipe de Wally Masur contre les défenseurs de Leon Smith leur a permis d'empocher au tie-break le 4e set après avoir sauvé une balle de match."
                            }
                        ]
                    }
