        "de-extract.jsonl": [
            {
                "entry_id": "758e1f5c-c8ec-30a9-842d-9c31b99d48ef",
                "word": "zweckmäßigerweise",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ab34fd6d-9e74-302a-a2af-8651ae85d0ca",
                        "entry_id": "758e1f5c-c8ec-30a9-842d-9c31b99d48ef",
                        "glosses": [
                            "zur Zweckmäßigkeit; in Anbetracht der Nützlichkeit von etwas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46f66a57-f0f0-479d-95d0-09d1841d9f52",
                                "sense_id": "ab34fd6d-9e74-302a-a2af-8651ae85d0ca",
                                "text": "„Die Meldepflicht bei Durchfallerkrankungen ist zweckmäßigerweise auf Fälle beschränkt, die seuchenhygienisch von wesentlicher Bedeutung sind.“"
                            },
                            {
                                "example_id": "d85de339-7fb7-49c7-9475-e23a8c36e9cf",
                                "sense_id": "ab34fd6d-9e74-302a-a2af-8651ae85d0ca",
                                "text": "„Es kann zweckmäßigerweise vorkommen, dass bei einem späteren Kapitel auf bestimmte Teile zurückgegriffen wird.“"
                            },
                            {
                                "example_id": "f31a0478-6c4a-433f-91cb-a5056cbf8d22",
                                "sense_id": "ab34fd6d-9e74-302a-a2af-8651ae85d0ca",
                                "text": "„Man geht deshalb zweckmäßigerweise an Hand eines Schemas oder einer Check-Liste vor.“"
                            },
                            {
                                "example_id": "5d1b1180-b435-4436-89b6-0596f459478e",
                                "sense_id": "ab34fd6d-9e74-302a-a2af-8651ae85d0ca",
                                "text": "„In diesen Schulküchen wird zweckmäßigerweise eine Mittagsmahlzeit, etwa dem Drittel des täglichen Nahrungsbedarfes im Nährwerte entsprechend, den Kindern verabreicht (etwa 10 hn pro Kind und Tag).“"
                            },
                            {
                                "example_id": "dfaf483f-e737-4ed3-9054-bb5e9a2496ec",
                                "sense_id": "ab34fd6d-9e74-302a-a2af-8651ae85d0ca",
                                "text": "„Bei vielen fremdbezogenen Produkten muß sich der Einkauf mit der Frage befassen, ob man zweckmäßigerweise den Betriebsbedarf direkt beim Erzeuger decken oder ein Handelsunternehmen einschalten soll.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
