                        "form": "se suranimer"
                    },
                    {
                        "form_id": "e8729c3a-78c5-473b-b0fd-83c04ca4cfe0",
                        "entry_id": "60e814ff-024d-30de-885a-16a5abe78fa2",
                        "tags": [],
                        "form": "sur-animer"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b4adca1f-a6d4-3de5-b6de-005d69cc7ab1",
                        "entry_id": "60e814ff-024d-30de-885a-16a5abe78fa2",
                        "glosses": [
                            "Animer de façon excessive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3570eb30-b4f4-4c8e-a371-18f61eafcd6f",
                                "sense_id": "b4adca1f-a6d4-3de5-b6de-005d69cc7ab1",
                                "text": "Il ne doit pas suranimer la réunion."
                            },
                            {
                                "example_id": "d678dbd0-2338-4954-ac0b-97b96d43fb96",
                                "sense_id": "b4adca1f-a6d4-3de5-b6de-005d69cc7ab1",
                                "text": "Mais par stratégie, certains choisissent aussi de pas « suranimer les ventes »."
                            }
                        ]
                    },
                    {
                        "sense_id": "77864740-b7b4-3166-b31b-2982e26702b6",
                        "entry_id": "60e814ff-024d-30de-885a-16a5abe78fa2",
                        "glosses": [
                            "Définition manquante ou à compléter. (Ajouter)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a5349b0-9497-4149-a3f9-3e091bc64ed4",
                                "sense_id": "77864740-b7b4-3166-b31b-2982e26702b6",
                                "text": "Par l'Incarnation, écrit Teilhard, Dieu est descendu dans la nature pour la suranimer et la ramener à Lui : voilà le dogme chrétien dans sa substance."
                            },
                            {
                                "example_id": "b9370a92-50be-4178-a898-edd4bd30a888",
                                "sense_id": "77864740-b7b4-3166-b31b-2982e26702b6",
                                "text": "Sous l'influence de notre foi, l'Univers est susceptible, sans changer extérieurement de traits, de s'assouplir, de s'animer, - de se suranimer."
                            }
                        ]
                    }
                ],
