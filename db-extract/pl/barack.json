                                        "entry_id": "f41341f8-c015-331a-abf0-d567361b546e",
                                        "glosses": [
                                            "A male given name from Arabic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12b8e0fd-9659-4476-b351-3e1a41d3670f",
                                                "sense_id": "824593bc-58e7-3b18-aaeb-497b74fb54ac",
                                                "text": "\"What did Marcus call you just now? Some African name, wasn't it?\" \"Barack.\" \"I thought your name was Barry.\" \"Barack's my given name. My father's name. He was Kenyan.\" \"Does it mean something?\" \"It means 'Blessed'. In Arabic. My grandfather was a Muslim.\""
                                            },
                                            {
                                                "example_id": "efc1a5bc-eb02-475d-8dbc-64b25b81862d",
                                                "sense_id": "824593bc-58e7-3b18-aaeb-497b74fb54ac",
                                                "text": "Joe Biden has had a two-word retort to recent questions about his record on civil rights and race: Barack Obama."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Barack",
                                "target_lang_code": "en",
                                "target_senses": [
