                ],
                "senses": [
                    {
                        "sense_id": "d98168ef-3726-3cc6-b2a5-8c7fe00a4f8b",
                        "entry_id": "15e68393-8133-3b62-94a1-616ea8a7da09",
                        "glosses": [
                            "Infirme, plein de maladies internes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c9ef74d-06b4-4732-83b0-c5362befdf5e",
                                "sense_id": "d98168ef-3726-3cc6-b2a5-8c7fe00a4f8b",
                                "text": "Les bataillons de l’Église militante ne se composeront plus que de vieilles femmes, de nabots, de maléficiés et de mangrelous."
                            },
                            {
                                "example_id": "7a5a425f-7862-48f2-8326-4be8f2ddf52d",
                                "sense_id": "d98168ef-3726-3cc6-b2a5-8c7fe00a4f8b",
                                "text": "[…] elles peuvent produire pendant toute leur vie, c'est-à-dire jusqu'à l'âge de dix ou douze ans ; mais ordinairement elles sont vieilles et maléficiées dès l'âge de sept ou huit ans."
                            }
                        ]
                    },
                    {
                        "sense_id": "ddd91e4c-95dc-3be5-9165-507ac6ff701e",
                        "entry_id": "15e68393-8133-3b62-94a1-616ea8a7da09",
                        "glosses": [
                            "Qui est plein de maléfices."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74f3f6f1-0455-4aa4-85c4-d8c55aeca800",
                                "sense_id": "ddd91e4c-95dc-3be5-9165-507ac6ff701e",
                                "text": "Il est hideux, pensait Durtal ; cette rivière de bile doit charrier des fièvres ; elle est maléficiée, pourrie, avec ses plaques savonneuses, ses teintes métalliques, ses fragments d’arc-en-ciel, échoués dans des boues."
                            },
                            {
                                "example_id": "786b15cf-38d9-4cfd-9781-43b8222d0939",
                                "sense_id": "ddd91e4c-95dc-3be5-9165-507ac6ff701e",
                                "text": "Par une diablerie inexplicable, le catholique appareil n’avait pas fonctionné, et toute la chimie de M. le curé n’avait pu faire surgir la moindre image sur les plaques maléficiées…"
                            },
                            {
                                "example_id": "a3d4b487-6849-412d-aa50-fcdc09acefa7",
                                "sense_id": "ddd91e4c-95dc-3be5-9165-507ac6ff701e",
                                "text": "Et la Maison des biens de fortune est visiblement maléficiée."
                            },
                            {
                                "example_id": "22823efd-4d6b-4d7f-9b65-7c709eb38c35",
                                "sense_id": "ddd91e4c-95dc-3be5-9165-507ac6ff701e",
                                "text": "Il y a chez Madeleine quelque chose d’une petite princesse maléficiée."
                            }
                        ]
                    }
                ],
