                "senses": [
                    {
                        "sense_id": "aac5f7df-f3b1-333e-ab0d-f5d7126abdd2",
                        "entry_id": "b4c5e597-2787-3ca3-9122-d32c39020ecd",
                        "glosses": [
                            "Caractère d’être métrosexuel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f8dc9ef-c595-4c38-8a5d-f87704c7112e",
                                "sense_id": "aac5f7df-f3b1-333e-ab0d-f5d7126abdd2",
                                "text": "C’est une intensification de la métrosexualité, devenue “mainstream” et normale au point que la coquetterie masculine ne fait plus tourner les têtes."
                            },
                            {
                                "example_id": "144e625f-8960-43f0-8f00-612507217b6c",
                                "sense_id": "aac5f7df-f3b1-333e-ab0d-f5d7126abdd2",
                                "text": "Le 12 juin, interrogé sur les notions d’homosexualité et de métrosexualité représentées soi-disant dans l’effectif de la Nazionale, l’attaquant italien de l’AC Milan avait dérapé en conférence de presse."
                            },
                            {
                                "example_id": "7f16b116-7a14-4211-a8a6-0e460de843a5",
                                "sense_id": "aac5f7df-f3b1-333e-ab0d-f5d7126abdd2",
                                "text": "En plus, la métrosexualité ne devrait pas se confondre avec l’homosexualité."
                            }
                        ]
                    }
                ],
