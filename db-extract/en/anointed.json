                    {
                        "sense_id": "84e0bf7c-5c2a-3c37-a2b0-ff7e77e6b4c4",
                        "entry_id": "0187d412-9843-3457-b8ae-d02f142bbf93",
                        "glosses": [
                            "A person who has been anointed, especially for religious reasons."
                        ],
                        "tags": [],
