                "senses": [
                    {
                        "sense_id": "45e6ee0f-0922-3b24-97fc-875203198a24",
                        "entry_id": "9d0d4182-9388-3cba-b37e-e873e2065d49",
                        "glosses": [
                            "een werkwoord dat een eigenschap koppelt aan het onderwerp"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52f2877a-7d50-477e-80cf-9c30c2862953",
                                "sense_id": "45e6ee0f-0922-3b24-97fc-875203198a24",
                                "text": "Jan is ziek."
                            },
                            {
                                "example_id": "3026bfed-ea81-4ac1-8a44-d609e1bd2759",
                                "sense_id": "45e6ee0f-0922-3b24-97fc-875203198a24",
                                "text": "Jan lijkt ziek."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "79eea23e-4816-425d-a2b6-7771b9869724",
                        "source_entry_id": "9d0d4182-9388-3cba-b37e-e873e2065d49",
                        "source_sense_id": "45e6ee0f-0922-3b24-97fc-875203198a24",
                        "source_sense_description": "een werkwoord dat een eigenschap koppelt aan het onderwerp",
                        "target_lang_word": "Kopula",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kopula",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4c0fc099-ce53-3d82-93e5-c13a4dec105f",
                                        "entry_id": "d3830175-05e8-3a66-9b1a-570b83feb57f",
                                        "glosses": [
                                            "Glied, das Subjekt und Prädikat zu einer Aussage verbindet"
                                        ],
                                        "tags": [
                                            "Logik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48935973-baca-4511-8ec5-f427c699d840",
                                                "sense_id": "4c0fc099-ce53-3d82-93e5-c13a4dec105f",
                                                "text": "„Er schuf damit die Voraussetzung für eine rationale Logik, in der der Kopula nun eine ähnliche Bedeutung zukommt wie dem Gleichheitszeichen in der Mathematik.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a41fa0b6-2044-3f9a-887b-665c09c55dba",
                                        "entry_id": "d3830175-05e8-3a66-9b1a-570b83feb57f",
                                        "glosses": [
                                            "die Verben \\\"sein\\\", \\\"bleiben\\\" und \\\"werden\\\", deren Funktion darin gesehen wird, eine Verbindung zwischen Subjekt und Prädikatsnomen zu bewirken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a23964c5-8974-4fa6-a82d-b4fc32b426de",
                                                "sense_id": "a41fa0b6-2044-3f9a-887b-665c09c55dba",
                                                "text": "Eine Kopula hat eine wichtige grammatische Funktion, aber nur eine schwach ausgeprägte Bedeutung."
                                            },
                                            {
                                                "example_id": "506f3748-32f1-4fd7-9d2b-4679606c6f69",
                                                "sense_id": "a41fa0b6-2044-3f9a-887b-665c09c55dba",
                                                "text": "„In solcher Verwendung nennt man diese Formen des Verbums sein »Kopula«, was man mit »Satzband« übersetzt hat.“"
                                            },
                                            {
                                                "example_id": "0d4ddf2d-6c52-40af-8569-879482c33e5e",
                                                "sense_id": "a41fa0b6-2044-3f9a-887b-665c09c55dba",
                                                "text": "„Dann gibt es noch ein Hilfswort, die so genannte Kopula – und bevor deine Phantasie mit dir durchbrennt, verrate ich dir lieber gleich, dass die Ägyptologen dabei nicht an die körperliche Vereinigung von Mann und Frau denken, sondern sich auf einen Begriff aus der Logik beziehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "de5da146-98c7-328a-92c0-c0b27522517b",
                                        "entry_id": "d3830175-05e8-3a66-9b1a-570b83feb57f",
                                        "glosses": [
                                            "die Begattung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "daeff062-cf89-4923-8eac-aa4df9d9f31b",
                                                "sense_id": "de5da146-98c7-328a-92c0-c0b27522517b",
                                                "text": "„Die Verbindung der beiden Geschlechtstiere in der Kopula kann bis zu 6 Stunden dauern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e0a1d37d-88c5-455c-aab0-2c3103089a8a",
                        "source_entry_id": "9d0d4182-9388-3cba-b37e-e873e2065d49",
                        "source_sense_id": "45e6ee0f-0922-3b24-97fc-875203198a24",
                        "source_sense_description": "een werkwoord dat een eigenschap koppelt aan het onderwerp",
                        "target_lang_word": "copula",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "copula",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "51f2f21d-fca3-3984-9775-0f583391e8ef",
                                        "entry_id": "630ca6e8-a452-30d7-8510-7a32911d7593",
                                        "glosses": [
                                            "A word, usually a verb, used to link the subject of a sentence with a predicate (usually a subject complement or an adverbial), that unites or associates the subject with the predicate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d74d26dd-1803-42d9-ae77-530ef1eebda6",
                                                "sense_id": "51f2f21d-fca3-3984-9775-0f583391e8ef",
                                                "text": "I begin by arguing in section 2 that there are in fact at least two Celtic copulas, a grammatical copula that simply spells out tense and agreement, and a substantive copula formed on a lexically listed verbal stem."
                                            },
                                            {
                                                "example_id": "647a7a8a-d926-4385-9459-f752b34fb0d7",
                                                "sense_id": "51f2f21d-fca3-3984-9775-0f583391e8ef",
                                                "text": "The theory of conjunctively tensed copulae will be developed and stated with more precision in the following section."
                                            },
                                            {
                                                "example_id": "c8c95f39-19ca-41e6-a8b6-02bfd3aa4974",
                                                "sense_id": "51f2f21d-fca3-3984-9775-0f583391e8ef",
                                                "text": "This paper explores the position of the copula in the development of the verb system in second language acquisition of Italian."
                                            },
                                            {
                                                "example_id": "1efda3ca-3131-4eb6-ba45-3d721de02e0e",
                                                "sense_id": "51f2f21d-fca3-3984-9775-0f583391e8ef",
                                                "text": "The present study focuses on the acquisition of a specific verbal element, namely the copula, in predicative constructions in a cross-linguistic perspective (English, German, Croatian)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8953e1b-9e58-3008-bc1a-77c2a9ddc102",
                                        "entry_id": "630ca6e8-a452-30d7-8510-7a32911d7593",
                                        "glosses": [
                                            "The bond or relationship by which two things are combined into a unity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6069afe3-9f1a-4f77-97be-6f7cfca04e0d",
                                                "sense_id": "d8953e1b-9e58-3008-bc1a-77c2a9ddc102",
                                                "text": "The fact that in milk the copula or bond is exceedingly slight is evident from the spontaneous resolution of milk when left in a vessel, its resolution, namely, into cream—a white substance of comparative consistency,—and a sourish fluid; also from its ready resolution when, merely by motion, it is turned into butter, or, by heat, into various kinds of curds."
                                            },
                                            {
                                                "example_id": "af2f75bc-770d-436f-869a-ac1ce6e20dbb",
                                                "sense_id": "d8953e1b-9e58-3008-bc1a-77c2a9ddc102",
                                                "text": "I quite correctly defined logical copulation by means [of] the copula of inclusion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e0a66ca-80ad-3d27-96d2-aca656f4cc55",
                                        "entry_id": "630ca6e8-a452-30d7-8510-7a32911d7593",
                                        "glosses": [
                                            "A function that represents the association between two or more variables, independent of the individual marginal distributions of the variables."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bfb99a99-d778-4028-ac72-d4e0126ae94b",
                                                "sense_id": "3e0a66ca-80ad-3d27-96d2-aca656f4cc55",
                                                "text": "In 2000, David X. Li, a banker with a doctorate in statistics who was then at RiskMetrics, part of J. P. Morgan Chase, began using mathematical functions called Gaussian copulas to estimate the likelihood of corporations’ dying in unison."
                                            },
                                            {
                                                "example_id": "e02fe94d-350c-4e14-8338-2b5bc666d580",
                                                "sense_id": "3e0a66ca-80ad-3d27-96d2-aca656f4cc55",
                                                "text": "There is little statistical theoretical theory for copulas. Sensitivity studies of estimation procedures and goodness-of-fit tests for copulas are unknown."
                                            },
                                            {
                                                "example_id": "04150dda-a83d-46b2-a44f-b3a802e3249f",
                                                "sense_id": "3e0a66ca-80ad-3d27-96d2-aca656f4cc55",
                                                "text": "Copulas provide an example of the haphazard evolution of quantitative finance. The key result is Sklar's theorem, which says that one can characterize any multivariate probability distribution by its copula (which specifies the correlation structure) and its marginal distributions (the conditional one dimensional distributions). Thus one can create multivariate distributions by mixing and matching copulas and marginal distributions."
                                            },
                                            {
                                                "example_id": "5c0f88c5-33dd-4d1b-b568-19962f9cfd06",
                                                "sense_id": "3e0a66ca-80ad-3d27-96d2-aca656f4cc55",
                                                "text": "A recently developed flexible method is provided by hierarchical Archimedean copulae (HAC)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "702f508e-9bf6-33a3-9ec9-9677b842232d",
                                        "entry_id": "630ca6e8-a452-30d7-8510-7a32911d7593",
                                        "glosses": [
                                            "A device that connects two or more keyboards of an organ."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d43ccd39-5b41-3316-88e6-58e71e9dd560",
                                        "entry_id": "630ca6e8-a452-30d7-8510-7a32911d7593",
                                        "glosses": [
                                            "The act of copulation; mating."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
