                        "source_entry_id": "89aefa8a-7aef-3f40-9e24-dfa2d153f12b",
                        "source_sense_description": "study of pronunciation",
                        "target_lang_word": "orthoépie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "orthoépie",
                                "target_lang_code": "fr",
