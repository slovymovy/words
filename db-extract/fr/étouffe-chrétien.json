                                        "entry_id": "baddf4a8-ccab-3d0f-9c81-ac3764c87bc6",
                                        "glosses": [
                                            "Anything dull and bland."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6e7dbd4-d98d-4fd7-872e-1747dbda4d1c",
                                                "sense_id": "ff2178cf-ed2b-3a57-a732-e88d850bb0e3",
                                                "text": "Critics dismissed the book as academic stodge."
                                            }
