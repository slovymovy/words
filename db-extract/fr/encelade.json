                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2ad3d958-adb9-4abf-bc4d-797b8d64608e",
                        "entry_id": "f152b30b-efa9-35a4-87f4-57a52934f9a9",
                        "tags": [],
                        "form": "Encélade"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "284f5cba-ba8e-39c2-b37a-7acb30eeb447",
                        "entry_id": "f152b30b-efa9-35a4-87f4-57a52934f9a9",
                        "glosses": [
                            "Titan, fils d’Ouranos (le Ciel) et de Gaïa (la Terre), fait prisonnier sous l’Etna à l’issue de la gigantomachie."
                        ],
                        "tags": [
                            "Divinité"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "bf5f581d-2632-31c0-92e2-bdd20ca493a4",
                        "entry_id": "f152b30b-efa9-35a4-87f4-57a52934f9a9",
                        "glosses": [
                            "Satellite naturel de la planète Saturne, découvert en 1789 par William Herschel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24728f85-b4e9-4afb-949a-d5012950d160",
                                "sense_id": "bf5f581d-2632-31c0-92e2-bdd20ca493a4",
                                "text": "Avec près de trois cents orbites autour de Saturne, la sonde a découvert notamment des mers de méthane liquide sur Titan, son plus grand satellite naturel, et un vaste océan d’eau salée sous la surface glacée d’Encelade, une petite Lune saturnienne."
                            },
                            {
                                "example_id": "16ac39d1-344e-45cf-a422-b114dec9a3a3",
                                "sense_id": "bf5f581d-2632-31c0-92e2-bdd20ca493a4",
                                "text": "\"[…]. Dans le cas de la lune Encelade de Saturne, il sera possible de quantifier les geysers\", se réjouit Olivier Hernandez, le directeur du Planétarium Rio Tinto."
                            },
                            {
                                "example_id": "1606ea52-424b-4ec1-ab2f-b8bb88e1f22d",
                                "sense_id": "bf5f581d-2632-31c0-92e2-bdd20ca493a4",
                                "text": "Cela dit, l’article de Nature fait entrer Mimas dans le club assez fermé des satellites dotés d’un océan interne, qui comptait jusqu’ici quatre membres : Europe et Ganymède, autour de Jupiter, et Encelade et Titan, autour de Saturne."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a566be66-583a-490a-aeb6-a3a4fcdbd18d",
                        "source_entry_id": "f152b30b-efa9-35a4-87f4-57a52934f9a9",
                        "source_sense_description": "satellite de Saturne",
                        "target_lang_word": "Enceladus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Enceladus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "edf6600f-fb3f-3bb6-87ff-33384592da64",
                                        "entry_id": "8312825a-aa09-3b4e-b820-52a69d67cad2",
                                        "glosses": [
                                            "Mond des Planeten Saturn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9b65c18-2207-47b0-93d6-c01fc75298b8",
                                                "sense_id": "edf6600f-fb3f-3bb6-87ff-33384592da64",
                                                "text": "Im Jahre 2005, als Cassini auf der Nachtseite des Enceladus vorbeiflog, erspähte die Sonde Streulicht von Geysir-artigen Eruptionen von Eispartikeln, die offenbar aus Rissen in der Nähe des Südpols stammten (…)."
                                            },
                                            {
                                                "example_id": "a26b4db4-7d59-49a2-b9cc-c3e5b2caf7bd",
                                                "sense_id": "edf6600f-fb3f-3bb6-87ff-33384592da64",
                                                "text": "Unter kilometerdicken Eisschichten am Südpol des Saturnmondes Enceladus könnte ein riesiger Ozean liegen."
                                            },
                                            {
                                                "example_id": "15da368a-9253-4eb4-abba-1f8de32cdbf1",
                                                "sense_id": "edf6600f-fb3f-3bb6-87ff-33384592da64",
                                                "text": "Tief im Saturnmond Enceladus sprudeln heiße Quellen am Boden eines unterirdischen Ozeans."
                                            },
                                            {
                                                "example_id": "05c2db1c-ebde-4955-9cc6-fb0d8938fed4",
                                                "sense_id": "edf6600f-fb3f-3bb6-87ff-33384592da64",
                                                "text": "Die Eispartikel von Enceladus speisen einen eigenen Saturnring, den sogenannten E-Ring, wie die Beobachtungen gezeigt haben."
                                            },
                                            {
                                                "example_id": "e4191630-de9c-4439-8add-6126b904e689",
                                                "sense_id": "edf6600f-fb3f-3bb6-87ff-33384592da64",
                                                "text": "Die Forscher hatten bereits gewusst, dass Enceladus wegen Resonanzen mit anderen Monden Gezeitenreibung erfahren muss, aber sie waren doch überrascht, dass diese intensiv genug ist, um geologische Aktivität zu ermöglichen."
                                            },
                                            {
                                                "example_id": "08f4f39d-e155-4708-a0d6-8a01e34899d3",
                                                "sense_id": "edf6600f-fb3f-3bb6-87ff-33384592da64",
                                                "text": "Diese Erwärmung beginnt nun aber Energie aus dem von Dione veränderten Orbit abzuführen, was die Umlaufbahn von Enceladus langsam wieder in den nahezu kreisförmigen Zustand zurückführt und den Mond erneut auskühlt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
