                                "sense_id": "b979beaa-82ff-372d-a8e2-9baa090b8ceb",
                                "text": "Die man heeft duidelijk O-benen."
                            },
                            {
                                "example_id": "b508697f-2916-455d-a1d2-437bc784b3ff",
                                "sense_id": "b979beaa-82ff-372d-a8e2-9baa090b8ceb",
                                "text": "Voorzichtig werp ik op dat hij, zeker voor een atleet, opvallende… O-benen heeft."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3bb35101-4712-427c-8e6a-86e3627fb94a",
