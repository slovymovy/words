                    "frequency": "Low",
                    "semantic_group_id": "droit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le paiement de la dernière mensualité a permis de <w>libérer</w> le bien immobilier de toute dette."
                        },
                        {
                            "text": "Cet arrangement amiable a réussi à le <w>libérer</w> de ses engagements antérieurs."
                        }
                    ],
                    "common_phrases": [
                        "libérer d'une dette"
                    ]
                },
                {
