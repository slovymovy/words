                ],
                "senses": [
                    {
                        "sense_id": "430d6446-ae5f-3175-af73-3a2638cec133",
                        "entry_id": "dde09740-3d09-3424-a6de-a3baa3fbead9",
                        "glosses": [
                            "Enlever son caparaçon ou sa protection à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e01e71d5-da33-449f-9b8f-6852e2c323c8",
                                "sense_id": "430d6446-ae5f-3175-af73-3a2638cec133",
                                "text": "Le retour inespéré de Montmartin qui parut en cet instant dans la cour du château , et ordonna de décaparaçonner son cheval, confirma et accrut l’espérance de Charles."
                            },
                            {
                                "example_id": "163a560f-7362-4c57-b956-fbeaf6d3a8b8",
                                "sense_id": "430d6446-ae5f-3175-af73-3a2638cec133",
                                "text": "Suite à ce baiser d’escamoteuse, j’ai tenté d’attirer vers moi la faunesse, de la décaparaçonner un peu, de la délunettiser encore une fois."
                            },
                            {
                                "example_id": "ea2e2755-d851-4a56-adde-f6ffb99cfb0a",
                                "sense_id": "430d6446-ae5f-3175-af73-3a2638cec133",
                                "text": "Trouver sa vérité, c’est se décaparaçonner."
                            }
                        ]
                    }
                ],
