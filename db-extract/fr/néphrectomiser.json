                "senses": [
                    {
                        "sense_id": "34753b67-b4ff-3de3-96dc-1d943a743deb",
                        "entry_id": "c837f5bb-6e38-3b16-8d27-7ca4f6a43322",
                        "glosses": [
                            "Procéder à l'ablation du rein chez (un être humain ou un animal)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d934b930-0e60-4859-9f4f-4b422061319c",
                                "sense_id": "34753b67-b4ff-3de3-96dc-1d943a743deb",
                                "text": "C'est ainsi qu'un équilibre stable n'est obtenu que si on a pris soin de néphrectomiser au préalable les animaux."
                            },
                            {
                                "example_id": "43b51b21-1bc6-4233-9280-d9217c783481",
                                "sense_id": "34753b67-b4ff-3de3-96dc-1d943a743deb",
                                "text": "La vasopressine. comme l'insuline, réduit le taux sanguin du galactose administré par voie intraveineuse chez le chien hépatectomisé, éviscéré et néphrectomisé."
                            }
                        ]
                    }
