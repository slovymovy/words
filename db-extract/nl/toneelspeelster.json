                        ],
                        "examples": [
                            {
                                "example_id": "e0ae80ee-f6a4-4e59-b5bb-6170f788a57a",
                                "sense_id": "e3faab17-e51f-34a1-803d-c77424693fbd",
                                "text": "Zij is een beroemde toneelspeelster."
                            }
                        ]
