    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4aa414fe-b1f0-3fac-b131-7342e730c9eb",
                    "sense_definition": "Een volwassen persoon van het mannelijk geslacht.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "gender",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>man</w> liep rustig door het park.",
                            "target_lang_translations": {
                                "en": "The <w>man</w> walked quietly through the park.",
                                "ru": "<w>Мужчина</w> спокойно шел по парку."
                            }
                        },
                        {
                            "text": "Die <w>man</w> is een <w>oude</w> <w>man</w> die daar elke dag wandelt.",
                            "target_lang_translations": {
                                "en": "That <w>man</w> is an old <w>man</w> who walks there every day.",
                                "ru": "Тот <w>мужчина</w> — пожилой <w>человек</w>, который гуляет там каждый день."
                            }
                        }
                    ],
                    "synonyms": [
                        "kerel"
                    ],
                    "antonyms": [
                        "vrouw"
                    ],
                    "common_phrases": [
                        "oude man",
                        "jonge man",
                        "man tot man"
                    ],
                    "target_lang_definitions": {
                        "en": "An adult person of the male sex.",
                        "ru": "Взрослый человек мужского пола."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "man",
                                "target_lang_sense_clarification": "an adult male human"
                            },
                            {
                                "target_lang_word": "guy",
                                "target_lang_sense_clarification": "informal term for a man"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "мужчина",
                                "target_lang_sense_clarification": "взрослый человек мужского пола"
                            },
                            {
                                "target_lang_word": "человек",
                                "target_lang_sense_clarification": "в общем смысле, как представитель человечества"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "130a5aff-7eea-3bde-8f3a-a6752a05c38a",
                    "sense_definition": "Een mannelijke huwelijkspartner.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "family",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ze is al jaren gelukkig getrouwd met haar <w>man</w>.",
                            "target_lang_translations": {
                                "en": "She has been happily married to her <w>husband</w> for years.",
                                "ru": "Она уже много лет счастлива в браке со своим <w>мужем</w>."
                            }
                        },
                        {
                            "text": "Mijn <w>man</w> en <w>vrouw</w> zijn gisteren samen uit eten gegaan.",
                            "target_lang_translations": {
                                "en": "My <w>husband</w> and wife went out to dinner together yesterday.",
                                "ru": "Мой <w>муж</w> и жена вчера вместе ходили в ресторан."
                            }
                        }
                    ],
                    "antonyms": [
                        "vrouw"
                    ],
                    "common_phrases": [
                        "man en vrouw",
                        "haar eigen man"
                    ],
                    "target_lang_definitions": {
                        "en": "A male marriage partner.",
                        "ru": "Мужчина, состоящий в браке; супруг."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "husband",
                                "target_lang_sense_clarification": "a man in a marriage"
                            },
                            {
                                "target_lang_word": "man",
                                "target_lang_sense_clarification": "husband, as in 'man and wife'"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "муж",
                                "target_lang_sense_clarification": "супруг"
                            },
                            {
                                "target_lang_word": "супруг",
                                "target_lang_sense_clarification": "официальное обозначение мужа"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ca169c4f-e47d-3bfd-9c25-38490ad4a366",
                    "sense_definition": "Een mannelijk exemplaar van een diersoort.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bij veel vogelsoorten is het <w>man</w> kleurrijker dan het vrouwtje.",
                            "target_lang_translations": {
                                "en": "In many bird species, the <w>male</w> is more colorful than the female.",
                                "ru": "У многих видов птиц <w>самец</w> окрашен ярче, чем самка."
                            }
                        },
                        {
                            "text": "De zwarte weduwe eet soms het <w>mannetje</w> op na het paren.",
                            "target_lang_translations": {
                                "en": "The black widow sometimes eats the <w>male</w> after mating.",
                                "ru": "Черная вдова иногда поедает <w>самца</w> после спаривания."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A male specimen of an animal species.",
                        "ru": "Особь мужского пола у животных."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "male",
                                "target_lang_sense_clarification": "the sex that produces sperm"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "самец",
                                "target_lang_sense_clarification": "особь мужского пола у животных"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6bf00273-a0d1-327c-9322-840b98a897bb",
                    "sense_definition": "Het goddelijke voedsel dat de Israëlieten kregen in de woestijn.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de Bijbel staat dat het volk <w>man</w> uit de hemel ontving.",
                            "target_lang_translations": {
                                "en": "The Bible states that the people received <w>manna</w> from heaven.",
                                "ru": "В Библии говорится, что народ получал <w>манну</w> небесную."
                            }
                        },
                        {
                            "text": "Het <w>man</w> diende als voedsel tijdens hun lange tocht door de woestijn.",
                            "target_lang_translations": {
                                "en": "The <w>manna</w> served as food during their long journey through the desert.",
                                "ru": "<w>Манна</w> служила пищей во время их долгого пути через пустыню."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The divine food that the Israelites received in the desert.",
                        "ru": "Пища, которую Бог посылал израильтянам в пустыне."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "manna",
                                "target_lang_sense_clarification": "miraculous food from heaven"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "манна",
                                "target_lang_sense_clarification": "небесная пища из Библии"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "825c7f09-fd7f-3601-aa8b-e5dab6f281bd",
                    "sense_definition": "Gebruikt om verbazing, nadruk of emotie uit te drukken.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "exclamation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Man</w>, wat ben ik moe na deze lange werkdag!",
                            "target_lang_translations": {
                                "en": "<w>Man</w>, am I tired after this long workday!",
                                "ru": "<w>Блин</w>, как же я устал после этого долгого рабочего дня!"
                            }
                        },
                        {
                            "text": "<w>Man</w>, is me dat schrikken door dat harde geluid.",
                            "target_lang_translations": {
                                "en": "<w>Man</w>, that loud noise really startled me.",
                                "ru": "<w>Да уж</w>, ну и напугал меня этот громкий звук."
                            }
                        }
                    ],
                    "common_phrases": [
                        "man man man"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Commonly used in informal speech to add emphasis."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Used to express surprise, emphasis, or emotion.",
                        "ru": "Междометие, используемое для выражения удивления, акцента или сильных эмоций."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "man",
                                "target_lang_sense_clarification": "exclamation used for emphasis"
                            },
                            {
                                "target_lang_word": "boy",
                                "target_lang_sense_clarification": "exclamation of surprise or excitement"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "блин",
                                "target_lang_sense_clarification": "разговорное восклицание досады или удивления"
                            },
                            {
                                "target_lang_word": "чувак",
                                "target_lang_sense_clarification": "разговорное обращение или восклицание"
                            },
                            {
                                "target_lang_word": "да уж",
                                "target_lang_sense_clarification": "выражение сильной эмоции или акцента"
                            }
                        ]
                    }
                }
            ]
        },
        {
