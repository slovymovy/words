                                        "glosses": [
                                            "дольная единица массы, равная одной миллионной грамма"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1bf51a3-3717-4f77-8c27-93f1b651f3b3",
                                                "sense_id": "7d63824c-5898-36c8-b2f8-b675d32d9fd8",
                                                "text": "Аналитическая чувствительность метода составляет несколько микрограмм на грамм образца."
                                            }
                                        ]
