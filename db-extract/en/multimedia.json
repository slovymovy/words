                "forms": [],
                "senses": [
                    {
                        "sense_id": "24114ccc-fbea-3a52-8b3f-a60a625b14c6",
                        "entry_id": "46b6d597-bd19-3560-bfad-e5d3b69e4f94",
                        "glosses": [
                            "The combined use of sound, video, and text to present an idea."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "802c3c7e-b8f3-4624-9f6b-60d4046e2f4b",
                        "source_entry_id": "46b6d597-bd19-3560-bfad-e5d3b69e4f94",
                        "source_sense_id": "24114ccc-fbea-3a52-8b3f-a60a625b14c6",
                        "source_sense_description": "The use of different media to convey information",
                        "target_lang_word": "multimédia",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "multimédia",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c68e3556-0407-3255-880d-d57012d15cb9",
                                        "entry_id": "5bfddd2c-a9c9-3396-b688-f143b2fb8a97",
                                        "glosses": [
                                            "Se dit d’une application, d’un service, d’un appareil utilisant plusieurs médias (image, son, vidéo…), le mot média étant pris dans son étymologie voulant dire « moyen de relier »."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d128a47-949a-4fdc-821b-0b4007ee47ac",
                                                "sense_id": "c68e3556-0407-3255-880d-d57012d15cb9",
                                                "text": "Partout dans le monde les manuels scolaires sont quelque peu malmenés, dans des sens divers : les chantres de l'électronique en prédisent la disparition au profit du multimédia ; […]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "multimédia",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "90cbd5fe-6895-3883-9538-c35cdde4bce3",
                                        "entry_id": "a5551a81-da9e-3ee9-ae4f-8734170756b8",
                                        "glosses": [
                                            "Relatif à l’usage de multiples médias."
                                        ],
                                        "tags": [
                                            "Audiovisuel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a578548-0936-4fbd-babe-5141a05be13b",
                                                "sense_id": "90cbd5fe-6895-3883-9538-c35cdde4bce3",
                                                "text": "L’utilisation du langage XML, est maintenant incontournable pour tous les créateurs d’applications multimédia. En effet, sa simplicité, sa souplesse et surtout son interopérabilité en font un langage universel permettant à la fois de structurer et d’échanger des informations, quel que soit le type de machine ou d’application."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3dd0748f-402e-4e66-9736-daad76969604",
                        "source_entry_id": "46b6d597-bd19-3560-bfad-e5d3b69e4f94",
