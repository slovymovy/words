                            {
                                "target_lang_word": "целоваться взасос",
                                "target_lang_sense_clarification": "страстно целоваться"
                            },
                            {
                                "target_lang_word": "лизаться",
                                "target_lang_sense_clarification": "грубо-жаргонное о поцелуях"
                            },
                            {
                                "target_lang_word": "зажиматься",
