                    },
                    {
                        "translation_id": "6ef3745a-2dda-4cf5-8342-ec53de80524d",
                        "source_entry_id": "ed3ef110-13d7-3192-a93a-de3e7e326cbc",
                        "source_sense_id": "88c39cfe-176c-3d35-b597-51c9f3de4784",
                        "target_lang_word": "sociolinguistics",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sociolinguistics",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2bdb8779-09e5-379c-88a8-3af5da144d58",
                                        "entry_id": "aef3f655-3622-3159-b198-ca4cd021cc2a",
                                        "glosses": [
                                            "The study of social and cultural effects on language and vice-versa."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1faaa6b6-8c9b-48f5-bf6a-b388b17cae03",
                                                "sense_id": "2bdb8779-09e5-379c-88a8-3af5da144d58",
                                                "text": "This paper surveys the research methods and approaches used in the multidisciplinary field of applied language studies or language education over the last fourty^([sic]) years. Drawing on insights gained in psycho- and sociolinguistics, educational linguistics and linguistic anthropology with regard to language and culture, it is organized around five major questions that concern language educators."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "abc987ed-4b53-4488-becb-412a245a25bf",
                        "source_entry_id": "ed3ef110-13d7-3192-a93a-de3e7e326cbc",
                        "source_sense_id": "88c39cfe-176c-3d35-b597-51c9f3de4784",
                        "target_lang_word": "sociolinguistique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sociolinguistique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "91a3c519-8c46-3f5a-b75c-b10e4a6dddae",
                                        "entry_id": "6e9a62c3-742d-391b-9d0e-0cfe78fa7088",
                                        "glosses": [
                                            "Discipline qui étudie le langage humain ou une langue, un dialecte, une communauté linguistique, du point de vue sociologique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a11ae629-e7b3-4360-9132-39a3105f6ee3",
                                                "sense_id": "91a3c519-8c46-3f5a-b75c-b10e4a6dddae",
                                                "text": "On m’avait promis que les chiens feraient ouah-ouah et les canards coin-coin, au lieu de woof-woof et de quack-quack ; plus de cocka-doodle-doo, des cocoricos. J'ai constaté que Français et Anglais s'illusionnaient à ce sujet. Première leçon de sociolinguistique."
                                            },
                                            {
                                                "example_id": "83425839-d885-40fd-8e35-713a63ae8c66",
                                                "sense_id": "91a3c519-8c46-3f5a-b75c-b10e4a6dddae",
                                                "text": "L’ensemble des théories présentées dans ce travail touche le champ de la sociolinguistique. Celle-ci ne se contente pas seulement d’éclairer le rapport entre langue et couche sociale, elle inclut dans son concept toute analyse linguistique ayant pour centre d’intérêt les influences des facteurs sociaux autant sur la langue que sur l’utilisation des langues en général."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sociolinguistique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "652b54a2-3698-3b28-b481-6f6d57d2215d",
                                        "entry_id": "87fef0ed-3aa5-3817-86a2-0c097b15a5b4",
                                        "glosses": [
                                            "Qui se rapporte à la sociologie du langage, à la langue dans son aspect socioculturel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21bcc012-fac6-4ffc-911a-2bd0124fd5b3",
                                                "sense_id": "652b54a2-3698-3b28-b481-6f6d57d2215d",
                                                "text": "Les causes de l’emprunt sont ainsi intimement liées aux conditions sociohistoriques, particulièrement politiques et économiques, qui font évoluer les situations sociolinguistiques."
                                            },
                                            {
                                                "example_id": "bad66dde-d8b5-4253-9212-17d39150fcd9",
                                                "sense_id": "652b54a2-3698-3b28-b481-6f6d57d2215d",
                                                "text": "Une étude sociolinguistique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
