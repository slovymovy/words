        "nl-extract.jsonl": [
            {
                "entry_id": "b3dcdeb7-8de6-336c-b026-6494a2b15e59",
                "word": "oppiepen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4e539bd8-736d-369a-902c-7a55f079553f",
                        "entry_id": "b3dcdeb7-8de6-336c-b026-6494a2b15e59",
                        "glosses": [
                            "iemand oproepen met behulp van een semafoon (of ander draadloos apparaat)"
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "fe8f90c3-2db7-4637-90f9-e3c33513fd55",
                                "sense_id": "4e539bd8-736d-369a-902c-7a55f079553f",
                                "text": "De kidswatcher is een horloge voor kinderen in de leeftijd van 5 tot 11 jaar. Door het horloge kunnen de ouders op hun telefoon zien waar hun kind is. In het horloge zitten modules die de locatie bepalen. Het horloge geeft die via een app door aan de smartphone van ouders en verzorgers. Zij kunnen een bericht naar het kind sturen, het kind kan hen oppiepen en in noodsituaties kan er snel contact worden gelegd met de politie."
                            }
                        ]
                    },
                    {
                        "sense_id": "83906d31-7294-331b-9027-ac4946950f80",
                        "entry_id": "b3dcdeb7-8de6-336c-b026-6494a2b15e59",
                        "glosses": [
                            "oproepen op een andere manier"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "8099e38d-9c75-4fd2-a8c3-b6f6af81f231",
                                "sense_id": "83906d31-7294-331b-9027-ac4946950f80",
                                "text": "De rivaliteit tussen beiden speelt weer op als Balkenende in het herfstreces een persconferentie geeft over de toestand in IJsland, en Bos vervolgens de media in zijn achtertuin uitnodigt om een toelichting te geven. Nadat Bos enkele malen al te opzichtig schittert als crisismanager, laat Balkenende zich door zijn eigen partij oppiepen voor zijn persoonlijke spoeddebat."
                            },
                            {
                                "example_id": "00c53ecc-4b5c-45c0-bbcf-c65bf50488b0",
                                "sense_id": "83906d31-7294-331b-9027-ac4946950f80",
                                "text": "Met Serious Talent hebben die een naam in het oppiepen van de Nederlandse pop. De trots op een goede songfestivalbijdrage is natuurlijk best genant, maar ook té leuk om uit handen te geven."
                            }
                        ]
                    },
                    {
                        "sense_id": "da9a51b5-edd9-3be1-90ce-220260f6dca5",
                        "entry_id": "b3dcdeb7-8de6-336c-b026-6494a2b15e59",
                        "glosses": [
                            "brood weer 'vers' maken door het te verwarmen in een oven of magnetron"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eec557d8-15c9-4fde-abef-13835bf34f60",
                                "sense_id": "da9a51b5-edd9-3be1-90ce-220260f6dca5",
                                "text": "Een broodtrommeltje helpt hier van zijn lang zal ze leven niet tegen.Even oppiepen in de magnetron wel: zodra de zetmeelmoleculen het weer warm krijgen, worden ze weer zacht en laten ze het water los."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "36d0d7a9-c772-47b6-87d9-9171741a451f",
                        "source_entry_id": "b3dcdeb7-8de6-336c-b026-6494a2b15e59",
                        "source_sense_id": "4e539bd8-736d-369a-902c-7a55f079553f",
                        "source_sense_description": "elektronisch draadloos oproepen",
                        "target_lang_word": "bleep",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bleep",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "01a5a761-e6c0-35a3-b257-ac6f656ba398",
                                        "entry_id": "bc98c94e-ec33-3a37-9695-1394fcf18375",
                                        "glosses": [
                                            "A brief high-pitched sound, as from some electronic device."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8c074b18-c931-3013-8ab4-9c48a4c1f770",
                                        "entry_id": "bc98c94e-ec33-3a37-9695-1394fcf18375",
                                        "glosses": [
                                            "A general euphemism for any expletive."
                                        ],
                                        "tags": [
                                            "countable",
                                            "euphemistic",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54ac7330-78c2-4b97-a8c8-419dca84070b",
                                                "sense_id": "8c074b18-c931-3013-8ab4-9c48a4c1f770",
                                                "text": "What the bleep are you doing?"
                                            },
                                            {
                                                "example_id": "d66d8b55-cf93-4318-a088-bff835e75eda",
                                                "sense_id": "8c074b18-c931-3013-8ab4-9c48a4c1f770",
                                                "text": "Who the bleep are you, Bob Kavin, to tell lesbians whether or not it's \"appropriate\" for us to gather together as women?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e373c89f-c102-3916-a869-7f6ebe785a18",
                                        "entry_id": "bc98c94e-ec33-3a37-9695-1394fcf18375",
                                        "glosses": [
                                            "A broad genre of electronic music with goth and industrial influences, as opposed to traditional gothic rock."
                                        ],
                                        "tags": [
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c23da2a4-df2e-4487-83a7-536ff026f661",
                                                "sense_id": "e373c89f-c102-3916-a869-7f6ebe785a18",
                                                "text": "See, there are a huge number of people in this city who look like goths and talk the talk and claim to enjoy much of the same music I do, so it confuses me somewhat that the clubs all play bleep. I would have thought there would be enough people to make something else work."
                                            },
                                            {
                                                "example_id": "a299a3be-b0f9-4413-bf4e-cad8cf8e4081",
                                                "sense_id": "e373c89f-c102-3916-a869-7f6ebe785a18",
                                                "text": "A number of nights now steer away from the EBM of yesteryear. The scene is alive and kicking with plenty of new bands that aren't reliant on synths. All you have to do is look. At InsanitoriuM we have a large, young, crowd that would up and leave if we started playing bleep at them, and we're not alone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d28bdaa8-1bd5-3f6b-94d2-b4fccac737ad",
                                        "entry_id": "bc98c94e-ec33-3a37-9695-1394fcf18375",
                                        "glosses": [
                                            "A pager, usually one held by a doctor or nurse in a hospital."
                                        ],
                                        "tags": [
                                            "UK",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "bleep",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "54a602ab-d998-32c1-9072-88d27283e668",
                                        "entry_id": "98773974-86bc-3d5f-8249-47f502b23c40",
                                        "glosses": [
                                            "To emit one or more bleeps."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "212bda26-dde0-418b-a5d2-d2e512eab625",
                                                "sense_id": "54a602ab-d998-32c1-9072-88d27283e668",
                                                "text": "The robot bleeped to acknowledge its new instructions."
                                            },
                                            {
                                                "example_id": "b4d563c9-ee41-487d-befd-24be3ebbeb3e",
                                                "sense_id": "54a602ab-d998-32c1-9072-88d27283e668",
                                                "text": "The basic toilet has quite a heavy door, which then bleeps to remind you to lock it - with a nice, peace of mind, manual lock."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7f4142d-926d-3a6a-9d1a-9fe7a0f5d9af",
                                        "entry_id": "98773974-86bc-3d5f-8249-47f502b23c40",
                                        "glosses": [
                                            "To edit out inappropriate spoken language in a broadcast by replacing offending words with bleeps."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2d1f6e88-1625-3645-ab70-7a497946eaf8",
                                        "entry_id": "98773974-86bc-3d5f-8249-47f502b23c40",
                                        "glosses": [
                                            "To contact someone by pager."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b6b1832-b16b-4dee-a2f0-73c46a33f7d6",
                                                "sense_id": "2d1f6e88-1625-3645-ab70-7a497946eaf8",
                                                "text": "If his condition gets any worse, please bleep the registrar on call."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
