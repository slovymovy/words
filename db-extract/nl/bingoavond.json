                    {
                        "sense_id": "3e828485-c6b2-3458-a93c-947688f79051",
                        "entry_id": "b7f0434b-aab3-35c9-bdb5-7a7446ae1242",
                        "glosses": [
                            "een bijeenkomst in de avonduren waarin men het kansspel bingo speelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb1d0513-2c44-4d41-beb7-a87e71091b2f",
                                "sense_id": "3e828485-c6b2-3458-a93c-947688f79051",
                                "text": "Nog niks te doen deze zaterdag en ben je de pubquizzen zat? Probeer eens een bingo! Eigenaar Willem van Munster van de cafés Good Fellows en Good Old Fellows aan de Willemstraat houdt zaterdag namelijk een digitale bingoavond. “Zo hebben we de mensen toch nog een beetje binnen.”"
                            },
                            {
                                "example_id": "58ad59d4-b1ed-4ad2-a116-742157037daa",
                                "sense_id": "3e828485-c6b2-3458-a93c-947688f79051",
                                "text": "Ik heb er werkelijk van alles aan gedaan om bij de finale aanwezig te kunnen zijn. Ineens kwam de mededeling dat er een bingoavond zou worden georganiseerd, met als hoofdprijs twee kaartjes voor Feyenoord-Celtic."
                            }
                        ]
