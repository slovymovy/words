                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5a5fea9-e48b-45b3-8632-404edde34ae4",
                                "sense_id": "3cd1e856-7031-3730-897b-707ce3e93641",
                                "text": "Herr Bartelmeß wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "0fe13a8d-f5f3-426f-ae27-690054709107",
                                "sense_id": "3cd1e856-7031-3730-897b-707ce3e93641",
                                "text": "Die Bartelmeß fliegen heute nach Stockholm."
                            },
                            {
                                "example_id": "ece9de55-6873-4a54-ac7b-110ba8bf8556",
                                "sense_id": "3cd1e856-7031-3730-897b-707ce3e93641",
                                "text": "Der Bartelmeß trägt nie die Pullover, die die Bartelmeß ihm strickt."
                            },
                            {
                                "example_id": "f1f98487-2c61-4350-8e1d-70ba8e0a0aff",
                                "sense_id": "3cd1e856-7031-3730-897b-707ce3e93641",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Bartelmeß kommt, geht der Herr Bartelmeß.“"
                            },
                            {
                                "example_id": "8d4f8e15-0077-4888-99ea-d6ba6cbff0e1",
                                "sense_id": "3cd1e856-7031-3730-897b-707ce3e93641",
                                "text": "Bartelmeß kommt und geht."
                            },
                            {
                                "example_id": "5a51cd8a-657b-422f-9acd-8b993e31d639",
                                "sense_id": "3cd1e856-7031-3730-897b-707ce3e93641",
                                "text": "Bartelmeßens kamen, sahen und siegten."
                            },
                            {
                                "example_id": "ecb765ea-bbca-4935-ac63-f4b6fb9626be",
                                "sense_id": "3cd1e856-7031-3730-897b-707ce3e93641",
                                "text": "Frau Bartelmeß ist ein Genie im Verkauf."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
