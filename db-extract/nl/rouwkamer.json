                    {
                        "translation_id": "b7afd298-cac7-4817-9172-0db188a62a9d",
                        "source_entry_id": "23fe199a-bd30-363e-a232-56a0f7b20645",
                        "source_sense_id": "f0113603-a372-3bbf-8481-43ef78001954",
                        "target_lang_word": "chapelle ardente",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chapelle ardente",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e2f1b11d-4b05-3ea6-bd2f-791cbde5d801",
                                        "entry_id": "085cdcfb-119d-3e9e-a627-69784ae1a9b8",
                                        "glosses": [
                                            "Salle où l’on veille un mort, avant ses obsèques."
                                        ],
                                        "tags": [
                                            "Funéraire"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97cf52d8-a555-4078-a856-68d0de5a0188",
                                                "sense_id": "e2f1b11d-4b05-3ea6-bd2f-791cbde5d801",
                                                "text": "Un petit clerc, son voisin, lui apprit que la vénérable relique était dans le haut de l’édifice dans une chapelle ardente."
                                            },
                                            {
                                                "example_id": "44b04cd7-2822-483b-84c5-831e345ee603",
                                                "sense_id": "e2f1b11d-4b05-3ea6-bd2f-791cbde5d801",
                                                "text": "Dom Augustin, le prieur défunt, aura, en habit de cordelier, les honneurs de la chapelle ardente ; […]"
                                            },
                                            {
                                                "example_id": "39aca9ce-7725-4895-9d9e-990ad9fc98d3",
                                                "sense_id": "e2f1b11d-4b05-3ea6-bd2f-791cbde5d801",
                                                "text": "Le prince Otto, le mélomane, est devenu fou et a mis, paraît-il, votre portrait en pied dans une chapelle ardente, où brûlent, autour d’un lit de repos, des cierges de cire jaune… et là, il soupire de l’aurore au crépuscule."
                                            },
                                            {
                                                "example_id": "583f3953-419c-493c-a9c9-d939efe8db9c",
                                                "sense_id": "e2f1b11d-4b05-3ea6-bd2f-791cbde5d801",
                                                "text": "Je voulais marcher seul ; la famille s’écarta devant moi qui avançais en vacillant. Je pus franchir le seuil de la chapelle ardente, m’accroupir sur un prie-Dieu."
                                            },
                                            {
                                                "example_id": "66f3d1f7-df25-43a3-abc9-ac9dde36122e",
                                                "sense_id": "e2f1b11d-4b05-3ea6-bd2f-791cbde5d801",
                                                "text": "La tante P., veuve du député orléaniste, garde le cœur de son fils, mort consul en Chine, dans un vase de cristal à ornements dorés ; ce boudoir de dévote est une chapelle ardente."
                                            },
                                            {
                                                "example_id": "a346e380-d401-4aff-a40e-55007f1f23b6",
                                                "sense_id": "e2f1b11d-4b05-3ea6-bd2f-791cbde5d801",
                                                "text": "Mathieu Paoli se souvient comme si c’était hier, de ce moment où, deux jours après la tragédie, le vendredi 13 septembre 1968, il s’était retrouvé dans le hall d’Orly avec les autres familles. Un avion avait été affrété pour eux à destination de Nice, où une chapelle ardente avait été dressée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
