                                        "sense_id": "015079ef-093b-37b1-91dd-eead40f4e3a5",
                                        "entry_id": "fe84bb8e-9f82-33c1-86ba-2c0444075c3b",
                                        "glosses": [
                                            "simple past and past participle of unbias"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "participle",
                                            "past"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6cef0a25-3227-4e10-b5b3-092dccfb6955",
                                                "sense_id": "015079ef-093b-37b1-91dd-eead40f4e3a5",
                                                "text": "But, as we have hinted before in relation to Dr. Beeching's appointment, our increasing conviction is that British Railway's greatest need at the moment is of strong, unbiassed direction from the top."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
