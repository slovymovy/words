                ],
                "senses": [
                    {
                        "sense_id": "6213e6c7-69ea-3870-9abb-843e1a639a6f",
                        "entry_id": "131ae1e0-d305-3973-a351-064b2c0bc6dc",
                        "glosses": [
                            "Relations et sentiments qui existent entre confrères."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5da5fff6-76a4-4fb2-bb05-4ea5369adf38",
                                "sense_id": "6213e6c7-69ea-3870-9abb-843e1a639a6f",
                                "text": "Mirabeau mourut sur ces entrefaites. La confraternité de la débauche, mieux que celle du talent, avait depuis peu réuni ces deux hommes."
                            },
                            {
                                "example_id": "0a70f986-8649-4bef-b44c-ccdbe20fcc88",
                                "sense_id": "6213e6c7-69ea-3870-9abb-843e1a639a6f",
                                "text": "Dans le respect des obligations de la mission de contrôle légal, les commissaires aux comptes entretiennent entre eux des rapports de confraternité. Ils se gardent de tout acte ou propos déloyal à l'égard d'un confrère ou susceptible de ternir l'image de la profession."
                            }
                        ]
                    },
                    {
                        "sense_id": "f43485b2-723a-3a92-9add-813f35b6cc2e",
                        "entry_id": "131ae1e0-d305-3973-a351-064b2c0bc6dc",
                        "glosses": [
                            "Affinités qui existent entre deux personnes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82834032-560c-433b-82d5-6eab700a837b",
                                "sense_id": "f43485b2-723a-3a92-9add-813f35b6cc2e",
                                "text": "Ce ne fut pas non plus sans une vive et profonde satisfaction qu’il reconnut, à l’inspection de la chambre à coucher, une parfaite confraternité de goûts et de sentiments à l’endroit des ameublements et des constructions intérieures."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3ca5ff79-b8ed-461b-9c7f-25a4e4513edc",
                        "source_entry_id": "131ae1e0-d305-3973-a351-064b2c0bc6dc",
