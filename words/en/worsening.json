{
    "word_family": [
        "worse",
        "worsen"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5a1305f3-7fbc-327b-a7f6-2835299f37a7",
                    "sense_definition": "The present participle and gerund of <w>worsen</w>",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "change",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The weather is <w>worsening</w> rapidly as the storm approaches the coast.",
                            "target_lang_translations": {
                                "ru": "Погода <w>быстро ухудшается</w>, по мере того как шторм приближается к побережью."
                            }
                        },
                        {
                            "text": "He is <w>worsening</w> the situation by refusing to listen to any advice.",
                            "target_lang_translations": {
                                "ru": "Он <w>ухудшает</w> ситуацию, отказываясь прислушиваться к любым советам."
                            }
                        }
                    ],
                    "common_phrases": [
                        "rapidly worsening",
                        "worsening situation"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "This is a grammatical form of the verb worsen."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс становления хуже или действие, приводящее к ухудшению чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ухудшающийся",
                                "target_lang_sense_clarification": "причастие, описывающее процесс становления хуже"
                            },
                            {
                                "target_lang_word": "ухудшение",
                                "target_lang_sense_clarification": "процесс или действие, ведущее к снижению качества"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c61279f8-1841-326c-a073-bda7a168f03e",
                    "sense_definition": "A state of becoming worse or a situation that has deteriorated.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "change",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden <w>worsening</w> of his health concerned the doctors greatly.",
                            "target_lang_translations": {
                                "ru": "Внезапное <w>ухудшение</w> его здоровья сильно обеспокоило врачей."
                            }
                        },
                        {
                            "text": "There has been a noticeable <w>worsening</w> in the quality of service lately.",
                            "target_lang_translations": {
                                "ru": "В последнее время наблюдается заметное <w>ухудшение</w> качества обслуживания."
                            }
                        }
                    ],
                    "synonyms": [
                        "deterioration",
                        "aggravation",
                        "decline"
                    ],
                    "antonyms": [
                        "improvement",
                        "amelioration"
                    ],
                    "common_phrases": [
                        "noticeable worsening",
                        "sudden worsening"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние, при котором качество или ситуация стали хуже; процесс деградации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ухудшение",
                                "target_lang_sense_clarification": "состояние или результат процесса снижения качества"
                            },
                            {
                                "target_lang_word": "деградация",
                                "target_lang_sense_clarification": "процесс постепенного ухудшения состояния или качества"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}