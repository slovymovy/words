                "senses": [
                    {
                        "sense_id": "99376bd7-0df9-3b4c-a391-d3918b467d71",
                        "entry_id": "6e72d412-c7fe-3c21-82d3-dbf50da07ef7",
                        "glosses": [
                            "Symbole dessiné d’un esprit."
                        ],
                        "tags": [
                            "Vaudou"
                        ],
                        "examples": [
                            {
                                "example_id": "b418aeb7-59bd-4eda-a5bb-3018d193ccde",
                                "sense_id": "99376bd7-0df9-3b4c-a391-d3918b467d71",
                                "text": "Dans l’interprétation des vévé, il s’est aussi beaucoup appuyé sur l’écriture égyptienne."
                            },
                            {
                                "example_id": "26ee4bdd-c1cb-4caf-a531-2a10ed23bb7b",
                                "sense_id": "99376bd7-0df9-3b4c-a391-d3918b467d71",
                                "text": "Il avait esquissé sur le carré de papier des emblèmes évoquant des designs pour fer forgé : des vévés."
                            },
                            {
                                "example_id": "51466951-2c74-4267-af6a-ac79a97a0ddf",
                                "sense_id": "99376bd7-0df9-3b4c-a391-d3918b467d71",
                                "text": "Les dessins au sol s’appellent des vévés et aident à établir un lien mystique avec les esprits que l’on désigne sous le terme Lwas."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cc032dd0-9ff9-40c3-b440-da640d33b4e1",
                        "source_entry_id": "6e72d412-c7fe-3c21-82d3-dbf50da07ef7",
                        "source_sense_id": "99376bd7-0df9-3b4c-a391-d3918b467d71",
                        "target_lang_word": "veve",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "veve",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1122b671-fc8a-3e79-a0f2-7d916e0229a8",
                                        "entry_id": "a2620bac-a21b-3ca4-bf5d-1974df4716eb",
                                        "glosses": [
                                            "Any of various symbols, like line diagrams, that have religious significance in voodoo, serving as a representation of the loa."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8428306-2a63-4f7c-b95c-17b98f00bca4",
                                                "sense_id": "1122b671-fc8a-3e79-a0f2-7d916e0229a8",
                                                "text": "The vever, as a cabbala-like method of invoking the gods, was included as a primary ceremonial device in Rada."
                                            },
                                            {
                                                "example_id": "7375e50d-0d00-4951-992d-e278fa65ab80",
                                                "sense_id": "1122b671-fc8a-3e79-a0f2-7d916e0229a8",
                                                "text": "The vèvè for Simbi, lord of healing, bristles with all sorts of allusions to the Kongo medicines of God, leaves, horns, water, and stars."
                                            },
                                            {
                                                "example_id": "8573e195-7aac-4ead-8ee0-214d1c4d03be",
                                                "sense_id": "1122b671-fc8a-3e79-a0f2-7d916e0229a8",
                                                "text": "The indigenous practice of sand painting was preserved in the practice of creating vévés, intricate drawings in cornmeal that were used to call various spirits."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
