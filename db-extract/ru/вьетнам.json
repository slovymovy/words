                                        "sense_id": "949d736e-2f20-3ec6-bcec-0ecd920912dd",
                                        "entry_id": "49f1a31b-01ad-3e49-bf29-5f377af8ee91",
                                        "glosses": [
                                            "A place that is very dangerous, especially if afflicted by violence."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d48e8094-84d3-4030-ad84-b77523aeb36e",
                                                "sense_id": "949d736e-2f20-3ec6-bcec-0ecd920912dd",
                                                "text": "Welcome back to Vietnam, California."
                                            },
                                            {
                                                "example_id": "785a80af-bc7c-4318-b5aa-686ae795c328",
                                                "sense_id": "949d736e-2f20-3ec6-bcec-0ecd920912dd",
                                                "text": "Vietnam, California, back in and on a mission."
                                            }
                                        ]
                                    },
