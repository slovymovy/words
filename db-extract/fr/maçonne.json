                        ],
                        "form": "maçon"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2976aba6-6b66-36e8-b03e-442b7be0ebe3",
                        "entry_id": "e93f9ae3-7c85-37a9-b479-90a6dbc5aa0d",
                        "glosses": [
                            "Ouvrière qui fait tous les ouvrages où il entre de la pierre, de la brique, du mortier, de la chaux dans le gros œuvre."
                        ],
                        "tags": [
                            "Métier"
                        ],
                        "examples": [
                            {
                                "example_id": "b2ed42fc-7a56-4385-8dbd-c72a5d2bb160",
                                "sense_id": "2976aba6-6b66-36e8-b03e-442b7be0ebe3",
                                "text": "Elle ressemblait autant à une maçonne que moi à une danseuse nue du Lido."
                            },
                            {
                                "example_id": "9730ef30-137e-4b63-a1b0-504f07308c44",
                                "sense_id": "2976aba6-6b66-36e8-b03e-442b7be0ebe3",
                                "text": "En ville, les femmes exercent quantité de métiers : un recensement fait au début du xivᵉ siècle en dénombre 125 ! Broderesses, chasublières, ferronnes, maçonnes, charretières, hongresses, lavandières de tête."
                            }
                        ]
                    },
                    {
                        "sense_id": "a2662faf-eb38-3319-a21c-fe28007c88f1",
                        "entry_id": "e93f9ae3-7c85-37a9-b479-90a6dbc5aa0d",
                        "glosses": [
                            "Franc-maçonne."
                        ],
                        "tags": [
                            "Franc-maçonnerie"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "02d38b3f-57da-48ef-ba23-cb5d34614475",
                        "source_entry_id": "e93f9ae3-7c85-37a9-b479-90a6dbc5aa0d",
                        "source_sense_description": "Ouvrière",
                        "target_lang_word": "Maurerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Maurerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "78fe86fb-11af-3439-a011-c08b137f187f",
                                        "entry_id": "28840035-062c-3ac6-a76e-f5ae452be0ae",
                                        "glosses": [
                                            "Bauhandwerkerin, die mauert und verputzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a54ba438-e656-435a-bd0d-31df3e75adf1",
                                                "sense_id": "78fe86fb-11af-3439-a011-c08b137f187f",
                                                "text": "Frau Schneider ist doch gelernte Maurerin."
                                            },
                                            {
                                                "example_id": "df500ba7-423a-44b9-8899-460ef4b79e2d",
                                                "sense_id": "78fe86fb-11af-3439-a011-c08b137f187f",
                                                "text": "„Ich kenne in ganz Berlin nicht eine Maurerin oder Zimmerfrau.“"
                                            },
                                            {
                                                "example_id": "78ef40b0-0877-4b74-b22b-bed65f5c4664",
                                                "sense_id": "78fe86fb-11af-3439-a011-c08b137f187f",
                                                "text": "„Im Osten bot man Trümmerfrauen Umschulungen an: Aus ungelernten Hilfsarbeiterinnen sollten Maurerinnen und Zimmerinnen werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Maurerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "177db60e-b4d8-3011-afdc-d89a93dceb1a",
                                        "entry_id": "edef9832-2bb8-3003-8531-1d4ef5982533",
                                        "glosses": [
                                            "Frau, die in der liechtensteinischen Gemeinde Mauren lebt oder dort geboren ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0cff9aad-3199-416e-8a6d-2c6f24659424",
                                                "sense_id": "177db60e-b4d8-3011-afdc-d89a93dceb1a",
                                                "text": "„Am Nachmittag kehrte die Maurerin den Spiess um und lag am Ende mit der exakt gleichen Differenz gegenüber der Salzburgerin im Vorteil.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
