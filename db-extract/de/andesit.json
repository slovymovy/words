                        "entry_id": "7abf607c-ee08-340f-997a-59828adc426e",
                        "glosses": [
                            "graues, magmatisches Ergussgestein, das sich hauptsächlich aus Plagioklas und Amphibol oder Pyroxen zusammensetzt und als Baumaterial verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1255fca7-84cd-4e03-80a2-5457e6f428f9",
                                "sense_id": "8cd25545-33e1-3eaa-b7f0-b222f50b3183",
                                "text": "„Das Vorhandensein von Andesiten würde bedeuten, daß der Mars in seiner Vergangenheit thermisch aktiver war als bisher angenommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
