                    {
                        "translation_id": "474c2241-ce0f-49e0-ba7d-4ebc15b49aa1",
                        "source_entry_id": "1b9e52f4-76de-3b39-9946-989fefc4b9d5",
                        "source_sense_id": "b13825fa-218c-3f53-a20d-02b10bbd7a46",
                        "target_lang_word": "Bescheidenheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bescheidenheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8265b149-5477-3206-adbe-34b4a9ead0d5",
                                        "entry_id": "78183a6a-3bff-357d-b74e-29ffd96d472b",
                                        "glosses": [
                                            "unaufdringliche Zurückhaltung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef500d5f-fa03-42b8-bad5-e9398d7a33ca",
                                                "sense_id": "8265b149-5477-3206-adbe-34b4a9ead0d5",
                                                "text": "Diese Bescheidenheit war für einen erfolgreichen Geschäftsmann ungewöhnlich."
                                            },
                                            {
                                                "example_id": "e12f6eb9-9728-42ac-9800-40ba7d344f5f",
                                                "sense_id": "8265b149-5477-3206-adbe-34b4a9ead0d5",
                                                "text": "„Bescheidenheit lehrt ein kurzer Rückblick auf die reichhaltigen Überlieferungen aus früheren Epochen.“"
                                            },
                                            {
                                                "example_id": "9eeb4da5-fc9a-4f7b-9e3b-a7b1aaed5441",
                                                "sense_id": "8265b149-5477-3206-adbe-34b4a9ead0d5",
                                                "text": "„Bescheidenheit ist eine Zier, doch weiter kommt man ohne ihr.“ (Erich Kästner)"
                                            },
                                            {
                                                "example_id": "95251b7b-d8b0-43f2-afa4-fb186d91af38",
                                                "sense_id": "8265b149-5477-3206-adbe-34b4a9ead0d5",
                                                "text": "„Was die Wirkung oder Wirkungen von Sprachkritik und populärer Stillehre auf den allgemeinen Sprachgebrauch betrifft, scheint in der Tat Bescheidenheit angebracht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9207623d-ef76-4fa5-9648-8b727ff6ab51",
                        "source_entry_id": "1b9e52f4-76de-3b39-9946-989fefc4b9d5",
                        "source_sense_id": "b13825fa-218c-3f53-a20d-02b10bbd7a46",
                        "target_lang_word": "Demut",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Demut",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e65540ce-100f-33ee-acc0-0d3e410557e3",
                                        "entry_id": "798d72cc-68ba-3b33-8179-2180e21c66fc",
                                        "glosses": [
                                            "vor allem religiös geprägte Geisteshaltung, bei der sich der Mensch in Erkenntnis der eigenen Unvollkommenheit dem göttlichen Willen unterwirft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c51f715-7bb4-4eb7-b7e0-b2b201558e0a",
                                                "sense_id": "e65540ce-100f-33ee-acc0-0d3e410557e3",
                                                "text": "Was nützt es in Demut zu wandeln, wenn man nicht weiß wohin?"
                                            },
                                            {
                                                "example_id": "a449b8e7-f0fe-4c01-8c79-9c8175144724",
                                                "sense_id": "e65540ce-100f-33ee-acc0-0d3e410557e3",
                                                "text": "„Zur Anmut gehören Beiläufigkeit, Ungekünsteltheit, Nonchalance, Sprezzatura; und wenn sie in Begleitung ihrer Schwester, der Demut, auftritt, ist sie unbesiegbar.“"
                                            },
                                            {
                                                "example_id": "d35e04ab-ea0a-4346-ba79-c11ad9a149f4",
                                                "sense_id": "e65540ce-100f-33ee-acc0-0d3e410557e3",
                                                "text": "„Der Mangel an Demut ist es, worüber sich Isaac Asimov bitterlich beklagt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fa07e9ea-e765-396c-90c9-4e3ed16c23bd",
                                        "entry_id": "798d72cc-68ba-3b33-8179-2180e21c66fc",
                                        "glosses": [
                                            "das Zurückzunehmen der eigenen Interessen gegenüber einer höheren Macht oder gegenüber einer Gemeinschaft"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
