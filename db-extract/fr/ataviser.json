                        "glosses": [
                            "Donner un caractère atavique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ba70ab7-9a29-4fdc-8eaf-862a76a49b10",
                                "sense_id": "90a6446a-31f1-3b62-a75d-14762695b500",
                                "text": "J’applaudis des deux mains, en atavisant sans doute inconsciemment, avant de partir vite les nettoyer, vu tout ce que mes mains ont dû s’échanger lors de cette séquence !"
                            },
                            {
                                "example_id": "c5dfba06-cf2c-42bf-b8fa-1598df0f6e0f",
                                "sense_id": "90a6446a-31f1-3b62-a75d-14762695b500",
                                "text": "J’observe à présent que cela s’“atavise” depuis 2001. L’époque devient atavique"
                            }
                        ]
                    }
