                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c64487ba-b3dd-4928-b965-bd211babee72",
                                "sense_id": "ba5eb3bd-f590-35f6-8b48-9e50e149da0d",
                                "text": "„In dieser Welt der kegelförmigen Hüte und Degen, der Stickerei und schneeweißen Perücken gab es nur Kopfsteinpflaster, über das viele Vollblutpferde trabten und zahlreiche vergoldete Kutschen klapperten, sowie Gehsteige aus Ziegeln mit Böcken zum Aufsteigen und Pfosten zum Anbinden von Pferden.“"
                            },
                            {
                                "example_id": "b9a28782-92b0-474d-aa4d-a2b29ef9fcc0",
                                "sense_id": "ba5eb3bd-f590-35f6-8b48-9e50e149da0d",
                                "text": "„Dem Architectural Digest zufolge sind große Villen inmitten riesiger Gärten und Farmen für Vollblutpferde echt gute Wohnsitze.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
