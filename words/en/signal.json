{
    "word_family": [
        "signaler",
        "signaling",
        "signaller",
        "signalling",
        "signalman",
        "signalize",
        "signally"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "20eddf08-28b8-3c77-b107-91c6de03fc30",
                    "sense_definition": "A sign made to give notice of some occurrence, command, or danger, or to indicate the start of a concerted action.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "communication_sign",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The referee blew his whistle to give the <w>signal</w> for the game to start.",
                            "target_lang_translations": {
                                "ru": "Судья дунул в свисток, чтобы дать <w>сигнал</w> к началу игры."
                            }
                        },
                        {
                            "text": "We waited for a hand <w>signal</w> before we began to move the heavy equipment.",
                            "target_lang_translations": {
                                "ru": "Мы ждали <w>знака</w> рукой, прежде чем начать перемещать тяжелое оборудование."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hand signal",
                        "give the signal",
                        "wait for a signal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Знак, подаваемый для уведомления о каком-либо событии, команде или опасности, либо для указания начала согласованного действия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сигнал",
                                "target_lang_sense_clarification": "оповещающий знак"
                            },
                            {
                                "target_lang_word": "знак",
                                "target_lang_sense_clarification": "жест или пометка для передачи смысла"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c278cddc-4371-3349-9ca3-a44df09aa50d",
                    "sense_definition": "An electromagnetic action, normally a voltage that is a function of time, that conveys the information of the radio or TV program or of communication with another party.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "technical_transmission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My mobile phone can't get a <w>signal</w> in the railway station.",
                            "target_lang_translations": {
                                "ru": "Мой мобильный телефон не ловит <w>сигнал</w> на вокзале."
                            }
                        },
                        {
                            "text": "The television <w>signal</w> is very weak because of the heavy storm outside.",
                            "target_lang_translations": {
                                "ru": "Телевизионный <w>сигнал</w> очень слабый из-за сильного шторма на улице."
                            }
                        }
                    ],
                    "common_phrases": [
                        "phone signal",
                        "radio signal",
                        "weak signal",
                        "strong signal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Электромагнитное воздействие (обычно напряжение как функция времени), передающее информацию радио- или телепрограммы или связи с другой стороной."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сигнал",
                                "target_lang_sense_clarification": "радио, ТВ или телефонная связь"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7fcdc0aa-22a7-3d73-bbea-90d002b8ed91",
                    "sense_definition": "An on-off light, semaphore, or other device used to give an indication to another person.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "signaling_device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The driver stopped the car because the traffic <w>signal</w> turned red.",
                            "target_lang_translations": {
                                "ru": "Водитель остановил машину, потому что <w>сигнал</w> светофора стал красным."
                            }
                        },
                        {
                            "text": "The train had to wait at the railway <w>signal</w> until the track was clear.",
                            "target_lang_translations": {
                                "ru": "Поезду пришлось ждать у железнодорожного <w>семафора</w>, пока путь не освободится."
                            }
                        }
                    ],
                    "common_phrases": [
                        "traffic signal",
                        "railway signal",
                        "smoke signal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Световой индикатор, семафор или другое устройство, используемое для подачи указаний другому лицу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сигнал",
                                "target_lang_sense_clarification": "световой или технический индикатор"
                            },
                            {
                                "target_lang_word": "семафор",
                                "target_lang_sense_clarification": "железнодорожный или морской указатель"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9f3afb9c-83bc-3151-ac05-1a5b597409aa",
                    "sense_definition": "A token; an indication; a foreshadowing; a sign.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "indication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden drop in stock prices was a clear <w>signal</w> of economic trouble.",
                            "target_lang_translations": {
                                "ru": "Внезапное падение цен на акции стало четким <w>сигналом</w> экономических проблем."
                            }
                        },
                        {
                            "text": "The dark clouds were a <w>signal</w> of a goodly day to-morrow being unlikely.",
                            "target_lang_translations": {
                                "ru": "Темные тучи были <w>знаком</w> того, что завтра вряд ли будет погожий день."
                            }
                        }
                    ],
                    "common_phrases": [
                        "clear signal",
                        "send a signal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Признак, указание или предвестие чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "знак",
                                "target_lang_sense_clarification": "предвестие или симптом"
                            },
                            {
                                "target_lang_word": "сигнал",
                                "target_lang_sense_clarification": "предупреждающий признак"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4d34c3c2-df57-3753-8e18-be0457fd41e9",
                    "sense_definition": "Useful information, as opposed to noise.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "information_theory",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In this data set, it is difficult to separate the <w>signal</w> from the noise.",
                            "target_lang_translations": {
                                "ru": "В этом наборе данных трудно отделить <w>сигнал</w> от шума."
                            }
                        },
                        {
                            "text": "The analyst looked for a meaningful <w>signal</w> amidst the random fluctuations of the market.",
                            "target_lang_translations": {
                                "ru": "Аналитик искал значимый <w>сигнал</w> среди случайных колебаний рынка."
                            }
                        }
                    ],
                    "antonyms": [
                        "noise"
                    ],
                    "common_phrases": [
                        "signal to noise ratio"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical context in statistics or engineering"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Полезная информация в противопоставление шуму."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сигнал",
                                "target_lang_sense_clarification": "полезная информация в данных"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9638a4cc-8eb5-3e64-886e-f5c2f4a05128",
                    "sense_definition": "To indicate; to convey or communicate by a signal.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "to_indicate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He whistled to <w>signal</w> that we should stop walking immediately.",
                            "target_lang_translations": {
                                "ru": "Он свистнул, чтобы <w>просигнализировать</w>, что нам нужно немедленно остановиться."
                            }
                        },
                        {
                            "text": "The driver used his blinker to <w>signal</w> a turn to the left.",
                            "target_lang_translations": {
                                "ru": "Водитель включил поворотник, чтобы <w>показать</w> поворот налево."
                            }
                        }
                    ],
                    "common_phrases": [
                        "signal a turn",
                        "signal for help"
                    ],
                    "target_lang_definitions": {
                        "ru": "Указывать, передавать или сообщать информацию с помощью сигнала."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сигнализировать",
                                "target_lang_sense_clarification": "подавать сигнал"
                            },
                            {
                                "target_lang_word": "подавать сигнал",
                                "target_lang_sense_clarification": "сообщать жестом или звуком"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5b27204c-009c-3f02-a670-65a1dd79d5bc",
                    "sense_definition": "To communicate with (a person or system) by a signal.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "to_indicate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ship's captain <w>signalled</w> the shore to request permission to dock.",
                            "target_lang_translations": {
                                "ru": "Капитан корабля <w>подал сигнал</w> на берег, чтобы запросить разрешение на швартовку."
                            }
                        },
                        {
                            "text": "Seeing the flames, he ran to the control room and <w>signalled</w> headquarters.",
                            "target_lang_translations": {
                                "ru": "Увидев пламя, он побежал в диспетчерскую и <w>сообщил</w> в штаб."
                            }
                        }
                    ],
                    "common_phrases": [
                        "signal headquarters"
                    ],
                    "target_lang_definitions": {
                        "ru": "Связываться с человеком или системой посредством сигнала."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "просигнализировать",
                                "target_lang_sense_clarification": "известить сигналом"
                            },
                            {
                                "target_lang_word": "подать сигнал",
                                "target_lang_sense_clarification": "уведомить кого-либо"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2c3211c9-4bea-3677-8881-b70afa87ac20",
                    "sense_definition": "Standing above others in rank, importance, or achievement.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "notable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The charity event was a <w>signal</w> success, raising more money than ever before.",
                            "target_lang_translations": {
                                "ru": "Благотворительное мероприятие имело <w>выдающийся</w> успех, собрав больше денег, чем когда-либо прежде."
                            }
                        },
                        {
                            "text": "Winning the Nobel Prize was a <w>signal</w> achievement in her long scientific career.",
                            "target_lang_translations": {
                                "ru": "Получение Нобелевской премии стало <w>значительным</w> достижением в её долгой научной карьере."
                            }
                        }
                    ],
                    "synonyms": [
                        "eminent",
                        "noteworthy",
                        "significant",
                        "important",
                        "notable"
                    ],
                    "common_phrases": [
                        "signal success",
                        "signal achievement",
                        "signal honor"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary or formal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выдающийся, превосходящий других по рангу, важности или достижениям."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выдающийся",
                                "target_lang_sense_clarification": "значительный, заметный"
                            },
                            {
                                "target_lang_word": "значительный",
                                "target_lang_sense_clarification": "важный, примечательный"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}