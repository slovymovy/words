{
    "word_family": [
        "benefaction",
        "benefactress",
        "beneficent",
        "beneficence",
        "benefit"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7d0ce915-8b54-3e7f-ba19-e85014277044",
                    "sense_definition": "A person who provides financial or other support, often by donating money to a person, cause, or charity.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "helper",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local museum received a massive donation from an anonymous <w>benefactor</w>.",
                            "target_lang_translations": {
                                "ru": "Местный музей получил крупное пожертвование от анонимного <w>благотворителя</w>."
                            }
                        },
                        {
                            "text": "The student was able to attend university thanks to a generous <w>benefactor</w>.",
                            "target_lang_translations": {
                                "ru": "Студент смог учиться в университете благодаря щедрому <w>покровителю</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "patron",
                        "donor",
                        "sponsor",
                        "supporter"
                    ],
                    "common_phrases": [
                        "anonymous benefactor",
                        "generous benefactor",
                        "chief benefactor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, оказывающий финансовую или иную поддержку, часто делая пожертвования человеку, организации или благотворительному фонду."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "благотворитель",
                                "target_lang_sense_clarification": "лицо, жертвующее средства или имущество"
                            },
                            {
                                "target_lang_word": "меценат",
                                "target_lang_sense_clarification": "покровитель культуры, искусства или науки"
                            },
                            {
                                "target_lang_word": "пожертвователь",
                                "target_lang_sense_clarification": "человек, сделавший пожертвование"
                            },
                            {
                                "target_lang_word": "благодетель",
                                "target_lang_sense_clarification": "человек, оказавший материальную помощь или поддержку"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "68cf7f9f-f03e-3dc6-b4cb-2b47597128e1",
                    "sense_definition": "Someone who performs good deeds or helps others, not necessarily with money.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "helper",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor was regarded as a true <w>benefactor</w> of humanity for his life-saving discoveries.",
                            "target_lang_translations": {
                                "ru": "Доктора считали истинным <w>благодетелем</w> человечества за его открытия, спасшие множество жизней."
                            }
                        },
                        {
                            "text": "Throughout his life, he acted as a selfless <w>benefactor</w> to the impoverished villagers.",
                            "target_lang_translations": {
                                "ru": "На протяжении всей своей жизни он был бескорыстным <w>благодетелем</w> для бедных жителей деревни."
                            }
                        }
                    ],
                    "synonyms": [
                        "well-doer",
                        "helper"
                    ],
                    "common_phrases": [
                        "benefactor of humanity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, совершающий добрые дела или помогающий другим людям, не обязательно деньгами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "благодетель",
                                "target_lang_sense_clarification": "тот, кто делает добро или оказывает покровительство"
                            },
                            {
                                "target_lang_word": "покровитель",
                                "target_lang_sense_clarification": "заступник, защитник, оказывающий поддержку"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}