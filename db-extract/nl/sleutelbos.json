                        "glosses": [
                            "aantal sleutels dat aan eenzelfde ring of band hangt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c57b8a4c-dc05-472b-8822-879456396826",
                                "sense_id": "b534dcec-99bb-328b-99f9-fe5e28d7289e",
                                "text": "Verlies je sleutelbos niet! Je zou je auto niet meer in kunnen."
                            }
