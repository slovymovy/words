                "senses": [
                    {
                        "sense_id": "f41362a6-2a8a-3ab7-b319-b88c1692fe2c",
                        "entry_id": "d1a2ebd0-782d-333e-81d3-27272af56f05",
                        "glosses": [
                            "Risquer à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b368a653-2779-4906-b865-8cc45516be32",
                                "sense_id": "f41362a6-2a8a-3ab7-b319-b88c1692fe2c",
                                "text": "Car, quand à la quatrième minute de la deuxième mi-temps l'arbitre siffle un penalty pour Munich, Scholl n'ose pas s'y rerisquer."
                            },
                            {
                                "example_id": "ef0efab6-68a1-4a1a-8261-98b7b703f9f4",
                                "sense_id": "f41362a6-2a8a-3ab7-b319-b88c1692fe2c",
                                "text": "J'ai donc passé ma jeunesse à me débattre dans les affres de l'humiliation toupettale et je me suis jurée de ne pas m'y rerisquer de sitôt."
                            },
                            {
                                "example_id": "a4cf3632-a636-4623-ba30-a3925b0180e6",
                                "sense_id": "f41362a6-2a8a-3ab7-b319-b88c1692fe2c",
                                "text": "De très bonnes surprises mais je trouve le risque trop important pour m'y rerisquer."
                            }
                        ]
                    }
