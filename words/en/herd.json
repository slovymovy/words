{
    "word_family": [
        "herder",
        "herdsman"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0b42047e-441f-3ae7-af78-47c2eb7ddc07",
                    "sense_definition": "A large group of animals of the same type that live, feed, or travel together.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "group_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer keeps a large <w>herd</w> of cattle in the north field.",
                            "target_lang_translations": {
                                "ru": "Фермер держит большое <w>стадо</w> крупного рогатого скота на северном поле.",
                                "zh": "农夫在北边的田里养了一大<w>群</w>牛。"
                            }
                        },
                        {
                            "text": "We watched a <w>herd</w> of elephants cross the river during our safari.",
                            "target_lang_translations": {
                                "ru": "Мы наблюдали, как <w>стадо</w> слонов переходит реку во время нашего сафари.",
                                "zh": "在游猎途中，我们看到一<w>群</w>大象穿过河流。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "herd of cattle",
                        "herd of elephants",
                        "herd of sheep"
                    ],
                    "target_lang_definitions": {
                        "ru": "Большая группа животных одного вида, которые живут, кормятся или передвигаются вместе.",
                        "zh": "指一群同类的动物，它们一起生活、觅食或迁徙。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стадо",
                                "target_lang_sense_clarification": "общее название для группы животных"
                            },
                            {
                                "target_lang_word": "табун",
                                "target_lang_sense_clarification": "лошадей или оленей"
                            },
                            {
                                "target_lang_word": "гурт",
                                "target_lang_sense_clarification": "крупного рогатого скота или овец"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "兽群",
                                "target_lang_sense_clarification": "指一群动物"
                            },
                            {
                                "target_lang_word": "畜群",
                                "target_lang_sense_clarification": "指一群家畜"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8012dfd7-71a7-327d-a96d-992e12abfaaa",
                    "sense_definition": "A large group of people, often implying that they are acting blindly or without independent thought.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "group_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I prefer to think for myself rather than just follow the <w>herd</w>.",
                            "target_lang_translations": {
                                "ru": "Я предпочитаю думать своей головой, а не просто следовать за <w>стадом</w>.",
                                "zh": "我更喜欢独立思考，而不是盲目<w>随大流</w>。"
                            }
                        },
                        {
                            "text": "A <w>herd</w> of shoppers rushed into the store as soon as the doors opened.",
                            "target_lang_translations": {
                                "ru": "<w>Толпа</w> покупателей устремилась в магазин, как только открылись двери.",
                                "zh": "商店门一开，一<w>群</w>顾客就涌了进去。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "follow the herd",
                        "common herd"
                    ],
                    "target_lang_definitions": {
                        "ru": "Большая группа людей; часто подразумевается, что они действуют слепо или бездумно.",
                        "zh": "指一大群人，通常暗示他们盲目行事或缺乏独立思考。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стадо",
                                "target_lang_sense_clarification": "пренебрежительно, о бездумной массе людей"
                            },
                            {
                                "target_lang_word": "толпа",
                                "target_lang_sense_clarification": "большое скопление людей"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "乌合之众",
                                "target_lang_sense_clarification": "贬义，指盲目跟风的人群"
                            },
                            {
                                "target_lang_word": "人群",
                                "target_lang_sense_clarification": "指一大群人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "50b82f09-1443-309f-8f5e-d9523b3f9987",
                    "sense_definition": "A person who looks after a group of domestic animals.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "person_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old <w>herd</w> spent his days watching over the sheep on the hillside.",
                            "target_lang_translations": {
                                "ru": "Старый <w>пастух</w> проводил дни, присматривая за овцами на склоне холма.",
                                "zh": "那位老<w>牧人</w>整天在山坡上照看羊群。"
                            }
                        },
                        {
                            "text": "He was employed as a <w>herd</w> to protect the goats from wolves.",
                            "target_lang_translations": {
                                "ru": "Его наняли <w>пастухом</w>, чтобы защищать коз от волков.",
                                "zh": "他被雇来当<w>牧人</w>，以保护山羊免受狼群袭击。"
                            }
                        }
                    ],
                    "synonyms": [
                        "herder",
                        "herdsman"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Modern English typically uses 'herder' or 'herdsman'."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который присматривает за группой домашних животных.",
                        "zh": "照看一群家畜的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пастух",
                                "target_lang_sense_clarification": "человек, пасущий скот"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "牧人",
                                "target_lang_sense_clarification": "放牧牲畜的人"
                            },
                            {
                                "target_lang_word": "牧民",
                                "target_lang_sense_clarification": "以放牧为生的人"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5898ee11-e406-331c-a23e-49a2084f1000",
                    "sense_definition": "To make a group of animals or people move together to a specific place.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "action_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teachers <w>herded</w> the students into the auditorium for the assembly.",
                            "target_lang_translations": {
                                "ru": "Учителя <w>согнали</w> учеников в актовый зал на собрание.",
                                "zh": "老师们把学生<w>赶</w>进礼堂参加集会。"
                            }
                        },
                        {
                            "text": "The sheepdogs <w>herded</w> the flock into the pen before nightfall.",
                            "target_lang_translations": {
                                "ru": "Овчарки <w>загнали</w> отару в загон до наступления темноты.",
                                "zh": "牧羊犬在天黑前把羊群<w>赶</w>进了圈里。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "herd together"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заставлять группу животных или людей двигаться вместе в определенное место.",
                        "zh": "驱赶一群动物或人到特定地点。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сгонять",
                                "target_lang_sense_clarification": "собирать в одно место"
                            },
                            {
                                "target_lang_word": "загонять",
                                "target_lang_sense_clarification": "направлять внутрь чего-либо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "驱赶",
                                "target_lang_sense_clarification": "使动物或人移动"
                            },
                            {
                                "target_lang_word": "赶",
                                "target_lang_sense_clarification": "驱使移动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e86dfced-4f9d-3201-af8a-b935473d2cdf",
                    "sense_definition": "To manage, care for, or look after a group of livestock.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "action_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was hired to <w>herd</w> the goats and ensure they did not wander off.",
                            "target_lang_translations": {
                                "ru": "Его наняли <w>пасти</w> коз и следить, чтобы они не разбрелись.",
                                "zh": "他被雇来<w>放牧</w>山羊，并确保它们不会走失。"
                            }
                        },
                        {
                            "text": "Generations of his family have <w>herded</w> cattle on these plains.",
                            "target_lang_translations": {
                                "ru": "Поколения его семьи <w>пасли</w> скот на этих равнинах.",
                                "zh": "他的家族几代人都在这些平原上<w>放牧</w>牛群。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Управлять, заботиться или присматривать за группой домашнего скота.",
                        "zh": "管理、照料或看管一群牲畜。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пасти",
                                "target_lang_sense_clarification": "присматривать за животными на пастбище"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "放牧",
                                "target_lang_sense_clarification": "在草地上看管牲畜"
                            },
                            {
                                "target_lang_word": "牧",
                                "target_lang_sense_clarification": "放养牲畜"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1907dc67-0d94-3b65-a044-80494d6f672d",
                    "sense_definition": "To come together or move as a group.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "action_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The animals <w>herded</w> together to stay warm during the blizzard.",
                            "target_lang_translations": {
                                "ru": "Животные <w>сбились в стадо</w>, чтобы согреться во время метели.",
                                "zh": "暴风雪期间，动物们<w>聚集</w>在一起取暖。"
                            }
                        },
                        {
                            "text": "Fish often <w>herd</w> in large schools to protect themselves from predators.",
                            "target_lang_translations": {
                                "ru": "Рыбы часто <w>сбиваются</w> в большие косяки, чтобы защититься от хищников.",
                                "zh": "鱼类经常<w>成群</w>游动，以保护自己免受捕食者的攻击。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Собираться вместе или передвигаться группой.",
                        "zh": "聚集在一起或成群移动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сбиваться в стадо",
                                "target_lang_sense_clarification": "группироваться вместе"
                            },
                            {
                                "target_lang_word": "толпиться",
                                "target_lang_sense_clarification": "собираться в тесную группу"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "聚集",
                                "target_lang_sense_clarification": "集合在一起"
                            },
                            {
                                "target_lang_word": "成群",
                                "target_lang_sense_clarification": "以群体形式活动"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "30a2766d-f899-378a-961b-d91020d27dcd",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Herd</w> is known for his contributions to local history.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Херд</w> известен своим вкладом в местную историю.",
                                "zh": "<w>赫德</w>先生因对当地历史的贡献而闻名。"
                            }
                        },
                        {
                            "text": "I met a woman named Sarah <w>Herd</w> at the conference.",
                            "target_lang_translations": {
                                "ru": "Я встретил женщину по имени Сара <w>Херд</w> на конференции.",
                                "zh": "我在会议上遇到了一位名叫莎拉·<w>赫德</w>的女士。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "zh": "姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Херд",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "赫德",
                                "target_lang_sense_clarification": "姓氏"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}