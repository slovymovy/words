                        "glosses": [
                            "прост. разбить что-либо многократными ударами"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d2bbb6d-9e20-41eb-ad57-5262069002ee",
                                "sense_id": "a440ee5d-60ad-3b8b-b750-1d3dcb8a79b2",
                                "text": "― Порядок, порядок, ― сказал водитель. ― Вот раздолбают немцев в Сталинграде и понаедут из эвакуации, ещё хуже с площадью станет."
                            }
                        ]
                    },
