                        "entry_id": "15cb0498-e70d-37da-95a0-da0fd843027e",
                        "glosses": [
                            "Indicating that the piece is to be played very loudly."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f0ddb7e-0869-44b9-b33c-3a9b51f84153",
                                "sense_id": "eaa65f74-4544-3b8d-bb6d-6fddf437281d",
                                "text": "(abbreviation) ff"
                            },
                            {
                                "example_id": "acab2ed5-527c-45c6-acff-89468160021f",
                                "sense_id": "eaa65f74-4544-3b8d-bb6d-6fddf437281d",
                                "text": "He claims he was doing no more than repeating the standard nationalist account. So he was, but he was also repeating that passionate liberal critique which had resounded, often fortissimo, in British debate when Indian nationalism was still a half-formed dream."
                            }
                        ]
                    }
