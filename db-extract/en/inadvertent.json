                "senses": [
                    {
                        "sense_id": "5012addb-8c7e-31f0-918a-314f404c15af",
                        "entry_id": "6e7779e4-f30c-37d1-9096-458a86dd409f",
                        "glosses": [
                            "Not intentional; not on purpose; not conscious."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "882ec767-ff07-46d4-bb1e-3b73f212dcbc",
                                "sense_id": "5012addb-8c7e-31f0-918a-314f404c15af",
                                "text": "We check everything because an inadvertent error could be disastrous."
                            }
                        ]
                    },
                    {
                        "sense_id": "e7111ad9-357c-3fb2-a8cd-66a8a76e64a7",
                        "entry_id": "6e7779e4-f30c-37d1-9096-458a86dd409f",
                        "glosses": [
                            "Inattentive."
                        ],
                        "tags": [
