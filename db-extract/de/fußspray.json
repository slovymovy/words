                "senses": [
                    {
                        "sense_id": "e0f7cb10-093b-334e-9054-b028d02f62a0",
                        "entry_id": "905183dc-9212-3fdb-b83b-87046c740557",
                        "glosses": [
                            "Spray gegen schlechte Gerüche der Füße"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea681dd2-4d9c-485e-ada2-d6f4a01aa21b",
                                "sense_id": "e0f7cb10-093b-334e-9054-b028d02f62a0",
                                "text": "„Ein Fußspray bekämpft nicht nur Fußgeruch, es sorgt auch sofort für eine angenehm kühle Erfrischung.“"
                            },
                            {
                                "example_id": "0db7c98f-14f1-4b50-aeb1-196ac3d7cbbf",
                                "sense_id": "e0f7cb10-093b-334e-9054-b028d02f62a0",
                                "text": "„Es gibt auch schöne Fußsprays aus der Natur: Die Basis bildet hier Hamameliswasser, das mit ätherischen Ölen vermischt wird.“"
                            },
                            {
                                "example_id": "ef662390-a0ec-49d7-a87d-56f8606b48e1",
                                "sense_id": "e0f7cb10-093b-334e-9054-b028d02f62a0",
                                "text": "„Verschwenderisch hüllte ich mich in Parfüm und Fußspray, verkleckerte wacker mein Makeup und bestäubte mich üppig mit feinem Puder.“"
                            },
                            {
                                "example_id": "400d318a-2a4c-4d91-a18b-ad6c0a4a15cc",
                                "sense_id": "e0f7cb10-093b-334e-9054-b028d02f62a0",
                                "text": "„Schon beim Hereinkommen schlug ihm der Geruch von Fleisch und Fußspray entgegen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
