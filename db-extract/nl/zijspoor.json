                                            {
                                                "example_id": "155933fa-57f3-4101-8e76-a5910f0e5de0",
                                                "sense_id": "f14a6c84-0224-3127-a9e3-f9b33764deef",
                                                "text": "Cela m’a donné envie et j’ai décidé, après ma licence d’histoire, de m’inscrire en fac d’arts du spectacle à Metz, avec l’idée de devenir scénariste. Comme voie de garage, c’est à peu près ce que l’on fait de mieux, mais je l’ignorais totalement…"
                                            },
                                            {
                                                "example_id": "3e68d3d3-260b-4ee8-ad4e-87ea0de0ae3c",
                                                "sense_id": "f14a6c84-0224-3127-a9e3-f9b33764deef",
                                                "text": "Commencer sa carrière dans une petite entreprise, tremplin ou voie de garage ?"
                                            }
                                        ]
