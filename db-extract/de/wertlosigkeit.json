                ],
                "senses": [
                    {
                        "sense_id": "f74a8163-e3da-37ac-b69f-74bae2bde67e",
                        "entry_id": "acdbfc38-cd18-3606-911e-dad95ee1ec9c",
                        "glosses": [
                            "Eigenschaft einer Person oder Sache, keinen Wert zu haben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eaafd94e-db01-4a7f-9eda-4db0eb26f865",
                                "sense_id": "f74a8163-e3da-37ac-b69f-74bae2bde67e",
                                "text": "„Im Kynismus sieht er die Haltung für die Wertlosigkeit des Lebens und aber die Beharrung am Leben.“"
                            },
                            {
                                "example_id": "dd3aaaac-53a8-4754-9752-c1fc98958498",
                                "sense_id": "f74a8163-e3da-37ac-b69f-74bae2bde67e",
                                "text": "„Die Vermeidungsmethode dient dazu, Gefühle der Wertlosigkeit zu vermeiden.“"
                            },
                            {
                                "example_id": "bf88276e-28d5-442f-8de8-5a45c5fd2375",
                                "sense_id": "f74a8163-e3da-37ac-b69f-74bae2bde67e",
                                "text": "„Gefühle der Wertlosigkeit Kinder und Jugendliche, die nicht erfahren, daß ihr eigenes Handeln zum Erfolg führt und von anderen geschätzt wird, bilden auf die Dauer Gefühle der Wertlosigkeit und Bedeutungslosigkeit aus.“"
                            },
                            {
                                "example_id": "ede31cd6-47e9-4504-a19f-904a9afaf8d8",
                                "sense_id": "f74a8163-e3da-37ac-b69f-74bae2bde67e",
                                "text": "„Ist die Gesellschaft insolvent, so kann Wertlosigkeit angenommen werden, sofern nicht eine verpfändete Rückdeckungsversicherung besteht.“"
                            },
                            {
                                "example_id": "485e7853-43cd-4516-b6f0-f8d9332c83b4",
                                "sense_id": "f74a8163-e3da-37ac-b69f-74bae2bde67e",
                                "text": "„Das aus tiefer Frustration erwachsende Gefühl der Sinnlosigkeit oder Wertlosigkeit, das uns lieber sterben als weiter mit diesem Gefühl leben lässt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b46748f5-5818-3fa0-bd01-28a0361185c5",
                        "entry_id": "acdbfc38-cd18-3606-911e-dad95ee1ec9c",
                        "glosses": [
                            "etwas, das keinen Wert hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "497ed9cb-c922-456b-81f5-d0dc44505540",
                                "sense_id": "b46748f5-5818-3fa0-bd01-28a0361185c5",
                                "text": "„Wenn mein Herz mit Christus erfüllt ist, habe ich weder Herz noch Auge für die Wertlosigkeiten der Welt.“"
                            },
                            {
                                "example_id": "5dd03a09-6c6c-4fc6-9e5c-87acc0c46bf0",
                                "sense_id": "b46748f5-5818-3fa0-bd01-28a0361185c5",
                                "text": "„Der Exotismus ist die Kunstaufwertung der kunstvoll verpackten Wertlosigkeiten.“"
                            },
                            {
                                "example_id": "236270e2-6278-47a8-b027-c098482311d3",
                                "sense_id": "b46748f5-5818-3fa0-bd01-28a0361185c5",
                                "text": "„Die Wertlosigkeiten, die dir aus dem Mund fallen, machen absolut gar nichts gut!“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
