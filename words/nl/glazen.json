                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het meer had die ochtend een strak en <w>glazen</w> oppervlak.",
                            "target_lang_translations": {
                                "en": "The lake had a smooth and <w>glassy</w> surface that morning.",
                                "ru": "В то утро у озера была гладкая <w>стеклянная</w> поверхность.",
                                "fr": "Ce matin-là, le lac avait une surface lisse et <w>de glace</w>.",
                                "pl": "Jezioro miało tego ranka gładką i <w>szklistą</w> taflę.",
                                "de": "Der See hatte an diesem Morgen eine glatte und <w>glasige</w> Oberfläche.",
                                "it": "Quella mattina il lago aveva una superficie tesa e <w>vitrea</w>.",
                                "cs": "Jezero mělo toho rána hladký a <w>skelný</w> povrch.",
                                "tr": "Gölün o sabah pürüzsüz ve <w>camsı</w> bir yüzeyi vardı.",
                                "es": "El lago tenía esa mañana una superficie lisa y <w>vítrea</w>.",
                                "zh": "那天早上，湖面像<w>玻璃</w>一样平滑。"
                            }
                        },
                        {
                            "text": "Hij staarde met een <w>glazen</w> blik voor zich uit zonder iets te zien.",
                            "target_lang_translations": {
                                "en": "He stared ahead with a <w>glassy</w> look without seeing anything.",
                                "ru": "Он смотрел перед собой <w>остекленевшим</w> взглядом, ничего не видя.",
                                "fr": "Il regardait devant lui avec un regard <w>vitreux</w> sans rien voir.",
                                "pl": "Patrzył przed siebie <w>szklistym</w> wzrokiem, niczego nie widząc.",
                                "de": "Er starrte mit einem <w>glasigen</w> Blick vor sich hin, ohne etwas zu sehen.",
                                "it": "Fissava il vuoto davanti a sé con uno sguardo <w>vitreo</w> senza vedere nulla.",
                                "cs": "Díval se před sebe <w>skelným</w> pohledem, aniž by cokoli viděl.",
                                "tr": "Hiçbir şey görmeden <w>donuk</w> bir bakışla önündeki boşluğa daldı.",
                                "es": "Miraba al frente con una mirada <w>vítrea</w> sin ver nada.",
                                "zh": "他眼神<w>呆滞</w>地盯着前方，什么也没看见。"
                            }
                        }
