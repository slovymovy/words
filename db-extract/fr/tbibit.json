                        "glosses": [
                            "Sorte de passereau."
                        ],
                        "tags": [
                            "Maroc"
                        ],
                        "examples": [
                            {
                                "example_id": "9e115d14-0660-4dd0-bec1-c84576dd8352",
                                "sense_id": "5a3e9215-0e92-3327-bc7b-49d7191b3baf",
                                "text": "Le tbibit est un passereau ressemblant beaucoup au moineau et que l’on ne trouve qu’au sud du Morbêa, surtout à Marrakech, où il est l’hôte familier de toutes les maisons."
                            },
                            {
                                "example_id": "d849bfb5-276a-42bb-9ebf-2e822065ea86",
                                "sense_id": "5a3e9215-0e92-3327-bc7b-49d7191b3baf",
                                "text": "Tamesloht est la cité des oiseaux : sous la claire lumière, des merles, des moineaux et des tourterelles volent sans cesse d’un arbre à l’autre, au milieu de la végétation surabondante, des « tbibits », petits oiseaux particuliers à la région de Marrakech, semblent chez eux ici, et viennent familièrement se disputer les miettes des repas dans les appartements."
                            }
                        ]
                    }
