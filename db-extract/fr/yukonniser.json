                "senses": [
                    {
                        "sense_id": "1866280c-2e75-370b-8401-8c067a76e1b8",
                        "entry_id": "3ed1a41a-44f3-32ed-8272-cfb54ebac19e",
                        "glosses": [
                            "Donner un caractère yukonnais à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "674c2958-ff47-4614-85ed-8b08c923cc69",
                                "sense_id": "1866280c-2e75-370b-8401-8c067a76e1b8",
                                "text": "« On dit souvent qu’il faut ‘yukonniser’ les programmes […] parce que nous ne faisons pas face aux mêmes enjeux que dans le sud [du pays] », précise Aja Mason."
                            },
                            {
                                "example_id": "a1ec9c8d-3668-4464-a52d-cdd08e3b0249",
                                "sense_id": "1866280c-2e75-370b-8401-8c067a76e1b8",
                                "text": "Vous deux avez fait du chemin en peu de temps, et vous vous êtes \"yukonnisés\" à un point que je n'aurais jamais pensé en novembre/décembre 2005."
                            }
                        ]
                    }
