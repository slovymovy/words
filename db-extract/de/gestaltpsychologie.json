                "senses": [
                    {
                        "sense_id": "a388c27c-b6ab-308d-a49a-fa52a42d35f7",
                        "entry_id": "25160ff3-9bce-3528-b706-7d278e163cfc",
                        "glosses": [
                            "Richtung innerhalb der Psychologie, die die menschliche Wahrnehmung als Fähigkeit beschreibt, Strukturen und Ordnungsprinzipien in Sinneseindrücken auszumachen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5834d45-a000-442e-9881-a5d8c376286f",
                                "sense_id": "a388c27c-b6ab-308d-a49a-fa52a42d35f7",
                                "text": "„In dieser Zeit entwickelte sich die kognitive Psychologie in ihrer damals avanciertesten Form, der Gestaltpsychologie, deren akademischer Schwerpunkt die Universität Berlin war.“"
                            },
                            {
                                "example_id": "bc8b19b9-5f4a-4d44-90bb-5ac979039484",
                                "sense_id": "a388c27c-b6ab-308d-a49a-fa52a42d35f7",
                                "text": "„Als Tochter einstmaliger Anhänger der Gestaltpsychologie, der Selbstaktualisierung, der Eutonie, ist mir bewusst, dass, wenn sich irgendjemand in der gegenwärtigen Situation unwohl fühlen sollte, ich das jedenfalls nicht bin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
