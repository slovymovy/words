                                            },
                                            {
                                                "example_id": "85227c0a-6296-4600-8e83-3fda55314660",
                                                "sense_id": "b4bf0184-b913-3b21-ab69-3caf15a33950",
                                                "text": "She gave a feisty response during the debate."
                                            },
                                            {
                                                "example_id": "06d21f78-7094-4802-b1d0-37b2a1daae2d",
                                                "sense_id": "b4bf0184-b913-3b21-ab69-3caf15a33950",
                                                "text": "The feisty puppy barked at everyone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67e3f2e0-dbd7-344e-bd28-264f64f94c46",
                                        "entry_id": "427e129e-657c-3b41-bb75-b1aeb8819eba",
                                        "glosses": [
                                            "Belligerent; prepared to stand and fight, especially in spite of relatively small stature or some other disadvantage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22b35984-ac01-48a9-b821-542157bdace6",
                                                "sense_id": "67e3f2e0-dbd7-344e-bd28-264f64f94c46",
                                                "text": "small but feisty"
                                            },
                                            {
                                                "example_id": "cf4ddc1c-827a-4679-9473-515f9a2e67f0",
                                                "sense_id": "67e3f2e0-dbd7-344e-bd28-264f64f94c46",
                                                "text": "The feisty wife of a world-renowned Russian sculptor emasculated an armed thug outside her Soho home — saying he “didn’t have the cojones to shoot her,” police sources said yesterday."
                                            }
                                        ]
                                    },
                                    {
