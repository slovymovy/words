                ],
                "senses": [
                    {
                        "sense_id": "3932033d-55ed-3af7-b490-ff412e9abdbc",
                        "entry_id": "dbacdd61-b535-3370-b3f7-fcdab1f0f800",
                        "glosses": [
                            "Russie."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "aceb10c6-370f-46e6-adb4-63443f6baac2",
                                "sense_id": "3932033d-55ed-3af7-b490-ff412e9abdbc",
                                "text": "Les jours passent et l'Ukraine résiste toujours.\nCe peuple fait preuve d'une résilience hors du commun.\nNous sommes Mardi 7 Novembre 2023 et je soutiens encore et toujours l'Ukraine jusqu'à la victoire totale et la soumission de la ruZZie !\nSlava Ukraïni ! ✊✊"
                            },
                            {
                                "example_id": "1176e332-24ca-4a78-90b8-6aa41e3d484a",
                                "sense_id": "3932033d-55ed-3af7-b490-ff412e9abdbc",
                                "text": "Medvedev démontre par l'absurde que la fédération de ruZZie doit disparaître pour que, non pas seulement l'Ukraine mais aussi, le reste du monde libre puisse vivre en paix."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c2ad64a2-d0c5-4cfd-877f-6405632eddaf",
                        "source_entry_id": "dbacdd61-b535-3370-b3f7-fcdab1f0f800",
                        "source_sense_id": "3932033d-55ed-3af7-b490-ff412e9abdbc",
                        "target_lang_word": "Ruzzia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ruzzia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0734a7f7-f059-3364-bbdd-7e2403a6e2a5",
                                        "entry_id": "74ef6784-be24-32a4-b894-28055c6c0037",
                                        "glosses": [
                                            "Alternative spelling of Russia."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "derogatory",
                                            "neologism",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9163dfd-3323-4d63-a7d5-3a767365e791",
                                                "sense_id": "0734a7f7-f059-3364-bbdd-7e2403a6e2a5",
                                                "text": "A third user, @Ni79Mo wrote: \"See what happens when you hang out with RuZZia too much? You start creating your own realities as well.\""
                                            },
                                            {
                                                "example_id": "8aeef0a3-6f68-4b18-8a6c-3d5ba5645ec2",
                                                "sense_id": "0734a7f7-f059-3364-bbdd-7e2403a6e2a5",
                                                "text": "Shayk was accused of being a \"supporter of the terrorist state Ruzzia and genocide of Ukrainians.\""
                                            },
                                            {
                                                "example_id": "f627f84f-56e7-4d28-a0af-c980a5be67e5",
                                                "sense_id": "0734a7f7-f059-3364-bbdd-7e2403a6e2a5",
                                                "text": "Because one way to fight a proxy war is to flood the market with cheap oil and that’s what the US is doing in its support of Ukraine against what the late Senator John McCain called Ruzzia: \"a petrol (gas) station, run by a Mafia, masquerading as a country\""
                                            },
                                            {
                                                "example_id": "8e3d8bf7-0e92-4c0d-8827-3e781cff949c",
                                                "sense_id": "0734a7f7-f059-3364-bbdd-7e2403a6e2a5",
                                                "text": "I received a letter that instilled in me feelings of rage and pain- my assigned roommate is going to be a competitor from the terrorist-country, from a country that lost all laws and order, from the despot-country, from the disgusting and deceitful stain on the body of our beautiful planet, from ruzzia^([sic])."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
