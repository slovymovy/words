                "senses": [
                    {
                        "sense_id": "ac1dce2b-7c25-3068-8d6d-23d6935bdedd",
                        "entry_id": "9e21a840-9db8-349e-b4e0-c7f77da893fa",
                        "glosses": [
                            "implizit Mitgesagtes; indirekte Folgerung, die sich aus einer Äußerung ergibt"
                        ],
                        "tags": [
                            "Pragmatik"
                        ],
                        "examples": [
                            {
                                "example_id": "ee349654-f97d-4dd9-b214-30879f131833",
                                "sense_id": "ac1dce2b-7c25-3068-8d6d-23d6935bdedd",
                                "text": "Der Satz „Einige Marsianer sind grün“ erzeugt die Implikatur, nicht alle Marsianer seien grün."
                            },
                            {
                                "example_id": "efb39efa-d203-4912-b014-7857cdeb2585",
                                "sense_id": "ac1dce2b-7c25-3068-8d6d-23d6935bdedd",
                                "text": "„Infolgedessen kann es nicht am Diktum selbst liegen, daß eine Implikatur ausgelöst wird, sondern daran, daß dieses Diktum unter den-und-den Umständen geäußert wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
