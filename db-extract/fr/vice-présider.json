                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2dca9677-a157-40cb-813b-5bb489558d93",
                                "sense_id": "515f32e1-1120-3a79-8f66-434d84c1ecb6",
                                "text": "En 1984, le Président François Mitterrand fait appel à Léopold Sédar Senghor pour vice-présider le Haut Conseil de la Francophonie qu'il vient de créer."
                            },
                            {
                                "example_id": "d2249a5c-3692-41f4-8d0d-94e89cdbcf77",
                                "sense_id": "515f32e1-1120-3a79-8f66-434d84c1ecb6",
                                "text": "Cédric Perrin est devenu sénateur de Belfort, Florian Bouquet dirige le département et Frédéric Rousse, son dircab à la mairie, vice-préside le même conseil départemental."
                            }
                        ]
                    }
