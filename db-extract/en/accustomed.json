{
    "word": "accustomed",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "3003c0dd-f6c1-3210-92bd-46a34eafb9a9",
                "word": "accustomed",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "cca65238-287e-435e-b6f5-c53fafa4a48c",
                        "entry_id": "3003c0dd-f6c1-3210-92bd-46a34eafb9a9",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more accustomed"
                    },
                    {
                        "form_id": "f36d1d16-401a-4585-a3d7-2404a533bdaf",
                        "entry_id": "3003c0dd-f6c1-3210-92bd-46a34eafb9a9",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most accustomed"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "95db888a-b56f-3a1d-9129-6e5f4a5c8f31",
                        "entry_id": "3003c0dd-f6c1-3210-92bd-46a34eafb9a9",
                        "glosses": [
                            "Familiar with something through repeated experience; adapted to existing conditions. (of a person)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b23d31e-d812-4939-8531-cb58c8315cf8",
                                "sense_id": "95db888a-b56f-3a1d-9129-6e5f4a5c8f31",
                                "text": "I am not accustomed to walk(ing) long distances."
                            },
                            {
                                "example_id": "1e2e1c7b-6efa-4da2-9dc8-4cc3d0b2b3a5",
                                "sense_id": "95db888a-b56f-3a1d-9129-6e5f4a5c8f31",
                                "text": "She is getting more and more accustomed to the cold."
                            },
                            {
                                "example_id": "6358a7cc-68bd-4b51-bd73-f5c24506a60c",
                                "sense_id": "95db888a-b56f-3a1d-9129-6e5f4a5c8f31",
                                "text": "1484, William Caxton (translator), The Book of the Subtyl Historyes and Fables of Esope, “The v fable is of the Foxe and of the busshe,”\nAnd ther fore men ought not to helpe them whiche ben acustomed to doo euylle"
                            },
                            {
                                "example_id": "3c3cbd13-aa53-4fc4-beea-722372414053",
                                "sense_id": "95db888a-b56f-3a1d-9129-6e5f4a5c8f31",
                                "text": "1621, Robert Burton, The Anatomy of Melancholy, Oxford: Henry Cripps, Partition 1, Section 2, Member 2, Subsection 3, p. 99,\nSuch things as we haue beene long accustomed to, though they be evill in their owne nature; yet they are lesse offensiue."
                            },
                            {
                                "example_id": "0e69cd31-a764-485b-aa62-52d5c6dbbcdc",
                                "sense_id": "95db888a-b56f-3a1d-9129-6e5f4a5c8f31",
                                "text": "“Miss Bennet, do you know who I am? I have not been accustomed to such language as this.”"
                            },
                            {
                                "example_id": "eee6d356-9e81-47dd-ae31-4586105d0287",
                                "sense_id": "95db888a-b56f-3a1d-9129-6e5f4a5c8f31",
                                "text": "Young Overton’s face assumed the bothered look of the man who is more accustomed to using his muscles than his wits […]"
                            },
                            {
                                "example_id": "ee44d143-73a4-4ba5-98e2-164230b5116f",
                                "sense_id": "95db888a-b56f-3a1d-9129-6e5f4a5c8f31",
                                "text": "None of the Victorian mothers—and most of the mothers were Victorian—had any idea how casually their daughters were accustomed to be kissed."
                            }
                        ]
                    },
                    {
                        "sense_id": "de9fcb40-f61d-3642-9aa1-3eedad1441ec",
                        "entry_id": "3003c0dd-f6c1-3210-92bd-46a34eafb9a9",
                        "glosses": [
                            "Familiar through use; usual; customary. (of a thing, condition, activity, etc.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ef24a87-4978-4c3c-9e72-8ecb9206fecd",
                                "sense_id": "de9fcb40-f61d-3642-9aa1-3eedad1441ec",
                                "text": "It is an accustomed action with her, to seem thus washing her hands: I have known her continue in this a quarter of an hour."
                            },
                            {
                                "example_id": "fdb41774-9e09-47bc-bb53-652d1f226498",
                                "sense_id": "de9fcb40-f61d-3642-9aa1-3eedad1441ec",
                                "text": "Molly had no sooner apparelled herself in her accustomed Rags, than her Sisters began to fall violently upon her […]"
                            },
                            {
                                "example_id": "efb8e085-0436-4a1d-894a-1e44540d15f2",
                                "sense_id": "de9fcb40-f61d-3642-9aa1-3eedad1441ec",
                                "text": "1812, Lord Byron, Childe Harold’s Pilgrimage, Canto 2, Stanza 72, in The Poetical Works of Lord Byron, Boston: Cummings & Hilliard, 1814, Volume I, p. 249,\nWho now shall lead thy scatter’d children forth,\nAnd long-accustom’d bondage uncreate?"
                            },
                            {
                                "example_id": "99bad793-3d09-47bb-a989-ec75f7141e81",
                                "sense_id": "de9fcb40-f61d-3642-9aa1-3eedad1441ec",
                                "text": "1912, Rabindranath Tagore, Gitanjali, London: The India Society, Section 63, p. 37,\nI am uneasy at heart when I have to leave my accustomed shelter; I forget that there abides the old in the new, and that there also thou abidest."
                            },
                            {
                                "example_id": "1a6eca52-da35-4671-a72a-3e3923488887",
                                "sense_id": "de9fcb40-f61d-3642-9aa1-3eedad1441ec",
                                "text": "The raid, directed as usual by vice squad Sgt. Edward McNelley and featuring the accustomed assortment of vice officers, […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "f10d69b1-3178-3832-b3c4-271e6c54b654",
                        "entry_id": "3003c0dd-f6c1-3210-92bd-46a34eafb9a9",
                        "glosses": [
                            "Frequented by customers."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "660fc925-185e-4550-8ff5-df1913f6b554",
                                "sense_id": "f10d69b1-3178-3832-b3c4-271e6c54b654",
                                "text": "1778, Tobias Smollett (translator), The Adventures of Gil Blas of Santillane by Alain-René Lesage, London: S. Crowder et al., Volume I, Chapter 7, p. 148,\nThere I got a place on the same terms as at Segovia, in a well accustomed shop, much frequented on account of the neighbourhood of the church of Santa Cruz, and the Prince’s theatre […]"
                            },
                            {
                                "example_id": "b434e7fb-0caf-43df-bed5-51d9eaf2b022",
                                "sense_id": "f10d69b1-3178-3832-b3c4-271e6c54b654",
                                "text": "1817, Seth William Stevenson), Journal of a Tour through Part of France, Flanders, and Holland, Norwich: for the author, Chapter 21, p. 283,\nThe pompous hotel is a lone cottage of very mean appearance, on the road side, and I will be sworn, was but an ill-accustomed Inn, until those renowned Generals justly gave it a licence."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "92464262-8219-4370-9c49-68931477fa38",
                        "source_entry_id": "3003c0dd-f6c1-3210-92bd-46a34eafb9a9",
