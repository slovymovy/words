                "senses": [
                    {
                        "sense_id": "1e33770c-7a6d-3393-824a-a1063819a0b6",
                        "entry_id": "f04fd0ff-08de-39de-bd4e-10abe92c70fd",
                        "glosses": [
                            "Un des noms vernaculaires dAzadirachta indica arbre des régions tropicales et subtropicales de la famille des Méliacées (comme le mahogany). Originaire d’Inde orientale il est de plus en plus cultivé en Afrique, en Australie et en Amérique Latine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25bb9679-82c7-4582-a577-15f7ee191864",
                                "sense_id": "1e33770c-7a6d-3393-824a-a1063819a0b6",
                                "text": "Le neem, un arbre de la famille de l’acajou, originaire du sous-continent indien mais largement présent en Afrique centrale, en Amérique du Sud et en Asie, a fait l’objet d’une des premières vastes campagnes de sensibilisation de la part du mouvement altermondialiste, relayant ainsi les fortes mobilisations des ONG indiennes."
                            },
                            {
                                "example_id": "8e97d87e-7a20-40cf-9400-f9441da9bf4f",
                                "sense_id": "1e33770c-7a6d-3393-824a-a1063819a0b6",
                                "text": "Mais il n’y avait pas de bruissement de feuilles à la fenêtre de ma chambre, pas de froufrou dans les neems et les anacardiers."
                            },
                            {
                                "example_id": "f152e3d2-ac40-4b79-b956-bf74d551418c",
                                "sense_id": "1e33770c-7a6d-3393-824a-a1063819a0b6",
                                "text": "Arbre \"sacré\" du sub-continent indien, utilisé depuis plus de 2000 ans dans la médecine ayurvédique, le neem et ses dérivés suscitent de plus en plus d’intérêt voire de convoitises."
                            }
                        ]
                    }
                ],
