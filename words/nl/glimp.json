{
    "word_family": [
        "glimpen",
        "glimpje",
        "glimpachtig"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c74ca9cc-e811-3454-b4af-b2e4569669d5",
                    "sense_definition": "iets wat je maar heel kort, in een flits, ziet",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "waarneming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wij konden maar een <w>glimp</w> van het nieuwe automodel zien.",
                            "target_lang_translations": {
                                "en": "We could only see a <w>glimpse</w> of the new car model.",
                                "fr": "Nous n'avons pu avoir qu'un <w>aperçu</w> du nouveau modèle de voiture."
                            }
                        },
                        {
                            "text": "De fans stonden uren in de kou om een <w>glimp</w> op te vangen van de beroemde zanger.",
                            "target_lang_translations": {
                                "en": "The fans stood in the cold for hours to catch a <w>glimpse</w> of the famous singer.",
                                "fr": "Les fans sont restés des heures dans le froid pour <w>entrevoir</w> le célèbre chanteur."
                            }
                        }
                    ],
                    "common_phrases": [
                        "glimp opvangen"
                    ],
                    "target_lang_definitions": {
                        "en": "something that you see only very briefly, in a flash",
                        "fr": "quelque chose que l'on aperçoit très brièvement, comme un éclair"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "glimpse",
                                "target_lang_sense_clarification": "a brief or partial view"
                            },
                            {
                                "target_lang_word": "glance",
                                "target_lang_sense_clarification": "a quick look"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "aperçu",
                                "target_lang_sense_clarification": "vue très brève ou rapide"
                            },
                            {
                                "target_lang_word": "lueur",
                                "target_lang_sense_clarification": "faible éclat ou manifestation fugitive"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c1d5af05-2711-3ac4-afc2-b7acabdfcd37",
                    "sense_definition": "een uiterlijke schijn die niet overeenkomt met de werkelijkheid",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "uiterlijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn vriendelijkheid was slechts een <w>glimp</w> om zijn ware bedoelingen te verbergen.",
                            "target_lang_translations": {
                                "en": "His friendliness was merely a <w>veneer</w> to hide his true intentions.",
                                "fr": "Sa gentillesse n'était qu'un <w>semblant</w> pour cacher ses véritables intentions."
                            }
                        },
                        {
                            "text": "Achter die mooie <w>glimp</w> van rijkdom ging een diepe schuld schuil.",
                            "target_lang_translations": {
                                "en": "Behind that beautiful <w>facade</w> of wealth lay a deep debt.",
                                "fr": "Derrière cette belle <w>façade</w> de richesse se cachait une lourde dette."
                            }
                        }
                    ],
                    "synonyms": [
                        "schijn",
                        "vernisje"
                    ],
                    "antonyms": [
                        "werkelijkheid"
                    ],
                    "target_lang_definitions": {
                        "en": "an outward appearance that does not correspond to reality",
                        "fr": "une apparence extérieure trompeuse qui ne correspond pas à la réalité"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "veneer",
                                "target_lang_sense_clarification": "a deceptive outward appearance"
                            },
                            {
                                "target_lang_word": "semblance",
                                "target_lang_sense_clarification": "the outward appearance or apparent form of something"
                            },
                            {
                                "target_lang_word": "facade",
                                "target_lang_sense_clarification": "a deceptive outward appearance"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "semblant",
                                "target_lang_sense_clarification": "apparence trompeuse"
                            },
                            {
                                "target_lang_word": "vernis",
                                "target_lang_sense_clarification": "apparence superficielle masquant la réalité"
                            },
                            {
                                "target_lang_word": "façade",
                                "target_lang_sense_clarification": "apparence extérieure trompeuse"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}