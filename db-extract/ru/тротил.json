                "senses": [
                    {
                        "sense_id": "99d0f46f-33bf-369a-bc22-db9cc97024a0",
                        "entry_id": "da0b273c-d24a-3563-818a-7408239312fd",
                        "glosses": [
                            "кристаллическое вещество жёлтого цвета, обладающее сильной взрывчатой силой"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14446435-0a72-4a4f-ae4d-bf06fe9886cb",
                                "sense_id": "99d0f46f-33bf-369a-bc22-db9cc97024a0",
                                "text": "Взрывом шестидесяти килограммов тротила барбет вмяло и перекосило, а башня весом примерно в восемьсот тонн сдвинулась с катков и вышла из строя."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "222f065f-4a24-49dd-85c8-524a58ef5bd9",
                        "source_entry_id": "da0b273c-d24a-3563-818a-7408239312fd",
                        "source_sense_id": "99d0f46f-33bf-369a-bc22-db9cc97024a0",
                        "target_lang_word": "TNT",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "TNT",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7be3b2b2-6ca3-304a-8b12-6cd7152d5a62",
                                        "entry_id": "8628d184-8e05-3875-81bf-dd4dc8ae40b3",
                                        "glosses": [
                                            "Abbreviation of trinitrotoluene (an explosive substance used in blasting)"
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb9c9771-57d8-443c-8101-31f3e80a269c",
                                                "sense_id": "7be3b2b2-6ca3-304a-8b12-6cd7152d5a62",
                                                "text": "\"We have grown accustomed to a deadly paradox: the world's greatest megatonnage of TNT is buried in the heart of the earth's most productive agricultural area."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88303990-2500-370e-af88-4394e262687b",
                                        "entry_id": "8628d184-8e05-3875-81bf-dd4dc8ae40b3",
                                        "glosses": [
                                            "Dynamite."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2f3bcc84-c8a8-3054-b8fb-3d377d53ea0d",
                                        "entry_id": "8628d184-8e05-3875-81bf-dd4dc8ae40b3",
                                        "glosses": [
                                            "An illegal immigrant."
                                        ],
                                        "tags": [
                                            "Philippines",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ea52617-8976-48b9-9b71-68c16092f9ef",
                                                "sense_id": "2f3bcc84-c8a8-3054-b8fb-3d377d53ea0d",
                                                "text": "These illegal immigrants are popularly known as “TNTs,” or tago ng tago (literally, “hide and hide”). Some married American citizens to legalize their stay, while others paid for “green card” marriages."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "TNT",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7a2beae4-4465-383a-a7fb-31891ac8d1e0",
                                        "entry_id": "e05f9299-a5e3-38dc-93eb-eb6da97f23ad",
                                        "glosses": [
                                            "Initialism of Turner Network Television, a U.S. television channel."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "initialism"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
