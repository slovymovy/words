                        "entry_id": "70aa369b-40f4-302a-993d-40a0d8d8b039",
                        "glosses": [
                            "Troisième personne du singulier du présent de l’indicatif de cesser."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "d0b93f0e-6aae-4376-97fb-bdda08c21b05",
                                "sense_id": "f49eef6b-54a2-3e1a-b5de-dae1094d290b",
                                "text": "Dos Passos ne cesse de renvoyer dos à dos républicains et démocrates ainsi que capitalistes et communistes."
                            }
                        ]
                    },
                    {
                        "sense_id": "7bb6f83c-51c7-39b4-baae-d2c9d7a9fd5d",
                        "entry_id": "70aa369b-40f4-302a-993d-40a0d8d8b039",
                        "glosses": [
                            "Première personne du singulier du présent du subjonctif de cesser."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "723bbda3-6f72-3ef2-8461-2ad5354cbf54",
                        "entry_id": "70aa369b-40f4-302a-993d-40a0d8d8b039",
                        "glosses": [
                            "Troisième personne du singulier du présent du subjonctif de cesser."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "afc0c0e4-0ebf-4b0e-bd0a-46709de867e6",
                                "sense_id": "723bbda3-6f72-3ef2-8461-2ad5354cbf54",
                                "text": "Que la France cesse d’exercer à la fois toutes ses influences sur les races latines de l’Amérique, et graduellement on les verra se saxonniser à l’instar du Texas et de la Californie."
                            }
                        ]
                    },
                    {
                        "sense_id": "f7959baf-b4fe-3d95-be58-2afd0792e6d7",
                        "entry_id": "70aa369b-40f4-302a-993d-40a0d8d8b039",
                        "glosses": [
                            "Deuxième personne du singulier du présent de l’impératif de cesser."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "8048a19e-7bd8-4a62-b8bd-1b063d706b6d",
                                "sense_id": "f7959baf-b4fe-3d95-be58-2afd0792e6d7",
                                "text": "Lave ta tignasse ou je te gifle ; fais-toi des locks, des tresses, rase-toi le crâne ; donne ta chemise ; cesse d’être ma honte, le soir, quand les voisines viennent, avec leur air de pimbêches, Fatoumata surtout, et qu’elles demandent : et ton frère ? où donc est-il, notre chéri ? où est-il, petit Abou ?"
                            }
                        ]
                    }
