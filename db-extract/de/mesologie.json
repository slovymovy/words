                "senses": [
                    {
                        "sense_id": "679fb0e5-7287-3f4e-b9dd-94ce4656fcd3",
                        "entry_id": "aaf86d65-a2e9-3b87-8645-beb65ceb6bfe",
                        "glosses": [
                            "Lehre vom Umweltverhältnis von den Organismen, ein ungewöhnlicher Ausdruck für die Wissenschaft von der Umwelt, oder Ökologie Spezialgebiet der Biologie"
                        ],
                        "tags": [
                            "archaic",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "a3934930-ded1-449a-bbaa-8e07f8736582",
                                "sense_id": "679fb0e5-7287-3f4e-b9dd-94ce4656fcd3",
                                "text": "Der Begriff Mesologie wurde um 1850 geprägt, geriet aber in Vergessenheit."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9555ff76-0c4b-33a3-be8f-4bbed3d48958",
                        "entry_id": "aaf86d65-a2e9-3b87-8645-beb65ceb6bfe",
                        "glosses": [
                            "Beziehungen zwischen den Lebewesen und deren Umgebung, sowie deren gegenseitigen Einflüssen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a43d213-5acb-4194-b5a4-6caebd57a3a4",
                                "sense_id": "9555ff76-0c4b-33a3-be8f-4bbed3d48958",
                                "text": "Außer den mächtigen genetischen Bestimmungen wirkt auch die Mesologie auf den menschlichen Körper."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "33653b22-219c-3c62-9807-c7a2690dc9df",
                        "entry_id": "aaf86d65-a2e9-3b87-8645-beb65ceb6bfe",
                        "glosses": [
                            "soziale und kulturelle Umwelt, in der der Mensch erzogen wird, studiert und sich entwickelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c6b1da5-42e5-4d26-baa1-683c6d046453",
                                "sense_id": "33653b22-219c-3c62-9807-c7a2690dc9df",
                                "text": "Hier kann der beeinflussende Faktor der Mesologie auf die Entwicklung der Identität des Kindes in Betracht gezogen werden."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
