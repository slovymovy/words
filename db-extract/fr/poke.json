                                        "sense_id": "955ef388-1e63-35cd-9a50-5e028d9366a1",
                                        "entry_id": "90d99af9-3999-32cc-8aef-c78f806ce732",
                                        "glosses": [
                                            "To rummage; to feel or grope around."
                                        ],
                                        "tags": [
