                ],
                "senses": [
                    {
                        "sense_id": "ca332eb6-9f45-3186-bb2f-7c86953a5b53",
                        "entry_id": "33f1dd3d-85ef-3105-aa4a-f117ab704e08",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec3ed24a-9212-4875-90a3-b056524b5e75",
                                "sense_id": "ca332eb6-9f45-3186-bb2f-7c86953a5b53",
                                "text": "Frau Werle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "f0d45088-e36e-49d3-8381-f7c2f6caabea",
                                "sense_id": "ca332eb6-9f45-3186-bb2f-7c86953a5b53",
                                "text": "Herr Werle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "7a20bc76-b1a6-4aab-a18b-c54d5da4ddc1",
                                "sense_id": "ca332eb6-9f45-3186-bb2f-7c86953a5b53",
                                "text": "Die Werles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "4bb81d57-35f2-44e9-a941-39cc3aa5d91d",
                                "sense_id": "ca332eb6-9f45-3186-bb2f-7c86953a5b53",
                                "text": "Der Werle trägt nie die Pullover, die die Werle ihm strickt."
                            },
                            {
                                "example_id": "b6ba17e7-5db6-4167-b1c4-40c5ad9babb5",
                                "sense_id": "ca332eb6-9f45-3186-bb2f-7c86953a5b53",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Werle kommt, geht der Herr Werle.“"
                            },
                            {
                                "example_id": "28169e57-f886-4d07-a7a8-85cddddacf20",
                                "sense_id": "ca332eb6-9f45-3186-bb2f-7c86953a5b53",
                                "text": "Werle kommt und geht."
                            },
                            {
                                "example_id": "ea24b5e1-69ee-4cfd-abc9-62786604c279",
                                "sense_id": "ca332eb6-9f45-3186-bb2f-7c86953a5b53",
                                "text": "Werles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
