    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "a4ed5cd0-b38e-39cf-a464-ffa715f3515b",
                "word": "dug",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "0bb011ed-7a39-43e3-b4e1-2c9402972c70",
                        "entry_id": "a4ed5cd0-b38e-39cf-a464-ffa715f3515b",
                        "tags": [
                            "plural"
                        ],
                        "form": "dugs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "38fcb551-6ec4-318b-898f-ee8cbe780df8",
                        "entry_id": "a4ed5cd0-b38e-39cf-a464-ffa715f3515b",
                        "glosses": [
                            "A mammary gland on a domestic mammal with more than two breasts."
                        ],
                        "tags": [
                            "in-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "8370cfa5-84e4-460d-b1a8-9e9758034706",
                                "sense_id": "38fcb551-6ec4-318b-898f-ee8cbe780df8",
                                "text": "Horatio: This Lapvving runs avvay vvith the ſshell on his head.\nHamlet: He did complie with his Dugge before hee ſuck't it: […]"
                            },
                            {
                                "example_id": "a3043639-4e05-43ef-b064-f74496a169ab",
                                "sense_id": "38fcb551-6ec4-318b-898f-ee8cbe780df8",
                                "text": "First Pig.\nI suck, but no milk will come from the dug."
                            }
                        ]
                    },
                    {
                        "sense_id": "97e27068-052e-3167-aa2f-b1d11261efb6",
                        "entry_id": "a4ed5cd0-b38e-39cf-a464-ffa715f3515b",
                        "glosses": [
                            "A woman's breast or nipple."
                        ],
                        "tags": [
                            "in-plural",
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "0d850546-f58f-43f9-bf37-d49f7c315cff",
                                "sense_id": "97e27068-052e-3167-aa2f-b1d11261efb6",
                                "text": "Ah! that Deceit ſhould ſteale ſuch gentle ſhape,\nAnd vvith a vertuous Vizor hide deepe vice.\nHe is my ſonne, I, and therein my ſhame,\nYet from my dugges, he drew not this deceit"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "35645314-b236-4bf7-a3a2-36abb55ea831",
                        "source_entry_id": "a4ed5cd0-b38e-39cf-a464-ffa715f3515b",
                        "source_sense_description": "mammary gland on domestic mammal",
                        "target_lang_word": "têton",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "7b0f322c-65cc-482a-9084-50b7200e04ca",
                        "source_entry_id": "a4ed5cd0-b38e-39cf-a464-ffa715f3515b",
                        "source_sense_description": "mammary gland on domestic mammal",
                        "target_lang_word": "mamelle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mamelle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d69f980e-869e-3b03-a639-1c48afbe129e",
                                        "entry_id": "7f3899c4-9c7e-3c58-97b9-feda30c4f3e8",
                                        "glosses": [
                                            "Partie charnue et glanduleuse du sein des mammifères femelles où se forme le lait."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36b7c1b8-1f80-47c4-b189-b48705cb070a",
                                                "sense_id": "d69f980e-869e-3b03-a639-1c48afbe129e",
                                                "text": "Mamelle droite, gauche."
                                            },
                                            {
                                                "example_id": "729421a9-089f-4cff-a16c-06f92501b636",
                                                "sense_id": "d69f980e-869e-3b03-a639-1c48afbe129e",
                                                "text": "Les enfants à la mamelle."
                                            },
                                            {
                                                "example_id": "a9617567-da0e-4fbd-ae9b-a599ce448e08",
                                                "sense_id": "d69f980e-869e-3b03-a639-1c48afbe129e",
                                                "text": "Les mamelles d’une vache, d’une jument, d’une baleine constituent le pis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6bd41920-d8e1-3378-9846-fbd75ae4f18e",
                                        "entry_id": "7f3899c4-9c7e-3c58-97b9-feda30c4f3e8",
                                        "glosses": [
                                            "Téton ; sein"
                                        ],
                                        "tags": [],
                                        "note": "Se dit pour l’homme comme pour la femme",
                                        "examples": [
                                            {
                                                "example_id": "e2146b95-b8e4-4097-a9e3-877f3c467bb0",
                                                "sense_id": "6bd41920-d8e1-3378-9846-fbd75ae4f18e",
                                                "text": "Ô Chef, qui labourais l’écume de la mer,\nDonne-moi ton épée à la garde de fer,\nLa lame que tes bras serrent sur ta mamelle,\nLe glaive qu’ont forgé les Nains, enfants d’Ymer."
                                            },
                                            {
                                                "example_id": "231e83a9-bbf0-471c-ab2d-a18932c0d70f",
                                                "sense_id": "6bd41920-d8e1-3378-9846-fbd75ae4f18e",
                                                "text": "— Ah ! malheur à celui qui laisse la débauche\nPlanter le premier clou sous sa mamelle gauche !\nLe cœur d’un homme vierge est un vase profond :\nLorsque la première eau qu’on y verse est impure,\nLa mer y passerait sans laver la souillure ;\nCar l’abîme est immense, et la tache est au fond."
                                            },
                                            {
                                                "example_id": "a8f1adf0-65c6-4ff5-88ab-bdf1d0adb310",
                                                "sense_id": "6bd41920-d8e1-3378-9846-fbd75ae4f18e",
                                                "text": "Je n’en perdais pas une broquille de toute cette bidoche exposée, de ces mamelles volumineuses, de ces cuisses grasses, vergeturées, s’entrouvrant sur des paysages insoupçonnés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c59e0e5-42af-3767-a8cb-657dd63757b4",
                                        "entry_id": "7f3899c4-9c7e-3c58-97b9-feda30c4f3e8",
                                        "glosses": [
                                            "Sources dont dépend [le complément de nom]."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "plural"
                                        ],
                                        "note": "Cette expression a été utilisée pour la première fois par le duc de Sully, ministre de Henri IV (voire citation ci-dessous) dans une phrase qui devint si célèbre que le modèle fut repris avec des concepts différents par la suite, souvent par plaisanterie",
                                        "examples": [
                                            {
                                                "example_id": "293ec66a-21f4-4cf1-a5de-9c6a37e86526",
                                                "sense_id": "0c59e0e5-42af-3767-a8cb-657dd63757b4",
                                                "text": "Sully, ministre de Henri IV, avait jadis déclaré, dans une célèbre envolée lyrique : « Labourage et pâturage sont les deux mamelles de la France »."
                                            },
                                            {
                                                "example_id": "468c9af6-b06d-426d-ab89-24c988d8ff1c",
                                                "sense_id": "0c59e0e5-42af-3767-a8cb-657dd63757b4",
                                                "text": "Innovation et répression : les deux mamelles de la Chine"
                                            },
                                            {
                                                "example_id": "ef8777bd-c78f-4017-a7d2-f1649bfad732",
                                                "sense_id": "0c59e0e5-42af-3767-a8cb-657dd63757b4",
                                                "text": "Jargon et pathos sont les deux mamelles de l'amphigouri."
                                            },
                                            {
                                                "example_id": "9d424230-873f-4460-871b-23205be8df31",
                                                "sense_id": "0c59e0e5-42af-3767-a8cb-657dd63757b4",
                                                "text": "Bricolage et jardinage, les deux mamelles du temps libre"
                                            },
                                            {
                                                "example_id": "bffaca87-879a-418f-af2a-179e765ee11e",
                                                "sense_id": "0c59e0e5-42af-3767-a8cb-657dd63757b4",
                                                "text": "Humour et colère, les deux mamelles de l'éloquence"
                                            },
                                            {
                                                "example_id": "1c764998-a3f8-43e7-9847-266bfcbe46fa",
                                                "sense_id": "0c59e0e5-42af-3767-a8cb-657dd63757b4",
                                                "text": "Effort collectif, sentiment d'appartenance, projet commun, sécurité d'emploi : ces valeurs désuètes ont été remplacées par compétition et profit, les deux mamelles siliconées de la mondialisation."
                                            },
                                            {
                                                "example_id": "b8e42bf2-0909-4268-9adf-4c31e56c1038",
                                                "sense_id": "0c59e0e5-42af-3767-a8cb-657dd63757b4",
                                                "text": "Réalisme et solidité avaient été les mamelles du Grand Chelem en 2010."
                                            },
                                            {
                                                "example_id": "89efe3f6-9c65-4ff8-9a27-71a1326a29c8",
                                                "sense_id": "0c59e0e5-42af-3767-a8cb-657dd63757b4",
                                                "text": "Grâce à lui, j’apprendrai à conjuguer rigueur et imagination, les deux mamelles, selon moi, du bon avocat."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
