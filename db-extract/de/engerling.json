                "senses": [
                    {
                        "sense_id": "2f11c5e8-f063-36d6-aca5-95e4440e1555",
                        "entry_id": "906a70f9-0923-3db3-bea0-c6e1d2cf8554",
                        "glosses": [
                            "die im Boden lebende Larve insbesondere des Maikäfers und des Junikäfers, aber auch anderer Blatthornkäfer"
                        ],
                        "tags": [
                            "Entomologie"
                        ],
                        "examples": [
                            {
                                "example_id": "4f1a9b73-9352-4b14-9c9b-c5d52865c7dc",
                                "sense_id": "2f11c5e8-f063-36d6-aca5-95e4440e1555",
                                "text": "Engerlinge sind gefürchtete Wurzelschädlinge."
                            },
                            {
                                "example_id": "b65701f0-be94-42ff-93b6-de871e074829",
                                "sense_id": "2f11c5e8-f063-36d6-aca5-95e4440e1555",
                                "text": "„Um die Engerlinge zu vertilgen, tüftelte er sich einen fahrbaren Hühnerkäfig aus, den zwei Männer hinter dem Pfluge herschoben - wobei es nicht ausblieb, daß die Tiere die Pfoten brachen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f2fbb107-6fec-39e9-84f8-ce8f5dd321f4",
                        "entry_id": "906a70f9-0923-3db3-bea0-c6e1d2cf8554",
                        "glosses": [
                            "Hautdassel; Fliegenlarven, die unter der Haut von Huftieren heranwachsen"
                        ],
                        "tags": [
                            "Jägersprache",
                            "sonst veraltet"
                        ],
                        "examples": [
                            {
                                "example_id": "b3ff7e82-252f-4059-b81b-2fdf11490861",
                                "sense_id": "f2fbb107-6fec-39e9-84f8-ce8f5dd321f4",
                                "text": "Engerlinge sind Parasiten."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c732dec8-fac9-4634-a071-54a069651a99",
                        "source_entry_id": "906a70f9-0923-3db3-bea0-c6e1d2cf8554",
                        "source_sense_id": "2f11c5e8-f063-36d6-aca5-95e4440e1555",
                        "source_sense_description": "(Mai)käferlarve",
                        "target_lang_word": "grubworm",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grubworm",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7fb32578-e3d7-3692-97db-94c00662b3d9",
                                        "entry_id": "da76995b-ca1c-36eb-b797-f7504d1aceaa",
                                        "glosses": [
                                            "A grub (the insect)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2c9aedf-c024-4d58-a837-e12b2f61f585",
                                                "sense_id": "7fb32578-e3d7-3692-97db-94c00662b3d9",
                                                "text": "And gnats and grubworms crowded on his view."
                                            },
                                            {
                                                "example_id": "65fecfb9-6159-4bc6-9555-066672bc40a0",
                                                "sense_id": "7fb32578-e3d7-3692-97db-94c00662b3d9",
                                                "text": "grubworms will migrate down into the soil for winter protection from cold temperatures. Most grubworm damage occurs in the late summer and early fall, when turfgrasses are likely to be under increased stress due to lack of moisture."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b062c2d3-907d-4e45-8f01-3b6ae0d9ad37",
                        "source_entry_id": "906a70f9-0923-3db3-bea0-c6e1d2cf8554",
                        "source_sense_id": "2f11c5e8-f063-36d6-aca5-95e4440e1555",
                        "source_sense_description": "(Mai)käferlarve",
                        "target_lang_word": "engerling",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "engerling",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "77bcc236-2c81-34c3-afc3-ab7d7a683031",
                                        "entry_id": "4f8d5980-3d44-3d37-acea-651a175c3435",
                                        "glosses": [
                                            "benaming voor de larve van de meikever, ook gebruikt voor larven van andere kevers als de junikever en Johanneskever"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8315253-6e4a-4fde-874d-04fa993aef06",
                                                "sense_id": "77bcc236-2c81-34c3-afc3-ab7d7a683031",
                                                "text": "Hij miste de engerling, de larve van de meikever die je vond als je in de grond spitte. (…) Een engerling blijft een vies, eng ding dat het gazon aanvreet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86a9c222-cb2e-3fce-a8fc-c5c8a45d1533",
                                        "entry_id": "4f8d5980-3d44-3d37-acea-651a175c3435",
                                        "glosses": [
                                            "persoon die bij anderen angst en afkeer oproept"
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51bdd74e-bf81-4e6d-9e48-049bb2ebb770",
                                                "sense_id": "86a9c222-cb2e-3fce-a8fc-c5c8a45d1533",
                                                "text": "Kent u dat rare kereltje ook al, riep de oude vrouw uit, wat een engerling hè, een kever, een doerak, je zou je straal in hem vergissen. Kom, kom, zei de zeeman sussend, het valt wel mee, zo erg is het niet met hem gesteld, hij is een beetje getikt, maar hij doet geen vlieg kwaad, ik ken hem al jaren, zijn vader was net zo."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
