                                                "sense_id": "a8ca3dfb-1dd3-3784-8ec2-2d31aff546e2",
                                                "text": "„Aceton strömt der Körper aus, wenn er überzuckert ist, wenn ein Diabetiker also kein Insulin zu sich nimmt, um seinen Zuckerpegel zu stabilisieren.“"
                                            },
                                            {
                                                "example_id": "37ae4461-2cc4-43dc-8933-9052033774ee",
                                                "sense_id": "a8ca3dfb-1dd3-3784-8ec2-2d31aff546e2",
                                                "text": "Den Zellen fehlt der Energielieferant, während das Blut überzuckert."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2e7d61ca-f13d-3559-91a4-83c68ba0ebc4",
                                        "entry_id": "02c44c4a-2ca1-354b-acb2-b11803176c4d",
                                        "glosses": [
                                            "durchschaut, draufgekommen"
                                        ],
