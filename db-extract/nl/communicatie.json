                    {
                        "sense_id": "c9940070-2996-3a39-bbc3-1048b98abc51",
                        "entry_id": "e52fb5b0-18c3-33e6-b2d0-ca4010d5fcfc",
                        "glosses": [
                            "het uitwisselen van informatie waarbij zender, ontvanger, inhoud en communicatiemedium betrokken zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92a0fd07-0604-410f-aefa-0c477a401f9b",
                                "sense_id": "c9940070-2996-3a39-bbc3-1048b98abc51",
                                "text": "Dat team staat bekend om hun goede communicatie."
                            },
                            {
                                "example_id": "f82a00e2-ef39-4074-a66e-37f09cd66b47",
                                "sense_id": "c9940070-2996-3a39-bbc3-1048b98abc51",
                                "text": "Terwijl zijn gevoel hem iets anders influisterde, hield hij het op een misverstand in de communicatie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1bef92ad-f149-4e06-be0c-4d508c854f17",
                        "source_entry_id": "e52fb5b0-18c3-33e6-b2d0-ca4010d5fcfc",
                        "source_sense_id": "c9940070-2996-3a39-bbc3-1048b98abc51",
                        "source_sense_description": "het uitwisselen van informatie",
                        "target_lang_word": "Kommunikation",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kommunikation",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "29ef40a9-35ef-3b02-b4ad-e29ec5056485",
                                        "entry_id": "62164a90-5de1-3000-b1d8-bfad5b3ea9a9",
                                        "glosses": [
                                            "Handlung zwischen Menschen und Organisationen unter gegenseitiger Bezugnahme mit zwei oder mehr Akteuren (möglicherweise auch über ein Medium); Informationsmitteilung in Form von Zeichen, Ziel ist das Verstehen dieser Mitteilungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74d19c8e-5de6-4534-86cd-b6769421cc6f",
                                                "sense_id": "29ef40a9-35ef-3b02-b4ad-e29ec5056485",
                                                "text": "Wir müssen dringend über unsere Art der Kommunikation reden."
                                            },
                                            {
                                                "example_id": "9be5f105-550e-4df7-9fd9-028deeccf269",
                                                "sense_id": "29ef40a9-35ef-3b02-b4ad-e29ec5056485",
                                                "text": "Nach dem Flugzeugabsturz waren die Überlebenden von jeglicher Kommunikation abgeschnitten."
                                            },
                                            {
                                                "example_id": "e3e23f4e-ed1a-4f7d-aac6-1f5fb0c5b918",
                                                "sense_id": "29ef40a9-35ef-3b02-b4ad-e29ec5056485",
                                                "text": "„Therapeutische Kommunikationen gehen also notwendigerweise über solche Ratschläge hinaus, die gewöhnlich, aber zweckloserweise die Betroffenen sich selbst geben beziehungsweise die ihnen von ihren Verwandten und Freunden gegeben werden.“"
                                            },
                                            {
                                                "example_id": "d8cea05b-4c10-4cb3-8be5-907b22218b9c",
                                                "sense_id": "29ef40a9-35ef-3b02-b4ad-e29ec5056485",
                                                "text": "„Es wäre wahrscheinlich gut, wenn wir eine regelmäßige bilaterale Sitzung zur Koordination unserer internen Kommunikation einrichten würden.“"
                                            },
                                            {
                                                "example_id": "7efdcd96-bbf1-4f93-ac20-2a93a0aff56d",
                                                "sense_id": "29ef40a9-35ef-3b02-b4ad-e29ec5056485",
                                                "text": "„Die Telegrafie, die nur eine Generation davor entwickelt worden war, stellte die Kommunikation auf den Kopf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "660fa6b7-c4ec-409b-80e2-d069d0cf74e8",
                        "source_entry_id": "e52fb5b0-18c3-33e6-b2d0-ca4010d5fcfc",
                        "source_sense_id": "c9940070-2996-3a39-bbc3-1048b98abc51",
