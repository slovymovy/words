                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unfilmable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1feb9fbe-db42-312c-8bb0-7f1cbf3b966d",
                                        "entry_id": "52efc85f-702e-3d25-b78d-5cfda8b43031",
                                        "glosses": [
                                            "Not suitable or able to be filmed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7268b175-78af-4ec0-b559-db5c2c4c942d",
                                                "sense_id": "1feb9fbe-db42-312c-8bb0-7f1cbf3b966d",
                                                "text": "The dense, bleak, multilayered graphic novel was declared unfilmable first by its writer Alan Moore and then by 12 Monkeys director Terry Gilliam, who was the first man to try and fail."
                                            },
                                            {
                                                "example_id": "e3c120a8-bda2-482f-80e3-c46f3559e25a",
                                                "sense_id": "1feb9fbe-db42-312c-8bb0-7f1cbf3b966d",
                                                "text": "But Benioff, Weiss, and their collaborator Alexander Woo have undoubtedly proved yet again that there is no such thing as an unfilmable novel."
                                            }
