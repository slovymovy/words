{
    "word_family": [
        "compatible",
        "compatibly",
        "incompatibility",
        "incompatible"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9cdf9bee-894d-3c2a-a51f-019e5b88d837",
                    "sense_definition": "The state in which two or more things are able to exist or work together without problems or conflict.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "general_compatibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The couple decided to take a personality test to check their <w>compatibility</w> before getting married.",
                            "target_lang_translations": {
                                "ru": "Пара решила пройти тест личности, чтобы проверить свою <w>совместимость</w> перед свадьбой."
                            }
                        },
                        {
                            "text": "The main issue with the new software was its lack of <w>compatibility</w> with older operating systems.",
                            "target_lang_translations": {
                                "ru": "Основной проблемой нового программного обеспечения было отсутствие <w>совместимости</w> со старыми операционными системами."
                            }
                        }
                    ],
                    "synonyms": [
                        "accord",
                        "harmony",
                        "consistency"
                    ],
                    "antonyms": [
                        "incompatibility",
                        "conflict",
                        "clash"
                    ],
                    "common_phrases": [
                        "lack of compatibility",
                        "ensure compatibility",
                        "test for compatibility"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние, при котором две или более вещи способны существовать или работать вместе без проблем или конфликтов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "совместимость",
                                "target_lang_sense_clarification": "способность сосуществовать или взаимодействовать"
                            },
                            {
                                "target_lang_word": "сочетаемость",
                                "target_lang_sense_clarification": "способность гармонично сочетаться"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dfe37068-e6e2-3d0f-851d-37f3bda1dc41",
                    "sense_definition": "The ability of a computer, device, or software program to work with other equipment or software without modification.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "technical_compatibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The developer worked hard to maintain backward <w>compatibility</w> so that users wouldn't lose their old files.",
                            "target_lang_translations": {
                                "ru": "Разработчик усердно работал над поддержанием обратной <w>совместимости</w>, чтобы пользователи не потеряли свои старые файлы."
                            }
                        },
                        {
                            "text": "Before buying the new graphics card, you should check its hardware <w>compatibility</w> with your motherboard.",
                            "target_lang_translations": {
                                "ru": "Перед покупкой новой видеокарты следует проверить её аппаратную <w>совместимость</w> с материнской платой."
                            }
                        }
                    ],
                    "synonyms": [
                        "interoperability"
                    ],
                    "antonyms": [
                        "incompatibility"
                    ],
                    "common_phrases": [
                        "backward compatibility",
                        "hardware compatibility",
                        "software compatibility"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Способность компьютера, устройства или программы работать с другим оборудованием или программным обеспечением без модификации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "совместимость",
                                "target_lang_sense_clarification": "техническая или программная"
                            },
                            {
                                "target_lang_word": "взаимозаменяемость",
                                "target_lang_sense_clarification": "способность работать в разных системах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "87c945b1-f7c1-3b3c-907b-605330f90e3e",
                    "sense_definition": "The continuity or good fit of materials or components while they are being deformed or used in a physical system.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "technical_compatibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Engineers must ensure the material <w>compatibility</w> of the alloys to prevent structural failure under high pressure.",
                            "target_lang_translations": {
                                "ru": "Инженеры должны обеспечить <w>совместимость</w> материалов сплавов, чтобы предотвратить разрушение конструкции под высоким давлением."
                            }
                        },
                        {
                            "text": "The <w>compatibility</w> of the two substances was tested to see if they would bond correctly during the cooling process.",
                            "target_lang_translations": {
                                "ru": "<w>Совместимость</w> двух веществ была протестирована, чтобы выяснить, правильно ли они соединятся в процессе охлаждения."
                            }
                        }
                    ],
                    "synonyms": [
                        "suitability",
                        "congruity"
                    ],
                    "common_phrases": [
                        "material compatibility",
                        "structural compatibility"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "scientific"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Непрерывность или хорошее соответствие материалов или компонентов при их деформации или использовании в физической системе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "совместимость",
                                "target_lang_sense_clarification": "физико-химическая или структурная"
                            },
                            {
                                "target_lang_word": "соответствие",
                                "target_lang_sense_clarification": "пригодность материалов друг другу"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}