                                    {
                                        "sense_id": "4735f5b5-9ba4-3c67-9f1a-370badc2741a",
                                        "entry_id": "db2b55a9-d324-3b31-8955-7f525a8470d8",
                                        "glosses": [
                                            "Sacre ; couronnement d'un souverain."
                                        ],
