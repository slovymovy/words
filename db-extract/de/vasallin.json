                        "glosses": [
                            "feste, ständige Anhängerin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25d06d08-c0b9-4fd3-a1c7-68c20207ade1",
                                "sense_id": "943d61b0-0106-31a9-b5ba-c6b1f60291e4",
                                "text": "„In einer Pause jedenfalls kam Tatiana, begleitet von ihren getreuen Vasallinnen, zu uns herübergeschwebt, während ich auf einer Steinkante auf dem Schulhof saß und in mein Forschungsheft zeichnete und Milena daneben im Sand spielte und mir von der neuen Haarspange erzählte, die Amalia ihr gekauft hatte.“"
                            }
                        ],
