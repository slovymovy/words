                "senses": [
                    {
                        "sense_id": "3654d5ea-ed0b-33c8-aeb3-4bb94c6d46d7",
                        "entry_id": "fafe130d-1984-361d-a4ac-0b3718c7055c",
                        "glosses": [
                            "festliche Veranstaltung eines Unternehmens für dessen Angestellte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "efd17001-602f-47d1-b1a8-1a1062cf1d56",
                                "sense_id": "3654d5ea-ed0b-33c8-aeb3-4bb94c6d46d7",
                                "text": "„Deshalb wurden die ‚Oldies‘ auch gerne bei runden Geburtstagen, bei Firmenfeiern oder auch im ‚Gläsernen Studio‘ auf dem Maimarkt in Anspruch genommen.“"
                            },
                            {
                                "example_id": "1ea74bd4-64c7-456b-b9b3-b023cf17e3eb",
                                "sense_id": "3654d5ea-ed0b-33c8-aeb3-4bb94c6d46d7",
                                "text": "„Der Kalender hat da andere Pläne: Freundestreffen, Firmenfeier, noch eine Freundesfeier eine Woche später und zwischendrin ein Kurzurlaub mit Weihnachtsmarktbesuch.“"
                            },
                            {
                                "example_id": "c577c106-aa9d-4fca-a489-b4d4e7a62e44",
                                "sense_id": "3654d5ea-ed0b-33c8-aeb3-4bb94c6d46d7",
                                "text": "„Bei einem Streit nach einer Firmenfeier auf einem Gastronomieschiff in Bremen sind mehrere Menschen verletzt worden, darunter auch Polizisten und ein Rettungssanitäter.“"
                            },
                            {
                                "example_id": "7ee5c3f4-b3d7-4124-b9e4-ef59e35e574c",
                                "sense_id": "3654d5ea-ed0b-33c8-aeb3-4bb94c6d46d7",
                                "text": "„Mehrere Tickets für die Porsche-Chance und neue, mitunter selbstgenähte Outfits inklusive – in der Oper steigt eine kleine Firmenfeier der etwas anderen Art.“"
                            },
                            {
                                "example_id": "8b2866fc-f120-41ee-aae1-8c2c0346a61d",
                                "sense_id": "3654d5ea-ed0b-33c8-aeb3-4bb94c6d46d7",
                                "text": "„Aber er meinte auch, dass es sich nicht gross anders anfühle als ein Konzert an einer Hochzeit oder Firmenfeier zu spielen.“"
                            },
                            {
                                "example_id": "df32400b-46cb-48c1-9c84-ef3f7fbce19b",
                                "sense_id": "3654d5ea-ed0b-33c8-aeb3-4bb94c6d46d7",
                                "text": "„Na, habt ihr bei bei der diesjährigen Firmenfeier ein bisschen zu tief in den Glühwein geschaut?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
