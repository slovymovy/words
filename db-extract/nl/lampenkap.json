                    }
                ],
                "translations": [
                    {
                        "translation_id": "061b93de-41f2-4bd4-bac0-75440517f56e",
                        "source_entry_id": "dab4f47e-34d3-3e9f-a386-4b9366e6ad96",
                        "source_sense_id": "5d74925a-74ee-30fd-b89c-a7781a0d0a44",
                        "source_sense_description": "kap over een lamp om het licht af te schermen",
                        "target_lang_word": "Lampenschirm",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lampenschirm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ac7110b5-fa83-3c4a-9453-0ef4c5fa1041",
                                        "entry_id": "14111545-9fbb-3c4b-8e71-391930c61458",
                                        "glosses": [
                                            "Abdeckung um eine Lampe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfd2e432-a6df-403c-acc1-a2c521a75f7c",
                                                "sense_id": "ac7110b5-fa83-3c4a-9453-0ef4c5fa1041",
                                                "text": "„Wir fertigen und reparieren Lampenschirme oder fertigen nach Ihrem Wünschen.“"
                                            },
                                            {
                                                "example_id": "9427cb14-73bf-4781-a2df-06caaba87659",
                                                "sense_id": "ac7110b5-fa83-3c4a-9453-0ef4c5fa1041",
                                                "text": "„Bobby durchquerte den Raum mit dreizehn Schritten, wobei er sich in der Mitte duckte, um dem Lampenschirm auszuweichen.“"
                                            },
                                            {
                                                "example_id": "0b3a2a2a-4be0-4836-9d17-c5f65eb95e03",
                                                "sense_id": "ac7110b5-fa83-3c4a-9453-0ef4c5fa1041",
                                                "text": "„Unter meinem aus einer Serviette gemachten Lampenschirm beobachtete ich Konrad, der neben mir in seinem Bett den Schlaf eines Kindesa schlief, trotz der Schritte über uns, die von Tante Praskovia herrührten.“"
                                            },
                                            {
                                                "example_id": "1124bdb4-fef7-4a8a-b2fd-fb15f5126b55",
                                                "sense_id": "ac7110b5-fa83-3c4a-9453-0ef4c5fa1041",
                                                "text": "„Wie sie so zurückgelehnt in dem Korbstuhl saß, fiel das sanfte Licht eines Lampenschirmes auf sie, spielte über ihr liebes, ernstes Gesicht und verlieh den Ringellocken ihres üppigen Haares einen matten, metallischen Schimmer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b6cea314-5c60-4df1-ba36-10a55029dd3c",
                        "source_entry_id": "dab4f47e-34d3-3e9f-a386-4b9366e6ad96",
                        "source_sense_id": "5d74925a-74ee-30fd-b89c-a7781a0d0a44",
                        "source_sense_description": "kap over een lamp om het licht af te schermen",
                        "target_lang_word": "Abatjour",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abatjour",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d753535e-13b4-31f9-8f53-ff3c0a7d1621",
                                        "entry_id": "255675e5-b741-34d7-a3a7-fd96dba944bb",
                                        "glosses": [
                                            "ein Fenster mit einer abgeschrägten Laibung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37a7afc3-cd56-4db8-9ed7-51926233c1d4",
                                                "sense_id": "d753535e-13b4-31f9-8f53-ff3c0a7d1621",
                                                "text": "Gefängnisfenster sind oft als Abatjour ausgeführt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "34987ebe-4073-35e6-b994-a72dc47ac9d9",
                                        "entry_id": "255675e5-b741-34d7-a3a7-fd96dba944bb",
                                        "glosses": [
                                            "ein Oberlicht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f891dfa-3f5c-4067-a437-4ac9086afdea",
                                                "sense_id": "34987ebe-4073-35e6-b994-a72dc47ac9d9",
                                                "text": "Industriell gefertigte, in der Decke integrierte Abatjours aus Kunststoff werden häufig zur kostengünstigen Belichtung genutzt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "57b4e0a1-9166-3102-a209-45033a7f445d",
                                        "entry_id": "255675e5-b741-34d7-a3a7-fd96dba944bb",
                                        "glosses": [
                                            "Lampenschirm"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60b33f56-8607-48f8-a971-08ef55cd90b4",
                                                "sense_id": "57b4e0a1-9166-3102-a209-45033a7f445d",
                                                "text": "Der Abatjour an einer Leuchte leitet das Licht in eine bestimmte Richtung und kann die Raumatmosphäre vollkommen verändern."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "355ffd24-fac1-4889-9948-d878a22f5285",
                        "source_entry_id": "dab4f47e-34d3-3e9f-a386-4b9366e6ad96",
                        "source_sense_id": "5d74925a-74ee-30fd-b89c-a7781a0d0a44",
                        "source_sense_description": "kap over een lamp om het licht af te schermen",
                        "target_lang_word": "lampshade",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lampshade",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "98309433-7603-3c57-9910-fee3d07702b0",
                                        "entry_id": "f732af46-bd62-3ef8-b45a-ff93011c1c1e",
                                        "glosses": [
                                            "A cover over a lamp to either diffuse the light or to block it in certain directions to avoid glare in the eyes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "lampshade",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c38daa1b-882d-37c6-9710-5803b68e5cae",
                                        "entry_id": "0b18d5a1-2aa1-34b5-9211-fcee3eb3fbd2",
                                        "glosses": [
                                            "To intentionally call attention to the improbable, incongruent, or clichéd nature of an element or situation featured in a work of fiction within the work itself."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5d4e52d-d215-4387-8ada-7b745a533a75",
                                                "sense_id": "c38daa1b-882d-37c6-9710-5803b68e5cae",
                                                "text": "Only one short bit of humor is endearing, lampshading the ridiculousness of an eye-mask being able to conceal a superhero's identity."
                                            },
                                            {
                                                "example_id": "fd3795ed-3cd0-4305-82a7-980aba4d58a7",
                                                "sense_id": "c38daa1b-882d-37c6-9710-5803b68e5cae",
                                                "text": "Rewriting a whole character is one heck of a chore but the editor/writer must either bite the bullet or indulge in some clever trickery like lampshading."
                                            },
                                            {
                                                "example_id": "754beb55-9feb-49a3-9523-e9438d451ddb",
                                                "sense_id": "c38daa1b-882d-37c6-9710-5803b68e5cae",
                                                "text": "Just as the push by writers in season 4 to make Homer stupider (a trend so established it was lampshaded in \"The 138th Episode Spectacular\") created some of the best episodes before eventually birthing an unlikable buffoon unaffectionately called \"Jerkass Homer\", so too is it less the episode itself as much as what it represented."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d698b348-7efc-3b46-8489-c058b4e4a2dc",
                                        "entry_id": "0b18d5a1-2aa1-34b5-9211-fcee3eb3fbd2",
                                        "glosses": [
                                            "To wear an oversize top with skintight thigh-high boots and no leggings."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a4551a4-7bf6-4574-9c92-3977ca0e719a",
                                                "sense_id": "d698b348-7efc-3b46-8489-c058b4e4a2dc",
                                                "text": "Pants. Who needs them? Definitely not celebrities sporting the lampshading or \"no pants\" trend this summer."
                                            },
                                            {
                                                "example_id": "126d99a0-0370-4dce-898e-5e6ca8fddc8f",
                                                "sense_id": "d698b348-7efc-3b46-8489-c058b4e4a2dc",
                                                "text": "Kate Moss lampshaded, Bella Hadid lampshaded—hell, nearly every Kardashian took the trend for a spin."
                                            },
                                            {
                                                "example_id": "5e222984-bee9-4095-99a7-15fc1208eaac",
                                                "sense_id": "d698b348-7efc-3b46-8489-c058b4e4a2dc",
                                                "text": "Lampshading – or, wearing an oversized top with over-the-knee boots – isn't just for Ariana Grande."
                                            },
                                            {
                                                "example_id": "7c66832f-8ff2-4c4c-bbe2-204f94f057e7",
                                                "sense_id": "d698b348-7efc-3b46-8489-c058b4e4a2dc",
                                                "text": "Adding to this, she aces the casual-chic look of oversized sweatshirts and hoodies paired with thigh-high boots, known as lampshading."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4fc20ac-fe7a-3a83-a4c2-7f4ccf2224b2",
                                        "entry_id": "0b18d5a1-2aa1-34b5-9211-fcee3eb3fbd2",
                                        "glosses": [
                                            "To adorn with one or more lampshades."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66ef3934-a234-4d1a-8dc3-7ca8ddb90d38",
                                                "sense_id": "b4fc20ac-fe7a-3a83-a4c2-7f4ccf2224b2",
                                                "text": "Her hotel sitting-room had, as usual, been flowered, cushioned and lampshaded into a delusive semblance of stability; and she had really felt, for the last few weeks, that the life she was leading there must be going to last — it seemed so perfect an answer to all her wants!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb3a344f-8f82-3645-828c-3af8b6b27bd3",
                                        "entry_id": "0b18d5a1-2aa1-34b5-9211-fcee3eb3fbd2",
                                        "glosses": [
                                            "To design or create lampshades."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34d47702-f428-407b-b5ab-7773618adedb",
                                                "sense_id": "bb3a344f-8f82-3645-828c-3af8b6b27bd3",
                                                "text": "Ruth Vitow (160 East 56th Street, 355-6881) has been the doyenne of lampshading for 30 years. She makes up designs in all categories, and her own custom lamps of Lucite and wood."
                                            },
                                            {
                                                "example_id": "f23759d7-c288-40e3-a589-d703357f78e6",
                                                "sense_id": "bb3a344f-8f82-3645-828c-3af8b6b27bd3",
                                                "text": "Finally she took a job decorating lampshades. Lampshading, as she called it, left her drained and without impetus or inspiration to draw, which always made her unhappy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "359cb1a8-07bd-49cb-a0db-875c947ae4b0",
                        "source_entry_id": "dab4f47e-34d3-3e9f-a386-4b9366e6ad96",
                        "source_sense_id": "5d74925a-74ee-30fd-b89c-a7781a0d0a44",
                        "source_sense_description": "kap over een lamp om het licht af te schermen",
                        "target_lang_word": "abat-jour",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abat-jour",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0ffb15e0-53f1-348f-9254-d47f9f8f0fcf",
                                        "entry_id": "c45c8926-eca1-32fc-be85-a63f8503555f",
                                        "glosses": [
                                            "Cadre ou réflecteur en papier ou en tissu pourvu souvent d’une armature en métal que l’on place sur les lampes ou à tout autre éclairage pour diriger la lumière tout en protégeant les yeux de l’éblouissement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f71b0658-a668-4bc3-bdb3-b5f4a0db8fab",
                                                "sense_id": "0ffb15e0-53f1-348f-9254-d47f9f8f0fcf",
                                                "text": "D’autres fabricants ont recouvert la face intérieure de l’abat-jour d’une feuille métallique, de manière à en faire une espèce de réflecteur."
                                            },
                                            {
                                                "example_id": "812a322f-6221-4983-bffd-e2b239a1971a",
                                                "sense_id": "0ffb15e0-53f1-348f-9254-d47f9f8f0fcf",
                                                "text": "Un propriétaire intraitable lui avait vendu ses meubles, l’hiver dernier ; et, depuis ce temps, elle logeait à l’hôtel, avec sa fille Adèle, une gamine de dix ans. Toutes deux découpaient des abat-jour, c’était au plus si elles gagnaient quarante sous à cette besogne."
                                            },
                                            {
                                                "example_id": "bf198d56-43b2-463e-8caa-e5918f63c096",
                                                "sense_id": "0ffb15e0-53f1-348f-9254-d47f9f8f0fcf",
                                                "text": "Elle est appuyée d’une main sur la table où brille la lampe sans abat-jour…"
                                            },
                                            {
                                                "example_id": "07dea4bd-6433-4bc6-b953-ebfcfdd1f2f6",
                                                "sense_id": "0ffb15e0-53f1-348f-9254-d47f9f8f0fcf",
                                                "text": "Baisse un peu l’abat-jour, veux-tu ? Nous serons mieux.\nC’est dans l’ombre que les cœurs causent,\net l’on voit beaucoup mieux les yeux\nquand on voit un peu moins les choses."
                                            },
                                            {
                                                "example_id": "63a0f317-7c25-4241-aeee-be8307ff0664",
                                                "sense_id": "0ffb15e0-53f1-348f-9254-d47f9f8f0fcf",
                                                "text": "Une glace munie d’une tablette en bois blanc se trouvait fixée contre un des murs et éclairée par deux ampoules sans abat-jour."
                                            },
                                            {
                                                "example_id": "5a57c312-b281-4486-82a4-574483ec8fa4",
                                                "sense_id": "0ffb15e0-53f1-348f-9254-d47f9f8f0fcf",
                                                "text": "D’abord, et surtout, c’était la salle à manger, avec en son milieu une longue table de chêne blond éclairée par une suspension de cuivre habillé d'un abat-jour en porcelaine surmonté d'une grosse boule colorée que l’on appelait « le monte-baisse »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd6dd094-8199-3648-9d0d-482472a25748",
                                        "entry_id": "c45c8926-eca1-32fc-be85-a63f8503555f",
                                        "glosses": [
                                            "Volet ou claire-voie que l’on place devant les ouvertures des habitations pour arrêter les rayons du soleil ou les insectes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1e9dbd46-e946-3665-9a0d-33cc08ceed5c",
                                        "entry_id": "c45c8926-eca1-32fc-be85-a63f8503555f",
                                        "glosses": [
                                            "Sorte de store ou de jalousie, constitué de lattes en bois, posé à l’extérieur de fenêtres à Lyon."
                                        ],
                                        "tags": [
                                            "Lyonnais"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e8c3688-fec3-4e27-b835-7240e791948f",
                                                "sense_id": "1e9dbd46-e946-3665-9a0d-33cc08ceed5c",
                                                "text": "Tous les anciens immeubles de Lyon ont leurs fenêtres équipées d’abat-jour."
                                            },
                                            {
                                                "example_id": "cdf9ab4f-9c54-4ba0-82ab-535abe865cb8",
                                                "sense_id": "1e9dbd46-e946-3665-9a0d-33cc08ceed5c",
                                                "text": "C’est ce qu’en français on nomme jalousie, c’est-à-dire un assemblage de lamelles de sapin mobiles et suspendues à des chaînettes, de manière qu’on peut, à l’aide d’une petite corde enroulée sur un cylindre, les faire monter et descendre à volonté. L’abat-jour est placé au-devant d’une fenêtre pour défendre des rayons du soleil. L’abat-jour ne s’emploie guère qu’à Lyon et aux environs. À Paris et dans le Midi, on ne se sert que de persiennes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f5bb12e-77f9-3254-a2c9-69a0f151778d",
                                        "entry_id": "c45c8926-eca1-32fc-be85-a63f8503555f",
                                        "glosses": [
                                            "Auvent."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d171c017-61aa-3b3e-b8b7-766cab448127",
                                        "entry_id": "c45c8926-eca1-32fc-be85-a63f8503555f",
                                        "glosses": [
                                            "Fenêtre disposée de manière à diriger le jour obliquement de haut en bas."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a5e3b76-fc8b-4823-8c47-a94dfb683e5c",
                                                "sense_id": "d171c017-61aa-3b3e-b8b7-766cab448127",
                                                "text": "Les croisées de cette prison sont garnies d’abat-jour."
                                            },
                                            {
                                                "example_id": "2cb124c6-6e2b-435b-a9e4-04d7822826f7",
                                                "sense_id": "d171c017-61aa-3b3e-b8b7-766cab448127",
                                                "text": "Les marchands ont des abat-jour dans leurs magasins pour faire paraître leurs marchandises plus belles."
                                            },
                                            {
                                                "example_id": "c51a9d1c-e4e5-4f28-bdf4-9b23cb25c453",
                                                "sense_id": "d171c017-61aa-3b3e-b8b7-766cab448127",
                                                "text": "Ordinairement les fenêtres des églises sont taillées en abat-jour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2123ffb-16da-32b6-9d6c-fffa1c4c16da",
                                        "entry_id": "c45c8926-eca1-32fc-be85-a63f8503555f",
                                        "glosses": [
                                            "Forme qui protège de la lumière du soleil."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75a3abe2-5c95-44cf-ba42-29fc52bcd05f",
                                                "sense_id": "b2123ffb-16da-32b6-9d6c-fffa1c4c16da",
                                                "text": "[…], les femmes, debout, les mains en abat-jour au-dessus des yeux, détaillaient tout haut les deux Parisiennes, leurs petits chapeaux de voyage, leurs robes collantes, sans bijoux, d’un si grand contraste avec les toilettes locales : […]."
                                            },
                                            {
                                                "example_id": "a140c749-9dea-4813-a630-fa22165d9888",
                                                "sense_id": "b2123ffb-16da-32b6-9d6c-fffa1c4c16da",
                                                "text": "Arrivé au porche d’entrée, il regarda sur la route de Saumur, la main en abat-jour et la figure grimaçante, à cause du soleil qui se trouvait bas, juste en face."
                                            },
                                            {
                                                "example_id": "cebff0f8-6550-49c1-80ce-e3d7d157d830",
                                                "sense_id": "b2123ffb-16da-32b6-9d6c-fffa1c4c16da",
                                                "text": "La Moussotte allait de temps à autre jusqu’au seuil de la porte, interrogeant le coin du bois d’où la route s’échappait de la forêt, la main en abat-jour sur les yeux, […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
