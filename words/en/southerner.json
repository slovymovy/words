                },
                {
                    "sense_id": "03ffab38-6fa2-359f-a519-fa61b363e62c",
                    "sense_definition": "A supporter, soldier, or citizen of the Confederate States of America during the American Civil War.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "historical",
                    "name_type": "historical_name",
                    "examples": [
                        {
                            "text": "During the Civil War, many a <w>Southerner</w> fought to protect their home state against Union troops.",
                            "target_lang_translations": {
                                "es": "Durante la guerra civil, más de un <w>sureño</w> luchó para defender su estado natal contra las tropas de la Unión."
                            }
                        },
                        {
                            "text": "The museum display shows uniforms that were commonly worn by a Confederate <w>Southerner</w> in battle.",
                            "target_lang_translations": {
                                "es": "La exhibición del museo muestra los uniformes que solía llevar en batalla un <w>sureño</w> confederado."
                            }
                        }
                    ],
                    "synonyms": [
