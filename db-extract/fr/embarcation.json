        "fr-extract.jsonl": [
            {
                "entry_id": "6e1ab70c-378e-3c5f-96f2-5efd8d659e30",
                "word": "embarcation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "483317ca-23d9-43f7-bb58-e95513840787",
                        "entry_id": "6e1ab70c-378e-3c5f-96f2-5efd8d659e30",
                        "tags": [
                            "plural"
                        ],
                        "form": "embarcations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0f1007f4-6b51-39f6-87f5-04e422d31f5e",
                        "entry_id": "6e1ab70c-378e-3c5f-96f2-5efd8d659e30",
                        "glosses": [
                            "Bateau de petite taille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "559018c9-7b30-4c1b-8def-f9e7dc5c72d5",
                                "sense_id": "0f1007f4-6b51-39f6-87f5-04e422d31f5e",
                                "text": "Des matelots tiraient, l’épaule courbée, des embarcations sur le quai."
                            },
                            {
                                "example_id": "05d2c7cf-6de0-4e60-93be-3b552b764db1",
                                "sense_id": "0f1007f4-6b51-39f6-87f5-04e422d31f5e",
                                "text": "[…]; et l’on voyait déjà quelques embarcations filer doucement sur l’eau que battaient les grands avirons, pareils à des vols de goélands lents et bas. On était au plus fort de la pêche du maquereau."
                            },
                            {
                                "example_id": "f92abeed-4de9-4b32-a3da-b027ebab0499",
                                "sense_id": "0f1007f4-6b51-39f6-87f5-04e422d31f5e",
                                "text": "La capture des baleinoptères par des procédés modernes a remplacé la tuerie périodique des bandes de marsouins rabattus par les embarcations au fond des baies."
                            },
                            {
                                "example_id": "fd374f0d-29d8-41e7-83ef-261b6410283f",
                                "sense_id": "0f1007f4-6b51-39f6-87f5-04e422d31f5e",
                                "text": "L’énorme rouf construit sur l’embarcation et son gréement, démontraient l’inexpérience totale que son propriétaire avait des choses de la mer."
                            },
                            {
                                "example_id": "a324daf1-1fd8-4f1a-9010-08394cdf26fb",
                                "sense_id": "0f1007f4-6b51-39f6-87f5-04e422d31f5e",
                                "text": "Ordre fut donné au charpentier Mac Nap de procéder à la construction d’une vaste embarcation."
                            }
                        ]
                    },
                    {
                        "sense_id": "9a3e6a5a-78ef-3580-8606-733eed297487",
                        "entry_id": "6e1ab70c-378e-3c5f-96f2-5efd8d659e30",
                        "glosses": [
                            "Bateau de petite taille équipant un navire, qui permet notamment de faire la navette jusqu’à terre ou de sauver les personnes à bord en cas de naufrage."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "53834ea3-a9bb-4800-9ee1-6b77ff8a9c61",
                                "sense_id": "9a3e6a5a-78ef-3580-8606-733eed297487",
                                "text": "L’équipage parvint à se sauver dans les embarcations du bâtiment, et une partie gagna un navire américain qui était alors à l’ancre dans la baie de Myanboor."
                            }
                        ]
                    },
                    {
                        "sense_id": "dfbd8c8e-8506-3c85-94b0-44636937e6cc",
                        "entry_id": "6e1ab70c-378e-3c5f-96f2-5efd8d659e30",
                        "glosses": [
                            "Embarquement."
                        ],
                        "tags": [],
                        "note": "Cet emploi est communément jugé abusif. Il est cependant compris par le locuteur francophone (embarquer & -ation : « action d’embarquer »). référence nécessaire (résoudre le problème",
                        "examples": [
                            {
                                "example_id": "e8e4b65b-e7f9-4f5a-8ebb-a7d39ac7a9b8",
                                "sense_id": "dfbd8c8e-8506-3c85-94b0-44636937e6cc",
                                "text": "Un dégrad se trouve au bord d'un cours d’eau et permet l’embarcation des passagers d'une pirogue. Aujourd'hui, par extension, le mot « dégrad » s'applique à tous les ports fluviaux de Guyane."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6b57d073-48d7-438c-8652-54e17c245d1c",
                        "source_entry_id": "6e1ab70c-378e-3c5f-96f2-5efd8d659e30",
                        "source_sense_description": "Bateau de petite taille",
                        "target_lang_word": "boat",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "boat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7f2367e2-508f-3ec1-9836-97215587e25f",
                                        "entry_id": "dddbf112-2377-3a3f-a890-2ebdc2a962d7",
                                        "glosses": [
                                            "A craft used for transportation of goods, fishing, racing, recreational cruising, or military use on or in the water, propelled by oars or outboard motor or inboard motor or by wind."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5d10790-8f66-4fc7-b13b-ed36a28ceb5d",
                                                "sense_id": "7f2367e2-508f-3ec1-9836-97215587e25f",
                                                "text": "Carried somehow, somewhither, for some reason, on these surging floods, were these travelers,[…]. Even such a boat as the Mount Vernon offered a total deck space so cramped as to leave secrecy or privacy well out of the question, even had the motley and democratic assemblage of passengers been disposed to accord either."
                                            },
                                            {
                                                "example_id": "ad9de006-de2e-4a6b-b4ff-195c04a2e824",
                                                "sense_id": "7f2367e2-508f-3ec1-9836-97215587e25f",
                                                "text": "Philander went into the next room[…]and came back with a salt mackerel[…]. Next he put the mackerel in a fry-pan, and the shanty began to smell like a Banks boat just in from a v'yage."
                                            },
                                            {
                                                "example_id": "fbbb7a7e-0a1b-479a-8f80-8ce44754f912",
                                                "sense_id": "7f2367e2-508f-3ec1-9836-97215587e25f",
                                                "text": "The dawn of the oil age was fairly recent. Although the stuff was used to waterproof boats in the Middle East 6,000 years ago, extracting it in earnest began only in 1859 after an oil strike in Pennsylvania. The first barrels of crude fetched $18 (around $450 at today’s prices)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "294e6473-9ae6-33a9-98ad-5e48f33ab9ae",
                                        "entry_id": "dddbf112-2377-3a3f-a890-2ebdc2a962d7",
                                        "glosses": [
                                            "A full house."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c0b81dc3-4bff-3ae4-b44f-d5d28e24f206",
                                        "entry_id": "dddbf112-2377-3a3f-a890-2ebdc2a962d7",
                                        "glosses": [
                                            "A conveyance, utensil, or dish somewhat resembling a boat in shape."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7d5a04e-f16a-4551-8572-bda64c247912",
                                                "sense_id": "c0b81dc3-4bff-3ae4-b44f-d5d28e24f206",
                                                "text": "a stone boat;   a gravy boat"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0840b77c-7001-388a-a203-40525e2536d6",
                                        "entry_id": "dddbf112-2377-3a3f-a890-2ebdc2a962d7",
                                        "glosses": [
                                            "A large and heavy car; the term connotes wasteful size."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29685207-8e4b-45f1-b2b8-e08b116ccdd9",
                                                "sense_id": "0840b77c-7001-388a-a203-40525e2536d6",
                                                "text": "Near-synonyms: land yacht, sled"
                                            },
                                            {
                                                "example_id": "f0e34147-912c-4724-8a84-dd370df8299a",
                                                "sense_id": "0840b77c-7001-388a-a203-40525e2536d6",
                                                "text": "He claimed to be broke but he always drove that ridiculous boat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a157935-eda6-30f9-a71b-58d85526716c",
                                        "entry_id": "dddbf112-2377-3a3f-a890-2ebdc2a962d7",
                                        "glosses": [
                                            "One of two possible conformations of cyclohexane rings (the other being chair), shaped roughly like a boat."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a399c003-5c6a-35f9-ae85-ab0b4a5f0489",
                                        "entry_id": "dddbf112-2377-3a3f-a890-2ebdc2a962d7",
                                        "glosses": [
                                            "The refugee boats arriving in Australian waters, and by extension, refugees generally."
                                        ],
                                        "tags": [
                                            "Australian",
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2d24ed41-58e4-3b1a-8611-db4f120b9e25",
                                        "entry_id": "dddbf112-2377-3a3f-a890-2ebdc2a962d7",
                                        "glosses": [
                                            "In Conway’s Game of Life, a particular still life consisting of a dead cell surrounded by five living cells."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4bfddec6-b3e1-4909-aea8-c5417bae4303",
                                                "sense_id": "2d24ed41-58e4-3b1a-8611-db4f120b9e25",
                                                "text": "It creates 4 blocks, a boat, and a glider every 768 generations."
                                            },
                                            {
                                                "example_id": "6309fb88-40c9-46a1-8dda-f33812d1e203",
                                                "sense_id": "2d24ed41-58e4-3b1a-8611-db4f120b9e25",
                                                "text": "The program is represented as a string of boats (1s) and blocks (0s)."
                                            },
                                            {
                                                "example_id": "c4a3e278-e37a-45cb-beee-f4bc9f7aa907",
                                                "sense_id": "2d24ed41-58e4-3b1a-8611-db4f120b9e25",
                                                "text": "For many stable patterns, by the way, there are other input glider lanes where the gliders are caught and turned into boats, which are then cleanly deleted by another glider coming in on the same lane."
                                            }
                                        ]
                                    },
                                    {
