                "translations": [
                    {
                        "translation_id": "b36491ed-582c-4d5a-9fdd-0ea5b4652d0a",
                        "source_entry_id": "c88a4d7d-abee-3ab7-8d52-12b3efc29e48",
                        "source_sense_id": "8f78e3e6-1004-363a-9e6b-e9b3e8fcb94b",
                        "target_lang_word": "Americanness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Americanness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1fafe839-a203-3dc2-aab8-e5b0992af9dc",
                                        "entry_id": "bb5353af-0939-3dec-8731-c4b5ebd4e96d",
                                        "glosses": [
                                            "The quality or characteristic of being American."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9943a220-6fe0-466c-b1ab-0c2bfa07b9ba",
                                                "sense_id": "1fafe839-a203-3dc2-aab8-e5b0992af9dc",
                                                "text": "“There is a political equation of Americanness with speaking English,” said Arias. “People who don’t speak English are just as American as those who do.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d6062828-a75b-4c5b-a252-03f77da94a02",
                        "source_entry_id": "c88a4d7d-abee-3ab7-8d52-12b3efc29e48",
                        "source_sense_id": "8f78e3e6-1004-363a-9e6b-e9b3e8fcb94b",
                        "target_lang_word": "Americaness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Americaness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d9c24f2e-2ba5-3f9d-9456-aa1e80d49c87",
                                        "entry_id": "ad9117c0-ec95-3681-8d81-bc86f758537e",
                                        "glosses": [
                                            "Alternative spelling of Americanness."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9cac1b2b-97a9-415f-9b2f-87f6ed77a204",
                                                "sense_id": "d9c24f2e-2ba5-3f9d-9456-aa1e80d49c87",
                                                "text": "There was support for the United States' involvement in Vietnam, though in Lawrence such support expressed a particular brand of patriotism, an Americaness drawn from the past."
                                            },
                                            {
                                                "example_id": "b6d48336-1c44-447f-8114-26975d3376f0",
                                                "sense_id": "d9c24f2e-2ba5-3f9d-9456-aa1e80d49c87",
                                                "text": "Although cultural pride in baseball seems to stem from its Americaness, cultural pride in football seems linked to the sport's manly qualities […]"
                                            },
                                            {
                                                "example_id": "870c755f-066c-4956-b952-4878a19d6f2b",
                                                "sense_id": "d9c24f2e-2ba5-3f9d-9456-aa1e80d49c87",
                                                "text": "The necessity of race to Americaness continued through the nineteenth and twentieth centuries and remains central to our identity today: […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Americaness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d0b21fc9-b5ae-3807-ae60-993121c80f4c",
                                        "entry_id": "9b0edd2a-cc17-3fa4-bd3a-45bfa6ea6750",
                                        "glosses": [
                                            "A female American."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1dbafaa-d2db-495f-9b64-c5adb51b9101",
                                                "sense_id": "d0b21fc9-b5ae-3807-ae60-993121c80f4c",
                                                "text": "With such expectations, then, every true American and Americaness was expected to be at his or her post, for the solemn occasion."
                                            },
                                            {
                                                "example_id": "39022bf8-1c8e-493f-8b98-1a7ed587e38b",
                                                "sense_id": "d0b21fc9-b5ae-3807-ae60-993121c80f4c",
                                                "text": "There was, at the Leek, in the way of literature, aBradshaw, a work (selling sixty thousand daily, it said) of one of those Americanesses who have struggled in at the gate of the heaven of popularity before it could be shut after Mrs. Beecher Stowe"
                                            },
                                            {
                                                "example_id": "9ae00f35-f2e8-4b5b-887e-a615b308880d",
                                                "sense_id": "d0b21fc9-b5ae-3807-ae60-993121c80f4c",
                                                "text": "This woman is like most Americanesses - she hates walking."
                                            },
                                            {
                                                "example_id": "e1a98c50-37cd-428c-b894-cf7231c09a0f",
                                                "sense_id": "d0b21fc9-b5ae-3807-ae60-993121c80f4c",
                                                "text": "2007 1634: The Baltic War\nBut this office was reputedly run by Americanesses, and the stories about them were enough to make any sane man pause. Incredible women, by all accounts"
                                            },
                                            {
                                                "example_id": "475934e2-2a29-4462-9588-2ae00d89cad9",
                                                "sense_id": "d0b21fc9-b5ae-3807-ae60-993121c80f4c",
                                                "text": "2017 1636: The Ottoman Onslaught\nBetween me and the picture of Denise— mostly the portrait—they'll be thinking 'Americans.' Well, Americanesses."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
