                                "target_senses": [
                                    {
                                        "sense_id": "fe6106b4-c118-3cf8-9e47-ca431825205b",
                                        "entry_id": "e8b57a24-76c8-3bd2-a517-c7519e417577",
                                        "glosses": [
                                            "Figure de rhétorique qui consiste à rapporter le discours d'un autre en style direct."
                                        ],
                                        "tags": [
                                            "rhetoric"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "005b46dc-58d0-4e87-b5ce-b058cd299a41",
                                                "sense_id": "fe6106b4-c118-3cf8-9e47-ca431825205b",
                                                "text": "Le trait d'esprit peut aussi prendre la forme de la mimèse, selon le mot privilégié par Philippe Hamon, reprise du discours de celui dont on entend se moquer sur le mode du pastiche, de la parodie ou de la charge."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "be4d69ba-9ff2-4d56-b857-b54dd68317dd",
                        "source_entry_id": "7047ccd7-e514-3e75-9731-2688b8db8844",
                        "source_sense_description": "the representation of aspects of the real world, especially human actions",
                        "target_lang_word": "mimèsis",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mimèsis",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a9116a68-6499-3473-a35c-22ff07d717d1",
                                        "entry_id": "ad243f41-a2c6-3365-87c9-136016d1abe5",
                                        "glosses": [
                                            "Imitation, représentation."
                                        ],
                                        "tags": [],
                                        "note": "Le mot s’emploie surtout pour désigner l’imitation du réel au moyen de mots dans un texte littéraire. La nature exacte de la mimèsis a souvent été l’objet de controverses. Paul Ricoeur propose de traduire le terme par fiction",
                                        "examples": [
                                            {
                                                "example_id": "c97a82c2-742e-42c5-8db5-45c506a8c162",
                                                "sense_id": "a9116a68-6499-3473-a35c-22ff07d717d1",
                                                "text": "Or ce qui frappe, c'est que lorsque Platon y évoque et y condamne la mimèsis, il ne parle à peu près pas de la tragédie : le discours sur la tragédie et le discours sur la mimèsis sont dissociés."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ec4c929f-730c-4ee9-b700-7bbc12480182",
                        "source_entry_id": "7047ccd7-e514-3e75-9731-2688b8db8844",
                        "source_sense_description": "the representation of aspects of the real world, especially human actions",
                        "target_lang_word": "Mimesis",
