        "ru-extract.jsonl": [
            {
                "entry_id": "89163461-df34-3ae6-b100-a7d664a55577",
                "word": "оптом",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2b677aae-ac61-3469-b93a-c9400e2ead24",
                        "entry_id": "89163461-df34-3ae6-b100-a7d664a55577",
                        "glosses": [
                            "крупной партией, большими количествами"
                        ],
                        "tags": [
                            "о купле-продаже товаров:"
                        ],
                        "examples": [
                            {
                                "example_id": "496ed20f-e07a-4b9f-b21c-8b4e8afc9a63",
                                "sense_id": "2b677aae-ac61-3469-b93a-c9400e2ead24",
                                "text": "Продажа оптом и в розницу."
                            },
                            {
                                "example_id": "74cf31e2-91a9-4572-96f4-38c45d5e2ce4",
                                "sense_id": "2b677aae-ac61-3469-b93a-c9400e2ead24",
                                "text": "Как же насчёт штанов, многоуважаемый служитель культа? Берёте? Есть ещё от жилетки рукава, круг от бублика и от мёртвого осла уши. Оптом всю партию — дешевле будет."
                            },
                            {
                                "example_id": "eafd4e30-8f01-44f5-af65-54b04de290e1",
                                "sense_id": "2b677aae-ac61-3469-b93a-c9400e2ead24",
                                "text": "Оптом, как говорится: полтора рубля за килограмм."
                            }
                        ]
                    },
                    {
                        "sense_id": "a201aa3f-2aa7-3ceb-ac65-9c4fd44fd988",
                        "entry_id": "89163461-df34-3ae6-b100-a7d664a55577",
                        "glosses": [
                            "перен., разг. всё целиком, всё сразу, гуртом"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "450025b0-b13e-4597-8c2f-b6be094d9cd5",
                                "sense_id": "a201aa3f-2aa7-3ceb-ac65-9c4fd44fd988",
                                "text": "Взять оптом публику — она свой вес имеет. // Сей вес перетянуть один глупец затеет; // Но раздроби её, вся важность пропадёт. // Кто ж эта публика? Вы, я, он, сей и тот."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d5e05c24-a033-431f-add1-93636be58608",
                        "source_entry_id": "89163461-df34-3ae6-b100-a7d664a55577",
