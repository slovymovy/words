                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dachshund",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "57dcf017-5cbc-3307-876f-ae0b27706cb0",
                                        "entry_id": "eb45c431-1470-30af-8206-5e0ffcb9b13a",
                                        "glosses": [
                                            "A certain breed of dog having short legs and a long trunk, including standard-sized, miniature (smooth-haired, long-haired, and short-haired) varieties."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "375a61f2-6c1d-46d3-908a-5697e9bb9f4f",
                                                "sense_id": "57dcf017-5cbc-3307-876f-ae0b27706cb0",
                                                "text": "Say what you will of dachshunds, their peculiar shape makes them the easiest breed of dog to trip over in existence."
                                            },
                                            {
                                                "example_id": "1456edb8-df9a-45db-9c9f-db2d53af2cc0",
                                                "sense_id": "57dcf017-5cbc-3307-876f-ae0b27706cb0",
                                                "text": "We had decided to take a small dog for the children and we chose a tan, short-haired, six-week-old male dachshund. We named him Fritz."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
