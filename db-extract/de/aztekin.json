                "senses": [
                    {
                        "sense_id": "f9c43d6f-7628-33e4-88ac-0e5778dc58a0",
                        "entry_id": "f86b5208-ee5d-3ea2-a05a-3a37d1addfad",
                        "glosses": [
                            "Angehörige einer mesoamerikanische Kultur in Zentralmexiko"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0fbcf7b4-a433-4726-b65e-fa5012cb0041",
                                "sense_id": "f9c43d6f-7628-33e4-88ac-0e5778dc58a0",
                                "text": "„Die Köpfe der Schlangen, den die Aztekin als Rock trug, begannen sich aufzurichten und geben einen freizügigen Blick auf ihren Unterleib frei.“"
                            },
                            {
                                "example_id": "e239682e-da13-43fa-833b-6a7e8d0a3422",
                                "sense_id": "f9c43d6f-7628-33e4-88ac-0e5778dc58a0",
                                "text": "„Es kann nach allem nicht bezweifelt werden, daß die Aztekinnen ebensoviel Wert auf ihre äußere Erscheinung legten, als die Frauen anderer Kulturnationen.“"
                            },
                            {
                                "example_id": "8988bb49-cb33-4e1d-9dff-51b877fede53",
                                "sense_id": "f9c43d6f-7628-33e4-88ac-0e5778dc58a0",
                                "text": "„Selbst in den Beziehungen der Azteken zu den schönen Aztekinnen tritt jenes Doppelwesen von Härte und Zartheit in ihrer Gemüthsart hervor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
