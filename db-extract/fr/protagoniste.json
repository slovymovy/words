        "fr-extract.jsonl": [
            {
                "entry_id": "70299856-d267-352f-a627-c8aa4a569a37",
                "word": "protagoniste",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c4da9372-05b0-43f7-9bb3-ad2e5ed79696",
                        "entry_id": "70299856-d267-352f-a627-c8aa4a569a37",
                        "tags": [
                            "plural"
                        ],
                        "form": "protagonistes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c46434d4-0d82-3cc0-8cdf-0869650a7ef7",
                        "entry_id": "70299856-d267-352f-a627-c8aa4a569a37",
                        "glosses": [
                            "Premier acteur qui engage le dialogue avec le chœur, dans le théâtre grec antique."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "5af84e3c-7269-49bd-b468-60555080586f",
                                "sense_id": "c46434d4-0d82-3cc0-8cdf-0869650a7ef7",
                                "text": "Le protagoniste joue le premier rôle ainsi que les seconds rôles."
                            }
                        ]
                    },
                    {
                        "sense_id": "3ed36892-601f-30f5-936d-d3ad2f9fa72f",
                        "entry_id": "70299856-d267-352f-a627-c8aa4a569a37",
                        "glosses": [
                            "Personnage principal d’une intrigue, d’une histoire, personnage important d’une pièce de théâtre, d’un film, d’un roman."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "debe2f37-dcd8-4297-87e0-ac83941acaaf",
                                "sense_id": "3ed36892-601f-30f5-936d-d3ad2f9fa72f",
                                "text": "Les premières scènes du roman nous montrent une protagoniste qui se perçoit visiblement par le regard extérieur."
                            }
                        ]
                    },
                    {
                        "sense_id": "a23310a2-75b2-3f07-a654-ce2518c2a47f",
                        "entry_id": "70299856-d267-352f-a627-c8aa4a569a37",
                        "glosses": [
                            "Personnage-clé dans une affaire."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "908bc381-afe9-471b-9cc3-92c5d8a2dbf7",
                                "sense_id": "a23310a2-75b2-3f07-a654-ce2518c2a47f",
                                "text": "Toutes les formes de l’antisémitisme, y compris antisémitisme racial, devaient trouver en France, un protagoniste puissant dans la personne d’Édouard Drumont."
                            },
                            {
                                "example_id": "28ac2806-a054-4c5e-8d2d-8899b15d1d23",
                                "sense_id": "a23310a2-75b2-3f07-a654-ce2518c2a47f",
                                "text": "Sur le Yémen maintenant, le département d’État s’est prononcé sur l’un des deux grands protagonistes de cette guerre meurtrière qui massacre des civils depuis plus de cinq ans."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a0b2078d-9ca8-4de3-9aa6-aebd21ede9d0",
                        "source_entry_id": "70299856-d267-352f-a627-c8aa4a569a37",
                        "target_lang_word": "Protagonist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Protagonist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b260f3ae-883c-321c-81d8-9856df5bf49b",
                                        "entry_id": "17d495a9-b9bb-3860-a5f8-20e257fbd3b4",
                                        "glosses": [
                                            "Hauptdarsteller (vor Deuter- und Triagonist)"
                                        ],
                                        "tags": [
                                            "in der griechischen Tragödie und in der Literatur"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50428628-3e41-45b0-add6-1e88fead406c",
                                                "sense_id": "b260f3ae-883c-321c-81d8-9856df5bf49b",
                                                "text": "Die griechische Tragödie entstand, als zum Chor erst der Protagonist, dann auch noch der Antagonist hinzutrat."
                                            },
                                            {
                                                "example_id": "141de277-72af-4479-908a-c38920c8ab36",
                                                "sense_id": "b260f3ae-883c-321c-81d8-9856df5bf49b",
                                                "text": "„In Murnaus 1927 gedrehtem Film Sunrise küssen sich die zwei Protagonisten auf der Straße und verursachen ein gewaltiges Verkehrschaos.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "05814ad1-5f13-36e3-9c9b-76feda0c01c7",
                                        "entry_id": "17d495a9-b9bb-3860-a5f8-20e257fbd3b4",
                                        "glosses": [
                                            "im heutigen Sinne: Vorkämpfer (für eine Idee, eine Bewegung) oder Hauptperson"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f00b187d-0cbc-4ec8-acc5-10ccb3c8a744",
                                                "sense_id": "05814ad1-5f13-36e3-9c9b-76feda0c01c7",
                                                "text": "Einige der Protagonisten von Attac stammen aus der Redaktion von ‚Le Monde diplomatique‘."
                                            },
                                            {
                                                "example_id": "8438700d-0bb3-40f5-b110-c8e44dfdb418",
                                                "sense_id": "05814ad1-5f13-36e3-9c9b-76feda0c01c7",
                                                "text": "„Doch der wahre Protagonist des Romans ist Hrdlak, der bettelarme Tagelöhner mit dem Klumpfuß.“"
                                            },
                                            {
                                                "example_id": "888892a0-13c8-4f10-a864-0fb8dd0da31e",
                                                "sense_id": "05814ad1-5f13-36e3-9c9b-76feda0c01c7",
                                                "text": "„Als Reporter lernt man von seinen Protagonisten immer etwas.“"
                                            },
                                            {
                                                "example_id": "825c670c-efba-4237-ab72-e9c20b934c22",
                                                "sense_id": "05814ad1-5f13-36e3-9c9b-76feda0c01c7",
                                                "text": "Schatzkanzler Hammond gilt in der Regierung als wichtigster Protagonist für einen weichen Brexit."
                                            },
                                            {
                                                "example_id": "fa9e2033-5020-4a5d-8c88-72a523854854",
                                                "sense_id": "05814ad1-5f13-36e3-9c9b-76feda0c01c7",
                                                "text": "„Sehr viel mehr wusste Murakami aber offensichtlich leider auch nicht vom Land, sonst hätte er seinen Protagonisten nicht ausgerechnet in eine Pizzeria geschickt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "cd5a88e9-8129-3146-962f-da01f3d1eb2a",
                                        "entry_id": "17d495a9-b9bb-3860-a5f8-20e257fbd3b4",
                                        "glosses": [
                                            "Hauptperson (der hauptsächlich Handelnde) des psychodramatischen Spiels"
                                        ],
                                        "tags": [
                                            "im Psychodrama nach Jakob Levy Moreno"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c9db006-5850-4617-8337-1685ba0cb0a7",
                                                "sense_id": "cd5a88e9-8129-3146-962f-da01f3d1eb2a",
                                                "text": "Der Protagonist im Psychodrama spielt Szenen des realen Lebens nach, aber er stellt auch Träume dar."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
