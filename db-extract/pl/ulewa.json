                "senses": [
                    {
                        "sense_id": "f7ae49b6-be38-3f08-854c-38bbcb88c6b5",
                        "entry_id": "c5fcc81d-6c61-3dff-9609-d1a865907f0c",
                        "glosses": [
                            "deszcz dający w stosunkowo krótkim czasie duże ilości wody"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16b73021-44c4-4373-a2c5-1a7567f9fbf3",
                                "sense_id": "f7ae49b6-be38-3f08-854c-38bbcb88c6b5",
                                "text": "Gdy wspięliśmy się na sam szczyt, dopadła nas ulewa."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "1bfa0dd0-61cb-38d8-add4-78acf5a1ae7d",
                        "entry_id": "c5fcc81d-6c61-3dff-9609-d1a865907f0c",
                        "glosses": [
                            "mnóstwo czegoś"
                        ],
                        "tags": [
                            "literary",
                            "metaphoric"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9aea4a38-3870-459a-a2d3-a3ff2573906f",
                        "source_entry_id": "c5fcc81d-6c61-3dff-9609-d1a865907f0c",
                        "source_sense_id": "f7ae49b6-be38-3f08-854c-38bbcb88c6b5",
                        "target_lang_word": "downpour",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "downpour",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7d5db4be-7990-378a-89ae-ea1b83d53826",
                                        "entry_id": "ec5200c8-e9cd-3c86-8ec8-954e09d92f0c",
                                        "glosses": [
                                            "A heavy rain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75af58f8-8d09-405d-9e47-bf50b5a7e750",
                                                "sense_id": "7d5db4be-7990-378a-89ae-ea1b83d53826",
                                                "text": "They got caught in a downpour without an umbrella and came back soaked."
                                            },
                                            {
                                                "example_id": "d5815f23-7541-4881-8c00-2cb063b41a22",
                                                "sense_id": "7d5db4be-7990-378a-89ae-ea1b83d53826",
                                                "text": "I left Inverness on a Saturday afternoon in July in a steady downpour of rain."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "downpour",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3dc469b6-5cb4-33f0-8b0f-ea4246a5f0aa",
                                        "entry_id": "1202e03f-54e7-3654-97a3-65b309fc9e33",
                                        "glosses": [
                                            "To pour down; rain heavily."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed8f2804-c6ae-4f28-9011-a09c406d91af",
                                                "sense_id": "3dc469b6-5cb4-33f0-8b0f-ea4246a5f0aa",
                                                "text": "It started to downpour, so Billy and I made our way back to our house, with Scotty following—or so I thought."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "709b2ab5-a3bf-4c24-ac9a-8ec807297c35",
                        "source_entry_id": "c5fcc81d-6c61-3dff-9609-d1a865907f0c",
                        "source_sense_id": "f7ae49b6-be38-3f08-854c-38bbcb88c6b5",
                        "target_lang_word": "averse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "averse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ef840830-d071-3615-8dde-44797f1f5fbe",
                                        "entry_id": "7e1ba687-dc40-3b37-b164-97fb2c41866c",
                                        "glosses": [
                                            "Pluie soudaine, abondante et généralement brève."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4efa2031-56b5-480d-82d8-ba69a5f88e3a",
                                                "sense_id": "ef840830-d071-3615-8dde-44797f1f5fbe",
                                                "text": "Le vent du sud-ouest, frappant en plein sur ma porte, en avait si bien relâché les jointures, qu’à la moindre averse j’étais inondé."
                                            },
                                            {
                                                "example_id": "11169490-5844-49e2-9b4e-94b6dd524321",
                                                "sense_id": "ef840830-d071-3615-8dde-44797f1f5fbe",
                                                "text": "Souvent on voit la partie inférieure du nuage s’effranger en averses pour inonder de pluie les pentes basses, tandis que plus haut les vapeurs plus froides se déchargent de flocons de neige."
                                            },
                                            {
                                                "example_id": "1dc85a51-8715-414d-8a67-1ed9673958e4",
                                                "sense_id": "ef840830-d071-3615-8dde-44797f1f5fbe",
                                                "text": "Bien que, par intervalles, de brèves et pâles soleillées courussent sur les chemins défoncés, sur les prairies semées de flaques miroitantes, on pressentait que l’accalmie serait de peu de durée, et que l’averse recommencerait avant la fin du jour."
                                            },
                                            {
                                                "example_id": "c7518bd7-4205-48ce-ab51-2f2192e55acf",
                                                "sense_id": "ef840830-d071-3615-8dde-44797f1f5fbe",
                                                "text": "A peine nos tentes sont-elles dressées, qu’une averse diluvienne s’abat sur le camp."
                                            },
                                            {
                                                "example_id": "d8b8cf5d-e0ea-4745-9e5b-6b10b2c58e43",
                                                "sense_id": "ef840830-d071-3615-8dde-44797f1f5fbe",
                                                "text": "Il pleuvait. Par instants, on entendait l’averse s’écraser contre la verrière du haut."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b494f666-566d-458d-8468-e30baf9d368c",
                        "source_entry_id": "c5fcc81d-6c61-3dff-9609-d1a865907f0c",
                        "source_sense_id": "f7ae49b6-be38-3f08-854c-38bbcb88c6b5",
                        "target_lang_word": "ondée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ondée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "90776e4f-e11b-3dd9-8698-8b1f978c8aa8",
                                        "entry_id": "30b9bd72-5af2-3b56-9e3b-0420cb84a8f0",
                                        "glosses": [
                                            "Pluie qui vient tout à coup et qui ne dure pas longtemps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a6c70d6-5577-462a-92cd-e289b1e746f2",
                                                "sense_id": "90776e4f-e11b-3dd9-8698-8b1f978c8aa8",
                                                "text": "Pendant de longues heures nous marchons en silence, ne regardant ni à droite ni à gauche, la tête baissée sous nos capuchons pour nous garantir de l’ondée cinglante."
                                            },
                                            {
                                                "example_id": "6b94fc84-f5be-4dab-b244-932b96b24239",
                                                "sense_id": "90776e4f-e11b-3dd9-8698-8b1f978c8aa8",
                                                "text": "Vers midi et demi, nous tirons le déjeuner des sacs, au café de la Bagnolle. La fin du séjour est marquée par une violente ondée qui vide les terrasses !"
                                            },
                                            {
                                                "example_id": "a3c68660-8b07-4c42-8e2e-74361700956a",
                                                "sense_id": "90776e4f-e11b-3dd9-8698-8b1f978c8aa8",
                                                "text": "Le ciel aujourd’hui avait fait son devoir : lorsque monsieur de Chateaudun parut, l’ondée cludienne avait sensiblement modifié la forme de son chapeau, la teinte de son veston, le pli de son pantalon."
                                            },
                                            {
                                                "example_id": "ad0b8898-af0b-4c71-80d7-5944d0e0e4cf",
                                                "sense_id": "90776e4f-e11b-3dd9-8698-8b1f978c8aa8",
                                                "text": "Quand il fait sec, Diphylleia grayi, qui pousse sur les flancs de montagnes des régions les plus froides du Japon, arbore des pétales blancs tout ce qu’il y a de plus commun. Mais qu’une ondée l’arrose et ces derniers deviennent alors totalement transparents."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ondée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "420fad60-9097-32ec-90b2-48bfccd52d96",
                                        "entry_id": "272b6b91-e89a-3de4-9606-3c4678ccc3fd",
                                        "glosses": [
                                            "Féminin singulier de ondé."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4687c1d6-34cd-40b4-8586-23df6e0760e4",
                                                "sense_id": "420fad60-9097-32ec-90b2-48bfccd52d96",
                                                "text": "Sur la rue, la maison présentait cette façade de moellons ravalée en plâtre, ondée par le temps et rayée par le crochet du maçon de manière à figurer des pierres de taille."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
