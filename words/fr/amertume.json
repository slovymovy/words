                    ],
                    "synonyms": [
                        "acrimonie",
                        "causticité",
                        "aigreur"
                    ],
                    "antonyms": [
                        "bienveillance",
                        "douceur"
                    ],
                    "common_phrases": [
                        "amertume des propos",
                        "amertume d'une critique"
                    ]
                }
            ]
        }
