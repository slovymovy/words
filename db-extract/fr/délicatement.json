        "fr-extract.jsonl": [
            {
                "entry_id": "d577b131-2121-3f70-83cb-4e63dd7f9b5f",
                "word": "délicatement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d95c4c57-cdde-3218-918f-414693c2a892",
                        "entry_id": "d577b131-2121-3f70-83cb-4e63dd7f9b5f",
                        "glosses": [
                            "Mollement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "249b2bbc-82e7-44d4-a149-74e88b6432b5",
                                "sense_id": "d95c4c57-cdde-3218-918f-414693c2a892",
                                "text": "Je suis moi-même une femme délicatement élevée, faible, craintive et épouvantée de la douleur ; …."
                            }
                        ]
                    },
                    {
                        "sense_id": "c75ce464-683b-3f37-a3d0-5f9650f3fec6",
                        "entry_id": "d577b131-2121-3f70-83cb-4e63dd7f9b5f",
                        "glosses": [
                            "D’une manière douce, légère."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f52e822-2a7f-4ab8-833c-f1f1301c9c2a",
                                "sense_id": "c75ce464-683b-3f37-a3d0-5f9650f3fec6",
                                "text": "Ajoutez le furikake (ou le gomashio) et mélangez délicatement afin de ne pas écraser les grains de riz."
                            }
                        ]
                    },
                    {
                        "sense_id": "7c117153-5491-322b-807c-d3b550c9aef8",
                        "entry_id": "d577b131-2121-3f70-83cb-4e63dd7f9b5f",
                        "glosses": [
                            "Avec délicatesse, d’une façon élégante et fine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e8e35f1-3542-48e5-b5f9-e0646bee6e0e",
                                "sense_id": "7c117153-5491-322b-807c-d3b550c9aef8",
                                "text": "Il y a deux choses qui font la bonté de son roman [d'Honoré d’Urfé], la disposition qui est régulière, et les passions tendres et amoureuses qu’il avait ressenties lui-même, qui sont touchées très délicatement. — (Segrais, Mémoires, t. II, p. 22.)"
                            },
                            {
                                "example_id": "644252aa-6f54-48f3-ac6a-15f3378255fe",
                                "sense_id": "7c117153-5491-322b-807c-d3b550c9aef8",
                                "text": "Il faut exprimer le vrai pour écrire naturellement, fortement, délicatement. — (Jean de la Bruyère, I.)"
                            },
                            {
                                "example_id": "32c2f03e-5abd-45e6-9583-b81c88747240",
                                "sense_id": "7c117153-5491-322b-807c-d3b550c9aef8",
                                "text": "Je touche délicatement à des matières délicates. — (Jean le Rond D’Alembert, Lett. à Volt. 3 mars 1766.)"
                            }
                        ]
                    },
                    {
                        "sense_id": "deded8cc-a058-3326-8178-5ce08d769c77",
                        "entry_id": "d577b131-2121-3f70-83cb-4e63dd7f9b5f",
                        "glosses": [
                            "D’une façon délicate, agréable au goût."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e12eb94-1480-4b69-ab46-5907bfa20b12",
                                "sense_id": "deded8cc-a058-3326-8178-5ce08d769c77",
                                "text": "On y mangeait délicatement. — (Antoine Hamilton, Gramm. 6.)"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3d4cce5e-82c9-4a7d-8f4d-4db0b8a23173",
                        "source_entry_id": "d577b131-2121-3f70-83cb-4e63dd7f9b5f",
                        "target_lang_word": "delicately",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "delicately",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ac87d927-4164-309e-bd2b-6fce5bcaf543",
                                        "entry_id": "106d1fb8-2a62-3e78-8aad-0af6760d5e5c",
                                        "glosses": [
                                            "In a delicate manner; exquisitely."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2090e00-eb7a-41ea-9cee-f1b2ab260d96",
                                                "sense_id": "ac87d927-4164-309e-bd2b-6fce5bcaf543",
                                                "text": "The gingerbread was delicately, if imprecisely, captured by the brushstrokes."
                                            },
                                            {
                                                "example_id": "4009453a-8c41-43ac-9618-0719b8652806",
                                                "sense_id": "ac87d927-4164-309e-bd2b-6fce5bcaf543",
                                                "text": "The intergrown foliage atop a xylosma hedge appears to be delicately balanced on long wooden fingers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e231c8c3-1784-33c7-97b7-c02eb466ded5",
                                        "entry_id": "106d1fb8-2a62-3e78-8aad-0af6760d5e5c",
                                        "glosses": [
                                            "Tactfully."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34008190-de39-43ab-9626-e1607119cc84",
                                                "sense_id": "e231c8c3-1784-33c7-97b7-c02eb466ded5",
                                                "text": "He approached the main subject delicately."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "af72006f-e0aa-444e-b34a-df218114d60f",
                        "source_entry_id": "d577b131-2121-3f70-83cb-4e63dd7f9b5f",
                        "target_lang_word": "finely",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "finely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c74e4153-2616-3fc4-a3ec-0260ce112ad0",
                                        "entry_id": "eb067659-218c-3529-893b-a66bb54f99fb",
                                        "glosses": [
                                            "So as to produce a fine texture; into small, thin, or delicate pieces."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "221f4365-190f-4063-a243-63ad6fa67619",
                                                "sense_id": "c74e4153-2616-3fc4-a3ec-0260ce112ad0",
                                                "text": "Fledglings can only be fed finely chopped meat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e00e7a87-7a75-3dab-aff6-1e39bc818cc9",
                                        "entry_id": "eb067659-218c-3529-893b-a66bb54f99fb",
                                        "glosses": [
                                            "In a fine, handsome or attractive way; very well."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7072d13a-4e5b-4170-a92e-862be776818c",
                                                "sense_id": "e00e7a87-7a75-3dab-aff6-1e39bc818cc9",
                                                "text": "This girl could not be above eighteen: her face regular and sweet-featur'd, her shape exquisite; nor could I help envying her two ripe enchanting breasts, finely plump'd out in flesh",
                                                "translation": "Fanny Hill",
                                                "english": "Fanny Hill"
                                            },
                                            {
                                                "example_id": "13e7ccf4-cc60-4598-856c-e2fb22b24fa7",
                                                "sense_id": "e00e7a87-7a75-3dab-aff6-1e39bc818cc9",
                                                "text": "Looking back, Yewdale Crag stands finely over the waterhead; Brantwood is opposite."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
