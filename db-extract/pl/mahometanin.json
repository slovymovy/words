                        "source_entry_id": "538a8d5e-01df-309e-8a14-9855395262af",
                        "source_sense_id": "6255b3c8-c81f-3d4c-8b03-99c24c0e86aa",
                        "target_lang_word": "Mohammedaner",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mohammedaner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d926a9a3-3b0e-3c80-8421-598653e28d64",
                                        "entry_id": "a538d6c2-c6a4-3eb4-bc40-9559bb0b3188",
                                        "glosses": [
                                            "Anhänger des Islam"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4e566f6-24f8-4072-8a9d-e1d49118578b",
                                                "sense_id": "d926a9a3-3b0e-3c80-8421-598653e28d64",
                                                "text": "„Die Mohammedaner haben keine Schöpfungslehre, dagegen kennen sie gute und böse Geister[.]“"
                                            },
                                            {
                                                "example_id": "4274f669-490e-4b99-a65e-e06931ed87e2",
                                                "sense_id": "d926a9a3-3b0e-3c80-8421-598653e28d64",
                                                "text": "„Nach Beendigung der Begrüßungserfordernisse bat sie auch die Frau des Mohammedaners Han zur Teilnahme an der Gesellschaft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d2b6e8f8-62f7-4ea1-b6b8-415d8391bf1e",
                        "source_entry_id": "538a8d5e-01df-309e-8a14-9855395262af",
                        "source_sense_id": "6255b3c8-c81f-3d4c-8b03-99c24c0e86aa",
                        "target_lang_word": "магометанин",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "магометанин",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "3dc8c9af-9a04-31b1-9001-67b1ae4f6e5b",
                                        "entry_id": "f71677dc-8da9-3877-ba3b-2e11e0016c05",
                                        "glosses": [
                                            "то же, что мусульманин"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cda274db-554d-40ce-b6db-1d70b2b770ba",
                                                "sense_id": "3dc8c9af-9a04-31b1-9001-67b1ae4f6e5b",
                                                "text": "Вина как верующий магометанин он не пил, и каждый раз передавал свой кубок кому-либо из почётнейших гостей."
                                            },
                                            {
                                                "example_id": "229c0c80-19fc-4100-8c0c-c3b8dad36e18",
                                                "sense_id": "3dc8c9af-9a04-31b1-9001-67b1ae4f6e5b",
                                                "text": "Он подчеркнул, что для магометан всякая гробница священна, но гробница воина, сражавшегося за своё отечество, особо священна, какой бы веры ни был этот воин."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
