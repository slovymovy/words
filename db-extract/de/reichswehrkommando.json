                "senses": [
                    {
                        "sense_id": "3aad93ad-9050-3e3a-8ee3-27bc69e2d099",
                        "entry_id": "a412f8b4-08f7-31b7-9f1c-e51eac812305",
                        "glosses": [
                            "Leitung der Streitkräfte; (auch regionale) Behörde mit Verfügungsgewalt über Soldaten/Truppen/Material; Einheit (Kommando) der Reichswehr"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "afa53e18-7e6e-4fbd-9f3c-ad141bea708f",
                                "sense_id": "3aad93ad-9050-3e3a-8ee3-27bc69e2d099",
                                "text": "„Nach dem Krieg diente er dem Münchner Reichswehrkommando wegen seiner rednerischen Begabung zunächst als Schulungsredner.“"
                            },
                            {
                                "example_id": "76b3a169-4a7b-4d28-9bae-727dad9114d1",
                                "sense_id": "3aad93ad-9050-3e3a-8ee3-27bc69e2d099",
                                "text": "„Die bayerische Führung und das bayerische Reichswehrkommando hatten sich wider Erwarten seinem Ansinnen verweigert.“"
                            },
                            {
                                "example_id": "1c3e5268-512a-4d77-b1da-6a53c5d71f77",
                                "sense_id": "3aad93ad-9050-3e3a-8ee3-27bc69e2d099",
                                "text": "„Unter dem Kapitel \"Der Aufruf zum Generalstreik bleibt aus\" schildern Sie die Verhaftung von Grzesinski, Weiß und Heimannsberg durch ein Reichswehrkommando.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
