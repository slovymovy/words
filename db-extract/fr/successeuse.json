                    },
                    {
                        "form_id": "52fbcea3-548a-4dea-bed9-d7bf6f438041",
                        "entry_id": "4e46aa40-fcf4-32be-8ee9-7ba023735c13",
                        "tags": [
                            "masculine"
                        ],
                        "form": "successeur"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f2d7ecb4-c27a-3c3e-8e16-a97f73bd583b",
                        "entry_id": "4e46aa40-fcf4-32be-8ee9-7ba023735c13",
                        "glosses": [
                            "Celle qui succède à quelqu’un ou quelqu’une dans une fonction, un titre, un rôle ou une institution."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25ce3ac5-8725-40fd-a611-3f3b959db09f",
                                "sense_id": "f2d7ecb4-c27a-3c3e-8e16-a97f73bd583b",
                                "text": "« Ce rôle revient plutôt au député. Il faudra voir ça avec votre successeur… ou votre successeuse », rétorque alors Claude Lillemann, qui en profite pour évoquer Marie Richard, candidate PS sur la 5ᵉ circonscription."
                            },
                            {
                                "example_id": "ec4438aa-81d4-4968-945f-ba6b2d4ae0e3",
                                "sense_id": "f2d7ecb4-c27a-3c3e-8e16-a97f73bd583b",
                                "text": "C’est pourquoi Ségolène Royal prit soin de dire qu’elle espérait être la « digne successeuse » de Maxime Bono à l’Assemblée nationale, même si certains estiment qu’il ne peut y avoir de féminin à successeur puisque ce n’est pas un titre et que d’autres pensent qu’il s’agirait plutôt de successeure. Vaste débat."
                            },
                            {
                                "example_id": "d5d7a6ba-78c4-445c-b92b-c180681ace48",
                                "sense_id": "f2d7ecb4-c27a-3c3e-8e16-a97f73bd583b",
                                "text": "Elle a trouvé en Alina Starkov une successeuse à sa mesure, qu’on espère suivre longtemps."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f193bfb1-96c8-4ac5-82ff-c659de5a4c6f",
                        "source_entry_id": "4e46aa40-fcf4-32be-8ee9-7ba023735c13",
                        "source_sense_id": "f2d7ecb4-c27a-3c3e-8e16-a97f73bd583b",
                        "target_lang_word": "Nachfolgerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nachfolgerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7f927dfb-b46c-3320-a481-26e870ff0aba",
                                        "entry_id": "beb12cf2-91bd-3410-9a47-a4d7c2268a6a",
                                        "glosses": [
                                            "weibliche Person, welche künftig die Position einer bestimmten Person einnimmt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b18d0089-6bed-4029-8480-c9d06a19132c",
                                                "sense_id": "7f927dfb-b46c-3320-a481-26e870ff0aba",
                                                "text": "Er begrüßte seine Nachfolgerin mit herzlichen Worten."
                                            },
                                            {
                                                "example_id": "75522915-99dd-40ce-b884-406193641f35",
                                                "sense_id": "7f927dfb-b46c-3320-a481-26e870ff0aba",
                                                "text": "Die Suche nach einer Nachfolgerin gestaltete sich schwieriger als gedacht."
                                            },
                                            {
                                                "example_id": "0bea1bd2-cb42-4d6e-9b52-e2f04542c9bd",
                                                "sense_id": "7f927dfb-b46c-3320-a481-26e870ff0aba",
                                                "text": "„Erst Verteidigungsministerin, demnächst wahrscheinlich Kommissionspräsidentin der EU: Ursula von der Leyen soll Nachfolgerin von Jean-Claude Juncker werden.“"
                                            },
                                            {
                                                "example_id": "4508f86e-ae56-4bb1-ba04-28bf497895ec",
                                                "sense_id": "7f927dfb-b46c-3320-a481-26e870ff0aba",
                                                "text": "„Der Nachfolger Heinrichs VIII., König Eduard VI., ist gestorben, Heinrichs Testament verfügt, auf Eduard solle im Todesfalle Maria, die Katholische, folgen, aber Eduard, so sagt man, habe auf dem Totenbett seine Schwester Johanna zur Nachfolgerin bestimmt.“"
                                            },
                                            {
                                                "example_id": "7b2e09d9-4073-4e01-8213-698d0813129a",
                                                "sense_id": "7f927dfb-b46c-3320-a481-26e870ff0aba",
                                                "text": "„Auch die Beziehung zu ihrer Nachfolgerin Lisa Matthias ist zerbrochen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6ee85509-00b3-415c-8d49-f03833b7225c",
                        "source_entry_id": "4e46aa40-fcf4-32be-8ee9-7ba023735c13",
