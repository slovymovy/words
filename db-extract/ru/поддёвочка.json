                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45a7e2a0-1d18-4865-bd5e-77c6da657344",
                                "sense_id": "dd6249e2-3765-3563-b500-78e0f4709b25",
                                "text": "Макарка нехотя расстегнул крючки у своей поддёвочки и стал её скидавать."
                            },
                            {
                                "example_id": "8da1ac06-3794-4221-92bf-eccebc42dc67",
                                "sense_id": "dd6249e2-3765-3563-b500-78e0f4709b25",
                                "text": "Поддёвочку его взял, пинжачок тоже, оставил в одних подштанниках, ― почесть в чём мать родила…"
                            }
                        ]
                    }
