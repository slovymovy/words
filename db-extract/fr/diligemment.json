                                                "example_id": "afe87aaa-68ef-4cb4-a018-e39c14648a92",
                                                "sense_id": "dabe3ede-3bfa-39fa-a29f-7dea9d6d29ef",
                                                "text": "Karstadt brauche motivierte und engagierte Mitarbeiter, auch für die nötige fachliche Beratung."
                                            }
