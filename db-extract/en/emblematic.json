    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "46d21b63-4036-36e8-bc7b-9b02f9bcb661",
                "word": "emblematic",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "8227f6f5-e0f4-491b-8668-5e71b3a3f88a",
                        "entry_id": "46d21b63-4036-36e8-bc7b-9b02f9bcb661",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more emblematic"
                    },
                    {
                        "form_id": "2c386f58-32a4-4d6b-8d68-5d87192bc1bd",
                        "entry_id": "46d21b63-4036-36e8-bc7b-9b02f9bcb661",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most emblematic"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fc03593f-9181-3bdc-9c65-83962d603c34",
                        "entry_id": "46d21b63-4036-36e8-bc7b-9b02f9bcb661",
                        "glosses": [
                            "Serving as, or relating to a symbol, emblem or illustration of a type."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cdbb5d52-534a-4b8b-8a29-2b6a605f972d",
                                "sense_id": "fc03593f-9181-3bdc-9c65-83962d603c34",
                                "text": "All was dreary—all was emblematic of that change and barrenness which passes away from nature, but never from the heart;..."
                            }
                        ]
                    },
                    {
                        "sense_id": "6df1cbb3-a260-3841-8f0c-0ffaa7938ba6",
                        "entry_id": "46d21b63-4036-36e8-bc7b-9b02f9bcb661",
                        "glosses": [
                            "Very typical."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "ff2ff1ed-c54b-4027-bde6-1a35b4c259b1",
                                "sense_id": "6df1cbb3-a260-3841-8f0c-0ffaa7938ba6",
                                "text": "The result of yesterday’s meaningful vote in the House of Commons, much like the first in January, was emblematic of a very striking Brexit reality: that the principle barrier to leaving the EU comes from the very people most desperate to see it happen."
                            },
                            {
                                "example_id": "d47e455b-1c54-40c4-940f-0aa388039c0f",
                                "sense_id": "6df1cbb3-a260-3841-8f0c-0ffaa7938ba6",
                                "text": "With Le Sommer withdrawn, France – now with five in midfield – seemed content to hold on for a deceptively narrow win. Such containment tactics can prove high risk but the only threat England could muster was a shot from Aluko which flew high and wide. It seemed entirely emblematic of their afternoon."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b94aced4-cae8-4249-975e-2ca73ef4d62b",
                        "source_entry_id": "46d21b63-4036-36e8-bc7b-9b02f9bcb661",
                        "source_sense_description": "serving as a symbol",
                        "target_lang_word": "emblématique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "emblématique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3d5ab7d8-ccda-3d23-82d3-f2a182f7dca3",
                                        "entry_id": "a8026dbe-44f4-3fed-a00a-16cc838472d6",
                                        "glosses": [
                                            "Qui contient un emblème ou qui s’y rapporte."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7b9d7643-4aff-3e4a-95fa-bcebb112afee",
                                        "entry_id": "a8026dbe-44f4-3fed-a00a-16cc838472d6",
                                        "glosses": [
                                            "Très typique, pouvant constituer un symbole de son genre."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7be991d-b9ea-403a-9ff0-d207914127b8",
                                                "sense_id": "7b9d7643-4aff-3e4a-95fa-bcebb112afee",
                                                "text": "Jadis emblématique, le petit livre rouge des pensées de Mao est aujourd'hui vendu comme souvenir aux touristes étrangers qui visitent Pékin."
                                            },
                                            {
                                                "example_id": "7e8db5cc-2cd8-4966-910c-5f85382c3718",
                                                "sense_id": "7b9d7643-4aff-3e4a-95fa-bcebb112afee",
                                                "text": "André Breton est la figure emblématique du surréalisme."
                                            },
                                            {
                                                "example_id": "d31d75ec-b5ad-4c10-8949-5137cac6cafa",
                                                "sense_id": "7b9d7643-4aff-3e4a-95fa-bcebb112afee",
                                                "text": "Le tout mis en musique par la fantastique partition de Bear McCreary, évoquant le thème emblématique de Howard Shore."
                                            },
                                            {
                                                "example_id": "eaf8ff61-626d-494d-8c65-dba40a5391a7",
                                                "sense_id": "7b9d7643-4aff-3e4a-95fa-bcebb112afee",
                                                "text": "Le massif de la Chipotte est probablement le lieu le plus emblématique de la bataille des frontières dans les Vosges."
                                            },
                                            {
                                                "example_id": "56397761-f5af-447d-90bd-0cd706c4b1c3",
                                                "sense_id": "7b9d7643-4aff-3e4a-95fa-bcebb112afee",
                                                "text": "En 2016, la mort de la mannequin américaine Katie May après un AVC, dont le médecin légiste a établi l’origine comme étant « la manipulation du cou par un chiropracteur », est sans doute le cas le plus emblématique."
                                            },
                                            {
                                                "example_id": "2299556a-9008-415b-978f-82e05cbd0da4",
                                                "sense_id": "7b9d7643-4aff-3e4a-95fa-bcebb112afee",
                                                "text": "Nul autre pays au monde n'abrite davantage de mammifères. Quelques-unes des espèces les plus emblématiques, comme le jaguar et le loup à crinière, sont presque impossibles à apercevoir."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "emblématique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3e22350e-c8ca-3ce3-9499-9eea3c677232",
                                        "entry_id": "660076e6-c234-38b1-84a2-f239cd2ae3e8",
                                        "glosses": [
                                            "Tous les attributs symboliques à une architecture, une charge, une fonction..."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8f421fc-9610-4f0e-9f8b-be20bb2563c2",
                                                "sense_id": "3e22350e-c8ca-3ce3-9499-9eea3c677232",
                                                "text": "Blois, c'est un essai,….Ici, beaucoup beaucoup d'éléments restent dus à l'architecture médiévale, notamment l'escalier à vis,…. Les gargouilles, l'emblématique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4faf3d3e-25d9-4aba-8d92-d4dfa481e16e",
                        "source_entry_id": "46d21b63-4036-36e8-bc7b-9b02f9bcb661",
                        "source_sense_description": "serving as a symbol",
                        "target_lang_word": "emblematisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "emblematisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9ef9066e-722c-35e5-810e-5a30eac029cb",
                                        "entry_id": "d1246eae-631a-33d9-a144-75acb29bf415",
                                        "glosses": [
                                            "sinnbildlich (ein Ding steht für ein anderes)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0df600e9-5963-4bae-9221-3c4e108476c5",
                                                "sense_id": "9ef9066e-722c-35e5-810e-5a30eac029cb",
                                                "text": "Diese neuen Aquarelle sind sehr emblematisch, sie bündeln eine Geschichte."
                                            },
                                            {
                                                "example_id": "9862e16c-e90e-40d8-958e-f769920996bc",
                                                "sense_id": "9ef9066e-722c-35e5-810e-5a30eac029cb",
                                                "text": "Ich wollte marokkanische Schriftsteller treffen und mir ein Bild von dieser emblematischen Stadt machen. Tanger ist, je nach Blickwinkel, das Tor zu Afrika oder das Tor zu Europa."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ee92b04e-f2cc-360a-803e-883d8aa56d1d",
                                        "entry_id": "d1246eae-631a-33d9-a144-75acb29bf415",
                                        "glosses": [
                                            "bezeichnend (ein Teil steht für das Ganze)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d230cc6e-594c-47fc-98f3-3730e3d360b6",
                                                "sense_id": "ee92b04e-f2cc-360a-803e-883d8aa56d1d",
                                                "text": "Die Beziehung zwischen China und Italien ist emblematisch für die gesamte politische Situation zwischen den Kulturen des Ostens und denen des Westens."
                                            },
                                            {
                                                "example_id": "ea8911e8-e1db-456c-a7f4-d459c2fd59c2",
                                                "sense_id": "ee92b04e-f2cc-360a-803e-883d8aa56d1d",
                                                "text": "„Abgesehen davon, dass die verfügbaren Daten ebenso detailliert wie verlässlich sind und diese Dynamik unmissverständlich zutage treten lassen, steht diese Phase tatsächlich emblematisch für eine erste Globalisierung von Handel und Finanzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
