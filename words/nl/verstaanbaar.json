            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6cff4e90-71ce-39df-835d-adf876390e0c",
                    "sense_definition": "zo duidelijk uitgesproken of klinkend dat het gehoord en herkend kan worden",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "akoestisch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Door het harde lawaai in de trein was de conducteur bijna niet <w>verstaanbaar</w>.",
                            "target_lang_translations": {
                                "en": "Due to the loud noise on the train, the conductor was barely <w>audible</w>."
                            }
                        },
                        {
                            "text": "De leraar probeerde zich <w>verstaanbaar</w> te maken in het drukke lokaal vol pratende leerlingen.",
                            "target_lang_translations": {
                                "en": "The teacher tried to <w>make himself heard</w> in the crowded classroom full of talking students."
                            }
                        }
                    ],
                    "antonyms": [
