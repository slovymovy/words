{
    "word_family": [
        "unclasp"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f439d99a-f80b-384f-9f23-1290f28de380",
                    "sense_definition": "To hold someone or something tightly with your hands or arms.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "hold",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They <w>clasped</w> hands and parted as friends after the long meeting.",
                            "target_lang_translations": {
                                "ru": "Они <w>пожали</w> друг другу руки и разошлись друзьями после долгой встречи."
                            }
                        },
                        {
                            "text": "The child <w>clasped</w> her mother's hand tightly while walking through the crowded market.",
                            "target_lang_translations": {
                                "ru": "Ребенок крепко <w>сжал</w> руку матери, идя через переполненный рынок."
                            }
                        }
                    ],
                    "synonyms": [
                        "grasp",
                        "grip",
                        "beclasp"
                    ],
                    "antonyms": [
                        "release",
                        "let go"
                    ],
                    "common_phrases": [
                        "clasp hands",
                        "clasp tightly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Крепко держать кого-либо или что-либо руками."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сжимать",
                                "target_lang_sense_clarification": "крепко обхватывать руками"
                            },
                            {
                                "target_lang_word": "обхватывать",
                                "target_lang_sense_clarification": "руками или объятиями"
                            },
                            {
                                "target_lang_word": "хватать",
                                "target_lang_sense_clarification": "крепко брать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3f1af081-3cf6-37ce-bfd2-4b69ca9bca48",
                    "sense_definition": "To fasten something with a small device or buckle.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fasten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>clasped</w> the gold necklace around her neck before leaving for the party.",
                            "target_lang_translations": {
                                "ru": "Она <w>застегнула</w> золотое ожерелье на шее перед уходом на вечеринку."
                            }
                        },
                        {
                            "text": "He carefully <w>clasped</w> the belt to ensure it was secure.",
                            "target_lang_translations": {
                                "ru": "Он осторожно <w>застегнул</w> ремень, чтобы убедиться, что он надежно закреплен."
                            }
                        }
                    ],
                    "synonyms": [
                        "attach",
                        "join"
                    ],
                    "antonyms": [
                        "unclasp",
                        "unfasten"
                    ],
                    "common_phrases": [
                        "clasp a necklace",
                        "clasp a belt"
                    ],
                    "target_lang_definitions": {
                        "ru": "Застегивать что-либо с помощью небольшого устройства или пряжки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "застегивать",
                                "target_lang_sense_clarification": "на застежку или пряжку"
                            },
                            {
                                "target_lang_word": "скреплять",
                                "target_lang_sense_clarification": "соединять части"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a6360852-f5f9-3b5a-820b-c2a2a98b8545",
                    "sense_definition": "A small device used for fastening things together, such as jewelry or a bag.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fastener",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I always have a hard time working the <w>clasp</w> on this necklace!",
                            "target_lang_translations": {
                                "ru": "Мне всегда трудно справиться с <w>застежкой</w> на этом ожерелье!"
                            }
                        },
                        {
                            "text": "The silver <w>clasp</w> on her handbag broke, so she had to get it repaired.",
                            "target_lang_translations": {
                                "ru": "Серебряная <w>застежка</w> на ее сумочке сломалась, поэтому ей пришлось отдать ее в ремонт."
                            }
                        }
                    ],
                    "synonyms": [
                        "join"
                    ],
                    "common_phrases": [
                        "necklace clasp",
                        "metal clasp"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшое устройство, используемое для скрепления вещей, таких как украшения или сумки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "застёжка",
                                "target_lang_sense_clarification": "для одежды, украшений или сумок"
                            },
                            {
                                "target_lang_word": "замок",
                                "target_lang_sense_clarification": "на цепочке или браслете"
                            },
                            {
                                "target_lang_word": "пряжка",
                                "target_lang_sense_clarification": "для ремня или сумки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a0d09a5b-28db-3297-9d93-31d5f2b8e08d",
                    "sense_definition": "A firm hold or a tight grasp with the hands.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "hold",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He took her hand in a firm <w>clasp</w> to show his support.",
                            "target_lang_translations": {
                                "ru": "Он взял ее руку в крепкое <w>пожатие</w>, чтобы выразить свою поддержку."
                            }
                        },
                        {
                            "text": "The athlete maintained a strong <w>clasp</w> on the trophy as he posed for photos.",
                            "target_lang_translations": {
                                "ru": "Атлет сохранял крепкую <w>хватку</w> на трофее, позируя для фотографий."
                            }
                        }
                    ],
                    "synonyms": [
                        "grasp",
                        "grip"
                    ],
                    "common_phrases": [
                        "firm clasp",
                        "tight clasp"
                    ],
                    "target_lang_definitions": {
                        "ru": "Крепкое удержание или плотный захват руками."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пожатие",
                                "target_lang_sense_clarification": "рук"
                            },
                            {
                                "target_lang_word": "хватка",
                                "target_lang_sense_clarification": "крепкое удержание"
                            },
                            {
                                "target_lang_word": "объятие",
                                "target_lang_sense_clarification": "крепкое удерживание руками"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d666e86b-bfb7-35aa-962e-1f11a737ba74",
                    "sense_definition": "A metal bar attached to a medal ribbon indicating an additional award or specific service.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "insignia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The veteran was proud to show the extra <w>clasp</w> on his campaign medal.",
                            "target_lang_translations": {
                                "ru": "Ветеран с гордостью показывал дополнительную <w>планку</w> на своей медали за кампанию."
                            }
                        },
                        {
                            "text": "Each <w>clasp</w> on the ribbon represented a different battle he had fought in.",
                            "target_lang_translations": {
                                "ru": "Каждая <w>планка</w> на ленте представляла отдельное сражение, в котором он участвовал."
                            }
                        }
                    ],
                    "common_phrases": [
                        "medal clasp"
                    ],
                    "target_lang_definitions": {
                        "ru": "Металлическая планка на ленте медали, указывающая на дополнительную награду или особые заслуги."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "планка",
                                "target_lang_sense_clarification": "на ленте медали"
                            },
                            {
                                "target_lang_word": "зажим",
                                "target_lang_sense_clarification": "для орденской ленты"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}