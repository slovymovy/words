                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6035ece7-a538-49ac-b6bf-cc2e785d41e9",
                                "sense_id": "75da461f-488d-3a42-82e2-a767bee68949",
                                "text": "Если человек безумеет от какой-нибудь зубной боли, то с чем сравнить всю эту душевную муку, когда всё кругом застилается мраком и жизнь делается непосильным бременем?.."
                            },
                            {
                                "example_id": "b72e8146-ca5c-4b38-8e4f-dffbc8f84efa",
                                "sense_id": "75da461f-488d-3a42-82e2-a767bee68949",
                                "text": "Лицо его серело, глаза безумели, и он похож был на обозлённую собаку."
                            }
                        ]
                    }
