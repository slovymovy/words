                ],
                "senses": [
                    {
                        "sense_id": "1357e5d1-ece5-317a-a25a-1653655be63b",
                        "entry_id": "1f0ebd27-a2ee-3596-abf5-cfc8560ee9a0",
                        "glosses": [
                            "To spell again."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "3ba5ce07-6305-4d3e-ae2c-ecc598631a7c",
                                "sense_id": "1357e5d1-ece5-317a-a25a-1653655be63b",
                                "text": "A child is learning to spell, but no special pains are taken to make him respell, and respell, until spelled aright, every misspelled word."
                            }
                        ]
                    },
                    {
                        "sense_id": "0647ef0c-39d9-3442-bc50-5f526df67a78",
                        "entry_id": "1f0ebd27-a2ee-3596-abf5-cfc8560ee9a0",
                        "glosses": [
                            "To spell again.",
                            "To spell differently, especially according to pronunciation, or by a phonetic system."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "5d318f15-425e-4421-bcba-72f1d9173c8c",
                                "sense_id": "0647ef0c-39d9-3442-bc50-5f526df67a78",
                                "text": "It may be hardly necessary to respell most of the words of this class in order to give their pronunciation, as, in their common orthography, they are naturally pronounced correctly, with the appropriate sound of the g."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "91379b83-f31b-4b81-a34e-2251bf09ff29",
                        "source_entry_id": "1f0ebd27-a2ee-3596-abf5-cfc8560ee9a0",
                        "source_sense_description": "Translations",
                        "target_lang_word": "réépeler",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "réépeler",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "271db0c4-7c3f-3946-aacb-3aff67187234",
                                        "entry_id": "bb628176-7c7a-3c38-b960-3d7a4e952a95",
                                        "glosses": [
                                            "Épeler à nouveau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa4b8f55-7225-4a42-bbc1-179f3eef6235",
                                                "sense_id": "271db0c4-7c3f-3946-aacb-3aff67187234",
                                                "text": "Le pire c'est par téléphone, à la troisième lettre, ils ont quasi tous raccroché et je dois réépeler !!!"
                                            }
                                        ]
                                    }
