        "fr-extract.jsonl": [
            {
                "entry_id": "8fffdf61-2919-3ac2-8d73-ebfaa7751c7e",
                "word": "EPI",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "cabd7353-dc60-3a2a-a243-c3d50f5fdff6",
                        "entry_id": "8fffdf61-2919-3ac2-8d73-ebfaa7751c7e",
                        "glosses": [
                            "Équipement de protection individuelle, permettant d’assurer la sécurité d’une personne en particulier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab42355a-15d8-40f1-905e-ebef8d318a9b",
                                "sense_id": "cabd7353-dc60-3a2a-a243-c3d50f5fdff6",
                                "text": "Certification des EPI anti-chute"
                            },
                            {
                                "example_id": "b7f2522b-80e8-4a18-8875-65b83022761f",
                                "sense_id": "cabd7353-dc60-3a2a-a243-c3d50f5fdff6",
                                "text": "PORT DES EPI ADAPTES"
                            },
                            {
                                "example_id": "9c38b7e2-a336-4af5-a20b-8a92e0a632ec",
                                "sense_id": "cabd7353-dc60-3a2a-a243-c3d50f5fdff6",
                                "text": "Les équipements de protection individuels (EPI) constituent la seule protection des usagers de deux-roues motorisés, du fait de l’absence de carrosserie et d’équipements susceptibles de les protéger en cas d’accident."
                            },
                            {
                                "example_id": "77ac3af4-8ecf-463f-9e93-5b3e83234006",
                                "sense_id": "cabd7353-dc60-3a2a-a243-c3d50f5fdff6",
                                "text": "Si le port d’un casque et de gants homologués est obligatoire en toutes conditions, les autres obligations ne concernent que les épreuves pratiques du permis définies par l’arrêté du 10/01/2013 qui stipule que les candidats au permis doivent porter des EPI adaptés : casque homologué, gants certifiés, blouson à manches longues, pantalon et bottes ou chaussures hautes."
                            }
                        ]
                    },
                    {
                        "sense_id": "b4761c9c-0fc7-363b-8a79-e75e591db2f5",
                        "entry_id": "8fffdf61-2919-3ac2-8d73-ebfaa7751c7e",
                        "glosses": [
                            "Personne spécialement formée pour intervenir sur les débuts d’incendie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9ea78ae-4ff6-4a05-9b46-0b76d270ee11",
                                "sense_id": "b4761c9c-0fc7-363b-8a79-e75e591db2f5",
                                "text": "Les équipiers de première intervention (EPI) ont reçu une formation plus complète sur la démarche coordonnée d’intervention et de lutte contre l’incendie"
                            }
                        ]
                    },
                    {
                        "sense_id": "c6d218c7-15ec-3395-80bd-598e52c1ee9f",
                        "entry_id": "8fffdf61-2919-3ac2-8d73-ebfaa7751c7e",
                        "glosses": [
                            "Ensemble formé par le parachute principal dorsal, le parachute de secours ventral et la gaine d’arme."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "bd7cd9f9-1723-327d-aacc-0ff5f13a0d66",
                        "entry_id": "8fffdf61-2919-3ac2-8d73-ebfaa7751c7e",
                        "glosses": [
                            "Entraînement par intervalles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b975fa9-87bf-4ae1-a88e-41b1bdd86c6c",
                                "sense_id": "bd7cd9f9-1723-327d-aacc-0ff5f13a0d66",
                                "text": "Commençons par le plus important: combien de séances d’EPI faut-il prévoir par semaine?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "00f648db-e70c-4676-999a-37ea36ab73c6",
                        "source_entry_id": "8fffdf61-2919-3ac2-8d73-ebfaa7751c7e",
                        "source_sense_id": "cabd7353-dc60-3a2a-a243-c3d50f5fdff6",
                        "source_sense_description": "Équipement de protection individuelle",
                        "target_lang_word": "PSA",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "PSA",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "42317f25-ca5f-3812-9716-e11c21e6b266",
                                        "entry_id": "d1281eba-7993-33da-93a6-1ee81e7d1553",
                                        "glosses": [
                                            "Persönliche Schutzausrüstung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "711036b9-420e-4586-87f4-564536042e61",
                                                "sense_id": "42317f25-ca5f-3812-9716-e11c21e6b266",
                                                "text": "„Die DGUV Regel erläutert §29 der DGUV Vorschrift 1 „Grundsätze der Prävention“ sowie Abschnitt 4.2.7 der Technischen Regel für Biologische Arbeitsstoffe (TRBA) „Biologische Arbeitsstoffe im Gesundheitswesen und in der Wohlfahrtspflege“ (TRBA 250) hinsichtlich der Bereitstellung von geeigneter persönlicher Schutzausrüstung (PSA) im Rettungsdienst.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4d7a92c0-aad0-4d7e-ba11-bb66642917e1",
                        "source_entry_id": "8fffdf61-2919-3ac2-8d73-ebfaa7751c7e",
                        "source_sense_id": "cabd7353-dc60-3a2a-a243-c3d50f5fdff6",
                        "source_sense_description": "Équipement de protection individuelle",
                        "target_lang_word": "Persönliche Schutzausrüstung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "dca476e6-42fe-4c23-80e4-c2a49edfa772",
                        "source_entry_id": "8fffdf61-2919-3ac2-8d73-ebfaa7751c7e",
                        "source_sense_id": "cabd7353-dc60-3a2a-a243-c3d50f5fdff6",
                        "source_sense_description": "Équipement de protection individuelle",
                        "target_lang_word": "Schutzausrüstung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schutzausrüstung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "788f7ae2-0366-3a17-a4dd-83fda56144da",
                                        "entry_id": "71c291d6-ca27-320f-bb07-f9c7efa2b5f5",
                                        "glosses": [
                                            "aus verschiedenen Teilen bestehende Bekleidung/Montur, die den Träger vor Schaden/Gefahr bewahren soll (unter Umständen auch mit bestimmten Gegenständen zu Schutz und Verteidigung)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6536dea1-00ed-4dfb-9434-49198510553f",
                                                "sense_id": "788f7ae2-0366-3a17-a4dd-83fda56144da",
                                                "text": "Neben der Schutzweste gehören auch Abdräng-Schild und Schutzbrille zur vorgeschriebenen Schutzausrüstung."
                                            },
                                            {
                                                "example_id": "8f743299-ee8a-4d5a-bb67-5ecddd308485",
                                                "sense_id": "788f7ae2-0366-3a17-a4dd-83fda56144da",
                                                "text": "Schutzausrüstung ist das A und O im Kampfsport. Sie brauchen Suspensorium, Kopfschutz, Brustschutz, Fußschutz, Schienbeinschutz, Mundschutz, Oberkörperschutz und gegebenenfalls einen Handschutz."
                                            },
                                            {
                                                "example_id": "b257222e-4c3c-4feb-8d63-825fcd78b2da",
                                                "sense_id": "788f7ae2-0366-3a17-a4dd-83fda56144da",
                                                "text": "Die Coronapandemie hat weltweit zu einer stark gestiegenen Nachfrage nach medizinischer Schutzausrüstung geführt, besonders bei den Schutzmasken gab es Engpässe."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "566b30cd-423c-420b-85f5-155f00d366d4",
                        "source_entry_id": "8fffdf61-2919-3ac2-8d73-ebfaa7751c7e",
