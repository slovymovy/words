                "senses": [
                    {
                        "sense_id": "ef1419ef-3195-34ad-8161-6655c92e6255",
                        "entry_id": "b9f0085b-2d7f-3a4c-9500-630d5e6e526a",
                        "glosses": [
                            "Wort, das ein beliebiges anderes Wort vertritt, das dem Sprecher nicht einfällt oder das er im gegebenen Zusammenhang nicht benutzen will und welches syntaktisch den Platz einnimmt, den das nicht benutzte Wort eingenommen hätte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6adf9400-f39e-403e-a99a-ace854f9c2e8",
                                "sense_id": "ef1419ef-3195-34ad-8161-6655c92e6255",
                                "text": "„Dingsbums“ ist so ein typisches umgangssprachliches Platzhalterwort."
                            },
                            {
                                "example_id": "be538b95-ed05-4596-a893-adb1b6351e4d",
                                "sense_id": "ef1419ef-3195-34ad-8161-6655c92e6255",
                                "text": "Gizmo (englisches Platzhalterwort, etwa „Ding“, „Dingens“, „Dingsbums“ …)"
                            },
                            {
                                "example_id": "8fdd3de1-7bf3-4e7f-a883-85aff1955451",
                                "sense_id": "ef1419ef-3195-34ad-8161-6655c92e6255",
                                "text": "So habe ich ihr Fotos von unserer Familie gezeigt: „Wer ist das?“, „Mama!“ - „Und das?“, „Papa!“ … „Und das?“, „Nonna!“ - „Und das?“ (ich zeigte nun das Foto von ihrer grossen Schwester). „Gugu!“, war ihre Antwort. „Gugu“ war also ihr Platzhalterwort für alles, was sie nicht direkt aussprechen konnte."
                            },
                            {
                                "example_id": "05f292ac-5733-4269-8386-abbe90c1f132",
                                "sense_id": "ef1419ef-3195-34ad-8161-6655c92e6255",
                                "text": "Dingsda - Person oder Sache, deren Name dem Sprecher gerade entfallen ist; leeres Platzhalterwort für einen entfallenen Namen oder Begriff"
                            },
                            {
                                "example_id": "09719c8a-1c25-4299-ad44-ffd8d2fe98fb",
                                "sense_id": "ef1419ef-3195-34ad-8161-6655c92e6255",
                                "text": "„Foo“ ist ein englischsprachiges Platzhalterwort, wie „bla“ oder „blubb“ in der deutschen Sprache."
                            },
                            {
                                "example_id": "0cc926d9-5383-44b7-87d9-063ff7618e0c",
                                "sense_id": "ef1419ef-3195-34ad-8161-6655c92e6255",
                                "text": "Das passende Wort zu einem Produkt zu finden, kann mitunter ein schwieriges Unterfangen sein. Wie schwierig genau, beweist uns […] im Supermarkt unseres Vertrauens dieser kleine Stab, der den eigenen Einkauf von dem Einkauf des Vor- oder Hintermannes trennt. Abstruse Wörter werden für diesen Gegenstand erfunden, und im Zweifel oder reinem Unwissen wird gern einmal auf das Platzhalterwort „Ding“ zurückgegriffen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
