                    {
                        "form_id": "1da27f5c-244d-4acd-9acb-8fec6ea9447d",
                        "entry_id": "663a9a8d-6849-3bd9-8879-a3035eb63758",
                        "tags": [
                            "singular",
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "^((h aspiré))\\ɑv\\"
