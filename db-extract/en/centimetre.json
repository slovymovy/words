                                    {
                                        "sense_id": "29fe8a27-e440-384d-9eae-d2f5d981b4ef",
                                        "entry_id": "cfe9c7f5-b2fe-3050-aa4d-a57e5acf3a46",
                                        "glosses": [
                                            "jednotka délky; setina metru"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5864069e-6883-4374-9e3f-9e044ba03334",
                                                "sense_id": "29fe8a27-e440-384d-9eae-d2f5d981b4ef",
                                                "text": "Podle hrázného jablonecké přehrady Jiřího Chmelaře leží ve městě 67 centimetrů sněhu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "04a3dd50-d474-3b77-b58b-2bd7635ccc31",
                                        "entry_id": "cfe9c7f5-b2fe-3050-aa4d-a57e5acf3a46",
                                        "glosses": [
                                            "krejčovské měřidlo"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf352af0-8b37-48fc-bfa9-3102932087ad",
                                                "sense_id": "04a3dd50-d474-3b77-b58b-2bd7635ccc31",
                                                "text": "Obvod pasu byl měřen krejčovským centimetrem, hmotnost zjišťována vážením na kalibrovaných váhách, body mass index byl počítán vzorcem BMI = hmotnost/kvadrát výšky (kg/m²)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7ffa0b5d-10e3-4e40-bb16-db9d887118db",
                        "source_entry_id": "2cd63120-f7bf-3359-8c3f-6ab2a3d86223",
                        "source_sense_id": "f80f774d-db01-32cd-a538-3a7a1dfae6b2",
                        "source_sense_description": "one-hundredth of a metre",
                        "target_lang_word": "centimeter",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "centimeter",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "6bb94967-25c9-3ad9-8300-8f2e2b8a4f3a",
                                        "entry_id": "b9c31229-adc5-38a9-bcdc-de0d2e851d79",
                                        "glosses": [
                                            "een lengtemaat die gelijk is aan één honderdste van een meter, weergegeven met symbool cm"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19952fb6-d00c-4291-8472-29ac951cdeaa",
                                                "sense_id": "6bb94967-25c9-3ad9-8300-8f2e2b8a4f3a",
                                                "text": "De stok is nog twee centimeter te kort."
                                            },
                                            {
                                                "example_id": "b0c3fae9-afa1-4d8c-9f81-bcb191644c6f",
                                                "sense_id": "6bb94967-25c9-3ad9-8300-8f2e2b8a4f3a",
                                                "text": "Bewoners van de Oosterstraat in Schiedam proberen met zandzakken water buiten hun woning te houden. De straat ligt 70 centimeter lager dan de nabije omgeving. Hevige regen- en onweersbuien, waarvoor het KNMI code oranje afgaf, leidden deze donderdag tot veel problemen in het midden en westen van het land."
                                            },
                                            {
                                                "example_id": "02fb542c-6c91-46db-9e30-0a60953c3c36",
                                                "sense_id": "6bb94967-25c9-3ad9-8300-8f2e2b8a4f3a",
                                                "text": "Ik wist niet wat ik zag toen ik aankwam. De hele tuin was omgetoverd tot een festivalterrein met ruim vijftig tenten die met minder dan een centimeter tussenruimte waren opgezet."
                                            },
                                            {
                                                "example_id": "6155a991-91a1-4088-8ac5-ce28ce8ff409",
                                                "sense_id": "6bb94967-25c9-3ad9-8300-8f2e2b8a4f3a",
                                                "text": "Dorien pakte Jeroens hand en tilde deze enkele centimeters op."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "796d82dd-d155-3169-a148-7c59bf064731",
                                        "entry_id": "b9c31229-adc5-38a9-bcdc-de0d2e851d79",
                                        "glosses": [
                                            "een meetlint waarmee men de lengte op centimeters nauwkeurig kan aflezen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09134196-f7a2-4129-a2e9-afa6ec979b71",
                                                "sense_id": "796d82dd-d155-3169-a148-7c59bf064731",
                                                "text": "De timmerman pakte zijn centimeter om de lengte nauwkeurig af te meten."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "987e4858-8bcc-46b4-8a0d-26672ba74c63",
