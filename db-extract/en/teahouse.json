                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "af5c318b-42f2-4454-9cfb-ff051f05579b",
                        "source_entry_id": "f0b1df3e-8b65-3924-88f1-ca35abc943a6",
                        "source_sense_description": "a cafe that sells tea",
                        "target_lang_word": "Teestube",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Teestube",
