                    "sense_definition": "Mettre de nouveau en usage, en vigueur ou en place quelque chose qui avait cessé d'exister ou d'être appliqué.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le gouvernement a décidé de <w>réintroduire</w> une taxe sur certains produits importés pour protéger l'économie."
                        },
                        {
                            "text": "L'école souhaite <w>réintroduire</w> le port de l'uniforme pour favoriser l'égalité entre les élèves."
                        }
                    ],
                    "synonyms": [
                        "rétablir",
                        "réinstaurer"
                    ],
                    "antonyms": [
