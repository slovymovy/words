                                "target_senses": [
                                    {
                                        "sense_id": "8849b2bf-cb56-3f60-bf02-93002bd3718f",
                                        "entry_id": "7d52ce07-9d28-3aa6-b3cd-eee1bb424570",
                                        "glosses": [
                                            "den Rechenregeln folgend, auf das Rechnen bezogen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba04f59c-b0c5-4080-b021-ed7d2874af63",
                                                "sense_id": "8849b2bf-cb56-3f60-bf02-93002bd3718f",
                                                "text": "Rein rechnerisch scheint sich das Projekt zu lohnen."
                                            },
                                            {
                                                "example_id": "b1aa716b-cae8-4ea4-ab52-acf4eaf1715e",
                                                "sense_id": "8849b2bf-cb56-3f60-bf02-93002bd3718f",
                                                "text": "Rechnerisch verstirbt alle vier Minuten ein Mensch am plötzlichen Herzstillstand."
                                            },
                                            {
                                                "example_id": "3eb845e5-16bf-4204-a78e-3a98798e0c9a",
                                                "sense_id": "8849b2bf-cb56-3f60-bf02-93002bd3718f",
                                                "text": "„Es gibt ein rechnerisches Modell, mit dem sich die Restlebensdauer vorhersagen lässt. Das Sterblichkeitsrisiko verdoppelt sich alle acht Jahre und nimmt exponentiell zu.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6b6617d1-e1c8-32a3-9ca1-efc2e0e376c1",
                                        "entry_id": "7d52ce07-9d28-3aa6-b3cd-eee1bb424570",
                                        "glosses": [
                                            "mit eigennützigen Hintergedanken, berechnend"
                                        ],
                                        "tags": [
                                            "Steigerung wäre denkbar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2ef4460-dc2f-4074-9e96-a51782727b0c",
                                                "sense_id": "6b6617d1-e1c8-32a3-9ca1-efc2e0e376c1",
                                                "text": "„[…] Und als er trotz ihres Reichtums jede größere Summe erfeilschen mußte und die rechnerische Gattin ihm sogar seine liebste Forderung, einen Rennstall, verweigerte, sah er wenig Anlaß mehr, sich weiterhin um die breitnackige, massive Norddeutsche ehelich zu bekümmern […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
