                "senses": [
                    {
                        "sense_id": "e5d2b824-5a86-36e0-8ab9-694785e74603",
                        "entry_id": "c2bb6414-41e0-30d7-a5cc-59f5fd28712d",
                        "glosses": [
                            "Vorschrift, die besagt, wann eine Zahl durch eine andere teilbar ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08ac89ef-ed9f-437e-b4ee-dbc977a8f257",
                                "sense_id": "e5d2b824-5a86-36e0-8ab9-694785e74603",
                                "text": "„Möchte man eine entsprechende Teilbarkeitsregel für die natürliche Zahl m finden, so betrachtet man die Reste der 10er-Potenzen bei der Division mit m. Die Reste entsprechen den gesuchten Gewichten.“"
                            },
                            {
                                "example_id": "c1dc1d62-9dbf-47a2-8ac0-2b0c8fa7fe9f",
                                "sense_id": "e5d2b824-5a86-36e0-8ab9-694785e74603",
                                "text": "„Im Dezimalsystem haben wir […] für die 2 und 5 Teilbarkeitsregeln, die sich aus der Teilbarkeitsregel für 10 ableiten, sowie Regeln für 4 und 8, die man aus den Regeln für 100 und 1000 bekommt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
