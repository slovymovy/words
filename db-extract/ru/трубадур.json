                                        "examples": [
                                            {
                                                "example_id": "9965b98b-5320-47e6-af22-466276d49427",
                                                "sense_id": "c9435028-f388-3241-8131-ffd4c108c3f2",
                                                "text": "Nog lang bleef het eigenaardige gezang van de troubadour in haar hoofd naklinken."
                                            },
                                            {
                                                "example_id": "7bddaf18-9a6f-408f-ade2-564db2c38adc",
                                                "sense_id": "c9435028-f388-3241-8131-ffd4c108c3f2",
                                                "text": "`Er was een tijd,' zei ze, 'waarin troubadours vrouwen het hof maakten met hun gedichten. Je zou bijna heimwee krijgen naar dat verleden. Want zie mij aan, omstuwd door twee heren die in hun pogingen een vrouw genegen te stemmen niets beters kunnen verzinnen dan indruk op haar te maken met haar eigen woorden.'"
                                            },
                                            {
                                                "example_id": "43d9ac6d-3977-4090-9e76-5c1dbc57e8a4",
                                                "sense_id": "c9435028-f388-3241-8131-ffd4c108c3f2",
                                                "text": "Ik weet meer over het verleden van de prinses dan welke sterveling ook, en het ware verhaal is minder sprookjesachtig dan de troubadours ons willen doen geloven."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1cc12bd2-1a5b-3ba9-acab-9cd9a347c279",
                                        "entry_id": "87b0fcb2-13e3-3691-860a-d57bfdd71662",
                                        "glosses": [
                                            "een langs herbergen, jaarmarkten rondtrekkend artiest, muzikant, zanger van liedjes en komediant"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3a4753a-28e6-4e63-b78e-10fa9f6316c5",
                                                "sense_id": "1cc12bd2-1a5b-3ba9-acab-9cd9a347c279",
                                                "text": "Met z'n grappen en vrolijke wijsjes bracht de troubadour het publiek in een uitgelaten stemming."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f96e28a3-4034-4796-87ae-996eb7a8d77e",
