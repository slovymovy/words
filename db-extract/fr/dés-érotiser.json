                ],
                "senses": [
                    {
                        "sense_id": "c3bc4449-c15f-33ed-9c34-0e3eb1aae417",
                        "entry_id": "071fba52-352f-3156-af84-c41746faf841",
                        "glosses": [
                            "Enlever son caractère érotique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57b44ff3-8773-421c-9a28-f4d511b41a61",
                                "sense_id": "c3bc4449-c15f-33ed-9c34-0e3eb1aae417",
                                "text": "Ces attitudes ne sont pas sans rappeler celles qui décrit Saouter (2001) dans son étude sur le rugby, en particulier sur la façon dont sont neutralisés les corps dans une logique consistant à les « dés-érotiser »."
                            },
                            {
                                "example_id": "6cccc0f8-e8fc-41b6-a89e-2aea6ff92693",
                                "sense_id": "c3bc4449-c15f-33ed-9c34-0e3eb1aae417",
                                "text": "Ils réclamèrent également au ministère de la Propagande de « dés-érotiser » la presse, la radio et le cinéma en supprimant les chansons à couplets « érotiques »."
                            },
                            {
                                "example_id": "c2d36532-a189-45b2-894b-5fcebe559492",
                                "sense_id": "c3bc4449-c15f-33ed-9c34-0e3eb1aae417",
                                "text": "Lisse et clos, il dés-érotise la corporéité, la dé-sensualise, même si ces caractéristiques ne cessent d’affleurer ou de jaillir ici et là par effraction."
                            }
                        ]
                    }
                ],
