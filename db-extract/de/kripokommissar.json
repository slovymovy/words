                        "examples": [
                            {
                                "example_id": "5089301d-b57a-4018-a450-0adb2a4d52b3",
                                "sense_id": "403ae8e7-d780-3bcc-bc6d-2b37a20d436f",
                                "text": "„Der Kripokommissar ist ein eindrucksvoller Mann, groß, kahl rasiert, dandyhaft.“"
                            },
                            {
                                "example_id": "33eff06d-86f1-4acb-8956-e1ab0e23c250",
                                "sense_id": "403ae8e7-d780-3bcc-bc6d-2b37a20d436f",
                                "text": "„Ihr Vater Roland Reck war zufällig mit dem Kripokommissar bekannt, dem die Demo-Anmeldung vorlag.“"
                            },
                            {
                                "example_id": "7e983aaa-f581-482f-a574-d6641dbd597d",
                                "sense_id": "403ae8e7-d780-3bcc-bc6d-2b37a20d436f",
                                "text": "„Der Kripokommissar aus Tübingen würde es als persönliche Niederlage betrachten, wenn Baumann doch schuldig wäre.“"
                            }
                        ],
