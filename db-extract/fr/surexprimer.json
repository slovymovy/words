                "senses": [
                    {
                        "sense_id": "e6044ed9-349a-350f-a8ee-a3e25743056a",
                        "entry_id": "b6f4e724-f47a-3b49-a4b4-0299bb9512c4",
                        "glosses": [
                            "Augmenter l’effet (d’un gène, etc.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60df48be-a086-4454-a6c0-54a028d2d196",
                                "sense_id": "e6044ed9-349a-350f-a8ee-a3e25743056a",
                                "text": "EGFR est surexprimé dans 70% des glioblastomes primaires, ceux après 55 ans."
                            },
                            {
                                "example_id": "c9c92d51-d358-4c34-8e2d-21ac87148b3c",
                                "sense_id": "e6044ed9-349a-350f-a8ee-a3e25743056a",
                                "text": "Techniques de génétiques de drosophile (croisements, utilisation de lignées Gal4 pour dépléter ou surexprimer la protéine d’intérêt dans des tissus spécifiques, génération de lignées transgéniques, variégation à effet de position, ….)."
                            },
                            {
                                "example_id": "4ddbf202-487d-4c49-bb80-1bb5dfbe6170",
                                "sense_id": "e6044ed9-349a-350f-a8ee-a3e25743056a",
                                "text": "Surexprimer les protéines."
                            },
                            {
                                "example_id": "040abbe1-af53-4ecc-8927-53287a0c1f90",
                                "sense_id": "e6044ed9-349a-350f-a8ee-a3e25743056a",
                                "text": "En parallèle, des protéines de fusion contenant SERT et un tag YFP en N-ter ont été surexprimées dans des neurones murins, afin de pouvoir co-immuno-précipiter les partenaires de SERT."
                            }
                        ]
                    }
