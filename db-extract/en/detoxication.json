                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fa74c49c-aebe-4c37-9c86-bfac5773ef10",
                        "source_entry_id": "05df9b64-818d-32d8-a3de-16998952db71",
                        "source_sense_description": "process",
                        "target_lang_word": "détoxication",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "détoxication",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8fba275e-51de-3f19-84b1-8a8e3754ba43",
                                        "entry_id": "2fc75d4b-901a-30f3-a054-12919ec5b4d8",
                                        "glosses": [
                                            "Action de détoxiquer, de faire une cure détox ; désintoxication."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6eb59c9f-7494-4e53-9753-5086d7f296fe",
                                                "sense_id": "8fba275e-51de-3f19-84b1-8a8e3754ba43",
                                                "text": "La détoxication passe, en effet, par la transformation de produits liposolubles (solubles dans la graisse) en produits hydrosolubles."
                                            },
                                            {
                                                "example_id": "8b73fc5c-3ca0-4ad8-b741-29275d61ec2b",
                                                "sense_id": "8fba275e-51de-3f19-84b1-8a8e3754ba43",
                                                "text": "Partout, l’on entend parler de la nécessité de faire une cure détox. Mais en quoi consiste cette détoxication, quels sont ses bienfaits, ses effets secondaires ?"
                                            },
                                            {
                                                "example_id": "a037aabe-95f8-4d77-867d-19475f9b4a57",
                                                "sense_id": "8fba275e-51de-3f19-84b1-8a8e3754ba43",
                                                "text": "Ses travaux sur le rat montrent que les sulfures d’allyle, composés que l’on trouve dans l’ail, stimulent certains enzymes hépatiques et intestinaux qui participent à la détoxication de substances cancérigènes présentes dans l’environnement, et inhibent une enzyme impliquée dans l’activation d’autres cancérigènes."
                                            },
                                            {
                                                "example_id": "f00da2ec-9e7f-42cb-ab43-f90e62f5f1e1",
                                                "sense_id": "8fba275e-51de-3f19-84b1-8a8e3754ba43",
                                                "text": "La circulation peut être considérée comme un acte d’intoxication par l’acide carbonique, mais corrigé à chaque instant, à l’état normal, par la respiration qui est un acte de détoxication."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
