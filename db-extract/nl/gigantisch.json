                    {
                        "form_id": "1bbc6540-2553-4d0b-97d5-a5fc96d498f8",
                        "entry_id": "f93c2ad9-0b6f-3223-bb10-d15f7a84c370",
                        "tags": [
                            "partitive",
                            "comparative"
                        ],
                        "form": "gigantischers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cda3f42d-cf1e-30d9-85e8-549904f6aff8",
                        "entry_id": "f93c2ad9-0b6f-3223-bb10-d15f7a84c370",
                        "glosses": [
                            "uizonderlijke groot"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b63754d9-9304-4726-a7ca-ab8e89f09b91",
                                "sense_id": "cda3f42d-cf1e-30d9-85e8-549904f6aff8",
                                "text": "Er kwam een gigantische vloedgolf die alles wegspoelde."
                            },
                            {
                                "example_id": "49146085-6f0b-4a55-8daf-7861f3620413",
                                "sense_id": "cda3f42d-cf1e-30d9-85e8-549904f6aff8",
                                "text": "In Schalkhaar durfde de organisatie het paasvuur niet aan te steken vanwege de droogte. Daarom is een gigantisch openluchtscherm opgesteld met daarop een film van het paasvuur. ,,Het is een mooie stunt en laat zien dat wij niet bij de pakken gaan neerzitten.’’"
                            },
                            {
                                "example_id": "df82df9a-f14d-4963-ada5-acf8327c92bf",
                                "sense_id": "cda3f42d-cf1e-30d9-85e8-549904f6aff8",
                                "text": "Het Amazoneregenwoud ligt in Zuid-Amerika. Het is gigantisch groot. Zo groot als de helft van Europa. Het regenwoud ligt verspreid over negen landen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "43a7685f-b6d8-43a7-a9ca-204febfe8116",
                        "source_entry_id": "f93c2ad9-0b6f-3223-bb10-d15f7a84c370",
                        "source_sense_id": "cda3f42d-cf1e-30d9-85e8-549904f6aff8",
                        "target_lang_word": "enormous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "enormous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "50d264bd-a8f6-3794-8469-ba634863cb23",
                                        "entry_id": "03455229-bbb1-339a-aba5-93cb37ca45e4",
                                        "glosses": [
                                            "Deviating from the norm; unusual, extraordinary."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bba4fcfa-daab-4ff3-a1fe-0fca4f3f3872",
                                                "sense_id": "50d264bd-a8f6-3794-8469-ba634863cb23",
                                                "text": "all shall be rather enforced than hindered, except they be dismembered, or grievously deformed, infirm, or visited with some enormous hereditary disease is body or mind […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4709110-1a92-34bd-b58e-1a4da324dc70",
                                        "entry_id": "03455229-bbb1-339a-aba5-93cb37ca45e4",
                                        "glosses": [
                                            "Exceedingly wicked; atrocious or outrageous."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c30ea444-7a73-466e-832f-76ab4ef2e955",
                                                "sense_id": "a4709110-1a92-34bd-b58e-1a4da324dc70",
                                                "text": "how apt wee are to receive all impressions, and chiefly the most wicked and enormous."
                                            },
                                            {
                                                "example_id": "95e12722-1d98-4085-8e67-fde0b375b990",
                                                "sense_id": "a4709110-1a92-34bd-b58e-1a4da324dc70",
                                                "text": "Men would prove wolves and vipers; tigers and dragons mixt in one and the same person to each other. O bless God for this great gift of Princes and Judges to rule the wicked and enormous world and to sway the scepter of righteousness […]"
                                            },
                                            {
                                                "example_id": "fee4edf7-5ac7-4a08-8fc2-11029f20ebb3",
                                                "sense_id": "a4709110-1a92-34bd-b58e-1a4da324dc70",
                                                "text": "Protestant Christian people are largely ignorant or indifferent to the wicked and enormous religious claims of Romanism. As a so-called religious organization, Romanism is not only the foe of Protestantism, but […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11a458f5-8f30-3ffb-9125-5d1b2a2b0646",
                                        "entry_id": "03455229-bbb1-339a-aba5-93cb37ca45e4",
                                        "glosses": [
                                            "Extremely large; greatly exceeding the common size, extent, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22feedd0-7795-48d9-b718-deff175a2749",
                                                "sense_id": "11a458f5-8f30-3ffb-9125-5d1b2a2b0646",
                                                "text": "The enormous Jupiter is the largest planet in the Solar System."
                                            },
                                            {
                                                "example_id": "f912bb4c-8cff-451b-8668-8ced9fdeb3cf",
                                                "sense_id": "11a458f5-8f30-3ffb-9125-5d1b2a2b0646",
                                                "text": "He turned back to the scene before him and the enormous new block of council dwellings. The design was some way after Corbusier but the block was built up on plinths and resembled an Atlantic liner swimming diagonally across the site."
                                            },
                                            {
                                                "example_id": "9da9c2c8-a564-4ecd-8078-7a0f79fe74b5",
                                                "sense_id": "11a458f5-8f30-3ffb-9125-5d1b2a2b0646",
                                                "text": "Floods in northern India, mostly in the small state of Uttarakhand, have wrought disaster on an enormous scale. The early, intense onset of the monsoon on June 14th swelled rivers, washing away roads, bridges, hotels and even whole villages. Rock-filled torrents smashed vehicles and homes, burying victims under rubble and sludge."
                                            },
                                            {
                                                "example_id": "ffab86d3-ae28-4772-a35b-2edb691097ed",
                                                "sense_id": "11a458f5-8f30-3ffb-9125-5d1b2a2b0646",
                                                "text": "Piecing together Corbynomics is difficult, not least because it has evolved during Mr Corbyn’s time in charge of Labour. The gulf between the Labour leadership’s past positions and the milder proposals in the manifesto means that enormous uncertainty hangs over what a Corbyn-led government would do in office."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6facd975-de87-47bb-9b2a-c90e192d1251",
                        "source_entry_id": "f93c2ad9-0b6f-3223-bb10-d15f7a84c370",
                        "source_sense_id": "cda3f42d-cf1e-30d9-85e8-549904f6aff8",
                        "target_lang_word": "gigantic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gigantic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2e8c9307-c470-3340-a69b-15cd77f9e6c0",
                                        "entry_id": "0fd6f71e-1bc0-36a0-838d-3c3932acd1ed",
                                        "glosses": [
                                            "Very large."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "624239e8-e18a-42d6-94c6-0c50211e5802",
                                                "sense_id": "2e8c9307-c470-3340-a69b-15cd77f9e6c0",
                                                "text": "Thou Genius of the place (this most renowned Ile)\nWhich livedst long before the All-earth-drowning Flood,\nWhilst yet the world did swarme with her Gigantick brood;"
                                            },
                                            {
                                                "example_id": "d893b783-29d1-4085-a95b-7ef474ae7c84",
                                                "sense_id": "2e8c9307-c470-3340-a69b-15cd77f9e6c0",
                                                "text": "It is in solitude that the imagination exercises its gigantic power; and where are a woman's feelings nurtured but in solitude?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f557100-f4f9-3d85-a370-66cc19db2d6d",
                                        "entry_id": "0fd6f71e-1bc0-36a0-838d-3c3932acd1ed",
                                        "glosses": [
                                            "Excellent; very good or exciting."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a655ec7e-19e7-4ee2-9b91-51f79eb88625",
                                                "sense_id": "6f557100-f4f9-3d85-a370-66cc19db2d6d",
                                                "text": "This band is going to be gigantic."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3204b4d9-9321-3a7e-8bff-db67ce8271a0",
                                        "entry_id": "0fd6f71e-1bc0-36a0-838d-3c3932acd1ed",
                                        "glosses": [
                                            "In the manner of a giant."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e0cf2e23-e856-4526-871e-741c989671a5",
                        "source_entry_id": "f93c2ad9-0b6f-3223-bb10-d15f7a84c370",
                        "source_sense_id": "cda3f42d-cf1e-30d9-85e8-549904f6aff8",
                        "target_lang_word": "huge",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "huge",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e4338431-3357-32fd-bd9a-a27e92d1290c",
                                        "entry_id": "b35a7fde-6367-33d7-b61c-5d48526cdac1",
                                        "glosses": [
                                            "Very large."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e8fa5a1-a8d4-44db-9d3c-6cb00ee94896",
                                                "sense_id": "e4338431-3357-32fd-bd9a-a27e92d1290c",
                                                "text": "“I don't mean all of your friends—only a small proportion—which, however, connects your circle with that deadly, idle, brainless bunch—the insolent chatterers at the opera,[…]the chlorotic squatters on huge yachts,[…]the neurotic victims of mental cirrhosis, the jewelled animals whose moral code is the code of the barnyard—!”"
                                            },
                                            {
                                                "example_id": "756a1c7a-cb79-452a-8b00-709ce8431997",
                                                "sense_id": "e4338431-3357-32fd-bd9a-a27e92d1290c",
                                                "text": "The huge square box, parquet-floored and high-ceilinged, had been arranged to display a suite of bedroom furniture designed and made in the halcyon days of the last quarter of the nineteenth century,[…]."
                                            },
                                            {
                                                "example_id": "2d21e2b2-f460-4cf6-99f0-c7c69240bf45",
                                                "sense_id": "e4338431-3357-32fd-bd9a-a27e92d1290c",
                                                "text": "[Rural solar plant] schemes are of little help to industry or other heavy users of electricity. Nor is solar power yet as cheap as the grid. For all that, the rapid arrival of electric light to Indian villages is long overdue. When the national grid suffers its next huge outage, as it did in July 2012 when hundreds of millions were left in the dark, look for specks of light in the villages."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df94a0a2-df36-3de4-b4c2-0b5c9f6ea90c",
                                        "entry_id": "b35a7fde-6367-33d7-b61c-5d48526cdac1",
                                        "glosses": [
                                            "Very strong, powerful, or dedicated."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70c4504b-e424-4a9b-b81a-764fa7012faa",
                                                "sense_id": "df94a0a2-df36-3de4-b4c2-0b5c9f6ea90c",
                                                "text": "Both of my parents are huge supporters of animal rights."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be18f605-da18-3b06-8a05-8b1cd7541e75",
                                        "entry_id": "b35a7fde-6367-33d7-b61c-5d48526cdac1",
                                        "glosses": [
                                            "Very interesting, significant, or popular."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac3a2e1e-cbba-4939-bc35-1d53dc32c905",
                                                "sense_id": "be18f605-da18-3b06-8a05-8b1cd7541e75",
                                                "text": "The band's next album is going to be huge."
                                            },
                                            {
                                                "example_id": "be4fa9d9-f27c-4d6c-ae72-8a73a776af17",
                                                "sense_id": "be18f605-da18-3b06-8a05-8b1cd7541e75",
                                                "text": "In our league our coach is huge!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0496ef8c-528f-46f0-ba5f-0fee931b1a27",
                        "source_entry_id": "f93c2ad9-0b6f-3223-bb10-d15f7a84c370",
