                "senses": [
                    {
                        "sense_id": "17aeefe0-d06c-354f-8c13-315e0489189f",
                        "entry_id": "636c6a99-ef22-3cdd-acb0-aae86cd3802e",
                        "glosses": [
                            "für die Innen- und Sportpolitik zuständige Fachbehörde (in Hamburg und Bremen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ecd77b2b-39ec-4884-ba95-9b5f1be5e667",
                                "sense_id": "17aeefe0-d06c-354f-8c13-315e0489189f",
                                "text": "„Die Spitzen von Polizei und Innenbehörde kündigten dazu am Freitag die Einführung einer sogenannten Kennzeichnungspflicht an.“"
                            },
                            {
                                "example_id": "e19c21c3-af20-4663-8c02-cf1a84641c33",
                                "sense_id": "17aeefe0-d06c-354f-8c13-315e0489189f",
                                "text": "„Beim Bürger- und Ordnungsamt Bremerhaven wurden nach Angaben der Bremer Innenbehörde fünf genehmigungspflichtige Waffen und neun erlaubnisfreie Waffen abgegeben.“"
                            },
                            {
                                "example_id": "83601107-0f61-4a80-802b-ff3c92ab9a22",
                                "sense_id": "17aeefe0-d06c-354f-8c13-315e0489189f",
                                "text": "„Seit dem Sommer 2016 prüft die Innenbehörde mit der Polizei mit Blick auf die neue Zielzahl 2600, wie die Bremer Polizei angesichts der Herausforderungen zukunftsfähig gestaltet werden kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
