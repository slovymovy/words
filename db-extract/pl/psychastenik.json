                        "glosses": [
                            "mężczyzna cierpiący na psychastenię"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46905293-5309-4dea-bfa8-23d2f01d8fe4",
                                "sense_id": "d6b360a7-074f-3d34-baee-d8e62b8d67cc",
                                "text": "Histeryk manipuluje innymi poprzez wybuchy własnej emocjonalności, psychastenik woli się poddać, niż wprost manipulować"
                            },
                            {
                                "example_id": "6d0d9cba-e3c6-458b-af4d-8fcbe1e5a708",
                                "sense_id": "d6b360a7-074f-3d34-baee-d8e62b8d67cc",
                                "text": "O ile histeryk nie dostrzega swoich wad, o tyle psychastenik je wyolbrzymia"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
