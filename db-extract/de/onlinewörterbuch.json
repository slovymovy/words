                "senses": [
                    {
                        "sense_id": "0d7c51d8-0330-3552-9131-32c1423c094c",
                        "entry_id": "a18aee37-455d-38a1-abfc-d12c003ab4b8",
                        "glosses": [
                            "Wörterbuch, das online im Internet zur Verfügung steht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "221e420b-db68-4dd2-8f96-59755c560a31",
                                "sense_id": "0d7c51d8-0330-3552-9131-32c1423c094c",
                                "text": "„In einer repräsentativen Studie des Hochschul-Informations-Systems (HIS) bezeichneten 52 Prozent der Studenten Wikipedia als »sehr verlässlich« oder »verlässlich«, Platz zwei belegte mit 49 Prozent das Onlinewörterbuch Leo […].“"
                            },
                            {
                                "example_id": "550434f7-6739-4ced-bb42-a3eb70e5a93c",
                                "sense_id": "0d7c51d8-0330-3552-9131-32c1423c094c",
                                "text": "„Im Juni 2004 wurden der Fachöffentlichkeit die ersten knapp 250 lexikografisch bearbeiteten Stichwörter im Onlinewörterbuch elexiko präsentiert; gut zehn Jahre später wurde die Bearbeitung des »Lexikons zum öffentlichen Sprachgebrauch« (das Kernmodul in elexiko) abgeschlossen und bei einem Kolloquium im Februar 2015 zur Diskussion gestellt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
