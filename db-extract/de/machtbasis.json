                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09468028-73fe-4a81-acb4-68a23644e7ec",
                                "sense_id": "007fe3d8-aed5-39c3-9cb8-1cb6b9748312",
                                "text": "„Der «unreine» Osten (Bihar und Bengalen) bot den dort entstehenden Großreichen eine enorme Machtbasis.“"
                            },
                            {
                                "example_id": "ea97e4b1-a7f0-40a6-8d03-7f9cc6c6896f",
                                "sense_id": "007fe3d8-aed5-39c3-9cb8-1cb6b9748312",
                                "text": "„Selbst als die Germanen etwa ab dem 3. Jahrhundert die Römerstädte bedrängten, geschah das nicht mit der Absicht, römische Verwaltungseinrichtungen oder Machtbasen zu übernehmen, sondern lediglich mit der Zielsetzung, germanische Handelszentren auszubauen.“"
                            },
                            {
                                "example_id": "4284b86f-2276-44e3-b622-88b47c879dfe",
                                "sense_id": "007fe3d8-aed5-39c3-9cb8-1cb6b9748312",
                                "text": "[Syrien, 2016:] „»Das Alawiten-Regime vertreibt und tötet mit den Luftschlägen sunnitische Zivilisten, um die eigene Machtbasis zu stärken.«“"
                            }
                        ],
                        "sense_index_json": "\"1\""
