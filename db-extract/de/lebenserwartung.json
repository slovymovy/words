                        "form": "der Lebenserwartung"
                    },
                    {
                        "form_id": "e28bfce4-01d3-45b4-bb7e-dbdc8f0a2e51",
                        "entry_id": "995c6dfb-754d-39d2-b749-c881a2eec25b",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Lebenserwartung"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "12df16c9-c27d-327e-abd1-3d65dd7053c8",
                        "entry_id": "995c6dfb-754d-39d2-b749-c881a2eec25b",
                        "glosses": [
                            "geschätzte Dauer des Lebens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46e9a788-6c27-4cc6-ab72-f525a3df848b",
                                "sense_id": "12df16c9-c27d-327e-abd1-3d65dd7053c8",
                                "text": "Die Lebenserwartung in einigen Entwicklungsländern ist erschreckend niedrig."
                            },
                            {
                                "example_id": "ff644048-52ef-4ab9-96f3-17f2bdd9133e",
                                "sense_id": "12df16c9-c27d-327e-abd1-3d65dd7053c8",
                                "text": "„Die Lebenserwartung in der DDR lag deutlich niedriger als in der Bundesrepublik, die Umweltbelastung dagegen teilweise dramatisch höher.“"
                            },
                            {
                                "example_id": "993b5cb3-c524-4763-a3f6-3544c35330ac",
                                "sense_id": "12df16c9-c27d-327e-abd1-3d65dd7053c8",
                                "text": "„Er erzählt von der Lebenserwartung, die um fünf Jahre gesunken ist.“"
                            },
                            {
                                "example_id": "4094d35b-2e60-4326-991b-3caae2ad9687",
                                "sense_id": "12df16c9-c27d-327e-abd1-3d65dd7053c8",
                                "text": "„Allein und im Rentenalter, fiel ich in Ländern wie Namibia auf, wo die durchschnittliche Lebenserwartung bei 43 Jahren liegt.\""
                            },
                            {
                                "example_id": "81300b5a-0b8b-4c83-89dc-738537d1a6b2",
                                "sense_id": "12df16c9-c27d-327e-abd1-3d65dd7053c8",
                                "text": "„Die Lebenserwartung liegt für Männer in Finnland bei 76 Jahren, 83 bei Frauen, und stieg für beide Geschlechter um ein Jahr in den letzten fünf Jahren.“"
                            },
                            {
                                "example_id": "0f5a5fee-3201-45e8-826a-7e3100247d09",
                                "sense_id": "12df16c9-c27d-327e-abd1-3d65dd7053c8",
                                "text": "„Deutsche haben die geringste Lebenserwartung in Westeuropa.“"
                            },
                            {
                                "example_id": "f907c69c-8128-4fbe-93a6-e64c03034f42",
                                "sense_id": "12df16c9-c27d-327e-abd1-3d65dd7053c8",
                                "text": "War die Lebenserwartung bei der Geburt im Jahr 2014 hierzulande bis auf 78,44 Jahre für Männer und 83,33 für Frauen geklettert, fiel sie 2015 auf 78,13 Jahre beziehungsweise 82,98 Jahre."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0a9eae79-e0d4-4d95-ad52-0ae184573a65",
                        "source_entry_id": "995c6dfb-754d-39d2-b749-c881a2eec25b",
                        "source_sense_id": "12df16c9-c27d-327e-abd1-3d65dd7053c8",
                        "source_sense_description": "geschätzte Dauer des Lebens",
                        "target_lang_word": "life expectancy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "life expectancy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8ce029a3-fafd-366f-90cd-c9ec2f099603",
                                        "entry_id": "db80277b-1ef0-3a30-ab63-890c71af1510",
                                        "glosses": [
                                            "The amount of time one is expected to live."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c70f6b0-99b9-4f31-8761-b5b71e6409b0",
                                                "sense_id": "8ce029a3-fafd-366f-90cd-c9ec2f099603",
                                                "text": "Great Danes have relatively short life expectancies compared to smaller dogs, living for an average of 8-10 years, and males are typically about 2.5 feet (0.76 meters) tall, according to the American Kennel Club."
                                            },
                                            {
                                                "example_id": "13d39a50-4445-4191-8f13-331dea4f51af",
                                                "sense_id": "8ce029a3-fafd-366f-90cd-c9ec2f099603",
                                                "text": "People born in 2023 are now estimated to live 78.4 years, according to the CDC. That’s still shy of the 78.8-year life expectancy from 2019, but it’s a significant improvement driven by lower death rates in each of the 10 leading causes of death."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc2b8ade-4db9-3541-a3e6-7e6b12768bcf",
                                        "entry_id": "db80277b-1ef0-3a30-ab63-890c71af1510",
                                        "glosses": [
                                            "The amount of time something is expected to last."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8da85517-6d14-4a34-a612-30858f34b38a",
                        "source_entry_id": "995c6dfb-754d-39d2-b749-c881a2eec25b",
                        "source_sense_id": "12df16c9-c27d-327e-abd1-3d65dd7053c8",
                        "source_sense_description": "geschätzte Dauer des Lebens",
                        "target_lang_word": "espérance de vie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "espérance de vie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "41745cd6-b749-3e0a-b0f1-36eb7b5cf497",
                                        "entry_id": "3d0cf5b4-73ec-3bfd-b07a-68b5cca33160",
                                        "glosses": [
                                            "Durée de vie restante moyenne des personnes d’un groupe partageant des caractéristiques données (lieu de vie, sexe, etc.), qui représente la durée qu’une personne de ce groupe peut encore espérer vivre à un moment donné."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a480ec4-8722-4ea9-9eb0-9a5806b3b0e4",
                                                "sense_id": "41745cd6-b749-3e0a-b0f1-36eb7b5cf497",
                                                "text": "L’espérance moyenne de vie est de trente ans en Bolivie ou au nord-est du Brésil. Cette situation va s’aggraver, car l’Amérique latine accuse le taux de croissance démographique le plus élevé du monde : 3 %."
                                            },
                                            {
                                                "example_id": "2b7a7562-5b3c-4165-942a-f3797bea9ab1",
                                                "sense_id": "41745cd6-b749-3e0a-b0f1-36eb7b5cf497",
                                                "text": "En uxorilocalité par contre l’homme est mal à l’aise et la femme plus en confort : le surplus de longévité est pour cette dernière. Néolocalité mise à part on peut donc dire que chaque conjoint a, envers son espérance de vie, intérêt à établir ménage auprès de ses proches."
                                            },
                                            {
                                                "example_id": "9f9de132-e20b-429d-9609-2075dc21b370",
                                                "sense_id": "41745cd6-b749-3e0a-b0f1-36eb7b5cf497",
                                                "text": "75 % de la population afrocolombienne du pays perçoit des salaires plus bas que le minimum légal et leur espérance de vie est de 20% inférieure à la moyenne nationale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "272d27f0-2f16-36fe-87df-9088765714f0",
                                        "entry_id": "3d0cf5b4-73ec-3bfd-b07a-68b5cca33160",
                                        "glosses": [
                                            "Durée moyenne d’une situation existante."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d1f8ae2-c39a-4cbe-8a34-fdf9eab9898b",
                                                "sense_id": "272d27f0-2f16-36fe-87df-9088765714f0",
                                                "text": "Scène tout à fait vraisemblable, et qui a dû s’entendre réellement dans bon nombre de foyers de jazzmen, dont l’espérance de vie dépasse rarement la venue du deuxième enfant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e7c8f17-8048-3d65-b8bf-b8acd702def8",
                                        "entry_id": "3d0cf5b4-73ec-3bfd-b07a-68b5cca33160",
                                        "glosses": [
                                            "Durée moyenne de bon fonctionnement qu’un objet peut atteindre à partir d’un moment donné et selon des contraintes mécaniques données. référence nécessaire (résoudre le problème)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f2af1c1-70f1-4d0c-812d-7da388f82181",
                                                "sense_id": "6e7c8f17-8048-3d65-b8bf-b8acd702def8",
                                                "text": "Ces bicyclettes-là ne sont peut-être pas dernier cri, mais leur espérance de vie est extraordinaire !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
