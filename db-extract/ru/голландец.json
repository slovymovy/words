                "senses": [
                    {
                        "sense_id": "fddebbb0-1f21-3bc1-92c0-f9d3881b0559",
                        "entry_id": "fafde8e2-1272-3cf4-8979-cd1d1fddb81d",
                        "glosses": [
                            "житель или уроженец Голландии"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "da47e1bb-2f9a-3b02-8d9f-4f63ddfcb600",
                        "entry_id": "fafde8e2-1272-3cf4-8979-cd1d1fddb81d",
                        "glosses": [
                            "разг. то же, что нидерландец"
                        ],
                        "tags": [],
