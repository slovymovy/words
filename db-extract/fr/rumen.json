                                        "glosses": [
                                            "The first compartment of the stomach of a cow or other ruminants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d72d7e6-b83a-4275-9cd9-0942c8213c0b",
                                                "sense_id": "b53378eb-011e-3194-a0a6-2761a450790f",
                                                "text": "In the newborn ruminant the abomasum is about as large as the rumen and remains relatively large as long as only milk is consumed (Brugnone, 1809). As the young ruminant consumes forages, the reticulum, and particularly the rumen, develop rapidly."
                                            }
                                        ]
