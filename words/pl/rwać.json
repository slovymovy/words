            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4508d679-ff9f-3e52-a35a-5c7a2860cfa5",
                    "sense_definition": "zbierać owoce, kwiaty lub liście przez odrywanie ich od rośliny",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "plants",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dzieci z radością <w>rwały</w> dojrzałe jabłka prosto z drzewa w sadzie babci.",
                            "target_lang_translations": {
                                "ru": "Дети с радостью <w>рвали</w> спелые яблоки прямо с дерева в бабушкином саду."
                            }
                        },
                        {
                            "text": "W każdą wiosnę chętnie <w>rwę</w> świeże kwiaty na łące za domem.",
                            "target_lang_translations": {
                                "ru": "Каждую весну я с удовольствием <w>собираю</w> свежие цветы на лугу за домом."
                            }
                        }
                    ],
                    "synonyms": [
                        "zrywać",
                        "zbierać"
                    ],
                    "common_phrases": [
                        "rwać jabłka",
                        "rwać kwiaty"
                    ],
                    "target_lang_definitions": {
                        "ru": "собирать плоды, цветы или листья, отделяя их от растения"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рвать",
                                "target_lang_sense_clarification": "цветы, плоды"
                            },
                            {
                                "target_lang_word": "срывать",
                                "target_lang_sense_clarification": "отделять от растения"
                            },
                            {
                                "target_lang_word": "собирать",
                                "target_lang_sense_clarification": "урожай, цветы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "65f6a5f2-4026-3a50-abc4-7e0cbd2c5b14",
                    "sense_definition": "dzielić coś na części za pomocą ciągnięcia lub szarpania",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zamiast użyć nożyczek, zdenerwowany chłopak zaczął <w>rwać</w> stary papier na małe kawałki.",
                            "target_lang_translations": {
                                "ru": "Вместо того чтобы взять ножницы, расстроенный парень принялся <w>рвать</w> старую бумагу на мелкие кусочки."
                            }
                        },
                        {
                            "text": "Podczas pakowania paczki zawsze <w>rwę</w> gazety, aby zabezpieczyć delikatne przedmioty.",
                            "target_lang_translations": {
                                "ru": "Упаковывая посылку, я всегда <w>рву</w> газеты, чтобы защитить хрупкие вещи."
                            }
                        }
                    ],
                    "synonyms": [
                        "drzeć",
                        "szarpać"
                    ],
                    "common_phrases": [
                        "rwać papier",
                        "rwać na kawałki",
                        "rwać na strzępy"
                    ],
                    "target_lang_definitions": {
                        "ru": "разделять что-либо на части натяжением или резким движением"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рвать",
                                "target_lang_sense_clarification": "бумагу, ткань"
                            },
                            {
                                "target_lang_word": "раздирать",
                                "target_lang_sense_clarification": "на части"
                            },
                            {
                                "target_lang_word": "драть",
                                "target_lang_sense_clarification": "на куски"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cf802bf5-bdc3-3290-8ecf-11fb38ced154",
                    "sense_definition": "usuwać coś siłą lub wyciągać gwałtownym ruchem z podłoża bądź ciała",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Doświadczony dentysta szybko i bezboleśnie <w>rwie</w> zepsuty ząb pacjenta.",
                            "target_lang_translations": {
                                "ru": "Опытный стоматолог быстро и безболезненно <w>удаляет</w> больной зуб пациента."
                            }
                        },
                        {
                            "text": "Ogrodnik przez całe popołudnie <w>rwał</w> chwasty rosnące pomiędzy grządkami marchewek.",
                            "target_lang_translations": {
                                "ru": "Садовник весь день <w>полол</w> сорняки, росшие между грядками моркови."
                            }
                        }
                    ],
                    "synonyms": [
                        "zrywać"
                    ],
                    "common_phrases": [
                        "rwać ząb",
                        "rwać chwasty"
                    ],
                    "target_lang_definitions": {
                        "ru": "удалять что-либо силой или резким движением из земли или тела"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рвать",
                                "target_lang_sense_clarification": "зуб, сорняки"
                            },
                            {
                                "target_lang_word": "вырывать",
                                "target_lang_sense_clarification": "с корнем или силой"
                            },
                            {
                                "target_lang_word": "выдёргивать",
                                "target_lang_sense_clarification": "с усилием"
                            },
                            {
                                "target_lang_word": "удалять",
                                "target_lang_sense_clarification": "о зубе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "38c06b0f-3406-39cb-b31d-097f267b4006",
                    "sense_definition": "boleć w sposób pulsujący, rwący i uciążliwy",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "pain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Przed każdą gwałtowną zmianą pogody okropnie <w>rwie</w> mnie w kolanie.",
                            "target_lang_translations": {
                                "ru": "Перед каждой резкой переменой погоды у меня ужасно <w>ломит</w> в колене."
                            }
                        },
                        {
                            "text": "Starszego pana od rana mocno <w>rwało</w> w krzyżu po ciężkiej pracy.",
                            "target_lang_translations": {
                                "ru": "У пожилого мужчины с самого утра сильно <w>стреляло</w> в пояснице после тяжёлой работы."
                            }
                        }
                    ],
                    "synonyms": [
                        "boleć"
                    ],
                    "common_phrases": [
                        "rwie w kościach",
                        "rwie w krzyżu"
                    ],
                    "target_lang_definitions": {
                        "ru": "болеть пульсирующей, ноющей или тянущей болью"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ломить",
                                "target_lang_sense_clarification": "о костях, суставах"
                            },
                            {
                                "target_lang_word": "стрелять",
                                "target_lang_sense_clarification": "о резкой пульсирующей боли"
                            },
                            {
                                "target_lang_word": "ныть",
                                "target_lang_sense_clarification": "о тянущей боли"
                            },
                            {
                                "target_lang_word": "дёргать",
                                "target_lang_sense_clarification": "о пульсирующей боли"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9546adbe-9241-3c13-8c89-e7b346d2724a",
                    "sense_definition": "starać się zdobyć czyjeś względy miłosne; flirtować",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "social",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Marek przez cały wieczór w klubie bezskutecznie <w>rwał</w> nowo poznaną dziewczynę.",
                            "target_lang_translations": {
                                "ru": "Марек весь вечер в клубе безуспешно <w>кадрил</w> новую знакомую."
                            }
                        },
                        {
                            "text": "Mój kolega zawsze <w>rwie</w> dziewczyny przy użyciu tych samych żartów.",
                            "target_lang_translations": {
                                "ru": "Мой приятель всегда <w>клеит</w> девушек одними и теми же шутками."
                            }
                        }
                    ],
                    "synonyms": [
                        "podrywać",
                        "uwodzić",
                        "podwalać się"
                    ],
                    "common_phrases": [
                        "rwać dziewczyny"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "potoczne, slangowe określenie na podrywanie"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "пытаться завязать романтические отношения; флиртовать, знакомиться"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "клеить",
