                "senses": [
                    {
                        "sense_id": "04d2caf0-49c9-3ceb-8883-1a954be6371b",
                        "entry_id": "3ce9b723-79d0-396f-9d7e-c9666b4d8b09",
                        "glosses": [
                            "Ort der Geburt einer Person"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f663055c-2d32-4102-b3c1-760896606fe4",
                                "sense_id": "04d2caf0-49c9-3ceb-8883-1a954be6371b",
                                "text": "„Als mein Zug durch die Nacht nach Heidelberg, Eberts Geburtsstätte, fuhr, sah ich auf allen Stationen Hunderte versammelt, die den toten Präsidenten noch einmal grüßen wollten.“"
                            },
                            {
                                "example_id": "85549452-5bcf-4fab-925b-98685d44c625",
                                "sense_id": "04d2caf0-49c9-3ceb-8883-1a954be6371b",
                                "text": "„Am besten lässt er sich an Symbolen festmachen, wie an «Ramjanmabhumi» in Ayodhya, wo ein Tempel die Geburtsstätte des legendären Königs Rama markiert haben soll.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4c1952e8-2175-35f7-9e0d-965bfc82a20b",
                        "entry_id": "3ce9b723-79d0-396f-9d7e-c9666b4d8b09",
                        "glosses": [
                            "übertragen: Ort, an dem etwas entstanden ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17b8933b-a22b-467a-bb7d-cf42b4f9ae21",
                                "sense_id": "4c1952e8-2175-35f7-9e0d-965bfc82a20b",
                                "text": "„Auch England, die Geburtsstätte von Traumwagen wie Aston Martin, Jaguar und Rolls Royce, ist speziell, was den Autoverkehr angeht.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
