    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d05aae14-57f9-3776-a2e0-ef6ad47e68af",
                    "sense_definition": "Mettre son dos en appui contre une surface, un mur ou un arbre.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "appui_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fatigué par la longue marche, le voyageur vint s'<w>adosser</w> au tronc d'un chêne pour se reposer."
                        },
                        {
                            "text": "Le détective préférait s'<w>adosser</w> contre le mur pour observer discrètement toute la pièce."
                        }
                    ],
                    "synonyms": [
                        "appuyer",
                        "accoter"
                    ],
                    "common_phrases": [
                        "s adosser au mur",
                        "s adosser contre un arbre"
                    ]
                },
                {
                    "sense_id": "efbfeaff-2e14-3a7e-a902-9606a1df7407",
                    "sense_definition": "Placer une construction ou un objet contre une surface solide qui lui sert d'appui ou d'abri.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "appui_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'architecte a choisi d'<w>adosser</w> la nouvelle véranda au mur nord de la maison."
                        },
                        {
                            "text": "Les jardiniers vont <w>adosser</w> un petit abri en bois contre la haie pour protéger les outils."
                        }
                    ],
                    "synonyms": [
                        "appuyer"
                    ],
                    "common_phrases": [
                        "adosser au mur"
                    ]
                },
                {
                    "sense_id": "d69844a5-2ebf-3a13-bfb9-9e9e236f104a",
                    "sense_definition": "Appuyer le dos d'une personne contre un mur ou un autre support.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "appui_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin aida le blessé à se relever et l'<w>adossa</w> avec précaution contre le mur."
                        },
                        {
                            "text": "Il <w>adosse</w> doucement son enfant fatigué contre le dossier du canapé."
                        }
                    ],
                    "synonyms": [
                        "appuyer"
                    ],
                    "common_phrases": [
                        "adosser contre un mur"
                    ]
