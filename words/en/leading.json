{
    "word_family": [
        "lead",
        "leader",
        "leadership",
        "mislead",
        "misleading",
        "leaderless"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5f6c81a8-1d00-3a27-8b37-bc56e9401c7a",
                    "sense_definition": "Ranking first; most important or most successful.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She played a <w>leading</w> role in the organization of the festival.",
                            "target_lang_translations": {
                                "ru": "Она сыграла <w>ведущую</w> роль в организации фестиваля.",
                                "zh": "她在节日组织工作中发挥了<w>主导</w>作用。"
                            }
                        },
                        {
                            "text": "Heart disease is a <w>leading</w> cause of death in many countries.",
                            "target_lang_translations": {
                                "ru": "Болезни сердца являются <w>основной</w> причиной смерти во многих странах.",
                                "zh": "心脏病是许多国家死亡的<w>主要</w>原因。"
                            }
                        }
                    ],
                    "antonyms": [
                        "lagging",
                        "trailing"
                    ],
                    "common_phrases": [
                        "leading role",
                        "leading cause",
                        "leading expert"
                    ],
                    "target_lang_definitions": {
                        "ru": "Занимающий первое место; самый важный или успешный.",
                        "zh": "排在第一位的；最重要、最成功或最有影响的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ведущий",
                                "target_lang_sense_clarification": "самый важный, главный"
                            },
                            {
                                "target_lang_word": "главный",
                                "target_lang_sense_clarification": "основной"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "主要的",
                                "target_lang_sense_clarification": "最重要、最有影响或最成功的"
                            },
                            {
                                "target_lang_word": "领先的",
                                "target_lang_sense_clarification": "处于领先地位的"
                            },
                            {
                                "target_lang_word": "主导的",
                                "target_lang_sense_clarification": "起核心作用的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8c9f8fa5-f428-3aae-94f8-fa8edade8ec8",
                    "sense_definition": "Designed to guide someone to a specific conclusion or action, especially in questioning.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer was warned by the judge not to ask <w>leading</w> questions.",
                            "target_lang_translations": {
                                "ru": "Судья предупредил адвоката не задавать <w>наводящих</w> вопросов.",
                                "zh": "法官警告律师不要提出<w>诱导性</w>问题。"
                            }
                        },
                        {
                            "text": "Her <w>leading</w> remarks helped the student find the correct answer.",
                            "target_lang_translations": {
                                "ru": "Её <w>наводящие</w> замечания помогли студенту найти правильный ответ.",
                                "zh": "她那些<w>引导性</w>的话帮助学生找到了正确答案。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "leading question"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предназначенный для того, чтобы подвести кого-то к определенному выводу или действию (о вопросах).",
                        "zh": "旨在引导某人得出特定结论或采取某种行动的，尤指问题带有暗示性的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наводящий",
                                "target_lang_sense_clarification": "подсказывающий ответ"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "诱导性的",
                                "target_lang_sense_clarification": "通过暗示答案或结论来引导对方的，尤指问题"
                            },
                            {
                                "target_lang_word": "引导性的",
                                "target_lang_sense_clarification": "起提示、引导作用的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0a0a8b1d-4814-3c3c-9c63-b1d478052f0f",
                    "sense_definition": "Occurring in advance or positioned at the front.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>leading</w> edge of the storm brought heavy rain and wind.",
                            "target_lang_translations": {
                                "ru": "<w>Передний</w> край шторма принес сильный дождь и ветер.",
                                "zh": "风暴<w>前面的</w>边缘带来了强风和暴雨。"
                            }
                        },
                        {
                            "text": "Consumer confidence is often considered a <w>leading</w> economic indicator.",
                            "target_lang_translations": {
                                "ru": "Уверенность потребителей часто считается <w>опережающим</w> экономическим показателем.",
                                "zh": "消费者信心常被视为一种<w>先行</w>经济指标。"
                            }
                        }
                    ],
                    "antonyms": [
                        "following"
                    ],
                    "common_phrases": [
                        "leading edge",
                        "leading indicator"
                    ],
                    "target_lang_definitions": {
                        "ru": "Находящийся впереди или происходящий заранее.",
                        "zh": "发生在前、先于其他事物出现的；或位于前端的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опережающий",
                                "target_lang_sense_clarification": "происходящий заранее"
                            },
                            {
                                "target_lang_word": "передний",
                                "target_lang_sense_clarification": "расположенный спереди"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "前面的",
                                "target_lang_sense_clarification": "位于前面的；在最前端的"
                            },
                            {
                                "target_lang_word": "先行的",
                                "target_lang_sense_clarification": "预示后续变化、先于其他现象出现的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e1ae8a10-b46d-30f8-b389-ce545b70d407",
                    "sense_definition": "Present participle of <w>lead</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is <w>leading</w> the team to victory this season.",
                            "target_lang_translations": {
                                "ru": "Она <w>ведет</w> команду к победе в этом сезоне.",
                                "zh": "这个赛季她正<w>带领</w>球队走向胜利。"
                            }
                        },
                        {
                            "text": "A narrow path is <w>leading</w> deep into the forest.",
                            "target_lang_translations": {
                                "ru": "Узкая тропинка <w>ведет</w> глубоко в лес.",
                                "zh": "一条狭窄的小路正<w>通向</w>森林深处。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "leading the way"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени от глагола lead (вести).",
                        "zh": "lead 的现在分词形式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ведущий",
                                "target_lang_sense_clarification": "указывающий путь"
                            },
                            {
                                "target_lang_word": "руководящий",
                                "target_lang_sense_clarification": "управляющий"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "带领",
                                "target_lang_sense_clarification": "带着人或事物向前移动、走向某处"
                            },
                            {
                                "target_lang_word": "引导",
                                "target_lang_sense_clarification": "引导方向"
                            },
                            {
                                "target_lang_word": "通向",
                                "target_lang_sense_clarification": "道路等延伸到某处"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3da38844-652f-3694-ab1f-a0d7445b22e9",
                    "sense_definition": "The vertical space added between lines of text in printing or typography.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Increasing the <w>leading</w> makes the paragraph easier to read.",
                            "target_lang_translations": {
                                "ru": "Увеличение <w>интерлиньяжа</w> делает абзац более удобным для чтения.",
                                "zh": "增大<w>行距</w>会让这段文字更容易阅读。"
                            }
                        },
                        {
                            "text": "The designer adjusted the <w>leading</w> to fit the text on the page.",
                            "target_lang_translations": {
                                "ru": "Дизайнер настроил <w>интерлиньяж</w>, чтобы текст поместился на странице.",
                                "zh": "设计师调整了<w>行距</w>，以便让文字适合页面版面。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вертикальный интервал между строками текста в типографике.",
                        "zh": "印刷或排版中，文字各行之间增加的垂直间距。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "интерлиньяж",
                                "target_lang_sense_clarification": "межстрочный интервал"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "行距",
                                "target_lang_sense_clarification": "排版中两行文字之间的垂直距离"
                            },
                            {
                                "target_lang_word": "字距行距",
                                "target_lang_sense_clarification": "排版术语，指字行之间的间隔"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b99eb88e-42f2-3d8c-ba4a-1f6da3e5f39f",
                    "sense_definition": "An act or instance of being guided or directed.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He followed the <w>leadings</w> of his conscience when making the decision.",
                            "target_lang_translations": {
                                "ru": "Принимая решение, он следовал <w>велениям</w> своей совести.",
                                "zh": "他在作决定时遵从了自己良心的<w>指引</w>。"
                            }
                        },
                        {
                            "text": "She trusted the spiritual <w>leadings</w> she felt during her meditation.",
                            "target_lang_translations": {
                                "ru": "Она доверяла духовному <w>руководству</w>, которое чувствовала во время медитации.",
                                "zh": "她相信自己在冥想时感受到的精神<w>指引</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие или случай руководства или направления.",
                        "zh": "被引导或被带领的行为或情况；也可指内心、精神上的引导。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "руководство",
                                "target_lang_sense_clarification": "направление действий"
                            },
                            {
                                "target_lang_word": "веление",
                                "target_lang_sense_clarification": "внутреннее побуждение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "指引",
                                "target_lang_sense_clarification": "引导或带领的行为；给予方向的影响"
                            },
                            {
                                "target_lang_word": "引导",
                                "target_lang_sense_clarification": "内心或精神上的引导、催促"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}