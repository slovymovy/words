                    "sense_id": "329651cc-886f-3caf-933b-e8206548f297",
                    "sense_definition": "To pass or move by, especially in reference to time.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "time_passage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He allowed a month to <w>elapse</w> before beginning the work.",
                            "target_lang_translations": {
                                "ru": "Он позволил целому месяцу <w>пройти</w>, прежде чем начать работу."
                            }
                        },
                        {
                            "text": "Several days <w>elapsed</w> before they met again.",
                            "target_lang_translations": {
                                "ru": "Несколько дней <w>прошло</w>, прежде чем они встретились снова."
                            }
                        }
                    ],
                    "synonyms": [
                        "pass",
                        "go by",
                        "roll on"
                    ],
                    "common_phrases": [
                        "time elapses"
                    ],
                    "target_lang_definitions": {
                        "ru": "Проходить, истекать (о времени)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пройти́",
                                "target_lang_sense_clarification": "основной глагол для обозначения того, что время прошло"
                            },
                            {
                                "target_lang_word": "исте́чь",
                                "target_lang_sense_clarification": "используется, когда речь идет об окончании срока действия чего-либо"
                            },
                            {
                                "target_lang_word": "минова́ть",
                                "target_lang_sense_clarification": "книжный вариант, подчеркивающий, что событие или период остались в прошлом"
                            }
                        ]
                    }
                }
            ]
        }
    ]
