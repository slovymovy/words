                                        "sense_id": "6e04afa4-e8e7-3078-937e-c3a9440e0d44",
                                        "entry_id": "0e064a06-1f39-3df9-9fda-dc17899df9ca",
                                        "glosses": [
                                            "Arrêt de nutrition d’un organe ou d’un tissu, qui se manifeste par la diminution de son volume ou de son poids."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e6ee4780-59e7-32b2-b497-a06b6073e9a9",
                                        "entry_id": "0e064a06-1f39-3df9-9fda-dc17899df9ca",
                                        "glosses": [
                                            "Diminution, rétrécissement, échec de croissance, d´une chose, d´une activité."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "453994b0-5f56-4e41-a229-8299870d650f",
                                                "sense_id": "e6ee4780-59e7-32b2-b497-a06b6073e9a9",
                                                "text": "atrophie d´un secteur économique, d´une industrie"
                                            },
                                            {
                                                "example_id": "3948b0a8-9229-4cbf-84df-ebca337db938",
                                                "sense_id": "e6ee4780-59e7-32b2-b497-a06b6073e9a9",
                                                "text": "atrophie d´un lac, d´un glacier"
                                            },
                                            {
                                                "example_id": "faec194a-8871-4477-899f-7d3928f57159",
                                                "sense_id": "e6ee4780-59e7-32b2-b497-a06b6073e9a9",
                                                "text": "Cette structure, installée sur l’eau, libère ainsi des terres dans des zones peuplées, réduit également l’évaporation, et profite de l’air plus frais à la surface de l’eau pour éviter un phénomène d’atrophie des performances des cellules solaires."
                                            }
                                        ]
