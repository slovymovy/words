                        "examples": [
                            {
                                "example_id": "aba908e4-23c3-48f8-a519-1abf61d6e429",
                                "sense_id": "ad6953e5-e175-3da0-ad73-cdd21aa79dc5",
                                "text": "Uiteindelijk is die hotelfunctie er niet van gekomen."
                            },
                            {
                                "example_id": "51f00e1a-efbd-45cb-9cf7-87747d132817",
                                "sense_id": "ad6953e5-e175-3da0-ad73-cdd21aa79dc5",
                                "text": "Het ziekenhuis in Den Helder gaf wel een reactie, maar wilde niet helpen. \"We kunnen als ziekenhuis geen hotelfunctie bekleden\", zei een woordvoerder daar vorige maand over. \"En het opnemen van patiënten zonder zorgvraag is ook niet passend.\""
                            },
                            {
                                "example_id": "99c425a5-ce92-4f0d-8cce-c84253167547",
                                "sense_id": "ad6953e5-e175-3da0-ad73-cdd21aa79dc5",
                                "text": "Hotel Van der Valk in Goes wordt een opvanglocatie voor asielzoekers. In het hotel aan de Deltaweg kunnen maximaal 450 mensen worden gehuisvest. Het gebouw verliest daarmee voor de komende jaren zijn traditionele hotelfunctie."
                            }
                        ]
                    }
