                            {
                                "example_id": "9a115088-e53a-4fac-a508-a1e77e0f1ba6",
                                "sense_id": "c1e90a18-f731-3203-9053-608fd78c8fe1",
                                "text": "Ich habe Kartoffelchips und Nüsschen zum Knabbern besorgt."
