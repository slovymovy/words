                "senses": [
                    {
                        "sense_id": "f6ab9010-e462-384c-9693-2fbf12b43a52",
                        "entry_id": "ab805b5b-f6aa-3d4b-8b9f-574b585cc80c",
                        "glosses": [
                            "jemand, der beruflich einen Lastwagen fährt; Fahrer eines Lastwagens"
                        ],
                        "tags": [
                            "Swiss Standard German",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "01f3e12b-2927-45ee-a7d4-c0bc613b1ded",
                                "sense_id": "f6ab9010-e462-384c-9693-2fbf12b43a52",
                                "text": "Der Lastwagenchauffeur holte sich die Frachtpapiere vom Disponenten."
                            },
                            {
                                "example_id": "b6e850c1-a3a1-4997-a3b3-c1bdea50c1b6",
                                "sense_id": "f6ab9010-e462-384c-9693-2fbf12b43a52",
                                "text": "„Ein paar Lastwagenchauffeure kamen hereingestolpert und riefen laut nach Kaffee und Doughnuts.“"
                            },
                            {
                                "example_id": "85b247da-e390-4de2-a10b-6d14ef65138f",
                                "sense_id": "f6ab9010-e462-384c-9693-2fbf12b43a52",
                                "text": "„Der Lastwagenchauffeur wurde mit schweren Verletzungen in ein Krankenhaus gefahren, hieß es vom ÖAMTC.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "484a41dc-195f-4724-b36f-eaa4ce3271ba",
                        "source_entry_id": "ab805b5b-f6aa-3d4b-8b9f-574b585cc80c",
                        "source_sense_id": "f6ab9010-e462-384c-9693-2fbf12b43a52",
                        "source_sense_description": "Fahrer eines Lastwagens",
                        "target_lang_word": "camionneur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "camionneur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dd42922e-79db-3b3e-8aac-13bc0b5047c7",
                                        "entry_id": "83e309b0-7844-38a1-8c43-6d9ac6180f87",
                                        "glosses": [
                                            "Celui qui conduit ou qui traîne un camion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c121304c-6200-4d4c-8022-f5fbef47c06a",
                                                "sense_id": "dd42922e-79db-3b3e-8aac-13bc0b5047c7",
                                                "text": "C’était donc au moment de la guerre avec la Prusse, il y a vingt-quatre ans… Et comme les Prussiens approchaient de Rouen, où nous habitions, mon pauvre mari, qui était camionneur, reçut la visite de deux messieurs… des messieurs que nous n’avions jamais vus."
                                            },
                                            {
                                                "example_id": "a4bb54eb-7522-4880-acf2-6b80c7c2906f",
                                                "sense_id": "dd42922e-79db-3b3e-8aac-13bc0b5047c7",
                                                "text": "Tous les trucs qu’il avait vu pratiquer, toutes les ficelles enregistrées au cours d’une expérience de camionneur déjà longue, des pistes pourries du llano vénézuélien aux pentes escarpées des Andes, il les passa en revue, et un par un les rejeta : ça ne collait pas."
                                            },
                                            {
                                                "example_id": "6a817a77-b19d-4de8-a7fa-99f507b46ec1",
                                                "sense_id": "dd42922e-79db-3b3e-8aac-13bc0b5047c7",
                                                "text": "À la fin du repas du soir, Julien annonça qu’ils avaient trouvé un camionneur qui les emmènerait à Lyon."
                                            },
                                            {
                                                "example_id": "7774899a-fe95-409f-8bc2-d2c71fef540e",
                                                "sense_id": "dd42922e-79db-3b3e-8aac-13bc0b5047c7",
                                                "text": "Au contraire, peu mais bien, les mots qui vont à l’âme, à l’os, au nerf, pour qu’à votre tour, camionneurs de chez Mory, ouvriers de chez Whirlpool, soignants du CHU, vous prononciez les mots qui vous rongent, qui pourrissent en vous, que vous les exprimiez, exprimer au sens littéral, qui vous les poussiez dehors, comme un poids, comme une douleur, comme une tumeur."
                                            }
                                        ]
                                    }
                                ]
                            },
