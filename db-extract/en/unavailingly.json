                        "glosses": [
                            "In an unavailing manner; without successful results; to no avail."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed925170-1aaa-4d69-baa2-5b5239a26adc",
                                "sense_id": "0ac11a53-875d-3c9f-a149-aef42de601af",
                                "text": "diplomatic efforts to secure his release continued through the good offices of the Turks and others, albeit unavailingly."
                            },
                            {
                                "example_id": "2e74745b-0867-4dad-a036-fe6a3465c267",
                                "sense_id": "0ac11a53-875d-3c9f-a149-aef42de601af",
                                "text": "The Shepperton guns spoke this time unavailingly."
                            },
                            {
