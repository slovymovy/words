    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f532ebcb-f9f2-362f-ae31-84634a8fa3b7",
                    "sense_definition": "Предикатив: можно увидеть, доступно для восприятия зрением.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "perception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Из нашего окна хорошо <w>видно</w> детскую площадку.",
                            "target_lang_translations": {
                                "en": "The playground is clearly <w>visible</w> from our window.",
                                "zh": "从我们的窗户可以清楚地<w>看见</w>游乐场。"
                            }
                        },
                        {
                            "text": "В густом тумане ничего не было <w>видно</w>.",
                            "target_lang_translations": {
                                "en": "Nothing was <w>visible</w> in the thick fog.",
                                "zh": "浓雾中什么也<w>看不见</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "заметно"
                    ],
                    "common_phrases": [
                        "хорошо видно",
                        "плохо видно",
                        "ничего не видно",
                        "отсюда видно"
                    ],
                    "target_lang_definitions": {
                        "en": "visible, can be seen",
                        "zh": "指肉眼可以看见，或处于视野范围内。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "visible",
                                "target_lang_sense_clarification": "perceptible by the eye"
                            },
                            {
                                "target_lang_word": "can be seen",
                                "target_lang_sense_clarification": "able to be viewed"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "看得见",
                                "target_lang_sense_clarification": "能够被看见"
                            },
                            {
                                "target_lang_word": "可见",
                                "target_lang_sense_clarification": "处于视野内"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "28996ccb-1c90-3b39-89ca-15b6dbf1dea8",
                    "sense_definition": "Предикатив: можно понять, становится ясно из обстоятельств.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "understanding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "По его счастливой улыбке <w>видно</w>, что он сдал экзамен.",
                            "target_lang_translations": {
                                "en": "It is <w>clear</w> from his happy smile that he passed the exam.",
                                "zh": "从他幸福的笑容里<w>看得出</w>他通过了考试。"
                            }
                        },
                        {
                            "text": "Из этого письма <w>видно</w>, что планы компании изменились.",
                            "target_lang_translations": {
                                "en": "It is <w>evident</w> from this letter that the company's plans have changed.",
                                "zh": "从这封信中<w>显然</w>可以看出公司的计划已经改变了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "понятно",
                        "очевидно",
                        "заметно"
                    ],
                    "common_phrases": [
                        "сразу видно",
                        "по глазам видно",
                        "по всему видно"
                    ],
                    "target_lang_definitions": {
                        "en": "clear, evident, obvious",
                        "zh": "指从某种迹象或事实中可以推断出结论，显而易见。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "clear",
                                "target_lang_sense_clarification": "easy to understand or perceive"
                            },
                            {
                                "target_lang_word": "evident",
                                "target_lang_sense_clarification": "plain or obvious"
                            },
                            {
                                "target_lang_word": "obvious",
                                "target_lang_sense_clarification": "easily perceived"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "看得出",
                                "target_lang_sense_clarification": "从迹象中推断"
                            },
                            {
                                "target_lang_word": "显然",
                                "target_lang_sense_clarification": "显而易见"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ea27cd3b-a3b1-3e76-9c9e-b4a346a3ec17",
                    "sense_definition": "Краткая форма среднего рода единственного числа прилагательного <w>видный</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Это старинное здание <w>видно</w> издалека благодаря высокой башне.",
                            "target_lang_translations": {
                                "en": "This old building is <w>visible</w> from afar thanks to the high tower.",
                                "zh": "多亏了那座高塔，这座古老的建筑从远处看很<w>显眼</w>。"
                            }
                        },
                        {
                            "text": "Его влияние на коллектив было <w>видно</w> в каждом решении.",
                            "target_lang_translations": {
                                "en": "His influence on the team was <w>visible</w> in every decision.",
                                "zh": "他在每一个决定中都<w>显眼</w>地体现了对团队的影响。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "neuter short form"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "visible",
                        "zh": "形容词“显眼的”的中性短尾形式，表示某物在空间上突出或易于察觉。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "visible",
                                "target_lang_sense_clarification": "adjective short form"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "显眼",
                                "target_lang_sense_clarification": "容易被看见"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "12e6c1fc-a2f3-334d-9c4d-84b13e4bd6d5",
                    "sense_definition": "Вводное слово, выражающее предположение; вероятно, по-видимому.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "probability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы, <w>видно</w>, уже не успеем на последний автобус.",
                            "target_lang_translations": {
                                "en": "<w>Apparently</w>, we won't make the last bus.",
                                "zh": "<w>看来</w>我们赶不上末班车了。"
                            }
                        },
                        {
                            "text": "Ты, <w>видно</w>, не совсем правильно понял мой вопрос.",
                            "target_lang_translations": {
                                "en": "You <w>evidently</w> didn't quite understand my question.",
                                "zh": "<w>看来</w>你没完全理解我的问题。"
                            }
                        }
                    ],
                    "synonyms": [
                        "очевидно",
                        "пожалуй",
                        "наверное",
                        "кажется"
                    ],
                    "common_phrases": [
                        "как видно"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "apparently, evidently, probably",
                        "zh": "表示推测，意为“看来”、“大概”。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "apparently",
                                "target_lang_sense_clarification": "based on what is known or seen"
                            },
                            {
                                "target_lang_word": "evidently",
                                "target_lang_sense_clarification": "clearly seen or understood"
                            },
                            {
                                "target_lang_word": "it looks like",
                                "target_lang_sense_clarification": "colloquial probability"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "看来",
                                "target_lang_sense_clarification": "表示推测"
                            },
                            {
                                "target_lang_word": "大概",
                                "target_lang_sense_clarification": "表示可能性"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}