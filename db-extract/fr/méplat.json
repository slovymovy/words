                    {
                        "sense_id": "01359d2e-9e85-387f-806c-2a69842daeb5",
                        "entry_id": "01009195-0f49-39cb-9d8e-a767f504e18b",
                        "glosses": [
                            "Qui a plus de largeur que d’épaisseur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2708ffc0-9802-4933-b3d2-135db7becc43",
                                "sense_id": "01359d2e-9e85-387f-806c-2a69842daeb5",
                                "text": "Planche méplate."
                            }
                        ]
                    },
                    {
                        "sense_id": "82041ceb-740b-3045-90a4-507c8d055a95",
                        "entry_id": "01009195-0f49-39cb-9d8e-a767f504e18b",
                        "glosses": [
                            "Qualifie une grume de section elliptique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e135ec60-a3f7-4264-a4f4-eb97fd74f343",
                                "sense_id": "82041ceb-740b-3045-90a4-507c8d055a95",
                                "text": "[L]es arbres méplats ou à coeur excentré produisent également des bois hétérogènes se déformant lors du séchage, sauf s’ils sont débités en pièces de faible largeur […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "8988a92d-fd74-3650-989d-368c27a7078b",
                        "entry_id": "01009195-0f49-39cb-9d8e-a767f504e18b",
                        "glosses": [
                            "Où l’épaisseur relative des premiers plans est atténuée."
                        ],
                        "tags": [
                            "Sculpture"
                        ],
                        "examples": [
                            {
                                "example_id": "9c289cf2-8253-40c2-98ae-08138b716676",
                                "sense_id": "8988a92d-fd74-3650-989d-368c27a7078b",
                                "text": "De très délicates sculptures, assez méplates pour se fondre dans l’ensemble, , mais assez fines et variées pour retenir l’attention quand on s’y appliquait, décorèrent les clefs de voûte et les écoinçons."
                            },
                            {
                                "example_id": "a92036dd-eed0-4ec2-bde7-5b86ab2e4732",
                                "sense_id": "8988a92d-fd74-3650-989d-368c27a7078b",
                                "text": "Bas-reliefs méplats."
                            }
                        ]
                    },
                    {
                        "sense_id": "b43204c5-ed23-357a-bc6e-56b02806a32c",
                        "entry_id": "01009195-0f49-39cb-9d8e-a767f504e18b",
                        "glosses": [
                            "Qui établit le passage d’un plan à un autre."
                        ],
                        "tags": [
                            "Peinture"
                        ],
                        "examples": [
                            {
                                "example_id": "7cf8a34a-5a6d-4cca-9f01-1860299b811b",
                                "sense_id": "b43204c5-ed23-357a-bc6e-56b02806a32c",
                                "text": "Lignes méplates."
                            }
                        ]
                    }
                ],
