                    {
                        "sense_id": "ce4578f6-d86f-3002-8cf6-0c0e6519c83f",
                        "entry_id": "a516ac95-d964-3eae-9965-50cf4b747577",
                        "glosses": [
                            "L’un des trois systèmes cabalistiques avec la gématrie et la notarique employé par les cabalistes pour déchiffrer la Torah, qui consiste à substituer les lettres d’un mot hébreu par d’autres selon diverses combinaisons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "538b768a-cc8b-4c54-b5cf-de95207702fa",
                                "sense_id": "ce4578f6-d86f-3002-8cf6-0c0e6519c83f",
                                "text": "La Cabale artificielle se divise encore elle-même en trois branches distinctes, qui sont la gématrie, le motaricon et la thémoura."
                            },
                            {
                                "example_id": "15fd30de-fc27-4f2f-9aef-f7188b3f1ee2",
                                "sense_id": "ce4578f6-d86f-3002-8cf6-0c0e6519c83f",
                                "text": "Les rabbins emploient aussi la cabale pour l’interprétation de l’Ecriture sainte; et sous ce rapport ils la divisent pareillement en trois parties; la gématrie, le notaricon et la thémoura."
                            }
                        ]
                    }
