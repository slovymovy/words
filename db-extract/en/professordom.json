                        "glosses": [
                            "The realm or sphere of professors; professors, collectively."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "50141e5b-1b4c-492e-8cee-243a3ee3e44d",
                                "sense_id": "dcd595a9-8b3d-39e5-a85b-572be81165c7",
                                "text": "He thinks that by nursing this gigantic reverence for the idea of professordom, such reverence will, somehow, be extended all over society, till the professor becomes a creature of power, of public notoriety, of independent reputation as he is in Germany."
                            },
                            {
                                "example_id": "85fa076f-7185-43da-a368-055553ad167c",
                                "sense_id": "dcd595a9-8b3d-39e5-a85b-572be81165c7",
                                "text": "Another, the fifth, year of professordom is expiring this week."
                            },
                            {
                                "example_id": "6443ad8f-8ce2-4cc2-9b39-ce44cfc49af1",
                                "sense_id": "dcd595a9-8b3d-39e5-a85b-572be81165c7",
                                "text": "For this reason, I would like to focus on a chink in the armour of professordom: on one of the facets of literary art to which academics pay insufficient attention."
                            }
                        ]
                    }
