                ],
                "senses": [
                    {
                        "sense_id": "0c78200d-74c1-3a2b-9e52-f60f7221cb70",
                        "entry_id": "27cd12f7-e485-3f90-bc91-aa3e931d9485",
                        "glosses": [
                            "auf Bundesebene tätige Behörde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f5ff5d7-4b29-42a8-85a9-0818b470648a",
                                "sense_id": "0c78200d-74c1-3a2b-9e52-f60f7221cb70",
                                "text": "„Kontrolliert wird die Einhaltung der Regelungen des Verbraucherschutzes u. a. durch das Bundesinstitut für Risikobewertung und das Bundesamt für Verbraucherschutz.“"
                            },
                            {
                                "example_id": "4a1e5f9b-ec4a-4759-8cab-9ce0ddffebb8",
                                "sense_id": "0c78200d-74c1-3a2b-9e52-f60f7221cb70",
                                "text": "„Damit Menschen nicht erst in der Notlage beginnen, ihre Habseligkeiten zu sortieren, empfiehlt das Bundesamt für Bevölkerungsschutz und Katastrophenhilfe (BBK), immer einen Notfallrucksack parat zu haben.“"
                            }
                        ],
