                        "translation_id": "4c90265e-c6f9-4cec-a4a7-cdc372b57790",
                        "source_entry_id": "0778a0f2-6a21-3bf9-8be0-c624ca163722",
                        "source_sense_id": "ac441045-14d9-337b-9ff4-15e1329e46af",
                        "target_lang_word": "gastrisch",
                        "target_lang_code": "de",
