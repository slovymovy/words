    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "363bfe21-5868-3fbf-89d5-53a265b351f5",
                    "sense_definition": "sztywny opatrunek unieruchamiający złamaną lub skręconą kończynę",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "medycyna",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Piotr złamał nogę podczas jazdy na nartach i musi nosić <w>gips</w> przez sześć tygodni.",
                            "target_lang_translations": {
                                "ru": "Петр сломал ногу во время катания на лыжах и должен носить <w>гипс</w> в течение шести недель."
                            }
                        },
                        {
                            "text": "Lekarz powiedział, że za tydzień zdejmie mi ten niewygodny <w>gips</w> z prawej ręki.",
                            "target_lang_translations": {
                                "ru": "Врач сказал, что через неделю снимет мне этот неудобный <w>гипс</w> с правой руки."
                            }
                        }
                    ],
                    "synonyms": [
                        "opatrunek gipsowy"
                    ],
                    "common_phrases": [
                        "ręka w gipsie",
                        "noga w gipsie",
                        "włożyć w gips",
                        "zdjąć gips"
                    ],
                    "target_lang_definitions": {
                        "ru": "жесткая медицинская повязка, фиксирующая сломанную или вывихнутую конечность"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гипс",
                                "target_lang_sense_clarification": "медицинская повязка"
                            },
                            {
                                "target_lang_word": "гипсовая повязка",
                                "target_lang_sense_clarification": "медицинская"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2fbe9eb7-d084-3e47-a242-998bb7ecc356",
                    "sense_definition": "biały proszek wiążący po zmieszaniu z wodą, stosowany jako spoiwo w budownictwie lub do tworzenia odlewów",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "budownictwo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Robotnicy użyli białego <w>gipsu</w>, aby wyrównać nierówności na powierzchni ściany.",
                            "target_lang_translations": {
                                "ru": "Рабочие использовали белый <w>гипс</w>, чтобы выровнять неровности на поверхности стены."
                            }
                        },
                        {
                            "text": "Kupiliśmy w sklepie budowlanym dwa duże worki <w>gipsu</w> do naprawy sufitu.",
                            "target_lang_translations": {
                                "ru": "Мы купили в строительном магазине два больших мешка <w>гипса</w> для ремонта потолка."
                            }
                        }
                    ],
                    "common_phrases": [
                        "worek gipsu",
                        "gips budowlany",
                        "gips szpachlowy"
                    ],
                    "target_lang_definitions": {
                        "ru": "белый порошок, затвердевающий при смешивании с водой, используемый в строительстве и для отливки форм"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гипс",
                                "target_lang_sense_clarification": "строительный материал или порошок"
                            },
                            {
                                "target_lang_word": "алебастр",
                                "target_lang_sense_clarification": "строительный гипс"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "be5f00c0-bdf2-3dae-9c0c-b941f74d0c9a",
                    "sense_definition": "minerał z grupy siarczanów, uwodniony siarczan wapnia, będący również pospolitą skałą osadową",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "geologia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W tej części kopalni występują naturalne złoża <w>gipsu</w> oraz innych cennych minerałów.",
                            "target_lang_translations": {
                                "ru": "В этой части шахты находятся природные месторождения <w>гипса</w> и других ценных минералов."
                            }
                        },
                        {
                            "text": "Geolodzy badają kryształy czystego <w>gipsu</w> znalezione w jaskiniach na południu kraju.",
                            "target_lang_translations": {
                                "ru": "Геологи исследуют кристаллы чистого <w>гипса</w>, найденные в пещерах на юге страны."
                            }
                        }
                    ],
                    "common_phrases": [
                        "złoża gipsu",
                        "kryształy gipsu"
                    ],
                    "target_lang_definitions": {
                        "ru": "минерал из класса сульфатов, водный сульфат кальция, а также осадочная горная порода"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гипс",
                                "target_lang_sense_clarification": "минерал или горная порода"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b85c54a7-f26a-39ab-afd8-431797a31310",
                    "sense_definition": "odlew rzeźbiarski, ozdoba lub figura wykonana z gipsu",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sztuka",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W pracowni artystycznej stały liczne zabytkowe <w>gipsy</w> przedstawiające postacie mitologiczne.",
                            "target_lang_translations": {
                                "ru": "В художественной мастерской стояли многочисленные старинные <w>гипсы</w>, изображающие мифологических персонажей."
                            }
                        },
                        {
                            "text": "Konserwator ostrożnie oczyścił stary <w>gips</w> z kurzu i zabezpieczył go przed wilgocią.",
                            "target_lang_translations": {
                                "ru": "Реставратор осторожно очистил старый <w>гипсовый слепок</w> от пыли и защитил его от влаги."
                            }
                        }
                    ],
                    "synonyms": [
                        "odlew"
                    ],
                    "common_phrases": [
                        "kolekcja gipsów"
                    ],
                    "target_lang_definitions": {
                        "ru": "скульптурный слепок, фигура или украшение, отлитые из гипса"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гипс",
                                "target_lang_sense_clarification": "гипсовый слепок или фигура"
                            },
                            {
                                "target_lang_word": "гипсовый слепок",
                                "target_lang_sense_clarification": "скульптурное изделие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5f67174d-476c-36d2-9709-18e185950ae5",
                    "sense_definition": "trudne, nieprzyjemne lub beznadziejne położenie życiowe",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jeśli nie oddamy tego projektu do jutra, znajdziemy się w prawdziwym <w>gipsie</w>.",
                            "target_lang_translations": {
                                "ru": "Если мы не сдадим этот проект до завтра, то окажемся в настоящем <w>переплёте</w>."
                            }
                        },
                        {
                            "text": "Nie mam pojęcia, jak zamierzasz wykaraskać się z takiego <w>gipsu</w> bez pomocy rodziny.",
                            "target_lang_translations": {
                                "ru": "Понятия не имею, как ты собираешься выпутаться из такой <w>передряги</w> без помощи семьи."
                            }
                        }
                    ],
                    "synonyms": [
                        "kabała",
                        "tarapaty"
                    ],
                    "common_phrases": [
                        "być w gipsie"
                    ],
                    "traits": [
