                "translations": [
                    {
                        "translation_id": "8b5649dc-c102-4198-9d10-4e18683e51e4",
                        "source_entry_id": "28920390-7ce6-3b9d-99fd-c40b2857bea1",
                        "source_sense_id": "3701aa29-c3b8-3068-bc59-e79466332127",
                        "target_lang_word": "Blümchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Blümchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "859fb98e-c396-3890-b9a4-292793b2851b",
                                        "entry_id": "79c255f4-f8cf-3ba2-b1a7-ce43f42eb1db",
                                        "glosses": [
                                            "kleine Blume"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "850dc189-8118-47c3-9d62-99dd56c09e57",
                                                "sense_id": "859fb98e-c396-3890-b9a4-292793b2851b",
                                                "text": "„Zum Garten ging ich früh hinaus, / Ob ich vielleicht ein Sträußchen finde? / Nach manchem Blümchen schaut ich aus, / Ich wollt's für dich zum Angebinde; / Umsonst hatt ich mich hinbemüht, / Vergebens war mein freudig Hoffen; / Das Veilchen war schon abgeblüht, / Von andern Blümchen keines offen.“"
                                            },
                                            {
                                                "example_id": "d97f87f3-f496-4309-bac2-af7621f67182",
                                                "sense_id": "859fb98e-c396-3890-b9a4-292793b2851b",
                                                "text": "„Das Kleid war in London gekauft worden, und es war mit blauen Blümchen und Sternchen bestickt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Blümchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "21e69f67-ffc3-3fcf-a000-d71e24bb649d",
                                        "entry_id": "a1302124-09c9-3863-8a5f-8d4867995bdb",
                                        "glosses": [
                                            "deutscher Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fce12fcf-00ed-4e17-95af-0ae223cf9dda",
                                                "sense_id": "21e69f67-ffc3-3fcf-a000-d71e24bb649d",
                                                "text": "Frau Blümchen ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "b88448b7-f0cb-4236-8ebc-2d6cfe50ef4c",
                                                "sense_id": "21e69f67-ffc3-3fcf-a000-d71e24bb649d",
                                                "text": "Herr Blümchen wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "cc05c9a0-0e01-4920-96fb-493b7669ad44",
                                                "sense_id": "21e69f67-ffc3-3fcf-a000-d71e24bb649d",
                                                "text": "Die Blümchens fliegen heute nach La Paz."
                                            },
                                            {
                                                "example_id": "f967141a-fa67-450c-b45d-6b29457dbca1",
                                                "sense_id": "21e69f67-ffc3-3fcf-a000-d71e24bb649d",
                                                "text": "Der Blümchen trägt nie die Schals, die die Blümchen ihm strickt."
                                            },
                                            {
                                                "example_id": "55d0f531-2d2e-443b-bbb1-bfdfad41b262",
                                                "sense_id": "21e69f67-ffc3-3fcf-a000-d71e24bb649d",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Blümchen kommt, geht der Herr Blümchen.“"
                                            },
                                            {
                                                "example_id": "c8818b64-9c33-46c5-bf63-c7672fc6a474",
                                                "sense_id": "21e69f67-ffc3-3fcf-a000-d71e24bb649d",
                                                "text": "Blümchen kommt und geht."
                                            },
                                            {
                                                "example_id": "8519a73d-86cb-4e88-b92f-55d04bdebfcd",
                                                "sense_id": "21e69f67-ffc3-3fcf-a000-d71e24bb649d",
                                                "text": "Blümchens kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
