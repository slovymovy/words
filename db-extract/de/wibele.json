                "senses": [
                    {
                        "sense_id": "57967394-5005-376c-8174-ca24f1b83eb6",
                        "entry_id": "63b89ec2-0181-3b25-9876-ce8a42dc9354",
                        "glosses": [
                            "süßes Gebäck aus Biskuitmasse, in Form einer Schuhsohle"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4904ad7f-be2e-45b1-bebc-b4e82b31e4ca",
                                "sense_id": "57967394-5005-376c-8174-ca24f1b83eb6",
                                "text": "„Wibele auf ein Backblech geben und im Ofen bei 60 Grad Umluft 10 Minuten erwärmen.“"
                            },
                            {
                                "example_id": "108f7a5f-a606-490d-9c11-1ae238df3af8",
                                "sense_id": "57967394-5005-376c-8174-ca24f1b83eb6",
                                "text": "„Als Kinder haben wir die Wibele immer für unseren Kaufladen bekommen.“"
                            },
                            {
                                "example_id": "4c3ac36a-8a28-48de-bd00-5b5e1a645a70",
                                "sense_id": "57967394-5005-376c-8174-ca24f1b83eb6",
                                "text": "„Typisch Hohenlohisch – das sind Wibele.“"
                            },
                            {
                                "example_id": "e3945ffe-5ea1-49db-9f0f-2a77d8ef8129",
                                "sense_id": "57967394-5005-376c-8174-ca24f1b83eb6",
                                "text": "„Unter anderem besuchte er auch ein Café, in dem das ortstypische Hart-gebäck „Wibele“ hergestellt wird.“"
                            },
                            {
                                "example_id": "1fb01142-cb6b-4854-98ef-421cfd11ce4f",
                                "sense_id": "57967394-5005-376c-8174-ca24f1b83eb6",
                                "text": "„Als Ihre Majestät die Queen 1965 auf Staatsbesuch in Langenburg Station machte, überreichte er „hör mädschesdi“ stolz eine Packung Wibele.“"
                            }
                        ],
