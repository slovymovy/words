                },
                {
                    "sense_id": "a49469a8-81b6-3a8e-8719-a0e0b5b0ea4a",
                    "sense_definition": "The point in the interior of a circle or sphere that is equidistant from all points on the circumference.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
