                        ],
                        "examples": [
                            {
                                "example_id": "04852882-5756-4dbf-ae00-5266db7860b7",
                                "sense_id": "d54af3cd-7814-35b4-993f-778f89a06f15",
                                "text": "I remember living through the sixties."
                            },
                            {
                                "example_id": "e4adf96e-7e82-4dec-b0a8-53382236c1c7",
                                "sense_id": "d54af3cd-7814-35b4-993f-778f89a06f15",
                                "text": "During the sixties [1860s] the Sabbatarians were particularly active in their attacks on Sunday excursions, and this had an effect both on the companies and the public."
                            }
                        ]
                    },
                    {
                        "sense_id": "08d40856-ec42-3287-9519-18de45937009",
                        "entry_id": "458b42c5-72a9-3a2f-b9b9-85d7047df619",
                        "glosses": [
                            "The decade of one's life from age 60 through age 69."
                        ],
                        "tags": [
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "735bfb00-ed44-4fe1-a351-ff64ff629249",
                                "sense_id": "08d40856-ec42-3287-9519-18de45937009",
                                "text": "She retired at some point in her sixties, I don't recall exactly when."
                            }
                        ]
                    },
                    {
                        "sense_id": "1955e9ed-a5bb-33c5-94e6-eeaa6c72211a",
                        "entry_id": "458b42c5-72a9-3a2f-b9b9-85d7047df619",
                        "glosses": [
                            "The range between 60 and 69 Fahrenheit."
                        ],
                        "tags": [
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "0159e49d-6748-4db1-8a03-7ce5bc91646c",
                                "sense_id": "1955e9ed-a5bb-33c5-94e6-eeaa6c72211a",
                                "text": "Highs in the mid sixties."
                            }
                        ]
                    }
                ],
