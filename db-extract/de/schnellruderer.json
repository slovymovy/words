                        "tags": [],
                        "examples": [
                            {
                                "example_id": "400994cf-4db5-480e-ae88-c6d5d100cbea",
                                "sense_id": "9ea7fe5c-1098-32b8-a108-41642ca22224",
                                "text": "„Ein Schnellruderer bringt ihn zur Flotte der Königin.“"
                            },
                            {
                                "example_id": "4426d663-0090-4ae2-a734-a032f1415dc3",
                                "sense_id": "9ea7fe5c-1098-32b8-a108-41642ca22224",
                                "text": "„Jetzt war kein einziger Schnellruderer mehr irgendwo im Mündungsgebiet zu sehen.“"
                            },
                            {
                                "example_id": "31550647-79e9-4fde-8460-5dfa28ea15c6",
                                "sense_id": "9ea7fe5c-1098-32b8-a108-41642ca22224",
                                "text": "„Es war Mitte des Sommers (Anfang Juli), und die 100 attischen Trieren, nämlich 60 Schnellruderer und 40 Soldatenschiffe, lagen segelfertig da; sollte noch in diesem Jahre etwas geschehen, so durfte nicht gesäumt werden.“"
                            }
                        ],
