                    {
                        "sense_id": "693ccebe-ea8a-3cad-bad3-391799475755",
                        "entry_id": "dc750b20-4bd6-3e5d-b3da-5e23bf6f0023",
                        "glosses": [
                            "een kolom van rook"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b040fae1-f21d-4c60-b374-083d2a13eb1b",
                                "sense_id": "693ccebe-ea8a-3cad-bad3-391799475755",
                                "text": "De brand was te ver weg om te kunnen zien of er iets aan gedaan werd. Omdat hij niet merkbaar bewoog, zag de rookzuil er tamelijk onschuldig uit."
                            },
                            {
                                "example_id": "1246a71a-589e-4c8e-81cd-338522170292",
                                "sense_id": "693ccebe-ea8a-3cad-bad3-391799475755",
                                "text": "De vulkaan La Soufrière op het Caribische eiland Saint Vincent is uitgebarsten. Vervolgens steeg er een zes tot acht kilometer hoge rookzuil op uit de krater. De hulpdiensten op het eiland houden rekening met asregens."
                            }
                        ]
