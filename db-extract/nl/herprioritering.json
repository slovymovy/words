                        "glosses": [
                            "het opnieuw vaststellen wat de belangrijkste zaken zijn die het eerste gedaan moeten worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "324679f8-f90c-4a83-891b-b06cd9ffa08a",
                                "sense_id": "2cd2864a-bbfa-3abf-8452-e8c4c9f61099",
                                "text": "'Nederland en veel andere Europese landen moeten ingrijpende maatregelen nemen. Dan is het niet uit te leggen, en wil ik niet uitleggen, dat in Europa het budget verder zou stijgen', aldus Dijsselbloem. De Europese Commissie zal als het aan Nederland ligt, opnieuw moeten kijken naar de besteding van het geld. 'Herprioritering' noemde Dijsselbloem dit."
                            },
                            {
                                "example_id": "cc0e3022-c7d9-4934-ba5d-833d890dd16b",
                                "sense_id": "2cd2864a-bbfa-3abf-8452-e8c4c9f61099",
                                "text": "Nederland wil niet opdraaien voor de 12 tot 15 miljard inkomsten die Europa straks verliest door de brexit. Dat verlies moet primair worden opgevangen door een ‘herprioritering’ en door het mes te zetten in belangrijke uitgavenposten als de landbouwsubsidies en steun aan zwakkere economieën."
                            }
                        ]
                    }
