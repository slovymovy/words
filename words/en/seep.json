                        "tr": "Sıvıların küçük açıklıklardan veya gözeneklerden yavaşça geçmesi, sızması.",
                        "ru": "Медленное прохождение жидкости через небольшие отверстия или поры.",
                        "cs": "Pomalu procházet malými otvory nebo póry (o kapalinách)."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "sızmak",
                                "target_lang_sense_clarification": "sıvının yavaşça bir yerden geçmesi"
                            },
                            {
                                "target_lang_word": "süzülmek",
                                "target_lang_sense_clarification": "damla damla sızarak akmak"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "просачиваться",
                                "target_lang_sense_clarification": "постепенно проникать сквозь что-либо"
                            },
                            {
                                "target_lang_word": "сочиться",
                                "target_lang_sense_clarification": "вытекать по капле или тонкой струйкой"
                            }
