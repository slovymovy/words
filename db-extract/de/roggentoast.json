                        "glosses": [
                            "geröstetes Roggenbrot"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe2cea85-073b-4ae9-963c-42ec9c2ed369",
                                "sense_id": "50b3a2c4-4568-3dc1-871a-fbf79322c4ab",
                                "text": "„Zwischen Bissen seines gebutterten Roggentoasts unterstrich er die Lektüre der Nachrichten in der Regel mit Ausrufen wie »Lügen! Schwachköpfe! Unfug!« und einer gelegentlichen rhetorischen Frage: »Wer gibt diesen Idioten eigentlich Arbeit?« und »Warum die Tinte verschwenden?«“"
                            },
                            {
                                "example_id": "c990d74a-0faf-4d04-bf16-84651681f49d",
                                "sense_id": "50b3a2c4-4568-3dc1-871a-fbf79322c4ab",
                                "text": "„Ein Katerfrühstück bestand aus schwarzem Kaffee, Orangensaft und Roggentoast.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
