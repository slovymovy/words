                "senses": [
                    {
                        "sense_id": "e1510225-2f77-355a-8717-7fd11f8a3c1e",
                        "entry_id": "7885c235-7cc4-3585-81eb-67193fe3b837",
                        "glosses": [
                            "de zijde van een ruimtelijk figuur dat naar boven wijst, hier tegenover ligt de onderkant die naar beneden wijst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b9d2232-e135-4664-8a23-4ce952a31907",
                                "sense_id": "e1510225-2f77-355a-8717-7fd11f8a3c1e",
                                "text": "Hierna lieten de duim en wijsvinger van haar rechterhand de bovenkant van haar pyjama flink wapperen."
                            }
                        ]
                    },
                    {
                        "sense_id": "bb8b2d88-4dac-33d9-988c-8a692b1664f8",
                        "entry_id": "7885c235-7cc4-3585-81eb-67193fe3b837",
                        "glosses": [
                            "het rijkste, hoogste, beste, snelste deel van een geheel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef32e209-3ff7-4c22-b3b8-31e9821f5b97",
                                "sense_id": "bb8b2d88-4dac-33d9-988c-8a692b1664f8",
                                "text": "Onder de toenmalige nieuwe baas maakten we de strategische keuze ons meer op de bovenkant van de markt te richten. De mensen die hier weg gingen, waren hard nodig in New York, waar de prijzen voor naoorlogse beeldende kunst omhoog schoten. Inmiddels is duidelijk dat de internationale middenmarkt voor het bedrijf onontbeerlijk is.”"
                            }
                        ]
                    }
