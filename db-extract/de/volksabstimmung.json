                "senses": [
                    {
                        "sense_id": "91f3d89d-ee56-3544-85f3-9c70eb8d9192",
                        "entry_id": "32dc6a64-d78a-3c53-8bc3-0ea87e105bc5",
                        "glosses": [
                            "referendum (direct vote on a proposed law or other political decision)"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "f3472ef3-58ea-4967-bd26-05a0f3eaeed1",
                                "sense_id": "91f3d89d-ee56-3544-85f3-9c70eb8d9192",
                                "text": "Euro oder Krone. Volksabstimmung in Dänemark. Die dänischen Wähler entscheiden am Donnerstag, ob der Euro in dem Königreich eingeführt oder an der bisherigen Währung, der Krone, festgehalten wird."
                            },
                            {
                                "example_id": "1b76b00f-7d90-4b1d-97bc-1f24b4255d5c",
                                "sense_id": "91f3d89d-ee56-3544-85f3-9c70eb8d9192",
                                "text": "Am 12. Juni 1994 fand eine Volksabstimmung in Österreich über den Beitritt des Landes zur Europäischen Union statt. 66,6 % der Abstimmenden befürworteten den geplanten EU-Beitritt. Die Wahlbeteiligung betrug 82,3 %."
                            }
                        ]
                    }
