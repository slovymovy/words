                    }
                ],
                "senses": [
                    {
                        "sense_id": "b59e10d6-2d25-3e18-861e-3f2f1fe5f8d3",
                        "entry_id": "6c6ab395-61a8-3cba-b4c7-2afa45b95513",
                        "glosses": [
                            "Démêler."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f6c18e1-f718-4e6f-8bdf-c46f7ec5feac",
                                "sense_id": "b59e10d6-2d25-3e18-861e-3f2f1fe5f8d3",
                                "text": "Ces petites choses vous serviront au moins d’extriquer des douteuses, en même tems vous pouvez être assuré de la realité des differentes espèces. (orthographe d’origine)"
                            },
                            {
                                "example_id": "66cc4df3-60bb-4507-9188-869444455c79",
                                "sense_id": "b59e10d6-2d25-3e18-861e-3f2f1fe5f8d3",
                                "text": "Décidément, cette histoire est inextricable, et pour l’extriquer, va falloir fourbir mes méninges."
                            },
                            {
                                "example_id": "59ac798c-8923-47b6-8a6f-6d094b8cbac6",
                                "sense_id": "b59e10d6-2d25-3e18-861e-3f2f1fe5f8d3",
                                "text": "Encore une fois le droit des étrangers ne peut s’extriquer de la logique souverainiste qui l’irrigue et place les étrangers en situation de dépendance au bon vouloir de l'Administration en ce qui concerne l’application de leurs droits."
                            },
                            {
                                "example_id": "bb614132-afd9-48b3-9641-fa09308f95ca",
                                "sense_id": "b59e10d6-2d25-3e18-861e-3f2f1fe5f8d3",
                                "text": "J’ai tenté, maladroitement à cause de mes ennuis, de m’en extriquer, mais je n’y suis pas parvenu."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "110f8fff-0b9b-4279-bd3a-1b7eac1b89be",
                        "source_entry_id": "6c6ab395-61a8-3cba-b4c7-2afa45b95513",
                        "source_sense_id": "b59e10d6-2d25-3e18-861e-3f2f1fe5f8d3",
