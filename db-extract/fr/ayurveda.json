                    {
                        "sense_id": "0cd6877c-1e42-399c-a9de-3f38a5ec231a",
                        "entry_id": "3366335e-bf30-31dc-a942-969b698f529c",
                        "glosses": [
                            "Médecine traditionnelle hindoue."
                        ],
                        "tags": [
                            "Médecine non conventionnelle"
                        ],
                        "examples": [
                            {
                                "example_id": "2734ff6d-741b-4a6f-a5bb-ff1880e176e0",
                                "sense_id": "0cd6877c-1e42-399c-a9de-3f38a5ec231a",
                                "text": "L’ayurvéda puise ses sources dans le Véda, ensemble de textes sacrés de l’Inde antique et ses principes sont ceux de ce qu’on appelle aujourd’hui la « médecine naturelle »."
                            },
                            {
                                "example_id": "891f3d3a-c8ff-460d-b85b-ee3e5b8721cd",
                                "sense_id": "0cd6877c-1e42-399c-a9de-3f38a5ec231a",
                                "text": "L’ayurveda, la médecine traditionnelle indienne, transmise à la fois par voie orale et textuelle, consacre en partie l’un de ses piliers, le Salakya tantra, aux opérations de l’œil."
                            }
                        ]
                    }
