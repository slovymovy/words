                ],
                "translations": [
                    {
                        "translation_id": "bbf16731-c482-4fda-b2bb-b08dc38eb8f0",
                        "source_entry_id": "29f407c5-7120-3d6b-ba59-c8771678c09f",
                        "source_sense_id": "43d830b3-1535-3ae6-bed8-03e2ae87f19c",
                        "target_lang_word": "mehrdimensional",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mehrdimensional",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9238280f-bfac-3edf-bdc2-95bca8f6a0c1",
                                        "entry_id": "5e845635-fdc1-3103-8b66-2a242c205b04",
                                        "glosses": [
                                            "mehr als eine Dimension besitzend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c75cd65-0bed-4813-8e8e-927d72e7d8c7",
                                                "sense_id": "9238280f-bfac-3edf-bdc2-95bca8f6a0c1",
                                                "text": "Die Problematik ist durchaus als mehrdimensional zu bezeichnen."
                                            },
                                            {
                                                "example_id": "8223cef5-41d3-421f-b600-21071a119b63",
                                                "sense_id": "9238280f-bfac-3edf-bdc2-95bca8f6a0c1",
                                                "text": "„Ein von diesen drei Größen abhängiges Zufallsexperiment wird durch eine mehrdimensionale Zufallsvariable X = (X1, X3, X3)“ beschrieben, die auch als Zufallsvektor angesehen wird.“"
                                            },
                                            {
                                                "example_id": "049e5f0b-c86e-40ab-a63a-8216cbadfe00",
                                                "sense_id": "9238280f-bfac-3edf-bdc2-95bca8f6a0c1",
                                                "text": "„So etwas wie Persönlichkeitsentwicklung in Kitas, Schulen oder Hochschulen findet eher als Rhetorik statt denn als praktische Umsetzung. Aber das muss anders werden, findet der Aktionsrat Bildung in seinem aktuellen Gutachten und fordert mehrdimensionale Bildung, also nicht nur Fachkompetenzen, sondern zum Beispiel auch musische, politische oder interkulturelle Kompetenzen – und eben Persönlichkeitsentwicklung.“"
                                            },
                                            {
                                                "example_id": "7774ec71-8831-4a76-94a5-09e923678b37",
                                                "sense_id": "9238280f-bfac-3edf-bdc2-95bca8f6a0c1",
                                                "text": "„In Bezug auf die Folgen familiärer Einkommensarmut für betroffene Kinder hat sich in der Kinderarmutsforschung die Auffassung durchgesetzt, dass mehrdimensionale Konzepte nötig sind, um die vielfältigen Erscheinungsformen von Armut bei Minderjährigen auch in ihren immateriellen Dimensionen zu beschreiben.“"
                                            },
                                            {
                                                "example_id": "931cf854-ade1-427a-8e70-bcfcfbbffa4e",
                                                "sense_id": "9238280f-bfac-3edf-bdc2-95bca8f6a0c1",
                                                "text": "„Die Merkmale des Gegenstands Sport und die Möglichkeiten seines Erziehungsfeldes drängen nach einer mehrdimensionalen Behandlung, die […] nur in einer interdisziplinären Kooperation der zuständigen Fachleute geleistet werden kann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9fcfc57f-2a27-4a21-bb0f-7d2412e2d2f3",
                        "source_entry_id": "29f407c5-7120-3d6b-ba59-c8771678c09f",
                        "source_sense_id": "43d830b3-1535-3ae6-bed8-03e2ae87f19c",
