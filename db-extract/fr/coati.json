                    },
                    {
                        "translation_id": "0c6c010c-f69f-44d0-9ef1-bd9e1a1f3368",
                        "source_entry_id": "ced1fca0-8e5a-3785-9780-1514c1f95863",
                        "source_sense_id": "9718088e-1077-3516-99fe-c06b5f8b0d74",
                        "source_sense_description": "Mammifère",
                        "target_lang_word": "coati",
                        "target_lang_code": "en",
