                        "glosses": [
                            "Having five lobes or having the shape of a cinquefoil."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "29db25ab-4300-4c95-8894-6edbc1dbd73a",
                                "sense_id": "dd0254f0-d7d8-3eb7-9d80-56db624208ab",
                                "text": "The nave has, on the north side, one single trefoiled window, and another of two lights cinquefoiled. The south side has a window of two lights cinquefoiled, and another of two lights trefoiled."
                            },
                            {
                                "example_id": "2ce26c3a-3ab5-4462-bf10-746ae56e37b2",
                                "sense_id": "dd0254f0-d7d8-3eb7-9d80-56db624208ab",
                                "text": "Edingthorpe, Norfolk. — A window with two ogee-headed lights, both cinquefoiled, supporting a centrepiece pointed above and ogee below. In it is inscribed a quatrefoil with double foliation."
                            },
                            {
                                "example_id": "d0ab16d2-ecbe-4912-a171-c23fcfc62433",
                                "sense_id": "dd0254f0-d7d8-3eb7-9d80-56db624208ab",
                                "text": "The E. wall is continued to form the end wall of the N. range and contains the E. window of the old Chapel under a gable flanked, on the N., by a square turret with stone quoins and one and two-light windows with cinquefoiled openings ..."
                            }
                        ]
