                "translations": [
                    {
                        "translation_id": "e114e476-811b-4475-8815-89ff05194397",
                        "source_entry_id": "1a339671-ce25-30c5-9cf3-4c48a3ba99ff",
                        "source_sense_id": "99d3910d-cdbd-37d0-adcd-ec971a3248d6",
                        "source_sense_description": "umgangssprachlich: Feier mit Alkoholkonsum: Sause, Saufgelage",
                        "target_lang_word": "Sause",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sause",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8f6081c9-7007-3f82-b7cc-6ddb5e21c148",
                                        "entry_id": "caddcf0e-04b8-3b74-a518-ed5cb65e8796",
                                        "glosses": [
                                            "eine (ausgelassene) Feier"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2e0b722-7ae1-490e-a1ca-a16a718ba943",
                                                "sense_id": "8f6081c9-7007-3f82-b7cc-6ddb5e21c148",
                                                "text": "\"Die alljährliche Mallorca-Sause mit Freunden weicht Fasten und Wanderurlaub mit Gleichgesinnten auf Rügen.\""
                                            },
                                            {
                                                "example_id": "54791745-7618-428c-947b-f7550438eb04",
                                                "sense_id": "8f6081c9-7007-3f82-b7cc-6ddb5e21c148",
                                                "text": "\"Es war eine Sause von geradezu spätrömischer Dekadenz.\""
                                            },
                                            {
                                                "example_id": "ee0cec98-bf8b-43a2-a873-9699298ed902",
                                                "sense_id": "8f6081c9-7007-3f82-b7cc-6ddb5e21c148",
                                                "text": "„Wir bekamen vierundzwanzig Stunden frei mit ein paar Dollars in der Tasche, und als die Sause vorbei war, kehrten alle Männer zurück, und wir gingen an Bord einer Schaluppe nach Albany.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f55ac3be-4a8b-4110-a598-34c415d1a7af",
                        "source_entry_id": "1a339671-ce25-30c5-9cf3-4c48a3ba99ff",
                        "source_sense_id": "99d3910d-cdbd-37d0-adcd-ec971a3248d6",
                        "source_sense_description": "umgangssprachlich: Feier mit Alkoholkonsum: Sause, Saufgelage",
                        "target_lang_word": "Saufgelage",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Saufgelage",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "81475a7f-0b92-3f66-9bea-9ab2acc5961d",
                                        "entry_id": "14e5c13d-8bf1-33f1-a035-9489df34f824",
                                        "glosses": [
                                            "Veranstaltung oder Zusammenkunft, bei der exzessiv Alkohol konsumiert wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d28a7d9-92da-4e81-a017-9db1b802db29",
                                                "sense_id": "81475a7f-0b92-3f66-9bea-9ab2acc5961d",
                                                "text": "„Das Mittsommerfest soll eigentlich ein Tag der Familie sein. Doch von Jahr zu Jahr häufen sich Saufgelage und Gewalttaten.“"
                                            },
                                            {
                                                "example_id": "f37d609f-3e4c-46bf-a4b7-146e32ae236d",
                                                "sense_id": "81475a7f-0b92-3f66-9bea-9ab2acc5961d",
                                                "text": "„Wir beide, Staszek und ich, hatten eine Leidenschaft: dann und wann ein seliges Freß- und Saufgelage zu feiern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
