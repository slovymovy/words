                        "glosses": [
                            "militair op een oorlogsschip"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd9f16cd-c237-4d24-8cf2-2eb7f06ff210",
                                "sense_id": "178a3c41-7929-3495-a554-7383e29be8fd",
                                "text": "De gepensioneerde marineman sprak zeer vrijmoedig; dat bleek duidelijk uit de uitdrukking op de gezichten van de luisteraars en uit het feit dat bepaalde heren, die Pierre kende als zeer volgzame en stille mannen, zich afkeurend afwendden of hem tegenspraken."
                            },
                            {
                                "example_id": "859699ee-dcb5-4dfc-a793-88c1aeb44cb6",
                                "sense_id": "178a3c41-7929-3495-a554-7383e29be8fd",
                                "text": "Johan Schram (1918-1993) was als marineman in 1939 naar de Oost uitgezonden. Wat een diensttijd van 3 jaar had moeten zijn, eindigde door de invallen in Nederland en later Nederlands-Indië in een jarenlange krijgsgevangenschap. In Nagasaki werd Johan kok voor buitenlandse dwangarbeiders op een scheepswerf."
                            }
                        ]
                    }
