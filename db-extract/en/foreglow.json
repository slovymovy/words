    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "a2a06fe9-0228-340e-ab59-782db28d2e99",
                "word": "foreglow",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "4088a575-4315-4546-9f93-384a39a09c1f",
                        "entry_id": "a2a06fe9-0228-340e-ab59-782db28d2e99",
                        "tags": [
                            "plural"
                        ],
                        "form": "foreglows"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "34881ef0-27fd-3b38-98d8-33e64910fdf6",
                        "entry_id": "a2a06fe9-0228-340e-ab59-782db28d2e99",
                        "glosses": [
                            "The glow of light appearing in the sky preceding sunrise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1741ca6-f594-4862-bd6f-80280dedbaa5",
                                "sense_id": "34881ef0-27fd-3b38-98d8-33e64910fdf6",
                                "text": "He promised fair things and, when another morning came, set forth in the first rosy foreglow of dawn through a dew-soaked world to his new work."
                            },
                            {
                                "example_id": "53fb2c6c-5042-4408-aeeb-294f0bfd6987",
                                "sense_id": "34881ef0-27fd-3b38-98d8-33e64910fdf6",
                                "text": "But glorious, and educating, and inspiring as is the sunrise in itself in many cases, there is occasionally something very remarkable that is connected with it. Rare is it, but how charming when, witnessed, though till very' recently it was all but unexplained. This is the foreglow. It is in no respects so splendid as the afterglows succeeding sunset; but because of its rarity, its beauty is enhanced."
                            },
                            {
                                "example_id": "c9ccaf44-8ae8-4c70-b33b-d7c755dcc52d",
                                "sense_id": "34881ef0-27fd-3b38-98d8-33e64910fdf6",
                                "text": "Little attention has been paid to foreglows compared with afterglows, either with regard to their natural beauty or their weather forecasting."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9edfccd6-8463-4a61-86e8-154ca5d228e5",
                        "source_entry_id": "a2a06fe9-0228-340e-ab59-782db28d2e99",
                        "source_sense_id": "34881ef0-27fd-3b38-98d8-33e64910fdf6",
                        "source_sense_description": "The glow of light appearing in the sky preceding sunrise",
                        "target_lang_word": "Morgenrot",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Morgenrot",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "14d1bd9a-7a1c-3121-b31f-0171f85d6f2b",
                                        "entry_id": "80d7e59f-a322-3df7-bc8c-de427b89d07d",
                                        "glosses": [
                                            "rötliche Färbung des Himmels bei Sonnenaufgang"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fa02358-3a7b-41ca-b647-139c4a048d4e",
                                                "sense_id": "14d1bd9a-7a1c-3121-b31f-0171f85d6f2b",
                                                "text": "Einer alten Bauernregel zufolge kündigt ein kräftiges Morgenrot schlechtes Wetter an."
                                            },
                                            {
                                                "example_id": "4fdfbcd0-32d6-4070-8400-076398b00922",
                                                "sense_id": "14d1bd9a-7a1c-3121-b31f-0171f85d6f2b",
                                                "text": "Trittst im Morgenrot daher, Seh’ ich dich im Strahlenmeer, Dich, du Hocherhabener, Herrlicher!"
                                            },
                                            {
                                                "example_id": "101685a6-6f9c-449a-aab7-f2959fb9d1b6",
                                                "sense_id": "14d1bd9a-7a1c-3121-b31f-0171f85d6f2b",
                                                "text": "„Das musste das Morgenrot sein, das viel zu frühe Morgenrot, das der Schnee reflektierte.“"
                                            },
                                            {
                                                "example_id": "45e59ae9-87cb-4f54-a5f1-68d6bc2486df",
                                                "sense_id": "14d1bd9a-7a1c-3121-b31f-0171f85d6f2b",
                                                "text": "„Wir waren – ein schöner Beweis meiner Ortskenntnis – bis zum Morgenrot vor der Nase der roten Vorposten in den Sümpfen herumgewatet.“"
                                            },
                                            {
                                                "example_id": "bfbc6449-d9e7-46d1-8b2f-0c8752131db1",
                                                "sense_id": "14d1bd9a-7a1c-3121-b31f-0171f85d6f2b",
                                                "text": "„Das Morgenrot stand hoch hinter den Häusern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "04855965-5a0d-4f28-9559-361c7abe9307",
                        "source_entry_id": "a2a06fe9-0228-340e-ab59-782db28d2e99",
                        "source_sense_id": "34881ef0-27fd-3b38-98d8-33e64910fdf6",
                        "source_sense_description": "The glow of light appearing in the sky preceding sunrise",
                        "target_lang_word": "Morgenröte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Morgenröte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "20ba74c6-bf2d-3143-8959-091dacdfeeb3",
                                        "entry_id": "2d0f48bc-0072-3493-aba3-e04837bca223",
                                        "glosses": [
                                            "Färbung des Himmels in Rottönen am Morgen kurz vor Sonnenaufgang"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f01c01b2-82e4-402f-b410-2aa3eb33c551",
                                                "sense_id": "20ba74c6-bf2d-3143-8959-091dacdfeeb3",
                                                "text": "Der Professor erfreute sich an der fantastischen Morgenröte."
                                            },
                                            {
                                                "example_id": "2ca2daf7-6a56-4006-9b89-b62112bf802d",
                                                "sense_id": "20ba74c6-bf2d-3143-8959-091dacdfeeb3",
                                                "text": "„Bis zur Morgenröte hatte Reizl auf ihn eingeredet.“"
                                            },
                                            {
                                                "example_id": "768f02a4-6dfd-4417-a430-82a5ef810c41",
                                                "sense_id": "20ba74c6-bf2d-3143-8959-091dacdfeeb3",
                                                "text": "„Beim ersten Strahl der Morgenröte kreischten der mächtige Schlüssel und der Riegel, und Signora Orio öffnete die Tür, um sich ihren nötigen Seelenfrieden für den Tag zu holen.“"
                                            },
                                            {
                                                "example_id": "937787cb-4444-46c5-a9f3-59dbf7c3b352",
                                                "sense_id": "20ba74c6-bf2d-3143-8959-091dacdfeeb3",
                                                "text": "„Die Morgenröte hatte kaum durch den Wald zu schimmern angefangen, als die dunkeln Gestalten der Squaws und ihrer Töchter dem Landungsplatze zueilten, wo einige Stunden zuvor ihre Männer und Väter sich eingeschifft hatten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
