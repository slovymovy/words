                        "examples": [
                            {
                                "example_id": "4f3b6212-9cc6-4553-ab5d-68fad9a8ba70",
                                "sense_id": "687eb36b-7624-3cff-95cb-82a89adb3377",
                                "text": "Als der Diener am nächsten Morgen behutsam eintrat, saß Händel noch am Arbeitstisch und schrieb. Er antwortete nicht, als Christof Schmidt, sein Adlatus, scheu ihn fragte, ob er beim Kopieren behilflich sein könne, er knurrte nur dumpf und gefährlich."
                            }
                        ]
                    }
                ],
