                                                "example_id": "710a74d1-195d-4d62-82fa-db722308fc60",
                                                "sense_id": "04065a60-2795-3263-a0e6-ee6917ddf90f",
                                                "text": "the unlucky manage of this fatal brawl"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5f80b3d-de82-3c99-9264-51291cbc312d",
                                        "entry_id": "9f88e9db-77b2-34e7-be10-72eefc16dc1d",
                                        "glosses": [
                                            "Manège."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dacd8f8a-627b-447c-9a4d-a39627ac32f7",
                                                "sense_id": "e5f80b3d-de82-3c99-9264-51291cbc312d",
                                                "text": "You must draw [the horse] in his career with his manage, and turn, doing the corvetto, leaping &c.."
                                            }
