                "senses": [
                    {
                        "sense_id": "197a131b-7328-334c-8459-c1033b75272a",
                        "entry_id": "9e636962-4a3c-32f6-ae7b-f1dba0c724ce",
                        "glosses": [
                            "Landwirt, der seinen Schwerpunkt auf die Viehzucht und Milchwirtschaft gelegt hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78eee39e-5b1d-43b2-aec1-91898fa34a80",
                                "sense_id": "197a131b-7328-334c-8459-c1033b75272a",
                                "text": "„Solchen Motiven zu folgen, kann vielversprechend sein: Vielleicht wird der Mann eines Tages erfolgreicher Viehwirt und baut so eine Ruine seiner Familiengeschichte auf.“"
                            },
                            {
                                "example_id": "9b23919e-e0d8-44c8-ae20-883268d68b48",
                                "sense_id": "197a131b-7328-334c-8459-c1033b75272a",
                                "text": "„Dazu gehört eine traditionelle Dhaufahrt durch die Fjorde Musandams ebenso wie ein Treffen mit einem omanischen Viehwirt und ein Besuch in der Weihrauchregion Dhofar.“"
                            },
                            {
                                "example_id": "3fc60eea-941e-421e-bdda-f4f91125758c",
                                "sense_id": "197a131b-7328-334c-8459-c1033b75272a",
                                "text": "„Der Viehwirt hatte das Feuer gegen 21 Uhr bemerkt und mit seinem Sohn versucht, seine Tiere zu retten.“"
                            },
                            {
                                "example_id": "ad145469-676a-43c8-b179-8c256f877351",
                                "sense_id": "197a131b-7328-334c-8459-c1033b75272a",
                                "text": "„Viele seien überzeugt, dass man als Land- oder Viehwirt den ganzen Tag arbeiten müsse und kaum Geld verdiene.“"
                            },
                            {
                                "example_id": "0eb626ee-f7a2-4f08-983f-3f020507ac66",
                                "sense_id": "197a131b-7328-334c-8459-c1033b75272a",
                                "text": "„Dann beginnt er eine Ausbildung zum Land- und Viehwirt an der Landwirtschaftsschule in Ettlingen.“"
                            },
                            {
                                "example_id": "10f5d343-f078-465a-8433-32d6de2a99f6",
                                "sense_id": "197a131b-7328-334c-8459-c1033b75272a",
                                "text": "„Mit einer digital gestützten und auf das einzelne Tier abgestimmten Fütterung versorgt heute schon jeder zweite Viehwirt (51 Prozent) seine Tiere.“"
                            },
                            {
                                "example_id": "52346b20-4eda-4a9b-90a6-8f7d0cb5202e",
                                "sense_id": "197a131b-7328-334c-8459-c1033b75272a",
                                "text": "„Als gelernter Viehwirt und Diplom-Kaufmann arbeitete er zunächst bei einem amerikanischen Hersteller für Pflanzenschutzmittel und Tiermedizin.“"
                            },
                            {
                                "example_id": "e47a1ba3-b74c-4971-9a5f-a6b5115e7d9f",
                                "sense_id": "197a131b-7328-334c-8459-c1033b75272a",
                                "text": "„Zwei Berufsgruppen gibt es, die Wölfe mit einer gewissen Berechtigung nicht leiden können: Viehwirte und Schäfer.“"
                            },
                            {
                                "example_id": "6c7176f5-f435-4e6f-bf76-f06e33064127",
                                "sense_id": "197a131b-7328-334c-8459-c1033b75272a",
                                "text": "„Der PR-Mann und Abenteurer erlebt, wie sich Holzfäller, Straßenbauer, Viehwirte und Soja-Bauern in die Lunge der Menschheit fressen; ein Fünftel des gesamten Amazonas-Gebietes ist bereits gerodet oder abgebrannt.“"
                            },
                            {
                                "example_id": "1aade92d-88dd-49b1-b3b4-b51ab44d8f53",
                                "sense_id": "197a131b-7328-334c-8459-c1033b75272a",
                                "text": "„Kentucky ist das Reich der Viehwirte, Jockeys und Cowboys – und Trumps rauer Stil kommt bei ihnen gut an.“"
                            },
                            {
                                "example_id": "cb3bdecc-86ff-49d5-804e-1ef304c0894e",
                                "sense_id": "197a131b-7328-334c-8459-c1033b75272a",
                                "text": "„‚Das beste Fleisch der Welt in den Händen der schlechtesten Regierung der Welt‘, stänkerten auf Plakaten Viehwirte, die mit den Exportbeschränkungen des Präsidentenpaars Kirchner unzufrieden sind.“"
                            },
                            {
                                "example_id": "fe2ab679-f53f-476e-b6da-df350c8c8c8a",
                                "sense_id": "197a131b-7328-334c-8459-c1033b75272a",
                                "text": "„Doch für Viehwirte und die Massentierhaltung ist das Virus eine wirtschaftliche Katastrophe.“"
                            },
                            {
                                "example_id": "bcc21f44-b0a4-44a1-84f7-ce66839907e3",
                                "sense_id": "197a131b-7328-334c-8459-c1033b75272a",
                                "text": "„Die Erntedaten zeigten, dass es vor allem die Viehwirte und Futterbauern besonders hart getroffen habe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
