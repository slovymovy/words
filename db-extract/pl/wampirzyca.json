                    },
                    {
                        "translation_id": "8581f498-4b58-42f8-96f4-bd1b19f65ffd",
                        "source_entry_id": "370c53e9-7542-366e-8299-f4039ede7a6d",
                        "source_sense_id": "f5111736-82b4-3cbd-a742-bd0d4c551b1e",
                        "target_lang_word": "vampiresse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vampiresse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ad09f3c2-17dc-3664-b293-64b89d718156",
                                        "entry_id": "44f9f5ae-03ab-39a9-a783-195ef5adb429",
                                        "glosses": [
                                            "Vampire femelle."
                                        ],
                                        "tags": [
                                            "Fantastique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82f9d8d0-a668-450c-af7b-c48a151d7e0a",
                                                "sense_id": "ad09f3c2-17dc-3664-b293-64b89d718156",
                                                "text": "Si le risque s'avère trop grand pour vous, vous pouvez percer le cœur de la vampiresse en 348."
                                            },
                                            {
                                                "example_id": "46643728-5def-49d5-b4ab-b8c22aab8b53",
                                                "sense_id": "ad09f3c2-17dc-3664-b293-64b89d718156",
                                                "text": "Il s'accroupit sur la vampiresse, ses mains sur ses épaules , ses muscles tendus comme un ressort prêt à se déclencher."
                                            },
                                            {
                                                "example_id": "81352c5f-9b44-47e2-b582-f42883873ba7",
                                                "sense_id": "ad09f3c2-17dc-3664-b293-64b89d718156",
                                                "text": "Il sentait, toute la nuit, la bouche d'Honorine, palpitante et comme voletante sur lui, lourdement ; il avait sur ses bras, sur ses mains qui se levaient avec un geste d'écarter la vampiresse, et sur sa poitrine et sur ses flancs, l'oppression d'un tyrannique triomphe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
