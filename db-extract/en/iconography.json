                    {
                        "sense_id": "280314bd-b627-3907-b5db-432a8dcf649f",
                        "entry_id": "1ad0687e-8701-37b2-ae8f-8c877cf7cdf5",
                        "glosses": [
                            "A set of specified or traditional symbolic forms associated with the subject or theme of a stylized genre of art."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "09a3c301-3ce7-4497-9c08-77a0840e70fc",
                                "sense_id": "280314bd-b627-3907-b5db-432a8dcf649f",
                                "text": "The hundredodd pages of photographs provide superb iconography of artistic collaboration and its rewards."
                            }
                        ]
                    },
                    {
                        "sense_id": "4240901e-9338-315b-946c-4a43813b30d8",
                        "entry_id": "1ad0687e-8701-37b2-ae8f-8c877cf7cdf5",
                        "glosses": [
                            "The art of representation by pictures or images; the description or study of portraiture or representation, as of persons."
                        ],
                        "tags": [
