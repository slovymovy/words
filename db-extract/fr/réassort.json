                    }
                ],
                "senses": [
                    {
                        "sense_id": "f9fd862e-2b33-394c-b088-54e59d400950",
                        "entry_id": "ffb24310-116b-3430-9121-cf8129db2eab",
                        "glosses": [
                            "Procédure qui permet de réapprovisionner un rayon ou une unité de gestion."
                        ],
                        "tags": [
                            "Logistique"
                        ],
                        "examples": [
                            {
                                "example_id": "e2c55d43-c6b6-4168-98d6-d9a31e4f0aaf",
                                "sense_id": "f9fd862e-2b33-394c-b088-54e59d400950",
                                "text": "L’échéancier d’achat sur lequel seront reportés les données commerciales (telles que les mentions office, réassort), sera par contre un précieux soutien de gestion."
                            },
                            {
                                "example_id": "77495941-c34c-4a5c-a066-4135849d515e",
                                "sense_id": "f9fd862e-2b33-394c-b088-54e59d400950",
                                "text": "Il donne toujours un coup de main à la petite Marie, avant la fermeture. Il l’aide à déballer ses cartons, pour le réassort du lendemain..."
                            },
                            {
                                "example_id": "0109345a-908b-42ae-8a0b-755437e0a448",
                                "sense_id": "f9fd862e-2b33-394c-b088-54e59d400950",
                                "text": "Il extirpe de sa poche arrière une feuille de papier, un formulaire de réassort adressé à la laiterie H. H. White, sur lequel figure le nom du laitier, le numéro de son fourgon et les quantités dont il avait besoin pour sa tournée, trois jours auparavant."
                            },
                            {
                                "example_id": "879d0c01-4a55-4fc6-8046-6d3e5e4bc3ba",
                                "sense_id": "f9fd862e-2b33-394c-b088-54e59d400950",
                                "text": "Au-delà du réassort quotidien, qui ne cesse de croître, les nouveaux services doivent à leur tour être équipés en totalité."
                            }
                        ]
                    },
                    {
                        "sense_id": "9d543c10-9f50-341a-8e23-ebfd0fba82de",
                        "entry_id": "ffb24310-116b-3430-9121-cf8129db2eab",
                        "glosses": [
                            "Les pièces destinées à réassortir."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "aebd480a-74e7-461c-87ab-b2291be0b205",
                                "sense_id": "9d543c10-9f50-341a-8e23-ebfd0fba82de",
                                "text": "Je le laisse sur cette comparaison extrêmement littéraire qui me vaudra un fauteuil sous la coupole lorsque je serai fatigué. Que dis-je : un fauteuil ! Un rang ! Car on manque de réassort chez les verdâtres."
                            },
                            {
                                "example_id": "2d9bda55-7f8e-4f18-b808-b699f2793dc3",
                                "sense_id": "9d543c10-9f50-341a-8e23-ebfd0fba82de",
                                "text": "Si le lot a du succès en France, il peut être difficile de trouver un réassort."
                            }
                        ]
                    }
                ],
