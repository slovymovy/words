                ],
                "senses": [
                    {
                        "sense_id": "3949879a-9d07-367b-a315-b9ee2fad1b2d",
                        "entry_id": "d94ab611-2c94-3a70-8245-d30a9bf3f4f5",
                        "glosses": [
                            "weibliches Geschlechtsorgan bei Säugetieren und anderen lebendgebärenden Wirbeltieren, in dem der Fötus bis zur Geburt heranreift"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6af01fdf-58ae-415f-8d18-e6052966f13c",
                                "sense_id": "3949879a-9d07-367b-a315-b9ee2fad1b2d",
                                "text": "Während der Schwangerschaft dehnt sich der Uterus stark aus."
                            },
                            {
                                "example_id": "859d9db6-3d47-47c1-a1f5-6967696ed4dd",
                                "sense_id": "3949879a-9d07-367b-a315-b9ee2fad1b2d",
                                "text": "„Der Autor behauptete, der Uterus sei zwar wirklich etwas Tierisches, er vermöge jedoch nichts über die Vernunft der Frau, weil die Anatomie noch nie den geringsten Verbindungsgang zwischen diesem Eingeweide, der Hülle des Fötus, und dem Gehirn entdeckt habe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "72ff5ef4-df84-42da-9281-096c13c8fbe4",
                        "source_entry_id": "d94ab611-2c94-3a70-8245-d30a9bf3f4f5",
