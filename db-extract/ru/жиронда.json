                    },
                    {
                        "translation_id": "1cc02777-c98b-4d02-9982-c25a2f86782f",
                        "source_entry_id": "6c154205-3580-323f-a3ce-93353bcb4ade",
                        "target_lang_word": "Gironde",
                        "target_lang_code": "de",
