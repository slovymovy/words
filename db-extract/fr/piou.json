                    {
                        "sense_id": "459f157c-3818-3518-a5a9-de1e3ed5ea18",
                        "entry_id": "6ab8a20e-64d7-341e-9b2a-8ec641e71b0f",
                        "glosses": [
                            "Soldat."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "d4dfff42-8bc4-41d9-8a0b-20ddd6bed740",
                                "sense_id": "459f157c-3818-3518-a5a9-de1e3ed5ea18",
                                "text": "De l’eau-de-vie et de l’absinthe, rien que ça ! … le mélo de mon piou, tu sais bien ? le militaire (…) il ne buvait que ça."
                            },
                            {
                                "example_id": "23081e50-f3fe-4a48-b3b1-336366fe61c1",
                                "sense_id": "459f157c-3818-3518-a5a9-de1e3ed5ea18",
                                "text": "Un certain nombre de gamins du voisinage, d’apprentis en route pour l’atelier, s’arrêtent aussi volontiers là, marquant le pas comme les pious et mimant tous leurs exercices."
                            }
                        ]
                    }
