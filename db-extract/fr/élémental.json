                    {
                        "sense_id": "87d53861-f38d-332c-b9df-73f708486f08",
                        "entry_id": "a7677346-1f81-3f24-8831-74dadfb2d1c3",
                        "glosses": [
                            "Sorte d’esprit désincarné qui vivrait dans les éléments."
                        ],
                        "tags": [
                            "Fantastique",
                            "Jeux de rôle",
                            "Jeux de rôle d’action-aventure"
                        ],
                        "examples": [
                            {
                                "example_id": "4372ae08-7778-4fbe-ad2d-0544fc56cb6f",
                                "sense_id": "87d53861-f38d-332c-b9df-73f708486f08",
                                "text": "Les occultistes considèrent deux sortes d’élémentals : ceux qui ont une existence propre et ceux qui sont artificiels."
                            },
                            {
                                "example_id": "f12c2528-a230-44bc-b6e8-6f3d03ce25c6",
                                "sense_id": "87d53861-f38d-332c-b9df-73f708486f08",
                                "text": "Les êtres psychiques qui peuplent la région dans laquelle agissent les forces physico-chimiques ont reçu le nom d’élémentals ou esprits des éléments."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "84b30fa0-13a9-4f7b-909e-e99e43ffd8cb",
                        "source_entry_id": "a7677346-1f81-3f24-8831-74dadfb2d1c3",
                        "source_sense_id": "87d53861-f38d-332c-b9df-73f708486f08",
