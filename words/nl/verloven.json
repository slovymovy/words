{
    "word_family": [
        "verloving",
        "verloofde"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "72ae808a-0f89-30ac-9628-df01f7b7ee56",
                    "sense_definition": "zich <w>verloven</w>: een formele belofte doen om met iemand te gaan trouwen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "engagement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kroonprins <w>verloofde</w> zich met een burgermeisje tijdens hun vakantie in Italië.",
                            "target_lang_translations": {
                                "en": "The crown prince <w>got engaged</w> to a commoner during their holiday in Italy."
                            }
                        },
                        {
                            "text": "Na drie jaar verkering besloten ze om zich officieel te <w>verloven</w>.",
                            "target_lang_translations": {
                                "en": "After dating for three years, they decided to <w>get engaged</w> officially."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zich officieel verloven",
                        "zich met iemand verloven"
                    ],
                    "target_lang_definitions": {
                        "en": "to make a formal promise to marry someone"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "get engaged",
                                "target_lang_sense_clarification": "to promise to marry"
                            },
                            {
                                "target_lang_word": "become engaged",
                                "target_lang_sense_clarification": "the process of entering an engagement"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e946ac67-0ddf-3d9e-ac50-f861ea2700f5",
                    "sense_definition": "twee mensen aan elkaar verbinden door een huwelijksbelofte, vaak door derden geregeld",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "engagement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dynastieën <w>verloven</w> hun prinsen vaak om diplomatieke redenen met buitenlandse prinsessen.",
                            "target_lang_translations": {
                                "en": "Dynasties often <w>betroth</w> their princes to foreign princesses for diplomatic reasons."
                            }
                        },
                        {
                            "text": "In die tijd was het gebruikelijk dat ouders hun kinderen al op jonge leeftijd <w>verloofden</w>.",
                            "target_lang_translations": {
                                "en": "In those days, it was common for parents to <w>betroth</w> their children at a young age."
                            }
                        }
                    ],
                    "common_phrases": [
                        "iemand verloven met"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "mostly used in historical or formal contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to bind two people together through a marriage promise, often arranged by third parties"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "betroth",
                                "target_lang_sense_clarification": "formal or historical term for arranging a marriage"
                            },
                            {
                                "target_lang_word": "affiance",
                                "target_lang_sense_clarification": "very formal or literary term for promising in marriage"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "73b1e458-f195-393c-a1f4-247d01ec31f8",
                    "sense_definition": "toestaan of verlof geven voor iets",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "permission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De officier wilde de soldaat een kort verblijf thuis <w>verloven</w>.",
                            "target_lang_translations": {
                                "en": "The officer wanted to <w>grant</w> the soldier a short stay at home."
                            }
                        },
                        {
                            "text": "Het is niet aan mij om u deze afwezigheid te <w>verloven</w>.",
                            "target_lang_translations": {
                                "en": "It is not up to me to <w>permit</w> you this absence."
                            }
                        }
                    ],
                    "synonyms": [
                        "toestaan",
                        "vergunnen"
                    ],
                    "antonyms": [
                        "verbieden"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern Dutch"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to allow or grant permission for something"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "permit",
                                "target_lang_sense_clarification": "to allow something to happen"
                            },
                            {
                                "target_lang_word": "grant leave",
                                "target_lang_sense_clarification": "to give official permission for absence"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0b77dc02-1aab-3b38-922b-b265d38af675",
                    "sense_definition": "meervoud van <w>verlof</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Alle <w>verloven</w> van het personeel werden ingetrokken vanwege de drukte.",
                            "target_lang_translations": {
                                "en": "All staff <w>leaves</w> were cancelled due to the busy period."
                            }
                        },
                        {
                            "text": "Tijdens de feestdagen worden er meestal geen nieuwe <w>verloven</w> goedgekeurd.",
                            "target_lang_translations": {
                                "en": "During the holidays, usually no new <w>leaves</w> are approved."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "plural form of leave or furlough"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "leaves",
                                "target_lang_sense_clarification": "plural of leave of absence"
                            },
                            {
                                "target_lang_word": "furloughs",
                                "target_lang_sense_clarification": "plural of temporary leave from duty"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}