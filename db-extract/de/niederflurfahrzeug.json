                                "example_id": "52e2dbd7-aa8c-41ff-875c-b9580e5cfff0",
                                "sense_id": "877dff38-deeb-312a-9c80-1f8e78a613a5",
                                "text": "„Das Niederflurfahrzeug ist von außen durch den Schriftzug „EcoTram“ erkennbar.“"
                            }
