    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "43608fb9-7940-34d6-b0ae-36baeed31ed2",
                    "sense_definition": "Diriger un instrument, une arme ou un faisceau lumineux dans une direction précise.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "orientation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le photographe a commencé à <w>braquer</w> son objectif vers la foule rassemblée sur la place."
                        },
                        {
                            "text": "Les gardes ont décidé de <w>braquer</w> un projecteur puissant sur la cour extérieure."
                        }
                    ],
                    "synonyms": [
                        "pointer",
                        "diriger",
                        "orienter"
                    ],
                    "common_phrases": [
                        "braquer une arme",
                        "braquer un projecteur",
                        "braquer son objectif"
                    ]
                },
                {
                    "sense_id": "2c97b504-b868-34d8-afbb-f24ef513b434",
                    "sense_definition": "Attaquer ou menacer quelqu'un avec une arme pour le dévaliser.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "criminalite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Deux individus masqués ont tenté de <w>braquer</w> la bijouterie en plein après-midi."
                        },
                        {
                            "text": "Les malfaiteurs voulaient <w>braquer</w> une banque avant l'arrivée rapide des forces de l'ordre."
                        }
                    ],
                    "synonyms": [
                        "dévaliser",
                        "attaquer"
                    ],
                    "common_phrases": [
                        "braquer une banque",
                        "braquer un commerce"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre courant ou familier pour désigner un vol à main armée"
                        }
                    ]
                },
                {
                    "sense_id": "a8f392af-7c23-33f0-9523-7d2fcb1122d6",
                    "sense_definition": "Tourner les roues ou le volant d'un véhicule dans une direction avec force ou amplitude.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "orientation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour réussir ce créneau étroit, il faut <w>braquer</w> à fond vers la droite."
                        },
                        {
                            "text": "Le conducteur a dû <w>braquer</w> brusquement pour éviter un obstacle imprévu sur la route."
                        }
                    ],
                    "synonyms": [
                        "tourner",
                        "virer"
                    ],
                    "antonyms": [
                        "débraquer"
                    ],
                    "common_phrases": [
                        "braquer à fond",
                        "braquer le volant",
                        "braquer à gauche"
                    ]
                },
                {
                    "sense_id": "b72108d8-a069-34b8-b79a-59f769bc93c3",
                    "sense_definition": "Se bloquer dans une attitude hostile, inflexible ou de refus obstiné.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "comportement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dès qu'on évoque ses erreurs passées, il a tendance à se <w>braquer</w> immédiatement."
                        },
                        {
                            "text": "Ne te <w>braque</w> pas pour une simple remarque faite sans mauvaise intention."
                        }
                    ],
                    "synonyms": [
                        "s'obstiner",
                        "se buter",
                        "se fermer"
                    ],
                    "antonyms": [
                        "céder",
                        "s'adoucir"
                    ],
                    "common_phrases": [
                        "se braquer contre"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "usage courant"
                        }
                    ]
                },
                {
                    "sense_id": "621ace90-20b4-3132-8b89-469dc02aebff",
                    "sense_definition": "Irriter ou indisposer quelqu'un au point de le rendre hostile ou intransigeant.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "comportement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une remarque trop directe risque de <w>braquer</w> les négociateurs dès le premier jour."
                        },
                        {
                            "text": "Sa réponse cassante a fini par <w>braquer</w> toute l'équipe contre le projet proposé."
                        }
                    ],
                    "synonyms": [
                        "irriter",
                        "froisser",
                        "indisposer"
                    ],
                    "antonyms": [
                        "amadouer",
                        "apaiser"
                    ],
                    "common_phrases": [
                        "braquer quelqu'un"
                    ]
                },
                {
                    "sense_id": "2a466ad0-2005-3cc4-afea-1bae7920093d",
                    "sense_definition": "Fixer attentivement ou avec insistance ses yeux ou son regard sur quelqu'un ou quelque chose.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "orientation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'inconnu n'arrêtait pas de <w>braquer</w> ses yeux curieux sur les nouveaux arrivants."
                        },
                        {
                            "text": "Elle n'aimait guère quand les spectateurs venaient <w>braquer</w> leur regard sur elle."
                        }
                    ],
                    "synonyms": [
                        "fixer",
                        "river"
                    ],
                    "antonyms": [
                        "détourner"
                    ],
                    "common_phrases": [
                        "braquer les yeux",
                        "braquer son regard"
                    ]
                },
                {
                    "sense_id": "43fb7456-7fd9-36fd-b07d-515349612ea5",
                    "sense_definition": "Briser les tiges de chanvre ou de lin afin d'en extraire la filasse.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "artisanat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les ouvriers devaient d'abord faire sécher les tiges avant de <w>braquer</w> le chanvre récolté."
                        },
                        {
                            "text": "Le paysan utilisait une machine traditionnelle pour <w>braquer</w> ces fibres végétales avec soin."
                        }
                    ],
                    "synonyms": [
