            "senses": [
                {
                    "sense_id": "384aa318-2db5-352f-9cfe-220d0ab1326e",
                    "sense_definition": "Amphibien sauteur et nageur à peau lisse et aux longues pattes arrière palmées, vivant près des étangs et des marais.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "amphibien",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une petite <w>grenouille</w> verte a sauté rapidement dans l'eau de la mare."
                        },
                        {
                            "text": "Pendant l'été, nous écoutons le chant des <w>grenouilles</w> près de l'étang."
                        }
                    ],
                    "synonyms": [
                        "raine"
                    ],
                    "common_phrases": [
                        "cuisses de grenouille",
                        "grenouille verte"
                    ]
                },
                {
                    "sense_id": "bf627594-65e1-3b24-b395-a8af6874e2d7",
                    "sense_definition": "Somme d'argent mise en réserve, notamment la caisse commune ou le trésor d'une association.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "argent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le trésorier a disparu après avoir mangé la <w>grenouille</w> du club de football."
                        },
                        {
                            "text": "Les membres ont constaté qu'il ne restait presque rien dans la <w>grenouille</w> de l'association."
                        }
                    ],
                    "common_phrases": [
                        "manger la grenouille"
                    ]
                },
                {
                    "sense_id": "87bfdbc3-efee-3caf-8fa0-7f0ac4dc3a6e",
                    "sense_definition": "Partie supérieure d'une cloche qui permet de la suspendre à son axe.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "cloche",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'artisan vérifie la solidité de la <w>grenouille</w> avant d'installer la lourde cloche."
                        },
                        {
                            "text": "Cette cloche ancienne reste suspendue au beffroi grâce à sa <w>grenouille</w> en bronze."
                        }
                    ],
                    "synonyms": [
