                "senses": [
                    {
                        "sense_id": "c53138ff-bb29-32e9-a556-006987d3869e",
                        "entry_id": "4ebef9c2-cb3b-3ff7-b8a3-02300d4447e5",
                        "glosses": [
                            "weibliche Person, die einer wissenschaftlichen Prüfung oder einer Untersuchung unterzogen wird, die an einem wissenschaftlichen Versuch teilnimmt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea507d57-f476-4226-8007-e57f06e9eeba",
                                "sense_id": "c53138ff-bb29-32e9-a556-006987d3869e",
                                "text": "Die Hälfte der Probandinnen erkrankte bereits nach drei Tagen."
                            },
                            {
                                "example_id": "d15439b7-af36-461a-9577-6afa606256a9",
                                "sense_id": "c53138ff-bb29-32e9-a556-006987d3869e",
                                "text": "Die Probandin wurde vorher ausführlich untersucht."
                            },
                            {
                                "example_id": "78918f47-e689-4178-bf11-77c45c5fa3f8",
                                "sense_id": "c53138ff-bb29-32e9-a556-006987d3869e",
                                "text": "„Alle Probandinnen und Probanden wurden außerdem einem Intelligenztest unterzogen.“"
                            },
                            {
                                "example_id": "72d14460-3225-4d4f-80bb-f173355e91b0",
                                "sense_id": "c53138ff-bb29-32e9-a556-006987d3869e",
                                "text": "„Noch eine ganze Zeit stehen sie so da, dann weckt Mesmer seine Probandin aus dem Schlaf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
