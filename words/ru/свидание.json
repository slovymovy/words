            "senses": [
                {
                    "sense_id": "b9e2b78e-01ac-3ae9-a0e5-a3f14ce0a762",
                    "sense_definition": "романтическая встреча двух людей",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "встреча",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он очень волновался перед своим первым <w>свиданием</w> с ней.",
                            "target_lang_translations": {
                                "en": "He was very nervous before his first <w>date</w> with her."
                            }
                        },
                        {
                            "text": "Они договорились пойти на <w>свидание</w> в пятницу вечером.",
                            "target_lang_translations": {
                                "en": "They agreed to go on a <w>date</w> on Friday evening."
                            }
                        }
                    ],
                    "synonyms": [
                        "свиданье",
                        "рандеву"
                    ],
                    "antonyms": [
                        "разлука"
                    ],
                    "common_phrases": [
                        "назначить свидание",
                        "идти на свидание"
                    ],
                    "target_lang_definitions": {
                        "en": "A romantic meeting between two people."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "date",
                                "target_lang_sense_clarification": "A romantic meeting or outing with a potential partner."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "936b6727-b2c0-399c-aa2b-996075a8aa32",
                    "sense_definition": "условленная встреча людей",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "встреча",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Деловое <w>свидание</w> было назначено на десять часов утра.",
                            "target_lang_translations": {
                                "en": "The business <w>meeting</w> was scheduled for ten o'clock in the morning."
                            }
                        },
                        {
                            "text": "Друзья договорились о <w>свидании</w> в центре города.",
                            "target_lang_translations": {
                                "en": "The friends arranged a <w>meeting</w> in the city center."
                            }
                        }
                    ],
                    "synonyms": [
                        "встреча",
                        "стрелка"
                    ],
                    "common_phrases": [
                        "деловое свидание"
                    ],
                    "target_lang_definitions": {
                        "en": "An arranged meeting between people."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "meeting",
                                "target_lang_sense_clarification": "A gathering of people for a specific purpose."
                            },
                            {
                                "target_lang_word": "appointment",
                                "target_lang_sense_clarification": "An arrangement between people to meet at a specific time."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7e56f650-68ed-34c7-948c-ead2d335ddb9",
                    "sense_definition": "посещение человека, находящегося в больнице или тюрьме",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "посещение",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Адвокат добился разрешения на <w>свидание</w> с подзащитным.",
                            "target_lang_translations": {
                                "en": "The lawyer obtained permission for a <w>visit</w> with the client."
                            }
                        },
                        {
                            "text": "Врачи разрешили короткое <w>свидание</w> с больным в палате.",
                            "target_lang_translations": {
                                "en": "The doctors allowed a short <w>visit</w> with the patient in the ward."
                            }
                        }
                    ],
                    "synonyms": [
                        "визит",
                        "посещение"
                    ],
                    "common_phrases": [
                        "разрешить свидание"
                    ],
                    "target_lang_definitions": {
                        "en": "A visit to someone who is in a hospital or prison."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "visit",
                                "target_lang_sense_clarification": "A formal or scheduled meeting with someone in a restricted or institutional setting."
                            }
                        ]
                    }
                }
            ]
        }
    ]
