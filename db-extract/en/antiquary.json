                                        "entry_id": "4d009c1a-288c-305f-9119-733f533b9750",
                                        "glosses": [
                                            "weibliche Person, die mit alten Büchern und eventuell auch anderen alten Druckwerken handelt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57f25c3f-0cc3-47af-8d3d-46b952250cb3",
                                                "sense_id": "3cde8e13-9e17-3054-bacf-60c802561922",
                                                "text": "„Die Antiquarin zahlt im Einkauf lieber 1000 Euro für ein Buch, als 1000 Bücher für je einen Euro zu erwerben.“"
                                            }
