        "fr-extract.jsonl": [
            {
                "entry_id": "0abab871-8135-39a1-afc7-f9e5fbf07653",
                "word": "détérioration",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e3d4d6cb-6065-4e32-9de1-3577913d9fd9",
                        "entry_id": "0abab871-8135-39a1-afc7-f9e5fbf07653",
                        "tags": [
                            "plural"
                        ],
                        "form": "détériorations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "26486ad8-97aa-30a9-8f0e-64fd3d0b37b6",
                        "entry_id": "0abab871-8135-39a1-afc7-f9e5fbf07653",
                        "glosses": [
                            "Action par laquelle une chose est détériorée ou résultat de cette action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "722c914a-352f-4f78-b18c-4df97b13a9bd",
                                "sense_id": "26486ad8-97aa-30a9-8f0e-64fd3d0b37b6",
                                "text": "Tout locataire est responsable des détériorations survenues durant son bail."
                            },
                            {
                                "example_id": "dbcbf466-c901-47a6-9ad7-b9b8cc742287",
                                "sense_id": "26486ad8-97aa-30a9-8f0e-64fd3d0b37b6",
                                "text": "Il y a de grandes détériorations dans cette terre, tout y est dans une étrange détérioration."
                            },
                            {
                                "example_id": "24c81ddb-c475-4cc4-806e-c388a36e9763",
                                "sense_id": "26486ad8-97aa-30a9-8f0e-64fd3d0b37b6",
                                "text": "Il faut en conclure que la cause de cette détérioration intéressait par conséquent la jante toute entière."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7ff9f347-edac-45cd-a73e-ac56b04174a0",
                        "source_entry_id": "0abab871-8135-39a1-afc7-f9e5fbf07653",
                        "source_sense_id": "26486ad8-97aa-30a9-8f0e-64fd3d0b37b6",
                        "target_lang_word": "deterioration",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "deterioration",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a4971ec7-2bdb-3716-96e4-36e5a7a52f12",
                                        "entry_id": "4a6f2bbc-4907-3092-9819-626079333bc3",
                                        "glosses": [
                                            "The process of making or growing worse, or the state of having grown worse."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2f7f8cc-b41d-49a2-942d-07954607e9ba",
                                                "sense_id": "a4971ec7-2bdb-3716-96e4-36e5a7a52f12",
                                                "text": "From 1945 onwards, deterioration in the condition of the brickwork in the arch soffits was kept under close observation, and in 1951 it was decided that strengthening must be undertaken."
                                            },
                                            {
                                                "example_id": "c59d2a83-488e-48c1-9b31-6eb794224a14",
                                                "sense_id": "a4971ec7-2bdb-3716-96e4-36e5a7a52f12",
                                                "text": "The Queen may be celebrating her jubilee but the Queen's English Society, which has railed against the misuse and deterioration of the English language, is to fold."
                                            },
                                            {
                                                "example_id": "a601fc3f-ee5d-4cf9-8d92-ec4e6bc2b8c9",
                                                "sense_id": "a4971ec7-2bdb-3716-96e4-36e5a7a52f12",
                                                "text": "\"The quantum sensors will provide highly accurate measurements that will help to detect the rate of change of the track and subsequently, any deteriorations which might lead to faults.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "97df2388-522d-4fb8-864a-460209680129",
                        "source_entry_id": "0abab871-8135-39a1-afc7-f9e5fbf07653",
                        "source_sense_id": "26486ad8-97aa-30a9-8f0e-64fd3d0b37b6",
