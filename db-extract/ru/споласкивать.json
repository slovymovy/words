                "translations": [
                    {
                        "translation_id": "00af1e6c-2bb9-4f06-b067-1d7ee06c941e",
                        "source_entry_id": "7fe7dc47-2d4d-39e6-8125-6f2a5c5fd96e",
                        "source_sense_id": "54f87410-d848-3f77-a7de-c6ad3efbf2db",
                        "target_lang_word": "rincer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rincer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b3a49b50-095d-381a-a53b-376deb953aa9",
                                        "entry_id": "d0e8523c-850b-331e-8656-b1e184a0421e",
                                        "glosses": [
                                            "Nettoyer, laver et en frottant, en parlant des bouteilles, des verres, des tasses et de quelques autres vases."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d48a894-d734-40d8-aade-4b27b609d965",
                                                "sense_id": "b3a49b50-095d-381a-a53b-376deb953aa9",
                                                "text": "Rincez ces verres."
                                            },
                                            {
                                                "example_id": "3c2f626b-2384-4a2f-baa2-1abdc7ece5c0",
                                                "sense_id": "b3a49b50-095d-381a-a53b-376deb953aa9",
                                                "text": "Il faut rincer cette cruche, cette bouteille."
                                            },
                                            {
                                                "example_id": "687109d6-5011-4ac5-8cfa-a28d0241f7ce",
                                                "sense_id": "b3a49b50-095d-381a-a53b-376deb953aa9",
                                                "text": "Se rincer la bouche, laver sa bouche."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ab277a9-7fde-3f7a-a835-8c254ef9e938",
                                        "entry_id": "d0e8523c-850b-331e-8656-b1e184a0421e",
                                        "glosses": [
                                            "Faire un dernier lavage dans de l’eau sans savon, éventuellement à un pH non neutre, comme dernière opération pour évacuer les agents de nettoyage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bea5f7b8-9a52-48c5-816d-323e4e9b976f",
                                                "sense_id": "3ab277a9-7fde-3f7a-a835-8c254ef9e938",
                                                "text": "Après lui avoir massé le cuir chevelu pendant une bonne minute, elle lui remit la tête sous le jet en s'attachant à ne pas crisper les doigts pendant qu'elle le rinçait."
                                            },
                                            {
                                                "example_id": "758027bb-595e-49ba-b486-6e1a220360db",
                                                "sense_id": "3ab277a9-7fde-3f7a-a835-8c254ef9e938",
                                                "text": "Rincer du linge, de la vaisselle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1c20d7b-5440-37b0-b0a2-28f457de85b4",
                                        "entry_id": "d0e8523c-850b-331e-8656-b1e184a0421e",
                                        "glosses": [
                                            "Laver, se désaltérer, humecter, boire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e39be35c-2768-407b-953c-48a3a8aea0ed",
                                                "sense_id": "b1c20d7b-5440-37b0-b0a2-28f457de85b4",
                                                "text": "Se rincer la bouche, se laver la bouche avec un liquide que l'on recrache."
                                            },
                                            {
                                                "example_id": "db4538b1-4bf1-4eba-8a42-271c0f61733b",
                                                "sense_id": "b1c20d7b-5440-37b0-b0a2-28f457de85b4",
                                                "text": "Se rincer le gosier, se rincer la dalle, boire."
                                            }
                                        ]
                                    },
                                    {
