                        "examples": [
                            {
                                "example_id": "38aea7f0-5e35-4090-a6db-de5c08d56bbe",
                                "sense_id": "3889462d-f45b-3a93-972b-75da0c328b05",
                                "text": "„Wenn das Grummet so dürr ist, daß der Ganserer nicht mehr anpackt (frißt), taugt es zum Einfahren.“"
                            },
                            {
                                "example_id": "5d627f07-d289-470a-a03b-53445595f78b",
                                "sense_id": "3889462d-f45b-3a93-972b-75da0c328b05",
                                "text": "„Mit grimmigem Gesicht näherte sie sich der Gänseschar und als der Ganserer, ein wunderschönes großes Tier, den Kopf senkte und zischend auf sie zukam, […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
