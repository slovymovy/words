                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "183c54f0-d56c-3c0e-acc0-023ae3d8ed86",
                                        "entry_id": "ae75cc13-25f0-3a78-8acf-8812a9d4f378",
                                        "glosses": [
                                            "chrześcijański duchowny, posiadający święcenia kapłańskie lub ordynowany na tę funkcję"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e17e078-956e-44d9-a7ac-d64fb90488fa",
                                                "sense_id": "183c54f0-d56c-3c0e-acc0-023ae3d8ed86",
                                                "text": "Po mszy ksiądz często rozmawiał z parafianami."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "ba1da6d0-371b-301a-8dbe-ed8ea49fdc56",
