                ],
                "senses": [
                    {
                        "sense_id": "c025debd-e2ec-369d-bb13-2058995ad402",
                        "entry_id": "4c2955c4-cb59-3f42-8509-c4bc2b362afd",
                        "glosses": [
                            "Mettre en sachets."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94cfbfb2-e818-4b53-a5cb-a97903a6d6d8",
                                "sense_id": "c025debd-e2ec-369d-bb13-2058995ad402",
                                "text": "Comme les langoustes doivent être congelées très rapidement après avoir été pêchées, seule une faible partie de la pêche peut être ensachetée."
                            },
                            {
                                "example_id": "4bc75e8d-011c-4add-b6f1-af222534d562",
                                "sense_id": "c025debd-e2ec-369d-bb13-2058995ad402",
                                "text": "Sachant que le Rhizobium est vendu sur le marché sous forme d’inoculants commerciaux, une étude similaire a été entreprise avec des cellules ensachetées soumises à des stress hydriques et de température."
                            },
                            {
                                "example_id": "2d9fb677-71b3-4cde-8308-6d179926ef93",
                                "sense_id": "c025debd-e2ec-369d-bb13-2058995ad402",
                                "text": "Le légiste tourna et retourna le préservatif ensacheté entre ses doigts."
                            },
                            {
                                "example_id": "f8cdfd44-1616-4199-8a7e-947a2303ae5f",
                                "sense_id": "c025debd-e2ec-369d-bb13-2058995ad402",
                                "text": "Son bon goût est avant tout dû au grand soin avec lequel Monsieur Bignon le cultive, le décortique et l'ensachette à la ferme."
                            },
                            {
                                "example_id": "32985009-1978-4f06-a4ec-61f288bd6aad",
                                "sense_id": "c025debd-e2ec-369d-bb13-2058995ad402",
                                "text": "Ces plantes sont tellement précieuses à mes yeux que je les \"ensachette\" le plus joliment possible."
                            },
                            {
                                "example_id": "68cdd5cc-1ca5-4c2f-a00e-ce47bd1811bd",
                                "sense_id": "c025debd-e2ec-369d-bb13-2058995ad402",
                                "text": "ce soir j'ensachète les confettis pour le carnaval de samedi"
                            }
                        ]
                    }
                ],
