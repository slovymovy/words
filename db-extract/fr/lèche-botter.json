                "senses": [
                    {
                        "sense_id": "1c955c10-0020-3096-abce-d70ba32f4a25",
                        "entry_id": "43c3d51d-3f1a-38b0-82d8-3d2ff88cae7a",
                        "glosses": [
                            "Faire du lèche-botte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f21ce92e-e450-4b27-8545-59f5c848f8cf",
                                "sense_id": "1c955c10-0020-3096-abce-d70ba32f4a25",
                                "text": "Ca Ça fait aussi ça quand c’est des modos, je sais pas si c’est pour draguer ou juste pour lèche-botter."
                            },
                            {
                                "example_id": "4f9531ae-48d8-470f-87b7-5134f0fc638d",
                                "sense_id": "1c955c10-0020-3096-abce-d70ba32f4a25",
                                "text": "Administrateurs (ceux qu’il faut écouter, respecter, lèche-botter, etc… ^([sic : etc.]))"
                            },
                            {
                                "example_id": "b910b865-3a08-44a0-b617-aa0f3c535422",
                                "sense_id": "1c955c10-0020-3096-abce-d70ba32f4a25",
                                "text": "Certains toujours à critiquer, d’autres toujours à lèche-botter…"
                            },
                            {
                                "example_id": "e3a17043-601c-498c-8215-39c136b061cb",
                                "sense_id": "1c955c10-0020-3096-abce-d70ba32f4a25",
                                "text": "Tant mieux, cela fait une personne de moins à lèche-botter."
                            },
                            {
                                "example_id": "40014755-aba3-4965-a584-0d17cc9f93b6",
                                "sense_id": "1c955c10-0020-3096-abce-d70ba32f4a25",
                                "text": "Triste sort que celui des responsables de théâtre contraints de lèche-botter [les élus] et particulièrement l’Officielle de la Culture Rouennaise, Catherine Morin-Desailly, sénatrice, pour avoir, avec sa réserve parlementaire, c’est-à-dire avec l’argent du peuple, financé personnellement quelques travaux."
                            }
                        ]
                    }
