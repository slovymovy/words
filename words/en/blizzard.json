                    "frequency": "VeryLow",
                    "semantic_group_id": "weather",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It began to <w>blizzard</w> just as we reached the mountain pass.",
                            "target_lang_translations": {
