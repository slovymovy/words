                        "glosses": [
                            "nederzetting in Suriname die gesticht is door de afstammelingen van ontsnapte Afrikaanse slaafgemaakten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17c94c24-e382-4fec-b1df-d07e67bdae9a",
                                "sense_id": "26e81561-e9ba-31f1-a839-8090df3503fa",
                                "text": "Ze gaan naar een marrondorp in het binnenland, een dorp dat is gesticht door weggelopen slaven."
                            },
                            {
                                "example_id": "c8738b94-f27a-452d-8baa-ec76479c9a04",
                                "sense_id": "26e81561-e9ba-31f1-a839-8090df3503fa",
                                "text": "Kunstenaar Marcel Pinas maakte een grote tafel met 39 lege stoelen en borden. Die staan symbool voor de slachtoffers van het bloedbad in marrondorp Moiwana (1986). Die werden in de Binnenlandse Oorlog werden doodgeschoten door het regeringsleger van Desi Bouterse."
                            },
                            {
                                "example_id": "523afccc-2226-4a2d-8a97-f98f70ea48c1",
                                "sense_id": "26e81561-e9ba-31f1-a839-8090df3503fa",
                                "text": "Dit verdrag van 10 oktober 1760 tussen het koloniaal bestuur en de marrons werd getekend in het marrondorp Bongodoti aan de Mama Ndyukakreek."
                            }
                        ]
                    }
