                        "entry_id": "6186d93a-9e0c-3a96-9629-95b45834bed7",
                        "glosses": [
                            "gebogenes Brett, das vom Böttcher als Bauelement für Fässer oder ähnliche Holzgefäße genutzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "023f8e8c-2ea9-4abe-8a87-e0267d438995",
                                "sense_id": "a5b961b1-3533-3a2e-be66-399fe3498d54",
                                "text": "Als Kinder haben wir alte Fassdauben als Skier verwendet."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e644d755-1d3b-40e1-a85a-2b73485e7d3e",
                        "source_entry_id": "6186d93a-9e0c-3a96-9629-95b45834bed7",
                        "source_sense_id": "a5b961b1-3533-3a2e-be66-399fe3498d54",
                        "source_sense_description": "gebogenes Brett, das vom Böttcher als Bauelement für Fässer oder ähnliche Holzgefäße genutzt wird",
                        "target_lang_word": "stave",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stave",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b221086f-07fa-34e0-88b0-e3aa26cf6ff6",
                                        "entry_id": "37ddec21-50b1-341b-ae92-f379669644a3",
                                        "glosses": [
                                            "One of a number of narrow strips of wood, or narrow iron plates, placed edge to edge to form the sides, covering, or lining of a vessel or structure; especially, one of the strips which form the sides of a cask, barrel, pail, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27366ff1-0036-4600-8879-e36cf439575a",
                                                "sense_id": "b221086f-07fa-34e0-88b0-e3aa26cf6ff6",
                                                "text": "For the Cherubims ſpread foorth their wings ouer the place of the Arke, and the Cherubims couered the Arke and the ſtaues thereof, aboue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0e3e6c0-124b-389e-a029-381aa893cf59",
                                        "entry_id": "37ddec21-50b1-341b-ae92-f379669644a3",
                                        "glosses": [
                                            "One of the bars or rounds of a rack, rungs of a ladder, etc; one of the cylindrical bars of a lantern wheel"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5aea76a0-9adf-3c83-9f6d-1f9a147b3672",
                                        "entry_id": "37ddec21-50b1-341b-ae92-f379669644a3",
                                        "glosses": [
                                            "A metrical portion; a stanza; a staff."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16910484-2deb-407a-9f0e-babd5651e022",
                                                "sense_id": "5aea76a0-9adf-3c83-9f6d-1f9a147b3672",
                                                "text": "Let us chaunt a passing stave / In honour of that hero brave."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "502dc907-f92e-36a9-9b52-2ac0cbe3f2e1",
                                        "entry_id": "37ddec21-50b1-341b-ae92-f379669644a3",
                                        "glosses": [
                                            "The set of five horizontal and parallel lines on and between which musical notes are written or pointed; the staff."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b35c22c3-7b3e-394f-a777-91085c993e68",
                                        "entry_id": "37ddec21-50b1-341b-ae92-f379669644a3",
                                        "glosses": [
                                            "The initial consonant, consonant cluster, or vowel of a word which rhymes with another word with the same consonant or vowel in stave-rhyme."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2666f0de-03c1-404e-8fd2-fdf483a94d00",
                                                "sense_id": "b35c22c3-7b3e-394f-a777-91085c993e68",
                                                "text": "Ley, in his work on the Metrical Forms of Hebrew Poetry, 1866, has taken too little notice of these frequently occurring alliteration staves; Lagarde communicated to me (8th Sept. 1846) his view of the stave-rhyme in the Book[…]"
                                            },
                                            {
                                                "example_id": "f0672ad1-de6e-4cf8-9feb-06a688913895",
                                                "sense_id": "b35c22c3-7b3e-394f-a777-91085c993e68",
                                                "text": "[The] stave that binds the two halves of the line together the on-verse must be classified as D in spite of the f-stave . . stave-rhyme (OED s.v. Stave sb.)"
                                            },
                                            {
                                                "example_id": "2bef6fca-ce35-402f-95e2-bacbe7bd2a38",
                                                "sense_id": "b35c22c3-7b3e-394f-a777-91085c993e68",
                                                "text": "... consisting only of the two staves, folches . . . fehta. […] Line 63 contains the two-stave rhyme, aerist ... asckim; the suggested reduplicative rhyme [...] is technically doubtful according to the standards we have[…]"
                                            },
                                            {
                                                "example_id": "a5e796a1-9260-4f59-a13a-90b379b5a8e1",
                                                "sense_id": "b35c22c3-7b3e-394f-a777-91085c993e68",
                                                "text": "This may seem sparse and incomplete, but is reminiscent of the Old Norse stave rhyme technique in which one avoided two alliterating staves in one dipod – which the poets of that time considered superfluous."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6cb7e87-2deb-3aa6-8328-d47e968b8f76",
                                        "entry_id": "37ddec21-50b1-341b-ae92-f379669644a3",
                                        "glosses": [
                                            "A sign, symbol or sigil, including rune or rune-like characters, used in Icelandic magic."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f1e9555e-38a5-33d2-86b9-17f39a7bb412",
                                        "entry_id": "37ddec21-50b1-341b-ae92-f379669644a3",
                                        "glosses": [
                                            "A staff or walking stick."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "stave",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5f10fb7d-30cd-35f2-b28b-09a1e5e763df",
                                        "entry_id": "eb133f1d-c397-3714-9fa7-b67d70827c53",
                                        "glosses": [
                                            "To fit or furnish with staves or rundles."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca5354c9-297f-45fe-ba40-96bc5352a3b6",
                                                "sense_id": "5f10fb7d-30cd-35f2-b28b-09a1e5e763df",
                                                "text": "vpon paine of death to bring it out and to ſtaue it"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2adf964e-95f4-3332-88ec-438385ae4188",
                                        "entry_id": "eb133f1d-c397-3714-9fa7-b67d70827c53",
                                        "glosses": [
                                            "To break in the staves of; to break a hole in; to burst."
                                        ],
                                        "tags": [
                                            "transitive",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f13ef89-5733-4c1b-85a2-c3d6068188fc",
                                                "sense_id": "2adf964e-95f4-3332-88ec-438385ae4188",
                                                "text": "to stave in a cask"
                                            },
                                            {
                                                "example_id": "e34f755b-5742-4332-bb8b-24784ace3a2f",
                                                "sense_id": "2adf964e-95f4-3332-88ec-438385ae4188",
                                                "text": "A great Sea constant runs here upon the Rocks, and before they got to Land their Boat was stav’d in Pieces […]"
                                            },
                                            {
                                                "example_id": "ee7bdd62-c1ff-442b-b5b3-22329c07a863",
                                                "sense_id": "2adf964e-95f4-3332-88ec-438385ae4188",
                                                "text": "And therefore three cheers for Nantucket; and come a stove boat and stove body when they will, for stave my soul, Jove himself cannot."
                                            },
                                            {
                                                "example_id": "cc3efeb6-102f-452f-bb42-27fae3564291",
                                                "sense_id": "2adf964e-95f4-3332-88ec-438385ae4188",
                                                "text": "Be careful in the hunt, ye mates. Don’t stave the boats needlessly, ye harpooneers; good white cedar plank is raised full three per cent within the year."
                                            },
                                            {
                                                "example_id": "f853af10-3599-4859-94b4-2a45aa3ac3f2",
                                                "sense_id": "2adf964e-95f4-3332-88ec-438385ae4188",
                                                "text": "A little to one side a cask was being staved for the troopers who had come with the Duke; and on all the noisy, moving scene and the flags that streamed from the roofs and windows, and the shifting crowd, poured the ruddy light of a great bon-feu that burned on the farther side of the way."
                                            },
                                            {
                                                "example_id": "e919b528-90ce-407c-9ffa-6a3a48dce041",
                                                "sense_id": "2adf964e-95f4-3332-88ec-438385ae4188",
                                                "text": "[…]for the jagged butt of the fallen mast was dashing against the ship's side with such vicious blows that it seemed but a matter of seconds ere it would stave a hole in her."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c665fee5-710c-3868-a359-9b75a5b1e55a",
                                        "entry_id": "eb133f1d-c397-3714-9fa7-b67d70827c53",
                                        "glosses": [
                                            "To push, or keep off, as with a staff."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e79b64f4-c390-43ac-91ac-d7e3e196a605",
                                                "sense_id": "c665fee5-710c-3868-a359-9b75a5b1e55a",
                                                "text": "The condition of a servant staves him off to a distance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b8a7c6d-4bf0-3cdd-8fbb-8cf66967cdee",
                                        "entry_id": "eb133f1d-c397-3714-9fa7-b67d70827c53",
                                        "glosses": [
                                            "To delay by force or craft; to drive away."
                                        ],
                                        "tags": [
                                            "transitive",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df7c6d68-48d5-4af8-be9b-60a6e5b1234e",
                                                "sense_id": "2b8a7c6d-4bf0-3cdd-8fbb-8cf66967cdee",
                                                "text": "We ate grass in an attempt to stave off our hunger."
                                            },
                                            {
                                                "example_id": "78a3b728-1eef-496b-85e1-8c976bd07840",
                                                "sense_id": "2b8a7c6d-4bf0-3cdd-8fbb-8cf66967cdee",
                                                "text": "Congress had authorized seeds to be granted to the farmers there to stave hunger, but President Cleveland vetoed the bill."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a4ebbe6-41eb-3325-9382-e07442e6fbc6",
                                        "entry_id": "eb133f1d-c397-3714-9fa7-b67d70827c53",
                                        "glosses": [
                                            "To burst in pieces by striking against something."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "intransitive",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "146ce549-9ff2-466c-9d42-6cb95150d914",
                                                "sense_id": "9a4ebbe6-41eb-3325-9382-e07442e6fbc6",
                                                "text": "But Donald would not hear of that proposal at all, assuring the Prince that it was impossible for them to return to the land again, because the squall was against them, and that if they should steer for the rock the boat would undoubtedly stave to pieces and all of them behoved to be drowned, for there was no [fol. 284.] possibility of saving any one life amongst them upon such a dangerous rock, where the sea was dashing with the utmost violence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41e94765-0baa-3357-8d6a-388c3a33ca03",
                                        "entry_id": "eb133f1d-c397-3714-9fa7-b67d70827c53",
                                        "glosses": [
                                            "To walk or move rapidly."
                                        ],
                                        "tags": [
                                            "dated",
                                            "dialectal",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9c1b81a-c7b2-4049-9c03-55dd8c3bea40",
                                                "sense_id": "41e94765-0baa-3357-8d6a-388c3a33ca03",
                                                "text": "He turned and blundered out of the house, stumbling over a chair and trying a wrong door on the way, and went staving down the street as if afraid to look behind him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5942792c-14f9-3e5f-b8be-97a5435c8bae",
                                        "entry_id": "eb133f1d-c397-3714-9fa7-b67d70827c53",
                                        "glosses": [
                                            "To suffer, or cause to be lost by breaking the cask."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd46e620-e124-48a9-bb4f-a34b434d68b3",
                                                "sense_id": "5942792c-14f9-3e5f-b8be-97a5435c8bae",
                                                "text": "All the […]wine in the city hath been staved."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "584ac013-e009-30ca-8857-d6b674cb0477",
                                        "entry_id": "eb133f1d-c397-3714-9fa7-b67d70827c53",
                                        "glosses": [
                                            "To render impervious or solid by driving with a calking iron."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a304e30d-2d85-4b76-ab6c-183c91bf6e93",
                                                "sense_id": "584ac013-e009-30ca-8857-d6b674cb0477",
                                                "text": "to stave lead, or the joints of pipes into which lead has been run"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "601d44f4-7203-459a-b3f6-607ef600ae28",
