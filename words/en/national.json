{
    "word_family": [
        "nation",
        "nationality",
        "nationalize",
        "nationalism",
        "nationalist",
        "international",
        "internationally",
        "transnational"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d379fde0-3905-3460-a5a0-0ffd9efdec6c",
                    "sense_definition": "Relating to a whole nation or country rather than part of it or other nations.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "general_scope",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government declared a <w>national</w> holiday to celebrate the victory.",
                            "target_lang_translations": {
                                "ru": "Правительство объявило <w>государственный</w> праздник, чтобы отпраздновать победу.",
                                "zh": "政府宣布设立一个<w>全国性的</w>假日来庆祝胜利。"
                            }
                        },
                        {
                            "text": "We need to improve our <w>national</w> security to protect the citizens.",
                            "target_lang_translations": {
                                "ru": "Нам нужно улучшить нашу <w>национальную</w> безопасность для защиты граждан.",
                                "zh": "为了保护公民，我们需要加强<w>国家的</w>安全。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "national anthem",
                        "national park",
                        "national security",
                        "national interest"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к целой нации или стране, а не к её части или другим нациям.",
                        "zh": "与整个国家有关的，而不是只涉及其中一部分或其他国家的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "национальный",
                                "target_lang_sense_clarification": "относящийся к нации"
                            },
                            {
                                "target_lang_word": "государственный",
                                "target_lang_sense_clarification": "относящийся к государству"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "全国性的",
                                "target_lang_sense_clarification": "与整个国家范围有关，而不是地方性的"
                            },
                            {
                                "target_lang_word": "国家的",
                                "target_lang_sense_clarification": "与国家本身或国家层面有关"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f9789679-1535-3f48-936d-e63c2db0f7e1",
                    "sense_definition": "Typical of or specific to a particular nation or its people.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "characteristic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pizza is often considered the <w>national</w> dish of Italy.",
                            "target_lang_translations": {
                                "ru": "Пиццу часто считают <w>национальным</w> блюдом Италии.",
                                "zh": "披萨常被认为是意大利<w>国家特有的</w>菜肴之一。"
                            }
                        },
                        {
                            "text": "The dancers wore the <w>national</w> costume during the parade.",
                            "target_lang_translations": {
                                "ru": "Танцоры были одеты в <w>национальные</w> костюмы во время парада.",
                                "zh": "舞者们在游行中穿着<w>民族的</w>服装。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "national dish",
                        "national costume",
                        "national identity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Характерный или специфичный для конкретной нации или её народа.",
                        "zh": "某个国家或其人民所特有的、典型的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "национальный",
                                "target_lang_sense_clarification": "свойственный нации"
                            },
                            {
                                "target_lang_word": "народный",
                                "target_lang_sense_clarification": "относящийся к культуре народа"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "民族的",
                                "target_lang_sense_clarification": "具有某个民族或国家的典型文化特征"
                            },
                            {
                                "target_lang_word": "国家特有的",
                                "target_lang_sense_clarification": "某国特有的、代表该国的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b6de88cd-bc8c-3506-816b-840253afcac6",
                    "sense_definition": "Having or expressing strong love and support for one's own country.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "patriotic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His <w>national</w> pride was evident in every speech he gave to the public.",
                            "target_lang_translations": {
                                "ru": "Его <w>национальная</w> гордость была очевидна в каждой речи, с которой он обращался к публике.",
                                "zh": "他每次公开演讲时流露出的<w>爱国</w>自豪感都很明显。"
                            }
                        },
                        {
                            "text": "The poet expressed deep <w>national</w> sentiments in his early works.",
                            "target_lang_translations": {
                                "ru": "Поэт выражал глубокие <w>национальные</w> чувства в своих ранних работах.",
                                "zh": "这位诗人在早期作品中表达了深厚的<w>爱国</w>情感。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Испытывающий или выражающий сильную любовь и поддержку своей стране.",
                        "zh": "对自己的国家怀有或表达强烈热爱与支持的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "национальный",
                                "target_lang_sense_clarification": "патриотический"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "爱国的",
                                "target_lang_sense_clarification": "表现出对自己国家的热爱与支持"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f1eb1dee-5f80-33e1-b719-0e72c4e61911",
                    "sense_definition": "A citizen or subject of a particular country, especially when living abroad.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The embassy provides assistance to foreign <w>nationals</w> in case of emergency.",
                            "target_lang_translations": {
                                "ru": "Посольство оказывает помощь иностранным <w>гражданам</w> в случае чрезвычайной ситуации.",
                                "zh": "遇到紧急情况时，大使馆会为外国<w>公民</w>提供帮助。"
                            }
                        },
                        {
                            "text": "He is a French <w>national</w> who has been working in London for five years.",
                            "target_lang_translations": {
                                "ru": "Он французский <w>гражданин</w>, который работает в Лондоне уже пять лет.",
                                "zh": "他是一名法国<w>公民</w>，已经在伦敦工作五年了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "foreign national",
                        "third-country national"
                    ],
                    "target_lang_definitions": {
                        "ru": "Гражданин или подданный конкретной страны, особенно проживающий за границей.",
                        "zh": "某个国家的公民或国民，尤指居住在国外时。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гражданин",
                                "target_lang_sense_clarification": "подданный государства"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "公民",
                                "target_lang_sense_clarification": "特定国家的国籍持有者，尤指在国外时"
                            },
                            {
                                "target_lang_word": "国民",
                                "target_lang_sense_clarification": "较正式说法，指一国国籍所属者"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "502aaf67-8591-3d30-84e7-6e03bb9e7015",
                    "sense_definition": "A sports competition involving participants from all parts of a country.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "event",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After winning the regional games, the team advanced to the <w>nationals</w>.",
                            "target_lang_translations": {
                                "ru": "После победы на региональных играх команда прошла на <w>национальный чемпионат</w>.",
                                "zh": "在赢得地区比赛后，这支队伍晋级了<w>全国锦标赛</w>。"
                            }
                        },
                        {
                            "text": "She trained every day hoping to win a medal at the <w>nationals</w>.",
                            "target_lang_translations": {
                                "ru": "Она тренировалась каждый день, надеясь выиграть медаль на <w>первенстве страны</w>.",
                                "zh": "她每天训练，希望能在<w>全国锦标赛</w>上赢得奖牌。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "the nationals",
                        "make it to nationals"
                    ],
                    "target_lang_definitions": {
                        "ru": "Спортивное соревнование с участием представителей со всех частей страны.",
                        "zh": "由全国各地选手参加的体育比赛。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "национальный чемпионат",
                                "target_lang_sense_clarification": "соревнование"
                            },
                            {
                                "target_lang_word": "первенство страны",
                                "target_lang_sense_clarification": "соревнование"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "全国锦标赛",
                                "target_lang_sense_clarification": "全国范围的体育比赛"
                            },
                            {
                                "target_lang_word": "全国赛",
                                "target_lang_sense_clarification": "较口语的说法，指全国级别赛事"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eb1c533b-11f6-37ae-ad63-dc755b965819",
                    "sense_definition": "A newspaper that is sold and read throughout a whole country.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "publication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scandal was reported in all the <w>nationals</w> the following morning.",
                            "target_lang_translations": {
                                "ru": "О скандале сообщили во всех <w>центральных газетах</w> на следующее утро.",
                                "zh": "第二天早上，所有<w>全国性报纸</w>都报道了这起丑闻。"
                            }
                        },
                        {
                            "text": "He prefers reading the <w>nationals</w> to keep up with major political news.",
                            "target_lang_translations": {
                                "ru": "Он предпочитает читать <w>общенациональные газеты</w>, чтобы быть в курсе главных политических новостей.",
                                "zh": "为了及时了解重大政治新闻，他更喜欢看<w>全国性报纸</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Газета, которая продается и читается по всей стране.",
                        "zh": "在全国范围内发行和阅读的报纸。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "центральная газета",
                                "target_lang_sense_clarification": "пресса"
                            },
                            {
                                "target_lang_word": "общенациональная газета",
                                "target_lang_sense_clarification": "пресса"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "全国性报纸",
                                "target_lang_sense_clarification": "面向全国发行和阅读的报纸"
                            },
                            {
                                "target_lang_word": "全国报纸",
                                "target_lang_sense_clarification": "强调覆盖全国范围的报纸"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b93272c5-686d-32e9-9db1-3399c3af5391",
                    "sense_definition": "A member or supporter of the National Party.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "politics_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Several <w>Nationals</w> voted against the proposed bill in parliament.",
                            "target_lang_translations": {
                                "ru": "Несколько <w>членов Национальной партии</w> проголосовали против предложенного законопроекта в парламенте.",
                                "zh": "几位<w>国家党党员</w>在议会中投票反对这项提议中的法案。"
                            }
                        },
                        {
                            "text": "He has been a loyal <w>National</w> for over twenty years.",
                            "target_lang_translations": {
                                "ru": "Он был верным <w>сторонником Национальной партии</w> более двадцати лет.",
                                "zh": "二十多年来，他一直是忠实的<w>国家党支持者</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Nat"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "New Zealand"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Член или сторонник Национальной партии.",
                        "zh": "国家党的成员或支持者。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "член Национальной партии",
                                "target_lang_sense_clarification": "политика"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "国家党党员",
                                "target_lang_sense_clarification": "新西兰国家党的成员"
                            },
                            {
                                "target_lang_word": "国家党支持者",
                                "target_lang_sense_clarification": "支持新西兰国家党的人"
                            }
                        ]
                    }
                }
            ]
        },
        {
