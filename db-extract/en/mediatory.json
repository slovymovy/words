                        "glosses": [
                            "Of or relating to mediation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8600dc5e-e7ca-47ef-8c19-bfdc942d32a2",
                                "sense_id": "72cc2c97-d97f-30c1-bb98-380f45315443",
                                "text": "This Mediatory Honour is very glorious, because Christ sits as a King at the right hand of the Majesty on high, and every one must confesse that our Royall Mediatour is not onely man but God also […]."
                            },
                            {
                                "example_id": "bf399e19-3924-4a0e-954e-443063f6d655",
                                "sense_id": "72cc2c97-d97f-30c1-bb98-380f45315443",
                                "text": "[…] we do earnestly entreat his majesty, as yet the only mediatory power between the several states of the British empire, to recommend to his parliament of Great Britain the total revocation of these acts […]"
                            },
                            {
                                "example_id": "9f896772-2abe-436f-a820-729ba5f08a19",
                                "sense_id": "72cc2c97-d97f-30c1-bb98-380f45315443",
                                "text": "[T]here was a widespread ambition that the United States should evoke some sort of permanent arbitration council alone, or in concert with the other Powers still neutral, which should stand, so to speak, on the edge of the battlefield and continue to offer its mediatory services to the warring governments until they were accepted."
                            },
                            {
                                "example_id": "4e8e23c6-5570-49d0-9757-998950517209",
                                "sense_id": "72cc2c97-d97f-30c1-bb98-380f45315443",
                                "text": "He said the EU supported the mediatory efforts of Zuma to forge agreement between the squabbling political parties."
                            }
                        ]
                    }
