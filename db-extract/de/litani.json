                "senses": [
                    {
                        "sense_id": "11605f53-1818-36cf-9701-2421fdb60e11",
                        "entry_id": "16676712-7efc-3b16-a5d3-dea44773f067",
                        "glosses": [
                            "Fluss im Südlibanon"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bcd83c4e-351d-4712-a20d-9a8a9b721ab4",
                                "sense_id": "11605f53-1818-36cf-9701-2421fdb60e11",
                                "text": "„Ben Gurions Tagebucheintrag vom 24. Mai, nach einer Sitzung mit seinen Beratern, klingt triumphierend und machthungriger denn je: Wir werden einen christlichen Staat im Libanon schaffen, dessen Südgrenze der Litani sein wird.“"
                            },
                            {
                                "example_id": "352f8774-d6a6-4225-a855-2960c2a95fff",
                                "sense_id": "11605f53-1818-36cf-9701-2421fdb60e11",
                                "text": "„Rabin legte Eschkol die idealen Grenzen Israels dar; seiner Ansicht nach sollten sie am Jordan, am Suezkanal und im Norden am Fluss Litani verlaufen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
