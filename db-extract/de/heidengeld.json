                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94e73f8f-1a13-4bd2-83c8-4ac13d85dcad",
                                "sense_id": "7f87b4ae-627f-3d82-8e36-85e93ef5b025",
                                "text": "„Auf dem Bildschirm stellt ein Dienstmädchen eine Vase mit frisch geschnittenen Pfingstrosen auf ein Fensterbrett in unserem Haus in Dubai, und meine Mutter, die das per Satellit beobachtet, dreht über ihre Drahtlosverbindung die Aircondition runter, bis es in dem Haus, in diesem einen Zimmer, kalt wie in einem Kühlschrank ist, kalt wie auf einer Skipiste, verpulvert ein Heidengeld für Halogenkohlenwasserstoff und Strom, nur damit ein paar todgeweihte hübsche rosa Blumen im Wert von zehn Dollar vielleicht noch einen Tag länger frisch bleiben.“"
                            },
                            {
                                "example_id": "41846068-bb66-4228-8255-1b0c0468e330",
                                "sense_id": "7f87b4ae-627f-3d82-8e36-85e93ef5b025",
                                "text": "„Diesen Neal Carey ausfindig zu machen, kostete ein Heidengeld, aber das war es wert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
