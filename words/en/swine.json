                    "sense_definition": "A derogatory slang term for a police officer.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "contemptible_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The angry demonstrators hurled insults at the <w>swine</w> blocking the street.",
                            "target_lang_translations": {
