                                                "sense_id": "e1fa75f4-0007-34d2-ac9e-7571b8b21b5f",
                                                "text": "„Bis auf die Mohajirin leben alle ethnischen Gruppen mehrheitlich in den gleichnamigen Provinzen.“"
                                            }
