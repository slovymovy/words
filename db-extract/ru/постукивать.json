                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cb94b445-6dcd-332f-8717-6b73a5c8e9c1",
                                        "entry_id": "4b4c7c6c-23d1-3c40-91b7-675c98ac369c",
                                        "glosses": [
                                            "Jouer maladroitement du piano."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cba8f6a2-7c66-4995-a80a-95859b85043b",
                                                "sense_id": "cb94b445-6dcd-332f-8717-6b73a5c8e9c1",
                                                "text": "Elle en aura fait, non pas de ces petites poupées gentilles qui savent charlestonner, pianoter, se servir avec art de la poudre de riz et du rouge, mais sont incapables de faire un pot-au-feu réussi."
                                            },
                                            {
                                                "example_id": "b63c01df-296b-4f38-86a7-a00b65b25283",
                                                "sense_id": "cb94b445-6dcd-332f-8717-6b73a5c8e9c1",
                                                "text": "Le violon restait maintenant dans sa boîte et, s’il pianotait encore de loin en loin, c’était par une espèce de phénomène d’aimantation, parce que passant près d’un piano il est difficile de n’en pas soulever le couvercle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "feae9d82-2288-34ee-9aaf-ec26fee5fc67",
                                        "entry_id": "4b4c7c6c-23d1-3c40-91b7-675c98ac369c",
                                        "glosses": [
                                            "Tapoter avec les doigts."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "acc412bd-17fc-4521-aeee-ad61499924ad",
                                                "sense_id": "feae9d82-2288-34ee-9aaf-ec26fee5fc67",
                                                "text": "En même temps, avide de se distraire, il pianotait au carreau."
                                            },
                                            {
                                                "example_id": "ddb70e6b-2132-493e-888b-296b6e9bdcc5",
                                                "sense_id": "feae9d82-2288-34ee-9aaf-ec26fee5fc67",
                                                "text": "Mado … se tenait en retrait, pianotant sur le guéridon avec toute la nervosité d'une personne impatiente de triompher; …."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8aa3cbac-e133-3923-9c78-5a0903beb3bf",
                                        "entry_id": "4b4c7c6c-23d1-3c40-91b7-675c98ac369c",
                                        "glosses": [
                                            "Taper au clavier d’un ordinateur ou d’un autre type d’équipement."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce979636-7f18-4180-81d1-16b40d2e14df",
                                                "sense_id": "8aa3cbac-e133-3923-9c78-5a0903beb3bf",
                                                "text": "Il a passé la nuit à pianoter sur son clavier."
                                            },
                                            {
                                                "example_id": "fa397e4f-624b-45de-8610-a8cf2cc8815e",
                                                "sense_id": "8aa3cbac-e133-3923-9c78-5a0903beb3bf",
                                                "text": "Chacune, sur son téléphone intelligent, pianote un message à quelqu'un d'autre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
