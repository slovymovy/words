        "fr-extract.jsonl": [
            {
                "entry_id": "567c5506-6e38-3d8f-a73e-33a4fb67ff4d",
                "word": "viride",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "94412c96-3d77-3e3f-972d-9600e123e7e9",
                        "entry_id": "567c5506-6e38-3d8f-a73e-33a4fb67ff4d",
                        "glosses": [
                            "D’un vert un peu sombre, mais soutenu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "774ddfad-6257-4668-815f-e9c72dd92ad2",
                                "sense_id": "94412c96-3d77-3e3f-972d-9600e123e7e9",
                                "text": "U, cycles, vibrements divins des mers virides,\nPaix des pâtis semés d’animaux, paix des rides\nQue l’alchimie imprime aux grands fronts studieux."
                            },
                            {
                                "example_id": "f40b9c89-a130-4f5e-b61a-0fadb6d8be44",
                                "sense_id": "94412c96-3d77-3e3f-972d-9600e123e7e9",
                                "text": "Son pourpoint est de soie, et ses poignards superbes\nPortent sur leurs pommeaux, parmi l’argent en gerbes\nLa viride émeraude et le clair diamant."
                            },
                            {
                                "example_id": "323ae2da-e3a5-42ea-9c4b-696a45354b1e",
                                "sense_id": "94412c96-3d77-3e3f-972d-9600e123e7e9",
                                "text": "Croyez que l’on puisse disposer d’une cruche assez admirablement ouvrée pour qu’elle s’use si régulièrement que l’on puisse voir, au terme de sa vie de cruche, le soleil au travers, viride comme l’or des batteurs ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "60daaa03-838c-4785-9db6-c887cf60450e",
                        "source_entry_id": "567c5506-6e38-3d8f-a73e-33a4fb67ff4d",
                        "source_sense_id": "94412c96-3d77-3e3f-972d-9600e123e7e9",
                        "target_lang_word": "viridian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "viridian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c191c77b-16c3-313d-9578-8243a12c7867",
                                        "entry_id": "a40755e8-2194-3ffb-bbb8-1d20909c9a13",
                                        "glosses": [
                                            "A bluish-green pigment made from chromium sesquioxide."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92de727e-30fd-4371-9918-7b4b84b10111",
                                                "sense_id": "c191c77b-16c3-313d-9578-8243a12c7867",
                                                "text": "It would be difficult to exaggerate the value of this addition to the artist’s palette. The colour of viridian is a very deep bluish green of great purity and transparency. It furnishes, with aureolin on the one hand and with ultramarine on the other, an immense number of beautiful hues, adapted to represent the colours of vegetation and of water."
                                            },
                                            {
                                                "example_id": "9aee3314-383a-405b-a2a8-2d1b158c8a9f",
                                                "sense_id": "c191c77b-16c3-313d-9578-8243a12c7867",
                                                "text": "Then Miss Sloviak emerged from the ladies' room, hair reestablished, cheeks rouged, eyelids freshly painted a soft viridian, smelling of what I recognised as Cristalle, the fragrance worn both by my wife, Emily, and also by my lover, Sara Gaskell."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3487941-4d57-3b2e-a5c0-74f3a8e61dae",
                                        "entry_id": "a40755e8-2194-3ffb-bbb8-1d20909c9a13",
                                        "glosses": [
                                            "A bluish-green color."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "viridian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1b1dd989-1feb-3836-bc07-88334ff24379",
                                        "entry_id": "f3d4423a-03d1-323f-aa2d-c225693af1d6",
                                        "glosses": [
                                            "Of a bluish green colour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3aa0198b-ad8a-4af1-9e41-d4144e72a06a",
                                                "sense_id": "1b1dd989-1feb-3836-bc07-88334ff24379",
                                                "text": "spring sweeps the wood’s cathedral nave\nwith the green fury of a wave,\ntill oak and elm and beech and ash\nin one viridian comber crash,\nwhile at their feet red vetches shine,\nsharp, and cold, and coralline."
                                            },
                                            {
                                                "example_id": "1c22c464-62cd-4793-80fb-1f0996869497",
                                                "sense_id": "1b1dd989-1feb-3836-bc07-88334ff24379",
                                                "text": "We walked out on to a balcony, looking down on the bright green fields, the grey-blue river lined with viridian poplars, and the red earth paths where the peasants were driving their animals […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
            {
                "entry_id": "c20ba503-9249-39ca-b626-54b0bc65fd7e",
                "word": "viride",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "25bbc86f-4b76-3078-a6bd-f6b14197e34a",
                        "entry_id": "c20ba503-9249-39ca-b626-54b0bc65fd7e",
                        "glosses": [
                            "Pigment d’oxyde de chrome, d’un vert bleuté assez foncé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1d9e1a0-26e9-4fe2-ae64-e5baf44e4071",
                                "sense_id": "25bbc86f-4b76-3078-a6bd-f6b14197e34a",
                                "text": "… ils commencèrent à peindre les étendues vertes sur lesquelles Eve allait semer les soixante-sept tiges d’aconit, peintes au violet de manganèse, à la dioxazine mauve et au violet de carbazole, tandis que du viride et du jaune du Cambodge seraient utilisés pour les tiges vertes comme de l’herbe et les grandes feuilles palmées."
                            }
                        ]
                    },
                    {
                        "sense_id": "70e7c196-68a7-3ab0-8c8c-3fcda234b900",
                        "entry_id": "c20ba503-9249-39ca-b626-54b0bc65fd7e",
                        "glosses": [
                            "Couleur de ce pigment. #40826d"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73d576ff-0b5a-4371-a62d-966261c4b7eb",
                                "sense_id": "70e7c196-68a7-3ab0-8c8c-3fcda234b900",
                                "text": "Pour les zones où la couleur était claire, j’ai mélangé du jaune citron et du viride."
                            }
                        ]
                    }
                ],
