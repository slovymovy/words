                "senses": [
                    {
                        "sense_id": "e3149c81-7f1e-345a-8c5e-25be78eb4da3",
                        "entry_id": "77282cdd-22d4-3542-b599-9bfe19fb86f9",
                        "glosses": [
                            "A female given name from Latin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61af92eb-7ff8-4685-9afb-4a6ea198dcda",
                                "sense_id": "e3149c81-7f1e-345a-8c5e-25be78eb4da3",
                                "text": "O grave and good Paulina, the great comfort / That I have had of thee!"
                            },
                            {
                                "example_id": "61407731-47f5-436c-a3bc-cd8372dece1d",
                                "sense_id": "e3149c81-7f1e-345a-8c5e-25be78eb4da3",
                                "text": "She smells like expensive soap and her teeth are shiny-white. She does not in any way look like her name. It's not her fault that she was born in a time when people believed in names like Wanda, Dottie and Betty. She's more of a Vanessa or Paulina."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
