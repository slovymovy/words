                "senses": [
                    {
                        "sense_id": "29abfe90-e517-3ad6-9b43-bf77b2dc2952",
                        "entry_id": "3130d497-a2f1-37ec-ac5d-1954899e6345",
                        "glosses": [
                            "Of, like, or pertaining to a wolf."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "819b7ea2-06da-3a6e-9f5d-e23bf1771610",
                        "entry_id": "3130d497-a2f1-37ec-ac5d-1954899e6345",
                        "glosses": [
                            "Of, like, or pertaining to a wolf.",
                            "Suggestive or characteristic of a wolf."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc3bb8d1-8ece-47e0-a300-c3be9ef0a206",
                                "sense_id": "819b7ea2-06da-3a6e-9f5d-e23bf1771610",
                                "text": "a wolfish appetite"
                            },
                            {
                                "example_id": "acbf8553-0b0a-41bd-8d27-a4cbf9447302",
                                "sense_id": "819b7ea2-06da-3a6e-9f5d-e23bf1771610",
                                "text": "“[…] Here, Fangs! Fangs!” he ejaculated at the top of his voice to a ragged wolfish-looking dog […]"
                            },
                            {
                                "example_id": "fd6546d5-bfe1-40c2-a769-09b08274e76d",
                                "sense_id": "819b7ea2-06da-3a6e-9f5d-e23bf1771610",
                                "text": "He had never seen dogs fight as these wolfish creatures fought, and his first experience taught him an unforgetable lesson. It is true, it was a vicarious experience, else he would not have lived to profit by it."
                            }
                        ]
                    },
                    {
                        "sense_id": "bc68172c-55b3-35d9-867b-57a20e6587af",
                        "entry_id": "3130d497-a2f1-37ec-ac5d-1954899e6345",
                        "glosses": [
                            "Fierce; menacing; savage."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ce18cba9-00f4-4724-820b-62b0ff50389b",
                        "source_entry_id": "3130d497-a2f1-37ec-ac5d-1954899e6345",
                        "source_sense_description": "pertaining to wolves",
                        "target_lang_word": "lupin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lupin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5906bc8e-78b3-3009-a089-ce0adc6edbae",
                                        "entry_id": "30420139-2634-3082-a67a-1e0541b6b83e",
                                        "glosses": [
                                            "Fabacée à feuilles disposées en éventail. → voir Lupinus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58ec14f6-8891-48bd-bdf5-88e0ed9e44f5",
                                                "sense_id": "5906bc8e-78b3-3009-a089-ce0adc6edbae",
                                                "text": "Pour les vaches laitières, le lupin s’utilise en remplacement du concentré classique tourteaux de soja/céréales."
                                            },
                                            {
                                                "example_id": "e7138a90-8057-457c-88e5-27c2ee9e076f",
                                                "sense_id": "5906bc8e-78b3-3009-a089-ce0adc6edbae",
                                                "text": "Bref, on doit 'désamertumer' les lupins après cuisson."
                                            },
                                            {
                                                "example_id": "f9e91e24-0151-419d-aedc-58f428b69008",
                                                "sense_id": "5906bc8e-78b3-3009-a089-ce0adc6edbae",
                                                "text": "Côté santé, le café de lupin est riche en fibres, en minéraux et en vitamine E."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lupin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6a7c9e89-b3b8-3a1f-816e-5a6ae7898114",
                                        "entry_id": "a0afe561-39ac-38d2-b260-7ec819eedeb7",
                                        "glosses": [
                                            "Loup-garou."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2ce060b-b20b-4d8b-8810-49c7f2589530",
                                                "sense_id": "6a7c9e89-b3b8-3a1f-816e-5a6ae7898114",
                                                "text": "Soit que ces esprits-bêtes fussent d’une race plus hardie que les lubins et lupins ordinaires, soit que le tailleur fût si laid, si laid, qu’il ne leur fit pas l’effet d'un chrétien, ils ne bougèrent tout le temps qu’il passa devant eux."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lupin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9d247f5b-856b-3e9e-a1a8-5df73d16dafe",
                                        "entry_id": "53feaf8b-d581-347f-8fe5-bd1cd8daf1d2",
                                        "glosses": [
                                            "Qui concerne le loup."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64bb7c77-d44c-4a4f-9af2-e82a82eb274f",
                                                "sense_id": "9d247f5b-856b-3e9e-a1a8-5df73d16dafe",
                                                "text": "(…) ce qui a fragmenté et réduit drastiquement les dernières populations lupines."
                                            },
                                            {
                                                "example_id": "dfe000ed-5c2d-44df-9f6b-3ae906fac3b1",
                                                "sense_id": "9d247f5b-856b-3e9e-a1a8-5df73d16dafe",
                                                "text": "Puis mon loup a fermé les paupières d’un geste incroyable, qui allait à l’encontre de tout instinct lupin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
