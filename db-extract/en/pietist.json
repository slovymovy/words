                "senses": [
                    {
                        "sense_id": "cc76fd3e-d331-3f80-8e55-f5e55ac4ae35",
                        "entry_id": "2ebb687c-7056-3a04-8b33-b9a0035d74dc",
                        "glosses": [
                            "A supporter of pietism."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc00da2a-b440-46a9-991f-f0349beaad3e",
                                "sense_id": "cc76fd3e-d331-3f80-8e55-f5e55ac4ae35",
                                "text": "What a commentary on our professional piety as a people and our pretence to morality as a city, when there can exist and flourish in our midst, right under the noses of priest, person, police and platitudinising pietist such a RED-HOT HELL HOLE as the specimen one into whose sultry recesses the scribes had made their way by means of a little mild deception."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "531c8107-40fd-4247-bcd8-8bc04911abbb",
                        "source_entry_id": "2ebb687c-7056-3a04-8b33-b9a0035d74dc",
                        "source_sense_id": "cc76fd3e-d331-3f80-8e55-f5e55ac4ae35",
                        "source_sense_description": "supporter of pietism",
                        "target_lang_word": "piétiste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "piétiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "101e5804-810d-3ff0-a595-425feb17ea02",
                                        "entry_id": "097b7522-6632-30ec-b8b3-2b89cf0280d2",
                                        "glosses": [
                                            "Membre d’une secte protestante, fondée par Spener, qui s’attache à la lettre de l’évangile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1e4412f-4ac1-4ce6-af44-9398d1de28fd",
                                                "sense_id": "101e5804-810d-3ff0-a595-425feb17ea02",
                                                "text": "Un piétiste, une piétiste."
                                            },
                                            {
                                                "example_id": "154c6edb-6986-4fe2-ae46-db912e9b5e54",
                                                "sense_id": "101e5804-810d-3ff0-a595-425feb17ea02",
                                                "text": "Un piétiste est, comme un autre, sujet aux faiblesses humaines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7a7a338-2b33-3408-9424-770f610f67a3",
                                        "entry_id": "097b7522-6632-30ec-b8b3-2b89cf0280d2",
                                        "glosses": [
                                            "Fantassin, soldat d'infanterie."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "piétiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "32d7676e-8bb9-3d0f-b80b-bf81e83b8041",
                                        "entry_id": "561c3f00-8c17-3873-835d-77ed7dd6b955",
                                        "glosses": [
                                            "Qui est relatif au piétisme, mouvement fondé par Philipp Jacob Spener (1635-1705)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31eaa91a-5ca8-4503-a3b4-ad0b7d62b254",
                                                "sense_id": "32d7676e-8bb9-3d0f-b80b-bf81e83b8041",
                                                "text": "La preuve que la ferveur piétiste avait peu à peu gagné un nombre croissant de pasteurs nous est fournie par deux faits."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81879527-766d-37fb-a332-75be5bd6330a",
                                        "entry_id": "561c3f00-8c17-3873-835d-77ed7dd6b955",
                                        "glosses": [
                                            "Se dit d'une communauté monastique consacrée la piété mais dont les membres ne prononcent pas de vœux perpétuels."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81551636-a324-4dbd-9c93-1a17ae79a301",
                                                "sense_id": "81879527-766d-37fb-a332-75be5bd6330a",
                                                "text": "Des groupes piétistes, de la Picardie à la Flandre — Béguards et Béguines —, puis sur le pourtour des Alpes, se fondent, encouragés par des clercs comme le prêtre liégeois Lambert le Bègue, mort en 1177 […]."
                                            },
                                            {
                                                "example_id": "cb854b46-db2c-46a3-ae33-1508c924d3e3",
                                                "sense_id": "81879527-766d-37fb-a332-75be5bd6330a",
                                                "text": "Jeanne lui a proposé de traduire en français un vieux livre tchèque qu’ils lisaient tous les deux dans une version anglaise. C’est un voyage allégorique tel qu’en a produit çà et là la littérature piétiste du XVIIᵉ siècle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae5046a5-7b68-3e9a-ba39-5cd6199bc49a",
                                        "entry_id": "561c3f00-8c17-3873-835d-77ed7dd6b955",
                                        "glosses": [
                                            "Qui est relatif au respect des pratiques religieuses."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f65dbba-edb3-42be-964d-07bfc7208bef",
                                                "sense_id": "ae5046a5-7b68-3e9a-ba39-5cd6199bc49a",
                                                "text": "Les murs blancs, nus, accentuaient l’atmosphère piétiste du lieu."
                                            },
                                            {
                                                "example_id": "6fe12749-9eb2-41f2-ab61-4a61977c33f3",
                                                "sense_id": "ae5046a5-7b68-3e9a-ba39-5cd6199bc49a",
                                                "text": "Arrivé en France en 1996, imam dans un foyer de Bobigny, ce Tunisien s'est formé théologiquement en Syrie et au Pakistan, dans le tabligh, un courant fondamentaliste, piétiste, apolitique et prosélyte de l'islam."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
