                "senses": [
                    {
                        "sense_id": "6ca24056-572a-3ee0-8300-1aff99b5a6dc",
                        "entry_id": "75a6ed66-feda-3045-9b31-25b11d59269a",
                        "glosses": [
                            "Sammelbegriff für die verschiedenen Berufssprachen der Handwerker"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d2057a5-5f72-4044-a570-a2545121d677",
                                "sense_id": "6ca24056-572a-3ee0-8300-1aff99b5a6dc",
                                "text": "„Malerei, Schnitzerei, Erzgießerei und Goldschmiedekunst aber kommen, wie die übrigen deutschen Handwerkssprachen, großenteils mit muttersprachlichen Wörtern aus.“"
                            },
                            {
                                "example_id": "dc30a075-82b9-4f62-a498-838072d18a6d",
                                "sense_id": "6ca24056-572a-3ee0-8300-1aff99b5a6dc",
                                "text": "„Meine Meisterprüfung, um in der Handwerkssprache zu bleiben, war mein Gesangsdiplom mit Auszeichnung und mein Magister artium.“"
                            },
                            {
                                "example_id": "748fd231-8f81-484b-88e3-849b65aeaf06",
                                "sense_id": "6ca24056-572a-3ee0-8300-1aff99b5a6dc",
                                "text": "„Solche Informationen gehören heute und morgen selbstverständlich zur guten Handwerkssprache unseres Berufes.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
