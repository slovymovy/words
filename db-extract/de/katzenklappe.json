                    },
                    {
                        "translation_id": "22b138e4-8d2f-4ca7-ac82-7c7aff354e4c",
                        "source_entry_id": "4aeabc20-b8f4-3b6a-b867-fcb4a58be6db",
                        "source_sense_id": "5b04732b-fba7-3ac4-8a3d-14fbd7baa4ab",
                        "target_lang_word": "kitty door",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "0ac41e8a-8dab-4724-a99d-643bb402dc9d",
                        "source_entry_id": "4aeabc20-b8f4-3b6a-b867-fcb4a58be6db",
                        "source_sense_id": "5b04732b-fba7-3ac4-8a3d-14fbd7baa4ab",
                        "target_lang_word": "chatière",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chatière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e38b07e1-9d74-310d-8c09-943c59bde58a",
                                        "entry_id": "99c23450-aad7-3524-8436-f5dae5cf16ab",
                                        "glosses": [
                                            "Ouverture qu’on pratique aux portes (ou aux toits des greniers) pour laisser passer les chats."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16d7e228-16bb-4465-91ee-9b041f520cae",
                                                "sense_id": "e38b07e1-9d74-310d-8c09-943c59bde58a",
                                                "text": "J'avisai alors, au niveau du parquet, un trou nommé chatière, qui existe dans les châteaux du Midi au bas de toutes les portes, afin de donner aux chats un libre accès dans les appartements."
                                            },
                                            {
                                                "example_id": "bfacac5a-08ca-4f89-821f-4ee5a328aee0",
                                                "sense_id": "e38b07e1-9d74-310d-8c09-943c59bde58a",
                                                "text": "Par un trou de carreau cassé rustiquement rebouché de papier, par la chatière d’une porte ou l’évidement d’un mur bas à l’endroit où passent les poutres, elle était parvenue, certaine nuit à couler dans la grange son corps vermiforme […]"
                                            },
                                            {
                                                "example_id": "ef725502-eeac-4364-9ba5-9e822d2ac2a6",
                                                "sense_id": "e38b07e1-9d74-310d-8c09-943c59bde58a",
                                                "text": "Marie Coquelière tenait entre ses jambes le moutard barbouillé de mûres, ouvrant, de la largeur d'une chatière, une bouche d'où sortaient sans répit des beuglements de porc échaudé."
                                            },
                                            {
                                                "example_id": "1e2ccd38-6347-47f3-b84c-5690e1cb1f7e",
                                                "sense_id": "e38b07e1-9d74-310d-8c09-943c59bde58a",
                                                "text": "Une chatière, trou rond, dissimulé par un clapet mobile ouvrant de-ci de-là, au gré des allées et venues de l’animal."
                                            },
                                            {
                                                "example_id": "1c2593b0-978c-4838-8a68-f233cafa58dd",
                                                "sense_id": "e38b07e1-9d74-310d-8c09-943c59bde58a",
                                                "text": "Pour remercier sa chatte Marion de lui avoir inspiré cette révélation, Isaac Newton eut l'idée de faire un trou carré dans le bas de sa porte afin de lui permettre d'entrer et de sortir de chez lui à sa guise. Il fut donc non seulement l'inventeur de la physique moderne, mais aussi de la… chatière."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ead2d86c-f1c1-3eab-bc35-2e943cf9fc14",
                                        "entry_id": "99c23450-aad7-3524-8436-f5dae5cf16ab",
                                        "glosses": [
                                            "Ouverture pratiquée pour la ventilation des toits."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "83da8aa0-e63b-3214-a3bd-3e0e200eb20c",
                                        "entry_id": "99c23450-aad7-3524-8436-f5dae5cf16ab",
                                        "glosses": [
                                            "Ouverture pratiquée pour l’écoulement des eaux d’un bassin."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "162c5b1e-323c-300a-8752-2d0d912cb2bd",
                                        "entry_id": "99c23450-aad7-3524-8436-f5dae5cf16ab",
                                        "glosses": [
                                            "Piège pour prendre les chats."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49eef3bb-f61f-4ddd-b68a-273f5d1fbeef",
                                                "sense_id": "162c5b1e-323c-300a-8752-2d0d912cb2bd",
                                                "text": "Par la faute du sieur Hulot, ces charmes, cette pureté, tout est devenu piége à loup, chatière à pièces de cent sous."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "724f43e7-6987-3026-8b62-fa0af71e34de",
                                        "entry_id": "99c23450-aad7-3524-8436-f5dae5cf16ab",
                                        "glosses": [
                                            "Passage étroit où l’on doit se glisser pour passer d’un endroit à un autre."
                                        ],
                                        "tags": [
                                            "Spéléologie",
                                            "Cataphilie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12f1aae3-bfb8-46e0-baac-5175f240277d",
                                                "sense_id": "724f43e7-6987-3026-8b62-fa0af71e34de",
                                                "text": "C’est le 3 septembre 1977, profitant d’une période d’étiage, que les spéléologues de la société Dijonnaise de plongée souterraine franchirent la chatière qui jusqu’alors s’était révélée infranchissable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aee52968-692f-41fd-8ed9-08bd0646a943",
                        "source_entry_id": "4aeabc20-b8f4-3b6a-b867-fcb4a58be6db",
