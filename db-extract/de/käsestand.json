                                "example_id": "809ab6e3-00ba-422f-b448-b1e5b98e16e4",
                                "sense_id": "1bd0b340-13de-39c1-8912-1c1ffa11f0c8",
                                "text": "„Hier drüben haben wir Mr. Walter Sickert, den Buchmacher... und Mr. James McNeil Whistler, der, glaube ich, einen Käsestand in Mile End besitzt.“"
                            },
                            {
                                "example_id": "062a7c25-4140-499b-855a-5bb8eefe659c",
                                "sense_id": "1bd0b340-13de-39c1-8912-1c1ffa11f0c8",
                                "text": "„Neben einem Käsestand, hinter den Holzkisten, sank er auf die Knie, nahm seinen Hut ab und legte ihn auf den Boden neben sich.“"
                            }
                        ],
