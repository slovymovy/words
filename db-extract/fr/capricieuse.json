                                "example_id": "2ac84310-ffba-4626-9314-2473c03b3f6e",
                                "sense_id": "a76783c3-f053-35b3-908f-1a0cb9dd51d6",
                                "text": "Depuis, elle est devenue une diva capricieuse, besnehardisée, bergerisée, BeHeLisée."
                            }
                        ]
                    }
