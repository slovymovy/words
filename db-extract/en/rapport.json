    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "9b6ded84-fc7c-3d56-8554-69a911adac60",
                "word": "rapport",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "bf84f884-84b2-489d-bd5b-fbd541bc5375",
                        "entry_id": "9b6ded84-fc7c-3d56-8554-69a911adac60",
                        "tags": [
                            "plural"
                        ],
                        "form": "rapports"
