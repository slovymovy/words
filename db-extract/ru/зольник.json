                "senses": [
                    {
                        "sense_id": "acf1f480-abb1-370b-9423-192a43b45601",
                        "entry_id": "61bd8e77-c186-38d9-a615-c314f0be4b3a",
                        "glosses": [
                            "нижняя часть топки, в которую падает зола"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c354d2e9-afaa-4614-9d49-5aa1dee4c3b1",
                                "sense_id": "acf1f480-abb1-370b-9423-192a43b45601",
                                "text": "Слева, куда протянулся паровоз, огнедышаще светился зольник, сыпалась жаркая светящаяся зола на полотно и относилась в сторону быстро."
                            },
                            {
                                "example_id": "1581baa7-b812-4f3c-9b11-67cd74f74da9",
                                "sense_id": "acf1f480-abb1-370b-9423-192a43b45601",
                                "text": "На четвёртый ряд, на который устанавливаются поддувало, зольник с колосником и заглушкой, идёт не простой кирпич, а огнеупорный."
                            }
                        ]
                    },
                    {
                        "sense_id": "e9972c90-08ad-3af2-b10b-30b21827d8f9",
                        "entry_id": "61bd8e77-c186-38d9-a615-c314f0be4b3a",
                        "glosses": [
                            ": известковый раствор для золения шкур"
                        ],
                        "tags": [
                            "в кожевенном деле"
                        ],
                        "examples": [
                            {
                                "example_id": "47ba885a-075f-4c92-bf97-4fee734eb3c2",
                                "sense_id": "e9972c90-08ad-3af2-b10b-30b21827d8f9",
                                "text": "Обмакнутую в зольнике кожу кидают в чан; двое или более других рабочих, вооружённых шестиками (грузилками), угружают брошенные кожи до дна зольного чана."
                            }
                        ]
                    },
                    {
                        "sense_id": "83738db5-2e03-37ec-a71b-9f9c587920de",
                        "entry_id": "61bd8e77-c186-38d9-a615-c314f0be4b3a",
                        "glosses": [
                            "чан, в котором золят шкуры"
                        ],
                        "tags": [
                            "в кожевенном деле"
                        ],
                        "examples": [
                            {
                                "example_id": "dad225b0-276d-4ccc-97df-5d483b95af59",
                                "sense_id": "83738db5-2e03-37ec-a71b-9f9c587920de",
                                "text": "Любил разминаться молодой приказчик и в цеху: вытащив из зольника клещами огромную кожу буйвола и разложив её «на кобыле», с наслаждением сбивал тупиком шерсть и верхний роговой слой до чистого голья."
                            }
                        ]
                    },
                    {
                        "sense_id": "790878b8-ba72-3ac3-8384-094edaec5245",
                        "entry_id": "61bd8e77-c186-38d9-a615-c314f0be4b3a",
                        "glosses": [
                            "старин. русская крестьянская кукла, сделанная из золы"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3195d421-24e5-4860-bb6e-e02fa4b47519",
                                "sense_id": "790878b8-ba72-3ac3-8384-094edaec5245",
                                "text": "На зольник сносили домашний сор, кости животных, разбитую посуду, игрушки."
                            },
                            {
                                "example_id": "bf862faa-8cac-4a71-829e-f318b0448101",
                                "sense_id": "790878b8-ba72-3ac3-8384-094edaec5245",
                                "text": "Например, куклы из золы (зольники) дарились на свадьбах, как пожелание потомства молодой семье, и служили также игрушкой."
                            }
                        ]
                    },
                    {
                        "sense_id": "aec7ca9c-2657-3ee3-af5b-d92c545b3724",
                        "entry_id": "61bd8e77-c186-38d9-a615-c314f0be4b3a",
                        "glosses": [
                            "археол. скопление золы на местах жертвоприношений в древних поселениях человека"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fe2c2044-45c2-4075-85e6-3ab4500653f9",
                        "source_entry_id": "61bd8e77-c186-38d9-a615-c314f0be4b3a",
                        "source_sense_description": "часть топки, в которую падает зола",
                        "target_lang_word": "ashpan",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ashpan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "22f73bed-0817-3353-8810-fd92b8fba438",
                                        "entry_id": "48e6a059-e99f-3a77-ba5f-a840e3de1218",
                                        "glosses": [
                                            "A container beneath a boiler's furnace, catching ash and clinker that falls through the firebars"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "540c7cab-59b3-33a8-84d0-e78e9ff86702",
                                        "entry_id": "48e6a059-e99f-3a77-ba5f-a840e3de1218",
                                        "glosses": [
                                            "A container that fits below the grate of a domestic fireplace."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "094993a9-6cd7-3ca8-9f7d-acbe163ac45d",
                                        "entry_id": "48e6a059-e99f-3a77-ba5f-a840e3de1218",
                                        "glosses": [
                                            "A large pan below the grate and firebox of a steam locomotive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66618dea-ee64-4f9d-8992-cc7ab374ec6d",
                                                "sense_id": "094993a9-6cd7-3ca8-9f7d-acbe163ac45d",
                                                "text": "They have been fitted with a complete rocking grate and a hopper ashpan so that the ashes can be released without the necessity for a man to go underneath the engine."
                                            },
                                            {
                                                "example_id": "4b64abdd-dffa-4f6c-a42e-b284282029d0",
                                                "sense_id": "094993a9-6cd7-3ca8-9f7d-acbe163ac45d",
                                                "text": "A new ashpan has been fitted, however, with four bottom doors for self-emptying, and a rocking grate with twelve rocking sections."
                                            },
                                            {
                                                "example_id": "16666a89-7111-4db8-b8d3-ced417cd43e5",
                                                "sense_id": "094993a9-6cd7-3ca8-9f7d-acbe163ac45d",
                                                "text": "During the day conditions worsened quickly—for example, a 2-6-0 on the Uckfield line suddenly encountered flood water high enough to enter its ashpan and extinguish its fire—until lock gates up-river at Barcombe gave way and a tidal wave rolled down the valley meeting head-on a spring tide rolling up from the coast."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "de84758f-4195-486d-a219-fe685f3423ff",
                        "source_entry_id": "61bd8e77-c186-38d9-a615-c314f0be4b3a",
                        "source_sense_description": "часть топки, в которую падает зола",
                        "target_lang_word": "ashpit",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ashpit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fc69297e-d3ef-30df-8006-2909de6a0e75",
                                        "entry_id": "31c4ed93-db87-3563-b882-7d4fdd9e27e2",
                                        "glosses": [
                                            "A pit for the disposal of ashes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10efb8c0-cbd0-4fe9-9645-f71a452a8676",
                                                "sense_id": "fc69297e-d3ef-30df-8006-2909de6a0e75",
                                                "text": "I hid my books in the long grass near the ashpit at the end of the garden where nobody ever came and hurried along the canal bank."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4978d690-836d-3448-805c-28e8aaec4b3b",
                                        "entry_id": "31c4ed93-db87-3563-b882-7d4fdd9e27e2",
                                        "glosses": [
                                            "a pit between the rails where a steam locomotive can drop its fire at the end of a day's work, before going \\\"on shed\\\"."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
