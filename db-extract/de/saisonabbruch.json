                "senses": [
                    {
                        "sense_id": "468703a2-ec9f-3880-8ea2-86a5b5110ec8",
                        "entry_id": "86362dd5-125f-3e88-a392-cdc5bd86df53",
                        "glosses": [
                            "vorzeitige Beendigung (der Teilnahme an) einer Spielzeit in einer Liga/einer Wettkampfserie et cetera einer bestimmten Sportart"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28d70e56-7b33-4100-9f9b-8cddb3737983",
                                "sense_id": "468703a2-ec9f-3880-8ea2-86a5b5110ec8",
                                "text": "„Kein Wunder, schließlich zeigen die Saisonabbrüche in Frankreich und den Niederlanden, was die Folgen sind. Klubs, die vom Saisonabbruch negativ betroffen sind, suchen ihr Glück auf juristischem Wege.“"
                            },
                            {
                                "example_id": "28bd05bb-b126-4ca1-946d-38780f5847bb",
                                "sense_id": "468703a2-ec9f-3880-8ea2-86a5b5110ec8",
                                "text": "„Der Berlin-Ligist hatte aufgrund des Saisonabbruchs Platz eins unglücklich verpasst.“"
                            },
                            {
                                "example_id": "2b223953-0abb-496f-b1ad-f692d925b45b",
                                "sense_id": "468703a2-ec9f-3880-8ea2-86a5b5110ec8",
                                "text": "„Vor dem heiklen Start der Geisterspiele entzweit vor allem die Abstiegsregel bei einem Saisonabbruch die Liga.“"
                            },
                            {
                                "example_id": "1f609fc8-42bb-4c4c-a485-8a4b93bbeb05",
                                "sense_id": "468703a2-ec9f-3880-8ea2-86a5b5110ec8",
                                "text": "„Roger Federer wird in dieser Saison kein Tennis-Turnier mehr bestreiten. Am Mittwochmorgen wandte er sich via Twitter an seine Fans, verkündete den Saisonabbruch.“"
                            },
                            {
                                "example_id": "4ed7d6c3-8283-4d0a-8abd-0f359a8b30af",
                                "sense_id": "468703a2-ec9f-3880-8ea2-86a5b5110ec8",
                                "text": "„Mehrere Klubvertreter aus der Super League hatten sich in den vergangenen Tagen für einen Saisonabbruch ausgesprochen, weil Spiele ohne Zuschauer Verluste bringen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
