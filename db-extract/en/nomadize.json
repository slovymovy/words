                        "entry_id": "e62c876c-1186-3890-b493-f58fb652b7a0",
                        "glosses": [
                            "To lead a nomadic life; to wander or roam without a fixed abode (often with domesticated animals."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "3442213d-6e80-4fcf-b883-6dfbb4fce2c2",
                                "sense_id": "5b2b8cdf-cfc8-3177-addd-e19dbaa16214",
                                "text": "The Vogules nomadising in the circle of Tscherdyn"
                            },
                            {
                                "example_id": "8b67b20e-f991-4d14-aa6f-c10734007bf1",
                                "sense_id": "5b2b8cdf-cfc8-3177-addd-e19dbaa16214",
                                "text": "The powerful tribe of Issasi, which nomadises within the limits of the Harrar principality, passes once a year across the river Havash, and so enters within the limits of the Danakili plain"
                            },
                            {
                                "example_id": "16ba5a22-cc29-4b92-b310-09363790c5cb",
                                "sense_id": "5b2b8cdf-cfc8-3177-addd-e19dbaa16214",
                                "text": "many Gypsies took jobs in the newly opened factories—in textile factories in Sliven, for example. Others continued to nomadize until well after World War II."
                            }
                        ]
                    }
