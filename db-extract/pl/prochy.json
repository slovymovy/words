                                        "sense_id": "6ba591c7-99f8-3608-bd6a-a3d3631d693a",
                                        "entry_id": "b30e489e-5f9b-3974-9741-f9f74be820c3",
                                        "glosses": [
                                            "de grondtoon (tonica) van de “as-mineurtoonladder”, tevens een korte aanduiding van die toonladder"
