    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b38c18a1-b837-308c-b0c3-1c5fb302a7f0",
                    "sense_definition": "A famous person's signature collected by an admirer.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "signature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young fan waited for hours to get an <w>autograph</w> from the famous actor."
                        },
                        {
                            "text": "Many people enjoy collecting the <w>autograph</w> of their favorite sports stars."
                        }
                    ],
                    "synonyms": [
                        "signature"
                    ],
                    "common_phrases": [
                        "get an autograph",
                        "ask for an autograph"
                    ]
                },
                {
                    "sense_id": "9d44f5cd-cd75-37a3-8a1d-8abac2250a6c",
                    "sense_definition": "A person's signature used to sign a document.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "signature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please provide your <w>autograph</w> at the bottom of this legal document."
                        },
                        {
                            "text": "The contract is not valid without your official <w>autograph</w>."
                        }
                    ],
                    "synonyms": [
                        "signature"
                    ],
                    "common_phrases": [
                        "provide an autograph"
                    ]
                },
                {
                    "sense_id": "923a99db-8c35-38c1-9c74-eb4116c1795b",
                    "sense_definition": "A document or manuscript written entirely in the author's own handwriting.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "manuscript",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The museum proudly displayed the original <w>autograph</w> of the famous poet's final work."
                        },
                        {
                            "text": "Researchers studied the <w>autograph</w> to understand the author's creative process."
                        }
                    ],
                    "synonyms": [
                        "holograph",
                        "original"
                    ]
                }
            ]
        },
        {
