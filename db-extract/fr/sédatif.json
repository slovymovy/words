                        ],
                        "form": "sédative"
                    },
                    {
                        "form_id": "2759b2d1-4635-4b86-b3ef-031dacdc90ac",
                        "entry_id": "32f1b46d-0252-3688-b939-a2c556dd72ed",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "sédatives"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "befbb3a5-c6e9-363f-bfb1-ab01d699d9b0",
                        "entry_id": "32f1b46d-0252-3688-b939-a2c556dd72ed",
                        "glosses": [
                            "Qui calme la douleur ou l’excitation d’un organe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1dd3de6d-56e0-4b36-9e3d-3e7c47a8ab88",
                                "sense_id": "befbb3a5-c6e9-363f-bfb1-ab01d699d9b0",
                                "text": "La boisson que Ruben lui présenta possédait des propriétés sédatives et narcotiques : elle procura au malade un sommeil profond et calme."
                            },
                            {
                                "example_id": "4908d4a4-e6da-411f-ae18-7cf1a42a6544",
                                "sense_id": "befbb3a5-c6e9-363f-bfb1-ab01d699d9b0",
                                "text": "C’est là qu’il se préparait à mourir, errant pensivement dans ces salles encombrées de collections, ou, plus souvent, confiné dans sa chambre et prêtant ses épaules et ses bras douloureux au bienfait des serviettes chaudes et des compresses sédatives."
                            },
                            {
                                "example_id": "0a3c6390-dde8-448b-b81a-5ab8608c85e3",
                                "sense_id": "befbb3a5-c6e9-363f-bfb1-ab01d699d9b0",
                                "text": "Une migraine, chez elle, ne ressemblait à aucune de celles qui atteignent les autres femmes. Elle demeurait dans la nuit, avec des compresses d’eau sédative sur le front."
                            },
                            {
                                "example_id": "9ae8b5ba-c524-4c9e-9158-f49d04d0f009",
                                "sense_id": "befbb3a5-c6e9-363f-bfb1-ab01d699d9b0",
                                "text": "Ce n'est qu'au XIXᵉ siècle, que Lamalou-les-Bains fut exploitée pour le pouvoir sédatif de ses eaux. Contrairement à beaucoup de stations thermales, elle n'a pas une origine romaine."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3c452e73-b88e-4bf6-b919-7ff396620b9e",
                        "source_entry_id": "32f1b46d-0252-3688-b939-a2c556dd72ed",
                        "source_sense_id": "befbb3a5-c6e9-363f-bfb1-ab01d699d9b0",
                        "target_lang_word": "Beruhigungsmittel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Beruhigungsmittel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dc0d5883-1481-3c1e-91b6-323433d54788",
                                        "entry_id": "6827ec34-5455-3da5-83a0-7650c417860f",
                                        "glosses": [
                                            "ein Arzneimittel, das anxiolytisch (angstlösend), beruhigend oder schlaffördernd wirken kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6610b0bb-e73d-488b-b99c-d73c1d7cd30e",
                                                "sense_id": "dc0d5883-1481-3c1e-91b6-323433d54788",
                                                "text": "Wenn du Beruhigungsmittel einnimmst, achte vorher auf die Packungsbeilage oder frage deinen Arzt oder Apotheker."
                                            },
                                            {
                                                "example_id": "2469207c-a7ee-41c3-9c0b-134e52ee746b",
                                                "sense_id": "dc0d5883-1481-3c1e-91b6-323433d54788",
                                                "text": "„Ich war vollauf damit beschäftigt, Ben mit einem steifen Grog wieder auf die Beine zu bringen und Mrs. Hawkins ein Beruhigungsmittel zu verabfolgen.“"
                                            },
                                            {
                                                "example_id": "ced64eef-4253-4271-8dc7-15931f9bdbb3",
                                                "sense_id": "dc0d5883-1481-3c1e-91b6-323433d54788",
                                                "text": "„Bei der Polizei sorgte man für Erste Hilfe: Wasser und eine Ohrfeige, und man gab ihr den Rat, sie solle zu einem Arzt gehen und sich ein Beruhigungsmittel geben lassen.“"
                                            },
                                            {
                                                "example_id": "4057ba4b-5e1c-47ec-8b41-84c2073d4d2c",
                                                "sense_id": "dc0d5883-1481-3c1e-91b6-323433d54788",
                                                "text": "„Friedrich gab mir ein Beruhigungsmittel.“"
                                            },
                                            {
                                                "example_id": "7aed1d92-9226-4281-a539-1812cc692e08",
                                                "sense_id": "dc0d5883-1481-3c1e-91b6-323433d54788",
                                                "text": "„Holmes behauptet, er habe zufällig gehört, wie ich ihn gewarnt hätte, mehr als zwei Tropfen Rizinusöl zu nehmen, während ich ihm gleichzeitig Strychnin in großen Dosen als Beruhigungsmittel empfahl.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3c0d1515-41b7-3585-abe1-abc4dfa0c41a",
                                        "entry_id": "6827ec34-5455-3da5-83a0-7650c417860f",
                                        "glosses": [
                                            "bestimmte physische oder psychische Techniken, die dazu führen, dass Beruhigung eintritt"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9be956d-90f5-48a3-9043-784710215265",
                                                "sense_id": "3c0d1515-41b7-3585-abe1-abc4dfa0c41a",
                                                "text": "Joga kann bei manchen auch als Beruhigungsmittel Anwendung finden."
                                            },
                                            {
                                                "example_id": "557a7dfb-3eb4-4702-a8ea-9920d0dfa079",
                                                "sense_id": "3c0d1515-41b7-3585-abe1-abc4dfa0c41a",
                                                "text": "Angekündigte Steuersenkungen haben sich noch immer als wirksames Beruhigungsmittel erwiesen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b12a3f09-0282-4d43-8455-075d4883aed3",
                        "source_entry_id": "32f1b46d-0252-3688-b939-a2c556dd72ed",
                        "source_sense_id": "befbb3a5-c6e9-363f-bfb1-ab01d699d9b0",
                        "target_lang_word": "Schmerzmittel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schmerzmittel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "564ebf71-5bd7-397c-bbb3-6adac7380fb4",
                                        "entry_id": "f25392b4-e1f0-3415-afa7-fb700b7bef79",
                                        "glosses": [
                                            "Mittel, dass den Schmerz/die Schmerzen stillt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6be4c483-1911-488f-9dd7-02652f4634bb",
                                                "sense_id": "564ebf71-5bd7-397c-bbb3-6adac7380fb4",
                                                "text": "Gegen ihre Migräne nahm sie schon lange starke Schmerzmittel."
                                            },
                                            {
                                                "example_id": "5b864169-8912-4cf7-80f3-224ddf1c14ff",
                                                "sense_id": "564ebf71-5bd7-397c-bbb3-6adac7380fb4",
                                                "text": "Obwohl man viele Schmerzmittel rezeptfrei bekommt, sind diese keineswegs harmlos."
                                            },
                                            {
                                                "example_id": "bfdb1892-1d02-447b-95b8-065546ea492e",
                                                "sense_id": "564ebf71-5bd7-397c-bbb3-6adac7380fb4",
                                                "text": "„Auch wissen wir, dass Cook auf seiner zweiten Reise mit Opiaten behandelt worden war, dem einzigen effektiven Schmerzmittel in der Medizinkiste des Schiffsarztes.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
