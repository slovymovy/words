                                "target_senses": [
                                    {
                                        "sense_id": "5da70ffb-53d9-34ce-9f6f-f456ad029a65",
                                        "entry_id": "b6cacefc-bb30-3073-85fc-14404ce3cac5",
                                        "glosses": [
                                            "Leiter einer Schule"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7fe6183-a06b-4091-9a75-001bd7333667",
                                                "sense_id": "5da70ffb-53d9-34ce-9f6f-f456ad029a65",
                                                "text": "Der Schulleiter wurde auf eigenen Wunsch in einen anderen Bezirk versetzt."
                                            },
                                            {
                                                "example_id": "76af3d23-45c8-4ca3-8a28-c9ffe8529ff5",
                                                "sense_id": "5da70ffb-53d9-34ce-9f6f-f456ad029a65",
                                                "text": "„Vorne stand der Schulleiter, hielt das Corpus Delicti, das geschändete Stalinbild, noch in den Händen – um ihn herum aber konnte sich eine Horde undisziplinierter Schüler vor Lachen nicht halten.“"
                                            },
                                            {
                                                "example_id": "58204891-c064-49b3-a022-58c0140b8e30",
                                                "sense_id": "5da70ffb-53d9-34ce-9f6f-f456ad029a65",
                                                "text": "„1915 musste der Schulleiter melden, dass von bis dahin 253 Mädchen und Jungen 109 verstorben waren.“"
                                            },
                                            {
                                                "example_id": "9613ebbd-3672-4560-83ea-5b9bfbfa8112",
                                                "sense_id": "5da70ffb-53d9-34ce-9f6f-f456ad029a65",
                                                "text": "„Sie fühlte sich plötzlich wie ein kleines Mädchen, das etwas angestellt hatte und zum Schulleiter musste.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
