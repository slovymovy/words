        "fr-extract.jsonl": [
            {
                "entry_id": "6a210041-4801-3c56-a35a-aef5841f0975",
                "word": "garde-corps",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5117725a-6f23-3fb1-8b6e-12ee4a0a8ef2",
                        "entry_id": "6a210041-4801-3c56-a35a-aef5841f0975",
                        "glosses": [
                            "Barrière destinée à empêcher de tomber, garde-fou (balcon, pont, terrasse, etc.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ed00e56-2b66-4538-8879-405bf1d4cd33",
                                "sense_id": "5117725a-6f23-3fb1-8b6e-12ee4a0a8ef2",
                                "text": "Lorsque l'extrémité supérieure d'une échelle aboutit au bord d'une plate-forme ses montants seront prolongés d'une hauteur de 1 m et la crinoline sera prolongée jusqu'à la hauteur du garde-corps de cette plate-forme."
                            }
                        ]
                    },
                    {
                        "sense_id": "a872daef-4a2f-3078-9225-011230c97624",
                        "entry_id": "6a210041-4801-3c56-a35a-aef5841f0975",
                        "glosses": [
                            "Balustrade qui garnit les bords d’un navire."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3125c5e7-eb92-4d73-b92c-c3ba417ab16c",
                        "source_entry_id": "6a210041-4801-3c56-a35a-aef5841f0975",
                        "target_lang_word": "railing",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "railing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e97847c1-7ebd-32b4-8267-e96129d151fd",
                                        "entry_id": "77af8e6c-44ab-3131-be25-89d386e96cca",
                                        "glosses": [
                                            "That rails; engaged in or given to violent complaining."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c32b090-3080-414a-ae01-b645fdc1ab02",
                                                "sense_id": "e97847c1-7ebd-32b4-8267-e96129d151fd",
                                                "text": "Why does that railing man go with us?"
                                            },
                                            {
                                                "example_id": "5f0ffdbc-4c35-48a6-b67b-778e7aee640f",
                                                "sense_id": "e97847c1-7ebd-32b4-8267-e96129d151fd",
                                                "text": "The daring of the railing reviler should be checked with moderation, i.e. as a duty of charity, and not through lust for one's own honour."
                                            },
                                            {
                                                "example_id": "d88ea810-8446-4646-afb5-594b6246e66f",
                                                "sense_id": "e97847c1-7ebd-32b4-8267-e96129d151fd",
                                                "text": "A clamorous, debating, railing woman feels the need to have the last word."
                                            },
                                            {
                                                "example_id": "2baf80e4-aa62-4ba0-9043-c4ccdbe0e93e",
                                                "sense_id": "e97847c1-7ebd-32b4-8267-e96129d151fd",
                                                "text": "On Anger's self-awareness of the originality of writing as a railing woman, see McManus, \"Eve's Dowry,\" p. 198."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e30078de-caa4-3c27-9ae2-44c5cfd2d06a",
                                        "entry_id": "77af8e6c-44ab-3131-be25-89d386e96cca",
                                        "glosses": [
                                            "Filled with invective and violent complaints"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f75624af-6310-452e-8e1b-7835d5ec1438",
                                                "sense_id": "e30078de-caa4-3c27-9ae2-44c5cfd2d06a",
                                                "text": "Petrus de Pilichdorf (in the year 1395, as he himself gives the date, cap 30,) writes a book of confutation of the several pretended errors of the Waldenses of this time in thirty-six chapters, but has nothing of baptism; though he descends to speak of many lesser matters, and aggravates all with very railing words, yet he finds nothing to accuse them of, but such things as the protestants now hold, except one or two, as the 'unlawfulness of 'all oaths,' &c."
                                            },
                                            {
                                                "example_id": "657bfa8a-bc7b-4128-93e0-1d869ec85f24",
                                                "sense_id": "e30078de-caa4-3c27-9ae2-44c5cfd2d06a",
                                                "text": "Such was the case of the 'very railing speeches against the justices' by Thomas Holman, vintner, of Terling, Essex, when he was presented in 1608 'for a common drunkard and for keeping ill rule in his house'."
                                            },
                                            {
                                                "example_id": "742279ef-10dc-47ea-8889-99237f206b03",
                                                "sense_id": "e30078de-caa4-3c27-9ae2-44c5cfd2d06a",
                                                "text": "I return to earlier considerations of railing by looking at the ways in which the railing style of the Poets' War yields a significant, perverse, even queer fin de siècle aesthetics that is expressed in part by extreme articulations of masculinity: metaphors and puns represent men as either hyperagressive or effeminate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11f4ebff-24e3-3d5d-b898-11f24c39ee4a",
                                        "entry_id": "77af8e6c-44ab-3131-be25-89d386e96cca",
                                        "glosses": [
                                            "Blowing violently."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75e8219e-d0a7-4ef7-b85c-542101127237",
                                                "sense_id": "11f4ebff-24e3-3d5d-b898-11f24c39ee4a",
                                                "text": "Had I a garden, claustral yews Should shut out railing wind,"
                                            },
                                            {
                                                "example_id": "90127d55-e187-421c-ab4b-8be65dbda683",
                                                "sense_id": "11f4ebff-24e3-3d5d-b898-11f24c39ee4a",
                                                "text": "But scatter to the railing wind Each gloomy phantom of the mind!"
                                            },
                                            {
                                                "example_id": "08137068-7e19-4234-b5a5-21323ba0c858",
                                                "sense_id": "11f4ebff-24e3-3d5d-b898-11f24c39ee4a",
                                                "text": "Beginning way back in October, one railing storm after another had swept down off the Bitterroot Mountains and into the valley where the Rocking R had stood for three generations."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "railing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8135ba64-c721-3039-ba56-71f8b392d635",
                                        "entry_id": "ea49b319-dbc6-33f2-946b-13bb856af21b",
                                        "glosses": [
                                            "A fence or barrier consisting of one or more horizontal rails and vertical supports."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90813fa7-04fc-4e58-ae38-a9a4a3c6430c",
                                                "sense_id": "8135ba64-c721-3039-ba56-71f8b392d635",
                                                "text": "During the war, everyone's railings were taken away to make bombers."
                                            },
                                            {
                                                "example_id": "3e7cd344-bd5f-4b03-9896-c14c0c6af76c",
                                                "sense_id": "8135ba64-c721-3039-ba56-71f8b392d635",
                                                "text": "We passed through an inner courtyard overladen with fake wrought-iron railings and accents badly in need of a paint job, evoking a kind of Woolworth's Vieux Carré."
                                            }
                                        ]
                                    }
                                ]
                            },
