                                                "example_id": "022b67e6-6bd2-4b73-a68a-e7060b9bf4c6",
                                                "sense_id": "ec078b89-21a0-3204-9229-94f01a4cf24c",
                                                "text": "„Sie lehnten es ab, Unterwäsche zu tragen, angeblich weil die sie einengte.“"
