                    {
                        "translation_id": "783d8637-41b4-4ec6-9d30-40a334bddc84",
                        "source_entry_id": "e3f36df9-6020-33c8-b845-e291f4614e32",
                        "source_sense_description": "pertaining to the Amorites",
                        "target_lang_word": "amurritisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "amurritisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bd7373e3-c951-3a8a-bc8e-3544711884ea",
                                        "entry_id": "94554eaa-ab3b-32f1-a9ef-3aaf183d1419",
                                        "glosses": [
                                            "die Amurriter oder ihre Kultur betreffend, zum Volk der Amurriter gehörend, die Sprache der Amurriter betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55d5f124-9553-4bd1-955d-7d4849054776",
                                                "sense_id": "bd7373e3-c951-3a8a-bc8e-3544711884ea",
                                                "text": "„Sprachlich, kulturell und ethnisch stellten Babylonien, Teile Nordmesopotamiens und das Gebiet am Mittleren Euphrat bis weit nach Westen insofern eine Einheit dar, als wesentliche Teile der Bevölkerung amurritischen Ursprungs waren, […].“"
                                            },
                                            {
                                                "example_id": "e45bbb2a-7459-4f55-8b2d-2fd8a9e82f8b",
                                                "sense_id": "bd7373e3-c951-3a8a-bc8e-3544711884ea",
                                                "text": "„Auch in Mari, Assyrien, Babylonien und im Süden Mesopotamiens herrschen nun amurritische Dynastien.“"
                                            },
                                            {
                                                "example_id": "e2410408-3f64-4899-b123-9e3826061059",
                                                "sense_id": "bd7373e3-c951-3a8a-bc8e-3544711884ea",
                                                "text": "„Die vom Palast abhängigen Personen zählten, wie aus Namensverzeichnissen hervorgeht, viele Tausende, und es sind ca. 6000 männliche und weibliche amurritische Personennamen bekannt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
            {
                "entry_id": "8bf17b0e-3dcc-3aef-8ea9-fface74bf9b2",
