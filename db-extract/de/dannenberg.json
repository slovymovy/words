                ],
                "senses": [
                    {
                        "sense_id": "e29269f3-c161-3e9a-b399-4176f67a5580",
                        "entry_id": "19741dd8-eeeb-3f7b-bd6e-51da38708447",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db12152d-a327-4506-9944-8fea872152e5",
                                "sense_id": "e29269f3-c161-3e9a-b399-4176f67a5580",
                                "text": "Frau Dannenberg ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "d3a45319-afef-4d8b-9dce-23ca3b7910b3",
                                "sense_id": "e29269f3-c161-3e9a-b399-4176f67a5580",
                                "text": "Herr Dannenberg wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "665e48a4-4296-4326-94cf-37bb0ffff708",
                                "sense_id": "e29269f3-c161-3e9a-b399-4176f67a5580",
                                "text": "Die Dannenbergs fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "b1eb431a-8aa4-4b03-ad0a-c1507fb65f8f",
                                "sense_id": "e29269f3-c161-3e9a-b399-4176f67a5580",
                                "text": "Der Dannenberg trägt nie die Schals, die die Dannenberg ihm strickt."
                            },
                            {
                                "example_id": "a1a5dbf4-1169-40dc-af99-a2f157c81e20",
                                "sense_id": "e29269f3-c161-3e9a-b399-4176f67a5580",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Dannenberg kommt, geht der Herr Dannenberg.“"
                            },
                            {
                                "example_id": "d8a1e691-08b0-410f-9f00-408fada6a1fc",
                                "sense_id": "e29269f3-c161-3e9a-b399-4176f67a5580",
                                "text": "Dannenberg kommt und geht."
                            },
                            {
                                "example_id": "d9fb23f3-ef65-4d34-86ae-9c6e5c9d90f0",
                                "sense_id": "e29269f3-c161-3e9a-b399-4176f67a5580",
                                "text": "Dannenbergs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
