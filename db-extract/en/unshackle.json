                                "target_senses": [
                                    {
                                        "sense_id": "0203f4c6-c425-3eda-a9a8-82844e0004d4",
                                        "entry_id": "dceaadba-9794-3f09-b398-62ef1f35d6e4",
                                        "glosses": [
                                            "iemand of een bevolking van gevangenschap of onderdrukking verlossen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5f0f77b-ec58-4daa-b743-787fe81fae0e",
                                                "sense_id": "0203f4c6-c425-3eda-a9a8-82844e0004d4",
                                                "text": "De Canadezen bevrijdden een groot deel van Nederland."
                                            },
                                            {
                                                "example_id": "6d66af5e-603d-4061-ac3b-fa8219817fc5",
                                                "sense_id": "0203f4c6-c425-3eda-a9a8-82844e0004d4",
                                                "text": "Koning Willem-Alexander en koningin Máxima waren afgelopen weekend in Terneuzen. De koning gaf het startschot voor de viering van 75 jaar vrijheid. Want dit jaar is het 75 jaar geleden dat Nederland bevrijd werd."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08a48f2e-4b02-328e-bd69-63dbca65a53d",
                                        "entry_id": "dceaadba-9794-3f09-b398-62ef1f35d6e4",
                                        "glosses": [
                                            "verlost worden van iets dat knelt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb32edd2-2916-4aad-ba79-46312b16bd19",
                                                "sense_id": "08a48f2e-4b02-328e-bd69-63dbca65a53d",
                                                "text": "Prins Claus heeft de Nederlandse man bevrijdt van de stropdas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e19b211a-71e1-3240-ac62-6596f295984b",
                                        "entry_id": "dceaadba-9794-3f09-b398-62ef1f35d6e4",
                                        "glosses": [
                                            "verlost worden uit een gevaarlijke situatie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be06be24-86f7-414f-b94f-793bea72a009",
                                                "sense_id": "e19b211a-71e1-3240-ac62-6596f295984b",
                                                "text": "Op dat moment wil Nella Thea alleen nog maar bevrijden uit deze situatie, maar tot haar verbazing staat haar nichtje nog altijd fier rechtop en kijkt ze met een strak gezicht naar de zelfvoldane lachjes van de meisjes."
                                            },
                                            {
                                                "example_id": "f4a0c502-9900-4304-9174-3dcc6ea809da",
                                                "sense_id": "e19b211a-71e1-3240-ac62-6596f295984b",
                                                "text": "Intuïtief klemde hij zich met zijn vingers vast, zijn nagels in het hout, en zo slaagde hij er uiteindelijk in zich te bevrijden uit de greep van de draaikolk."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cf1a3fbe-03e7-4c9b-8481-714c2c099063",
                        "source_entry_id": "6a2247bf-50a9-3d5c-a97b-8cc888e2dfa9",
