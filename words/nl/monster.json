                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Monster</w> die troepen onmiddellijk zodat we weten wie er aanwezig is.",
                            "target_lang_translations": {
