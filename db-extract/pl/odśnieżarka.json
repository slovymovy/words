                                        "sense_id": "23bea9b0-3853-3e17-8825-a27f1d19fc9e",
                                        "entry_id": "487de523-9106-38bb-a9b7-d09bdf03ab58",
                                        "glosses": [
                                            "Alternative form of snowplow."
                                        ],
                                        "tags": [
                                            "UK",
                                            "alt-of",
