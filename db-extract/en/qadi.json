    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "1fa87a1f-ded9-328e-9fa0-268688e83377",
                "word": "qadi",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "fd00f271-1b1a-4549-b1c9-f4221b0339a0",
                        "entry_id": "1fa87a1f-ded9-328e-9fa0-268688e83377",
                        "tags": [
                            "plural"
                        ],
                        "form": "qadis"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f7dea649-3c8c-3c86-ba14-23f253030caf",
                        "entry_id": "1fa87a1f-ded9-328e-9fa0-268688e83377",
                        "glosses": [
                            "A judge who is trained in and practices Islamic law."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f686bc41-9166-4491-b843-c0e4e2805706",
                                "sense_id": "f7dea649-3c8c-3c86-ba14-23f253030caf",
                                "text": "To this the Jew agreed, and the two went together to the great hall, in which the kadi was administering justice."
                            },
                            {
                                "example_id": "9bf5f4a7-9c52-43b0-abb0-b99c8d447d93",
                                "sense_id": "f7dea649-3c8c-3c86-ba14-23f253030caf",
                                "text": "legal treatises dealing with the subject usually spoke of the appointment to office of a qadi [...]."
                            },
                            {
                                "example_id": "35da0f97-b6a4-4cb1-9f22-34788afd7ce3",
                                "sense_id": "f7dea649-3c8c-3c86-ba14-23f253030caf",
                                "text": "The Qazi, his spiritual adviser, had recommended that the Russian be taken out into the desert and buried alive [...]."
                            },
                            {
                                "example_id": "4017a2a4-5b8a-4379-a6ae-87e02c68058f",
                                "sense_id": "f7dea649-3c8c-3c86-ba14-23f253030caf",
                                "text": "While sharia law for divorce in many Muslim countries has been modified by governments, in Israel reform was initiated by qadis."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e52670bb-0816-443e-8ba9-c807f5d5069c",
                        "source_entry_id": "1fa87a1f-ded9-328e-9fa0-268688e83377",
                        "source_sense_id": "f7dea649-3c8c-3c86-ba14-23f253030caf",
                        "source_sense_description": "judge in Islam",
                        "target_lang_word": "kadi",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kadi",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "d391587e-7af6-3303-8f06-28a341ffaed4",
                                        "entry_id": "35d81215-9558-341d-a8f4-0955e1ebb7d1",
                                        "glosses": [
                                            "islamitisch rechter die op grond van de sharia, de islamitische wetgeving, oordeelt"
                                        ],
