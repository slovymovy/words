                        "entry_id": "b667a661-0c58-3d64-8854-10bc79f5e7a9",
                        "glosses": [
                            "ganz unten, an unterster Stelle (eines Stapels oder Ähnlichem)"
                        ],
                        "tags": [
                            "räumlich"
                        ],
                        "examples": [
                            {
                                "example_id": "8d0776a2-2c1f-458f-9946-e3177c3bf2b9",
                                "sense_id": "614aa979-b99a-37e5-9b0f-9ab6ea3b19a8",
                                "text": "Schau mal in dem Bücherstapel da, ich glaube die Ausgabe liegt in dem zuunterst."
                            },
                            {
                                "example_id": "57cf1c42-6e34-4c82-81b4-6dc4fe2a2e48",
                                "sense_id": "614aa979-b99a-37e5-9b0f-9ab6ea3b19a8",
                                "text": "Zuunterst in dem Haufen wirst du irgendwo auch die Socken finden."
                            },
                            {
                                "example_id": "ffa3e479-4715-4525-ace4-34e984fd7bd0",
                                "sense_id": "614aa979-b99a-37e5-9b0f-9ab6ea3b19a8",
                                "text": "Beim Packen legt man die Unterwäsche zuunterst, und ganz oben drauf kommen als letztes dann die gebügelten Blusen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
