                    },
                    {
                        "translation_id": "b398ed92-f9f5-4c0b-905e-4d6fbb387680",
                        "source_entry_id": "f7f557d6-0e0f-3f7c-bdbb-3402a53fc686",
                        "source_sense_id": "889b815c-d867-3f7b-9007-6560ebfee65e",
                        "target_lang_word": "Reisepass",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Reisepass",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "689cb9af-ad38-3d7f-ad73-3a6d22f2af52",
                                        "entry_id": "425b16f0-9ce5-39ae-8373-ad783f871d7f",
                                        "glosses": [
                                            "amtliches Ausweisdokument, das das Ein- und Ausreisen in bestimmte Staaten erlaubt oder erst ermöglicht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6cb5cf09-579d-4bbb-910a-facef9b5c166",
                                                "sense_id": "689cb9af-ad38-3d7f-ad73-3a6d22f2af52",
                                                "text": "Ohne Reisepass können Sie nicht die Grenze passieren!"
                                            },
                                            {
                                                "example_id": "73f8802a-9e88-461a-a079-64991e34af00",
                                                "sense_id": "689cb9af-ad38-3d7f-ad73-3a6d22f2af52",
                                                "text": "„Die Schalterbeamtin wirft einen kurzen Blick in meinen Reisepass und zählt tatsächlich ungerührt einen Stapel Geld auf den Tresen.“"
                                            },
                                            {
                                                "example_id": "cbc896f3-ad05-4e1b-9c9b-396086db2056",
                                                "sense_id": "689cb9af-ad38-3d7f-ad73-3a6d22f2af52",
                                                "text": "„Sofort begann sie, sich impfen zu lassen, und besorgte sich einen Reisepass.“"
                                            },
                                            {
                                                "example_id": "95c6bcec-6456-4abf-a2fc-4985aea342e1",
                                                "sense_id": "689cb9af-ad38-3d7f-ad73-3a6d22f2af52",
                                                "text": "„Äußerlich ähnelt der finnische Reisepass in Format und Farbe unserem.“"
                                            },
                                            {
                                                "example_id": "1e751f11-6216-4777-96b2-9a21b912574c",
                                                "sense_id": "689cb9af-ad38-3d7f-ad73-3a6d22f2af52",
                                                "text": "„Meine Mutter steht daneben, den Blick nach links unten gesenkt, den Reisepass hält sie mit beiden Händen vor der Brust.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4cdf801e-556b-4efe-bcc9-adaf600e9717",
                        "source_entry_id": "f7f557d6-0e0f-3f7c-bdbb-3402a53fc686",
                        "source_sense_id": "889b815c-d867-3f7b-9007-6560ebfee65e",
                        "target_lang_word": "passport",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "passport",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "794e2f1a-e60a-3d50-bd38-8edeeb986dba",
                                        "entry_id": "88087e29-4601-3e0e-970e-948616798f4d",
                                        "glosses": [
                                            "An official document normally used for international journeys, which proves the identity and nationality of the person for whom it was issued."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "486c33f2-2a53-47f8-81e0-d4986f3a94c0",
                                                "sense_id": "794e2f1a-e60a-3d50-bd38-8edeeb986dba",
                                                "text": "You will have to bring your passport to prove who you are."
                                            },
                                            {
                                                "example_id": "e6bc8934-226d-4cd7-8b0c-abd24132df3e",
                                                "sense_id": "794e2f1a-e60a-3d50-bd38-8edeeb986dba",
                                                "text": "Meanwhile, the Italian authorities examine passports and hand-baggage, except in the case of sleeping-car passengers, who are usually left undisturbed."
                                            },
                                            {
                                                "example_id": "892106c2-f65b-4622-8016-7baac4b17060",
                                                "sense_id": "794e2f1a-e60a-3d50-bd38-8edeeb986dba",
                                                "text": "Dagobert gave him back his passport. He re-pocketed it indifferently; a talisman which had lost its potency."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9a4c890-c5ea-3c15-b379-8683bf33e9f5",
                                        "entry_id": "88087e29-4601-3e0e-970e-948616798f4d",
                                        "glosses": [
                                            "Any document that allows entry or passage."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "da39f2ff-4eb7-3cf5-a40b-842379662d28",
                                        "entry_id": "88087e29-4601-3e0e-970e-948616798f4d",
                                        "glosses": [
                                            "Something which enables someone to do or achieve something."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6a7f8f7-ca57-4623-93db-85794355fbb6",
                                                "sense_id": "da39f2ff-4eb7-3cf5-a40b-842379662d28",
                                                "text": "The tenor's voice was his passport to the international concert circuit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "786efb88-a527-3445-93d9-0e96e0cfc731",
                                        "entry_id": "88087e29-4601-3e0e-970e-948616798f4d",
                                        "glosses": [
                                            "An identification document used by firefighters, collected when they enter a dangerous area and returned when they leave, to keep track of who is still in the area."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "passport",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1270220c-fcfc-3323-903a-ce1833979a0d",
                                        "entry_id": "9b9e6873-0d2b-3d31-be7e-40eb5d0e7cdf",
                                        "glosses": [
                                            "To regulate how money given to a local authority must be spent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "026d256a-88e7-47fe-adfc-cf3d1f876388",
                                                "sense_id": "1270220c-fcfc-3323-903a-ce1833979a0d",
                                                "text": "Did we not pass an Act last year which passported the money directly through to the schools and gave local authorities very little discretion?"
                                            },
                                            {
                                                "example_id": "d38318a0-2e25-45cf-965b-955273039ee4",
                                                "sense_id": "1270220c-fcfc-3323-903a-ce1833979a0d",
                                                "text": "They are talking about whether the money that goes into district councils ends up getting passported through to the operators through concessionary fares."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa61c753-9caf-3b8c-b945-e32fae0e9728",
                                        "entry_id": "9b9e6873-0d2b-3d31-be7e-40eb5d0e7cdf",
                                        "glosses": [
                                            "Providing the legal requirements to enable or legitimize cross-border economic activity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f28540ca-a7c0-4768-bbcc-788b99a738c4",
                                                "sense_id": "fa61c753-9caf-3b8c-b945-e32fae0e9728",
                                                "text": "Apart from the condition in (ii), which may easily be overcome via an agreement between the depositor and the bank, European legislation does not preclude the entry of Islamic financial undertakings on the internal market at EU-based credit institutions because banking directives allow European credit institutions to perform not only the core banking business, but also passported activities according to the principle of mutual recognition and home country control."
                                            },
                                            {
                                                "example_id": "ecd29ddd-5711-4672-baf2-9975aeb4f0d9",
                                                "sense_id": "fa61c753-9caf-3b8c-b945-e32fae0e9728",
                                                "text": "Also, in this context, rules are different in relation to passporting the asset managers' activities, or the product […]"
                                            },
                                            {
                                                "example_id": "b72260dc-7503-4d69-bf63-aa01e7a288c6",
                                                "sense_id": "fa61c753-9caf-3b8c-b945-e32fae0e9728",
                                                "text": "She was announcing that a “draft law on criminal liability for forced Russian passporting” had been approved, which was “aimed primarily at punishing the organisers of hostile passporting and their accomplices”."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9e100a9-c59c-3e0e-9405-3277a9bf302d",
                                        "entry_id": "9b9e6873-0d2b-3d31-be7e-40eb5d0e7cdf",
                                        "glosses": [
                                            "To enable eligibility for a benefit automatically based on eligibility for a different benefit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "761cad7a-075a-4fbd-877f-ce7238a6e8ed",
                                                "sense_id": "a9e100a9-c59c-3e0e-9405-3277a9bf302d",
                                                "text": "At present, recipients of Working Tax Credit who are not also in receipt of Child Tax Credit are automatically passported to a full fee remission in some courts and tribunals, and those in receipt of Working Tax Credit and in receipt of child tax credit are passported in others (see annex B)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4606ed91-0d0b-43e7-8656-6e0c981ed4b4",
                        "source_entry_id": "f7f557d6-0e0f-3f7c-bdbb-3402a53fc686",
                        "source_sense_id": "889b815c-d867-3f7b-9007-6560ebfee65e",
                        "target_lang_word": "passeport",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "passeport",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f9e16bda-882e-3090-92a1-44d7ca0feda8",
                                        "entry_id": "49cbd46b-946c-3377-8b66-c89ff98355df",
                                        "glosses": [
                                            "Pièce d’identité délivrée par l’État, permettant aux nationaux d’un pays soit de circuler librement à l’intérieur, soit de voyager dans un autre pays."
                                        ],
                                        "tags": [
                                            "Administration"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26b54feb-7d6d-4aba-ac33-90d7b31b7c68",
                                                "sense_id": "f9e16bda-882e-3090-92a1-44d7ca0feda8",
                                                "text": "Dès lors, les Sahraouis ne purent se déplacer entre les zones contrôlées par le Maroc que dans des convois militaires. Seuls quelques commerçants de confiance restent autorisés à se rendre aux îles Canaries munis de passeports marocains."
                                            },
                                            {
                                                "example_id": "cb57145a-50c7-4651-b52c-f055a308d82f",
                                                "sense_id": "f9e16bda-882e-3090-92a1-44d7ca0feda8",
                                                "text": "Peut-être je voulais mettre la main, comme dans les films, sur nos passeports, que bien sûr, les fliquesses avaient confisqués, et avec, nos identités. Pas si simple, en fait, de leur échapper. — (Laure Ly, Demain matin, Paris : Éditions Balland, 2000)"
                                            },
                                            {
                                                "example_id": "14255c1d-b37d-45b7-9e52-6c3654cc61a3",
                                                "sense_id": "f9e16bda-882e-3090-92a1-44d7ca0feda8",
                                                "text": "Délivrer un passeport, des passeports. Faire viser un passeport ; renouveler son passeport."
                                            },
                                            {
                                                "example_id": "31268035-2e62-4241-8da1-ac47366efb10",
                                                "sense_id": "f9e16bda-882e-3090-92a1-44d7ca0feda8",
                                                "text": "Je disais donc que grâce à mon passeport, j’avais la possibilité de voyager dans le monde entier."
                                            },
                                            {
                                                "example_id": "45916ea6-ef28-425b-9700-2219e72e2cdc",
                                                "sense_id": "f9e16bda-882e-3090-92a1-44d7ca0feda8",
                                                "text": "Demander ses passeports, se dit d’un ambassadeur qui sollicite son départ du pays où il est accrédité, en cas de difficultés diplomatiques)"
                                            },
                                            {
                                                "example_id": "63124860-11ed-48d5-8f25-e81745a65d9a",
                                                "sense_id": "f9e16bda-882e-3090-92a1-44d7ca0feda8",
                                                "text": "Passeport biométrique."
                                            },
                                            {
                                                "example_id": "2ae188ec-b208-40cf-af73-341c6e2744c7",
                                                "sense_id": "f9e16bda-882e-3090-92a1-44d7ca0feda8",
                                                "text": "Passeport diplomatique, document officiel qui permet aux diplomates de quitter le pays où ils sont accrédités, ou d’y rentrer sans être soumis aux formalités de la douane."
                                            },
                                            {
                                                "example_id": "7ed0cf02-94d5-442d-b1a4-60e6f787c9c0",
                                                "sense_id": "f9e16bda-882e-3090-92a1-44d7ca0feda8",
                                                "text": "Passeport jaune, pièce d’identité des forçats libérés.",
                                                "translation": "Il tira de sa poche une grande feuille de papier jaune qu’il déplia. – Voilà mon passeport. Jaune, comme vous voyez. Cela sert à me faire chasser de partout où je vais. Voulez-vous lire ? (...) Tenez, voilà ce qu’on a mis sur le passeport : « Jean Valjean, forçat libéré, natif de... » – cela vous est égal... – « est resté dix-neuf ans au bagne. Cinq ans pour vol avec effraction. Quatorze ans pour avoir tenté de s’évader quatre fois. Cet homme est très dangereux. » — (Victor Hugo, Les Misérables, I, 2, 3 ; 1862)"
                                            },
                                            {
                                                "example_id": "12d2ec4a-ef16-459d-aa30-95f552d3f1b1",
                                                "sense_id": "f9e16bda-882e-3090-92a1-44d7ca0feda8",
                                                "text": "Passeport Nansen, passeport créé sous les auspices de la Société des Nations pour attribuer une identité aux réfugiés et aux apatrides.",
                                                "translation": "Deux ans avant la guerre, il avait renoncé à son passeport Nansen et obtenu la naturalisation française. — (Simenon, Le Petit homme d’Arkhangelsk, Paris, 1956)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ee99971-6e6e-342b-b2d1-61c9ad0f3760",
                                        "entry_id": "49cbd46b-946c-3377-8b66-c89ff98355df",
                                        "glosses": [
                                            "Autorisation de sortie délivrée à un navire contre acquittement des droits de douane."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "261b4924-f298-4e06-b85b-1db0f9a68c58",
                                                "sense_id": "9ee99971-6e6e-342b-b2d1-61c9ad0f3760",
                                                "text": "Les sommes payées pour le fret ou nolis des vaisseaux de Sa Majesté, seront justifiées par le contrat d'affretement, […avec le détail] des voyages qu'ils doivent faire & de la somme payée pour chaque passeport."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2caa9bab-ff59-395c-b314-aa1f2b784caa",
                                        "entry_id": "49cbd46b-946c-3377-8b66-c89ff98355df",
                                        "glosses": [
                                            "Ce qui permet de passer d'un lieu ou d'un état à un autre, d'être accepté dans des cercles fermés."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7caa085-3d49-4bd9-ac82-69c17df3de0d",
                                                "sense_id": "2caa9bab-ff59-395c-b314-aa1f2b784caa",
                                                "text": "Avec un passeport comme votre voix et votre violon, vous ne pouviez manquer d'être bien accueillis par mon maître."
                                            },
                                            {
                                                "example_id": "1b367d0b-01e2-4b86-a8f8-bc07f6de6de1",
                                                "sense_id": "2caa9bab-ff59-395c-b314-aa1f2b784caa",
                                                "text": "Passeport pour le paradis, certificat de décès"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "391dea5b-b1f0-393a-b8f5-43b21ada52ab",
                                        "entry_id": "49cbd46b-946c-3377-8b66-c89ff98355df",
                                        "glosses": [
                                            "Autorisation de vente à l’étranger d’une œuvre d’art."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f07b504c-64a8-48a9-90c3-fbc4cea9c766",
