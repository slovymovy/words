                ],
                "word_linkages": []
            },
            {
                "entry_id": "dc88dec9-b274-3ece-95cb-3d3d60d92262",
                "word": "stentor",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "701b67fa-a65f-4ff5-a45c-ca544f48f7d3",
                        "entry_id": "dc88dec9-b274-3ece-95cb-3d3d60d92262",
                        "tags": [
                            "plural"
                        ],
                        "form": "stentors"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "54da385e-0196-322b-84cc-67a26e465ce2",
                        "entry_id": "dc88dec9-b274-3ece-95cb-3d3d60d92262",
                        "glosses": [
                            "Homme doué d’une voix forte, tonitruante."
                        ],
                        "tags": [
                            "analogy"
                        ],
                        "examples": [
                            {
                                "example_id": "1379f018-c2c6-41f0-b88b-55461688c56d",
                                "sense_id": "54da385e-0196-322b-84cc-67a26e465ce2",
                                "text": "Non, concéda encore Pierrot. Je suis entré à l’œil.\n− Ça c’est le comble, beugla le stentor."
                            },
                            {
                                "example_id": "516619cd-da74-41dc-b233-98f224af5fba",
                                "sense_id": "54da385e-0196-322b-84cc-67a26e465ce2",
                                "text": "Ce n’est pas le verbe de Balzac qui peut impressionner le stentor qu’est Vidock: sa parole fangeuse, illuminée par le vocabulaire des bagnes, roule sur l’assistance et hypnotise l’auditoire."
                            },
                            {
                                "example_id": "0de4fc28-001b-4c10-98ca-5db5ab66eac1",
                                "sense_id": "54da385e-0196-322b-84cc-67a26e465ce2",
                                "text": "Il couvre le chœur de sa voix de stentor pendant les cantiques."
                            }
                        ]
                    },
                    {
                        "sense_id": "0374aaeb-b7bb-3c4e-83e4-87829792f1d8",
                        "entry_id": "dc88dec9-b274-3ece-95cb-3d3d60d92262",
                        "glosses": [
                            "Genre de micro-organismes eucaryotes unicellulaires ciliés (Ciliophora), infusoires d’eau douce, et ressemblant à un porte-voix ou une trompette."
                        ],
                        "tags": [
                            "analogy"
                        ],
                        "examples": [
                            {
                                "example_id": "9b00b0b1-3b82-45c2-a570-ebdb6af2f1af",
                                "sense_id": "0374aaeb-b7bb-3c4e-83e4-87829792f1d8",
                                "text": "Si l’on prend un infusoire assez volumineux, tel que le stentor, et qu’on le coupe en deux moitiés contenant chacune une partie du noyau, chacune des deux moitiés régénère un stentor indépendant."
                            }
                        ]
                    },
                    {
                        "sense_id": "443daf92-bd9a-3d6e-bfa7-7361af01a715",
                        "entry_id": "dc88dec9-b274-3ece-95cb-3d3d60d92262",
                        "glosses": [
                            "Genre de micro-organismes eucaryotes unicellulaires ciliés (Ciliophora), infusoires d’eau douce, et ressemblant à un porte-voix ou une trompette.",
                            "Un de ces organismes."
                        ],
                        "tags": [
                            "analogy",
                            "metonymically"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "0d23a0b4-79e0-35d6-99a7-3ec5f8dc815c",
                        "entry_id": "dc88dec9-b274-3ece-95cb-3d3d60d92262",
                        "glosses": [
                            "Un synonyme plus récent du genre des alouates (Alouatta), singes hurleurs d’Amérique néotropicale."
                        ],
                        "tags": [
                            "analogy",
                            "obsolete"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7100d146-ffd9-452b-92c8-5845863378aa",
                        "source_entry_id": "dc88dec9-b274-3ece-95cb-3d3d60d92262",
                        "source_sense_id": "54da385e-0196-322b-84cc-67a26e465ce2",
                        "source_sense_description": "homme à la voix forte",
                        "target_lang_word": "stentor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stentor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "67b6a2ae-5e57-39d7-acf1-be8f21a70f3c",
                                        "entry_id": "062a9f8b-01bb-3833-9987-f17380555019",
                                        "glosses": [
                                            "A person with a powerful or stentorian voice."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af1d1100-66bf-4e7d-924e-2afed868347b",
                                                "sense_id": "67b6a2ae-5e57-39d7-acf1-be8f21a70f3c",
                                                "text": "1609, Ben Jonson, Epicoene Act IV, Scene II, 1989, Johanna Procter (editor), The Selected Plays of Ben Jonson, Volume 1, page 381,\nRogues, hellhounds, Stentors, out of my doors, you sons of noise and tumult, begot on an ill May Day, or when the galley-foist is afloat to Westminster!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86405798-8a59-3e55-8172-3a497e1e3207",
                                        "entry_id": "062a9f8b-01bb-3833-9987-f17380555019",
                                        "glosses": [
                                            "Any protozoan of the genus Stentor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20b2e06c-88ae-43c1-82e5-3d6ce7fc1d19",
                                                "sense_id": "86405798-8a59-3e55-8172-3a497e1e3207",
                                                "text": "Ere long a solitary amœba and stentor were found engaged in a struggle, which continued for some time with varying success, finally ending with the escape of the latter."
                                            },
                                            {
                                                "example_id": "81e7379a-703d-4388-91cc-d6f65857397a",
                                                "sense_id": "86405798-8a59-3e55-8172-3a497e1e3207",
                                                "text": "When the stentors become too numerous it is a simple matter to subdivide the culture and add the requisite amount of spring water to each culture."
                                            },
                                            {
                                                "example_id": "5e775b13-7ec6-406c-b835-730c6ae0d7d4",
                                                "sense_id": "86405798-8a59-3e55-8172-3a497e1e3207",
                                                "text": "It can be an irritant even for humans and is certainly toxic to tiny animals like stentor. He added carmine to the water tank in which the stentor was living, and simply watched to see what happened."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4792db8-1070-360e-9351-9b0f9b516e25",
                                        "entry_id": "062a9f8b-01bb-3833-9987-f17380555019",
                                        "glosses": [
                                            "A part of the amplification system of a carillon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "052fa351-542c-4ccb-b418-4f6738c8eee3",
                                                "sense_id": "b4792db8-1070-360e-9351-9b0f9b516e25",
                                                "text": "The unit is completely automatic in operation and tower stentors, matching the power output of the amplifier, are provided for roof or tower mounting."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5c1b9bf-ab12-3d91-979b-e1de45693341",
                                        "entry_id": "062a9f8b-01bb-3833-9987-f17380555019",
                                        "glosses": [
                                            "A howler monkey."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
