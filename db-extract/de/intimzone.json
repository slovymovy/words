                        "entry_id": "f6e586f0-0bc1-3f1d-8c4b-1e5136bdbe33",
                        "glosses": [
                            "Bereich um die Genitalien beim Menschen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1cb2ce04-aeaf-4928-92e4-63c77e72e8c9",
                                "sense_id": "14a11219-f7b3-353c-834c-0dd860bf3936",
                                "text": "Bevor man eine andere Person in ihrer Intimzone berührt, sollte man sich sicher sein, dass sie dies auch wünscht."
                            }
                        ],
                        "sense_index_json": "\"2\""
