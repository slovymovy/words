                    {
                        "translation_id": "c283ddd6-2b0b-4ebe-a461-ad7d89631b26",
                        "source_entry_id": "12f98c1f-32b0-3f4e-b430-8d6403605bf4",
                        "source_sense_id": "0f34c18b-60f7-3837-b29d-3b067ca26ba9",
