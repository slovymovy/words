                        "glosses": [
                            "Étude des principes et processus qui gouvernent la distribution des lignées généalogiques, spécialement celle de niveau intraspécifique."
                        ],
                        "tags": [
                            "Généalogie"
                        ],
                        "examples": [
                            {
