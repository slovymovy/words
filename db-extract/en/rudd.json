                    {
                        "sense_id": "8ff972c1-c98b-3ebb-bf7d-a3fe6acb4603",
                        "entry_id": "72f9f182-a100-39d8-b0b3-43ef60fcf036",
                        "glosses": [
                            "Any species of the freshwater game fishes of genus Scardinius."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ed8d8ae-fd44-4026-8832-6049e5298f45",
                                "sense_id": "8ff972c1-c98b-3ebb-bf7d-a3fe6acb4603",
                                "text": "Within minutes of starting I had my first fish a rudd about a pound, this was followed by a tench about five pounds."
                            }
                        ]
                    },
                    {
                        "sense_id": "f7a7a370-7b4a-3841-a293-e3d0b1db2327",
                        "entry_id": "72f9f182-a100-39d8-b0b3-43ef60fcf036",
                        "glosses": [
                            "Any species of the freshwater game fishes of genus Scardinius.",
                            "common rudd (Scardinius erythrophthalmus)"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0a314e16-94cf-4ab8-8e76-554fb1b5d658",
