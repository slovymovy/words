                                "target_senses": [
                                    {
                                        "sense_id": "b596bb2c-82dc-3a67-8b8b-322d23976c17",
                                        "entry_id": "52dc06de-2902-301b-9194-32dc18e3ce4c",
                                        "glosses": [
                                            "Arzneistoff, das meist als Cholesterinsenker eingesetzt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0170b909-096a-448d-81a0-0a8fc9137ce6",
                                                "sense_id": "b596bb2c-82dc-3a67-8b8b-322d23976c17",
                                                "text": "„Statine, so argumentieren die Befürworter, seien gut erprobte, vergleichsweise nebenwirkungsarme Medikamente, die das relative Risiko, einen Herzinfarkt oder Schlaganfall zu bekommen, deutlich senken können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
