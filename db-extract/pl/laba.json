        "pl-extract.jsonl": [
            {
                "entry_id": "40857de7-e185-352c-b34c-c8af806ca7b1",
                "word": "laba",
                "pos": "noun",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "90d01e37-df3a-3225-8725-0b359d92b17b",
                        "entry_id": "40857de7-e185-352c-b34c-c8af806ca7b1",
                        "glosses": [
                            "czas wolny od pracy, nauki, zajęć"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "e9e7fce0-c274-46d6-ad0b-a3fd639af920",
                                "sense_id": "90d01e37-df3a-3225-8725-0b359d92b17b",
                                "text": "Koniec czerwca: chłopaki czekają już tylko na rozdanie świadectw – a potem całe dwa miesiące laby!"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "43aa7776-3781-35dd-a647-354df1bd14f9",
                        "entry_id": "40857de7-e185-352c-b34c-c8af806ca7b1",
                        "glosses": [
                            "gw. (Górny Śląsk) gw. (Poznań) beztroski odpoczynek, próżnowanie, leniuchowanie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ed8c4ae-78ea-45ec-99bc-60746dd597d2",
                                "sense_id": "43aa7776-3781-35dd-a647-354df1bd14f9",
                                "text": "Ni mo sprawiedliwości na tym świecie. Jedyn musi siedzieć w robocie, a drugi mo labę"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4ea8eb77-2e41-4b8a-8921-64ed67a0feb6",
                        "source_entry_id": "40857de7-e185-352c-b34c-c8af806ca7b1",
                        "source_sense_id": "90d01e37-df3a-3225-8725-0b359d92b17b",
                        "target_lang_word": "dog days",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dog days",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e43a8946-1fa5-3108-9fd7-30286b065446",
                                        "entry_id": "ce752951-6d19-3cef-a44d-00e5a99a1660",
                                        "glosses": [
                                            "The days following the heliacal rising of Sirius, now in early August (Gregorian) at dates varying by latitude."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "plural",
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "407cb61a-77cb-4864-b5d1-410b55b56952",
                                                "sense_id": "e43a8946-1fa5-3108-9fd7-30286b065446",
                                                "text": "... a sterre, wherof canicular or dogge days be named Dies caniculares."
                                            },
                                            {
                                                "example_id": "ddf089fe-9514-41f3-9ca4-cb61208903b8",
                                                "sense_id": "e43a8946-1fa5-3108-9fd7-30286b065446",
                                                "text": "Dog days bright and clear\nIndicate a good year;\nBut when accompanied by rain,\nWe hope for better times in vain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26082cd7-09f5-3a0b-b510-6386260f352f",
                                        "entry_id": "ce752951-6d19-3cef-a44d-00e5a99a1660",
                                        "glosses": [
                                            "The unpleasantly hot days of late summer."
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9183ab40-5c5f-48c7-8748-27eed12415e1",
                                                "sense_id": "26082cd7-09f5-3a0b-b510-6386260f352f",
                                                "text": "Why ſhould thoſe Eteſian and Eaſterne winds blow cōtinually in ſome places, at ſet times, one way ſtill, in the dog dayes only: heere perpetuall drought, there dropping ſhowres; [...]"
                                            },
                                            {
                                                "example_id": "dfaaf133-10d2-4263-96cc-93e25490d36a",
                                                "sense_id": "26082cd7-09f5-3a0b-b510-6386260f352f",
                                                "text": "The dog days of August have often spelled trouble for the world economy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "226020e7-0099-3094-b3b0-359c08a58a38",
                                        "entry_id": "ce752951-6d19-3cef-a44d-00e5a99a1660",
                                        "glosses": [
                                            "Any similar period of inactivity, laziness, or stagnation."
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f1c1939-440a-42e6-8900-cbb962e9c0f2",
                                                "sense_id": "226020e7-0099-3094-b3b0-359c08a58a38",
                                                "text": "The two-cassette miniseries, produced by Oliver Stone, arrives in early August, in time to stir the dog days of summer rentals."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eed245b2-c7f6-4456-ad66-4b03b1282f7a",
                        "source_entry_id": "40857de7-e185-352c-b34c-c8af806ca7b1",
                        "source_sense_id": "90d01e37-df3a-3225-8725-0b359d92b17b",
                        "target_lang_word": "süßes Nichtstun",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "0ac5c926-11f5-4456-a714-fc2f5c0af7d5",
                        "source_entry_id": "40857de7-e185-352c-b34c-c8af806ca7b1",
                        "source_sense_id": "90d01e37-df3a-3225-8725-0b359d92b17b",
                        "target_lang_word": "Nichtstun",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nichtstun",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cbc6e3e3-1731-3248-bcec-408abd065498",
                                        "entry_id": "2d9a7269-3493-3fcd-8624-5f7fb1707a96",
                                        "glosses": [
                                            "Verhalten ohne Aktivität"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f08139e-3934-4e5f-a7eb-20e95c66a08e",
                                                "sense_id": "cbc6e3e3-1731-3248-bcec-408abd065498",
                                                "text": "Das Unglück liegt in deinem Leben im Nichtstun."
                                            },
                                            {
                                                "example_id": "015af3da-ea34-4e25-8acd-312e47ac7dfa",
                                                "sense_id": "cbc6e3e3-1731-3248-bcec-408abd065498",
                                                "text": "„Nach drei Tagen Nichtstun und Langeweile wollte er bei den Segelmanövern mithelfen.“"
                                            },
                                            {
                                                "example_id": "9bc74844-1d7b-4aaf-9edd-53a97df6441e",
                                                "sense_id": "cbc6e3e3-1731-3248-bcec-408abd065498",
                                                "text": "„Er legte sich auf eine Waldwiese und genoss das Nichtstun.“"
                                            },
                                            {
                                                "example_id": "a303774d-d915-4619-a8e7-2f8e255eccf7",
                                                "sense_id": "cbc6e3e3-1731-3248-bcec-408abd065498",
                                                "text": "„Ich blieb drei Wochen bei ihnen und war aufgrund der Prellungen, die ich erlitten hatte, zum Nichtstun verdammt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
