                                "target_senses": [
                                    {
                                        "sense_id": "067d379a-458c-3c4c-959b-f3617a785077",
                                        "entry_id": "1b0c5d57-b313-3481-b516-6868fa6ff494",
                                        "glosses": [
                                            "iemand die de bergsport beoefend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9c4309d-d4bb-4a13-b5d6-86497562dbff",
                                                "sense_id": "067d379a-458c-3c4c-959b-f3617a785077",
                                                "text": "Voor een klimmer is het beklimmen van de Mount Everest letterlijk het hoogst haalbare."
                                            },
                                            {
                                                "example_id": "ee07c8a4-1f05-4082-8c95-efc20d06e2ab",
                                                "sense_id": "067d379a-458c-3c4c-959b-f3617a785077",
                                                "text": "De serie Everest Rescue volgt helikopterpiloten die reddingsacties uitvoeren op Mount Everest. Ze moeten vaak onder de meest hachelijke omstandigheden gestrande en gewonde klimmers redden. Het is misschien wel de gevaarlijkste plek voor helikopters om te werken en daarom worden alleen de allerbeste piloten geselecteerd. Dit seizoen volgt hen in het klimseizoen van 2016. Een jaar na de aardbeving in Nepal, die aan 8000 mensen het leven kostte en waarbij nog eens 22 bergbeklimmers omkwamen in een lawine, zijn de toeristen weer terug."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17af0bb8-bbaa-3849-b569-cf39fc44aae4",
                                        "entry_id": "1b0c5d57-b313-3481-b516-6868fa6ff494",
                                        "glosses": [
                                            "iemand die bij het wielrennen goed een berg op kan fietsen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c340dec-dfa3-46af-8ae2-08298cf34eb0",
                                                "sense_id": "17af0bb8-bbaa-3849-b569-cf39fc44aae4",
                                                "text": "Peter Winnen is een echte klimmer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8259d7d3-6613-3ce8-a24b-80da9477f5db",
                                        "entry_id": "1b0c5d57-b313-3481-b516-6868fa6ff494",
                                        "glosses": [
                                            "iemand die ten opzichte van zijn ouders een veel hogere maatschappelijke positie heeft gehaald"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40b44b3e-0ec1-4c8b-933c-5baf983fff38",
                                                "sense_id": "8259d7d3-6613-3ce8-a24b-80da9477f5db",
                                                "text": "Veel kinderen van migranten zijn klimmers."
                                            }
