                        "bon apôtre"
                    ]
                },
                {
                    "sense_id": "46f62b5b-f116-3980-be34-40adbc5a99be",
                    "sense_definition": "Personne qui a été la première à convertir un pays ou une région au christianisme.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Saint Denis est traditionnellement reconnu comme le premier évêque et l'<w>apôtre</w> de Paris."
                        },
                        {
                            "text": "Ce moine voyageur fut surnommé l'<w>apôtre</w> de la Germanie pour ses nombreuses missions."
