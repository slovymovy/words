                    {
                        "sense_id": "f4439f18-60d6-3e3f-aa0b-3155dae99e3a",
                        "entry_id": "a50d8e03-09b5-3ccd-b84d-4a7c77bf772c",
                        "glosses": [
                            "rodzaj ogólnoustrojowej reakcji alergicznej typu natychmiastowego, która ma miejsce po ekspozycji na alergen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4275b2b-483d-43da-afcf-b9184a7006e0",
                                "sense_id": "f4439f18-60d6-3e3f-aa0b-3155dae99e3a",
                                "text": "Czy anafilaksję ciężko wyleczyć?"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c2385ba2-8768-4b8b-a69f-5c62eb4f93c9",
                        "source_entry_id": "a50d8e03-09b5-3ccd-b84d-4a7c77bf772c",
                        "source_sense_id": "f4439f18-60d6-3e3f-aa0b-3155dae99e3a",
                        "target_lang_word": "anaphylaxis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anaphylaxis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6f98b67f-5f45-38dd-a835-e4a7f13fc5e7",
                                        "entry_id": "6b8555fe-9641-306c-b8dc-cf915619374e",
                                        "glosses": [
                                            "Extreme sensitivity to a substance such as a foreign protein or drug."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c3d88bb6-2545-34b5-a6af-c3580bf6b2c9",
                                        "entry_id": "6b8555fe-9641-306c-b8dc-cf915619374e",
                                        "glosses": [
                                            "A severe and rapid systemic allergic reaction to an allergen, causing a constriction of the trachea, preventing breathing; anaphylactic shock."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81e7aeb6-354b-401c-8063-404779ab0abe",
                                                "sense_id": "c3d88bb6-2545-34b5-a6af-c3580bf6b2c9",
                                                "text": "“Anyone who has experienced or witnessed an anaphylaxis reaction knows it can be very stressful deciding when to inject epinephrine to themselves or a child and often delay,” Dr. Jonathan Spergel, chief of the allergy program at Children’s Hospital of Philadelphia, said in a news release from ARS Pharmaceuticals."
                                            },
                                            {
                                                "example_id": "76e29d7f-2d3a-438f-930b-dcd2c27e2559",
                                                "sense_id": "c3d88bb6-2545-34b5-a6af-c3580bf6b2c9",
                                                "text": "He said a bite could send someone into anaphylaxis, which is a narrowing of the airways and lowering of blood pressure, within minutes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0feec5a7-25ff-4528-b9e8-9bd94969163f",
                        "source_entry_id": "a50d8e03-09b5-3ccd-b84d-4a7c77bf772c",
                        "source_sense_id": "f4439f18-60d6-3e3f-aa0b-3155dae99e3a",
                        "target_lang_word": "anaphylaxie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anaphylaxie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "438ff54f-8086-3136-bd41-67d6924b39c3",
                                        "entry_id": "6a644924-f20d-359a-9d17-4774b366282d",
                                        "glosses": [
                                            "Réaction d’hypersensibilité systémique, aiguë et potentiellement mortelle, survenant rapidement après l’exposition à un allergène ou à un agent déclencheur."
                                        ],
                                        "tags": [
                                            "Allergologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0236a5f3-81ee-4cf3-87fa-0ee8dfc244b9",
                                                "sense_id": "438ff54f-8086-3136-bd41-67d6924b39c3",
                                                "text": "L’anaphylaxie systémique est l’exemple le plus grave de réaction d’hypersensibilité immédiate."
                                            },
                                            {
                                                "example_id": "243c7990-7f55-4132-ab21-128a80166e46",
                                                "sense_id": "438ff54f-8086-3136-bd41-67d6924b39c3",
                                                "text": "La surveillance posthomologation n’a relevé aucun problème de sécurité grave à ce jour, à l’exception de rares cas d’anaphylaxie [une forme très sévère de réaction allergique]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32bd495a-7581-3018-acca-eecacd39178f",
                                        "entry_id": "6a644924-f20d-359a-9d17-4774b366282d",
                                        "glosses": [
                                            "Réaction psychique de défense, assimilée à une hypersensibilisation progressive aux émotions."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd1af89d-0e1e-43b7-b480-3bf2b7a7df91",
                                                "sense_id": "32bd495a-7581-3018-acca-eecacd39178f",
                                                "text": "Loin d’immuniser l’émotif par la répétition, chaque émotion nouvelle le sensibilise au contraire plus encore par une sorte d’anaphylaxie psychique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3906bc9e-ef11-3cae-943e-7c1bdf9484ec",
                                        "entry_id": "6a644924-f20d-359a-9d17-4774b366282d",
                                        "glosses": [
                                            "Réaction de rejet brusque et intense."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eafb56cc-944b-4e22-b159-2bdbfa76e9aa",
                                                "sense_id": "3906bc9e-ef11-3cae-943e-7c1bdf9484ec",
                                                "text": "Mais, sans apporter le moindre appareil de comparaison scientifique et parler d’anaphylaxie, disons qu’au sein de nos relations amicales ou purement mondaines, il y a une hostilité momentanément guérie, mais récurrente, par accès."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e9159ef1-300b-446e-8c1f-c867f1d5fb5b",
                        "source_entry_id": "a50d8e03-09b5-3ccd-b84d-4a7c77bf772c",
                        "source_sense_id": "f4439f18-60d6-3e3f-aa0b-3155dae99e3a",
                        "target_lang_word": "anafilaxia",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anafilaxia",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "f4e8f5e0-ecc0-3951-9b74-de652152111d",
                                        "entry_id": "3ad4c5e0-5172-31ed-86c0-36e5f8b82f6f",
                                        "glosses": [
                                            "Estado de hipersensibilidad o de reacción exagerada a la nueva introducción a una sustancia extraña, que al ser administrada por primera vez provocó reacción escasa o nula."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ebc0580a-bde3-4e37-895a-1fe291a20292",
                                                "sense_id": "f4e8f5e0-ecc0-3951-9b74-de652152111d",
                                                "text": "Es obvio que la anafilaxia tiene fundamento inmunológico, y que el choque es producido por una reacción de antígeno-anticuerpo."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
