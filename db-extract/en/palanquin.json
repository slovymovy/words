                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ed73f4d5-d0d1-3a20-9fba-019b90e3bd87",
                                        "entry_id": "9050da8e-f7bc-3304-85e2-c9fb1e046691",
                                        "glosses": [
                                            "Petit palan de bout de vergue servant à relever le bas des voiles, pendant qu'on y prenait des ris, pour que la voile ne soit pas raide."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
