                        "examples": [
                            {
                                "example_id": "505c4605-7ecd-4f51-acc4-5f079f375340",
                                "sense_id": "24d0a50f-b810-38bf-95d2-51ea21bac464",
                                "text": "Nóżka mnie boli, mamusiu."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "290d56c4-d0a2-3649-ae78-5be82e66f7ee",
                        "entry_id": "eaf5f3e5-5917-3110-9b13-469d1659c93a",
                        "glosses": [
                            "mała noga"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "696ce616-6249-456d-b42d-7636e5fba2d3",
                                "sense_id": "290d56c4-d0a2-3649-ae78-5be82e66f7ee",
                                "text": "Malutka czerwona rączka z palcami grubości zapałki z niespodziewaną siłą ułapiła palec Cesi, a cienkie nóżki, oswobodzone z pieluch, wykonały kilka energicznych kopniaków"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "f8f31424-3ab2-303e-a930-75daae885928",
                        "entry_id": "eaf5f3e5-5917-3110-9b13-469d1659c93a",
                        "glosses": [
                            "niewielka podpora, np. roweru, motocykla"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "dcabe45b-6548-3c2e-9539-8b720002bfc1",
                        "entry_id": "eaf5f3e5-5917-3110-9b13-469d1659c93a",
                        "glosses": [
                            "jedna z końcówek (wyprowadzeń) elementu elektronicznego, np. układu scalonego"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "679db464-df02-4248-a478-07b9de61891a",
                                "sense_id": "dcabe45b-6548-3c2e-9539-8b720002bfc1",
                                "text": "Ten układ ma dwadzieścia nóżek."
                            }
                        ],
                        "sense_index_json": "\"1.4\""
                    },
