                },
                {
                    "sense_id": "86f926a5-cee1-38c6-b37c-cf965e7b43ca",
                    "sense_definition": "To arrive at a shore or to land a boat.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "land",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The weary sailors managed to <w>rive</w> their small boat upon the sandy beach.",
                            "target_lang_translations": {
                                "ru": "Утомленным морякам удалось <w>причалить</w> на своей маленькой лодке к песчаному пляжу."
                            }
                        },
                        {
                            "text": "They hoped to <w>rive</w> before the tide turned against them.",
                            "target_lang_translations": {
                                "ru": "Они надеялись <w>пристать к берегу</w> до того, как прилив обернется против них."
                            }
