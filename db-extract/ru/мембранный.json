                "senses": [
                    {
                        "sense_id": "6fd1772c-abd4-3eb6-8549-16549008fe45",
                        "entry_id": "8ebacce8-5ec6-32f2-aafe-12e10703ed83",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительным мембрана"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1066db8-c4fa-43f7-b2d7-4fc436ccfad8",
                                "sense_id": "6fd1772c-abd4-3eb6-8549-16549008fe45",
                                "text": "По его мнению, оптимальным средством для использования в быту являются мембранные фильтры."
                            },
                            {
                                "example_id": "b16b7c07-6979-4e2d-9f32-928d2ef6d652",
                                "sense_id": "6fd1772c-abd4-3eb6-8549-16549008fe45",
                                "text": "Еще в 40-е годы была известна конструкция мембранной плотины под названием «брезентовая перемычка»."
                            }
                        ]
                    }
