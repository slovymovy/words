                "senses": [
                    {
                        "sense_id": "9fc76c08-1b70-324e-8feb-e6a96f54b950",
                        "entry_id": "e57625cd-5835-3465-aae9-ef0b03890887",
                        "glosses": [
                            "op de streek betrekking hebbend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92b64826-7d18-4652-b456-a7a4793ae4f6",
                                "sense_id": "9fc76c08-1b70-324e-8feb-e6a96f54b950",
                                "text": "We hebben sinds enige tijd een regionale omroep."
                            },
                            {
                                "example_id": "4f8dd344-2e10-436f-8c79-fb47c18958fb",
                                "sense_id": "9fc76c08-1b70-324e-8feb-e6a96f54b950",
                                "text": "Toeters en vlaggen: Volgens de regionale omroep RTV Oost was het ook druk in de omgeving van het stadion van de club, De Adelaarshorst. Voorbijkomende auto's toeterden erop los en mensen hingen met vlaggen uit het raam."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "756474cd-c46a-4b43-87ac-e2d199bac831",
                        "source_entry_id": "e57625cd-5835-3465-aae9-ef0b03890887",
                        "source_sense_id": "9fc76c08-1b70-324e-8feb-e6a96f54b950",
                        "source_sense_description": "op de streek betrekking hebbend",
                        "target_lang_word": "regional",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "regional",
