                        "sense_id": "9c7997fd-b17f-3267-86de-2b05521421bd",
                        "entry_id": "dc68de67-2d54-32aa-8718-8c2772812c3b",
                        "glosses": [
                            "Définition manquante ou à compléter. (Ajouter)"
                        ],
                        "tags": [
                            "Transitude"
                        ],
                        "examples": [
                            {
                                "example_id": "1c1ceed7-5a98-4336-aa3b-2d0aa90950d5",
                                "sense_id": "9c7997fd-b17f-3267-86de-2b05521421bd",
                                "text": "Le transgendrisme désigne un changement non exécuté du sexe masculin vers le genre féminin ou vice-versa. Ce sera le transsexuel qui reste au milieu du gué. L’intéressé recherchera changement d'identité permanent."
                            }
                        ]
                    },
                    {
                        "sense_id": "0908a1a6-c7f7-3547-bd71-c749f4c8900f",
                        "entry_id": "dc68de67-2d54-32aa-8718-8c2772812c3b",
                        "glosses": [
                            "Transidentité."
                        ],
                        "tags": [
                            "Transitude"
                        ],
                        "examples": [
                            {
                                "example_id": "f04c7cd7-b8b9-4035-a228-4c12ca288a11",
                                "sense_id": "0908a1a6-c7f7-3547-bd71-c749f4c8900f",
                                "text": "Le transsexualisme ou le « transgendrisme » participent, comme le transhumanisme de cette revendication de toute puissance qui nous permet de façonner, de contrôler, de fabriquer sans surprise de l’humain ou du post-humain en quête de performance absolue."
                            },
                            {
                                "example_id": "c90a472a-c401-4cfa-b07c-229f3965d3e2",
                                "sense_id": "0908a1a6-c7f7-3547-bd71-c749f4c8900f",
                                "text": "Toute personne faisant publiquement la « promotion de la sodomie, du lesbianisme, de la bisexualité et du transgendrisme » auprès de mineurs sera condamnée à une amende allant jusqu’à 3000 roubles (78 euros)."
                            }
                        ]
                    }
