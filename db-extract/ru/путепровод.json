                "senses": [
                    {
                        "sense_id": "3a9914e0-8c98-39be-9f4e-60f09a2d5a5d",
                        "entry_id": "651c893e-c40d-38ed-8313-79499036d56d",
                        "glosses": [
                            "мост над дорогой или тоннель в месте пересечения с другой дорогой, оврагом, ущельем или другим естественным или искусственным препятствием"
                        ],
                        "tags": [],
