{
    "word_family": [
        "elusion",
        "elusive",
        "elusiveness"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1781b002-ccc2-3df0-b43a-a41bc98de80c",
                    "sense_definition": "To evade or escape from someone or something, especially by using cunning or skill.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "escape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The criminal managed to <w>elude</w> the police by hiding in the dense forest for several days.",
                            "target_lang_translations": {
                                "ru": "Преступнику удалось <w>ускользнуть</w> от полиции, скрываясь в густом лесу в течение нескольких дней."
                            }
                        },
                        {
                            "text": "Despite their best efforts, the championship title continued to <w>elude</w> the team for another season.",
                            "target_lang_translations": {
                                "ru": "Несмотря на все усилия, чемпионский титул продолжал <w>ускользать</w> от команды еще один сезон."
                            }
                        }
                    ],
                    "synonyms": [
                        "evade",
                        "escape",
                        "dodge",
                        "avoid"
                    ],
                    "antonyms": [
                        "confront",
                        "encounter"
                    ],
                    "common_phrases": [
                        "elude capture",
                        "elude detection",
                        "elude the police"
                    ],
                    "target_lang_definitions": {
                        "ru": "Избегать или спасаться от кого-либо или чего-либо, особенно используя хитрость или мастерство."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ускользать",
                                "target_lang_sense_clarification": "от преследования или ответственности"
                            },
                            {
                                "target_lang_word": "избегать",
                                "target_lang_sense_clarification": "поимки или встречи"
                            },
                            {
                                "target_lang_word": "уклоняться",
                                "target_lang_sense_clarification": "от выполнения чего-либо или от кого-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e68b4e16-c27c-30c9-992b-61623f9efb02",
                    "sense_definition": "To shake off a pursuer or give someone the slip during a chase.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "escape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The clever fox was able to <w>elude</w> the hounds by crossing the shallow stream.",
                            "target_lang_translations": {
                                "ru": "Хитрая лиса смогла <w>оторваться</w> от гончих, перейдя неглубокий ручей."
                            }
                        },
                        {
                            "text": "He managed to <w>elude</w> his pursuers by ducking into a crowded subway station.",
                            "target_lang_translations": {
                                "ru": "Ему удалось <w>скрыться</w> от преследователей, нырнув в многолюдную станцию метро."
                            }
                        }
                    ],
                    "synonyms": [
                        "outrun",
                        "lose"
                    ],
                    "antonyms": [
                        "catch",
                        "capture"
                    ],
                    "common_phrases": [
                        "elude pursuers",
                        "elude a chase"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оторваться от преследователя или обмануть его во время погони."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ускользнуть",
                                "target_lang_sense_clarification": "от преследователей"
                            },
                            {
                                "target_lang_word": "сбивать с толку",
                                "target_lang_sense_clarification": "преследователя"
                            },
                            {
                                "target_lang_word": "оторваться",
                                "target_lang_sense_clarification": "от погони"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ddc82bb3-f4c5-3714-a13d-36318a9f8be7",
                    "sense_definition": "To be incomprehensible to someone or escape being understandable.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "understanding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The complex logic of the advanced physics lecture seemed to <w>elude</w> most of the students.",
                            "target_lang_translations": {
                                "ru": "Сложная логика лекции по продвинутой физике, казалось, <w>ускользала</w> от большинства студентов."
                            }
                        },
                        {
                            "text": "I understand basic arithmetic, but the principles of calculus completely <w>elude</w> me.",
                            "target_lang_translations": {
                                "ru": "Я понимаю основы арифметики, но принципы исчисления совершенно <w>не поддаются</w> моему пониманию."
                            }
                        }
                    ],
                    "synonyms": [
                        "baffle",
                        "escape"
                    ],
                    "antonyms": [
                        "understand",
                        "grasp"
                    ],
                    "common_phrases": [
                        "elude understanding",
                        "elude logic"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть непонятным для кого-либо или не поддаваться пониманию."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ускользать",
                                "target_lang_sense_clarification": "от понимания"
                            },
                            {
                                "target_lang_word": "не поддаваться",
                                "target_lang_sense_clarification": "осмыслению"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9797b1c3-72b7-3ff6-887d-46ed28e5d4fb",
                    "sense_definition": "To escape someone's memory or slip someone's mind.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "memory",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I know her face very well, but her name continues to <w>elude</w> me at the moment.",
                            "target_lang_translations": {
                                "ru": "Я очень хорошо знаю её лицо, но её имя в данный момент продолжает <w>ускользать</w> из моей памяти."
                            }
                        },
                        {
                            "text": "The specific details of the contract <w>elude</w> my memory, so I will have to check the files.",
                            "target_lang_translations": {
                                "ru": "Точные детали контракта <w>вылетели</w> у меня из головы, поэтому мне придется проверить документы."
                            }
                        }
                    ],
                    "synonyms": [
                        "escape"
                    ],
                    "antonyms": [
                        "remember",
                        "recall"
                    ],
                    "common_phrases": [
                        "elude memory",
                        "elude one's mind"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вылетать из памяти или забываться."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вылетать из головы",
                                "target_lang_sense_clarification": "о памяти"
                            },
                            {
                                "target_lang_word": "ускользать",
                                "target_lang_sense_clarification": "из памяти"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}