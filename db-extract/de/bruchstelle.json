                                "target_senses": [
                                    {
                                        "sense_id": "ed8d5887-362d-3b8a-bfe9-a452f220913d",
                                        "entry_id": "2cf83263-2353-341f-9d3c-566d0b412aad",
                                        "glosses": [
                                            "The point at which the increasing strain in a material causes it to break."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "736b0b89-b22e-341b-b691-3bcf96355256",
                                        "entry_id": "2cf83263-2353-341f-9d3c-566d0b412aad",
                                        "glosses": [
                                            "The point at which a person or system succumbs to stresses or pressures and descends into crisis."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84ad669c-864f-4442-bcfb-ecefd92be946",
                                                "sense_id": "736b0b89-b22e-341b-b691-3bcf96355256",
                                                "text": "Even before Hurricane Sandy, New York was sheltering more homeless people than any city in the United States: a record 47,000 women, men and children, in a system strained to the breaking point."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "67fc696b-1e8c-4a6e-8690-6728b77ab174",
                        "source_entry_id": "48dd0ec9-6c49-3f53-be45-69749a8c5520",
                        "source_sense_id": "42f3e4f9-ff26-3081-89fb-d9cf1d4a8a1a",
                        "source_sense_description": "Stelle, an der etwas gebrochen ist",
                        "target_lang_word": "brisure",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brisure",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "13d069f8-fdda-3af4-92a2-2e75e4ea16b5",
                                        "entry_id": "517dcee6-0665-34ff-89b4-629bd3c82638",
                                        "glosses": [
                                            "Partie brisée, cassée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a68607e6-f1e4-4977-bfc3-1ca23d2ed7a7",
                                                "sense_id": "13d069f8-fdda-3af4-92a2-2e75e4ea16b5",
                                                "text": "Il y a des brisures dans ce parquet, dans cette boiserie."
                                            },
                                            {
                                                "example_id": "61a69d19-66e6-4e35-9a91-d121bab4c53c",
                                                "sense_id": "13d069f8-fdda-3af4-92a2-2e75e4ea16b5",
                                                "text": "Enfin, elle n’avait qu’une corne, celle de gauche. L’autre était cassée tout près du crâne, si bien que dans la laine, seule se devinait la ligne de brisure."
                                            },
                                            {
                                                "example_id": "5ca78138-a9ca-48e0-ba6b-64d83eca02e3",
                                                "sense_id": "13d069f8-fdda-3af4-92a2-2e75e4ea16b5",
                                                "text": "Les brisures de riz, aujourd’hui très présentes dans la cuisine des migrants béti et bamiléké, et surtout dans la restauration ambulante, ne relèvent que d’une innovation relativement récente qui remonte à la fin du XXᵉ siècle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71d1924c-6502-3213-8976-e1786c15a569",
                                        "entry_id": "517dcee6-0665-34ff-89b4-629bd3c82638",
                                        "glosses": [
                                            "Rupture de quelque chose de matériel."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1951fd0e-606d-3093-a2b3-bed87bd78fe1",
                                        "entry_id": "517dcee6-0665-34ff-89b4-629bd3c82638",
                                        "glosses": [
                                            "Rupture de quelque chose d’abstrait."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5535b2d-11c5-4cbd-b159-3c6b934ba54e",
                                                "sense_id": "1951fd0e-606d-3093-a2b3-bed87bd78fe1",
                                                "text": "Je sers le thé et nous le dégustons en silence. Nous ne l’avons jamais pris ensemble le matin et cette brisure dans le protocole de notre rituel a une étrange saveur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba0d3e88-f1f8-3b1a-ae40-f5b63c8134a9",
                                        "entry_id": "517dcee6-0665-34ff-89b4-629bd3c82638",
                                        "glosses": [
                                            "Partie d’un ouvrage de menuiserie ou de serrurerie qui se replie les unes sur les autres au moyen de charnières."
                                        ],
                                        "tags": [
                                            "Serrurerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08f84c62-8866-4828-9aae-0f425521da5a",
                                                "sense_id": "ba0d3e88-f1f8-3b1a-ae40-f5b63c8134a9",
                                                "text": "La brisure d’un volet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cfe6499f-33e9-375c-b5e5-72bbbbfef100",
                                        "entry_id": "517dcee6-0665-34ff-89b4-629bd3c82638",
                                        "glosses": [
                                            "Ligne pour couvrir le flanc d’une fortification."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1145b6be-b42c-35ee-b25c-3720fbc1a4f7",
                                        "entry_id": "517dcee6-0665-34ff-89b4-629bd3c82638",
                                        "glosses": [
                                            "Toute pièce d’armoiries qui modifie l’écu pour distinguer les cadets, les bâtards."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4bd69bcc-aff9-4574-acb3-eeb652d77390",
                                                "sense_id": "1145b6be-b42c-35ee-b25c-3720fbc1a4f7",
                                                "text": "Il est aisé d’en déduire une brisure par rapport à un état initial de l’écu garni de quatre roses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b951fed8-ea1e-3828-a4d5-392a58f4be54",
                                        "entry_id": "517dcee6-0665-34ff-89b4-629bd3c82638",
                                        "glosses": [
                                            "Petite bande d’étoffe qui borde une encolure, un poignet."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4d889a46-71d6-31c4-9ef9-aa350b592114",
                                        "entry_id": "517dcee6-0665-34ff-89b4-629bd3c82638",
                                        "glosses": [
                                            "Charnière de l’apprêt d’une boucle d'oreille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2db79688-be72-4b14-810f-dfdb32b22c41",
                                                "sense_id": "4d889a46-71d6-31c4-9ef9-aa350b592114",
                                                "text": "On passe la tige par le trou de perçage afin qu’elle vienne se loger dans une partie mobile située à l’arrière de l’oreille et que l’on referme à l’aide d’une charnière, appelée brisure par les bijoutiers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e569c66a-2bed-3b68-801d-bb645f3a33ee",
                                        "entry_id": "517dcee6-0665-34ff-89b4-629bd3c82638",
                                        "glosses": [
                                            "Blessure, physique ou émotionnelle ; traumatisme."
                                        ],
                                        "tags": [
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "265eaa78-2085-4115-bda8-254723aeaeb2",
                                                "sense_id": "e569c66a-2bed-3b68-801d-bb645f3a33ee",
                                                "text": "Je n’ai aucune promptitude\nje suis là déchaînée mais inerte\nIl n’y a plus que cette brisure ensoleillée\ncette blanche impulsion où la vie se déploie\ncet instinct de la lumière\noù tout vous constate en secret"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
