                ],
                "senses": [
                    {
                        "sense_id": "80ea73e9-904b-3a01-8a0f-af8acf50acbc",
                        "entry_id": "f880abc0-be02-3f91-8392-cd20f0ff1a73",
                        "glosses": [
                            "Action de broyer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24d619eb-94cd-46a7-bbb3-16b67098f2d6",
                                "sense_id": "80ea73e9-904b-3a01-8a0f-af8acf50acbc",
                                "text": "Le broiement des couleurs, des grains, du plâtre."
                            },
                            {
                                "example_id": "c5fbc45b-f0a5-4200-8f37-16d74fac921f",
                                "sense_id": "80ea73e9-904b-3a01-8a0f-af8acf50acbc",
                                "text": "On est parvenu à pratiquer le broiement de la pierre dans la vessie."
                            },
                            {
                                "example_id": "ef17f3aa-f8f1-4f05-8307-69bf27554cb7",
                                "sense_id": "80ea73e9-904b-3a01-8a0f-af8acf50acbc",
                                "text": "Il sentait cela très vivement. Il savait tout du danger de travailler sans dispositif de sécurité. Rien qu’à y penser, il sentait dans sa main le broiement du moule qui se referme."
                            },
                            {
                                "example_id": "4b966c08-2b17-4fc3-91a8-15fdba7dccfb",
                                "sense_id": "80ea73e9-904b-3a01-8a0f-af8acf50acbc",
                                "text": "La carcasse du navire écrase les bouées contre le granite, en doux craquements chlorés qui rappellent un broiement d’os."
                            }
                        ]
                    }
                ],
