                        "cross_references": [
                            {
                                "target_word": "hold-up",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "031954de-8811-322a-9906-743d7b70e413",
                                        "entry_id": "f38c29b7-fd20-3c86-9ade-b9167884ae1e",
                                        "glosses": [
                                            "gewapende overval (waarbij de slachtoffers de handen omhoog moeten houden)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9403641-c46a-4cf5-9ea9-79b9b483d653",
                                                "sense_id": "031954de-8811-322a-9906-743d7b70e413",
                                                "text": "Op 4 maart 2017 werden twee agenten door een overste naar het Westland Shopping Center gestuurd. Naar verluidt om prijzen voor een quiz te kopen, die kort daarop georganiseerd werd door de zone. Net op dat moment vond even verderop een hold-up plaats op een merkkledingwinkel. De agenten werden opgeroepen, maar stonden nog pralines te kopen."
                                            },
                                            {
                                                "example_id": "a1a68bda-c256-4795-9e95-0dace12e00c1",
                                                "sense_id": "031954de-8811-322a-9906-743d7b70e413",
                                                "text": "In de slotfase zette Genk alle zeilen bij om de drie punten thuis te houden. In het doelgebied van Verhulst vielen nog heel wat hete standjes te noteren, maar ei zo na pleegde Lokeren een hold-up."
                                            },
                                            {
                                                "example_id": "d123f689-6d00-486b-9343-b17023fa31e3",
                                                "sense_id": "031954de-8811-322a-9906-743d7b70e413",
                                                "text": "In de zaak van de Bende van Nijvel treedt Vermassen op voor David Van de Steen, die bij de overval op de Delhaize in Aalst op 9 november 1985 zijn ouders en zijn zus verloor. Bij die hold-up kwamen acht mensen om het leven."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
