                                                "sense_id": "00c85a9f-5d73-36be-8d2b-6aa5d663d084",
                                                "text": "Despite protesting his innocence under torture, the sexagenarian father was condemned by the Parlement in March 1762 to be broken on the wheel, a fate which he bore with stoical fortitude."
                                            }
                                        ]
                                    }
                                ]
                            }
