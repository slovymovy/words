                    {
                        "sense_id": "107c261a-82c2-38dc-9c39-29c37309e3da",
                        "entry_id": "43e9117a-f9be-3484-aa1d-e9e368e659bf",
                        "glosses": [
                            "Algue comestible populaire en cuisine japonaise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ccde8890-9449-4e29-b365-f95da33d2802",
                                "sense_id": "107c261a-82c2-38dc-9c39-29c37309e3da",
                                "text": "Le wakamé est une algue populaire dans la gastronomie asiatique non seulement pour ses qualités gustatives, mais aussi pour ses vertus nutritives."
                            },
                            {
                                "example_id": "bc497169-161c-4f38-bc6f-1a8c617ffad5",
                                "sense_id": "107c261a-82c2-38dc-9c39-29c37309e3da",
                                "text": "Le wakamé a un goût et un parfum iodé, proche de ceux de l’huître."
                            },
                            {
                                "example_id": "8f9b4dbb-2e1b-4238-9d90-22f8b9261867",
                                "sense_id": "107c261a-82c2-38dc-9c39-29c37309e3da",
                                "text": "Le wakamé, une algue aux propriétés thérapeutiques étonnantes"
                            },
                            {
                                "example_id": "1a471fff-78f1-4f83-987e-d0be72916cad",
                                "sense_id": "107c261a-82c2-38dc-9c39-29c37309e3da",
                                "text": "Le liant est obtenu par la wakamé elle-même qui se dissout à la cuisson et devient légèrement liante."
                            },
                            {
                                "example_id": "167e3af1-3a78-4159-9d3f-9f0fcc0fcd74",
                                "sense_id": "107c261a-82c2-38dc-9c39-29c37309e3da",
                                "text": "Elle appartient à Algolesko, une start-up finistérienne qui y produit principalement en bio deux algues brunes comestibles : du wakamé et de la laminaire sucrée."
                            }
                        ]
                    }
