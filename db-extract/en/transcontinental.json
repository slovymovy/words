                    {
                        "sense_id": "1e27608f-3176-393f-b73c-fe3e4a4707db",
                        "entry_id": "21514e9b-12a2-365c-85ec-8f05b25be6db",
                        "glosses": [
                            "Crossing or spanning a continent."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "eee126e6-c810-45d2-9352-8c768a579f9d",
                                "sense_id": "1e27608f-3176-393f-b73c-fe3e4a4707db",
                                "text": "In that year [1871] British Columbia decided to become part of the Dominion of Canada, on condition that a transcontinental railway should be completed without delay."
                            },
                            {
                                "example_id": "cbdc80c5-7428-47e4-8e2a-c6919a847575",
                                "sense_id": "1e27608f-3176-393f-b73c-fe3e4a4707db",
                                "text": "It is the transcontinental trains which figure most prominently in railway advertising. Both railways run two trains in each direction."
                            }
                        ]
                    }
                ],
                "translations": [
