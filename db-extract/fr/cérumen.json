                "senses": [
                    {
                        "sense_id": "884b340d-34ca-3322-97d9-ec7f42ca8193",
                        "entry_id": "14762d66-1e01-3de0-9d14-ac9391a21e0d",
                        "glosses": [
                            "Matière épaisse et jaunâtre ou blanchâtre sécrétée par des glandes situées dans le conduit auditif externe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82ee7857-2ce7-4853-8e6a-4b7285b19e85",
                                "sense_id": "884b340d-34ca-3322-97d9-ec7f42ca8193",
                                "text": "Le diagnostic d’otacariose est confirmé par la mise en évidence d’otodectes dans le cérumen grâce aux examens otoscopique et microscopique."
                            },
                            {
                                "example_id": "43bbde10-a088-4595-b1c7-04de9c98de9c",
                                "sense_id": "884b340d-34ca-3322-97d9-ec7f42ca8193",
                                "text": "Or le cérumen est sécrété naturellement pour lubrifier la peau de l’oreille, tapissée de petits poils, et l’aider à rester souple et tonique. Tout cela permet de chasser les impuretés de l’oreille et en assurer l’auto-nettoyage »."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ce319fad-0bcc-4251-9660-a5d9c236e948",
                        "source_entry_id": "14762d66-1e01-3de0-9d14-ac9391a21e0d",
