                    },
                    {
                        "translation_id": "8fb24323-567b-497d-8d3a-084331d78935",
                        "source_entry_id": "f5494416-74bf-3473-9da1-fc03060ae758",
                        "source_sense_id": "351be1ad-c34c-3569-97b0-1cb052f59de8",
