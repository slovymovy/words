                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29e70b1f-7bf6-4bcc-b44c-899f4e1a19c8",
                                "sense_id": "5d177f1f-4a53-312d-a36a-8286af24f8ba",
                                "text": "Elle a mis son système en place avant même la naissance de l’enfant, en se forçant à suivre un régime alimentaire ultra-nutritif – qui la rendait malade, mais tant pis – tout au long de sa grossesse."
                            },
                            {
                                "example_id": "e3fb019c-7882-42c1-bc81-37e96f213116",
                                "sense_id": "5d177f1f-4a53-312d-a36a-8286af24f8ba",
                                "text": "Pour un velouté ultra-nutritif, mixez du chou-fleur qui servira de « crème »."
                            },
                            {
                                "example_id": "677e5da8-8cd5-4506-b5f6-fa6e93413e53",
                                "sense_id": "5d177f1f-4a53-312d-a36a-8286af24f8ba",
                                "text": "Avant, il s’agit de colostrum, un liquide ultra-nutritif idéal pour l’enfant, notamment pour un bon démarrage de son immunité."
                            }
                        ]
                    }
