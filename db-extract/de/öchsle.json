                ],
                "senses": [
                    {
                        "sense_id": "e2fd6764-8556-36c9-9790-82c5bf2efa4e",
                        "entry_id": "17e704a5-08d2-3275-b25b-09982713be41",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bccdfba7-a060-472f-baa1-e97fe975902f",
                                "sense_id": "e2fd6764-8556-36c9-9790-82c5bf2efa4e",
                                "text": "Frau Öchsle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "9e593821-e58e-45fc-9fb5-1c6393c79da2",
                                "sense_id": "e2fd6764-8556-36c9-9790-82c5bf2efa4e",
                                "text": "Herr Öchsle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "dc0f9407-878d-489e-8545-b1cd0d10e257",
                                "sense_id": "e2fd6764-8556-36c9-9790-82c5bf2efa4e",
                                "text": "Die Öchsles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "38a29fb6-d4af-4668-bd8e-ed08d14756a9",
                                "sense_id": "e2fd6764-8556-36c9-9790-82c5bf2efa4e",
                                "text": "Der Öchsle trägt nie die Pullover, die die Öchsle ihm strickt."
                            },
                            {
                                "example_id": "197d82b5-b400-4893-8a19-5a7910c3851c",
                                "sense_id": "e2fd6764-8556-36c9-9790-82c5bf2efa4e",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Öchsle kommt, geht der Herr Öchsle.“"
                            },
                            {
                                "example_id": "babb70f7-9b10-4095-8521-8846ce49341a",
                                "sense_id": "e2fd6764-8556-36c9-9790-82c5bf2efa4e",
                                "text": "Öchsle kommt und geht."
                            },
                            {
                                "example_id": "3ad58845-4016-47cd-89c5-19872d376b51",
                                "sense_id": "e2fd6764-8556-36c9-9790-82c5bf2efa4e",
                                "text": "Öchsles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
