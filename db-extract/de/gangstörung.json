                "senses": [
                    {
                        "sense_id": "b2675ce3-e7ee-325e-92d0-6225a0e3f478",
                        "entry_id": "1d9dd855-d5f8-31fa-8098-b9c4afa565be",
                        "glosses": [
                            "beeinträchtigte Funktion der zur Bewegung benötigten Körperteile; gestörtes Gangbild (zum Beispiel Humpeln, kleine Schritte, auffällig langsames Gehen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6224da62-b45e-4280-b847-9ad9f863b0cb",
                                "sense_id": "b2675ce3-e7ee-325e-92d0-6225a0e3f478",
                                "text": "„Gangstörungen sind oft multifaktoriell und können Folge von Störungen in ganz unterschiedlichen neurologischen Systemen sein […].“"
                            },
                            {
                                "example_id": "34e4e218-7123-4a89-888a-146941f0ee7b",
                                "sense_id": "b2675ce3-e7ee-325e-92d0-6225a0e3f478",
                                "text": "„Zu Gangstörungen kann es bereits kommen, wenn bei einem dieser Faktoren eine Fehlfunktion vorliegt.“"
                            },
                            {
                                "example_id": "c1492a67-266a-4cc2-8c56-9a7fc51b25f2",
                                "sense_id": "b2675ce3-e7ee-325e-92d0-6225a0e3f478",
                                "text": "„Die 13-jährige Marianne wurde stationär in eine Kinderklinik aufgenommen, nachdem sie in den drei Monaten zuvor eine ausgeprägte Gangstörung (»schnappendes Einknicken des rechten Beines im Kniegelenk«) entwickelt hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
