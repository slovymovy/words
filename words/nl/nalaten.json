{
    "word_family": [
        "nalatenschap",
        "nalatig",
        "nalatigheid"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b56169c5-e4d5-371c-8109-778f95e0c1c0",
                    "sense_definition": "iets aan iemand toebedelen in een testament na overlijden",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "erfenis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De rijke man besloot zijn gehele vermogen <w>na te laten</w> aan een goed doel.",
                            "target_lang_translations": {
                                "en": "The wealthy man decided to <w>bequeath</w> his entire fortune to a charity."
                            }
                        },
                        {
                            "text": "Wat zou ik mijn kinderen <w>nalaten</w> als ik er morgen niet meer zou zijn?",
                            "target_lang_translations": {
                                "en": "What would I <w>leave</w> to my children if I were no longer here tomorrow?"
                            }
                        }
                    ],
                    "synonyms": [
                        "vermaken"
                    ],
                    "common_phrases": [
                        "vermogen nalaten",
                        "erfenis nalaten"
                    ],
                    "target_lang_definitions": {
                        "en": "to allocate something to someone in a will after death"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bequeath",
                                "target_lang_sense_clarification": "to leave property or money to someone in a will"
                            },
                            {
                                "target_lang_word": "leave",
                                "target_lang_sense_clarification": "to give something to someone in a will"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c3f28023-d322-364a-b588-240dcc9d98b0",
                    "sense_definition": "iets niet doen wat men eigenlijk had moeten of kunnen doen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verzuim",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>liet na</w> de gevolgen van zijn beslissing goed te overzien.",
                            "target_lang_translations": {
                                "en": "He <w>failed</w> to properly oversee the consequences of his decision."
                            }
                        },
                        {
                            "text": "Je mag niet <w>nalaten</w> om de nodige veiligheidsmaatregelen te treffen voor het experiment.",
                            "target_lang_translations": {
                                "en": "You must not <w>neglect</w> to take the necessary safety measures for the experiment."
                            }
                        }
                    ],
                    "synonyms": [
                        "verzaken",
                        "verzuimen"
                    ],
                    "common_phrases": [
                        "niet nalaten te",
                        "hulp nalaten"
                    ],
                    "target_lang_definitions": {
                        "en": "to not do something that one actually should or could have done"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fail",
                                "target_lang_sense_clarification": "to not perform an expected action"
                            },
                            {
                                "target_lang_word": "omit",
                                "target_lang_sense_clarification": "to leave out or fail to do something"
                            },
                            {
                                "target_lang_word": "neglect",
                                "target_lang_sense_clarification": "to fail to carry out a duty or task"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5a8d57ec-bdfa-3b19-b6d6-5811fbc8bf18",
                    "sense_definition": "iets doorgeven of schenken aan de volgende generaties",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "erfenis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De filosoof heeft ons vele wijze woorden <w>nagelaten</w> over de zin van het leven.",
                            "target_lang_translations": {
                                "en": "The philosopher has <w>left</w> us many wise words about the meaning of life."
                            }
                        },
                        {
                            "text": "Het is belangrijk om een gezonde planeet <w>na te laten</w> aan ons nageslacht.",
                            "target_lang_translations": {
                                "en": "It is important to <w>pass on</w> a healthy planet to our offspring."
                            }
                        }
                    ],
                    "common_phrases": [
                        "aan het nageslacht nalaten"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vaak in overdrachtelijke zin gebruikt"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to pass on or give something to future generations"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "leave",
                                "target_lang_sense_clarification": "to pass on a legacy or impact"
                            },
                            {
                                "target_lang_word": "bequeath",
                                "target_lang_sense_clarification": "to hand down or transmit to posterity"
                            },
                            {
                                "target_lang_word": "pass on",
                                "target_lang_sense_clarification": "to give something to those who come after"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}