                "senses": [
                    {
                        "sense_id": "e28cb68f-f0d8-33fb-a2bb-5d4ca1e0b99c",
                        "entry_id": "c22b4ebd-a998-32c4-8a3a-d493319bc6c0",
                        "glosses": [
                            "Ableitung, Folgerung von etwas (etwa einer Hypothese, Formel oder eines Wortes), um etwas zu beweisen oder zu erklären"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5619d7a-08ed-4422-8465-54fdadabaf67",
                                "sense_id": "e28cb68f-f0d8-33fb-a2bb-5d4ca1e0b99c",
                                "text": "„Die oft als ‚g‘ bezeichnete Konstante hat Isaac Newton im Jahre 1686 bei seiner theoretischen Herleitung des Gravitationsgesetzes eingeführt, ohne ihr jedoch einen Zahlenwert zu geben.“"
                            },
                            {
                                "example_id": "c26244c2-7e7d-4cc9-ba6f-94aa800d2e2a",
                                "sense_id": "e28cb68f-f0d8-33fb-a2bb-5d4ca1e0b99c",
                                "text": "„Im Routinealltag wird für gefällte Entscheidungen nach Ursachen, Wirkung und Folge sowie Begründungen und logischen Herleitungen gesucht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
