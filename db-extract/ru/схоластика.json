                    {
                        "translation_id": "15019d3d-a3ba-4cc3-9026-dacd4aa8c702",
                        "source_entry_id": "f3ed212b-e2e5-3b58-82d3-30e096da2e9e",
                        "source_sense_description": "систематическая европейская средневековая философия",
                        "target_lang_word": "Scholastik",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
