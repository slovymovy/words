{
    "word_family": [
        "attirance",
        "tirer"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a3105c0c-f877-3b7e-8d4a-1bf18a01d111",
                    "sense_definition": "Exercer une force d'attraction, faire venir à soi ou capter l'intérêt et la curiosité.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "attraction_physique_mentale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le bruit soudain dans la rue a fini par <w>attirer</w> l'attention de tous les voisins."
                        },
                        {
                            "text": "Ce festival de musique gratuit permet chaque été d'<w>attirer</w> du monde dans la région."
                        }
                    ],
                    "common_phrases": [
                        "attirer l'attention",
                        "attirer du monde"
                    ]
                },
                {
                    "sense_id": "b9deac4e-894d-31bf-a8f3-91786a6cdb3a",
                    "sense_definition": "Séduire ou appâter quelqu'un en faisant naître une tentation ou un espoir trompeur.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "seduction_piege",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les escrocs ont réussi à <w>attirer</w> dans un piège plusieurs investisseurs naïfs."
                        },
                        {
                            "text": "Le fromage parfumé sert à <w>attirer</w> la souris hors de sa cachette nocturne."
                        }
                    ],
                    "common_phrases": [
                        "attirer dans un piège"
                    ]
                },
                {
                    "sense_id": "90fa53d6-2d80-3cdf-aa2e-8fe83f21e680",
                    "sense_definition": "Susciter ou provoquer à son propre égard, souvent à la forme pronominale.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "consequences_personnelles",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "À force d'arriver en retard, il a fini par s'<w>attirer</w> des ennuis au travail."
                        },
                        {
                            "text": "Par son imprudence, il a fini par s'<w>attirer</w> les reproches de son directeur."
                        }
                    ],
                    "common_phrases": [
                        "s'attirer des ennuis",
                        "s'attirer les foudres"
                    ]
                }
            ]
        }
    ]
}