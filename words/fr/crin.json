                {
                    "sense_id": "37dc3e07-3bd4-3e9d-bb97-e25d0d753843",
                    "sense_definition": "Poil long et rude de certains animaux, en particulier de la crinière et de la queue du cheval.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "matiere_poil",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le cavalier brosse régulièrement la queue de sa monture pour en démêler le <w>crin</w>."
                        },
                        {
                            "text": "Les artisans utilisaient souvent du véritable <w>crin</w> de cheval pour fabriquer des tamis solides."
                        }
                    ],
                    "common_phrases": [
                        "crin de cheval"
                    ]
                },
                {
                    "sense_id": "1c5c2b36-dcbe-3644-aaa5-177ebe2912e4",
                    "sense_definition": "Matière textile ou de rembourrage faite de ces poils ou de fibres végétales similaires, servant aussi pour garnir les archets.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "matiere_poil",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce tapissier traditionnel utilise un vieux matelas de <w>crin</w> pour restaurer l'assise du fauteuil."
                        },
                        {
                            "text": "Elle frictionne énergiquement ses jambes avec un gant de <w>crin</w> pour stimuler la circulation sanguine."
                        }
                    ],
                    "common_phrases": [
                        "gant de crin",
                        "matelas de crin"
                    ]
                },
                {
                    "sense_id": "de8f0bb9-2bb5-30e6-b3a7-78546b34ad78",
                    "sense_definition": "Cheveu ou poil humain rude et épais.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "matiere_poil",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En vieillissant, l'homme arborait un <w>crin</w> argenté qui lui donnait un air particulièrement sévère."
                        },
                        {
                            "text": "Le vent soufflait fort sur la falaise, décoiffant complètement son <w>crin</w> épais et rebelle."
                        }
                    ],
                    "synonyms": [
                        "cheveu",
                        "poil"
                    ],
                    "traits": [
