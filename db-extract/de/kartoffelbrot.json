                        "glosses": [
                            "Brot, das unter Verwendung von Kartoffeln hergestellt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b025cfd9-93fb-42a3-ac69-672a14dfc52a",
                                "sense_id": "ec4be4b5-7f4d-3f92-8ee2-aab89a1cf89f",
                                "text": "„Im Ersten Weltkrieg wurde ein mit Kartoffelmehl gestrecktes Brot produziert. Offiziell »Kriegsbrot« getauft, verleitete es das Publikum, das Kurzwort »K-Brot« als »Kartoffelbrot« aufzulösen (nicht identisch mit dem »Kommissbrot«, das schon seit dem 18. Jahrhundert in der Landsersprache geläufig war).“"
                            }
                        ],
