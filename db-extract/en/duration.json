                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "947918e9-f0e7-4907-90c8-f9efb0f67f46",
                                                "sense_id": "a1a1402c-f733-3713-a427-cf21a016ccc6",
                                                "text": "De nummers op deze cd variëren in tijdsduur van drie tot acht minuten."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0c95eefb-52b3-4250-9ef4-065aaebd625a",
                        "source_entry_id": "0dbd7316-d35e-3fac-afd0-f5f9a060d50d",
                        "source_sense_description": "amount of time",
                        "target_lang_word": "duur",
                        "target_lang_code": "nl",
