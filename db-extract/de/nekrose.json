                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e01d3fc1-234c-3640-affc-ba19b7526c80",
                                        "entry_id": "b9d8b922-b40c-3e2b-8cea-dd90d2acdaa6",
                                        "glosses": [
                                            "Troisième personne du singulier de l’indicatif présent du verbe nécroser."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b5cecf1-a262-4a71-9f0d-fd9455209d17",
                                                "sense_id": "e01d3fc1-234c-3640-affc-ba19b7526c80",
                                                "text": "Un caillou a obstrué le cholédoque… Le pancréas, ne recevant plus sa ration de graisses, se nécrose… — C’est-à-dire ? — Il… s’autodévore."
                                            }
