                "senses": [
                    {
                        "sense_id": "ae007388-9eb1-3ad5-acb5-c4f4c1da3b05",
                        "entry_id": "d68a8157-dfa0-3a55-93bd-6a2feebdcfbe",
                        "glosses": [
                            "Auftreten der Erkrankung am Virus SARS-CoV-2 (Coronavirus)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47fdf09b-4bfb-49c6-8521-bb039ca5f23a",
                                "sense_id": "ae007388-9eb1-3ad5-acb5-c4f4c1da3b05",
                                "text": "Rund 20% der entdeckten Coronafälle verlaufen schwerer oder gar lebensbedrohlich, mindestens 0,4% enden in Deutschland tödlich."
                            },
                            {
                                "example_id": "96c88e10-bca4-46ca-96fa-69946f3642cc",
                                "sense_id": "ae007388-9eb1-3ad5-acb5-c4f4c1da3b05",
                                "text": "„Ein Sprecher der Bank wollte den Coronafall bisher nicht bestätigen.“"
                            },
                            {
                                "example_id": "94c8593e-ad2c-4cd2-afc9-0fbb79657c71",
                                "sense_id": "ae007388-9eb1-3ad5-acb5-c4f4c1da3b05",
                                "text": "„In Graubünden wurden zwei Coronafälle bestätigt – mitten in der Tourismus-Hochburg Engadin.“"
                            },
                            {
                                "example_id": "a734b076-cd32-485c-be0f-7e908c586765",
                                "sense_id": "ae007388-9eb1-3ad5-acb5-c4f4c1da3b05",
                                "text": "„Nach einem bestätigten Coronafall an einem Lüneburger Gymnasium müssen mehr als 1.000 Schüler und rund 100 Lehrkräfte in häusliche Quarantäne.“"
                            },
                            {
                                "example_id": "d24b2cde-ae5f-4881-92b6-cdd30bf6f6a2",
                                "sense_id": "ae007388-9eb1-3ad5-acb5-c4f4c1da3b05",
                                "text": "„Das BAG meldet 52 neue Coronafälle in den letzten 24 Stunden in der Schweiz.“"
                            },
                            {
                                "example_id": "e26e98da-fbbc-4a12-b833-038071155d8d",
                                "sense_id": "ae007388-9eb1-3ad5-acb5-c4f4c1da3b05",
                                "text": "„Auch in Japan steigen nun die Coronafälle rasant an.“"
                            },
                            {
                                "example_id": "06aba1ea-f34b-4738-a352-9bd6bebcf8b2",
                                "sense_id": "ae007388-9eb1-3ad5-acb5-c4f4c1da3b05",
                                "text": "„Die kleine Hospizgemeinschaft des Domiciliums Weyarn ist bisher noch von Coronafällen verschont geblieben. Trotzdem hat die Seuche alles verändert.“"
                            },
                            {
                                "example_id": "ea0a7b28-daa0-4b13-a483-f1cb1fbdffa6",
                                "sense_id": "ae007388-9eb1-3ad5-acb5-c4f4c1da3b05",
                                "text": "„[…] landesweit [sollen] spezielle Teams nach den Sommerferien zum Einsatz kommen, wenn es in einer Schule einen Coronafall gibt.“"
                            },
                            {
                                "example_id": "edbe9b4a-7268-44c3-94a7-3c17934577fb",
                                "sense_id": "ae007388-9eb1-3ad5-acb5-c4f4c1da3b05",
                                "text": "„Für Bewohner, Angehörige und Beschäftigte der Seniorenresidenz Brockenblick [ist es] eine schwierige Situation, auch wenn es derzeit hier keinen aktiven Coronafall mehr gibt.“"
                            },
                            {
                                "example_id": "9a568778-543a-4774-bffc-460dc544e9b8",
                                "sense_id": "ae007388-9eb1-3ad5-acb5-c4f4c1da3b05",
                                "text": "„Schüler, die in einem Gebiet waren, in dem es viele Coronafälle gibt, zum Beispiel in der Region Lombardei in Norditalien, sollen in der Woche nach den Faschingsferien nicht zur Schule gehen.“"
                            },
                            {
                                "example_id": "8aeb7618-9df7-44b1-85f0-35d1c650ce17",
                                "sense_id": "ae007388-9eb1-3ad5-acb5-c4f4c1da3b05",
                                "text": "„Wie wichtig aber Transparenz bei der Bekämpfung einer Pandemie [ist, zeigt] schon das Beispiel Ischgl. In dem Skigebiet in Österreich waren schon recht früh Coronafälle aufgetreten.“"
                            },
                            {
                                "example_id": "4f25ec0f-86b0-4f24-ad4a-c446529228d3",
                                "sense_id": "ae007388-9eb1-3ad5-acb5-c4f4c1da3b05",
                                "text": "„Eine Tracing-App, um Coronafälle zurückzuverfolgen - das ist eine gute Idee findet Ulf Buermeyer, Netzaktivist und Vorsitzender der Gesellschaft für Freiheitsrechte.“"
                            },
                            {
                                "example_id": "e1b83962-d7bf-4cb6-a336-34d4cf64658f",
                                "sense_id": "ae007388-9eb1-3ad5-acb5-c4f4c1da3b05",
                                "text": "„[…] Mustafa Öz hat […] die Zustände in den Unterkünften für Schlachthof-Mitarbeiter nach den Coronafällen scharf kritisiert.“"
                            },
                            {
                                "example_id": "7eddf57d-b32e-41dd-8481-b981dfa3020a",
                                "sense_id": "ae007388-9eb1-3ad5-acb5-c4f4c1da3b05",
                                "text": "„Nach der Häufung von Coronafällen unter Schlachthofarbeitern hat die Bundesregierung jetzt schärfere Auflagen beschlossen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
