                "senses": [
                    {
                        "sense_id": "6ac71c8c-717d-3b00-b79f-722e51d25dc6",
                        "entry_id": "b659164a-abf2-3fa8-9c42-dbde0b91cd60",
                        "glosses": [
                            "Schnitzel, zubereitet aus dem Fleisch eines Schweines"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c557fc6d-e4a4-4ecd-8191-f92a0909e671",
                                "sense_id": "6ac71c8c-717d-3b00-b79f-722e51d25dc6",
                                "text": "„Mehr als 600 Genossen hocken unter dem Holzdach des Ballsaals an langen Tischen, trinken Bier (2,90 Euro), schneiden Schweineschnitzel (13,50 Euro).“"
                            },
                            {
                                "example_id": "ecba5fba-bff2-43c8-b71f-3446fa853eb9",
                                "sense_id": "6ac71c8c-717d-3b00-b79f-722e51d25dc6",
                                "text": "„Die Japaner lieben auch Schnitzel. Ihre bekannteste Interpretation ist Tonkatsu, paniertes, dick geschnittenes Schweineschnitzel, das mit Kohl, Reis, Misosuppe sowie einer speziellen Sauce serviert wird.“"
                            },
                            {
                                "example_id": "e54170f3-3d7a-4bd7-a1db-b25d6511f92e",
                                "sense_id": "6ac71c8c-717d-3b00-b79f-722e51d25dc6",
                                "text": "„Wenn sich die Bewohner Schweineschnitzel wünschen, brät Halima ihnen das auch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
