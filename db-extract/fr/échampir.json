                "senses": [
                    {
                        "sense_id": "f1d626a7-b195-3fe8-a56b-99ac974442de",
                        "entry_id": "17c357dc-a7fd-34c5-8d77-1e5774f0f021",
                        "glosses": [
                            "Réchampir."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "2eb92e8f-84a2-49f5-a326-1077a2668823",
                                "sense_id": "f1d626a7-b195-3fe8-a56b-99ac974442de",
                                "text": "Une courte fugue à la Côte d’Azur m'a permis de visiter un palais luxueux où l'on échampit actuellement les derniers ors et qui va s'ouvrir prochainement à la colonie cosmopolite."
                            },
                            {
                                "example_id": "4141ff8f-852a-4b47-a683-8335b4a819a6",
                                "sense_id": "f1d626a7-b195-3fe8-a56b-99ac974442de",
                                "text": "Il mit la main sur ses yeux, pour regarder l'Orient. Du jour s’échampissait, pointait à l'horizon, avec des nuances veloutées de chairs féminines. Il fut charmé de ce jaune rose, qui mourait en bleu, procédant par couches allongées en poussière de pastel brouillée de lumière..."
                            }
                        ]
                    }
