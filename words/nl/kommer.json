                    "frequency": "Low",
                    "semantic_group_id": "verdriet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De oude man leefde de laatste jaren van zijn leven in grote <w>kommer</w> en eenzaamheid.",
                            "target_lang_translations": {
                                "en": "The old man lived the last years of his life in great <w>misery</w> and loneliness."
                            }
                        },
                        {
                            "text": "Een spin in de morgen brengt <w>kommer</w> en zorgen.",
                            "target_lang_translations": {
                                "en": "A spider in the morning brings <w>sorrow</w> and worries."
                            }
