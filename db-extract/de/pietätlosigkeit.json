                        "sense_id": "9708551c-f414-3c40-b559-12cf5e018ec6",
                        "entry_id": "554dd86f-33ab-372c-94fc-aaf54b34f6ce",
                        "glosses": [
                            "Mangel an Respekt, Achtung, Ehrfurcht, speziell vor den Toten (Pietät)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2cf54702-3a5b-47e5-aef6-3bf032a42728",
                                "sense_id": "9708551c-f414-3c40-b559-12cf5e018ec6",
                                "text": "So eine Pietätlosigkeit!"
                            },
                            {
                                "example_id": "8720b79f-115f-41ca-965a-27e548c82882",
                                "sense_id": "9708551c-f414-3c40-b559-12cf5e018ec6",
                                "text": "„Ihn zu verraten wäre ihnen auch als Pietätlosigkeit gegenüber Molly und Mortimer erschienen.“"
                            },
                            {
                                "example_id": "bfc0e1b7-405d-41b3-94bf-053337779c9d",
                                "sense_id": "9708551c-f414-3c40-b559-12cf5e018ec6",
                                "text": "„Fünf Dinge gibt es, die man gemeinhin als pietätlos bezeichnet: die erste Pietätlosigkeit ist, seine Glieder nicht zu regen und darüber die Pflege der Eltern zu vernachlässigen […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
