                "senses": [
                    {
                        "sense_id": "788f7ae2-0366-3a17-a4dd-83fda56144da",
                        "entry_id": "71c291d6-ca27-320f-bb07-f9c7efa2b5f5",
                        "glosses": [
                            "aus verschiedenen Teilen bestehende Bekleidung/Montur, die den Träger vor Schaden/Gefahr bewahren soll (unter Umständen auch mit bestimmten Gegenständen zu Schutz und Verteidigung)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6536dea1-00ed-4dfb-9434-49198510553f",
                                "sense_id": "788f7ae2-0366-3a17-a4dd-83fda56144da",
                                "text": "Neben der Schutzweste gehören auch Abdräng-Schild und Schutzbrille zur vorgeschriebenen Schutzausrüstung."
                            },
                            {
                                "example_id": "8f743299-ee8a-4d5a-bb67-5ecddd308485",
                                "sense_id": "788f7ae2-0366-3a17-a4dd-83fda56144da",
                                "text": "Schutzausrüstung ist das A und O im Kampfsport. Sie brauchen Suspensorium, Kopfschutz, Brustschutz, Fußschutz, Schienbeinschutz, Mundschutz, Oberkörperschutz und gegebenenfalls einen Handschutz."
                            },
                            {
                                "example_id": "b257222e-4c3c-4feb-8d63-825fcd78b2da",
                                "sense_id": "788f7ae2-0366-3a17-a4dd-83fda56144da",
                                "text": "Die Coronapandemie hat weltweit zu einer stark gestiegenen Nachfrage nach medizinischer Schutzausrüstung geführt, besonders bei den Schutzmasken gab es Engpässe."
                            }
                        ],
                        "sense_index_json": "\"1\""
