                "translations": [
                    {
                        "translation_id": "300f2000-73ce-4041-91a7-df9a3261b0f0",
                        "source_entry_id": "b75e21af-c240-3b83-9aea-8653a4fcfa15",
                        "source_sense_id": "e422bbaf-01f7-3674-a564-609b085439be",
                        "target_lang_word": "decomposer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "decomposer",
