                    {
                        "translation_id": "196f4f1d-fae1-449f-9346-305078c50b62",
                        "source_entry_id": "204c1366-8ab9-3aa0-91f4-e22eca974c0e",
                        "source_sense_id": "b4de10f6-403a-3ed7-aea3-197babc92bc2",
