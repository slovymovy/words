                "translations": [
                    {
                        "translation_id": "632943a9-9f22-4ef8-910b-9870ff278348",
                        "source_entry_id": "7e8920c2-18f0-3ffb-9085-b9c368b904da",
                        "source_sense_id": "783d19ed-dda2-322c-9a17-271af8d39cb1",
                        "source_sense_description": "een vaak ondergronds kanaal voor de afvoer van drek",
                        "target_lang_word": "Abwasserkanal",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abwasserkanal",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0f4f913b-11ea-35c7-a257-3182f1dad2be",
                                        "entry_id": "302e7cde-8a62-3aa5-acaf-a5f545bb81ae",
                                        "glosses": [
                                            "ein Tunnel, Rohr, Betonkanal oder ein Röhrensystem zum Abführen von Schmutzwasser bis zu einem Fluss oder einem Klärwerk"
                                        ],
                                        "tags": [
                                            "jargon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c299c39-b19c-4aa7-9670-e9e2294fe821",
                                                "sense_id": "0f4f913b-11ea-35c7-a257-3182f1dad2be",
                                                "text": "Der unterirdische Abwasserkanal sichert die Ableitung von Oberflächen- und Schmutzwasser bis in das Klärwerk."
                                            },
                                            {
                                                "example_id": "e0931b85-87d1-48e3-a92d-16a20bc944a4",
                                                "sense_id": "0f4f913b-11ea-35c7-a257-3182f1dad2be",
                                                "text": "„Einer der Hauptabwasserkanäle, der unter der Großen Budengasse durch die Stadtmauer in den Rhein führte, ist unterirdisch erhalten; ein Teil ist gehoben und auf dem Theo-Burauen-Platz aufgestellt. An dieser Stelle kreuzt heute ein moderner Abwasserkanal das historische Bauwerk.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "70481759-4b76-495b-b5d8-ca222c00fbfd",
                        "source_entry_id": "7e8920c2-18f0-3ffb-9085-b9c368b904da",
                        "source_sense_id": "783d19ed-dda2-322c-9a17-271af8d39cb1",
