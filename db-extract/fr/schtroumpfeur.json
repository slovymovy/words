                                        "sense_id": "754bb060-1379-3c44-a8d8-07a8854856c2",
                                        "entry_id": "85efe135-d05f-3d8e-b35a-574b3e01745a",
                                        "glosses": [
                                            "A blue pixie with a white stocking cap, from the media franchise The Smurfs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b1f0f95-e5aa-45c4-9497-ed6d0f25f47c",
                                                "sense_id": "754bb060-1379-3c44-a8d8-07a8854856c2",
                                                "text": "He occasionally used the proper noun of the restaurant as an adverb, the way a Smurf would."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c11930b-0edb-3f2f-b642-d75b9cf7a7e6",
                                        "entry_id": "85efe135-d05f-3d8e-b35a-574b3e01745a",
                                        "glosses": [
                                            "A smurf account or its user."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "80a36f12-c9d6-38a5-98d1-f83e3b3598ef",
                                        "entry_id": "85efe135-d05f-3d8e-b35a-574b3e01745a",
                                        "glosses": [
                                            "A smurf attack."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1cd6360c-c5d4-3f25-bf6e-c32154d10f3b",
                                        "entry_id": "85efe135-d05f-3d8e-b35a-574b3e01745a",
                                        "glosses": [
                                            "One member of a team, each of whom acquires a small amount of money or ingredients for manufacturing drugs, keeping the transactions too small in order to not raise suspicion."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75f43583-eb8b-483d-93f4-9769dda14b29",
                                                "sense_id": "1cd6360c-c5d4-3f25-bf6e-c32154d10f3b",
                                                "text": "Each smurf goes to different banks and purchases cashier's checks in denominations of less than $ 10,000, thus bypassing the reporting requirement."
                                            },
                                            {
                                                "example_id": "1dfd9c8a-3fd3-4f55-b78a-fd8a644e9545",
                                                "sense_id": "1cd6360c-c5d4-3f25-bf6e-c32154d10f3b",
                                                "text": "Once the checks and money orders were purchased, the smurfs delivered them to Barrera, who arranged deposits of multiple checks and money orders into bank accounts that he controlled for further transfer to accounts in Panama, Colombia, and elsewhere."
                                            },
                                            {
                                                "example_id": "156c6783-e204-4a81-9018-97dc6a0e64be",
                                                "sense_id": "1cd6360c-c5d4-3f25-bf6e-c32154d10f3b",
                                                "text": "The local cooks would get some smurfs to buy boxes of Sudafed at all the drugstores in a hundred-mile radius, then pay them off in product."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "smurf",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0226d611-0791-3b39-86c7-4f2a48335b80",
                                        "entry_id": "24585c6d-5c8b-3eb6-98b0-1ea7ba9ea813",
                                        "glosses": [
                                            "Used to replace any other verb, as is typical of smurfs."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8adeb4be-9464-36d2-90e6-b2071db96d8b",
                                        "entry_id": "24585c6d-5c8b-3eb6-98b0-1ea7ba9ea813",
                                        "glosses": [
                                            "To split a large financial transaction into smaller ones so as to avoid scrutiny; to carry out structuring."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3933e3cb-e1d7-3781-8bf5-23e7cc82ba07",
                                        "entry_id": "24585c6d-5c8b-3eb6-98b0-1ea7ba9ea813",
                                        "glosses": [
                                            "To carry out a smurf attack against someone."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "28299951-3afa-3c16-8d73-28890bc7eff9",
                                        "entry_id": "24585c6d-5c8b-3eb6-98b0-1ea7ba9ea813",
                                        "glosses": [
                                            "To use a smurf account."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "55ad29fa-3c2c-3aaf-9a2c-0920389986ee",
                                        "entry_id": "24585c6d-5c8b-3eb6-98b0-1ea7ba9ea813",
                                        "glosses": [
                                            "To use a smurf account.",
                                            "To perform exceptionally well, as if one's using a smurf account, playing into much inferior opponents."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "broadly",
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b1325cb-d3d1-4695-a448-7cee27a3c72f",
                                                "sense_id": "55ad29fa-3c2c-3aaf-9a2c-0920389986ee",
                                                "text": "He has been absolutely smurfing this season."
                                            },
                                            {
                                                "example_id": "a523238b-36f3-4576-a932-1db643f9f023",
                                                "sense_id": "55ad29fa-3c2c-3aaf-9a2c-0920389986ee",
                                                "text": "Oh my god, he smurfed that fight so hard!"
                                            }
                                        ]
                                    }
