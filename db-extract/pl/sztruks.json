                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98c29c8e-e50f-4433-8ef9-c7f19243424e",
                                "sense_id": "088c0c35-76d3-3b6a-94cf-84ee940fd7f5",
