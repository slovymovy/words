                                        "examples": [
                                            {
                                                "example_id": "0d6fbf2b-2629-4b6f-ad89-661295ac0d03",
                                                "sense_id": "c3f3e452-21c9-3ed8-8877-ba834b2106a5",
                                                "text": "a demented idea"
                                            },
                                            {
                                                "example_id": "591bf9d6-106b-4c78-8a04-661153799a8b",
                                                "sense_id": "c3f3e452-21c9-3ed8-8877-ba834b2106a5",
                                                "text": "One of these new recruits is Jagger Froid, a demented alien from the Black Hole Galaxy, who dishes out punishment with a laser-sharp tongue."
                                            },
                                            {
                                                "example_id": "e4cc55a5-ee4b-4b85-ac2d-716c56688baa",
                                                "sense_id": "c3f3e452-21c9-3ed8-8877-ba834b2106a5",
                                                "text": "Literally nothing happens, apart from Donaldson counting to 100,000. In this sense, it is nothing like his later videos, defined as they are by a near-demented commitment to maximum viewer-stimulation."
                                            }
                                        ]
                                    }
                                ]
