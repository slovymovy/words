                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f4b96951-bd38-383f-8e75-6f9ef22c8671",
                                        "entry_id": "d4ced20c-8a70-3240-82c1-3273252fdc40",
                                        "glosses": [
                                            "způsob uvažování z určitého hlediska"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e185097e-c0f0-42c1-93e7-b0c3f54f9f5d",
                                                "sense_id": "f4b96951-bd38-383f-8e75-6f9ef22c8671",
                                                "text": "Českou optikou (alespoň takovou se česká optika na sociálních sítích a v průzkumech veřejného mínění jeví) viděno měla kancléřka drtivě prohrát, měli ji hnát z Bundestagu do důchodu a měla vyhrát protiimigrační, protiislámská, krajně pravicová, populistická Alternativa pro Německo (AfD). Nic takového, Merkelová bude počtvrté kancléřkou, což se povedlo jen Konradu Adenauerovi a Helmutu Kohlovi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9b290c8-07e7-3d8c-aea1-ddede0d796f1",
                                        "entry_id": "d4ced20c-8a70-3240-82c1-3273252fdc40",
                                        "glosses": [
                                            "prodejna brýlí, často vybavená pro upravování čoček"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3fe88ea4-be71-46cf-8449-43ebba7d0cbf",
                                                "sense_id": "d9b290c8-07e7-3d8c-aea1-ddede0d796f1",
                                                "text": "V poslední letech se do módy vrací extravagantní vzhled. Namísto tenkých kovových stranic a vrtaných skel jsou tak v optikách stále častěji vidět silné plastové obruby, často extravagantních tvarů."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
