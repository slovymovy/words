                "senses": [
                    {
                        "sense_id": "d3159c5b-edb0-32c0-a969-7a8cbd88b304",
                        "entry_id": "1bb097bb-a055-35e5-9c4e-f96f956ae9be",
                        "glosses": [
                            "ciepła kamizelka, zwykle z kożucha"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c963b79-913e-4cde-a334-2b308c2912ae",
                                "sense_id": "d3159c5b-edb0-32c0-a969-7a8cbd88b304",
                                "text": "Nie chce nam powiedzieć, gdzie kupił ten serdak."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ff11f84f-ebe2-4051-b501-80dd428af8b3",
                        "source_entry_id": "1bb097bb-a055-35e5-9c4e-f96f956ae9be",
                        "source_sense_id": "d3159c5b-edb0-32c0-a969-7a8cbd88b304",
                        "target_lang_word": "jerkin",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jerkin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e90775b4-537d-3063-a85d-344bc875906d",
                                        "entry_id": "b13bc2d6-6bfd-3c53-b407-936fcf078cfc",
                                        "glosses": [
                                            "A type of men's garment popular in the sixteenth and seventeenth centuries: a close-fitting collarless jacket, with or without sleeves."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "481becee-95fb-4c6f-ae79-61caf7744e71",
                                                "sense_id": "e90775b4-537d-3063-a85d-344bc875906d",
                                                "text": "[T]wenty yeomen, two and two, / In hosen black, and jerkins blue, / With falcons broider'd on each breast, / Attended on their lord's behest."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91a86916-7a31-3ee9-b4a4-5cdb67fd6985",
                                        "entry_id": "b13bc2d6-6bfd-3c53-b407-936fcf078cfc",
                                        "glosses": [
                                            "A sleeveless jacket, usually leather; a long waistcoat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "507689eb-f630-4408-a01c-3ca49c06f7ab",
                                                "sense_id": "91a86916-7a31-3ee9-b4a4-5cdb67fd6985",
                                                "text": "A tall and very good-looking kid in a jerkin came out of the store and rode the coupé off around the corner and came back walking, his glistening black hair plastered with rain."
                                            },
                                            {
                                                "example_id": "b5f35ff2-87e6-4f57-bd92-cd06ebc57096",
                                                "sense_id": "91a86916-7a31-3ee9-b4a4-5cdb67fd6985",
                                                "text": "I booked a room at the small hotel and deposited my luggage there. I bought myself strong boots, a pair of breeches, a jerkin, and a couple of shirts. Then I turned my back upon the town and climbed."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "jerkin",
                                "target_lang_code": "en",
                                "target_senses": [
