                    {
                        "sense_id": "8ed89dba-4d61-39d3-a5df-cd1d4e8760b9",
                        "entry_id": "fe2fb67a-19ea-31f2-b213-8cdef3561a65",
                        "glosses": [
                            "pierwiastek chemiczny o symbolu Mg i liczbie atomowej 12"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ffe5d99-85f6-491a-8d71-00ac2d7492b8",
                                "sense_id": "8ed89dba-4d61-39d3-a5df-cd1d4e8760b9",
                                "text": "W przyrodzie wodorotlenek magnezu występuje w postaci minerału brucytu."
                            },
                            {
                                "example_id": "d3fcb9fd-4a5f-44c8-936b-a59bdae29632",
                                "sense_id": "8ed89dba-4d61-39d3-a5df-cd1d4e8760b9",
                                "text": "Jakie właściwości chemiczne ma magnez?"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "721470ca-dbba-428b-80e3-0e2668c30c50",
                        "source_entry_id": "fe2fb67a-19ea-31f2-b213-8cdef3561a65",
