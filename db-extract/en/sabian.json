                                    {
                                        "sense_id": "1d8592c6-9f6d-3c27-b0d1-1f210a8ca5e0",
                                        "entry_id": "de9473d3-2755-3ff1-bd21-c0b877546c7a",
                                        "glosses": [
                                            "Relatif au royaume de Saba, au Yémen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b7837ed-1b0c-4b5b-83e6-3e43a565efa9",
                                                "sense_id": "1d8592c6-9f6d-3c27-b0d1-1f210a8ca5e0",
                                                "text": "Le premier royaume sabéen."
                                            },
                                            {
                                                "example_id": "b7edddf1-b87f-4a9c-a01a-cc2bdbe2a8ef",
                                                "sense_id": "1d8592c6-9f6d-3c27-b0d1-1f210a8ca5e0",
                                                "text": "Au détour des riches contrées sabéennes, il y a 3000 ans, vivait une reine dont le goût pour les onguents et autres parfums faisait d’elle une déesse de beauté."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9044133c-2c83-333a-8ea8-0996be270dbb",
                                        "entry_id": "de9473d3-2755-3ff1-bd21-c0b877546c7a",
                                        "glosses": [
                                            "Qui appartient, qui a rapport au sabéisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75d4b818-7887-4031-87ec-cff7be888a27",
                                                "sense_id": "9044133c-2c83-333a-8ea8-0996be270dbb",
                                                "text": "Le culte sabéen."
                                            },
                                            {
                                                "example_id": "2d1c9f3f-73e4-4e01-995d-ee7c352753db",
                                                "sense_id": "9044133c-2c83-333a-8ea8-0996be270dbb",
                                                "text": "François, connu pour ses mains tendues tous azimuts aux autres religions, a tenu à y prier avec des dignitaires yazidis – minorité d'Irak martyrisée par les djihadistes du groupe armé État islamique (EI) – mais aussi sabéens et zoroastriens, communautés multimillénaires dans le pays, ainsi qu’avec des musulmans chiites et sunnites."
                                            }
                                        ]
                                    }
                                ]
                            }
