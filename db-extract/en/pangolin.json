                    {
                        "sense_id": "01ffa838-bafb-3448-b6bb-f5ebccd1ab50",
                        "entry_id": "d74d9e53-33c3-3edb-a3c2-004f4dc510f7",
                        "glosses": [
                            "Any of several long-tailed, scale-covered mammals of the family Manidae within the order Pholidota of tropical Africa and Asia."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2e9e7f8-9bc6-485a-8e3e-0b78099fd071",
                                "sense_id": "01ffa838-bafb-3448-b6bb-f5ebccd1ab50",
                                "text": "Like many Sri Lankans, pangolins have big tongues, thick hides and small brains. They pick on ants, rats and anything smaller than them. They hide in terror when faced with bullies and get up to mischief when the lights are out. They are hundreds of thousands of years old and are plodding towards extinction."
                            }
                        ]
                    }
                ],
