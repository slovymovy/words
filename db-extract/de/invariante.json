                        "examples": [
                            {
                                "example_id": "46bcd7fd-0527-4272-bc60-0ed5e8916370",
                                "sense_id": "82153c92-6521-3474-a110-d0a6cc58294d",
                                "text": "Die Winkelgrößen sind Invarianten in bezug auf die Ähnlichkeitstransformationen nicht jedoch die Längen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2be26502-818c-3acf-b00c-de1584188d08",
                        "entry_id": "a0845837-c21c-311e-9c41-21ac15897e2e",
                        "glosses": [
                            "Bedingung, die nicht verletzt werden darf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0571305-1098-41aa-981b-9ec81a60eaef",
                                "sense_id": "2be26502-818c-3acf-b00c-de1584188d08",
                                "text": "Diese Invarianten definieren Annahmen, die ein Objekt einer Klasse immer dann erfüllen muß, wenn ein Nutzer von außen auf dieses Objekt zugreifen kann."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "ecdf7b1f-9035-336b-be77-75054c0624fd",
                        "entry_id": "a0845837-c21c-311e-9c41-21ac15897e2e",
                        "glosses": [
                            "Größe, die bei Eintritt gewisser Veränderungen unveränderlich bleibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3a3f19f-d16f-42a5-99a7-41505f90d392",
                                "sense_id": "ecdf7b1f-9035-336b-be77-75054c0624fd",
                                "text": "„Deutbar ist Kunst nur an ihrem Bewegungsgesetz, nicht durch Invarianten.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
