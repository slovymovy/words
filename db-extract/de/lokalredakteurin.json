                "senses": [
                    {
                        "sense_id": "df6ffbdb-de94-3263-b001-4a17f34c067d",
                        "entry_id": "3f8a59e4-b1af-304b-954f-0a913280936e",
                        "glosses": [
                            "Redakteurin, die sich als Mitglied einer Lokalredaktion um die Berichterstattung aus dem ortsnahen/lokalen Bereich kümmert"
                        ],
                        "tags": [
                            "Journalistik"
                        ],
                        "examples": [
                            {
                                "example_id": "713d5be5-2c78-41e3-834d-e86536f04d36",
                                "sense_id": "df6ffbdb-de94-3263-b001-4a17f34c067d",
                                "text": "„Lokalredakteurin Susanne Stirn bekannte sich dazu, auch künftig ‚in aller Früh die Konkurrenz auf gute Geschichten‘ zu durchsuchen, auch wenn ‚mir morgen das Herz brechen wird, zu wissen, dass es Geschichten gibt, die in meiner Zeitung nicht mehr erscheinen werden‘.“"
                            }
                        ],
