                {
                    "sense_id": "eb2c8cbe-41b7-3cb5-8f38-8c513f479be1",
                    "sense_definition": "Umieścić przedmiot na jakiejś powierzchni, zazwyczaj w pozycji poziomej.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "placement_physical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Proszę <w>położyć</w> te dokumenty na moim biurku, żebym mógł je później przejrzeć.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>положите</w> эти документы мне на стол, чтобы я мог их позже просмотреть.",
                                "en": "Please <w>put</w> these documents on my desk so that I can look over them later.",
                                "nl": "Gelieve deze documenten op mijn bureau <w>neer te leggen</w>, zodat ik ze later kan doornemen."
                            }
                        },
                        {
                            "text": "Gdzie <w>położyłeś</w> klucze od samochodu, bo nie mogę ich nigdzie znaleźć?",
                            "target_lang_translations": {
                                "ru": "Куда ты <w>положил</w> ключи от машины? Я нигде не могу их найти.",
                                "en": "Where did you <w>put</w> the car keys, because I can't find them anywhere?",
                                "nl": "Waar heb je de autosleutels <w>neergelegd</w>? Ik kan ze nergens vinden."
                            }
                        }
                    ],
                    "synonyms": [
                        "umieścić",
                        "odłożyć"
                    ],
                    "antonyms": [
                        "podnieść",
                        "wziąć",
                        "zdjąć"
                    ],
                    "common_phrases": [
                        "położyć na stole",
                        "położyć na miejscu",
                        "położyć rękę"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поместить предмет на какую-либо поверхность, обычно в горизонтальном положении.",
                        "en": "To place an object on a surface, usually in a horizontal position.",
                        "nl": "Een voorwerp op een oppervlak plaatsen, meestal in een liggende (horizontale) positie."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "положить",
