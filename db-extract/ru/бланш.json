                "senses": [
                    {
                        "sense_id": "2649541e-c1e0-3487-a9c6-a15007907791",
                        "entry_id": "0897c2fa-1fa4-3e52-a35a-2bcfa9df82ef",
                        "glosses": [
                            "прост. синяк под глазом, ссадина"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44647475-9727-47ad-9092-e24650f07979",
                                "sense_id": "2649541e-c1e0-3487-a9c6-a15007907791",
                                "text": "Но что характерно ― синяки портят не всякую женщину, иные и с «бланшем» не теряют аристократичности анфаса."
                            },
                            {
                                "example_id": "50015180-f41b-47b9-89af-e6a8041e33b1",
                                "sense_id": "2649541e-c1e0-3487-a9c6-a15007907791",
                                "text": "Напротив стояла ещё вполне молодая и, видимо, когда-то симпатичная дама с большим бланшем под правым глазом."
                            }
                        ]
                    }
