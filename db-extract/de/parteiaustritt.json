                "senses": [
                    {
                        "sense_id": "fd3efe56-57b6-370b-839a-f267c0390055",
                        "entry_id": "11ce80dc-c6b1-3e88-bc9f-42c94a2185ff",
                        "glosses": [
                            "Handlung, eine politische Organisation (Partei) (freiwillig) zu verlassen (auszutreten)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "baf33c43-2586-482e-ad8d-6dfd34c5ccc7",
                                "sense_id": "fd3efe56-57b6-370b-839a-f267c0390055",
                                "text": "„Elke Twesten hat die niedersächsische Regierung mit ihrem Parteiaustritt in die Krise gestürzt.“"
                            },
                            {
                                "example_id": "a6e0814a-1aaa-447d-87df-12e0c4a41cbe",
                                "sense_id": "fd3efe56-57b6-370b-839a-f267c0390055",
                                "text": "„Aus Protest gegen die Flüchtlingspolitik von Bundeskanzlerin Angela Merkel (CDU) hat die langjährige CDU-Politikerin Erika Steinbach ihren Parteiaustritt angekündigt.“"
                            },
                            {
                                "example_id": "cc05b662-c442-47dc-b972-215c37b35a5a",
                                "sense_id": "fd3efe56-57b6-370b-839a-f267c0390055",
                                "text": "„Der AfD-Fraktionsvorsitzende im Landtag von Sachsen-Anhalt, André Poggenburg, [hat Frauke] Petry zum Parteiaustritt aufgefordert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
