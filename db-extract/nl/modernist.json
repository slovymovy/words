                                "target_senses": [
                                    {
                                        "sense_id": "ba919345-c855-3c36-9e48-3c0898351061",
                                        "entry_id": "c3377e1a-bc01-32aa-8ac0-1bc20fffce36",
                                        "glosses": [
                                            "A follower or proponent of modernism."
