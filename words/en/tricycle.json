    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0586b219-2fb9-3584-a7c1-3038f5fe5e75",
                    "sense_definition": "A vehicle with three wheels, powered by pedals and typically used by young children.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "vehicle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young child learned to ride a <w>tricycle</w> in the park.",
                            "target_lang_translations": {
                                "ru": "Маленький ребёнок научился кататься на <w>трёхколёсном велосипеде</w> в парке."
                            }
                        },
                        {
                            "text": "She received a bright red <w>tricycle</w> for her third birthday.",
                            "target_lang_translations": {
                                "ru": "На свой третий день рождения она получила ярко-красный <w>трёхколёсный велосипед</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "trike"
                    ],
                    "common_phrases": [
                        "ride a tricycle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Трёхколёсное транспортное средство с педальным приводом, обычно используемое маленькими детьми."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трёхколёсный велосипед",
                                "target_lang_sense_clarification": "детский велосипед с тремя колёсами"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bf4a5c2a-a094-3ad5-9a9d-dbb8b1089300",
                    "sense_definition": "A motorized three-wheeled vehicle used for public transport.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vehicle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We took a <w>tricycle</w> through the busy city streets to reach the market.",
                            "target_lang_translations": {
                                "ru": "Мы поехали на <w>трицикле</w> по оживлённым городским улицам, чтобы добраться до рынка."
                            }
                        },
                        {
                            "text": "The driver of the <w>tricycle</w> waited patiently for passengers near the station.",
                            "target_lang_translations": {
                                "ru": "Водитель <w>трицикла</w> терпеливо ждал пассажиров возле станции."
                            }
                        }
                    ],
                    "synonyms": [
                        "pedicab"
                    ],
                    "target_lang_definitions": {
                        "ru": "Моторизованное трёхколёсное транспортное средство, используемое для перевозки пассажиров."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трицикл",
                                "target_lang_sense_clarification": "транспортное средство с тремя колёсами"
                            },
                            {
                                "target_lang_word": "трайк",
                                "target_lang_sense_clarification": "трёхколёсный мотоцикл или моторизованное средство"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "987aeeec-ca58-37b8-bec6-b397694e8caa",
                    "sense_definition": "To travel or move by riding a tricycle.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The toddler <w>tricycled</w> across the patio while his parents watched.",
                            "target_lang_translations": {
                                "ru": "Малыш <w>ехал на трёхколёсном велосипеде</w> по внутреннему дворику, пока родители наблюдали за ним."
                            }
                        },
                        {
                            "text": "He <w>tricycled</w> down the sidewalk to meet his friends at the playground.",
                            "target_lang_translations": {
                                "ru": "Он <w>ехал на трёхколёсном велосипеде</w> по тротуару, чтобы встретиться с друзьями на детской площадке."
                            }
                        }
                    ],
                    "synonyms": [
                        "trike"
                    ],
                    "target_lang_definitions": {
                        "ru": "Передвигаться на трёхколёсном велосипеде или трицикле."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ехать на трёхколёсном велосипеде",
                                "target_lang_sense_clarification": "передвигаться на детском трёхколёсном велосипеде"
                            },
                            {
                                "target_lang_word": "ехать на трицикле",
                                "target_lang_sense_clarification": "передвигаться на моторизованном трицикле"
                            }
                        ]
                    }
                }
            ]
        }
    ]
