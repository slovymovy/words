                    {
                        "sense_id": "6eebab34-74df-339b-8e5e-a9fa69cc5a4d",
                        "entry_id": "028f2f56-6b3e-3ffb-9f94-35a6fbacdfd5",
                        "glosses": [
                            "een voordeel gevend, met name geldelijk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6fdabe56-a922-4fbb-aa8e-019b3636f82c",
                                "sense_id": "6eebab34-74df-339b-8e5e-a9fa69cc5a4d",
                                "text": "Deze uitverkoop maakte de aankoop een stuk voordeliger."
                            },
                            {
                                "example_id": "21134f68-7b2d-4b18-b745-d512b2d26e4f",
                                "sense_id": "6eebab34-74df-339b-8e5e-a9fa69cc5a4d",
                                "text": "Hij had stad en land afgestruind om zo voordelig mogelijk een lichtgewicht uitrusting bij elkaar te scharrelen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ffc9bca9-0ddf-4398-9dfe-ddb1d41fe872",
                        "source_entry_id": "028f2f56-6b3e-3ffb-9f94-35a6fbacdfd5",
                        "source_sense_id": "6eebab34-74df-339b-8e5e-a9fa69cc5a4d",
