                                        "examples": [
                                            {
                                                "example_id": "f29a6993-20c6-4739-bf63-1a81db6c10af",
                                                "sense_id": "8018b376-f373-3f88-a255-4e86348e2341",
                                                "text": "Standardisation of locomotive design is an essential feature of an efficiently run modern railway."
                                            },
                                            {
                                                "example_id": "abb0be2c-fb97-4590-8ceb-45a65db1c804",
                                                "sense_id": "8018b376-f373-3f88-a255-4e86348e2341",
                                                "text": "The final remnants of the competitive spirit between companies will be eliminated, and there is no reasonable prospect that the dull uniformity of standardisation will be offset by greater efficiency in operation."
                                            }
