                ],
                "senses": [
                    {
                        "sense_id": "5f6f1258-d6a4-3007-921c-1245589cdc3a",
                        "entry_id": "b7d2644d-8f61-3b49-9fd3-c5fbe8948684",
                        "glosses": [
                            "speckled"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0771ba3a-04f6-4cbb-bac9-598eb11683d5",
                                "sense_id": "5f6f1258-d6a4-3007-921c-1245589cdc3a",
                                "text": "Тех ру́сского оконча́ния папиро́с, кото́рые он предпочти́тельно кури́л, тут не держа́ли, и он бы ушё́л без всего́, не окажи́сь у таба́чника кра́пчатого жиле́та с перламу́тровыми пу́говицами и лы́сины ты́квенного отте́нка.",
                                "translation": "This shop did not carry the Russian tipped cigarettes that he preferred, and he would have left empty-handed if it had not been for the tobacconist’s speckled vest with mother-of-pearl buttons and his pumpkin-colored bald spot.",
                                "english": "This shop did not carry the Russian tipped cigarettes that he preferred, and he would have left empty-handed if it had not been for the tobacconist’s speckled vest with mother-of-pearl buttons and his pumpkin-colored bald spot."
                            }
                        ]
                    }
                ],
