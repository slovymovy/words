{
    "word_family": [
        "leven",
        "voortzetting",
        "voortgang",
        "levend"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3df5c26e-766d-3cfd-aebf-9d3525200371",
                    "sense_definition": "Blijven bestaan in de herinnering of door een nalatenschap, vaak na iemands overlijden.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "voortbestaan",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn prachtige muziek zal voor altijd <w>voortleven</w> in de harten van zijn fans.",
                            "target_lang_translations": {
                                "en": "His beautiful music will <w>live on</w> forever in the hearts of his fans."
                            }
                        },
                        {
                            "text": "De oude tradities <w>leven</w> nog steeds <w>voort</w> in dit kleine dorpje.",
                            "target_lang_translations": {
                                "en": "The old traditions still <w>survive</w> in this small village."
                            }
                        }
                    ],
                    "synonyms": [
                        "voortbestaan",
                        "blijven"
                    ],
                    "antonyms": [
                        "verdwijnen",
                        "vergaan"
                    ],
                    "common_phrases": [
                        "voortleven in herinnering",
                        "eeuwig voortleven"
                    ],
                    "target_lang_definitions": {
                        "en": "To continue to exist in memory or through a legacy, often after someone's death."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "live on",
                                "target_lang_sense_clarification": "to continue to exist in memory or influence"
                            },
                            {
                                "target_lang_word": "survive",
                                "target_lang_sense_clarification": "to persist through time or history"
                            },
                            {
                                "target_lang_word": "endure",
                                "target_lang_sense_clarification": "to remain in existence"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bb1f6132-2a8d-3c3b-9a2e-ff996baa3d37",
                    "sense_definition": "Doorgaan met leven na een bepaalde gebeurtenis of tijdstip.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "voortbestaan",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij <w>leefden</w> nog vele jaren gelukkig <w>voort</w> na hun pensioen.",
                            "target_lang_translations": {
                                "en": "They <w>lived on</w> happily for many more years after their retirement."
                            }
                        },
                        {
                            "text": "Ondanks het grote verlies moest de familie op de een of andere manier <w>voortleven</w>.",
                            "target_lang_translations": {
                                "en": "Despite the great loss, the family had to <w>carry on</w> somehow."
                            }
                        }
                    ],
                    "synonyms": [
                        "doorleven"
                    ],
                    "antonyms": [
                        "sterven"
                    ],
                    "common_phrases": [
                        "rustig voortleven"
                    ],
                    "target_lang_definitions": {
                        "en": "To continue living after a specific event or point in time."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "live on",
                                "target_lang_sense_clarification": "to continue one's life after an event"
                            },
                            {
                                "target_lang_word": "carry on",
                                "target_lang_sense_clarification": "to continue with life despite difficulties"
                            },
                            {
                                "target_lang_word": "continue",
                                "target_lang_sense_clarification": "to go on living"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}