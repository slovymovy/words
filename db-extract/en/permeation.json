                        "target_lang_word": "Ausbreitung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ausbreitung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8f0faffa-0e4a-3a08-a47d-040e702a8271",
                                        "entry_id": "1da77fba-cc05-3336-868e-9a9a5fc65fb3",
                                        "glosses": [
                                            "das Sichausbreiten oder das Ausbreiten von etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1af29503-0a67-4cf6-9daa-2dc91ec0129b",
                                                "sense_id": "8f0faffa-0e4a-3a08-a47d-040e702a8271",
                                                "text": "„Verschärft wurde diese Lage durch die rapide Ausbreitung einer hochansteckenden Infektionskrankheit.“"
                                            },
                                            {
                                                "example_id": "b36433d8-c8a1-409d-bde5-f6e8ed538085",
                                                "sense_id": "8f0faffa-0e4a-3a08-a47d-040e702a8271",
                                                "text": "„Manche Äcker müssen die Landwirte mehrfach mit dem umstrittenen Totalherbizid Glyphosat behandeln oder ein bis zwei Jahre lang brach liegen lassen, um die Ausbreitung des Ungrases zu stoppen.“"
                                            },
                                            {
                                                "example_id": "0b1ee331-5aaf-4f05-adb6-65d340601afa",
                                                "sense_id": "8f0faffa-0e4a-3a08-a47d-040e702a8271",
                                                "text": "„Es ist eines der grössten Umweltprobleme Chinas: die Ausbreitung der Wüste Gobi. Mittlerweile bedeckt der Sand ein Viertel der Volksrepublik.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
