                "senses": [
                    {
                        "sense_id": "0455b32d-fe78-3176-b8d1-06fab13b6df8",
                        "entry_id": "c6733a16-1753-3312-af7e-e46a44b4b866",
                        "glosses": [
                            "früher verwendetes Gerät zum Fangen von Aalen in der Form einer Gabel mit mehreren Zacken, die mit Widerhaken versehen sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d4841a7-2859-47ab-9f67-c28485bd4388",
                                "sense_id": "0455b32d-fe78-3176-b8d1-06fab13b6df8",
                                "text": "„Die Fischer der Insel Poel bei Wismar betreiben im Winter den Aalfang mit Aaleisen und stellen dem Aal von März bis November mit Netzen und Angeln nach.“"
                            },
                            {
                                "example_id": "777960ea-f1a6-4fa5-8106-c4b55aa6f970",
                                "sense_id": "0455b32d-fe78-3176-b8d1-06fab13b6df8",
                                "text": "„In einer Halle hatte er eine Ausstellung alter Werkzeuge, Aaleisen und altmodischer Angelgerätschaften.“"
                            },
                            {
                                "example_id": "ab801ed1-fc3c-40c8-b526-b48c5dd7d55b",
                                "sense_id": "0455b32d-fe78-3176-b8d1-06fab13b6df8",
                                "text": "„Aaleisen und Aalspeer anzuwenden, ist seit ca. 1850 verboten, ebenso die ähnlich grausame Aalharke und das Aalstechen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
