                ],
                "senses": [
                    {
                        "sense_id": "ff99d153-863b-3788-9728-431d8ee7a42e",
                        "entry_id": "8812091b-e83f-3922-bd9d-2160aec5f6d1",
                        "glosses": [
                            "Person, meistens ein Kind oder Jugendlicher, der frech, dreist, arrogant und unbelehrbar auftritt, aber auch wehleidig, widerspenstig und weinerlich"
                        ],
                        "tags": [
                            "derogatory",
                            "impolite"
                        ],
                        "examples": [
                            {
                                "example_id": "cef2ed13-b68a-41c6-ab66-c2e0741b7f1e",
                                "sense_id": "ff99d153-863b-3788-9728-431d8ee7a42e",
                                "text": "Du Rotzlöffel weißt natürlich wieder alles besser."
                            },
                            {
                                "example_id": "f329ae08-d81d-4ec9-9951-161e4758a733",
                                "sense_id": "ff99d153-863b-3788-9728-431d8ee7a42e",
                                "text": "„Da opfere man sein Leben für die Kinder, und heraus komme so etwas, ein Rotzlöffel ohne Manieren, frei von Anstand und Demut.“"
                            },
                            {
                                "example_id": "e1f8dc46-fe3d-4a0b-a7e4-3820ea23e36b",
                                "sense_id": "ff99d153-863b-3788-9728-431d8ee7a42e",
                                "text": "„Der Rotzlöffel mit der Hornbrille heißt Troy.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d7c52871-812a-4042-aec8-275d416cc3b8",
                        "source_entry_id": "8812091b-e83f-3922-bd9d-2160aec5f6d1",
                        "source_sense_id": "ff99d153-863b-3788-9728-431d8ee7a42e",
                        "source_sense_description": "Person, meistens ein Kind oder Jugendlicher, der frech, dreist, arrogant und unbelehrbar auftritt, aber auch wehleidig, widerspenstig und weinerlich",
                        "target_lang_word": "morveux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "morveux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ca5d1706-2fb5-3e2a-a9ba-7cb461a6c40d",
                                        "entry_id": "b5aa588a-ed8e-3c5b-87eb-23775cab733b",
                                        "glosses": [
                                            "Qui a la morve au nez."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec2d5a10-c784-44e0-ba24-cc54f1b0cac8",
                                                "sense_id": "ca5d1706-2fb5-3e2a-a9ba-7cb461a6c40d",
                                                "text": "Les petits voleurs restaient, les uns debout, les autres accotés contre le lit ou la huche, tous morveux et sales, bien portants d’ailleurs, grugeant leurs prunes sans rien dire, mais regardant l’étranger d’un œil sournois et narquois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ecc7d5b-0372-3a4c-a809-d2583af6b4da",
                                        "entry_id": "b5aa588a-ed8e-3c5b-87eb-23775cab733b",
                                        "glosses": [
                                            "Qui est atteint de la maladie appelée la morve."
                                        ],
                                        "tags": [
                                            "Hippologie",
                                            "Médecine vétérinaire"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6cfe5608-260d-4b3f-8baf-3f996a3db77c",
                                                "sense_id": "3ecc7d5b-0372-3a4c-a809-d2583af6b4da",
                                                "text": "Ne donnez au cheval morveux que du son mouillé ; faites lui faire un exercice modéré, […] ."
                                            },
                                            {
                                                "example_id": "dab563f0-82b1-44b3-aa1f-a0df2c1cb35b",
                                                "sense_id": "3ecc7d5b-0372-3a4c-a809-d2583af6b4da",
                                                "text": "Le maquignon de bas étage […] ne craint pas de vendre un cheval morveux après avoir essayé de cacher le jetage en introduisant une éponge dans un naseau, et avoir pratiqué l’églandage."
                                            },
                                            {
                                                "example_id": "052fe620-9b64-40e7-85a9-aeb946e86e2b",
                                                "sense_id": "3ecc7d5b-0372-3a4c-a809-d2583af6b4da",
                                                "text": "Il avait aussi découvert un arrière-grand-oncle du vicaire général de l’archevêché, un sieur de Goulet, ou plus exactement, comme il signait lui-même, un Goulet-Trocard, qui, fournisseur aux armées, avait été condamné aux travaux forcés, en 1812, pour avoir livré, au lieu de bœuf, la viande de chevaux morveux."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "morveux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c5516231-5155-36e1-b196-ba4a55618362",
                                        "entry_id": "dba622e4-36f4-33a0-b197-f6bda92d0594",
                                        "glosses": [
                                            "Enfant."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ec27cbf-9857-43f3-b68f-20e66d0c0943",
                                                "sense_id": "c5516231-5155-36e1-b196-ba4a55618362",
                                                "text": "Pour ces morveux-là, un type de vingt-six ans, c'est un vieux; je fis un sourire à la petite gosse blonde […]."
                                            },
                                            {
                                                "example_id": "c9c63286-42ee-48bf-8454-64b046c9eb57",
                                                "sense_id": "c5516231-5155-36e1-b196-ba4a55618362",
                                                "text": "Amène-toi morveux : on est grands, merde aux gniards."
                                            },
                                            {
                                                "example_id": "6477c89c-349e-4bc3-af93-93318f8089c9",
                                                "sense_id": "c5516231-5155-36e1-b196-ba4a55618362",
                                                "text": "– Toi, ta gueule, morveux ! jeta l’aîné. Bon, tout le monde est au courant que c’est la mobilisation générale, et que les conscrits de la classe 53 sont concernés. Je crois que ça va chier avec les Russes, si j’ai bien compris. Un bled avec un nom à coucher dehors..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3cc3a2bd-8ebe-32fa-92f1-928be6d78934",
                                        "entry_id": "dba622e4-36f4-33a0-b197-f6bda92d0594",
                                        "glosses": [
                                            "Prétentieux, qui se met en avant, se fait valoir."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d6022a0-9131-42c6-9c5a-ba7ed0d6e49b",
                                                "sense_id": "3cc3a2bd-8ebe-32fa-92f1-928be6d78934",
                                                "text": "Un méchant morveux, qui fait la leçon à tout le monde."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
