                    },
                    {
                        "sense_id": "e8a63a9b-f965-3dd1-9809-1c0f35f8b128",
                        "entry_id": "7fb0cc1a-7cdb-3dc3-9026-bd2be43abe5f",
                        "glosses": [
                            "More than one complete musical texture occurring at the same time. This first appeared in the music of Charles Ives, and is common in the music of Conlon Nancarrow, and others."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fb912c10-e06c-4921-96e3-1ac3ce94b535",
                        "source_entry_id": "7fb0cc1a-7cdb-3dc3-9026-bd2be43abe5f",
                        "source_sense_description": "the quality or state of being simultaneous",
                        "target_lang_word": "gelijktijdigheid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gelijktijdigheid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "b94265e6-d6bb-3b9e-bbc9-54c80779ec95",
                                        "entry_id": "e9d6a57a-f19d-3ec6-a9ef-12ade335ccc3",
                                        "glosses": [
                                            "het op hetzelfde moment plaatsvinden van meerdere gebeurtenissen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "991ef3f9-26e6-44e2-802e-a4d3b01ec063",
                                                "sense_id": "b94265e6-d6bb-3b9e-bbc9-54c80779ec95",
                                                "text": "Maar om een handeling op te slaan in de vorm van een flits die geen tijd meer bestrijkt, was dat niet de vastlegging van die handeling in oneindig versnelde toestand? Volgens de fluxierekening van Newton vergde dat echter een eveneens oneindige energie, de energie die nodig is om begin en einde in elkaar te persen, om in volstrekte gelijktijdigheid, met ultieme versnelling, snel als de tijd zelve een massa te verplaatsen, een been, een tong, een hand, toen zo loom strelend, in de sluimerherinnering nu echter de drager van precies diezelfde energie, de hitte die overblijft wanneer men onder toevoer van alle kracht in de wereld een naald heeft samengeperst tot niets — wanneer zij met de vinger van haar aandacht zulk een sluimerherinnering aantoetsen zou, waardoor die zich opnieuw, temporeel in haar geest zou voltrekken, eerst die hand, toen de tong, niet meer alles tegelijk, zou dat de vrijmaking van die door de geest toegevoegde energie betekenen, welke na de explosie dan neerregenen zou als seconden, teruggetransmuteerd tot tijd, de tijd waarin het herinneringsbeeld zich ontsluiten en afspelen kan als handeling met verloop, een explosie verwoestend als het geweld waarmee die tot niets samengeperste naald zou terugspringen in zijn oude vorm van stof en staal."
                                            },
                                            {
                                                "example_id": "0b41f19d-f799-4cc1-a7b2-49c1e4db10de",
                                                "sense_id": "b94265e6-d6bb-3b9e-bbc9-54c80779ec95",
                                                "text": "Tegen de natuurwetten in zoeken ze naar gelijktijdigheid, of gelijk oversteken. De kwadratuur van de cirkel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a78228b1-9668-477a-9042-36561b7eabfb",
                        "source_entry_id": "7fb0cc1a-7cdb-3dc3-9026-bd2be43abe5f",
                        "source_sense_description": "the quality or state of being simultaneous",
                        "target_lang_word": "simultanéité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "simultanéité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5c42b0e3-6f5d-3e9e-966f-2ddf4e4a0337",
                                        "entry_id": "840b2494-8eec-3e22-b4a6-802f5faaa4e7",
                                        "glosses": [
                                            "Caractère de ce qui est simultané."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "887678cc-89ff-44bf-8c0c-af93bf9a1126",
                                                "sense_id": "5c42b0e3-6f5d-3e9e-966f-2ddf4e4a0337",
                                                "text": "La simultanéité de ces deux actions."
                                            },
                                            {
                                                "example_id": "e53d53bd-60e0-4f51-a623-eea160464ed6",
                                                "sense_id": "5c42b0e3-6f5d-3e9e-966f-2ddf4e4a0337",
                                                "text": "Ce fut chez tous deux la même expression, le même pressentiment. Aussi la manœuvre inspirée à ces deux passions réelles, devint-elle si comique par la simultanéité de cette gymnastique, qu’elle fit sourire les gens d’assez d’esprit pour y voir une révélation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "71369090-534d-4b71-8400-6c4e6c522ea4",
                        "source_entry_id": "7fb0cc1a-7cdb-3dc3-9026-bd2be43abe5f",
                        "source_sense_description": "the quality or state of being simultaneous",
                        "target_lang_word": "Gleichzeitigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gleichzeitigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2b72cec3-447c-342c-9d46-2264983d54ac",
                                        "entry_id": "85f67dff-1fd2-3d4a-bb2b-08ad8ba51c6b",
                                        "glosses": [
                                            "Eigenschaft/Zustand, zu gleicher Zeit zu geschehen/vorhanden zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9fb08e32-8c97-4ba6-9607-18e17916de03",
                                                "sense_id": "2b72cec3-447c-342c-9d46-2264983d54ac",
                                                "text": "„Es ist die Gleichzeitigkeit von Fortschritt und Rückschritt, die es so schwer macht, Narendra Modis Amtszeit zu beurteilen.“"
                                            },
                                            {
                                                "example_id": "fb73c2ac-36e8-43a6-8620-4f7a5aff7224",
                                                "sense_id": "2b72cec3-447c-342c-9d46-2264983d54ac",
                                                "text": "„Auf diesem Wege kann die relative Gleichzeitigkeit unter den drei Uhren in ein und demselben System nachgewiesen werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5ce5c9c4-5931-4026-9daf-67196e702c1a",
                        "source_entry_id": "7fb0cc1a-7cdb-3dc3-9026-bd2be43abe5f",
                        "source_sense_description": "the quality or state of being simultaneous",
                        "target_lang_word": "Simultanität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Simultanität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f7859cfc-8097-3ac0-9000-f2cbaf5d439b",
                                        "entry_id": "2234ac2c-0ae2-37d3-b4e4-ab9749467549",
                                        "glosses": [
                                            "Eigenschaft/Tatsache, zur gleichen Zeit stattzufinden"
                                        ],
                                        "tags": [
                                            "jargon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ff8eb4e-ec26-4aa6-a435-8068a0229dfe",
                                                "sense_id": "f7859cfc-8097-3ac0-9000-f2cbaf5d439b",
                                                "text": "„Die Wirkung des Visuellen erfuhr eine Steigerung durch die Simultanität von Ereignis und Berichterstattung in den audiovisuellen Medien.“"
                                            },
                                            {
                                                "example_id": "689b4cd2-9bbc-47e6-aaef-844fd8ffcb5b",
                                                "sense_id": "f7859cfc-8097-3ac0-9000-f2cbaf5d439b",
                                                "text": "„Die Untrennbarkeit (bzw. Simultanität) von Produktion und Absatz bei einer Dienstleistung wird auch als ‚Uno-actu-Prinzip‘ bezeichnet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d97ca0e3-2857-36e1-b749-bcfb5c20789a",
                                        "entry_id": "2234ac2c-0ae2-37d3-b4e4-ab9749467549",
                                        "glosses": [
                                            "Vereinigung separater/disparater/divergenter Ereignisse/Inhalte in einem Werk"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c33141dd-1d13-4292-a688-3008c2274618",
                                                "sense_id": "d97ca0e3-2857-36e1-b749-bcfb5c20789a",
                                                "text": "„Simultanität des Disparaten: Bildhaft verarbeitete Eindrücke und Beschreibungen werden assoziativ, ohne logische Stringenz Zeile für Zeile aneinander gereiht.“"
                                            },
                                            {
                                                "example_id": "01841954-df06-4e05-b92c-4a6cd0645e5d",
                                                "sense_id": "d97ca0e3-2857-36e1-b749-bcfb5c20789a",
                                                "text": "„Eine collageartige Simultanität von Orten und Zuständen fügt Divergentes zum Sinnzusammenhang.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
