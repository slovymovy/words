                        "sense_id": "3417f973-4b94-3869-b453-90c1e5ae6263",
                        "entry_id": "53211584-a4aa-31c0-89e9-830dc6ee2367",
                        "glosses": [
                            "Mediziner, der sich mit Erkrankungen des Herzens beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2bdc7ba-b5a7-4e33-bcf6-de0dda982562",
                                "sense_id": "3417f973-4b94-3869-b453-90c1e5ae6263",
                                "text": "Der Patient musste zum Kardiologen, der ihm einen Herzkatheter legte."
                            },
                            {
                                "example_id": "c768d4fe-88ec-4f36-b5e8-d8dc29d23b70",
                                "sense_id": "3417f973-4b94-3869-b453-90c1e5ae6263",
                                "text": "„Ich hatte ihren Namen gegoogelt und gelesen, dass sie die Tochter eines anscheinend weltberühmten Grazer Kardiologen war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
