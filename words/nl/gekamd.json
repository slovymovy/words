                                "target_lang_sense_clarification": "having a crest or comb"
                            },
                            {
                                "target_lang_word": "combed",
                                "target_lang_sense_clarification": "heraldic or anatomical term for having a comb"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bd510eee-acda-3ae9-a7a3-cd76fe6e2cd2",
