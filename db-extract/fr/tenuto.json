                        "sense_id": "eff7863f-e66e-317d-a2bd-19e777156826",
                        "entry_id": "78b67937-0955-38d8-b263-74e0321439ff",
                        "glosses": [
                            "De façon tenue, en parlant d’une note jouée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c28b9033-42db-45d8-878c-9808eccec812",
                                "sense_id": "eff7863f-e66e-317d-a2bd-19e777156826",
                                "text": "On peut jouer « absolument tenuto » et non pas legato ce qui est écrit legato, c’est-à-dire « sans interrompre le flux d’air »."
                            }
                        ]
