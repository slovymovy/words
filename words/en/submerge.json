{
    "word_family": [
        "submergence",
        "submersible",
        "submersion"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "762e9197-9764-329a-9f0e-d70babe19e32",
                    "sense_definition": "To sink or go down below the surface of a liquid.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "underwater",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The submarine began to <w>submerge</w> as it left the harbor.",
                            "target_lang_translations": {
                                "ru": "Подводная лодка начала <w>погружаться</w>, покидая гавань."
                            }
                        },
                        {
                            "text": "Watch the boat <w>submerge</w> completely under the waves.",
                            "target_lang_translations": {
                                "ru": "Смотри, как лодка полностью <w>погружается</w> под волны."
                            }
                        }
                    ],
                    "synonyms": [
                        "submerse"
                    ],
                    "common_phrases": [
                        "submerge underwater"
                    ],
                    "target_lang_definitions": {
                        "ru": "Опускаться под поверхность жидкости."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "погружа́ться",
                                "target_lang_sense_clarification": "опускаться во что-либо (жидкость)"
                            },
                            {
                                "target_lang_word": "погрузи́ться",
                                "target_lang_sense_clarification": "опуститься, целиком поместиться в жидкость"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "40360d06-cd73-3f2f-a8b2-a342b7d337bd",
                    "sense_definition": "To place something completely into a liquid.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "underwater",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>submerge</w> the vegetables in boiling water for two minutes.",
                            "target_lang_translations": {
                                "ru": "Вам следует <w>погрузить</w> овощи в кипящую воду на две минуты."
                            }
                        },
                        {
                            "text": "Carefully <w>submerge</w> the fabric in the dye to ensure an even color.",
                            "target_lang_translations": {
                                "ru": "Осторожно <w>погрузите</w> ткань в краситель, чтобы обеспечить равномерный цвет."
                            }
                        }
                    ],
                    "synonyms": [
                        "immerse"
                    ],
                    "common_phrases": [
                        "submerge in water"
                    ],
                    "target_lang_definitions": {
                        "ru": "Помещать что-либо полностью в жидкость."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "погружа́ть",
                                "target_lang_sense_clarification": "целиком опускать во что-либо жидкое"
                            },
                            {
                                "target_lang_word": "погрузи́ть",
                                "target_lang_sense_clarification": "позволить чему-либо полностью или частично опуститься в жидкость"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "23fadd48-b134-3371-b288-f34d6c165076",
                    "sense_definition": "To be covered by a large amount of water.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "underwater",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The low-lying fields were <w>submerged</w> after the heavy rainstorm.",
                            "target_lang_translations": {
                                "ru": "Низменные поля были <w>затоплены</w> после сильного ливня."
                            }
                        },
                        {
                            "text": "Many coastal roads are <w>submerged</w> during the high tide.",
                            "target_lang_translations": {
                                "ru": "Многие прибрежные дороги <w>затоплены</w> во время прилива."
                            }
                        }
                    ],
                    "common_phrases": [
                        "completely submerged"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть покрытым большим количеством воды."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "затопля́ть",
                                "target_lang_sense_clarification": "покрывать, заливать жидкостью поверхность"
                            },
                            {
                                "target_lang_word": "затопи́ть",
                                "target_lang_sense_clarification": "залить водой местность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d6607107-fd0e-3dda-accb-a54587c8ea82",
                    "sense_definition": "To be completely overwhelmed or occupied by an intense emotion or situation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "overwhelmed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She felt <w>submerged</w> in grief after the tragic news.",
                            "target_lang_translations": {
                                "ru": "Она чувствовала, что <w>погрузилась</w> в горе после трагических новостей."
                            }
                        },
                        {
                            "text": "He was <w>submerged</w> in work and could not attend the meeting.",
                            "target_lang_translations": {
                                "ru": "Он был <w>погружен</w> в работу и не смог присутствовать на встрече."
                            }
                        }
                    ],
                    "common_phrases": [
                        "submerged in work"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть полностью поглощенным сильной эмоцией или занятым делом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "погружа́ться",
                                "target_lang_sense_clarification": "перен. целиком отдаваться чему-либо"
                            },
                            {
                                "target_lang_word": "погрузи́ться",
                                "target_lang_sense_clarification": "перен. предаться какому-либо чувству или сосредоточиться на чем-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c208b71f-e71d-33b7-a641-25d24e111de9",
                    "sense_definition": "To suppress or hide something, such as feelings or memories.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "overwhelmed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He tried to <w>submerge</w> his anger by focusing on his hobbies.",
                            "target_lang_translations": {
                                "ru": "Он пытался <w>подавить</w> свой гнев, сосредоточившись на хобби."
                            }
                        },
                        {
                            "text": "She attempted to <w>submerge</w> her painful memories with constant activity.",
                            "target_lang_translations": {
                                "ru": "Она пыталась <w>скрыть</w> свои болезненные воспоминания постоянной активностью."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Подавлять или скрывать что-либо, например чувства или воспоминания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подавля́ть",
                                "target_lang_sense_clarification": "скрывать или сдерживать чувства"
                            },
                            {
                                "target_lang_word": "скрыва́ть",
                                "target_lang_sense_clarification": "утаивать воспоминания или эмоции"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}