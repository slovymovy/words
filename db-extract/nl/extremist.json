                        "glosses": [
                            "iemand met radicale, extremistische standpunten, een aanhanger van een ideologie die ver van het politieke of maatschappelijke centrum ligt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d069957-0ef3-4291-8aab-449dbd231f5b",
                                "sense_id": "a9ac34e2-c5c1-3c5f-b27e-8cee43d3dc34",
                                "text": "Volgens de president is een kleine groep extremisten verantwoordelijk voor de rellen."
