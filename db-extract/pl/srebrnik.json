                                        "glosses": [
                                            "eine (antike) Münze aus Silber"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e46a94be-5550-4770-b4dc-d1cc0f37e4fd",
                                                "sense_id": "2947d512-5595-3e70-b682-0df054451cc8",
                                                "text": "Neben einigen Silberlingen und Schmuckstücken fanden die Archäologen bei der Ausgrabung auch Spielzeug und andere Alltagsgegenstände."
                                            },
                                            {
                                                "example_id": "01e5106a-8e59-461d-b3d0-501ef5f9d9a4",
                                                "sense_id": "2947d512-5595-3e70-b682-0df054451cc8",
                                                "text": "„Da ging einer von den Zwölfen, mit Namen Judas Iskariot, zu den Hohenpriestern und sprach: Was wollt ihr mir geben? Ich will ihn euch verraten. Und sie boten ihm dreißig Silberlinge.“"
                                            },
                                            {
                                                "example_id": "9eb7447f-f825-4185-bdae-a94b6db67195",
                                                "sense_id": "2947d512-5595-3e70-b682-0df054451cc8",
                                                "text": "„Als Judas, der ihn verraten hatte, sah, dass er zum Tode verurteilt war, reute es ihn, und er brachte die dreißig Silberlinge den Hohenpriestern und Ältesten zurück“ […]."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
