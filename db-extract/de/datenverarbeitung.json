                        "sense_id": "fff042f7-3750-37c1-9e48-4c3d30fcccba",
                        "entry_id": "c47630cd-94b4-3771-a839-97761f3c6295",
                        "glosses": [
                            "die zielgerichtete Transformation von im Allgemeinen großen Datenmengen durch Menschen oder Maschinen nach einem vorgegebenen Verfahren"
                        ],
                        "tags": [
                            "EDV"
                        ],
                        "examples": [
                            {
                                "example_id": "b0722684-ba52-4986-8bc7-7acc9203d518",
                                "sense_id": "fff042f7-3750-37c1-9e48-4c3d30fcccba",
                                "text": "Nachrichtenbezogene Computeranwendungen wie E-Mail oder VoIP können überwacht werden, nicht aber Datenverarbeitungen, die nicht nachrichten- oder kommunikationsbezogen sind (Textverarbeitung, Datenbanken, etc.)"
                            },
                            {
                                "example_id": "cbc8d5c1-843f-47ce-9ffd-9871979849d9",
                                "sense_id": "fff042f7-3750-37c1-9e48-4c3d30fcccba",
                                "text": "Durch die Bearbeitung dieser Daten ist es möglich [sic!] auf zusätzliche Untersuchungen zu verzichten, und die Bilder stehen uns durch die schnelle Datenverarbeitung sofort für die Diagnosestellung zur Verfügung."
                            }
                        ],
