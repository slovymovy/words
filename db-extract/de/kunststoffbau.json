                "senses": [
                    {
                        "sense_id": "438b19d4-6e2b-39f6-b758-37cdd98e4fcb",
                        "entry_id": "02a016a7-cf2b-3bcd-a28f-8fa14484c4f2",
                        "glosses": [
                            "Konstruktion und Herstellung von Gebilden aus Plastik/Kunststoffen"
                        ],
                        "tags": [
                            "Technik, kein Plural"
                        ],
                        "examples": [
                            {
                                "example_id": "1ad01fdf-c0ca-46c1-b6b8-3fe86cfa080b",
                                "sense_id": "438b19d4-6e2b-39f6-b758-37cdd98e4fcb",
                                "text": "„Garne können auch zu Körpergebilden wie Schläuchen oder Strümpfen oder zu Vorerzeugnissen beispielsweise für den Kunststoffbau weiterverarbeitet werden.“"
                            },
                            {
                                "example_id": "d0d70cb6-b386-41d1-ba4a-cc958cd44e4f",
                                "sense_id": "438b19d4-6e2b-39f6-b758-37cdd98e4fcb",
                                "text": "„Dann war ich eines Tages Richtung Gießen unterwegs, um dort bei einer Spezialfirma für Kunststoffbau unseren neuen Grauwassertank abzuholen.“"
                            },
                            {
                                "example_id": "13574ca6-f79f-421d-bc63-2f3328638856",
                                "sense_id": "438b19d4-6e2b-39f6-b758-37cdd98e4fcb",
                                "text": "„Zusammenfassend ist zu sagen, daß der Kunststoffbau neue, bisher im Bauwesen unbekannte Wege gehen muß, um mit den unerwünschten Eigenheiten der Kunststoffe fertig zu werden und ihre Vorzüge voll zur Geltung zu bringen.“"
                            },
                            {
                                "example_id": "3fa824fd-dec7-4c35-abcf-b45254dc05bb",
                                "sense_id": "438b19d4-6e2b-39f6-b758-37cdd98e4fcb",
                                "text": "„Der Aluminium(leicht)bau hat im Flugzeugbau Eingang gefunden, ebenso wie der Kunststoffbau, der heute Gebrauchsgüter und Sportgeräte beherrscht.“"
                            },
                            {
                                "example_id": "4a3f2bd8-ec78-48e7-9d46-896bc524f02a",
                                "sense_id": "438b19d4-6e2b-39f6-b758-37cdd98e4fcb",
                                "text": "„Aber auch das Angebot der Bauwirtschaft und das Spektrum der Methoden wird noch vielfältiger werden: der Kunststoffbau eröffnet bereits heute unabsehbare Perspektiven […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0092b0b1-30f4-3750-9a0c-e451abdcd92f",
                        "entry_id": "02a016a7-cf2b-3bcd-a28f-8fa14484c4f2",
                        "glosses": [
                            "aus Kunststoff gefertigtes, größeres Teil"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7642c780-c0bd-4918-896b-5554cfa0143e",
                                "sense_id": "0092b0b1-30f4-3750-9a0c-e451abdcd92f",
                                "text": "„Überdies tendierte der Kunststoffbau an bestimmten Stellen zum Reißen, zumindestens in der ersten Serie.“"
                            },
                            {
                                "example_id": "653f54d7-2d87-4bc5-bed1-613b0ed9d045",
                                "sense_id": "0092b0b1-30f4-3750-9a0c-e451abdcd92f",
                                "text": "„Kosten soll der Kunststoffbau laut Preisempfehlung des Herstellers 487,39 Euro – ein krummer Preis, weil die bis zum Jahresende in Pandemie-Zeiten gesenkte Mehrwertsteuer berücksichtigt wird.“"
                            },
                            {
                                "example_id": "ee383b2b-fca1-489b-9d12-3a5b8a1bfdea",
                                "sense_id": "0092b0b1-30f4-3750-9a0c-e451abdcd92f",
                                "text": "„Die Abbildung 49 rechts zeigt den Kunststoffbau am Frontend des Fahrzeugs.“"
                            },
                            {
                                "example_id": "d21a0ee8-9a02-468b-b688-d56833879d39",
                                "sense_id": "0092b0b1-30f4-3750-9a0c-e451abdcd92f",
                                "text": "„Ziel des Konstrukteurs ist es also, vor allem im Stahlbau und bei dünnwandigen, unregelmäßigen, oft offenen Profilquerschnitten im Kunststoffbau die Beanspruchung durch den Schubmittelpunkt zu legen.“"
                            },
                            {
                                "example_id": "81f8fb39-ebd4-48bc-afbd-d6fb8e262ccb",
                                "sense_id": "0092b0b1-30f4-3750-9a0c-e451abdcd92f",
                                "text": "„Sein Wagen sei ‚von der einen Seite zur anderen‘ aufgeplatzt. Der Kunststoffbau habe ihn und seine Begleiterin glücklicherweise vor Verletzungen bewahrt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
