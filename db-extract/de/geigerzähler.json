                "senses": [
                    {
                        "sense_id": "4c1cc2a5-d3c4-3e96-bca4-e704973a5801",
                        "entry_id": "e0308d6b-7168-3600-b101-4474f75f9edd",
                        "glosses": [
                            "Compteur Geiger."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "e68f1aef-5e76-4317-8dd3-5f4880858fb1",
                                "sense_id": "4c1cc2a5-d3c4-3e96-bca4-e704973a5801",
                                "text": "Mit einem Geigerzähler kann man messen, wie stark die Strahlung ist.",
                                "translation": "Avec un compteur Geiger, on peut mesurer la puissance d’un rayonnement."
                            },
                            {
                                "example_id": "091035fc-72b5-4dd1-bced-cadf4ab252c4",
                                "sense_id": "4c1cc2a5-d3c4-3e96-bca4-e704973a5801",
                                "text": "Uranatome sind instabil und emittieren Partikel, die sich mit einem Geigerzähler nachweisen lassen.",
                                "translation": "Les atomes d’uranium sont instables et émettent des particules qui sont détectables par un compteur Geiger."
                            }
                        ]
                    }
                ],
