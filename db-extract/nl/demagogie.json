                                                "sense_id": "0f742e67-0d1b-3753-8d8d-3c55adaaf5fa",
                                                "text": "Tomber dans la démagogie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37cfbf78-1c19-3ca0-90b1-494c5ebb34e3",
                                        "entry_id": "c841f467-3412-390c-91fc-1af725a45cfa",
                                        "glosses": [
                                            "État où le pouvoir est entre les mains de la multitude."
