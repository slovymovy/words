                        "examples": [
                            {
                                "example_id": "4de80203-eacc-4846-bc87-05acbe1c7d27",
                                "sense_id": "917345d7-75fa-3b28-ac9b-f28c133a7f1d",
                                "text": "Ton clebs a encore fait ses besoins devant la porte !"
                            },
                            {
                                "example_id": "0060451e-296e-4e5c-8ee7-da9b6997077c",
                                "sense_id": "917345d7-75fa-3b28-ac9b-f28c133a7f1d",
                                "text": "Il le regarde s’éloigner dans la lumière crue de l’avenue, avec son affreux clebs."
                            },
                            {
                                "example_id": "4d6fc29b-a406-4cdc-9898-d125bb44b130",
                                "sense_id": "917345d7-75fa-3b28-ac9b-f28c133a7f1d",
                                "text": "Je ne pense pas que Dingo était un dingo australien, mais tout bonnement un clebs."
                            },
                            {
                                "example_id": "94bae66c-d352-4ee4-91ee-d2b5104401ef",
                                "sense_id": "917345d7-75fa-3b28-ac9b-f28c133a7f1d",
                                "text": "Toute la meute dévale, fonce zigzag, les clebs lui râlent, coursent au train."
                            },
                            {
                                "example_id": "0e20e865-17f9-48b0-a76b-f887ca75da7e",
                                "sense_id": "917345d7-75fa-3b28-ac9b-f28c133a7f1d",
                                "text": "Tout plutôt que de le faire piquer. Il ne tuerait pas ce clebs, c’était dit."
                            }
                        ]
                    }
