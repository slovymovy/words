                                        "examples": [
                                            {
                                                "example_id": "b13d394c-be73-4abc-bfcb-5e6a1802e5cd",
                                                "sense_id": "1f865c98-b398-3f77-b550-a0cf9c30509a",
                                                "text": "We subjoin an engraving […] which will give the reader a far better notion of the structure than any verbal description could convey to the mind."
                                            },
                                            {
                                                "example_id": "4f01fc7d-61cc-4545-8934-19b3c87134d3",
                                                "sense_id": "1f865c98-b398-3f77-b550-a0cf9c30509a",
                                                "text": "It was not a verbal remark, but a proceeding in dumb-show"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7472322-3acb-3994-93d9-9735a8c10230",
                                        "entry_id": "38af6c4b-f501-34ae-95fe-381d7099cbbd",
                                        "glosses": [
                                            "Expressly spoken rather than written; oral."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b3ae47c-69c8-4c92-abef-08b090302f0b",
                                                "sense_id": "b7472322-3acb-3994-93d9-9735a8c10230",
                                                "text": "a verbal contract"
                                            },
                                            {
                                                "example_id": "8206953f-d547-4828-8eda-929d1f4c508d",
                                                "sense_id": "b7472322-3acb-3994-93d9-9735a8c10230",
                                                "text": "a verbal testimony"
                                            },
                                            {
                                                "example_id": "05575d1b-2c4e-4d04-8885-5145e861e700",
                                                "sense_id": "b7472322-3acb-3994-93d9-9735a8c10230",
                                                "text": "You can't have verbal communication with a man in New South Wales, you know."
                                            },
                                            {
                                                "example_id": "01e0ee0e-af75-45d8-aa54-ae1356c35d4f",
                                                "sense_id": "b7472322-3acb-3994-93d9-9735a8c10230",
                                                "text": "I am not speaking of the verbal use of the term 'Fascist'. I am speaking of what I have seen in print."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e7df267-f55b-3bf4-8784-3b98c3af89a2",
                                        "entry_id": "38af6c4b-f501-34ae-95fe-381d7099cbbd",
                                        "glosses": [
                                            "Derived from, or having the nature of a verb."
                                        ],
