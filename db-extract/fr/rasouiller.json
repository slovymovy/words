                "senses": [
                    {
                        "sense_id": "246f451d-6460-30e3-afbf-06809347bc17",
                        "entry_id": "e3cd1c54-89a6-3a55-bd5a-cca308722207",
                        "glosses": [
                            "Raser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f630cb9-6cd0-4ea1-858e-1c5344051c32",
                                "sense_id": "246f451d-6460-30e3-afbf-06809347bc17",
                                "text": "La France a évacué 1263 personnes du Tchad… Alors que ça pète de tous les bouts, que des rebelles veulent foutre sur la trogne du Président Idriss Déby, on commence à mouiller le pantalon dans les ambassades quand les bombes viennent nous rasouiller les oreilles ainsi que celles de nos copains allemands, américains, chinois, libyens, etc."
                            }
                        ]
                    },
                    {
                        "sense_id": "b8256bd7-1e82-3d72-9e37-02c4ca9652af",
                        "entry_id": "e3cd1c54-89a6-3a55-bd5a-cca308722207",
                        "glosses": [
                            "Se raser."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "66fffe14-9142-455d-b60f-479638baa07d",
                                "sense_id": "b8256bd7-1e82-3d72-9e37-02c4ca9652af",
                                "text": "Avec ce beau temps hivernal, cariboutomsk en a profité pour se baigner, s’enlever ses puces et se rasouiller le museau."
                            },
                            {
                                "example_id": "42df9aee-2464-4234-856f-39644b59cf21",
                                "sense_id": "b8256bd7-1e82-3d72-9e37-02c4ca9652af",
                                "text": "On peut se frotter, se récurer, se rasouiller les poils en tous genres…"
                            },
                            {
                                "example_id": "e7dd24df-01e2-47a5-bea5-3c3f2b8e931b",
                                "sense_id": "b8256bd7-1e82-3d72-9e37-02c4ca9652af",
                                "text": "La photo de notre webmaster qui s’est rasouillé le bouc ce wkd ^([sic])week-end.."
                            }
                        ]
                    }
