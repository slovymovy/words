{
    "word_family": [
        "creep",
        "creeper",
        "creepily",
        "creepiness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "02ca8607-d88f-3cd7-829d-607bebe852ab",
                    "sense_definition": "Producing an uneasy fearful sensation, as of things crawling over one's skin.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "scary_atmosphere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old abandoned house looks really <w>creepy</w> in the moonlight.",
                            "target_lang_translations": {
                                "ru": "Старый заброшенный дом выглядит действительно <w>жутким</w> при лунном свете.",
                                "zh": "在月光下，那座废弃的老房子看起来真的很<w>阴森</w>。"
                            }
                        },
                        {
                            "text": "She got a <w>creepy</w> feeling that someone was watching her from the shadows.",
                            "target_lang_translations": {
                                "ru": "У неё возникло <w>жуткое</w> ощущение, что кто-то наблюдает за ней из темноты.",
                                "zh": "她有一种<w>令人毛骨悚然</w>的感觉，仿佛有人在暗处盯着她。"
                            }
                        }
                    ],
                    "synonyms": [
                        "scary",
                        "eerie",
                        "spooky",
                        "unsettling",
                        "frightening",
                        "weird"
                    ],
                    "antonyms": [
                        "pleasant",
                        "comforting",
                        "soothing",
                        "inviting"
                    ],
                    "common_phrases": [
                        "creepy feeling",
                        "creepy house",
                        "creepy story",
                        "creepy noise"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывающий чувство страха, тревоги или ощущение, будто по коже ползают мурашки.",
                        "zh": "指令人感到不安、恐惧，仿佛有东西在皮肤上爬行。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жуткий",
                                "target_lang_sense_clarification": "вызывающий страх"
                            },
                            {
                                "target_lang_word": "зловещий",
                                "target_lang_sense_clarification": "угрожающий, пугающий"
                            },
                            {
                                "target_lang_word": "вызывающий мурашки",
                                "target_lang_sense_clarification": "о физическом ощущении страха"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "阴森的",
                                "target_lang_sense_clarification": "形容环境或氛围令人恐惧"
                            },
                            {
                                "target_lang_word": "恐怖的",
                                "target_lang_sense_clarification": "令人感到害怕的"
                            },
                            {
                                "target_lang_word": "令人毛骨悚然的",
                                "target_lang_sense_clarification": "形容极度不安的生理感受"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "18de5625-8450-3c15-a33a-5bd4ff596b4c",
                    "sense_definition": "Causing discomfort or repulsion due to strange, eccentric, or inappropriate behavior.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "social_discomfort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I stayed away from the <w>creepy</w> man who was staring at everyone on the bus.",
                            "target_lang_translations": {
                                "ru": "Я держался подальше от <w>жуткого</w> мужчины, который пялился на всех в автобусе.",
                                "zh": "我离那个在公交车上盯着每个人看的<w>怪异</w>男人远点。"
                            }
                        },
                        {
                            "text": "He gave me a <w>creepy</w> smile that made me want to leave the room immediately.",
                            "target_lang_translations": {
                                "ru": "Он улыбнулся мне <w>отталкивающей</w> улыбкой, от которой мне захотелось немедленно выйти из комнаты.",
                                "zh": "他露出了一个<w>令人不适</w>的微笑，让我立刻想离开房间。"
                            }
                        }
                    ],
                    "synonyms": [
                        "weird",
                        "disturbing",
                        "unsettling"
                    ],
                    "antonyms": [
                        "charming",
                        "normal",
                        "pleasant",
                        "nice"
                    ],
                    "common_phrases": [
                        "creepy guy",
                        "creepy smile",
                        "creepy behavior"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывающий дискомфорт или отвращение из-за странного, эксцентричного или неуместного поведения.",
                        "zh": "因行为怪异、古怪或不恰当而引起不适或反感。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отталкивающий",
                                "target_lang_sense_clarification": "вызывающий неприязнь"
                            },
                            {
                                "target_lang_word": "жуткий",
                                "target_lang_sense_clarification": "пугающе странный"
                            },
                            {
                                "target_lang_word": "противный",
                                "target_lang_sense_clarification": "гадкий, неприятный"
                            },
                            {
                                "target_lang_word": "криповый",
                                "target_lang_sense_clarification": "сленг: странный и пугающий"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "怪异的",
                                "target_lang_sense_clarification": "形容行为举止不正常"
                            },
                            {
                                "target_lang_word": "令人不适的",
                                "target_lang_sense_clarification": "形容让人感到反感或尴尬"
                            },
                            {
                                "target_lang_word": "猥琐的",
                                "target_lang_sense_clarification": "形容行为举止令人厌恶"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "641d3b7e-670d-3fad-b828-b7cd63f0c098",
                    "sense_definition": "Moving by creeping along.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "motion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The garden was full of <w>creepy</w> insects hiding under the wet leaves.",
                            "target_lang_translations": {
                                "ru": "Сад был полон <w>ползучих</w> насекомых, прячущихся под мокрыми листьями.",
                                "zh": "花园里到处都是躲在湿叶子底下的<w>爬行</w>昆虫。"
                            }
                        },
                        {
                            "text": "We watched the <w>creepy</w> shadows lengthen across the floor as the sun went down.",
                            "target_lang_translations": {
                                "ru": "Мы наблюдали, как <w>ползучие</w> тени удлинялись по полу, когда садилось солнце.",
                                "zh": "随着太阳下山，我们看着那些<w>蠕动</w>的影子在地板上拉长。"
                            }
                        }
                    ],
                    "synonyms": [
                        "crawling"
                    ],
                    "common_phrases": [
                        "creepy-crawlies"
                    ],
                    "target_lang_definitions": {
                        "ru": "Передвигающийся ползком или медленно стелющийся.",
                        "zh": "指缓慢爬行或移动的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ползучий",
                                "target_lang_sense_clarification": "о насекомых, растениях или тенях"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "爬行的",
                                "target_lang_sense_clarification": "形容昆虫或生物的动作"
                            },
                            {
                                "target_lang_word": "蠕动的",
                                "target_lang_sense_clarification": "形容缓慢且令人不适的移动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4e79e8ca-eb29-3b37-9080-ae7aa800a42a",
                    "sense_definition": "Feeling an uneasy fearful sensation; creeped out.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "subjective_feeling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I felt <w>creepy</w> and afraid after hearing that ghost story.",
                            "target_lang_translations": {
                                "ru": "Мне стало <w>жутко</w> и страшно после этой истории о привидениях.",
                                "zh": "听完那个鬼故事后，我感到<w>毛骨悚然</w>且害怕。"
                            }
                        },
                        {
                            "text": "Walking alone in the dark forest made him feel <w>creepy</w>.",
                            "target_lang_translations": {
                                "ru": "От прогулки в одиночестве по темному лесу ему стало <w>не по себе</w>.",
                                "zh": "独自走在黑暗的森林里让他感到<w>不安</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "afraid",
                        "uneasy",
                        "scared"
                    ],
                    "antonyms": [
                        "calm",
                        "secure"
                    ],
                    "target_lang_definitions": {
                        "ru": "Испытывающий страх или неприятное, тревожное ощущение.",
                        "zh": "感到不安、恐惧或被吓到。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "напуганный",
                                "target_lang_sense_clarification": "испытывающий страх"
                            },
                            {
                                "target_lang_word": "встревоженный",
                                "target_lang_sense_clarification": "беспокойный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "感到不安",
                                "target_lang_sense_clarification": "形容心理上的不适感"
                            },
                            {
                                "target_lang_word": "毛骨悚然",
                                "target_lang_sense_clarification": "形容极度恐惧的心理状态"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}