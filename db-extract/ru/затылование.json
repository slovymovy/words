                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "be38cd34-e463-3703-8bb3-edb03b108236",
                                        "entry_id": "e65615ab-ffd6-3d77-9b13-9de9b8631d9a",
                                        "glosses": [
                                            "That brings relief."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06f80d22-68bb-428b-9af6-50ee6a2d474a",
                                                "sense_id": "be38cd34-e463-3703-8bb3-edb03b108236",
                                                "text": "Like a weary insomniac, France too greeted the relieving dawn chiefly longing for one thing only – repose."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "relieving",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4dd26a8b-c066-3b3c-8c76-2784f4d93058",
                                        "entry_id": "5ecf436f-b8e1-3466-b5c6-d2c5fa56e3b7",
                                        "glosses": [
                                            "A change in colour, texture, etc. that relieves monotony."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27a182c9-4e28-4ca2-bf33-9b3f4b3b488f",
                                                "sense_id": "4dd26a8b-c066-3b3c-8c76-2784f4d93058",
                                                "text": "Purple flowers are commonly contrasted with centres or variegations of bright yellow, as blue flowers are with like relievings of orange […]"
                                            },
                                            {
                                                "example_id": "21d9c2be-80ad-49a2-9e63-39b2b466d7d4",
                                                "sense_id": "4dd26a8b-c066-3b3c-8c76-2784f4d93058",
                                                "text": "The light—divested of its aching brilliancy, lies sweetly upon the floor, checkered as that old man's life, in its quaint, yet charming relievings of shadow."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "67907a33-c777-437f-965d-da9ecdaa0ce9",
                        "source_entry_id": "f6c984e6-243b-3aaa-bcbd-8b112a2a9fe9",
