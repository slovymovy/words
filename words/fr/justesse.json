            "pos": "noun",
            "senses": [
                {
                    "sense_id": "98d7b3f9-db17-3c1e-be3b-d3617416e489",
                    "sense_definition": "Qualité de ce qui est exact, approprié ou conforme à la vérité et à la réalité.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "exactitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tout le monde a salué la <w>justesse</w> de ses remarques lors de la réunion."
                        },
                        {
                            "text": "Cette balance de laboratoire fonctionne avec une <w>justesse</w> absolue pour peser les produits chimiques."
                        }
                    ],
                    "synonyms": [
                        "exactitude",
                        "pertinence",
                        "précision"
                    ],
                    "antonyms": [
                        "inexactitude",
                        "fausseté",
                        "erreur"
                    ],
                    "common_phrases": [
                        "avec justesse",
                        "justesse d'un propos",
                        "justesse d'un raisonnement"
                    ]
                },
                {
                    "sense_id": "47921b5b-e581-3d6b-ac77-c78ba45cd11d",
                    "sense_definition": "Précision ou exactitude dans l'exécution technique ou artistique, notamment en musique.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "precision_execution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La soprano a interprété ce morceau complexe avec une admirable <w>justesse</w> de voix."
                        },
                        {
                            "text": "Il admire la <w>justesse</w> des tirs de cet archer expérimenté."
                        }
                    ],
                    "synonyms": [
                        "précision",
                        "rigueur"
                    ],
                    "antonyms": [
                        "fausseté"
                    ],
                    "common_phrases": [
                        "justesse de la voix",
                        "chanter avec justesse"
                    ]
                },
                {
                    "sense_id": "53f56edd-7a59-37e2-a493-b90d5c3ac52c",
                    "sense_definition": "Caractère de ce qui est équitable, légitime ou fondé en droit et en morale.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "equite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les citoyens manifestent pacifiquement pour rappeler la <w>justesse</w> de leurs revendications sociales."
                        },
                        {
                            "text": "Elle a toujours défendu la <w>justesse</w> de cette cause humanitaire auprès des tribunaux internationaux."
                        }
                    ],
                    "synonyms": [
                        "équité",
                        "légitimité",
                        "rectitude"
                    ],
                    "antonyms": [
                        "iniquité",
                        "injustice"
                    ],
                    "common_phrases": [
                        "justesse d'une cause",
                        "justesse d'une décision"
                    ]
                },
                {
                    "sense_id": "06e3f7cb-a324-36e6-bb3f-6e6d34452ca3",
                    "sense_definition": "Aptitude d'une personne à évaluer, percevoir ou juger les situations de façon lucide et pénétrante.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "discernement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Grâce à la <w>justesse</w> de son coup d'œil, l'expert a immédiatement repéré le tableau authentique."
                        },
                        {
                            "text": "La <w>justesse</w> d'esprit de notre directrice nous a permis d'éviter une crise majeure."
                        }
                    ],
                    "synonyms": [
                        "discernement",
                        "lucidité",
                        "perspicacité"
                    ],
                    "common_phrases": [
                        "justesse d'esprit",
                        "justesse du coup d'œil"
                    ]
                }
            ]
        }
