                    },
                    {
                        "translation_id": "c703b518-6450-4012-876e-0925f5624fae",
                        "source_entry_id": "c408fed8-a76e-369b-a87f-9b3ca76e1460",
                        "source_sense_id": "609dec1d-5812-3b52-860e-0bc8fb91f7df",
                        "target_lang_word": "Nomade",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nomade",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "38d6e30a-17eb-3f49-be9c-e7ba41d50f1e",
                                        "entry_id": "786370de-abac-3fe2-857b-4d27217cc693",
                                        "glosses": [
                                            "Angehöriger eines Volkes, das ohne festen Wohnsitz von Ort zu Ort zieht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29d1f44c-7c9c-4562-ac1d-65894d4a2b78",
                                                "sense_id": "38d6e30a-17eb-3f49-be9c-e7ba41d50f1e",
                                                "text": "Die Tuareg in Afrika sind Nomaden."
                                            },
                                            {
                                                "example_id": "90c04639-80eb-4d4b-8f1b-bc3da79ba6f0",
                                                "sense_id": "38d6e30a-17eb-3f49-be9c-e7ba41d50f1e",
                                                "text": "Einige Regierungen versuchen die Nomaden sesshaft zu machen."
                                            },
                                            {
                                                "example_id": "66a1df8e-8cb0-4cb0-882f-34603342e33c",
                                                "sense_id": "38d6e30a-17eb-3f49-be9c-e7ba41d50f1e",
                                                "text": "„Immer öfter hatten die Holzhütten runde Pagodendächer, die Augen der Menschen schienen schmaler, in der Leere des Landes waren immer mehr Jurten kirgisischer Nomaden aufgeschlagen.“"
                                            },
                                            {
                                                "example_id": "20eb4f82-c596-4a46-b0c2-3a1a1a8b8ff3",
                                                "sense_id": "38d6e30a-17eb-3f49-be9c-e7ba41d50f1e",
                                                "text": "„Aus dem Nomaden wurde auf dem Thron ein ehrgeiziger Bauherr.“"
                                            },
                                            {
                                                "example_id": "9854e985-a7d7-4e8a-bd83-b8793777e353",
                                                "sense_id": "38d6e30a-17eb-3f49-be9c-e7ba41d50f1e",
                                                "text": "„Die unbekannten Nomaden werden als Eindringlinge dargestellt, die sich durch ihren Büßer- und Opferstatus unangreifbar machen möchten.“"
                                            },
                                            {
                                                "example_id": "b228afb8-535d-44e1-9651-8ee401bcfa13",
                                                "sense_id": "38d6e30a-17eb-3f49-be9c-e7ba41d50f1e",
                                                "text": "„Zudem fallen immer wieder Nomaden aus der Umgebung in die Stadt ein, erpressen die Einwohner um Geld oder Wertsachen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "80b7236e-f68e-3492-a67b-652168d212d7",
