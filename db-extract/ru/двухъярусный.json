                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cd9c4df4-df2d-4ae9-8c8a-252bf1a6e0ab",
                        "source_entry_id": "230622f6-d8b9-37b3-a8d9-efd99662b9d2",
                        "target_lang_word": "double-level",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "e9925d95-f733-4db7-a5fb-10ee2861db9d",
                        "source_entry_id": "230622f6-d8b9-37b3-a8d9-efd99662b9d2",
                        "target_lang_word": "two-tier",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "two-tier",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fd2376b3-7e9f-3139-89b8-4b3b6e938333",
                                        "entry_id": "ddd732ff-6ad5-358e-adae-1ed5b7d82c94",
                                        "glosses": [
                                            "Having or consisting of two tiers."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "39e51b0f-b066-48ee-a8f0-a766090bf87c",
                                                "sense_id": "fd2376b3-7e9f-3139-89b8-4b3b6e938333",
                                                "text": "Long before the final design for the Borders Railway was adopted and then implemented, CBR had argued that the 35-mile route - comprising 30 miles of new line extending southwards from Newcraighall - should be designed with a two-tier service in mind. This would comprise stopping services running as far as Gorebridge (12 miles south of Edinburgh), and faster limited-stop services covering the whole line to Tweedbank."
                                            },
                                            {
                                                "example_id": "5f1c10ba-620f-408a-a1a5-09da608978bb",
                                                "sense_id": "fd2376b3-7e9f-3139-89b8-4b3b6e938333",
                                                "text": "We have a two-tier system of Justice in the United States that cannot be allowed to continue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9ad2583-f550-34c4-8bf8-c70d864dd97b",
                                        "entry_id": "ddd732ff-6ad5-358e-adae-1ed5b7d82c94",
                                        "glosses": [
                                            "Relating to the two-tier system, a payroll system in which one group of workers receives lower wages and/or benefits than another."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc8722ef-3192-47a5-9a2b-9f7c82acc47d",
                                                "sense_id": "a9ad2583-f550-34c4-8bf8-c70d864dd97b",
                                                "text": "the two-tier regime"
                                            },
                                            {
                                                "example_id": "daf813be-29b1-4f4a-8f0e-944d2d46688f",
                                                "sense_id": "a9ad2583-f550-34c4-8bf8-c70d864dd97b",
                                                "text": "a two-tier accounting structure"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc94c6ef-4ff2-35f4-896c-f11ea69b9eb3",
                                        "entry_id": "ddd732ff-6ad5-358e-adae-1ed5b7d82c94",
                                        "glosses": [
                                            "Giving preferential treatment to one group over another."
                                        ],
                                        "tags": [
                                            "UK",
                                            "derogatory",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d07a5bf-daaf-4400-b4d7-1b04c00f12fa",
                                                "sense_id": "fc94c6ef-4ff2-35f4-896c-f11ea69b9eb3",
                                                "text": "two-tier policing"
                                            },
                                            {
                                                "example_id": "865883b1-6c4a-4870-9f20-e763bbfe0451",
                                                "sense_id": "fc94c6ef-4ff2-35f4-896c-f11ea69b9eb3",
                                                "text": "two-tier Keir (nickname for prime minister Keir Starmer)"
                                            },
                                            {
                                                "example_id": "326cfcb0-06b1-46c7-b3fd-328767543bb9",
                                                "sense_id": "fc94c6ef-4ff2-35f4-896c-f11ea69b9eb3",
                                                "text": "2025, 28 March, Paul Seddon, Minister threatens to override sentencing rules (BBC News) https://www.bbc.co.uk/news/articles/cz0303vkg7ko\nUnder the rules, which have prompted a \"two-tier\" justice row, judges will be expected to consider the lives of offenders from ethnic minority and other backgrounds before deciding on punishment."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a61c99f0-f20f-40a0-8353-3d46d3f4ac98",
                        "source_entry_id": "230622f6-d8b9-37b3-a8d9-efd99662b9d2",
                        "target_lang_word": "zweistöckig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zweistöckig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "13c97f5b-5a3e-32f8-993d-3d3313d0a477",
                                        "entry_id": "efe0b2be-8a0a-34d2-b1db-db8273d59a76",
                                        "glosses": [
                                            "mit zwei Stockwerken versehen, über zwei Stockwerke verfügend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a38be558-5081-4b3d-a246-c976e85930b1",
                                                "sense_id": "13c97f5b-5a3e-32f8-993d-3d3313d0a477",
                                                "text": "Sie wohnt in einem zweistöckigen Haus."
                                            },
                                            {
                                                "example_id": "cc97cc7b-d766-4544-b71c-38389a3a35ce",
                                                "sense_id": "13c97f5b-5a3e-32f8-993d-3d3313d0a477",
                                                "text": "„Von dem Geld, das die Goryo-kai in Shizuoka von Kajiyama bekam, baute sie eine zweistöckige Zentrale.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6d0745d6-5ecd-3d99-99bc-47d89d7e20c1",
                                        "entry_id": "efe0b2be-8a0a-34d2-b1db-db8273d59a76",
                                        "glosses": [
                                            "zwei übereinander liegende Ebenen habend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8714070c-4547-4e01-9756-9209ba9ff4b1",
                                                "sense_id": "6d0745d6-5ecd-3d99-99bc-47d89d7e20c1",
                                                "text": "Wir fuhren mit einem zweistöckigen Bus."
                                            },
                                            {
                                                "example_id": "8c125b19-fcbf-47b9-aade-5479af950ebc",
                                                "sense_id": "6d0745d6-5ecd-3d99-99bc-47d89d7e20c1",
                                                "text": "Er bestellte eine zweistöckige Torte für ihren Geburtstag."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f2184e7a-326f-4e51-84c8-41e4665f91f8",
                        "source_entry_id": "230622f6-d8b9-37b3-a8d9-efd99662b9d2",
