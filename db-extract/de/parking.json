                "senses": [
                    {
                        "sense_id": "0e361b28-2e50-3167-8eb6-cb415288943b",
                        "entry_id": "293bd995-f82c-3d71-9f11-991a2c612cf6",
                        "glosses": [
                            "Gebäude oder Fläche zum Abstellen einer gewissen Zahl von Fahrzeugen"
                        ],
                        "tags": [
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "b89d43be-8658-4377-8bc3-4b7c5d44669f",
                                "sense_id": "0e361b28-2e50-3167-8eb6-cb415288943b",
                                "text": "„Exakt 1000 Bautage dauerte es seit dem Anfrässtart im Februar 2016, bis das 310-plätzige Parking im Schlossberg erstellt war.“"
                            },
                            {
                                "example_id": "c1f57898-534e-476b-9991-1e038c1d7521",
                                "sense_id": "0e361b28-2e50-3167-8eb6-cb415288943b",
                                "text": "„Auf dem Parking hinter dem Bushof ist am Donnerstagmorgen schon einiges los.“"
                            },
                            {
                                "example_id": "a5711408-11ec-4433-bbe9-340253e48d66",
                                "sense_id": "0e361b28-2e50-3167-8eb6-cb415288943b",
                                "text": "„Gemäß unseren Informationen wurde der Parking nur auf diese Art und Weise gestaltet, damit er optimal an den Kreisverkehr angepasst ist, was unserer Meinung nach die falsche Prioritätensetzung darstellt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
