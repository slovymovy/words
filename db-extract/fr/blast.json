                "senses": [
                    {
                        "sense_id": "d427fc3d-96f9-33bd-bd41-67415ccdf293",
                        "entry_id": "f1dfc1e3-8577-3744-88b5-d6c2f88512e2",
                        "glosses": [
                            "Synonyme de « effet de souffle »."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a52a1a5-7a5d-4d7a-80c3-8f0ad0349fcf",
                                "sense_id": "d427fc3d-96f9-33bd-bd41-67415ccdf293",
                                "text": "L’onde de choc atteindra tous les organismes exposés, provoquant des lésions anatomiques viscérales (blast primaire), avec dans le même temps l’onde de pression qui précipitera par projection les éclats et les débris, puis les personnes, les faisant chuter ou les enfouissant (blast secondaire)."
                            },
                            {
                                "example_id": "c2004e97-9cfd-4866-9e03-b9aba189a3b4",
                                "sense_id": "d427fc3d-96f9-33bd-bd41-67415ccdf293",
                                "text": "Le blast ? C’est le mot qu’a utilisé Nicolas Sarkozy pour exprimer sa satisfaction (« L’effet de blast a été complet ») - face à l’intense couverture médiatique dont le lancement de son livre et de sa campagne a fait l’objet et à l’effet de souffle qu’il aurait réussi à produire."
                            },
                            {
                                "example_id": "f2a43dbc-2411-4f36-add1-e6a059a2f929",
                                "sense_id": "d427fc3d-96f9-33bd-bd41-67415ccdf293",
                                "text": "Ces derniers mots ont produit un effet de souffle qui a déformé la scène, un blast."
                            }
                        ]
                    },
                    {
                        "sense_id": "1d62aaeb-3da1-3dd0-9270-e797d2a08cec",
                        "entry_id": "f1dfc1e3-8577-3744-88b5-d6c2f88512e2",
                        "glosses": [
                            "Synonyme de « effet de souffle ».",
                            "Blast auriculaire : variation brutale de la pression de l’air dans le conduit auditif provoquant un traumatisme ou déchirement du tympan."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "2c94f9d0-bfe1-3806-883d-85e8f26a7bdf",
                        "entry_id": "f1dfc1e3-8577-3744-88b5-d6c2f88512e2",
                        "glosses": [
                            "Technique de batterie consistant à frapper à un tempo très rapide sur deux fûts en même temps que sur des doubles pédales dans le but de provoquer un effet de souffle."
                        ],
                        "tags": [
