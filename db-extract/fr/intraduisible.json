                                        "entry_id": "18e4a5d1-e1d0-327b-9262-8c66fbd8fb88",
                                        "glosses": [
                                            "so, dass es in einer anderen Sprache nicht sinnvoll wiedergegeben werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09255c1a-a0ed-4b3f-acb9-d632eddb03fa",
                                                "sense_id": "aa37d08f-320d-3b52-84db-571ce5606fa1",
                                                "text": "Wortspiele sind in der Regel unübersetzbar."
                                            },
                                            {
                                                "example_id": "a563b12f-f987-4cee-98f1-d5bf2ae60144",
                                                "sense_id": "aa37d08f-320d-3b52-84db-571ce5606fa1",
                                                "text": "Dieses Wort ist unübersetzbar. Man könnte es höchstens umständlich umschreiben."
                                            },
                                            {
                                                "example_id": "d369a3a6-010b-4df5-a8b0-b047be196229",
                                                "sense_id": "aa37d08f-320d-3b52-84db-571ce5606fa1",
                                                "text": "„Von anderen unübersetzbaren Wörtern erfahren wir viel über die Feinheit einer Sprache.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
