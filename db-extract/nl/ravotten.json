                "senses": [
                    {
                        "sense_id": "b7b586c2-f075-320b-9240-8609aa94e2e4",
                        "entry_id": "5d15beec-8779-3325-88f6-63c83766f4af",
                        "glosses": [
                            "op een gezellige vriendschappelijke wijze met elkaar vechten zonder elkaar te verwonden"
                        ],
                        "tags": [
                            "unergative"
                        ],
                        "examples": [
                            {
                                "example_id": "412f0e06-a2a2-4fdb-a337-005ddf2c4d7c",
                                "sense_id": "b7b586c2-f075-320b-9240-8609aa94e2e4",
                                "text": "In de wijk Gracia in het centrum van Barcelona staan buiten aan de school een vijftigtal mensen. Er heerst een vrolijke sfeer. Enkele jongeren spelen gitaar, er wordt gebabbeld en gelachen. Op de speelplaats binnen ravotten kinderen, ouders staan in groepjes te kletsen. Velen onder hen zullen de nacht in de school doorbrengen. Ze willen vermijden dat de politie de school vannacht gaat sluiten, zodat er morgen niet gestemd kan worden."
                            },
                            {
                                "example_id": "38ac4c78-ce14-48e7-a8d6-7abff7f0720c",
                                "sense_id": "b7b586c2-f075-320b-9240-8609aa94e2e4",
                                "text": "Het huis waar zijn kinderen afgelopen week ook voor het eerst twee nachtjes sliepen. ,,Ze liepen al te ravotten in de tuin. Het is fijn dat ze nu een vaste plek hebben.\""
                            }
                        ]
                    }
