                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "b61fd255-09c2-39e1-a5e5-1c52c92b780b",
                        "entry_id": "1c9b49e7-70b6-3fe0-beaf-d337ea07bfa6",
                        "glosses": [
                            "dim. tant. benaming voor muntstuk met de waarde van een tiende van een munteenheid",
                            "muntstuk ter waarde van 0,10 euro"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5cde599f-9d9f-4154-905a-8b551ea15c3d",
                                "sense_id": "b61fd255-09c2-39e1-a5e5-1c52c92b780b",
                                "text": "Eurootje in de gleuf, knoppen bedienen, wachten maar. (…) Dan valt ineens rinkelend een dubbeltje wisselgeld in het retourvakje van de automaat."
                            }
                        ]
                    },
                    {
                        "sense_id": "f77f88dd-6414-367e-904b-069adb3c7a9d",
                        "entry_id": "1c9b49e7-70b6-3fe0-beaf-d337ea07bfa6",
                        "glosses": [
                            "dim. tant. benaming voor muntstuk met de waarde van een tiende van een munteenheid",
                            "oud muntstuk ter waarde van 0,10 gulden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d137d2d-23c5-4757-906c-9f71697940e8",
                                "sense_id": "f77f88dd-6414-367e-904b-069adb3c7a9d",
                                "text": "Toen wij nog Nederlandse guldens hadden, stond zij ook op alle munten, op een stuiver, een dubbeltje, een kwartje, een gulden, een rijksdaalder en op een munt van vijf gulden."
                            }
                        ]
                    },
                    {
                        "sense_id": "c51c4a84-3f94-3965-a85f-794d4b086eb6",
                        "entry_id": "1c9b49e7-70b6-3fe0-beaf-d337ea07bfa6",
                        "glosses": [
                            "dim. tant. benaming voor muntstuk met de waarde van een tiende van een munteenheid",
                            "muntstuk ter waarde van 0,10 dollar"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9774034a-67e7-48d2-bbe4-bfbb06cda326",
                                "sense_id": "c51c4a84-3f94-3965-a85f-794d4b086eb6",
                                "text": "Een zeldzaam dubbeltje van ruim een eeuw oud is voor 2 miljoen dollar (1,8 miljoen euro) verkocht op een Amerikaanse veiling. Van de 1894-S Barber Dime werden er destijds slechts een handjevol geslagen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "607a3dfa-abc5-4f3f-8b35-f6f305b4ce28",
                        "source_entry_id": "1c9b49e7-70b6-3fe0-beaf-d337ea07bfa6",
                        "source_sense_id": "bf8a5759-5132-3bbe-a491-4cf4f85eb5f1",
                        "source_sense_description": "benaming voor muntstuk met de waarde van een tiende van een munteenheid",
                        "target_lang_word": "Groschen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Groschen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8ac50ff1-d344-3533-9711-6d7b10f079a6",
                                        "entry_id": "bb841c8c-ee54-35f6-a406-cd6af9488191",
                                        "glosses": [
                                            "eine deutsche, dicke Silbermünze, die vom 14. bis in das 19. Jahrhundert geprägt wurde"
                                        ],
                                        "tags": [
                                            "ursprünglich"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9c73ab3-5e05-4317-9e86-7a16b4c77672",
                                                "sense_id": "8ac50ff1-d344-3533-9711-6d7b10f079a6",
                                                "text": "Groschen als Zahlungsmittel gibt es in Deutschland nicht mehr."
                                            },
                                            {
                                                "example_id": "d985c669-4060-4e0d-b1a5-17c8bc464411",
                                                "sense_id": "8ac50ff1-d344-3533-9711-6d7b10f079a6",
                                                "text": "„Und als er nach dem Gesang zu ihr trat, hatte sie die fünf Groschen, die sie für ihn zurechtgelegt hatte, in einen Taler verwandelt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b817600a-ffdb-3510-8504-51a3ef102988",
                                        "entry_id": "bb841c8c-ee54-35f6-a406-cd6af9488191",
                                        "glosses": [
                                            "30 Groschen = ein Taler"
                                        ],
                                        "tags": [
                                            "in Preußen (seit 1838)"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "65b2de9d-e952-3e23-bbfb-c40e6294c302",
                                        "entry_id": "bb841c8c-ee54-35f6-a406-cd6af9488191",
                                        "glosses": [
                                            "100 Groschen = 1 Schilling (bis zur Einführung des Euro)"
                                        ],
                                        "tags": [
                                            "in Österreich (seit 1925)"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14bbc7a5-7aee-4a19-a8ac-de7aef1f397a",
                                                "sense_id": "65b2de9d-e952-3e23-bbfb-c40e6294c302",
                                                "text": "„Bei der Umrechnung in Schillinge und bei Berechnungen in Schillingen sind Bruchteile, die einen halben Groschen oder mehr betragen, für einen Groschen zu rechnen, Bruchteile unter einem halben Groschen zu vernachlässigen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "942ba869-9c31-3f7e-947a-60c6bc98ec32",
                                        "entry_id": "bb841c8c-ee54-35f6-a406-cd6af9488191",
                                        "glosses": [
                                            "100 Groschen = 1 Zloty"
                                        ],
                                        "tags": [
                                            "in Polen (seit 1928)"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "b8833c0c-a38a-3905-9efd-d48e6b2a6809",
                                        "entry_id": "bb841c8c-ee54-35f6-a406-cd6af9488191",
                                        "glosses": [
                                            "die 10-Pfennig-Münze in Deutschland (vor der Einführung des Euro)"
                                        ],
                                        "tags": [
                                            "Volksmund"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24df6ca8-896d-463a-90fb-3d730e1ed4a9",
                                                "sense_id": "b8833c0c-a38a-3905-9efd-d48e6b2a6809",
                                                "text": "„Aber die Kindervorstellung kostete hier einen Groschen weniger als woanders, und das entschied.“"
                                            },
                                            {
                                                "example_id": "33301e88-ffac-44e3-ae41-b85e0f62fa61",
                                                "sense_id": "b8833c0c-a38a-3905-9efd-d48e6b2a6809",
                                                "text": "„Hastig kramt Eos noch einmal zwei Groschen hervor und stopft sie in den Automaten.“"
                                            },
                                            {
                                                "example_id": "91372b58-04f6-405b-8778-30a042f51816",
                                                "sense_id": "b8833c0c-a38a-3905-9efd-d48e6b2a6809",
                                                "text": "„Ecke Fasanenstraße steht ein Straßensänger mit müdem Gesicht, vor sich auf dem Boden eine Blechdose mit Groschen.“"
                                            },
                                            {
                                                "example_id": "5fa6c1bd-dc96-46f7-9a33-412ae5aede67",
                                                "sense_id": "b8833c0c-a38a-3905-9efd-d48e6b2a6809",
                                                "text": "„Schließlich zieht sie ihr Portemonnaie hervor, öffnet den Metallclip und klaubt Groschen heraus.“"
                                            },
                                            {
                                                "example_id": "4d62204c-1c8a-4215-84e5-be374ba80340",
                                                "sense_id": "b8833c0c-a38a-3905-9efd-d48e6b2a6809",
                                                "text": "„Ich wußte nicht, wieviel Seidenkissen es für einen Groschen gab, ich machte das Glas auf und zählte zwanzig Stück in eine Tüte und schämte mich zum ersten Mal meiner nicht ganz sauberen Finger, die durch das dicke Bonbonglas noch vergrößert wurden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "5731e48c-d92c-321b-8984-f23277a2f5b3",
                                        "entry_id": "bb841c8c-ee54-35f6-a406-cd6af9488191",
                                        "glosses": [
                                            "Bezeichnung für Geld"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            }
                        ]
                    },
