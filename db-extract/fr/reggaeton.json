                                        "glosses": [
                                            "A style of Latin American popular music, originally developing from reggae in Panama but now more of a type of hip hop-dance music mainly associated with Puerto Rico."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e941ea83-d3c3-4fc3-a5e1-1ee38b59cbd8",
                                                "sense_id": "ed9f0f2b-e65e-3959-a7a5-020b866c555b",
                                                "text": "The Spanish islands gave the world salsa, and the more modern (and often controversial) hip-hop style reggaeton, which was forged between the islands and Miami."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
