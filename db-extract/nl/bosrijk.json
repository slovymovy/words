                    {
                        "sense_id": "5bff9189-a028-3158-88bc-58b9ff16cea0",
                        "entry_id": "29c5e049-bc74-31c6-8484-7cf4c076e2fa",
                        "glosses": [
                            "gekenmerkt door een verhoudingsgewijs groot aantal bossen; rijk aan bos"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "496b965d-c7e0-45b5-86e9-669815654ed9",
                                "sense_id": "5bff9189-a028-3158-88bc-58b9ff16cea0",
                                "text": "De Veluwe is een bosrijke omgeving."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1cc7f7f4-dc5b-4158-a1b8-f304e04dab87",
                        "source_entry_id": "29c5e049-bc74-31c6-8484-7cf4c076e2fa",
                        "source_sense_id": "5bff9189-a028-3158-88bc-58b9ff16cea0",
                        "source_sense_description": "gekenmerkt door een verhoudingsgewijs groot aantal bossen; rijk aan bos",
                        "target_lang_word": "buschreich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "5c82c1f3-6016-467b-892b-f56431ecd3b4",
                        "source_entry_id": "29c5e049-bc74-31c6-8484-7cf4c076e2fa",
                        "source_sense_id": "5bff9189-a028-3158-88bc-58b9ff16cea0",
                        "source_sense_description": "gekenmerkt door een verhoudingsgewijs groot aantal bossen; rijk aan bos",
                        "target_lang_word": "bosky",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bosky",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "55f56417-670c-3725-a7a0-b157f4e8e039",
                                        "entry_id": "403feb34-fee7-3068-bf87-3ad615053fef",
                                        "glosses": [
                                            "Having abundant bushes, shrubs or trees."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d84b5d60-e01c-43fb-a44c-18df1239eda6",
                                                "sense_id": "55f56417-670c-3725-a7a0-b157f4e8e039",
                                                "text": "And the fields; they must have been a little more trackless and irregular, more bosky and tumbled, retaining a little more hill and dale, an irregularity which generation after generation of ploughing has nearly counteracted ; […]."
                                            },
                                            {
                                                "example_id": "bead259f-98a3-4ae8-81d6-0713a4b562d5",
                                                "sense_id": "55f56417-670c-3725-a7a0-b157f4e8e039",
                                                "text": "Even in 1869 it had had more than half a century of development, and to judge from photographs must already have been a place of charm. Indeed, it seems to have had at that time more and finer trees than now, and to have been more bosky with scattered copses and masses of shrubbery."
                                            },
                                            {
                                                "example_id": "a2934203-2415-40ee-a6e0-b47dacf2276f",
                                                "sense_id": "55f56417-670c-3725-a7a0-b157f4e8e039",
                                                "text": "The Harvard Yard is also darkened and made to seem far more bosky and umbrageous than it was."
                                            },
                                            {
                                                "example_id": "8b4bca78-3d96-4e5e-b77d-97efbf6e0b7e",
                                                "sense_id": "55f56417-670c-3725-a7a0-b157f4e8e039",
                                                "text": "We rambled around wet fields and bosky paths that smelled of jasmine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c314973-aa3c-33b4-9112-be59ec68ac52",
                                        "entry_id": "403feb34-fee7-3068-bf87-3ad615053fef",
                                        "glosses": [
                                            "Caused by trees or shrubs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d88dc98b-13d4-4f45-892f-5af1f2ab0d6a",
                                                "sense_id": "8c314973-aa3c-33b4-9112-be59ec68ac52",
                                                "text": "It was open, and they looked down the road which was darkened over with long bosky shadows."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ddcdcfe-4a0d-3850-b176-26d457866f1b",
                                        "entry_id": "403feb34-fee7-3068-bf87-3ad615053fef",
                                        "glosses": [
                                            "Bushy, bristling."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ddbdbb0-1afb-4f65-8b89-253434643998",
                                                "sense_id": "9ddcdcfe-4a0d-3850-b176-26d457866f1b",
                                                "text": "They were nearly all whalemen; chief mates, and second mates, and third mates, and sea carpenters, and sea coopers, and sea blacksmiths, and harpooneers, and ship keepers; a brown and brawny company, with bosky beards; an unshorn, shaggy set, all wearing monkey jackets for morning gowns."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b1f4871-c39b-34e2-82a4-c19a82a429fb",
                                        "entry_id": "403feb34-fee7-3068-bf87-3ad615053fef",
                                        "glosses": [
                                            "Drunk; inebriated."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
