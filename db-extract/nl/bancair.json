                                        "examples": [
                                            {
                                                "example_id": "1546deb1-bb9b-4201-af41-7803d37b60c7",
                                                "sense_id": "d5d44ff0-8dee-34cd-9587-117d8ee9a654",
                                                "text": "Ces jeunes gens ressentent d'autant moins de scrupules que ces établissements bancaires ont poussé leurs familles au surendettement à coups de « crédits conso » répétés, un jour pour un nouveau canapé, un autre pour un écran plat."
                                            },
                                            {
                                                "example_id": "9fe40023-c214-466d-b920-b9b21dd6875c",
                                                "sense_id": "d5d44ff0-8dee-34cd-9587-117d8ee9a654",
                                                "text": "Un bon sens dérangeant en Champagne, surtout dans une Côte des Blancs productiviste et bidouilleuse qui est à la viticulture naturelle ce que le Luxembourg est à la transparence bancaire."
                                            },
                                            {
                                                "example_id": "80189de8-2aa8-41a2-928a-c6421420119e",
                                                "sense_id": "d5d44ff0-8dee-34cd-9587-117d8ee9a654",
                                                "text": "Ancien cadre bancaire, il sera à un guichet pour veiller à la bonne utilisation du nouveau moyen de paiement « cashless » (sans monnaie)."
                                            }
                                        ]
                                    }
