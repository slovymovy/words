    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "04f02810-1358-312c-9b34-201dca3c3f0f",
                "word": "spadework",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "75d7f389-456e-3368-87ff-44302b84f60b",
                        "entry_id": "04f02810-1358-312c-9b34-201dca3c3f0f",
                        "glosses": [
                            "Work done by digging with a spade."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "a8b2f5c7-b010-499e-a587-99bb449fd284",
                                "sense_id": "75d7f389-456e-3368-87ff-44302b84f60b",
                                "text": "It is this help that the present book attempts to give, and the moment of its appearance, during a partial lull of excavation, is an opportune one. There is a chance to take breath and gather up the threads, with the possibility that the next month's spade-work will not put us out of date."
                            }
                        ]
                    },
                    {
                        "sense_id": "2809c40f-3dad-34be-8358-b9f966d7551a",
                        "entry_id": "04f02810-1358-312c-9b34-201dca3c3f0f",
                        "glosses": [
                            "Work done in preparation for something else."
                        ],
                        "tags": [
                            "figuratively",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "73177ec8-adf1-4d89-80c7-91163537da83",
                                "sense_id": "2809c40f-3dad-34be-8358-b9f966d7551a",
                                "text": "There's a lot of spadework to be done before the scheme can be implemented."
                            },
                            {
                                "example_id": "6fa52488-f713-4d76-865a-51961212b8a3",
                                "sense_id": "2809c40f-3dad-34be-8358-b9f966d7551a",
                                "text": "Removing a portion of chair which had got entangled in my back hair, I said with a candour that became me well: “I was looking for a mouse.” If she had replied, “Ah, yes, indeed. I understand now. A mouse, to be sure. Quite,” everything would have been nice and smooth, but she didn't. “A mouse?” she said. “What do you mean?” Well, of course, if she didn't know what a mouse was, there was evidently a good deal of tedious spadework before us, and one would scarcely have known where to start."
                            },
                            {
                                "example_id": "7c840507-1f86-4712-b7f0-4c05375a0e90",
                                "sense_id": "2809c40f-3dad-34be-8358-b9f966d7551a",
                                "text": "Some essential spadework, on which certain details of the plan will be founded, is yet unfinished."
                            }
                        ]
                    }
                ],
