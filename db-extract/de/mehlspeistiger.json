                "senses": [
                    {
                        "sense_id": "0352eff8-0729-3928-9d9b-dc4aecc0f600",
                        "entry_id": "eeca1b4a-29f1-3556-8d7c-ca7a58c870c1",
                        "glosses": [
                            "Person, die eine besondere Vorliebe für Mehlspeisen hat"
                        ],
                        "tags": [
                            "Austrian German",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "b610085a-760a-4a27-b450-48f133d8a1ca",
                                "sense_id": "0352eff8-0729-3928-9d9b-dc4aecc0f600",
                                "text": "„Nicht in irgendeiner Konditorei, sondern bei Wienerroither in Pörtschach, dem damals wie heute angesagten Hotspot für Mehlspeistiger.“"
                            },
                            {
                                "example_id": "351447fb-8b79-45f6-9d68-2e552a008cb9",
                                "sense_id": "0352eff8-0729-3928-9d9b-dc4aecc0f600",
                                "text": "„Einmal im Jahr wurden selbst unbelehrbare Mehlspeistiger aus ihren Gehegen gelockt und durch Ausübung von Sozialdruck zur Teilnahme an Fitwandertagen verdonnert.“"
                            },
                            {
                                "example_id": "1f5ca60c-f148-43e0-b61b-d10c13c9c6d8",
                                "sense_id": "0352eff8-0729-3928-9d9b-dc4aecc0f600",
                                "text": "„Warum zieht ihr nicht lieber Kokolores wie Bergfex, Zuckergoscherl oder Mehlspeistiger, mit denen man immer noch kujoniert wird, in euer Schattenreich?“"
                            },
                            {
                                "example_id": "e5e0a957-2553-4a48-b967-96328ffc062d",
                                "sense_id": "0352eff8-0729-3928-9d9b-dc4aecc0f600",
                                "text": "„Im Café Laumer zu Frankfurt mag die \"Engadiner Nusstorte\" Mehlspeistiger auch 35 Jahre nach Adornos Tod noch verzücken - in den Konditoreien Wiens, so beklagt Thomas Dèzsy, scheint die schmackhafte Süßspeise so gut wie unbekannt zu sein.“"
                            },
                            {
                                "example_id": "8820d7d7-ddb6-4867-986f-31528aff5421",
                                "sense_id": "0352eff8-0729-3928-9d9b-dc4aecc0f600",
                                "text": "„Österreich war halt immer ein Land der Mehlspeistiger.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
