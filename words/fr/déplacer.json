{
    "word_family": [
        "déplacement",
        "déplaçable",
        "replacer",
        "placer"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5b451a0a-26b2-30fb-bc4e-fc619c088c95",
                    "sense_definition": "Changer un objet ou une personne de place, le mettre ailleurs.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a demandé de l'aide pour <w>déplacer</w> un meuble très lourd dans le salon."
                        },
                        {
                            "text": "Tu dois <w>déplacer</w> la voiture car elle bloque l'accès au garage."
                        }
                    ],
                    "synonyms": [
                        "bouger",
                        "mouvoir"
                    ],
                    "common_phrases": [
                        "déplacer un meuble",
                        "déplacer la voiture"
                    ]
                },
                {
                    "sense_id": "b6f1f51d-4e34-3b97-9606-1a0e41ea336b",
                    "sense_definition": "Changer soi-même de lieu ou effectuer un trajet d'un endroit à un autre.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans cette grande ville, les habitants aiment se <w>déplacer</w> à pied."
                        },
                        {
                            "text": "Mon collègue préfère souvent se <w>déplacer</w> en train pour éviter les bouchons."
                        }
                    ],
                    "synonyms": [
                        "bouger"
                    ],
                    "common_phrases": [
                        "se déplacer à pied"
                    ]
                },
                {
                    "sense_id": "161ebc16-db03-3a31-8d41-db0e04fc4421",
                    "sense_definition": "Faire le trajet pour se rendre chez quelqu'un ou sur place, notamment pour une démarche ou un travail.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "visite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin accepte volontiers de se <w>déplacer</w> à domicile pour soigner les malades."
                        },
                        {
                            "text": "Le bureau était fermé et je regrette de m'être <w>déplacé</w> pour rien."
                        }
                    ],
                    "common_phrases": [
                        "se déplacer à domicile",
                        "se déplacer pour rien"
                    ]
                },
                {
                    "sense_id": "2e7ee7f7-a830-3b5c-a4e3-0c9b3a19f62f",
                    "sense_definition": "Faire changer un agent ou un fonctionnaire d'affectation ou de lieu de travail.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "travail",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après plusieurs incidents graves, la direction a décidé de <w>déplacer</w> cet employé dans une autre agence."
                        },
                        {
                            "text": "Le fonctionnaire a été <w>déplacé</w> dans le sud du pays pour les besoins du service."
                        }
                    ]
                }
            ]
        }
    ]
}