                                ]
                            },
                            {
                                "target_word": "wrok",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "c5faedad-5019-3772-8cc7-f5ab1d016638",
                                        "entry_id": "7d78c705-7b11-3141-b333-c1e6ac02a350",
                                        "glosses": [
                                            "blijvend gevoel van onvrede over geleden of vermeend onrecht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd94e1a0-4d2d-4384-a60f-dfccd0b4cef6",
                                                "sense_id": "c5faedad-5019-3772-8cc7-f5ab1d016638",
                                                "text": "Eerder werd al bekend dat verdachte Tetsuya Yamagami wrok tegen Abe koesterde, omdat de politicus volgens hem verbonden was aan een religieuze groep. Het is niet duidelijk waarom de 41-jarige man uiteindelijk Abe als slachtoffer koos."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1eb999f5-b90b-40b5-aae0-67a06c1b8609",
                        "source_entry_id": "a2feaf53-e880-3003-84fd-96720ef8bd82",
                        "source_sense_description": "anger",
                        "target_lang_word": "Ärger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ärger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6807cc39-11b5-3405-b0e9-8d0a854474e9",
                                        "entry_id": "c24af514-0f38-3189-a9d1-1c48c4fe28b9",
                                        "glosses": [
                                            "spontane, innere, emotionale Reaktion hochgradiger Unzufriedenheit auf eine Situation, eine Person oder eine Erinnerung, die der Verärgerte lieber anders gesehen hätte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60bb48d2-89f5-4a8d-8741-563238262c22",
                                                "sense_id": "6807cc39-11b5-3405-b0e9-8d0a854474e9",
                                                "text": "Als ihm der Zug vor der Nase wegfuhr, spürte er den Ärger in sich aufsteigen."
                                            },
                                            {
                                                "example_id": "d4041843-c3f8-49a8-9919-2a13d08bd7b5",
                                                "sense_id": "6807cc39-11b5-3405-b0e9-8d0a854474e9",
                                                "text": "„Häufig suchen auch die Anwälte reicher Anleger seinen Rat, wenn sie Ärger mit der Steuer befürchten.“"
                                            },
                                            {
                                                "example_id": "fb74a6c2-c726-41dd-bb51-ff5002670427",
                                                "sense_id": "6807cc39-11b5-3405-b0e9-8d0a854474e9",
                                                "text": "„Das Verlangen nach Anerkennung durch Mitschüler kann manchmal geradezu suchtartige Formen annehmen und manche Schüler nehmen dafür erheblichen Ärger mit dem Lehrer in Kauf.“"
                                            },
                                            {
                                                "example_id": "1cd7024e-4c0b-4076-a599-e2b57eef1e29",
                                                "sense_id": "6807cc39-11b5-3405-b0e9-8d0a854474e9",
                                                "text": "„Ohne etwas zu entgegnen, schluckte Herbstaster ihren Ärger hinunter.“"
                                            },
                                            {
                                                "example_id": "425effd1-1b3c-404b-a6a8-e09318249230",
                                                "sense_id": "6807cc39-11b5-3405-b0e9-8d0a854474e9",
                                                "text": "„Der Pfarrer lächelte von Zeit zu Zeit, seine Nichte konnte jedoch ihren Ärger nicht verwinden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2379616b-6e4a-3e3a-bd50-06e0aa886cf6",
                                        "entry_id": "c24af514-0f38-3189-a9d1-1c48c4fe28b9",
                                        "glosses": [
                                            "ein ärgerliches Erlebnis"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0cbc6184-883d-4b9b-9de2-e9ac205bdd74",
                                                "sense_id": "2379616b-6e4a-3e3a-bd50-06e0aa886cf6",
                                                "text": "Hoffentlich machen die Hooligans heute keinen Ärger."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eba24924-6902-4815-9cf8-ae972310125d",
                        "source_entry_id": "a2feaf53-e880-3003-84fd-96720ef8bd82",
                        "source_sense_description": "anger",
                        "target_lang_word": "Gereiztheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gereiztheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dc51487c-701d-3dee-a7d7-1210ce34ea02",
                                        "entry_id": "ded93f93-8d97-37af-ae6b-9e3466fcdef5",
                                        "glosses": [
                                            "Zustand nervlich angespannter Stimmung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d728877-dd6c-4bb1-8868-5826beef17ba",
                                                "sense_id": "dc51487c-701d-3dee-a7d7-1210ce34ea02",
                                                "text": "Am Ende des Arbeitstages schleppte er den Stress und die Gereiztheit oft mit nach Hause."
                                            },
                                            {
                                                "example_id": "59841b73-b480-470a-8598-4fbca3cec0fc",
                                                "sense_id": "dc51487c-701d-3dee-a7d7-1210ce34ea02",
                                                "text": "„Als Bruni bemerkt, dass Isoldes depressive Gereiztheit zunimmt, äußert sie ihre Vermutung, dass es für Percys Reserviertheit neben der Nibelungentreue noch handfestere Gründe geben könnte, wogegen halt schärfere Aphrodisiaka eingesetzt werden müssten.“"
                                            },
                                            {
                                                "example_id": "0fbd59f4-5239-4f89-9b90-b8ea44a946ac",
                                                "sense_id": "dc51487c-701d-3dee-a7d7-1210ce34ea02",
                                                "text": "„Alle ihre Gereiztheit war plötzlich verschwunden, und ihre unruhigen, fragenden Augen hafteten in gieriger Erwartung an seinem Gesicht.“"
                                            },
                                            {
                                                "example_id": "81f7df7e-bb1f-43b2-8275-fc2405916b40",
                                                "sense_id": "dc51487c-701d-3dee-a7d7-1210ce34ea02",
                                                "text": "„Sie lachte herzlich, denn der Ton, in dem St. Armaud dies sagte, klang durchaus liebenswürdig und jedenfalls ebenso frei von Gereiztheit wie Tadel.“"
                                            },
                                            {
                                                "example_id": "9fe2e779-d03a-4b43-b29f-874837c33d3f",
                                                "sense_id": "dc51487c-701d-3dee-a7d7-1210ce34ea02",
                                                "text": "„Wenn Karl Emonds eine Siebenzimmerwohnung hätte, wäre die Gereiztheit, das Gehetztsein nicht mehr unumgänglich.“"
                                            },
                                            {
                                                "example_id": "a6a04519-9fe0-48f3-9724-46b95a17fc01",
                                                "sense_id": "dc51487c-701d-3dee-a7d7-1210ce34ea02",
                                                "text": "„Als Ferris sein Büro betrat, musterte Hoffman ihn über den Rand seiner Lesebrille hinweg mit einer Mischung aus Gereiztheit und Erstaunen, als habe er total vergessen, dass er Ferris herbestellt hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
