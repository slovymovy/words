                "senses": [
                    {
                        "sense_id": "e74e01f6-b802-3afd-a294-9fc6936b972b",
                        "entry_id": "ec0e2af1-a27b-3527-88aa-dbc2636bab30",
                        "glosses": [
                            "In an agreeable or pleasing manner"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9fc57b79-aac2-4aeb-8b17-ec5c468195b2",
                                "sense_id": "e74e01f6-b802-3afd-a294-9fc6936b972b",
                                "text": "What a game this was in those early minutes. Germany were also agreeably fluid, with a fine natural width. But they also looked like a champion team short-handed heading back towards their own goal."
                            }
                        ]
                    },
                    {
                        "sense_id": "e5f4e080-c3a5-3b88-8598-b0c5ce142e37",
                        "entry_id": "ec0e2af1-a27b-3527-88aa-dbc2636bab30",
                        "glosses": [
                            "In accordance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55af5b5e-6e1c-4aa9-a5b5-a02cb8902f99",
                                "sense_id": "e5f4e080-c3a5-3b88-8598-b0c5ce142e37",
                                "text": "Walter was not a little surprised when he came back in the course of the forenoon, agreeably to his promise, to find Mr Brogley sitting in the back parlour with his hands in his pockets, and his hat hanging up behind the door."
                            }
                        ]
                    },
                    {
                        "sense_id": "ad8d6c57-2e0f-3c45-991b-6cfcf4ec4129",
                        "entry_id": "ec0e2af1-a27b-3527-88aa-dbc2636bab30",
                        "glosses": [
                            "Alike; similarly."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e8ea67e4-4aa2-4f63-880b-6eba2c718e83",
                        "source_entry_id": "ec0e2af1-a27b-3527-88aa-dbc2636bab30",
                        "source_sense_description": "in an agreeable manner",
                        "target_lang_word": "agréablement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "agréablement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "05042a74-2aa1-3c82-adbe-7b2439483c2b",
                                        "entry_id": "53217bdc-f7bc-3ead-960c-3df06e63d635",
                                        "glosses": [
                                            "D’une manière agréable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c04d9ac-7948-4b43-b25d-99fdab06e945",
                                                "sense_id": "05042a74-2aa1-3c82-adbe-7b2439483c2b",
                                                "text": "Très surpris, non, madame, répondit le lieutenant Hobson, mais je le serais agréablement, je l'avoue."
                                            },
                                            {
                                                "example_id": "e20258f7-c59f-4ea4-ae91-1f64f1808630",
                                                "sense_id": "05042a74-2aa1-3c82-adbe-7b2439483c2b",
                                                "text": "Cet éclat et ces honneurs dont le monde est si jaloux et dont il cherche à repaître si agréablement son orgueil…"
                                            },
                                            {
                                                "example_id": "b9136c26-8507-49c2-b35f-31c63954000e",
                                                "sense_id": "05042a74-2aa1-3c82-adbe-7b2439483c2b",
                                                "text": "[Le maître d’une maison délicieuse] Il n'est plus, il n'en a pas joui si agréablement ni si tranquillement que vous ; il n'y a jamais eu un jour serein…"
                                            },
                                            {
                                                "example_id": "b89c218f-bca3-4a74-a1a5-b4c6e3102a7d",
                                                "sense_id": "05042a74-2aa1-3c82-adbe-7b2439483c2b",
                                                "text": "Cet art de donner agréablement qu’elle avait si bien pratiqué durant sa vie, l’a suivie, je le sais, jusqu’entre les bras de la mort"
                                            },
                                            {
                                                "example_id": "7bc11e55-7344-4c48-9082-3504600b1032",
                                                "sense_id": "05042a74-2aa1-3c82-adbe-7b2439483c2b",
                                                "text": "On hait la médisance, la galanterie grossière : pourvu qu’on la tourne agréablement, on n'en a plus horreur"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e91e15c8-0e25-4b63-9d3e-7a436c989338",
                        "source_entry_id": "ec0e2af1-a27b-3527-88aa-dbc2636bab30",
                        "source_sense_description": "in an agreeable manner",
                        "target_lang_word": "angenehm",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "angenehm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c06d5a7e-7d44-3497-8071-4f90c14209aa",
                                        "entry_id": "fab57712-9438-315d-ae6a-742921c346ed",
                                        "glosses": [
                                            "gefühlsmäßig positiv empfundene Eigenschaft einer Person oder Sache"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7286f218-e828-42fd-82ff-8db0f2eddfbd",
                                                "sense_id": "c06d5a7e-7d44-3497-8071-4f90c14209aa",
                                                "text": "Ist die Temperatur des Wassers so angenehm?"
                                            },
                                            {
                                                "example_id": "9573aaff-e93d-4539-aeab-2b5235cb10b4",
                                                "sense_id": "c06d5a7e-7d44-3497-8071-4f90c14209aa",
                                                "text": "Er ist ein angenehmer Zeitgenosse."
                                            },
                                            {
                                                "example_id": "200c19c9-1f33-4905-b5d7-8bda023e29d8",
                                                "sense_id": "c06d5a7e-7d44-3497-8071-4f90c14209aa",
                                                "text": "Eine Annehmlichkeit ist ein angenehmes Ereignis."
                                            },
                                            {
                                                "example_id": "d439ddeb-7e2d-4426-851a-ca7f40ea1778",
                                                "sense_id": "c06d5a7e-7d44-3497-8071-4f90c14209aa",
                                                "text": "„Seit ich das Extrembergsteigen hinter mir gelassen habe, träume ich nur noch angenehme Träume, auch vom Gehen und Klettern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
