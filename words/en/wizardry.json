{
    "word_family": [
        "wizard",
        "wizardly"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b1f0a23c-722a-3925-aa34-91922b31b98d",
                    "sense_definition": "The practice or art of magic and sorcery.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "magic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient tales describe a world filled with dark <w>wizardry</w> and mysterious creatures.",
                            "target_lang_translations": {
                                "es": "Los relatos antiguos describen un mundo lleno de <w>brujería</w> oscura y criaturas misteriosas."
                            }
                        },
                        {
                            "text": "She practiced the subtle arts of <w>wizardry</w> in secret to protect her village.",
                            "target_lang_translations": {
                                "es": "Ella practicaba las sutiles artes de la <w>hechicería</w> en secreto para proteger a su aldea."
                            }
                        }
                    ],
                    "synonyms": [
                        "sorcery",
                        "magic",
                        "witchcraft"
                    ],
                    "common_phrases": [
                        "acts of wizardry",
                        "dark wizardry"
                    ],
                    "target_lang_definitions": {
                        "es": "Práctica o arte de la magia y la hechicería."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "hechicería",
                                "target_lang_sense_clarification": "arte o práctica mágica"
                            },
                            {
                                "target_lang_word": "brujería",
                                "target_lang_sense_clarification": "práctica de artes mágicas"
                            },
                            {
                                "target_lang_word": "magia",
                                "target_lang_sense_clarification": "fuerza o arte sobrenatural"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3deef9a8-008f-3bdd-a6aa-ebbefc8bd727",
                    "sense_definition": "Exceptional skill, cleverness, or expertise in a particular activity or field.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "skill",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He used his technical <w>wizardry</w> to repair the broken server within minutes.",
                            "target_lang_translations": {
                                "es": "Usó su <w>pericia</w> técnica para reparar el servidor averiado en cuestión de minutos."
                            }
                        },
                        {
                            "text": "Her financial <w>wizardry</w> saved the company from falling into heavy debt.",
                            "target_lang_translations": {
                                "es": "Su <w>magia</w> financiera salvó a la empresa de caer en graves deudas."
                            }
                        }
                    ],
                    "synonyms": [
                        "mastery",
                        "expertise",
                        "brilliance",
                        "virtuosity"
                    ],
                    "common_phrases": [
                        "financial wizardry",
                        "technical wizardry"
                    ],
                    "target_lang_definitions": {
                        "es": "Habilidad, ingenio o pericia excepcional en una actividad o campo determinado."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "maestría",
                                "target_lang_sense_clarification": "gran habilidad o destreza"
                            },
                            {
                                "target_lang_word": "magia",
                                "target_lang_sense_clarification": "habilidad asombrosa en sentido figurado"
                            },
                            {
                                "target_lang_word": "genialidad",
                                "target_lang_sense_clarification": "capacidad o talento extraordinario"
                            },
                            {
                                "target_lang_word": "pericia",
                                "target_lang_sense_clarification": "destreza o conocimiento técnico"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7f672ff6-9afa-3841-9fa4-6964cc7e49d8",
                    "sense_definition": "Remarkably clever or impressive innovation, such as advanced technology, that seems almost magical.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "skill",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Modern smartphones rely on technological <w>wizardry</w> that would have astonished previous generations.",
                            "target_lang_translations": {
                                "es": "Los teléfonos inteligentes modernos dependen de una <w>magia</w> tecnológica que habría asombrado a las generaciones anteriores."
                            }
                        },
                        {
                            "text": "The special effects in the film are a masterpiece of digital <w>wizardry</w>.",
                            "target_lang_translations": {
                                "es": "Los efectos especiales de la película son una obra maestra del <w>prodigio</w> digital."
                            }
                        }
                    ],
                    "synonyms": [
                        "ingenuity"
                    ],
                    "common_phrases": [
                        "technological wizardry",
                        "digital wizardry"
                    ],
                    "target_lang_definitions": {
                        "es": "Innovación notablemente ingeniosa o impresionante, como tecnología avanzada, que parece casi mágica."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "magia",
                                "target_lang_sense_clarification": "prodigio técnico o tecnológico"
                            },
                            {
                                "target_lang_word": "prodigio",
                                "target_lang_sense_clarification": "logro técnico asombroso"
                            },
                            {
                                "target_lang_word": "ingenio",
                                "target_lang_sense_clarification": "capacidad inventiva o tecnológica"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}