                "senses": [
                    {
                        "sense_id": "bbd4099d-0637-3ca1-9818-910c263a4eda",
                        "entry_id": "90d83afc-e42e-379b-8601-7db4619580d2",
                        "glosses": [
                            "Ornament auf Kleidungsstücken in Form eines aufgesetzten Stoffteils"
                        ],
                        "tags": [
                            "Mode"
                        ],
                        "examples": [
                            {
                                "example_id": "fee3a13e-1ae1-4067-b0b3-268d70d8c824",
                                "sense_id": "bbd4099d-0637-3ca1-9818-910c263a4eda",
                                "text": "Die Taschen des Jacketts sind spielerische Extras, die zum Beispiel durch eine Patte, viele sagen dazu auch Klappe, hervorgehoben werden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9c1e1cf9-0446-39a7-8e5b-f80e3e0d892e",
                        "entry_id": "90d83afc-e42e-379b-8601-7db4619580d2",
                        "glosses": [
                            "aus Metall gefertigter Unterschuh"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae42abcd-9f2e-42b3-a140-4ac2ef29934c",
                                "sense_id": "9c1e1cf9-0446-39a7-8e5b-f80e3e0d892e",
                                "text": "In der Türkei wurden ähnliche, aber besonders hohe hölzerne Unterschuhe, die Nalins getragen, um in türkischen Bädern die Füße vor Wasser und der Hitze von mit Hypocausten beheizten Fußböden zu schützen. Anwendung fanden diese Patten auch z.B. beim Putzen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "e34d171f-6c9a-3e9e-ae4a-b95a1bb57aea",
                        "entry_id": "90d83afc-e42e-379b-8601-7db4619580d2",
                        "glosses": [
                            "Pfote eines Tieres"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "7016c4da-a3cb-4e3d-97d2-ac63f9f6eaf3",
                                "sense_id": "e34d171f-6c9a-3e9e-ae4a-b95a1bb57aea",
                                "text": "„Auf einer Seite ist das Bild des Hertzogs gepräget, und auf der andern ein geflügelter Löwe, der in der einen Patte ein bloßes Schwerdt, und in der andern ein Buch hält, …“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "544226ec-c691-3b02-aaf8-33a7a60c9e9e",
                        "entry_id": "90d83afc-e42e-379b-8601-7db4619580d2",
                        "glosses": [
                            "rheinisch, Geld"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "616664e9-9ee8-4e46-8259-38a32e85519b",
                                "sense_id": "544226ec-c691-3b02-aaf8-33a7a60c9e9e",
                                "text": "„Alle machen es für Geld. Sex, malochen, Kinder erziehen. Alles für Geld. Zaster, Flocken, Pinkepinke. Patte, Alter.“"
                            },
                            {
                                "example_id": "ec4e572e-a5b7-4119-8733-5d786585486e",
                                "sense_id": "544226ec-c691-3b02-aaf8-33a7a60c9e9e",
                                "text": "„Pack ich aber erst noch innen Jumpfermann, kapp mich die Patte, un wat reune ich da?“",
                                "translation": "„Da packe ich erst einmal in die Tasche, greif mir das Geld, und was sehe ich da?“"
                            }
                        ],
                        "sense_index_json": "\"4\""
                    },
                    {
                        "sense_id": "d4ac77c0-1149-3751-81b9-ea2bd5b9248b",
                        "entry_id": "90d83afc-e42e-379b-8601-7db4619580d2",
                        "glosses": [
                            "rheinisch, sondersprachlich Masematte: Geldbörse, Portemonnaie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7818291-b4ee-4bd8-96ec-3c7b845895da",
                                "sense_id": "d4ac77c0-1149-3751-81b9-ea2bd5b9248b",
                                "text": "„Penunzen dafür, ja, die hatte / Er gestern noch in seiner Patte.“",
                                "translation": "„Geld dafür, ja das hatte er / gestern noch in seiner Tasche.“"
                            }
                        ],
                        "sense_index_json": "\"5\""
                    }
