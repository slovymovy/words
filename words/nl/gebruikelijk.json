    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b94f5be2-fc65-3a9f-81f9-80efd51b9dfb",
                    "sense_definition": "overeenkomstig de gewoonte of wat men regelmatig doet",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "gewoonte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is in Nederland <w>gebruikelijk</w> om elkaar drie kussen te geven bij een verjaardag.",
                            "target_lang_translations": {
                                "en": "In the Netherlands, it is <w>customary</w> to give each other three kisses on a birthday."
                            }
                        },
                        {
                            "text": "De <w>gebruikelijke</w> gang van zaken is dat we eerst de agenda bespreken.",
                            "target_lang_translations": {
                                "en": "The <w>usual</w> course of events is that we discuss the agenda first."
                            }
                        }
                    ],
                    "synonyms": [
                        "gewoon",
                        "normaal",
                        "gangbaar",
                        "traditioneel"
                    ],
                    "antonyms": [
                        "ongebruikelijk"
                    ],
                    "common_phrases": [
                        "gebruikelijke gang van zaken",
                        "zoals gebruikelijk",
                        "gebruikelijke manier"
                    ],
                    "target_lang_definitions": {
                        "en": "In accordance with custom or what is regularly done"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "usual",
                                "target_lang_sense_clarification": "typical or habitual"
                            },
                            {
                                "target_lang_word": "customary",
                                "target_lang_sense_clarification": "according to local custom or tradition"
                            },
                            {
                                "target_lang_word": "standard",
                                "target_lang_sense_clarification": "the normal or expected procedure"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "29503f67-f847-3e46-869c-16e068314894",
                    "sense_definition": "wat vaak voorkomt of meestal gebeurt",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "frequentie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In sommige culturen is het <w>gebruikelijker</w> om thee te drinken dan koffie bij het ontbijt.",
                            "target_lang_translations": {
                                "en": "In some cultures, it is more <w>common</w> to drink tea than coffee at breakfast."
                            }
                        },
                        {
                            "text": "Het is niet <w>gebruikelijk</w> dat de winkel op zondagavond nog open is.",
                            "target_lang_translations": {
                                "en": "It is not <w>normal</w> for the shop to still be open on Sunday evening."
                            }
                        }
                    ],
