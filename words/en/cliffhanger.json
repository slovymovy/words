    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "00e850f5-f79a-30ee-bd21-35fc5f6ed089",
                    "sense_definition": "An ending or stopping point in a story or show calculated to leave the narrative unresolved in order to create suspense.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "suspenseful_outcome",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The season finale ended on a massive <w>cliffhanger</w>, leaving fans desperately waiting for answers."
                        },
                        {
                            "text": "Every chapter of the novel finishes with a clever <w>cliffhanger</w> to keep the reader hooked."
                        }
                    ],
                    "antonyms": [
                        "anticlimax"
                    ],
                    "common_phrases": [
                        "end on a cliffhanger",
                        "season-ending cliffhanger"
                    ]
                },
                {
                    "sense_id": "9ca2fa99-5c1a-3d35-9631-8b2955d68fa7",
                    "sense_definition": "A contest, situation, or outcome that remains tense and uncertain until the very last moment.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "suspenseful_outcome",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The championship match turned into a real <w>cliffhanger</w> that was decided in the final seconds."
                        },
                        {
                            "text": "Polls showed the presidential election was a true <w>cliffhanger</w> right up to election night."
                        }
                    ],
                    "common_phrases": [
                        "real cliffhanger",
                        "election cliffhanger"
                    ]
                }
            ]
        }
    ]
