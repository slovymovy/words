                    {
                        "sense_id": "abe577a5-694a-3407-bc88-1d7e1b886051",
                        "entry_id": "1c8da28b-1e1d-3625-8056-2e3845a5abc7",
                        "glosses": [
                            "een persoon of boekje dat informatie geeft over een stad"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "2d26c594-6377-4575-ace7-444e5905beff",
                                "sense_id": "abe577a5-694a-3407-bc88-1d7e1b886051",
                                "text": "„Vroeger was ik helemaal niet duurzaam en liet ik alle lampen aanstaan. Nu ben ik er de hele dag mee bezig. Ik vind het belangrijk dat iedereen die geïnteresseerd is in duurzaam leven ook een workshop kan volgen. Daarom ga ik mijn lezingen en workshops aanbieden op basis van donatie, zodat mensen zelf kunnen beslissen wat ze willen geven. Ik ken mensen die werken als stadsgids en adverteren met free tours, dat werkt goed. Mensen geven misschien minder, maar er komt een groter publiek op af.”"
                            }
                        ]
                    }
