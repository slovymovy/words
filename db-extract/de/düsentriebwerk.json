                "senses": [
                    {
                        "sense_id": "92f8e1be-0c2b-3667-bbfa-8f7713c010b7",
                        "entry_id": "8f92c9ad-b61b-307b-954e-4461644d1b84",
                        "glosses": [
                            "Maschine zum Antrieb von Flugzeugen, welche sich dadurch kennzeichnet aus einem verengendem Rohr, das meist dazu dient, die Fließgeschwindigkeit einer Flüssigkeit oder eines Gases zu erhöhen, besteht"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "5db4560b-68aa-4244-accb-e5bbe8249817",
                                "sense_id": "92f8e1be-0c2b-3667-bbfa-8f7713c010b7",
                                "text": "Das Düsentriebwerk funktioniert nicht mehr."
                            },
                            {
                                "example_id": "8a6ea04e-e62d-44e8-9c80-5360915abd79",
                                "sense_id": "92f8e1be-0c2b-3667-bbfa-8f7713c010b7",
                                "text": "„Im Übrigen spukt es hier sehr wohl, sagt Ási und sieht dabei mich direkt an, während der dünne Mundi, der ein Sommerhaus hat und anscheinend Düsentriebwerke verkauft, auf der Fensterbank Platz nimmt und ein schmales Buch aus der Jackentasche zieht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
