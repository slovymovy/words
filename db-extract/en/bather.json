                                    {
                                        "sense_id": "f4281199-c23d-3c2a-8804-803d1914c029",
                                        "entry_id": "c2b6b326-e2fd-31fb-8c9b-f575da367794",
                                        "glosses": [
                                            "Lit en forme de baignoire."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
