                        "examples": [
                            {
                                "example_id": "d24b7e10-a6d3-4b7a-b4e4-35780e9df68c",
                                "sense_id": "bde6086a-ded7-3d4e-8940-2a337503415b",
                                "text": "Le régime flexitariste est un régime à base de végétaux qui n’exclut pas radicalement la viande. Il a été popularisé en 2010 par Dawn Jackson Blatner, une diététicienne américaine, avec la publication du livre « The Flexitarian Diet »."
                            },
                            {
                                "example_id": "473f1f21-d41f-456f-9f41-6254518b3ed9",
                                "sense_id": "bde6086a-ded7-3d4e-8940-2a337503415b",
                                "text": "On estime que 30 % de la population serait flexitariste, parfois même à son insu."
                            },
                            {
                                "example_id": "9b02f00d-3276-4af5-8a5e-056d79617e78",
                                "sense_id": "bde6086a-ded7-3d4e-8940-2a337503415b",
                                "text": "Puisque cette méthode flexitariste préconise de manger le moins possible de plats industriels, elle nécessite alors de faire des courses et de cuisiner davantage, ce qui peut poser problème aux personnes qui disposent de peu de temps."
                            }
                        ]
                    }
                ],
