                "entry_id": "bcaac4d5-2b75-372b-aa1d-f945c7089737",
                "word": "superorganism",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "33fcca70-d10a-4991-a209-89712dc1980f",
                        "entry_id": "bcaac4d5-2b75-372b-aa1d-f945c7089737",
                        "tags": [
                            "plural"
                        ],
                        "form": "superorganisms"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b2c92ee3-48f4-3a0e-8307-505a42b4145d",
                        "entry_id": "bcaac4d5-2b75-372b-aa1d-f945c7089737",
                        "glosses": [
                            "A social colony of individuals who, through division of labour, effective communication and self-organization, form a highly connected community that functions as if it were a single organism."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "acde43e4-0f98-4b1c-bfc6-de770c884eed",
                                "sense_id": "b2c92ee3-48f4-3a0e-8307-505a42b4145d",
                                "text": "A superorganism is an ensemble of living and non-living matter, which acts as a single self-regulating system. […] Gaia is the largest and most complex superorganism we know."
                            },
                            {
                                "example_id": "8bdb137c-467f-47d7-82ce-ab7adbbb1a90",
                                "sense_id": "b2c92ee3-48f4-3a0e-8307-505a42b4145d",
                                "text": "To grasp why Metaman—our strange amalgam of concrete, humans, computer chips, and various plants and animals—is a superorganism rather than merely an elaborate “social grouping” of humans, look at another, far simpler grouping of organisms—a termite colony."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "34397dbe-cfe9-41f3-8535-cf92a80a68dc",
                        "source_entry_id": "bcaac4d5-2b75-372b-aa1d-f945c7089737",
                        "source_sense_id": "b2c92ee3-48f4-3a0e-8307-505a42b4145d",
                        "source_sense_description": "social colony",
                        "target_lang_word": "superorganisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "superorganisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f7bd15aa-bece-3c4a-9d83-89b0300ae1ed",
                                        "entry_id": "942fc869-e05a-3e1e-853b-961c4b249bcf",
                                        "glosses": [
                                            "Organisation sociétale d’un groupe d’individus agissant comme une entité unique avec ses propres lois."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c689c84a-a834-4029-aa89-6302947d4b88",
                                                "sense_id": "f7bd15aa-bece-3c4a-9d83-89b0300ae1ed",
                                                "text": "L’ensemble de la colonie fusionne en un superorganisme qui devient autonome et indivisible, et surtout qui se retrouve au centre de la sélection naturelle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c28d6a0-caff-3bcc-bfec-1a6aa45ec939",
                                        "entry_id": "942fc869-e05a-3e1e-853b-961c4b249bcf",
                                        "glosses": [
                                            "Comportement social dans une société humaine."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e30bc3c-a40c-45ff-972d-e13bcac6f5fd",
                                                "sense_id": "5c28d6a0-caff-3bcc-bfec-1a6aa45ec939",
                                                "text": "[…] le concept de superorganisme nous conduit à jeter un autre regard sur les relations qui s’établissent dans les systèmes sociaux humains ainsi que sur l’évolution de l’homme en tant qu’espèce."
                                            }
                                        ]
                                    }
                                ]
                            }
