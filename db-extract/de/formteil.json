                "senses": [
                    {
                        "sense_id": "df0b5d18-5e3d-3752-be78-f64825f4db88",
                        "entry_id": "785c087c-b00e-32cd-b4d8-68e41b6f693c",
                        "glosses": [
                            "Gegenstand von besonderer Gestalt, dem diese gegeben wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d88ce3b-304e-4220-bec5-be6ab2df2c0a",
                                "sense_id": "df0b5d18-5e3d-3752-be78-f64825f4db88",
                                "text": "„Mit Hilfe von Spritzgießsimulationsprogrammen, können Optimierungspotentiale bei Formteilen und Werkzeugen schnell und effizient schon während der Entwicklungsphase aufgezeigt werden.“"
                            },
                            {
                                "example_id": "13ccb800-779b-4153-a752-85370df79cca",
                                "sense_id": "df0b5d18-5e3d-3752-be78-f64825f4db88",
                                "text": "„Fiberfab fertigt aus Fiberglas Formteile für Auto- Tuning, Modellbau , Boote, komplette Karosserien für Nutzfahrzeuge, Rennsport, Lautsprecherhörner, Radarkuppeln und Interieurteile.“"
                            },
                            {
                                "example_id": "c5196342-58f3-4b86-9c88-986524a13a04",
                                "sense_id": "df0b5d18-5e3d-3752-be78-f64825f4db88",
                                "text": "„Wir fertigen Formteile in unterschiedlichen Größen.“"
                            },
                            {
                                "example_id": "5b871c1c-1693-41e4-8439-7f53591717d6",
                                "sense_id": "df0b5d18-5e3d-3752-be78-f64825f4db88",
                                "text": "„Das Formteil ohne Binder, das allein durch die formschlüssige Verzahnung der Partikel zusammenhält, bezeichnet man auf Grund seines geänderten Aussehens als Braunteil oder Blauteil.“"
                            },
                            {
                                "example_id": "b76fa462-36c5-46c6-8e81-6f8214c89b53",
                                "sense_id": "df0b5d18-5e3d-3752-be78-f64825f4db88",
                                "text": "„Alle Rohre und Formteile sind farblich selbstverständlich aufeinander abgestimmt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
