                "senses": [
                    {
                        "sense_id": "55a0d526-5a07-3e16-aba3-645cc6de9510",
                        "entry_id": "07f56d5d-cbde-3d45-8d1f-44dd7d37f36d",
                        "glosses": [
                            "Verkauf von Waren im Geschäft durch einen Verkäufer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd338afc-132b-4d63-a26f-faf59d0cbe77",
                                "sense_id": "55a0d526-5a07-3e16-aba3-645cc6de9510",
                                "text": "„Inhaltstoffe, die Allergien oder Unverträglichkeiten auslösen können, müssen in Kantinen, Restaurants und beim Thekenverkauf einsehbar sein.“"
                            },
                            {
                                "example_id": "f1b84098-9b9f-4c5d-b1fd-3b1aee988fcd",
                                "sense_id": "55a0d526-5a07-3e16-aba3-645cc6de9510",
                                "text": "„Der Thekenverkauf macht in Metzgereien immer noch 64 Prozent des Umsatzes aus. “"
                            },
                            {
                                "example_id": "4056079d-9771-4d1e-9191-899d9428b473",
                                "sense_id": "55a0d526-5a07-3e16-aba3-645cc6de9510",
                                "text": "„In Schwabing gibt es ein schönes Eiscafé, mit Tischen und Thekenverkauf.“"
                            },
                            {
                                "example_id": "05e5cb70-9315-473d-b654-f471104fcff0",
                                "sense_id": "55a0d526-5a07-3e16-aba3-645cc6de9510",
                                "text": "„Die Besonderheit bestand vor allem auch darin, dass die Bücher in den Regalen, entgegen dem in Russland noch bis Mitte der neunziger Jahre üblichen Thekenverkauf für den Kunden frei zugänglich waren.“"
                            },
                            {
                                "example_id": "b3f97d86-a3ce-4af9-a104-15b36ea89843",
                                "sense_id": "55a0d526-5a07-3e16-aba3-645cc6de9510",
                                "text": "„Seit einem Jahr wechselte sie innerbetrieblich vom Thekenverkauf zur Kasse.“"
                            },
                            {
                                "example_id": "cbb5790a-9c20-4cb8-8f7f-402fef2f4f9f",
                                "sense_id": "55a0d526-5a07-3e16-aba3-645cc6de9510",
                                "text": "„Diese vollzieht sich beim Internet-Handel wie beim Thekenverkauf regelmäßig in Deutschland, da die Verfügungsgewalt auf den Käufer erst mit der Übergabe an den Besteller übergeht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
