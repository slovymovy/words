                    },
                    {
                        "translation_id": "8e196c69-422b-4cfe-abc9-63fb596eee19",
                        "source_entry_id": "c1e4d492-ff56-317c-9747-26578a444dce",
                        "source_sense_description": "person who cultivates",
                        "target_lang_word": "cultivateur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cultivateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c2e264b3-1cc8-361f-95ee-9780ed7d2152",
                                        "entry_id": "cc89de2e-10c7-3e49-95cb-ff3554386b62",
                                        "glosses": [
                                            "Celui qui cultive la terre ou qui exploite une terre, un domaine."
                                        ],
                                        "tags": [
                                            "Métier"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a5513d6-a125-4986-ba0e-e78eab2b2598",
                                                "sense_id": "c2e264b3-1cc8-361f-95ee-9780ed7d2152",
                                                "text": "Si la racine de disette étoit une betterave, les cultivateurs sémeroient-ils si distinctement l’une & l’autre ?"
                                            },
                                            {
                                                "example_id": "7fd3e658-bc77-4af7-9c08-515e07fd1d9e",
                                                "sense_id": "c2e264b3-1cc8-361f-95ee-9780ed7d2152",
                                                "text": "[…] ; ce champignon parasite est réputé une maladie contagieuse par les cultivateurs, et sa persistance dans les champs où il s’est montré une première fois, vient à l’appui de leur croyance."
                                            },
                                            {
                                                "example_id": "ef7c6c64-8bac-44ea-a1a0-f80a34c11f12",
                                                "sense_id": "c2e264b3-1cc8-361f-95ee-9780ed7d2152",
                                                "text": "La chimie agricole est une science appelée à rendre d’immenses services aux cultivateurs. Elle a pour objet l’étude des terrains; […]."
                                            },
                                            {
                                                "example_id": "08073f7b-b840-4abb-a8c2-df5f50c16fbd",
                                                "sense_id": "c2e264b3-1cc8-361f-95ee-9780ed7d2152",
                                                "text": "[…] la plus grande partie des terrains argileux, à sous-sol compacte et humide, du département ont été drainés, et partout les cultivateurs ont eu à se louer de opération."
                                            },
                                            {
                                                "example_id": "66187df8-211a-4287-acfb-ae48b11c695f",
                                                "sense_id": "c2e264b3-1cc8-361f-95ee-9780ed7d2152",
                                                "text": "Grâce à cette mesure protectrice, les petits cultivateurs belges sont assurés de ne pas payer leurs engrais quatre fois ce qu’ils valent, […]"
                                            },
                                            {
                                                "example_id": "7eed031d-d17e-49cb-a0e7-09355115f651",
                                                "sense_id": "c2e264b3-1cc8-361f-95ee-9780ed7d2152",
                                                "text": "Il fallait bien, n’est-ce pas, que tous les cultivateurs de la région contemplassent ces nouveautés."
                                            },
                                            {
                                                "example_id": "9948139e-7f43-433d-9676-6aedead4d026",
                                                "sense_id": "c2e264b3-1cc8-361f-95ee-9780ed7d2152",
                                                "text": "Tout petit, j’avais décidé que je ne serais jamais cultivateur, c’est-à-dire jamais esclave des animaux et des travaux saisonniers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5c00825-2da7-393d-961e-79fb49af2ab8",
                                        "entry_id": "cc89de2e-10c7-3e49-95cb-ff3554386b62",
                                        "glosses": [
                                            "Appareil, doté de dents souples, permettant le travail superficiel du sol."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af34e6b9-b454-4215-ab11-f1e0375afc04",
                                                "sense_id": "b5c00825-2da7-393d-961e-79fb49af2ab8",
                                                "text": "Ceux qui possèdent des charrues polysocs feront avec elles un déchaumage parfait en réglant la profondeur à 5 ou 6 centimètres ; mais avec la houe, l'extirpateur, le cultivateur ou le scarificateur on obtiendra également d’excellents résultats."
                                            },
                                            {
                                                "example_id": "13367ede-c4d7-4938-887a-daa2b3aa0609",
                                                "sense_id": "b5c00825-2da7-393d-961e-79fb49af2ab8",
                                                "text": "Sur les sols légers à moyens, quand les premiers 10 cm du sol sont secs, on recommande deux passages avec le cultivateur-déchaumeur de champs, équipé de pointes du type patte de 25 cm de largeur et jusqu’à 7 à 9 cm de profondeur."
                                            },
                                            {
                                                "example_id": "f057fc70-8b23-4b25-97b1-e6490c0500a9",
                                                "sense_id": "b5c00825-2da7-393d-961e-79fb49af2ab8",
                                                "text": "Sur le cultivateur, les socs sont étroits alors qu’ils sont larges sur les houes, mais, dans la pratique, ces deux équipements sont souvent confondus."
                                            },
                                            {
                                                "example_id": "c91fabb7-e292-4756-b92f-35bffe21dd48",
                                                "sense_id": "b5c00825-2da7-393d-961e-79fb49af2ab8",
                                                "text": "Je l’ai là, dit Ledyard. La merveille dont je vous ai parlé l’autre fois.\nIl écarta la bâche et le soleil éclaira un cultivateur à sept dents, flambant neuf, posé sur chant contre la ridelle."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cultivateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "efc9ce40-c0a2-3de9-b781-514799e8799c",
                                        "entry_id": "84ffe024-d894-342a-8fe9-32714c261cb4",
                                        "glosses": [
                                            "Qui cultive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c886e85-9be0-430d-9cd0-7aad427675ef",
                                                "sense_id": "efc9ce40-c0a2-3de9-b781-514799e8799c",
                                                "text": "Il est à observer qu’un peuple chasseur doit se répandre sur un vaste continent, beaucoup plus vite qu’un peuple cultivateur."
                                            },
                                            {
                                                "example_id": "46bc362d-357d-44cd-b92a-22be9e7cd6cc",
                                                "sense_id": "efc9ce40-c0a2-3de9-b781-514799e8799c",
                                                "text": "[…]: ainsi le propre de cette façon de commercer est de faire baisser nécessairement le prix de ces productions dans l’intérieur de la nation cultivatrice qui en est première propriétaire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
