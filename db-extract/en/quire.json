                                    {
                                        "sense_id": "473acbb8-fb32-3458-ae05-53b73064137e",
                                        "entry_id": "d8f61dd3-1cdd-3333-b7d9-d5bb8a15c02e",
                                        "glosses": [
                                            "een ingebonden bundel bedrukte of beschreven vellen papier"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61a61af4-4fb6-4430-bb27-d2a1d6c158f6",
                                                "sense_id": "473acbb8-fb32-3458-ae05-53b73064137e",
                                                "text": "Als hij wat tijd voor zichzelf had, ging hij bijna altijd een boek lezen."
                                            },
                                            {
                                                "example_id": "a051afed-52c3-49dd-a6a2-15ebfb6a08b4",
                                                "sense_id": "473acbb8-fb32-3458-ae05-53b73064137e",
                                                "text": "' Ik was behoorlijk opgelucht toen ze me dat opdroeg, want meestal als ik aan mensen vertelde dat ik een boek wilde schrijven, reageerden ze door te zeggen dat hun levensverhaal daar bijzonder geschikt voor zou zijn."
                                            },
                                            {
                                                "example_id": "470a4951-9515-45ff-8b0f-fce99208eb43",
                                                "sense_id": "473acbb8-fb32-3458-ae05-53b73064137e",
                                                "text": "' Ze pakte een boek over schilders uit de renaissance en een oude Vogue en gaf ze aan Teresa."
                                            },
                                            {
                                                "example_id": "c21cf2c4-ae40-4680-a9c1-572513e0d880",
                                                "sense_id": "473acbb8-fb32-3458-ae05-53b73064137e",
                                                "text": "Voor haar lag de Vogue die ze van Olive had gekregen, en ze ging ermee om alsof het de eerste druk van een kostbaar boek was."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4ab3681-20d7-3c8b-a8b5-fbe560765b33",
                                        "entry_id": "d8f61dd3-1cdd-3333-b7d9-d5bb8a15c02e",
                                        "glosses": [
                                            "deel van een groter geschrift"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e281f9da-a466-3392-8392-05a8fc753214",
                                        "entry_id": "d8f61dd3-1cdd-3333-b7d9-d5bb8a15c02e",
                                        "glosses": [
                                            "boeken: de administratie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3f7fc22-7c77-4f59-a078-5f16866c404d",
                                                "sense_id": "e281f9da-a466-3392-8392-05a8fc753214",
                                                "text": "Het gestopte slachthuis Hilckmann moet de gemeente Nijmegen inzage geven in de boeken."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "boek",
