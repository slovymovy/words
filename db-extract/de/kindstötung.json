                                        "sense_id": "3dbe5d71-f3cf-3411-b214-9cbf8e3f5f3f",
                                        "entry_id": "acc1f9bb-df61-393b-b556-dd71aece2642",
                                        "glosses": [
                                            "The murder of an infant."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89a1a316-62e2-4d75-ba88-d6fa6347bdaf",
                                                "sense_id": "3dbe5d71-f3cf-3411-b214-9cbf8e3f5f3f",
                                                "text": "PROLICIDE […] Admits of two divisions, fœticide or criminal abortion and infanticide or the destruction of the new born infant."
                                            },
                                            {
                                                "example_id": "7c335d75-5baa-4d82-910d-193101d704e4",
                                                "sense_id": "3dbe5d71-f3cf-3411-b214-9cbf8e3f5f3f",
                                                "text": "A recent government survey shows that 65 per cent of the families in Japan today are nuclear families, and a report on infanticide published this year by the Criminal Sience Club of Chuo University here indicates that eight out of ten infanticides today occur in nuclear families."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "feafdbf5-77b2-3afc-93a5-11db04ee35bf",
                                        "entry_id": "acc1f9bb-df61-393b-b556-dd71aece2642",
                                        "glosses": [
                                            "The murder of a child by a parent; filicide."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "60bdbb9a-16c8-340c-9b40-31ecbeb6aa57",
                                        "entry_id": "acc1f9bb-df61-393b-b556-dd71aece2642",
                                        "glosses": [
                                            "The criminal offence of killing of a newborn, committed by its mother while psychologically disturbed by the effects of childbirth or lactation, not regarded as murder."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b1915450-4255-3b12-b02e-f64f44409310",
                                        "entry_id": "acc1f9bb-df61-393b-b556-dd71aece2642",
                                        "glosses": [
                                            "The killing of a young, immature animal by a mature adult of the same species."
                                        ],
