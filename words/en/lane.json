{
    "word_family": [
        "laneway"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "209c2359-cb28-3d4c-b2af-96067e5da883",
                    "sense_definition": "A lengthwise division of a roadway intended for a single line of vehicles.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "designated_strip",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should check your mirrors carefully before you change <w>lanes</w> on the highway.",
                            "target_lang_translations": {
                                "ru": "Вам следует внимательно проверить зеркала, прежде чем менять <w>полосу</w> на шоссе.",
                                "zh": "在高速公路上变换<w>车道</w>前，你应该仔细检查后视镜。"
                            }
                        },
                        {
                            "text": "The bus <w>lane</w> is reserved for public transport during peak traffic hours.",
                            "target_lang_translations": {
                                "ru": "Автобусная <w>полоса</w> зарезервирована для общественного транспорта в часы пик.",
                                "zh": "高峰时段，公交<w>车道</w>仅供公共交通工具使用。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "bus lane",
                        "bike lane",
                        "fast lane",
                        "change lanes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Продольная часть проезжей части, предназначенная для движения одного ряда транспортных средств.",
                        "zh": "道路上用于车辆单行行驶的纵向划分区域。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "полоса",
                                "target_lang_sense_clarification": "движения"
                            },
                            {
                                "target_lang_word": "ряд",
                                "target_lang_sense_clarification": "автомобильный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "车道",
                                "target_lang_sense_clarification": "交通道路"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "68b47c6c-70f0-39ee-bee0-493b8d5de34d",
                    "sense_definition": "A narrow road or path, often found in the countryside or between walls and hedges.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "narrow_road",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We took a long walk down a quiet country <w>lane</w> near the farm.",
                            "target_lang_translations": {
                                "ru": "Мы долго гуляли по тихой просёлочной <w>дороге</w> возле фермы.",
                                "zh": "我们在农场附近一条安静的乡间<w>小路</w>上走了很久。"
                            }
                        },
                        {
                            "text": "The delivery truck was too wide to fit through the narrow <w>lane</w>.",
                            "target_lang_translations": {
                                "ru": "Грузовик доставки был слишком широким, чтобы проехать по узкому <w>переулку</w>.",
                                "zh": "送货卡车太宽了，无法通过那条狭窄的<w>小巷</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "path",
                        "track"
                    ],
                    "common_phrases": [
                        "country lane",
                        "narrow lane"
                    ],
                    "target_lang_definitions": {
                        "ru": "Узкая дорога или тропинка, часто встречающаяся в сельской местности или между стенами и живыми изгородями.",
                        "zh": "狭窄的道路或小径，常见于乡村或墙壁与树篱之间。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "переулок",
                                "target_lang_sense_clarification": "узкая улица"
                            },
                            {
                                "target_lang_word": "дорожка",
                                "target_lang_sense_clarification": "тропинка"
                            },
                            {
                                "target_lang_word": "улочка",
                                "target_lang_sense_clarification": "маленькая улица"
                            },
                            {
                                "target_lang_word": "аллея",
                                "target_lang_sense_clarification": "в парке или саду"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "小巷",
                                "target_lang_sense_clarification": "狭窄的街道"
                            },
                            {
                                "target_lang_word": "乡间小路",
                                "target_lang_sense_clarification": "乡村道路"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a7806fe0-1f36-3791-b044-786ae6fedbb7",
                    "sense_definition": "A marked division of a racetrack or swimming pool assigned to a specific competitor.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "designated_strip",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The swimmer in the fourth <w>lane</w> is currently in the lead.",
                            "target_lang_translations": {
                                "ru": "Пловец на четвёртой <w>дорожке</w> сейчас лидирует.",
                                "zh": "第四<w>泳道</w>的选手目前处于领先位置。"
                            }
                        },
                        {
                            "text": "Athletes must stay in their assigned <w>lanes</w> throughout the entire race.",
                            "target_lang_translations": {
                                "ru": "Спортсмены должны оставаться на своих <w>дорожках</w> на протяжении всей гонки.",
                                "zh": "运动员在整场比赛中必须保持在各自的<w>赛道</w>内。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "swimming lane"
                    ],
                    "target_lang_definitions": {
                        "ru": "Размеченная часть беговой дорожки или бассейна, закрепленная за конкретным участником соревнования.",
                        "zh": "赛道或游泳池中分配给特定参赛者的划定区域。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дорожка",
                                "target_lang_sense_clarification": "беговая или в бассейне"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "泳道",
                                "target_lang_sense_clarification": "游泳池"
                            },
                            {
                                "target_lang_word": "赛道",
                                "target_lang_sense_clarification": "田径比赛"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dd5802cf-cf9d-321d-87c3-5a8966e4dd36",
                    "sense_definition": "A designated route for ships or aircraft, or a passage for people waiting in a line.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "designated_strip",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I waited in the express <w>lane</w> because I only had a few items to buy.",
                            "target_lang_translations": {
                                "ru": "Я ждал на экспресс-<w>кассе</w>, потому что мне нужно было купить всего несколько вещей.",
                                "zh": "我在快速<w>通道</w>排队，因为我只买了几样东西。"
                            }
                        },
                        {
                            "text": "Large cargo ships must travel within the designated shipping <w>lanes</w> to avoid accidents.",
                            "target_lang_translations": {
                                "ru": "Крупные грузовые суда должны двигаться в пределах установленных судоходных <w>путей</w>, чтобы избежать аварий.",
                                "zh": "大型货船必须在指定的航运<w>航道</w>内行驶，以避免事故。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "shipping lane",
                        "checkout lane",
                        "express lane"
                    ],
                    "target_lang_definitions": {
                        "ru": "Установленный маршрут для судов или самолетов, либо проход для людей, стоящих в очереди.",
                        "zh": "为船舶或飞机指定的航线，或供排队人群行进的通道。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "путь",
                                "target_lang_sense_clarification": "маршрут следования"
                            },
                            {
                                "target_lang_word": "трасса",
                                "target_lang_sense_clarification": "воздушная или морская"
                            },
                            {
                                "target_lang_word": "проход",
                                "target_lang_sense_clarification": "между рядами"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "航道",
                                "target_lang_sense_clarification": "水上或空中路线"
                            },
                            {
                                "target_lang_word": "通道",
                                "target_lang_sense_clarification": "排队区域"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9220ce27-8a9e-3c27-b09e-1c2788ac48f5",
                    "sense_definition": "An elongated wooden strip of floor along which a bowling ball is rolled.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "designated_strip",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We booked two <w>lanes</w> at the bowling alley for my birthday party.",
                            "target_lang_translations": {
                                "ru": "Мы забронировали две <w>дорожки</w> в боулинге на мой день рождения.",
                                "zh": "我们为我的生日派对在保龄球馆预订了两条<w>球道</w>。"
                            }
                        },
                        {
                            "text": "The ball rolled slowly down the <w>lane</w> and missed all the pins.",
                            "target_lang_translations": {
                                "ru": "Шар медленно катился по <w>дорожке</w> и не сбил ни одной кегли.",
                                "zh": "球沿着<w>球道</w>缓慢滚动，结果一个瓶子也没撞倒。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "bowling lane"
                    ],
                    "target_lang_definitions": {
                        "ru": "Длинная деревянная полоса пола, по которой катят шар для боулинга.",
                        "zh": "保龄球馆中供滚球的长条形木质地板区域。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дорожка",
                                "target_lang_sense_clarification": "для боулинга"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "球道",
                                "target_lang_sense_clarification": "保龄球"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ca9717fe-17f4-3297-b131-991e0ff5048c",
                    "sense_definition": "A particular path on a game map that characters traverse to attack the enemy base.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "designated_strip",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team decided to push the bottom <w>lane</w> to distract the opponents.",
                            "target_lang_translations": {
                                "ru": "Команда решила пропушить нижнюю <w>линию</w>, чтобы отвлечь противников.",
                                "zh": "团队决定推进下<w>路</w>以分散对手的注意力。"
                            }
                        },
                        {
                            "text": "You need to defend your <w>lane</w> carefully to prevent the enemy from advancing.",
                            "target_lang_translations": {
                                "ru": "Тебе нужно тщательно защищать свою <w>линию</w>, чтобы не дать врагу продвинуться.",
                                "zh": "你需要小心防守你的那条<w>路</w>，以阻止敌人推进。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "video games"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Определенный путь на игровой карте, по которому персонажи перемещаются для атаки вражеской базы.",
                        "zh": "游戏地图中角色为攻击敌方基地而行进的特定路径。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "линия",
                                "target_lang_sense_clarification": "в компьютерных играх"
                            },
                            {
                                "target_lang_word": "лейн",
                                "target_lang_sense_clarification": "игровой сленг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "路",
                                "target_lang_sense_clarification": "电子游戏术语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "9269fbef-21a7-326c-b7c4-b9b1d4f03c76",
                    "sense_definition": "A surname of English or Irish origin.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "name_group",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Lane</w> has been our neighbor for over twenty years.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Лейн</w> был нашим соседом более двадцати лет.",
                                "zh": "<w>莱恩</w>先生做我们的邻居已经二十多年了。"
                            }
                        },
                        {
                            "text": "The history book mentioned a general named <w>Lane</w> who served in the war.",
                            "target_lang_translations": {
                                "ru": "В учебнике истории упоминался генерал по фамилии <w>Лейн</w>, который служил на войне.",
                                "zh": "历史书里提到了一位名叫<w>莱恩</w>的将军，他曾参加过那场战争。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия английского или ирландского происхождения.",
                        "zh": "源自英国或爱尔兰的姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Лейн",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "莱恩",
                                "target_lang_sense_clarification": "姓氏"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "661614ff-6e0f-3972-9f48-a78a79dcaeb3",
                    "sense_definition": "A male or female given name.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "name_group",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "My friend <w>Lane</w> is coming over for dinner tonight.",
                            "target_lang_translations": {
                                "ru": "Мой друг <w>Лейн</w> придет сегодня на ужин.",
                                "zh": "我的朋友<w>莱恩</w>今晚要来吃晚饭。"
                            }
                        },
                        {
                            "text": "They decided to name their new baby daughter <w>Lane</w>.",
                            "target_lang_translations": {
                                "ru": "Они решили назвать свою новорожденную дочь <w>Лейн</w>.",
                                "zh": "他们决定给刚出生的女儿取名为<w>莱恩</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мужское или женское имя.",
                        "zh": "男性或女性的名字。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Лейн",
                                "target_lang_sense_clarification": "имя"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "莱恩",
                                "target_lang_sense_clarification": "名字"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7ec4f424-076e-3eeb-9f8b-bfc504a11462",
                    "sense_definition": "A name used for various places in the United States and England.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "name_group",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "He grew up in a small town called <w>Lane</w> in South Carolina.",
                            "target_lang_translations": {
                                "ru": "Он вырос в маленьком городке под названием <w>Лейн</w> в Южной Каролине.",
                                "zh": "他在南卡罗来纳州一个叫<w>莱恩</w>的小镇长大。"
                            }
                        },
                        {
                            "text": "The map shows a hamlet named <w>Lane</w> in the English countryside.",
                            "target_lang_translations": {
                                "ru": "На карте показана деревушка под названием <w>Лейн</w> в английской сельской местности.",
                                "zh": "地图上显示在英国乡村有一个叫<w>莱恩</w>的小村庄。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Название, используемое для различных географических мест в США и Англии.",
                        "zh": "美国和英国各地地名的统称。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Лейн",
                                "target_lang_sense_clarification": "топоним"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "莱恩",
                                "target_lang_sense_clarification": "地名"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}