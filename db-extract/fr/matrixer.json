                ],
                "senses": [
                    {
                        "sense_id": "6ed0d6e8-35d6-3921-a569-c6c406e01387",
                        "entry_id": "2a92e3ad-3874-37ca-afb5-34484522322d",
                        "glosses": [
                            "Duper, tromper."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "44242eaa-966f-4f3c-b3b0-5e65737b5c7c",
                                "sense_id": "6ed0d6e8-35d6-3921-a569-c6c406e01387",
                                "text": "Cette raideur était le lot de ceux qui ne se laissaient pas matrixer et parvenaient à s’arracher au plan organique de l’irréalité."
                            },
                            {
                                "example_id": "04edfa27-829a-4486-9c54-a3f5700a7aea",
                                "sense_id": "6ed0d6e8-35d6-3921-a569-c6c406e01387",
                                "text": "Y a quelques semaines ils expliquaient comment ils arrivent à matrixer leurs élèves."
                            }
                        ]
                    },
                    {
                        "sense_id": "78751193-ccc7-3769-bffd-2820d0e12699",
                        "entry_id": "2a92e3ad-3874-37ca-afb5-34484522322d",
                        "glosses": [
                            "Prendre une emprise totale sur quelqu’un, sans qu’il s’en rende compte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b94de54b-b30f-43b6-864a-d7bbbfd9f241",
                                "sense_id": "78751193-ccc7-3769-bffd-2820d0e12699",
                                "text": "Leur inconscient est vérolé : ce sont des caméras et micros de surveillance ambulants, des mouchards contrôlés par des genres d’« agents Smith » de la matrice programmés pour décapiter ceux qu’ils ne peuvent convertir, matrixer, annihiler ; des hôtes administrés par des symbiotes ou subsistances parasites. (sic)"
                            },
                            {
                                "example_id": "390935e1-73f2-4b72-9d9c-441a8f83b655",
                                "sense_id": "78751193-ccc7-3769-bffd-2820d0e12699",
                                "text": "Les pandas sont \"matrixés\" par les bambous qu'ils mangent, au point qu'ils développent de nouveaux instincts"
                            }
                        ]
                    }
