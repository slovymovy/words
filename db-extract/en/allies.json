                                        "entry_id": "c063b192-7610-3390-9fb4-5838e0675d6f",
                                        "glosses": [
                                            "Ensemble des États-Unis, de l’Union soviétique, du Royaume-Uni et des autres pays qui s’opposèrent formellement aux forces de l’Axe durant la Seconde Guerre mondiale."
                                        ],
                                        "tags": [
                                            "Relations internationales"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ba30894-47c4-4849-88e4-b7df5b7af055",
                                                "sense_id": "34b6f8d2-2128-3723-a3ba-ef20c9ae6f74",
                                                "text": "L’avance des Alliés est très rapide, ils n’ont pas le temps d’emmener, ils fusillent."
                                            },
                                            {
                                                "example_id": "57abb38c-f4f7-4f55-86d0-106dc9bc10c6",
                                                "sense_id": "34b6f8d2-2128-3723-a3ba-ef20c9ae6f74",
                                                "text": "Fraîchement réinvesti, Emmanuel Macron a commémoré, dimanche à Paris, la victoire du 8 mai 1945 des Alliés sur l’Allemagne nazie."
                                            }
                                        ]
                                    },
