                ],
                "senses": [
                    {
                        "sense_id": "a6ea3c55-da3c-3c81-a669-b175fbd507a8",
                        "entry_id": "cfd5c8de-cf7a-3ab2-b2b3-601dd5b47d9f",
                        "glosses": [
                            "Qui prend l’apparence d’un buisson, d’une boule touffue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c4870e6-32db-4869-9fd6-66f783b51829",
                                "sense_id": "a6ea3c55-da3c-3c81-a669-b175fbd507a8",
                                "text": "Arbuste à port érigé, buissonnant, très ramifié, s’étalant avec une belle ampleur en vieillissant."
                            },
                            {
                                "example_id": "caff38a7-35da-4ad4-86db-289801568865",
                                "sense_id": "a6ea3c55-da3c-3c81-a669-b175fbd507a8",
                                "text": "Un cours d’eau comme la Marne ne peut se passer d’une végétation arborescente et buissonnante. Les racines soutiennent et consolident la terre. C’est le moyen le plus efficace de lutter contre l’érosion."
                            }
                        ]
                    },
                    {
                        "sense_id": "a5bbd278-7eec-3962-8794-373d5fcbfa50",
                        "entry_id": "cfd5c8de-cf7a-3ab2-b2b3-601dd5b47d9f",
                        "glosses": [
                            "Ramifié comme un buisson."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "98b1b516-73bd-400a-b059-1abc4bc584d9",
                                "sense_id": "a5bbd278-7eec-3962-8794-373d5fcbfa50",
                                "text": "Toujours est-il que l’on aurait là une preuve de plus que l’évolution humaine était particulièrement buissonnante et que de nombreuses espèces d’hominines ont cohabité."
                            }
                        ]
                    }
