                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82daad73-98a1-404c-a90a-f5e837fdc07b",
                                "sense_id": "a32a1e22-7581-332e-b042-8be83c4b20ab",
                                "text": "Bien dans le collier, ramenant sa tête fine sur son poitrail trapu, et tirant de toutes ses forces, la ponnette montait gaillardement la dure et longue côte."
                            },
                            {
                                "example_id": "81529063-9e53-48cb-a0ac-71ad00ad68ab",
                                "sense_id": "a32a1e22-7581-332e-b042-8be83c4b20ab",
                                "text": "Les petites détenaient déjà de fortes jambes et une croupe basse et large qui ne changeraient plus. Deux ponnettes déjà équipées et qui trompaient leur faim sur les enfants des laveuses et des femmes de journée."
                            }
                        ]
                    }
