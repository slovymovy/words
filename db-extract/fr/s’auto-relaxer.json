                ],
                "senses": [
                    {
                        "sense_id": "c1bc8a8e-6754-3f1d-8859-f8055d2f3754",
                        "entry_id": "0afe8879-7cfc-3a14-b2c8-003b5c5c4ee9",
                        "glosses": [
                            "Se relaxer tout seul, sans intervention extérieure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13d0c79d-2697-4503-ae63-8aee8902093e",
                                "sense_id": "c1bc8a8e-6754-3f1d-8859-f8055d2f3754",
                                "text": "Tous les soirs, s'auto-relaxer au moins 10 minutes, permet d'évacuer les tensions, se vider la tête, apaiser le mental."
                            },
                            {
                                "example_id": "65450f61-8e1e-4e8b-b2bf-502ec074defa",
                                "sense_id": "c1bc8a8e-6754-3f1d-8859-f8055d2f3754",
                                "text": "Apprendre des moyens de s'auto-relaxer en situation de tension."
                            },
                            {
                                "example_id": "20a5bb9d-754f-4e84-abfc-457231f80bb8",
                                "sense_id": "c1bc8a8e-6754-3f1d-8859-f8055d2f3754",
                                "text": "Surtout, j'ai bien compris qu'un fois la période d'apprentissage passée, c'est la personne elle même qui s'auto-relaxe si j'ose dire, en utilisant pour elle même la respiration abdominale, la suggestion, la visualisation, l'appréciation des sensations...puis elle se concentre progressivement sur chaque partie de son corps, en apprécie la pesanteur, la chaleur, rythme cardiaque."
                            }
                        ]
                    }
