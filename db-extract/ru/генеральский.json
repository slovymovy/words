                ],
                "senses": [
                    {
                        "sense_id": "fca3e126-bc86-33c4-acf7-e83b4eb7770f",
                        "entry_id": "ccc5ece1-1418-34fd-9226-56043f3f4ddd",
                        "glosses": [
                            "прил. к генерал"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db6d05aa-6e2c-4885-bc23-98cd48b93b1e",
                                "sense_id": "fca3e126-bc86-33c4-acf7-e83b4eb7770f",
                                "text": "Этот генерал, один из самых осанистых членов нашего клуба, помещик не очень богатый, но с бесподобнейшим образом мыслей, старомодный волокита за барышнями, чрезвычайно любил, между прочим, в больших собраниях заговаривать вслух, с генеральскою вескостью, именно о том, о чём всё ещё говорили осторожным шёпотом."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7e24ba0f-acc2-4716-bc99-d1b42f8858af",
                        "source_entry_id": "ccc5ece1-1418-34fd-9226-56043f3f4ddd",
                        "source_sense_id": "fca3e126-bc86-33c4-acf7-e83b4eb7770f",
                        "target_lang_word": "generalski",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "generalski",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "08b5f08d-19d0-34bc-be85-8fbc9df0ddc6",
                                        "entry_id": "4a5ab5c2-1a3b-3674-a978-f3f41c69d3eb",
                                        "glosses": [
                                            "związany z generałem, dotyczący generała"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9156c704-4271-4589-8c5e-a33da4bd790f",
                                                "sense_id": "08b5f08d-19d0-34bc-be85-8fbc9df0ddc6",
                                                "text": "Po 1989 roku wiele osób zmieniało przekonania jak rękawiczki, ale korpus generalski bił tu wszelkie rekordy"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "generalski",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "9ab379f7-ff94-32a0-9b3f-ec9e3d6e9075",
                                        "entry_id": "ffabd29b-3735-367a-bf52-f1c368fe7b8d",
                                        "glosses": [
                                            "taki, który należy do generała, będący jego własnością"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35619fcd-9c71-4e5a-bc2f-b925550d981e",
                                                "sense_id": "9ab379f7-ff94-32a0-9b3f-ec9e3d6e9075",
                                                "text": "Głównodowodzący admirał przekazał okręt flagowy na kwaterę generała, na pokład wniesiono bagaże, a na banderę wciągnięto generalski sztandar"
                                            }
                                        ],
                                        "sense_index_json": "\"2.1\""
                                    }
                                ]
                            }
                        ]
                    }
