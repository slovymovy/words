                "senses": [
                    {
                        "sense_id": "ca5b7a34-f71b-370b-8b60-c943ec8711d6",
                        "entry_id": "0c531644-08a9-3bb6-ad1d-1809a2d527b1",
                        "glosses": [
                            "Rendre un objet qui avait été balluchonné, pour le rendre à nouveau utilisable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98970fe1-d05e-456f-a3a0-833da71996e5",
                                "sense_id": "ca5b7a34-f71b-370b-8b60-c943ec8711d6",
                                "text": "Attention: Pensez à débaluchonner vos objets en mithril, car le forgeron ne les prendra pas."
                            },
                            {
                                "example_id": "90b97280-c038-4b2d-8ea0-cd85fff1663c",
                                "sense_id": "ca5b7a34-f71b-370b-8b60-c943ec8711d6",
                                "text": "Depuis des heures, il débaluchonne ses plus beaux parchemins et les met à l'abri."
                            },
                            {
                                "example_id": "8ace0171-a400-4fdb-bac8-2d832faa349e",
                                "sense_id": "ca5b7a34-f71b-370b-8b60-c943ec8711d6",
                                "text": "En plus, bonjour la pompe à Px... une bidouille qui vaut rien et c'est parti... je baluchonne, je débaluchonne, je baluchonne, je débaluchonne..."
                            }
                        ]
