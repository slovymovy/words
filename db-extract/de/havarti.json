                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81d4665e-6cd8-40e8-88e7-41ada2b67b3c",
                                                "sense_id": "62cca129-d54c-3f18-91a2-f9258751817c",
                                                "text": "Blues, cheddars and related goudas and havartis play a big part but there’s still room for newcomers like the Italian Defendi Cremosa (creamy gorgonzola-style) and there are even more English varieties springing up."
                                            },
                                            {
                                                "example_id": "cb98bf4b-8ddb-454d-a896-ca069689c5d7",
                                                "sense_id": "62cca129-d54c-3f18-91a2-f9258751817c",
                                                "text": "In less than a minute, you can get one of Mets fan Josh Capon’s famous pressed sandwiches, including his sourdough grilled cheese, broccoli rabe with havarti, or bacon and tomato marmalade."
                                            },
                                            {
                                                "example_id": "ec5da259-ed8e-41e2-b4af-6bee367b63a9",
                                                "sense_id": "62cca129-d54c-3f18-91a2-f9258751817c",
                                                "text": "And you can’t go wrong with the griddled cheese sandwich made with havarti, muenster, and cheddar on sourdough."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
