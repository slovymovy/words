                    "semantic_group_id": "accord",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le négociateur a fait preuve d'un remarquable esprit de <w>conciliation</w> lors des pourparlers."
                        },
                        {
                            "text": "Après des semaines de tensions, une <w>conciliation</w> a finalement été trouvée entre les deux partis."
                        }
                    ],
