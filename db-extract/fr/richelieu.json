            {
                "entry_id": "1b51cb45-3d49-3ca5-8ac3-6f64a2b7c384",
                "word": "Richelieu",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "161f90c0-f83d-3be9-aabe-3637f8771867",
                        "entry_id": "1b51cb45-3d49-3ca5-8ac3-6f64a2b7c384",
                        "glosses": [
                            "Commune française, située dans le département d’Indre-et-Loire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad9e7292-3583-48db-b8e8-1b2fe41de932",
                                "sense_id": "161f90c0-f83d-3be9-aabe-3637f8771867",
                                "text": "J’ai éprouvé la même extase, il y a une trentaine d’années, à Richelieu, autre ville nouvelle édifiée exactement un siècle plus tard par le ministre-cardinal."
                            }
                        ]
                    },
                    {
                        "sense_id": "8adb2cd5-1116-319b-9dcf-4e633fe49fe2",
                        "entry_id": "1b51cb45-3d49-3ca5-8ac3-6f64a2b7c384",
                        "glosses": [
                            "Affluent du Saint-Laurent, prenant sa source dans le lac Champlain et se rendant jusqu'à Sorel."
                        ],
                        "tags": [
                            "Cours d’eau"
                        ],
                        "examples": [
                            {
                                "example_id": "861901d2-f0b7-434d-a00b-ee55e97e7dca",
                                "sense_id": "8adb2cd5-1116-319b-9dcf-4e633fe49fe2",
                                "text": "La région du Richelieu, baptisée « le grenier du Bas-Canada », illustrait le modèle de société rurale que souhaitait développer une certaine élite canadienne-française."
                            }
                        ]
                    },
                    {
                        "sense_id": "4a97bcff-1a4f-33c4-8936-c1d25b552fd1",
                        "entry_id": "1b51cb45-3d49-3ca5-8ac3-6f64a2b7c384",
                        "glosses": [
                            "Ville canadienne du Québec située dans la MRC de Rouville."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "2551fd84-b4f4-3521-8ccc-a1266cd6affa",
                        "entry_id": "1b51cb45-3d49-3ca5-8ac3-6f64a2b7c384",
                        "glosses": [
                            "Ancien nom de la commune de Ahmed Rachedi dans la wilaya de Mila en Algérie."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
