{
    "word_family": [
        "einde",
        "eindig",
        "oneindig",
        "beëindigen",
        "eindpunt",
        "eindresultaat"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4d6fa82a-22a2-336c-a559-abe9a6df0368",
                    "sense_definition": "tot een afsluiting komen of een laatste fase bereiken",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "beëindiging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De film zal over tien minuten <w>eindigen</w>.",
                            "target_lang_translations": {
                                "en": "The movie will <w>end</w> in ten minutes.",
                                "ru": "Фильм <w>закончится</w> через десять минут."
                            }
                        },
                        {
                            "text": "De spannende wedstrijd <w>eindigde</w> in een gelijkspel.",
                            "target_lang_translations": {
                                "en": "The exciting match <w>ended</w> in a draw.",
                                "ru": "Напряженный матч <w>завершился</w> вничью."
                            }
                        }
                    ],
                    "synonyms": [
                        "stoppen",
                        "ophouden"
                    ],
                    "antonyms": [
                        "beginnen",
                        "starten"
                    ],
                    "common_phrases": [
                        "eindigen in",
                        "eindigen met"
                    ],
                    "target_lang_definitions": {
                        "en": "To come to a conclusion or reach a final stage.",
                        "ru": "Прийти к завершению или достичь финальной стадии."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "end",
                                "target_lang_sense_clarification": "to come to a stop or conclusion"
                            },
                            {
                                "target_lang_word": "finish",
                                "target_lang_sense_clarification": "to reach the end of a duration or event"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "заканчиваться",
                                "target_lang_sense_clarification": "о событиях, фильмах, процессах"
                            },
                            {
                                "target_lang_word": "завершаться",
                                "target_lang_sense_clarification": "официальное или окончательное завершение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "af665305-e708-3502-82e4-86b2b1406c6c",
                    "sense_definition": "een bepaalde positie of resultaat behalen aan het slot van een proces of wedstrijd",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "resultaat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De Nederlandse zanger <w>eindigde</w> als derde bij de vakjury.",
                            "target_lang_translations": {
                                "en": "The Dutch singer <w>finished</w> third with the professional jury.",
                                "ru": "Голландский певец <w>занял</w> третье место по мнению профессионального жюри."
                            }
                        },
                        {
                            "text": "Hij <w>eindigde</w> met een verzoek om de eenheid te bewaren.",
                            "target_lang_translations": {
                                "en": "He <w>ended</w> with a request to preserve unity.",
                                "ru": "Он <w>закончил</w> просьбой сохранить единство."
                            }
                        }
                    ],
                    "common_phrases": [
                        "als derde eindigen",
                        "eindigen als"
                    ],
                    "target_lang_definitions": {
                        "en": "To achieve a specific position or result at the end of a process or competition.",
                        "ru": "Занять определенное место или получить результат в конце процесса или соревнования."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "end up",
                                "target_lang_sense_clarification": "to reach a final state or position"
                            },
                            {
                                "target_lang_word": "finish",
                                "target_lang_sense_clarification": "to complete a race or competition in a certain rank"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "занять место",
                                "target_lang_sense_clarification": "в соревновании или рейтинге"
                            },
                            {
                                "target_lang_word": "закончить",
                                "target_lang_sense_clarification": "с определенным результатом или действием"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ace4d0d9-cd62-3cd3-b60c-84af713a6712",
                    "sense_definition": "een activiteit of loopbaan definitief afsluiten",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "beëindiging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>eindigde</w> zijn wielercarrière op dertigjarige leeftijd.",
                            "target_lang_translations": {
                                "en": "He <w>ended</w> his cycling career at the age of thirty.",
                                "ru": "Он <w>завершил</w> свою карьеру велогонщика в возрасте тридцати лет."
                            }
                        },
                        {
                            "text": "De ontmoeting <w>eindigde</w> met een stevige omhelzing na het gesprek.",
                            "target_lang_translations": {
                                "en": "The meeting <w>ended</w> with a firm hug after the conversation.",
                                "ru": "Встреча <w>закончилась</w> крепким объятием после разговора."
                            }
                        }
                    ],
                    "synonyms": [
                        "stoppen",
                        "afsluiten",
                        "beëindigen"
                    ],
                    "antonyms": [
                        "beginnen"
                    ],
                    "common_phrases": [
                        "carrière eindigen"
                    ],
                    "target_lang_definitions": {
                        "en": "To definitively conclude an activity or career.",
                        "ru": "Окончательно завершить деятельность или карьеру."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "end",
                                "target_lang_sense_clarification": "to bring something to a final close"
                            },
                            {
                                "target_lang_word": "finish",
                                "target_lang_sense_clarification": "to complete or put an end to a career or task"
                            },
                            {
                                "target_lang_word": "terminate",
                                "target_lang_sense_clarification": "to formally bring to an end"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "завершить",
                                "target_lang_sense_clarification": "карьеру или официальную встречу"
                            },
                            {
                                "target_lang_word": "закончить",
                                "target_lang_sense_clarification": "деятельность или этап жизни"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}