                                        "entry_id": "6bc7e20d-7d41-313b-b543-d8d27744f005",
                                        "glosses": [
                                            "Not content; discontented; dissatisfied."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35e87eaa-954c-4b64-b1a1-7bb003a5bb86",
                                                "sense_id": "53d41d5c-0ec0-30e8-a584-fb5246e46815",
                                                "text": "[...] Paſſion seemed to be much diſcontent, but Patience was very quiet. Then Chriſtian aſked, What is the reaſon of the diſcontent of Paſſion."
                                            }
                                        ]
