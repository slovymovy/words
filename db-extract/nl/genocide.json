                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "91dc621f-c4b0-408b-98a0-6b21dde2468a",
                        "entry_id": "ffcbe268-3e23-3e5f-9b40-4370b9de4f39",
                        "tags": [
                            "plural"
                        ],
                        "form": "genociden"
                    },
                    {
                        "form_id": "f969079d-f8e5-41bd-b8a8-457208134ff5",
                        "entry_id": "ffcbe268-3e23-3e5f-9b40-4370b9de4f39",
                        "tags": [
                            "plural"
                        ],
                        "form": "genocides"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0d33073b-3404-3aa0-a93c-4ec0f7fbca28",
                        "entry_id": "ffcbe268-3e23-3e5f-9b40-4370b9de4f39",
                        "glosses": [
                            "stelselmatige vernietiging van een volk"
                        ],
                        "tags": [
                            "misdaad"
                        ],
                        "examples": [
                            {
                                "example_id": "4147db3f-f862-4beb-a1a2-0d2c4a77c90c",
                                "sense_id": "0d33073b-3404-3aa0-a93c-4ec0f7fbca28",
                                "text": "Bizimana wordt ervan beschuldigd als hoogste bevelhebber een belangrijke rol te hebben gespeeld in de genocide in Rwanda, die in 1994 het leven kostte aan 800.000 Rwandese Tutsi’s en gematigde Hutu’s."
                            },
                            {
                                "example_id": "891f896d-0ca9-444e-858c-692b5d98247b",
                                "sense_id": "0d33073b-3404-3aa0-a93c-4ec0f7fbca28",
                                "text": "In het eerste deel worden in algemeene trekken de onderwerpen : bestuur, politie, wetgeving, rechtbanken, eigendommen, financiën, arbeidskrachten en wat Lemkin noemt ,\"genocide\", waarvan hij als verklaring geeft: de vernietiging van een land of van een ethnologische groep behandeld"
                            },
                            {
                                "example_id": "e96a495e-e249-45fd-acd1-d9f38193d7d0",
                                "sense_id": "0d33073b-3404-3aa0-a93c-4ec0f7fbca28",
                                "text": "De Chinese ambassade in Nederland verzet zich in een verklaring die op 18 april 2021 is uitgegeven tegen de beschuldiging dat in de Oeigoerse regio genocide wordt gepleegd en spreekt van een \"desinformatiecampagne\"."
                            }
                        ]
                    },
                    {
                        "sense_id": "5dcd051b-a98b-39ef-9db9-e8d94cde0eb6",
                        "entry_id": "ffcbe268-3e23-3e5f-9b40-4370b9de4f39",
                        "glosses": [
                            "\\\"een van de volgende handelingen, gepleegd met de bedoeling om een nationale, etnische, godsdienstige groep, dan wel een groep, behorende tot een bepaald ras, geheel of gedeeltelijk als zodanig te vernietigen: het doden van leden van de groep; het toebrengen van ernstig lichamelijk of geestelijk letsel aan leden van de groep; het opzettelijk aan de groep opleggen van levensvoorwaarden die gericht zijn op haar gehele of gedeeltelijke lichamelijke vernietiging; het nemen van maatregelen, bedoeld om geboorten binnen de groep te voorkomen en het gewelddadig overbrengen van kinderen van de groep naar een andere groep.\\\" (definitie uit Verdrag inzake de voorkoming en de bestraffing van genocide van de Verenigde Naties uit 1948)"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "91002fed-9ce7-4133-a6b3-04a104f3035f",
                        "source_entry_id": "ffcbe268-3e23-3e5f-9b40-4370b9de4f39",
                        "source_sense_id": "0d33073b-3404-3aa0-a93c-4ec0f7fbca28",
                        "source_sense_description": "stelselmatige uitroeiing van een volk",
                        "target_lang_word": "genocide",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "genocide",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d26d5a2b-18fb-3638-afad-19be71a74503",
                                        "entry_id": "c7c5e987-fa71-3e93-914c-086bc5e3d3a0",
                                        "glosses": [
                                            "The systematic and deliberate destruction of a group of people, typically by killing substantial numbers of them, on the basis of their ethnicity, religion, or nationality."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aefbfb5f-da68-41f0-9fef-0c5047ac0ab8",
                                                "sense_id": "d26d5a2b-18fb-3638-afad-19be71a74503",
                                                "text": "A genocide will always be followed by the denial that it ever happened."
                                            },
                                            {
                                                "example_id": "2bd2ec4f-eeb4-4188-bdc6-5ef6aed9a7e3",
                                                "sense_id": "d26d5a2b-18fb-3638-afad-19be71a74503",
                                                "text": "For the German occupying authorities war thus appears to offer the most appropriate occasion for carrying out their policy of genocide."
                                            },
                                            {
                                                "example_id": "7065ec69-61b3-46b4-a5bc-1ce3fb82b5f4",
                                                "sense_id": "d26d5a2b-18fb-3638-afad-19be71a74503",
                                                "text": "Shaddam IV: I want fifty legion of Sardaukar on Arrakis at once!\nSubordinate: Fifty legions? That's our entire reserves as well.\nShaddam IV: This is genocide: the deliberate and systematic destruction of all life on Arrakis!"
                                            },
                                            {
                                                "example_id": "909314db-6207-457e-8e40-b217830cabad",
                                                "sense_id": "d26d5a2b-18fb-3638-afad-19be71a74503",
                                                "text": "Though most of the cases here cover European encounters with non-Europeans, it is not the intention of the book to give the impression that genocide is a function of European colonialism and imperialism alone."
                                            },
                                            {
                                                "example_id": "f5bf1ec6-dd4c-410a-a60c-325523888011",
                                                "sense_id": "d26d5a2b-18fb-3638-afad-19be71a74503",
                                                "text": "A genocide denier is an apologist for the next genocide. […] Mr. Handke is the Bob Dylan of genocide apologists."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4dcd5848-f838-3e55-ac35-8e16c29450bf",
                                        "entry_id": "c7c5e987-fa71-3e93-914c-086bc5e3d3a0",
                                        "glosses": [
                                            "The systematic killing of substantial numbers of people on other grounds."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "67866d50-eca2-3da5-bb93-b68101f9aa92",
                                        "entry_id": "c7c5e987-fa71-3e93-914c-086bc5e3d3a0",
                                        "glosses": [
                                            "The systematic suppression of ideas or practices on the basis of cultural or ethnic origin; culturicide."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67b839ba-0afd-4ef7-8c9c-f94957b8f263",
                                                "sense_id": "67866d50-eca2-3da5-bb93-b68101f9aa92",
                                                "text": "Native Americans in the twentieth century are no longer a \"vanishing race\" or a silent minority. They have survived centuries of cultural genocide inflicted on them by non-Native Americans— both the well-meaning and the self-seeking— […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "215960a1-2a92-3fdf-99bf-ff4a8be8de3c",
                                        "entry_id": "c7c5e987-fa71-3e93-914c-086bc5e3d3a0",
                                        "glosses": [
                                            "The elimination of an entire class of monsters by the player."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab5a77b2-38a2-4ff1-a7ac-236f55787348",
                                                "sense_id": "215960a1-2a92-3fdf-99bf-ff4a8be8de3c",
                                                "text": "I used genocide in my first ascension, but have been genocideless ever since. Makes the game much more interesting, but then again, if one hasn't ascended yet, it will be interesting anyway."
                                            },
                                            {
                                                "example_id": "c62886ef-0dff-4e14-9dd7-23646cba5e04",
                                                "sense_id": "215960a1-2a92-3fdf-99bf-ff4a8be8de3c",
                                                "text": "What an Extinctionist tries to do is completely eliminate as many kinds of monsters from the game as possible, either through genocide if it's available, or from just depleting all the kinds of monsters that can be produced."
                                            },
                                            {
                                                "example_id": "fcf0498d-87ce-470e-9df2-8065f6aab0b9",
                                                "sense_id": "215960a1-2a92-3fdf-99bf-ff4a8be8de3c",
                                                "text": "The three main playstyles are neutral (the player kills some, but not all monsters), pacifist (all monsters are spared) and genocide (all monsters are eliminated)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "genocide",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c38f0d27-b635-31bf-8e59-90a93fe1c105",
                                        "entry_id": "850b398e-4d22-38a6-ae8f-6cbd8d711f80",
                                        "glosses": [
                                            "To commit genocide (against); to eliminate (a group of people) completely."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5fca965-e49a-4461-8265-36856452b4af",
                                                "sense_id": "c38f0d27-b635-31bf-8e59-90a93fe1c105",
                                                "text": "Even though the Soviet constitution and that of the Ukrainian SSR contain provisions guaranteeing freedom of religion and other fundamental liberties, the Soviet government genocided the Ukrainian Autocephalous Orthodox Church in the 1930's …"
                                            },
                                            {
                                                "example_id": "30bd901b-7d93-4cd1-b1b2-5baccfa6f369",
                                                "sense_id": "c38f0d27-b635-31bf-8e59-90a93fe1c105",
                                                "text": "A clue appears in the Nazis finding the Gypsies dirty and disorderly (for not only Jews were genocided)."
                                            },
                                            {
                                                "example_id": "7215c379-0563-4047-b159-7f1f69d89c05",
                                                "sense_id": "c38f0d27-b635-31bf-8e59-90a93fe1c105",
                                                "text": "You just know it makes much more sense to encourage brutal governments to buy our WMD technology than to get them to put food in the empty bellies of their people or quit genociding the populace."
                                            },
                                            {
                                                "example_id": "20eb3f3f-5467-4930-892d-83d411522f92",
                                                "sense_id": "c38f0d27-b635-31bf-8e59-90a93fe1c105",
                                                "text": "It is unlikely that Sulla succeeded in genociding the Samnites, since their mountains offered many refuges, but in subsequent centuries the Samnites disappeared, being absorbed into the general population of Italy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "04586b36-380a-4d1d-b861-b7d249904832",
                        "source_entry_id": "ffcbe268-3e23-3e5f-9b40-4370b9de4f39",
                        "source_sense_id": "0d33073b-3404-3aa0-a93c-4ec0f7fbca28",
                        "source_sense_description": "stelselmatige uitroeiing van een volk",
                        "target_lang_word": "génocide",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "génocide",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "76afb799-d3a2-3dee-a77b-aef5ea24f257",
                                        "entry_id": "c6b05d5b-c61c-3783-873a-efcca05062eb",
                                        "glosses": [
                                            "Élimination physique intentionnelle, totale ou partielle, d’un groupe humain (national, ethnique ou religieux) ce qui veut dire que les membres sont exterminés ou rendus incapables de procréer en raison de leur appartenance au groupe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f8b0d04-8557-4502-a062-c14d86c9be5e",
                                                "sense_id": "76afb799-d3a2-3dee-a77b-aef5ea24f257",
                                                "text": "En 1994, le génocide du Rwanda a fait 800 000 morts."
                                            },
                                            {
                                                "example_id": "f4334514-98dc-4661-8cc8-541d96d4fbb1",
                                                "sense_id": "76afb799-d3a2-3dee-a77b-aef5ea24f257",
                                                "text": "La destruction des systèmes de réciprocité africains par la colonisation et la généralisation de la domination du marché capitaliste conduisent à l’ethnocide, à l’« économicide » et au génocide."
                                            },
                                            {
                                                "example_id": "9452562c-775c-49bc-ac90-a1f7521660ef",
                                                "sense_id": "76afb799-d3a2-3dee-a77b-aef5ea24f257",
                                                "text": "En décembre 2003, le Tribunal international pour le Rwanda a condamné trois hommes pour incitation directe et publique au génocide, pour avoir proféré des mots ayant semé la haine, pour avoir appelé, à la radio, « à stigmatiser l’appartenance ethnique de manière à entraîner le mépris et la haine pour la population tutsi »."
                                            },
                                            {
                                                "example_id": "cd5c4ab0-4a46-4cbc-863e-5445a85ca936",
                                                "sense_id": "76afb799-d3a2-3dee-a77b-aef5ea24f257",
                                                "text": "La Convention de l’ONU sur le génocide définit celui-ci comme la détention, les sévices, les déplacements, la stérilisation et la mise à mort « dans l’intention de détruire, ou tout, ou en partie, un groupe national, ethnique, racial ou religieux »."
                                            },
                                            {
                                                "example_id": "fadf866e-5bd0-486d-b711-cb2af15d2d33",
                                                "sense_id": "76afb799-d3a2-3dee-a77b-aef5ea24f257",
                                                "text": "Le génocide arménien est reconnu par plus de vingt pays et par de nombreux historiens, mais il est rigoureusement contesté par la Turquie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3b22bcf-00ba-3a8e-b7ba-a8df7e540cd4",
                                        "entry_id": "c6b05d5b-c61c-3783-873a-efcca05062eb",
                                        "glosses": [
                                            "Hécatombe, mort violente et rapide d’un grand nombre de personnes."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "202d36f3-f60d-4ae0-b786-386275687964",
                                                "sense_id": "a3b22bcf-00ba-3a8e-b7ba-a8df7e540cd4",
                                                "text": "J’ai visité des hôpitaux, j’ai vu les victimes de la route. Le génocide commence en France."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "génocide",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8b6c11ef-7fe3-3568-aef1-09466c35c74b",
