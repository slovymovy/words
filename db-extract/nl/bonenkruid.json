                                        "sense_id": "7314c097-3fce-37e5-ae47-c15cd7e6d311",
                                        "entry_id": "08a50216-acbc-3326-99cf-836e0a13e579",
                                        "glosses": [
                                            "eine Pflanze aus der Gattung Satureja, die teilweise als Küchenkraut verwendet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c132a728-58d2-48ac-8e07-6b95d5dff9f7",
                                                "sense_id": "7314c097-3fce-37e5-ae47-c15cd7e6d311",
                                                "text": "Die meisten Bohnenkräuter kommen in den temperaten Gebieten und den tropischen Gebirgen vor."
                                            },
                                            {
                                                "example_id": "ed401b0c-75e0-4426-9bff-a7a67bce748e",
                                                "sense_id": "7314c097-3fce-37e5-ae47-c15cd7e6d311",
                                                "text": "Das Bohnenkraut passt sehr gut zu Bohnen, Kartoffeln und Salat."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d2c332a0-6625-4429-a088-6449c600921a",
                        "source_entry_id": "3197e525-e8fe-38f8-8c13-8fa26a94e090",
