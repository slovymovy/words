                "senses": [
                    {
                        "sense_id": "cddda403-ab3c-31ee-8b4e-0cddac8bf087",
                        "entry_id": "7ae2bb56-d21c-374f-b6d4-5604ca44f860",
                        "glosses": [
                            "Unir deux solives par un embrèvement ; faire entrer une pièce de bois dans une autre afin de les assembler."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78d933bc-8b50-43dc-9785-4388c3ccdd43",
                                "sense_id": "cddda403-ab3c-31ee-8b4e-0cddac8bf087",
                                "text": "En effet il n’est plus possible d’embréver ces perçages après mise en place du renfort (voir la photo)."
                            },
                            {
                                "example_id": "522259e7-7fea-42d9-9cec-20e32488331f",
                                "sense_id": "cddda403-ab3c-31ee-8b4e-0cddac8bf087",
                                "text": "Rayonnage d’affichage de la gondole AU50 avec le panneau embrévé de cheville de trou pour le magasin s’adaptant L900 x D450/450 x H2100mm."
                            },
                            {
                                "example_id": "8a4b6349-8434-4afc-badb-a4414a7ea549",
                                "sense_id": "cddda403-ab3c-31ee-8b4e-0cddac8bf087",
                                "text": "Sur les sablières I posées sur les jouées (voir la face postérieure C), venaient s’embréver les madriers formant chevrons et recevant les lambris intérieurs de manière à dégager le jour dormant K, les châssis rectangulaires étant seuls ouvrants."
                            }
                        ]
                    }
