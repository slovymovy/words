                "senses": [
                    {
                        "sense_id": "ed460399-2c8a-32f5-90b4-20a31ace3f06",
                        "entry_id": "1cde7ff8-f589-3d13-ac75-98a8d2874640",
                        "glosses": [
                            "Motorschaden bei Hubkolben-Verbrennungsmotoren, bei dem Kolben und Zylinder durch übermäßige Wärmeentwicklung eine feste Verbindung – ähnlich wie geschweißt – eingehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ddfd1c74-2406-4db1-b2c4-a032a420635a",
                                "sense_id": "ed460399-2c8a-32f5-90b4-20a31ace3f06",
                                "text": "Häufigster Grund für einen Kolbenfresser ist einfacher Ölmangel."
                            },
                            {
                                "example_id": "4da9bd3b-6179-471f-8a4b-62ddde7ca857",
                                "sense_id": "ed460399-2c8a-32f5-90b4-20a31ace3f06",
                                "text": "„Ein Kolbenfresser führt meist zu massiven Folgeschäden an Zylindern, Lagern und Kurbelwelle.“"
                            },
                            {
                                "example_id": "14411585-35ed-4ab9-94ee-79cc249b0536",
                                "sense_id": "ed460399-2c8a-32f5-90b4-20a31ace3f06",
                                "text": "„Ein Kolbenfresser ergibt sich häufig nicht urplötzlich, sondern deutet sich zumindest vorher an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
