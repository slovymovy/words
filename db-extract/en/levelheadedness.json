                "entry_id": "39edcf74-7838-387a-b1ad-7da208fdbc38",
                "word": "levelheadedness",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1e7ab646-1bce-3efb-a405-6aadf38605ae",
                        "entry_id": "39edcf74-7838-387a-b1ad-7da208fdbc38",
                        "glosses": [
                            "The property of being levelheaded, stable, not overly swayed by passion."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b5f0bdf1-d23d-4f6e-b0bd-affae0b4352d",
                        "source_entry_id": "39edcf74-7838-387a-b1ad-7da208fdbc38",
                        "source_sense_id": "1e7ab646-1bce-3efb-a405-6aadf38605ae",
                        "source_sense_description": "property of being levelheaded",
                        "target_lang_word": "Besonnenheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Besonnenheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7a1c27a2-a07b-36fe-9351-4ee783e7b477",
                                        "entry_id": "9f205a4b-c026-3a41-91f2-889436897419",
                                        "glosses": [
                                            "Eigenschaft/Haltung, nichts unüberlegt zu tun"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c702973-0dc0-4d26-a0ff-83ba404c76e3",
                                                "sense_id": "7a1c27a2-a07b-36fe-9351-4ee783e7b477",
                                                "text": "„Sie rieten zur Besonnenheit und forderten die Truppen auf, Soldatenräte zu bilden und deren Anweisungen zu gehorchen.“"
                                            },
                                            {
                                                "example_id": "ce17ad6d-422d-4ce4-b880-97ae7f603005",
                                                "sense_id": "7a1c27a2-a07b-36fe-9351-4ee783e7b477",
                                                "text": "„Vor seinem düsteren Hintergrund erzählt dieses Buch vom Mitgefühl und vom Mut, von der Besonnenheit und der Energie zum Handeln, von der Stärke der Schwachen.“"
                                            },
                                            {
                                                "example_id": "656989ab-0d6a-4f4f-b572-200f00d2ce75",
                                                "sense_id": "7a1c27a2-a07b-36fe-9351-4ee783e7b477",
                                                "text": "„Als Canondah jedoch sich vor ihm niederließ und in die wohlbekannten Töne des Nachtgesanges ausbrach, schien sie ihre ganze Besonnenheit zu verlieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a0dcf44d-82d3-49d9-b301-305d7939c704",
                        "source_entry_id": "39edcf74-7838-387a-b1ad-7da208fdbc38",
                        "source_sense_id": "1e7ab646-1bce-3efb-a405-6aadf38605ae",
                        "source_sense_description": "property of being levelheaded",
                        "target_lang_word": "Unaufgeregtheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "55047fe1-73f8-4386-bb3c-777514daaf28",
                        "source_entry_id": "39edcf74-7838-387a-b1ad-7da208fdbc38",
                        "source_sense_id": "1e7ab646-1bce-3efb-a405-6aadf38605ae",
                        "source_sense_description": "property of being levelheaded",
                        "target_lang_word": "Umsicht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Umsicht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c43a6bbb-2f1f-336d-ba83-7b45d1841fdc",
                                        "entry_id": "60645f6c-d455-370f-a483-88de3360a949",
                                        "glosses": [
                                            "das Beachten aller bedeutsamen Umstände, vorausschauendes Handeln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89c7df2f-b019-42fb-8e45-83b5a43bab00",
                                                "sense_id": "c43a6bbb-2f1f-336d-ba83-7b45d1841fdc",
                                                "text": "Durch Umsicht werden Fehler vermieden."
                                            },
                                            {
                                                "example_id": "10f14003-206c-4dff-8476-3847746acde7",
                                                "sense_id": "c43a6bbb-2f1f-336d-ba83-7b45d1841fdc",
                                                "text": "„Händler/innen haben mit der gebotenen Umsicht zur Einhaltung der anwendbaren Sicherheitsanforderungen beizutragen, indem sie insbesondere keine Produkte liefern, von denen sie wissen oder auf Grund der ihnen bei zumutbarer Sorgfalt zugänglichen Informationen wissen müssten, dass sie diesen Anforderungen nicht genügen.“"
                                            },
                                            {
                                                "example_id": "ca5bf55c-9967-40aa-95ae-2596f8b6550b",
                                                "sense_id": "c43a6bbb-2f1f-336d-ba83-7b45d1841fdc",
                                                "text": "„Die goldene Regel des Drachenfliegens heißt, möglichst viel Umsicht walten lassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "be8a4294-5d76-3b05-bcb2-3dbe720950b8",
                                        "entry_id": "60645f6c-d455-370f-a483-88de3360a949",
                                        "glosses": [
                                            "Rundblick, Aussicht"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc035f98-3af8-4ee4-9446-1b2248bd01d2",
                                                "sense_id": "be8a4294-5d76-3b05-bcb2-3dbe720950b8",
                                                "text": "„Von der Höhe des Damms, auf dem der Wettlauf gehalten wurde, bietet sich eine prachtvolle Umsicht dar.“"
                                            },
                                            {
                                                "example_id": "dc6d35c6-118d-469d-ba12-c4a91c79d117",
                                                "sense_id": "be8a4294-5d76-3b05-bcb2-3dbe720950b8",
                                                "text": "„Erst 1845 hören wir von einem acht Meter hohen hölzernen Gerüst auf dem Gipfel, welches »eine fast unbeschränkte Umsicht gewähre«.“"
                                            },
                                            {
                                                "example_id": "fadc99af-3a69-4841-ba1c-89cd0e267ffa",
                                                "sense_id": "be8a4294-5d76-3b05-bcb2-3dbe720950b8",
                                                "text": "„Denn die Aussicht von diesem Thurm ist so entzückend schön, so über alle Maßen reichhaltig, daß kein Berg in dem großen Riesengebirge diese herrliche Umsicht gewährt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5779cb26-cf62-496c-b099-f480f32a8770",
                        "source_entry_id": "39edcf74-7838-387a-b1ad-7da208fdbc38",
                        "source_sense_id": "1e7ab646-1bce-3efb-a405-6aadf38605ae",
                        "source_sense_description": "property of being levelheaded",
                        "target_lang_word": "Ausgeglichenheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ausgeglichenheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "36392c09-9e55-34ea-8e58-2bd2ac143994",
                                        "entry_id": "a40ed58d-6f6c-3d27-a6c2-f45612abc7ae",
                                        "glosses": [
                                            "Zustand, sich im Gleichgewicht zu befinden, keinen starken (Gefühls-)Schwankungen ausgesetzt zu sein, eine gleichmäßige Verteilung aufzuweisen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a3772ac-a243-4a3f-a84f-c685208f53e7",
                                                "sense_id": "36392c09-9e55-34ea-8e58-2bd2ac143994",
                                                "text": "Er zeichnet sich im Gegensatz zu den anderen durch seine auffallende Ausgeglichenheit aus."
                                            },
                                            {
                                                "example_id": "32cc01c8-efc7-403b-b566-8c6122b4dc77",
                                                "sense_id": "36392c09-9e55-34ea-8e58-2bd2ac143994",
                                                "text": "„Außerdem soll tägliches Meditieren für mehr Entspannung und Ausgeglichenheit sorgen.“"
                                            },
                                            {
                                                "example_id": "0fc266f0-3e82-487d-91ff-3cad4154ef58",
                                                "sense_id": "36392c09-9e55-34ea-8e58-2bd2ac143994",
                                                "text": "„Die Wut seiner jungen Jahre hatte er in eine beneidenswerte Ausgeglichenheit umgewandelt, leicht nihilistisch vielleicht, aber immer warmherzig.“"
                                            },
                                            {
                                                "example_id": "74c659c1-e806-492b-934b-0b41a43ef50e",
                                                "sense_id": "36392c09-9e55-34ea-8e58-2bd2ac143994",
                                                "text": "„Daran ändert selbst der Umverteilungsmechanismus wenig, den die Bundesliga und andere Ligen installiert haben, um die Ausgeglichenheit der Teams zu ermöglichen.“"
                                            },
                                            {
                                                "example_id": "8f3f511f-728a-4da6-a005-3d341f7e5ba9",
                                                "sense_id": "36392c09-9e55-34ea-8e58-2bd2ac143994",
                                                "text": "„Dennoch ist man sich einig, dass schon eine Viertelstunde Vorlesen am Tag zu mehr Ausgeglichenheit bei Kindern führt; denn schon in dieser kurzen Vorlesezeit können die Kleinen zur Ruhe kommen.“"
                                            },
                                            {
                                                "example_id": "ec39720d-eedf-4847-ac01-4ba02cc9dfd4",
                                                "sense_id": "36392c09-9e55-34ea-8e58-2bd2ac143994",
                                                "text": "„Der uns heute besonders interessierende Kulturgrund dieses Stiles war eine verhältnismäßig große Ausgeglichenheit zwischen städtischem und ländlichem Wesen.“"
                                            },
                                            {
                                                "example_id": "d149d266-d5e2-4f8b-b84c-b1d7c7386d34",
                                                "sense_id": "36392c09-9e55-34ea-8e58-2bd2ac143994",
                                                "text": "„Diese Methode übten sie jahrelang sehr strikt aus und schufen dadurch bereits früh eine gewisse Ausgeglichenheit zwischen den beiden Sprachen.“"
                                            },
                                            {
                                                "example_id": "990f67df-ca1d-4a5c-9843-a37289233f5f",
                                                "sense_id": "36392c09-9e55-34ea-8e58-2bd2ac143994",
                                                "text": "„Die Massenfertigung von Speisen mit Geschmacksverstärkern und künstlichen Zusatzstoffen führt vor allem bei Kindern dazu, dass sie hyperaktiv, unaufmerksam und unkonzentriert werden. […] An einer britischen Schule haben Schüler eine Woche lang nur stressfreies Essen gegessen. Und siehe da, erste Ausgeglichenheiten in der Stimmung waren die Folge.“"
                                            },
                                            {
                                                "example_id": "54d3dbae-d2c9-49b3-ba2c-4321ba80a977",
                                                "sense_id": "36392c09-9e55-34ea-8e58-2bd2ac143994",
                                                "text": "„Die württembergische Wirtschaft zeichnet sich durch die Ausgeglichenheiten zwischen den und innerhalb der verschiedenen Wirtschaftszweige aus.“"
                                            },
                                            {
                                                "example_id": "94d0223d-c915-46b8-86a6-23f3b57f1ff2",
                                                "sense_id": "36392c09-9e55-34ea-8e58-2bd2ac143994",
                                                "text": "„Seit dieser Zeit sind aber in den Schafbeständen der bäuerlichen Züchter viel, zum Teil fast alle Ausgeglichenheiten verloren gegangen, besonders was Form und Leistung anbelangt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
