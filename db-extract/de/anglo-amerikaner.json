                                    {
                                        "sense_id": "f27aa641-75e8-3d71-83ed-7ac1a37e580c",
                                        "entry_id": "bee8b968-f568-32ce-940e-dc831cca2809",
                                        "glosses": [
                                            "Originario, relativo a, o propio de la América de habla inglesa (anglosajona), la colonizada por Inglaterra, a veces también llamada Angloamérica, o a lo americano de origen inglés o británico."
                                        ],
                                        "tags": [
                                            "noun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "673b9aba-b02c-4f43-a4c1-f6efb47cd1e0",
                                                "sense_id": "f27aa641-75e8-3d71-83ed-7ac1a37e580c",
                                                "text": "Las colonias angloamericanas del sur fundamentaron su economía en la de obra esclava."
                                            },
                                            {
                                                "example_id": "fae235ce-0f3f-4ab6-99f0-478f42b9caf8",
                                                "sense_id": "f27aa641-75e8-3d71-83ed-7ac1a37e580c",
                                                "text": "el inmigrante hispano nunca vino a asimilarse a la población angloamericana ni a."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6cfb05f3-7558-32a8-b302-1847ece57ee8",
                                        "entry_id": "bee8b968-f568-32ce-940e-dc831cca2809",
                                        "glosses": [
                                            "Que pertenece o concierne a elementos comunes o relaciones bilaterales entre el Reino Unido y el continente americano."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48675162-63d4-4118-b2b0-4f1031ea6915",
                                                "sense_id": "6cfb05f3-7558-32a8-b302-1847ece57ee8",
                                                "text": "En los primeros momentos de la Revolución Francesa mediaba un grave estado de tensión en las relaciones angloamericanas, a causa de haberse apoderado los hispanos de once naves mercantes inglesas."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "6ca9b458-36c9-33e5-ac39-92a9c5b48570",
                                        "entry_id": "bee8b968-f568-32ce-940e-dc831cca2809",
                                        "glosses": [
                                            "Que pertenece o concierne a elementos comunes o relaciones bilaterales entre el Reino Unido y la América de habla inglesa, en particular los Estados Unidos."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9981c666-6b3c-4a42-b234-0cf8df749f99",
                                                "sense_id": "6ca9b458-36c9-33e5-ac39-92a9c5b48570",
                                                "text": "La historia de las relaciones angloamericanas durante la II Guerra Mundial no fue lineal, como se vería si leyéramos algunas de las 1.799 cartas intercambiadas entre Churchill y Roosevelt durante ese período."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "871fc1b9-a95f-34c9-bf0a-d1e5516a9b3e",
                                        "entry_id": "bee8b968-f568-32ce-940e-dc831cca2809",
                                        "glosses": [
                                            "Originario, relativo a, o propio de los Estados Unidos de América."
                                        ],
                                        "tags": [
                                            "noun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f3dfa44-ba6f-49a0-9e92-e83fa8d6ae2c",
                                                "sense_id": "871fc1b9-a95f-34c9-bf0a-d1e5516a9b3e",
                                                "text": "En el puerto de Veracruz aún se encontraban las fuerzas angloamericanas enviadas por Woodrow Wilson."
                                            }
                                        ],
