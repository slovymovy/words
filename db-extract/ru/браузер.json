                ],
                "senses": [
                    {
                        "sense_id": "5425f06a-8537-38ef-bc27-c4e31d40c405",
                        "entry_id": "e63cfd44-35f9-3ef5-8245-6c9f871d9aa3",
                        "glosses": [
                            "комп. программа, предназначенная для просмотра сайтов, гипертекстовых документов в Интернете"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aac6b621-fffc-4c54-a53f-852e8c4d06ff",
                                "sense_id": "5425f06a-8537-38ef-bc27-c4e31d40c405",
                                "text": "В 1993 году в Университете штата Иллинойс (University of Illinois) Марком Андреесеном (Marc Andreesen) был создан первый интернет-браузер Mosaic."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cfbde9a0-a843-4129-8a8a-fbf96c404339",
                        "source_entry_id": "e63cfd44-35f9-3ef5-8245-6c9f871d9aa3",
                        "source_sense_id": "5425f06a-8537-38ef-bc27-c4e31d40c405",
                        "target_lang_word": "browser",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "browser",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5417718e-6da8-3742-ad47-fdcc611261aa",
                                        "entry_id": "8deed13b-bd59-3da0-8ab1-187251a3001d",
                                        "glosses": [
                                            "One who or which browses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51870f55-b0f8-4850-b98a-b3a77e27d238",
                                                "sense_id": "5417718e-6da8-3742-ad47-fdcc611261aa",
                                                "text": "Giraffe have a long, muscular tongue, which aids in gathering leaves into the mouth; and the dentition is typical of browsers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3c745b2-5974-3d6a-8e75-d26ec0e887b2",
                                        "entry_id": "8deed13b-bd59-3da0-8ab1-187251a3001d",
                                        "glosses": [
                                            "One who or which browses.",
                                            "A person who examines goods for sale but purchases nothing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7becac82-b1f0-408f-a349-0e4aeb076bef",
                                                "sense_id": "f3c745b2-5974-3d6a-8e75-d26ec0e887b2",
                                                "text": "While still in the mood for antique bartering, The Emerald City on the South End section of Dartmouth St. has expanded just in time for browsers and buyers. Allow some time here as it's a poke-and-find shop of 1800's pictures and prints, turn-of-the-century kitchen ware, and some very unusual furnishings and lamps."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9845919a-9b68-3292-b4bb-4f7167ab26ef",
                                        "entry_id": "8deed13b-bd59-3da0-8ab1-187251a3001d",
                                        "glosses": [
                                            "Ellipsis of web browser."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "697c7811-da7c-441f-b156-ecf22c4f6e37",
                                                "sense_id": "9845919a-9b68-3292-b4bb-4f7167ab26ef",
                                                "text": "A program which provides access to the hypertext world we call a browser."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60b0ab81-563c-3191-8fbd-11d2b9dbb670",
                                        "entry_id": "8deed13b-bd59-3da0-8ab1-187251a3001d",
                                        "glosses": [
                                            "Any other type of information browser."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eefeacd4-6606-4fff-8a01-a2ebd9d2e374",
                                                "sense_id": "60b0ab81-563c-3191-8fbd-11d2b9dbb670",
                                                "text": "The real strengthof AR browsers is their discoverability. Today, browsers have most of the attention and it's amazing how many people have yet to experience a browser for themselves. Browsers are incredibly useful ways to discover information about places and objects around you."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "673b18b1-bcfc-45d7-be53-31b7d26b2b98",
                        "source_entry_id": "e63cfd44-35f9-3ef5-8245-6c9f871d9aa3",
                        "source_sense_id": "5425f06a-8537-38ef-bc27-c4e31d40c405",
                        "target_lang_word": "Webbrowser",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Webbrowser",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2898b8dd-f375-3bf0-86ab-545cc98f5edd",
                                        "entry_id": "3db5979f-f471-344c-875f-5f336f63d96a",
                                        "glosses": [
                                            "Computersoftware zum Betrachten von Webseiten im World Wide Web"
                                        ],
                                        "tags": [
                                            "Software",
                                            "Web"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58a1a3f4-10e2-4eeb-b9ca-081ad02873b6",
                                                "sense_id": "2898b8dd-f375-3bf0-86ab-545cc98f5edd",
                                                "text": "Mein favorisierter Webbrowser ist der Internet Explorer."
                                            },
                                            {
                                                "example_id": "ddbb47e8-cc65-4ebb-9875-a8ceb274a2e9",
                                                "sense_id": "2898b8dd-f375-3bf0-86ab-545cc98f5edd",
                                                "text": "„Neben HTML-Seiten können Webbrowser verschiedene andere Arten von Dokumenten wie zum Beispiel Bilder und PDF-Dokumente anzeigen. Webbrowser stellen die Benutzeroberfläche für Webanwendungen dar.“"
                                            },
                                            {
                                                "example_id": "766e1046-5438-458f-b9f4-f4d7a4635f8a",
                                                "sense_id": "2898b8dd-f375-3bf0-86ab-545cc98f5edd",
                                                "text": "„Der erste brauchbare Webbrowser erschien erst weitere zehn Jahre später.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
