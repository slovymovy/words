                    {
                        "translation_id": "87b6619b-d3f2-4c7b-885c-50b48e0077b5",
                        "source_entry_id": "18a76fee-0f90-3b44-b038-f3112985b987",
                        "source_sense_id": "c05dcc5a-c112-34f1-8aa7-e86bd7c52e26",
                        "target_lang_word": "lidmaatschap",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lidmaatschap",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "145013da-ce59-30a6-ba14-cc961448a6ad",
                                        "entry_id": "4503905d-70ff-3b44-9600-a8093481f09b",
                                        "glosses": [
                                            "de status van iemand als lid van een organisatie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89257228-edea-462e-8a1f-81f370be359b",
                                                "sense_id": "145013da-ce59-30a6-ba14-cc961448a6ad",
                                                "text": "Het lidmaatschap van deze vereniging is beperkt tot moedertaalsprekers van het Cherokee."
                                            },
                                            {
                                                "example_id": "8ba9e660-5395-4807-8136-f181c85476f8",
                                                "sense_id": "145013da-ce59-30a6-ba14-cc961448a6ad",
                                                "text": "Het lidmaatschap of bestuurderschap van een criminele organisatie is in de aanklacht opgenomen, zegt Van Gessel."
                                            },
                                            {
                                                "example_id": "a4085ad4-b4c1-4157-9e3d-4f484027c456",
                                                "sense_id": "145013da-ce59-30a6-ba14-cc961448a6ad",
                                                "text": "President Niinisto en premier Marin van Finland zijn voorstander van het NAVO-lidmaatschap van hun land. Volgens de twee moet het land \"zonder vertraging\" een aanvraag doen voor het lidmaatschap van het militaire bondgenootschap. Dinsdag zei de defensiecommissie van het Finse parlement al dat toetreden tot de NAVO de beste optie is om nationale veiligheid te garanderen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "79e60d23-1099-4a6d-a509-07dfd2f5df71",
                        "source_entry_id": "18a76fee-0f90-3b44-b038-f3112985b987",
                        "source_sense_id": "c05dcc5a-c112-34f1-8aa7-e86bd7c52e26",
                        "target_lang_word": "Mitgliedschaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mitgliedschaft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dbb6afed-f33c-3636-9a64-067abc04518f",
                                        "entry_id": "2f9e5e1b-bd56-3df2-966d-88b63a919a99",
                                        "glosses": [
                                            "Zustand, in dem jemand Mitglied von etwas ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5b728c2-3a68-452c-acbc-ae492f3295a8",
                                                "sense_id": "dbb6afed-f33c-3636-9a64-067abc04518f",
                                                "text": "Ich möchte meine Mitgliedschaft im Schützenverein kündigen."
                                            },
                                            {
                                                "example_id": "36587ae7-ca7a-4180-9658-3777c8b70155",
                                                "sense_id": "dbb6afed-f33c-3636-9a64-067abc04518f",
                                                "text": "„Die Mitgliedschaft dauert sechs Jahre, eine Wiederberufung ist jedoch möglich.“"
                                            },
                                            {
                                                "example_id": "313eb90b-3f08-44d6-bc66-ce4cb171d74a",
                                                "sense_id": "dbb6afed-f33c-3636-9a64-067abc04518f",
                                                "text": "„Auf dem NATO-Gipfel in Bukarest wurde der Ukraine und Georgien eine Mitgliedschaft [Anmerkung: in der NATO] zwar in Aussicht gestellt, doch ohne Datum.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
