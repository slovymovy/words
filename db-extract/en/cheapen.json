                        "examples": [
                            {
                                "example_id": "c1ab0604-9675-474b-af50-83166c5e1245",
                                "sense_id": "582c285c-0d1c-360d-a916-b01b1cab9232",
                                "text": "She cheapened the dress by adding a fringe to it.",
                                "translation": "Sie verschlechterte ihre Bekleidung, indem sie eine Franse dazugenommen hat."
                            },
                            {
                                "example_id": "f0e929c4-d4f7-486a-8a5b-2a1730c7b508",
                                "sense_id": "582c285c-0d1c-360d-a916-b01b1cab9232",
                                "text": "„The code word for that is simply ›prayer‹, but it became cheapened by misuse.“",
                                "translation": "Das Schlüsselwort dafür ist schlicht ›Gebet‹, welches aber durch falsche Verwendung schlechtgemacht wurde."
                            }
                        ],
                        "sense_index_json": "\"2\""
