                "senses": [
                    {
                        "sense_id": "9b00bfe1-1a38-3f58-aebd-1f9ab0e3bbd5",
                        "entry_id": "a2f8cd0f-6491-30f9-9593-ac9fdfbb568e",
                        "glosses": [
                            "Personne suivant la doctrine de Jean Campan."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25d6677a-6c3c-4168-87df-461dba5b0d87",
                                "sense_id": "9b00bfe1-1a38-3f58-aebd-1f9ab0e3bbd5",
                                "text": "Les campanistes, disciples de Jean Campan, antiluthérien et sacramentaire, ne croyaient pas que le Fils et le Saint-Esprit fussent deux personnes distinctes du Père."
                            },
                            {
                                "example_id": "3d80420f-f638-40e4-93c4-320405825f7e",
                                "sense_id": "9b00bfe1-1a38-3f58-aebd-1f9ab0e3bbd5",
                                "text": "Campanistes sont ainsi appellez par la confession de Mansueld, de Iean Campanus, qui apporte vne autre exposition des paroles de la Cene de nostre Seigneur, que les Carolstadiens, Zuingliens, Oecolampadiés, Suuencfeldians ou Caluinistes."
                            }
                        ]
                    }
