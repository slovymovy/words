                "senses": [
                    {
                        "sense_id": "9ed25f94-e947-3f2d-bc63-d610d5b6f352",
                        "entry_id": "149a50a2-3d42-32cc-8e2b-224dd4b65b5c",
                        "glosses": [
                            "in einem Krankenhaus beschäftigter therapeutischer Clown"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9db97a2-ac0a-4d12-ac54-988dde4941e3",
                                "sense_id": "9ed25f94-e947-3f2d-bc63-d610d5b6f352",
                                "text": "„Es entstanden Weiterbildungszentren für Kinderärzte, Krankenschwestern und Sozialarbeiter, die ein systematisches Training zum Krankenhausclown offerieren.“"
                            },
                            {
                                "example_id": "1e2d19eb-ddf1-437c-aa3c-3dd480bb7645",
                                "sense_id": "9ed25f94-e947-3f2d-bc63-d610d5b6f352",
                                "text": "„An diesem Tag poltern gerade die Krankenhausclowns durchs Zimmer, spielen Gitarre und singen ‚Alle meine Entchen‘ in der ‚We will Rock you‘-Version.“"
                            },
                            {
                                "example_id": "3cc85e3e-9e77-45be-befc-2204de3bd766",
                                "sense_id": "9ed25f94-e947-3f2d-bc63-d610d5b6f352",
                                "text": "„Sie ist als Krankenhausclown für Kinder unterwegs, spielt in der Kindertheaterwerkstatt Ulm mit und besucht auch Senioren im Pflegeheim.“"
                            },
                            {
                                "example_id": "1712bb83-e518-4798-9551-9ef09db9d530",
                                "sense_id": "9ed25f94-e947-3f2d-bc63-d610d5b6f352",
                                "text": "„Neben dem künstlerischen Talent, muss der Krankenhausclown daher eine große Bereitschaft besitzen, Freude und Liebe zu spenden.“"
                            },
                            {
                                "example_id": "899bb85f-d529-4737-acd7-7668c1e209cf",
                                "sense_id": "9ed25f94-e947-3f2d-bc63-d610d5b6f352",
                                "text": "„Oettinger, 45, aus der Nähe von Karlsruhe ist Krankenhausclown.“"
                            },
                            {
                                "example_id": "f8348895-81c5-4bf9-8ee0-75a6f859fb25",
                                "sense_id": "9ed25f94-e947-3f2d-bc63-d610d5b6f352",
                                "text": "„‚Die Diplom-Animatöse‘, nennt Christine Prayon ihr erstes Kabarett-Solo, für das sie in diesem Jahr prompt den Deutschen Kleinkunstpreis des Unterhauses bekam. ‚Ich habe gedacht: Du fängst als Krankenhausclown an, arbeitest ein paar Jahre an der Basis hier im Unterhaus, und mit 30 hast du’s dann geschafft, da bist du im Dschungelcamp.‘“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
