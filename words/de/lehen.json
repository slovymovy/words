            "senses": [
                {
                    "sense_id": "b1a7cb1c-72f6-3d33-977b-9d383b435c0e",
                    "sense_definition": "Im Feudalismus ein von einem Lehnsherrn an einen Vasallen verliehenes Gut oder Recht, verbunden mit der Pflicht zu Treue und Diensten.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "feudalismus",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der König übertrug dem tapferen Ritter ein fruchtbares <w>Lehen</w> im Süden des Reiches."
                        },
                        {
                            "text": "Für seine treuen Dienste durfte der Graf das erhaltene <w>Lehen</w> an seine Nachkommen vererben."
                        }
                    ],
                    "synonyms": [
                        "Lehngut"
                    ],
                    "antonyms": [
                        "Allod",
                        "Eigengut"
                    ],
                    "common_phrases": [
                        "ein Lehen empfangen",
                        "ein Lehen vergeben",
                        "ein Lehen verleihen"
                    ]
                },
                {
                    "sense_id": "25293ac8-245d-3a37-94c4-46bb1b1943da",
                    "sense_definition": "Ein landwirtschaftlicher Betrieb oder Bauernhof von einer bestimmten Größe.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "landwirtschaft",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Familie bewirtschaftete dieses abgelegene <w>Lehen</w> bereits seit mehreren Generationen erfolgreich."
                        },
                        {
                            "text": "Nach dem Tod des Vaters übernahm der älteste Sohn das gesamte bäuerliche <w>Lehen</w>."
                        }
                    ],
                    "synonyms": [
                        "Bauernhof",
                        "Erbhof"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "landschaftlich für einen Bauernhof oder ein Erbgut"
                        }
                    ]
                },
                {
                    "sense_id": "3f03da99-d5c2-3b9c-8bcf-c3fa023aea11",
                    "sense_definition": "Ein Gegenstand, der jemandem nur vorübergehend geliehen worden ist; eine Leihgabe.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "leihe",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nach vielen Monaten verlangte der Nachbar sein wertvolles <w>Lehen</w> unversehrt zurück."
                        },
                        {
                            "text": "Er betrachtete das fremde Buch stets nur als ein vorübergehendes <w>Lehen</w>."
                        }
                    ],
                    "synonyms": [
                        "Leihgabe"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "im modernen Sprachgebrauch durch Leihgabe verdrängt"
                        }
                    ]
                }
            ]
        }
    ]
