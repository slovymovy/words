        "fr-extract.jsonl": [
            {
                "entry_id": "b015c14a-fa42-3906-861c-1e7b7e689c46",
                "word": "subito",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2d01294c-b57c-307a-a89c-217e5cea95a4",
                        "entry_id": "b015c14a-fa42-3906-861c-1e7b7e689c46",
                        "glosses": [
                            "Subitement, tout à coup."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2fad9abf-ef53-477e-8d38-2c3f9afb7c0f",
                                "sense_id": "2d01294c-b57c-307a-a89c-217e5cea95a4",
                                "text": "Pierre avalait les dames à la régalade. Il les animait, les entraînait, les poussait dans les coins, se montait un peu la tête, se déchaînait subito."
                            },
                            {
                                "example_id": "fd7a3983-e3a1-4467-978d-2ea79fad2461",
                                "sense_id": "2d01294c-b57c-307a-a89c-217e5cea95a4",
                                "text": "Après avoir pris des nouvelles de ma santé, voilà subito qu’il se met à pester contre tout : les corvées, l’ordinaire, les marches de nuit (des heures à crapahuter dans la neige, par un froid sibérien, harnachés comme des mulets)."
                            }
                        ]
                    },
                    {
                        "sense_id": "1bbd1345-d8e2-3567-ba74-405f1bb29810",
                        "entry_id": "b015c14a-fa42-3906-861c-1e7b7e689c46",
                        "glosses": [
                            "Sans retard, immédiatement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "973b1296-4936-4b72-a461-582183cea737",
                                "sense_id": "1bbd1345-d8e2-3567-ba74-405f1bb29810",
                                "text": "C'est alors que docteurs, savants et professeurs\nEntonnèrent subito tous en chœur\nLe soleil a rendez-vous avec la lune\nMais la lune n'est pas là et le soleil attend."
                            },
                            {
                                "example_id": "ffa1f66b-3094-42ce-b443-f4be042c92a6",
                                "sense_id": "1bbd1345-d8e2-3567-ba74-405f1bb29810",
                                "text": "… et n’essayez pas de sortir de la circonscription de Palm Springs sans ça, je vous fais coffrer subito."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
