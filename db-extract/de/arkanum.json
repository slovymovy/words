                    },
                    {
                        "translation_id": "6729ec32-5377-46fa-bdfc-555a4358352f",
                        "source_entry_id": "b4dab976-aebd-39e1-9080-a0cc9a46ea80",
                        "source_sense_id": "7f32ec88-8621-36d5-9053-122b7b31711d",
                        "source_sense_description": "Geheimnis, das Geheimgehaltene als Teil einer Geheimlehre",
                        "target_lang_word": "arcane",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arcane",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ffdb09cd-eb3e-3040-9edd-a11b8dff4cbd",
                                        "entry_id": "20e43e29-002c-3bfc-afd1-ada9f582f52c",
                                        "glosses": [
                                            "Qui est secret, mystérieux."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3aa8d3f7-2f23-488c-8f06-be62f2fbb9ec",
                                                "sense_id": "ffdb09cd-eb3e-3040-9edd-a11b8dff4cbd",
                                                "text": "Opération arcane."
                                            },
                                            {
                                                "example_id": "852f516a-4f46-4049-bd7b-ced4ecc4a6ca",
                                                "sense_id": "ffdb09cd-eb3e-3040-9edd-a11b8dff4cbd",
                                                "text": "Peut-être au cours des années survenues, certaines communications arcanes avaient-elles été établies entre le passage abandonné et le monde extérieur."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "arcane",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "121d7837-7c1a-32ae-8fa9-04b8e5a1086e",
                                        "entry_id": "c198ba56-8c79-39a4-b9aa-5ab1f5a53159",
                                        "glosses": [
                                            "Remède secret."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "40bc2166-57ce-3932-a949-762b7e123475",
                                        "entry_id": "c198ba56-8c79-39a4-b9aa-5ab1f5a53159",
                                        "glosses": [
                                            "Carte du jeu de tarot divinatoire."
                                        ],
                                        "tags": [
                                            "Cartes à jouer"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2370b9e3-0dd0-40b6-b013-411891bbd32c",
                                                "sense_id": "40bc2166-57ce-3932-a949-762b7e123475",
                                                "text": "En tarologie, la mort est représentée par l’Arcane XIII qui poussa Gérard de Nerval à se pendre ; cet arcane signifie mort et transformation, pour Serge Marcotoune : « […] »."
                                            },
                                            {
                                                "example_id": "df853573-2adb-4c16-bf28-096d71b9c274",
                                                "sense_id": "40bc2166-57ce-3932-a949-762b7e123475",
                                                "text": "La papesse est assise, elle vous tend le livre de la connaissance ouverte, mais son regard est ailleurs, en direction de la clé que vous offre l’arcane VIIII (l'Hermite), […]."
                                            },
                                            {
                                                "example_id": "de3e1c60-e023-472f-bb20-a0cd257eb813",
                                                "sense_id": "40bc2166-57ce-3932-a949-762b7e123475",
                                                "text": "Une fois qu'elle eut terminé, elle se concentra un court instant puis retourna la dernière lame du tarot. C'était l’arcane de la papesse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a4047e9-ab7c-3fe6-86e5-65913412a0c2",
                                        "entry_id": "c198ba56-8c79-39a4-b9aa-5ab1f5a53159",
                                        "glosses": [
                                            "Secrets, chose mystérieuse et incompréhensible au sens commun."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad25153b-b15d-4d0e-a342-6e4c7b2d244e",
                                                "sense_id": "9a4047e9-ab7c-3fe6-86e5-65913412a0c2",
                                                "text": "Ses pattes torses pouvaient bien le rendre burlesque à un bal des moissons, ce rigodon-là n’avait pas d’arcanes pour lui."
                                            },
                                            {
                                                "example_id": "95539594-871a-4be6-98f3-fb0e4de52db6",
                                                "sense_id": "9a4047e9-ab7c-3fe6-86e5-65913412a0c2",
                                                "text": "Il lui arrivait même de s’émerveiller de la facilité, de la promptitude avec laquelle il avait illuminé ces arcanes, hier encore ténébreux et rébarbatifs."
                                            },
                                            {
                                                "example_id": "36ba0976-44fc-4653-aa91-4a19823bdaf1",
                                                "sense_id": "9a4047e9-ab7c-3fe6-86e5-65913412a0c2",
                                                "text": "Aux petits, j’enseignais à déchiffrer les syllabes ; […] aux grands, je dévoilais les secrets des fractions et même les arcanes de l’hypoténuse."
                                            },
                                            {
                                                "example_id": "c737afe9-8fb1-4c41-a128-ac6a446c4a32",
                                                "sense_id": "9a4047e9-ab7c-3fe6-86e5-65913412a0c2",
                                                "text": "Ce qui distingue un romancier, un dramaturge, du reste des hommes, c’est justement le don de voir de grands arcanes dans les aventures les plus communes. Toutes les aventures sont communes, mais non leurs secrets ressorts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "efa8ea6d-923d-396d-bd1b-bd57067c5624",
                                        "entry_id": "c198ba56-8c79-39a4-b9aa-5ab1f5a53159",
                                        "glosses": [
                                            "Nom donné à un alliage métallique, utilisé autrefois pour l'étamage et dont les ouvriers gardaient la composition secrète, d'où son nom. On disait aussi arcane corralien."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
