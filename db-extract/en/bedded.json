    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "82d3b441-38c0-3bb8-b8bc-73751a4abbec",
                "word": "bedded",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b54f6024-f6a8-3d22-8656-4db5dc1c9302",
                        "entry_id": "82d3b441-38c0-3bb8-b8bc-73751a4abbec",
                        "glosses": [
                            "Furnished with one or more beds; Having (a particular number or type of) beds"
                        ],
                        "tags": [
                            "not-comparable",
                            "often"
                        ],
                        "examples": [
                            {
                                "example_id": "364cb6d9-385a-440e-a49a-75d1aef689e3",
                                "sense_id": "b54f6024-f6a8-3d22-8656-4db5dc1c9302",
                                "text": "three-bedded room"
                            },
                            {
                                "example_id": "3ba7a9b1-f24d-4cd9-afe1-517ed580f250",
                                "sense_id": "b54f6024-f6a8-3d22-8656-4db5dc1c9302",
                                "text": "S.L.M., Ward 20, sleeps in a two-bedded room with D.L.M., over the laundry."
                            },
                            {
                                "example_id": "56701bdc-ab59-4678-a949-7da3672eaf6a",
                                "sense_id": "b54f6024-f6a8-3d22-8656-4db5dc1c9302",
                                "text": "Please reserve one single-bedded and two double-bedded rooms for tomorrow."
                            },
                            {
                                "example_id": "2377bd88-66bc-48b6-b9af-f943da193563",
                                "sense_id": "b54f6024-f6a8-3d22-8656-4db5dc1c9302",
                                "text": "To the right of the superintendent's accommodation were the male, large 20-bedded and the small 5-bedded wards, and to the left the same lay-out of accommodation for female patients."
                            },
                            {
                                "example_id": "0da2fba0-315e-4c52-aea8-c1f37bd7c8db",
                                "sense_id": "b54f6024-f6a8-3d22-8656-4db5dc1c9302",
                                "text": "'Don't,' it said angrily, looking back over its shoulder into the feather-bedded room, 'don't, I say. […]'"
                            }
                        ]
                    },
                    {
                        "sense_id": "08d56095-148f-3a4c-98b3-3a32395bf6b2",
                        "entry_id": "82d3b441-38c0-3bb8-b8bc-73751a4abbec",
                        "glosses": [
                            "Having gone to bed."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "5d5f2718-b25f-499c-a390-136d2fe462b6",
                                "sense_id": "08d56095-148f-3a4c-98b3-3a32395bf6b2",
                                "text": "All silent the bedded house, Silent as the tread of mouse, Save where House-maid Bridget keeps Snoring Orgies as she sleeps , And the Cricket's tender throat , Gives a shrill, unvaried note;"
                            },
                            {
                                "example_id": "26f2cf66-b5d8-4599-a20a-82eddbfb793e",
                                "sense_id": "08d56095-148f-3a4c-98b3-3a32395bf6b2",
                                "text": "His bedded children dumb as death, Nor dared to speak aboon their breath;"
                            },
                            {
                                "example_id": "0ddbf891-00cb-4bb1-92bd-1e5d6aba11be",
                                "sense_id": "08d56095-148f-3a4c-98b3-3a32395bf6b2",
                                "text": "Now and then a member of a bedded family would make a dash for a moment to seize something to eat, and then retire quickly to cover to make his meal."
                            }
                        ]
                    },
                    {
                        "sense_id": "b6c94528-31a7-31d4-9b06-cd4a4077c191",
                        "entry_id": "82d3b441-38c0-3bb8-b8bc-73751a4abbec",
                        "glosses": [
                            "Having sexual experience; not a virgin."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "3dabc94e-875b-4294-aa74-07680c93045b",
                                "sense_id": "b6c94528-31a7-31d4-9b06-cd4a4077c191",
                                "text": "the Queene, as being (I speake in the language of Canaan) the wedded and bedded wife to the king of glory ."
                            },
                            {
                                "example_id": "8c2b95e7-7029-4d8e-b1ea-fb8a7214c9b2",
                                "sense_id": "b6c94528-31a7-31d4-9b06-cd4a4077c191",
                                "text": "Margaret, his \"spouse\" accuses John of impotency, having been his bedded wife for upwards of two years."
                            },
                            {
                                "example_id": "a5950f2c-8a2a-4978-8ced-92ee289a4d38",
                                "sense_id": "b6c94528-31a7-31d4-9b06-cd4a4077c191",
                                "text": "OK, not your lawfully wedded wife, but what was it that witch Radha Sabnis called me –your \"awfully bedded wife.\""
                            },
                            {
                                "example_id": "0f63f45a-8f41-4d21-9fa9-d358f57b727e",
                                "sense_id": "b6c94528-31a7-31d4-9b06-cd4a4077c191",
                                "text": "He began his account by noting that Cassandra 'is a married, nay a bedded wife; your Francis hath lain with a wench' and then related how the groom had acquitted himself:"
                            }
                        ]
                    },
                    {
                        "sense_id": "b38438e6-b20b-3c10-bb0d-73cd43ec90dd",
                        "entry_id": "82d3b441-38c0-3bb8-b8bc-73751a4abbec",
                        "glosses": [
                            "Lying flat."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "b5d4d42f-a310-4934-9cf7-a74611a14c95",
                                "sense_id": "b38438e6-b20b-3c10-bb0d-73cd43ec90dd",
                                "text": "And, as the sleeping soldiers in the alarm, Your bedded hair, like life in excrements, Start up and stand an end."
                            },
                            {
                                "example_id": "7e29320a-eb72-49dd-a34f-96d043ba162c",
                                "sense_id": "b38438e6-b20b-3c10-bb0d-73cd43ec90dd",
                                "text": "A second companion report presents a method for designing systems of vertical bolts to reinforce bedded roof."
                            },
                            {
                                "example_id": "2bfce4ec-fd26-412b-a851-70df28574165",
                                "sense_id": "b38438e6-b20b-3c10-bb0d-73cd43ec90dd",
                                "text": "Higher levels resulted from exposure to bedded than to suspended sediment in all cases except in clams and mussels exposed to OHDP Outer sediments (Table 16)."
                            }
                        ]
                    },
                    {
                        "sense_id": "8d2f2347-fbc0-3c28-bf44-14bdc6450300",
                        "entry_id": "82d3b441-38c0-3bb8-b8bc-73751a4abbec",
                        "glosses": [
                            "Forming or containing a bed or beds (a horizontal deposit of a mineral or ore)."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "9b38503f-d0ea-4423-a34c-9b09f25761b4",
                                "sense_id": "8d2f2347-fbc0-3c28-bf44-14bdc6450300",
                                "text": "This is largely because of their use in coal mines, although roof bolts are used in mining bedded deposits of all kinds potash (New Mexico) , trona (Wyoming), and ores of iron (Alabama), lead (Missouri) , uranium (Utah), lead-zinc (Utah), and copper (Michigan and Arizona)."
                            },
                            {
                                "example_id": "2010a7c3-dd12-4f5b-81ce-cb153df78e10",
                                "sense_id": "8d2f2347-fbc0-3c28-bf44-14bdc6450300",
                                "text": "The acceptance of bedded salt as a viable nuclear waste repository will in part be dependent upon demonstration of the ability to effectively isolate those man-made penetrations, i.e. shafts, boreholds, and tunnels common to the repository site."
                            },
                            {
                                "example_id": "4fd07b14-6bb6-4de2-934b-ad8f1d73520d",
                                "sense_id": "8d2f2347-fbc0-3c28-bf44-14bdc6450300",
                                "text": "Grayish black, medium-bedded, laminated packstone bearing limestone concretions, intercalated with light-gray, thin-bedded grainstone."
                            },
                            {
                                "example_id": "7640921d-2f5c-402d-b580-fdfa2d0b27a7",
                                "sense_id": "8d2f2347-fbc0-3c28-bf44-14bdc6450300",
                                "text": "This leads to a different bedding situation throughout the annular gap dividing the segmental lining into a fully bedded and partially bedded area as shown in Figure 3."
                            }
                        ]
                    },
                    {
                        "sense_id": "0c9d91ab-882f-3634-82a4-a1f5cdf1a101",
                        "entry_id": "82d3b441-38c0-3bb8-b8bc-73751a4abbec",
                        "glosses": [
                            "Growing or arranged in a bed or beds (garden plot or area in which a large number of plants, seaweed, or shellfish are found together.)"
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "13801846-d5fb-4985-9f75-ad6b6b64a5d2",
                                "sense_id": "0c9d91ab-882f-3634-82a4-a1f5cdf1a101",
                                "text": "Who lovest to see the hamadryads dress Their ruffled locks where meeting hazels darken And through whole solemn hours dost sit and hearken The dreary melody of bedded reeds In desolate places, where dark moisture breeds"
                            },
                            {
                                "example_id": "df89d71a-61ad-4014-899b-4b63762e756c",
                                "sense_id": "0c9d91ab-882f-3634-82a4-a1f5cdf1a101",
                                "text": "The cover crops mentioned are superior to a constant use of inorganic fertilizers were a continuous cropping of bedded vegetables are grown."
                            },
                            {
                                "example_id": "fdadf4f1-17a1-4848-be95-883ef1ef12d5",
                                "sense_id": "0c9d91ab-882f-3634-82a4-a1f5cdf1a101",
                                "text": "The arrangement of the great bedded garden is circular and unusual , and the blaze of color is attained by boldy contrasting the vari- ous hues to secure rich effect."
                            }
                        ]
                    },
                    {
                        "sense_id": "e7a38cb2-872e-31ca-9123-5eca1f806872",
                        "entry_id": "82d3b441-38c0-3bb8-b8bc-73751a4abbec",
                        "glosses": [
                            "With a bedding of straw, sand, woodchips, or similar covering the floor."
                        ],
                        "tags": [
                            "not-comparable",
                            "often"
                        ],
                        "examples": [
                            {
                                "example_id": "d831aabd-d850-49d4-98f7-c8f6937e4abb",
                                "sense_id": "e7a38cb2-872e-31ca-9123-5eca1f806872",
                                "text": "Hogs in the non-bedded house had significantly longer carcasses ( P < .01 ) than hogs in the bedded house."
                            },
                            {
                                "example_id": "7b4c4a90-30c2-48d1-97f2-badaa56f3adb",
                                "sense_id": "e7a38cb2-872e-31ca-9123-5eca1f806872",
                                "text": "Loose housing with a bedded area overcomes the problem of mobility and allows physical contact between animals, but the animals are still housed in a restricted space and may not be able to escape completely from an aggressive dominant cow."
                            },
                            {
                                "example_id": "13abda1c-443a-4d11-8ee7-6a6554a0ba5c",
                                "sense_id": "e7a38cb2-872e-31ca-9123-5eca1f806872",
                                "text": "Various epidemiologic studies have shown a significantly higher prevalence of lameness in herds using mattress-based freestalls compared with deep-bedded stalls (mostly sand)."
                            },
                            {
                                "example_id": "8783276e-5b1f-49fa-8df9-c6bacd342083",
                                "sense_id": "e7a38cb2-872e-31ca-9123-5eca1f806872",
                                "text": "Some manure handling systems incorporate sand separating equipment or sand-settling lanes to separate the sand from the sand-laden manure to be able to recycle the sand and use it in the sand-bedded freestalls."
                            },
                            {
                                "example_id": "925744a9-dbb3-4f22-8f37-73baba4d8713",
                                "sense_id": "e7a38cb2-872e-31ca-9123-5eca1f806872",
                                "text": "In straw bedded pens pigs take less time for lying down, spend more time lying laterally and sows show increased total lying time."
                            }
                        ]
                    }
                ],
