{
    "word_family": [
        "deceased"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3e89ebc7-039a-37e8-81c9-0ef0aa60baf8",
                    "sense_definition": "The act of dying; the end of life.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "death",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The family gathered to settle the estate following the <w>decease</w> of their elderly patriarch.",
                            "target_lang_translations": {
                                "ru": "Семья собралась, чтобы распорядиться имуществом после <w>кончины</w> их престарелого патриарха."
                            }
                        },
                        {
                            "text": "Upon his <w>decease</w>, the title and all associated properties passed directly to his eldest daughter.",
                            "target_lang_translations": {
                                "ru": "После его <w>смерти</w> титул и вся сопутствующая собственность перешли непосредственно к его старшей дочери."
                            }
                        }
                    ],
                    "synonyms": [
                        "death",
                        "demise",
                        "expiration",
                        "passing"
                    ],
                    "antonyms": [
                        "birth",
                        "life"
                    ],
                    "common_phrases": [
                        "upon his decease",
                        "date of decease"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal or legal context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт умирания; конец жизни."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кончина",
                                "target_lang_sense_clarification": "официальный или возвышенный термин для смерти"
                            },
                            {
                                "target_lang_word": "смерть",
                                "target_lang_sense_clarification": "в юридическом или формальном контексте"
                            },
                            {
                                "target_lang_word": "уход из жизни",
                                "target_lang_sense_clarification": "вежливое обозначение смерти"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7becba34-b32c-3c8d-a02a-f58f806af582",
                    "sense_definition": "To stop living; to pass away.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "dying",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The elderly man <w>deceased</w> peacefully in his sleep surrounded by his loved ones.",
                            "target_lang_translations": {
                                "ru": "Пожилой мужчина мирно <w>скончался</w> во сне в окружении своих близких."
                            }
                        },
                        {
                            "text": "Legal documents often specify what happens to assets if a beneficiary should <w>decease</w> before the testator.",
                            "target_lang_translations": {
                                "ru": "Юридические документы часто определяют, что происходит с активами, если бенефициар <w>умрет</w> раньше завещателя."
                            }
                        }
                    ],
                    "synonyms": [
                        "die",
                        "expire",
                        "perish",
                        "pass away"
                    ],
                    "antonyms": [
                        "live",
                        "be born"
                    ],
                    "common_phrases": [
                        "should he decease"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal or legal context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Перестать жить; скончаться."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скончаться",
                                "target_lang_sense_clarification": "официальный термин"
                            },
                            {
                                "target_lang_word": "умереть",
                                "target_lang_sense_clarification": "в формальных документах"
                            },
                            {
                                "target_lang_word": "преставиться",
                                "target_lang_sense_clarification": "устаревший или книжный стиль"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e73d6b95-b247-32bf-9276-fdf72cc7bd06",
                    "sense_definition": "To cause someone or something to die.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "killing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient text describes a poison so potent it could <w>decease</w> an elephant in minutes.",
                            "target_lang_translations": {
                                "ru": "Древний текст описывает яд настолько сильный, что он мог <w>умертвить</w> слона за считанные минуты."
                            }
                        },
                        {
                            "text": "It is rare to see the verb used transitively to mean to <w>decease</w> another person in modern English.",
                            "target_lang_translations": {
                                "ru": "В современном английском языке редко можно встретить этот глагол в переходном значении, означающем <w>лишение жизни</w> другого человека."
                            }
                        }
                    ],
                    "synonyms": [
                        "kill",
                        "slay"
                    ],
                    "antonyms": [
                        "revive",
                        "animate"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in this transitive sense today"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Стать причиной смерти кого-либо или чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "умертвить",
                                "target_lang_sense_clarification": "вызвать смерть (архаичное использование)"
                            },
                            {
                                "target_lang_word": "лишить жизни",
                                "target_lang_sense_clarification": "в переходном значении"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}