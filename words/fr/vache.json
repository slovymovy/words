            "pos": "noun",
            "senses": [
                {
                    "sense_id": "51b104ef-f408-35f5-a736-2351deb6c77f",
                    "sense_definition": "Mammifère herbivore domestique femelle de l'espèce bovine, élevé principalement pour la production de lait ou de viande.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "bovide",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le fermier emmène chaque matin les <w>vaches</w> dans le pré pour brouter l'herbe fraîche."
                        },
                        {
                            "text": "Mon grand-père trait sa <w>vache</w> tous les jours avant le lever du soleil."
                        }
                    ],
                    "synonyms": [
                        "Bos taurus",
                        "meumeu"
                    ],
                    "common_phrases": [
                        "vache laitière",
                        "lait de vache",
                        "troupeau de vaches"
                    ]
                },
                {
                    "sense_id": "bb078fae-0bff-3451-bdc9-c8bdd0bf4388",
                    "sense_definition": "Personne méchante, perfide ou particulièrement déloyale.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "insulte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce garçon refuse toujours d'aider ses camarades, c'est vraiment une <w>vache</w>."
                        },
                        {
                            "text": "Elle a agi en vraie <w>vache</w> en révélant notre secret à tout le monde."
                        }
                    ],
                    "common_phrases": [
