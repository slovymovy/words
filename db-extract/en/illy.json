                        "examples": [
                            {
                                "example_id": "cccca77a-4882-4884-b754-b09155387b47",
                                "sense_id": "5b7f8e7a-0e35-3683-b97d-993d517f6771",
                                "text": "The domestic presence of Lucy had begun to produce a remarkable effect upon Pierre. Sometimes, to the covertly watchful eye of Isabel, he would seem to look upon Lucy with an expression illy befitting their singular and so-supposed merely cousinly relation; […]"
                            },
                            {
                                "example_id": "db127e49-8748-4624-aebc-ac72040b19ad",
                                "sense_id": "5b7f8e7a-0e35-3683-b97d-993d517f6771",
                                "text": "Nor was this less ominous than the rattle of musketry, for it suggested but a single solution to the little band of rescuers—that the illy garrisoned village had already succumbed to the onslaught of a superior force."
                            }
                        ]
                    }
