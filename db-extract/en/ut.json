                    },
                    {
                        "translation_id": "2df926d5-adb5-4ea4-8139-2fc30fd699bc",
                        "source_entry_id": "0fb9f4a7-2119-3cd1-9684-f91e90bd7af3",
                        "source_sense_id": "c9605e6e-76b5-3705-aa43-9484780b27f4",
                        "source_sense_description": "first note of a major scale",
                        "target_lang_word": "ut",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ut",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "defc86cf-a233-392e-9dac-25bcf856546e",
                                        "entry_id": "abee6bad-6bb0-3880-bfed-ae6499e730d3",
                                        "glosses": [
                                            "La première note de l’échelle des sons."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1dd7814-d024-4a14-94a4-91db6194f696",
                                                "sense_id": "defc86cf-a233-392e-9dac-25bcf856546e",
                                                "text": "La clef d’ut."
                                            },
                                            {
                                                "example_id": "abad6b32-dc12-49c3-bcd1-caedf0e7d2c9",
                                                "sense_id": "defc86cf-a233-392e-9dac-25bcf856546e",
                                                "text": "La gamme d’ut."
                                            },
                                            {
                                                "example_id": "a6515542-8fbc-430c-96d7-9673fe4bc812",
                                                "sense_id": "defc86cf-a233-392e-9dac-25bcf856546e",
                                                "text": "La célèbre Messe en ut mineur de Mozart, demeurée inachevée."
                                            },
                                            {
                                                "example_id": "4dcfb954-bef3-4d44-a3fe-66fb3b5edff7",
                                                "sense_id": "defc86cf-a233-392e-9dac-25bcf856546e",
                                                "text": "Dans la rue, dans les cours, partout, il jetait en l’air des ut brillants que les murs renvoyaient comme des balles de cuivre…"
                                            },
                                            {
                                                "example_id": "3e7bbf01-4533-4523-877e-d67637254a79",
                                                "sense_id": "defc86cf-a233-392e-9dac-25bcf856546e",
                                                "text": "Il passait son temps à ça. Trousser une femme, la posséder en cinq minutes et, vite, vite, courir au piano pour vérifier si ça ne lui avait pas éraillé son ut !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "888ebd4e-618e-3073-84e2-7a073d73eebe",
                                        "entry_id": "abee6bad-6bb0-3880-bfed-ae6499e730d3",
                                        "glosses": [
                                            "Signe qui représente cette première note."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9bb8cfc-da1c-42b8-a55e-e2f30f13b6de",
                                                "sense_id": "888ebd4e-618e-3073-84e2-7a073d73eebe",
                                                "text": "Il y a un dièse devant cet ut."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "940fb988-6d02-3ed3-ace8-181b5f9deac5",
                                        "entry_id": "abee6bad-6bb0-3880-bfed-ae6499e730d3",
                                        "glosses": [
                                            "Clef d’ut."
                                        ],
                                        "tags": [
                                            "Abréviation"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f030a6bb-8bac-4b33-b219-d681f23f21b3",
                                                "sense_id": "940fb988-6d02-3ed3-ace8-181b5f9deac5",
                                                "text": "Pour transposer une seconde en dessous, il faut lire en ut quatre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
