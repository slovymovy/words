                                        "glosses": [
                                            "onmogelijk om met zintuigen of instrumenten waar te nemen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b20f21e3-7cf3-4d55-8017-59ecbda6ef68",
                                                "sense_id": "867012b1-b00d-3f87-b9f2-f04530411f3b",
                                                "text": "Radioactieve straling is met de menselijke zintuigen onwaarneembaar."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a5947883-bd2b-473f-986c-8fb7bdf48a99",
                        "source_entry_id": "c16d9b81-d572-36cb-94d9-356894196520",
                        "source_sense_description": "not perceptible",
                        "target_lang_word": "onzichtbaar",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "onzichtbaar",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "2df6c3a8-1365-3ecc-968a-c3aec66917b1",
                                        "entry_id": "c36affb2-5014-39d7-92e8-ff77012be05d",
                                        "glosses": [
                                            "niet waarneembaar voor het oog"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee89e6c0-2267-4649-94be-2936b306ab56",
                                                "sense_id": "2df6c3a8-1365-3ecc-968a-c3aec66917b1",
                                                "text": "De onzichtbare man was een bekend televisieserie"
                                            },
                                            {
                                                "example_id": "0b796350-e128-47a6-bc52-4dc9bcea0bf8",
                                                "sense_id": "2df6c3a8-1365-3ecc-968a-c3aec66917b1",
                                                "text": "Alles stond nu in het teken van het zo snel mogelijk afmaken van de trail, voordat sneeuw het pad onzichtbaar en onbegaanbaar zou maken."
                                            },
                                            {
                                                "example_id": "09952071-09d4-4f55-9eed-1fec72e421b9",
                                                "sense_id": "2df6c3a8-1365-3ecc-968a-c3aec66917b1",
                                                "text": "„Het was een bewolkte, zwoele namiddag; de matrozen hingen lui op het dek rond of staarden wezenloos over het loodkleurige water. Queequeg en ik waren rustig een zogenaamde zwaardmat aan het weven als extra sjorring voor onze sloep. Om ons heen was alles zo stil en gedempt en toch ook vervuld van wat ging komen en in de lucht hing zo’n mijmerachtige betovering dat die zwijgende mannen stuk voor stuk in hun eigen onzichtbare ik leken op te gaan."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a8c21735-3c34-4eee-8ab5-8ce330383a39",
                        "source_entry_id": "c16d9b81-d572-36cb-94d9-356894196520",
                        "source_sense_description": "not perceptible",
                        "target_lang_word": "onmerkbaar",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "onmerkbaar",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "0b41afa9-c49e-3029-87c6-215f3756ce0a",
                                        "entry_id": "851a591d-0f9c-3e1c-960f-f5af77ea35bf",
                                        "glosses": [
                                            "in het geheel niet opvallend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33196f06-2f4d-4255-bae4-3a8dc0bb633b",
                                                "sense_id": "0b41afa9-c49e-3029-87c6-215f3756ce0a",
                                                "text": "Deze onmerkbare besmetting leidt uiteindelijk tot een zware ziekte."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cf6f16a9-2747-4b7d-acad-556cf1471e73",
                        "source_entry_id": "c16d9b81-d572-36cb-94d9-356894196520",
                        "source_sense_description": "not perceptible",
