                "senses": [
                    {
                        "sense_id": "5c553e0a-32fe-3e85-b804-9bfacde58b2d",
                        "entry_id": "3d631af0-3f59-3d08-a21e-1d6c69c31599",
                        "glosses": [
                            "adversity, misfortune"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fadb2ee5-f8b1-4dff-930d-e9b8c4b988fa",
                                "sense_id": "5c553e0a-32fe-3e85-b804-9bfacde58b2d",
                                "text": "— А, э́то вы, — сказа́л Пьер с рассе́янным и недово́льным ви́дом. — А я вот рабо́таю, — сказа́л он, ука́зывая на тетра́дь с тем ви́дом спасе́ния от невзго́д жи́зни, с кото́рым смо́трят несчастли́вые лю́ди на свою́ рабо́ту.",
                                "translation": "“Ah, it's you!” said Pierre with a preoccupied, dissatisfied air. “And I, you see, am hard at it.” He pointed to his manuscript book with that air of escaping from the ills of life with which unhappy people look at their work.",
                                "english": "“Ah, it's you!” said Pierre with a preoccupied, dissatisfied air. “And I, you see, am hard at it.” He pointed to his manuscript book with that air of escaping from the ills of life with which unhappy people look at their work."
                            },
                            {
                                "example_id": "8bed6f8f-72c1-492b-89d8-e8d2628d6f6f",
                                "sense_id": "5c553e0a-32fe-3e85-b804-9bfacde58b2d",
                                "text": "Быва́ют заня́тия, спаси́тельные в мину́ту душе́вной невзго́ды.",
                                "translation": "Certain pastimes can be salutary in moments of inner tribulation.",
                                "english": "Certain pastimes can be salutary in moments of inner tribulation."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
