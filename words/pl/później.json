                {
                    "sense_id": "7dd3c02e-4a4f-314b-b556-9f357c694caa",
                    "sense_definition": "Stopień wyższy od przysłówka <w>późno</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "comparative_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dzisiaj słońce zachodzi <w>później</w> niż wczoraj.",
                            "target_lang_translations": {
                                "ru": "Сегодня солнце заходит <w>позже</w>, чем вчера.",
                                "en": "Today the sun sets <w>later</w> than yesterday.",
                                "nl": "Vandaag gaat de zon <w>later</w> onder dan gisteren.",
                                "de": "Heute geht die Sonne <w>später</w> unter als gestern.",
                                "fr": "Aujourd'hui, le soleil se couche <w>plus tard</w> qu'hier.",
                                "it": "Oggi il sole tramonta <w>più tardi</w> rispetto a ieri.",
                                "cs": "Dnes slunce zapadá <w>později</w> než včera.",
                                "tr": "Bugün güneş dünden <w>daha geç</w> batıyor.",
                                "es": "Hoy el sol se pone <w>más tarde</w> que ayer.",
                                "zh": "今天太阳落山比昨天<w>晚</w>。"
                            }
                        },
                        {
                            "text": "Im <w>później</w> pójdziesz spać, tym trudniej będzie rano wstać.",
                            "target_lang_translations": {
                                "ru": "Чем <w>позже</w> ты ляжешь спать, тем труднее будет встать утром.",
                                "en": "The <w>later</w> you go to sleep, the harder it will be to get up in the morning.",
                                "nl": "Hoe <w>later</w> je naar bed gaat, hoe moeilijker het zal zijn om 's ochtends op te staan.",
                                "de": "Je <w>später</w> du schlafen gehst, desto schwieriger wird es sein, morgens aufzustehen.",
                                "fr": "Plus tu iras te coucher <w>tard</w>, plus il sera difficile de se lever le matin.",
                                "it": "Più <w>tardi</w> vai a dormire, più sarà difficile alzarsi al mattino.",
                                "cs": "Čím <w>později</w> půjdeš spát, tím hůř se ti bude ráno vstávat.",
                                "tr": "Ne kadar <w>geç</w> yatarsan, sabah kalkmak o kadar zor olacak.",
                                "es": "Cuanto <w>más tarde</w> te vayas a dormir, más difícil será levantarse por la mañana.",
                                "zh": "你睡得越<w>晚</w>，早上就越难起床。"
                            }
                        }
