                                "example_id": "12de9193-40e0-47fe-9009-460adb59205b",
                                "sense_id": "693f6b6f-aeda-3100-857d-665bcf8b57c4",
                                "text": "„Indien hat am Samstag erfolgreich eine taktische Atomrakete des Typs Prithvi-II getestet.“"
                            },
                            {
                                "example_id": "5fd7c597-6b6b-452c-b477-6a86baafb7d8",
                                "sense_id": "693f6b6f-aeda-3100-857d-665bcf8b57c4",
                                "text": "„In dieser Nacht meldet das System den Start einer amerikanischen Atomrakete.“"
                            }
                        ],
