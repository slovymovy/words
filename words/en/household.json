{
    "word_family": [
        "householder"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "dcc481b3-d995-35b5-a2e1-369e34b2a3a5",
                    "sense_definition": "All the people who live together in a single home.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "group_of_people",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Every member of the <w>household</w> helps to keep the kitchen clean.",
                            "target_lang_translations": {
                                "ru": "Каждый член <w>семьи</w> помогает поддерживать чистоту на кухне.",
                                "tr": "<w>Ev halkının</w> her bir üyesi mutfağın temiz kalmasına yardımcı olur.",
                                "zh": "<w>家庭</w>里的每一位成员都帮忙保持厨房清洁。"
                            }
                        },
                        {
                            "text": "The survey collects data on the average income of each <w>household</w>.",
                            "target_lang_translations": {
                                "ru": "Опрос собирает данные о среднем доходе каждого <w>домохозяйства</w>.",
                                "tr": "Anket, her bir <w>hanenin</w> ortalama geliri hakkında veri topluyor.",
                                "zh": "这项调查收集了每个<w>住户</w>的平均收入数据。"
                            }
                        }
                    ],
                    "synonyms": [
                        "family",
                        "home",
                        "occupants"
                    ],
                    "common_phrases": [
                        "head of the household",
                        "single-parent household",
                        "low-income household"
                    ],
                    "target_lang_definitions": {
                        "ru": "Все люди, живущие вместе в одном жилище; семья как экономическая единица.",
                        "tr": "Tek bir evde birlikte yaşayan tüm insanlar; ev halkı veya hane.",
                        "zh": "居住在同一屋檐下的所有成员；作为经济或统计单位的家庭。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "домохозяйство",
                                "target_lang_sense_clarification": "экономическая или статистическая единица"
                            },
                            {
                                "target_lang_word": "семья",
                                "target_lang_sense_clarification": "группа людей, живущих вместе"
                            },
                            {
                                "target_lang_word": "дом",
                                "target_lang_sense_clarification": "разговорное обозначение всех живущих в доме"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "hane",
                                "target_lang_sense_clarification": "istatistiki veya ekonomik birim olarak evde yaşayanlar"
                            },
                            {
                                "target_lang_word": "ev halkı",
                                "target_lang_sense_clarification": "aynı evde birlikte yaşayan insanlar"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "家庭",
                                "target_lang_sense_clarification": "指共同生活的人群"
                            },
                            {
                                "target_lang_word": "住户",
                                "target_lang_sense_clarification": "指统计学意义上的居住单位"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0146c015-143b-3e95-9eef-53a0795a4bb4",
                    "sense_definition": "A family line or ancestry, often noble or royal.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "ancestry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The prince fought to restore the honor of his <w>household</w>.",
                            "target_lang_translations": {
                                "ru": "Принц сражался, чтобы восстановить честь своего <w>рода</w>.",
                                "tr": "Prens, <w>hanedanının</w> onurunu geri kazanmak için savaştı.",
                                "zh": "王子为恢复他<w>家族</w>的荣誉而战。"
                            }
                        },
                        {
                            "text": "Many legends were written about the fall of that ancient <w>household</w>.",
                            "target_lang_translations": {
                                "ru": "О падении этого древнего <w>дома</w> было сложено множество легенд.",
                                "tr": "O kadim <w>sülalenin</w> çöküşü hakkında pek çok efsane yazıldı.",
                                "zh": "关于那个古老<w>家族</w>的衰落，流传着许多传说。"
                            }
                        }
                    ],
                    "synonyms": [
                        "lineage",
                        "house",
                        "ancestry"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in historical or literary contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Семейная линия или родословная, часто знатная или королевская.",
                        "tr": "Genellikle soylu veya kraliyet mensubu bir aile soyu.",
                        "zh": "家族或血统，常指贵族或皇室。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "род",
                                "target_lang_sense_clarification": "происхождение, династия"
                            },
                            {
                                "target_lang_word": "дом",
                                "target_lang_sense_clarification": "правящая династия или знатная семья"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "hanedan",
                                "target_lang_sense_clarification": "soylu aile veya soy"
                            },
                            {
                                "target_lang_word": "sulale",
                                "target_lang_sense_clarification": "soy, aile zinciri"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "家族",
                                "target_lang_sense_clarification": "指血缘关系或世系"
                            },
                            {
                                "target_lang_word": "门第",
                                "target_lang_sense_clarification": "指显赫的家族地位"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "fd98ddbf-529f-33e0-a1b4-2e40b1831944",
                    "sense_definition": "Relating to a house or the people living in it.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "domestic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We spent the weekend shopping for <w>household</w> goods and groceries.",
                            "target_lang_translations": {
                                "ru": "Мы провели выходные, покупая <w>хозяйственные</w> товары и продукты.",
                                "tr": "Hafta sonunu <w>ev</w> eşyaları ve gıda alışverişi yaparak geçirdik.",
                                "zh": "我们周末去采购了<w>家用</w>物品和食品杂货。"
                            }
                        },
                        {
                            "text": "Sharing <w>household</w> chores makes life easier for everyone in the family.",
                            "target_lang_translations": {
                                "ru": "Разделение <w>домашних</w> обязанностей облегчает жизнь всем в семье.",
                                "tr": "<w>Ev</w> işlerini paylaşmak ailedeki herkes için hayatı kolaylaştırır.",
                                "zh": "分担<w>家务</w>让家里的每个人生活得更轻松。"
                            }
                        }
                    ],
                    "synonyms": [
                        "domestic",
                        "home"
                    ],
                    "antonyms": [
                        "commercial",
                        "industrial"
                    ],
                    "common_phrases": [
                        "household chores",
                        "household items",
                        "household waste",
                        "household appliances"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к дому, ведению хозяйства или людям, живущим в нем.",
                        "tr": "Bir evle veya o evde yaşayan insanlarla ilgili olan.",
                        "zh": "与房屋、家务或居住者相关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бытовой",
                                "target_lang_sense_clarification": "относящийся к быту, технике, отходам"
