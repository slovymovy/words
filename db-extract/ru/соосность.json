                    {
                        "translation_id": "933a71f7-d751-412d-bd36-d4fa985c994c",
                        "source_entry_id": "dfb25aa2-f1ea-3232-a3b8-41c31cf635c6",
                        "source_sense_id": "2ab0e399-d5ea-3715-9f8c-cc267e80cd8d",
                        "target_lang_word": "alignement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alignement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6e54e32b-698b-3ac9-81a4-e4ae086a4c75",
                                        "entry_id": "d92b5c0d-11e9-34eb-af0e-900afb3b480b",
                                        "glosses": [
                                            "Action d’aligner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b212fc5-65c4-4f5a-9347-b854cc91c34f",
                                                "sense_id": "6e54e32b-698b-3ac9-81a4-e4ae086a4c75",
                                                "text": "Alignement des livres dans une bibliothèque, des allées dans un jardin."
                                            },
                                            {
                                                "example_id": "68678274-d003-4ae3-93d9-c5fb78445a53",
                                                "sense_id": "6e54e32b-698b-3ac9-81a4-e4ae086a4c75",
                                                "text": "Prendre des alignements : Il a mal pris ses alignements."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98f96a1e-85b5-31bc-b84d-e2060d06a164",
                                        "entry_id": "d92b5c0d-11e9-34eb-af0e-900afb3b480b",
                                        "glosses": [
                                            "Ligne indiquée par les services de la voirie pour la direction d’une rue."
                                        ],
                                        "tags": [
                                            "Urbanisme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61aff53c-54e9-4822-8c19-37d9564855e0",
                                                "sense_id": "98f96a1e-85b5-31bc-b84d-e2060d06a164",
                                                "text": "J'aimais le triangle de bitume désert que ménageait notre rue Vandamme, en vue d'une improbable remise à l'alignement."
                                            },
                                            {
                                                "example_id": "3ead192c-34fe-42b0-b265-713dcbfd373b",
                                                "sense_id": "98f96a1e-85b5-31bc-b84d-e2060d06a164",
                                                "text": "Il fallait, aussi, substituer aux grandes percées, rocades ou radiales, la continuation du réseau viaire parisien, en abandonnant la multitude d’alignements nouveaux envisagés à la période précédente et dont le résultat le plus tangible avait été la création de ces « dents creuses » qui déparent tant de rues parisiennes, sans espoir de voir l’alignement général de la voie réalisé dans un délai raisonnable."
                                            },
                                            {
                                                "example_id": "3aff1874-2ef5-4238-8144-3bbdb9266b1a",
                                                "sense_id": "98f96a1e-85b5-31bc-b84d-e2060d06a164",
                                                "text": "Toutefois, la dimension des rues n'est pas le seul sujet qui préoccupe les urbanistes réformateurs. Ceux-ci s'intéressent aussi à l’alignement des voies, la hauteur des constructions, les mesures contre les incendies, les noms et numérotation des rues, le lotissement régulier, etc."
                                            },
                                            {
                                                "example_id": "a540239d-ad22-4f17-9f88-9fec1c4e6a99",
                                                "sense_id": "98f96a1e-85b5-31bc-b84d-e2060d06a164",
                                                "text": "Cette maison est, n’est pas sur alignement. Cette rue est, n’est pas dans l’alignement, à l’alignement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5cd5c8c1-0d86-34d8-b184-5ca41fda63d7",
                                        "entry_id": "d92b5c0d-11e9-34eb-af0e-900afb3b480b",
                                        "glosses": [
                                            "Ligne d’objets, placé selon une orientation voulue."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eeba3484-f98d-49db-8292-8c800ac2d5d8",
                                                "sense_id": "5cd5c8c1-0d86-34d8-b184-5ca41fda63d7",
                                                "text": "Mais il y avait tout près un dénivellement de terrain à franchir et un alignement d’arbres à passer."
                                            },
                                            {
                                                "example_id": "b2e643cc-0921-4a7a-9f98-00b294748c8e",
                                                "sense_id": "5cd5c8c1-0d86-34d8-b184-5ca41fda63d7",
                                                "text": "La Chiffonne en longea la côte occidentale, doubla la pointe Nord et, suivant les falaises de l'Est, moins anfractueuses, pénétra dans un grand port naturel, protégé par un alignement de gros rochers et de petits îlots."
                                            },
                                            {
                                                "example_id": "810b0fcd-75f9-43de-a9c1-1d5f2a9d6fd9",
                                                "sense_id": "5cd5c8c1-0d86-34d8-b184-5ca41fda63d7",
                                                "text": "Ainsi, en une après-midi, un agriculteur repoussa en limite de parcelle une quarantaine de menhirs de l’alignement de Landaoudec en Crozon, alignement qui avait déjà souffert de l'implantation d'un fort napoléonien puis de casemates et blockhaus pendant la seconde guerre mondiale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7df98226-f8d3-3e1a-921a-daf0e3763c47",
                                        "entry_id": "d92b5c0d-11e9-34eb-af0e-900afb3b480b",
                                        "glosses": [
                                            "Mise en rangs d'une troupe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5ac30ab-991e-4a3d-9ba6-c8f0e2cefb78",
                                                "sense_id": "7df98226-f8d3-3e1a-921a-daf0e3763c47",
                                                "text": "Un bon alignement."
                                            },
                                            {
                                                "example_id": "2bd5bec3-0465-4a6e-9e30-c7b4699145aa",
                                                "sense_id": "7df98226-f8d3-3e1a-921a-daf0e3763c47",
                                                "text": "Un alignement défectueux."
                                            },
                                            {
                                                "example_id": "e599bb7e-5b4a-4780-a808-afd336e27b20",
                                                "sense_id": "7df98226-f8d3-3e1a-921a-daf0e3763c47",
                                                "text": "Se jeter en dehors de l’alignement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60bd0f12-46d5-3a10-8ac9-900d2f5197ad",
                                        "entry_id": "d92b5c0d-11e9-34eb-af0e-900afb3b480b",
                                        "glosses": [
                                            "Fait de positionner un élément d’une certaine façon par rapport aux autres."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a87ef6ff-e654-30b9-9801-e5935da9812d",
                                        "entry_id": "d92b5c0d-11e9-34eb-af0e-900afb3b480b",
                                        "glosses": [
                                            "Procédé qui consiste à disposer des séquences de nucléotides ou d’acides aminés les unes au-dessous des autres afin de les comparer."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
