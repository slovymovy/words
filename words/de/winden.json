                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "luftbewegung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die alten Segelschiffe trotzten den starken <w>Winden</w> auf dem stürmischen Ozean."
