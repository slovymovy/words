                ],
                "senses": [
                    {
                        "sense_id": "1554f0e4-d9fa-3347-b680-19defb166f5f",
                        "entry_id": "6ac47c5b-6bda-3355-916d-4ac956167298",
                        "glosses": [
                            "ein Kinderspiel: Wenn ein Begriff zwei oder noch mehr Bedeutungen hat, dann wird er Teekesselchen genannt: „Mein Teekesselchen ist …“. Teekesselchen ist hier ein Platzhalter für Begriff/Wort."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "243694c5-7dad-44cf-8432-5cb17bc90e26",
                                "sense_id": "1554f0e4-d9fa-3347-b680-19defb166f5f",
                                "text": "„An meinem Teekesselchen melden sich Gäste bei der Ankunft im Hotel an. Und dieses Teekesselchen beschreibt auch die Qualität des Radios.“ (Empfang)"
                            },
                            {
                                "example_id": "dc29a5dc-c7ef-4e63-942b-8cd2f765a658",
                                "sense_id": "1554f0e4-d9fa-3347-b680-19defb166f5f",
                                "text": "Bekannte und bei Kindern meist als erste benutzte Beispiele für Teekesselchen sind „Schloss“, „Bank“, und „Ball“ und das Verb „lesen“."
                            },
                            {
                                "example_id": "073ad7ce-bc43-4c6a-85cb-6d95d93d8334",
                                "sense_id": "1554f0e4-d9fa-3347-b680-19defb166f5f",
                                "text": "Teekesselchen - Das schwerste Erinnere Dich aller Zeiten: Gesucht sind Paare mit identischem Begriff, aber unterschiedlicher Bedeutung. So kann Pony beispielsweise einen Haarschnitt oder ein Kleinpferd beschreiben."
                            },
                            {
                                "example_id": "9e13cc01-bac4-4c97-a315-e314d7ada3b9",
                                "sense_id": "1554f0e4-d9fa-3347-b680-19defb166f5f",
                                "text": "„Wir spielen Teekesselchen raten.“"
                            },
                            {
                                "example_id": "eed31240-d7c6-4d24-a9ad-69f1bfd61c27",
                                "sense_id": "1554f0e4-d9fa-3347-b680-19defb166f5f",
                                "text": "Das Wort „Teekesselchen“ ist selbst ein Teekesselchen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ecfad8c6-7b42-3a8f-8425-09a95adc66b3",
                        "entry_id": "6ac47c5b-6bda-3355-916d-4ac956167298",
                        "glosses": [
                            "kleiner Teekessel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ebebb683-9aec-4912-96e3-e2b74efaed69",
                                "sense_id": "ecfad8c6-7b42-3a8f-8425-09a95adc66b3",
                                "text": "„Mara mochte den Geruch eigentlich nicht, und viel zu oft hatte ihr das eigentlich so niedliche Teekesselchen mit seiner Spuckerei die Hand verbrüht.“"
                            },
                            {
                                "example_id": "eedb65d9-0bc4-44a6-a52b-0c93d35d8c8d",
                                "sense_id": "ecfad8c6-7b42-3a8f-8425-09a95adc66b3",
                                "text": "„Auf dem Bahnsteig wenige Menschen, eben erst wachgewordene Passagiere mit Teekesselchen in den Händen, Soldaten, eine dralle Bäuerin, die zwei große flache Körbe trägt, aus denen der duftende Dampf gekochter Maiskolben – goldener Früchte aus Aladins Wundergarten – in weißblauen Kringeln emporsteigt.“"
                            },
                            {
                                "example_id": "10741557-823d-4e03-8a71-4beb76fd97e1",
                                "sense_id": "ecfad8c6-7b42-3a8f-8425-09a95adc66b3",
                                "text": "„Unterhalb des Sommerdreiecks liegen die Sternbilder Schütze (Sgr) und Skorpion (Sco), deren hellste Sterne wie ein Teekesselchen neben bzw. ein Edelsteinbäumchen auf den hellsten Wolken der Milchstraße liegen.“"
                            },
                            {
                                "example_id": "6aa3537b-3dba-4cf7-b895-4301b0f1749f",
                                "sense_id": "ecfad8c6-7b42-3a8f-8425-09a95adc66b3",
                                "text": "„Dabei wird der Tee als sawarka, also starker Sud, aufgebrüht und auf den Deckel des samowars gesetzt, wo das kleine Teekesselchen durch den Dampf warm gehalten wird.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
