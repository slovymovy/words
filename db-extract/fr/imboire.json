                "senses": [
                    {
                        "sense_id": "5644d8a5-9f08-3792-a7e2-c6cca884fd0c",
                        "entry_id": "87b4713c-d13c-3297-901a-eb2a13cbd657",
                        "glosses": [
                            "Variante de emboire dans le sens d’imbiber."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "2fb0577f-5aa2-4587-ab05-74227107e995",
                                "sense_id": "5644d8a5-9f08-3792-a7e2-c6cca884fd0c",
                                "text": "… un solitaire qui, vivant peu avec les hommes, a moins d'occasion de s’imboire de leur préjugés, et plus de temps pour réfléchir sur ce qui le frappe quand il commerce avec eux."
                            }
                        ]
