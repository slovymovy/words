                        "entry_id": "8ba461ed-eeaa-337c-8642-c8fcd60741e2",
                        "glosses": [
                            "Type de sol argileux et rouge, propice à l’agriculture."
                        ],
                        "tags": [
                            "Maroc"
                        ],
                        "examples": [
                            {
                                "example_id": "9fd9e40e-bbc1-4b02-a2de-c297ec6894b6",
                                "sense_id": "91535c0e-5830-3abb-aa86-78ee1e7a28a5",
                                "text": "Grâce à la nature du sol (tirs et hamri) et à l’abondance des précipitations, une grande partie de la zone côtière se prête admirablement à l’exploitation agricole."
                            },
                            {
                                "example_id": "6732b118-7f12-4506-8bf0-939c297d10f9",
                                "sense_id": "91535c0e-5830-3abb-aa86-78ee1e7a28a5",
                                "text": "Les sols lourds (texture très fine) et rouges, appelés par les paysans hamri, se trouvent principalement sur les alluvions de l’Amirien et du Soltanien."
                            },
                            {
                                "example_id": "824b393a-7d0f-48cb-bfab-91834c207e81",
                                "sense_id": "91535c0e-5830-3abb-aa86-78ee1e7a28a5",
                                "text": "Essais faits à la Station de Sidi Slimane sur sols de type tirs et hamri, argileux, compacts, dépourvus de calcaire dans les horizons supérieurs."
                            }
                        ]
                    }
