                                                "sense_id": "3a75e8ae-0463-38bb-8759-feaeae68f50a",
                                                "text": "Sekaná se nakrájí na plátky a podávat se může třeba s bramborovou kaší."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8fd5b86-aa6a-3ee0-bb3c-45273688bd54",
                                        "entry_id": "4ea1787e-00f5-3243-84c0-a5b28555b546",
                                        "glosses": [
                                            "samotná tato směs určená primárně pro přípravu sekané [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2e1c192-15ed-4c6a-8f6b-8c6f8fe226d7",
                                                "sense_id": "f8fd5b86-aa6a-3ee0-bb3c-45273688bd54",
                                                "text": "Koupil jsem sekanou, můžu udělat třeba karbanátky."
                                            },
                                            {
                                                "example_id": "9ddcc176-49c2-4a84-9604-5740a7a8cf93",
                                                "sense_id": "f8fd5b86-aa6a-3ee0-bb3c-45273688bd54",
                                                "text": "Mám koupit tu jejich sekanou nebo čisté mleté?"
                                            },
                                            {
                                                "example_id": "9bc8c00d-f8ef-4f18-9d92-9d0247a0cde9",
                                                "sense_id": "f8fd5b86-aa6a-3ee0-bb3c-45273688bd54",
                                                "text": "Upekla jsem té sekané raději dvě šišky"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84e9687b-7cbc-3d88-9080-a2826bd2235e",
                                        "entry_id": "4ea1787e-00f5-3243-84c0-a5b28555b546",
                                        "glosses": [
                                            "jedno balení sekané [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
