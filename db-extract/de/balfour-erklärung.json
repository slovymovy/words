                "senses": [
                    {
                        "sense_id": "e93dad55-ed0f-3ddf-b8af-31eab9bb86af",
                        "entry_id": "06dbece4-e016-32f2-a84c-f61d909ea43c",
                        "glosses": [
                            "im November 1917 erfolgte Deklaration, in der Großbritannien erklärte, Pläne für die Schaffung einer „nationalen Heimstätte“ des jüdischen Volks in Palästina zu unterstützen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45b475c7-ef64-4ec3-9f12-b6eae7633819",
                                "sense_id": "e93dad55-ed0f-3ddf-b8af-31eab9bb86af",
                                "text": "„Die Balfour-Erklärung war gut zehn Monate vorher abgegeben worden, doch Untergaliläa wurde damals noch von den Türken regiert und hatte keinen Kontakt zu den britisch besetzten Gebieten.“"
                            },
                            {
                                "example_id": "38825b00-0a43-462a-b7c5-8d1986c40d0a",
                                "sense_id": "e93dad55-ed0f-3ddf-b8af-31eab9bb86af",
                                "text": "„Tatsächlich handelte es sich hierbei um eine einmalige Ausnahme, denn die britische Regierung war äußerst bemüht, den mit der Balfour-Erklärung eingeschlagenen Kurs zu halten.“"
                            }
                        ],
