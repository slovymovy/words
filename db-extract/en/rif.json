                        ],
                        "form": "RIFed"
                    },
                    {
                        "form_id": "2e894bdd-62e2-46a1-834d-fe88356b9f7b",
                        "entry_id": "316b76bd-9362-30ce-8cfd-2e50febd03b4",
                        "tags": [
                            "past"
                        ],
                        "form": "RIFed"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "436cb51f-9234-3246-80b0-414f42002aca",
                        "entry_id": "316b76bd-9362-30ce-8cfd-2e50febd03b4",
                        "glosses": [
                            "To lay off from work due to a reduction in force."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "98e53c84-3a73-49db-9200-0d1d33d8c333",
                                "sense_id": "436cb51f-9234-3246-80b0-414f42002aca",
                                "text": "Our own agency let go 300 positions, affected 120 people who got RIFed, but 1,200 people were affected in the process."
                            },
                            {
                                "example_id": "1291921a-7b21-44de-87fd-018d57040f2c",
                                "sense_id": "436cb51f-9234-3246-80b0-414f42002aca",
                                "text": "Federal employees got 'RIFed.' That lasted about six months."
                            },
                            {
                                "example_id": "9f8a1a64-4cee-462b-9dd4-7a25020f63fa",
                                "sense_id": "436cb51f-9234-3246-80b0-414f42002aca",
                                "text": "Despite my exemplary service, I got RIFed.” Ginger cringed at the raw sarcasm in his voice, but wanted clarification. “Riffed?” “Reduction in force. Let go, laid off, whatever fits.”"
                            },
                            {
                                "example_id": "80430d8f-e8c0-4204-b9a1-5b604c555f46",
                                "sense_id": "436cb51f-9234-3246-80b0-414f42002aca",
                                "text": "“If somebody’s been RIF’ed, they may have the opportunity of moving into another position where they have seniority that is specifically similar to the job that they had before,” Stier said."
                            }
                        ]
                    }
                ],
