                "senses": [
                    {
                        "sense_id": "52a94d20-8376-3332-a764-061d48c66c2d",
                        "entry_id": "4c84037b-590c-3e30-9f18-a256d10fe00e",
                        "glosses": [
                            "Hose, die zu einem Anzug gehört"
                        ],
                        "tags": [
                            "Mode"
                        ],
                        "examples": [
                            {
                                "example_id": "0dec95b0-7f1f-4abf-8908-bd9c5b066b1a",
                                "sense_id": "52a94d20-8376-3332-a764-061d48c66c2d",
                                "text": "„Wie sehr mir Toms Berührungen gefallen, verrät jedem das Zelt in meiner Anzugshose.“"
                            },
                            {
                                "example_id": "9f7c0b14-0587-483d-b54a-9280eadba0d6",
                                "sense_id": "52a94d20-8376-3332-a764-061d48c66c2d",
                                "text": "„Allerdings spürte er, dass er lange Zeit keinen Sport getrieben hatte, als sein Bauchansatz bei der ungewohnten Turnübung schmerzhaft gegen den Bund der Anzugshose drückte.“"
                            },
                            {
                                "example_id": "d298f92e-4286-4c9a-ad61-9e69cc70a362",
                                "sense_id": "52a94d20-8376-3332-a764-061d48c66c2d",
                                "text": "„Bayern Münchens Coach jedenfalls kennt das Gefühl sehr gut, wenn einem vor zigtausend Zuschauern im Stadion und Millionen vor den TV-Schirmen die Anzugshose reißt.“"
                            },
                            {
                                "example_id": "92520240-621d-468f-a766-84b4ff400469",
                                "sense_id": "52a94d20-8376-3332-a764-061d48c66c2d",
                                "text": "„Johnson tritt gerne flapsig auf, sein ungekämmter Haarschopf oder dass er als Velofahrer manchmal vergisst, die Anzugshose aus den Socken zu ziehen, sind das Kapital seiner Popularität.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
