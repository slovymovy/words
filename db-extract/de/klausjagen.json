                                "example_id": "16b6f030-5da4-4b88-b416-9c39bd037f02",
                                "sense_id": "bd666215-acd7-3fb6-8963-3a426fd93c7a",
                                "text": "„Beim Klausjagen in Küssnacht dürfen selbst am Kinderumzug Mädchen nicht teilnehmen.“"
                            },
                            {
                                "example_id": "849d5762-3f1b-48e5-b057-7bce8c3fc702",
                                "sense_id": "bd666215-acd7-3fb6-8963-3a426fd93c7a",
                                "text": "„Das Klausjagen gehört untrennbar zur Kultur des Bezirks Küssnacht.“"
                            },
                            {
                                "example_id": "dc71b7f8-d8d9-4ed8-8ab9-f43a45e2a247",
                                "sense_id": "bd666215-acd7-3fb6-8963-3a426fd93c7a",
                                "text": "„Im Allgemeinen werde das Klausjagen im Dorf aber als reine Männerangelegenheit akzeptiert.“"
                            }
