                ],
                "senses": [
                    {
                        "sense_id": "38f1a852-7865-3226-aaa7-293197f6a4ea",
                        "entry_id": "a9cebc05-9f2a-32b0-99ad-ad1fffed12c8",
                        "glosses": [
                            "sehr hoch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8a6a691-2072-4595-8336-92e062b3c744",
                                "sense_id": "38f1a852-7865-3226-aaa7-293197f6a4ea",
                                "text": "„Das riesige Maschinenhaus, das Reaktorgebäude mit dem turmhohen Schornstein, die flachen Nebengebäude, die Bahngleise für den Transport des radioaktiven Materials: Alles scheint im Originalzustand erhalten.“"
                            },
                            {
                                "example_id": "89e3bae2-e3d7-4d77-9431-8e00b59c8cb1",
                                "sense_id": "38f1a852-7865-3226-aaa7-293197f6a4ea",
                                "text": "„Wir kommen an einem Soldaten vorbei, der in Habtachtstellung mit einer halbautomatischen Waffe in den Händen offenbar einen turmhohen Stapel schrottreifer Autoreifen – nichts anderes ist in Sicht – bewacht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
