                        "form": "threnodies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3237b5c8-311d-354b-9528-580a6c5ed248",
                        "entry_id": "52565089-c401-3514-b48b-38914a7930e5",
                        "glosses": [
                            "A song or poem of lamentation or mourning for a dead person; a dirge; an elegy."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89a41e25-f733-4cf7-941c-40fcd2dd04d5",
                                "sense_id": "3237b5c8-311d-354b-9528-580a6c5ed248",
                                "text": "The fifer actually knew but one tune \"The Bonnie Blue Flag\"—and did not know that well. But it was all that he had, and he played it with wearisome monotony for every camp call. . . . I never hated any piece of music as I came to hate that threnody of treason."
                            },
                            {
                                "example_id": "cfb914de-d822-4e78-8c45-2e9eb5222479",
                                "sense_id": "3237b5c8-311d-354b-9528-580a6c5ed248",
                                "text": "A strongly personal note runs through Kenneth Leighton's Improvisation (Novello, 35p), which is a threnody in memory of Maurice de Sausmārez. Gently undulating, cantabile lines of ‘mourning’ alternate with sharp, anguished note-clusters which work up to a fierce paroxysm of grief."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8b64e630-c573-4f4c-8301-8450878bad40",
                        "source_entry_id": "52565089-c401-3514-b48b-38914a7930e5",
                        "source_sense_id": "3237b5c8-311d-354b-9528-580a6c5ed248",
                        "source_sense_description": "a song or poem of lamentation",
                        "target_lang_word": "klaagzang",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "klaagzang",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "d7f5b193-8908-3483-aadc-b27032cab527",
                                        "entry_id": "3742145a-e2d2-34d6-be58-61ec81fe00b4",
                                        "glosses": [
                                            "een klagend gezongen lied of gesproken woord"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69c3b10b-71b6-498c-8091-fed1422ba615",
                                                "sense_id": "d7f5b193-8908-3483-aadc-b27032cab527",
                                                "text": "Stones in her Mouth. Scènes vol schrijnende poëzie, doordringende klaagzangen en trage dansen in de voorstelling van de Samoaan Lemi Ponifasio, over het lot van Maori-vrouwen. In eigen cultuur vereerd, werden zij onder het koloniale bewind van Europeanen slachtoffer van onderdrukking en geweld. Hyperesthetisch, maar hun pijn is bijna voelbaar."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f1806c7-5ddf-317d-b9a9-75ab20b10c06",
                                        "entry_id": "3742145a-e2d2-34d6-be58-61ec81fe00b4",
                                        "glosses": [
                                            "een lied of gesproken woord dat gaat over iets droevigs"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d581fbe-7e9e-49e8-b35d-1fbbc42128b1",
                                                "sense_id": "0f1806c7-5ddf-317d-b9a9-75ab20b10c06",
                                                "text": "Kleppen is goud. Nooit zag je daarom zo veel praattafelgasten de politiek in huppelen. De elite? Dat zijn Wilders, Roos, Baudet en – bien étonnés – Sylvana Simons. Zij schilderen de diploma-elite af als de nazaten van een ancien régime waar zij zelf de bastaardkinderen van zijn. Die zelfgekroonden beheersen onze schermen met de klaagzang ‘niet gehoord te worden’."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3a1f5ab5-1dfa-44ce-8674-c778ba0c8b96",
                        "source_entry_id": "52565089-c401-3514-b48b-38914a7930e5",
                        "source_sense_id": "3237b5c8-311d-354b-9528-580a6c5ed248",
                        "source_sense_description": "a song or poem of lamentation",
                        "target_lang_word": "thrène",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "thrène",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ed3c8fe1-68c4-32bc-942a-e8e78495c12a",
                                        "entry_id": "90f70623-76f5-33b6-a4a0-d0b14554ca26",
                                        "glosses": [
                                            "Chant funèbre chez les Grecs."
                                        ],
                                        "tags": [
                                            "Ancient-Greek"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3489b0af-a753-45d5-8091-c6ae19ec379e",
                                                "sense_id": "ed3c8fe1-68c4-32bc-942a-e8e78495c12a",
                                                "text": "Walt Whitman à l'occasion de la mort du président Lincoln, écrivit un de ses plus beaux chants. Mais si ce libre chant eût été contraint, si Whitman avait été forcé de l’écrire par ordre et conformément à un canon admis, ce thrène aurait perdu sa vertu, sa beauté; ou plutôt Whitman n’aurait pas pu l’écrire."
                                            },
                                            {
                                                "example_id": "b66feda4-350c-4760-8f9e-537deec8963e",
                                                "sense_id": "ed3c8fe1-68c4-32bc-942a-e8e78495c12a",
                                                "text": "Elle prit immédiatement son rôle de pleureuse et commenta la mémoire du mort de lamentations, de thrènes désespérés."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cee971b0-0acd-4197-9b8a-be03b1ab6f46",
                        "source_entry_id": "52565089-c401-3514-b48b-38914a7930e5",
                        "source_sense_id": "3237b5c8-311d-354b-9528-580a6c5ed248",
                        "source_sense_description": "a song or poem of lamentation",
                        "target_lang_word": "lamentation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lamentation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "04841860-7f74-3f9c-b330-f13f9b37b350",
                                        "entry_id": "38b8d735-9aa6-38b4-a948-921b2cb7c5ff",
                                        "glosses": [
                                            "Plainte accompagnée de gémissements et de cris."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4079d4a5-aa32-4cac-abec-3d147a4ee226",
                                                "sense_id": "04841860-7f74-3f9c-b330-f13f9b37b350",
                                                "text": "Et bien des fois, descendu dans la nuit des géhennes sociales, j’ai porté aux moribonds la résignation, l’espérance aux désespérés ; bien des fois j’ai changé en cris de joie les lamentations farouches de ces damnés."
                                            },
                                            {
                                                "example_id": "78d85d82-6948-4759-9888-24df15c0d850",
                                                "sense_id": "04841860-7f74-3f9c-b330-f13f9b37b350",
                                                "text": "…et, au milieu du silence troublé par le seul bruissement de la brise hivernale, je crus effectivement entendre de longues plaintes qui me semblaient n'être pas seulement la lamentation du vent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f34a34e-e4b7-3897-ab8f-af2a24268d0a",
                                        "entry_id": "38b8d735-9aa6-38b4-a948-921b2cb7c5ff",
                                        "glosses": [
                                            "Expression de douleur et de regret."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7b8f346-09bc-4916-9de6-28c71cc6cba3",
                                                "sense_id": "6f34a34e-e4b7-3897-ab8f-af2a24268d0a",
                                                "text": "Sa visite fut une longue lamentation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "86060e87-6a49-4048-8437-cb860ff9dfe7",
                        "source_entry_id": "52565089-c401-3514-b48b-38914a7930e5",
                        "source_sense_id": "3237b5c8-311d-354b-9528-580a6c5ed248",
                        "source_sense_description": "a song or poem of lamentation",
                        "target_lang_word": "plainte",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plainte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5e15d1ea-346d-35d2-860a-83a75aafbc44",
                                        "entry_id": "1b67b837-591c-3b9f-8d6b-a92f517cb862",
                                        "glosses": [
                                            "Gémissement ; lamentation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4c27dc7-a743-4a9a-b41b-15d001e72f33",
                                                "sense_id": "5e15d1ea-346d-35d2-860a-83a75aafbc44",
                                                "text": "Les plaintes d’un malade, d’un homme qui souffre."
                                            },
                                            {
                                                "example_id": "f9cf10c8-8f30-433e-ba44-a0fa5440c629",
                                                "sense_id": "5e15d1ea-346d-35d2-860a-83a75aafbc44",
                                                "text": "La plainte le soulage."
                                            },
                                            {
                                                "example_id": "ff7c66a9-d6ab-47d4-9e78-55365a2f2446",
                                                "sense_id": "5e15d1ea-346d-35d2-860a-83a75aafbc44",
                                                "text": "La douleur ne lui arracha pas une seule plainte."
                                            },
                                            {
                                                "example_id": "48ef92c5-7da3-4e99-9ffd-6ea79ff216e5",
                                                "sense_id": "5e15d1ea-346d-35d2-860a-83a75aafbc44",
                                                "text": "Le ciel a entendu ses plaintes."
                                            },
                                            {
                                                "example_id": "5458b9f7-1a44-4736-ba8f-b29d9d00bd68",
                                                "sense_id": "5e15d1ea-346d-35d2-860a-83a75aafbc44",
                                                "text": "Durant la même nuit, Feempje qui n'avait jamais de cauchemar s'était débattu, en grognant et en poussant des plaintes, contre il n'aurait pu dire quelles terrifiantes figures."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "172b551e-dbb2-3fab-ae3f-91eb6f15e49f",
                                        "entry_id": "1b67b837-591c-3b9f-8d6b-a92f517cb862",
                                        "glosses": [
                                            "Ce qu’on dit, ce qu’on écrit pour faire connaître le sujet qu’on a de se plaindre de quelqu’un."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c00bdc1b-3155-4f37-8ebb-9d087134cb39",
                                                "sense_id": "172b551e-dbb2-3fab-ae3f-91eb6f15e49f",
                                                "text": "Il fait de grandes plaintes de vous, contre vous."
                                            },
                                            {
                                                "example_id": "0791913e-f0db-4feb-93fb-a83adad87266",
                                                "sense_id": "172b551e-dbb2-3fab-ae3f-91eb6f15e49f",
                                                "text": "Il s’est répandu en plaintes à ce sujet."
                                            },
                                            {
                                                "example_id": "35e0f0e5-b68a-484b-882f-13e712b2b80f",
                                                "sense_id": "172b551e-dbb2-3fab-ae3f-91eb6f15e49f",
                                                "text": "Il m’a adressé les plaintes les plus graves contre vous."
                                            },
                                            {
                                                "example_id": "43782253-bf67-4b6b-a458-2390521a457a",
                                                "sense_id": "172b551e-dbb2-3fab-ae3f-91eb6f15e49f",
                                                "text": "Ses plaintes sont bien fondées, sont mal fondées, sont exagérées."
                                            },
                                            {
                                                "example_id": "5cbf7df3-c9aa-45c8-b15a-7a607659524a",
                                                "sense_id": "172b551e-dbb2-3fab-ae3f-91eb6f15e49f",
                                                "text": "On n’a pas écouté ses plaintes."
                                            },
                                            {
                                                "example_id": "ad90a636-cfb3-4f50-a441-ce28790c9d7b",
                                                "sense_id": "172b551e-dbb2-3fab-ae3f-91eb6f15e49f",
                                                "text": "On a fermé l’oreille à ses plaintes."
                                            },
                                            {
                                                "example_id": "f3c24dfd-153b-49d6-b490-6e2a590dc7d7",
                                                "sense_id": "172b551e-dbb2-3fab-ae3f-91eb6f15e49f",
                                                "text": "On a étouffé ses plaintes."
                                            },
                                            {
                                                "example_id": "3b844db2-5cea-466d-b14a-488e0c79887f",
                                                "sense_id": "172b551e-dbb2-3fab-ae3f-91eb6f15e49f",
                                                "text": "Je ne lui ai donné aucun sujet de plainte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c481455a-5c03-3d64-9425-a864023e720b",
                                        "entry_id": "1b67b837-591c-3b9f-8d6b-a92f517cb862",
                                        "glosses": [
                                            "Exposé qu’on fait en justice du sujet qu’on a de se plaindre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb24076a-59a8-402f-a914-b32de86b15ff",
                                                "sense_id": "c481455a-5c03-3d64-9425-a864023e720b",
                                                "text": "Le nombre de plaintes pour violences sexuelles déposées à Paris a augmenté de 30 % par rapport à 2021, d’après la procureure de la République de Paris, Laure Beccuau."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "plainte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9e6887db-b2e9-3780-9057-1814985adcdd",
                                        "entry_id": "43d33ea9-466f-3979-8a1a-fca65ca5170a",
                                        "glosses": [
                                            "Participe passé féminin singulier de plaindre."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c46fe138-e1f3-41f8-8a99-32ce8859ba47",
                                                "sense_id": "9e6887db-b2e9-3780-9057-1814985adcdd",
                                                "text": "J’ai de si belles relations qu’Yvonne ne perd jamais au change. Elle ne s’en est jamais plainte à moi, du moins."
                                            },
                                            {
                                                "example_id": "6666f799-d80c-43e5-9086-52729a7ad35e",
                                                "sense_id": "9e6887db-b2e9-3780-9057-1814985adcdd",
                                                "text": "Bien que jamais tu ne te sois plainte…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
