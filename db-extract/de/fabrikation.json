                                        "entry_id": "7faf0549-b7fb-3522-9a91-39c94f06b4b6",
                                        "glosses": [
                                            "The total amount produced."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64a03130-f2fa-4ec0-81a6-93deb05624bb",
                                                "sense_id": "66ade1bb-dbf6-3a41-badb-ae237cd29388",
                                                "text": "They hope to increase spaghetti production next year."
                                            },
                                            {
                                                "example_id": "692eef1a-3cb3-4ffd-8997-d5898b7fa2b6",
                                                "sense_id": "66ade1bb-dbf6-3a41-badb-ae237cd29388",
                                                "text": "The exiguity and ſmallneſſe of ſome ſeeds extending to large productions is one of the magnalities of nature, ſomewhat illuſtrating the work of the Creation, and vaſt production from nothing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21097a70-3c88-313c-9c98-01f0197ca164",
                                        "entry_id": "7faf0549-b7fb-3522-9a91-39c94f06b4b6",
                                        "glosses": [
                                            "The presentation of a theatrical work."
                                        ],
