                "senses": [
                    {
                        "sense_id": "8c9b1e0a-6154-327e-adea-fd8551c4fdbd",
                        "entry_id": "8670b431-0724-3104-a16a-4e84d50940e1",
                        "glosses": [
                            "rodzice rodziców; babcia i dziadek"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "38a68b6f-2265-4e40-88a9-a66d0b6eb3cf",
                                "sense_id": "8c9b1e0a-6154-327e-adea-fd8551c4fdbd",
                                "text": "Mama wspominała, jak dziadkowie nie chcieli zgodzić się na jej ślub z tatą."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "99182801-303a-352e-84b3-e122fba0486d",
                        "entry_id": "8670b431-0724-3104-a16a-4e84d50940e1",
                        "glosses": [
