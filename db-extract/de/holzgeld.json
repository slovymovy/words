                "senses": [
                    {
                        "sense_id": "86ac70f0-2adb-3675-9435-49f1d12d2102",
                        "entry_id": "17e016d7-22a9-3e04-99e8-9389f2f2d20d",
                        "glosses": [
                            "Geld, das für den Kauf von Holz bestimmt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e6bf627-d1fe-4bdb-9f59-7d3ae2fd42b7",
                                "sense_id": "86ac70f0-2adb-3675-9435-49f1d12d2102",
                                "text": "„Eine Klafter Eichenholz von 6 Fuß Höhe, 6 Fuß Breite und 3 Fuß Klobenlänge enthält 108 Cubikfuß, und kostet in den königl. Preuß. Forsten 1 Rthlr. Holzgeld.“"
                            },
                            {
                                "example_id": "9e881550-9434-4cef-b176-69e73bd04fc6",
                                "sense_id": "86ac70f0-2adb-3675-9435-49f1d12d2102",
                                "text": "„Sie gehörten zu den Berufsgruppen, deren Einkommen trotz des teilweise konjunkturellen Aufschwungs der sechziger Jahre nicht erhöht wurde. Wie bereits seit Jahrzehnten erhielten sie neben Miete und Holzgeld jährlich nur 37 Taler, 8 Groschen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9876bc39-21c6-36e4-a391-7fb998706924",
                        "entry_id": "17e016d7-22a9-3e04-99e8-9389f2f2d20d",
                        "glosses": [
                            "Geld, das jemand durch den Verkauf von Holz einnimmt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3c84eac-03b4-414b-a713-5c6b12ecc5e2",
                                "sense_id": "9876bc39-21c6-36e4-a391-7fb998706924",
                                "text": "„Fünfzig Prozent des Landeshaushaltes [Sabahs] stammen vom Holzgeld, und in nicht mehr als drei Jahren, so die Prognosen, wird der Rohstoff knapp.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
