                        "source_entry_id": "3628c3bf-235b-34a8-888d-cbebf558f678",
                        "source_sense_id": "f90df851-cccc-3dd2-b001-e999f594aefc",
                        "source_sense_description": "type of white blood cell",
                        "target_lang_word": "macrophage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "macrophage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "617ebe32-3a27-3dce-ba06-751fcfa751f7",
                                        "entry_id": "8f41f1d7-6d23-3d12-a65e-e736beffbcf1",
                                        "glosses": [
                                            "Qui a pour fonction de phagocyter les cellules apoptiques et les agents pathogènes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "acb3b350-cadb-474f-b467-ae91f95807e1",
                                                "sense_id": "617ebe32-3a27-3dce-ba06-751fcfa751f7",
                                                "text": "Le système des phagocytes mononucléés. par ses cellules effectrices ou macrophages, est responsable d’une grande part des mécanismes de défense de l’individu."
                                            },
                                            {
                                                "example_id": "1c8057eb-d66b-4375-ab82-ea925369557e",
                                                "sense_id": "617ebe32-3a27-3dce-ba06-751fcfa751f7",
                                                "text": "Lorsque les cellules macrophages auront digéré les LDL cholestérol, elles libéreront dans le sang une substance toxique pour l’organisme et feront de nouveau appel à d’autres macrophages pour digérer ces éléments toxiques."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "macrophage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ac5560e6-7c8a-361f-9da2-7fe31c6b3883",
                                        "entry_id": "bf97cad7-570b-349f-ab51-2105a8a893c6",
                                        "glosses": [
                                            "Cellule qui a, dans le corps des animaux, pour fonction de phagocyter les cellules étrangères à ce corps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9246559f-8723-4478-b197-1a7b4e05f785",
                                                "sense_id": "ac5560e6-7c8a-361f-9da2-7fe31c6b3883",
                                                "text": "Face à un inoculum limité, le macrophage alvéolaire peut assumer seul la clairance bactérienne."
                                            },
                                            {
                                                "example_id": "11677999-9804-4259-bd2d-623b220356f7",
                                                "sense_id": "ac5560e6-7c8a-361f-9da2-7fe31c6b3883",
                                                "text": "Les macrophages constituent le premier organisme de défense cellulaire contre les agents infectieux. On les retrouve dans tous les tissus, en particulier le thymus, la rate, les ganglions lymphatiques, les muqueuses ; en fonction de leur localisation, ils sont connus sous différentes appellations (histiocyte dans le tissu conjonctif, cellule de Kupfer dans le foie, ostéoclaste dans le tissu osseux, etc.)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
