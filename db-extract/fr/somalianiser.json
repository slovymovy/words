                                "example_id": "08c48514-6bf2-4c68-aecd-f293f01eac7b",
                                "sense_id": "355471f7-4272-3dad-b613-1efc8a3ac5ea",
                                "text": "Plutôt que d’opposer au business somalien de la piraterie un business occidental de l’anti-piraterie, je propose de «somalianiser» la protection des navires avec des équipes embarquées mixtes composées de cadres occidentaux et de gardes somaliens."
                            },
                            {
                                "example_id": "f746eaed-e784-4944-9d18-895ea99c7bfd",
                                "sense_id": "355471f7-4272-3dad-b613-1efc8a3ac5ea",
                                "text": "On dit que la capitale canadienne s'africanise voire se somalianise ou djiboutianise, vite une description/explication sociologique ?"
                            }
                        ]
