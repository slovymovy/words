                "senses": [
                    {
                        "sense_id": "36f23a8f-24be-39a7-81bd-22ea80234903",
                        "entry_id": "cd1a9aff-5ed9-3844-b883-2a83a7e5c652",
                        "glosses": [
                            "Amtsadel in der antiken Römischen Republik"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "0973df20-ccf1-4da9-98a2-c33d4bfcac95",
                                "sense_id": "36f23a8f-24be-39a7-81bd-22ea80234903",
                                "text": "„Entscheidungen fielen grundsätzlich im Senat. Aber zu ihrer Verwirklichung bedurfte es der Magistrate und bei Gesetzen auch der Volksversammlung. Einzelne Politiker oder Gruppen konnten vielleicht vorübergehend den Senat majorisieren, doch sie mussten nach menschlichem Ermessen an einer der beiden anderen Instanzen scheitern, da sich diese ihrer Kontrolle entzogen, wenn innerhalb der Nobilität kein Konsens zustande kam.“"
                            },
                            {
                                "example_id": "cf136f92-8399-427f-92ea-b44ceb882533",
                                "sense_id": "36f23a8f-24be-39a7-81bd-22ea80234903",
                                "text": "„Namens- und Kleiderwechsel, der Verlust und der Gewinn von Nobilität und Ansehen sind in der spanischen Literatur nicht bloß ein unterhaltsames Maskenspiel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
