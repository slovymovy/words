                "translations": [
                    {
                        "translation_id": "692ab918-c6cc-43ea-8217-39a690f23b05",
                        "source_entry_id": "5354837d-cbc4-372d-b0a2-1a3ba1ffd413",
                        "source_sense_id": "1d19ffdb-67cb-339c-b7dd-4ea10d9f16e5",
                        "target_lang_word": "Trübung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Trübung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a81b7319-6557-34e8-b363-9d5dd6949499",
                                        "entry_id": "610d00e4-69f1-30c0-a2bf-71597ae41867",
                                        "glosses": [
                                            "Zustand des Undurchsichtigseins/Getrübtseins"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "373c2a4b-84a1-4563-bad9-83e1e921fa7c",
                                                "sense_id": "a81b7319-6557-34e8-b363-9d5dd6949499",
                                                "text": "[Milchglas:] „Durch die Beimischung von Calciumphosphat, Fluoriden oder Zinnoxid vor dem Schmelzen wird eine Trübung des Glases erreicht.“"
                                            },
                                            {
                                                "example_id": "ba9c6462-c30d-495f-9e5b-a3a80dfa975e",
                                                "sense_id": "a81b7319-6557-34e8-b363-9d5dd6949499",
                                                "text": "„An den Grenzflächen zwischen Wasser und Öltröpfchen wird das Licht gestreut (Tyndall-Effekt), was die milchig-weiße Trübung hervorruft.“"
                                            },
                                            {
                                                "example_id": "78f1f3db-199b-43a3-ae9c-04435ad0d6c2",
                                                "sense_id": "a81b7319-6557-34e8-b363-9d5dd6949499",
                                                "text": "„Mit zunehmendem Alter kommt es zu einer Trübung der Augenlinse, die meist langsam voranschreitet.“"
                                            },
                                            {
                                                "example_id": "f3b9c29c-3d24-4856-badd-428ba9a75a05",
                                                "sense_id": "a81b7319-6557-34e8-b363-9d5dd6949499",
                                                "text": "„Typisch ist eine zunehmende Trübung in der Pupillenebene.“"
                                            },
                                            {
                                                "example_id": "7b839abd-ccd4-495f-a1e1-9b62bed975e3",
                                                "sense_id": "a81b7319-6557-34e8-b363-9d5dd6949499",
                                                "text": "„Die im Alter einsetzende Trübung der Linse wird als Grauer Star bezeichnet.“"
                                            },
                                            {
                                                "example_id": "ea9a149d-5fe3-4cb2-88b1-950a9c5fa6fd",
                                                "sense_id": "a81b7319-6557-34e8-b363-9d5dd6949499",
                                                "text": "„Eine Trübung der Linse findet sich oft bei Dackeln, Cockerspanieln, Retrievern, Pudeln, aber auch bei Katzen.“"
                                            },
                                            {
                                                "example_id": "0e742197-4abd-4f51-b9f2-19d950abcfeb",
                                                "sense_id": "a81b7319-6557-34e8-b363-9d5dd6949499",
                                                "text": "„Denn Vitamin C ist in der Augenflüssigkeit enthalten und unterstützt den Abbau von Sauerstoffradikalen, welche eine Trübung der Linse begünstigen.“"
                                            },
                                            {
                                                "example_id": "370a2ad1-d7a2-4911-aea7-227d3ede3014",
                                                "sense_id": "a81b7319-6557-34e8-b363-9d5dd6949499",
                                                "text": "„Permanganatstäube verursachen am Auge eine Trübung der Hornhaut.“"
                                            },
                                            {
                                                "example_id": "cb9e70bf-3f49-404d-9cb7-797f42ed7a40",
                                                "sense_id": "a81b7319-6557-34e8-b363-9d5dd6949499",
                                                "text": "„Wie werden getrübte Gläser wieder klar? […] Je nach Stärke der Trübung erhält das Glas durch Putzen mit Zitronensaft etwas an Glanz zurück. Ganz klar werden solche Gläser jedoch nicht mehr.“"
                                            },
                                            {
                                                "example_id": "29a08b7a-6c44-4338-aabb-e3e243eae1c9",
                                                "sense_id": "a81b7319-6557-34e8-b363-9d5dd6949499",
                                                "text": "[Schlagzeile:] „Labor bestätigt: Trübung der Oste bei Zeven nicht gefährlich“"
                                            },
                                            {
                                                "example_id": "9f783e91-ba92-427e-80d8-a396081bbd45",
                                                "sense_id": "a81b7319-6557-34e8-b363-9d5dd6949499",
                                                "text": "[Göstritzbach, Auebach, Erlbach/Gloggnitz:] „»Die Situation ist unbedenklich, ähnlich der Situation nach einem starken Regen, wenn Sand aufgrund großer Wassermengen aufgewirbelt wird und für eine Trübung des Wassers sorgt.«“"
                                            },
                                            {
                                                "example_id": "c294518a-9604-48b8-9ab3-169dccdd9210",
                                                "sense_id": "a81b7319-6557-34e8-b363-9d5dd6949499",
                                                "text": "[Wasseranalyse:] „Nach folgender Methode lassen sich Sulfat-Ionen mit einer hinreichenden Genauigkeit bestimmen: Hierbei wird die Trübung nach Versetzen mit Bariumchloridlösung (Fällung von Bariumsulfat) fotometrisch bestimmt.“"
                                            },
                                            {
                                                "example_id": "7ef0c07a-781b-4795-a298-fa363c353a18",
                                                "sense_id": "a81b7319-6557-34e8-b363-9d5dd6949499",
                                                "text": "„Eine massenhafte Vermehrung von Blaualgen können Badegäste an der grünlichen oder blau-grünen Trübung des Wassers erkennen.“"
                                            },
                                            {
                                                "example_id": "577de1af-4133-4a8b-a38b-c4dd2a777f17",
                                                "sense_id": "a81b7319-6557-34e8-b363-9d5dd6949499",
                                                "text": "„Diese Trübung der Flüssigkeit kommt daher, dass die Bakterien in einer sehr hohen Konzentration vorliegen.“"
                                            },
                                            {
                                                "example_id": "4e425fd1-96aa-4d8b-b152-0d1b5020114d",
                                                "sense_id": "a81b7319-6557-34e8-b363-9d5dd6949499",
                                                "text": "[Swimmingpools:] „Die Trübung lässt sich dann nicht durch die Zugabe von noch mehr Chlor beseitigen.“"
                                            },
                                            {
                                                "example_id": "f84ad536-f933-4cf1-9864-52228e91e2cb",
                                                "sense_id": "a81b7319-6557-34e8-b363-9d5dd6949499",
                                                "text": "[Leitungswasser:] „Betroffen von der Trübung des Wassers waren alle Haushalte in Fuschl, viele haben sich besorgt an die Gemeinde gewandt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "81f69154-60a1-3e8c-b84a-10922295a68d",
                                        "entry_id": "610d00e4-69f1-30c0-a2bf-71597ae41867",
                                        "glosses": [
                                            "Beeinträchtigung/Störung/Verschlechterung eines guten Zustands"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d6addf4-df3e-4836-afbb-e7ba3d8ef198",
                                                "sense_id": "81f69154-60a1-3e8c-b84a-10922295a68d",
                                                "text": "„Bei der Deutschen Diabeteshilfe in Stuttgart erfahre ich, Symptome wie die Trübung des Bewusstseins und Aggressivität kämen eher bei Unter- als bei Überzuckerung vor.“"
                                            },
                                            {
                                                "example_id": "0928cbe3-997f-4f6f-8039-e4598aff2206",
                                                "sense_id": "81f69154-60a1-3e8c-b84a-10922295a68d",
                                                "text": "[USA - Saudi-Arabien:] „Der Anschlag vom 11. September 2001 – bei dem 15 der 19 Täter aus Saudi-Arabien stammten – führte zu einer tiefen Trübung der gegenseitigen Beziehungen.“"
                                            },
                                            {
                                                "example_id": "e56c3ffb-345e-45b8-838d-fae479666a20",
                                                "sense_id": "81f69154-60a1-3e8c-b84a-10922295a68d",
                                                "text": "„Merkel sprach bei der gemeinsamen Pressekonferenz gar von „Trübungen“ im deutsch-türkischen Verhältnis.“"
                                            },
                                            {
                                                "example_id": "4e379cf0-3500-40e8-b62f-e952f30f28a2",
                                                "sense_id": "81f69154-60a1-3e8c-b84a-10922295a68d",
                                                "text": "[Deutsch-Schweizer-Beziehungen:] […] „der Liberale Joachim Eder: »Wir sind gefasst und auch die Deutschen scheinen gefasst zu sein, zumindest die Politik, weil die gegenseitigen Beziehungen, zumindest auch die wirtschaftlichen, so eng und vor allem auch so wichtig sind, dass niemand ein Interesse an einer langfristigen Trübung des Verhältnisses hat.«“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "501ab3c8-7cc6-37a7-8599-9c710449c3e2",
                                        "entry_id": "610d00e4-69f1-30c0-a2bf-71597ae41867",
                                        "glosses": [
                                            "Zustand der Verdunkelung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30dd5a3a-4cf8-4a5f-a844-f97cc71d1ff8",
                                                "sense_id": "501ab3c8-7cc6-37a7-8599-9c710449c3e2",
                                                "text": "„Am Montagabend nun hat eine neue Aschewolke Mitteleuropa erreicht. Auch in Bayern war die auffallende Trübung des Himmels dank der wolkenarmen Atmosphäre gut zu sehen.“"
                                            },
                                            {
                                                "example_id": "2f4d11dc-431e-4afd-9840-a912813d874f",
                                                "sense_id": "501ab3c8-7cc6-37a7-8599-9c710449c3e2",
                                                "text": "„»Der Saharastaub ist schon eingetroffen, das sieht man an einer gelblichen Trübung in der Luft«, sagte Christian Herold, Meteorologe des Deutschen Wetterdienstes (DWD), am Karsamstag.“"
                                            },
                                            {
                                                "example_id": "7e04557f-9921-4ee4-ac2c-975cae69b59b",
                                                "sense_id": "501ab3c8-7cc6-37a7-8599-9c710449c3e2",
                                                "text": "[Saharastaub:] „Die Kamera in Warnemünde an der Ostsee etwa zeigte am Vormittag noch eine kräftige Trübung, berichtete Dietzsch.“"
                                            },
                                            {
                                                "example_id": "ee80a007-fd6f-4959-b79d-07e0d04b6356",
                                                "sense_id": "501ab3c8-7cc6-37a7-8599-9c710449c3e2",
                                                "text": "[Saharastaub:] „Die Trübung hat aber auch ihre guten Seiten: Die vielen Partikel in der Luft sorgen für spektakuläre Sonnenauf- und -untergänge.“"
                                            },
                                            {
                                                "example_id": "11b9e884-3f1b-4f2b-9128-3e79d6b3802a",
                                                "sense_id": "501ab3c8-7cc6-37a7-8599-9c710449c3e2",
                                                "text": "[Saharastaub:] „Der Staub sorgt nicht nur für eine Trübung der Luft, er kann auch ein Grund für «Fehlprognosen» sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
