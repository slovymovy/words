                                                "example_id": "7b4a53b3-06fe-4724-8c9c-58ed66441b87",
                                                "sense_id": "0f316421-40ad-3541-a15f-9c66f948a4c4",
                                                "text": "The extreme humidity decayed the wooden sculptures in the museum's collection in a matter of years."
                                            },
                                            {
                                                "example_id": "a267e613-93ef-403f-8108-d5fd6b644bdb",
                                                "sense_id": "0f316421-40ad-3541-a15f-9c66f948a4c4",
                                                "text": "Infirmity, that decays the wise."
                                            }
                                        ]
