                                    {
                                        "sense_id": "e04a23b8-cc4e-369c-9c8b-f34ca00a6a85",
                                        "entry_id": "79609605-5fc0-3236-a1e9-8f4e5cc60416",
                                        "glosses": [
                                            "Hueso o cartílago que conforma la columna vertebral."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28f09bd6-d4c8-4685-bc49-fb5123eeefe0",
                                                "sense_id": "e04a23b8-cc4e-369c-9c8b-f34ca00a6a85",
                                                "text": "«Las vértebras son soportadas desde el axis hasta la parte craneal del sacro por discos intervertebrales y varios ligamentos (…)»."
                                            },
                                            {
                                                "example_id": "a8b05d81-3569-4a84-ab34-4c597e4f374d",
                                                "sense_id": "e04a23b8-cc4e-369c-9c8b-f34ca00a6a85",
                                                "text": "«La veintena de dientes y el gran número de vértebras (cervicales, pectorales, dorsales y sacras) encontrados no pueden asignarse a un grupo de plesiosaurios concreto»."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6eae1a7f-a536-4327-8263-f5bd85662c25",
                        "source_entry_id": "e1792a65-ed86-3083-ad9d-f4d1f2278221",
                        "source_sense_id": "c5a639f2-2ece-3ec1-b8fd-5e2b3326345a",
                        "target_lang_word": "Wirbel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wirbel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "58e2fd1a-0f0a-3a2e-9387-e236829e063a",
                                        "entry_id": "8ec08310-9254-3171-8b83-5604bd399122",
                                        "glosses": [
                                            "eine um eine gemeinsame Mittellinie kreisende Strömung (Gas oder Flüssigkeit)"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51b48128-3658-48fc-9d55-edfe991dcea4",
                                                "sense_id": "58e2fd1a-0f0a-3a2e-9387-e236829e063a",
                                                "text": "„Der versierte Kajakfahrer wird eins mit seinem Boot und kann sich in dieser neuen Einheit den Strömungen, Wirbeln und Kaskaden des Wildwassers stellen.“"
                                            },
                                            {
                                                "example_id": "f926c8ef-1cb8-4328-abea-68a4594a6c4b",
                                                "sense_id": "58e2fd1a-0f0a-3a2e-9387-e236829e063a",
                                                "text": "Das aus einer Badewanne ablaufende Wasser bildet am Abfluss einen Wirbel."
                                            },
                                            {
                                                "example_id": "9c6c3be1-598b-4d14-b835-2e604f2c260e",
                                                "sense_id": "58e2fd1a-0f0a-3a2e-9387-e236829e063a",
                                                "text": "„Das schwarze Wasser unterspülte das Ufer, und kleine Wirbel trieben in einem Bogen vorbei und griffen nach den Wurzeln, die ins Wasser hinunterhingen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5df95818-7725-3409-97b5-b4f9c833e992",
                                        "entry_id": "8ec08310-9254-3171-8b83-5604bd399122",
                                        "glosses": [
                                            "eine Stelle der Haut (zum Beispiel Kopfhaut oder Fell), an der das Haar strahlenförmig auseinandergeht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52b286b7-a3f2-4696-b3d5-b797e5d75005",
                                                "sense_id": "5df95818-7725-3409-97b5-b4f9c833e992",
                                                "text": "Der Scheitel wird vom Wirbel aus gezogen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "787678cc-b946-3bf6-84f9-47d352105cd3",
                                        "entry_id": "8ec08310-9254-3171-8b83-5604bd399122",
                                        "glosses": [
