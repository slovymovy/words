{
    "word_family": [
        "sublimity",
        "sublimation",
        "sublimely",
        "sublimeness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3e8431e3-32ea-368c-a573-beaefd53b35f",
                    "sense_definition": "Of an aspect of art or nature: causing awe or deep respect due to its beauty or magnificence; awe-inspiring, impressive.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "aesthetic_excellence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hikers stood in silence, overwhelmed by the <w>sublime</w> scenery of the snow-capped mountains.",
                            "target_lang_translations": {
                                "ru": "Пешие туристы стояли в тишине, пораженные <w>величественным</w> видом заснеженных гор."
                            }
                        },
                        {
                            "text": "The cathedral's architecture is truly <w>sublime</w>, reflecting centuries of artistic mastery.",
                            "target_lang_translations": {
                                "ru": "Архитектура собора поистине <w>возвышенна</w>, отражая столетия художественного мастерства."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sublime scenery",
                        "sublime beauty",
                        "truly sublime"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к искусству или природе: вызывающий трепет или глубокое уважение благодаря своей красоте или великолепию; внушающий благоговение, впечатляющий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "величественный",
                                "target_lang_sense_clarification": "о красоте природы или архитектуры"
                            },
                            {
                                "target_lang_word": "возвышенный",
                                "target_lang_sense_clarification": "о стиле или эстетике"
                            },
                            {
                                "target_lang_word": "потрясающий",
                                "target_lang_sense_clarification": "вызывающий сильное впечатление"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bf283529-20b0-3433-85a2-c91c42d4c969",
                    "sense_definition": "Of a person or their actions or qualities: intellectually, morally, or spiritually superior.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "superiority",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The philosopher's life was a <w>sublime</w> example of dedication to the truth.",
                            "target_lang_translations": {
                                "ru": "Жизнь философа была <w>высоким</w> примером преданности истине."
                            }
                        },
                        {
                            "text": "Saving the child from the fire was a <w>sublime</w> deed that earned him a medal of honor.",
                            "target_lang_translations": {
                                "ru": "Спасение ребенка из огня было <w>благородным</w> поступком, за который он получил почетную медаль."
                            }
                        }
                    ],
                    "antonyms": [
                        "profound"
                    ],
                    "common_phrases": [
                        "sublime deed",
                        "sublime sacrifice"
                    ],
                    "target_lang_definitions": {
                        "ru": "О человеке, его поступках или качествах: интеллектуально, морально или духовно превосходящий других; благородный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возвышенный",
                                "target_lang_sense_clarification": "о моральных качествах или целях"
                            },
                            {
                                "target_lang_word": "благородный",
                                "target_lang_sense_clarification": "о поступках или характере"
                            },
                            {
                                "target_lang_word": "высокий",
                                "target_lang_sense_clarification": "о помыслах или идеалах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f7443c47-8e9c-327c-b48f-c36612ef5b4c",
                    "sense_definition": "Of a thing: consummate, perfect; (informal, loosely) excellent, marvellous, wonderful.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "aesthetic_excellence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chef prepared a <w>sublime</w> meal that left every guest at the table speechless.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар приготовил <w>великолепный</w> ужин, который заставил всех гостей за столом замолчать от восторга."
                            }
                        },
                        {
                            "text": "Her performance on the violin was <w>sublime</w>, showing a level of skill rarely seen.",
                            "target_lang_translations": {
                                "ru": "Ее игра на скрипке была <w>превосходной</w>, демонстрируя редко встречающийся уровень мастерства."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sublime meal",
                        "sublime performance"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "loosely used for excellent"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "О предмете или явлении: совершенный, безупречный; (разг.) превосходный, чудесный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "великолепный",
                                "target_lang_sense_clarification": "о качестве чего-либо"
                            },
                            {
                                "target_lang_word": "превосходный",
                                "target_lang_sense_clarification": "высшей степени качества"
                            },
                            {
                                "target_lang_word": "божественный",
                                "target_lang_sense_clarification": "разг., о еде или искусстве"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9e5df94b-72d8-3ce1-8504-9b63ecb56042",
                    "sense_definition": "Complete, downright, utter.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "intensifier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is behaving like a <w>sublime</w> idiot by ignoring all the warnings.",
                            "target_lang_translations": {
                                "ru": "Он ведет себя как <w>совершенный</w> идиот, игнорируя все предупреждения."
                            }
                        },
                        {
                            "text": "The project failed due to a <w>sublime</w> lack of planning and coordination.",
                            "target_lang_translations": {
                                "ru": "Проект провалился из-за <w>абсолютного</w> отсутствия планирования и координации."
                            }
                        }
                    ],
                    "synonyms": [
                        "absolute",
                        "out-and-out"
                    ],
                    "common_phrases": [
                        "sublime idiot",
                        "sublime indifference"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полный, совершенный, абсолютный (часто в негативном контексте)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "совершенный",
                                "target_lang_sense_clarification": "в значении абсолютный"
                            },
                            {
                                "target_lang_word": "крайний",
                                "target_lang_sense_clarification": "о степени проявления качества"
                            },
                            {
                                "target_lang_word": "абсолютный",
                                "target_lang_sense_clarification": "полный, ничем не ограниченный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9472c94b-f407-3ad4-aa25-040e4107ff13",
                    "sense_definition": "High, tall, towering; also, positioned in a high place; high-up, lofty.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physical_height",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The castle stood <w>sublime</w> upon the cliff, overlooking the entire valley below.",
                            "target_lang_translations": {
                                "ru": "Замок <w>величественно возвышался</w> на утесе, возвышаясь над всей долиной внизу."
                            }
                        },
                        {
                            "text": "From his <w>sublime</w> perch on the mountain, the eagle watched for its prey.",
                            "target_lang_translations": {
                                "ru": "Со своего <w>высокого</w> насеста на горе орел высматривал добычу."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in a literal physical sense today"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Высокий, возвышающийся; расположенный на большой высоте (архаичное значение)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "высокий",
                                "target_lang_sense_clarification": "о физическом расположении"
                            },
                            {
                                "target_lang_word": "возвышающийся",
                                "target_lang_sense_clarification": "над окружающей местностью"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f6bec9f5-82e7-3e5e-becb-9dde1d5eb2b8",
                    "sense_definition": "Of a person: haughty, proud.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "superiority",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The nobleman walked with a <w>sublime</w> air that made others feel insignificant.",
                            "target_lang_translations": {
                                "ru": "Дворянин шел с <w>надменным</w> видом, заставляя окружающих чувствовать себя ничтожными."
                            }
                        },
                        {
                            "text": "His <w>sublime</w> arrogance prevented him from admitting his obvious mistakes.",
                            "target_lang_translations": {
                                "ru": "Его <w>высокомерная</w> самоуверенность мешала ему признать очевидные ошибки."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "mostly found in older literature"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "О человеке: надменный, гордый, высокомерный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "высокомерный",
                                "target_lang_sense_clarification": "проявляющий превосходство"
                            },
                            {
                                "target_lang_word": "надменный",
                                "target_lang_sense_clarification": "о манере поведения"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ed7605ce-6df9-3079-b594-68f67c7e18da",
                    "sense_definition": "To raise (someone or an intangible thing) to a state of (especially moral or spiritual) excellence; to exalt.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "elevation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The poet sought to <w>sublime</w> the human experience through his evocative verses.",
                            "target_lang_translations": {
                                "ru": "Поэт стремился <w>возвысить</w> человеческий опыт через свои выразительные стихи."
                            }
                        },
                        {
                            "text": "Great art has the power to <w>sublime</w> the soul and inspire noble thoughts.",
                            "target_lang_translations": {
                                "ru": "Великое искусство обладает силой <w>облагораживать</w> душу и вдохновлять на благородные мысли."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sublime the soul"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поднимать (кого-либо или что-либо нематериальное) до состояния совершенства (особенно морального или духовного); возвышать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возвышать",
                                "target_lang_sense_clarification": "делать более благородным"
                            },
                            {
                                "target_lang_word": "облагораживать",
                                "target_lang_sense_clarification": "делать чище и лучше"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b037feda-d563-334f-8325-5a82b66c4b8b",
                    "sense_definition": "To change a solid substance into a gas without passing through the liquid state; synonym of <w>sublimate</w>.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "chemistry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the laboratory, we watched the iodine crystals <w>sublime</w> into a purple vapor.",
                            "target_lang_translations": {
                                "ru": "В лаборатории мы наблюдали, как кристаллы йода <w>сублимируются</w> в фиолетовый пар."
                            }
                        },
                        {
                            "text": "Dry ice will <w>sublime</w> at room temperature, turning directly into carbon dioxide gas.",
                            "target_lang_translations": {
                                "ru": "Сухой лед будет <w>возгоняться</w> при комнатной температуре, превращаясь непосредственно в углекислый газ."
                            }
                        }
                    ],
                    "synonyms": [
                        "sublimate"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical usage in chemistry"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Переходить из твердого состояния в газообразное, минуя жидкую фазу; сублимировать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сублимировать",
                                "target_lang_sense_clarification": "физико-химический процесс"
                            },
                            {
                                "target_lang_word": "возгонять",
                                "target_lang_sense_clarification": "технический термин"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e2ab18e0-17a6-37d8-9576-edec065c26f6",
                    "sense_definition": "That which is intellectually, morally, or spiritually superior in human life or human nature.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "abstract_concepts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The philosopher argued that the pursuit of the <w>sublime</w> is the highest human calling.",
                            "target_lang_translations": {
                                "ru": "Философ утверждал, что стремление к <w>возвышенному</w> — высшее призвание человека."
                            }
                        },
                        {
                            "text": "There is a thin line between the <w>sublime</w> and the ridiculous in modern art.",
                            "target_lang_translations": {
                                "ru": "В современном искусстве существует тонкая грань между <w>возвышенным</w> и смешным."
                            }
                        }
                    ],
                    "common_phrases": [
                        "the sublime and the ridiculous"
                    ],
                    "target_lang_definitions": {
                        "ru": "То, что является интеллектуально, морально или духовно высшим в человеческой жизни или природе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возвышенное",
                                "target_lang_sense_clarification": "философская или эстетическая категория"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}