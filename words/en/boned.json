{
    "word_family": [
        "bone",
        "bony",
        "boneless"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "03ec2e67-812f-3869-8a61-85236b694320",
                    "sense_definition": "Having had the bones removed before cooking.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "preparation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chef prepared a <w>boned</w> chicken for the main course.",
                            "target_lang_translations": {
                                "pl": "Szef kuchni przygotował na danie główne <w>trybowanego</w> kurczaka."
                            }
                        },
                        {
                            "text": "Always check if the fish is <w>boned</w> before serving it to children.",
                            "target_lang_translations": {
                                "pl": "Zawsze sprawdzaj, czy ryba jest <w>pozbawiona ości</w>, zanim podasz ją dzieciom."
                            }
                        }
                    ],
                    "synonyms": [
                        "deboned"
                    ],
                    "antonyms": [
                        "unboned"
                    ],
                    "common_phrases": [
                        "boned chicken",
                        "boned fish"
                    ],
                    "target_lang_definitions": {
                        "pl": "Pozbawiony kości przed gotowaniem."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "trybowany",
                                "target_lang_sense_clarification": "odnoszące się do mięsa, z którego usunięto kości"
                            },
                            {
                                "target_lang_word": "bez kości",
                                "target_lang_sense_clarification": "opis stanu produktu spożywczego"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2b302067-345b-3389-86ff-c6da1e642bf8",
                    "sense_definition": "Having a specific type or structure of bone.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Birds have light and hollow-<w>boned</w> skeletons to help them fly.",
                            "target_lang_translations": {
                                "pl": "Ptaki mają lekkie szkielety o <w>pustych w środku kościach</w>, co pomaga im latać."
                            }
                        },
                        {
                            "text": "The athlete was naturally large and thick-<w>boned</w>.",
                            "target_lang_translations": {
                                "pl": "Sportowiec był z natury duży i <w>grubokościsty</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hollow-boned",
                        "thick-boned"
                    ],
                    "target_lang_definitions": {
                        "pl": "Posiadający określony typ lub strukturę kości."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "o kościach",
                                "target_lang_sense_clarification": "używane w złożeniach opisujących budowę ciała"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "175083ed-c480-370e-a4e9-dcd90d275616",
                    "sense_definition": "In a situation with unfortunate circumstances that are difficult to overcome.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "slang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If we miss the last train, we are completely <w>boned</w>.",
                            "target_lang_translations": {
                                "pl": "Jeśli ucieknie nam ostatni pociąg, będziemy całkowicie <w>w kropce</w>."
                            }
                        },
                        {
                            "text": "Without a map in this forest, we are really <w>boned</w>.",
                            "target_lang_translations": {
                                "pl": "Bez mapy w tym lesie naprawdę <w>leżymy</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "screwed",
                        "fucked",
                        "up shit's creek"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Informal and potentially offensive."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "W trudnej, niekorzystnej sytuacji, z której ciężko wyjść (slang)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "w kropce",
                                "target_lang_sense_clarification": "idiom oznaczający bycie w trudnej sytuacji"
                            },
                            {
                                "target_lang_word": "leżeć",
                                "target_lang_sense_clarification": "potoczne określenie bycia w beznadziejnej sytuacji"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d9e378ae-3901-333a-8165-a0af64c2838f",
                    "sense_definition": "Simple past and past participle of <w>bone</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "grammar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The butcher <w>boned</w> the meat carefully.",
                            "target_lang_translations": {
                                "pl": "Rzeźnik starannie <w>wytrybował</w> mięso."
                            }
                        },
                        {
                            "text": "She has <w>boned</w> the fish for the recipe.",
                            "target_lang_translations": {
                                "pl": "Ona <w>wytrybowała</w> rybę do tego przepisu."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Grammatical inflection."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Czas przeszły i imiesłów czasu przeszłego od czasownika 'bone' (usuwać kości)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wytrybował",
                                "target_lang_sense_clarification": "czas przeszły od trybować"
                            },
                            {
                                "target_lang_word": "wytrybowany",
                                "target_lang_sense_clarification": "imiesłów przymiotnikowy bierny"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}