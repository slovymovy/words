                ],
                "senses": [
                    {
                        "sense_id": "e2481878-c703-344a-9af4-5d48ccf86601",
                        "entry_id": "0f944ff3-daab-3142-93c8-8af39b5c30a3",
                        "glosses": [
                            "baulicher Raum, aus dem heraus bestimmte Vorgänge gesteuert und überwacht werden; mit Informationsverarbeitung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "501f90a3-be3a-4bb7-b134-5a31674eb03c",
                                "sense_id": "e2481878-c703-344a-9af4-5d48ccf86601",
                                "text": "„Die Clarity Digital Displays und ihre hohe Bildqualität ermöglichen es dem Personal selbst Details von jedem Platz im Kontrollraum zu erkennen und sofort auf die Information zu reagieren.“"
                            },
                            {
                                "example_id": "f387a21d-1f0a-480e-a1cb-452d2344ad01",
                                "sense_id": "e2481878-c703-344a-9af4-5d48ccf86601",
                                "text": "„Bei großen Anlagen ist der Kontrollraum, die Schnittstelle zwischen Mensch und Maschine bzw. Mensch und Anlage.“"
                            },
                            {
                                "example_id": "1357f3ce-960e-4fef-97e5-c15853f1ae87",
                                "sense_id": "e2481878-c703-344a-9af4-5d48ccf86601",
                                "text": "„Der Begriff Leitstand hat meist einen industriellen Hintergrund, während Kontrollraum auch im Security-Bereich, Fernsehstudios und Verkehrsleitzentralen benutzt wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "831cc127-227b-3ca2-becf-3b03aa053974",
                        "entry_id": "0f944ff3-daab-3142-93c8-8af39b5c30a3",
                        "glosses": [
                            "Bereich, der unter Kontrolle steht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "570ff187-88c3-4bfb-acde-fd7aa31be0ec",
                                "sense_id": "831cc127-227b-3ca2-becf-3b03aa053974",
                                "text": "„Der Begriff Leitstand hat meist einen industriellen Hintergrund, während Kontrollraum auch im Security-Bereich, Fernsehstudios und Verkehrsleitzentralen benutzt wird.“"
                            },
                            {
                                "example_id": "6b0f837c-317b-4cd3-8ee6-6be47502c963",
                                "sense_id": "831cc127-227b-3ca2-becf-3b03aa053974",
                                "text": "Im festgelegten Kontrollraum haben sich keine fremden Personen aufzuhalten, da es ein Sicherheitsbereich ist."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3c0e4def-ea9c-49c1-b7bb-a8e5f0c19e24",
                        "source_entry_id": "0f944ff3-daab-3142-93c8-8af39b5c30a3",
