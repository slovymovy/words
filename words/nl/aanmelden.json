                },
                {
                    "sense_id": "de4a2d0c-6485-3f74-96a8-1d072f470409",
                    "sense_definition": "toegang krijgen tot een computersysteem met een gebruikersnaam en wachtwoord",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "computergebruik",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet je eerst <w>aanmelden</w> voordat je de bestanden kunt bekijken.",
                            "target_lang_translations": {
                                "en": "You must <w>log in</w> first before you can view the files."
                            }
                        },
                        {
                            "text": "Ik kan me niet <w>aanmelden</w> op de website omdat ik mijn wachtwoord ben vergeten.",
                            "target_lang_translations": {
                                "en": "I can't <w>sign in</w> to the website because I forgot my password."
                            }
                        }
                    ],
                    "synonyms": [
                        "inloggen"
                    ],
                    "antonyms": [
                        "afmelden"
                    ],
                    "common_phrases": [
                        "bij het systeem aanmelden",
                        "met een wachtwoord aanmelden"
                    ],
                    "target_lang_definitions": {
                        "en": "To gain access to a computer system using a username and password"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "log in",
                                "target_lang_sense_clarification": "to enter a computer system or website"
                            },
                            {
                                "target_lang_word": "sign in",
                                "target_lang_sense_clarification": "to identify oneself to a system to start a session"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8f57727c-80e3-3b54-ac54-d003fc9ad344",
                    "sense_definition": "de komst of aanwezigheid van iemand officieel kenbaar maken",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "aankondiging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De secretaresse zal de gasten bij de directeur <w>aanmelden</w>.",
                            "target_lang_translations": {
                                "en": "The secretary will <w>announce</w> the guests to the director."
                            }
                        },
                        {
                            "text": "U moet zich bij de receptie <w>aanmelden</w> zodra u het gebouw binnenkomt.",
                            "target_lang_translations": {
                                "en": "You must <w>report</w> to the reception as soon as you enter the building."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bij de receptie aanmelden",
                        "een bezoeker aanmelden"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vaak in een zakelijke of formele context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To officially announce the arrival or presence of someone"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "announce",
