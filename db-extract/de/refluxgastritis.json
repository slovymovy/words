                "senses": [
                    {
                        "sense_id": "7b897fcf-25f6-32ee-b237-a27c59614170",
                        "entry_id": "4400680c-998a-3661-9aee-00d56c31928d",
                        "glosses": [
                            "Rückfluss von Mageninhalt in die Speiseröhre, die mit Bauchschmerzen und Sodbrennen einhergehen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a6227bf-69e6-4158-bdf9-93a3cb2face8",
                                "sense_id": "7b897fcf-25f6-32ee-b237-a27c59614170",
                                "text": "„Wertvoller ist die endoskopische Untersuchung des Restmagens, insbesondere zur Abgrenzung gegenüber der postoperativen alkalischen Refluxgastritis.“"
                            },
                            {
                                "example_id": "b4d9bdcd-9e1b-45d8-98ec-49db9fc0f4ad",
                                "sense_id": "7b897fcf-25f6-32ee-b237-a27c59614170",
                                "text": "„Gallensäuren verursachen strukturelle Veränderungen im Magen und im Oesophagus wie Refluxgastritis und Refluxoesophagitis.“"
                            },
                            {
                                "example_id": "4f994023-2bf7-423c-84e1-20ecfe4dfc36",
                                "sense_id": "7b897fcf-25f6-32ee-b237-a27c59614170",
                                "text": "„Postoperative Refluxgastritis Reflux von alkalischem Duodenalsaft in den Magen mit Schleimhautschädigung.“"
                            },
                            {
                                "example_id": "1331fef7-cc26-4ff5-858d-4126b17cdbdb",
                                "sense_id": "7b897fcf-25f6-32ee-b237-a27c59614170",
                                "text": "„Im Vordergrund der Beschwerden stehen abdominale Schmerzen, Alkalische Refluxgastritis und Karzinome Blähungen und Durchfälle.“"
                            }
                        ],
