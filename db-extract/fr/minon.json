                    {
                        "sense_id": "7f5a1cc2-e3ee-3b95-8f25-7e32abe6912f",
                        "entry_id": "903da7fa-3996-35fc-b782-fc3c5442f4c6",
                        "glosses": [
                            "Nom d’amitié que les enfants donnent aux chats."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "a874cfac-f9eb-4684-8561-0278b702efea",
                                "sense_id": "7f5a1cc2-e3ee-3b95-8f25-7e32abe6912f",
                                "text": "Viens, minon, mon petit minon."
                            },
                            {
                                "example_id": "1056a2dc-971b-4664-a4e2-2bdd75e320cc",
                                "sense_id": "7f5a1cc2-e3ee-3b95-8f25-7e32abe6912f",
                                "text": "On appelle les animaux domestiques par leur nom, s'ils en ont. Le chat ou le chien peuvent avoir leur nom propre. On appellera le chat soit par son nom, soit simplement en lui criant « Minon, minon, minon ! »"
                            }
                        ]
                    },
                    {
                        "sense_id": "10ff1d4f-1017-3ad0-a991-8beb485e046f",
                        "entry_id": "903da7fa-3996-35fc-b782-fc3c5442f4c6",
                        "glosses": [
                            "Chaton d'une fleur mâle de châtaignier ou de noisetier."
                        ],
                        "tags": [
                            "Régionalisme"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "e4467c02-da66-3ca5-9b10-0751b7853863",
                        "entry_id": "903da7fa-3996-35fc-b782-fc3c5442f4c6",
                        "glosses": [
                            "Amas de poussière ; moutons."
                        ],
                        "tags": [
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "fe63be39-e9f7-46c1-a9ac-4504c04b0dcd",
                                "sense_id": "e4467c02-da66-3ca5-9b10-0751b7853863",
                                "text": "Pourvu qu'il n'y eût pas de « frandouilles » aux serviettes, ni de « minons » sous les meubles, — c'est-à-dire ni effilochages, ni duvet, elle se tenait pour satisfaite."
                            }
                        ]
                    },
