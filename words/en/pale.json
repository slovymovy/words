{
    "word_family": [
        "paleness",
        "palely",
        "impale",
        "paling"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1aaf1fd1-698c-3dd0-bbef-43ee3966f262",
                    "sense_definition": "Light in color; not dark or deep.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "color_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wore a <w>pale</w> blue dress to the wedding.",
                            "target_lang_translations": {
                                "ru": "Она надела <w>бледно</w>-голубое платье на свадьбу.",
                                "zh": "她穿了一件<w>浅</w>蓝色的裙子去参加婚礼。"
                            }
                        },
                        {
                            "text": "The walls of the nursery were painted a <w>pale</w> yellow.",
                            "target_lang_translations": {
                                "ru": "Стены детской были выкрашены в <w>бледно</w>-жёлтый цвет.",
                                "zh": "育儿室的墙壁被漆成了<w>淡</w>黄色。"
                            }
                        }
                    ],
                    "synonyms": [
                        "light",
                        "pastel"
                    ],
                    "antonyms": [
                        "dark",
                        "bright",
                        "deep",
                        "vivid"
                    ],
                    "common_phrases": [
                        "pale blue",
                        "pale green",
                        "pale skin",
                        "pale light"
                    ],
                    "target_lang_definitions": {
                        "ru": "Светлый по цвету; не темный и не насыщенный.",
                        "zh": "颜色浅；不深或不浓。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бледный",
                                "target_lang_sense_clarification": "о цвете"
                            },
                            {
                                "target_lang_word": "светлый",
                                "target_lang_sense_clarification": "о тоне краски"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "浅色",
                                "target_lang_sense_clarification": "指颜色不深"
                            },
                            {
                                "target_lang_word": "淡",
                                "target_lang_sense_clarification": "指颜色浅淡"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "772cd8ed-b411-37a3-a733-6fc28c49d28c",
                    "sense_definition": "Having a lighter skin color than usual, often due to sickness, shock, or fear.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "color_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He turned <w>pale</w> when he heard the terrible news.",
                            "target_lang_translations": {
                                "ru": "Он стал <w>бледным</w>, когда услышал ужасные новости.",
                                "zh": "听到那个可怕的消息时，他的脸色变得<w>苍白</w>。"
                            }
                        },
                        {
                            "text": "You look a bit <w>pale</w>; are you feeling okay?",
                            "target_lang_translations": {
                                "ru": "Ты выглядишь немного <w>бледным</w>; ты хорошо себя чувствуешь?",
                                "zh": "你看上去有点<w>苍白</w>，身体还好吗？"
                            }
                        }
                    ],
                    "synonyms": [
                        "pallid",
                        "wan",
                        "ashen",
                        "white",
                        "pasty",
                        "colorless"
                    ],
                    "antonyms": [
                        "flushed",
                        "rosy",
                        "ruddy"
                    ],
                    "common_phrases": [
                        "turn pale",
                        "go pale",
                        "deadly pale",
                        "pale face"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий более светлый цвет кожи, чем обычно, часто из-за болезни, шока или страха.",
                        "zh": "肤色比平时浅，通常是因为生病、震惊或恐惧。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бледный",
                                "target_lang_sense_clarification": "о лице или коже"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "苍白",
                                "target_lang_sense_clarification": "形容脸色或肤色"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d539e3a9-e220-3e70-9a92-4ec95a8826d5",
                    "sense_definition": "Feeble or faint; lacking in intensity or quality compared to something else.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "metaphorical_weakness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sequel was just a <w>pale</w> imitation of the original movie.",
                            "target_lang_translations": {
                                "ru": "Это продолжение было лишь <w>жалким</w> подобием оригинального фильма.",
                                "zh": "这部续集只是原版电影的<w>苍白</w>模仿。"
                            }
                        },
                        {
                            "text": "His explanation was a <w>pale</w> excuse for his rude behavior.",
                            "target_lang_translations": {
                                "ru": "Его объяснение было <w>слабым</w> оправданием его грубого поведения.",
                                "zh": "他的解释对他粗鲁的行为来说是一个<w>无力</w>的借口。"
                            }
                        }
                    ],
                    "synonyms": [
                        "weak",
                        "feeble",
                        "faint",
                        "poor"
                    ],
                    "antonyms": [
                        "strong",
                        "vivid"
                    ],
                    "common_phrases": [
                        "pale imitation",
                        "pale shadow",
                        "pale reflection"
                    ],
                    "target_lang_definitions": {
                        "ru": "Слабый или тусклый; лишенный интенсивности или качества по сравнению с чем-то другим.",
                        "zh": "虚弱或暗淡；与他物相比缺乏强度或质量。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жалкий",
                                "target_lang_sense_clarification": "ничтожный, слабый"
                            },
                            {
                                "target_lang_word": "бледный",
                                "target_lang_sense_clarification": "перен. невыразительный"
                            },
                            {
                                "target_lang_word": "слабый",
                                "target_lang_sense_clarification": "неубедительный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "苍白",
                                "target_lang_sense_clarification": "比喻无力或不深刻"
                            },
                            {
                                "target_lang_word": "无力",
                                "target_lang_sense_clarification": "指缺乏说服力"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "353949fe-bb52-38ab-bd5c-650dd163ec39",
                    "sense_definition": "To seem less important, serious, or good when compared to something else.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "verb_compare",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My problems <w>pale</w> in comparison to what she is going through.",
                            "target_lang_translations": {
                                "ru": "Мои проблемы <w>меркнут</w> по сравнению с тем, что переживает она.",
                                "zh": "与她所经历的一切相比，我的问题简直<w>相形见绌</w>。"
                            }
                        },
                        {
                            "text": "The cost of the meal <w>paled</w> beside the price of the rare wine.",
                            "target_lang_translations": {
                                "ru": "Стоимость еды <w>побледнела</w> рядом с ценой редкого вина.",
                                "zh": "这顿饭的费用在那瓶名贵葡萄酒的价格面前显得<w>逊色</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "diminish",
                        "fade"
                    ],
                    "common_phrases": [
                        "pale in comparison",
                        "pale beside",
                        "pale next to"
                    ],
                    "target_lang_definitions": {
                        "ru": "Казаться менее важным, серьезным или хорошим по сравнению с чем-то другим.",
                        "zh": "与他物相比显得不那么重要、严肃或优秀。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "меркнуть",
                                "target_lang_sense_clarification": "становиться менее значимым"
                            },
                            {
                                "target_lang_word": "бледнеть",
                                "target_lang_sense_clarification": "перен. уступать в сравнении"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "逊色",
                                "target_lang_sense_clarification": "指比不上"
                            },
                            {
                                "target_lang_word": "相形见绌",
                                "target_lang_sense_clarification": "指相比之下显得不足"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e443f3af-1122-362f-ba17-9ca9b7775f30",
                    "sense_definition": "To become pale in the face, usually because of shock or fear.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "verb_color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her face <w>paled</w> at the sight of the blood.",
                            "target_lang_translations": {
                                "ru": "Её лицо <w>побледнело</w> при виде крови.",
                                "zh": "看到血时，她的脸<w>变苍白</w>了。"
                            }
                        },
                        {
                            "text": "He <w>paled</w> visibly when the police officer approached him.",
                            "target_lang_translations": {
                                "ru": "Он заметно <w>побледнел</w>, когда к нему подошел полицейский.",
                                "zh": "当警察走近他时，他明显地<w>变苍白</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "blanch",
                        "whiten"
                    ],
                    "antonyms": [
                        "flush",
                        "blush"
                    ],
                    "target_lang_definitions": {
                        "ru": "Становиться бледным в лице, обычно от шока или страха.",
                        "zh": "脸色变白，通常是因为震惊或恐惧。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бледнеть",
                                "target_lang_sense_clarification": "терять румянец"
                            },
                            {
                                "target_lang_word": "побледнеть",
                                "target_lang_sense_clarification": "совершенный вид"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "变苍白",
                                "target_lang_sense_clarification": "指脸色失去血色"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3b571533-a38c-35a4-b753-de5b8e1ababc",
                    "sense_definition": "A boundary or limit; used in the phrase 'beyond the pale' to mean unacceptable behavior.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "noun_boundary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His rude comments were completely beyond the <w>pale</w>.",
                            "target_lang_translations": {
                                "ru": "Его грубые комментарии переходили все <w>границы</w>.",
                                "zh": "他粗鲁的评论完全超出了文明社会的<w>界限</w>。"
                            }
                        },
                        {
                            "text": "Such conduct is considered outside the <w>pale</w> of civilized society.",
                            "target_lang_translations": {
                                "ru": "Такое поведение считается выходящим за <w>рамки</w> цивилизованного общества.",
                                "zh": "这种行为被认为超出了文明社会的<w>范围</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "limit",
                        "bound",
                        "boundary"
                    ],
                    "common_phrases": [
                        "beyond the pale"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "mostly used in the idiom 'beyond the pale'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Граница или предел; используется в выражении 'beyond the pale' (за пределами допустимого).",
                        "zh": "界限或范围；用于短语“beyond the pale”表示不可接受的行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "граница",
                                "target_lang_sense_clarification": "в идиомах о допустимом"
                            },
                            {
                                "target_lang_word": "рамки",
                                "target_lang_sense_clarification": "пределы приличия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "界限",
                                "target_lang_sense_clarification": "指行为的底线"
                            },
                            {
                                "target_lang_word": "范围",
                                "target_lang_sense_clarification": "指社会规范的范畴"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3847abf7-220c-304b-9c17-cd31199a76a5",
                    "sense_definition": "A wooden stake or picket used to make a fence.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "noun_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The garden was surrounded by a fence made of sharpened wooden <w>pales</w>.",
                            "target_lang_translations": {
                                "ru": "Сад был окружен забором, сделанным из заостренных деревянных <w>кольев</w>.",
                                "zh": "花园被一圈用削尖的<w>木桩</w>围成的栅栏包围着。"
                            }
                        },
                        {
                            "text": "One <w>pale</w> was missing from the old gate.",
                            "target_lang_translations": {
                                "ru": "В старых воротах не хватало одной <w>штакетины</w>.",
                                "zh": "旧大门上少了一根<w>栅栏条</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "stake",
                        "picket",
                        "post"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "modern usage prefers 'stake' or 'picket'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Деревянный кол или заостренная планка, используемая для изготовления забора.",
                        "zh": "用于制作栅栏的木桩或尖木条。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кол",
                                "target_lang_sense_clarification": "заостренная палка"
                            },
                            {
                                "target_lang_word": "штакетина",
                                "target_lang_sense_clarification": "планка забора"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "木桩",
                                "target_lang_sense_clarification": "指栅栏的支撑物"
                            },
                            {
                                "target_lang_word": "栅栏条",
                                "target_lang_sense_clarification": "指围栏的组成部分"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0dc7dbdd-3b4e-37f6-8d2d-3a546d8e1d5b",
                    "sense_definition": "A broad vertical band down the middle of a shield in heraldry.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "noun_heraldry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The knight's shield featured a red <w>pale</w> on a silver background.",
                            "target_lang_translations": {
                                "ru": "На щите рыцаря был изображен красный <w>столб</w> на серебряном фоне.",
                                "zh": "骑士的盾牌上有一个银色背景下的红色<w>竖条</w>。"
                            }
                        },
                        {
                            "text": "The coat of arms is distinguished by a blue <w>pale</w> charged with three stars.",
                            "target_lang_translations": {
                                "ru": "Герб отличается синим <w>столбом</w>, обремененным тремя звездами.",
                                "zh": "该纹章的特征是一个带有三颗星的蓝色<w>竖条</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "heraldry"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Широкая вертикальная полоса посередине щита в геральдике.",
                        "zh": "纹章学中盾牌中间的宽垂直带。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "столб",
                                "target_lang_sense_clarification": "геральдическая фигура"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "竖条",
                                "target_lang_sense_clarification": "纹章中的垂直带"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "ef6ebdb0-1931-33fe-869f-e4d6d09ea067",
                    "sense_definition": "The area of Ireland under English government control in the Late Middle Ages.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "name_place",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "Life within the <w>Pale</w> was governed by English law.",
                            "target_lang_translations": {
                                "ru": "Жизнь внутри <w>Пейла</w> регулировалась английским правом.",
                                "zh": "在<w>佩尔</w>地区的生活受英国法律管辖。"
                            }
                        },
                        {
                            "text": "The settlers lived inside the <w>Pale</w> for protection.",
                            "target_lang_translations": {
                                "ru": "Поселенцы жили внутри <w>Пейла</w> ради защиты.",
                                "zh": "定居者为了寻求保护而住在<w>佩尔</w>地区内。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "historical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Территория Ирландии, находившаяся под управлением английского правительства в позднем Средневековье.",
                        "zh": "中世纪晚期爱尔兰受英国政府控制的地区。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Пейл",
                                "target_lang_sense_clarification": "историческая область"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "佩尔",
                                "target_lang_sense_clarification": "历史地名"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}