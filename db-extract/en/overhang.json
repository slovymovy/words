                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "6e06f405-d6c6-3a82-89f9-e4e7ff9fdf76",
                        "entry_id": "5f1c894f-ebd2-361e-a26d-f97d931f954b",
                        "glosses": [
                            "A fatty roll of pubis flab that hangs over one's genitals; a FUPA."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "745f8409-d83a-3419-8f10-63e16300a88a",
                        "entry_id": "5f1c894f-ebd2-361e-a26d-f97d931f954b",
                        "glosses": [
                            "Anything that overhangs or protrudes over its base, such as a wave immediately before breaking, or a protruding cliff or rock wall."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e248882c-e8bc-44c5-ba38-e23792071c6e",
                                "sense_id": "745f8409-d83a-3419-8f10-63e16300a88a",
                                "text": "These are firstly for products which need a cool room; secondly for products which can be stored on a standard pallet without overhang; and thirdly for products known as \"the uglies\" which always overhang a standard pallet."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9fd86ec2-3fb8-4052-b82b-25256faf742f",
                        "source_entry_id": "5f1c894f-ebd2-361e-a26d-f97d931f954b",
                        "source_sense_description": "in architecture",
                        "target_lang_word": "surplomb",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "surplomb",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "865f0fc4-f015-3159-bf70-c5332d40ddc6",
                                        "entry_id": "f352b6b5-05f4-3375-b5aa-f115517dc5c5",
                                        "glosses": [
                                            "État de ce qui n’est pas à plomb, de ce dont le haut avance plus que la base ou le pied ; on le dit surtout en parlant de constructions."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba124668-aba4-4380-a1f3-d9af4baa2120",
                                                "sense_id": "865f0fc4-f015-3159-bf70-c5332d40ddc6",
                                                "text": "J’allais, je venais sur le balcon, je jetais sur les passants un regard de surplomb."
                                            },
                                            {
                                                "example_id": "9c40f04e-dff2-456e-8a46-9171e72d22b0",
                                                "sense_id": "865f0fc4-f015-3159-bf70-c5332d40ddc6",
                                                "text": "Ce mur est en surplomb, il penche."
                                            },
                                            {
                                                "example_id": "cd9d0709-39a2-449b-abf3-bad34bd2c764",
                                                "sense_id": "865f0fc4-f015-3159-bf70-c5332d40ddc6",
                                                "text": "Des perdrix grandes ouvertes surgirent sans bruit du vallon, et se posèrent à trente pas sur notre gauche, sous le surplomb de la barre grise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b2261b8-519c-35a5-a622-7a7de38b4b8f",
                                        "entry_id": "f352b6b5-05f4-3375-b5aa-f115517dc5c5",
                                        "glosses": [
                                            "Posture de condescendance, de domination vis-à-vis de quelqu’un ou d’un groupe considéré comme plus faible ou inférieur."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4a6cded-caed-4b67-9d68-88e6311ffbb8",
                                                "sense_id": "3b2261b8-519c-35a5-a622-7a7de38b4b8f",
                                                "text": "Il n’aurait pas fallu accueillir la parole des victimes telle qu’elle se donne ? Il faudrait passer cette parole au crible de l’analyse des « Gardiens du temple », de ceux qui ne lui « feront pas dire n’importe quoi » ? Une telle posture n’est qu’une manière d’écouter en conservant une position de surplomb, de pouvoir en somme. La légitimité et le sens de la parole des victimes sont ainsi suspendues au jugement d’un tiers présenté comme instance légitime de vérité."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dfffe949-0392-4f9b-a2b8-4ad156642e6a",
