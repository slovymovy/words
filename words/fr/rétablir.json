            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ec658cab-5794-398f-ad23-5905c32eaebf",
                    "sense_definition": "Remettre en vigueur ou instaurer de nouveau ce qui avait cessé d'exister.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La police est intervenue rapidement pour <w>rétablir</w> le calme dans le quartier."
                        },
                        {
                            "text": "Le nouveau gouvernement a promis de <w>rétablir</w> la paix dans toute la région."
                        }
                    ],
                    "synonyms": [
                        "réinstaurer",
                        "restaurer"
                    ],
                    "antonyms": [
                        "abolir",
                        "supprimer"
                    ],
                    "common_phrases": [
