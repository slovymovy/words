                "senses": [
                    {
                        "sense_id": "bc9d6d22-44f2-3115-84f1-4de7ba15f02b",
                        "entry_id": "943abec9-9487-3ae3-805f-f0f341e9c2d4",
                        "glosses": [
                            "Construire, réaliser, se livrer à une activité quelconque"
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "cd81bb2f-fe9a-445c-bd7a-2a0697a24fe4",
                                "sense_id": "bc9d6d22-44f2-3115-84f1-4de7ba15f02b",
                                "text": "J’ai nablaté une merca pirate pour pouvoir lire après le couvre-feu."
                            },
                            {
                                "example_id": "ea097c21-eabe-4a51-b959-813fb686be62",
                                "sense_id": "bc9d6d22-44f2-3115-84f1-4de7ba15f02b",
                                "text": "Et comme toujours, après avoir nablaté, il faut dénablater, aussi les lendemains de la fête sont-ils des jours pénibles et, comme tels, révélateurs de bonnes volontés."
                            },
                            {
                                "example_id": "48822749-4813-4e6d-b42b-1c75ba8df8c2",
                                "sense_id": "bc9d6d22-44f2-3115-84f1-4de7ba15f02b",
                                "text": "Les missaires nablatent chaque fois qu'il faut nablater, boccardent, gigonnent, déboccardent, sesquitent, roudoutent et bètatisent à longueur de journée."
                            }
                        ]
                    }
