                "senses": [
                    {
                        "sense_id": "6e8b62a9-c910-3797-a422-e99fe64cbc76",
                        "entry_id": "966adc70-53ac-3710-85b9-7be5f7be61b6",
                        "glosses": [
                            "Établissement public de coopération intercommunale (EPCI), par exemple une communauté de communes."
                        ],
                        "tags": [
                            "France"
                        ],
                        "examples": [
                            {
                                "example_id": "6cef540c-0330-4506-8f08-320aad3e820d",
                                "sense_id": "6e8b62a9-c910-3797-a422-e99fe64cbc76",
                                "text": "L’intercommunalité pour profiter des retombées de l'autoroute A71, tel est le pari de trois communes, Verneix, Saint-Angel et Chamblet qui se sont unies dans un syndicat intercommunal pour mettre en valeur l'atout de leur situation avec le carrefour de la Croix de Fragne, aux extrémités du tronçon commun A 71-Route Centre Europe Atlantique."
                            },
                            {
                                "example_id": "a8abac31-26f6-4ac4-9e65-dce7cd3366a8",
                                "sense_id": "6e8b62a9-c910-3797-a422-e99fe64cbc76",
                                "text": "Lors de sa conférence de presse du mardi 14 janvier, le président de la République a annoncé pour 2014 une nouvelle réforme des collectivités locales et dit sa volonté « de mettre un terme aux enchevêtrements et doublons » des communes, intercommunalités départements et régions."
                            },
                            {
                                "example_id": "da0c6991-40c9-47c4-ae00-c9ae1ee4f17e",
                                "sense_id": "6e8b62a9-c910-3797-a422-e99fe64cbc76",
                                "text": "Je crois, pour ma part, en une intercommunalité de projet et réfute une intercommunalité subie."
                            },
                            {
                                "example_id": "ec14359e-e802-44ea-aa68-d878e566558a",
                                "sense_id": "6e8b62a9-c910-3797-a422-e99fe64cbc76",
                                "text": "Beaucoup de compétences des villes ont été transférées aux intercommunalités ou à des syndicats de communes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
