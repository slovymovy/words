                                "target_senses": [
                                    {
                                        "sense_id": "2ff82875-3744-36a1-b69c-0cefc999543a",
                                        "entry_id": "7b5f5c88-799b-3a97-bfda-415720a8f2de",
                                        "glosses": [
                                            "ein Lebewesen, eine Pflanze oder ein Tier, das als der Urahn, als der heilige Vorfahr angesehen wird (in animistischen Völkern)"
                                        ],
                                        "tags": [
                                            "bei Naturvölkern"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "274e9026-562a-4ce9-81d3-b68e0c3ac0ae",
                                                "sense_id": "2ff82875-3744-36a1-b69c-0cefc999543a",
                                                "text": "Der Klan verehrte sein Totem als den Ahnen, dem in jeder Lebenslage Respekt zu zollen war."
                                            }
                                        ],
