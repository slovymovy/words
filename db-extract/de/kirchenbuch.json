                                        "glosses": [
                                            "Registre catholique retraçant les baptêmes, mariages et décès."
                                        ],
                                        "tags": [
                                            "Généalogie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "325804c9-ed4c-4cbe-8270-045fa2cdda31",
                                                "sense_id": "26f41d4e-db0d-3763-892e-81a149c5784b",
                                                "text": "L'exploitation des registres paroissiaux de Jerez de la Frontera, ville espagnole située en Andalousie près du port de Cadix, démontre notamment l'exubérance de la vie sous l'Ancien Régime, mais aussi l’omniprésence de la mort."
                                            },
                                            {
                                                "example_id": "9622f1cf-6b5e-4305-a283-0bc18c89b28d",
                                                "sense_id": "26f41d4e-db0d-3763-892e-81a149c5784b",
                                                "text": "Un registre paroissial est un livre dans lequel sont enregistrés les actes qui témoignent d’une appartenance à une confession chrétienne dans une paroisse."
                                            }
                                        ]
                                    }
                                ]
