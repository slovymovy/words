                "senses": [
                    {
                        "sense_id": "65823f16-cd01-3a5d-9d01-762004dcbf5c",
                        "entry_id": "7f21921f-675b-36ff-9c63-bbfaf44c7eb9",
                        "glosses": [
                            "Person, zu der man eine besonders starke Bindung hat, mit der man seelisch in vielen Bereichen übereinstimmt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dbccf454-5dfa-4b18-a306-88edee628906",
                                "sense_id": "65823f16-cd01-3a5d-9d01-762004dcbf5c",
                                "text": "„Das waren die letzten Worte, die ihr Vater von seinem Seelenverwandten Yeok Dosan gehört hatte.“"
                            },
                            {
                                "example_id": "98336468-fa33-4356-92fb-a4f09263a86d",
                                "sense_id": "65823f16-cd01-3a5d-9d01-762004dcbf5c",
                                "text": "„Er sagte, es sei unvermeidlich gewesen, ein Wirbelwind habe sie erfasst, sie seien Seelenverwandte gewesen.“"
                            },
                            {
                                "example_id": "87ac9586-e860-4c38-afe9-8695e9435f97",
                                "sense_id": "65823f16-cd01-3a5d-9d01-762004dcbf5c",
                                "text": "„Er fragt sich, ob sie beide Seelenverwandte sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b232568b-a0f9-4dee-ac28-5bb8e9b35c48",
