                                    {
                                        "sense_id": "f990fd5c-617d-341b-878d-9c57b1888a77",
                                        "entry_id": "9ddba3bf-2544-3f9d-ba95-7ec5c8bffd97",
                                        "glosses": [
                                            "Qui permet de consoler, qui apporte une consolation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54abc32b-8bfc-4e9a-b6e3-a560ba38bcec",
                                                "sense_id": "f990fd5c-617d-341b-878d-9c57b1888a77",
                                                "text": "Je vous dirai sur cela un beau mot de saint Augustin, et bien consolatif pour de certaines personnes."
                                            },
                                            {
                                                "example_id": "ddbc13c9-ae8f-43ff-b327-8877206e9286",
                                                "sense_id": "f990fd5c-617d-341b-878d-9c57b1888a77",
                                                "text": "Quand on fixe une heure à une femme, c’est sans y croire, c’est plutôt une heure qu’on se fixe à soi-même : on se dit qu’on n’aura à souffrir qu’à partir de ce moment-là. Voilà la vertu consolative du rendez-vous, du rendez-vous auquel elles ne se rendent pas."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
