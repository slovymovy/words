                        "glosses": [
                            "Donner un caractère hypertextuel à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2460f38e-3eb5-4c7a-b9b7-d1c4ca169c24",
                                "sense_id": "ce8d0ddc-19e5-3837-9ab5-0dd77bb613f5",
                                "text": "Qu’importe l'œuvre ou le discours, il est question d’attirer, de naviguer, de lier, d’hypertextualiser pour conserver l’individu, réduit à sa dimension de prospect, dans l’orbite d’influence des opérateurs susceptibles de monétiser cette attention."
                            },
                            {
                                "example_id": "210b5aa9-dcc9-4e7d-90d2-b1980f79f331",
                                "sense_id": "ce8d0ddc-19e5-3837-9ab5-0dd77bb613f5",
                                "text": "Il faut absolument combiner, croiser, intertextualiser, hypertextualiser."
                            }
                        ]
                    }
