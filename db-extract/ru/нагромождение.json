                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f5bffd42-d03a-4433-8472-8fcc7fb85e25",
                        "source_entry_id": "fca3f171-c8e4-3282-8801-3ed5dd148bea",
                        "target_lang_word": "amoncellement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "amoncellement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5ef9ab55-687f-3cbe-9a29-8708837ddba0",
                                        "entry_id": "248f568a-e1b1-36a5-aec1-0ed58fa99835",
                                        "glosses": [
                                            "Action d’amonceler ou résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08331586-6ed8-40bd-9190-8795efa30fdd",
                                                "sense_id": "5ef9ab55-687f-3cbe-9a29-8708837ddba0",
                                                "text": "L'homme auquel on comprime le cerveau avec le doigt, à un endroit où manque un morceau du crâne, cet homme n'éprouve aucune douleur, seulement il s'endort. Eh bien! le même phénomène arrive quand le cerveau est comprimé par un amoncellement du sang."
                                            },
                                            {
                                                "example_id": "0fccf211-116c-4701-99c6-424deec3759c",
                                                "sense_id": "5ef9ab55-687f-3cbe-9a29-8708837ddba0",
                                                "text": "Cette embouchure, protégée non par des roches, mais par un amoncellement assez singulier de terre et de sable, formait un port naturel, dans lequel deux ou trois navires eussent été parfaitement couverts contre les vents du large."
                                            },
                                            {
                                                "example_id": "f3defe1b-b3f1-490c-ae94-569bf3b3c966",
                                                "sense_id": "5ef9ab55-687f-3cbe-9a29-8708837ddba0",
                                                "text": "Au bout d'une heure de ce périlleux exercice, nous arrivons au pied du nouveau cratère, qui n'est qu'un amoncellement de rapilli."
                                            },
                                            {
                                                "example_id": "e1fa6dce-1cca-40f4-977e-4e9b8a9810ef",
                                                "sense_id": "5ef9ab55-687f-3cbe-9a29-8708837ddba0",
                                                "text": "Quand tout dort encore, les larges avenues de Carpentras voient affluer des amoncellements d'asperges, de petits pois, de pomme de terre, de cerises et de fraises."
                                            },
                                            {
                                                "example_id": "a8cfbdb1-efa3-4043-a8ed-66380c9a7640",
                                                "sense_id": "5ef9ab55-687f-3cbe-9a29-8708837ddba0",
                                                "text": "Une sorte de houle secoua les amoncellements graisseux de son ventre et rabattit sa tête contre le mur."
                                            },
                                            {
                                                "example_id": "5bed46d2-1df3-404b-932b-03784cfda01c",
                                                "sense_id": "5ef9ab55-687f-3cbe-9a29-8708837ddba0",
                                                "text": "Cet amoncellement de mesures rend par conséquent cette politique peu lisible : qui pourrait aujourd'hui dresser la liste exhaustive des multiples dispositifs qui la constituent ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "36b6c607-6f55-4587-a937-be4a8ff0e7fc",
                        "source_entry_id": "fca3f171-c8e4-3282-8801-3ed5dd148bea",
                        "target_lang_word": "amoncèlement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "amoncèlement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "96d48930-88ff-3d8d-a258-1c27f037d3e3",
                                        "entry_id": "ad90d9e1-42f6-37e6-a8d4-4b5f78365814",
                                        "glosses": [
                                            "Action d’amonceler ou résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0edcdd48-9efc-4069-9db4-5b670050297b",
                                                "sense_id": "96d48930-88ff-3d8d-a258-1c27f037d3e3",
                                                "text": "L’amoncèlement des capitaux."
                                            },
                                            {
                                                "example_id": "5dc9f52e-1d26-4249-a926-8660d59a3de3",
                                                "sense_id": "96d48930-88ff-3d8d-a258-1c27f037d3e3",
                                                "text": "La chevelure du jeune garçon de seize ans tombante sur ses épaules larges comme un amoncèlement hasardeux de briques jouait avec le soleil qui traversait le hall depuis les hautes fenêtres donnant sur une petite cour."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
