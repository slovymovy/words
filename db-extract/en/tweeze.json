                "senses": [
                    {
                        "sense_id": "f8cd60c7-f077-3585-bb4d-e4bd3d632e9c",
                        "entry_id": "49bdeb1a-79e5-3ee1-9a25-6f227fc163da",
                        "glosses": [
                            "To pluck or grasp using tweezers."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "879591d6-f604-497d-ac81-66126611d50e",
                                "sense_id": "f8cd60c7-f077-3585-bb4d-e4bd3d632e9c",
                                "text": "Stamp-men tweeze their treasures to avoid smudging, wear, tear; to hold them up to the light or pick them out of benzine baths in search of watermarks."
                            },
                            {
                                "example_id": "a5a85fc6-1caa-4705-8efb-a79f3e9bfdd5",
                                "sense_id": "f8cd60c7-f077-3585-bb4d-e4bd3d632e9c",
                                "text": "He held his usual levee at his lodgings; he spent the usual hours washing and dressing; he rubbed his teeth with a red root, tweezed out hairs with a silver tweezer, tied his cravat to admiration, and issued at four precisely as perfectly equipped as if the Rue Royale had been St. James's Street and the Prince himself had hung upon his arm."
                            }
                        ]
                    },
                    {
                        "sense_id": "bc700897-6353-3c00-8916-4fdc269603d5",
                        "entry_id": "49bdeb1a-79e5-3ee1-9a25-6f227fc163da",
                        "glosses": [
                            "To shape by plucking out hairs with tweezers."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "d9d9a532-3e75-4e76-8d4f-9afa280c3517",
                                "sense_id": "bc700897-6353-3c00-8916-4fdc269603d5",
                                "text": "Here Mrs. Lawrence had smiled to soften the anxiety of her blue eyes under their frowning, carefully tweezed brows."
                            },
                            {
                                "example_id": "66977c29-5266-4405-aa1f-5282ca244923",
                                "sense_id": "bc700897-6353-3c00-8916-4fdc269603d5",
                                "text": "He’d run his lacquered, dusky pink index finger over his tweezed mustache and say […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "3a0e4719-7741-35ea-a98f-f314fea0dd6d",
                        "entry_id": "49bdeb1a-79e5-3ee1-9a25-6f227fc163da",
                        "glosses": [
                            "To pluck out hairs using tweezers."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "964790b9-8de1-4bb6-a649-6fd47ae0c019",
                                "sense_id": "3a0e4719-7741-35ea-a98f-f314fea0dd6d",
                                "text": "Word to the wise: if you must tweeze solo, stick to plucking only the obvious stray hairs."
                            }
                        ]
                    }
                ],
