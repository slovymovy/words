                "senses": [
                    {
                        "sense_id": "faf26847-fac0-38fc-bbb7-c75b93bb9975",
                        "entry_id": "f1b18b01-abee-3610-8d5c-0c3506eb4d4a",
                        "glosses": [
                            "Personen, die die Sicherheit von Veranstaltungen oder von Orten überwachen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dcc658eb-9892-42f2-80fa-b36a753a0729",
                                "sense_id": "faf26847-fac0-38fc-bbb7-c75b93bb9975",
                                "text": "„Jede Sektion wird von einem Emir befehligt, der sich selbst finanziert, Fatwas ausspricht, eine eigene Verwaltung und eigene Sicherheitsleute hat.“"
                            },
                            {
                                "example_id": "fef14192-984f-4eb8-9a7b-9ce34a1cc527",
                                "sense_id": "faf26847-fac0-38fc-bbb7-c75b93bb9975",
                                "text": "„In Brasilien galt Staatstrauer. Der Besitzer der Diskothek dürfte in seinen Vernehmungen dazu befragt werden, warum eine wichtige Fluchttür zum Zeitpunkt der Katastrophe offenbar abgesperrt war. Außerdem sollen Sicherheitsleute die nach draußen drängenden Gäste zunächst am Verlassen des Clubs gehindert haben.“"
                            },
                            {
                                "example_id": "c5446872-3f38-46b7-817e-95165376e1f6",
                                "sense_id": "faf26847-fac0-38fc-bbb7-c75b93bb9975",
                                "text": "„Die Sicherheitsleute hatten Wichtigeres zu tun, als den Oberkellner zu kontrollieren: Heinrich Lübke wollte einfach mal ungestört Verwandtschaft im sechs Kilometer entfernten Ortsteil Nikolausberg besuchen!“"
                            },
                            {
                                "example_id": "75e9b5c3-1753-4dcb-9a12-39771a0644eb",
                                "sense_id": "faf26847-fac0-38fc-bbb7-c75b93bb9975",
                                "text": "„Ich hingegen hatte schon häufiger Bekanntschaft mit unfreundlichen Sicherheitsleuten gemacht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
