                    {
                        "translation_id": "4481b48e-87b1-4625-a7fd-4cdbf9fb545c",
                        "source_entry_id": "0efb18f4-6f6c-3187-b41e-b0396a313d63",
                        "source_sense_id": "16016877-77b4-38f4-94bd-a583b8fd1d7a",
