                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nadat hij de ramen had <w>geruit</w>, was het huis eindelijk winddicht.",
                            "target_lang_translations": {
