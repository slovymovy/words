                        "entry_id": "890310d1-08b8-325f-876e-68bbfc028920",
                        "glosses": [
                            "Plante de la famille des Lamiacées, composé d’un très grand nombre d’espèces."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52189d82-2aac-40bb-b63c-4d6f02f29f57",
                                "sense_id": "dab28014-b656-384b-ba0a-0336d5cbcbd4",
                                "text": "Sur l’un des pans de mur poussait une germandrée."
                            }
                        ]
                    }
                ],
