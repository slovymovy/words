                                "target_lang_sense_clarification": "о чем-то, что постоянно беспокоит"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "28ee1c4c-a6de-3e3c-8a45-3d7573bf5586",
                    "sense_definition": "Arousing sexual desire without intending to satisfy it.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "teasing_behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The actress gave him a <w>teasing</w> glance before walking away.",
                            "target_lang_translations": {
                                "ru": "Актриса бросила на него <w>кокетливый</w> взгляд, прежде чем уйти."
                            }
                        },
                        {
                            "text": "She wore a <w>teasing</w> outfit that caught everyone's attention.",
                            "target_lang_translations": {
                                "ru": "На ней был <w>соблазнительный</w> наряд, который привлек всеобщее внимание."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Соблазняющий, вызывающий сексуальное желание без намерения его удовлетворить."
                    },
                    "translations": {
                        "ru": [
                            {
