                "senses": [
                    {
                        "sense_id": "cd6f0cac-3172-39d6-a7a9-e4522f87c399",
                        "entry_id": "a3420cc7-c704-396c-9ba9-5698bd8a03b9",
                        "glosses": [
                            "Fahrzeug, das dazu dient, zu fliehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3f9e0f0-6f9d-4c1f-a0b3-8547d1968d21",
                                "sense_id": "cd6f0cac-3172-39d6-a7a9-e4522f87c399",
                                "text": "Die Räuber hatten Pech mit ihrem Fluchtwagen, der einfach nicht ansprang."
                            },
                            {
                                "example_id": "d44fccc2-38c7-4eda-b33c-5d2b4076cd93",
                                "sense_id": "cd6f0cac-3172-39d6-a7a9-e4522f87c399",
                                "text": "„Die Gräfin gab ihren Leuten Anweisung, was sie auf ihre Fluchtwagen laden sollten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "10f14481-c115-47c5-b7d2-4f742358cc67",
                        "source_entry_id": "a3420cc7-c704-396c-9ba9-5698bd8a03b9",
                        "source_sense_id": "cd6f0cac-3172-39d6-a7a9-e4522f87c399",
                        "source_sense_description": "Fahrzeug, das dazu dient, zu fliehen",
                        "target_lang_word": "getaway car",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "getaway car",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2f63422a-4307-3ebb-8d1e-64880d6ab58b",
                                        "entry_id": "503c1861-f705-310d-8212-c2237508ef56",
                                        "glosses": [
                                            "A car (motor vehicle) that is left with the motor running and a driver in position while a crime is being committed so that the perpetrators may flee the scene quickly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6a2b2ff-a3e3-4222-9871-f1cbcff063c3",
                                                "sense_id": "2f63422a-4307-3ebb-8d1e-64880d6ab58b",
                                                "text": "There was an average Monday\nThere was a movie star\nThere was a man with a gun\nThere was a getaway car"
                                            },
                                            {
                                                "example_id": "4e93cc52-dd0e-4f8a-bc88-1454034b4494",
                                                "sense_id": "2f63422a-4307-3ebb-8d1e-64880d6ab58b",
                                                "text": "I'm in a getaway car\nI left you in a motel bar\nPut the money in the bag and I stole the keys\nThat was the last time you ever saw me"
                                            },
                                            {
                                                "example_id": "5f687926-0d25-48d6-ae49-f67e2825ae04",
                                                "sense_id": "2f63422a-4307-3ebb-8d1e-64880d6ab58b",
                                                "text": "The police had found the getaway car in the field. The rain had washed most of the yellow paint off the Mini to reveal the Union Jack underneath. There was no doubt that the car was Queenie. This led the police to their prime suspect, the car’s owner, Gilbert Goodie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
