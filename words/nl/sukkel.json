                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>sukkel</w> al de hele week met een vervelende griep.",
                            "target_lang_translations": {
                                "en": "I have been <w>struggling</w> with a nasty flu all week.",
                                "ru": "Я уже целую неделю <w>мучаюсь</w> с противным гриппом.",
