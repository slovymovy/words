                ],
                "senses": [
                    {
                        "sense_id": "7ffd2a69-cff5-3044-a716-68439e2e2b7b",
                        "entry_id": "c1868ab7-4055-3e2a-b01d-ac2ce1a0f8e3",
                        "glosses": [
                            "To deliver an apostrophe (an exclamatory speech) to someone, especially someone not present."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "aa2bd517-bb73-4960-bada-1a1dc0bb1773",
                                "sense_id": "7ffd2a69-cff5-3044-a716-68439e2e2b7b",
                                "text": "[S]he resumed her former occupation, and continued to soliloquize and apostrophize her absent hand-maidens, without even appearing sensible of his presence."
                            },
                            {
                                "example_id": "517d3319-d988-4b69-8f43-6663712619b3",
                                "sense_id": "7ffd2a69-cff5-3044-a716-68439e2e2b7b",
                                "text": "\"He fully believes he is one of the aristocracy! And he is so condescending to the son he so egregiously deludes that you might suppose him the most virtuous of parents. Oh!\" said the old lady, apostrophizing him with infinite vehemence. \"I could bite you!\""
                            },
                            {
                                "example_id": "8a7710cc-85a5-44b1-a676-470ceb0c4687",
                                "sense_id": "7ffd2a69-cff5-3044-a716-68439e2e2b7b",
                                "text": "“Ah! poultry, poultry! You little thought,” said Mr. Pumblechook, apostrophising the fowl in the dish, “when you was a young fledgling, what was in store for you. […]”"
                            },
                            {
                                "example_id": "0d706318-e354-4f7b-ad5b-ff5434cb9569",
                                "sense_id": "7ffd2a69-cff5-3044-a716-68439e2e2b7b",
                                "text": "Just as I could not shed tears, so was I incapable of apostrophizing God in my despair."
                            },
                            {
                                "example_id": "3d1a2736-80bc-41a8-b4b4-2403a2e4ede9",
                                "sense_id": "7ffd2a69-cff5-3044-a716-68439e2e2b7b",
                                "text": "Miss Phyllis Morgan, as the hapless heroine dressed in the shabbiest of clothes, appears in the midst of a gay and giddy throng; she apostrophises all and sundry there, including the villain, and has a magnificent scene which always brings down the house, and nightly adds to her histrionic laurels."
                            }
                        ]
                    },
                    {
                        "sense_id": "3f0c2acb-df08-355f-9e38-a15b20170dab",
                        "entry_id": "c1868ab7-4055-3e2a-b01d-ac2ce1a0f8e3",
                        "glosses": [
                            "To add one or more apostrophe characters to text to indicate missing letters."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ab524f0f-1a58-4444-baa9-725925566b3f",
                        "source_entry_id": "c1868ab7-4055-3e2a-b01d-ac2ce1a0f8e3",
                        "source_sense_description": "to use the apostrophe in writing or speech",
                        "target_lang_word": "apostropher",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apostropher",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "df5c3bde-99c1-3f11-b67a-a1ea7259493c",
                                        "entry_id": "d78b0995-edb8-36e6-8056-a75ad0879f2b",
                                        "glosses": [
                                            "Interpeller par apostrophe une personne morte ou absente, ou un objet personnifié."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff8ea52a-031d-4397-94e5-db40c36e3b37",
                                                "sense_id": "df5c3bde-99c1-3f11-b67a-a1ea7259493c",
                                                "text": "Deux jours après, en s'en allant, il apostrophait les mœurs modernes.\n- L'amour prend la couleur de chaque siècle. En 1822 il est doctrinaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "509aa1f2-f3ef-3f23-aa95-4fbc29017499",
                                        "entry_id": "d78b0995-edb8-36e6-8056-a75ad0879f2b",
                                        "glosses": [
                                            "Interpeller quelqu’un pour lui dire quelque chose de façon impolie ou désagréable."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2694a9ef-35cf-4b65-bbee-79433f57d8dd",
                                                "sense_id": "509aa1f2-f3ef-3f23-aa95-4fbc29017499",
                                                "text": "Tous se désolaient, certains pleuraient, et Gabin les apostropha : « Pourquoi pleurnichez-vous, vous n’avez pas grand-chose à perdre. Tandis que moi… »"
                                            },
                                            {
                                                "example_id": "d3820c92-1818-498e-9f67-2116d30d60b2",
                                                "sense_id": "509aa1f2-f3ef-3f23-aa95-4fbc29017499",
                                                "text": "Les yeomen séparèrent les prêtres irrités, qui continuaient à élever la voix, s’apostrophant l’un l’autre en mauvais latin, […]."
                                            },
                                            {
                                                "example_id": "aec21d16-3d49-469e-af52-ff896cd2ea66",
                                                "sense_id": "509aa1f2-f3ef-3f23-aa95-4fbc29017499",
                                                "text": "Au moindre geste d’improbation, il nous apostrophait et nous imposait silence avec une fureur qui nous touchait sans nous convaincre ; […]."
                                            },
                                            {
                                                "example_id": "2149ee15-7c78-4d71-89b1-cb6db42b9b13",
                                                "sense_id": "509aa1f2-f3ef-3f23-aa95-4fbc29017499",
                                                "text": "Dites donc, vous autres, – les apostropha-t-il, […], – je meurs de fatigue, et je ne me tiens plus sur les jambes d’avoir été si longtemps en selle. Impossible de vous accorder une seule seconde d’entretien, je suis fourbu, esquinté."
                                            },
                                            {
                                                "example_id": "80b7292a-2786-439c-b0fa-f337aaa2dc2a",
                                                "sense_id": "509aa1f2-f3ef-3f23-aa95-4fbc29017499",
                                                "text": "Profitez en pour relire votre dossier. Ne sortez pas votre journal, le juge le prendrait fort mal et se faire apostropher en pleine audience est très désagréable. Un livre de poche peut être lu discrètement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b30c713-fa1d-30ed-88b2-820bcf4c5a3c",
                                        "entry_id": "d78b0995-edb8-36e6-8056-a75ad0879f2b",
                                        "glosses": [
                                            "Donner un coup (à quelqu’un)."
                                        ],
                                        "tags": [
                                            "hyperbole",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7093ac4a-bf10-4307-823b-4d9560f7de41",
                                                "sense_id": "8b30c713-fa1d-30ed-88b2-820bcf4c5a3c",
                                                "text": "Il l’a apostrophé d’un coup de bâton."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
