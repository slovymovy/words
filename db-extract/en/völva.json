                                                "sense_id": "bfe19269-4ed9-320e-88a9-59119367e62a",
                                                "text": "Anstelle einer Beantwortung von Odins vierter Frage folgt eine Halbstrophe, in der die Völva zeigt, daß sie Ödinn erkannt hat."
                                            },
                                            {
                                                "example_id": "aabd1ec4-57b2-4c47-9522-be0230579e1d",
                                                "sense_id": "bfe19269-4ed9-320e-88a9-59119367e62a",
                                                "text": "Als seine Trägerin erscheint im Norden die Völva, die wandernde Seherin. Sie ist uns aus mehreren Sagaszenen leidlich bekannt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
