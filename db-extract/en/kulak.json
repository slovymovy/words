                                        "glosses": [
                                            "устар. то же, что купец; перекупщик, переторговщик"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "33c26c1a-e865-3b29-a393-dabc22b2b111",
                                        "entry_id": "08e6d7db-fd08-3fad-a4b5-7d1a964d6018",
                                        "glosses": [
                                            "устар., уничиж. то же, что скупец; скупой человек, стяжатель"
                                        ],
                                        "tags": [],
