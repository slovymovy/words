                "entry_id": "17f37c4c-7192-325d-84eb-a032ae2da1c0",
                "word": "humectant",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "a273c1f4-b745-42b9-b399-5a9785aaeca5",
                        "entry_id": "17f37c4c-7192-325d-84eb-a032ae2da1c0",
                        "tags": [
                            "plural"
                        ],
                        "form": "humectants"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "653be9a3-90a2-3a6c-8e32-a51beb832285",
                        "entry_id": "17f37c4c-7192-325d-84eb-a032ae2da1c0",
                        "glosses": [
                            "Any substance that promotes the retention of water, especially one used to keep a food product moist."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "432208fe-c846-4ff9-97f4-3777717d304b",
                                "sense_id": "653be9a3-90a2-3a6c-8e32-a51beb832285",
                                "text": "[…] that you have induced a horrid phlegmatic condition with will soon require a liberal and generous humectant to keep the very membranes of your very entrails from desquamating, chipping off and blocking up all the pipes of your body."
                            },
                            {
                                "example_id": "4df2021d-fc7b-494d-8a00-924887605295",
                                "sense_id": "653be9a3-90a2-3a6c-8e32-a51beb832285",
                                "text": "The humectant is preferably added at this stage, subsequent to centrifuging, because it increases the viscosity of the slurry. The centrifuged material with the combined humectant is then dried to remove all or most of the water."
                            },
                            {
                                "example_id": "c0327d4d-1d1f-4386-bdcb-96c0b4a475ed",
                                "sense_id": "653be9a3-90a2-3a6c-8e32-a51beb832285",
                                "text": "Sorbitol is an excellent humectant and is used to extend the shelf life of many baked goods and fillings."
                            }
                        ]
                    }
                ],
                "translations": [
