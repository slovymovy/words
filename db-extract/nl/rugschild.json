                                        "sense_id": "153f49bb-7320-353e-84a6-3c302b92afbd",
                                        "entry_id": "db2d2542-e931-39d2-a90c-fa996e8417df",
                                        "glosses": [
                                            "The casing of a self-contained single-unit artillery projectile."
