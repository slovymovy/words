                        "glosses": [
                            "Ancienne race de lévrier disparu, d’Occitanie, assez grand, à poil court."
                        ],
                        "tags": [
                            "Cynologie"
                        ],
                        "examples": [
                            {
                                "example_id": "5d2ab413-d1a0-4fac-98f9-c9c7a7d57460",
                                "sense_id": "f5b5ae48-4c86-3e7c-ad07-8cb1592fee60",
                                "text": "Le charnaigre forcait le gibier dans les ronces où il se retire."
                            },
                            {
                                "example_id": "21aca176-65fa-42b5-a5f3-7bf533964d57",
                                "sense_id": "f5b5ae48-4c86-3e7c-ad07-8cb1592fee60",
                                "text": "— Puis encore les lévriers charnaigres, qui bondissent; les lévriers harpés, sans ventre; les lévriers nobles, au râble large; les lévriers gigotes, aux os éloignés; les lévriers nobles, de longue encolure; les lévriers œuvres, au palais noir; […]."
                            }
                        ]
                    }
