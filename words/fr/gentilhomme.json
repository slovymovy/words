                    ]
                },
                {
                    "sense_id": "f15f5ecd-6fe5-379d-a6d8-954563f3450e",
                    "sense_definition": "Homme noble attaché au service ou à la personne d'un prince.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "noblesse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Plusieurs jeunes <w>gentilshommes</w> accompagnaient fidèlement le duc dans tous ses déplacements."
                        },
                        {
                            "text": "En tant que fidèle <w>gentilhomme</w> du roi, il refusait de participer à cette rébellion."
