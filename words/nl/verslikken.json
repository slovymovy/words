{
    "word_family": [
        "slikken",
        "inslikken",
        "doorslikken",
        "slik"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "dd00d7fb-b5e6-32a2-aeca-34bb6b41552e",
                    "sense_definition": "zich per ongeluk voedsel of drank in de luchtpijp in plaats van de slokdarm laten glijden",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "fysiek slikken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>verslikte</w> zich in een stukje brood en begon vreselijk te hoesten.",
                            "target_lang_translations": {
                                "en": "He <w>choked</w> on a piece of bread and started coughing terribly."
                            }
                        },
                        {
                            "text": "Pas op dat je je niet gaat <w>verslikken</w> in dat koude water.",
                            "target_lang_translations": {
                                "en": "Be careful not to <w>swallow</w> that cold water <w>the wrong way</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zich verslikken in water",
                        "zich lelijk verslikken"
                    ],
                    "target_lang_definitions": {
                        "en": "To accidentally have food or drink go down the windpipe instead of the esophagus"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "choke",
                                "target_lang_sense_clarification": "on food or drink"
                            },
                            {
                                "target_lang_word": "swallow the wrong way",
                                "target_lang_sense_clarification": "idiomatic expression for food entering the windpipe"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e11ec751-9a2c-3000-a6b9-76051b03b4fc",
                    "sense_definition": "zich verkijken op iets of de moeilijkheid van een situatie onderschatten",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figuurlijk onderschatten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij heeft zich <w>verslikt</w> in de moeilijkheid van het probleem.",
                            "target_lang_translations": {
                                "en": "He <w>underestimated</w> the difficulty of the problem."
                            }
                        },
                        {
                            "text": "De politicus heeft zich lelijk <w>verslikt</w> in de reactie van het publiek.",
                            "target_lang_translations": {
                                "en": "The politician badly <w>miscalculated</w> the public's reaction."
                            }
                        }
                    ],
                    "synonyms": [
                        "misrekenen",
                        "verkijken"
                    ],
                    "common_phrases": [
                        "zich verslikken in de taak",
                        "zich lelijk verslikken"
                    ],
                    "target_lang_definitions": {
                        "en": "To misjudge something or underestimate the difficulty of a situation"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bite off more than one can chew",
                                "target_lang_sense_clarification": "to take on a task that is too big"
                            },
                            {
                                "target_lang_word": "miscalculate",
                                "target_lang_sense_clarification": "to underestimate a situation"
                            },
                            {
                                "target_lang_word": "underestimate",
                                "target_lang_sense_clarification": "to judge something as less difficult than it is"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}