                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2b2879b1-e1ee-41f1-af45-755d75052b3c",
                        "source_entry_id": "175d4d54-2f9c-337f-9546-46ae8d0d4e39",
                        "target_lang_word": "Lottospiel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lottospiel",
                                "target_lang_code": "de",
