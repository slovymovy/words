                ],
                "senses": [
                    {
                        "sense_id": "64f390de-9b27-3053-b5b7-47621c60ff11",
                        "entry_id": "0aaf4621-3354-3fc1-8ab8-7d5d60f2ac4d",
                        "glosses": [
                            "Außenwand eines Hauses"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ba480bc-7126-4a14-94d2-af77b739a469",
                                "sense_id": "64f390de-9b27-3053-b5b7-47621c60ff11",
                                "text": "In dieser Straßen sehen die Hauswände besonders ungepflegt aus."
                            },
                            {
                                "example_id": "4f04f90a-681c-465b-b484-c9987b128217",
                                "sense_id": "64f390de-9b27-3053-b5b7-47621c60ff11",
                                "text": "„Auf der schwarzen Hauswand leuchtet gelb ein Fleck.“"
                            },
                            {
                                "example_id": "c0b0813a-9af1-4da0-a766-72485d699ae4",
                                "sense_id": "64f390de-9b27-3053-b5b7-47621c60ff11",
                                "text": "„Es war eine süße Illusion, wie das Versprechen der hell erleuchteten Schokoladenwerbung auf der Hauswand über ihm.“"
                            },
                            {
                                "example_id": "bad4fcfb-9226-488e-80c4-21c32d3229e5",
                                "sense_id": "64f390de-9b27-3053-b5b7-47621c60ff11",
                                "text": "„Sie verabschiedete sich von Frau Wolter und lehnte sich draußen an die Hauswand neben dem Küchenfenster.“"
                            },
                            {
                                "example_id": "ea28ce79-0464-4fd2-8aa8-8e9ba8b18aef",
                                "sense_id": "64f390de-9b27-3053-b5b7-47621c60ff11",
                                "text": "„Zwei Bauarbeiter arbeiteten an der Hauswand im fünften Stock.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
