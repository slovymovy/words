                                                "sense_id": "b8b22954-7602-38ee-81bb-eb232adf9a48",
                                                "text": "the collective body of a nation"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8244d480-57ad-38f3-8f51-2618ea253f7d",
                                        "entry_id": "970dc2fe-30e6-3de8-9469-6c97bb28ef8d",
                                        "glosses": [
                                            "Tending to collect; forming a collection."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e42fa66a-a0cf-4498-a587-faa95d55f5b6",
                                                "sense_id": "8244d480-57ad-38f3-8f51-2618ea253f7d",
                                                "text": "Local is his throne […] to fix a point, / A central point, collective of his sons."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5c4a268-681d-3a03-ad56-acbaf5ff8ef3",
                                        "entry_id": "970dc2fe-30e6-3de8-9469-6c97bb28ef8d",
                                        "glosses": [
                                            "Having plurality of origin or authority."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b480853e-1245-3cda-924e-e740b58d2d91",
                                        "entry_id": "970dc2fe-30e6-3de8-9469-6c97bb28ef8d",
                                        "glosses": [
                                            "Expressing a collection or aggregate of individuals, by a singular form."
                                        ],
                                        "tags": [
