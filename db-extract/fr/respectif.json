                                "target_senses": [
                                    {
                                        "sense_id": "96efbd0a-0318-3aeb-9eb0-39348420b455",
                                        "entry_id": "3cdd3fd8-fcc3-3f90-a85c-898edaa8fae1",
                                        "glosses": [
                                            "jeweilig"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
