                ],
                "senses": [
                    {
                        "sense_id": "695d39ae-f223-323b-897d-311cb569bd51",
                        "entry_id": "45d95746-cd52-3695-9aea-aa272f2fe093",
                        "glosses": [
                            "giftiges, weißes Pigment mit hoher Deckkraft auf Basis des Metalls Blei"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af42f5b6-5912-41fd-a289-1d1479e2c750",
                                "sense_id": "695d39ae-f223-323b-897d-311cb569bd51",
                                "text": "„Natürlich stieß der Chemiker Ostwald bald zu Problemen der chemischen Beschaffenheit der Farben vor und stellte fest, daß den Künstlern hier oftmals das einfachste Wissen fehlt und häufig gesundheitsschädigende Farben, so unter anderem Bleiweiß, verwendet werden.“"
                            },
                            {
                                "example_id": "898897ea-12a8-41dc-b6f0-faaf8a0eed74",
                                "sense_id": "695d39ae-f223-323b-897d-311cb569bd51",
                                "text": "„Um ein Gemälde auf Echtheit zu prüfen, werden häufig die verwendeten Weißpigmente untersucht. Im Mittelalter nutzte man Bleiweiß, Titanweiß kam erst im 20. Jahrhundert auf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
