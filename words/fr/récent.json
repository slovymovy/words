                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les événements <w>récents</w> ont complètement modifié le calendrier de notre équipe.",
                            "target_lang_translations": {
                                "en": "<w>Recent</w> events have completely changed our team's schedule.",
                                "ru": "<w>Недавние</w> события полностью изменили график нашей команды.",
                                "nl": "De <w>recente</w> gebeurtenissen hebben de planning van ons team volledig veranderd.",
                                "de": "Die <w>jüngsten</w> Ereignisse haben den Terminplan unseres Teams vollständig verändert.",
                                "pl": "<w>Niedawne</w> wydarzenia całkowicie zmieniły harmonogram naszego zespołu.",
                                "it": "Gli eventi <w>recenti</w> hanno completamente modificato il calendario della nostra squadra.",
                                "cs": "<w>Nedávné</w> události zcela změnily harmonogram našeho týmu.",
                                "tr": "<w>Son</w> olaylar ekibimizin takvimini tamamen değiştirdi.",
                                "es": "Los acontecimientos <w>recientes</w> han modificado completamente el calendario de nuestro equipo.",
                                "zh": "<w>最近</w>发生的事件彻底改变了我们团队的日程安排。"
                            }
                        },
                        {
                            "text": "Cette décision très <w>récente</w> a surpris l'ensemble des employés de l'entreprise.",
                            "target_lang_translations": {
                                "en": "This very <w>recent</w> decision has surprised all of the company's employees.",
                                "ru": "Это очень <w>недавнее</w> решение удивило всех сотрудников компании.",
                                "nl": "Deze zeer <w>recente</w> beslissing heeft alle medewerkers van het bedrijf verrast.",
                                "de": "Diese <w>jüngste</w> Entscheidung hat alle Mitarbeiter des Unternehmens überrascht.",
                                "pl": "Ta bardzo <w>niedawna</w> decyzja zaskoczyła wszystkich pracowników firmy.",
                                "it": "Questa decisione molto <w>recente</w> ha sorpreso tutti i dipendenti dell'azienda.",
                                "cs": "Toto velmi <w>nedávné</w> rozhodnutí překvapilo všechny zaměstnance firmy.",
                                "tr": "Bu çok <w>yeni</w> karar şirketin bütün çalışanlarını şaşırttı.",
                                "es": "Esta decisión muy <w>reciente</w> ha sorprendido a todos los empleados de la empresa.",
                                "zh": "这个<w>最近</w>做出的决定让公司全体员工都感到十分意外。"
                            }
                        }
