                ],
                "senses": [
                    {
                        "sense_id": "d1f7a395-48ba-3d05-a517-be6ca1a95441",
                        "entry_id": "97e864b8-be8a-3ff7-8381-6131c6f1ad2e",
                        "glosses": [
                            "ein abstoßender Fixpunkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bffb88b5-5e71-4a66-bdb1-448aa7086fc6",
                                "sense_id": "d1f7a395-48ba-3d05-a517-be6ca1a95441",
                                "text": "„Ein Fixpunkt, gegen den jede nahe genug begonnene Folge von Iterationen konvergiert, heißt Attraktor; und ein Fixpunkt, von dem sich jede nahe begonnene Folge von Iterationen entfernt (außer der trivialen Folge, die mit dem Fixpunkt selbst beginnt), heißt Repeller“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f2ba0abd-0fcc-3807-9afc-f1bee40a2cd2",
                        "entry_id": "97e864b8-be8a-3ff7-8381-6131c6f1ad2e",
                        "glosses": [
                            "eine abstoßend gepolte Elektrode"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a737c0a-01bd-4228-95e2-5ce60ecd53fc",
                                "sense_id": "f2ba0abd-0fcc-3807-9afc-f1bee40a2cd2",
                                "text": "„Die Ionen, die zwischen Repeller und erster Blende durch einen Laserpuls, der auch den zeitlichen Nullpunkt definiert, entstehen, werden durch den Repeller in das Massenspektrometer beschleunigt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "de7c68dc-5d35-37af-9336-488674609605",
                        "entry_id": "97e864b8-be8a-3ff7-8381-6131c6f1ad2e",
                        "glosses": [
                            "Rotor oder Turbine, die dem antreibenden Medium (Wasser oder Wind) die Energie entzieht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6b4b2dc-e88a-48dd-9af3-e84f665af35a",
                                "sense_id": "de7c68dc-5d35-37af-9336-488674609605",
                                "text": "„Zudem trieb der Repeller einen Generator zur Stromerzeugung an, bzw. lud man bei schwachem Wind die Akkumulatoren des kleinen \"Elektrizitätswerks\" damit auf.“"
                            },
                            {
                                "example_id": "76618303-6f08-41b9-bf01-b58a49b218d3",
                                "sense_id": "de7c68dc-5d35-37af-9336-488674609605",
                                "text": "Das Windrad ist eine Form des Repellers dazu zählt auch der Rotor einer Windmühle."
                            },
                            {
                                "example_id": "4269b284-bc3a-44e0-9428-352014bd0f66",
                                "sense_id": "de7c68dc-5d35-37af-9336-488674609605",
                                "text": "Der Rotor – ein Repeller, also kein Propeller – wird von der natürlichen Luftströmung angetrieben."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
