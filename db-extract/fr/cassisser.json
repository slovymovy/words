                "senses": [
                    {
                        "sense_id": "9209afb1-04c5-3ef5-8f16-8296872785ce",
                        "entry_id": "2bcee12b-9a62-3016-bd7d-4b1cefd4ed7c",
                        "glosses": [
                            "Additionner de cassis."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "e3c86593-c349-4198-a74e-5fc2334fcf80",
                                "sense_id": "9209afb1-04c5-3ef5-8f16-8296872785ce",
                                "text": "Des poires, oui, mais au vin rouge épicé et cassissé."
                            },
                            {
                                "example_id": "724158a7-433a-4de7-b894-85138c151715",
                                "sense_id": "9209afb1-04c5-3ef5-8f16-8296872785ce",
                                "text": "Publicité Advertising 1972 l'Héritier Guyot un grand cassis à tout cassisser."
                            },
                            {
                                "example_id": "8b8f3f93-5a0e-4a20-af22-467f91ee73c9",
                                "sense_id": "9209afb1-04c5-3ef5-8f16-8296872785ce",
                                "text": "Au commissariat central, on s’est lassé de mes débordements, on en a eu marre de mes larmes cassissées : on m’a déclaré (provisoirement) inapte à l’exercice de mes fonctions."
                            }
                        ]
                    },
                    {
                        "sense_id": "0e07c1a2-a043-3235-817a-1922d9a4f6cf",
                        "entry_id": "2bcee12b-9a62-3016-bd7d-4b1cefd4ed7c",
                        "glosses": [
                            "Émettre des arômes de cassis."
                        ],
                        "tags": [
                            "Extrêmement rare"
                        ],
                        "examples": [
                            {
                                "example_id": "55a6914c-f719-4147-b9ad-4051453465e6",
                                "sense_id": "0e07c1a2-a043-3235-817a-1922d9a4f6cf",
                                "text": "Il soutient bien son appellation, fleurant bon le terroir et cassissant à plaisir."
                            }
                        ]
                    }
