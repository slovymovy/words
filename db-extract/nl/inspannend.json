        "nl-extract.jsonl": [
            {
                "entry_id": "f9c5a1a4-ede8-3249-b43e-57ce0fe2b2e7",
                "word": "inspannend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3370f5ed-4200-3c8d-a194-1fe012b0aca2",
                        "entry_id": "f9c5a1a4-ede8-3249-b43e-57ce0fe2b2e7",
                        "glosses": [
                            "van iets dat het vermoeiend is of moeite kost"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85d0f1a1-8499-4cc3-b245-73b3bb38ecae",
                                "sense_id": "3370f5ed-4200-3c8d-a194-1fe012b0aca2",
                                "text": "Alles wordt in het werk gesteld om ervoor te zorgen dat de bestuurder ook na een inspannende of saaie, dus slaapverwekkende rit toch fit en ontspannen op de bestemming aankomt."
                            },
                            {
                                "example_id": "42f586ce-c489-4575-beb8-45919239a83c",
                                "sense_id": "3370f5ed-4200-3c8d-a194-1fe012b0aca2",
                                "text": "Ook de nieuwe assistentie- en hulpsystemen voor de bestuurder en de verder doorontwikkelde mogelijkheden op connectiviteitsgebied hebben een inspannende testmarathon doorstaan."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c778fcd5-1bee-46a6-960d-fd6827074234",
                        "source_entry_id": "f9c5a1a4-ede8-3249-b43e-57ce0fe2b2e7",
                        "source_sense_id": "3370f5ed-4200-3c8d-a194-1fe012b0aca2",
                        "source_sense_description": "van iets dat het vermoeiend is of moeite kost",
                        "target_lang_word": "strenuous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "strenuous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "63e53f6b-aa22-354a-96cf-b533f812ce8f",
                                        "entry_id": "5ac14d90-3d4b-3309-930f-f0b8d5eaab44",
                                        "glosses": [
                                            "Having great vigour or energy; forceful."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68e35135-8ef8-4e6d-9b78-e6d22615f0ac",
                                                "sense_id": "63e53f6b-aa22-354a-96cf-b533f812ce8f",
                                                "text": "strenuous exercise"
                                            },
                                            {
                                                "example_id": "c07b8459-e0ab-4b39-a520-0e07022c069a",
                                                "sense_id": "63e53f6b-aa22-354a-96cf-b533f812ce8f",
                                                "text": "strenuous activity"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9c0b746-4702-3824-8214-667b1c43813e",
                                        "entry_id": "5ac14d90-3d4b-3309-930f-f0b8d5eaab44",
                                        "glosses": [
                                            "Requiring great exertion; very laborious."
                                        ],
                                        "tags": [
                                            "of a task"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3aadceb0-e5ea-43cc-9129-659a1fff75df",
                                                "sense_id": "a9c0b746-4702-3824-8214-667b1c43813e",
                                                "text": "It [Troutbeck] has religious isolation also, for it is several miles—and very strenuous miles in winter—from the parish church at Mungrisdale, and the introduction of the harmonium to the waiting room was due to the zeal of a vicar of many years ago who, in the absence of any other room in the village, obtained permission to use the premises for services, including Sunday School. Most of his successors have continued this self-sacrificing duty."
                                            },
                                            {
                                                "example_id": "3456ebab-affe-4bf4-b9b3-e7cba563211c",
                                                "sense_id": "a9c0b746-4702-3824-8214-667b1c43813e",
                                                "text": "We can achieve this god‐likeness only by unremitting and strenuous effort of the intellect."
                                            },
                                            {
                                                "example_id": "8f1e9b8b-4b4c-47ed-bb4b-9ac143c47db9",
                                                "sense_id": "a9c0b746-4702-3824-8214-667b1c43813e",
                                                "text": "Whether you need to recover from a stressful day, a strenuous workout or even an injury or surgery, restorative yoga may be just the thing for you."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1a75ee5f-630e-4831-ba84-8b7fac981b59",
                        "source_entry_id": "f9c5a1a4-ede8-3249-b43e-57ce0fe2b2e7",
                        "source_sense_id": "3370f5ed-4200-3c8d-a194-1fe012b0aca2",
                        "source_sense_description": "van iets dat het vermoeiend is of moeite kost",
                        "target_lang_word": "energetic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "energetic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ec0c42e7-b9ef-3872-ae07-1fd2d2aa65a9",
                                        "entry_id": "e0852e9f-453d-358e-9b7c-7200bfcb7f1b",
                                        "glosses": [
                                            "Possessing or pertaining to energy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b2a8c26-65d2-488e-b21b-987c80a78fc9",
                                                "sense_id": "ec0c42e7-b9ef-3872-ae07-1fd2d2aa65a9",
                                                "text": "Cosmic rays are energetic particles from outer space."
                                            },
                                            {
                                                "example_id": "a211959d-a0d0-4d82-b8b8-3298ac823e29",
                                                "sense_id": "ec0c42e7-b9ef-3872-ae07-1fd2d2aa65a9",
                                                "text": "energetic laws"
                                            },
                                            {
                                                "example_id": "a68aa9ea-9a3d-473a-9bde-fa8665de63ce",
                                                "sense_id": "ec0c42e7-b9ef-3872-ae07-1fd2d2aa65a9",
                                                "text": "Now lift the inverted jar so that the air can get at the outside of the “porous cup” and instantly the energetic illuminating gas which is now inside the “porous cup” begins to come out, and the water rises in the glass tube to take its place."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8114133-f844-3bc0-8ed2-592dd659f680",
                                        "entry_id": "e0852e9f-453d-358e-9b7c-7200bfcb7f1b",
                                        "glosses": [
                                            "Characterised by force or vigour; full of energy; lively, vigorous, furious."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a516c58-f938-45d0-99ec-891435714b20",
                                                "sense_id": "e8114133-f844-3bc0-8ed2-592dd659f680",
                                                "text": "Those kids are so energetic: they want to run around playing all day."
                                            },
                                            {
                                                "example_id": "875842c6-cd50-4097-a90c-e2a3103c3640",
                                                "sense_id": "e8114133-f844-3bc0-8ed2-592dd659f680",
                                                "text": "They are even now insulted with all the arguments which have been used in favor of energetic governments, ever since the days of Pharaoh: but every one knew, long before our revolution, that an energetic government could be supported […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d6524d0-bfb4-3761-95d1-6d3a1b642f61",
                                        "entry_id": "e0852e9f-453d-358e-9b7c-7200bfcb7f1b",
                                        "glosses": [
                                            "Having powerful effects; efficacious, potent."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1dcb41b3-5776-447c-9617-3daa6b4c2eda",
                                                "sense_id": "2d6524d0-bfb4-3761-95d1-6d3a1b642f61",
                                                "text": "At these energetic sounds, the sun hid himself beneath a gloomy cloud; and the waters of two little lakes, that were naturally clearer than crystal, became of a colour like blood."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "energetic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f796cd19-5048-34a4-8908-d167bda657d0",
                                        "entry_id": "f9588cd4-3660-3cad-a4ab-d5db695b52da",
                                        "glosses": [
                                            "Any material used for its release of energy, either as an explosive, propellant, or for pyrotechnic effects."
                                        ],
                                        "tags": [
                                            "in-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49d1831a-fa54-4908-8fb3-70ccd8809bcc",
                                                "sense_id": "f796cd19-5048-34a4-8908-d167bda657d0",
                                                "text": "Unfortunately, conventional nanoporous energetics can have poor long-term storage stability, and can be dangerously unstable, severely limiting their usefulness."
                                            },
                                            {
                                                "example_id": "bd6c2916-e4e1-48f7-bc74-2e57f816260d",
                                                "sense_id": "f796cd19-5048-34a4-8908-d167bda657d0",
                                                "text": "Improved energetics can help the Department of Defense build smaller munitions that still pack a punch."
                                            },
                                            {
                                                "example_id": "3e38cd56-902e-4cda-9807-3f6adb588ed4",
                                                "sense_id": "f796cd19-5048-34a4-8908-d167bda657d0",
                                                "text": "Where I will say there is something that we all have to watch is the underlying suppliers, the suppliers of solid rockets motors, of batteries, of energetics."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
