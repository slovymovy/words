                "senses": [
                    {
                        "sense_id": "8b4f074f-9eae-3096-8bc7-84cbff5c8436",
                        "entry_id": "248b51ca-cf5a-3d8b-8b7a-45f36f39c757",
                        "glosses": [
                            "een hoog, hoorbaar geluid dat lijkt op dat van een fluit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f4b6815-b744-4a6b-b70b-d85e591b5ef0",
                                "sense_id": "8b4f074f-9eae-3096-8bc7-84cbff5c8436",
                                "text": "Onderzoekers hebben in Indonesië bij toeval een nieuwe uilensoort ontdekt. De uil is bruinwit van kleur en maakt een zeer specifieke fluittoon. Volgens de onderzoekers is de uil nog nergens anders ter wereld aangetroffen."
                            },
                            {
                                "example_id": "08aad9f6-839e-48a3-8d35-7c65b2d49865",
                                "sense_id": "8b4f074f-9eae-3096-8bc7-84cbff5c8436",
                                "text": "Als er niet zo veel herrie was geweest, had hij kunnen nadenken over wat hem dwarszat, maar de krijsende fluittonen volgden elkaar op, onderbroken door explosies die je van hoofd tot voeten door elkaar schudden."
                            }
                        ]
                    },
                    {
                        "sense_id": "c7edb043-37bd-3d9b-8998-a5559cb9862a",
                        "entry_id": "248b51ca-cf5a-3d8b-8b7a-45f36f39c757",
                        "glosses": [
                            "een toon die iemand kan horen als er sprake is van een gehooraandoening"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "829366f8-bae4-48c5-b21a-1b4f99b06714",
                                "sense_id": "c7edb043-37bd-3d9b-8998-a5559cb9862a",
                                "text": "Verontrustende cijfers: een op de tien mensen hoort een constante ruis, fluittoon, knars of sirene. Onder jongeren piept het bij een op de vijf."
                            },
                            {
                                "example_id": "57691b4b-a09a-412a-aba4-c842542bef1c",
                                "sense_id": "c7edb043-37bd-3d9b-8998-a5559cb9862a",
                                "text": "De 17-jarige Lichtenvoordenaar vraagt een vergoeding voor zijn emotionele schade, 6000 euro. Volgens Waterman, die de jongen en zijn ouders kort geleden sprak, probeert de jongen groot te houden en verder gaan met zijn leven, maar zit hij met permanent gehoorverlies en een blijvende fluittoon in oor."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d87c3c0c-fbaa-4cf4-8ec3-087fadd1bad0",
                        "source_entry_id": "248b51ca-cf5a-3d8b-8b7a-45f36f39c757",
                        "source_sense_id": "8b4f074f-9eae-3096-8bc7-84cbff5c8436",
