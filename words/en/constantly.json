                                "target_lang_sense_clarification": "sabit olarak"
                            },
                            {
                                "target_lang_word": "sürekli",
                                "target_lang_sense_clarification": "düzenli ve tutarlı biçimde"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "始终",
                                "target_lang_sense_clarification": "自始至终保持不变"
                            },
                            {
