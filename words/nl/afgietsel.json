            "pos": "noun",
            "senses": [
                {
                    "sense_id": "442426be-8345-33c8-b6b8-a4b605c15367",
                    "sense_definition": "Een kopie van een origineel voorwerp, gemaakt door een vloeistof in een mal te laten uitharden.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "reproductie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In het museum staat een gipsen <w>afgietsel</w> van een beroemd Grieks standbeeld.",
                            "target_lang_translations": {
                                "en": "In the museum, there is a plaster <w>cast</w> of a famous Greek statue."
                            }
                        },
                        {
                            "text": "De kunstenaar maakte een nauwkeurig <w>afgietsel</w> van de antieke munt.",
                            "target_lang_translations": {
                                "en": "The artist made an accurate <w>replica</w> of the antique coin."
                            }
                        }
                    ],
                    "synonyms": [
                        "replica",
                        "kopie",
                        "reproductie"
                    ],
                    "antonyms": [
                        "origineel"
                    ],
                    "common_phrases": [
                        "gipsen afgietsel",
                        "nauwkeurig afgietsel",
                        "bronzen afgietsel"
                    ],
                    "target_lang_definitions": {
                        "en": "A copy of an original object, made by letting a liquid harden in a mold."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cast",
                                "target_lang_sense_clarification": "an object made in a mold"
                            },
                            {
                                "target_lang_word": "replica",
                                "target_lang_sense_clarification": "an exact copy or model"
                            },
                            {
                                "target_lang_word": "reproduction",
                                "target_lang_sense_clarification": "a copy of a work of art"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d50d7aad-3433-3f9a-a7f0-954de92d7e13",
                    "sense_definition": "Een voorwerp dat gevormd is door vloeibaar materiaal in een vorm te gieten.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "reproductie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het metalen <w>afgietsel</w> moest urenlang afkoelen voordat de mal geopend kon worden.",
                            "target_lang_translations": {
                                "en": "The metal <w>casting</w> had to cool for hours before the mold could be opened."
                            }
                        },
                        {
                            "text": "Elk <w>afgietsel</w> uit deze serie is genummerd door de maker.",
                            "target_lang_translations": {
                                "en": "Every <w>cast</w> from this series is numbered by the maker."
                            }
                        }
                    ],
                    "synonyms": [
