                "senses": [
                    {
                        "sense_id": "d771d9e0-01c4-3bd6-a5aa-8d478cbe8a8a",
                        "entry_id": "15a7c451-e218-387b-9911-d8d25b8a927d",
                        "glosses": [
                            "Type de chant exprimant la foi soufie interprété généralement par un petit ensemble de voix d’hommes accompagnées, pratiqué au Pakistan et en Inde."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4bdcadf7-0a04-4410-825f-1d3f02eff3af",
                                "sense_id": "d771d9e0-01c4-3bd6-a5aa-8d478cbe8a8a",
                                "text": "Au XIIe siècle de notre calendrier (le IVe siècle de l’Hégire), des formes poétiques venues d’Iran et d’Asie centrale, des formes musicales d’Inde du Nord et quatre langues (urdu, hindi, arabe et persan médiéval) se fondent en un art tout entier tendu vers la célébration de la gloire de Dieu, le qawwali."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eb3d93c5-db30-4352-970d-01e00ca6daa5",
                        "source_entry_id": "15a7c451-e218-387b-9911-d8d25b8a927d",
