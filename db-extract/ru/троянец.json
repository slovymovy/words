                                                "sense_id": "a2c4116f-afc5-30a0-860c-4d6a3a6b1dcb",
                                                "text": "Výjevy, jejichž rekonstrukce byla spojena s celou řadou problémů, představují boje, které sváděli Řekové s Trójany…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1dec1907-6c59-36b2-87a7-6ef5efe43731",
                                        "entry_id": "36b00145-2636-389e-82b9-9a72a2dcf925",
                                        "glosses": [
                                            "planetka nacházející se libračním centru planety L4 nebo L5, 60 stupňů před nebo za planetou"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "046065ea-1f64-427a-88db-643dd410ba6d",
                                                "sense_id": "1dec1907-6c59-36b2-87a7-6ef5efe43731",
                                                "text": "Nejznámějším příkladem těles nacházejících se v libračních bodech L4 a L5 jsou skupiny planetek nazývaných Trójané v libračních bodech soustavy Slunce-Jupiter."
                                            },
                                            {
                                                "example_id": "5032a21a-a604-4632-ad6f-cd64015d2df1",
                                                "sense_id": "1dec1907-6c59-36b2-87a7-6ef5efe43731",
                                                "text": "S. Tabachnik a N. Wyn Evans dále uvedli, že existují také Trójané Marsu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a182f5b9-8f0a-3835-91bc-586e34e821bf",
                                        "entry_id": "36b00145-2636-389e-82b9-9a72a2dcf925",
                                        "glosses": [
                                            "planetka v libračním centru soustavy Slunce-Jupiter nacházejícím se 60 stupňů za Jupiterem."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05852d00-bc8a-4a50-9944-f26fb6be7e51",
                                                "sense_id": "a182f5b9-8f0a-3835-91bc-586e34e821bf",
                                                "text": "U Jupitera jsou kolem L₄, L₅ rozsety skupiny planetek nazývané Trójané a Řekové nebo obě Trójané."
