                                "example_id": "1a2f5a06-82d6-4587-8bbc-993f942e3a0c",
                                "sense_id": "2bee35c9-0257-3872-a867-5e2feb8462c0",
                                "text": "Bref, je m'autoblinde et ne lésine pas sur les mémoires de masses externes..."
                            },
                            {
                                "example_id": "b8f70ca3-2ecf-4cd9-87bf-3e6e9774986c",
                                "sense_id": "2bee35c9-0257-3872-a867-5e2feb8462c0",
                                "text": "allons allons, on sait tous que je m'autoblinde!!!!"
