                "senses": [
                    {
                        "sense_id": "e6fd8233-a535-37ca-be56-bbc28183f7eb",
                        "entry_id": "32be9a4f-fd3d-39f2-a617-588a7992bfc0",
                        "glosses": [
                            "pseudonim Iosifa Wissarionowicza Dżugaszwiliego, radzieckiego polityka i przywódcy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3bae5f94-e166-49f4-8fc6-f021f1100dac",
                                "sense_id": "e6fd8233-a535-37ca-be56-bbc28183f7eb",
                                "text": "Śmierć Stalina spowodowała falę histerii w propagandzie i społeczeństwie oraz ostatni realny paroksyzm jego kultu"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3ec9435c-399c-48e1-9f87-61a53fde529e",
                        "source_entry_id": "32be9a4f-fd3d-39f2-a617-588a7992bfc0",
                        "source_sense_id": "e6fd8233-a535-37ca-be56-bbc28183f7eb",
                        "target_lang_word": "Stalin",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stalin",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "b3af77dd-72ff-3ae7-911b-6905002e8969",
                                        "entry_id": "9d8b2139-a41e-3557-825d-23145740c66a",
                                        "glosses": [
                                            "přezdívka ruského diktátora Josifa Vissarionoviče Džugašviliho, používaná jako příjmení"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c705d781-125a-4642-8cc7-98cbc210f9fc",
                                                "sense_id": "b3af77dd-72ff-3ae7-911b-6905002e8969",
                                                "text": "Při konferencích tří státníků v Teheránu a na Jaltě se Stalin zavázal, že pošle své armády proti Japonsku, jakmile bude poražena německá armáda."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "55c43f4d-f094-4171-ba00-a9fe98a8b516",
                        "source_entry_id": "32be9a4f-fd3d-39f2-a617-588a7992bfc0",
                        "source_sense_id": "e6fd8233-a535-37ca-be56-bbc28183f7eb",
                        "target_lang_word": "Staline",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Staline",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "39f8bdfa-d8cf-3200-95ca-72924f7fc5c4",
                                        "entry_id": "5d637e3e-cf3d-3b38-9a38-3c2e6cfc73fa",
                                        "glosses": [
                                            "Surnom, et seul nom utilisé de façon courante, du chef de l’Union soviétique entre 1928 et 1953. Surnom de Iossif Vissarionovitch Djougachvili."
                                        ],
                                        "tags": [
                                            "Communisme",
                                            "URSS"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c0a7bc9-df43-44d6-b893-e1abc538dc68",
                                                "sense_id": "39f8bdfa-d8cf-3200-95ca-72924f7fc5c4",
                                                "text": "La défaite consommée, Staline ne devait pas manquer de l’imputer à ses agents, de les mettre en accusation devant son Inquisition et de les faire disparaître."
                                            },
                                            {
                                                "example_id": "c2e40b1f-8e71-463a-b71e-701e34b39369",
                                                "sense_id": "39f8bdfa-d8cf-3200-95ca-72924f7fc5c4",
                                                "text": "Ce fut le rôle historique de Charles de Gaulle, qui avait déjà, de façon assez analogue, rendu acceptable à la bourgeoisie française l’entrée dans la coalition anti-hitlérienne aux côtés de Staline et des communistes français."
                                            },
                                            {
                                                "example_id": "2b5d660d-039c-4aef-800b-07680ad5c5f2",
                                                "sense_id": "39f8bdfa-d8cf-3200-95ca-72924f7fc5c4",
                                                "text": "On reconnaît Lénine au lit et, autour, Staline et Khroutchev, parmi beaucoup d’autres adorants plus ou moins identifiables, qui, comme on dit, lui « servent la soupe », et même si la soupe de Staline ressemble plutôt à un bouillon d’onze heure."
                                            },
                                            {
                                                "example_id": "d20635ba-1a6b-46bc-8d6c-c34367d1543e",
                                                "sense_id": "39f8bdfa-d8cf-3200-95ca-72924f7fc5c4",
                                                "text": "Ils affrontèrent la torture en traitant Staline de tous les noms…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "69404000-a037-473a-ae50-8782b0cbc097",
                        "source_entry_id": "32be9a4f-fd3d-39f2-a617-588a7992bfc0",
                        "source_sense_id": "e6fd8233-a535-37ca-be56-bbc28183f7eb",
                        "target_lang_word": "Сталин",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Сталин",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f2d9ce14-0b3e-3fc6-87de-21cbb7f099bc",
                                        "entry_id": "ead24bb1-9efd-3d3b-975f-be29a5fa0b4c",
                                        "glosses": [
                                            "наиболее известный из псевдонимов Иосифа Джугашвили, впоследствии принятый им и членами его семьи в качестве официальной фамилии"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2266705f-010e-4b08-b4e7-86af7a31c02f",
                                                "sense_id": "f2d9ce14-0b3e-3fc6-87de-21cbb7f099bc",
                                                "text": "Товарищ Сталин, вы большой учёный — // В языкознаньи знаете вы толк; // А я простой советский заключённый, // И мне товарищ — серый брянский волк."
                                            },
                                            {
                                                "example_id": "db6de06e-376c-4daf-bca5-eea16366148f",
                                                "sense_id": "f2d9ce14-0b3e-3fc6-87de-21cbb7f099bc",
                                                "text": "И даже майор-лётчик Василий Сталин, упоминаемый по радио в приказах Верховного, ― это тоже Сталин…"
                                            },
                                            {
                                                "example_id": "c3ac09d6-ab6a-4b2d-8486-2b1c0efa313b",
                                                "sense_id": "f2d9ce14-0b3e-3fc6-87de-21cbb7f099bc",
                                                "text": "Сообщили о том, что Светлана Сталина попросила убежище в Индии."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Сталин",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "aaa26976-37d8-3958-9b21-de01cdfa5298",
                                        "entry_id": "2e3629a7-780a-3a1b-bdf8-7471d13bbdb0",
                                        "glosses": [
                                            "мужское имя"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a18ab570-14d7-41bd-b65f-4736f2d72dc2",
                                                "sense_id": "aaa26976-37d8-3958-9b21-de01cdfa5298",
                                                "text": "Лучший бомбардир — Сталин Хосе Ривас («Минервен» Сьюдад-Гуайяна, Венесуэла) — 7 голов."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Сталин",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "1b831978-a502-3fbf-a309-d37f17eb03fb",
                                        "entry_id": "b6fff654-12ea-377f-af6c-8a5da2529926",
                                        "glosses": [
                                            "истор. название болгарского города Варна в 1949–1956 годах"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65021594-0cdb-496f-a906-58ce8155003b",
                                                "sense_id": "1b831978-a502-3fbf-a309-d37f17eb03fb",
                                                "text": "Город Сталин — один из лучших морских курортов Болгарии. Одновременно он является промышленным городом, портом и очагом культуры и просвещения."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "039320fb-371a-3c5e-947c-72224b671732",
                                        "entry_id": "b6fff654-12ea-377f-af6c-8a5da2529926",
                                        "glosses": [
                                            "истор. название румынского города Брашов в 1950–1960 годах"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8c71f37-2b6a-4493-8a78-ab26efad0ecd",
                                                "sense_id": "039320fb-371a-3c5e-947c-72224b671732",
                                                "text": "Краток путь стремительной горной реки Яломицы. Плотины превратят её крутопадающее двадцатипятикилометровое русло в подобие гигантской водяной лестницы, по всем ступеням которой расположится несколько гидроэлектростанций. Электроэнергия, вырабатываемая ими, будет направлена в столицу Румынии — Бухарест, в центр тракторной промышленности республики — город Сталин, в район отдыха трудящихся — Синаю."
                                            },
                                            {
                                                "example_id": "59a8ffe1-49c1-452d-83a6-bffbf57198ba",
                                                "sense_id": "039320fb-371a-3c5e-947c-72224b671732",
                                                "text": "Недалёк день, когда железная дорога от города Сталин до Кымпина будет электрифицирована. Широко развернулось в промышленных района страны строительство теплоэлектроцентралей. Некоторые из них уже вступили в строй. Так, теплоцентраль в Дойчешть, работающая на месте добычи лигнита, дала промышленный ток нашей столице Бухаресту, нефтедобывающим и нефтеперерабатывающим предприятиям долины Прахова, заводам города Сталин."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21d087a5-34f9-325f-80f3-1dc46bb0b075",
                                        "entry_id": "b6fff654-12ea-377f-af6c-8a5da2529926",
                                        "glosses": [
                                            "истор. название албанского города Кучова в 1950–1990 годах"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c6678ef-e6a7-42bc-8c58-13d4033ad58c",
                                                "sense_id": "21d087a5-34f9-325f-80f3-1dc46bb0b075",
                                                "text": "Между прочим, в Албании в каждом городе обязательно есть памятник Сталину и Ленину. А то и несколько. Есть даже город Сталин."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
