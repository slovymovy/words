                    }
                ],
                "senses": [
                    {
                        "sense_id": "6e6b4ce1-b216-3a79-85bf-23f09f9450a6",
                        "entry_id": "b288eecd-c320-32f6-b596-d1b1bb972acd",
                        "glosses": [
                            "Courte hache de guerre des guerriers francs de l’époque mérovingienne."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "628fd5a2-b321-33a1-8cde-389e5ad4364f",
                        "entry_id": "b288eecd-c320-32f6-b596-d1b1bb972acd",
                        "glosses": [
                            "Décoration française créée et décernée par le Régime de Vichy."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "621c7be4-04df-4aaf-866c-71cf1fed410e",
                                "sense_id": "628fd5a2-b321-33a1-8cde-389e5ad4364f",
                                "text": "Pétain va même s’inspirer d’une soi-disant hache gauloise pour créer sa francisque."
                            },
                            {
                                "example_id": "a6ed65f8-c74d-423e-85ec-5afa5fd57bb6",
                                "sense_id": "628fd5a2-b321-33a1-8cde-389e5ad4364f",
                                "text": "Comment défendre le fait qu’il ait obtenu la francisque de la main même du Maréchal ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "4d2169d8-e0ca-3303-b62d-762b7caa7d9c",
                        "entry_id": "b288eecd-c320-32f6-b596-d1b1bb972acd",
                        "glosses": [
                            "Meuble représentant l’arme du même nom à simple ou double tranchant dans les armoiries. La représentation est libre et peut s’inspirer de la forme ancienne (simple tranchant) qui était une arme de jet ou de la forme issue de la renaissance (double tranchant) qui a inspiré l’ordre de la Francisque du régime de Vichy."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b247129-6b31-48c6-a677-873766f753f0",
                                "sense_id": "4d2169d8-e0ca-3303-b62d-762b7caa7d9c",
                                "text": "De gueules à la champagne-pal d’argent chargée d’un angon d’azur mouvant de la pointe, supporté, en pointe, par quatre tourteaux du champ, deux l’un sur l’autre à dextre et deux l’un sur l’autre à senestre, soutenus d’un autre tourteau du même brochant sur l’angon, le pal accosté, à dextre, d’un besant d’or figuré d’un taureau furieux et, à senestre, d’une francisque contournée du même, qui est de Francueil d’Indre-et-Loire → voir illustration « armoiries avec une francisque à simple tranchant »"
                            },
                            {
                                "example_id": "7e0f263e-dfd8-46d5-a2f4-22db3f875557",
                                "sense_id": "4d2169d8-e0ca-3303-b62d-762b7caa7d9c",
                                "text": "Tiercé en bande : au premier d’azur semé de fleurs de lys d’or, au deuxième d’argent à la francisque de sable posée en bande, au troisième de gueules aux trois arbres d’or mouvant de la pointe, qui est de Franconville du Val-d’Oise → voir illustration « armoiries avec une francisque à double tranchant »"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
