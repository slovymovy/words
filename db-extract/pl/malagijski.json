                "senses": [
                    {
                        "sense_id": "bee09905-914b-34b3-8b38-1a418811dda5",
                        "entry_id": "36d54388-b89f-3c75-be71-2c73e4c1435c",
                        "glosses": [
                            "związany z Malagą, dotyczący Malagi"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9a4b6f7-556f-49a0-a43e-89810f9046ae",
                                "sense_id": "bee09905-914b-34b3-8b38-1a418811dda5",
                                "text": "W dwadzieścia lat później Kulawy miał taki sam pogląd na świat jak wówczas, kiedy żył w rozwiązłej atmosferze malagijskich lupanarów"
                            },
                            {
                                "example_id": "157b81ac-5f5d-46e0-a000-e1bbb8133e16",
                                "sense_id": "bee09905-914b-34b3-8b38-1a418811dda5",
                                "text": "Całymi dniami Amalia i jej siwiejący już dobrze małżonek wystawali przed stajnią lub siadywali na skrzynkach w słońcu, jak to robili chyba w swojej malagijskiej wiosce, skąd pochodzili"
                            },
                            {
                                "example_id": "f5b06935-1a01-4e7e-becb-e14932a938b6",
                                "sense_id": "bee09905-914b-34b3-8b38-1a418811dda5",
                                "text": "Prowincja Malaga jest najbardziej górzystą częścią Andaluzji, dzięki czemu istnieją tam doskonałe warunki do hodowli kóz. Tradycyjnie region ten był związany raczej z produkcją wina, jednak po tym, jak winnice zostały wyniszczone przez jeden z gatunków stonki, zaczęto hodować tutaj kozy malagijskie"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
