                                "target_senses": [
                                    {
                                        "sense_id": "c7660a5f-49ee-326d-b757-15990ea692e4",
                                        "entry_id": "7071e54e-1374-3d28-b7fa-45bec9a7b5bf",
                                        "glosses": [
                                            "Relatif à l’injonction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff7f1233-48f2-4c83-9dc6-c31af2f3f438",
                                                "sense_id": "c7660a5f-49ee-326d-b757-15990ea692e4",
                                                "text": "Pour se prémunir des messages, comme ceux reçus par Tatiana Silva, Hugo Clément dit éviter « un ton péremptoire et trop injonctif. Il faut surtout mettre l’accent sur les chiffres, les images et les explications scientifiques de l’impact de l’élevage sur l’environnement. »"
                                            },
                                            {
                                                "example_id": "255cb375-8765-47b7-a0e7-1208bbe411e7",
                                                "sense_id": "c7660a5f-49ee-326d-b757-15990ea692e4",
                                                "text": "Le serf est sommé (parole injonctive) de réaliser ce désir et, par conséquent, efface en lui tout désir propre."
                                            }
                                        ]
                                    }
                                ]
