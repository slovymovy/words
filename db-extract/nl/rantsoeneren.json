                "senses": [
                    {
                        "sense_id": "c69db997-55b9-380f-a85c-5238c204e386",
                        "entry_id": "35920acf-c05b-38d4-8ff5-df534fc2d500",
                        "glosses": [
                            "voorzien van de benodigde levensmiddelen"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "d31cf5b8-9b4c-3f6c-a419-8c6efa389bb0",
                        "entry_id": "35920acf-c05b-38d4-8ff5-df534fc2d500",
                        "glosses": [
                            "verdelen van een schaars goed door iedereen een kleinere, afgepaste hoeveelheid te geven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "585eaec0-4133-4357-84ca-03be36b51b2d",
                                "sense_id": "d31cf5b8-9b4c-3f6c-a419-8c6efa389bb0",
                                "text": "Het hele oosten van Afrika dreigt onleefbaar te worden. Ook in het Middellandse Zeegebied ziet de toekomst er vooral droog uit. Was het toeval dat Rome afgelopen zomer het water moest rantsoeneren?"
                            },
                            {
                                "example_id": "ff164a62-a6d7-4ba1-b413-3619fff75028",
                                "sense_id": "d31cf5b8-9b4c-3f6c-a419-8c6efa389bb0",
                                "text": "Sinds de ramp zijn 19 van de 54 kerncentrales nog in bedrijf. Functionarissen hebben gezegd dat in het slechtste geval alle reactors in Japan halverwege 2012 gesloten zouden kunnen worden. Dan zou het land 30 procent minder energie opwekken, wat weer zou leiden tot het structureel rantsoeneren van energie."
                            },
                            {
                                "example_id": "e72092a1-2fcf-4063-be6e-b2afb595a92e",
                                "sense_id": "d31cf5b8-9b4c-3f6c-a419-8c6efa389bb0",
                                "text": "Gezondheidszorg is een schaars goed. De gezondheidseconomie leert dat de vraag het aanbod altijd overtreft. Er is nooit genoeg voor iedereen. Zelfs voor de zorg die doorgaat voor noodzakelijk geldt dat er altijd mensen zullen zijn die niet krijgen wat zij nodig hebben. Gezondheidszorg is een goed dat per definitie wordt gerantsoeneerd."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9a13226a-8681-4448-9815-806995fefe7a",
                        "source_entry_id": "35920acf-c05b-38d4-8ff5-df534fc2d500",
                        "source_sense_id": "c69db997-55b9-380f-a85c-5238c204e386",
                        "source_sense_description": "verdelen van een schaars goed door iedereen een kleinere, afgepaste hoeveelheid te geven",
                        "target_lang_word": "ration",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ration",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "43203194-a391-3b88-9e26-42325f59b23b",
                                        "entry_id": "80d1a5b4-c1d4-3a57-bcd4-aa669e746425",
                                        "glosses": [
                                            "A portion of some limited resource, especially food, allocated to a person or group."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a158140-0bae-4f3f-ba50-54a5c245df5c",
                                                "sense_id": "43203194-a391-3b88-9e26-42325f59b23b",
                                                "text": "The corn ration was drastically reduced, and it was announced that an extra potato ration would be issued to make up for it."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ration",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8f2b6309-39a8-3aba-9957-e20a38761d2e",
                                        "entry_id": "c6df0359-ca67-3989-a89d-7349eba80fa3",
                                        "glosses": [
                                            "To supply with a ration; to limit (someone) to a specific allowance of something."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d475035-03bc-4f44-a360-1892cf439298",
                                                "sense_id": "8f2b6309-39a8-3aba-9957-e20a38761d2e",
                                                "text": "We rationed ourselves to three sips of water a day until we were rescued."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf9d7667-3f31-32f9-ae55-a285c4072711",
                                        "entry_id": "c6df0359-ca67-3989-a89d-7349eba80fa3",
                                        "glosses": [
                                            "To portion out (especially during a shortage of supply); to limit access to."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9f7f0c6-4cc9-4233-aa12-075a4d27c6d1",
                                                "sense_id": "bf9d7667-3f31-32f9-ae55-a285c4072711",
                                                "text": "By the third day on the raft, we had to ration our water."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e361cb4-3742-3df5-ae8f-786b8c98baa2",
                                        "entry_id": "c6df0359-ca67-3989-a89d-7349eba80fa3",
                                        "glosses": [
                                            "To restrict (an activity etc.)"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5fb27e2-8645-4d79-ac0c-1322b898a704",
                                                "sense_id": "4e361cb4-3742-3df5-ae8f-786b8c98baa2",
                                                "text": "Our present health care system is rationed only to those who can afford it because of unnecessary high cost, lack of insurance coverage by 47 million people, and exorbitant prescription prices."
                                            },
                                            {
                                                "example_id": "bb95d85e-380c-4af2-bb51-de9f131cda6f",
                                                "sense_id": "4e361cb4-3742-3df5-ae8f-786b8c98baa2",
                                                "text": "A theocratic state in which an equation is drawn between the Catholic hierarchy and God and the rights of citizens may be rationed by the church according to its doctrines."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
