                "senses": [
                    {
                        "sense_id": "e9501647-6d54-3acc-ab8c-86459027f881",
                        "entry_id": "d0d3dda6-08bb-3e4f-9094-6127934988cc",
                        "glosses": [
                            "Spielform, bei der die Chance erheblicher Gewinne, aber auch die Gefahr erheblicher Verluste gegeben ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e932ad4-0309-44cd-b37d-c2aec2fd6f2a",
                                "sense_id": "e9501647-6d54-3acc-ab8c-86459027f881",
                                "text": "„Aus dem ungebrochenen Drang der Jugendlichen, der Umgebung Spiel- und Handlungsräume abzugewinnen, entstehen Abenteuer- und Risikospiele auf Brücken, an Kanälen, in Kiesgruben, an Uferböschungen, auf Schienen und Autobahnen.“"
                            },
                            {
                                "example_id": "5938e4eb-3547-4c7a-bd8f-9cbe55eb7959",
                                "sense_id": "e9501647-6d54-3acc-ab8c-86459027f881",
                                "text": "„Das Risikospiel mit der totalen Freiheit scheint zu funktionieren – vielleicht auch, weil sich das Risiko in Grenzen hält.“"
                            },
                            {
                                "example_id": "085e149a-7ffe-427c-bb93-6788554a747e",
                                "sense_id": "e9501647-6d54-3acc-ab8c-86459027f881",
                                "text": "„Dann stürzen sie sich in ein Risikospiel, nennen wir es: Star-Stechen.“"
                            },
                            {
                                "example_id": "8b318060-67b9-4936-b0a4-6269dfdee87d",
                                "sense_id": "e9501647-6d54-3acc-ab8c-86459027f881",
                                "text": "„Russland im Gegenzug braucht stabile Absatzmärkte und kann sich andererseits nicht darauf verlassen, dass sich der Westen auf lange Sicht auf solche Risikospiele einlässt.“"
                            },
                            {
                                "example_id": "16293169-77ca-4d8b-881c-cbfc9c112c6c",
                                "sense_id": "e9501647-6d54-3acc-ab8c-86459027f881",
                                "text": "„Nicht so sehr deshalb, weil das atomare Risikospiel, exakt drei Jahre nach Tschernobyl, bei der französischen Cogema mit geringerem Einsatz gespielt werden kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9ec7a542-2ebb-3273-b05c-36ed747d654c",
                        "entry_id": "d0d3dda6-08bb-3e4f-9094-6127934988cc",
                        "glosses": [
                            "Turnierspiel mit erhöhten Gefahren für die öffentliche Sicherheit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a91fcdbb-d398-48bc-9057-6deff4d63728",
                                "sense_id": "9ec7a542-2ebb-3273-b05c-36ed747d654c",
                                "text": "„Die Partie zwischen Deutschland und Polen im Stade de France von Saint-Denis war als Risikospiel angesetzt worden.“"
                            },
                            {
                                "example_id": "1faf240b-1666-4aac-84eb-04e4daba6dfe",
                                "sense_id": "9ec7a542-2ebb-3273-b05c-36ed747d654c",
                                "text": "„So wurden Eintrittskarten beim Gäste-Kontingent nur noch personalisiert abgegeben - beim Risikospiel Cottbus gegen Dresden zeigte das positive Wirkung.“"
                            },
                            {
                                "example_id": "719f766a-bc3c-4bf4-acf8-98fe7ff1b105",
                                "sense_id": "9ec7a542-2ebb-3273-b05c-36ed747d654c",
                                "text": "„Der Sächsische Fußball-Verband fordert bereits, alle Spiele der Markranstädter als Risikospiele einzustufen.“"
                            },
                            {
                                "example_id": "2c87b038-a157-4ced-a3bd-a5f04e0fbdaf",
                                "sense_id": "9ec7a542-2ebb-3273-b05c-36ed747d654c",
                                "text": "„Frankreichs Behörden verteidigen ihr Vorgehen in Lille - die Polizei zeigt bei weiteren Risikospielen massiv Präsenz.“"
                            },
                            {
                                "example_id": "18255e13-e9c4-47c3-a762-b135a62aa35a",
                                "sense_id": "9ec7a542-2ebb-3273-b05c-36ed747d654c",
                                "text": "„Ich sitze im Fanbeirat, wir reden über Eintrittspreise, arbeiten aber auch eng mit der Polizei zusammen, gerade vor Risikospielen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
