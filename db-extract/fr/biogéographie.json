                ],
                "senses": [
                    {
                        "sense_id": "a97c8e7a-3e4b-32de-b7b3-8ba6d856ed8c",
                        "entry_id": "2ab5cf8b-7dca-33a9-87a4-c02eef84229f",
                        "glosses": [
                            "Branche interdisciplinaire qui étudie la répartition des êtres vivants à la surface de la Terre et les facteurs physiques, biologiques et historiques qui influencent cette répartition."
                        ],
                        "tags": [
                            "Géographie physique"
                        ],
                        "examples": [
                            {
                                "example_id": "49156dc2-fa39-49b0-bce9-433dfaebcfa5",
                                "sense_id": "a97c8e7a-3e4b-32de-b7b3-8ba6d856ed8c",
                                "text": "En contexte « naturel » comme sur les sites archéologiques, les analyses menées sur les charbons de bois visent notamment à raconter l’histoire de la forêt, les formes de gestion forestière, la biogéographie des essences identifiées, le peuplement forestier et, par conséquent, les événements climatiques."
                            },
                            {
                                "example_id": "debe0778-5890-4877-8b93-b1aa2e14af4b",
                                "sense_id": "a97c8e7a-3e4b-32de-b7b3-8ba6d856ed8c",
                                "text": "Avec sa thèse, Câmpia Româna, Vâlsan posera les bases de la géomorphologie en Roumanie, et fera des recherches remarquées sur la biogéographie, la géographie historique, l’anthropogéographie et la géographie humaine."
                            }
                        ]
                    }
                ],
                "translations": [
