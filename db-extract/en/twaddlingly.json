                        "examples": [
                            {
                                "example_id": "150b0224-d6b3-4f76-bc66-92326f1a000f",
                                "sense_id": "a604d66a-a8f2-3b33-bbe7-222a354fb504",
                                "text": "Let us call to mind those days, now twaddlingly called the \"good old times,\" when Music lay in its cradle […]"
                            },
                            {
                                "example_id": "811a925c-c35e-4e31-8751-1a36f20eed66",
                                "sense_id": "a604d66a-a8f2-3b33-bbe7-222a354fb504",
                                "text": "[…] in my opinion too weak and twaddlingly sentimental."
                            },
                            {
                                "example_id": "3bf3db3f-432c-4516-9809-b987c899444f",
                                "sense_id": "a604d66a-a8f2-3b33-bbe7-222a354fb504",
                                "text": "But almost everything has suffered from being twaddlingly coddled by an undiscerning and over-appreciative audience which appears to park its brains along with its Volvos."
                            }
                        ]
                    }
