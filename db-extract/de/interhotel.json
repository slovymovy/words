                "senses": [
                    {
                        "sense_id": "22944153-7b17-30a1-8da5-8c19a84684b9",
                        "entry_id": "b2226291-9180-367c-bfc7-92f2e871552e",
                        "glosses": [
                            "gut ausgestattetes Hotel einer DDR-Hotelkette, das für Gäste aus dem nichtsozialistischen Ausland vorgesehen war und in dem man mit Devisen zahlen musste"
                        ],
                        "tags": [
                            "in der DDR"
                        ],
                        "examples": [
                            {
                                "example_id": "cc1fbeed-1de3-4c3d-8f79-58cac709c855",
                                "sense_id": "22944153-7b17-30a1-8da5-8c19a84684b9",
                                "text": "„Doch auch die heruntergewirtschafteten Interhotels haben außer ihrer zumeist guten Lage einen weiteren geldwerten Vorteil: Sie sind, jedenfalls bis jetzt noch, in der Regel ohne Konkurrenz.“"
                            },
                            {
                                "example_id": "4374940e-93bc-41e8-8e25-79adca409272",
                                "sense_id": "22944153-7b17-30a1-8da5-8c19a84684b9",
                                "text": "„Bei diesen Reisen ist man auch nicht auf die teuren Interhotels angewiesen, sondern kann in jedem Hotel absteigen.“"
                            },
                            {
                                "example_id": "cd6b26c3-8ffb-4ac5-b44a-2efec0a9fa98",
                                "sense_id": "22944153-7b17-30a1-8da5-8c19a84684b9",
                                "text": "„Vom Café Orbit aus, in der zehnten Etage des Interhotels Kosmos, entdeckte ich das Panorama von Erfurt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
