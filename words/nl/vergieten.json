    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "30587d21-9287-3533-b2d9-bedb43b0ea03",
                    "sense_definition": "een vloeistof verloren doen gaan door deze weg te laten lopen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vloeistof morsen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er wordt in die oorlog helaas erg veel bloed <w>vergoten</w>.",
                            "target_lang_translations": {
                                "en": "Unfortunately, a lot of blood is being <w>shed</w> in that war.",
                                "ru": "В той войне, к сожалению, <w>проливается</w> очень много крови."
                            }
                        },
                        {
                            "text": "Tijdens het gevecht werd er veel bloed <w>vergoten</w> op het slagveld.",
                            "target_lang_translations": {
                                "en": "During the fight, much blood was <w>spilled</w> on the battlefield.",
                                "ru": "Во время боя на поле битвы было <w>пролито</w> много крови."
                            }
                        }
                    ],
                    "synonyms": [
                        "morsen",
                        "storten"
                    ],
                    "common_phrases": [
                        "bloed vergieten",
                        "tranen vergieten"
                    ],
                    "target_lang_definitions": {
                        "en": "To cause a liquid to be lost or flow out, often used in the context of blood or tears.",
                        "ru": "Вызывать вытекание жидкости, часто в контексте крови или слез."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "shed",
                                "target_lang_sense_clarification": "to let flow, especially blood or tears"
                            },
                            {
                                "target_lang_word": "spill",
                                "target_lang_sense_clarification": "to cause to flow out and be lost or wasted"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "проливать",
                                "target_lang_sense_clarification": "о крови или слезах"
                            },
                            {
                                "target_lang_word": "проливать",
                                "target_lang_sense_clarification": "случайно разлить жидкость"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "978816c9-4cfd-37ba-98e6-2a6ffa76f811",
                    "sense_definition": "vloeistof ergens overheen gieten of afgieten",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vloeistof morsen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet de pasta eerst <w>vergieten</w> voordat je de saus toevoegt.",
                            "target_lang_translations": {
                                "en": "You must <w>drain</w> the pasta first before you add the sauce.",
                                "ru": "Сначала нужно <w>слить</w> воду с пасты, прежде чем добавлять соус."
                            }
                        },
                        {
                            "text": "Zal ik het water voor je <w>vergieten</w> in de gootsteen?",
                            "target_lang_translations": {
                                "en": "Shall I <w>pour</w> the water into the sink for you?",
                                "ru": "Мне <w>вылить</w> для тебя воду в раковину?"
                            }
                        }
                    ],
                    "synonyms": [
                        "afgieten",
                        "overgieten"
                    ],
                    "target_lang_definitions": {
                        "en": "To pour a liquid over something or to drain a liquid from something using a colander.",
                        "ru": "Сливать жидкость с чего-либо или переливать ее, часто используя дуршлаг."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "drain",
                                "target_lang_sense_clarification": "to pour off liquid from food"
                            },
                            {
                                "target_lang_word": "strain",
                                "target_lang_sense_clarification": "to separate liquid from solids"
                            },
                            {
                                "target_lang_word": "pour",
                                "target_lang_sense_clarification": "to transfer liquid from one container to another"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "сливать",
                                "target_lang_sense_clarification": "воду после варки продуктов"
                            },
                            {
                                "target_lang_word": "откидывать",
                                "target_lang_sense_clarification": "на дуршлаг"
                            },
                            {
                                "target_lang_word": "переливать",
                                "target_lang_sense_clarification": "из одной емкости в другую"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5112e5e4-a022-301d-91b2-82bccf9cace5",
                    "sense_definition": "iets vloeibaar maken",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vloeibaar maken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De metaalbewerker moest het ijzer <w>vergieten</w> om het in de vorm te krijgen.",
                            "target_lang_translations": {
                                "en": "The metalworker had to <w>melt</w> the iron to get it into the mold.",
                                "ru": "Металлисту пришлось <w>расплавить</w> железо, чтобы залить его в форму."
                            }
                        },
                        {
                            "text": "Door de hitte begon het materiaal langzaam te <w>vergieten</w>.",
                            "target_lang_translations": {
                                "en": "Due to the heat, the material slowly began to <w>liquefy</w>.",
                                "ru": "Из-за жары материал начал медленно <w>плавиться</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "smelten",
                        "vloeibaar maken"
                    ],
                    "antonyms": [
                        "stollen"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technisch"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To make something liquid, typically through heating or melting.",
                        "ru": "Делать что-либо жидким, обычно путем нагревания или плавления."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "melt",
                                "target_lang_sense_clarification": "to turn a solid into liquid by heat"
                            },
                            {
                                "target_lang_word": "liquefy",
                                "target_lang_sense_clarification": "to make or become liquid"
                            },
                            {
                                "target_lang_word": "cast",
                                "target_lang_sense_clarification": "to pour molten metal into a mold"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "плавить",
                                "target_lang_sense_clarification": "превращать твердое в жидкое нагревом"
                            },
                            {
                                "target_lang_word": "разжижать",
                                "target_lang_sense_clarification": "делать жидким"
                            },
                            {
                                "target_lang_word": "отливать",
                                "target_lang_sense_clarification": "заливать расплавленный металл в форму"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
