                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f560984a-d351-4f89-bf9a-39259601021f",
                        "source_entry_id": "05ee1024-a38e-35f5-912e-f98c34c0fbf4",
                        "target_lang_word": "bungalow",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bungalow",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "d8086315-70f0-335f-abf0-d0491f3c8e3a",
                                        "entry_id": "9d6de24d-41a8-3604-a8d8-775ff5f8200a",
                                        "glosses": [
                                            "woning zonder bovenverdieping"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7baf8d69-ce87-4e5c-8eac-df9c1bc789f3",
                                                "sense_id": "d8086315-70f0-335f-abf0-d0491f3c8e3a",
                                                "text": "“We komen de meest gekke dingen tegen. Zo had iemand in een gelijkvloerse bungalow een traplift opgevoerd. Anderen vragen hypotheekrenteaftrek aan, terwijl ze in een huurhuis wonen.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b1a7e03-154e-3748-9ecb-1975eec755dc",
                                        "entry_id": "9d6de24d-41a8-3604-a8d8-775ff5f8200a",
                                        "glosses": [
                                            "vakantiewoning"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95fc66dd-57f4-4329-800d-8729a7bd573a",
                                                "sense_id": "4b1a7e03-154e-3748-9ecb-1975eec755dc",
                                                "text": "Met de vakantie zitten we in een bungalow in de Ardennen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "17918a46-7fcd-40c9-985b-6cebb148ea41",
                        "source_entry_id": "05ee1024-a38e-35f5-912e-f98c34c0fbf4",
                        "target_lang_word": "bungalow",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bungalow",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c45cf305-29f1-35fd-8739-75be1a0e5df9",
                                        "entry_id": "4a3e2a21-484a-3c5d-a372-31bb169903fb",
                                        "glosses": [
                                            "Petite construction habitable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10c6898b-cfe4-4171-916a-cf7e31f1d11f",
                                                "sense_id": "c45cf305-29f1-35fd-8739-75be1a0e5df9",
                                                "text": "La vapeur se contournait en spirales autour des groupes de palmiers, entre lesquels apparaissaient de pittoresques bungalows, quelques viharis, sortes de monastères abandonnés, et des temples merveilleux qu’enrichissait l’inépuisable ornementation de l’architecture indienne."
                                            },
                                            {
                                                "example_id": "d9272121-5a90-4d4d-b649-c8626ae4493e",
                                                "sense_id": "c45cf305-29f1-35fd-8739-75be1a0e5df9",
                                                "text": "— Moi non plus, je n'ai plus de cigarettes, dit-il.\n— Putain de votre race à tous, dit Louise. J'en ai dans mon bungalow au Sun, je vais les chercher. De toute façon, fallait que je m'habille."
                                            },
                                            {
                                                "example_id": "8698f863-6bea-4d04-89e3-b9a2175ac5ee",
                                                "sense_id": "c45cf305-29f1-35fd-8739-75be1a0e5df9",
                                                "text": "À Bangui, j'habitais un petit bungalow perdu parmi les bananiers, au pied d'une colline où la lune venait chaque nuit se percher comme un hibou lumineux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb4231a1-bff0-3fb2-a39f-85ba5aa2aae6",
                                        "entry_id": "4a3e2a21-484a-3c5d-a372-31bb169903fb",
                                        "glosses": [
                                            "Local temporaire sur un chantier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a26792b9-1feb-4421-bb7d-70f6cf8f6ecf",
                                                "sense_id": "cb4231a1-bff0-3fb2-a39f-85ba5aa2aae6",
                                                "text": "Sur un chantier, on croise de nombreuses personnes, on mange dans le même bungalow, on prend des camionnettes ensemble…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
