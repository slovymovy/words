                "senses": [
                    {
                        "sense_id": "2209eab8-fae6-3c6f-8a05-4acc664e96cb",
                        "entry_id": "ba322ace-0f1d-372b-a90a-2cf496987878",
                        "glosses": [
                            "eine gleichbleibende Struktur, charakteristische Eigenschaft von einem Geruchstoff"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5dc23352-488a-47fe-a51a-b7e38868d36a",
                                "sense_id": "2209eab8-fae6-3c6f-8a05-4acc664e96cb",
                                "text": "„In Zusammenarbeit mit dem Unternehmen Ilía Sistemas haben sie herausgefunden, dass es immer erkennbare Geruchsmuster im Körpergeruch eines Individuums stabil bleiben.“"
                            },
                            {
                                "example_id": "e5c81ff8-29c6-42d6-b442-7bb654fa4675",
                                "sense_id": "2209eab8-fae6-3c6f-8a05-4acc664e96cb",
                                "text": "„Die Verwendung von Zusatzstoffen dient zur Erzielung eines bestimmten Geschmacks- oder Geruchsmusters.“"
                            },
                            {
                                "example_id": "be22fa93-7e21-4725-8be2-a97058d837dd",
                                "sense_id": "2209eab8-fae6-3c6f-8a05-4acc664e96cb",
                                "text": "„Da jeder Mensch eine individuelle Kombination aus Duftstoffen absondert, sei es wahrscheinlich auch möglich, den biologischen Fingerabdruck durch ein elektronisches Geruchsmuster zu ersetzen oder zu ergänzen.“"
                            },
                            {
                                "example_id": "b3380889-f612-4a59-b167-522cd51d95c4",
                                "sense_id": "2209eab8-fae6-3c6f-8a05-4acc664e96cb",
                                "text": "„Die Realisierung dieser Ziele wird durch den technologischen Ansatz angestrebt,dass an einigen wenigen Sensorelementen durch die Generierung von Datenmustern, welche zu entsprechenden Geruchsmustern korrespondieren, sowie durch die Anwendung von Mustererkennungsverfahren zahlreiche Gefahrenstoffe detektiert werden können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "431d5ccf-dca0-3b15-9484-de60bbfdab3a",
                        "entry_id": "ba322ace-0f1d-372b-a90a-2cf496987878",
                        "glosses": [
                            "eine kleine Menge oder ein kleines Stück, das einen bestimmten Geruch enthält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6923c2e-0969-4347-bf6e-c6c38d8f799f",
                                "sense_id": "431d5ccf-dca0-3b15-9484-de60bbfdab3a",
                                "text": "„Liegt von der vermissten Person ein Geruchsmuster vor (Bsp. Kleidungsstück, Schlüsselbund, Geldbörse, Ring), wird dieses dem Hund als \"Bild\" zur Verfügung gestellt wurde.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
