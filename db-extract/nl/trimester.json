                        ],
                        "examples": [
                            {
                                "example_id": "70fd60ec-b578-4df7-b4e0-1d54c2116c7a",
                                "sense_id": "0db543a2-16c6-3eab-9d50-6d1a928859d2",
                                "text": "Het was een druk trimester voor de leerlingen met alle examens en toetsen."
