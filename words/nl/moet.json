                },
                {
                    "sense_id": "5f0b89ed-02c5-3945-9843-2cedc07491f6",
                    "sense_definition": "Iets wat men verplicht is te doen; een dwang of noodzaak.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "noun_compulsion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Voor ons is het een plezierige hobby en absoluut geen <w>moet</w>.",
                            "target_lang_translations": {
                                "ru": "Для нас это приятное хобби, а вовсе не <w>обязаловка</w>.",
                                "en": "For us it is a pleasant hobby and absolutely not an <w>obligation</w>.",
                                "de": "Für uns ist es ein schönes Hobby und absolut kein <w>Muss</w>."
                            }
                        },
                        {
                            "text": "Zoals het oude spreekwoord zegt: <w>moet</w> is een bitter kruid.",
                            "target_lang_translations": {
                                "ru": "Как гласит старая пословица: <w>необходимость</w> — горькая трава.",
                                "en": "As the old proverb says: <w>necessity</w> is a bitter herb.",
                                "de": "Wie das alte Sprichwort sagt: <w>Müssen</w> ist ein bitteres Kraut."
                            }
                        }
                    ],
                    "synonyms": [
                        "dwang",
                        "verplichting",
                        "noodzaak"
                    ],
                    "antonyms": [
                        "keuze",
                        "vrijheid"
                    ],
                    "common_phrases": [
