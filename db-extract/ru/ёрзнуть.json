                "translations": [
                    {
                        "translation_id": "510cad14-5640-42e5-b29b-1a8d698a2467",
                        "source_entry_id": "3045b426-4479-3c4c-8d76-34daabbe8975",
                        "source_sense_id": "fc26a3e7-9959-357c-b005-ac5e67a2800f",
                        "target_lang_word": "s'agiter",
                        "target_lang_code": "fr",
