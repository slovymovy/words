                        "examples": [
                            {
                                "example_id": "f95cd33c-0e14-4d44-920d-1100bc54991a",
                                "sense_id": "4b7160a9-2f63-37ff-b591-6b5d08c4521d",
                                "text": "De meisjes ruiken naar flink afgeprijsde Moederdagparfum en de jongens ruiken naar wetlook-gel en angstzweet. De jongens kijken naar de meisjes en de meisjes kijken naar de jongens. Hun blikken verlammen elkaar. Er gaat vanavond niet gedanst worden."
                            },
                            {
                                "example_id": "18aebec5-a26b-4c16-92db-61e27510d47b",
                                "sense_id": "4b7160a9-2f63-37ff-b591-6b5d08c4521d",
                                "text": "Die verdamp-verklaring gaat alleen op voor standaardgels, zegt Valckx. ‘Wetlook’-gels bevatten juist stoffen om water vast te houden en verdamping tegen te gaan, ook als je de gel al in je haar hebt gesmeerd. „Zo kunnen we juist die natte look bewerkstelligen.”"
                            },
                            {
                                "example_id": "c53d6036-7960-4a72-b84a-80da796b3248",
                                "sense_id": "4b7160a9-2f63-37ff-b591-6b5d08c4521d",
                                "text": "Op foto's op Instagram is het resultaat te zien van de verrassende kappersbehandeling die realityster Kylie onderging. Haar ongekamde kapsel is een stuk korter dan het was. Ze draagt het haar los en als wetlook."
                            }
