                                        "entry_id": "7f847b33-8b86-34ed-8174-c02da82f8d26",
                                        "glosses": [
                                            "Staat in Südamerika"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04170ce3-fd45-4b4b-97f7-c6e5df787f8a",
                                                "sense_id": "a5a3635d-feb1-3a80-9144-278902bf02ea",
                                                "text": "Bogotá ist die Hauptstadt von Kolumbien."
                                            },
                                            {
                                                "example_id": "4de06d3b-5c12-45b3-82e6-44c47f472050",
                                                "sense_id": "a5a3635d-feb1-3a80-9144-278902bf02ea",
                                                "text": "Kolumbiens Wirtschaft wächst trotz der Unruhen kontinuierlich und stellt damit in Südamerika den größten Wachstumsmarkt nach Chile dar."
                                            },
                                            {
                                                "example_id": "bcaaefb1-14b6-4a26-a0cd-013cc215ff43",
                                                "sense_id": "a5a3635d-feb1-3a80-9144-278902bf02ea",
                                                "text": "Die westliche Hälfte Kolumbiens wird von den Anden dominiert[.]"
                                            },
                                            {
                                                "example_id": "a90c995c-3222-4a39-8219-c33498d5f4cb",
                                                "sense_id": "a5a3635d-feb1-3a80-9144-278902bf02ea",
                                                "text": "„Nun war es eben dieser verlorene Sohn, der ihnen sein Haus in Kolumbien öffnete.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
