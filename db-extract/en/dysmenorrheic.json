                "senses": [
                    {
                        "sense_id": "d29035c6-0158-30a1-949e-ed1202cdb05d",
                        "entry_id": "9ad897fa-4942-3966-8694-63d4857be321",
                        "glosses": [
                            "Of, pertaining to, or experiencing dysmenorrhea."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ecd1438c-b4f1-4c1f-a144-96c114f82fa4",
                                "sense_id": "d29035c6-0158-30a1-949e-ed1202cdb05d",
                                "text": "It is more recently the opinion of specialists that psychogenic symptoms may be associated with some dysmenorrheic patients, but that these symptoms are not necessarily the cause of physical complaints."
                            },
                            {
                                "example_id": "14fc41bf-688a-455d-80b5-82931ca7f8f1",
                                "sense_id": "d29035c6-0158-30a1-949e-ed1202cdb05d",
                                "text": "In severely dysmenorrheic women, there is exaggerated uterine contractility and a significantly higher prostaglandin content in the menstrual blood with a twofold to tenfold increase when compared with women who do not have menstrual pain."
                            },
                            {
                                "example_id": "8b109825-17c9-40a7-8cdf-0e13c6e3e70d",
                                "sense_id": "d29035c6-0158-30a1-949e-ed1202cdb05d",
                                "text": "Baker and colleagues (1999) reported that dysmenorrheic women had reduced sleep efficiency when experiencing menstrual pain, with increased wakefulness, movement, and stage 1 sleep compared to pain-free phases of their cycle."
                            }
                        ]
                    }
