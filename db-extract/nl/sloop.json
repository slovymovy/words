                        ],
                        "examples": [
                            {
                                "example_id": "23c98458-7ab7-45f8-bd36-f723ee2ddb49",
                                "sense_id": "9648cae0-9d1d-31d8-84b3-3f7ca816676d",
                                "text": "Ik zal even een sloopje om dat kussen doen."
                            }
                        ]
                    },
                    {
                        "sense_id": "3a92784d-dd23-3af0-99f3-f5b130dc2e9e",
                        "entry_id": "f94bfbdb-a089-37df-8241-317e05594bda",
                        "glosses": [
                            ": de daad van het slopen, afbreken"
                        ],
                        "tags": [
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "bc48ac3c-cb59-4fb3-a563-d8eb4499b9cf",
                                "sense_id": "3a92784d-dd23-3af0-99f3-f5b130dc2e9e",
                                "text": "Dat schip is rijp voor de sloop."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "86f67f43-10d3-4aa5-a803-900af43f7da8",
                        "source_entry_id": "f94bfbdb-a089-37df-8241-317e05594bda",
                        "source_sense_id": "9648cae0-9d1d-31d8-84b3-3f7ca816676d",
                        "source_sense_description": "een stoffen omslag om een kussen",
                        "target_lang_word": "Kissenbezug",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kissenbezug",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6d951efa-e185-3a5a-a8c3-0489f1610175",
                                        "entry_id": "48b331c7-39d3-33ee-a40b-29d0faff8d9f",
                                        "glosses": [
                                            "Überzug aus Stoff für Kissen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ea3c997-c438-4ece-818f-6fc3e2a955d9",
                                                "sense_id": "6d951efa-e185-3a5a-a8c3-0489f1610175",
                                                "text": "Der Kissenbezug befindet sich zurzeit in der Waschmaschine."
                                            },
                                            {
                                                "example_id": "bfc2e417-3d91-46e8-a8ed-9ea48cfa96b4",
                                                "sense_id": "6d951efa-e185-3a5a-a8c3-0489f1610175",
                                                "text": "„An der andern Wand steht ein Offizier in Uniform und macht sich ein Bett zurecht; er hat selbst Laken und weiße Kissenbezüge bei sich.“"
                                            },
                                            {
                                                "example_id": "85f64b38-df84-489a-adcd-b2e8aaf805a4",
                                                "sense_id": "6d951efa-e185-3a5a-a8c3-0489f1610175",
                                                "text": "„Ich zog den einen Kissenbezug ab, dann überlegte ich mir die Sache anders und bezog das Kissen wieder, es könnte ja zu weiteren Übernachtungen kommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6e1aa4f3-46a7-4492-ba09-783d7813a5f0",
                        "source_entry_id": "f94bfbdb-a089-37df-8241-317e05594bda",
                        "source_sense_id": "9648cae0-9d1d-31d8-84b3-3f7ca816676d",
                        "source_sense_description": "een stoffen omslag om een kussen",
                        "target_lang_word": "pillowcase",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
