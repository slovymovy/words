                        "entry_id": "b8fc2a7b-3035-3ea7-982c-6107afbbafda",
                        "glosses": [
                            "bochtig door het landschap kronkelen"
                        ],
                        "tags": [
                            "unergative"
                        ],
                        "examples": [
                            {
                                "example_id": "31682a87-e076-4627-ab61-f355f818778b",
                                "sense_id": "3d98df1f-da41-3c80-8af1-ea9f08237df8",
                                "text": "De Dortherbeek heeft, getuige de sterk slingerende gemeentegrens, in het verleden sterk gemeanderd."
                            }
                        ]
                    },
                    {
                        "sense_id": "a8d46a58-d75a-33dd-97ad-c0fc1e509045",
                        "entry_id": "b8fc2a7b-3035-3ea7-982c-6107afbbafda",
                        "glosses": [
                            "in zijn oorspronkelijke kronkelende loop herstellen"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "ee7207d0-1ab8-4fd9-ad3a-0aa9af525512",
                                "sense_id": "a8d46a58-d75a-33dd-97ad-c0fc1e509045",
                                "text": "De loop van dit riviertje is vanaf hier al gemeanderd door Het Brabants Landschap."
                            }
                        ]
                    },
                    {
                        "sense_id": "ccdb01f0-b483-3927-bdae-e4b1b57cdec3",
                        "entry_id": "b8fc2a7b-3035-3ea7-982c-6107afbbafda",
                        "glosses": [
                            "overdrachtelijk langs een kronkelende weg reizen"
                        ],
                        "tags": [
                            "ergative"
                        ],
                        "examples": [
                            {
