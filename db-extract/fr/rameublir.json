                        "glosses": [
                            "Ameublir à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "843aad6c-0498-40f5-a28d-932a40c83aa1",
                                "sense_id": "a175a600-0752-307a-b8fa-18f0f8ac4408",
                                "text": "Rameublir la terre autour des arbres et écheniller;"
                            },
                            {
                                "example_id": "887e361a-2765-468b-80e7-30628825c020",
                                "sense_id": "a175a600-0752-307a-b8fa-18f0f8ac4408",
                                "text": "Le trou n'a pas besoin d'avoir plus de sept à huit pouces de profondeur ; l'églantier une fois enterré, vous le foulez avec les pieds et vous rameublissez la terre à l'entour."
                            }
                        ]
                    }
