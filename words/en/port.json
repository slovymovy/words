                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Australia"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чемодан или школьный портфель.",
                        "zh": "手提箱或书包。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чемодан",
                                "target_lang_sense_clarification": "багаж"
                            },
                            {
                                "target_lang_word": "портфель",
                                "target_lang_sense_clarification": "школьная сумка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "行李箱",
                                "target_lang_sense_clarification": "旅行用箱"
                            },
                            {
                                "target_lang_word": "书包",
                                "target_lang_sense_clarification": "学生用包"
                            }
                        ]
                    }
                }
            ]
