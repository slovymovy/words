        "ru-extract.jsonl": [
            {
                "entry_id": "80924268-9b81-3789-9121-215ce6268a34",
                "word": "Некрасов",
                "pos": "name",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b882e749-9c12-37f8-8ac3-68d6294c97af",
                        "entry_id": "80924268-9b81-3789-9121-215ce6268a34",
                        "glosses": [
                            "русская фамилия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf1e1eaa-43ab-400e-8133-4059d48987fb",
                                "sense_id": "b882e749-9c12-37f8-8ac3-68d6294c97af",
                                "text": "Возник стихийный митинг, на котором выступали Дина Проничева, писатель Виктор Некрасов, молодой украинский публицист Иван Дзюба — и опять они говорили о памятнике…"
                            },
                            {
                                "example_id": "211dbee7-c1f9-4446-9cce-63f8a4070c34",
                                "sense_id": "b882e749-9c12-37f8-8ac3-68d6294c97af",
                                "text": "Афанасий Фет, квартировавший тогда в городских апартаментах Некрасова — дело было летом, петербуржцы разъехались по дачам, — видел, как хозяин регулярно наезжал сыграть партию-другую в клубе, и был вынужден одолжить Некрасову тысячу рублей наличными совершенно без надежды вернуть."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
