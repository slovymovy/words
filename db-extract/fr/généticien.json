                    },
                    {
                        "form_id": "13d5d855-3407-49c9-a3e4-4033b4aa9f96",
                        "entry_id": "3ac7391b-9d64-3f85-b1c0-4701e70c943a",
                        "tags": [
                            "feminine"
                        ],
                        "form": "généticienne"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7c40bba7-d786-3102-9c1f-ba1eb8c27a56",
                        "entry_id": "3ac7391b-9d64-3f85-b1c0-4701e70c943a",
                        "glosses": [
                            "Scientifique qui étudie les gènes, spécialiste de la génétique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90b2dbe4-ac85-4aee-a129-60ea77d94e61",
                                "sense_id": "7c40bba7-d786-3102-9c1f-ba1eb8c27a56",
                                "text": "Et, les consultants viennent parfois rencontrer le généticien comme celui qui va tout expliquer, tout résoudre de façon magique, un peu comme un Dieu, une position bien difficile pour ce médecin."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "15a110ba-3360-4d54-8903-b976ef0fa1ce",
                        "source_entry_id": "3ac7391b-9d64-3f85-b1c0-4701e70c943a",
                        "source_sense_id": "7c40bba7-d786-3102-9c1f-ba1eb8c27a56",
                        "target_lang_word": "Genetiker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Genetiker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b15d1602-a4ff-3bc7-996d-6a3716fbe9b1",
                                        "entry_id": "f8ef3de7-be2b-3dc6-b4aa-20dbb0543221",
                                        "glosses": [
                                            "jemand, der sich wissenschaftlich mit der Genetik beschäftigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "edb042b4-4629-437b-8d83-e1935aef7094",
                                                "sense_id": "b15d1602-a4ff-3bc7-996d-6a3716fbe9b1",
                                                "text": "„Ein linker Genetiker explodierte daraufhin: Es sei unerhört und obszön, dass im Jahre 2000 so viele Menschen auf unserem Planeten hungers sterben müssen.“"
                                            },
                                            {
                                                "example_id": "c188df13-3d14-4e7b-9cd7-daa0eca8fabe",
                                                "sense_id": "b15d1602-a4ff-3bc7-996d-6a3716fbe9b1",
                                                "text": "„Als Vortragende haben sich unter anderem Wikipedia-Mitgründer Larry Sanger, die NASA-Weltraumforscherin Kerry McGuire und der österreichische Genetiker Markus Hengstschläger sowie die ehemalige nigerianische Bildungsministerin und Gründerin von Transparency International, Obiageli Ezekwesili, angekündigt.“"
                                            },
                                            {
                                                "example_id": "684fd466-54b6-45e1-8eaa-65bccd291f92",
                                                "sense_id": "b15d1602-a4ff-3bc7-996d-6a3716fbe9b1",
                                                "text": "„Davis, ein Genetiker, der früher biochemische Forschungen betrieb, wirft die Bettdecke beiseite und eilt über eine gewundene Holztreppe hinunter ins Erdgeschoss.“"
                                            },
                                            {
                                                "example_id": "058a1099-f85b-4480-a654-7210242f906e",
                                                "sense_id": "b15d1602-a4ff-3bc7-996d-6a3716fbe9b1",
                                                "text": "„Außerdem befassen sich noch die Althistoriker mit den Kelten, die die Berichte antiker Autoren auswerten, sowie Genetiker und Anthropologen, die versuchen, aus Knochen und anderen biologischen Materialien Befunde abzuleiten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3c8efcba-a615-4b12-a40f-1800fddae882",
                        "source_entry_id": "3ac7391b-9d64-3f85-b1c0-4701e70c943a",
                        "source_sense_id": "7c40bba7-d786-3102-9c1f-ba1eb8c27a56",
                        "target_lang_word": "Genetikerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Genetikerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0beb4418-d560-3943-a1a6-944c21ab5f30",
                                        "entry_id": "5391d31a-9d66-39f0-aee4-3ef994525219",
                                        "glosses": [
                                            "weibliche Person, die sich wissenschaftlich mit der Genetik beschäftigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d0017bf-fcf4-4516-af52-f85bc0be8d35",
                                                "sense_id": "0beb4418-d560-3943-a1a6-944c21ab5f30",
                                                "text": "„Frau Dr. R. (Genetikerin und Molekularbiologin) übernahm 2005 bis Dezember 2009 die tatsächliche Leitung der Forschungsabteilung der D. GmbH.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c178d347-61d0-4c84-a4b8-34950a561aac",
                        "source_entry_id": "3ac7391b-9d64-3f85-b1c0-4701e70c943a",
                        "source_sense_id": "7c40bba7-d786-3102-9c1f-ba1eb8c27a56",
                        "target_lang_word": "geneticist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "geneticist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "918525ed-554d-33e7-8d9c-b7f403d465e0",
                                        "entry_id": "c34ea3e4-f5bf-37f4-b574-c19b8bcbab80",
                                        "glosses": [
                                            "A scientist who studies genes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28fd7ba3-21e8-4a4f-b67c-6601e09dead7",
                                                "sense_id": "918525ed-554d-33e7-8d9c-b7f403d465e0",
                                                "text": "In an ingenious approach, a team of 11 scientists – including biologists, geneticists, glaciologists, computer scientists and ice-sheet modellers – looked at the genetics of Turquet’s octopus – a species that has been living around the Antarctic continent for about 4m years."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0db0ea84-cbf7-3bfa-afa1-1cba507dbdbb",
                                        "entry_id": "c34ea3e4-f5bf-37f4-b574-c19b8bcbab80",
                                        "glosses": [
                                            "A physician who diagnoses, treats, and counsels patients with genetic disorders or syndromes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36cea0b4-4619-4d9e-8ccc-8016868f15e6",
                                                "sense_id": "0db0ea84-cbf7-3bfa-afa1-1cba507dbdbb",
                                                "text": "The geneticist said Ryan had a rare genetic disorder called mucopolysaccharidosis I, or MPS I, with a wide-range of symptoms affecting multiple systems in the body."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
