        "nl-extract.jsonl": [
            {
                "entry_id": "4022d1ff-26b7-370e-af71-c4c34ffa347b",
                "word": "infantiliseren",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8c266a67-f1ec-36c0-86ec-63f0ed981435",
                        "entry_id": "4022d1ff-26b7-370e-af71-c4c34ffa347b",
                        "glosses": [
                            "zorgen dat volwassene zich als een kind gaat gedragen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "433ec053-d715-4285-a0f3-0d086389d89a",
                                "sense_id": "8c266a67-f1ec-36c0-86ec-63f0ed981435",
                                "text": "Zo werd de Magnum de Che Guevara in een guerrilla die volwassenen zou emanciperen door hen te infantiliseren. Kinderlijkheid als de ultieme vorm van maatschappijkritiek en subversie! Eens ze zich kommerloos op een ijsje op een stokje konden trakteren, zonder voor een zonderling of weer zo’n vieze kinderlokker te worden versleten, lag het lichtend pad naar de vrijheid en het nieuwe morgenrood helemaal open. De Standaard 30 JANUARI 2016 OM 03:00 UUR"
                            }
                        ]
                    },
                    {
                        "sense_id": "cfc17e35-6c45-382f-b854-d65039345cbb",
                        "entry_id": "4022d1ff-26b7-370e-af71-c4c34ffa347b",
                        "glosses": [
                            "volwassen persoon benaderen alsof hij een klein kind is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a6b603b-3952-4b52-bdb4-8a217c4bf741",
                                "sense_id": "cfc17e35-6c45-382f-b854-d65039345cbb",
                                "text": "Hoe mooi het ook leest, dat verhaal van Hilde en Mark, hoed u voor de neiging om te gaan ooh’en en aah’en. Dat is een tic die jongere mensen weleens wil besluipen wanneer ze ouderen in de liefde aanschouwen. ‘Kijk hoe schattig!’, u kent het wel. Niet doen. ‘Het is betuttelend,’ zegt Luc Van de Ven, ‘want daarmee doe je niets anders dan oudere mensen infantiliseren."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
