{
    "word_family": [
        "bullshitter"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "399b2bc3-f825-3db9-bda3-79d8913c8a94",
                    "sense_definition": "Statements that are false, exaggerated, or nonsensical, often used to impress or deceive.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "nonsense_lies",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't pay any attention to him because he talks a lot of <w>bullshit</w>.",
                            "target_lang_translations": {
                                "ru": "Не обращай на него внимания, он несёт полную <w>херню́</w>.",
                                "zh": "别理他，他老是满嘴<w>屁话</w>。"
                            }
                        },
                        {
                            "text": "The excuse he gave for being late was a total load of <w>bullshit</w>.",
                            "target_lang_translations": {
                                "ru": "Оправдание, которое он придумал для своего опоздания, было полным <w>пиздежо́м</w>.",
                                "zh": "他拿来解释迟到的借口完全是一派<w>胡说八道</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "nonsense",
                        "rubbish",
                        "crap",
                        "baloney",
                        "hogwash",
                        "horseshit",
                        "drivel",
                        "tripe"
                    ],
                    "common_phrases": [
                        "load of bullshit",
                        "cut the bullshit",
                        "total bullshit",
                        "pile of bullshit"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "vulgar"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вульгарный сленг для обозначения лжи, преувеличений или бессмыслицы.",
                        "zh": "虚假、夸张或毫无意义的话，常用来唬人或骗人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пиздёж",
                                "target_lang_sense_clarification": "грубое сленговое слово для обозначения лжи или пустой болтовни"
                            },
                            {
                                "target_lang_word": "херня́",
                                "target_lang_sense_clarification": "грубое слово для обозначения ерунды, вздора или чего-то некачественного"
                            },
                            {
                                "target_lang_word": "чушь соба́чья",
                                "target_lang_sense_clarification": "экспрессивное выражение для полной бессмыслицы"
                            },
                            {
                                "target_lang_word": "бред си́вой кобы́лы",
                                "target_lang_sense_clarification": "идиома, означающая явную глупость или ложь"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "屁话",
                                "target_lang_sense_clarification": "粗俗说法，指荒唐、不真实的话"
                            },
                            {
                                "target_lang_word": "胡说八道",
                                "target_lang_sense_clarification": "指乱说、没有道理的话"
                            },
                            {
                                "target_lang_word": "鬼话",
                                "target_lang_sense_clarification": "带强烈不信或斥责语气的假话、瞎话"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8a766527-c9e3-3e01-bb60-135453cf93af",
                    "sense_definition": "Feces produced by a bull.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer had to clear the <w>bullshit</w> from the barn every morning.",
                            "target_lang_translations": {
                                "ru": "Фермеру приходилось каждое утро вычищать <w>навоз</w> из сарая.",
                                "zh": "农夫每天早上都得把牛棚里的<w>牛粪</w>清理掉。"
                            }
                        },
                        {
                            "text": "Watch your step on the path or you might step in some <w>bullshit</w>.",
                            "target_lang_translations": {
                                "ru": "Смотри под ноги на тропинке, иначе можешь вступить в <w>дерьмо</w>.",
                                "zh": "走小路时看着点脚下，不然你可能会踩到<w>牛屎</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "manure",
                        "dung",
                        "cowshit"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "vulgar"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Экскременты быка (буквальное значение).",
                        "zh": "公牛排出的粪便。"
                    },
