                        "disappointed tone",
                        "disappointed face"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражающий разочарование своим видом или голосом.",
                        "tr": "Görünüş veya ses tonuyla hayal kırıklığı duygularını dışa vuran veya gösteren."
                    },
