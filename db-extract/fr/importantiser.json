                "senses": [
                    {
                        "sense_id": "56431b9c-419b-3834-8ab0-b7960c85eb19",
                        "entry_id": "0c4c28a5-7840-35f3-8d39-20cc03f769cf",
                        "glosses": [
                            "Donner un caractère important à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "965fc1ea-eedc-4d34-a307-79458dec69eb",
                                "sense_id": "56431b9c-419b-3834-8ab0-b7960c85eb19",
                                "text": "Un partage des tâches qui l’importantise."
                            },
                            {
                                "example_id": "697f9c88-19e5-413f-a67a-537bc89d7774",
                                "sense_id": "56431b9c-419b-3834-8ab0-b7960c85eb19",
                                "text": "Je vous répons, sans vouloir m'importantiser (sic, pour me rendre important) qu’on n’a pas voulu en confier l’exécution à personne pendant mon absence et que je vous garantis que mon départ est arretté et fixé depuis vendredy dernier."
                            },
                            {
                                "example_id": "5f63548b-fdaa-4028-bf63-edc355178c36",
                                "sense_id": "56431b9c-419b-3834-8ab0-b7960c85eb19",
                                "text": "Un trou du cul qui s’importantise."
                            }
                        ]
                    }
