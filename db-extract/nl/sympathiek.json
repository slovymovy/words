                "senses": [
                    {
                        "sense_id": "874923e8-8046-381d-a16a-e6d5660788bd",
                        "entry_id": "66361890-5da7-3e30-b24b-970a503c5792",
                        "glosses": [
                            "bereid zich in de zorgen van een ander te verplaatsen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7829deb-bad5-4d7e-b81e-d2f2fea96ed4",
                                "sense_id": "874923e8-8046-381d-a16a-e6d5660788bd",
                                "text": "Hij kreeg geen sympathiek gehoor."
                            }
                        ]
                    },
                    {
                        "sense_id": "6cf2bba5-4722-3a02-b28c-bf9515659262",
                        "entry_id": "66361890-5da7-3e30-b24b-970a503c5792",
                        "glosses": [
                            "aangenaam en vriendelijk in de omgang"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89703137-99ad-4bad-a5f8-2e4457fe65f9",
                                "sense_id": "6cf2bba5-4722-3a02-b28c-bf9515659262",
                                "text": "Hij is een sympathieke kerel."
                            },
                            {
                                "example_id": "133d573d-59b8-4ece-8f86-f51d43544151",
                                "sense_id": "6cf2bba5-4722-3a02-b28c-bf9515659262",
                                "text": "Je opa Henri en je vader Antoine, allebei moderne, progressieve mannen, gebruiken de naam van het geslacht de Chantery zelden, en de adellijke titels nog minder, en dat is heel sympathiek."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6f9f3eb6-8cc3-469e-9630-5d944d9716a8",
                        "source_entry_id": "66361890-5da7-3e30-b24b-970a503c5792",
                        "target_lang_word": "sympathetic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sympathetic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d05418d3-12aa-3f4c-b2de-9f28a13ad204",
                                        "entry_id": "9e7e8a18-0700-3eb9-bb8f-5374960eaa27",
                                        "glosses": [
                                            "Of, related to, feeling, showing, or characterized by sympathy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d09a54f-2dd1-401b-a7ed-e0de15daf6f0",
                                                "sense_id": "d05418d3-12aa-3f4c-b2de-9f28a13ad204",
                                                "text": "John looked very upset. I gave him a sympathetic look."
                                            },
                                            {
                                                "example_id": "f981c9c8-9ef2-454d-bdeb-9482ccd54e93",
                                                "sense_id": "d05418d3-12aa-3f4c-b2de-9f28a13ad204",
                                                "text": "Vaublanc, in San Domingo so sympathetic to the sorrows of labour in France, had to fly from Paris in August, 1792, to escape the wrath of the French workers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "faac05df-eda9-30c8-8aa0-b7dda202dc7a",
                                        "entry_id": "9e7e8a18-0700-3eb9-bb8f-5374960eaa27",
                                        "glosses": [
                                            "Of, related to, feeling, showing, or characterized by sympathy.",
                                            "Showing approval of or favor towards an idea or action."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bde62865-dfd4-3fc4-8013-e659ac21bd12",
                                        "entry_id": "9e7e8a18-0700-3eb9-bb8f-5374960eaa27",
                                        "glosses": [
                                            "Attracting the liking of others. (of a person)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "36802726-aace-34f8-a33e-9b433244b1c7",
                                        "entry_id": "9e7e8a18-0700-3eb9-bb8f-5374960eaa27",
                                        "glosses": [
                                            "Attracting the liking of others. (of a person)",
                                            "Designed in a sensitive or appropriate way."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6086079a-93c5-3aba-9daa-e7ac71bedd87",
                                        "entry_id": "9e7e8a18-0700-3eb9-bb8f-5374960eaa27",
                                        "glosses": [
                                            "Relating to, producing, or denoting an effect which arises through an affinity, interdependence, or mutual association."
                                        ],
                                        "tags": [
                                            "relational"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "435e92b8-06d4-4a71-9cd4-5d39fd5d53a3",
                                                "sense_id": "6086079a-93c5-3aba-9daa-e7ac71bedd87",
                                                "text": "Sympathetic magic is based on imitation or correspondence."
                                            },
                                            {
                                                "example_id": "fb460b9f-14b2-400a-a49d-c2d2b149ceea",
                                                "sense_id": "6086079a-93c5-3aba-9daa-e7ac71bedd87",
                                                "text": "sympathetic ink"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6689088-b989-34d0-b23a-6e2ae0b32a00",
                                        "entry_id": "9e7e8a18-0700-3eb9-bb8f-5374960eaa27",
                                        "glosses": [
                                            "Relating to, producing, or denoting an effect which arises through an affinity, interdependence, or mutual association.",
                                            "A supernatural connection or power resulting from two items having the same form or some other correspondence. (of magic)"
                                        ],
                                        "tags": [
                                            "relational"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3049e288-bd2e-4931-89a6-607550866447",
                                                "sense_id": "e6689088-b989-34d0-b23a-6e2ae0b32a00",
                                                "text": "One of his great enthusiasms was for a \"sympathetic\" weapon salve, an idea originating in Paracelsus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "177dd073-0516-349b-8024-d076d29a4fb7",
                                        "entry_id": "9e7e8a18-0700-3eb9-bb8f-5374960eaa27",
                                        "glosses": [
                                            "Relating to, producing, or denoting an effect which arises through an affinity, interdependence, or mutual association.",
                                            "Relating to musical tones produced by sympathetic vibration or to strings so tuned as to sound by sympathetic vibration."
                                        ],
                                        "tags": [
                                            "relational"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9c8781f8-ddb1-3459-97b7-e7a79365e8cc",
                                        "entry_id": "9e7e8a18-0700-3eb9-bb8f-5374960eaa27",
                                        "glosses": [
                                            "Relating to or denoting the part of the autonomic nervous system consisting of nerves arising from ganglia near the middle part of the spinal cord, supplying the internal organs, blood vessels, and glands, and balancing the action of the parasympathetic nerves."
                                        ],
                                        "tags": [
                                            "relational"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "726feacc-7d94-4773-8e67-f69ef7c85520",
                                                "sense_id": "9c8781f8-ddb1-3459-97b7-e7a79365e8cc",
                                                "text": "Sympathetic innervation involves epinephrine."
                                            },
                                            {
                                                "example_id": "5d70caba-d6eb-4dd4-963e-f7a4e0e2d6ee",
                                                "sense_id": "9c8781f8-ddb1-3459-97b7-e7a79365e8cc",
                                                "text": "It was suggested that adrenaline might act at the junction of sympathetic nerves and the effector organs, and that adrenaline might be released at sympathetic nerve endings."
                                            }
                                        ]
                                    }
                                ]
