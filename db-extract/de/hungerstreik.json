                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "2b5a33c5-0f13-32e7-a1e3-97fb7ea41425",
                                        "entry_id": "5fb676d3-f2a7-3d28-a3c2-a87b6f58649a",
                                        "glosses": [
                                            "záměrné nepřijímání potravy za účelem zhubnutí nebo očisty organismu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56ad7e29-d5cc-429d-8088-5e58f60eba8b",
                                                "sense_id": "2b5a33c5-0f13-32e7-a1e3-97fb7ea41425",
                                                "text": "Nejkratší hladovka trvá 36 hodin, nejdelší tři až pět dní. Avšak opravdovou nazýváme až tu desetidenní."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5b6d511-e4af-3db2-b5a1-a365c34cbeb8",
                                        "entry_id": "5fb676d3-f2a7-3d28-a3c2-a87b6f58649a",
                                        "glosses": [
                                            "odmítání potravy jako forma protestu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d22985d3-7370-4250-ae1a-1f5056ccd3e9",
                                                "sense_id": "b5b6d511-e4af-3db2-b5a1-a365c34cbeb8",
                                                "text": "První hladovku držel Miroslav Mareček ještě před listopadem 1989 na protest proti obvinění z pobuřování. Po revoluci jich následovalo ještě několik, většinou na protest proti postupu justice při vyřizování jeho podnětů. Nejdelší protest trval 90 dní."
                                            }
                                        ]
                                    }
