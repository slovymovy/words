                        "entry_id": "08ee37c7-978a-3829-982e-4cd66dd72b55",
                        "glosses": [
                            "kosmetyk w formie ołówka, sztyftu lub pędzelka, służący do obrysowania oczu lub ust"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8a81a64-a3b2-496a-a1ae-2ae10a8e4d82",
                                "sense_id": "e3bf0bca-d106-313f-a29c-5e05a60765c2",
                                "text": "Błyszczyk czy szminka to dla wielu kobiet obowiązkowy kosmetyk, ale już z konturówką bywa różnie."
                            }
                        ],
