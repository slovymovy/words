                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Monika",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0d12b39b-456a-3d62-bd7f-86c80acea4cb",
                                        "entry_id": "cf3a21a9-0270-34ce-97b2-983c97af69e2",
                                        "glosses": [
                                            "A female given name from Latin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12c5606f-cf3b-44f5-9f76-dda18f3bc8b9",
                                                "sense_id": "0d12b39b-456a-3d62-bd7f-86c80acea4cb",
                                                "text": "Both Maya and Monika had inherited Megan's coloring, without a trace of Amit's deeply tan skin and black eyes, so that apart from their vaguely Indian names they appeared fully American."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
