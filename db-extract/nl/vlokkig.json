                ],
                "senses": [
                    {
                        "sense_id": "c5beec93-b93a-3fc3-a49e-e189c95e79ba",
                        "entry_id": "0123af45-4345-3901-8e45-4870d75517f8",
                        "glosses": [
                            "bestaande uit vlokken, vlokken bevattend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ff13cd5-faa6-4faf-9412-1ff414349a97",
                                "sense_id": "c5beec93-b93a-3fc3-a49e-e189c95e79ba",
                                "text": "De pastilla met vis (€14,50) is een flinke pastei van heerlijk vlokkig, Marokkaans filodeeg (werqa) - met de bijgeleverde gegrilde gamba's en salade met gemak een hoofdgerecht."
                            },
                            {
                                "example_id": "9167b221-e194-4569-9d0f-8ffa639be5ae",
                                "sense_id": "c5beec93-b93a-3fc3-a49e-e189c95e79ba",
                                "text": "Op 28 februari 1908 viel Heike Kamerlingh Onnes (1853-1926), de anders zo degelijke manager-wetenschapper, ten prooi aan ontdekkerskoorts. Na een lange dag achter de koelinstallatie, waarmee gassen steeds dichter bij het absolute nulpunt van -273,15 graden gebracht werden, vormde zich in de binnenste, met helium gevulde glazen buis, een vlokkige massa."
                            },
                            {
                                "example_id": "7f8e8572-1048-4131-9c22-04573f7f716c",
                                "sense_id": "c5beec93-b93a-3fc3-a49e-e189c95e79ba",
                                "text": "Hij bestaat uit losse, vlokkige sojastukken (ze doen wat denken aan de imitatiekip uit het vegavak) die op elkaar gepakt toch zorgen voor een compacte en zware structuur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "964a4137-e814-4fe7-a2f2-48ede7d09bf0",
                        "source_entry_id": "0123af45-4345-3901-8e45-4870d75517f8",
                        "source_sense_id": "c5beec93-b93a-3fc3-a49e-e189c95e79ba",
                        "target_lang_word": "fleecy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fleecy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "88aa2b0e-32b5-3e64-9b96-c1944b846d5d",
                                        "entry_id": "e6bf212d-bd5c-30c8-b1fd-25eac869066f",
                                        "glosses": [
                                            "Resembling or covered in fleece."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa2eaa8b-8a19-435e-8ce9-06d3103d7a60",
                                                "sense_id": "88aa2b0e-32b5-3e64-9b96-c1944b846d5d",
                                                "text": "Her path was on the briny deep;\nYet no white sail propell'd her course,\nNor measured oar with graceful sweep\nUrged her to stem the billow's force;\nSelf-moved, with fleecy track she past,\nDisdaining in her pride\nTo woo the breeze or shun the blast,\nOr wait the rolling tide;..."
                                            },
                                            {
                                                "example_id": "9ee71490-76e4-4bd1-88a3-a2dc705beac4",
                                                "sense_id": "88aa2b0e-32b5-3e64-9b96-c1944b846d5d",
                                                "text": "{...} turning to take a last glance into the valley, whence a light mist mounted and formed a fleecy cloud on the skirts of the blue."
                                            },
                                            {
                                                "example_id": "87a47ebb-c316-47de-b142-294bd406aa97",
                                                "sense_id": "88aa2b0e-32b5-3e64-9b96-c1944b846d5d",
                                                "text": "So this was my future home, I thought![…]Backed by towering hills, the but faintly discernible purple line of the French boundary off to the southwest, a sky of palest Gobelin flecked with fat, fleecy little clouds, it in truth looked a dear little city; the city of one's dreams."
                                            },
                                            {
                                                "example_id": "e5a8583e-ebef-45dc-9a55-65533ea233d8",
                                                "sense_id": "88aa2b0e-32b5-3e64-9b96-c1944b846d5d",
                                                "text": "Here the galley paused not at all, but floated easily in the blue of the sky among fleecy clouds tinted with rose."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bbaf5bab-46e7-4c42-be26-dc881620b81c",
                        "source_entry_id": "0123af45-4345-3901-8e45-4870d75517f8",
                        "source_sense_id": "c5beec93-b93a-3fc3-a49e-e189c95e79ba",
                        "target_lang_word": "flocculent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flocculent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "550a7677-fe16-3b1a-81ce-bb3ea9c7f162",
                                        "entry_id": "e1dbad8e-bf49-32c7-8c48-02de592f5344",
                                        "glosses": [
                                            "Flocculated, resembling bits of wool; woolly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1455e93b-3c98-4fbd-89b5-d34a72871834",
                                                "sense_id": "550a7677-fe16-3b1a-81ce-bb3ea9c7f162",
                                                "text": "As soon as night begins to spread its darkening shadows over our brief twilight, this active creature [the morepork] sets out on its hunting excursions, roaming over field and gully with soft, noiseless flight, one of the advantages it owes to its flocculent plumage; [...]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "265a2f5c-6344-380a-9c82-d75494286077",
                                        "entry_id": "e1dbad8e-bf49-32c7-8c48-02de592f5344",
                                        "glosses": [
                                            "Covered in a woolly substance; downy."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9a3e816a-5a80-3f93-ba50-c3206ded1be8",
                                        "entry_id": "e1dbad8e-bf49-32c7-8c48-02de592f5344",
                                        "glosses": [
                                            "Flaky."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "flocculent",
