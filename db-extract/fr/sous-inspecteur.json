                                "example_id": "5f840c7f-81eb-419b-aa7f-634d3ced701c",
                                "sense_id": "b6bebece-829c-34ec-8b7e-f045d2dded89",
                                "text": "Le propriétaire était alors Anatole Laverny, sous-inspecteur des Douanes et secrétaire de la Société des archives historiques de la Saintonge et de l’Aunis."
                            },
                            {
                                "example_id": "394c93ff-be3b-42a6-a774-ca1c617cc9b0",
                                "sense_id": "b6bebece-829c-34ec-8b7e-f045d2dded89",
                                "text": "Le tiers au moins des inspections qui deviendront vacantes sera réservé aux sous-inspecteurs."
                            },
                            {
                                "example_id": "7aa80ef0-f14b-4ed0-a345-95a40bb4b34d",
                                "sense_id": "b6bebece-829c-34ec-8b7e-f045d2dded89",
                                "text": "Les inspecteurs et sous-inspecteurs reçoivent un traitement correspondant à une des classes établies par le présent décret, et des indemnités de déplacement fixées suivant les nécessités du service."
                            }
                        ]
