                                        "glosses": [
                                            "A mechanism within DNA that activates or deactivates a gene."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7d50fd0f-0718-3151-9108-808b982f963a",
                                        "entry_id": "de2cc5f4-25ba-334e-a8a8-2ea7b65a6a2a",
                                        "glosses": [
                                            "One who is willing to take either a submissive or a dominant role in a sexual relationship."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c786af88-3efd-44cb-8ada-19ef57a67709",
                                                "sense_id": "7d50fd0f-0718-3151-9108-808b982f963a",
                                                "text": "Ideally, if one of your ladies happens to be a switch (or would be willing to switch for this scene), I would love to be able to inflict a little \"revenge tickling\" as well, as part of a scenario."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c204a120-87de-37a6-879c-eec5639bc845",
                                        "entry_id": "de2cc5f4-25ba-334e-a8a8-2ea7b65a6a2a",
                                        "glosses": [
                                            "A separate mass or tress of hair, or of some substance (such as jute) made to resemble hair, formerly worn on the head by women."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f215eba3-11b0-3186-a710-67301d55d52e",
