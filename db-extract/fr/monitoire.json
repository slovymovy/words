                "senses": [
                    {
                        "sense_id": "b74c7ff5-abd3-3621-9b0a-4aafa9bf5eb6",
                        "entry_id": "c35de898-9341-3124-af0c-ae45f2082e22",
                        "glosses": [
                            "Lettre d’avertissement pour obliger, sous des peines ecclésiastiques, tous ceux qui ont connaissance d’un crime ou d’un fait qu’on cherche à éclaircir, à venir révéler ce qu’ils savent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32aad4f2-f1c0-4664-9bb6-9ca0edd59d8e",
                                "sense_id": "b74c7ff5-abd3-3621-9b0a-4aafa9bf5eb6",
                                "text": "Il existe un monitoire de l’évêque de Durham contre des clercs irréguliers de cette catégorie qui avaient l’habitude de s’associer avec les brigands des frontières, et qui profanaient les plus saints offices des fonctions ecclésiastiques en les célébrant pour le bien des voleurs, des brigands et des assassins, au milieu des ruines et dans les cavernes, sans égard pour les formes canoniques."
                            }
                        ]
                    },
                    {
                        "sense_id": "cb2b5794-1d35-392b-b36c-c6c36409fb48",
                        "entry_id": "c35de898-9341-3124-af0c-ae45f2082e22",
                        "glosses": [
                            "Citation à comparaître devant un tribunal ecclésiastique, sous peine d’excommunication."
                        ],
