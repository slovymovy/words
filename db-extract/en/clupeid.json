                "senses": [
                    {
                        "sense_id": "06ed16b9-aee4-3d02-8496-643b777c280e",
                        "entry_id": "2ca3b890-d15a-3464-9ac3-4bb5194a8d7e",
                        "glosses": [
                            "Any of many soft-finned fish of the family Clupeidae."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa19a23a-8cd4-4be1-a646-acac3c6498a9",
                                "sense_id": "06ed16b9-aee4-3d02-8496-643b777c280e",
                                "text": "The open water expanses of the lake have been occupied mainly by two species of clupeids, as well as by Eutropius niloticus and Physailia pellucida."
                            },
                            {
                                "example_id": "122de532-4e99-473d-8e27-2edacb5078d4",
                                "sense_id": "06ed16b9-aee4-3d02-8496-643b777c280e",
                                "text": "In the pelagic zone of Lake Tanganyika, the endemic clupeids are planktivores which migrate surfacewards at night (cf. marine clupeids, p. 227)."
                            },
                            {
                                "example_id": "4a7929d3-2ba7-42bc-9be1-2c1dda23981b",
                                "sense_id": "06ed16b9-aee4-3d02-8496-643b777c280e",
                                "text": "Although most marine fishes studied thus far cannot detect sound frequencies above about 500 Hz, at least some clupeids can detect considerably higher frequencies."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1c23bc16-0972-47e4-a1ea-6bfb8bcd9c99",
                        "source_entry_id": "2ca3b890-d15a-3464-9ac3-4bb5194a8d7e",
                        "source_sense_id": "06ed16b9-aee4-3d02-8496-643b777c280e",
                        "source_sense_description": "fish of family Clupeidae",
                        "target_lang_word": "haring",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "haring",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "cf0f8046-e68f-3da5-bd72-441bffbc7a0f",
                                        "entry_id": "e1ba946e-cd98-3173-bd51-5c6018998aa7",
                                        "glosses": [
                                            "bepaald soort zilvergrijze zoutwatervis, geschikt voor consumptie, Clupea harengus"
                                        ],
                                        "tags": [
                                            "straalvinnigen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a938e46a-5240-4642-8a1e-46cd63e976d2",
                                                "sense_id": "cf0f8046-e68f-3da5-bd72-441bffbc7a0f",
                                                "text": "Een miezerig jongetje is tegen een visvrouw met een mand vol koopwaar aan gerend, en een halfdode haring glibbert over de brede voorkant van haar rok naar beneden."
                                            },
                                            {
                                                "example_id": "b279cd79-ccaf-4839-a2c2-112369f937a7",
                                                "sense_id": "cf0f8046-e68f-3da5-bd72-441bffbc7a0f",
                                                "text": "Regenwormen, haring en de lindeboom zijn zomaar een paar typisch Nederlandse natuurverschijnselen. Vijftig van dit soort karakteristieke soorten planten en dieren staan in de eerste Canon van de Nederlandse natuur, die vandaag verschijnt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d1944d6-ca62-3be5-af30-35dc48c26c15",
                                        "entry_id": "e1ba946e-cd98-3173-bd51-5c6018998aa7",
                                        "glosses": [
                                            "soort pen waarmee de scheerlijnen van een tent in de bodem bevestigd worden, tentharing"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8f5a005-f470-4a93-a78f-ca233b66e7fd",
                                                "sense_id": "2d1944d6-ca62-3be5-af30-35dc48c26c15",
                                                "text": "Ik kroop mijn tent uit en verzette nogmaals alle haringen om zo nog minder in de weg te staan."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
