                                "target_senses": [
                                    {
                                        "sense_id": "7003e525-980f-3a82-82bb-90df163f4c2f",
                                        "entry_id": "1c145956-407d-3551-a1e0-74353455a201",
                                        "glosses": [
                                            "für [1] bis [3]: nur für männliche Personen"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "57ddfea0-181c-3c3f-87ef-5c00583bdea3",
                                        "entry_id": "1c145956-407d-3551-a1e0-74353455a201",
                                        "glosses": [
                                            "Bauer, Bauernjunge; großer, kräftiger, oft ungebildeter, unhöflicher Mann vom Lande"
                                        ],
                                        "tags": [
                                            "ursprünglich"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b053d96-f30c-434d-8a77-0ae89abede5b",
                                                "sense_id": "57ddfea0-181c-3c3f-87ef-5c00583bdea3",
                                                "text": "Aus diesem Lümmel wird nie etwas Richtiges."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0c39fb3a-f5b8-374a-8dda-ddd238878570",
                                        "entry_id": "1c145956-407d-3551-a1e0-74353455a201",
                                        "glosses": [
                                            "Junge oder Mann mit schlechten, groben Manieren, unangebrachtem, negativ auffälligem Benehmen"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c1ca5a8-667b-4043-ac80-dad21844f3ec",
                                                "sense_id": "0c39fb3a-f5b8-374a-8dda-ddd238878570",
                                                "text": "Aus diesem Lümmel wird nie etwas Richtiges."
                                            },
                                            {
                                                "example_id": "bfc0c290-4d44-49b2-96b1-b27a91d03075",
                                                "sense_id": "0c39fb3a-f5b8-374a-8dda-ddd238878570",
                                                "text": "„Es sprach sich jedoch herum, daß der Lümmel auf Laxnes die Linie nach Thingvellir unterbrach, weil er zu faul war zu antworten.“"
                                            },
                                            {
                                                "example_id": "cc1e4c70-6878-4196-b931-4e62eab29205",
                                                "sense_id": "0c39fb3a-f5b8-374a-8dda-ddd238878570",
                                                "text": "„Ich gehe mit raschen Schritten zum Etoile, bis ich niemanden sehe, und frage den Lümmel, was er von mir will und was ihn veranlaßt, mich zu überfallen.“"
                                            },
                                            {
                                                "example_id": "7a9e1a39-44ce-45fb-b748-e16b452c78b2",
                                                "sense_id": "0c39fb3a-f5b8-374a-8dda-ddd238878570",
                                                "text": "„An der Umzäunung rissen ein paar Lümmel blöde Witze.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "6378016c-7be2-34f0-8d46-87aa2e5b8bc3",
                                        "entry_id": "1c145956-407d-3551-a1e0-74353455a201",
                                        "glosses": [
                                            "Schlingel"
                                        ],
                                        "tags": [
                                            "vertraulich",
                                            "familiär",
                                            "positiv besetzt"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19ce09b2-e170-497d-9324-b45fc13880df",
                                                "sense_id": "6378016c-7be2-34f0-8d46-87aa2e5b8bc3",
                                                "text": "Du bist mir vielleicht ein Lümmel, aber geh nachher rüber und entschuldige dich!"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "4ab40bb8-88c8-3aa0-9eb5-a625d1a1dceb",
                                        "entry_id": "1c145956-407d-3551-a1e0-74353455a201",
                                        "glosses": [
                                            "Penis"
                                        ],
                                        "tags": [
                                            "vulgär für"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8112f6c-1e1c-43ea-98cc-deab648a4b6b",
                                                "sense_id": "4ab40bb8-88c8-3aa0-9eb5-a625d1a1dceb",
                                                "text": "Sein Hosenstall war offen und man konnte beinahe seinen Lümmel sehen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "289d3270-4e4b-3128-a7f8-58b22f00c3ec",
                                        "entry_id": "1c145956-407d-3551-a1e0-74353455a201",
                                        "glosses": [
                                            "Verbindung zwischen Baum und Mast, häufig mittels eines Zapfens und einer Aufhängung; Lümmelbeschlag"
                                        ],
                                        "tags": [
                                            "Seglersprache"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c13d292-2592-4938-9401-2917e46edfcf",
                                                "sense_id": "289d3270-4e4b-3128-a7f8-58b22f00c3ec",
                                                "text": "Lümmel nennt sich die Verbindung zwischen Baum und Mast, bestehend aus dem Lümmelbeschlag am Baum und dem Lümmellager am Mast."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bdd6608c-ab3e-43f4-996a-d50e881fc95a",
                        "source_entry_id": "a8b8dd4d-ae31-3416-ba6c-801bf2df06e4",
                        "source_sense_id": "4ac35ee7-b4d9-3f90-90a1-7c0e42594daa",
                        "target_lang_word": "boor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "boor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7dca29c0-a79f-3c3b-a314-20eb0d1ee113",
                                        "entry_id": "874cd61f-2f57-3533-a799-df980abf3ef3",
                                        "glosses": [
                                            "A peasant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "727ef383-6011-412f-bf44-52e4bd91464f",
                                                "sense_id": "7dca29c0-a79f-3c3b-a314-20eb0d1ee113",
                                                "text": "Not swear it, now I am a gentleman? Let boors and franklins say it, I’ll swear it."
                                            },
                                            {
                                                "example_id": "b67d62d7-5486-48f7-ab27-8d45fcce7b0c",
                                                "sense_id": "7dca29c0-a79f-3c3b-a314-20eb0d1ee113",
                                                "text": "For all the rich array and goodly port and countenance of Corinius, he seemed but a very boor beside the Lord Brandoch Daha, and dearly did each hate the other."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d40eac4-4fbe-3175-a746-2bc8b1ce1695",
                                        "entry_id": "874cd61f-2f57-3533-a799-df980abf3ef3",
                                        "glosses": [
                                            "A Boer, white South African of Dutch or Huguenot descent."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "00a94902-5c40-3d3f-bde6-4367bc52b1a6",
                                        "entry_id": "874cd61f-2f57-3533-a799-df980abf3ef3",
                                        "glosses": [
                                            "A yokel, country bumpkin."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b0ba5e00-72cd-359b-aa28-b072a38ef81e",
                                        "entry_id": "874cd61f-2f57-3533-a799-df980abf3ef3",
                                        "glosses": [
                                            "An uncultured person; a vulgarian."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "367635d2-d061-48ea-8df1-fe3e60ebf3de",
                                                "sense_id": "b0ba5e00-72cd-359b-aa28-b072a38ef81e",
                                                "text": "I question if any man ever saw his absent friend more clearly than did Shakespeare his Falstaff, for instance, or Scott his Balfour of Burleigh. But does it, therefore, follow that either of these great writers would, when hungry, have summoned up before him a clearer picture of his approaching dinner, than does the equally hungry or very much hungrier boor? This I doubt; and on the same principle I doubt if the said boor would see his dinner more clearly than a wolf, bear, or tiger would theirs when in quest of it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0faad8d8-f959-4b46-a19f-3d0624bb9027",
                        "source_entry_id": "a8b8dd4d-ae31-3416-ba6c-801bf2df06e4",
                        "source_sense_id": "4ac35ee7-b4d9-3f90-90a1-7c0e42594daa",
                        "target_lang_word": "lourdaud",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lourdaud",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b16de0dc-37fd-37f9-a833-df64f93603f0",
                                        "entry_id": "3a24099f-5cf0-3f84-9431-7dd3ed642bb4",
                                        "glosses": [
                                            "Lourd et maladroit, pataud."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b59c2d6e-b0e3-44e1-8d9b-8af9620ac610",
                                                "sense_id": "b16de0dc-37fd-37f9-a833-df64f93603f0",
                                                "text": "La démarche est un peu lourdaude dans un uniforme fripé, délavé par la pluie et la neige."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47f3469b-826e-3af5-bb42-2ba83e70b742",
                                        "entry_id": "3a24099f-5cf0-3f84-9431-7dd3ed642bb4",
                                        "glosses": [
                                            "À l’apparence massive, dénué de grâce."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60d3dc18-cbad-4f37-a7ef-04144456a2bf",
                                                "sense_id": "47f3469b-826e-3af5-bb42-2ba83e70b742",
                                                "text": "Nous continuons à nous croire légers et rapides sans voir que tous les pays nous ont dépassés. Aux Olympiades, je souffrais le martyre à voir ceux que nous persistons à appeler « ces lourdauds d’Allemands », comme dans les contes du XVIIIe, nous surclasser dès les éliminatoires."
                                            },
                                            {
                                                "example_id": "1855334f-4ee0-46cc-94fa-62f17436cdb2",
                                                "sense_id": "47f3469b-826e-3af5-bb42-2ba83e70b742",
                                                "text": "Attibert se retourna et distingua une silhouette lourdaude que des hommes hissaient sur leurs épaules."
                                            },
                                            {
                                                "example_id": "319209a9-a013-412b-838a-efac5ab5c18c",
                                                "sense_id": "47f3469b-826e-3af5-bb42-2ba83e70b742",
                                                "text": "Juché sur le tronc d’un arbre abattu par la bourrasque, il observait ses deux frères, dos à dos, en train de dérouiller ces lourdauds de van der Merwe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "892986bf-d6d4-3af1-aaa1-c941ad88e1be",
                                        "entry_id": "3a24099f-5cf0-3f84-9431-7dd3ed642bb4",
                                        "glosses": [
                                            "Fruste, dont l’esprit est dépourvu de toute finesse."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e57572dd-e120-44fd-b716-2c25e4e0128d",
                                                "sense_id": "892986bf-d6d4-3af1-aaa1-c941ad88e1be",
                                                "text": "Le cocher était ce François, gars de campagne, un peu lourdaud, bon cœur, niais, facile à duper."
                                            },
                                            {
                                                "example_id": "c9903b5c-99d7-44db-892b-80803e3f384c",
                                                "sense_id": "892986bf-d6d4-3af1-aaa1-c941ad88e1be",
                                                "text": "Mes manigances pour vous faire porter le chapeau n'ont pas fonctionné, mais je ne suis pas un gros lourdaud pour autant."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lourdaud",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5fe00305-db33-3eaf-936d-0fd9ec283f05",
                                        "entry_id": "b640cbb1-4de1-3b3e-a8d1-3a1331ddb2b1",
                                        "glosses": [
                                            "Individu lourd et maladroit, pataud."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24bf091a-3d4e-474a-95a2-a87eec47c4ad",
                                                "sense_id": "5fe00305-db33-3eaf-936d-0fd9ec283f05",
                                                "text": "Le ministre descendit de voiture, Tancrède le suivit aussitôt. Par bonheur, le valet de pied était un lourdaud qui lui laissa le temps de descendre avant qu’il eût pensé à relever le marche-pied."
                                            },
                                            {
                                                "example_id": "d8cd6f05-95d2-450b-8775-1b68c7a9e044",
                                                "sense_id": "5fe00305-db33-3eaf-936d-0fd9ec283f05",
                                                "text": "Justin, qui apportait alors une pile d’assiettes, fut saisi d’un tremblement.\n— Qu’as-tu ? dit le pharmacien. Le jeune homme, à cette question, laissa tout tomber par terre, avec un grand fracas.\n— Imbécile ! s’écria Homais, maladroit ! lourdaud ! fichu âne !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b89adab-c2c7-3721-b594-fab2e3c606dd",
                                        "entry_id": "b640cbb1-4de1-3b3e-a8d1-3a1331ddb2b1",
                                        "glosses": [
                                            "Individu à l’apparence massive, dénué de grâce."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62d5e7be-0e41-4969-aa48-b2a2037941e2",
                                                "sense_id": "4b89adab-c2c7-3721-b594-fab2e3c606dd",
                                                "text": "Amour ! bel amour ! il n’est pas au monde de plus grand magicien que toi. D’un professeur lourdaud, vieillot, maniaque, tu fais un Adonis !"
                                            },
                                            {
                                                "example_id": "52222e8c-1ca3-4910-8bf0-88e9c827fa4a",
                                                "sense_id": "4b89adab-c2c7-3721-b594-fab2e3c606dd",
                                                "text": "À côté de lui, le gros lourdaud aux joues couperosées, c'est Gaspard, le fermier, et là, Anna, sa femme, efficace, joviale, un cul imposant mais alerte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60ff9870-2c21-36cb-b9a2-8e5f81a193a0",
                                        "entry_id": "b640cbb1-4de1-3b3e-a8d1-3a1331ddb2b1",
                                        "glosses": [
                                            "Individu fruste, dont l’esprit est dépourvu de toute finesse."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96b9c74f-319b-4454-a212-bf03065cc18e",
                                                "sense_id": "60ff9870-2c21-36cb-b9a2-8e5f81a193a0",
                                                "text": "Un lourdaud libéral, auprès d’une maîtresse,\nSemble donner l’aumône alors qu’il fait largesse ;\nEt d’un tel contre-temps il fait tout ce qu’il fait,\nQue quand il tâche à plaire il offense en effet."
                                            },
                                            {
                                                "example_id": "eb704f2b-6ce5-4e8d-8ec4-c709dadcfc5e",
                                                "sense_id": "60ff9870-2c21-36cb-b9a2-8e5f81a193a0",
                                                "text": "Je pouvais suivre le raisonnement simpliste de ces lourdauds […]"
                                            },
                                            {
                                                "example_id": "9d83e21d-ef01-47b4-9323-17dbfa32fdf3",
                                                "sense_id": "60ff9870-2c21-36cb-b9a2-8e5f81a193a0",
                                                "text": "Elle eut un sourire large et très pro. Le sourire spécial réservé aux lourdauds qui n’ont rien appris de la marche du monde et de ses complexités."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
