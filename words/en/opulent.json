                    "frequency": "Middle",
                    "semantic_group_id": "wealth_and_luxury",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hotel lobby was decorated with <w>opulent</w> gold leaf and massive crystal chandeliers.",
