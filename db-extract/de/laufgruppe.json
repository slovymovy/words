                ],
                "senses": [
                    {
                        "sense_id": "12c57179-afe1-3b21-953b-2a273ef3ebbb",
                        "entry_id": "01b8d984-36d2-3c71-8e62-424f0b84a28d",
                        "glosses": [
                            "Gruppe von Läufern; Gruppe von Menschen, die gemeinsam laufen oder (regelmäßig) am Lauftraining teilnehmen"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "066b9114-abef-47eb-96f7-1cfb4b9f1c83",
                                "sense_id": "12c57179-afe1-3b21-953b-2a273ef3ebbb",
                                "text": "„Was sagt man, wenn man nicht in einer Laufgruppe ist und für einen Marathon trainiert, wenn man seine Abende nicht beim Klavierunterricht verbringt, sondern lieber auf der Couch sitzt und GZSZ oder Netflix schaut?“"
                            },
                            {
                                "example_id": "b82db048-abda-48d3-bcc9-bbc5542b075f",
                                "sense_id": "12c57179-afe1-3b21-953b-2a273ef3ebbb",
                                "text": "„Regelmäßig stattfindende Gruppen sind u.a., der christliche Stammtisch, die Laufgruppe, die TransID Gruppe für Ü 27, die trans*-Jugendgruppe und das Treffen der Queerkids für Regenbogenfamilien.“"
                            },
                            {
                                "example_id": "d9c1304f-ca04-4eb3-a40a-bb8fd48215b8",
                                "sense_id": "12c57179-afe1-3b21-953b-2a273ef3ebbb",
                                "text": "„Der Verein gliedert sich in 4 Abteilungen, Fußball, Kegeln, Laufgruppe und Gymnastik.“"
                            },
                            {
                                "example_id": "36aaced4-5bf0-4caa-99dd-fb8b0f2a1d71",
                                "sense_id": "12c57179-afe1-3b21-953b-2a273ef3ebbb",
                                "text": "„An einem Märzsonntag startete eine kleine Laufgruppe bei der Sparrenburg in Richtung Hermannsdenkmal.“"
                            },
                            {
                                "example_id": "3fffb4e6-190d-48b7-bea0-2389b363ade2",
                                "sense_id": "12c57179-afe1-3b21-953b-2a273ef3ebbb",
                                "text": "„Die Stimmung hätte bei dem Sternlauf der vier verschiedenen Laufgruppen zur zentralen Feierstunde an der Marina Rünthe nicht besser sein können, denn die Sonne lachte vom Himmel, und auch die angenehme Temperatur von 18 Grad bot ideale Lauf- und Walking-Bedingungen.“"
                            },
                            {
                                "example_id": "f49cf6ab-f788-4146-a4c6-b74b6202ac06",
                                "sense_id": "12c57179-afe1-3b21-953b-2a273ef3ebbb",
                                "text": "„Gerade in den tristen Wochen des Jahres dürfte es sich daher lohnen, zu zweit oder in einer Laufgruppe den eigenen Zielen nachzujagen, statt sich alleine über die Strecke zu quälen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
