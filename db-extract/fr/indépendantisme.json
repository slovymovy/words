                "entry_id": "e2e3a4ee-603d-3ffb-adf6-6785f0eb6cba",
                "word": "indépendantisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "948b29ae-7e99-4b66-b904-81e3935e77fd",
                        "entry_id": "e2e3a4ee-603d-3ffb-adf6-6785f0eb6cba",
                        "tags": [
