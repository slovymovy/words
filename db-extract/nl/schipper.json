                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "17e3dcff-8479-3ff2-9235-b4fedd930f35",
                                        "entry_id": "b93a7755-4006-3805-8715-d712d7e7063b",
                                        "glosses": [
                                            "A chief or leader."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a8edf84-9daa-450e-9538-83aa0f766022",
                                                "sense_id": "17e3dcff-8479-3ff2-9235-b4fedd930f35",
                                                "text": "For out of the shal come a captaine, whych shall govern my people israhel."
                                            },
                                            {
                                                "example_id": "d07d77ce-8cac-448b-8208-e48573b93d28",
                                                "sense_id": "17e3dcff-8479-3ff2-9235-b4fedd930f35",
                                                "text": "Stand up-stand up, Northumberland! / I bid you answer true, / If England's King has under his hand / A Captain as good as you?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea25f27b-e143-3cb1-bf85-3ece1dcc271c",
                                        "entry_id": "b93a7755-4006-3805-8715-d712d7e7063b",
                                        "glosses": [
                                            "The person lawfully in command of a ship or other vessel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2534434-6fca-4770-8fb8-8e161be5fa64",
                                                "sense_id": "ea25f27b-e143-3cb1-bf85-3ece1dcc271c",
                                                "text": "Merchants, common sailors, captains of vessels, skippers, […] naval officers of all countries, and the Governments of several states on the two continents, were deeply interested in the matter."
                                            },
                                            {
                                                "example_id": "17a675d9-4c66-4f62-9c31-426c5215c2fc",
                                                "sense_id": "ea25f27b-e143-3cb1-bf85-3ece1dcc271c",
                                                "text": "The captain is the last man to leave a sinking ship."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc17653a-e7e8-354b-be10-d15139309727",
                                        "entry_id": "b93a7755-4006-3805-8715-d712d7e7063b",
                                        "glosses": [
                                            "An army officer with a rank between the most senior grade of lieutenant and major."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2708416-2613-48b4-b393-b46be820676f",
                                                "sense_id": "bc17653a-e7e8-354b-be10-d15139309727",
                                                "text": "\"A fine man, that Dunwody, yonder,\" commented the young captain, as they parted, and as he turned to his prisoner. \"We'll see him on in Washington some day. He is strengthening his forces now against Mr. Benton out there.[…].\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d62084b-28b9-35b6-8999-15557a6ac44c",
                                        "entry_id": "b93a7755-4006-3805-8715-d712d7e7063b",
                                        "glosses": [
                                            "A naval officer with a rank between commander and commodore."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "863f7da8-01c0-340e-a8e5-8449b4dc16f4",
                                        "entry_id": "b93a7755-4006-3805-8715-d712d7e7063b",
                                        "glosses": [
                                            "A commissioned officer in the United States Navy, Coast Guard, NOAA Corps, or PHS Corps of a grade superior to a commander and junior to a rear admiral (lower half). A captain is equal in grade or rank to a United States Army, Marine Corps, or Air Force colonel."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1d2d2943-3fad-31ce-9cd6-1f5578563556",
                                        "entry_id": "b93a7755-4006-3805-8715-d712d7e7063b",
                                        "glosses": [
                                            "One of the athletes on a sports team who is designated to make decisions, and is allowed to speak for his team with a referee or official."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96de6254-0471-4bd8-8d26-37c15a8aa55a",
                                                "sense_id": "1d2d2943-3fad-31ce-9cd6-1f5578563556",
                                                "text": "Captain's supposed to be the leader, right?"
                                            },
                                            {
                                                "example_id": "2b168d34-f7b1-4e7b-a840-ee4b6853c476",
                                                "sense_id": "1d2d2943-3fad-31ce-9cd6-1f5578563556",
                                                "text": "As Di Matteo celebrated and captain John Terry raised the trophy for the fourth time, the Italian increased his claims to become the permanent successor to Andre Villas-Boas by landing a trophy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9da9bff6-0445-3571-acf8-a1178950d7ef",
                                        "entry_id": "b93a7755-4006-3805-8715-d712d7e7063b",
                                        "glosses": [
                                            "The leader of a group of workers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb7a62f0-201d-4cca-89b8-cd009e42a9f8",
                                                "sense_id": "9da9bff6-0445-3571-acf8-a1178950d7ef",
                                                "text": "John Henry said to the captain, \"A man ain't nothing but a man.\""
                                            },
                                            {
                                                "example_id": "47fa9b8b-d00b-4a67-af7f-7bd1d0115857",
                                                "sense_id": "9da9bff6-0445-3571-acf8-a1178950d7ef",
                                                "text": "The assistant mine captains then reported to the mine captain in charge of all underground operations and subordinate only to the superintendent himself."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13797738-b4e2-3bd0-946d-73c6b0e892ee",
                                        "entry_id": "b93a7755-4006-3805-8715-d712d7e7063b",
                                        "glosses": [
                                            "The head boy of a school."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ae9f4ce7-2407-39c5-9dfc-f4732a0a51f5",
                                        "entry_id": "b93a7755-4006-3805-8715-d712d7e7063b",
                                        "glosses": [
                                            "A maître d', a headwaiter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdfe0565-9ad4-4fbf-b20a-f38f92bac700",
                                                "sense_id": "ae9f4ce7-2407-39c5-9dfc-f4732a0a51f5",
                                                "text": "1977, Don Felder, Don Henley, and Glenn Frey, lyricists, \"Hotel California\",\nSo I called up the Captain, \"Please bring me my wine.\" / He said: \"We haven't had that spirit here since 1969.\""
                                            }
                                        ]
                                    },
