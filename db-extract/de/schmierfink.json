                "translations": [
                    {
                        "translation_id": "d89578cc-03ae-4209-a123-e4ebc20e4f43",
                        "source_entry_id": "341a17d1-ff2f-3be2-90e5-cf446473b2ca",
                        "source_sense_id": "8067bde7-6335-3c83-a595-57df0bd25257",
                        "source_sense_description": "Schimpfwort: jemand, der unsauber, ungenau schreibt, insbesondere bei Schulkindern",
                        "target_lang_word": "dauber",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dauber",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5da4d3bf-dee2-305d-84f4-f2e5d54b15cb",
                                        "entry_id": "7b180a46-3e13-3954-b004-409f09c97294",
                                        "glosses": [
                                            "One who, or that which, daubs; especially, a coarse, unskillful painter."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52cd8dc8-f1e7-4557-9d40-094aacc9de1c",
                                                "sense_id": "5da4d3bf-dee2-305d-84f4-f2e5d54b15cb",
                                                "text": "After he had exerted all his powers to produce a masterpiece of art, the canons, upon viewing the picture, pronounced it a contemptible performance, and the artist a miserable dauber; and Vandyck could hardly obtain payment for his work."
                                            },
                                            {
                                                "example_id": "327d3f5f-91e2-4ed8-871a-37a73f487640",
                                                "sense_id": "5da4d3bf-dee2-305d-84f4-f2e5d54b15cb",
                                                "text": "I want to be great, or nothing. I won't be a common-place dauber, so I don't intend to try any more."
                                            },
                                            {
                                                "example_id": "ed98633d-473a-42f4-af4e-d4921df07ff6",
                                                "sense_id": "5da4d3bf-dee2-305d-84f4-f2e5d54b15cb",
                                                "text": "I'm not a good painter; I'm a dauber who can get a good likeness. Van Gogh or Cézanne would never have made it; I was given a bottle of Beaujolais and a set of directions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ccf133ec-4306-3cab-ad6e-f61f9cc83a36",
                                        "entry_id": "7b180a46-3e13-3954-b004-409f09c97294",
                                        "glosses": [
                                            "A pad or ball of rags, covered with canvas, for inking plates."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "96fec963-4703-38eb-adc6-c3398d76f18e",
                                        "entry_id": "7b180a46-3e13-3954-b004-409f09c97294",
                                        "glosses": [
                                            "A type of thick marker pen used to mark a bingo card."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d14212f-ffc6-49fa-8d6e-686320e3a315",
                                                "sense_id": "96fec963-4703-38eb-adc6-c3398d76f18e",
                                                "text": "Said she wasn't going but she went still / Likes her gentlemen not to be gentle / Was it a Mecca dauber or a betting pencil?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae846b6c-8b1a-3f3d-b9ed-2f4397cc3cdc",
                                        "entry_id": "7b180a46-3e13-3954-b004-409f09c97294",
                                        "glosses": [
                                            "A low and gross flatterer."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6c86e74f-a90e-3ad3-bdcb-759d053caaa5",
                                        "entry_id": "7b180a46-3e13-3954-b004-409f09c97294",
                                        "glosses": [
                                            "The mud wasp; the mud dauber."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0b1eb05e-97c8-44bf-bc09-ae2cfb160580",
                        "source_entry_id": "341a17d1-ff2f-3be2-90e5-cf446473b2ca",
                        "source_sense_id": "8067bde7-6335-3c83-a595-57df0bd25257",
                        "source_sense_description": "Schimpfwort: jemand, der unsauber, ungenau schreibt, insbesondere bei Schulkindern",
                        "target_lang_word": "barbouilleur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "barbouilleur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "22f70472-c931-3a9b-a135-72a3179903d6",
                                        "entry_id": "1f420d2e-1feb-3ca8-8021-2ce20bf9ab49",
                                        "glosses": [
                                            "Personne qui barbouille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26503310-d4c4-4e0f-a573-1847b1030d9c",
                                                "sense_id": "22f70472-c931-3a9b-a135-72a3179903d6",
                                                "text": "Dans le contexte culturel de la publication de ce livre, il est observé que, « Les intentions des barbouilleurs nocturnes sont de corsiser les noms des lieux » (Ettori, op. cit. : 360)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dfb8fe22-39a9-33c3-9833-c878c30bba10",
                                        "entry_id": "1f420d2e-1feb-3ca8-8021-2ce20bf9ab49",
                                        "glosses": [
                                            "Mauvais peintre, mauvais écrivain."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "233ce15e-0992-4cc5-b1a7-800d04b3b59c",
                                                "sense_id": "dfb8fe22-39a9-33c3-9833-c878c30bba10",
                                                "text": "Ce que les romans du dix-septième siècle appelaient le coup de foudre, qui décide du destin du héros et de sa maîtresse, est un mouvement de l\"âme qui, pour avoir été gâté par un nombre infini de barbouilleurs, n\"en existe pas moins dans la nature; …."
                                            },
                                            {
                                                "example_id": "7bea7709-0ca1-40e6-9c5f-51963cc4c235",
                                                "sense_id": "dfb8fe22-39a9-33c3-9833-c878c30bba10",
                                                "text": "Ces peintures, faites par des barbouilleurs de province, prenaient de la barbarie même du travail un aspect hétéroclite et formidable."
                                            },
                                            {
                                                "example_id": "156cb899-970f-4701-9a56-821179f5d615",
                                                "sense_id": "dfb8fe22-39a9-33c3-9833-c878c30bba10",
                                                "text": "La duchesse d’Armonville avait lancé un petit rire énigmatique et, somme toute, puisque par le fait d’un oncle éloigné, mort à propos, le barbouilleur superbe possédait une fortune de trois cent mille francs, il devenait un peu moins ridicule."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1806def0-3cb9-485d-92ba-e244e6be231c",
                        "source_entry_id": "341a17d1-ff2f-3be2-90e5-cf446473b2ca",
                        "source_sense_id": "eb411a7a-1630-3a05-8a82-77758c001e96",
                        "source_sense_description": "Schimpfwort: jemand, der Unanständiges, Anstößiges, Verleumderisches oder Beleidigendes veröffentlicht",
                        "target_lang_word": "muckraker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "muckraker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2c573e53-2b6d-39e7-8468-9f42adae8092",
                                        "entry_id": "84d68172-7569-36d5-b182-1e654174e073",
                                        "glosses": [
                                            "One who investigates and exposes issues of corruption that often violate widely held values; e.g. one who exposes political corruption or the poor conditions in prisons."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05459a98-b354-4d30-93ec-a58057d278bd",
                                                "sense_id": "2c573e53-2b6d-39e7-8468-9f42adae8092",
                                                "text": "The paper gave a start to the theater critic Hilton Als and the novelist Colson Whitehead, both recipients of the Pulitzer Prize. Its resident muckraker, Wayne Barrett, took aim at New York developers and politicians for nearly 40 years, and his obsessive work on Donald J. Trump has become a resource for reporters covering the president today."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7771503-dda1-349e-a6c2-60f475eca131",
                                        "entry_id": "84d68172-7569-36d5-b182-1e654174e073",
                                        "glosses": [
                                            "One of a group of American investigative reporters, novelists and critics of the Progressive Era (the 1890s to the 1920s)."
                                        ],
                                        "tags": [
                                            "US",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff6c7626-54e1-4c4e-bb54-813951bdd447",
                                                "sense_id": "d7771503-dda1-349e-a6c2-60f475eca131",
                                                "text": "\"Oh, in many ways. There are two classes of people who are not welcomed on the Canal Zone—magazine writers and applicants for positions who have political influence back of them. The former are regarded as muckrakers, the latter as spies.\""
                                            },
                                            {
                                                "example_id": "09ead97c-fa48-415a-9c42-b8dd005a89e7",
                                                "sense_id": "d7771503-dda1-349e-a6c2-60f475eca131",
                                                "text": "\"Lady,\" says he, \"the goil's nutty! You got a bughouse patient on your bands! This here talk about the white-slave traffic, ma'am… it's all the work o' these magazine muckrakers!\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d62daef-24c4-335e-99bd-e114bab78abc",
                                        "entry_id": "84d68172-7569-36d5-b182-1e654174e073",
                                        "glosses": [
                                            "A sensationalist, scandalmongering journalist, one who is not driven by any social principles."
                                        ],
                                        "tags": [
                                            "British",
                                            "derogatory"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
