                "senses": [
                    {
                        "sense_id": "191d5c8a-b12d-3bc6-b04d-47c28f73f644",
                        "entry_id": "3807474d-f93f-37e7-812e-2d26c6bc5c73",
                        "glosses": [
                            "Rire, plaisanter, faire des farces."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "71b129d7-837f-3e9f-ae57-278a03d5aaee",
                        "entry_id": "3807474d-f93f-37e7-812e-2d26c6bc5c73",
                        "glosses": [
                            "Mettre en farce, railler dans une farce."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "019bb0ee-f026-4148-a006-9c001eb41334",
                                "sense_id": "71b129d7-837f-3e9f-ae57-278a03d5aaee",
                                "text": "Molière, que bien connaissez\nEt qui vous a si bien farcés,\nMessieurs les coquets et coquettes."
                            },
                            {
                                "example_id": "3b33212a-747e-4169-bbec-2865ea12c34d",
                                "sense_id": "71b129d7-837f-3e9f-ae57-278a03d5aaee",
                                "text": "Paillardin. — C’est une farce, hein ? C’est une farce !…\nPinglet. — Une farce ! Est-ce que j’ai l’air de farcer, Monsieur ?"
                            },
                            {
                                "example_id": "98cac2f9-1749-49f1-8db8-14ef78bfb7cf",
                                "sense_id": "71b129d7-837f-3e9f-ae57-278a03d5aaee",
                                "text": "Le patron croyait lui avoir rendu service en le présentant au journaliste de Paris-Midi ? Celui-ci était persuadé qu’il faisait un acte de bonté en acceptant d’inviter Jean à sa table ? Ils étaient farcés tous les deux !"
                            }
                        ]
                    }
                ],
