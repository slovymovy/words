                    {
                        "sense_id": "643ece45-ba4c-3c64-9ee0-b1c3069dadfe",
                        "entry_id": "5a200d31-7c35-3e65-824d-337e1e8f5249",
                        "glosses": [
                            "Femme membre d’un sénat."
                        ],
                        "tags": [
                            "Métier"
                        ],
                        "examples": [
                            {
                                "example_id": "ab27d35a-f57f-4aee-a6c0-e1b2ae2a3765",
                                "sense_id": "643ece45-ba4c-3c64-9ee0-b1c3069dadfe",
                                "text": "Les documents saisis dans l’ordinateur de Raúl Reyes sont accablants pour la sénatrice colombienne d’extrême gauche."
                            },
                            {
                                "example_id": "b90e2a00-0258-47e2-9243-22d3bce68541",
                                "sense_id": "643ece45-ba4c-3c64-9ee0-b1c3069dadfe",
                                "text": "Si dans un premier temps elle se destine uniquement à une carrière juridique, elle se lance finalement en politique au tournant des années 2000 et gravit progressivement les échelons avant de devenir sénatrice en 2017."
                            }
                        ]
                    },
                    {
                        "sense_id": "1fb264e8-5d67-33e9-af64-dc1dd793f06b",
                        "entry_id": "5a200d31-7c35-3e65-824d-337e1e8f5249",
                        "glosses": [
                            "Épouse d’un sénateur de Pologne, de Suède, ou de Rome."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eef66d33-6603-4b59-b672-b09b996ac1ab",
                        "source_entry_id": "5a200d31-7c35-3e65-824d-337e1e8f5249",
                        "source_sense_id": "643ece45-ba4c-3c64-9ee0-b1c3069dadfe",
                        "source_sense_description": "Membre d’un sénat",
                        "target_lang_word": "Senatorin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Senatorin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "967611e7-ed2f-3b5b-b2ab-2340452e4a1e",
                                        "entry_id": "540477e9-8c85-3f55-8bf6-be03f56b8b18",
                                        "glosses": [
                                            "weibliches Mitglied eines Senats"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f12f5926-0e99-4a50-8f19-887a93e9ffd6",
                                                "sense_id": "967611e7-ed2f-3b5b-b2ab-2340452e4a1e",
                                                "text": "„Hillary Clinton ist seit nunmehr fast einem Vierteljahrhundert im öffentlichen Bewusstsein allgegenwärtig, als First Lady, Senatorin, oberste Diplomatin und in jüngster Zeit vor allem als Rednerin, deren Honorare für einen abendlichen Auftritt in der Grössenordnung von einer Viertelmillion Dollar liegen.“"
                                            },
                                            {
                                                "example_id": "9ea390f2-6f91-44a2-820c-e6f61a9109e9",
                                                "sense_id": "967611e7-ed2f-3b5b-b2ab-2340452e4a1e",
                                                "text": "„In der neuen rot-rot-grünen Regierung ist die Linken-Politikerin als Senatorin für Stadtentwicklung und Wohnen zuständig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aa7999cf-e27a-4552-8f9c-f283a40e0ad4",
                        "source_entry_id": "5a200d31-7c35-3e65-824d-337e1e8f5249",
                        "source_sense_id": "643ece45-ba4c-3c64-9ee0-b1c3069dadfe",
                        "source_sense_description": "Membre d’un sénat",
                        "target_lang_word": "senator",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "senator",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0dd3295d-7dc1-3840-9162-212a6262f399",
                                        "entry_id": "992c9b83-7d0e-3035-ae84-cbd83df6efd5",
                                        "glosses": [
                                            "A member, normally elected, in the house or chamber of a legislature called a senate, as, for instance, the legislatures of the United States and Canada."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec596097-98ac-4fec-8b34-50f5bc955225",
                                                "sense_id": "0dd3295d-7dc1-3840-9162-212a6262f399",
                                                "text": "It was disbanded when Derrick was only six, after that grouchy old ultra-Libertarian Senator Timothy de Illy made “welfare hotel for Third-World nations” a household catchphrase."
                                            },
                                            {
                                                "example_id": "629b88c2-1fcd-494c-99fc-08afeed7f656",
                                                "sense_id": "0dd3295d-7dc1-3840-9162-212a6262f399",
                                                "text": "I was a United States senator-elect at age thirty."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b848a165-35f7-3f25-a859-c064fbd3596a",
                                        "entry_id": "992c9b83-7d0e-3035-ae84-cbd83df6efd5",
                                        "glosses": [
                                            "A member of any legislative body or parliament, particularly the British Parliament."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b72e594b-8cf9-3e24-ba04-ee9ce276e3a5",
                                        "entry_id": "992c9b83-7d0e-3035-ae84-cbd83df6efd5",
                                        "glosses": [
                                            "A member of the ancient Roman Senate."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "34aaca4e-2d7b-3dd0-83da-7a9d08cc98d2",
                                        "entry_id": "992c9b83-7d0e-3035-ae84-cbd83df6efd5",
                                        "glosses": [
                                            "A member of a governing council in other states in the ancient world."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "10ed33a7-a235-3ee1-b8b6-ff15196666e5",
                                        "entry_id": "992c9b83-7d0e-3035-ae84-cbd83df6efd5",
                                        "glosses": [
                                            "A member of the ruler’s council or governing council in general, a leading statesman."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3de7b1e3-e351-481f-9136-ec81a695ca13",
                                                "sense_id": "10ed33a7-a235-3ee1-b8b6-ff15196666e5",
                                                "text": "Both we will raigne as Conſuls of the earth,\nAnd mightie kings ſhall be our Senators."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf9120f3-ee16-3816-9c3c-800c95d2f06f",
                                        "entry_id": "992c9b83-7d0e-3035-ae84-cbd83df6efd5",
                                        "glosses": [
                                            "An important church official."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9a818395-b7df-354b-9f2a-7012a89df0b8",
                                        "entry_id": "992c9b83-7d0e-3035-ae84-cbd83df6efd5",
                                        "glosses": [
                                            "In Germany, a minister of the executive branch of government in the city states of Berlin, Bremen, and Hamburg; and a government official of cities that were part of the Hanseatic League."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6ee47057-d8b6-45fa-8fc7-5e59b660faa8",
                        "source_entry_id": "5a200d31-7c35-3e65-824d-337e1e8f5249",
                        "source_sense_id": "643ece45-ba4c-3c64-9ee0-b1c3069dadfe",
                        "source_sense_description": "Membre d’un sénat",
                        "target_lang_word": "senatrix",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "senatrix",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9d79bb4f-7724-3811-a768-28c8be3d91ab",
                                        "entry_id": "1b06616c-547d-33ab-bd35-938d9c32382c",
                                        "glosses": [
                                            "A female senator (a female member of a senate)"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa70ba60-d866-4300-b8a4-f7410e8ca861",
                                                "sense_id": "9d79bb4f-7724-3811-a768-28c8be3d91ab",
                                                "text": "The Federal elections, for which women were entitled to stand as senatorial candidates, had come previously, though old prejudice had been too strong to the extent of many votes to grasp that a woman might really be a senatrix, and that a vote cast for her would not be wasted, still one woman candidate had polled 51,597 votes […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22ee8cdf-2c8e-390c-a737-ae23485f9ee9",
                                        "entry_id": "1b06616c-547d-33ab-bd35-938d9c32382c",
                                        "glosses": [
                                            "Traditionally used as a term of address for a female senator in parliamentary proceedings in some Senates like those of the United States, Canada and France ."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1ddbc79-2205-4639-9f4c-76a68cbc1a2b",
                                                "sense_id": "22ee8cdf-2c8e-390c-a737-ae23485f9ee9",
                                                "text": "Mrs. CARAWAY of Arkansas. Mr. President, will the distinguished gentleman from Pennsylvania yield to a few questions?\nMr. REED of Pennsylvania. I yield to the Senatrix from Arkansas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41a35037-41ce-379b-97bb-10e66b93724d",
                                        "entry_id": "1b06616c-547d-33ab-bd35-938d9c32382c",
                                        "glosses": [
                                            "The wife of a senator."
                                        ],
                                        "tags": [
                                            "dated",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8938832d-78f0-4928-ab31-16e66f985cd4",
                                                "sense_id": "41a35037-41ce-379b-97bb-10e66b93724d",
                                                "text": "Theodora, beautiful, able, and shameless, was called the senatrix, the wife of the senator Theophylact, and the soul of that great, noble family and its dependents."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "70a675c1-b6f0-4e37-ac3c-5a070823906d",
                        "source_entry_id": "5a200d31-7c35-3e65-824d-337e1e8f5249",
                        "source_sense_id": "643ece45-ba4c-3c64-9ee0-b1c3069dadfe",
                        "source_sense_description": "Membre d’un sénat",
                        "target_lang_word": "senatress",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "senatress",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e0b80525-fc4b-3364-889d-750833daef08",
                                        "entry_id": "c5844810-0264-3907-b3b1-e05bb705dd36",
                                        "glosses": [
                                            "A female senator."
                                        ],
                                        "tags": [
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b92665fd-5d82-4a78-82a8-ea4418bf493e",
                                                "sense_id": "e0b80525-fc4b-3364-889d-750833daef08",
                                                "text": "Heliogabalus introduced his Mother into the Senate, and she took her Place there by the Seats of the Consuls, and was present at passing a Decree of the Senate. This Emperor made the first Senatress; he created a little Senate of Women, which met on Collis Quirinalis under the Direction of Semiamira, and the Laws they made concerning the Ladies, ...."
                                            },
                                            {
                                                "example_id": "c3413ae0-b9ab-452c-8e60-8dadf3260926",
                                                "sense_id": "e0b80525-fc4b-3364-889d-750833daef08",
                                                "text": "The researches of the learned Coppi make it almost certain that the Colonna descend from Theodora, the Senatress of Roma, who flourished in the year 914; ...."
                                            },
                                            {
                                                "example_id": "4a962305-1125-43a3-92d2-4a035dcad1ed",
                                                "sense_id": "e0b80525-fc4b-3364-889d-750833daef08",
                                                "text": "\"And I take pleasure in presenting to you a lady you all know, State Senator Rumbley—or is it Senatress?\""
                                            },
                                            {
                                                "example_id": "8564d593-1b18-462c-a4e2-2886742cc4f2",
                                                "sense_id": "e0b80525-fc4b-3364-889d-750833daef08",
                                                "text": "\"If I said the lady was an elected representative of the US people, with strange political notions and strong presidential ambitions, would that help?\" I whistled softly. \"You mean the senatress, herself?\""
                                            },
                                            {
                                                "example_id": "1e47d0b3-f7cc-4076-8cab-bc8cb63b6bcf",
                                                "sense_id": "e0b80525-fc4b-3364-889d-750833daef08",
                                                "text": "This scandal resulted in the intervention by a US congresswoman and future US senatress (as she preferred to be called) and vice president of the United States of America ...."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
