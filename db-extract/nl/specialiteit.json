                                                "sense_id": "1cb0b68e-4966-397f-b4ba-89145fcf6f68",
                                                "text": "Die Weißwurst ist eine typische bayerische Spezialität."
                                            },
                                            {
                                                "example_id": "d045fcad-f7e9-4db8-b312-b064c0c24653",
