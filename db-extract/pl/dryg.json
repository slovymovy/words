                "senses": [
                    {
                        "sense_id": "544444f8-c10d-3572-b65c-f4a34b650066",
                        "entry_id": "7c30da3e-d685-388d-8267-c2e48397127b",
                        "glosses": [
                            "zwykle w zwrocie „mieć dryg do czegoś” – mieć do czegoś skłonność, talent do robienia czegoś"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "f2c6338d-a535-4130-8392-bf23571ffe08",
                                "sense_id": "544444f8-c10d-3572-b65c-f4a34b650066",
                                "text": "Kocha łowić ryby i ma do tego niesamowity dryg"
                            },
                            {
                                "example_id": "a9bbb155-30f0-4726-b0e4-ff65eebc81e9",
                                "sense_id": "544444f8-c10d-3572-b65c-f4a34b650066",
                                "text": "– Biedna dziewczyna… Ani w pracy się jej nie układało, bo nie miała drygu do niemieckiego…"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f4ac844c-e889-46f9-b9e0-2f39e5caaa9e",
                        "source_entry_id": "7c30da3e-d685-388d-8267-c2e48397127b",
                        "source_sense_id": "544444f8-c10d-3572-b65c-f4a34b650066",
                        "target_lang_word": "knack",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "knack",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "779c753b-c2f1-3e65-be9b-d8992c60901e",
                                        "entry_id": "656a6b39-f11e-3b48-be65-0b34193ea9a5",
                                        "glosses": [
                                            "A readiness in performance; aptness at doing something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1f7a0b8-b4ee-47f6-9b1a-83dd7d39034d",
                                                "sense_id": "779c753b-c2f1-3e65-be9b-d8992c60901e",
                                                "text": "These men had some uncanny knack of knowing when the steel was right, and like many such things, it just could not be put into a textbook on the subject."
                                            },
                                            {
                                                "example_id": "8d5d4e8e-1690-4e88-9e01-8129c79f65ff",
                                                "sense_id": "779c753b-c2f1-3e65-be9b-d8992c60901e",
                                                "text": "The sophist runs for cover to the darkness of what is not and attaches himself to it by some knack of his;"
                                            },
                                            {
                                                "example_id": "fea0ce26-af57-4e38-b2fb-d3557e351796",
                                                "sense_id": "779c753b-c2f1-3e65-be9b-d8992c60901e",
                                                "text": "And the Premier League's all-time top-goalscoring midfielder proved he has not lost the knack of being in the right place at the right time with a trio of clinical finishes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c10bc239-add3-3c44-8bab-ce3cb5088981",
                                        "entry_id": "656a6b39-f11e-3b48-be65-0b34193ea9a5",
                                        "glosses": [
                                            "A petty contrivance; a toy."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "01c543ca-efe9-38b0-a7fe-4fe6922b3f97",
                                        "entry_id": "656a6b39-f11e-3b48-be65-0b34193ea9a5",
                                        "glosses": [
                                            "Something performed, or to be done, requiring aptness and dexterity."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "knack",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1e92c826-8c5b-3eca-af58-ebc193852dd1",
                                        "entry_id": "8bb287c8-283d-31b0-803b-1d70cf88b461",
                                        "glosses": [
                                            "To crack; to make a sharp, abrupt noise; to chink."
                                        ],
                                        "tags": [
                                            "UK",
                                            "dialectal",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c5c057e-7772-4240-98f3-937234e1f100",
                                                "sense_id": "1e92c826-8c5b-3eca-af58-ebc193852dd1",
                                                "text": "If they hear the Beads knack upon each other, that's enough."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7383943f-2885-3ab9-b14b-6f65c19d2216",
