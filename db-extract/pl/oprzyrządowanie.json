                    },
                    {
                        "translation_id": "a7e25d8f-8208-4b2a-93aa-4370a02d1421",
                        "source_entry_id": "23c6b4d7-1597-3521-8fb9-c4df4617cee4",
                        "source_sense_id": "7f69ab2b-3e6d-311e-943e-c596ba0c012d",
                        "target_lang_word": "εξοπλισμός",
                        "target_lang_code": "el",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "εξοπλισμός",
                                "target_lang_code": "el",
                                "target_senses": [
                                    {
                                        "sense_id": "107e3e74-1b0f-3595-801f-d1f852625d9a",
                                        "entry_id": "1e99957a-42e6-3e64-996e-b8fc84c3469d",
                                        "glosses": [
                                            "ο εφοδιασμός με όπλα, με πολεμικό υλικό"
                                        ],
                                        "tags": [
                                            "στρατιωτικός όρος"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c208a1b6-efc9-4f46-affa-231db7162524",
                                                "sense_id": "107e3e74-1b0f-3595-801f-d1f852625d9a",
                                                "text": "Aγορά νέων όπλων για εξοπλισμό του στρατού μας."
                                            },
                                            {
                                                "example_id": "575ff223-1627-49b6-a5b9-a5d8698027bb",
                                                "sense_id": "107e3e74-1b0f-3595-801f-d1f852625d9a",
                                                "text": "※ Ο εργολάβος, αφού συμβουλεύτηκε το φασαριόζικο μηχάνημά του, που με τα διαολεμένα επαναλαμβανόμενα βουητά του σε έκανε να σκέφτεσαι ότι κάτω από τα πόδια σου κρύβεται ολόκληρος λόχος με τον εξοπλισμό του, υπέδειξε με την ίδια βεβαιότητα νέο σημείο λίγα μέτρα πιο πέρα. (Κωνσταντίνος Τζαμιώτης, Θα πέσει η νύχτα, εκδ. Μεταίχμιο, 2025)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bab885bb-53be-34f7-a17d-094ee96bcb1a",
                                        "entry_id": "1e99957a-42e6-3e64-996e-b8fc84c3469d",
                                        "glosses": [
                                            "τα διαθέσιμα οπλικά συστήματα, το σύνολο του πολεμικού υλικού"
                                        ],
                                        "tags": [
                                            "στρατιωτικός όρος"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32f910b1-5120-49d5-8ec1-f689119acbfc",
                                                "sense_id": "bab885bb-53be-34f7-a17d-094ee96bcb1a",
                                                "text": "χώρες με πυρηνικό εξοπλισμό"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0499bca5-051f-3c70-a65e-fdc6d47ebd06",
                                        "entry_id": "1e99957a-42e6-3e64-996e-b8fc84c3469d",
                                        "glosses": [
                                            "ο εφοδιασμός με τα κατάλληλα εργαλεία, εξαρτήματα, μηχανήματα, όργανα"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec687934-b71f-4550-818a-b9dea69905b8",
                                                "sense_id": "0499bca5-051f-3c70-a65e-fdc6d47ebd06",
                                                "text": "H κατασκευή του νοσοκομείου τελείωσε δεν έχει όμως ακόμα αρχίσει ο εξοπλισμός του."
                                            },
                                            {
