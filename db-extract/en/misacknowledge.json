                        "glosses": [
                            "To fail to acknowledge; to acknowledge wrongly."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "03ae8bff-1590-4b79-9175-3492b68aa364",
                                "sense_id": "08b74b9d-aec9-3f0b-88d8-962b40149e5f",
                                "text": "I saw him at Ferrara, in so pitteous a plight[…]; misacknowledging [translating mesconnoissant] both himselfe and his labours, which unwitting to him, and even to his face, have been published both uncorrected and maimed."
                            },
                            {
                                "example_id": "c6e959b3-883b-4b38-ad5b-2a06dd892efc",
                                "sense_id": "08b74b9d-aec9-3f0b-88d8-962b40149e5f",
                                "text": "How many do I ordinarily see that mis-acknowledge poverty; how many that wish for death or that pass it without any alarm or affliction?"
                            }
                        ]
                    }
