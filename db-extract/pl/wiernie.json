                    },
                    {
                        "translation_id": "73cf447d-0581-46ae-8bf4-7f9242946a8b",
                        "source_entry_id": "ff693fe2-da16-377d-aa45-c00507e8c2ed",
                        "source_sense_id": "c52fe7f7-0b0d-33ae-9726-5cced6a2d0dc",
                        "target_lang_word": "accurately",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "accurately",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d4a7ed62-20f0-381e-9407-c03fd22795ba",
                                        "entry_id": "5714ac9a-b2d1-3f2f-9a20-e166006e363c",
                                        "glosses": [
                                            "In an accurate manner; exactly; precisely; without error or defect."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2fb62c5e-bfb5-4ab5-9160-bdbc6ba8ea2a",
                                                "sense_id": "d4a7ed62-20f0-381e-9407-c03fd22795ba",
                                                "text": "For much of the 20th century, the image of Mexico popularized abroad through film, music, art and literature was, more accurately, a portrayal of Jalisco state and especially its capital, Guadalajara."
                                            },
                                            {
                                                "example_id": "3994bca5-218b-4916-9ce5-dd1a8af94af5",
                                                "sense_id": "d4a7ed62-20f0-381e-9407-c03fd22795ba",
                                                "text": "The internal NES clock must accurately measure down to milliseconds for its games to work properly."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c5b83227-b72b-4b99-88cc-2542bf36a15d",
                        "source_entry_id": "ff693fe2-da16-377d-aa45-c00507e8c2ed",
                        "source_sense_id": "c52fe7f7-0b0d-33ae-9726-5cced6a2d0dc",
                        "target_lang_word": "minutieusement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "minutieusement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4ae0daaf-ec84-3cc1-b8f6-de3274b2cad2",
                                        "entry_id": "66ec79a3-2344-3e83-97e6-809aa3e35f54",
                                        "glosses": [
                                            "D’une manière minutieuse ; avec minutie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f4bcece-3dde-4d40-aed4-b21508157515",
                                                "sense_id": "4ae0daaf-ec84-3cc1-b8f6-de3274b2cad2",
                                                "text": "Gervaise venait de poser le bonnet de madame Boche sur un champignon garni d'un linge, et en tuyautait les dentelles minutieusement au petit fer."
                                            },
                                            {
                                                "example_id": "fd3e0125-2b86-457f-8e66-3d4fe0572e7e",
                                                "sense_id": "4ae0daaf-ec84-3cc1-b8f6-de3274b2cad2",
                                                "text": "Le vétérinaire surveille aussi minutieusement l’application du dahir du 4 août 1914 interdisant l’abatage pour le boucher des femelles de l'espèce bovine avant l’âge de huit ans et de celles des espèces ovine et caprine avant cinq ans."
                                            },
                                            {
                                                "example_id": "5554c97d-6ad9-4054-a867-80ba3968964d",
                                                "sense_id": "4ae0daaf-ec84-3cc1-b8f6-de3274b2cad2",
                                                "text": "Au jour, j'inspecte minutieusement les avaries et consolide les réparations provisoires de la nuit."
                                            },
                                            {
                                                "example_id": "92b9670f-28a8-4e77-aeef-45cb6b5c0028",
                                                "sense_id": "4ae0daaf-ec84-3cc1-b8f6-de3274b2cad2",
                                                "text": "Les prescriptions les plus importantes de ce décret visent la prévention de la maladie dite « maladie des caissons » et réglementent très minutieusement la durée de la compression et de la décompression, c’est-à-dire le temps employé par les tubistes pour s’écluser ou se désécluser."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "231dcd18-59c1-4064-a1d2-999d3604a2f7",
                        "source_entry_id": "ff693fe2-da16-377d-aa45-c00507e8c2ed",
                        "source_sense_id": "c52fe7f7-0b0d-33ae-9726-5cced6a2d0dc",
                        "target_lang_word": "exactement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exactement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5ecd47fd-68f1-313b-a51d-8ecc3f41d123",
                                        "entry_id": "01566817-f387-3b39-af91-16e1865f2c14",
                                        "glosses": [
                                            "D’une manière exacte, correctement précise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f971e597-a2cc-4203-b07c-7c571055cd29",
                                                "sense_id": "5ecd47fd-68f1-313b-a51d-8ecc3f41d123",
                                                "text": "Comme toutes les réformes monétaires, la stabilisation de la monnaie allemande a provoqué une crise économique, ou plus exactement, elle n'a pas suffi à en préserver le Reich."
                                            },
                                            {
                                                "example_id": "0344f036-230e-40be-a83b-4145a656978f",
                                                "sense_id": "5ecd47fd-68f1-313b-a51d-8ecc3f41d123",
                                                "text": "Par contre nous nous sommes attaché à représenter l’orographie et l’hydrographie de la région aussi exactement qu'il nous a été possible de le faire."
                                            },
                                            {
                                                "example_id": "5c190caa-5cc0-45cb-839a-c49f7835f7a6",
                                                "sense_id": "5ecd47fd-68f1-313b-a51d-8ecc3f41d123",
                                                "text": "Elle ne sait pas exactement ce qu’elle veut, mais elle sait très bien ce qu’elle refuse : retourner à Aix et devenir la parfaite épouse d’un pinardier."
                                            },
                                            {
                                                "example_id": "d19daa0a-0d3f-4630-824f-9944d355baf9",
                                                "sense_id": "5ecd47fd-68f1-313b-a51d-8ecc3f41d123",
                                                "text": "Pour moi, monseigneur, qui vous connais jusque dans l’âme, et qui sais combien exactement vous vous acquittez de tous les devoirs de toutes sortes d’amitiés."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c4c13580-efc2-41f0-844c-c50243d3fe5a",
                        "source_entry_id": "ff693fe2-da16-377d-aa45-c00507e8c2ed",
                        "source_sense_id": "c52fe7f7-0b0d-33ae-9726-5cced6a2d0dc",
                        "target_lang_word": "au juste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "au juste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1e722d67-226e-3364-9bfb-5a28922df9d3",
                                        "entry_id": "40d4faf2-9623-3424-bced-0beaddf61c5f",
                                        "glosses": [
                                            "Justement et précisément. Il se dit du prix, du nombre, du poids et de la mesure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d76713c-9f82-4a5d-9a79-28ad367cb15f",
                                                "sense_id": "1e722d67-226e-3364-9bfb-5a28922df9d3",
                                                "text": "Quelle fut, au juste, la sentence rendue par l'Official ? Les biographes nous racontent qu'il n'y en eut pas, […]."
                                            },
                                            {
                                                "example_id": "a77a3730-ed8e-48fa-9bfe-f40e23f0314c",
                                                "sense_id": "1e722d67-226e-3364-9bfb-5a28922df9d3",
                                                "text": "Bizarre destinée, celle qui, à seize ans, sans que j’aie su au juste pourquoi, a décidé un jour que je me préparerais à Saint-Cyr, a fait de moi le camarade d’André de Saint-Avit."
                                            },
                                            {
                                                "example_id": "f8676ec6-ffa8-4cf0-a1c5-7f38dc1e0bdd",
                                                "sense_id": "1e722d67-226e-3364-9bfb-5a28922df9d3",
                                                "text": "J'allai voir qui c'était, au juste, persuadée que Simon, lui, n'aurait pas frappé, bien sûr, parce qu'il était chez lui, outre le fait qu'il avait les clefs."
                                            },
                                            {
                                                "example_id": "5707294a-2583-4370-a5c0-9df2bd772a7d",
                                                "sense_id": "1e722d67-226e-3364-9bfb-5a28922df9d3",
                                                "text": "Où veux-tu en venir au juste, Ivo ?"
                                            },
                                            {
                                                "example_id": "1885d942-f1b0-4415-aaad-96eb7634fed6",
                                                "sense_id": "1e722d67-226e-3364-9bfb-5a28922df9d3",
                                                "text": "Le philosophe doit éviter les ambiguïtés ou les plurivocités, et décider du langage qu'il entend au juste parler. Dans le cas contraire, les portes sont grandes ouvertes aux malentendus."
                                            },
                                            {
                                                "example_id": "9100c693-f49d-440a-9cdb-a019701acd11",
                                                "sense_id": "1e722d67-226e-3364-9bfb-5a28922df9d3",
                                                "text": "– On parle d’indigènes ! rectifia Le Bihan. Au nom du ciel, à quoi tu joues, Gaby ?\n– D’indigènes ? Et alors, ça veut dire quoi au juste, ne sommes-nous pas tous des indigènes ? Voire des dégénérés de basse extraction d’après Marsaud…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6fd8e49e-be62-49b9-bbf7-ce7c193d1822",
                        "source_entry_id": "ff693fe2-da16-377d-aa45-c00507e8c2ed",
                        "source_sense_id": "c52fe7f7-0b0d-33ae-9726-5cced6a2d0dc",
                        "target_lang_word": "justement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "justement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fcdf97df-fd4f-38c2-98a9-41021890dc90",
                                        "entry_id": "63511c68-1d15-3282-8ec9-bbc5e0f13dc3",
                                        "glosses": [
                                            "Avec justice."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fcfdf7cf-b3a7-4dda-a5ec-4bdaadd4b6e5",
                                                "sense_id": "fcdf97df-fd4f-38c2-98a9-41021890dc90",
                                                "text": "Il a jugé justement. - Il a agi justement. - Il a été puni justement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5b8898a-8fad-383e-b1dc-b5b761fd3aa4",
                                        "entry_id": "63511c68-1d15-3282-8ec9-bbc5e0f13dc3",
                                        "glosses": [
                                            "Dans la juste proportion, ni plus ni moins qu’il ne faut, précisément."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41b964de-d242-45bb-b5b4-759a4978841c",
                                                "sense_id": "d5b8898a-8fad-383e-b1dc-b5b761fd3aa4",
                                                "text": "Voilà justement ce qui vous manque. - Vous arrivez justement à l’heure qu’il faut. - C’est justement cette explication que je désirais."
                                            },
                                            {
                                                "example_id": "16696b34-3806-4730-a847-a630141dea51",
                                                "sense_id": "d5b8898a-8fad-383e-b1dc-b5b761fd3aa4",
                                                "text": "Gisèle me demanda où elle pourrait la trouver, car elle avait justement quelque chose à lui dire. « Quoi donc ? — Des choses qui se rapportent à de petites camarades à elle. — Quelles camarades ? Je pourrai peut-être vous renseigner, ce qui ne vous empêchera pas de la voir. — Oh ! des camarades d’autrefois, je ne me rappelle pas les noms », répondit Gisèle d’un air vague, en battant en retraite. Elle me quitta, croyant avoir parlé avec une prudence telle que rien ne pouvait me paraître que très clair. Mais le mensonge est si peu exigeant, a besoin de si peu de chose pour se manifester ! S’il s’était agi de camarades d’autrefois, dont elle ne savait même pas les noms, pourquoi aurait-elle eu « justement » besoin d’en parler à Albertine ? Cet adverbe, assez parent d’une expression chère à Mme Cottard : « cela tombe à pic », ne pouvait s’appliquer qu’à une chose particulière, opportune, peut-être urgente, se rapportant à des êtres déterminés."
                                            },
                                            {
                                                "example_id": "618350c8-1318-452e-a4a8-7b0fc55ff050",
                                                "sense_id": "d5b8898a-8fad-383e-b1dc-b5b761fd3aa4",
                                                "text": "— Tu veux que je téléphone de la cabine qui est en bas ? J’ai remarqué que, de la salle, on entend tout ce qui se dit…\n— Justement !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ba8554e-7011-365a-97ce-f671de966882",
                                        "entry_id": "63511c68-1d15-3282-8ec9-bbc5e0f13dc3",
                                        "glosses": [
                                            "Qualifie qu'on vient de parler de telle ou telle chose/personne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36141ce3-e041-49e8-8456-1222f19c3d4c",
                                                "sense_id": "4ba8554e-7011-365a-97ce-f671de966882",
                                                "text": "Actuellement, l'équipe travaille beaucoup et de façon intense sur l'amélioration de l’Académie Français Authentique, dont Tom fait partie justement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2ebe26d6-5ea7-4d1f-ac3c-e7f5e100a904",
                        "source_entry_id": "ff693fe2-da16-377d-aa45-c00507e8c2ed",
                        "source_sense_id": "c52fe7f7-0b0d-33ae-9726-5cced6a2d0dc",
                        "target_lang_word": "précisément",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "précisément",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "13fbd406-21a6-3675-aea8-ec64e5a57945",
                                        "entry_id": "8234c244-0c69-3023-8d83-f8fd6784f089",
                                        "glosses": [
                                            "Avec précision ; exactement ; au plus juste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1aef0909-b832-40e9-bdf6-54e32d80c77d",
                                                "sense_id": "13fbd406-21a6-3675-aea8-ec64e5a57945",
                                                "text": "Le pauvre homme vivotait dans un chaos d’innovations continuelles et acharnées, en un endroit précisément où ces innovations s’effectuaient ostensiblement et impitoyablement."
                                            },
                                            {
                                                "example_id": "45d9e97f-f817-44c2-a97c-ef843bb1de8e",
                                                "sense_id": "13fbd406-21a6-3675-aea8-ec64e5a57945",
                                                "text": "Dans le passage de l’oral à l’écrit, la spécificité du messager s’efface derrière celle du message. Peut-être y perd-on en spontanéité, mais on y gagne en cohérence, celle précisément d’une forme littéraire."
                                            },
                                            {
                                                "example_id": "7007f738-68eb-4e1a-929f-d6cd8b154788",
                                                "sense_id": "13fbd406-21a6-3675-aea8-ec64e5a57945",
                                                "text": "Pourvu que ceux que nous faisons parler se soient connus…. nous ne sommes pas obligés à nous attacher si précisément à la durée de leur vie,"
                                            },
                                            {
                                                "example_id": "bcedb2a2-153e-406c-b5f2-23f981ce033c",
                                                "sense_id": "13fbd406-21a6-3675-aea8-ec64e5a57945",
                                                "text": "Il n'y a presque personne qui ne pense plutôt à ce qu’il veut dire qu’à répondre précisément à ce qu’on lui dit,"
                                            },
                                            {
                                                "example_id": "fb698b01-f288-45a8-8592-bfb5c8b8b800",
                                                "sense_id": "13fbd406-21a6-3675-aea8-ec64e5a57945",
                                                "text": "Nous fîmes bien précisément ce que nous avions résolu,"
                                            },
                                            {
                                                "example_id": "33dd2bb6-86dc-4ac4-b6b6-ff23ccf88495",
                                                "sense_id": "13fbd406-21a6-3675-aea8-ec64e5a57945",
                                                "text": "Vouloir et agir, c’est précisément la même chose qu’être libre,"
                                            },
                                            {
                                                "example_id": "b3f9d641-f067-4ff4-a66e-6fd70f4d7c24",
                                                "sense_id": "13fbd406-21a6-3675-aea8-ec64e5a57945",
                                                "text": "C'est précisément parce qu’on est riche, qu’on se vend plus cher, quand on fait tant que de se vendre,"
                                            },
                                            {
                                                "example_id": "a87b8d29-ba1c-497b-abab-b54237734330",
                                                "sense_id": "13fbd406-21a6-3675-aea8-ec64e5a57945",
                                                "text": "Pendant les répétitions, il a fait des raccords, ajouté des béquets, et aussi pratiqué des coupures qui ont précisément pour but de lui rendre ce public indulgent et favorable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "414afb98-428b-3c75-9972-6bafeb73df7c",
                                        "entry_id": "8234c244-0c69-3023-8d83-f8fd6784f089",
                                        "glosses": [
                                            "Véritablement ; réellement."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b0fe7ea4-5419-3e7f-aabd-55eb06235310",
                                        "entry_id": "8234c244-0c69-3023-8d83-f8fd6784f089",
                                        "glosses": [
                                            "Oui, c’est cela."
                                        ],
                                        "tags": [
                                            "ellipsis",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "915d6724-e3db-48cb-83ab-a504ed7f6d50",
                                                "sense_id": "b0fe7ea4-5419-3e7f-aabd-55eb06235310",
                                                "text": "— Le chevalier : Je parie que ce rival redoutable, c’est Volsain.\n — La comtesse : Précisément."
                                            },
                                            {
                                                "example_id": "493f4cd6-dd00-4262-8b6d-e9107cb2bd1b",
                                                "sense_id": "b0fe7ea4-5419-3e7f-aabd-55eb06235310",
                                                "text": "Précisément, reprit Timante ; celui que je propose est ce qui vous convient."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4e56597f-8dfb-4521-a3e1-21969f28b0fb",
                        "source_entry_id": "ff693fe2-da16-377d-aa45-c00507e8c2ed",
                        "source_sense_id": "c52fe7f7-0b0d-33ae-9726-5cced6a2d0dc",
                        "target_lang_word": "fidèlement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fidèlement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8c911303-3e8b-3a83-8a63-108e77aa5d7c",
                                        "entry_id": "0a417694-f1f0-3c11-8712-1071a03b99a3",
                                        "glosses": [
                                            "D’une manière fidèle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44026dd7-a966-45c6-b9d2-e29e36b4af03",
                                                "sense_id": "8c911303-3e8b-3a83-8a63-108e77aa5d7c",
                                                "text": "Une de vos amies vous dira que je suis le meilleur garçon du monde, et que, pour aimer en cinq ou six lieux à la fois, il n'y a personne qui le fasse si fidèlement que moi."
                                            },
                                            {
                                                "example_id": "95c9c99e-9368-41ff-ae6f-d90b0268a505",
                                                "sense_id": "8c911303-3e8b-3a83-8a63-108e77aa5d7c",
                                                "text": "Dans tous mes maux, je me suis encore conservé ma mémoire tout entière ; et je crois qu’elle me servira fidèlement quand ce sera pour vous, puisque vous y avez autant de part que personne."
                                            },
                                            {
                                                "example_id": "973cb66c-c9d3-463e-ac25-76683f3116bd",
                                                "sense_id": "8c911303-3e8b-3a83-8a63-108e77aa5d7c",
                                                "text": "Les petits esprits [les sympathies] se sont bien communiqués, et sont passés bien fidèlement de Livry en Provence."
                                            },
                                            {
                                                "example_id": "db0a4f2f-857e-4eae-b142-d238c79cd211",
                                                "sense_id": "8c911303-3e8b-3a83-8a63-108e77aa5d7c",
                                                "text": "Au culte des autels nos vierges destinées Gardent fidèlement le dépôt précieux."
                                            },
                                            {
                                                "example_id": "b65d25fc-cba8-4e8d-b7da-3eca47e8b478",
                                                "sense_id": "8c911303-3e8b-3a83-8a63-108e77aa5d7c",
                                                "text": "Qu’elle soit cependant fidèlement servie."
                                            },
                                            {
                                                "example_id": "1e1d4000-328d-44bc-bec9-e01f28b8b313",
                                                "sense_id": "8c911303-3e8b-3a83-8a63-108e77aa5d7c",
                                                "text": "Encore une fois, le comte de Boulainvilliers a bien raison d’assurer qu’un jésuite ne peut écrire fidèlement l’histoire."
                                            },
                                            {
                                                "example_id": "04ff3cfb-9b2d-4984-966f-6706fa5048b4",
                                                "sense_id": "8c911303-3e8b-3a83-8a63-108e77aa5d7c",
                                                "text": "Il vit dans l’isolement, fidèlement servi par Bodrick, le majordome, tandis que son père, complètement fou, erre dans les couloirs du château en hurlant, nu."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
