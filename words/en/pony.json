                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "cheat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>ponied</w> his way through the Latin homework.",
                            "target_lang_translations": {
                                "ru": "Он сделал домашнее задание по латыни, <w>пользуясь шпаргалкой</w>.",
                                "zh": "他<w>用小抄</w>完成了拉丁语作业。"
                            }
                        },
                        {
                            "text": "It is better to learn the language than to <w>pony</w> on every assignment.",
                            "target_lang_translations": {
                                "ru": "Лучше выучить язык, чем <w>списывать</w> каждое задание.",
                                "zh": "学习语言比每次作业都<w>用小抄</w>要好。"
                            }
                        }
