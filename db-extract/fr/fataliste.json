        "fr-extract.jsonl": [
            {
                "entry_id": "95ce2c3e-b2b5-34ea-9ee7-c3f5e82f2e20",
                "word": "fataliste",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d508c6dd-88bb-4aa9-a6d7-8c58bea9c04e",
                        "entry_id": "95ce2c3e-b2b5-34ea-9ee7-c3f5e82f2e20",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "fatalistes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "77ce6f9d-f0c6-3acf-b11c-ac8e662fc6d2",
                        "entry_id": "95ce2c3e-b2b5-34ea-9ee7-c3f5e82f2e20",
                        "glosses": [
                            "Qui est un fataliste, qui croit au destin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "093fe235-0638-4372-9e9c-f2c3091b2466",
                                "sense_id": "77ce6f9d-f0c6-3acf-b11c-ac8e662fc6d2",
                                "text": "Pourquoi se courroucer ! c’est inutile et triste.\nMonsieur, pour être heureux, devenez fataliste."
                            },
                            {
                                "example_id": "ef5ca3df-f976-4b0b-8f9c-956552e2ecf5",
                                "sense_id": "77ce6f9d-f0c6-3acf-b11c-ac8e662fc6d2",
                                "text": "En cela, d’ailleurs, il obéissait à sa nature, et nous avons de bonnes raisons de croire qu’il était un peu fataliste, mais d’un fatalisme très orthodoxe, comptant sur lui, et même sur la Providence […]"
                            },
                            {
                                "example_id": "a8a1de5a-7886-466a-b885-373c88c21ed7",
                                "sense_id": "77ce6f9d-f0c6-3acf-b11c-ac8e662fc6d2",
                                "text": "Il est fataliste et peu confiant, dans un temps où « tout ce qui est vieux s’écroule et où il n’y a pas encore de neuf » ."
                            }
                        ]
                    },
                    {
                        "sense_id": "5f7b2659-e680-3b34-999d-c092896b2719",
                        "entry_id": "95ce2c3e-b2b5-34ea-9ee7-c3f5e82f2e20",
                        "glosses": [
                            "Qui concerne le fatalisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44c8f1f7-f7bc-49cf-a60d-6e1ea173b73d",
                                "sense_id": "5f7b2659-e680-3b34-999d-c092896b2719",
                                "text": "La mort subite de son unique sœur, deux ans plus tard, lui a inspiré la théorie fataliste des dates prédestinées de la mort, comme pour se consoler."
                            },
                            {
                                "example_id": "dc65df6a-9b24-4cda-ac02-67e9089daa64",
                                "sense_id": "5f7b2659-e680-3b34-999d-c092896b2719",
                                "text": "D’autres points communs rapprochent l’analyse de Pluquet de celle de Boullier : il vise le spinozisme comme le principal responsable de la diffusion de la doctrine fataliste au XVIIe et au XVIIIe siècle – […]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "87edba45-69af-4b0d-a553-ee1a759e281a",
                        "source_entry_id": "95ce2c3e-b2b5-34ea-9ee7-c3f5e82f2e20",
                        "target_lang_word": "fatalistic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fatalistic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "79422986-c0fb-32e4-a0dc-b6a305080878",
                                        "entry_id": "2649835e-122b-3d41-850f-8134dfb857da",
                                        "glosses": [
                                            "Of or pertaining to fatalism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a03d0c2-27db-4b4d-8b6d-e43bf40cb544",
                                                "sense_id": "79422986-c0fb-32e4-a0dc-b6a305080878",
                                                "text": "To forego life for a fantasy: What could be more fatalistic than that?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa117f00-6148-3294-a8c3-68d5abc87134",
                                        "entry_id": "2649835e-122b-3d41-850f-8134dfb857da",
                                        "glosses": [
                                            "Submissive to fate."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
            {
                "entry_id": "fb0b9940-6c76-3dbd-8803-bb00d384771f",
                "word": "fataliste",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ec175806-cd93-4acf-83cd-52ce951f058f",
                        "entry_id": "fb0b9940-6c76-3dbd-8803-bb00d384771f",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "fatalistes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2eba6a1c-7d08-3e64-8515-45d01bd04485",
                        "entry_id": "fb0b9940-6c76-3dbd-8803-bb00d384771f",
                        "glosses": [
                            "Personne qui professe le fatalisme, la fatalité, le destin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c378e8aa-a2dc-417a-b432-02183309858e",
                                "sense_id": "2eba6a1c-7d08-3e64-8515-45d01bd04485",
                                "text": "Et j’arrive ainsi au gros reproche dont on croit accabler les roamnciers naturalistes en les traitant de fatalistes. […] Comme le dit très bien Claude Bernard, du moment où nous pouvons agir, et où nous agissons sur le déterminisme des phénomènes, en modifiant les milieux par exemple, nous ne sommes pas des fatalistes."
                            }
                        ]
                    },
                    {
                        "sense_id": "902977e0-78ab-3e39-b70f-9445c3bd7f96",
                        "entry_id": "fb0b9940-6c76-3dbd-8803-bb00d384771f",
                        "glosses": [
                            "Personne qui accepte les événements comme ils surviennent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60df66d2-6481-44d7-96e7-f03ce4d6381d",
                                "sense_id": "902977e0-78ab-3e39-b70f-9445c3bd7f96",
                                "text": "Je le vois encore : il était garde-chasse chez Mme de La Valette, ancien soldat, et il semblait que sa vie n’eût d’autre but que d’exécuter une consigne. C’était, par excellence, un résigné, un fataliste, à la manière des paysans russes."
                            },
                            {
                                "example_id": "58e6caa5-c567-43b0-8403-4b753b27e3bf",
                                "sense_id": "902977e0-78ab-3e39-b70f-9445c3bd7f96",
                                "text": "Fataliste incurable, l’inspecteur Serdj marmotte des incantations."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f1ad8d29-8fe5-4e2e-a0d1-69b5caaa3080",
                        "source_entry_id": "fb0b9940-6c76-3dbd-8803-bb00d384771f",
                        "target_lang_word": "Fatalistin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
