                                "sense_id": "0153a5c5-dc6f-3e81-8e6e-6561ea14a554",
                                "text": "Het voorafgaande ongeluk heeft haar een trauma gegeven."
                            }
                        ]
                    },
                    {
                        "sense_id": "b581600d-66df-35f9-b4e7-fb615db06d68",
                        "entry_id": "ea368c82-018d-3638-9462-6e73a71bf817",
                        "glosses": [
