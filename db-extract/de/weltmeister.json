                "senses": [
                    {
                        "sense_id": "8f0fd66d-2d77-30c9-8040-f497bfcda2dc",
                        "entry_id": "190647a2-9380-3c9e-aee1-52bc436bc769",
                        "glosses": [
                            "Champion du monde."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7d48fdc-e866-4915-8dad-dc14e1dd3040",
                                "sense_id": "8f0fd66d-2d77-30c9-8040-f497bfcda2dc",
                                "text": "Die Seleção ist die Nummer eins der Welt. Sie hat die Südamerika-Qualifikation souverän gewonnen. Sie ist fünffacher Weltmeister.",
                                "translation": "La Seleção est le numéro un mondial. Elle a remporté haut la main les qualifications pour l'Amérique du Sud. Elle est quintuple championne du monde."
                            },
                            {
                                "example_id": "0dc7b36a-af42-40b2-afcd-f5405bc51762",
                                "sense_id": "8f0fd66d-2d77-30c9-8040-f497bfcda2dc",
                                "text": "Es ist wohl einer der kuriosesten Wettbewerbe – und gewonnen hat ihn ein Kanadier: Zachary Knowles ist Weltmeister im Luftgitarre-Spielen.",
                                "translation": "C'est sans doute l'un des concours les plus curieux - et c'est un Canadien qui l’a remporté : Zachary Knowles est champion du monde d'air guitar."
                            }
                        ]
                    }
                ],
