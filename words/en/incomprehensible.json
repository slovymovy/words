{
    "word_family": [
        "comprehend",
        "comprehension",
        "comprehensible",
        "incomprehensibility"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7fc3dea2-c809-3d6c-a897-70288fd3a5c9",
                    "sense_definition": "Impossible or very difficult to understand.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "understanding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professor's lecture was completely <w>incomprehensible</w> to the students.",
                            "target_lang_translations": {
                                "cs": "Přednáška profesora byla pro studenty naprosto <w>nesrozumitelná</w>."
                            }
                        },
                        {
                            "text": "His <w>incomprehensible</w> behavior left everyone feeling confused and frustrated.",
                            "target_lang_translations": {
                                "cs": "Jeho <w>nepochopitelné</w> chování zanechalo všechny zmatené a frustrované."
                            }
                        }
                    ],
                    "synonyms": [
                        "unintelligible",
                        "unfathomable",
                        "inexplicable"
                    ],
                    "antonyms": [
                        "comprehensible",
                        "understandable"
                    ],
                    "common_phrases": [
                        "utterly incomprehensible",
                        "completely incomprehensible"
                    ],
                    "target_lang_definitions": {
                        "cs": "Něco, co je nemožné nebo velmi obtížné pochopit či porozumět."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "nesrozumitelný",
                                "target_lang_sense_clarification": "vztahující se k něčemu, co nelze snadno pochopit nebo čemu není rozumět"
                            },
                            {
                                "target_lang_word": "nepochopitelný",
                                "target_lang_sense_clarification": "vztahující se k něčemu, co přesahuje lidské chápání nebo logiku"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "47ddc3c4-1914-3a90-a009-16541f4dfb3d",
                    "sense_definition": "Boundless or infinite in nature.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "understanding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>incomprehensible</w> vastness of the universe humbles the human spirit.",
                            "target_lang_translations": {
                                "cs": "<w>Nezměrná</w> rozlehlost vesmíru pokořuje lidského ducha."
                            }
                        },
                        {
                            "text": "Ancient texts often describe the divine as an <w>incomprehensible</w> force.",
                            "target_lang_translations": {
                                "cs": "Starověké texty často popisují božství jako <w>nepochopitelnou</w> sílu."
                            }
                        }
                    ],
                    "synonyms": [
                        "fathomless",
                        "infinite"
                    ],
                    "target_lang_definitions": {
                        "cs": "Nekonečný, nezměrný nebo přesahující lidské chápání svou velikostí či podstatou."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "nepochopitelný",
                                "target_lang_sense_clarification": "ve smyslu něčeho, co je příliš velké nebo složité na to, aby to bylo plně pochopeno"
                            },
                            {
                                "target_lang_word": "nezměrný",
                                "target_lang_sense_clarification": "ve smyslu něčeho, co je tak obrovské, že to nelze změřit nebo obsáhnout myslí"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "24a1cd17-d498-3694-aa83-856f1fa4e834",
                    "sense_definition": "Anything that is beyond human understanding.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "understanding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mysteries of quantum physics remain <w>incomprehensibles</w> to the average person.",
                            "target_lang_translations": {
                                "cs": "Záhady kvantové fyziky zůstávají pro běžného člověka <w>nepochopitelné</w>."
                            }
                        },
                        {
                            "text": "He tried to categorize the <w>incomprehensibles</w> of the ancient world.",
                            "target_lang_translations": {
                                "cs": "Pokusil se kategorizovat <w>nepochopitelné jevy</w> starověkého světa."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Věci nebo jevy, které jsou mimo lidské chápání."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "nepochopitelné věci",
                                "target_lang_sense_clarification": "substantivizované vyjádření pro jevy, které nelze rozumově vysvětlit"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}