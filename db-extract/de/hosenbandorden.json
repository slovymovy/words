                                "sense_id": "d4cd72c9-d8a4-3ab7-8023-e822df1954be",
                                "text": "„Prinz William ist seit Montag ein Ritter des Hosenbandordens.“"
                            },
                            {
                                "example_id": "90cb951d-85e4-4867-93de-7bfa5b21534d",
                                "sense_id": "d4cd72c9-d8a4-3ab7-8023-e822df1954be",
                                "text": "„Zur Uniform wird der Prinz den Stern und das Band tragen, die ihn als Ritter des Hosenbandordens ausweisen.“"
                            }
                        ],
