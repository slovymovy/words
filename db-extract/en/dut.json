                "senses": [
                    {
                        "sense_id": "9ec62b83-7e7f-3b61-8cc0-2b9a2bd18e71",
                        "entry_id": "ec977fa1-174f-3d36-8749-e7e2b72b6fff",
                        "glosses": [
                            "A snug woolly hat."
                        ],
                        "tags": [
                            "Geordie"
                        ],
                        "examples": [
                            {
                                "example_id": "07592a1d-2805-4046-9c75-3153e6aa0a1a",
                                "sense_id": "9ec62b83-7e7f-3b61-8cc0-2b9a2bd18e71",
                                "text": "There was a kid at our school called Dean Smith who used to wear a 'Benny Dut' to demonstrate how unfathomably stupid he is."
                            },
                            {
                                "example_id": "fabd7bc8-092b-42ba-ad39-6e1a15afa2d4",
                                "sense_id": "9ec62b83-7e7f-3b61-8cc0-2b9a2bd18e71",
                                "text": "The result is that I’m entering Ward Jackson Park, near Hartlepool Cricket Club, dressed in people shorts, comfy top – and traditional blue-and-white Pooly dut (for culture starved southerners, a woolly cap)."
                            },
                            {
                                "example_id": "695dfd7a-483d-414a-8805-5a0fd01225ef",
                                "sense_id": "9ec62b83-7e7f-3b61-8cc0-2b9a2bd18e71",
                                "text": "Grab your dut – we’re off for a trip down memory lane for a hot pork pie from Seaton Baths![…] These singing angels, pictured at a previous Hartlepool Christmas lights switch-on, are all kitted out in their duts (woolly hats) for winter."
                            }
                        ]
                    }
