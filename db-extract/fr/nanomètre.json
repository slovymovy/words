        "fr-extract.jsonl": [
            {
                "entry_id": "8078b8b9-b692-383a-b12f-a067454e6780",
                "word": "nanomètre",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6eaa6915-2491-422c-aa8c-3e551c3304db",
                        "entry_id": "8078b8b9-b692-383a-b12f-a067454e6780",
                        "tags": [
                            "plural"
                        ],
                        "form": "nanomètres"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5daa1902-4e0c-37bf-9238-9f66fef74e23",
                        "entry_id": "8078b8b9-b692-383a-b12f-a067454e6780",
                        "glosses": [
                            "Unité de mesure de longueur du Système international (SI), valant 10⁻⁹ mètre, et dont le symbole est nm."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "221d104f-7346-4a74-873d-8b036295aaaf",
                                "sense_id": "5daa1902-4e0c-37bf-9238-9f66fef74e23",
                                "text": "Il y a un milliard de nanomètres dans un mètre."
                            },
                            {
                                "example_id": "f48363a7-04b3-434e-b109-20fa89758192",
                                "sense_id": "5daa1902-4e0c-37bf-9238-9f66fef74e23",
                                "text": "Les particules élémentaires qui entrent en jeu à cette échelle de mesure ont des dimensions qui sont bien dessous du nanomètre."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "89ad9f86-329e-4066-9583-211b701a7abf",
                        "source_entry_id": "8078b8b9-b692-383a-b12f-a067454e6780",
                        "source_sense_id": "5daa1902-4e0c-37bf-9238-9f66fef74e23",
                        "source_sense_description": "Unité de mesure de longueur",
                        "target_lang_word": "nanometre",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nanometre",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cf33d7c5-a779-326b-b33a-d836e8e446e0",
                                        "entry_id": "bb8c19ec-d0a0-319d-9b90-9c6602f0c3a0",
                                        "glosses": [
                                            "An SI subunit of length equal to 10⁻⁹ metres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "920edb29-5c17-42eb-bfea-7725e5223a26",
                                                "sense_id": "cf33d7c5-a779-326b-b33a-d836e8e446e0",
                                                "text": "Holonyms: micrometre < millimetre < centimetre < decimetre < metre < kilometre < megametre < gigametre < terametre < petametre"
                                            },
                                            {
                                                "example_id": "1fdd5bb7-f7c3-4d3f-847d-78943794c575",
                                                "sense_id": "cf33d7c5-a779-326b-b33a-d836e8e446e0",
                                                "text": "Meronym: picometre"
                                            },
                                            {
                                                "example_id": "d5bd051f-1ffe-4d7e-ba7e-bca4737c2a3b",
                                                "sense_id": "cf33d7c5-a779-326b-b33a-d836e8e446e0",
                                                "text": "A nanometre is one billionth of a metre. A single atom is between a tenth to half a nanometre across; a million or more of them stacked on top of one another would equal the thickness of a piece of paper."
                                            },
                                            {
                                                "example_id": "69a8704a-1cba-4847-8bb8-dc9f613a1d0c",
                                                "sense_id": "cf33d7c5-a779-326b-b33a-d836e8e446e0",
                                                "text": "The resulting nanopasta is 372 nanometres thick, or about the same size as a measles virus."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cc2b3172-f7f1-454b-8e0a-467f752d2f9b",
                        "source_entry_id": "8078b8b9-b692-383a-b12f-a067454e6780",
                        "source_sense_id": "5daa1902-4e0c-37bf-9238-9f66fef74e23",
                        "source_sense_description": "Unité de mesure de longueur",
                        "target_lang_word": "nanometer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nanometer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6008e181-8bd2-3b6f-9350-b9d42f6baa83",
                                        "entry_id": "d5e414bd-5c09-379a-9f6d-960ebf04de68",
                                        "glosses": [
                                            "US spelling of nanometre."
                                        ],
                                        "tags": [
                                            "US",
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8aaed884-4bba-4daf-a841-31f1d8c9c1a5",
                                                "sense_id": "6008e181-8bd2-3b6f-9350-b9d42f6baa83",
                                                "text": "We live our lives in three dimensions for our threescore and ten allotted years. Yet every branch of contemporary science, from statistics to cosmology, alludes to processes that operate on scales outside of human experience: the millisecond and the nanometer, the eon and the light-year."
                                            },
                                            {
                                                "example_id": "9ce19228-dd4c-46de-bca3-cf3f2684c6d7",
                                                "sense_id": "6008e181-8bd2-3b6f-9350-b9d42f6baa83",
                                                "text": "Images also indicated that gel porosity was in the nanometer range, similar to previously characterized hyperporous beads generated using the same sol-gel methods, which limits mobility of encapsulated cells (Fig 2B ) [23 ]."
                                            },
                                            {
                                                "example_id": "342a69ca-61f4-4d49-bc3c-adfe16aa0fee",
                                                "sense_id": "6008e181-8bd2-3b6f-9350-b9d42f6baa83",
                                                "text": "It is noteworthy that biological phenomena occur at scales ranging from nanometers to megameters, and from nanoseconds to gigaannums."
                                            },
                                            {
                                                "example_id": "fdb09d75-0517-4709-ada0-ebd423fa885c",
                                                "sense_id": "6008e181-8bd2-3b6f-9350-b9d42f6baa83",
                                                "text": "The newest form of gold created in a lab is the thickness of two atoms, according to a new study. It’s only 0.47 nanometers thick, which is one million times thinner than a human finger nail."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "34be5e77-b206-4da6-b59c-282de77ba482",
                        "source_entry_id": "8078b8b9-b692-383a-b12f-a067454e6780",
                        "source_sense_id": "5daa1902-4e0c-37bf-9238-9f66fef74e23",
