                ],
                "translations": [
                    {
                        "translation_id": "1e538095-6671-4939-a02a-838726a49c1b",
                        "source_entry_id": "465f3e53-ed8b-39af-ac72-2c84bc5ee7eb",
                        "source_sense_id": "1df79b20-9d55-3879-a50f-31db783c025f",
                        "target_lang_word": "anachoretic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anachoretic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "085b4c6b-e047-3d7a-9fa3-ff0892d6a9b2",
                                        "entry_id": "766d6346-6d51-36bd-9e37-54a7d700a008",
                                        "glosses": [
                                            "Living in isolation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f770ae8-3204-451a-8337-f2d9d0ced333",
                                                "sense_id": "085b4c6b-e047-3d7a-9fa3-ff0892d6a9b2",
                                                "text": "Both the anachoretic and the missionary spirit were strong in the family of Penda; the former chiefly among the women, the latter among the men of the house: nearly all his children and grandchildren died in the odour of sanctity."
                                            },
                                            {
                                                "example_id": "67467bb4-f636-47a1-b39f-4159e373933c",
                                                "sense_id": "085b4c6b-e047-3d7a-9fa3-ff0892d6a9b2",
                                                "text": "No longer purely anachoretic or solitary, it begins, like the insect on the flower, to simulate the colour of that new social life from which it draws its own."
                                            },
                                            {
                                                "example_id": "7eda4939-2fad-4d50-9702-b709389725ee",
                                                "sense_id": "085b4c6b-e047-3d7a-9fa3-ff0892d6a9b2",
                                                "text": "Anachoretic behaviour is of two different kinds, permanent and temporary."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42870b0d-36bf-39ab-9717-bd05c7ab2180",
                                        "entry_id": "766d6346-6d51-36bd-9e37-54a7d700a008",
                                        "glosses": [
                                            "Pertaining to anachoresis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b9b5fd9-8ecd-4271-8212-eb238e1573cd",
                                                "sense_id": "42870b0d-36bf-39ab-9717-bd05c7ab2180",
                                                "text": "If a combination of micro-organisms is injected simultaneously, only one of the bacteria may be demonstrated in the anachoretic abscess."
                                            },
                                            {
                                                "example_id": "742586ef-9179-4f9c-b6eb-c4e5224fff94",
                                                "sense_id": "42870b0d-36bf-39ab-9717-bd05c7ab2180",
                                                "text": "Anachoresis, or anachoretic pulpitis, is, therefore, a pulpitis of systemic origin."
                                            },
                                            {
                                                "example_id": "a6c3c846-6484-4247-b997-2d5eabfd11d1",
                                                "sense_id": "42870b0d-36bf-39ab-9717-bd05c7ab2180",
                                                "text": "Anachoretic pulpitis was suggested as a reality by the work of Robinson and Boling in the early 1940's."
                                            },
                                            {
                                                "example_id": "7ecd1a68-ef00-4965-a3a8-cb1d56151cf5",
                                                "sense_id": "42870b0d-36bf-39ab-9717-bd05c7ab2180",
                                                "text": "The absence of other precipitating lesions was cited as evidence (by exclusion) for anachoretic infection in 51% of maxillary and 59% of mandibular cheek teeth."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
