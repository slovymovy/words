                "senses": [
                    {
                        "sense_id": "c201922e-151f-3570-b257-15ebd5481a66",
                        "entry_id": "08346af7-f7ec-34b0-beaa-2453b2babe68",
                        "glosses": [
                            "K.o.-Runde bei Fußball- Europa- und Weltmeisterschaften sowie anderen Fußballturnieren bei unentschiedenem Spielstand auch nach einer Verlängerung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3161637-d9f8-4a45-bddf-f9a1db504488",
                                "sense_id": "c201922e-151f-3570-b257-15ebd5481a66",
                                "text": "Lehmann hielt zwei Bälle im Elfmeterschießen (Fußballweltmeisterschaft 2006 in Deutschland)"
                            },
                            {
                                "example_id": "111159ad-e4fc-460d-9599-e29adf085ad5",
                                "sense_id": "c201922e-151f-3570-b257-15ebd5481a66",
                                "text": "„Die K.o.-Runden von Welt- oder Europameisterschaften sind die Blüte des Elfmeterschießens.“ (Quelle: Wikipedia, Artikel Strafstoß)"
                            },
                            {
                                "example_id": "4aa48d7a-b929-4bef-b7db-49afb5bf0531",
                                "sense_id": "c201922e-151f-3570-b257-15ebd5481a66",
                                "text": "T.F.: „Was hat Sie auf die Idee des Elfmeterschießens gebracht?“",
                                "translation": "(Auszüge aus einem Interview des deutschen Schiedsrichters Karl Wald (K.W.; geb. 1916), der 1970 das Elfmeterschießen erfunden hat. Das Interview führte Timo Frasch (T.F.) für die FAZ, F.A.Z., 03.07.2006, Nr. 151, Seite 36)"
                            },
                            {
                                "example_id": "eb68bc43-0132-4336-98b8-4937df2531d3",
                                "sense_id": "c201922e-151f-3570-b257-15ebd5481a66",
                                "text": "„Er pariert im Elfmeterschießen die Versuche von Ivan Klasnic und Hugo Almeida, der Oberligist erreicht die 2. Runde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
