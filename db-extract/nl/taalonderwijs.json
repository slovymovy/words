                                    {
                                        "sense_id": "4d53bd39-6d26-39ff-9d3f-bd61af341385",
                                        "entry_id": "9c69dadc-3a60-36f4-bc9f-ee339caa1118",
                                        "glosses": [
                                            "Unterricht in einer oder mehreren Sprachen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43fdb0a2-d716-4ce7-98ef-79eea9ae8f9d",
                                                "sense_id": "4d53bd39-6d26-39ff-9d3f-bd61af341385",
                                                "text": "„Von den Wegbereitern dieses Unterrichts seien Thomasius und Francke angeführt, weil sie jene beiden Richtungen präsentieren, die die Entwicklung des deutschen Sprachunterrichts im 18. Jahrhundert bestimmt haben.“"
                                            },
                                            {
                                                "example_id": "94528f5c-0945-4b62-bd33-7fcb7421c90b",
                                                "sense_id": "4d53bd39-6d26-39ff-9d3f-bd61af341385",
                                                "text": "„Zu Lämmerts akademischen Mentoren gehörte Richard Alewyn, ein prominenter Remigrant, der im Exil keine seiner Qualifikation entsprechende Stellung finden konnte und sich mit Sprachunterricht an einem Mädchencollege durchgebracht hatte…“"
                                            },
                                            {
                                                "example_id": "f18faa32-b444-4473-aed5-ee5cd08d1553",
                                                "sense_id": "4d53bd39-6d26-39ff-9d3f-bd61af341385",
                                                "text": "„Das lernt man schon im Sprachunterricht.“"
                                            },
                                            {
                                                "example_id": "71864f42-cc2a-4d87-83fa-62f77dda3679",
                                                "sense_id": "4d53bd39-6d26-39ff-9d3f-bd61af341385",
                                                "text": "„Die Frage, ob es sich um progressive Tendenzen in der Sprachentwicklung oder Sprachverfall handelt und inwieweit diese Erscheinungen ihren Platz im Sprachunterricht finden sollten, wurde dann zur Diskussion gestellt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
