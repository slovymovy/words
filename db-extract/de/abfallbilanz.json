                "senses": [
                    {
                        "sense_id": "32a5a296-a943-3838-a19d-8f7391b46d85",
                        "entry_id": "e96a6723-4035-337a-8746-83f070edc31c",
                        "glosses": [
                            "Auflistung des angefallenen Abfalls (in einem bestimmten Zeitraum)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2cfbc2c7-ec95-4bb0-971b-3e51331d3dcb",
                                "sense_id": "32a5a296-a943-3838-a19d-8f7391b46d85",
                                "text": "„Entweder wird durch Verfahrensumstellung (oder ein neues Verfahren mit neuen Anlagen) die Schadstoff- und Abfallbilanz der Produktion in ökologisch günstiger Weise verändert; oder man schaltet zu einer bestehenden Anlage eine weitere hinzu, welche die unerwünschten Nebenprodukte entweder in Inputs oder in vermarktbare Produkte umwandelt.“"
                            },
                            {
                                "example_id": "3d1c3267-54b2-4b51-94cf-8723dffd65bc",
                                "sense_id": "32a5a296-a943-3838-a19d-8f7391b46d85",
                                "text": "„Das Abfallwirtschaftskonzept beruht auf der Abfallbilanz und erstellt eine Prognose zur künftigen Entsorgungssicherheit nach dem Stand der Technik und der wirtschaftlichen Entwicklung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
