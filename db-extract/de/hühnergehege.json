                "senses": [
                    {
                        "sense_id": "70417252-8478-3902-9522-997a03b03093",
                        "entry_id": "9fcb034f-da1b-35f7-ac1c-fb0d02fc2682",
                        "glosses": [
                            "Gehege, in dem Hühner gehalten werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6b6e8ed-8225-4003-bd78-2485d8327c9f",
                                "sense_id": "70417252-8478-3902-9522-997a03b03093",
                                "text": "„Hinter einem Haus entdeckten wir ein Hühnergehege mit vielleicht zehn Hühnern, allesamt tot und verwesend; unter den Federn taten sich die Maden gütlich.“"
                            },
                            {
                                "example_id": "04285a82-0f8d-472d-b989-0f3b7631c1e4",
                                "sense_id": "70417252-8478-3902-9522-997a03b03093",
                                "text": "„Er überquerte einen Rasen, rannte durch die nächste Hecke und dann über einen schmalen Feldweg, an einem übelriechenden Hühnergehege vorbei, die Vögel flatterten und kreischten, weiter durch einen Hof, bis er vor einem Haus landete, wo ein Mann im Liegestuhl aus dem Nichts, in das er versunken war, aufblickte und sonderbar lächelte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
