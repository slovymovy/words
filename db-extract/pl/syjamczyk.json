                        "source_entry_id": "f3712e15-2eb8-34fa-9e61-6fccd64162ad",
                        "source_sense_id": "f1c86cbf-7753-350b-98c1-f41c6dfa3d18",
                        "target_lang_word": "сиамец",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "сиамец",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a436b3fe-c1bd-3742-891f-65fd245d7628",
                                        "entry_id": "c75e07d8-fde7-3f03-aa06-402a1ef7826c",
                                        "glosses": [
                                            "устар. представитель коренного населения Сиама (Таиланда)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8d22592-8d41-4ab5-b0ff-a8cee666cea0",
                                                "sense_id": "a436b3fe-c1bd-3742-891f-65fd245d7628",
                                                "text": "В халате он похож на знатного сиамца, мандарина."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18ef6c1d-8f41-397b-af0f-258714dd2e09",
                                        "entry_id": "c75e07d8-fde7-3f03-aa06-402a1ef7826c",
                                        "glosses": [
                                            "разг. кот сиамской породы"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31551b33-846c-478e-a610-e0200e408337",
                                                "sense_id": "18ef6c1d-8f41-397b-af0f-258714dd2e09",
                                                "text": "Тогда мы еще не знали, что сиамцы рождаются полностью белыми и характерный окрас приобретают к полугоду, и подумали, что на рынке маме подсунули обычного беспородного мурлыку."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dcc4576b-3a02-319f-bc08-1d2dddea5102",
                                        "entry_id": "c75e07d8-fde7-3f03-aa06-402a1ef7826c",
                                        "glosses": [
                                            "прост. часто перен. один из сиамских близнецов"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a0ee966-dd67-4819-af42-3abe39c10656",
                                                "sense_id": "dcc4576b-3a02-319f-bc08-1d2dddea5102",
                                                "text": "Спаянные горелой крышей сиамцы-близнецы не желали расставаться, и когда Галя пыталась разломить живую и уродливую плоть, корка тянулась и рвала бока"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
