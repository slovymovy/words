                ],
                "senses": [
                    {
                        "sense_id": "d852a1d8-46f9-30f7-94a0-d0a7378eed6f",
                        "entry_id": "67762497-16df-3646-be2e-413950f7f744",
                        "glosses": [
                            "A whole that is more than the sum of its parts; superaddition."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9a633b7-59ad-4266-87fd-0f24a43e621d",
                                "sense_id": "d852a1d8-46f9-30f7-94a0-d0a7378eed6f",
                                "text": "The tradition consists in understanding a politically active unit as an oversum (that is, a super-additive entity): The whole is more than the sum of its parts."
                            },
                            {
                                "example_id": "54cc4e4c-0cc3-4051-be89-ad2bf2aa2ccf",
                                "sense_id": "d852a1d8-46f9-30f7-94a0-d0a7378eed6f",
                                "text": "It follows from this counterbalance of majority rule and inalienable absolutes within a given society that the latter is ordered according to the oversum principle: The whole is more than the sum of its parts."
                            },
                            {
                                "example_id": "312f3a6f-5900-499e-b0dc-ca8c4b42a45d",
                                "sense_id": "d852a1d8-46f9-30f7-94a0-d0a7378eed6f",
                                "text": "Democracy requires an oversum, a koiné, a res publica, a Genossenschaft, a commonwealth, a League such as the Iroquois, a Tewa-Pueblo, that is, an entity of which the citizens are members with membership duties and rights."
                            },
                            {
                                "example_id": "e15e0259-2b57-4cdb-86d9-74b2042280f2",
                                "sense_id": "d852a1d8-46f9-30f7-94a0-d0a7378eed6f",
                                "text": "The Saxonian tradition does not know or rejects the cooperative, the oversum, or superaddition."
                            },
                            {
                                "example_id": "036f25ca-17ea-464a-83fd-85029133a3a6",
                                "sense_id": "d852a1d8-46f9-30f7-94a0-d0a7378eed6f",
                                "text": "Thus SB is an over-sum effect."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
