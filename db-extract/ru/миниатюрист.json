                                    {
                                        "sense_id": "ef1ea4e6-7050-3c6c-bbeb-ddb62732c1df",
                                        "entry_id": "4cb46609-b710-34f3-acc5-9f3ed3381b9d",
                                        "glosses": [
                                            "An artist who paints miniature figures or scenes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ca7331e0-b382-3525-bf21-b9f324e7d3e3",
                                        "entry_id": "4cb46609-b710-34f3-acc5-9f3ed3381b9d",
                                        "glosses": [
                                            "A person who creates or collects miniature figurines (such as dolls)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "665cc706-ff37-4cbc-8b7a-879cac5346db",
                                                "sense_id": "ca7331e0-b382-3525-bf21-b9f324e7d3e3",
                                                "text": "Power scissors Every miniaturist should have a pair."
                                            },
                                            {
                                                "example_id": "a55e96a9-5286-4849-ab83-e75a907b9260",
                                                "sense_id": "ca7331e0-b382-3525-bf21-b9f324e7d3e3",
                                                "text": "The miniaturist's hobby is as varied as the people who pursue it."
                                            },
                                            {
                                                "example_id": "0847e5b6-3bff-4a9e-8487-6ce0651c01fd",
                                                "sense_id": "ca7331e0-b382-3525-bf21-b9f324e7d3e3",
                                                "text": "There are many smaller devices to be found, particularly in Scotland, which are more suited to the miniaturist."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d8ffeaef-1d7b-4ec5-97fc-fe2ddc3677a0",
                        "source_entry_id": "db4f77e5-cfdd-3800-8652-250c5eec5c58",
