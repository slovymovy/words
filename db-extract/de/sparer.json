                "senses": [
                    {
                        "sense_id": "ed24e5d2-98c8-3df4-9130-6b0fb4b3271e",
                        "entry_id": "365feba9-c9a0-367c-a0ea-4d7cf78241e5",
                        "glosses": [
                            "Person, die etwas spart, besonders bei einer Bank oder Sparkasse"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ded19f6b-fe4f-4932-9740-e3eb2ed0c886",
                                "sense_id": "ed24e5d2-98c8-3df4-9130-6b0fb4b3271e",
                                "text": "Michael ist ein Sparer, er zahlt jeden Cent auf sein Konto ein."
                            },
                            {
                                "example_id": "a0ff3ef1-add3-4cc4-9109-6ba5b1ecd66a",
                                "sense_id": "ed24e5d2-98c8-3df4-9130-6b0fb4b3271e",
                                "text": "Meine Großeltern waren ihr ganzen Leben eifrige Sparer."
                            },
                            {
                                "example_id": "acf88058-00b5-4030-acc6-24009d688dd3",
                                "sense_id": "ed24e5d2-98c8-3df4-9130-6b0fb4b3271e",
                                "text": "„Die meisten der verunsicherten Sparer wussten nicht, dass es kommunal festgelegte Höchstsummen für Abhebungen gab, in Berlin beispielsweise 150 Mark pro Tag.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "561bbc73-e86b-409b-bab9-bfac222e92b3",
                        "source_entry_id": "365feba9-c9a0-367c-a0ea-4d7cf78241e5",
                        "source_sense_id": "ed24e5d2-98c8-3df4-9130-6b0fb4b3271e",
                        "source_sense_description": "Person, die etwas spart, besonders bei einer Bank oder Sparkasse",
                        "target_lang_word": "saver",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "saver",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bb959074-7d29-3b38-9cec-a55d9464847c",
                                        "entry_id": "f0f7c639-aec8-34d9-a2fe-c7544d2d4be3",
                                        "glosses": [
                                            "One who saves."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "acb896a7-7adb-40b0-9d3c-6b40802f9506",
                                                "sense_id": "bb959074-7d29-3b38-9cec-a55d9464847c",
                                                "text": "a saver of souls"
                                            },
                                            {
                                                "example_id": "d1f0a335-24c2-4c71-a415-86a43ae6d674",
                                                "sense_id": "bb959074-7d29-3b38-9cec-a55d9464847c",
                                                "text": "Finance is seldom romantic. But the idea of peer-to-peer lending comes close. This is an industry that brings together individual savers and lenders on online platforms. Those that want to borrow are matched with those that want to lend."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af2a24e1-051a-3db2-bcd7-bef2d333f857",
                                        "entry_id": "f0f7c639-aec8-34d9-a2fe-c7544d2d4be3",
                                        "glosses": [
                                            "One who keeps savings more than usual."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "842defc2-5847-4267-a7c2-bd89165715f3",
                                                "sense_id": "af2a24e1-051a-3db2-bcd7-bef2d333f857",
                                                "text": "He’s a saver and she’s a spender; you’d think the marriage would be doomed, but he keeps them from going into bankruptcy and she makes sure they have a lot of fun."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3b62a63-5a83-3898-8319-45d3a620fe9f",
                                        "entry_id": "f0f7c639-aec8-34d9-a2fe-c7544d2d4be3",
                                        "glosses": [
                                            "A ticket or coupon that offers a discount."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5bd7a643-7108-4649-a2c3-c9585a5ee206",
                                                "sense_id": "f3b62a63-5a83-3898-8319-45d3a620fe9f",
                                                "text": "Tickets are cheaper the younger you are—snag a youth ticket (if you're twenty-five or under) for a 35 percent discount. If both you and your travel partner are twenty-six or older, the Small Group Saver will knock off 15 percent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
