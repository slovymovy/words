                ],
                "senses": [
                    {
                        "sense_id": "cc2ab5e3-4729-3399-baca-1850fc68f59b",
                        "entry_id": "9640c4b6-6398-3bb6-813e-149b28ebb858",
                        "glosses": [
                            "Umsetzung von etwas ohne fremde Hilfe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5367d41-6a16-4b83-986d-08f499fa081f",
                                "sense_id": "cc2ab5e3-4729-3399-baca-1850fc68f59b",
                                "text": "Im Alleingang schoss er das Tor."
                            },
                            {
                                "example_id": "2deb1beb-aeee-499c-b659-ea068f450720",
                                "sense_id": "cc2ab5e3-4729-3399-baca-1850fc68f59b",
                                "text": "Im Alleingang hat er seine Firma aus dem Nichts entstehen lassen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "48a701d6-bfd7-3127-9f9d-89894e7277d9",
                        "entry_id": "9640c4b6-6398-3bb6-813e-149b28ebb858",
                        "glosses": [
                            "Hinwegsetzung über Zusammenarbeit und Aufzwingung der eigenen Vorstellungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cae27466-4851-452e-abca-43c5509f25cd",
                                "sense_id": "48a701d6-bfd7-3127-9f9d-89894e7277d9",
                                "text": "Der Alleingang mancher Mitarbeiter hier ist mir zu dumm. So wird das nichts mit dem Projekt."
                            },
                            {
                                "example_id": "49188e87-615c-4f0b-8a3f-6c79cec1e13e",
                                "sense_id": "48a701d6-bfd7-3127-9f9d-89894e7277d9",
                                "text": "„Er hatte im Alleingang gehandelt und zeigte wenig Interesse an Politik.“"
                            },
                            {
                                "example_id": "1ee6c9a6-2e33-47b5-8017-8109c85e06d0",
                                "sense_id": "48a701d6-bfd7-3127-9f9d-89894e7277d9",
                                "text": "„Dass ich auf Bernaschek und seinen Alleingang eine Mordswut habe, will ich in unserem kleinen Kreis nicht ungesagt lassen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3e0b98b0-5952-48bf-9e4f-b675d37a34b1",
                        "source_entry_id": "9640c4b6-6398-3bb6-813e-149b28ebb858",
                        "source_sense_id": "cc2ab5e3-4729-3399-baca-1850fc68f59b",
                        "source_sense_description": "Umsetzung von etwas ohne fremde Hilfe",
                        "target_lang_word": "solo run",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "solo run",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e80ea9a3-0550-3ff7-b1dc-106a9fdf1fb7",
                                        "entry_id": "5779a666-34cb-3d7f-96ec-7b8d7b6a103f",
                                        "glosses": [
                                            "A run made while soloing (and possibly bouncing) the football."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36bef4f8-14c1-466b-8488-0f0f928df1a8",
                                                "sense_id": "e80ea9a3-0550-3ff7-b1dc-106a9fdf1fb7",
                                                "text": "Dublin fired a second goal when Noelle Healy ended her fine solo run with an impressive finish."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5db078fc-2e9d-3e15-b458-7ada53b98cec",
                                        "entry_id": "5779a666-34cb-3d7f-96ec-7b8d7b6a103f",
                                        "glosses": [
                                            "Action taken without consultation of colleagues or approval of superiors."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f4afe22-e4a3-479e-abf3-3b79b113f864",
                                                "sense_id": "5db078fc-2e9d-3e15-b458-7ada53b98cec",
                                                "text": "For a start Minister Varadkar, without seeking approval from on high, set off on a solo run informing the public that not everything in the pie-in-the-sky programme for Government was achievable."
                                            },
                                            {
                                                "example_id": "cd1fdbcf-78a4-41e1-b615-e79ba5bd4ccf",
                                                "sense_id": "5db078fc-2e9d-3e15-b458-7ada53b98cec",
                                                "text": "Ireland strives to nudge the EU towards “a more just” position but avoids solo runs, said Holohan, who noted that France and other members had echoed its call for a ceasefire. “We want to remain within the European consensus.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
