                                "example_id": "fd0ed936-aa27-48f4-84f0-e2cafee6e5b5",
                                "sense_id": "833ab4db-a4db-3375-a857-c20409a286e5",
                                "text": "At the Hoolie or Spring Festival, which happened in March, the Sepoys came round in procession, and exhibited anautch for our amusement in front of our bungalow, and a sort of play, the performers enacting the part of wild beasts."
                            }
