                    {
                        "sense_id": "c66d5952-75b0-3240-abc5-129ded1c8d11",
                        "entry_id": "3b59234b-d4ae-3f12-8a31-5cc98c7f5733",
                        "glosses": [
                            "een aardewerken pot bedoeld de as van een overledene te bevatten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7de605da-d303-45f0-94b1-825e9d3d6fcf",
                                "sense_id": "c66d5952-75b0-3240-abc5-129ded1c8d11",
                                "text": "Bij de opgraving kwamen een groot aantal urnen aan de dag."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8d013d61-a3c6-4ccf-836d-888791440649",
                        "source_entry_id": "3b59234b-d4ae-3f12-8a31-5cc98c7f5733",
                        "source_sense_id": "c66d5952-75b0-3240-abc5-129ded1c8d11",
                        "source_sense_description": "eerste betekenisomschrijving",
                        "target_lang_word": "Urne",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Urne",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1f5f9bfd-e83c-33d4-bc25-85ec68f37049",
                                        "entry_id": "24741792-bf5f-3678-b5d8-16ccf2bf2110",
                                        "glosses": [
                                            "Behältnis, in dem die Asche einer verbrannten Person aufbewahrt wird"
                                        ],
                                        "tags": [
                                            "Bestattung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed0782aa-5e83-4d6c-a3d3-22f6b1681f97",
                                                "sense_id": "1f5f9bfd-e83c-33d4-bc25-85ec68f37049",
                                                "text": "Die Urne ihrer Großmutter stand auf dem Kamin."
                                            },
                                            {
                                                "example_id": "8065b473-20cf-4bb3-9528-d8d42c2c2443",
                                                "sense_id": "1f5f9bfd-e83c-33d4-bc25-85ec68f37049",
                                                "text": "Urnen können sowohl in der Erde bestattet als auch in geeigneten Räumen wie Urnenhainen aufbewahrt werden."
                                            },
                                            {
                                                "example_id": "e558de75-7816-4e75-890a-24084e1522c2",
                                                "sense_id": "1f5f9bfd-e83c-33d4-bc25-85ec68f37049",
                                                "text": "„Ich hob diese teuren Reste auf, verschloß sie in einer Urne und stellte diese in unser Haustabernakel, unter die Schwingen der Cherubim.“"
                                            },
                                            {
                                                "example_id": "92371c30-b706-4e1b-b816-fe11d73a3e01",
                                                "sense_id": "1f5f9bfd-e83c-33d4-bc25-85ec68f37049",
                                                "text": "„Die Urne bewahrte sie auf, stellte sie im Vorderzimmer auf den Kaminsims und füllte sie mit den langen Rispen des Strandhafers.“"
                                            },
                                            {
                                                "example_id": "2a33cda2-ba31-4030-9cf7-a5c76dcd93d0",
                                                "sense_id": "1f5f9bfd-e83c-33d4-bc25-85ec68f37049",
                                                "text": "„Darauf ergriff Bouvard die beiden Urnen, die mit Erde gefüllt waren – was menschliche Asche sei –, dann hielt er das Fläschchen an seine Augen, um zu zeigen, wie die Römer ihre Tränen hineinfließen ließen .“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "013f327c-43d9-3737-b8c9-99f743fcc442",
                                        "entry_id": "24741792-bf5f-3678-b5d8-16ccf2bf2110",
                                        "glosses": [
                                            "Behältnis, in dem die Stimmzettel gesammelt werden"
                                        ],
                                        "tags": [
                                            "Wahl"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aef0b222-f382-4794-b15e-fbee389c773d",
                                                "sense_id": "013f327c-43d9-3737-b8c9-99f743fcc442",
                                                "text": "Aus Protest zerriss er demonstrativ seinen Wahlzettel und stieß die Urne um."
                                            },
                                            {
                                                "example_id": "344b6375-7356-4b60-9005-d6adfc020d07",
                                                "sense_id": "013f327c-43d9-3737-b8c9-99f743fcc442",
                                                "text": "Die Urne sollte während der Wahl nie unbeaufsichtigt gelassen werden."
                                            },
                                            {
                                                "example_id": "e789896f-d91f-4e42-93b3-31a6579a8442",
                                                "sense_id": "013f327c-43d9-3737-b8c9-99f743fcc442",
                                                "text": "„Egal mit wem wir sprechen, niemand glaubt, dass sich nach der Wahl etwas ändert. Also, warum überhaupt zur Urne gehen?“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2b80fe27-29bb-4588-9cc9-f1f11ab450c6",
                        "source_entry_id": "3b59234b-d4ae-3f12-8a31-5cc98c7f5733",
                        "source_sense_id": "c66d5952-75b0-3240-abc5-129ded1c8d11",
                        "source_sense_description": "eerste betekenisomschrijving",
                        "target_lang_word": "urn",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "urn",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e95f4619-0091-3a10-ba2d-2d380b4ad7cd",
                                        "entry_id": "1b03209a-3945-34ee-8567-bd333b507156",
                                        "glosses": [
                                            "A vase with a footed base."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad61042a-a746-47b8-89a5-d3f3af209f9d",
                                                "sense_id": "e95f4619-0091-3a10-ba2d-2d380b4ad7cd",
                                                "text": "A rustic, digging in the ground by Padua, […]found an urn, or earthen pot, in which there was another urn."
                                            },
                                            {
                                                "example_id": "8b040093-8f61-4e11-9285-159e6bf5a8c2",
                                                "sense_id": "e95f4619-0091-3a10-ba2d-2d380b4ad7cd",
                                                "text": "His scattered limbs with my dead body burn, / And once more join us in the pious urn."
                                            },
                                            {
                                                "example_id": "d2138ee9-f3c8-4afb-af12-27e995bbb522",
                                                "sense_id": "e95f4619-0091-3a10-ba2d-2d380b4ad7cd",
                                                "text": "Mary Fibbs and all her friends start making coughing noises whenever I come near them, and then they all giggle and Mary says Grandfather mixes his cough medicine in the urns on top of the gate posts after dark with his umbrella, and now Jessamy!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58556f54-ee9f-3ea6-8393-d2349b5178b3",
                                        "entry_id": "1b03209a-3945-34ee-8567-bd333b507156",
                                        "glosses": [
                                            "A metal vessel for serving tea or coffee."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "50c360fb-91f2-37b4-a27e-88a6b96e439b",
                                        "entry_id": "1b03209a-3945-34ee-8567-bd333b507156",
                                        "glosses": [
                                            "A vessel for the ashes or cremains of a deceased person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c6bcf24-c486-4a72-b485-d4168da90e2e",
                                                "sense_id": "50c360fb-91f2-37b4-a27e-88a6b96e439b",
                                                "text": "So draw him home to those that mourn\n⁠In vain; a favourable speed\n⁠Ruffle thy mirror’d mast, and lead\nThro’ prosperous floods his holy urn."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83a4350c-0ec5-3b45-873d-7a01a692a6e7",
                                        "entry_id": "1b03209a-3945-34ee-8567-bd333b507156",
                                        "glosses": [
                                            "Any place of burial; the grave."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e385b3d-1263-43db-9be2-911014aa3208",
                                                "sense_id": "83a4350c-0ec5-3b45-873d-7a01a692a6e7",
                                                "text": "Or lay these bones in an unworthy urn, / Tombless, with no remembrance over them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4168d61e-075d-32e8-ae7e-f39c199514ea",
                                        "entry_id": "1b03209a-3945-34ee-8567-bd333b507156",
                                        "glosses": [
                                            "A measure of capacity for liquids, containing about three gallons and a half, wine measure. It was half the amphora, and four times the congius."
                                        ],
                                        "tags": [
                                            "Roman",
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "39b1f880-faf8-37c2-b6ad-0c54e8ec42dd",
                                        "entry_id": "1b03209a-3945-34ee-8567-bd333b507156",
                                        "glosses": [
                                            "A hollow body shaped like an urn, in which the spores of mosses are contained; a spore case; a theca."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
