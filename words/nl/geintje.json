    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "33eb5e8e-ba22-3cbb-b395-d3e6cce5405a",
                    "sense_definition": "een grapje of een kleine, onschuldige streek",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "grap",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het was maar een <w>geintje</w>, dus je moet niet zo boos worden.",
                            "target_lang_translations": {
                                "en": "It was only a <w>joke</w>, so you shouldn't get so angry."
                            }
                        },
                        {
                            "text": "Hij houdt ervan om een flauw <w>geintje</w> uit te halen met zijn collega's.",
                            "target_lang_translations": {
                                "en": "He likes to play a silly <w>prank</w> on his colleagues."
                            }
                        }
                    ],
                    "synonyms": [
                        "grapje",
                        "mopje",
                        "geintje"
                    ],
                    "common_phrases": [
                        "een flauw geintje",
                        "voor het geintje"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Veelgebruikt in informele spreektaal."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "a joke or a small, harmless prank"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "joke",
                                "target_lang_sense_clarification": "something said or done to provoke laughter"
                            },
                            {
                                "target_lang_word": "prank",
                                "target_lang_sense_clarification": "a mischievous trick or practical joke"
                            },
                            {
                                "target_lang_word": "gag",
                                "target_lang_sense_clarification": "a joke or funny story"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c428eb92-5dd5-347c-952a-657c6e34d6c5",
                    "sense_definition": "een onaangename of onverwachte gebeurtenis (vaak ironisch gebruikt)",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "onaangenaamheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dat was een duur <w>geintje</w> toen de auto plotseling kapotging.",
                            "target_lang_translations": {
                                "en": "That was an expensive <w>joke</w> when the car suddenly broke down."
                            }
                        },
                        {
                            "text": "Nu moeten we alles opnieuw doen, wat een mooi <w>geintje</w> is dat.",
                            "target_lang_translations": {
                                "en": "Now we have to do everything all over again, what a nice <w>joke</w> that is."
                            }
                        }
                    ],
                    "synonyms": [
                        "grap"
                    ],
                    "common_phrases": [
                        "een duur geintje"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Vaak ironisch of sarcastisch gebruikt."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "an unpleasant or unexpected event (often used ironically)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "joke",
                                "target_lang_sense_clarification": "used ironically to describe an expensive or annoying situation"
                            },
                            {
                                "target_lang_word": "stunt",
                                "target_lang_sense_clarification": "an action that causes unexpected trouble or cost"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "886b089f-b409-32a2-b5bd-ea5b0e8fb662",
                    "sense_definition": "het verkleinwoord van <w>gein</w>",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "grammatica",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het woord <w>geintje</w> is het verkleinwoord van het zelfstandig naamwoord gein.",
                            "target_lang_translations": {
                                "en": "The word <w>geintje</w> is the diminutive of the noun gein."
                            }
                        },
                        {
                            "text": "In het Nederlands maken we van gein het verkleinwoord <w>geintje</w>.",
                            "target_lang_translations": {
                                "en": "In Dutch, we turn gein into the diminutive <w>geintje</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Grammaticale vorm van een ander woord."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "the diminutive form of the noun 'gein' (fun/pleasure)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "little joke",
                                "target_lang_sense_clarification": "literal diminutive meaning of fun or joke"
                            }
                        ]
                    }
                }
            ]
        }
    ]
