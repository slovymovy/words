                                    {
                                        "sense_id": "a55d8040-323b-3364-8ee2-b80c4bda98cf",
                                        "entry_id": "4df8c35d-eade-3a59-a4cc-7398561521dd",
                                        "glosses": [
                                            "etwas mit kleinen, schnellen Stößen bewegen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "225e33fc-d347-4d90-963b-1c4201513e2a",
                                                "sense_id": "a55d8040-323b-3364-8ee2-b80c4bda98cf",
                                                "text": "Bevor man die einzelnen Blätter bindet, rüttelt der Buchbinder sie zu einem ordentlichen Stapel."
                                            },
                                            {
                                                "example_id": "17377ffd-97ca-4569-941a-aaa4e30c312b",
                                                "sense_id": "a55d8040-323b-3364-8ee2-b80c4bda98cf",
                                                "text": "Jan war im Zug eingeschlafen, doch plötzlich rüttelte ihn jemand. Es war der Schaffner."
                                            },
                                            {
                                                "example_id": "e68ebee6-32a8-4bcb-9a7d-529927317c47",
                                                "sense_id": "a55d8040-323b-3364-8ee2-b80c4bda98cf",
                                                "text": "Auch Passagiere, die die Tür des Ruheraums mit der Toilettentür verwechseln und an der Klinke rütteln, stören bei der Entspannung über den Wolken."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "225b0801-189e-31e5-aa5c-f62bd8601e0b",
                                        "entry_id": "4df8c35d-eade-3a59-a4cc-7398561521dd",
                                        "glosses": [
                                            "etwas (zum Beispiel ein Prinzip) infrage stellen, bedrohen"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7517a32-2ed0-42cb-949f-d216cb4b1997",
                                                "sense_id": "225b0801-189e-31e5-aa5c-f62bd8601e0b",
                                                "text": "Am Wikiprinzip darf nicht gerüttelt werden!"
                                            },
                                            {
                                                "example_id": "a21bcd74-6fda-4faa-ad22-72480cccdd18",
                                                "sense_id": "225b0801-189e-31e5-aa5c-f62bd8601e0b",
                                                "text": "Die Jugendlichen rütteln am Konzept der Ehe und wollen sie zu Fall bringen."
                                            },
                                            {
                                                "example_id": "3277c0b4-f8a6-4fae-89be-4f83f5a7fc27",
                                                "sense_id": "225b0801-189e-31e5-aa5c-f62bd8601e0b",
                                                "text": "An seinem Entschluss zu kündigen war nicht zu rütteln."
                                            },
                                            {
                                                "example_id": "3dbae842-8629-4b65-b0ae-e9e436fa5005",
                                                "sense_id": "225b0801-189e-31e5-aa5c-f62bd8601e0b",
                                                "text": "Knapp geschnitten und ganz in schwarz gehalten, rüttelte Chanel mit diesem Kleidungsstück [dem \"kleinen Schwarzen\"] zudem an gesellschaftlichen Tabus - bislang hatten sich Frauen möglichst bedeckt zu zeigen, und schwarz galt zudem als Farbe der Dienerschaft."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "63afbec7-04f0-38a1-8a56-cb941fa4a9db",
                                        "entry_id": "4df8c35d-eade-3a59-a4cc-7398561521dd",
                                        "glosses": [
                                            "der Vorgang des Sektflaschen-Drehens auf dem Rüttelbrett oder Rüttelpult, um den Niederschlag und die Trübstoffe zum Korken bzw. in den Flaschenhals zu treiben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9329b779-aa76-4412-9911-1c1bac0e3ac4",
                                                "sense_id": "63afbec7-04f0-38a1-8a56-cb941fa4a9db",
                                                "text": "Sie rüttelten den ganzen Nachmittag Sektflaschen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "58fe11a6-8091-34bc-9be4-88a20eda373c",
                                        "entry_id": "4df8c35d-eade-3a59-a4cc-7398561521dd",
                                        "glosses": [
                                            "ein Vogel, meist ein Raubvogel, fliegt mit kurzen Flügelschlägen an einem Punkt in der Luft"
                                        ],
