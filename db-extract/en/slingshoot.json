                        ],
                        "examples": [
                            {
                                "example_id": "ddb3c574-a380-4a3e-8f67-641f5c5ffb5a",
                                "sense_id": "7f63e9d8-5799-3b33-8fd7-7a6428de2032",
                                "text": "I did not like him and at times had the urge to yank back on his armbands and slingshoot him out past Otto and the lions into the street."
                            },
                            {
                                "example_id": "e1b3bc54-a396-43e9-b34c-e8c7eeb60c90",
                                "sense_id": "7f63e9d8-5799-3b33-8fd7-7a6428de2032",
                                "text": "I was always worried about Jesus’ harebrained schemes; something always seemed to go awry with them. Like the time he suggested we slingshoot a beehive off of a tree in his backyard."
                            }
                        ]
                    }
