                            },
                            {
                                "target_lang_word": "da",
                                "target_lang_sense_clarification": "olumsuz katılım gösterirken"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "也不",
                                "target_lang_sense_clarification": "表示否定认同"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "ook niet",
                                "target_lang_sense_clarification": "informele instemming met een ontkenning"
                            },
                            {
                                "target_lang_word": "evenmin",
                                "target_lang_sense_clarification": "formele instemming met een ontkenning"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "też nie",
                                "target_lang_sense_clarification": "wyrażenie zgody z przeczeniem"
                            }
                        ],
                        "de": [
