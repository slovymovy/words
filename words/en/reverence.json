                    "frequency": "Middle",
                    "semantic_group_id": "respect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pilgrims approached the holy site with great <w>reverence</w>."
                        },
                        {
                            "text": "She spoke of her mentor with profound <w>reverence</w> and gratitude."
                        }
                    ],
                    "antonyms": [
                        "contempt",
                        "blasphemy",
                        "profanity"
                    ],
                    "common_phrases": [
