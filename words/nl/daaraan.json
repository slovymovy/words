                    "sense_id": "57bf09a0-9732-33e6-8f2a-2e1354c8a88e",
                    "sense_definition": "Aan dat of aan die; verwijst naar een zaak, dier of situatie die eerder genoemd is of aangewezen wordt.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "null",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik heb <w>daaraan</w> nog helemaal niet gedacht.",
                            "target_lang_translations": {
                                "ru": "Я <w>об этом</w> ещё совсем не подумал.",
                                "en": "I haven't thought <w>about that</w> at all yet.",
                                "it": "Non ho ancora pensato affatto <w>a questo</w>."
                            }
                        },
                        {
                            "text": "Je moet <w>daaraan</w> werken als je beter wilt worden.",
                            "target_lang_translations": {
                                "ru": "Ты должен <w>над этим</w> работать, если хочешь стать лучше.",
                                "en": "You have to work <w>on that</w> if you want to get better.",
                                "it": "Devi lavorare <w>su questo</w> se vuoi migliorare."
                            }
                        },
                        {
                            "text": "<w>Daaraan</w> wordt een stevige kabel bevestigd.",
                            "target_lang_translations": {
                                "ru": "<w>К этому</w> крепится прочный кабель.",
                                "en": "A sturdy cable is attached <w>to that</w>.",
                                "it": "<w>A questo</w> viene fissato un cavo robusto."
                            }
                        }
                    ],
                    "synonyms": [
                        "eraan"
                    ],
                    "antonyms": [
                        "hieraan"
                    ],
                    "common_phrases": [
                        "daaraan denken",
                        "daaraan twijfelen",
                        "daaraan werken",
                        "daaraan wennen",
                        "daaraan toevoegen"
                    ],
                    "target_lang_definitions": {
                        "ru": "Об этом, к этому, над этим; указывает на предмет, животное или ситуацию, которые были упомянуты ранее или на которые указывают.",
                        "en": "To that, about that, or on that; refers to a thing, animal, or situation previously mentioned or pointed out.",
                        "it": "A ciò, di ciò, su ciò; si riferisce a una cosa, un animale o una situazione menzionati in precedenza o indicati."
                    },
