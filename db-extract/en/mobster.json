                "senses": [
                    {
                        "sense_id": "6b3384c7-d067-3184-b55d-5139d80bf613",
                        "entry_id": "ef6352f9-949e-3905-8f44-c1f26e80736f",
                        "glosses": [
                            "A member of a mob or Mafia."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6e81cfb-28aa-49cf-afcc-9b0e5a59656c",
                                "sense_id": "6b3384c7-d067-3184-b55d-5139d80bf613",
                                "text": "The proprietor was a \"Zip\" — a Sicilian-born mobster — who was running a gambling operation that cut into Godfather Gotti's turf."
                            },
                            {
                                "example_id": "3a2f92a9-685a-473f-aa04-bd2cffcb7cfd",
                                "sense_id": "6b3384c7-d067-3184-b55d-5139d80bf613",
                                "text": "Most of the carpet joints were run by the mobsters and local henchmen associated with the Mayfield Road Gang, but Peter Schmidt's Playtorium and Glenn Rendezvous were also included."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "54bf85c9-a9cb-4ac4-93aa-6a79b7d88c56",
                        "source_entry_id": "ef6352f9-949e-3905-8f44-c1f26e80736f",
                        "source_sense_id": "6b3384c7-d067-3184-b55d-5139d80bf613",
                        "source_sense_description": "member of a criminal gang — see also Mafioso",
                        "target_lang_word": "Gangster",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gangster",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c2b42058-3b84-32b3-916a-50b294ae3243",
                                        "entry_id": "969c28e1-35ab-35db-bd22-07d0b1aaf259",
                                        "glosses": [
                                            "Mitglied einer Verbrecherbande"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ca02d77-77b6-4484-84f9-f5183520ccf2",
                                                "sense_id": "c2b42058-3b84-32b3-916a-50b294ae3243",
                                                "text": "Die Gangster verschiedener Gangs bekriegen sich untereinander."
                                            },
                                            {
                                                "example_id": "0f521ab6-9f92-425e-ae89-c78180411b13",
                                                "sense_id": "c2b42058-3b84-32b3-916a-50b294ae3243",
                                                "text": "„Sie sammeln monatelang Beweismaterial und überwachen die Gangster.“"
                                            },
                                            {
                                                "example_id": "801efadd-7549-40c8-b3c2-a3bd72fce63a",
                                                "sense_id": "c2b42058-3b84-32b3-916a-50b294ae3243",
                                                "text": "„Sie hatten sich getrennt wie Gangter nach der Tat.“"
                                            },
                                            {
                                                "example_id": "ec9c8b64-c5c3-4a31-93e5-526e904155b5",
                                                "sense_id": "c2b42058-3b84-32b3-916a-50b294ae3243",
                                                "text": "In den 1920er Jahren haben in der Wiener Unterwelt viele Gangster ihr Unwesen getrieben."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
