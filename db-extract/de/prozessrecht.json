                        "form": "das Prozessrecht"
                    },
                    {
                        "form_id": "c356739d-5cf3-41af-8af5-6ec8b9814e3c",
                        "entry_id": "f68a03ee-abf3-3312-a41e-fca15148dde0",
                        "tags": [
                            "accusative",
