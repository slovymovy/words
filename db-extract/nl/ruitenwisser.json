                        "source_sense_id": "01e1ccb8-3f6b-3cad-bc9b-37363b214a38",
                        "source_sense_description": "een apparaatje dat de ruiten van een auto automatisch wist met een bewegende arm met wisserblad",
                        "target_lang_word": "Scheibenwischer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
