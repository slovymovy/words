                                "target_senses": [
                                    {
                                        "sense_id": "1c74d00a-dfa9-35ef-9263-d3ae65b8532c",
                                        "entry_id": "2b60a934-640b-3adb-b1de-11975938a7d3",
                                        "glosses": [
                                            "Alternative letter-case form of Dadaist."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5196f34-0da5-4f88-a9d7-8b881940d4ef",
                                                "sense_id": "1c74d00a-dfa9-35ef-9263-d3ae65b8532c",
                                                "text": "In 1976 and 1977, and the years to follow, as symbolically remade by the Sex Pistols, it was, perhaps, dadaists, lettrists, situationists, and various medieval heretics."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
