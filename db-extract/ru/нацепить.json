                                                "example_id": "439b205f-06d3-4fbb-98fe-7ab737f5c8e3",
                                                "sense_id": "502e9298-0403-388b-ad6c-d945d374d238",
                                                "text": "Der Chef hängte ihm dann auch noch das Korrekturlesen an."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "8f2e8295-5b18-3732-9e90-cda77b7f98b7",
                                        "entry_id": "47538c45-272e-3150-aa5c-925c666edcc2",
                                        "glosses": [
                                            "jemandem etwas über Wert verkaufen; jemandem etwas verkaufen, dass dieser eigentlich nicht haben wollte"
