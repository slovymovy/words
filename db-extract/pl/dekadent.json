                        "translation_id": "c05462a6-ac99-487f-a17d-8415d984ab95",
                        "source_entry_id": "4f7fbcd6-4d2d-36c5-a0fb-88267199c67b",
                        "source_sense_id": "3bb5e486-656b-3c0f-aa80-bf5a204de50e",
                        "target_lang_word": "decadent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "decadent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e1be96ac-16ac-3108-b6b6-5349bc090caf",
                                        "entry_id": "9ac0e860-4574-30f3-9536-e1e8fa9c680a",
                                        "glosses": [
                                            "Characterized by moral or cultural decline."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b3d34f8-83d3-4cb1-a5e5-8843ea7c20e4",
                                                "sense_id": "e1be96ac-16ac-3108-b6b6-5349bc090caf",
                                                "text": "As societies grow decadent, the language grows decadent, too. Words are used to disguise, not to illuminate, action: you liberate a city by destroying it. Words are to confuse, so that at election time people will solemnly vote against their own interests."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "412273b3-7344-3eb7-a3df-7e44aaac32cc",
                                        "entry_id": "9ac0e860-4574-30f3-9536-e1e8fa9c680a",
                                        "glosses": [
                                            "Luxuriously self-indulgent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aff531fe-b236-4340-afd5-a5e178b5819a",
                                                "sense_id": "412273b3-7344-3eb7-a3df-7e44aaac32cc",
                                                "text": "2003, Hedonismbot in the Futurama episode \"The Devil's Hands Are Idle Playthings\"\nSurgery in an opera? How wonderfully decadent! And just as I was beginning to lose interest!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "decadent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "628d6134-10ee-37ff-9090-bcb8feb2b910",
                                        "entry_id": "768651ea-283d-357b-bc69-a639c4698d47",
                                        "glosses": [
                                            "A person affected by moral decay."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a782486-403c-4e25-95dc-55293b8c5bda",
                                                "sense_id": "628d6134-10ee-37ff-9090-bcb8feb2b910",
                                                "text": "L. Douglas\nHe had the fastidiousness, the preciosity, the love of archaisms, of your true decadent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "03874c3e-2e7a-4bec-a1cd-a29a6fbd3831",
                        "source_entry_id": "4f7fbcd6-4d2d-36c5-a0fb-88267199c67b",
                        "source_sense_id": "3bb5e486-656b-3c0f-aa80-bf5a204de50e",
                        "target_lang_word": "décadent",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "décadent",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4295c8d7-2133-3fa6-ab11-00acb72239a4",
                                        "entry_id": "4ae35dec-4b48-31db-b965-9b73e57c7970",
                                        "glosses": [
                                            "Qui appartient à ce que l'on considère comme époque de décadence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24c024b0-8248-4bc5-afba-7ab3c35f198b",
                                                "sense_id": "4295c8d7-2133-3fa6-ab11-00acb72239a4",
                                                "text": "Les idées qui ont cours chez les moralistes modernes viennent, pour une très notable partie, de la Grèce décadente."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79f0ecb0-f788-3ce6-846f-6baa046b2988",
                                        "entry_id": "4ae35dec-4b48-31db-b965-9b73e57c7970",
                                        "glosses": [
                                            "Qui résulte de la décadence ou qui l’atteste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b749f95-47a2-4041-8b08-491a158b52af",
                                                "sense_id": "79f0ecb0-f788-3ce6-846f-6baa046b2988",
                                                "text": "Art décadent."
                                            },
                                            {
                                                "example_id": "d1fd11e1-bebd-44ed-833b-8b9accbb3aa7",
                                                "sense_id": "79f0ecb0-f788-3ce6-846f-6baa046b2988",
                                                "text": "Poésie décadente."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c52a78af-3987-3fa1-ae14-c4d7f618bd42",
                                        "entry_id": "4ae35dec-4b48-31db-b965-9b73e57c7970",
                                        "glosses": [
                                            "Qui appartient au courant du décadentisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d9a8ea1-749d-4c30-b393-39ed52242982",
                                                "sense_id": "c52a78af-3987-3fa1-ae14-c4d7f618bd42",
                                                "text": "Gabriele D'Annunzio (1863-1938) est un célèbre poète italien décadent."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "décadent",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a7dba40b-0584-3501-bd40-d05b2d4d5502",
                                        "entry_id": "50d395a5-5cde-37c4-8682-60e06a280358",
                                        "glosses": [
                                            "Un de ceux que l’on considère avoir vécu dans la décadence, ou dans une époque de décadence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c46bcece-3244-4d45-843a-ea622ba4eabd",
                                                "sense_id": "a7dba40b-0584-3501-bd40-d05b2d4d5502",
                                                "text": "En passant, Baudrillard associe les décadents ayant voté Non à la Constitution européenne aux banlieusards qui niquent leur mère."
                                            }
