{
    "word_family": [
        "eis",
        "veeleisend",
        "vereisen",
        "opeisen",
        "afpersen"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0eb368e4-54c4-3401-947e-16aeab94f779",
                    "sense_definition": "op een zeer dringende manier vragen om iets, vaak met de verwachting dat het gebeurt",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "demand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De boze werknemers <w>eisen</w> een hogere vergoeding voor hun overuren.",
                            "target_lang_translations": {
                                "en": "The angry employees <w>demand</w> higher compensation for their overtime.",
                                "ru": "Разгневанные сотрудники <w>требуют</w> более высокой компенсации за сверхурочную работу."
                            }
                        },
                        {
                            "text": "De demonstranten <w>eisten</w> het aftreden van de president tijdens het protest.",
                            "target_lang_translations": {
                                "en": "The protesters <w>demanded</w> the president's resignation during the protest.",
                                "ru": "Протестующие во время акции протеста <w>потребовали</w> отставки президента."
                            }
                        }
                    ],
                    "synonyms": [
                        "vragen"
                    ],
                    "antonyms": [
                        "aanbieden",
                        "geven"
                    ],
                    "common_phrases": [
                        "uitleg eisen",
                        "het aftreden eisen",
                        "gerechtigheid eisen"
                    ],
                    "target_lang_definitions": {
                        "en": "To ask for something in a very urgent manner, often with the expectation that it will happen.",
                        "ru": "Настоятельно просить о чем-то, часто с ожиданием, что это будет выполнено."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "demand",
                                "target_lang_sense_clarification": "to request forcefully"
                            },
                            {
                                "target_lang_word": "insist on",
                                "target_lang_sense_clarification": "to be firm about a requirement"
                            },
                            {
                                "target_lang_word": "claim",
                                "target_lang_sense_clarification": "to assert a right to something"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "требовать",
                                "target_lang_sense_clarification": "настоятельно заявлять о своих правах или желаниях"
                            },
                            {
                                "target_lang_word": "настаивать",
                                "target_lang_sense_clarification": "упорно добиваться выполнения чего-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aefe4967-2805-32a6-94f4-2b185902ab1f",
                    "sense_definition": "iets noodzakelijk maken om een bepaald doel te bereiken",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "require",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Deze moeilijke taak <w>eist</w> veel concentratie en geduld van de studenten.",
                            "target_lang_translations": {
                                "en": "This difficult task <w>requires</w> a lot of concentration and patience from the students.",
                                "ru": "Эта сложная задача <w>требует</w> от студентов большой концентрации и терпения."
                            }
                        },
                        {
                            "text": "Het leren van een nieuwe taal <w>eist</w> dagelijkse oefening en inzet.",
                            "target_lang_translations": {
                                "en": "Learning a new language <w>demands</w> daily practice and commitment.",
                                "ru": "Изучение нового языка <w>требует</w> ежедневной практики и усердия."
                            }
                        }
                    ],
                    "synonyms": [
                        "vereisen",
                        "vragen"
                    ],
                    "common_phrases": [
                        "aandacht eisen",
                        "inspanning eisen"
                    ],
                    "target_lang_definitions": {
                        "en": "To make something necessary in order to achieve a certain goal.",
                        "ru": "Делать что-то необходимым для достижения определенной цели."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "require",
                                "target_lang_sense_clarification": "to need something as a condition"
                            },
                            {
                                "target_lang_word": "demand",
                                "target_lang_sense_clarification": "to need a lot of effort or quality"
                            },
                            {
                                "target_lang_word": "call for",
                                "target_lang_sense_clarification": "to make necessary or appropriate"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "требовать",
                                "target_lang_sense_clarification": "нуждаться в определенных условиях или усилиях"
                            },
                            {
                                "target_lang_word": "требовать больших усилий",
                                "target_lang_sense_clarification": "о делах, задачах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "87b47683-32bb-332d-b31e-2b962e9f2f8c",
                    "sense_definition": "tot gevolg hebben dat mensen overlijden of dat er grote schade ontstaat",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "claim_lives",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De zware storm <w>eiste</w> het leven van drie onschuldige mensen.",
                            "target_lang_translations": {
                                "en": "The severe storm <w>claimed</w> the lives of three innocent people.",
                                "ru": "Сильный шторм <w>унес</w> жизни трех ни в чем не повинных людей."
                            }
                        },
                        {
                            "text": "De verschrikkelijke ramp <w>eiste</w> het leven van 155 personen in de regio.",
                            "target_lang_translations": {
                                "en": "The terrible disaster <w>took</w> the lives of 155 people in the region.",
                                "ru": "Ужасная катастрофа <w>унесла</w> жизни 155 человек в регионе."
                            }
                        }
                    ],
                    "common_phrases": [
                        "levens eisen",
                        "het leven eisen"
                    ],
                    "target_lang_definitions": {
                        "en": "To result in the death of people or cause major damage.",
                        "ru": "Приводить к гибели людей или вызывать серьезные разрушения."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "claim",
                                "target_lang_sense_clarification": "to cause the loss of life"
                            },
                            {
                                "target_lang_word": "take",
                                "target_lang_sense_clarification": "to result in death"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "уносить",
                                "target_lang_sense_clarification": "о жизнях при катастрофах, стихийных бедствиях"
                            },
                            {
                                "target_lang_word": "забирать",
                                "target_lang_sense_clarification": "о жизнях"
                            }
                        ]
                    }
                }
            ]
        },
