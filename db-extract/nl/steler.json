                                    {
                                        "sense_id": "93b7468b-dd0b-3aab-a65a-e400d392ce36",
                                        "entry_id": "b516398d-2105-3988-9b3d-7880405193a9",
                                        "glosses": [
                                            "One who steals another person's property, especially by stealth and without using force or violence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07366753-2ba9-4506-8150-b6fc72272867",
                                                "sense_id": "93b7468b-dd0b-3aab-a65a-e400d392ce36",
                                                "text": "Take heed to false harlots, and more, ye wot what. / If noise ye heare, / Looke all be cleare: / Least drabs doe noie thee, / And theeues destroie thee."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab20134e-88e0-3566-a5db-da4ed483ac79",
                                        "entry_id": "b516398d-2105-3988-9b3d-7880405193a9",
