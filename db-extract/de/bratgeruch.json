                ],
                "senses": [
                    {
                        "sense_id": "16d6cf7d-a8f8-3e11-9ebc-700b2b3efe57",
                        "entry_id": "f22c5183-3842-38e5-9d0f-eb0263d2cbdd",
                        "glosses": [
                            "markanter, wahrnehmbarer Geruch nach einem kurzzeitig angebratenem Stück Fleisch/Fisch/Gemüse an sich selbst, in der Umgebung oder direkt am Bratling; durch das Geruchsorgan wahrgenommene Ausdünstung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34d599ff-5087-4274-9b4c-a0f8af074738",
                                "sense_id": "16d6cf7d-a8f8-3e11-9ebc-700b2b3efe57",
                                "text": "Ein angebratenes Stück Steak hat einen anderen Bratgeruch als Gambas oder Fisch."
                            },
                            {
                                "example_id": "3d516268-89e2-4519-9960-d242d3715e45",
                                "sense_id": "16d6cf7d-a8f8-3e11-9ebc-700b2b3efe57",
                                "text": "„Außerdem: keine heiße Pfanne, kein Bratgeruch und trotzdem jederzeit frisch serviert.“"
                            },
                            {
                                "example_id": "c6297bd9-1f01-4438-a3f6-17ab6bc2f343",
                                "sense_id": "16d6cf7d-a8f8-3e11-9ebc-700b2b3efe57",
                                "text": "„Qualm und Bratgerüche müssen Nachbarn grundsätzlich nicht hinnehmen.“"
                            },
                            {
                                "example_id": "71a6c8d3-e6ae-4860-ae61-086647b47576",
                                "sense_id": "16d6cf7d-a8f8-3e11-9ebc-700b2b3efe57",
                                "text": "„Aus Wirtshausfenstern wirbelt fetter Bratgeruch und Lustgebrüll aus hundert Singspielhallen.“"
                            },
                            {
                                "example_id": "34a9d765-698c-4764-ab62-3a207155384c",
                                "sense_id": "16d6cf7d-a8f8-3e11-9ebc-700b2b3efe57",
                                "text": "„Obwohl die von Frittier- und Bratgeruch gereinigte Abluft im Innenhof des Gebäudes direkt an den Fenstern der Anwohner vorbeizieht, sind bislang keinerlei Beschwerden bekannt.“"
                            },
                            {
                                "example_id": "01c3cf12-aaf2-4315-8443-a154c1021059",
                                "sense_id": "16d6cf7d-a8f8-3e11-9ebc-700b2b3efe57",
                                "text": "„Es wurde gebrutzelt (im Freien übrigens, um Bratgerüche aus der Halle fernzuhalten), Salate wurden angerichtet und leckere Käseplatten serviert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
