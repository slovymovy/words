                        "form": "die Interoperabilität"
                    },
                    {
                        "form_id": "62695d9d-a0bb-403d-8ae5-f85c49db7720",
                        "entry_id": "53802dbf-25e8-315c-8bfd-e9538f6633c4",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Interoperabilitäten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "95e1c5e8-c600-3992-bf06-e86175c89941",
                        "entry_id": "53802dbf-25e8-315c-8bfd-e9538f6633c4",
                        "glosses": [
                            "Fähigkeit der Zusammenarbeit von verschiedenen Systemen, Techniken oder Organisationen; insbesondere möglichst nahtloses Zusammenarbeiten, um Informationen auf effiziente und verwertbare Art und Weise auszutauschen beziehungsweise den Benutzern zur Verfügung zu stellen"
                        ],
                        "tags": [
                            "Plural selten"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "dc8525c2-e5c4-31c3-a4ea-b1533ef6033f",
                        "entry_id": "53802dbf-25e8-315c-8bfd-e9538f6633c4",
                        "glosses": [
                            "Konstellation, in der mehrere Programme dasselbe Protokoll beziehungsweise dieselben Protokolle oder Datenformate verwenden können"
                        ],
                        "tags": [
                            "Plural selten"
                        ],
                        "examples": [
                            {
                                "example_id": "d0236e01-14a0-42df-b649-8a14fd49d45d",
                                "sense_id": "dc8525c2-e5c4-31c3-a4ea-b1533ef6033f",
                                "text": "…“der große Erfolg des Internets beruht schließlich darauf, dass die offenen Internetprotokolle eine maximale Interoperabilität ermöglichen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "38e8b325-9745-4092-80e3-5080aa1e14d6",
                        "source_entry_id": "53802dbf-25e8-315c-8bfd-e9538f6633c4",
                        "source_sense_id": "95e1c5e8-c600-3992-bf06-e86175c89941",
                        "target_lang_word": "interoperability",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "interoperability",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1389a030-eff4-394a-ae1f-dcc3acef4a34",
                                        "entry_id": "e028f235-32ac-3315-aef4-7d3e48916807",
                                        "glosses": [
                                            "The capability of a product or system, to interact and function with others reciprocally."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f001c7b-5f2d-4277-827f-1afd276dfceb",
                                                "sense_id": "1389a030-eff4-394a-ae1f-dcc3acef4a34",
                                                "text": "The commission found that by withholding vital information about Windows, the company deliberately restricted interoperability between personal computers using Windows and computer servers running software from Microsoft's rivals."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ea9ee62-a82d-3f18-88d4-92d6ec3e502f",
                                        "entry_id": "e028f235-32ac-3315-aef4-7d3e48916807",
                                        "glosses": [
                                            "The capacity for a service, piece of equipment etc., to be operated by different forces or groups."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a40a298f-cea8-440e-8881-8d8da5b4dba2",
                                                "sense_id": "0ea9ee62-a82d-3f18-88d4-92d6ec3e502f",
                                                "text": "Dr Fox and Mr Morin have ruled out the notion of binational crews, but they are still exploring other ways to enhance the interoperability of France’s Charles de Gaulle and Britain’s planned two new carriers, which seem likely to be spared by the defence review."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "593c2a81-3fee-4528-9706-b97921d80df1",
                        "source_entry_id": "53802dbf-25e8-315c-8bfd-e9538f6633c4",
                        "source_sense_id": "95e1c5e8-c600-3992-bf06-e86175c89941",
                        "target_lang_word": "inter-operability",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "f376ed17-55e4-4643-84e6-cc3e79698c81",
                        "source_entry_id": "53802dbf-25e8-315c-8bfd-e9538f6633c4",
                        "source_sense_id": "95e1c5e8-c600-3992-bf06-e86175c89941",
                        "target_lang_word": "interopérabilité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "interopérabilité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3d41f2d1-bb90-3008-896f-16cf074500e8",
                                        "entry_id": "b834c15a-6700-327e-8095-ad5fd45f7ad7",
                                        "glosses": [
                                            "Capacité que possède un produit ou un système, dont les interfaces sont intégralement connues, à fonctionner avec d’autres produits ou systèmes existants ou futurs et ce sans restriction d’accès ou de mise en œuvre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fb0e050-c13a-48f9-9804-cc7a5e927f6d",
                                                "sense_id": "3d41f2d1-bb90-3008-896f-16cf074500e8",
                                                "text": "L’interopérabilité des systèmes de télépéage au sein de l’Union Européenne est apparue comme une réponse efficace aux questions posées par le développement des flux de transports internationaux."
                                            },
                                            {
                                                "example_id": "6028eeae-3e25-424a-8ce0-63c79ef68297",
                                                "sense_id": "3d41f2d1-bb90-3008-896f-16cf074500e8",
                                                "text": "Pour que le BIM puisse effectivement servir à mieux gérer les interfaces et à partager une information de meilleure qualité, il faut assurer l’interopérabilité entre les logiciels et définir des formats de données utilisables par tous."
                                            },
                                            {
                                                "example_id": "831dd5f9-8e70-4701-ae62-0bd443c957c1",
                                                "sense_id": "3d41f2d1-bb90-3008-896f-16cf074500e8",
                                                "text": "La saisie directe sur le profil d’acheteur ou, éventuellement, une interopérabilité entre le logiciel marchés et le profil d’acheteur, demeurent des possibilités."
                                            },
                                            {
                                                "example_id": "b20e61a8-85cc-4a18-90e7-3594a1b6dce0",
                                                "sense_id": "3d41f2d1-bb90-3008-896f-16cf074500e8",
                                                "text": "L'utilisation du langage XML, est maintenant incontournable pour tous les créateurs d'applications multimédia. En effet, sa simplicité, sa souplesse et surtout son interopérabilité en font un langage universel permettant à la fois de structurer et d'échanger des informations, quel que soit le type de machine ou d'application."
                                            },
                                            {
                                                "example_id": "7bb00201-d6ef-4acd-8003-1f7c232c8be9",
                                                "sense_id": "3d41f2d1-bb90-3008-896f-16cf074500e8",
                                                "text": "Dans un contexte où les éditeurs de logiciels Bim se disputent les faveurs des acteurs du Bâtiment, la question de l’interopérabilité est plus que jamais d’actualité."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a0f9dfab-a80a-4989-98e4-d8fa35c9b933",
                        "source_entry_id": "53802dbf-25e8-315c-8bfd-e9538f6633c4",
                        "source_sense_id": "95e1c5e8-c600-3992-bf06-e86175c89941",
