                "senses": [
                    {
                        "sense_id": "068e4377-febe-3c56-8d41-aeee1c7dc94d",
                        "entry_id": "e5d50897-c090-3795-9e43-fcfd2b435911",
                        "glosses": [
                            "Revenir en arrière sur l’extrusion de quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20b46b79-da9f-4deb-9874-e2dee7711a29",
                                "sense_id": "068e4377-febe-3c56-8d41-aeee1c7dc94d",
                                "text": "Ce que l’on peut extruder / désextruder apparait en surbrillance (de la même couleur que le glow des arêtes du cube)."
                            },
                            {
                                "example_id": "5f542a48-2012-4503-b312-d86b4ea7ac10",
                                "sense_id": "068e4377-febe-3c56-8d41-aeee1c7dc94d",
                                "text": "À l’inverse, lorsque le joueur désextrudera, une descente de la gamme LA sera jouée."
                            },
                            {
                                "example_id": "c969edd2-467d-4685-a253-b2a3924d746f",
                                "sense_id": "068e4377-febe-3c56-8d41-aeee1c7dc94d",
                                "text": "Comme les cubes verts, ils peuvent être extrudés et désextrudés. Par contre, ils se désextrudent tout seul avec le temps!"
                            }
                        ]
                    }
