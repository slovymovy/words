                ],
                "senses": [
                    {
                        "sense_id": "82fb1e70-a1c6-364c-b701-9cb3ab87109e",
                        "entry_id": "3c6d1b49-2259-399a-a98a-866e9dc93e49",
                        "glosses": [
                            "Person, die das Kommando über eine meist größere militärische Einheit hat"
                        ],
                        "tags": [
                            "Austrian German",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "a5b81750-3271-464d-9e2c-c26d884e5f10",
                                "sense_id": "82fb1e70-a1c6-364c-b701-9cb3ab87109e",
                                "text": "„Die österreichischen UN-Soldaten sind von der derzeitigen Sicherheitslage in Syrien indirekt betroffen, der Streitkräftekommandant machte sich vor Ort ein Bild von der Situation.“"
                            },
                            {
                                "example_id": "aa49e12e-977e-4948-a159-4816039c09fe",
                                "sense_id": "82fb1e70-a1c6-364c-b701-9cb3ab87109e",
                                "text": "„Ob beim Eurofighter-Kauf krumme Dinge gelaufen sind, dass müsse die Justiz klären, sagt der scheidende Streitkräftekommandant.“"
                            },
                            {
                                "example_id": "28f2bde2-34fc-4eb9-a9ab-9888837c0182",
                                "sense_id": "82fb1e70-a1c6-364c-b701-9cb3ab87109e",
                                "text": "„Franz Reißner ist der zweithöchste Offizier im Heer. Der Streitkräftekommandant kritisiert die fehlende Diversität im Ressort.“"
                            },
                            {
                                "example_id": "14621398-bf1b-449a-a9fe-e71fa1eb6db2",
                                "sense_id": "82fb1e70-a1c6-364c-b701-9cb3ab87109e",
                                "text": "„Österreichische Soldaten im Auslandseinsatz sollen wegen des Coronavirus ihren Sonderurlaub nur mehr in Österreich verbringen dürfen. Das hat Streitkräftekommandant Franz Reißner in einem Befehl, der der APA vorliegt, angeordnet.“"
                            },
                            {
                                "example_id": "76d555cb-5c52-4a97-83b9-d82c75ec892a",
                                "sense_id": "82fb1e70-a1c6-364c-b701-9cb3ab87109e",
                                "text": "„Das Verteidigungsministerium ist auf der Suche nach einem neuen Streitkräftekommandanten.“"
                            },
                            {
                                "example_id": "5a76eae6-6c10-4785-89bd-44cc247745bb",
                                "sense_id": "82fb1e70-a1c6-364c-b701-9cb3ab87109e",
                                "text": "„Minister Norbert Darabos braucht das allerdings nicht zu sorgen: 53 Prozent der Befragten meinen ohnehin, dass sich das Berufsheer sowieso über kurz oder lang durchsetzen wird. Er muss jetzt für das bestehende Wehrpflichtigenheer sorgen - etwa durch die Bestellung eines neuen Streitkräftekommandanten.“"
                            },
                            {
                                "example_id": "9ee2b697-bb15-4a88-b364-4d62b9eaadd0",
                                "sense_id": "82fb1e70-a1c6-364c-b701-9cb3ab87109e",
                                "text": "„Die ANR wird angeführt von Mahamat Garfa, der bis 1994 Streitkräftekommandant unter Präsident Déby war.“"
                            },
                            {
                                "example_id": "dc696b42-a79d-4ac7-b8de-9b64e2986228",
                                "sense_id": "82fb1e70-a1c6-364c-b701-9cb3ab87109e",
                                "text": "„Nach dem Krieg wurde Kováč Streitkräftekommandant der Fallschirmspringer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
