                        "entry_id": "d5ccc851-f8fb-33c7-b115-11e471100c5f",
                        "glosses": [
                            "Living or situated remote from the seacoast."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "d88aedf8-07c5-4b31-838c-fd7c61c3b30a",
                                "sense_id": "243b0513-a120-323b-8570-d35327a5af3b",
                                "text": "Near-synonym: inland"
                            },
                            {
                                "example_id": "56a3e319-9ea8-4de4-97c2-1c059b829e36",
                                "sense_id": "243b0513-a120-323b-8570-d35327a5af3b",
                                "text": "an upcountry residence"
                            },
                            {
                                "example_id": "5b656a35-2587-4ad1-8568-46b4a207013d",
                                "sense_id": "243b0513-a120-323b-8570-d35327a5af3b",
                                "text": "The fourth company involved in the purchase, the Upper Mississippi Company (formed by Thomas Scott after he had withdrawn the bid of the Virginia Yazoo Company), apparently restricted its largess to a few upcountry Georgians."
                            }
                        ]
                    }
