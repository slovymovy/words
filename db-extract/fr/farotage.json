                        "examples": [
                            {
                                "example_id": "14c9828d-c931-433b-b7e6-1476d6499eab",
                                "sense_id": "2bf76b86-d313-3316-b476-9b6d9bceb57f",
                                "text": "— Ta façon de marcher… de te coiffer… Je croyais que c’était du farotage. — Eh, Aya, ce sont mes parent qui m’ont raté, ô."
                            },
                            {
                                "example_id": "fac70e51-1734-4845-a2ab-9fa4b0bab9d8",
                                "sense_id": "2bf76b86-d313-3316-b476-9b6d9bceb57f",
                                "text": "Bosso... Ce sont des foutaises! Les vrais faits c’est pas comme ça, eh ! Moi-même y’ai vu la vérité. Ils ont même pas de quoi daba, mais c’est dur pour eux donc farotage devient leur profession."
                            }
                        ]
                    },
