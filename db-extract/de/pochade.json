                "senses": [
                    {
                        "sense_id": "ac10cf19-0e7a-3a74-92b2-b835f6cf251c",
                        "entry_id": "108f2007-dd13-3834-84d0-c4f47e12604c",
                        "glosses": [
                            "eine mittels weniger, markanter Pinselstriche angefertigte farbige (Entwurfs-)Zeichnung, die für sich selbst genommen schon als Werk gilt und somit nicht als Vorentwurf beziehungsweise Vorskizze einer detaillierteren (noch auszuarbeitenden) bildlichen Darstellung dient"
                        ],
                        "tags": [
                            "Kunstwissenschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "d1253ac1-06a3-479d-ae21-bf95c9cbb77a",
                                "sense_id": "ac10cf19-0e7a-3a74-92b2-b835f6cf251c",
                                "text": "Pochaden wurden früher als Gekritzel und Gekrakel verschrien."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "faa45618-702a-3360-ba3c-e695e1b121ef",
                        "entry_id": "108f2007-dd13-3834-84d0-c4f47e12604c",
                        "glosses": [
                            "flüchtig ausgeführte Arbeit"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [],
                        "sense_index_json": "\"2a\""
                    },
                    {
                        "sense_id": "884590ac-30af-3b4b-b233-29508ee13442",
                        "entry_id": "108f2007-dd13-3834-84d0-c4f47e12604c",
                        "glosses": [
                            "literarisches beziehungsweise musikalisches Erzeugnis, durch das etwas versucht wird"
                        ],
                        "tags": [
                            "im übertragenen Sinne",
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "14a19c4b-be9d-47d6-ac41-f67735421ad6",
                                "sense_id": "884590ac-30af-3b4b-b233-29508ee13442",
                                "text": "Eine der bekanntesten literarischen Pochaden ist die „Pochade Radiophonique“ von Samuel Beckett."
                            }
                        ],
                        "sense_index_json": "\"2b\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "07c5f4a9-1ac6-4b24-8e77-6ed92c8ba629",
                        "source_entry_id": "108f2007-dd13-3834-84d0-c4f47e12604c",
                        "source_sense_id": "ac10cf19-0e7a-3a74-92b2-b835f6cf251c",
                        "source_sense_description": "Zeichnung",
                        "target_lang_word": "pochade",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pochade",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fc593b85-47ca-35fd-8d8a-3caf865176a7",
                                        "entry_id": "83f57d7c-43d7-3322-8c56-166ac09f4135",
                                        "glosses": [
                                            "A rough sketch."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37eee547-5580-4142-afb4-70346b31e4f1",
                                                "sense_id": "fc593b85-47ca-35fd-8d8a-3caf865176a7",
                                                "text": "In despair, he finally painted a pochade of people leaving the church of Saint-François, in the village of the same name."
                                            },
                                            {
                                                "example_id": "7e8e0784-98b3-40bc-b9c9-200dd5e401b3",
                                                "sense_id": "fc593b85-47ca-35fd-8d8a-3caf865176a7",
                                                "text": "This painting was very small, not even a study but a pochade — no more than a first idea jotted down in paint."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f39b4c68-f4e5-49ec-8eb3-4f6c3f4376f7",
                        "source_entry_id": "108f2007-dd13-3834-84d0-c4f47e12604c",
                        "source_sense_id": "ac10cf19-0e7a-3a74-92b2-b835f6cf251c",
                        "source_sense_description": "Zeichnung",
                        "target_lang_word": "pochade",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pochade",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dcaeb384-e1e4-3c79-b738-fa2a2eeb7a2a",
                                        "entry_id": "6baa5bd4-d5b0-3f85-a045-6edbd71de32e",
                                        "glosses": [
                                            "Croquis enlevé de verve et destiné à fixer une impression."
                                        ],
                                        "tags": [
                                            "Peinture"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d4d8e78-2a6a-4f1f-b681-4151a10f9063",
                                                "sense_id": "dcaeb384-e1e4-3c79-b738-fa2a2eeb7a2a",
                                                "text": "Ce n’est qu’une pochade."
                                            },
                                            {
                                                "example_id": "43b1c470-7fca-459d-ada1-6a0a5ab9044e",
                                                "sense_id": "dcaeb384-e1e4-3c79-b738-fa2a2eeb7a2a",
                                                "text": "Les petites filles ont des bonnets aussi développés que ceux de leurs grand-mères, ce qui leur donne l’air de ces gamins turcs à tête énorme et à corps fluet des pochades de Decamps."
                                            },
                                            {
                                                "example_id": "16047c8e-6677-4005-aec0-35fb6e2fd762",
                                                "sense_id": "dcaeb384-e1e4-3c79-b738-fa2a2eeb7a2a",
                                                "text": "Son regard, errant sur les murs jaunis, s’arrêtait à des pochades familières, à des tableautins sans cadres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "426538d2-fb27-3200-a3bb-30d54d5ba892",
                                        "entry_id": "6baa5bd4-d5b0-3f85-a045-6edbd71de32e",
                                        "glosses": [
                                            "Œuvre rapide et seulement ébauchée."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
