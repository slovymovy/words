                    },
                    {
                        "translation_id": "ee721995-bfe0-42b8-9836-c8febac341e2",
                        "source_entry_id": "e7b26c96-3fc3-33e9-8bb8-b52331b0d855",
                        "source_sense_description": "часть растения, запасающая питательные вещества",
                        "target_lang_word": "Wurzelknolle",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "96f52ba5-ac3e-4216-8950-2fc9d3bfe9d0",
                        "source_entry_id": "e7b26c96-3fc3-33e9-8bb8-b52331b0d855",
                        "source_sense_description": "часть растения, запасающая питательные вещества",
                        "target_lang_word": "racine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "racine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d5881ce2-13cb-3d89-9040-0964730aff4b",
                                        "entry_id": "cb81cb13-ddb6-32ee-a982-b1561541bdd6",
                                        "glosses": [
                                            "Organe végétal, généralement souterrain, assurant l’absorption de l’eau et des sels minéraux, la fixation de la plante à son support et parfois le stockage de réserves. Certaines racines peuvent être aériennes, aquatiques ou spécialisées."
                                        ],
                                        "tags": [
                                            "Anatomie végétale",
                                            "Biologie végétale"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41676bda-cd59-43e1-bf5d-e621622023a5",
                                                "sense_id": "d5881ce2-13cb-3d89-9040-0964730aff4b",
                                                "text": "Ce chêne se cramponne au sol pierreux par des racines longues, à moitié hors de la terre, noueuses, couvertes de mousse, et semblables à de grands serpents endormis."
                                            },
                                            {
                                                "example_id": "4e866357-dfe2-4c6b-b21a-c72ca7368ec8",
                                                "sense_id": "d5881ce2-13cb-3d89-9040-0964730aff4b",
                                                "text": "La phytodisponibilité d’un élément-trace est sa capacité à être transféré dans la plante durant son développement, soit par les racines à partir du sol, soit par les parties aériennes pour les particules en suspension dans l’air."
                                            },
                                            {
                                                "example_id": "f4a43320-3748-4f26-89ac-df4bd1dbb7af",
                                                "sense_id": "d5881ce2-13cb-3d89-9040-0964730aff4b",
                                                "text": "Pour dormir ils étaient obligés de se hisser sur les racines de mangliers qui abondaient dans cette région."
                                            },
                                            {
                                                "example_id": "41cb4527-bc39-45c1-a005-c6ab4394cf67",
                                                "sense_id": "d5881ce2-13cb-3d89-9040-0964730aff4b",
                                                "text": "Quel que soit l’instrument employé, la section doit toujours être faite rez sol, afin que les rejets qui se développent soient bien assis sur la souche, et puissent émettre des racines qui concourreront dans une large mesure à leur nutrition."
                                            },
                                            {
                                                "example_id": "1234af01-cf1c-467d-b0e7-8acfcdf32a2f",
                                                "sense_id": "d5881ce2-13cb-3d89-9040-0964730aff4b",
                                                "text": "Ces sortes d’arbres jettent, poussent de profondes racines."
                                            },
                                            {
                                                "example_id": "c577c0f9-b88a-4a12-8a8e-a5db9451a15d",
                                                "sense_id": "d5881ce2-13cb-3d89-9040-0964730aff4b",
                                                "text": "Les racines de certains arbres courent sous la terre, s’étendent bien loin sous terre."
                                            },
                                            {
                                                "example_id": "16a4b711-093b-4ce3-943e-0f783b9489f3",
                                                "sense_id": "d5881ce2-13cb-3d89-9040-0964730aff4b",
                                                "text": "Ce plant avait été coupé, il a repoussé de racine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8334dcb8-6ddd-3a87-8ab4-5f6e9c45efbb",
                                        "entry_id": "cb81cb13-ddb6-32ee-a982-b1561541bdd6",
                                        "glosses": [
                                            "Racine de certains arbres dont on fait des ouvrages d’ébénisterie et de tour."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fcf6b1c5-34cd-4e87-bfe4-62294e87435b",
                                                "sense_id": "8334dcb8-6ddd-3a87-8ab4-5f6e9c45efbb",
                                                "text": "Un meuble de racine d’orme, d’if, d’olivier, etc."
                                            },
                                            {
                                                "example_id": "5da541ea-cae0-44ce-a670-e9602fb3181b",
                                                "sense_id": "8334dcb8-6ddd-3a87-8ab4-5f6e9c45efbb",
                                                "text": "Une botte de racine de buis."
                                            },
                                            {
                                                "example_id": "678e6e62-bf6f-46db-b86c-771144258bb4",
                                                "sense_id": "8334dcb8-6ddd-3a87-8ab4-5f6e9c45efbb",
                                                "text": "C’est du buis de racine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c354aee-7b7e-3ac1-ae25-c1b0d190f305",
                                        "entry_id": "cb81cb13-ddb6-32ee-a982-b1561541bdd6",
                                        "glosses": [
                                            "Plante, telle que les raves, les betteraves, les carottes, les navets, etc., dans lesquelles ce qui est comestible est ce qui vient en terre."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "944a7087-7a1e-4879-b8a7-4ef2dd1f0dc2",
                                                "sense_id": "0c354aee-7b7e-3ac1-ae25-c1b0d190f305",
                                                "text": "A la même époque, Malcolm Flemyng, médecin à Édimbourg, recommande lui aussi, en 1760, de manger avec frugalité, de préférence une alimentation monotone, riche en légumes, racines et verdure, mais sans adjonction de beurre, de tromper sa faim en se remplissant l’estomac de fruits de saison […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e02b7bec-995d-3e41-950d-ee480876e3f4",
                                        "entry_id": "cb81cb13-ddb6-32ee-a982-b1561541bdd6",
                                        "glosses": [
                                            "Partie des ongles, des dents, des cheveux, des poils par où ils tiennent à la chair."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4576b350-fc03-44e1-b402-284f80299b6f",
                                                "sense_id": "e02b7bec-995d-3e41-950d-ee480876e3f4",
                                                "text": "Vers la racine, le poil de rétrécit régulièrement et les extrémités libres sont légèrement renflées ou obtuses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b1c9797-f564-3f97-9752-548d1aa5f83e",
                                        "entry_id": "cb81cb13-ddb6-32ee-a982-b1561541bdd6",
                                        "glosses": [
                                            "Point par lequel un nerf tient au cerveau ou à la moelle épinière."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1465bfac-9464-3e74-9211-fe764a42f515",
                                        "entry_id": "cb81cb13-ddb6-32ee-a982-b1561541bdd6",
                                        "glosses": [
                                            "Principe du commencement de certaines choses ; origine."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2337eb6-67ac-4123-98c1-c2d265d8e082",
                                                "sense_id": "1465bfac-9464-3e74-9211-fe764a42f515",
                                                "text": "Le dogme de l’incurable méchanceté de l'homme a, d'ailleurs, chez certains de ses adeptes, une autre racine : un plaisir romantique à évoquer la race humaine murée dans une misère fatale et éternelle."
                                            },
                                            {
                                                "example_id": "5b29dd95-7c35-42cb-ad44-9afb3900d388",
                                                "sense_id": "1465bfac-9464-3e74-9211-fe764a42f515",
                                                "text": "Bien qu'il plonge ses racines dans le zen, le chanoyu ne prône donc pas de doctrine religieuse. Il faut plutôt le considérer comme l'amalgame d'un vaste ensemble d'idéaux philosophiques et esthétiques […]."
                                            },
                                            {
                                                "example_id": "cfa92120-ba2f-4b9c-b37f-a60a077199de",
                                                "sense_id": "1465bfac-9464-3e74-9211-fe764a42f515",
                                                "text": "La racine indienne est ainsi un élément constitutif du nous majoritaire, et c’est sur cette organisation spécifique de l’altérité que les idées multiculturelles se greffent."
                                            },
                                            {
                                                "example_id": "0acb9301-0cf1-4a8a-9656-72f80d017f52",
                                                "sense_id": "1465bfac-9464-3e74-9211-fe764a42f515",
                                                "text": "La coupe que j'ai donnée alors des environs de Roche-de-Vic pourrait aujourd'hui s'interpréter très aisément comme un pli couché dont la racine serait au Sud-Ouest et qui viendrait passer sur les roches écrasées d’Argentat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05e3ce9c-89ec-3935-8e62-57cf402c1af4",
                                        "entry_id": "cb81cb13-ddb6-32ee-a982-b1561541bdd6",
                                        "glosses": [
                                            "Mot primitif, d’où dérivent d’autres mots ; la plus petite et plus ancienne unité lexicale qui permette de former des mots apparentés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56420b96-fc3e-4d83-99b7-f90fe5f59054",
                                                "sense_id": "05e3ce9c-89ec-3935-8e62-57cf402c1af4",
                                                "text": "Le mot Front en français est la racine des mots Frontal, Frontière, Frontispice, Affronter, Effronté, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "acb7106b-5bce-3e58-a919-3597bb3263b9",
                                        "entry_id": "cb81cb13-ddb6-32ee-a982-b1561541bdd6",
                                        "glosses": [
                                            "Mot primitif, d’où dérivent d’autres mots ; la plus petite et plus ancienne unité lexicale qui permette de former des mots apparentés.",
                                            "Racine trilittérale : Groupe de trois consonnes d'où dérivent d'autres mots dans les langues sémitiques en particulier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b4bdcbc-a397-4d53-a3cf-0a2667413ab2",
                                                "sense_id": "acb7106b-5bce-3e58-a919-3597bb3263b9",
                                                "text": "Son nom^([Idriss]) – construit sur la racine trilittérale d. r. s. – évoque les notions d'étude et d'enseignement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d9c1fc8-c323-36a5-a6e0-673fd5b7d6d8",
                                        "entry_id": "cb81cb13-ddb6-32ee-a982-b1561541bdd6",
                                        "glosses": [
                                            "Étymon."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8ef6a902-09a2-3a77-be15-eaef4b21af01",
                                        "entry_id": "cb81cb13-ddb6-32ee-a982-b1561541bdd6",
                                        "glosses": [
                                            "Valeur d'une fonction pour laquelle cette dernière s'annule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "680766c0-3dd7-4985-935c-fe7d752f2d69",
                                                "sense_id": "8ef6a902-09a2-3a77-be15-eaef4b21af01",
                                                "text": "Lorsque le discriminant est strictement positif, la fonction admet deux racines."
                                            },
                                            {
                                                "example_id": "2f03d3d7-649b-40cb-a2b1-20da415a1d57",
                                                "sense_id": "8ef6a902-09a2-3a77-be15-eaef4b21af01",
                                                "text": "Dans ce chapitre, nous énonçons uniquement des résultats d'intégralité pour les coefficients de Taylor de racines de coordonnées canoniques.",
                                                "translation": "Éric Delaygue, Propriétés arithmétiques des applications miroir, Institut Fourier, 2011, page 17"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09bba628-45af-34da-978c-39d1cc933d5d",
                                        "entry_id": "cb81cb13-ddb6-32ee-a982-b1561541bdd6",
                                        "glosses": [
                                            "Nombre déduit d’un autre, de telle sorte que le second soit une puissance du premier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b2d95a2-bd0b-45aa-a484-aca25e72ac14",
                                                "sense_id": "09bba628-45af-34da-978c-39d1cc933d5d",
                                                "text": "Trois est la racine carrée de neuf."
                                            },
                                            {
                                                "example_id": "b557d6dd-79ae-4cf7-bb51-a26fb421cd1f",
                                                "sense_id": "09bba628-45af-34da-978c-39d1cc933d5d",
                                                "text": "Trois est la racine cubique de vingt-sept."
                                            },
                                            {
                                                "example_id": "6d996028-1af7-419c-a9c1-09beb9a827b5",
                                                "sense_id": "09bba628-45af-34da-978c-39d1cc933d5d",
                                                "text": "Extraire la racine carrée, la racine cubique d’un nombre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab3a1e6e-6341-370c-aa3f-26b828cb7b8a",
                                        "entry_id": "cb81cb13-ddb6-32ee-a982-b1561541bdd6",
                                        "glosses": [
                                            "Élément (« nœud ») de base d’une structure arborescente (« arbre »), qui n’a lui-même aucun nœud parent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df265c96-ebcc-48ca-8e21-c922f56eb3b9",
                                                "sense_id": "ab3a1e6e-6341-370c-aa3f-26b828cb7b8a",
                                                "text": "On peut alors reformuler la définition formelle d’un arbre de la manière suivante : il y a exactement un seul chemin entre la racine et chacun des autres nœuds de l’arbre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93d2e016-4444-30f2-ad06-e71b18f45d45",
                                        "entry_id": "cb81cb13-ddb6-32ee-a982-b1561541bdd6",
                                        "glosses": [
                                            "Répertoire de base d’un système de fichiers."
                                        ],
                                        "tags": [
                                            "specifically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c70fed2e-f074-4d2d-999c-458af9f10b40",
                                                "sense_id": "93d2e016-4444-30f2-ad06-e71b18f45d45",
                                                "text": "La racine d’un disque dur."
                                            }
                                        ]
                                    }
