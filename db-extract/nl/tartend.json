                "senses": [
                    {
                        "sense_id": "23f178ef-4a8e-3f52-9c08-cc88c18d07b5",
                        "entry_id": "55fb202e-d885-3f25-8f6b-32d552f3961d",
                        "glosses": [
                            "van iets dat men weet dat het op tegenstand kan rekenen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0fad05e-2d98-4965-af37-c22ec86512bc",
                                "sense_id": "23f178ef-4a8e-3f52-9c08-cc88c18d07b5",
                                "text": "De vakbonden hebben geen goed woord over voor dit voorstel. „Een het rechtsgevoel tartende vergroving ten nadele van de werknemer.”"
                            },
                            {
                                "example_id": "6dde0f8d-72df-45af-b5df-ca64b3c595c1",
                                "sense_id": "23f178ef-4a8e-3f52-9c08-cc88c18d07b5",
                                "text": "Hoog boven een riviervallei lijkt deze zwaartekracht tartende boomhut bijna lijkt op een futuristisch schip tussen eeuwenoude bomen. De cabine is toegankelijk via een brug die dwars door de bosbodem loopt en binnen in de cabin staat het bed centraal, zodat het prachtige panorama het eerste is wat je ziet als je wakker wordt."
                            }
                        ]
                    }
