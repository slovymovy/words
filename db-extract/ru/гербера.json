                "senses": [
                    {
                        "sense_id": "9a75571d-a4b4-3612-8801-1fea6b1018ff",
                        "entry_id": "f7274f5b-389c-3688-93af-afb530bddc60",
                        "glosses": [
                            "род многолетних трав семейства астровых"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6002ac04-2361-4b21-83f4-f1ea16e44677",
                                "sense_id": "9a75571d-a4b4-3612-8801-1fea6b1018ff",
                                "text": "Повезло в цветочном магазине, куда только что привезли болгарские герберы .."
                            },
                            {
                                "example_id": "6cfe1515-1ec8-45ce-adee-68e33c834713",
                                "sense_id": "9a75571d-a4b4-3612-8801-1fea6b1018ff",
                                "text": "Он покупал Светочке огромные букеты голландских роз и тюльпанов, клумбы гербер и вёдра декоративных ромашек."
                            },
                            {
                                "example_id": "56fa5618-c2bb-4936-8236-c986af51b144",
                                "sense_id": "9a75571d-a4b4-3612-8801-1fea6b1018ff",
                                "text": "Хорошим подарком для учителя станет букет из таких традиционно популярных цветов, как розы, хризантемы, герберы, каллы."
                            }
                        ]
                    }
