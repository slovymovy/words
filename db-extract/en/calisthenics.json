                                        "entry_id": "44d998b4-4281-35d4-ba7b-db162725ab6f",
                                        "glosses": [
                                            "rodzaj treningu siłowego, wykonywanego w oparciu o ćwiczenia wykorzystujące ciężar własnego ciała"
