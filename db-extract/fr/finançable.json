                                        "examples": [
                                            {
                                                "example_id": "738f3b40-d882-4084-abff-bc4e5ca63a12",
                                                "sense_id": "2c967b49-6e61-3db3-833b-bb048b4b40f9",
                                                "text": "„Auch andere Experten, etwa vom ifo-Institut, und die Bundesvereinigung der Deutschen Arbeitgeberverbände (BDA) schließen sich der Auffassung an, dass die gesetzliche Rentenversicherung ohne eine Anpassung der Lebensarbeitszeit an die zunehmende Lebenserwartung auf Dauer nicht finanzierbar ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8423f179-c642-4df7-a6fb-55e13a3404df",
                        "source_entry_id": "05da8cc8-1eb1-3e45-939d-24989370646b",
                        "source_sense_id": "4457a996-33b1-3285-8cce-7f9e3491ee11",
                        "target_lang_word": "financeable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
