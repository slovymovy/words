    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "385aec56-f43f-3633-9788-140798899187",
                    "sense_definition": "ergens vandaan vertrekken of weggaan",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vertrek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij besloot om vroeg <w>heen</w> te <w>gaan</w> omdat hij nog veel werk had.",
                            "target_lang_translations": {
                                "ru": "Он решил <w>уйти</w> пораньше, так как у него было еще много работы.",
                                "en": "He decided to <w>leave</w> early because he still had a lot of work."
                            }
                        },
                        {
                            "text": "Zij <w>ging</w> rustig <w>heen</w> en keek niet meer om naar het huis.",
                            "target_lang_translations": {
                                "ru": "Она спокойно <w>ушла</w> и больше не оглядывалась на дом.",
                                "en": "She <w>departed</w> quietly and didn't look back at the house again."
                            }
                        }
                    ],
                    "common_phrases": [
                        "heen en weer gaan",
                        "vroeg heengaan"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vaak gebruikt in formele of plechtige context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "уходить или отправляться откуда-либо",
                        "en": "to depart or leave from somewhere"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уходить",
                                "target_lang_sense_clarification": "покидать место"
                            },
                            {
                                "target_lang_word": "отправляться",
                                "target_lang_sense_clarification": "начинать путь"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "leave",
                                "target_lang_sense_clarification": "to go away from a place"
                            },
                            {
                                "target_lang_word": "depart",
                                "target_lang_sense_clarification": "to leave, especially to start a journey"
                            },
                            {
                                "target_lang_word": "go away",
                                "target_lang_sense_clarification": "to leave a person or place"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "10b1df89-750c-3cb6-9788-8e2103d2e378",
                    "sense_definition": "op een zachte of plechtige manier sterven",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "overlijden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na een lang en gelukkig leven is onze grootvader rustig <w>heengegaan</w>.",
                            "target_lang_translations": {
                                "ru": "После долгой и счастливой жизни наш дедушка мирно <w>ушел из жизни</w>.",
                                "en": "After a long and happy life, our grandfather has quietly <w>passed away</w>."
                            }
                        },
                        {
                            "text": "Zij is in haar slaap <w>heengegaan</w> omringd door haar familie.",
                            "target_lang_translations": {
                                "ru": "Она <w>скончалась</w> во сне в окружении своей семьи.",
                                "en": "She <w>passed</w> in her sleep surrounded by her family."
                            }
                        }
                    ],
                    "synonyms": [
                        "overlijden"
                    ],
                    "common_phrases": [
                        "rustig heengaan",
                        "in vrede heengaan"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "eufemisme voor sterven"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "тихо или торжественно умереть",
                        "en": "to die in a gentle or solemn way"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уйти из жизни",
