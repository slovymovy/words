                    {
                        "sense_id": "4592afe1-f420-3fc1-8c28-be412e77650d",
                        "entry_id": "bc3944b8-d11b-354b-bb1c-303617e8eb2d",
                        "glosses": [
                            "Eiweißstoff (Protein), der für einen Kern eine Ummantelung (Hülle) bildet, oftmals mit Eigenschaften, die den Kern eines Mikroorganismus sicherer vor Zerstörung durch Abwehrreaktionen/Umwelteinflüsse macht"
                        ],
                        "tags": [
                            "Genetik"
                        ],
                        "examples": [
                            {
                                "example_id": "b001b2a1-296a-4f5f-8566-2fde5709ee4b",
                                "sense_id": "4592afe1-f420-3fc1-8c28-be412e77650d",
                                "text": "In dieser Darstellung sind die Zellkerne blau und das Hüllprotein wurde mit Rhodamin rot gefärbt."
                            },
                            {
                                "example_id": "d3cff178-c896-4afd-b95f-a2bc112c351d",
                                "sense_id": "4592afe1-f420-3fc1-8c28-be412e77650d",
                                "text": "„Durch physikalische Kartierung und Sequenzierung wurde auch ein cDNA-Fragment gefunden, welches das komplette Gen für das Hüllprotein von PPV-AT enthält.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
