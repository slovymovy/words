    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "ee689523-eca3-31cb-976a-437a241314d2",
                "word": "kibitzer",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "7ca6b1af-21f2-4f52-985a-212b988466d0",
                        "entry_id": "ee689523-eca3-31cb-976a-437a241314d2",
