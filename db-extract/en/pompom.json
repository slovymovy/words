    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "d9428732-c354-3e11-8023-19ba8c8fae92",
                "word": "pompom",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "4a82a602-2244-40a6-a459-9141f0478519",
                        "entry_id": "d9428732-c354-3e11-8023-19ba8c8fae92",
                        "tags": [
                            "plural"
                        ],
                        "form": "pompoms"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cc17a96a-4863-31a9-9802-a56fc39e7bba",
                        "entry_id": "d9428732-c354-3e11-8023-19ba8c8fae92",
                        "glosses": [
                            "A decorative ball made of pieces of soft fabric, tinsel, plastic, or paper streamers bound at the center, most notably held, waved, and shaken in cheerleading."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "32c4c894-694b-3e18-a475-90dc9d31cdef",
                        "entry_id": "d9428732-c354-3e11-8023-19ba8c8fae92",
                        "glosses": [
                            "A small, fluffy ball made of soft fabric, used in arts and crafts or as colorful elements in clothing or accessories."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f29f92c8-5813-4b98-bdfd-8074740782f7",
                        "source_entry_id": "d9428732-c354-3e11-8023-19ba8c8fae92",
                        "source_sense_description": "decorative ball made of pieces of soft fabric",
                        "target_lang_word": "pompom",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pompom",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "73ca9bea-6ad3-37a2-872d-59a3b94b9957",
                                        "entry_id": "f20d1fa5-7408-3244-911c-4228e10166bc",
                                        "glosses": [
                                            "nodeloos lawaai en ophef"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13529b81-f5fa-4275-8f17-3ca594958643",
                                                "sense_id": "73ca9bea-6ad3-37a2-872d-59a3b94b9957",
                                                "text": "Naast de 300.000 huizen zijn er ook een pak appartementsgebouwen die zo goed als leeg staan. In Cork werd twee jaar geleden the Elysee met veel pompom geopend."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7640dcc5-a5b2-3756-bfeb-f12f0e5abb74",
                                        "entry_id": "f20d1fa5-7408-3244-911c-4228e10166bc",
                                        "glosses": [
                                            "snelvurend kanon m.n. als luchtafweerkanon"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1fa26e41-9aa2-4ee9-a466-3c38331b3a38",
                                                "sense_id": "7640dcc5-a5b2-3756-bfeb-f12f0e5abb74",
                                                "text": "De Pom-pom of Nordenfeldt-Maximspeelde een groote rol in dezen oorlog; maar ik denk dat men aan dit veldstuk een al te groote waarde heeft gehecht. Het pompom-kanon schopt een helsch lawaai op, wanneer het werkt en dit heeft misschien een demoraliseerenden invloed op den vijand; maar hier eindigen dan ook zijn deugden, want zijn uitwerking beteekent niets."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "77fe5d00-432d-4c87-bc72-dddd22357250",
                        "source_entry_id": "d9428732-c354-3e11-8023-19ba8c8fae92",
                        "source_sense_description": "decorative ball made of pieces of soft fabric",
                        "target_lang_word": "pompon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pompon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "044747b7-8885-337c-a195-07dce513fb74",
                                        "entry_id": "f20c7b46-8291-3353-ab8c-5f0ce63054f0",
                                        "glosses": [
                                            "Ornement en forme de houppe, de boule et qui sert dans la toilette et dans l’ameublement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f44c1029-9094-43cb-a4d4-6835f5cccdbf",
                                                "sense_id": "044747b7-8885-337c-a195-07dce513fb74",
                                                "text": "[…] de longues files d’ânes blanchâtres portant de la paille hachée, ficelée avec des résilles de cordelettes ; et c’est tout : l’âne qui marche en tête, l’âne coronel, a toujours un petit plumet ou un pompon qui marque sa supériorité dans la hiérarchie de la gent à longues oreilles."
                                            },
                                            {
                                                "example_id": "0b81a4ab-8cb5-407d-8e79-19ba8110027a",
                                                "sense_id": "044747b7-8885-337c-a195-07dce513fb74",
                                                "text": "Les brides et les bâts des chameaux étaient tout parés de perles brillantes et de pompons multicolores."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28fd5084-206f-3d0c-a771-e21b5c43989b",
                                        "entry_id": "f20c7b46-8291-3353-ab8c-5f0ce63054f0",
                                        "glosses": [
                                            "Houppe de laine en forme de boule que les militaires portaient à leur képi de grande tenue et d’un ornement de même genre que les marins de l’État portent encore à leur béret."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bb1ca952-c5d6-397f-a3f3-c251ec0984e2",
                                        "entry_id": "f20c7b46-8291-3353-ab8c-5f0ce63054f0",
                                        "glosses": [
                                            "Boule de laine en haut d’un bonnet, d’une tuque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4851fd24-693d-44dd-9ebf-b76c3211ae65",
                                                "sense_id": "bb1ca952-c5d6-397f-a3f3-c251ec0984e2",
                                                "text": "On pouvait y apercevoir au sol du matériel de premiers soins, un paquet de cigarettes, un briquet vert et une tuque d’hiver à pompon noire, jaune et blanche."
                                            },
                                            {
                                                "example_id": "7ba9a96c-b9d8-4252-a00a-c026af125e48",
                                                "sense_id": "bb1ca952-c5d6-397f-a3f3-c251ec0984e2",
                                                "text": "Cabaïa, la marque originalement spécialisée dans le bonnet aux pompons interchangeables, a lancé sa gamme de sacs en se basant sur les envies de ses clients."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cbfc7604-7479-32c3-9deb-9166670386f6",
                                        "entry_id": "f20c7b46-8291-3353-ab8c-5f0ce63054f0",
                                        "glosses": [
                                            "Activité, manière d'être ou de faire, comparée à un ornement agréable mais de peu de fonds."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21c79b3d-42e7-400e-ab84-938d9b07ff96",
                                                "sense_id": "cbfc7604-7479-32c3-9deb-9166670386f6",
                                                "text": "Notre frivole aréopage\nDonne des lois à vos héros,\nEt des pompons du badinage\nNous semons vos graves bureaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1476c02-ba88-366c-b7de-3f4e20252c9e",
                                        "entry_id": "f20c7b46-8291-3353-ab8c-5f0ce63054f0",
                                        "glosses": [
                                            "Houppe de laine suspendue et balancée au-dessus d’un manège forain, donnant droit à un tour gratuit supplémentaire à l’enfant qui parvient à le décrocher (voir expression ci-dessous)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9a304355-fc2e-355e-9a72-5e3c1a6676bd",
                                        "entry_id": "f20c7b46-8291-3353-ab8c-5f0ce63054f0",
                                        "glosses": [
                                            "Summum ; sommet ; pire."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c953de1-dab1-4277-8e33-7cb84a8d738e",
                                                "sense_id": "9a304355-fc2e-355e-9a72-5e3c1a6676bd",
                                                "text": "C’est aussi la preuve du déclin de son auteur, le metteur en scène John Guillermin. Auteur de quelques pellicules élégantes et/ou spectaculaires dans les années 60/70, le réalisateur Britannique s’enfonçait avec les années 80 dans la nanarditude la plus complète… Le pompon étant atteint quelques années après avec le consternant King Kong 2."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58cbe64f-613f-316c-b305-253be00030f8",
                                        "entry_id": "f20c7b46-8291-3353-ab8c-5f0ce63054f0",
                                        "glosses": [
                                            "Ornement ajouté."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "314bc738-03c9-4880-8325-34ad954ef853",
                                                "sense_id": "58cbe64f-613f-316c-b305-253be00030f8",
                                                "text": "N’importe ! ce sont là de jolis souvenirs ; un peu grotesques, mais avec un petit pompon d’héroïsme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0d2b55d0-6305-4518-9515-a0c802b43fda",
                        "source_entry_id": "d9428732-c354-3e11-8023-19ba8c8fae92",
