                {
                    "sense_id": "e41d17c6-e191-3141-b086-57564446224f",
                    "sense_definition": "Een specifieke versie of druk van een literair of wetenschappelijk werk.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "publicatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de eerste <w>uitgave</w> van het boek stond een typfout die later is verbeterd.",
                            "target_lang_translations": {
                                "en": "There was a typo in the first <w>edition</w> of the book that was later corrected.",
                                "ru": "В первом <w>издании</w> книги была опечатка, которую позже исправили."
                            }
                        },
                        {
                            "text": "De verzamelaar zocht overal naar een zeldzame eerste <w>uitgave</w> van die roman.",
                            "target_lang_translations": {
                                "en": "The collector searched everywhere for a rare first <w>edition</w> of that novel.",
                                "ru": "Коллекционер повсюду искал редкое первое <w>издание</w> этого романа."
                            }
                        }
