{
    "word_family": [
        "uchylenie",
        "uchylny",
        "uchylenie"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2809bb05-72f1-36b0-a959-42b8dd03704a",
                    "sense_definition": "otwierać coś tylko częściowo",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "otwieranie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Warto <w>uchylać</w> okno w nocy, aby wpuścić świeże powietrze do sypialni.",
                            "target_lang_translations": {
                                "ru": "Полезно <w>приоткрывать</w> окно на ночь, чтобы впустить свежий воздух в спальню."
                            }
                        },
                        {
                            "text": "Kobieta <w>uchyla</w> drzwi, żeby sprawdzić, kto przyszedł z wizytą.",
                            "target_lang_translations": {
                                "ru": "Женщина <w>приоткрывает</w> дверь, чтобы проверить, кто пришел с визитом."
                            }
                        }
                    ],
                    "common_phrases": [
                        "uchylać drzwi",
                        "uchylać okno"
                    ],
                    "target_lang_definitions": {
                        "ru": "открывать что-либо лишь частично, приоткрывать"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приоткрывать",
                                "target_lang_sense_clarification": "открывать дверь или окно на небольшое расстояние"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9c659986-0f4a-3274-a399-84bbc560b82a",
                    "sense_definition": "czynić coś nieważnym lub nieobowiązującym",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "prawo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sąd może <w>uchylać</w> decyzje administracyjne, jeśli są one niezgodne z prawem.",
                            "target_lang_translations": {
                                "ru": "Суд может <w>отменять</w> административные решения, если они противоречат закону."
                            }
                        },
                        {
                            "text": "Parlament planuje <w>uchylać</w> stare przepisy, które utrudniają rozwój przedsiębiorczości.",
                            "target_lang_translations": {
                                "ru": "Парламент планирует <w>отменять</w> старые нормы, которые препятствуют развитию предпринимательства."
                            }
                        }
                    ],
                    "synonyms": [
                        "kasować",
                        "odwoływać",
                        "unieważniać"
                    ],
                    "common_phrases": [
                        "uchylać wyrok",
                        "uchylać decyzję"
                    ],
                    "target_lang_definitions": {
                        "ru": "делать что-либо недействительным или отменять действие закона, решения"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отменять",
                                "target_lang_sense_clarification": "аннулировать действие решения или закона"
                            },
                            {
                                "target_lang_word": "аннулировать",
                                "target_lang_sense_clarification": "признавать недействительным"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0d7d6562-7b66-3e0a-a7c0-d03d770caf9b",
                    "sense_definition": "starać się uniknąć wykonania jakiegoś obowiązku",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "unikanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nie wolno <w>uchylać</w> się od płacenia podatków w żadnym państwie.",
                            "target_lang_translations": {
                                "ru": "Нельзя <w>уклоняться</w> от уплаты налогов ни в одном государстве."
                            }
                        },
                        {
                            "text": "Pracownik próbował <w>uchylać</w> się od odpowiedzialności za popełniony błąd.",
                            "target_lang_translations": {
                                "ru": "Работник пытался <w>уклоняться</w> от ответственности за совершенную ошибку."
                            }
                        }
                    ],
                    "synonyms": [
                        "migać się",
                        "wymigiwać się",
                        "wykręcać się sianem"
                    ],
                    "common_phrases": [
                        "uchylać się od odpowiedzialności",
                        "uchylać się od obowiązku"
                    ],
                    "target_lang_definitions": {
                        "ru": "стараться избежать выполнения какой-либо обязанности или ответственности"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уклоняться",
                                "target_lang_sense_clarification": "избегать выполнения долга или ответственности"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}