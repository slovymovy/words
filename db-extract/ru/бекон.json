                                        "sense_id": "3fe2f6cc-3c3a-33ef-ac67-4526711d6137",
                                        "entry_id": "5f72eac2-20dc-32f3-b67a-630a1f3871a7",
                                        "glosses": [
                                            "geräuchertes und gepökeltes Bauchfleisch vom Schwein; häufig mit anhaftender Schwarte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76cfbf4d-76d1-4d86-9f70-526cec7cdf26",
                                                "sense_id": "3fe2f6cc-3c3a-33ef-ac67-4526711d6137",
                                                "text": "Ein paar Scheiben gebratenen Bacon gehören zu einem guten Frühstück dazu."
                                            }
