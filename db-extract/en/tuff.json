                        "examples": [
                            {
                                "example_id": "6ed02b19-96f0-4546-afb5-65acd506bd6a",
                                "sense_id": "9ab4d710-332b-3b76-b815-f3dbf428e2a0",
                                "text": "Tuff Stuff teaches that while life may go smoothly most of the time, ..."
                            },
                            {
                                "example_id": "b230ee90-cc2b-4efd-ac8c-beaf5d0e3d3c",
                                "sense_id": "9ab4d710-332b-3b76-b815-f3dbf428e2a0",
                                "text": "… yet never to make us so strong as the strongest of Men, whose Sinnews are tuffer, and Bones stronger, and Joints closer, and Flesh firmer, than ours are …"
                            },
                            {
                                "example_id": "bb57c8ba-f16e-4c0d-81d8-aa509eaf4be1",
                                "sense_id": "9ab4d710-332b-3b76-b815-f3dbf428e2a0",
                                "text": "It was rave reviewed in the Caribbean Times as 'the ruffest, tuffest and the boo-yacka of all modern gangster novels'."
                            },
                            {
                                "example_id": "e0e05e89-ef62-44dc-9391-fd67818cc6e3",
                                "sense_id": "9ab4d710-332b-3b76-b815-f3dbf428e2a0",
                                "text": "TUFF METER"
                            },
                            {
                                "example_id": "4be27932-ecbd-45f0-921e-26aca4625701",
                                "sense_id": "9ab4d710-332b-3b76-b815-f3dbf428e2a0",
                                "text": "Its Tuff-n-Tiny USB flash drive is about the size of a thumbnail. … The company insists that the \"tuff\" part of the name is well-earned for being waterproof, dustproof and you can drive a car over it."
                            },
                            {
                                "example_id": "75c418ce-3147-4582-8a6c-5c8352ee17ad",
                                "sense_id": "9ab4d710-332b-3b76-b815-f3dbf428e2a0",
                                "text": "Tuff Stuff Professional Wrestling"
                            }
                        ]
                    }
                ],
