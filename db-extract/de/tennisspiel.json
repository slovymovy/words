                ],
                "senses": [
                    {
                        "sense_id": "90ebd09a-5c2c-3bea-99a3-441173111a3f",
                        "entry_id": "73c89be8-1b79-3d00-bd9f-ef5c2cfc8d45",
                        "glosses": [
                            "Aufeinandertreffen von zwei oder mehreren Spielern innerhalb eines Wettkampfes in der Sportart Tennis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "adf29385-f850-4376-9bd1-ae57245aa16f",
                                "sense_id": "90ebd09a-5c2c-3bea-99a3-441173111a3f",
                                "text": "Ich konnte das Tennisspiel gestern Abend leider nicht sehen."
                            },
                            {
                                "example_id": "c6236b70-0501-47ed-aef9-33c4e94fd34e",
                                "sense_id": "90ebd09a-5c2c-3bea-99a3-441173111a3f",
                                "text": "„Wer das Tennisspiel erlernen möchte, wird mit einiger Wahrscheinlichkeit zunächst Schwierigkeiten mit der Ausführung des Aufschlags haben.“"
                            },
                            {
                                "example_id": "a84a368e-f267-4f00-847e-020c421505fd",
                                "sense_id": "90ebd09a-5c2c-3bea-99a3-441173111a3f",
                                "text": "„Tennisspiele bieten neben einer dreidimensionalen Graphik die Möglichkeit, sich ohne Laufarbeit mit Tennisgrößen wie Ivan Lendl, Jimmy Connors, John McEnroe und Björn Borg zu messen.“"
                            },
                            {
                                "example_id": "d7bb00db-541b-4d30-834e-43935ede40e9",
                                "sense_id": "90ebd09a-5c2c-3bea-99a3-441173111a3f",
                                "text": "„Es ist ein Genuss, einem Tennisspiel zuzusehen.“"
                            },
                            {
                                "example_id": "acacb867-a756-4c9f-97a5-1a7dd00f90ef",
                                "sense_id": "90ebd09a-5c2c-3bea-99a3-441173111a3f",
                                "text": "„Wegen des Tennisspiels trägt er eine sicher sitzende Brille, deren Drahtbügel schlingenförmig um seine Ohren liegen, auch im Gericht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
