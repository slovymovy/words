                                        "entry_id": "9ebb9179-8e32-3763-81f1-198e833cb075",
                                        "glosses": [
                                            "subatomair deeltje met een positieve elektrische lading en een rustmassa van 1 amu (1,6726231×10⁻²⁷ kg)"
                                        ],
                                        "tags": [
