                    {
                        "sense_id": "ca6aa285-0d93-306a-a872-6195033589d1",
                        "entry_id": "12472080-dbaa-3aac-bc20-104ae6422e20",
                        "glosses": [
                            "techniek om afbeeldingen op papier of een ander materiaal aan te brengen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e85294e1-caa0-4d0f-9445-24df35d40d6a",
                                "sense_id": "ca6aa285-0d93-306a-a872-6195033589d1",
                                "text": "Het prentenkabinet alleen al, een plek die vooral door kenners wordt bezocht, bevat meer dan 750.000 stuks. Voor het prachtboek België in oude prenten is daaruit door de medewerkers van het huis een wonderlijke selectie van 350 topografische tekeningen en prenten van steden, dorpen en landschappen op het Belgische grondgebied gemaakt, gedateerd tussen 1525 en 1875, zeg maar van de opkomst van de drukkunst tot het begin van de fotografie."
                            },
                            {
                                "example_id": "ea032e09-7a5a-43fd-8002-d2cb4268852b",
                                "sense_id": "ca6aa285-0d93-306a-a872-6195033589d1",
                                "text": "Een ander voorbeeld: het was de uitvinding van de boekdrukkunst die de middeleeuwse heksenvervolging mogelijk maakte. Voor het verspreiden van die perfide boodschap kwam de drukkunst destijds als een geschenk uit de hemel."
                            }
                        ]
                    }
