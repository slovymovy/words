                                "example_id": "3efacd3e-7ba4-49f1-b569-6df617ad04bf",
                                "sense_id": "51a315fb-d072-3478-8826-be6dd33b64d6",
                                "text": "Een witte baard, een rode jas en rendieren: zo kennen wij de Kerstman."
                            }
                        ]
                    }
