                    },
                    {
                        "translation_id": "0cd6715a-8062-4ac1-8902-bef7168150b2",
                        "source_entry_id": "9184645e-cf98-3af5-9199-4b326299d452",
                        "source_sense_id": "b2f5b0f1-5709-3b3e-ba03-1f9ac798e061",
                        "target_lang_word": "Skulptur",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Skulptur",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d89cf02d-0a2c-3001-bac4-f9909db7df8c",
                                        "entry_id": "9067c845-9b59-3071-b544-681975145da0",
                                        "glosses": [
                                            "Gattung der Bildhauerei, die sich mit dreidimensionalen Werken befasst, die aus festem Material mittels eines subtraktiven Verfahrens (Abtragen, Ausstechen, Aushöhlen) geschaffen wurden"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8686b57-cff1-478c-b557-46f38b941972",
                                                "sense_id": "d89cf02d-0a2c-3001-bac4-f9909db7df8c",
                                                "text": "„Ihre vielfältige Volkskunst enthält Lieder, Tanz, Poesie, antike griechischen Elemente in Skulptur und ihren traditionellen Trachten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "826ed058-f3de-3fce-a17a-e8486f66338c",
                                        "entry_id": "9067c845-9b59-3071-b544-681975145da0",
                                        "glosses": [
                                            "dreidimensionales Kunstwerk, das aus festem Material (Stein oder Ähnlichem) besteht und das durch Abtragen, Ausstechen oder Aushöhlen geschaffen wurde"
                                        ],
                                        "tags": [
                                            "Bildhauerei"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae56c1c9-fe25-41e5-8314-a4aac03be940",
                                                "sense_id": "826ed058-f3de-3fce-a17a-e8486f66338c",
                                                "text": "„Nach den Anfängen im 15. Jahrhundert wurden immer mehr Skulpturen geschaffen, die unabhängig von einem Bauwerk im Raum standen und den oft nackten Körper von Menschen detailgetreu abbildeten.“"
                                            },
                                            {
                                                "example_id": "86833feb-62bb-4adb-a175-2f6757709d5f",
                                                "sense_id": "826ed058-f3de-3fce-a17a-e8486f66338c",
                                                "text": "„Figurinen findet man an solchen Orten und in solchen kulturellen Kontexten, die auf den Charakter der Skulpturen als Kultobjekte hinweisen.“"
                                            },
                                            {
                                                "example_id": "94196e04-08fb-4699-9b23-d96ca55fc5c9",
                                                "sense_id": "826ed058-f3de-3fce-a17a-e8486f66338c",
                                                "text": "„Die Oberfläche der Pyramide war mit Steinplatten bedeckt, die 70 steinerne Skulpturen trugen.“"
                                            },
                                            {
                                                "example_id": "4f869634-1bdb-4aa5-bde0-8c14404d03b8",
                                                "sense_id": "826ed058-f3de-3fce-a17a-e8486f66338c",
                                                "text": "„Zurück im Zimmer, lag Scott immer noch wie auf seinem Grab, wie eine Skulptur, ein Denkmal seiner selbst, hielt die Augen geschlossen und atmete mit beispielhafter Würde.“"
                                            },
                                            {
                                                "example_id": "d687c9ed-95d3-4616-b341-b51df8d31028",
                                                "sense_id": "826ed058-f3de-3fce-a17a-e8486f66338c",
                                                "text": "In Vorgärten findet man Skulpturen aller Art."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "792398a9-38ae-337c-b63c-4a014dfe1e08",
                                        "entry_id": "9067c845-9b59-3071-b544-681975145da0",
                                        "glosses": [
                                            "jede Art von dreidimensionalem Kunstwerk, dass bildhauerisch geschaffen wurde (Plastik oder Skulptur)"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78869f31-59df-4d20-8120-e6547573a03f",
                                                "sense_id": "792398a9-38ae-337c-b63c-4a014dfe1e08",
                                                "text": "In Vorgärten findet man Skulpturen aller Art."
                                            },
                                            {
                                                "example_id": "3431cd31-a316-4b07-a194-79cbdd6647f0",
                                                "sense_id": "792398a9-38ae-337c-b63c-4a014dfe1e08",
                                                "text": "„Es gibt auch Skulpturen politischen Inhalts.“"
                                            },
                                            {
                                                "example_id": "97570415-f314-48c6-b08c-d2df97532921",
                                                "sense_id": "792398a9-38ae-337c-b63c-4a014dfe1e08",
                                                "text": "„Heute steht dort eine sowjetische Skulptur aus Beton, die den Gedenkstein des Briten ersetzt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
