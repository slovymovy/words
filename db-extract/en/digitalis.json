                                                "sense_id": "cb3bac0e-8d94-390b-a4a5-cfb371976eb0",
                                                "text": "„Sarah hatte tatsächlich ebenjenen Silberschmied geheiratet, der unsere Namen in den Fingerhut graviert hatte!“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
