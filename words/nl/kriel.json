    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b266646b-1279-3c7b-8897-0912dea72dcf",
                    "sense_definition": "Een kleine aardappel; krieltje.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "aardappel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We eten vanavond gebakken <w>kriel</w> met een frisse salade.",
                            "target_lang_translations": {
                                "en": "Tonight we are eating fried <w>baby potatoes</w> with a fresh salad."
                            }
                        },
                        {
                            "text": "Zij kookt de <w>kriel</w> het liefst in de schil.",
                            "target_lang_translations": {
                                "en": "She prefers to boil the <w>baby potatoes</w> in their skins."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gebakken kriel"
                    ],
                    "target_lang_definitions": {
                        "en": "A small potato; baby potato."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "baby potato",
                                "target_lang_sense_clarification": "small potato used in cooking"
                            },
                            {
                                "target_lang_word": "new potato",
                                "target_lang_sense_clarification": "small, young potato"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bd93e124-b4b5-36cd-949f-1bcbff5bf382",
                    "sense_definition": "Een dwerghoen of krielkip.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vogel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kleine <w>kriel</w> scharrelde vrolijk rond in de achtertuin.",
                            "target_lang_translations": {
                                "en": "The little <w>bantam</w> scratched around happily in the backyard."
                            }
                        },
                        {
                            "text": "Hij houdt verschillende soorten <w>kriel</w> in zijn ren.",
                            "target_lang_translations": {
                                "en": "He keeps several types of <w>bantam chickens</w> in his coop."
                            }
                        }
                    ],
                    "synonyms": [
                        "krielkip"
                    ],
                    "target_lang_definitions": {
                        "en": "A bantam; a small breed of domestic chicken."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bantam",
                                "target_lang_sense_clarification": "miniature chicken breed"
                            },
                            {
                                "target_lang_word": "bantam chicken",
                                "target_lang_sense_clarification": "small breed of chicken"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8d4cf8ad-fa5c-3214-8c3f-d4c294d4b08b",
                    "sense_definition": "Een klein of tenger persoon.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "persoon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die kleine <w>kriel</w> liet zich door niemand de les lezen.",
                            "target_lang_translations": {
                                "en": "That little <w>shrimp</w> didn't let anyone lecture him."
                            }
                        },
                        {
                            "text": "Als kind was hij maar een magere <w>kriel</w>.",
                            "target_lang_translations": {
                                "en": "As a child, he was just a skinny <w>runt</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used informally to describe a small person"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A small, short, or petite person."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "shrimp",
                                "target_lang_sense_clarification": "informal term for a small or short person"
                            },
                            {
                                "target_lang_word": "runt",
                                "target_lang_sense_clarification": "informal term for a small person"
                            },
                            {
                                "target_lang_word": "half-pint",
                                "target_lang_sense_clarification": "informal term for a short person"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "200294db-e945-3b69-902c-1ed92c09d87c",
                    "sense_definition": "Levendig en dartel.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "karakter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De jonge honden waren uiterst <w>kriel</w> en renden door de tuin.",
                            "target_lang_translations": {
                                "en": "The young dogs were extremely <w>frisky</w> and ran through the garden."
                            }
                        },
                        {
                            "text": "Met een <w>kriel</w> humeur begon zij aan de vrolijke dans.",
                            "target_lang_translations": {
                                "en": "With a <w>lively</w> mood, she started the cheerful dance."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Mainly dialectal or regional usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Lively, playful, and full of energy."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lively",
                                "target_lang_sense_clarification": "full of life and energy"
                            },
                            {
                                "target_lang_word": "frisky",
                                "target_lang_sense_clarification": "playful and full of energy"
                            },
                            {
                                "target_lang_word": "sprightly",
                                "target_lang_sense_clarification": "lively and full of energy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9ea6acb9-3cea-30d0-bfe9-49e8b62c320f",
                    "sense_definition": "Kregel en prikkelbaar.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "karakter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Door het slaapgebrek reageerde hij nogal <w>kriel</w> op de vragen.",
                            "target_lang_translations": {
                                "en": "Due to the lack of sleep, he reacted rather <w>crankily</w> to the questions."
                            }
                        },
                        {
                            "text": "Zij werd een beetje <w>kriel</w> van al dat lawaai om haar heen.",
                            "target_lang_translations": {
                                "en": "She became a bit <w>irritable</w> from all that noise around her."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Mainly dialectal or regional usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Irritable, touchy, or cranky."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "irritable",
                                "target_lang_sense_clarification": "easily annoyed or angered"
                            },
                            {
                                "target_lang_word": "cranky",
                                "target_lang_sense_clarification": "bad-tempered or irritable"
                            },
                            {
                                "target_lang_word": "testy",
                                "target_lang_sense_clarification": "easily irritated or impatient"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0ef0ecbc-3299-3d55-8af9-9ebabd4f1ac9",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>krielen</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>kriel</w> van de zenuwen als ik voor een grote groep moet spreken.",
                            "target_lang_translations": {
                                "en": "I <w>swarm</w> with nerves when I have to speak in front of a large group."
                            }
                        },
                        {
                            "text": "In deze drukke winkelstraat <w>kriel</w> ik tussen de mensen door.",
                            "target_lang_translations": {
                                "en": "In this busy shopping street, I <w>weave</w> through the swarming people."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Verb form"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "First-person singular present tense of 'krielen' (to swarm, crawl, or teem)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "swarm",
                                "target_lang_sense_clarification": "to move about in large numbers"
                            },
                            {
                                "target_lang_word": "teem",
                                "target_lang_sense_clarification": "to be full of or swarming with"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}