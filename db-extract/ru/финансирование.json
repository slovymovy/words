                                    {
                                        "sense_id": "279d5e56-5846-3159-8ec9-e2b51825b0c5",
                                        "entry_id": "9bfcd75c-690f-3b5f-91c9-a42025bdddd8",
                                        "glosses": [
                                            "A transaction that provides funds for a business."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b625d9c2-f345-4e88-8fc3-cd099557fa81",
                                                "sense_id": "279d5e56-5846-3159-8ec9-e2b51825b0c5",
                                                "text": "The successive equity financings were at higher and higher valuations."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "financing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e635ec30-e81b-3ca0-b3ca-72423060e370",
                                        "entry_id": "300b8a8c-4844-3463-b177-5ea683ea2f38",
                                        "glosses": [
                                            "present participle and gerund of finance"
                                        ],
