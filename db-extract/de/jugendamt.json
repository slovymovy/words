                "senses": [
                    {
                        "sense_id": "de7cee6b-b33f-3128-b2fe-73e20c770ab3",
                        "entry_id": "c01c3c4d-9b34-3353-a39b-502e99eaca4e",
                        "glosses": [
                            "Behörde, die für öffentliche Jugendhilfe zuständig ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3767644-fdb1-4a0f-9acf-568f28156527",
                                "sense_id": "de7cee6b-b33f-3128-b2fe-73e20c770ab3",
                                "text": "In Deutschland muss jeder Landkreis ein Jugendamt unterhalten."
                            },
                            {
                                "example_id": "908d76e0-8bf3-49f8-9d60-59cfd2c210bb",
                                "sense_id": "de7cee6b-b33f-3128-b2fe-73e20c770ab3",
                                "text": "„Die Fürsorgestelle hieß jetzt Jugendamt, und sie saß lange auf dem Flur, ehe man sie vorließ.“"
                            },
                            {
                                "example_id": "fa5fb86a-cdfe-4b34-adbb-7e95c7588eb7",
                                "sense_id": "de7cee6b-b33f-3128-b2fe-73e20c770ab3",
                                "text": "„Es dauerte noch ein paar Tage, bis das Jugendamt die einzige lebende Verwandte meiner Eltern ausfindig gemacht hatte, denn sie war gerade in Frankreich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
