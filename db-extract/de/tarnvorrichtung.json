                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cloaking device",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "df98930f-0711-3166-b218-3ab965b8fb82",
                                        "entry_id": "2a286562-2627-3b73-9e64-162bfabbf9db",
                                        "glosses": [
                                            "A device which renders a person or thing invisible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e62b04e9-57fd-46ee-9cae-a281a6571025",
                                                "sense_id": "df98930f-0711-3166-b218-3ab965b8fb82",
                                                "text": "I believe the Romulans have developed a cloaking device which renders our tracking sensors useless."
                                            },
                                            {
                                                "example_id": "785b2d09-0e67-4d18-8db6-806771093c57",
                                                "sense_id": "df98930f-0711-3166-b218-3ab965b8fb82",
                                                "text": "They can't have disappeared. No ship that small has a cloaking device."
                                            },
                                            {
                                                "example_id": "b74983bd-e19e-49b3-876f-56af277e8d53",
                                                "sense_id": "df98930f-0711-3166-b218-3ab965b8fb82",
                                                "text": "I put out my hand and touched the warm surface of the camouflaged Rolls-Royce. I was going to ask Mycroft if I could have the cloaking device fitted to my Speedster but I was too late; enthused by my interest he had trotted off to a large roll-top bureau and was beckoning me over excitedly."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
