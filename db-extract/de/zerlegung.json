                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3c85e33e-ed2f-416f-ba31-4bb068a14d57",
                        "source_entry_id": "f2d051db-bb28-338a-82e4-de9c9f467716",
                        "source_sense_id": "120b213c-759b-3fab-82e9-8e9a6639c5c9",
                        "source_sense_description": "Aufteilung in meist vorher schon getrennt vorliegende Bestandteile",
                        "target_lang_word": "разложение",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "разложение",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "fc6da1ec-e96f-323f-94e6-6c5159cd2c38",
                                        "entry_id": "4342710f-1c8e-346b-aba2-64da1637f206",
                                        "glosses": [
                                            "действие по значению гл. разлагать, разделение объекта на составляющие"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0568280-1452-497b-8555-cfa3f33b43e2",
                                                "sense_id": "fc6da1ec-e96f-323f-94e6-6c5159cd2c38",
                                                "text": "Свет звёзд, светящихся белым и жёлтым светом, при таком разложении в спектр даёт цветную полоску, перерезанную тонкими чёрными линиями, соответствующими поглощению света атомами различных химических элементов."
                                            },
                                            {
                                                "example_id": "3960eac5-0373-43a1-a33c-4a01b72ba6a7",
                                                "sense_id": "fc6da1ec-e96f-323f-94e6-6c5159cd2c38",
                                                "text": "Дальнейшее разложение идёт через фосфат глицеринового альдегида до молочной кислоты."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44be9a67-d07b-32b6-9506-2e308df9deaa",
                                        "entry_id": "4342710f-1c8e-346b-aba2-64da1637f206",
                                        "glosses": [
                                            "матем. представление сложного объекта в виде набора более простых"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9f2974f4-938d-3216-a7ec-19c079a9b67b",
                                        "entry_id": "4342710f-1c8e-346b-aba2-64da1637f206",
                                        "glosses": [
                                            "физ. представление равнодействующей в виде суммы её составляющих"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d278dd96-f006-45bb-b5a1-4de57d7229a7",
                                                "sense_id": "9f2974f4-938d-3216-a7ec-19c079a9b67b",
                                                "text": "Этот ток опять начнёт разложение воды электролита на водород и кислород, но кислород теперь осаждается на отрицательной пластине, а водород ― на положительной, черт."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "043bda7e-49db-330a-b648-4eeee4b3ce2a",
                                        "entry_id": "4342710f-1c8e-346b-aba2-64da1637f206",
                                        "glosses": [
                                            "биохим. распад органической материи"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98644418-6f9f-4f59-8548-e3a1fb5d83a0",
                                                "sense_id": "043bda7e-49db-330a-b648-4eeee4b3ce2a",
                                                "text": "В Персии считали, что шафран задерживает разложение трупов, что в условиях жаркого климата имеет, конечно, немалое значение."
                                            },
                                            {
                                                "example_id": "4b63c5b3-6ce9-45a2-85bd-716a9e18da3d",
                                                "sense_id": "043bda7e-49db-330a-b648-4eeee4b3ce2a",
                                                "text": "От такого гниения и разложения мёртвых растений и животных происходит удобрение почвы, а потому без работы таких микробов не могло бы быть плодородия почвы, дающей людям и всем животным пропитание."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59d39c41-538e-376f-9fae-9264baf8bd3d",
                                        "entry_id": "4342710f-1c8e-346b-aba2-64da1637f206",
                                        "glosses": [
                                            "перен., неодобр. моральный упадок"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "762c99e1-6f99-42f3-a92c-bab83ad49a2c",
                                                "sense_id": "59d39c41-538e-376f-9fae-9264baf8bd3d",
                                                "text": "И от этого послеиюльского эпизода прошла целая эпоха разложения и упадка демократии."
                                            },
                                            {
                                                "example_id": "9d095033-e05f-4de1-8cf7-6533c26c397b",
                                                "sense_id": "59d39c41-538e-376f-9fae-9264baf8bd3d",
                                                "text": "В том то и беда. что интеллигентский социализм ничего не дал положительного и нового в отношении устройства семьи и вполне понятно, почему: сам русский интеллигент есть продукт разложения общества, значит и семьи."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
