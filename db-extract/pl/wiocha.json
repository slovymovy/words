                    {
                        "translation_id": "0dfa5401-917c-435e-bd5e-5f7eaacc7a0e",
                        "source_entry_id": "608c09e8-c13a-3399-8dbc-ae84fc44ea16",
                        "source_sense_id": "e99506c4-237a-3ef5-bad4-38518ece803e",
                        "target_lang_word": "díra",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "díra",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "028f5233-db72-35ff-96c7-34d62f05cbfa",
                                        "entry_id": "f5029d4e-60df-30f4-bbda-087676a0a547",
                                        "glosses": [
                                            "volný prostor v tělese, které ji obklopuje"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dfd90e27-f741-44bc-a114-7f4d2fdc8756",
                                                "sense_id": "028f5233-db72-35ff-96c7-34d62f05cbfa",
                                                "text": "Přišed za ním, nepromluvil jsem a on také ne. Vrtal do balvanu díru; pouhým perlíkem nebylo lze jej rozbíti. Tady musí nastoupit síla jiná. Je to nevděčná věc, pár hodin trpělivé mozolné práce třeba věnovat takovému vrtání."
                                            },
                                            {
                                                "example_id": "8af35f19-ec45-41a4-b253-659f64133933",
                                                "sense_id": "028f5233-db72-35ff-96c7-34d62f05cbfa",
                                                "text": "Nakonec je potřeba vyvrtat díru o průměru pět milimetrů."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a0b06a6-ed39-3cfb-9d00-1b1b011a100f",
                                        "entry_id": "f5029d4e-60df-30f4-bbda-087676a0a547",
                                        "glosses": [
                                            "vyhloubené místo na nějakém povrchu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0493160-53e1-4f6c-a00d-b6dc41afd55f",
                                                "sense_id": "5a0b06a6-ed39-3cfb-9d00-1b1b011a100f",
                                                "text": "Na silnici byla díra, kterou všichni opatrně objížděli."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b32d0be2-5ded-357a-bcca-ee8b1d6118cb",
                                        "entry_id": "f5029d4e-60df-30f4-bbda-087676a0a547",
                                        "glosses": [
                                            "uprázdněné místo"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2847c019-f7ec-449c-acf2-23c1b2a99f38",
                                                "sense_id": "b32d0be2-5ded-357a-bcca-ee8b1d6118cb",
                                                "text": "Zrušením té schůzky se mi v zítřejším plánu objevila díra."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63778859-ef53-3747-83c0-253ffd6b5aaf",
                                        "entry_id": "f5029d4e-60df-30f4-bbda-087676a0a547",
                                        "glosses": [
                                            "zapadlé, vzdálené, nevýznamné místo, sídlo apod."
                                        ],
                                        "tags": [
                                            "expressively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b95a197f-2cd8-47e6-ba9b-4415d3b02a24",
                                                "sense_id": "63778859-ef53-3747-83c0-253ffd6b5aaf",
                                                "text": "Přestěhoval se do nějaké díry na Šumavě."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c3a192a-ad96-3061-ba88-724387f9de45",
                                        "entry_id": "f5029d4e-60df-30f4-bbda-087676a0a547",
                                        "glosses": [
                                            "zostřená samovazba"
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52e6151a-61dc-47a8-93cc-9d7a9d96ab88",
                                                "sense_id": "9c3a192a-ad96-3061-ba88-724387f9de45",
                                                "text": "Za napadení spoluvězně šel na dva dny do díry."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "310027c6-6238-34d4-8eea-166e10db0717",
                                        "entry_id": "f5029d4e-60df-30f4-bbda-087676a0a547",
                                        "glosses": [
                                            "pomyslná kladně nabitá částice v polovodičích, vzniklá po uvolněném elektronu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4dec01ad-363d-427e-8b84-090e0b45d0b8",
                                                "sense_id": "310027c6-6238-34d4-8eea-166e10db0717",
                                                "text": "Majoritními nosiči náboje v polovodičích typu n jsou elektrony, v typu p díry."
