{
    "word_family": [
        "licensable",
        "licensee",
        "licenser",
        "licensor",
        "licensure",
        "unlicensed"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "81fdf103-e212-339f-8bbd-c8bd5ea3020c",
                    "sense_definition": "A document permitting a person to drive a motor vehicle.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "legal_permission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police officer asked the driver to show his <w>license</w>.",
                            "target_lang_translations": {
                                "ru": "Полицейский попросил водителя предъявить <w>права</w>.",
                                "zh": "警察要求司机出示他的<w>驾照</w>。"
                            }
                        },
                        {
                            "text": "I was so happy when I finally passed the test and got my <w>license</w>.",
                            "target_lang_translations": {
                                "ru": "Я был так счастлив, когда наконец сдал экзамен и получил <w>права</w>.",
                                "zh": "当我最终通过考试并拿到<w>驾照</w>时，我感到非常高兴。"
                            }
                        }
                    ],
                    "synonyms": [
                        "driver's license",
                        "permit"
                    ],
                    "common_phrases": [
                        "valid license",
                        "lose your license",
                        "show your license"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "short for driver's license"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Документ, разрешающий управление транспортным средством.",
                        "zh": "允许个人驾驶机动车的证件。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "права",
                                "target_lang_sense_clarification": "водительские (разг.)"
                            },
                            {
                                "target_lang_word": "удостоверение",
                                "target_lang_sense_clarification": "водительское (офиц.)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "驾照",
                                "target_lang_sense_clarification": "驾驶执照"
                            },
                            {
                                "target_lang_word": "驾驶证",
                                "target_lang_sense_clarification": "正式证件"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0095bd6e-0c35-3092-96da-382203896a5d",
                    "sense_definition": "A legal document giving official permission to do something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "legal_permission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You must buy a fishing <w>license</w> before you catch anything in this lake.",
                            "target_lang_translations": {
                                "ru": "Вы должны купить <w>лицензию</w> на рыбалку, прежде чем ловить что-либо в этом озере.",
                                "zh": "在这个湖里钓鱼之前，你必须先购买一张钓鱼<w>许可证</w>。"
                            }
                        },
                        {
                            "text": "The restaurant applied for a liquor <w>license</w> to serve alcohol.",
                            "target_lang_translations": {
                                "ru": "Ресторан подал заявку на <w>лицензию</w> на продажу спиртных напитков.",
                                "zh": "这家餐厅申请了酒类<w>经营许可证</w>以供应酒精饮料。"
                            }
                        }
                    ],
                    "synonyms": [
                        "permit",
                        "certificate",
                        "pass",
                        "authorization",
                        "documentation"
                    ],
                    "antonyms": [
                        "prohibition"
                    ],
                    "common_phrases": [
                        "marriage license",
                        "fishing license",
                        "liquor license",
                        "business license"
                    ],
                    "target_lang_definitions": {
                        "ru": "Юридический документ, дающий официальное разрешение на выполнение каких-либо действий.",
                        "zh": "授予进行某项活动之官方许可的法律文件。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лицензия",
                                "target_lang_sense_clarification": "документ"
                            },
                            {
                                "target_lang_word": "разрешение",
                                "target_lang_sense_clarification": "право на деятельность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "许可证",
                                "target_lang_sense_clarification": "官方许可文件"
                            },
                            {
                                "target_lang_word": "执照",
                                "target_lang_sense_clarification": "经营或从业许可"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "718f0d6f-a45f-31bc-b802-9deecb7c83dc",
                    "sense_definition": "The legal terms under which a person is allowed to use a product, especially software.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ip_law",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please read the software <w>license</w> agreement before installing the program.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, прочитайте <w>лицензионное</w> соглашение перед установкой программы.",
                                "zh": "在安装程序之前，请阅读软件<w>许可协议</w>。"
                            }
                        },
                        {
                            "text": "This image is available for free under a Creative Commons <w>license</w>.",
                            "target_lang_translations": {
                                "ru": "Это изображение доступно бесплатно по <w>лицензии</w> Creative Commons.",
                                "zh": "这张图片可以在知识共享<w>许可</w>下免费使用。"
                            }
                        }
                    ],
                    "synonyms": [
                        "agreement",
                        "terms of use"
                    ],
                    "common_phrases": [
                        "software license",
                        "license agreement",
                        "under license",
                        "open source license"
                    ],
                    "target_lang_definitions": {
                        "ru": "Юридические условия, на которых разрешено использование продукта, особенно программного обеспечения.",
                        "zh": "允许个人使用产品（尤其是软件）的法律条款。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лицензия",
                                "target_lang_sense_clarification": "условия использования"
                            },
                            {
                                "target_lang_word": "лицензионное соглашение",
                                "target_lang_sense_clarification": "договор"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "许可协议",
                                "target_lang_sense_clarification": "法律条款"
                            },
                            {
                                "target_lang_word": "授权",
                                "target_lang_sense_clarification": "使用权限"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "13c44083-387d-30cf-aaf5-0a33004dc516",
                    "sense_definition": "Freedom to deviate deliberately from normally applicable rules or practices.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "abstract_freedom",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The director took some artistic <w>license</w> with the historical facts to make the movie more exciting.",
                            "target_lang_translations": {
                                "ru": "Режиссер допустил некоторую художественную <w>вольность</w> в обращении с историческими фактами, чтобы сделать фильм более захватывающим.",
                                "zh": "导演为了让电影更精彩，对历史事实进行了一些艺术上的<w>加工</w>。"
                            }
                        },
                        {
                            "text": "Poetic <w>license</w> allows writers to ignore standard grammar for better rhythm.",
                            "target_lang_translations": {
                                "ru": "Поэтическая <w>вольность</w> позволяет писателям игнорировать стандартную грамматику ради лучшего ритма.",
                                "zh": "诗歌<w>特权</w>允许作家为了更好的节奏而忽略标准语法。"
                            }
                        }
                    ],
                    "synonyms": [
                        "latitude",
                        "liberty"
                    ],
                    "antonyms": [
                        "strictness"
                    ],
                    "common_phrases": [
                        "poetic license",
                        "artistic license",
                        "creative license"
                    ],
                    "target_lang_definitions": {
                        "ru": "Свобода намеренно отступать от общепринятых правил или норм.",
                        "zh": "故意偏离常规规则或惯例的自由。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вольность",
                                "target_lang_sense_clarification": "отступление от правил"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "自由",
                                "target_lang_sense_clarification": "不受拘束"
                            },
                            {
                                "target_lang_word": "特权",
                                "target_lang_sense_clarification": "艺术或创作上的自由"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f9202cb4-a360-3164-8974-f0ce0bb5dc6d",
                    "sense_definition": "Excessive freedom; lack of due restraint.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "abstract_freedom",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The conquering army behaved with unbridled <w>license</w> in the defeated city.",
                            "target_lang_translations": {
                                "ru": "Армия завоевателей вела себя в побежденном городе с необузданной <w>вседозволенностью</w>.",
                                "zh": "征服军队在战败的城市里表现得肆无忌惮，毫无<w>约束</w>。"
                            }
                        },
                        {
                            "text": "There is a fine line where liberty ends and <w>license</w> begins.",
                            "target_lang_translations": {
                                "ru": "Существует тонкая грань, где заканчивается свобода и начинается <w>вседозволенность</w>.",
                                "zh": "自由的终点与<w>放纵</w>的起点之间只有一线之隔。"
                            }
                        }
                    ],
                    "synonyms": [
                        "anarchy",
                        "lawlessness"
                    ],
                    "antonyms": [
                        "restraint",
                        "discipline"
                    ],
                    "common_phrases": [
                        "liberty and license"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезмерная свобода; отсутствие должных ограничений.",
                        "zh": "过度的自由；缺乏应有的约束。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вседозволенность",
                                "target_lang_sense_clarification": "распущенность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "放纵",
                                "target_lang_sense_clarification": "缺乏约束"
                            },
                            {
                                "target_lang_word": "肆无忌惮",
                                "target_lang_sense_clarification": "行为无度"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b7a52fa5-d7fc-312d-ab86-b83c30cf845e",
                    "sense_definition": "To grant official permission or authority to someone.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "authorize_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The state board must <w>license</w> all doctors before they can practice medicine.",
                            "target_lang_translations": {
                                "ru": "Государственный совет должен <w>лицензировать</w> всех врачей, прежде чем они смогут заниматься медициной.",
                                "zh": "州委员会必须先为所有医生<w>颁发执照</w>，他们才能行医。"
                            }
                        },
                        {
                            "text": "The shop is <w>licensed</w> to sell tobacco products.",
                            "target_lang_translations": {
                                "ru": "Магазин <w>лицензирован</w> для продажи табачных изделий.",
                                "zh": "这家商店已获<w>授权</w>销售烟草制品。"
                            }
                        }
                    ],
                    "synonyms": [
                        "authorize",
                        "permit",
                        "certify"
                    ],
                    "antonyms": [
                        "ban",
                        "forbid",
                        "prohibit"
                    ],
                    "common_phrases": [
                        "licensed to practice",
                        "fully licensed",
                        "licensed premises"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предоставлять официальное разрешение или полномочия кому-либо.",
                        "zh": "授予某人官方许可或授权。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лицензировать",
                                "target_lang_sense_clarification": "выдавать разрешение"
                            },
                            {
                                "target_lang_word": "разрешать",
                                "target_lang_sense_clarification": "позволять деятельность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "颁发执照",
                                "target_lang_sense_clarification": "授予许可"
                            },
                            {
                                "target_lang_word": "授权",
                                "target_lang_sense_clarification": "准许进行活动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8f3e437a-6d7d-31d6-9fb9-a239d81b4988",
                    "sense_definition": "To give formal authorization to use intellectual property.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "ip_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company decided to <w>license</w> its new technology to other manufacturers.",
                            "target_lang_translations": {
                                "ru": "Компания решила <w>лицензировать</w> свою новую технологию другим производителям.",
                                "zh": "该公司决定将其新技术<w>授权</w>给其他制造商。"
                            }
                        },
                        {
                            "text": "They <w>license</w> their software to universities at a discounted rate.",
                            "target_lang_translations": {
                                "ru": "Они <w>предоставляют лицензии</w> на свое программное обеспечение университетам по сниженной ставке.",
                                "zh": "他们以折扣价向大学<w>提供</w>软件许可。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "license the technology",
                        "license the brand",
                        "license the patent"
                    ],
                    "target_lang_definitions": {
                        "ru": "Давать официальное разрешение на использование интеллектуальной собственности.",
                        "zh": "给予使用知识产权的正式授权。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лицензировать",
                                "target_lang_sense_clarification": "предоставлять права"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "授权",
                                "target_lang_sense_clarification": "提供使用权"
                            },
                            {
                                "target_lang_word": "许可",
                                "target_lang_sense_clarification": "允许使用"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "55923d3e-28c7-3582-a800-25f7d7b9994f",
                    "sense_definition": "To acquire authorization to use intellectual property, usually in exchange for compensation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "ip_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The film studio <w>licensed</w> a popular song for the movie trailer.",
                            "target_lang_translations": {
                                "ru": "Киностудия <w>приобрела права</w> на популярную песню для трейлера фильма.",
                                "zh": "电影制片厂为电影预告片<w>购买</w>了一首流行歌曲的版权。"
                            }
                        },
                        {
                            "text": "We need to <w>license</w> the rights to this image before we print the brochure.",
                            "target_lang_translations": {
                                "ru": "Нам нужно <w>приобрести лицензию</w> на права на это изображение, прежде чем печатать брошюру.",
                                "zh": "在印刷宣传册之前，我们需要<w>取得</w>这张图片的版权许可。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "license a song",
                        "license the rights"
                    ],
                    "target_lang_definitions": {
                        "ru": "Получать разрешение на использование интеллектуальной собственности, обычно за вознаграждение.",
                        "zh": "获取使用知识产权的授权，通常是有偿的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приобретать лицензию",
                                "target_lang_sense_clarification": "покупать права"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "获得授权",
                                "target_lang_sense_clarification": "取得使用权"
                            },
                            {
                                "target_lang_word": "取得许可",
                                "target_lang_sense_clarification": "购买使用权"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0cfbcc9e-6ebd-3b70-a3f8-ccf8e9789205",
                    "sense_definition": "To permit a specific grammatical structure or feature.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "linguistics_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In English, transitive verbs <w>license</w> a direct object.",
                            "target_lang_translations": {
                                "ru": "В английском языке переходные глаголы <w>допускают</w> прямое дополнение.",
                                "zh": "在英语中，及物动词<w>支配</w>直接宾语。"
                            }
                        },
                        {
                            "text": "Certain linguistic rules <w>license</w> the use of negative polarity items.",
                            "target_lang_translations": {
                                "ru": "Определенные лингвистические правила <w>разрешают</w> использование единиц с отрицательной полярностью.",
                                "zh": "某些语言规则<w>允许</w>使用否定极性项。"
                            }
                        }
                    ],
                    "synonyms": [
                        "permit",
                        "allow"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical (linguistics)"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать возможным использование определенной грамматической структуры или признака.",
                        "zh": "允许某种特定的语法结构或特征。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "допускать",
                                "target_lang_sense_clarification": "лингвистика"
                            },
                            {
                                "target_lang_word": "разрешать",
                                "target_lang_sense_clarification": "грамматика"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "允许",
                                "target_lang_sense_clarification": "语法许可"
                            },
                            {
                                "target_lang_word": "支配",
                                "target_lang_sense_clarification": "语言学中动词对宾语的支配"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}