                        "glosses": [
                            "эл.-техн. режим работы источника бесперебойного питания (ИБП) в котором вход ИБП напрямую или через корректирующие и фильтрующие цепи соединен с выходом ИБП"
                        ],
                        "tags": [],
                        "examples": [
