                ],
                "senses": [
                    {
                        "sense_id": "4298da6c-a427-3850-9176-60c67089dc8b",
                        "entry_id": "3a4fae1d-3fc8-39b0-952d-88cf6f0bf058",
                        "glosses": [
                            "Zeit im Übergang von einem Semester zum nächsten, in der in der Regel keine Lehrveranstaltungen stattfinden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a5c4bf6-27d8-4346-b784-e639742ddd7e",
                                "sense_id": "4298da6c-a427-3850-9176-60c67089dc8b",
                                "text": "„Unschlüssig waren Hugo und ich, wie wir unsere Semesterferien verbringen würden.“"
                            },
                            {
                                "example_id": "8e230972-81c4-4c05-b67c-04706b32630f",
                                "sense_id": "4298da6c-a427-3850-9176-60c67089dc8b",
                                "text": "„Sämtliche Ferien (Sommermonate, Weihnachtsferien, Semesterferien, Osterferien) und des öfteren auch die Wochenenden verbringt er an seinem Wohnsitz in Deutschland.“"
                            },
                            {
                                "example_id": "8a5f98f9-3e56-49cf-bc70-a011409113e2",
                                "sense_id": "4298da6c-a427-3850-9176-60c67089dc8b",
                                "text": "„Ammondt ging in den Semesterferien auf Tournee und brachte es so zu Auftritten in aller Welt, auch in Amerika, sogar im Memphis, dem heiligen Ort der Elvis-Fans.“"
                            },
                            {
                                "example_id": "c45a0646-60f7-40a9-a5d3-21203ea0019b",
                                "sense_id": "4298da6c-a427-3850-9176-60c67089dc8b",
                                "text": "„In diesem Sommer ging ich vor den Semesterferien nicht zur studentischen Arbeitsvermittlung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "39ce5d73-b72d-3a5c-95e3-2294e1195023",
                        "entry_id": "3a4fae1d-3fc8-39b0-952d-88cf6f0bf058",
                        "glosses": [
                            "Schulferien in Österreich zwischen den Semestern eines Schuljahres"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28d16101-0585-446a-9065-6ee497c8a380",
                                "sense_id": "39ce5d73-b72d-3a5c-95e3-2294e1195023",
                                "text": "„Die Semesterferien wurden in Österreich 1973 während der ersten Ölkrise unter dem Namen Energieferien eingeführt.“"
                            },
                            {
                                "example_id": "993184da-0736-471a-9844-c55e4d6cf816",
                                "sense_id": "39ce5d73-b72d-3a5c-95e3-2294e1195023",
                                "text": "„In Wien, Niederösterreich und Vorarlberg beginnen am Freitag für rund 490.000 Schüler die Semesterferien.“"
                            },
                            {
                                "example_id": "e1b40ba1-e70a-4764-856a-ba9efaf7cc77",
                                "sense_id": "39ce5d73-b72d-3a5c-95e3-2294e1195023",
                                "text": "„Für die anderen Bundesländer wurde seitens des Stadtschulrates für Wien nicht recherchiert, ob der Samstag vor den Semesterferien generell schulfrei gegeben wird.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
