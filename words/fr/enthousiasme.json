            "senses": [
                {
                    "sense_id": "3cc5f466-b91d-327e-aee5-8f1847ce3f05",
                    "sense_definition": "Admiration passionnée ou goût très vif pour une personne ou pour une chose.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sentiment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les élèves ont accueilli le nouveau projet de voyage avec un grand <w>enthousiasme</w>."
