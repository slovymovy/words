    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8cc4fa89-0830-3524-9d9d-fbb6770c5216",
                    "sense_definition": "The state or condition of being friends with someone.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "social_relationship",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Their <w>friendship</w> began in elementary school and has lasted for over twenty years.",
                            "target_lang_translations": {
                                "ru": "Их <w>дружба</w> началась в начальной школе и длится уже более двадцати лет.",
                                "zh": "他们的<w>友谊</w>始于小学，至今已持续了二十多年。"
                            }
                        },
                        {
                            "text": "It is important to maintain a close <w>friendship</w> by talking and meeting regularly.",
                            "target_lang_translations": {
                                "ru": "Важно поддерживать близкую <w>дружбу</w>, регулярно общаясь и встречаясь.",
                                "zh": "通过定期交谈和见面来维持亲密的<w>友谊</w>非常重要。"
                            }
                        }
                    ],
                    "synonyms": [
                        "amity",
                        "closeness",
                        "fellowship",
                        "friendhood",
                        "mateship"
                    ],
                    "antonyms": [
                        "enmity",
                        "unfriendship"
                    ],
                    "common_phrases": [
                        "close friendship",
                        "lifelong friendship",
                        "bond of friendship"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние или условие пребывания в дружеских отношениях с кем-либо.",
                        "zh": "指人与人之间相互亲近、友好的状态或关系。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дружба",
                                "target_lang_sense_clarification": "близкие отношения, основанные на взаимной привязанности"
                            },
                            {
                                "target_lang_word": "приятельство",
                                "target_lang_sense_clarification": "менее глубокие, дружелюбные отношения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "友谊",
                                "target_lang_sense_clarification": "指人与人之间深厚的感情和亲密关系"
                            },
                            {
                                "target_lang_word": "友情",
                                "target_lang_sense_clarification": "指朋友之间的情谊"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b9816bb2-9cf5-3aa7-8d25-3093f4bbed9d",
                    "sense_definition": "A specific friendly relationship between two or more people.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "social_relationship",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She developed a strong <w>friendship</w> with her new colleague after working on the project together.",
                            "target_lang_translations": {
                                "ru": "У неё завязалась крепкая <w>дружба</w> с новым коллегой после совместной работы над проектом.",
                                "zh": "在共同完成那个项目后，她与新同事建立了深厚的<w>友谊</w>。"
                            }
                        },
                        {
                            "text": "The benefits of <w>friendships</w> between women are physically and psychologically undeniable.",
                            "target_lang_translations": {
                                "ru": "Польза женской <w>дружбы</w> неоспорима как с физической, так и с психологической точки зрения.",
                                "zh": "女性之间<w>友谊</w>带来的身心益处是不容置疑的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "chumship",
                        "entente cordiale"
                    ],
                    "antonyms": [
                        "enemyship",
                        "foeship"
                    ],
                    "common_phrases": [
                        "strong friendship",
                        "lasting friendship",
                        "form a friendship"
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкретные дружеские отношения между двумя или более людьми.",
                        "zh": "指两人或多人之间具体的友好关系。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дружба",
                                "target_lang_sense_clarification": "личная связь между людьми"
                            },
                            {
                                "target_lang_word": "дружеские отношения",
                                "target_lang_sense_clarification": "взаимоотношения между друзьями"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "友谊",
                                "target_lang_sense_clarification": "指两人之间建立的特定友好联系"
                            },
                            {
                                "target_lang_word": "友好关系",
                                "target_lang_sense_clarification": "指双方或多方之间维持的友好状态"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "574aeb30-0663-3f5b-8118-5f60d67e79f9",
                    "sense_definition": "A feeling of good will or peaceful relations between groups or nations.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "social_relationship",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two countries signed a treaty of <w>friendship</w> to promote trade and peace.",
                            "target_lang_translations": {
                                "ru": "Две страны подписали договор о <w>дружбе</w> для содействия торговле и миру.",
                                "zh": "两国签署了一份<w>友好</w>条约，以促进贸易与和平。"
                            }
                        },
                        {
                            "text": "The gesture was intended as a token of <w>friendship</w> between the rival communities.",
                            "target_lang_translations": {
                                "ru": "Этот жест был задуман как знак <w>дружбы</w> между соперничающими сообществами.",
                                "zh": "这一举动旨在作为敌对社区之间<w>友谊</w>的象征。"
                            }
                        }
                    ],
                    "synonyms": [
                        "amity",
                        "entente cordiale"
                    ],
                    "antonyms": [
                        "enmity"
                    ],
                    "common_phrases": [
                        "token of friendship",
                        "gesture of friendship",
                        "treaty of friendship"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувство доброй воли или мирные отношения между группами или народами.",
                        "zh": "指群体或国家之间和平共处、互助友好的关系。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дружба",
                                "target_lang_sense_clarification": "мирное сосуществование и сотрудничество стран"
                            },
                            {
                                "target_lang_word": "дружелюбие",
                                "target_lang_sense_clarification": "проявление доброй воли"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "友好",
                                "target_lang_sense_clarification": "指国家或团体间和平、合作的关系"
                            },
                            {
                                "target_lang_word": "友谊",
                                "target_lang_sense_clarification": "指群体间表现出的善意与和平"
                            }
                        ]
                    }
                }
            ]
        },
