                                    {
                                        "sense_id": "cf1f1c45-384b-3d8a-988d-903e37a2297b",
                                        "entry_id": "4be3387b-3ee1-3311-abf3-8cdbe8e4969b",
                                        "glosses": [
                                            "ato ou efeito de mastigar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b5d6048-4590-4713-8392-997a8f20eed7",
                                                "sense_id": "cf1f1c45-384b-3d8a-988d-903e37a2297b",
                                                "text": "Mas tamanho sabor tem seu preço: há bastante gordura incrustada nesse corte e, em algumas partes, a mastigação fica difícil."
                                            }
