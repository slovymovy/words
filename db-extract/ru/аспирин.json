                "senses": [
                    {
                        "sense_id": "d55bb2c8-1936-3d41-a5b8-da23214b8dc6",
                        "entry_id": "ec94b8a6-6a13-3c5b-a4d5-1b7efe279dad",
                        "glosses": [
                            "фарм., разг. то же, что ацетилсалициловая кислота, жаропонижающее и болеутолящее средство"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c8d2d69-8bc6-4111-a25f-9551b3019feb",
                                "sense_id": "d55bb2c8-1936-3d41-a5b8-da23214b8dc6",
                                "text": "Продолжайте давать спермин… если будет жар, дайте аспирину…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8cfff501-fc2f-4209-bf2e-5fd398c53d20",
                        "source_entry_id": "ec94b8a6-6a13-3c5b-a4d5-1b7efe279dad",
