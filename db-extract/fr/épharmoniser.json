                "senses": [
                    {
                        "sense_id": "70f6946e-7127-3e2e-800a-18f11d10d44f",
                        "entry_id": "d96f9866-7800-3cab-a34a-6593670a6f71",
                        "glosses": [
                            "Donner un caractère épharmonique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "800dc9da-90dc-43f6-8df6-5ffadd7798d2",
                                "sense_id": "70f6946e-7127-3e2e-800a-18f11d10d44f",
                                "text": "Il n’est pas étonnant qu'un organisme qui vit sans se déplacer dans un milieu pareil, se soit adapté, épharmonisé de la même façon."
                            },
                            {
                                "example_id": "32e7ec58-8cf4-495f-a73a-871bb10e84c8",
                                "sense_id": "70f6946e-7127-3e2e-800a-18f11d10d44f",
                                "text": "Nos cultures d’Indochine ne sont pas encore assez avancées pour qu’elles aient pu créer et fixer des variétés locales épharmonisées dans leur milieu, mais on peut retenir d’ores et déjà les résultats d’expériences comme celles de Shepard et Oliver (Caroline du Sud) qui préconisent la multiplication asexuée par le marcottage, le bouturage et la greffe, dans la conservation des bonnes variétés."
                            }
                        ]
                    }
                ],
