    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ef94953a-da2b-3f2d-81b7-b5f423302039",
                    "sense_definition": "Sentiment pénible d'isolement affectif ou d'abandon.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sentiment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Depuis son installation dans cette grande métropole, elle souffre d'une profonde <w>solitude</w>."
                        },
                        {
                            "text": "Beaucoup de personnes âgées redoutent la <w>solitude</w> et le manque de visites de leurs proches."
                        }
                    ],
                    "synonyms": [
                        "isolement",
                        "abandon"
                    ],
                    "common_phrases": [
                        "souffrir de la solitude",
                        "rompre la solitude"
                    ]
                },
                {
                    "sense_id": "b2e599af-52c2-36fd-9f75-73a791a101a7",
                    "sense_definition": "État d'une personne qui est physiquement seule ou retirée de la vie sociale.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "etat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'écrivain s'est installé à la campagne pour trouver la <w>solitude</w> nécessaire à la rédaction de son livre."
                        },
                        {
                            "text": "Après une longue semaine de travail au bureau, il apprécie le calme et la <w>solitude</w> de sa maison."
                        }
                    ],
                    "synonyms": [
                        "isolement",
                        "retraite"
                    ],
                    "common_phrases": [
                        "vivre dans la solitude",
                        "aimer la solitude",
                        "rechercher la solitude"
                    ]
                },
                {
                    "sense_id": "604de7e6-0d9e-3086-821c-c9e10c636488",
                    "sense_definition": "Lieu inhabité, désert et éloigné de toute activité humaine.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "lieu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les explorateurs ont marché pendant plusieurs semaines à travers les vastes <w>solitudes</w> du désert."
                        },
                        {
                            "text": "Le randonneur aimait contempler les <w>solitudes</w> glacées et silencieuses de la haute montagne."
                        }
                    ],
                    "synonyms": [
                        "désert"
                    ],
                    "common_phrases": [
                        "vastes solitudes",
                        "immenses solitudes"
                    ]
                }
            ]
        }
    ]
