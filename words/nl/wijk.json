                        {
                            "text": "Wij wonen in een rustige <w>wijk</w> aan de rand van de stad.",
                            "target_lang_translations": {
                                "en": "We live in a quiet <w>neighborhood</w> on the edge of the city.",
                                "ru": "Мы живем в тихом <w>районе</w> на окраине города.",
                                "pl": "Mieszkamy w spokojnej <w>dzielnicy</w> na obrzeżach miasta.",
                                "de": "Wir wohnen in einem ruhigen <w>Stadtviertel</w> am Stadtrand.",
                                "fr": "Nous habitons dans un <w>quartier</w> calme en périphérie de la ville.",
                                "it": "Viviamo in un <w>quartiere</w> tranquillo alla periferia della città.",
                                "cs": "Bydlíme v klidné <w>čtvrti</w> na okraji města.",
                                "tr": "Şehrin kıyısında sakin bir <w>mahallede</w> oturuyoruz.",
                                "es": "Vivimos en un <w>barrio</w> tranquilo en las afueras de la ciudad.",
                                "zh": "我们住在城市边缘一个安静的<w>社区</w>里。"
                            }
                        },
                        {
                            "text": "De gemeente wil de veiligheid in deze <w>wijk</w> verbeteren.",
                            "target_lang_translations": {
                                "en": "The municipality wants to improve safety in this <w>district</w>.",
                                "ru": "Муниципалитет хочет улучшить безопасность в этом <w>районе</w>.",
                                "pl": "Gmina chce poprawić bezpieczeństwo w tej <w>dzielnicy</w>.",
                                "de": "Die Gemeinde möchte die Sicherheit in diesem <w>Stadtteil</w> verbessern.",
                                "fr": "La municipalité veut améliorer la sécurité dans ce <w>quartier</w>.",
                                "it": "Il comune vuole migliorare la sicurezza in questo <w>quartiere</w>.",
                                "cs": "Obec chce zlepšit bezpečnost v této <w>čtvrti</w>.",
                                "tr": "Belediye bu <w>mahalledeki</w> güvenliği artırmak istiyor.",
                                "es": "El municipio quiere mejorar la seguridad en este <w>distrito</w>.",
