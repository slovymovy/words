                                "target_senses": [
                                    {
                                        "sense_id": "041704c1-f5a1-324e-8aab-06a4ece06dd3",
                                        "entry_id": "f341cd92-7ee0-39fd-9859-9404066c339a",
                                        "glosses": [
                                            "struktura wewnętrzna czegoś, rozpatrywana w odniesieniu do charakterystyki i ułożenia składników"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8b2cad7-8ab8-4d93-82f3-0b9c5ab37d67",
                                                "sense_id": "041704c1-f5a1-324e-8aab-06a4ece06dd3",
                                                "text": "Tekstura gleby odzwierciedla sposób ułożenia względem siebie poszczególnych ziaren i agregatów"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "b725a63d-4d31-3c4b-8a11-b3ee3612fb80",
                                        "entry_id": "f341cd92-7ee0-39fd-9859-9404066c339a",
                                        "glosses": [
                                            "powierzchnia ścian trójwymiarowych obiektów graficznych"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b249306-58d6-42d8-9acd-defe5710d0b9",
                                                "sense_id": "b725a63d-4d31-3c4b-8a11-b3ee3612fb80",
                                                "text": "Tekstura obiektu nie została wyrenderowana poprawnie."
                                            }
