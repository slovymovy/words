                                        "sense_id": "2591b88e-4fdb-385e-9eb6-e2ef0ab7089b",
                                        "entry_id": "06633ad1-254d-3cbc-9139-effb08ed5d37",
                                        "glosses": [
                                            "Those ones.",
                                            "Used as the direct object of a verb."
                                        ],
                                        "tags": [
                                            "in-plural",
