                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le prix est trop élevé pour que cette offre immobilière nous <w>intéresse</w>."
                        },
                        {
                            "text": "Cette proposition financière ne semble guère <w>intéresser</w> les investisseurs actuels."
