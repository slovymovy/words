            "senses": [
                {
                    "sense_id": "09bc1d16-5ccd-3e20-a470-f87d9c18a95e",
                    "sense_definition": "Grosse balle sphérique ou ovale, généralement gonflée d'air, servant à la pratique de divers sports ou jeux.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "sport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les enfants jouent au <w>ballon</w> dans la cour de l'école pendant la récréation."
                        },
                        {
                            "text": "L'attaquant frappe fort dans le <w>ballon</w> et marque un magnifique but."
                        }
                    ],
                    "common_phrases": [
                        "jouer au ballon",
                        "ballon de football",
                        "tirer dans le ballon"
                    ]
                },
                {
                    "sense_id": "5f4003e5-31e6-34c0-9e82-37d8db4c49eb",
                    "sense_definition": "Poche élastique et légère en caoutchouc que l'on gonfle d'air ou d'un gaz léger pour servir de jouet ou d'ornement festif.",
