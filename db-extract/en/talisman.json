                                        "glosses": [
                                            "Objeto portátil al que se atribuyen virtudes mágicas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee65da0c-b358-49b3-a22a-a59c5beeb5e0",
                                                "sense_id": "56aa35ef-f7f2-3a37-abb3-cca7722ead5a",
                                                "text": "Te agradezco que sanes mi alma\nSobrevivo encontrando en tus ojos\nEl resplandor de un verde talismán\nSi al final esta vida es un sueño\nSolo sé que a tu lado me quiero despertar\nAmanecer una vez más"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
