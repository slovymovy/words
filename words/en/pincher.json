                    "sense_definition": "A surname transferred from the nickname or occupational name.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Pincher</w> arrived early to attend the annual board meeting.",
                            "target_lang_translations": {
                                "de": "Herr <w>Pincher</w> kam früh an, um an der jährlichen Vorstandssitzung teilzunehmen."
                            }
                        },
                        {
                            "text": "The historical archives list a family named <w>Pincher</w> living in the village.",
                            "target_lang_translations": {
                                "de": "Die historischen Archive verzeichnen eine Familie namens <w>Pincher</w>, die in dem Dorf lebte."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
