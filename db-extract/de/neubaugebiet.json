                ],
                "senses": [
                    {
                        "sense_id": "99fad158-61e8-3950-b2d8-c6037af9e4c1",
                        "entry_id": "d017bada-c556-3dfc-a1eb-d104887e3a70",
                        "glosses": [
                            "neu erschlossene Fläche, auf der Häuser gebaut wurden oder werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a4c95d5-1773-4502-994a-6933fed61cd2",
                                "sense_id": "99fad158-61e8-3950-b2d8-c6037af9e4c1",
                                "text": "In unserem Dorf gibt es mehrere Neubaugebiete."
                            },
                            {
                                "example_id": "2d26f171-393c-40d6-ae98-21887896f382",
                                "sense_id": "99fad158-61e8-3950-b2d8-c6037af9e4c1",
                                "text": "„In der Herzogstraße, die in einem Neubaugebiet lag, war es Schumann wiederum zu laut.“"
                            },
                            {
                                "example_id": "9d1dfbfe-6599-454d-9b9d-97bcb2d4f52e",
                                "sense_id": "99fad158-61e8-3950-b2d8-c6037af9e4c1",
                                "text": "„Ihre Kinder sind längst aus dem Haus, und seit einiger Zeit wohnt sie in dem Neubaugebiet in einer Souterrainwohnung.“"
                            },
                            {
                                "example_id": "a44ce914-fd02-4e58-9488-1b118b245221",
                                "sense_id": "99fad158-61e8-3950-b2d8-c6037af9e4c1",
                                "text": "„In Götzenhain gibt es eine Tankstelle, vier Kneipen nur mit kalter Küche, einen Arzt für Allgemeinmedizin, einen Lebensmittelmarkt im Neubaugebiet und den Damen- und Herrenfrisör Gleim, der auch Schulhefte, Tintenpatronen, Negerküsse und Brausebonbons verkauft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
