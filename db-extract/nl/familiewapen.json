                "senses": [
                    {
                        "sense_id": "5ae4e99a-0eb7-3a49-a31e-bdd867b843b5",
                        "entry_id": "a37ad196-7621-390a-8797-4b858dd8a552",
                        "glosses": [
                            "het onderscheidende kleur- en vormrijk beeldmerk van een familie of persoon, uitgebeeld op een wapenschild"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "abfe870a-f685-4633-9e64-33cc1ae68908",
                                "sense_id": "5ae4e99a-0eb7-3a49-a31e-bdd867b843b5",
                                "text": "Ach ja, opeens herinner ik het mij weer: de benoeming vond het vorige jaar plaats in Den Haag, het was oktober en Orion verscheen juist aan de hemel — mijn ambt, juffrouw, dat is mijn teken, mijn winterbeeld.Leeuwarden, 13 maart 1747Weledele Juffrouw Catharina. dat rare kruis in mijn zegel, jazeker, inderdaad, dat is ons familiewapen; gelieve er met enige eerbied over te spreken want ik heb het zelf, op zevenjarige leeftijd ontworpen."
                            },
                            {
                                "example_id": "e13888c9-dddf-4112-82d7-b39a0a7fd0fa",
                                "sense_id": "5ae4e99a-0eb7-3a49-a31e-bdd867b843b5",
                                "text": "Drie zussen uit Heerlen hadden het zilver eerder bij een kunsthandelaar gebracht met de vraag wat het waard was. Deze Heerlense zilverexpert had het Duitse familiewapen op de sauskommen herkend en schakelde de politie in."
                            }
                        ]
                    }
