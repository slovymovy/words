{
    "word_family": [
        "oozy"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ae843673-611c-342c-834c-6a821db89dd9",
                    "sense_definition": "To flow, leak, or trickle out slowly through small openings.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "flow-leak",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We watched the thick sap <w>ooze</w> from the cut in the pine tree.",
                            "target_lang_translations": {
                                "ru": "Мы наблюдали, как густая смола <w>сочится</w> из надреза на сосне."
                            }
                        },
                        {
                            "text": "The dark mud began to <w>ooze</w> through the cracks in the old wooden floor.",
                            "target_lang_translations": {
                                "ru": "Темная грязь начала <w>просачиваться</w> сквозь щели в старом деревянном полу."
                            }
                        }
                    ],
                    "synonyms": [
                        "seep",
                        "trickle",
                        "leak"
                    ],
                    "antonyms": [
                        "gush",
                        "pour"
                    ],
                    "common_phrases": [
                        "ooze through",
                        "ooze out"
                    ],
                    "target_lang_definitions": {
                        "ru": "Медленно вытекать, просачиваться или выделяться по каплям через мелкие отверстия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сочиться",
                                "target_lang_sense_clarification": "о жидкости, выделяющейся по каплям"
                            },
                            {
                                "target_lang_word": "просачиваться",
                                "target_lang_sense_clarification": "медленно проходить сквозь трещины или поры"
                            },
                            {
                                "target_lang_word": "вытекать",
                                "target_lang_sense_clarification": "медленно выходить наружу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7044f651-fc47-3856-94dc-9f9942b534aa",
                    "sense_definition": "To exhibit or give off a particular quality, emotion, or feeling strongly and naturally.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "exude-quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young actor seemed to <w>ooze</w> confidence during his first major interview.",
                            "target_lang_translations": {
                                "ru": "Казалось, молодой актер буквально <w>излучал</w> уверенность во время своего первого крупного интервью."
                            }
                        },
                        {
                            "text": "The historic hotel is beautifully restored and continues to <w>ooze</w> charm from every corner.",
                            "target_lang_translations": {
                                "ru": "Исторический отель прекрасно отреставрирован и продолжает <w>источать</w> очарование в каждом своем уголке."
                            }
                        }
                    ],
                    "synonyms": [
                        "exude",
                        "radiate",
                        "emanate"
                    ],
                    "common_phrases": [
                        "ooze confidence",
                        "ooze charm"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильно и естественно излучать, выражать или источать определенное качество, эмоцию или чувство."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "источать",
                                "target_lang_sense_clarification": "переносное значение, о качествах или чувствах"
                            },
                            {
                                "target_lang_word": "излучать",
                                "target_lang_sense_clarification": "о сильном проявлении уверенности, обаяния и т.д."
                            },
                            {
                                "target_lang_word": "брызгать",
                                "target_lang_sense_clarification": "в значении переполняться какими-то эмоциями"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4e983c3e-5da1-34ba-ae5a-de9e482b28bf",
                    "sense_definition": "Soft, wet mud or slime, especially found at the bottom of a body of water.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mud-slime",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The divers struggled to see anything through the thick <w>ooze</w> at the bottom of the lake.",
                            "target_lang_translations": {
                                "ru": "Водолазы с трудом могли что-то разглядеть сквозь густой <w>ил</w> на дне озера."
                            }
                        },
                        {
                            "text": "Many small creatures live buried deep within the river <w>ooze</w>.",
                            "target_lang_translations": {
                                "ru": "Многие мелкие существа живут, зарывшись глубоко в речную <w>тину</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "slime",
                        "mud",
                        "muck",
                        "sludge"
                    ],
                    "common_phrases": [
                        "river ooze",
                        "thick ooze"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мягкая, влажная грязь, ил или слизь, особенно на дне водоема."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ил",
                                "target_lang_sense_clarification": "мягкий осадок на дне водоема"
                            },
                            {
                                "target_lang_word": "тина",
                                "target_lang_sense_clarification": "вязкая болотная или речная грязь"
                            },
                            {
                                "target_lang_word": "жижа",
                                "target_lang_sense_clarification": "густая жидкая грязь"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "43148fb6-3b61-3370-b1e4-97563d28d6c3",
                    "sense_definition": "A slow, gentle flow or seepage of a liquid.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "flow-leak",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The steady <w>ooze</w> of water from the hillside indicated a hidden spring nearby.",
                            "target_lang_translations": {
                                "ru": "Постоянное <w>просачивание</w> воды со склона холма указывало на скрытый поблизости источник."
                            }
                        },
                        {
                            "text": "Engineers monitored the slow <w>ooze</w> of oil from the damaged pipe.",
                            "target_lang_translations": {
                                "ru": "Инженеры следили за медленным <w>истечением</w> нефти из поврежденной трубы."
                            }
                        }
                    ],
                    "synonyms": [
                        "seepage",
                        "trickle",
                        "leakage"
                    ],
                    "antonyms": [
                        "gush",
                        "flood"
                    ],
                    "common_phrases": [
                        "slow ooze"
                    ],
                    "target_lang_definitions": {
                        "ru": "Медленное, постепенное вытекание или просачивание жидкости."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "просачивание",
                                "target_lang_sense_clarification": "процесс медленного вытекания"
                            },
                            {
                                "target_lang_word": "истечение",
                                "target_lang_sense_clarification": "медленный выход жидкости наружу"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}