                "senses": [
                    {
                        "sense_id": "016c0e45-c3f5-334c-afda-ec7f2afbd382",
                        "entry_id": "15b2fcb3-5dcf-31bf-b792-fcf3d997d02b",
                        "glosses": [
                            "to be acquired [with у (u, + genitive) ‘by someone’] (idiomatically translated by English get or acquire with the object of у (u) as the subject)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "077eadce-8ab6-4921-b3d8-c9d21d00cc31",
                                "sense_id": "016c0e45-c3f5-334c-afda-ec7f2afbd382",
                                "text": "у него́ завели́сь де́ньги",
                                "translation": "he's got money (to spend)",
                                "english": "he's got money (to spend)"
                            },
                            {
                                "example_id": "300045a0-a0bb-4dd9-adce-019d090c568e",
                                "sense_id": "016c0e45-c3f5-334c-afda-ec7f2afbd382",
                                "text": "там у меня́ завели́сь но́вые друзья́",
                                "translation": "I got/met/acquired new friends there",
                                "english": "I got/met/acquired new friends there"
                            }
                        ]
                    },
                    {
                        "sense_id": "c9661fa6-1c25-3837-9748-8197771ce876",
                        "entry_id": "15b2fcb3-5dcf-31bf-b792-fcf3d997d02b",
                        "glosses": [
                            "to infest"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "250ae974-b3c8-4163-8496-ab2ee430f7e5",
                                "sense_id": "c9661fa6-1c25-3837-9748-8197771ce876",
                                "text": "в ста́ром до́ме завели́сь мы́ши",
                                "translation": "mice infested the old house",
                                "english": "mice infested the old house"
                            },
                            {
                                "example_id": "a8547730-71cc-4668-aa99-b2a8df46c02a",
                                "sense_id": "c9661fa6-1c25-3837-9748-8197771ce876",
                                "text": "у неё завели́сь вши",
                                "translation": "she's become infested with lice",
                                "english": "she's become infested with lice"
                            }
                        ]
                    },
                    {
                        "sense_id": "085cbefa-fac3-3106-8ac7-875900409f37",
                        "entry_id": "15b2fcb3-5dcf-31bf-b792-fcf3d997d02b",
                        "glosses": [
                            "to be wound up (of a mechanism or clock); to start (of a car or motor)"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "db5d7e79-8e79-3f89-8c9a-5c5a335a8e04",
                        "entry_id": "15b2fcb3-5dcf-31bf-b792-fcf3d997d02b",
                        "glosses": [
                            "to get worked up, to be turned on"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "0a571897-8764-4826-84f8-b9ad99f82b35",
                                "sense_id": "db5d7e79-8e79-3f89-8c9a-5c5a335a8e04",
                                "text": "не заводи́сь и́з-за пустяка́!",
                                "translation": "don't get all worked up over nothing!",
                                "english": "don't get all worked up over nothing!"
                            }
