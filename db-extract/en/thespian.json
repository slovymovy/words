                        ],
                        "examples": [
                            {
                                "example_id": "a3672a15-e789-446b-8801-4d98637b36fc",
                                "sense_id": "9a710298-5690-37c4-aa42-6b84ed55be2f",
                                "text": "In his way Carlyle was as much of a Thespian as Garrick or Kemble, Booth or Jeferson."
                            },
                            {
                                "example_id": "1137f84f-b17d-4fbd-93f5-041bb8f41b69",
                                "sense_id": "9a710298-5690-37c4-aa42-6b84ed55be2f",
                                "text": "Now, I don’t think you’ve met Melissa Wayne, a fellow Thespian."
                            },
                            {
                                "example_id": "408cb59c-845b-404f-a38f-27dea1bca9d9",
                                "sense_id": "9a710298-5690-37c4-aa42-6b84ed55be2f",
                                "text": "The courtyard’s empty and the Clients are inside the castle making pigs of themselves while watching a troupe of Thespians bait an animatronic bear."
                            }
                        ]
                    }
