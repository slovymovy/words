    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cf4b051f-3751-3965-828f-bd24caedfac9",
                    "sense_definition": "A portable electronic device that combines a video camera and a video recorder into one unit.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "video equipment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He used a digital <w>camcorder</w> to film his daughter's first birthday party.",
                            "target_lang_translations": {
                                "ru": "Он использовал цифровую <w>видеокамеру</w>, чтобы снять первый день рождения своей дочери."
                            }
                        },
                        {
                            "text": "Before smartphones became popular, many families owned a handheld <w>camcorder</w> for home movies.",
                            "target_lang_translations": {
                                "ru": "До того как смартфоны стали популярными, у многих семей была ручная <w>видеокамера</w> для домашних видео."
                            }
                        }
                    ],
                    "synonyms": [
                        "video camera"
                    ],
                    "common_phrases": [
                        "handheld camcorder",
                        "digital camcorder"
                    ],
                    "target_lang_definitions": {
                        "ru": "Портативное электронное устройство, объединяющее в себе видеокамеру и видеомагнитофон."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "видеокамера",
                                "target_lang_sense_clarification": "портативное устройство для съемки"
                            },
                            {
                                "target_lang_word": "камкордер",
                                "target_lang_sense_clarification": "технический термин для совмещенной камеры и рекордера"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5ec326dd-8d06-3a54-af27-98bee393e7fc",
                    "sense_definition": "To record video and audio using a camcorder.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "recording action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tourists were busy <w>camcordering</w> every monument they passed in the city center.",
                            "target_lang_translations": {
                                "ru": "Туристы были заняты тем, что <w>снимали на видеокамеру</w> каждый памятник, мимо которого проходили в центре города."
                            }
                        },
                        {
                            "text": "He <w>camcordered</w> the entire wedding ceremony from the back of the church.",
                            "target_lang_translations": {
                                "ru": "Он <w>записал на видео</w> всю свадебную церемонию, находясь в задней части церкви."
                            }
                        }
                    ],
                    "synonyms": [
                        "film",
                        "videotape",
                        "record"
                    ],
                    "target_lang_definitions": {
                        "ru": "Записывать видео и аудио с помощью видеокамеры."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "снимать на видеокамеру",
                                "target_lang_sense_clarification": "процесс записи видео"
                            },
                            {
                                "target_lang_word": "записывать на видео",
                                "target_lang_sense_clarification": "фиксировать происходящее"
                            }
                        ]
                    }
                }
            ]
        }
