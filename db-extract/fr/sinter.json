                                        "glosses": [
                                            "An alluvial sediment deposited by a mineral spring."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc0f7e93-c3d6-40c5-b5bf-750784cdbbc8",
                                                "sense_id": "b5b23c71-8c78-3dfc-8823-ad004c971c8d",
                                                "text": "That water at a high temperature can hold quartz in solution is well illustrated by the deposits of silicious sinter, thrown down by thermal springs, […]"
                                            },
                                            {
                                                "example_id": "c02747b7-8fe3-4019-a971-b9b7e8ebcb5d",
                                                "sense_id": "b5b23c71-8c78-3dfc-8823-ad004c971c8d",
                                                "text": "It has steaming lakes, pools, and streams, healing baths and springs, acidulous basins of emerald, opal, and orange, and tinted terraces of sinter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e339c37-2a53-3eed-8915-742495fc0ac5",
                                        "entry_id": "cfdd9187-c58a-3a1b-ae82-9154d77aaa93",
                                        "glosses": [
                                            "A mass formed by sintering."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5420191-d72b-430e-bdb4-ff829c4760f7",
                                                "sense_id": "4e339c37-2a53-3eed-8915-742495fc0ac5",
                                                "text": "Consider a copper sinter material with spherical sinter particles in an early stage of the sintering process, see Fig. 3.5(a)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca567cb4-481e-3a6a-8389-ad3df14f55f6",
                                        "entry_id": "cfdd9187-c58a-3a1b-ae82-9154d77aaa93",
                                        "glosses": [
                                            "A mixture of iron ore and fluxes added to a blast furnace."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f2633f6-66a8-44a4-b562-20dd3ea3e526",
                                                "sense_id": "ca567cb4-481e-3a6a-8389-ad3df14f55f6",
                                                "text": "A combination of fully and partly automatic working provides speed, efficiency and manpower economy in unloading coal, home ore, foreign ore and coke and concentrates from incoming wagons and loading outgoing wagons for despatch to the company's Ebbw works with export ore and sinter."
                                            }
                                        ]
                                    }
                                ]
