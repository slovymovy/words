                    "sense_definition": "spowodować, że coś rozprzestrzeni się w wielu kierunkach",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "rozprzestrzenianie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Plotki potrafią <w>rozsiać</w> się w biurze w ciągu kilku minut.",
                            "target_lang_translations": {
                                "ru": "Слухи могут <w>распространиться</w> по офису за несколько минут."
                            }
                        },
                        {
                            "text": "Wiatr pomógł <w>rozsiać</w> zarodniki grzybów po całym lesie.",
                            "target_lang_translations": {
                                "ru": "Ветер помог <w>разнести</w> споры грибов по всему лесу."
                            }
                        }
                    ],
                    "synonyms": [
                        "roznieść",
                        "rozprzestrzenić"
                    ],
                    "common_phrases": [
                        "rozsiać plotki",
                        "rozsiać zamęt"
                    ],
                    "target_lang_definitions": {
                        "ru": "стать причиной того, что что-то распространилось во многих направлениях"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "распространить",
