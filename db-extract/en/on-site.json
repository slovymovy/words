                                "sense_id": "15ca4d5f-0162-3aae-a43b-36f4dae5a7d8",
                                "text": "Our supplier offers on-site support."
                            },
                            {
                                "example_id": "ba2d5e73-c014-4162-85f4-967fec9472ed",
                                "sense_id": "15ca4d5f-0162-3aae-a43b-36f4dae5a7d8",
                                "text": "Production has restarted at Derby Litchurch Lane, after Bombardier agreed new working practices with on-site trade union representatives."
                            }
