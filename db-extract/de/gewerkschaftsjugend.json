                ],
                "senses": [
                    {
                        "sense_id": "140a893c-457d-37c4-b1a2-aa0197b2b3bd",
                        "entry_id": "1f89f324-deaf-3ccf-93c6-6c811f382472",
                        "glosses": [
                            "Jugendliche, die in einer Gewerkschaft organisiert sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1814b162-7197-4f23-87cd-7a85f15ce16d",
                                "sense_id": "140a893c-457d-37c4-b1a2-aa0197b2b3bd",
                                "text": "„Kritik an dem Freispruch übte die Österreichische Gewerkschaftsjugend.“"
                            },
                            {
                                "example_id": "8d9a85f1-5a21-498d-95bc-547488484550",
                                "sense_id": "140a893c-457d-37c4-b1a2-aa0197b2b3bd",
                                "text": "„Die auf Junckers Auslassungen erfolgte Schelte von Seiten der Gewerkschaftsjugend dürfte es Schmit erleichtern, seinen Anspruch auf alleinige Zuständigkeit in diesen Fragen geltend zu machen.“"
                            },
                            {
                                "example_id": "a671fb82-03cf-4b04-a6d9-a5fb36ae4f60",
                                "sense_id": "140a893c-457d-37c4-b1a2-aa0197b2b3bd",
                                "text": "„‚15 Sekunden Ruhm‘ versprachen sich Vertreter der Gewerkschaftsjugend sowie der SJ (Sozialistischen Jugend) bei den Eisenstädter Wein- und Genusstagen.“"
                            },
                            {
                                "example_id": "9265e821-e2d2-4890-9e8d-e315aa7a93cd",
                                "sense_id": "140a893c-457d-37c4-b1a2-aa0197b2b3bd",
                                "text": "„Am 1. September hatte die Gewerkschaftsjugend eine Feierstunde am KZ-Friedhof, wobei die Pflege der Anlage allgemein gelobt wurde.“"
                            },
                            {
                                "example_id": "ffedacdd-251e-4803-a7f1-f5e58020dd74",
                                "sense_id": "140a893c-457d-37c4-b1a2-aa0197b2b3bd",
                                "text": "„Die Linksjugend hatte Popcorn und Musik dabei, und bei der Gewerkschaftsjugend konnte man Videospiele ausprobieren.“"
                            },
                            {
                                "example_id": "1b581ee3-2d5b-48c7-8985-b2362bf1ebc0",
                                "sense_id": "140a893c-457d-37c4-b1a2-aa0197b2b3bd",
                                "text": "„Sie gehören der Gewerkschaftsjugend an und sind zugleich Mitglieder des «Funke», einer marxistischen Strömung in der Juso und den Gewerkschaften.“"
                            },
                            {
                                "example_id": "c5da13b1-f8cf-47ff-8694-91bd62e536b3",
                                "sense_id": "140a893c-457d-37c4-b1a2-aa0197b2b3bd",
                                "text": "„Über andere Anzeichen, die in die gleiche Richtung deuten, weiß Pia Möller von der Gewerkschaftsjugend zu berichten.“"
                            },
                            {
                                "example_id": "8adfaaf3-9355-45b7-8fa0-4dbd6b3cb661",
                                "sense_id": "140a893c-457d-37c4-b1a2-aa0197b2b3bd",
                                "text": "„Anfangs liefen die Planungen der Gewerkschaftsjugend und der Waiblinger Initiative für eine Kundgebung parallel, doch inzwischen haben sich die Engagierten zusammengetan, sodass nun ein Bündnis aus Gewerkschaften, Vereinen, Initiativen und Bürgerinnen und Bürgern entstanden ist, das zur Kundgebung gegen Faschismus und Rassismus aufruft.“"
                            },
                            {
                                "example_id": "674a4807-e18e-486b-bcba-c9683abdd19b",
                                "sense_id": "140a893c-457d-37c4-b1a2-aa0197b2b3bd",
                                "text": "„In Innsbruck sind etwa die Diakonie, die Gewerkschaftsjugend und die Scientists for Future mit an Bord, in Linz die Caritas, die Volkshilfe und die Omas gegen rechts.“"
                            },
                            {
                                "example_id": "89d6f8d2-4572-4bed-8606-e44899be9c27",
                                "sense_id": "140a893c-457d-37c4-b1a2-aa0197b2b3bd",
                                "text": "„Die Gewerkschaftsjugend vertritt Jugendliche vor Arbeitgebern und in der Politik – ‚für faire Löhne, bessere Arbeitsbedingungen und starke Rechte in Ausbildung & Beruf‘.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
