{
    "word_family": [
        "quoique"
    ],
    "entries": [
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "b6570a3e-2781-3f5b-8226-de3bf7933558",
                    "sense_definition": "Introduit une proposition subordonnée complétive qui sert d'objet ou de sujet au verbe principal.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "subordination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je sais bien <w>que</w> tu as beaucoup de travail cette semaine."
                        },
                        {
                            "text": "Le médecin pense <w>qu'</w>elle sera guérie avant la fin du mois."
                        }
                    ],
                    "common_phrases": [
                        "je pense que",
                        "il faut que",
                        "le fait que"
                    ]
                },
                {
                    "sense_id": "c269b6f1-125b-32ee-b517-bcdabe0a1aa6",
                    "sense_definition": "Introduit le second terme d'une comparaison après un comparatif de supériorité, d'infériorité ou d'égalité.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "comparaison",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce nouveau modèle est nettement plus rapide <w>que</w> l'ancien ordinateur."
                        },
                        {
                            "text": "Cette valise est aussi lourde <w>que</w> celle de ton frère."
                        }
                    ],
                    "common_phrases": [
                        "plus que",
                        "moins que",
                        "autant que"
                    ]
                },
                {
                    "sense_id": "4aaf6368-f217-3c3e-9236-fc7b89667490",
                    "sense_definition": "Remplace une autre conjonction dans une seconde proposition subordonnée pour éviter la répétition.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "subordination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Si le soleil revient et <w>que</w> le vent cesse, nous irons nous promener."
                        },
                        {
                            "text": "Quand le train arrivera et <w>que</w> les portes s'ouvriront, nous monterons ensemble."
                        }
                    ]
                },
                {
                    "sense_id": "beb9d908-0da8-3755-8614-a91f213e632a",
                    "sense_definition": "Marque la succession temporelle immédiate après des locutions comme « à peine ».",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il venait à peine de sortir <w>qu'</w>un orage violent a éclaté."
                        },
                        {
                            "text": "Nous étions à peine arrivés à l'hôtel <w>que</w> le téléphone a sonné."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "8804abf7-3984-3e5d-9481-e4767ac26711",
                    "sense_definition": "Pronom relatif invariable représentant une personne ou une chose en fonction de complément d'objet direct.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "relatif",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le roman captivant <w>que</w> tu m'as prêté m'a beaucoup plu."
                        },
                        {
                            "text": "Les amis <w>qu'</w>il a invités ce soir viennent d'arriver."
                        }
                    ],
                    "common_phrases": [
                        "ce que",
                        "celui que"
                    ]
                },
                {
                    "sense_id": "6ed88dbc-0769-3102-b0b9-d62b3c7fc7b0",
                    "sense_definition": "Pronom interrogatif désignant une chose inanimée en fonction de complément d'objet direct.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "interrogatif",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Que</w> désirez-vous commander comme dessert pour ce midi ?"
                        },
                        {
                            "text": "<w>Qu'</w>avez-vous pensé de notre dernière présentation au bureau ?"
                        }
                    ],
                    "common_phrases": [
                        "que faire",
                        "que dire",
                        "qu'est-ce que"
                    ]
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "2e5a5b39-fc2c-3da5-a12f-773d2bc9b3c7",
                    "sense_definition": "Employé avec la négation « ne » pour exprimer une restriction équivalant à « seulement ».",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "restriction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant son régime, il ne mange <w>que</w> des légumes cuits à la vapeur."
                        },
                        {
                            "text": "Cette petite boutique artisanale n'ouvre <w>qu'</w>en fin de semaine."
                        }
                    ],
                    "synonyms": [
                        "seulement"
                    ],
                    "common_phrases": [
                        "ne faire que",
                        "rien que"
                    ]
                },
                {
                    "sense_id": "6db66bf1-00ad-38c5-9254-32ce05cc9acc",
                    "sense_definition": "Marque l'exclamation ou l'intensité dans une phrase exprimant un sentiment vif.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "exclamation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Que</w> ce paysage de montagne est magnifique sous la neige !"
                        },
                        {
                            "text": "<w>Qu'</w>il est agréable de se reposer au soleil dans le jardin !"
                        }
                    ],
                    "common_phrases": [
                        "que c'est beau"
                    ]
                },
                {
                    "sense_id": "82aebebf-07ff-3f05-b260-bb04face06be",
                    "sense_definition": "Introduit un souhait, un ordre ou une prière avec un verbe conjugué au subjonctif.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "injonction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Que</w> la fête commence enfin après tous ces préparatifs !"
                        },
                        {
                            "text": "<w>Qu'</w>ils fassent bien attention en traversant la route glissante."
                        }
                    ]
                },
                {
                    "sense_id": "c1560da9-68ef-30bc-bfe4-2955db97b991",
                    "sense_definition": "Employé avec une négation pour interroger sur la cause ou le motif.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "interrogatif",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Que</w> ne le disiez-vous plus tôt pour éviter ce malentendu ?"
                        },
                        {
                            "text": "<w>Que</w> n'avez-vous accepté cette offre exceptionnelle quand il était temps ?"
                        }
                    ],
                    "synonyms": [
                        "pourquoi"
                    ],
                    "common_phrases": [
                        "que ne"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Emploi littéraire et vieilli"
                        }
                    ]
                }
            ]
        }
    ]
}