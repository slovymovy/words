{
    "word_family": [
        "longitudinally",
        "longitude"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "13194f02-defc-31a3-9898-bf5077f5897c",
                    "sense_definition": "Relating to or involving research where the same subjects or variables are observed repeatedly over an extended period of time.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "research",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The university conducted a <w>longitudinal</w> study to track children's reading habits.",
                            "target_lang_translations": {
                                "zh": "该大学开展了一项<w>纵向</w>研究，以追踪儿童的阅读习惯。"
                            }
                        },
                        {
                            "text": "Researchers collected <w>longitudinal</w> data across three decades to monitor health trends.",
                            "target_lang_translations": {
                                "zh": "研究人员收集了跨越三十年的<w>追踪</w>数据，以监测健康趋势。"
                            }
                        }
                    ],
                    "antonyms": [
                        "cross-sectional"
                    ],
                    "common_phrases": [
                        "longitudinal study",
                        "longitudinal research",
                        "longitudinal data",
                        "longitudinal survey"
                    ],
                    "target_lang_definitions": {
                        "zh": "（科研中）追踪的，纵向的，长期跟踪的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "纵向的",
                                "target_lang_sense_clarification": "研究或数据"
                            },
                            {
                                "target_lang_word": "追踪的",
                                "target_lang_sense_clarification": "长期调查或研究"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6d9cdaec-de22-3ecd-bde7-be9cf8bb59dc",
                    "sense_definition": "Extending, running, or placed in the direction of the length or long axis of a body or structure.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "spatial",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The subway cars were designed with <w>longitudinal</w> seating to allow more standing room.",
                            "target_lang_translations": {
                                "zh": "地铁车厢采用<w>纵向</w>座椅设计，以腾出更多的站立空间。"
                            }
                        },
                        {
                            "text": "The surgeon made a small <w>longitudinal</w> cut along the patient's arm.",
                            "target_lang_translations": {
                                "zh": "外科医生沿着患者的手臂做了一个很小的<w>纵向</w>切口。"
                            }
                        }
                    ],
                    "antonyms": [
                        "transverse"
                    ],
                    "common_phrases": [
                        "longitudinal axis",
                        "longitudinal section",
                        "longitudinal stripe"
                    ],
                    "target_lang_definitions": {
                        "zh": "纵向的，沿长轴方向的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "纵向的",
                                "target_lang_sense_clarification": "排列或切口方向"
                            },
                            {
                                "target_lang_word": "长轴方向的",
                                "target_lang_sense_clarification": "几何或结构上"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b369657-498e-3237-8911-53f501bf0daf",
                    "sense_definition": "Pertaining or relating to length.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "spatial",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The aircraft rolled smoothly around its <w>longitudinal</w> axis during the flight test.",
                            "target_lang_translations": {
                                "zh": "在飞行测试中，飞机平稳地绕其<w>纵向</w>轴线滚转。"
                            }
                        },
                        {
                            "text": "Engineers measured the <w>longitudinal</w> expansion of the metal beam caused by extreme heat.",
                            "target_lang_translations": {
                                "zh": "工程师测量了极端高温引起的金属梁<w>长度</w>膨胀。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "长度的，沿长度方向的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "纵向的",
                                "target_lang_sense_clarification": "长度测量或轴线"
                            },
                            {
                                "target_lang_word": "长度的",
                                "target_lang_sense_clarification": "尺寸或膨胀"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1b8f0920-b4fb-3d9b-8a6e-f727caa990bb",
                    "sense_definition": "Acting, moving, or measured forward or backward relative to a defined direction.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "spatial",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The vehicle experienced strong <w>longitudinal</w> acceleration when the driver pressed the pedal.",
                            "target_lang_translations": {
                                "zh": "驾驶员踩下踏板时，车辆产生了强烈的<w>纵向</w>加速度。"
                            }
                        },
                        {
                            "text": "Sound travels through the air in the form of a <w>longitudinal</w> wave.",
                            "target_lang_translations": {
                                "zh": "声音以<w>纵</w>波的形式在空气中传播。"
                            }
                        }
                    ],
                    "antonyms": [
                        "transverse"
                    ],
                    "common_phrases": [
                        "longitudinal wave",
                        "longitudinal acceleration"
                    ],
                    "target_lang_definitions": {
                        "zh": "（物理或动力学中）纵向的，前后方向的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "纵向的",
                                "target_lang_sense_clarification": "加速度或波"
                            },
                            {
                                "target_lang_word": "纵",
                                "target_lang_sense_clarification": "如纵波"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d8e61a1d-e6d7-30d4-b202-fcb7ad4c8352",
                    "sense_definition": "Relating to geographic longitude or lines running from pole to pole.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The navigator carefully checked the ship's <w>longitudinal</w> position on the maritime chart.",
                            "target_lang_translations": {
                                "zh": "领航员在海图上仔细核对了船只的<w>经度</w>位置。"
                            }
                        },
                        {
                            "text": "Time zones roughly follow the Earth's <w>longitudinal</w> lines.",
                            "target_lang_translations": {
                                "zh": "时区大致沿着地球的<w>经</w>线划分。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "longitudinal position",
                        "longitudinal line"
                    ],
                    "target_lang_definitions": {
                        "zh": "经度的，经线的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "经度的",
                                "target_lang_sense_clarification": "地理位置"
                            },
                            {
                                "target_lang_word": "经线的",
                                "target_lang_sense_clarification": "地理坐标线"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "176bf770-a960-3125-941d-72d71bd2550c",
                    "sense_definition": "A structural part or member placed lengthwise, especially in shipbuilding or aerospace construction.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "engineering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The shipbuilders welded each steel <w>longitudinal</w> to the ship's bottom plating.",
                            "target_lang_translations": {
                                "zh": "造船工人将每一根钢制<w>纵梁</w>焊接在船底板上。"
                            }
                        },
                        {
                            "text": "Workers inspected every main <w>longitudinal</w> inside the aircraft's damaged wing.",
                            "target_lang_translations": {
                                "zh": "工人们检查了受损机翼内部的每一根主<w>纵梁</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（造船或航空航天中的）纵梁，纵向构件"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "纵梁",
                                "target_lang_sense_clarification": "船体或机翼主要受力件"
                            },
                            {
                                "target_lang_word": "纵向构件",
                                "target_lang_sense_clarification": "工程结构件"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9f651b20-4db2-3b5a-88c2-a12c89f445b7",
                    "sense_definition": "A railway sleeper or tie that lies parallel to and directly underneath the track rail.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "railway",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The track was supported by a heavy wooden <w>longitudinal</w> along the bridge.",
                            "target_lang_translations": {
                                "zh": "桥上的铁轨由一根沉重的木质<w>纵枕</w>支撑。"
                            }
                        },
                        {
                            "text": "Engineers replaced the cracked <w>longitudinal</w> to ensure proper track alignment.",
                            "target_lang_translations": {
                                "zh": "工程师更换了开裂的<w>纵向轨枕</w>，以确保轨道几何对齐。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（沿轨道方向铺设的）纵枕，纵向轨枕"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "纵枕",
                                "target_lang_sense_clarification": "铁路轨道部件"
                            },
                            {
                                "target_lang_word": "纵向轨枕",
                                "target_lang_sense_clarification": "铁轨结构"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}