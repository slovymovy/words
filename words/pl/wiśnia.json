{
    "word_family": [
        "wisienka",
        "wiśniowy",
        "wiśniówka"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "23e0ea6b-d55c-302d-998d-2009c1bb077b",
                    "sense_definition": "czerwony, soczysty owoc pestkowy wiśni o słodko-kwaśnym smaku",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "owoc",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W lipcu zbieramy dojrzałe, słodkie <w>wiśnie</w> na pyszny kompot.",
                            "target_lang_translations": {
                                "en": "In July, we pick ripe, sweet <w>cherries</w> for a delicious compote.",
                                "zh": "七月份，我们采摘成熟甜美的<w>酸樱桃</w>来煮美味的水果甜汤。"
                            }
                        },
                        {
                            "text": "Madzia zaczerwieniła się na twarzy jak najczerwieńsza <w>wiśnia</w>.",
                            "target_lang_translations": {
                                "en": "Madzia's face flushed red like the reddest <w>cherry</w>.",
                                "zh": "玛齐亚的脸红得就像熟透的<w>樱桃</w>一样。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "dojrzała wiśnia",
                        "dżem z wiśni",
                        "sok z wiśni"
                    ],
                    "target_lang_definitions": {
                        "en": "a red, juicy stone fruit with a tart or sweet-sour taste",
                        "zh": "酸樱桃，酸甜多汁的红色核果"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sour cherry",
                                "target_lang_sense_clarification": "fruit, specifically tart cherry (Prunus cerasus)"
                            },
                            {
                                "target_lang_word": "cherry",
                                "target_lang_sense_clarification": "fruit in general"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "酸樱桃",
                                "target_lang_sense_clarification": "水果，多用于制作果汁、果酱"
                            },
                            {
                                "target_lang_word": "樱桃",
                                "target_lang_sense_clarification": "统称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "60be259d-01b7-38fa-8fb7-3d6ac8bdc7b8",
                    "sense_definition": "drzewo lub krzew owocowy z rodziny różowatych, wydający kuliste, czerwone owoce",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "drzewo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W naszym starym ogrodzie rośnie duża, kwitnąca na biało <w>wiśnia</w>.",
                            "target_lang_translations": {
                                "en": "In our old garden grows a large <w>cherry tree</w> blooming in white.",
                                "zh": "我们家的老花园里长着一棵开着白花的大<w>樱桃树</w>。"
                            }
                        },
                        {
                            "text": "Wiosną każda <w>wiśnia</w> w sadzie pokrywa się pięknym kwiatem.",
                            "target_lang_translations": {
                                "en": "In spring, every <w>cherry tree</w> in the orchard becomes covered with beautiful blossoms.",
                                "zh": "春天，果园里的每一棵<w>樱桃树</w>都开满了美丽的花朵。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "kwitnąca wiśnia",
                        "drzewo wiśni"
                    ],
                    "target_lang_definitions": {
                        "en": "a fruit tree or shrub of the rose family that bears round red fruit",
                        "zh": "蔷薇科落叶乔木或灌木，结红色球形果实"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cherry tree",
                                "target_lang_sense_clarification": "tree"
                            },
                            {
                                "target_lang_word": "sour cherry tree",
                                "target_lang_sense_clarification": "specifically the tree of Prunus cerasus"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "樱桃树",
                                "target_lang_sense_clarification": "植物"
                            },
                            {
                                "target_lang_word": "酸樱桃树",
                                "target_lang_sense_clarification": "植物学名称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ab4c2f5d-09a1-3242-9aad-aeab1020ccba",
                    "sense_definition": "o osobie niekoleżeńskiej, chciwej lub nieskorej do dzielenia się z innymi",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "człowiek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nie bądź taka <w>wiśnia</w> i poczęstuj kolegów cukierkami.",
                            "target_lang_translations": {
                                "en": "Don't be such a <w>cheapskate</w> and offer some candies to your classmates.",
                                "zh": "别那么<w>小气</w>，拿糖果招待一下朋友们吧。"
                            }
                        },
                        {
                            "text": "Ale z ciebie <w>wiśnia</w>, nawet kawałka ciasta nie chciałeś zostawić!",
                            "target_lang_translations": {
                                "en": "What a <w>stingy guy</w> you are, you didn't even want to leave a piece of cake!",
                                "zh": "你真是个<w>小气鬼</w>，连一块蛋糕都不愿意留！"
                            }
                        }
                    ],
                    "synonyms": [
                        "świnia"
                    ],
                    "common_phrases": [
                        "być wiśnią"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "używane potocznie, żartobliwie lub z wyrzutem"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "an ungenerous, selfish, or uncooperative person who refuses to share",
                        "zh": "（口语）小气鬼，吝啬、不愿与人分享的人"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cheapskate",
                                "target_lang_sense_clarification": "stingy person unwilling to share"
                            },
                            {
                                "target_lang_word": "spoilsport",
                                "target_lang_sense_clarification": "uncooperative or ungenerous person"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "小气鬼",
                                "target_lang_sense_clarification": "指不肯分享的人"
                            },
                            {
                                "target_lang_word": "吝啬鬼",
                                "target_lang_sense_clarification": "指自私小气的人"
                            }
                        ]
                    }
                }
            ]
        }
    ]
