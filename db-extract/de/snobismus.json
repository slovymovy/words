                    },
                    {
                        "translation_id": "9e468f2f-f693-4ae6-bf68-0bc53a0bafe7",
                        "source_entry_id": "d7b9b4a9-6c46-3606-ab90-ec7a1c2ba84f",
                        "source_sense_id": "6626992a-2db4-3c50-90bb-90346e7ae4c3",
                        "target_lang_word": "snobbism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "snobbism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b760f1d8-944e-3a7b-91b9-998caacb0716",
                                        "entry_id": "6791ee12-d546-30a3-bc7e-c88005f25176",
                                        "glosses": [
                                            "A snobbish attitude, particularly in relation to art or high culture."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a26d4f4-cdea-4e70-85c5-da048fa2db6a",
                                                "sense_id": "b760f1d8-944e-3a7b-91b9-998caacb0716",
                                                "text": "It is no answer to say that \"my\" programme in art and letters has gradually been forced through, has, to some extent, grabbed its place in the sun. For one thing, I don't care about \"minority culture.\" I have never cared a damn about snobbisms or for writing ultimately for the few."
                                            },
                                            {
                                                "example_id": "516dc654-95e0-4440-be8f-6f9699545658",
                                                "sense_id": "b760f1d8-944e-3a7b-91b9-998caacb0716",
                                                "text": "This question of the part played by culture in a civilisation prompts the similar question of the role of snobbism."
                                            },
                                            {
                                                "example_id": "2e403560-c944-4c7a-82e4-d53c2aa869d3",
                                                "sense_id": "b760f1d8-944e-3a7b-91b9-998caacb0716",
                                                "text": "Had Zach been something other than a butcher, she would doubtless have found other snobbisms."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9c54aef2-21d4-45a3-9fb0-2279851e3da8",
