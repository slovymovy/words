                        "glosses": [
                            "Relier l’estomac et l’intestin grêle de quelqu'un par une opération chirurgicale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a5f120e-0e90-4c7f-989a-062ed65282be",
                                "sense_id": "b89e0d94-f812-3171-999b-7ecda3a25525",
                                "text": "Contribution à l’étude des fonctions de l’estomac étudiées sur un malade atteint de cancer du pylore et gastroentérostomisé, par MM. Dehove et Soupault."
                            },
                            {
                                "example_id": "c6a5f0a5-ef7e-41ee-a8d7-f3e3d325cce9",
                                "sense_id": "b89e0d94-f812-3171-999b-7ecda3a25525",
                                "text": "C’est ainsi que chez un de nos malades, gastroentérostomisé en 1908, tous les troubles disparurent pendant deux ans et le malade augmenta de 15 kilogrammes."
                            }
