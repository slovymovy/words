                    "sense_id": "a8289f37-1fc3-367c-abc2-357d0da57a5c",
                    "sense_definition": "eerste persoon enkelvoud tegenwoordige tijd van <w>zuiveren</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>zuiver</w> het water met een speciaal filter voordat ik het drink.",
                            "target_lang_translations": {
                                "en": "I <w>purify</w> the water with a special filter before I drink it."
                            }
                        },
                        {
                            "text": "Elke ochtend <w>zuiver</w> ik mijn huid met een milde lotion.",
                            "target_lang_translations": {
                                "en": "Every morning I <w>cleanse</w> my skin with a mild lotion."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "verb form"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "first person singular present tense of 'to purify'"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "purify",
                                "target_lang_sense_clarification": "to make clean or pure"
                            },
                            {
                                "target_lang_word": "filter",
                                "target_lang_sense_clarification": "to remove impurities from a liquid"
                            },
                            {
                                "target_lang_word": "cleanse",
                                "target_lang_sense_clarification": "to clean thoroughly"
                            }
                        ]
