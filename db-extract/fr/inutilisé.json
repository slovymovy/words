                                        "entry_id": "9d4d7c9a-1e68-3f04-8cc3-c8aafdbf2221",
                                        "glosses": [
                                            "nicht ausgeschöpft/realisiert (genutzt)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e48563a3-e629-479d-a4b6-76eea92f0e84",
                                                "sense_id": "79beb178-91a4-3510-9d11-dccf5ad4f035",
                                                "text": "Diese Mitarbeitergruppe stellt in Hinblick auf den Service ein ungenutztes Potential dar."
                                            },
                                            {
                                                "example_id": "5150215f-68f0-4ba1-920b-ead407b77fed",
                                                "sense_id": "79beb178-91a4-3510-9d11-dccf5ad4f035",
                                                "text": "Und wieder eine ungenutzte Gelegenheit, aus der man hätte viel machen können."
                                            },
                                            {
                                                "example_id": "39a19757-475a-4a3e-9c80-8bda06ba10d7",
                                                "sense_id": "79beb178-91a4-3510-9d11-dccf5ad4f035",
                                                "text": "[Photovoltaik:] „Wenn man durch die Städte geht, ist es manchmal zum Haareraufen, wie viele Flächen noch ungenutzt sind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5482821f-8059-4ec3-8bca-62598cbe1574",
