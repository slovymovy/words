                                "target_senses": [
                                    {
                                        "sense_id": "a5cd73e1-6a9a-35c7-8a3d-0d0bebf5b698",
                                        "entry_id": "86083667-c8b5-3722-b1c2-82e28368dc94",
                                        "glosses": [
                                            "eine Information als Ergebnis einer Suche erhalten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4bf87294-9653-45b5-9cad-26e2f30712cc",
                                                "sense_id": "a5cd73e1-6a9a-35c7-8a3d-0d0bebf5b698",
                                                "text": "Hast du was rausgefunden?"
                                            },
                                            {
                                                "example_id": "2189e7a5-3d19-411b-b8b5-f6a9bbda737e",
                                                "sense_id": "a5cd73e1-6a9a-35c7-8a3d-0d0bebf5b698",
                                                "text": "Es war gar nicht so einfach, den Nachnamen rauszufinden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "df4858c2-e9dc-3fe9-8bf1-72fef71ffd87",
                                        "entry_id": "86083667-c8b5-3722-b1c2-82e28368dc94",
                                        "glosses": [
                                            "den Weg nach draußen kennen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e585bb9-7c42-4361-b98a-c02903673523",
                                                "sense_id": "df4858c2-e9dc-3fe9-8bf1-72fef71ffd87",
                                                "text": "Findest du alleine raus?"
                                            },
                                            {
                                                "example_id": "3df0b56e-0eee-48fe-9450-3c7f6e928a8b",
                                                "sense_id": "df4858c2-e9dc-3fe9-8bf1-72fef71ffd87",
                                                "text": "„Wenn ein ungeliebter Besuch einfach nicht nach Hause gehen möchte, weshalb geht man dann nicht einfach ins Bett und überlässt seinen Besuch sich selbst? Frei nach dem Motto: ‚Raus findet man immer!‘“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
