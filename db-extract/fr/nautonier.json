                ],
                "senses": [
                    {
                        "sense_id": "3d868976-ba53-3390-9490-4fc2865628a6",
                        "entry_id": "3d01a9c6-aa7a-379c-b46a-abc1fb35723a",
                        "glosses": [
                            "Celui qui conduit un navire, une barque."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "16f92d27-70ef-46a1-b505-6af6b3043f89",
                                "sense_id": "3d868976-ba53-3390-9490-4fc2865628a6",
                                "text": "Quel nautonier hardi sur la mer écumeuse,\nComme Ulysse autrefois vers l’île de Circé,\nVers la sainte Paphos guidant sa nef pieuse,\nÀ l’heure favorable entre au port délaissé ?"
                            },
                            {
                                "example_id": "c2333fd4-6a37-46a4-8d72-cdb5ddc2a573",
                                "sense_id": "3d868976-ba53-3390-9490-4fc2865628a6",
                                "text": "Le prudent nautonier se réjouit d’avoir passé le détroit de Scylla."
                            },
                            {
                                "example_id": "f2e4d7c0-3cf0-42c6-a8ac-e3d4e54cce8f",
                                "sense_id": "3d868976-ba53-3390-9490-4fc2865628a6",
                                "text": "Que dire enfin ? le robuste nautonier radouba, calfata, renfloua la nef avariée de l’Église."
                            }
                        ]
                    },
                    {
                        "sense_id": "bf876e21-066e-33f5-8304-984b2fe775ec",
                        "entry_id": "3d01a9c6-aa7a-379c-b46a-abc1fb35723a",
                        "glosses": [
                            "Charon."
                        ],
                        "tags": [
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "03d1c346-954b-4b29-ba3a-27bc3e436ee1",
                                "sense_id": "bf876e21-066e-33f5-8304-984b2fe775ec",
                                "text": "Dans la deuxième partie sont tous les coupables, qui s’empressent de passer le fleuve Achéron dans la barque du nautonier des Enfers."
                            }
                        ]
                    }
