                                                "sense_id": "94124a87-008f-3197-9d55-6e52dd785084",
                                                "text": "Und als der Alte am nächsten Tag dorthin kam, schenkte ihm der Sultan tausend Rial für neue Ziegen."
                                            },
                                            {
                                                "example_id": "f3576571-8741-46d5-a62a-2e2e793e9493",
                                                "sense_id": "94124a87-008f-3197-9d55-6e52dd785084",
                                                "text": "Im übrigen schätzte der eine den Exporterlös auf dreißig Millionen Rial, der andere auf drei Millionen Rial."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "463e822a-f968-384b-b808-712ab2a9aeeb",
