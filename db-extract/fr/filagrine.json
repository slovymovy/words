                        ],
                        "examples": [
                            {
                                "example_id": "20fb8e79-6fbf-476b-8062-472a0a2af1a8",
                                "sense_id": "735bfc50-2f30-39f1-820c-f643286f2bee",
                                "text": "Elles ont une capacité à certaines protéines intracellulaires cutanées, profilagrine et filagrine, qui provoque sur le plan histologique un décollement intra-épidermique entre le stratum granulosum et le stratum spinosum, créant cliniquement des lésion bulleuses."
                            },
                            {
                                "example_id": "ff8beba6-9c8a-4a16-8d40-46de15573f81",
                                "sense_id": "735bfc50-2f30-39f1-820c-f643286f2bee",
                                "text": "Cet anticorps reconnaît aussi la filagrine épidermique humaine des kératinocytes."
                            }
                        ]
