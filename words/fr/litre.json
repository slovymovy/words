                    "sense_definition": "Contenu d'une bouteille ou d'un récipient de cette capacité.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "recipient",
                    "name_type": "no",
                    "examples": [
