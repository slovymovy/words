                                        "entry_id": "a432ba47-fb31-32f4-ba5c-59c1244ff639",
                                        "glosses": [
                                            "zweiter Wochentag gemäß ISO 8601; dritter Wochentag nach jüdischer, christlicher und islamischer Zählung; Tag zwischen Montag und Mittwoch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d494f8d2-60e1-4dc8-958c-01016195c7a8",
                                                "sense_id": "b6631863-2913-3242-95bc-7e7f7f5c9825",
                                                "text": "Am Dienstag gehen wir immer ins Kino."
                                            },
                                            {
                                                "example_id": "7089f921-9a63-42a0-b42b-49f4e3db0c77",
                                                "sense_id": "b6631863-2913-3242-95bc-7e7f7f5c9825",
                                                "text": "„In zwei Jahren solle die Wiener Basis auf 14 bis 15 Mittelstrecken-Flieger und in fünf Jahren auf 30 Jets wachsen, sagte IAG-Chef Willie Walsh am Dienstag zum Start der neuen Billigfluglinie mit zunächst vier Flugzeugen.“"
                                            },
                                            {
                                                "example_id": "2546d850-9c1a-4c95-8a83-1bcdd8d9ba15",
                                                "sense_id": "b6631863-2913-3242-95bc-7e7f7f5c9825",
                                                "text": "„Das etwa 1,7 Kilogramm schwere Fluggerät sei nur wenige Meter neben einer Familie mit zwei Kindern am Boden eingeschlagen, berichtete die Polizei am Dienstag.“"
                                            },
                                            {
                                                "example_id": "e5e4106a-5895-40bf-81b5-7ab6ed43d723",
                                                "sense_id": "b6631863-2913-3242-95bc-7e7f7f5c9825",
                                                "text": "„Nach dem Hubschrauberabsturz mit einem Toten bei einer Bundesheerübung am Dienstag in der Wattener Lizum in Tirol befinden sich die beiden schwerverletzten Besatzungsmitglieder nicht in Lebensgefahr.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Dienstag",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aa918b89-7c4a-3cfe-98c5-089e5e0ef8fb",
                                        "entry_id": "cecf13b2-f4c5-3256-b089-df4b938c7bf7",
                                        "glosses": [
                                            "deutschsprachiger Familienname, Nachname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffe8e676-94d2-4c25-b088-b2791ac7e717",
                                                "sense_id": "aa918b89-7c4a-3cfe-98c5-089e5e0ef8fb",
                                                "text": "Frau Dienstag ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "c402ad5d-604e-4f42-b100-4caf00bd353f",
                                                "sense_id": "aa918b89-7c4a-3cfe-98c5-089e5e0ef8fb",
                                                "text": "Herr Dienstag wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "d825cb19-8383-418c-9bf3-0277fc93e412",
                                                "sense_id": "aa918b89-7c4a-3cfe-98c5-089e5e0ef8fb",
                                                "text": "Die Dienstags fahren heute ins Emsland."
                                            },
                                            {
                                                "example_id": "51ad3372-5c28-4d87-a54e-134934bee6b4",
                                                "sense_id": "aa918b89-7c4a-3cfe-98c5-089e5e0ef8fb",
                                                "text": "Der Dienstag trägt nie die Schals, die die Dienstag ihm strickt."
                                            },
                                            {
                                                "example_id": "29b4b5e6-803a-4bf2-85fb-dba603ff7f0b",
                                                "sense_id": "aa918b89-7c4a-3cfe-98c5-089e5e0ef8fb",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Dienstag kommt, geht der Herr Dienstag.“"
                                            },
                                            {
                                                "example_id": "2c66303a-3bb5-4fa3-827d-7785d93f28d8",
                                                "sense_id": "aa918b89-7c4a-3cfe-98c5-089e5e0ef8fb",
                                                "text": "Dienstag kommt und geht."
                                            },
                                            {
                                                "example_id": "3a64d431-3c92-4fd7-aeda-fee7899bdc62",
                                                "sense_id": "aa918b89-7c4a-3cfe-98c5-089e5e0ef8fb",
                                                "text": "Dienstags kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
