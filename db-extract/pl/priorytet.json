                        "source_sense_id": "30755b41-6910-3d7a-b3c1-0e3bc1d1c65c",
                        "target_lang_word": "Priorität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Priorität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ea95be6b-d12a-3f74-9c3a-f60727dc36a1",
                                        "entry_id": "34d9a403-278d-3568-a23e-2c6d9ab66545",
                                        "glosses": [
                                            "Einstufung von etwas in einem Wertesystem als vorrangig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c23f22fc-3072-43e3-9a15-efe385e968f2",
                                                "sense_id": "ea95be6b-d12a-3f74-9c3a-f60727dc36a1",
                                                "text": "„Der Prozess läuft mit einer niedrigeren Priorität.“"
                                            },
                                            {
                                                "example_id": "bf5e0b9d-5356-4da7-bc18-2c15f8a13f08",
                                                "sense_id": "ea95be6b-d12a-3f74-9c3a-f60727dc36a1",
                                                "text": "„[…] dass der Kohleausstieg erst in 20 Jahren erfolgt, heißt einfach: Die Umwelt hat auch in der Politik leider keine Priorität.“"
                                            },
                                            {
                                                "example_id": "9ff1cd48-7206-4050-ad05-1b4dc5bbdaf8",
                                                "sense_id": "ea95be6b-d12a-3f74-9c3a-f60727dc36a1",
                                                "text": "Erschwerend kam hinzu, dass in dieser besonderen, politischen Lage, der Präsidentenpalast und die Ministerien Priorität hatten."
                                            },
                                            {
                                                "example_id": "c03bd39f-e878-4d68-b51f-306a6128ca9d",
                                                "sense_id": "ea95be6b-d12a-3f74-9c3a-f60727dc36a1",
                                                "text": "„Vielleicht haben die Steinmeiers nach ihrer Krise ja auch andere Prioritäten für ihr Leben gesetzt.“"
                                            },
                                            {
                                                "example_id": "30234351-9dd3-4d89-8eaa-400ed6083121",
                                                "sense_id": "ea95be6b-d12a-3f74-9c3a-f60727dc36a1",
                                                "text": "„Chrissi setzt ihre Prioritäten in genau umgekehrter Reihenfolge.“"
                                            },
                                            {
                                                "example_id": "471d9156-70e1-46b3-bf4c-be65b2113c50",
                                                "sense_id": "ea95be6b-d12a-3f74-9c3a-f60727dc36a1",
                                                "text": "„Spielt es überhaupt eine Rolle, was wahr ist und was nicht, wenn die oberste Priorität der eigene Nutzen ist?“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
