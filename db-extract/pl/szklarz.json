                    {
                        "translation_id": "497918fe-20cf-411a-9bba-4790aec82746",
                        "source_entry_id": "5cf05930-4a8f-349e-b44e-9b2829486ee5",
                        "source_sense_id": "a95ddfe7-312a-3542-accb-6a063f406849",
                        "target_lang_word": "Glaser",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Glaser",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "81f95c12-7a34-3dac-8897-180a22e481fb",
                                        "entry_id": "d61be226-f8d3-3ce9-8ea7-654e344a3ebc",
                                        "glosses": [
                                            "im Fenster- und Glasbau tätige Person; Fachmann für Fenster- und Glastechnik"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8932118d-8d68-4328-a1b8-c2d06c60a177",
                                                "sense_id": "81f95c12-7a34-3dac-8897-180a22e481fb",
                                                "text": "Nach dem Sturm musste der Glaser vorbeikommen, um alle beschädigten Fenster instand zusetzen."
                                            },
                                            {
                                                "example_id": "f71fcbaf-1f80-437c-a0b8-db718541e0ff",
                                                "sense_id": "81f95c12-7a34-3dac-8897-180a22e481fb",
                                                "text": "„Der Glaser, den ich diesbezüglich sofort um Rat und Hilfe bat, teilte mir fernmündlich mit, diese Kleinigkeit lohne nicht den Weg.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ae0f8217-fd82-45f0-8913-cf16599616a8",
                        "source_entry_id": "5cf05930-4a8f-349e-b44e-9b2829486ee5",
                        "source_sense_id": "a95ddfe7-312a-3542-accb-6a063f406849",
                        "target_lang_word": "стекольщик",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "стекольщик",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "36fc8780-ae59-39d8-9354-6937b7bc523a",
                                        "entry_id": "af13aee1-fec5-377b-82d8-90beaf14c8a0",
                                        "glosses": [
                                            "тот, кто занимается вставкой стёкол в рамы"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9813d6e-a2bc-4143-aadd-4ca5ae5e9d37",
                                                "sense_id": "36fc8780-ae59-39d8-9354-6937b7bc523a",
                                                "text": "В трактире посетителей было мало; стекольщик вставлял стекло в разбитой стеклянной двери, буфетчик сидел у выручки и пил чай."
                                            },
                                            {
                                                "example_id": "3e5c696b-30ad-440a-bbb9-ff96de52dd9e",
                                                "sense_id": "36fc8780-ae59-39d8-9354-6937b7bc523a",
                                                "text": "По профессии он стекольщик. Человек сам немудрёный. И с бородой."
                                            },
                                            {
                                                "example_id": "47d65fcf-94a5-48c4-a300-d363769c15f6",
                                                "sense_id": "36fc8780-ae59-39d8-9354-6937b7bc523a",
                                                "text": "С трёх сторон небо над городом преображалось от двойных вспышек — точно по городу гигантскими шагами ходил стекольщик, неся на плече вспыхивающую свою раму."
                                            },
                                            {
                                                "example_id": "156e66d4-3848-41c3-ba34-58aed4f730da",
                                                "sense_id": "36fc8780-ae59-39d8-9354-6937b7bc523a",
                                                "text": "Вы, конечно, не раз видели, как работает стекольщик: чтобы разрезать стекло, он «алмазом» проводит на нём длинную царапину и затем просто-напросто ломает лист на две части."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "80d793e5-60a8-3fb9-81e3-c06573673c54",
                                        "entry_id": "af13aee1-fec5-377b-82d8-90beaf14c8a0",
                                        "glosses": [
                                            "разг. рабочий, работник стекольной промышленности; изготовитель стекла или стеклянных изделий"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec9ffbeb-6b6d-4463-b1b9-5a6c5dc0ae8b",
                                                "sense_id": "80d793e5-60a8-3fb9-81e3-c06573673c54",
                                                "text": "Химики вторгались в металлургию, создавая пластмассы, заменяющие сталь, стекольщики теснили специалистов по строительным материалам — они выставили модель здания санатория с хрустальными колоннами."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
