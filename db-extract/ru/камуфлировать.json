                                    },
                                    {
                                        "sense_id": "2819511b-f186-3a98-ad65-d2039f60afc4",
                                        "entry_id": "c1e3cd9a-99e3-3162-b26d-dc435283d267",
                                        "glosses": [
                                            "etwas für etwas anderes ausgeben, um das wahre Wesen zu verbergen"
