                        "glosses": [
                            "In a sparing manner; with frugality, moderation, scantiness, reserve, forbearance, or the like; sparsely."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba2a836e-e772-4785-8d92-0ce876a02b48",
                                "sense_id": "f4401670-2393-3a3a-ac4a-d01e54f2b596",
                                "text": "The Mark Tree is generally used as an effect to accentuate transitions in music, either at the beginning or end of a phrase. When used sparingly, they ^([sic]) can add an exotic \"shimmer\" effect."
                            }
                        ]
                    }
                ],
                "translations": [
