                ],
                "senses": [
                    {
                        "sense_id": "44d1420e-d19d-3add-8e76-0c7963ac19ca",
                        "entry_id": "9fe7a3cc-f725-3728-a835-7d9aeb8769b6",
                        "glosses": [
                            "Person, die keine helle Hautfarbe hat, nicht europäischer Abstammung is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a575c839-4f52-40cd-964d-2852b0117159",
                                "sense_id": "44d1420e-d19d-3add-8e76-0c7963ac19ca",
                                "text": "„Wie jeder Nichtweiße, der seit mehreren Jahren hier lebte, war der General aufs Beste vertraut mit den Eigenarten und Feinheiten der Weißen und ihrer Verschiedenheit.“"
                            },
                            {
                                "example_id": "23c39217-729b-41f3-93fc-61d060351f21",
                                "sense_id": "44d1420e-d19d-3add-8e76-0c7963ac19ca",
                                "text": "„Fanon ist ein sachkundiger Zeuge, dem es zuzuhören lohnt. Er zwang das alte, aufgeblähte und hohle Frankreich, sich gegen die Unterdrückung Schwarzer zu stellen und Verantwortung für die Verbrechen von Weißen an Nichtweißen zu übernehmen; über Frankreich erreichte er den gesamten Westen.“"
                            },
                            {
                                "example_id": "53aa4c8c-b953-45fc-ab44-9c158233d612",
                                "sense_id": "44d1420e-d19d-3add-8e76-0c7963ac19ca",
                                "text": "„Außer im Dienst von Buren und Briten beteiligten sich Nichtweiße auch zunehmend in Stammesverbänden an den Kampfhandlungen, als Verbündete einer der beiden Parteien, oder besser gesagt: der Briten.“"
                            },
                            {
                                "example_id": "dc6b7798-e267-412d-b492-bf89e8eae639",
                                "sense_id": "44d1420e-d19d-3add-8e76-0c7963ac19ca",
                                "text": "„›Ich hätte einen Farbigen vorgezogen, aber Marty stand im Ruf, mit Nichtweißen auszukommen, also hab ich mein Okay gegeben.‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
