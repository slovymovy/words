                                    {
                                        "sense_id": "d9ee6fcc-6110-3646-b41d-b526144fa165",
                                        "entry_id": "cda9a9bf-a8af-33a0-ad43-2ff83cd13987",
                                        "glosses": [
                                            "Kategorie der Konjugation (Verbflexion) in einigen indogermanischen (indoeuropäischen) Sprachen, die eine abgeschlossene Handlung oder einen abgeschlossenen Prozess darstellt."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02b06dbf-946f-4db0-9930-1543393b1958",
                                                "sense_id": "d9ee6fcc-6110-3646-b41d-b526144fa165",
                                                "text": "Der Aorist wird zum Beispiel in der (alt)griechischen Grammatik im Tempussystem behandelt, obwohl seine Funktion nicht in erster Linie eine Zeitangabe ist."
                                            },
                                            {
                                                "example_id": "9512a76e-b88b-4a93-adf7-a62d9deea7ee",
                                                "sense_id": "d9ee6fcc-6110-3646-b41d-b526144fa165",
                                                "text": "Der Aorist wird unter anderem in Erzählungen verwendet."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "615561e8-ab83-3cbd-9c55-61128b3d13a8",
                                        "entry_id": "cda9a9bf-a8af-33a0-ad43-2ff83cd13987",
                                        "glosses": [
                                            "Verbform im Aorist [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8077688-ce16-4c88-b4f0-304fb7c9370b",
                                                "sense_id": "615561e8-ab83-3cbd-9c55-61128b3d13a8",
                                                "text": "Das Prädikat dieses Satzes ist ein Aorist."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c4e004b1-e1d0-4a8d-9fbd-b5dcaf85cdfe",
                        "source_entry_id": "7adb68d8-f192-3413-8e48-b5d9fe38d1f8",
                        "source_sense_id": "6cd2a951-afff-3702-bdd5-9513d372577d",
                        "target_lang_word": "аорист",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "аорист",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "db43480a-a96b-3731-83e6-857c8d09a07a",
                                        "entry_id": "3dee0bd3-f7ef-3445-aeeb-6e3821a2e151",
                                        "glosses": [
                                            "лингв. видо-временная форма глагола в индоевропейских языках (греческом, старославянском, древнерусском, современных южнославянских), обозначавшая недлительное действие, полностью отнесённое к прошлому, без указания на его развитие (в противоположность имперфекту) или полноту совершения, предел (в противоположность перфекту)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a4414c7-1288-4a25-a9cd-f932ee25470d",
                                                "sense_id": "db43480a-a96b-3731-83e6-857c8d09a07a",
                                                "text": "Я говорил про пять гласных звуков, два типа склонения прилагательных, тоническое ударение и вытеснение аориста и имперфекта сложным прошедшим временем ― перфектом."
                                            },
                                            {
                                                "example_id": "2cf3c18e-e5e9-4f00-ac9a-84f13f0d5b76",
                                                "sense_id": "db43480a-a96b-3731-83e6-857c8d09a07a",
                                                "text": "Объяснить, что такое глагольная форма «аорист» (именно так значилось в билете) для меня было равносильно решению теоремы Ферма переростком оборо́вшим четыре действия арифметики."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
