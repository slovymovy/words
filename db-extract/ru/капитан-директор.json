                "senses": [
                    {
                        "sense_id": "28f251f0-52a9-32f0-bc30-8940d7edcce8",
                        "entry_id": "4fabe191-dfb5-3174-8c75-83db708ed29f",
                        "glosses": [
                            "капитан промыслово-перерабатывающего судна (или флотилии), ответственный за его вождение и производственную деятельность"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77ceaa60-d914-4c32-aadc-1235c0493e52",
                                "sense_id": "28f251f0-52a9-32f0-bc30-8940d7edcce8",
                                "text": "— Капитан-директором надо было назначить нашего Кирибеева, — сказал Жилин, — он бы тут всех в божью веру привёл…"
                            },
                            {
                                "example_id": "226978f9-79c4-44ad-8cf9-14c36b1aa0cd",
                                "sense_id": "28f251f0-52a9-32f0-bc30-8940d7edcce8",
                                "text": "После нескольких неудачных тралений капитан-директор нашего судна Герой Социалистического Труда А. Мердов и старший мастер добычи В. Виноградов решили полностью переоборудовать трал."
                            }
                        ]
                    }
