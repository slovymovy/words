                    {
                        "translation_id": "23cbda2e-05d4-43f5-9c38-b50f8f5b88db",
                        "source_entry_id": "0a536b59-bf40-3edd-96de-21193fc1e424",
                        "source_sense_id": "9ca8b1de-0718-3df1-bdbf-2aa08418c312",
