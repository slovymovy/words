                    {
                        "translation_id": "816cdb38-2224-4821-a9f9-9543a81dcd14",
                        "source_entry_id": "be362c2e-4abe-3c33-bb69-a4e76e69fc45",
                        "source_sense_id": "4c133506-05cb-3931-bf2f-22292ecea8d4",
