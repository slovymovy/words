                    {
                        "sense_id": "d791f455-5033-3cb3-8d38-8c36b25c074c",
                        "entry_id": "2c747e7f-b22c-3a8d-8174-8b591c385545",
                        "glosses": [
                            "Gotteshaus, das den Aposteln und Kirchenvätern Peter und Paul ^(→ WP) geweiht ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cee55deb-9a4d-43f7-bada-a4f1960d50b6",
                                "sense_id": "d791f455-5033-3cb3-8d38-8c36b25c074c",
                                "text": "„Ende des 19. Jahrhunderts gab es in Moskau nur zwei katholische Kirchen: die Kirche des Heiligen Ludwig der französischen und die Peter-und-Paul-Kirche der polnischen Gemeinde.“"
                            },
                            {
                                "example_id": "3a7bb29c-47d1-4733-9550-846e74a7ac27",
                                "sense_id": "d791f455-5033-3cb3-8d38-8c36b25c074c",
                                "text": "„Sie [die Martinskirche] und die drei Peter-und-Paul-Kirchen in der Umgebung deuten auf eine Sonderstellung von Meßkirch als Zentralort der Missionierung im 8. Jahrhundert hin.“"
                            }
                        ],
