                        "sense_id": "c7da6806-85c3-34ea-b441-496da9e96d21",
                        "entry_id": "57b40e8e-dbf5-3589-b916-c8320a400172",
                        "glosses": [
                            "As if cooked on a grill."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef095d3c-26e0-43a6-93cc-39f2babfd128",
                                "sense_id": "c7da6806-85c3-34ea-b441-496da9e96d21",
                                "text": "After a day in the sun, he looked more grilled than his hamburger."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "55c14860-528e-4b36-b80c-8f9449baf64b",
                        "source_entry_id": "57b40e8e-dbf5-3589-b916-c8320a400172",
                        "source_sense_description": "Translations",
                        "target_lang_word": "grillé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grillé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d96631ef-9baa-3b7a-822f-340dcd2e7715",
                                        "entry_id": "badd3534-b6c7-3692-bd01-15e631a9efe1",
                                        "glosses": [
                                            "Qui est doté d’une grille."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1d67729-f9e9-4e87-8f67-3b9caa3ae5b9",
                                                "sense_id": "d96631ef-9baa-3b7a-822f-340dcd2e7715",
                                                "text": "Les remparts de la citadelle et les mosquées de Galata se fondaient dans le ciel bombé de la nuit, de rares lumières brillaient aux longues fenêtres grillées du quartier turc, au flanc des rues tordues."
                                            },
                                            {
                                                "example_id": "3ed67631-d5f4-40b4-9950-71cccecd81a8",
                                                "sense_id": "d96631ef-9baa-3b7a-822f-340dcd2e7715",
                                                "text": "Lorsque je traversai la cour par laquelle nous sortions, Lambert était collé à l’une des fenêtres grillées du réfectoire pour me voir passer."
                                            },
                                            {
                                                "example_id": "09dd1b19-4670-47ce-a59b-9735c2c73ea9",
                                                "sense_id": "d96631ef-9baa-3b7a-822f-340dcd2e7715",
                                                "text": "Nous devons dire que nous n’avons aperçu, à ces fenêtres si bien garnies de barreaux, que de charmants visages et des physionomies d’anges ; c’est peut-être pour cela qu’elles sont grillées avec tant de soin."
                                            },
                                            {
                                                "example_id": "ee5ad141-29a8-4989-b741-1978a58d5093",
                                                "sense_id": "d96631ef-9baa-3b7a-822f-340dcd2e7715",
                                                "text": "En août 1280, à Paris, le roi Philippe permit à Isar, alors évêque de Carcassonne, de pratiquer quatre fenêtres grillées dans la courtine adossée à l’évêché, […]."
                                            },
                                            {
                                                "example_id": "8551c945-46ab-4130-bb4f-1f228ae60010",
                                                "sense_id": "d96631ef-9baa-3b7a-822f-340dcd2e7715",
                                                "text": "Oh ! reprit la jeune fille, […] tu te souviens de notre loge grillée à l’Opéra ? Toutes les dames en avaient de pareilles. Eh bien, c’est fini ou presque."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "636985bb-db7e-3748-8703-b5f420eda957",
                                        "entry_id": "badd3534-b6c7-3692-bd01-15e631a9efe1",
                                        "glosses": [
                                            "Qui a subi une cuisson au gril."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dc05231c-b3c5-3e06-849e-a8c478eb5c18",
                                        "entry_id": "badd3534-b6c7-3692-bd01-15e631a9efe1",
                                        "glosses": [
                                            "Désigne un appareil électrique hors service suite à une surchauffe."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6c7fd8e7-94af-38c7-ad46-8f61c2a8b2aa",
                                        "entry_id": "badd3534-b6c7-3692-bd01-15e631a9efe1",
                                        "glosses": [
                                            "Qui agit de manière voyante, peu discrète lors d'une action interdite ou secrète, qui multiplie les chances de se faire griller."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a69d8f5a-4ea8-467a-8542-b79aeb8c56a5",
                                                "sense_id": "6c7fd8e7-94af-38c7-ad46-8f61c2a8b2aa",
                                                "text": "T'es grillée quand tu penses que personne ne t'entend téléphoner en cachette."
                                            },
                                            {
                                                "example_id": "72813035-aee6-499e-b739-b5d5f5d74c67",
                                                "sense_id": "6c7fd8e7-94af-38c7-ad46-8f61c2a8b2aa",
                                                "text": "Quand il essaie de mentir il est trop grillé."
                                            }
                                        ]
                                    }
                                ]
