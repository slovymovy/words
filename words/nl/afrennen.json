{
    "word_family": [
        "ren",
        "renner",
        "hardlopen"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e050d787-c46d-3cb6-94e6-64f104383936",
                    "sense_definition": "Snel rennend op iemand of iets afkomen.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ren_beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik zag de hond snel op mij <w>afrennen</w> in het park.",
                            "target_lang_translations": {
                                "en": "I saw the dog <w>rush up to</w> me quickly in the park."
                            }
                        },
                        {
                            "text": "De blije kinderen wilden snel op de man <w>afrennen</w> toen hij met cadeautjes binnenkwam.",
                            "target_lang_translations": {
                                "en": "The happy children wanted to quickly <w>rush towards</w> the man when he entered with presents."
                            }
                        }
                    ],
                    "synonyms": [
                        " toesnelden",
                        "toelopen"
                    ],
                    "antonyms": [
                        "wegrennen"
                    ],
                    "common_phrases": [
                        "op iemand afrennen"
                    ],
                    "target_lang_definitions": {
                        "en": "Approaching someone or something quickly by running."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rush up to",
                                "target_lang_sense_clarification": "to run towards someone or something quickly"
                            },
                            {
                                "target_lang_word": "rush towards",
                                "target_lang_sense_clarification": "to move at high speed toward a target"
                            },
                            {
                                "target_lang_word": "race up to",
                                "target_lang_sense_clarification": "to run very fast towards someone or something"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "34545bf8-3eaa-3512-800c-bcc473f3f5c4",
                    "sense_definition": "Rennend naar beneden bewegen.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "ren_beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet niet zo hard de steile heuvel <w>afrennen</w>.",
                            "target_lang_translations": {
                                "en": "You shouldn't <w>run down</w> the steep hill so fast."
                            }
                        },
                        {
                            "text": "De jongen wilde voorzichtig de trap <w>afrennen</w> om de bus te halen.",
                            "target_lang_translations": {
                                "en": "The boy wanted to carefully <w>run down</w> the stairs to catch the bus."
                            }
                        }
                    ],
                    "common_phrases": [
                        "de trap afrennen",
                        "de heuvel afrennen"
                    ],
                    "target_lang_definitions": {
                        "en": "Moving downwards by running."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "run down",
                                "target_lang_sense_clarification": "to run down a slope, hill, or stairs"
                            },
                            {
                                "target_lang_word": "rush down",
                                "target_lang_sense_clarification": "to move downwards very quickly by running"
                            },
                            {
                                "target_lang_word": "race down",
                                "target_lang_sense_clarification": "to run rapidly down something steep or descending"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4f02c85b-549c-361c-9b1f-7cbd961c661a",
                    "sense_definition": "Snel rennend een afstand afleggen of ergens vandaan rennen.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "ren_beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ze moesten een heel stuk <w>afrennen</w> om op tijd voor de training te zijn.",
                            "target_lang_translations": {
                                "en": "They had to <w>run</w> a long way to be on time for training."
                            }
                        },
                        {
                            "text": "Na het horen van de bel zag je de scholieren snel het terrein <w>afrennen</w>.",
                            "target_lang_translations": {
                                "en": "After hearing the bell, you saw the students quickly <w>run off</w> the premises."
                            }
                        }
                    ],
                    "synonyms": [
                        "wegrennen"
                    ],
                    "common_phrases": [
                        "een afstand afrennen"
                    ],
                    "target_lang_definitions": {
                        "en": "Covering a distance quickly by running, or running away from somewhere."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "run off",
                                "target_lang_sense_clarification": "to run away or leave somewhere quickly"
                            },
                            {
                                "target_lang_word": "rush off",
                                "target_lang_sense_clarification": "to depart in a hurry by running"
                            },
                            {
                                "target_lang_word": "race off",
                                "target_lang_sense_clarification": "to speed away or depart rapidly on foot"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}