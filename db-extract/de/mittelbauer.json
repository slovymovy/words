                    {
                        "form_id": "5d44ad3a-05ff-4034-be78-3743d3645cd8",
                        "entry_id": "4d2892da-a549-3046-a247-042db0fe27a3",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Mittelbauern"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "11373e13-873f-3670-8fe0-0e1b3a79bb88",
                        "entry_id": "4d2892da-a549-3046-a247-042db0fe27a3",
                        "glosses": [
                            "Bauer, der auf der d-Linie oder e-Linie steht, also ein Damenbauer oder ein Königsbauer"
                        ],
                        "tags": [
                            "Schach"
                        ],
                        "examples": [
                            {
                                "example_id": "28fa883b-b56d-4258-88b0-52cc79e58c67",
                                "sense_id": "11373e13-873f-3670-8fe0-0e1b3a79bb88",
                                "text": "In der Ausgangsstellung des Schachspiels stehen die weißen Mittelbauern auf den Feldern d2 und e2, die schwarzen Zentrumsbauern auf den Feldern d7 und e7."
                            },
                            {
                                "example_id": "ec8ce59a-15e2-438d-bec3-231d8b476b35",
                                "sense_id": "11373e13-873f-3670-8fe0-0e1b3a79bb88",
                                "text": "„Rèti [ging] von dem Gedanken aus, die frühzeitige Besetzung der Brettmitte durch Bauern gebe dem Gegner die Möglichkeit zu Angriffen, der Mittelbauer werde zur ‚Angriffsmarke‘.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "02995f41-f27f-3e3f-93d5-da0c7b75eb04",
                        "entry_id": "4d2892da-a549-3046-a247-042db0fe27a3",
                        "glosses": [
                            "Bauer mit mittlerem privaten Grundbesitz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b789a59-5806-47a0-abb4-04a3450ef3ac",
                                "sense_id": "02995f41-f27f-3e3f-93d5-da0c7b75eb04",
                                "text": "„Als Sohn eines thüringischen Mittelbauern war er praktisch zwischen Landmaschinen groß geworden.“"
                            },
                            {
                                "example_id": "1872d10e-f8cd-4234-b646-43c59de2890b",
                                "sense_id": "02995f41-f27f-3e3f-93d5-da0c7b75eb04",
                                "text": "„Mit der II. Parteikonferenz begann auch die Kollektivierung der Klein- und Mittelbauern sowie das Zerschlagen des privaten Großhandels und des Mittelstandes.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
