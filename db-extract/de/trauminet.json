                        ],
                        "examples": [
                            {
                                "example_id": "76ab054a-93d7-4ce4-8adc-7dfe28fdd3cd",
                                "sense_id": "b0eba5fd-22ed-32a9-8ae9-d0e9059646ed",
                                "text": "Als es ernst wurde, wurde Holger ganz schnell ein kleiner Trauminet."
                            },
                            {
                                "example_id": "c148bd0e-1f37-4383-8d83-d1504996c1c8",
                                "sense_id": "b0eba5fd-22ed-32a9-8ae9-d0e9059646ed",
                                "text": "Bei euch gibt es doch nur noch Trauminets und keine echten Kerle mehr."
                            },
                            {
                                "example_id": "8a4d0b36-9088-4471-aa84-c9466363599d",
                                "sense_id": "b0eba5fd-22ed-32a9-8ae9-d0e9059646ed",
                                "text": "„Heinz Fischer, dem seit Jahrzehnten vorgeworfen wird, ein politischer Trauminet und Übervorsichtler zu sein, hat sich hingestellt und gesagt, was die FPÖ im Fall der Verurteilung des Uwe Scheuch an Justizbeschimpfung aufführe, sei eindeutig jenseits der ‚Grenzen dessen, was politische Kultur und den Rechtsstaat ausmacht‘.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "94f0b193-dc4d-4528-ab93-d2bf3a089f2e",
