                                "target_lang_word": "средние величины",
                                "target_lang_sense_clarification": "статистический термин"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "moyennes",
                                "target_lang_sense_clarification": "valeurs moyennes en mathématiques ou statistiques"
                            }
                        ]
                    }
                }
            ]
        },
