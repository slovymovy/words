                "senses": [
                    {
                        "sense_id": "f0f201e2-5cf1-3fd9-b93c-a9f731f91c7a",
                        "entry_id": "5360cf24-aeb4-3cb6-890e-8f5ff85ccd60",
                        "glosses": [
                            "Monôme : expression algébrique avec un seul terme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a224258-4061-415d-b0c1-38e36896b0d2",
                                "sense_id": "f0f201e2-5cf1-3fd9-b93c-a9f731f91c7a",
                                "text": "In der Algebra ist ein Monom ein Polynom, das nur aus einem Glied besteht. Ein Monom ist also ein Produkt, bestehend aus einem Koeffizienten und Potenzen von einer oder mehreren Variablen.",
                                "translation": "En algèbre, un monôme est un polynôme ne comprenant qu’un terme. Un monôme est donc un produit ne comprenant qu’un coefficient et des puissances de une ou plusieurs variables."
                            },
                            {
                                "example_id": "5aea65eb-a56f-4337-88d2-f16565c03980",
                                "sense_id": "f0f201e2-5cf1-3fd9-b93c-a9f731f91c7a",
                                "text": "Als Trinom bezeichnet man in der Mathematik die dreigliedrige Entsprechung zu dem bekannteren Binom. Es handelt sich also um ein Polynom, das eine Summe von drei Monomen ist.",
                                "translation": "En mathématiques, on appelle trinôme l’analogue à trois termes du binôme, plus connu. Il s’agit donc d’un polynôme qui est la somme de trois monômes."
                            }
                        ]
                    }
                ],
