                    {
                        "translation_id": "7d0d47d1-1118-47b2-8182-5eecf87c00b8",
                        "source_entry_id": "d21afe1d-7d9c-3916-809a-23e5282bde00",
                        "source_sense_description": "city",
                        "target_lang_word": "Gaza",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gaza",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cf2d7a0e-c2d3-3ad9-a9c1-ef7f46a802a0",
                                        "entry_id": "2683682c-5062-320a-b462-6d139a70ade6",
                                        "glosses": [
                                            "Ville de Palestine dans la bande de Gaza."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fa6b472-eb97-481e-9ef1-ba6de9a3658e",
                                                "sense_id": "cf2d7a0e-c2d3-3ad9-a9c1-ef7f46a802a0",
                                                "text": "Pourtant, avant de rentrer à Alexandrie, il lui faut encore aller à Damas, à Jérusalem et aussi à Gaza, et enfin à Jéricho ! Il lui faut, elle, reine d'Égypte, rencontrer Hérode."
                                            },
                                            {
                                                "example_id": "98f20900-39db-492b-afd9-fee61a21d70a",
                                                "sense_id": "cf2d7a0e-c2d3-3ad9-a9c1-ef7f46a802a0",
                                                "text": "J’ai participé à des guerres à Gaza, à Jénine, en Cisjordanie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be874855-c1af-31b8-8159-d5edfbc298e2",
                                        "entry_id": "2683682c-5062-320a-b462-6d139a70ade6",
                                        "glosses": [
                                            "La bande de Gaza."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81cc903d-51b6-4ece-a35c-d849c5158013",
                                                "sense_id": "be874855-c1af-31b8-8159-d5edfbc298e2",
                                                "text": "Une terrible guerre proxy (où deux pouvoirs utilisent une tierce personne) éclata, les États-Unis finançant le Fatah en Cisjordanie à coups de centaines de millions de dollars, tandis que l’Iran envoyait clandestinement de l’argent et des armes au Hamas à Gaza."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a00012d-bd0d-3f67-880b-9a690f4e48f3",
                                        "entry_id": "2683682c-5062-320a-b462-6d139a70ade6",
                                        "glosses": [
                                            "Surnom d’un bidonville de Mamoudzou."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9db03380-5627-4609-a8b6-e4115035f6be",
                                                "sense_id": "1a00012d-bd0d-3f67-880b-9a690f4e48f3",
                                                "text": "Tu crois que c’est facile d’être le chef de Gaza."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ca6b894a-459e-4fe0-95db-32ad9873f112",
                        "source_entry_id": "d21afe1d-7d9c-3916-809a-23e5282bde00",
                        "source_sense_description": "city",
                        "target_lang_word": "Gaza",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gaza",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "01a7df26-2e04-395e-8389-f48a18a387b4",
                                        "entry_id": "f2a3372d-d11a-36a6-bc91-86b2662ec50a",
                                        "glosses": [
                                            "Stadt im östlichen Mittelmeerraum"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68ae3a3a-03a8-4b64-8b0a-98e72913ca20",
                                                "sense_id": "01a7df26-2e04-395e-8389-f48a18a387b4",
                                                "text": "Der Rabbiner und Dichter Israel Nadschara starb 1628 in Gaza."
                                            },
                                            {
                                                "example_id": "ec98cd0d-ad69-4c7f-bf7b-3502b8070f06",
                                                "sense_id": "01a7df26-2e04-395e-8389-f48a18a387b4",
                                                "text": "„Wer nach dem Markt auch noch Gazas kleinen Pascha-Palast aus dem 13. Jahrhundert besichtigt, der hat sich am Abend einen Besuch im Hammam al-Samara verdient.“"
                                            },
                                            {
                                                "example_id": "6340dce1-8010-4abc-94b5-0a49e0db18a0",
                                                "sense_id": "01a7df26-2e04-395e-8389-f48a18a387b4",
                                                "text": "„Bei den schwersten israelischen Luftangriffen seit Beginn der Offensive wurden am Abend in der Stadt Gaza mindestens 18 Menschen getötet und etwa 50 weitere verletzt. “"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1abd778a-7f52-378b-9d63-955484d5a39b",
                                        "entry_id": "f2a3372d-d11a-36a6-bc91-86b2662ec50a",
                                        "glosses": [
                                            "Gazastreifen"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9309abbe-825f-434b-b4c1-a2a6a49dd111",
                                                "sense_id": "1abd778a-7f52-378b-9d63-955484d5a39b",
                                                "text": "„Es müsse darum gehen, die Menschen in Gaza zu schützen. Doch seine Worte finden im Gazastreifen wenig Gehör.“"
                                            },
                                            {
                                                "example_id": "19dcfacf-dca7-4474-8292-6ea5445d62bf",
                                                "sense_id": "1abd778a-7f52-378b-9d63-955484d5a39b",
                                                "text": "„Die Anzeichen mehren sich, dass Israel seine Gaza-Offensive bald beenden könnte – auch weil die internationale Gemeinschaft ungeduldig wird.“"
                                            },
                                            {
                                                "example_id": "ef8133f3-b385-491d-9b96-d0404ac2bf97",
                                                "sense_id": "1abd778a-7f52-378b-9d63-955484d5a39b",
                                                "text": "„Zuletzt durften die Owaidas aus Gaza weder auf der einen noch der anderen Seite wieder heraus, obwohl sie deutsche Staatsbürger sind.“"
                                            },
                                            {
                                                "example_id": "c799afe8-533d-448b-8854-38af8f492d38",
                                                "sense_id": "1abd778a-7f52-378b-9d63-955484d5a39b",
                                                "text": "„Für die völkerrechtliche Bewertung der israelischen Kriegsverbrechen in Gaza ist das Srebrenica-Urteil von 2007 des Internationalen Gerichtshofs maßgeblich.“"
                                            },
                                            {
                                                "example_id": "8fdee58b-5f50-4d17-8a2e-861ba2c89a89",
                                                "sense_id": "1abd778a-7f52-378b-9d63-955484d5a39b",
                                                "text": "[Isralischer Krieg im Gazastreifen 2023 - 2025:] „Die Zivilbevölkerung in Gaza hungert. Hauptbetroffene sind Kinder.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "4f337936-6332-32c6-893c-398600d008fd",
                                        "entry_id": "f2a3372d-d11a-36a6-bc91-86b2662ec50a",
                                        "glosses": [
                                            "Regierungsbezirk im Gazastreifen"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    },
