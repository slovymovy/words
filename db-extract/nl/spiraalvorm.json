                        "glosses": [
                            "gelijkend op een kromme lijn die zich om een punt heen slingert en zich steeds meer daarvan verwijdert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23131462-3699-4959-965a-387b276ed994",
                                "sense_id": "5c60e6c9-6d99-3c23-a961-ffa57f34aeed",
                                "text": "Toen ik er een aanwees met rechte, gelijkmatige naden over de spiraal heen, terwijl die lijnen op een ander exemplaar elk twee knobbels hadden die de spiraalvorm onderbraken, klopte hij op mijn hand."
                            },
                            {
                                "example_id": "2de235da-0b29-4119-a00b-4c7afdf2c766",
                                "sense_id": "5c60e6c9-6d99-3c23-a961-ffa57f34aeed",
                                "text": "Wetenschappers vragen zich nu af hoe het stelsel zich heeft kunnen vormen. Een mogelijke verklaring is de aanwezigheid van een kleiner stelsel dat om BX442 draait. De zwaartekracht van dat dwergstelsel zou net dat zetje hebben kunnen geven om het stelsel zijn karakteristieke spiraalvorm te geven."
                            }
                        ]
                    }
