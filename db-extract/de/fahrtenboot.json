                "senses": [
                    {
                        "sense_id": "fd43ee1d-15e7-3d52-9d9e-f859ddcdca37",
                        "entry_id": "13efc11a-c92a-3f9b-8a72-207fb37ccee8",
                        "glosses": [
                            "Segelschiff, das geeignet ist, um längere Touren zu unternehmen (beispielsweise an der Küste oder über das Meer)"
                        ],
                        "tags": [
                            "Seglersprache"
                        ],
                        "examples": [
                            {
                                "example_id": "969af745-ef32-461a-a34c-4649f9a812e5",
                                "sense_id": "fd43ee1d-15e7-3d52-9d9e-f859ddcdca37",
                                "text": "Heribert Streuer entwickelte 1967 ein familienfreundliches Fahrtenboot, den Kleinkreuzer Flying Cruiser A."
                            },
                            {
                                "example_id": "8339d597-1128-41db-a2d0-27da484c46b0",
                                "sense_id": "fd43ee1d-15e7-3d52-9d9e-f859ddcdca37",
                                "text": "Sieben Windstärken sind für ein kleines Fahrtenboot richtiger Sturm, für eine 16 Meter lange Segelyacht eine harte Brise."
                            },
                            {
                                "example_id": "645728d4-1f2d-4052-b3b1-6068f9588825",
                                "sense_id": "fd43ee1d-15e7-3d52-9d9e-f859ddcdca37",
                                "text": "Im Vergleich zu modernen Fahrtenbooten ist die 47CR aufreizend schlank, doch bietet sie mehr Volumen als die Modelle der Classic-Linie."
                            },
                            {
                                "example_id": "4d46e92b-68cd-40e7-8128-f7009515943b",
                                "sense_id": "fd43ee1d-15e7-3d52-9d9e-f859ddcdca37",
                                "text": "Eine J/29 ist eher für sportliches Segeln gedacht, denn als reines Fahrtenboot."
                            },
                            {
                                "example_id": "c98f641c-9187-4c5d-95cb-069ccb6c6c6e",
                                "sense_id": "fd43ee1d-15e7-3d52-9d9e-f859ddcdca37",
                                "text": "Noch immer gibt es eine hohe Anzahl von älteren Fahrtenbooten, die aktiv Reisen unternehmen."
                            },
                            {
                                "example_id": "2345ad05-bf62-418c-a85e-ac56f2168fc5",
                                "sense_id": "fd43ee1d-15e7-3d52-9d9e-f859ddcdca37",
                                "text": "Ein Ziel war es auch mit den gut segelnden Fahrtenbooten Regatten auf einem hohen Niveau veranstalten zu können."
                            },
                            {
                                "example_id": "b601079c-b866-4db4-a336-5e928c660e41",
                                "sense_id": "fd43ee1d-15e7-3d52-9d9e-f859ddcdca37",
                                "text": "Ein bequemes und gutes Fahrtenboot wird nie ein erstklassiges Rennboot sein."
                            },
                            {
                                "example_id": "adf43f10-ecfa-4af1-a842-9f2a40d5ccb7",
                                "sense_id": "fd43ee1d-15e7-3d52-9d9e-f859ddcdca37",
                                "text": "Die frische Brise wirbelte stäubende Wasserpartikel auf, und es war ein Glück, dass sich die Yacht als echtes Fahrtenboot so gut und leicht in diesem Wetter hielt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
