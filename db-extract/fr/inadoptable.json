                                "target_senses": [
                                    {
                                        "sense_id": "6fbc2596-d0c8-3ff3-9547-74c43b19089c",
                                        "entry_id": "acbf9608-8e5a-3aed-bcda-d3ab33e6e523",
                                        "glosses": [
                                            "That cannot be adopted; unsuitable for adoption."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fdd4f8e-c7e0-48c2-98e0-b09e676d801a",
                                                "sense_id": "6fbc2596-d0c8-3ff3-9547-74c43b19089c",
                                                "text": "Even children with minor or correctable handicaps such as harelip, cleft palate, crossed eyes, or clubfoot were classed as \"unadoptable\"."
                                            },
                                            {
                                                "example_id": "18ee6c84-c072-4f37-bcd9-cf9c92be4cad",
                                                "sense_id": "6fbc2596-d0c8-3ff3-9547-74c43b19089c",
                                                "text": "At Columbia-Greene, staffers go for the most unadoptable animals to save them from euthanasia. The youngest, healthiest, cutest pets are waiting for you."
                                            }
                                        ]
                                    }
                                ]
