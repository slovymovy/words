                {
                    "sense_id": "a544db80-236d-3ad7-8e36-693b95b9e2d4",
                    "sense_definition": "een plotseling kortdurend luid geluid voortbrengend",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "geluid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>knallende</w> kurken van de champagneflessen zorgden voor een feestelijke sfeer in de kamer.",
                            "target_lang_translations": {
                                "en": "The <w>popping</w> corks of the champagne bottles created a festive atmosphere in the room."
                            }
                        },
                        {
                            "text": "Tijdens de demonstratie hoorden we overal <w>knallende</w> zwepen en luid geschreeuw van de menigte.",
                            "target_lang_translations": {
                                "en": "During the demonstration, we heard <w>cracking</w> whips and loud shouting from the crowd everywhere."
                            }
                        }
                    ],
                    "synonyms": [
                        "ontploffend",
                        "ploffend"
                    ],
                    "common_phrases": [
                        "knallende kurken",
                        "knallende zwepen"
