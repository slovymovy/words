                "senses": [
                    {
                        "sense_id": "c66bafe1-bdb1-3fd3-a574-aa9149fd24e7",
                        "entry_id": "146741c2-4ef9-36df-b733-d12514eab69a",
                        "glosses": [
                            "Bezeichnung für ein im Satz fehlendes Subjekt"
                        ],
                        "tags": [
                            "Linguistik/Sprachwissenschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "7405a1a5-4bae-457b-ad6b-07bb40b94f31",
                                "sense_id": "c66bafe1-bdb1-3fd3-a574-aa9149fd24e7",
                                "text": "Nullsubjekt verweist auf die Tatsache, dass in manchen deutschen Sätzen kein Subjekt vorkommt, wie z. B. in Sätzen mit Verben, die Empfindungen ausdrücken: „Euch ist wohl zu warm hier?“ Man kann in solche Sätze auch ein Scheinsubjekt einfügen: „Euch ist es wohl zu warm hier?“ Sie sind aber auch ohne dieses grammatisch korrekt."
                            },
                            {
                                "example_id": "dfca7861-e6ae-484e-ba54-48a790726fa9",
                                "sense_id": "c66bafe1-bdb1-3fd3-a574-aa9149fd24e7",
                                "text": "„Ein Beispiel hierfür ist das Italienische, eine Sprache mit Nullsubjekt, die aber in bestimmten Fällen doch ein pronominales Subjekt verlangt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
