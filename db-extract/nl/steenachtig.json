                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a0ef55e-2c99-46ba-a595-c5eeaf2bd26f",
                                                "sense_id": "f3876508-3423-3667-b2c8-50bb7ba86f9e",
                                                "text": "Um hier zu stehen, muss man einen langen, steinigen Weg überwunden haben."
                                            }
