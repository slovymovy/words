                    ]
                },
                {
                    "sense_id": "cc91381b-674b-39da-8885-7013c6610450",
                    "sense_definition": "État d'égarement mental, crise de délire ou de rage incontrôlable proche de la folie.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "demence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le malade a été pris d'un accès de <w>fureur</w> soudain qui a effrayé le personnel soignant."
