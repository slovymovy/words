                        "source_entry_id": "8b48b58c-0067-3781-be76-95529fb9fff1",
                        "source_sense_description": "someone who plates metal",
                        "target_lang_word": "Schmied",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schmied",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6d07e4de-e6d9-3032-9cff-7c6c918dcdb0",
                                        "entry_id": "4a177b75-8ae1-3539-9707-20f2dc48ff5f",
                                        "glosses": [
                                            "Handwerker, der Metalle mittels Feuer und Schlagwerkzeugen bearbeitet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab97ac45-e1f3-40a2-9d8b-d575658704fe",
                                                "sense_id": "6d07e4de-e6d9-3032-9cff-7c6c918dcdb0",
                                                "text": "Diesmal lassen wir uns einen Metallzaun vom Schmied herstellen."
                                            },
                                            {
                                                "example_id": "b9635ac8-17bb-4d8c-9cb3-554405dbc2ce",
                                                "sense_id": "6d07e4de-e6d9-3032-9cff-7c6c918dcdb0",
                                                "text": "„Die Nacht war früher als sonst hereingebrochen, als eine junge Frau den Schmied mit ihrer Ziege aufsuchte.“"
                                            },
                                            {
                                                "example_id": "caa72e77-482b-48a3-911c-f1e0e742d382",
                                                "sense_id": "6d07e4de-e6d9-3032-9cff-7c6c918dcdb0",
                                                "text": "„Der Wirt schlug sich in der Tür mit einem Schmiede, und gerade, als die Fabrikarbeiter dazukamen, machte sich der Schmied von dem Kneipwirt los und fiel mit dem Gesicht auf das Pflaster.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Schmied",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8605f815-c3e3-3044-9f66-c2f2c437689d",
                                        "entry_id": "8eca19a8-bd02-3aaa-af34-b13038d4d64e",
                                        "glosses": [
                                            "deutscher Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "096221b8-df77-4b8e-827a-8f822b6c349d",
                                                "sense_id": "8605f815-c3e3-3044-9f66-c2f2c437689d",
                                                "text": "Frau Schmied ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "bebca845-ed94-4bf1-9e9c-23efeff11d35",
                                                "sense_id": "8605f815-c3e3-3044-9f66-c2f2c437689d",
                                                "text": "Herr Schmied wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "86d50281-bc66-485b-ba0f-0168a009f3ac",
                                                "sense_id": "8605f815-c3e3-3044-9f66-c2f2c437689d",
                                                "text": "Die Schmieds fliegen heute nach La Paz."
                                            },
                                            {
                                                "example_id": "f3087700-ea0f-4283-933b-65797fff9062",
                                                "sense_id": "8605f815-c3e3-3044-9f66-c2f2c437689d",
                                                "text": "Der Schmied trägt nie die Schals, die die Schmied ihm strickt."
                                            },
                                            {
                                                "example_id": "60a66c3c-7801-41b1-ab7d-70d03fe3a045",
                                                "sense_id": "8605f815-c3e3-3044-9f66-c2f2c437689d",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Schmied kommt, geht der Herr Schmied.“"
                                            },
                                            {
                                                "example_id": "401cb1cb-e03e-42e5-985d-7f366b8798c3",
                                                "sense_id": "8605f815-c3e3-3044-9f66-c2f2c437689d",
                                                "text": "Schmied kommt und geht."
                                            },
                                            {
                                                "example_id": "9d03de53-1ca5-4bcd-afce-2ac2d29e2314",
                                                "sense_id": "8605f815-c3e3-3044-9f66-c2f2c437689d",
                                                "text": "Schmieds kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
