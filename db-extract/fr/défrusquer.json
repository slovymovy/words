                "senses": [
                    {
                        "sense_id": "6551eef8-8c6b-3df3-ba7c-1fe896ce6b9d",
                        "entry_id": "d701cd56-64ba-3f86-8ceb-fb3e0a480ae3",
                        "glosses": [
                            "Déshabiller."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "877a0ae7-b16e-40c1-8c23-bbbcf13ea753",
                                "sense_id": "6551eef8-8c6b-3df3-ba7c-1fe896ce6b9d",
                                "text": "Tandis qu’elle avançait vers le bar, je la défrusquai de l’œil ; ça n’avait pas l’air de la gêner."
                            },
                            {
                                "example_id": "4fdd98f5-0252-4869-97e6-06cc451ecac0",
                                "sense_id": "6551eef8-8c6b-3df3-ba7c-1fe896ce6b9d",
                                "text": "Le frusquer le matin… le défrusquer le soir… et poireauter toute la nuit… J'en ai ma claque."
                            },
                            {
                                "example_id": "aa0ae391-b7fe-4815-a40b-fd69d290f478",
                                "sense_id": "6551eef8-8c6b-3df3-ba7c-1fe896ce6b9d",
                                "text": "Viens-tu te défrusquer dans le cabinet de toilette ?"
                            }
                        ]
                    }
