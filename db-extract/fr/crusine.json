                        "examples": [
                            {
                                "example_id": "63b2c43b-1575-4d53-bdea-70d7dc34342f",
                                "sense_id": "00846153-9c5c-3995-81d2-8bdaa859f6d5",
                                "text": "Si l’idée d’une alimentation saine vous plait, joignez leur cours de « crusine »."
                            },
                            {
                                "example_id": "e7b748e6-691f-4bef-8eb6-c95624f3c105",
                                "sense_id": "00846153-9c5c-3995-81d2-8bdaa859f6d5",
                                "text": "Toute en blondeur pétillante et en féminité, France s’adonne avec passion, bonheur, étincelle dans les yeux, à ce qui a désormais pour nom officiel la «crusine»…"
                            },
                            {
                                "example_id": "c6b400b2-a0fc-4b59-a653-87fab1c724df",
                                "sense_id": "00846153-9c5c-3995-81d2-8bdaa859f6d5",
                                "text": "En feuilletant « Les secrets de la crusine », ouvrage destiné à tous « ceux qui pensent qu’ils ont tout essayé et qui sont à la recherche d’une nouvelle expérience culinaire », selon l’éditeur, Judith Regan, je suis frappée par le nombre d’ingrédients nécessaires à chaque menu."
                            }
                        ]
