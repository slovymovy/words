{
    "word_family": [
        "admit",
        "admittance",
        "admission",
        "admissible",
        "inadmissible"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "381a2e57-a45f-3b86-9ba1-0199a1c59ebc",
                    "sense_definition": "Used to acknowledge or accept that something is true, often despite reluctance.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "concession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Admittedly</w>, vandalism is a bit of a problem in this neighbourhood.",
                            "target_lang_translations": {
                                "ru": "<w>Надо признать</w>, вандализм — небольшая проблема в этом районе."
                            }
                        },
                        {
                            "text": "The test was <w>admittedly</w> much harder than anyone had anticipated.",
                            "target_lang_translations": {
                                "ru": "Тест был, <w>надо признать</w>, гораздо сложнее, чем кто-либо ожидал."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для признания того, что факт верен, часто с некоторой неохотой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "надо признать",
                                "target_lang_sense_clarification": "признание факта, часто с неохотой"
                            },
                            {
                                "target_lang_word": "правда",
                                "target_lang_sense_clarification": "вводное слово для признания истинности"
                            },
                            {
                                "target_lang_word": "по общему признанию",
                                "target_lang_sense_clarification": "согласно мнению большинства"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c502d82d-4f7d-3a56-94dc-cfdc4765ce52",
                    "sense_definition": "Used to introduce a concession before making a contrasting point.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "concession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is only a theory, <w>admittedly</w>, but it might actually work.",
                            "target_lang_translations": {
                                "ru": "Это всего лишь теория, <w>правда</w>, но она вполне может сработать."
                            }
                        },
                        {
                            "text": "<w>Admittedly</w> he cannot swim, but he still loves going to the seaside.",
                            "target_lang_translations": {
                                "ru": "<w>Хотя</w> он и не умеет плавать, он всё равно обожает ездить на море."
                            }
                        }
                    ],
                    "synonyms": [
                        "granted"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для выражения уступки перед высказыванием противоположной мысли."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "правда",
                                "target_lang_sense_clarification": "выражение уступки перед контрастом"
                            },
                            {
                                "target_lang_word": "хотя",
                                "target_lang_sense_clarification": "уступительное значение"
                            },
                            {
                                "target_lang_word": "надо признать",
                                "target_lang_sense_clarification": "признание обстоятельства перед противопоставлением"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}