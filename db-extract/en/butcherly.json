                        "glosses": [
                            "Like a butcher; characterised by slaughter, savage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24a2e492-68f2-427f-b4b8-268d283504b0",
                                "sense_id": "3a8cb75a-0d6e-334c-ad3b-be68deb39694",
                                "text": "Alexander comming to the Ocean of India, cast in favour of Thetis many great rich vessels of gold into the Sea, replenishing moreover her Altars with a butcherly slaughter, not onely of innocent beasts, but of men[…]."
                            },
                            {
                                "example_id": "684379d2-dc9a-4b0c-ae4c-2358950ceeab",
                                "sense_id": "3a8cb75a-0d6e-334c-ad3b-be68deb39694",
                                "text": "She had not realised how butcherly the severed vessels would look, and she had not reckoned with the horrid halitus of blood, which steamed to her nostrils under the blazing sun."
                            }
                        ]
                    }
