    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b8c9cc17-69ac-3115-83e6-d80e2dd6bec5",
                    "sense_definition": "A building used for religious worship, especially in polytheistic religions or ancient traditions.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "religious_building",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient <w>temple</w> of Zeus was a massive structure with many marble columns.",
                            "target_lang_translations": {
                                "ru": "Древний <w>храм</w> Зевса был массивным сооружением со множеством мраморных колонн."
                            }
                        },
                        {
                            "text": "Many tourists visit the <w>temple</w> complex to see the beautiful statues of the gods.",
                            "target_lang_translations": {
                                "ru": "Многие туристы посещают <w>храмовый</w> комплекс, чтобы увидеть прекрасные статуи богов."
                            }
                        }
                    ],
                    "synonyms": [
                        "house of worship",
                        "place of worship",
                        "shrine",
                        "fane"
                    ],
                    "common_phrases": [
                        "ancient temple",
                        "temple complex",
                        "buddhist temple",
                        "hindu temple"
                    ],
                    "target_lang_definitions": {
                        "ru": "Здание, предназначенное для богослужений, особенно в политеистических религиях или древних традициях."
