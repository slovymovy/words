{
    "word_family": [
        "diminishment",
        "diminution",
        "diminutive",
        "undiminished"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d5c7bb0e-20fe-30dc-bf12-2249bd58f5ae",
                    "sense_definition": "To become less or smaller in size, amount, or importance.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "decrease",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The noise from the party began to <w>diminish</w> as the guests started to leave.",
                            "target_lang_translations": {
                                "ru": "Шум вечеринки начал <w>стихать</w>, когда гости стали расходиться.",
                                "zh": "随着客人陆续离开，派对的喧闹声开始<w>减弱</w>。"
                            }
                        },
                        {
                            "text": "The available resources will <w>diminish</w> rapidly if we do not manage them carefully.",
                            "target_lang_translations": {
                                "ru": "Доступные ресурсы будут быстро <w>сокращаться</w>, если мы не будем распоряжаться ими осторожно.",
                                "zh": "如果我们不谨慎管理，现有资源将迅速<w>减少</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "decrease",
                        "lessen",
                        "decline",
                        "abate"
                    ],
                    "antonyms": [
                        "augment",
                        "wax"
                    ],
                    "common_phrases": [
                        "diminish rapidly",
                        "diminish over time"
                    ],
                    "target_lang_definitions": {
                        "ru": "Становиться меньше по размеру, количеству или значимости.",
                        "zh": "指在大小、数量或重要性上变得更小或更少。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уменьшаться",
                                "target_lang_sense_clarification": "становиться меньше"
                            },
                            {
                                "target_lang_word": "сокращаться",
                                "target_lang_sense_clarification": "о ресурсах или объемах"
                            },
                            {
                                "target_lang_word": "ослабевать",
                                "target_lang_sense_clarification": "о звуке или силе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "减少",
                                "target_lang_sense_clarification": "指数量或程度上的降低"
                            },
                            {
                                "target_lang_word": "减弱",
                                "target_lang_sense_clarification": "指力量、声音或影响力的衰减"
                            },
                            {
                                "target_lang_word": "缩减",
                                "target_lang_sense_clarification": "指规模或资源的缩小"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1f1effa0-9cda-3787-97ed-1a6e7454cd1f",
                    "sense_definition": "To make something smaller or less important.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "decrease",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new law might <w>diminish</w> the power of local governments to make independent decisions.",
                            "target_lang_translations": {
                                "ru": "Новый закон может <w>ослабить</w> власть местных органов управления в принятии независимых решений.",
                                "zh": "新法律可能会<w>削弱</w>地方政府独立决策的权力。"
                            }
                        },
                        {
                            "text": "We must not <w>diminish</w> the importance of education in our society.",
                            "target_lang_translations": {
                                "ru": "Мы не должны <w>умалять</w> важность образования в нашем обществе.",
                                "zh": "我们绝不能<w>贬低</w>教育在社会中的重要性。"
                            }
                        }
                    ],
                    "synonyms": [
                        "reduce",
                        "lower",
                        "cut",
                        "lessen"
                    ],
                    "antonyms": [
                        "augment"
                    ],
                    "common_phrases": [
                        "diminish the importance",
                        "diminish the impact"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать что-либо меньше или менее важным.",
                        "zh": "使某物变得更小或不那么重要。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уменьшать",
                                "target_lang_sense_clarification": "делать меньше"
                            },
                            {
                                "target_lang_word": "ослаблять",
                                "target_lang_sense_clarification": "влияние или власть"
                            },
                            {
                                "target_lang_word": "сокращать",
                                "target_lang_sense_clarification": "количество или права"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "削弱",
                                "target_lang_sense_clarification": "指降低权力或影响力"
                            },
                            {
                                "target_lang_word": "贬低",
                                "target_lang_sense_clarification": "指降低某事物的价值或重要性"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6977e722-b757-37a1-86b9-cce958400eb3",
                    "sense_definition": "To make something appear smaller or less significant than it really is; to belittle.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "belittle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He tried to <w>diminish</w> her achievements by claiming she had received too much help.",
                            "target_lang_translations": {
                                "ru": "Он пытался <w>принизить</w> её достижения, утверждая, что ей слишком много помогали.",
                                "zh": "他试图通过声称她得到了太多帮助来<w>贬低</w>她的成就。"
                            }
                        },
                        {
                            "text": "Do not <w>diminish</w> the value of his contribution just because he is new.",
                            "target_lang_translations": {
                                "ru": "Не <w>умаляйте</w> ценность его вклада только потому, что он новичок.",
                                "zh": "不要仅仅因为他是新人就<w>轻视</w>他的贡献价值。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bring down"
                    ],
                    "common_phrases": [
                        "diminish the value",
                        "diminish achievements"
                    ],
                    "target_lang_definitions": {
                        "ru": "Представлять что-либо менее значимым, чем оно есть на самом деле; принижать.",
                        "zh": "使某事物看起来比实际更小或更不重要；轻视。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "принижать",
                                "target_lang_sense_clarification": "заслуги или достижения"
                            },
                            {
                                "target_lang_word": "умалять",
                                "target_lang_sense_clarification": "значение или ценность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "轻视",
                                "target_lang_sense_clarification": "指不重视某人的贡献"
                            },
                            {
                                "target_lang_word": "贬低",
                                "target_lang_sense_clarification": "指刻意降低某人的成就"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "29c907eb-1f0a-39e8-aea1-e8a852c667ea",
                    "sense_definition": "To lessen the authority, dignity, or reputation of someone; to make someone feel less powerful.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "belittle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scandal served to <w>diminish</w> his standing in the community.",
                            "target_lang_translations": {
                                "ru": "Скандал послужил тому, чтобы <w>подорвать</w> его положение в обществе.",
                                "zh": "这起丑闻<w>损害</w>了他在社区中的地位。"
                            }
                        },
                        {
                            "text": "She felt <w>diminished</w> by his constant criticism of her work.",
                            "target_lang_translations": {
                                "ru": "Она чувствовала себя <w>униженной</w> из-за его постоянной критики её работы.",
                                "zh": "他对他工作的不断批评让她感到自尊心受<w>损</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "lower"
                    ],
                    "common_phrases": [
                        "feel diminished",
                        "diminish authority"
                    ],
                    "target_lang_definitions": {
                        "ru": "Умалять авторитет, достоинство или репутацию кого-либо.",
                        "zh": "损害某人的权威、尊严或声誉；使人感到地位下降。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подрывать",
                                "target_lang_sense_clarification": "авторитет или репутацию"
                            },
                            {
                                "target_lang_word": "унижать",
                                "target_lang_sense_clarification": "заставлять чувствовать себя менее значимым"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "损害",
                                "target_lang_sense_clarification": "指对声誉或地位的破坏"
                            },
                            {
                                "target_lang_word": "贬损",
                                "target_lang_sense_clarification": "指使人感到尊严受损"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1f84629c-027e-3d4b-9337-1a47ce97364c",
                    "sense_definition": "To disappear or fade away gradually.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "decrease",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sound of the train <w>diminished</w> into the distance until it was gone.",
                            "target_lang_translations": {
                                "ru": "Звук поезда <w>затихал</w> вдали, пока совсем не исчез.",
                                "zh": "火车的声音在远处逐渐<w>消逝</w>，直到完全听不见。"
                            }
                        },
                        {
                            "text": "As the sun set, the light slowly <w>diminished</w> across the valley.",
                            "target_lang_translations": {
                                "ru": "Когда солнце село, свет над долиной медленно <w>угас</w>.",
                                "zh": "随着太阳落山，山谷里的光线慢慢<w>减弱</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ebb",
                        "decline"
                    ],
                    "common_phrases": [
                        "diminish into distance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Постепенно исчезать или затихать.",
                        "zh": "逐渐消失或减弱。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "затихать",
                                "target_lang_sense_clarification": "о звуке"
                            },
                            {
                                "target_lang_word": "угасать",
                                "target_lang_sense_clarification": "о свете или чувствах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "消逝",
                                "target_lang_sense_clarification": "指声音或光线逐渐不见"
                            },
                            {
                                "target_lang_word": "减弱",
                                "target_lang_sense_clarification": "指强度逐渐降低"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "921490ae-0162-3543-81f0-d700997898c0",
                    "sense_definition": "To become gradually thinner toward one end; to taper.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The columns <w>diminish</w> toward the top to create a more elegant appearance.",
                            "target_lang_translations": {
                                "ru": "Колонны <w>сужаются</w> кверху, что создает более элегантный вид.",
                                "zh": "柱子向上方逐渐<w>变细</w>，以营造出更优雅的外观。"
                            }
                        },
                        {
                            "text": "The narrow path <w>diminishes</w> as it winds up the steep mountain.",
                            "target_lang_translations": {
                                "ru": "Узкая тропа <w>сужается</w>, извиваясь вверх по крутой горе.",
                                "zh": "这条狭窄的小路随着蜿蜒上山而逐渐<w>收窄</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "diminish toward top"
                    ],
                    "target_lang_definitions": {
                        "ru": "Постепенно сужаться к одному концу.",
                        "zh": "向一端逐渐变细。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сужаться",
                                "target_lang_sense_clarification": "становиться тоньше к концу"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "变细",
                                "target_lang_sense_clarification": "指形状上的收窄"
                            },
                            {
                                "target_lang_word": "收窄",
                                "target_lang_sense_clarification": "指路径或结构逐渐变窄"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f6582687-2c17-376a-b244-81d8a2acd1aa",
                    "sense_definition": "To take away or subtract a part from a whole.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "decrease",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The editor was careful not to <w>diminish</w> anything from the original manuscript's meaning.",
                            "target_lang_translations": {
                                "ru": "Редактор старался не <w>отнимать</w> ничего от смысла оригинальной рукописи.",
                                "zh": "编辑非常小心，没有对原稿的含义造成任何<w>减损</w>。"
                            }
                        },
                        {
                            "text": "You should not <w>diminish</w> from the truth even when it is difficult.",
                            "target_lang_translations": {
                                "ru": "Не следует <w>отступать</w> от истины, даже когда это трудно.",
                                "zh": "即使在困难的情况下，你也不应该<w>背离</w>真相。"
                            }
                        }
                    ],
                    "synonyms": [
                        "reduce",
                        "cut"
                    ],
                    "common_phrases": [
                        "diminish from"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "often used in biblical or formal contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отнимать или вычитать часть из целого.",
                        "zh": "从整体中拿走或减去一部分。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отнимать",
                                "target_lang_sense_clarification": "убавлять от чего-либо"
                            },
                            {
                                "target_lang_word": "отступать",
                                "target_lang_sense_clarification": "в контексте «отступать от истины»"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "减损",
                                "target_lang_sense_clarification": "指对完整性的破坏"
                            },
                            {
                                "target_lang_word": "背离",
                                "target_lang_sense_clarification": "指偏离真理或原则"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}