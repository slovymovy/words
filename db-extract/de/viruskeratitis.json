                        "examples": [
                            {
                                "example_id": "f087f4bd-14a8-4c33-976d-0741e32ae77c",
                                "sense_id": "873b54ca-11f2-391c-a768-a04fd6834010",
                                "text": "„Sie reduzieren die Sehschärfe auf 0,2, da sich die Viruskeratitis zunehmend nach zentral ausgebreitet hat.“"
                            },
