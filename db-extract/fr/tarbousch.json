                        "examples": [
                            {
                                "example_id": "ac9baffc-877b-4474-acf4-7203733631c1",
                                "sense_id": "c280f771-2fdb-3126-b780-7a201bc9f8de",
                                "text": "Ses cheveux , plus artistement nattés et tressés que la première fois, étaient inondés d’une pluie de sequins, et un petit tarbousch de velours cramoisi était coquettement posé sur le sommet de sa tète."
                            },
                            {
                                "example_id": "fcb30fbb-dc42-4720-9d57-e4e6501ceafa",
                                "sense_id": "c280f771-2fdb-3126-b780-7a201bc9f8de",
                                "text": "Sa coiffure était ce bonnet rouge que les Turcs appellent tarbousch, et les Grecs ʃési ; il était garni d’un gland et d’un flocon d’or épanoui en forme de soleil."
                            }
                        ]
                    }
