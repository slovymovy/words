                ],
                "senses": [
                    {
                        "sense_id": "b0a065ea-89e1-3e21-afbf-280e0a1ed96b",
                        "entry_id": "ebebee0a-acd6-303b-8ddf-83940a5908ef",
                        "glosses": [
                            "Bestandteil einer Substanz"
                        ],
                        "tags": [
                            "natürliche vorgefundenen oder künstlich (physikalisch/chemisch) hergestellten"
                        ],
                        "examples": [
                            {
                                "example_id": "87796543-a7cb-44bd-a55c-d1e85525d65e",
                                "sense_id": "b0a065ea-89e1-3e21-afbf-280e0a1ed96b",
                                "text": "„Einige wenige → ätherische Öle bzw. Inhaltsstoffe besitzen bei der Aufnahme (Resorption) größerer Mengen in den Organismus eine abortive (abtreibende) Wirkung.“"
                            },
                            {
                                "example_id": "708e2708-e27d-4c0e-b158-e0e37c9bb86b",
                                "sense_id": "b0a065ea-89e1-3e21-afbf-280e0a1ed96b",
                                "text": "Die Inhaltsstoffe des Medikaments könnten bei falscher Anwendung bei einigen Patienten zum Tode führen."
                            },
                            {
                                "example_id": "82a7881d-cd66-4312-aa60-2892eb1b598a",
                                "sense_id": "b0a065ea-89e1-3e21-afbf-280e0a1ed96b",
                                "text": "Die Zusammensetzung und die genauen Mengenangaben der Inhaltsstoffe von Coca–Cola sind geheim."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d01ccb66-c2f3-481c-a3a2-f47346fb2d7f",
                        "source_entry_id": "ebebee0a-acd6-303b-8ddf-83940a5908ef",
                        "source_sense_id": "b0a065ea-89e1-3e21-afbf-280e0a1ed96b",
