                "senses": [
                    {
                        "sense_id": "9c03bc1e-3e13-3cc3-98ab-e2ac617ee272",
                        "entry_id": "73e57b5c-7e7b-396d-92b0-9023c3a63768",
                        "glosses": [
                            "Variante de lofer."
                        ],
                        "tags": [
                            "alt-of",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "84421d8e-307d-42be-bda8-97d0518c6041",
                                "sense_id": "9c03bc1e-3e13-3cc3-98ab-e2ac617ee272",
                                "text": "C'est ainsi que n'a pas été considéré comme une faille le fait par un voilier au plus près de loffer un peu, surtout si celle manœuvre ne lui fait pas changer son cap."
                            },
                            {
                                "example_id": "cf1433d0-72c4-4b78-8c24-86b0cbcc935b",
                                "sense_id": "9c03bc1e-3e13-3cc3-98ab-e2ac617ee272",
                                "text": "Ajoutons enfin, que plus un bâtiment tire d'eau par l'avant et moins par l'arrière, plus il est ardent ou apte à loffer."
                            }
                        ]
                    }
