                "senses": [
                    {
                        "sense_id": "8891d453-79d1-30ab-826c-67b2f4c6d400",
                        "entry_id": "48664bba-6039-35e6-9802-de985055077c",
                        "glosses": [
                            "baulich visualisierter Ereignispunkt auf einem religiösen Passionsweg"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "baeb4172-8929-4013-a444-71f0d2073377",
                                "sense_id": "8891d453-79d1-30ab-826c-67b2f4c6d400",
                                "text": "„Der prachtvolle barocke Kreuzweg mit den 13 Stationskapellen und der Hauptkapelle der 12. Station wurde in den Jahren 1731 bis 1748 erbaut.“"
                            },
                            {
                                "example_id": "1867c13c-4735-4b89-a52c-a476d970153f",
                                "sense_id": "8891d453-79d1-30ab-826c-67b2f4c6d400",
                                "text": "„Noch vor 1837 befand sich hier eine Stationskapelle Amenhoteps III; auf hohem Podest stand der Barkenschrein mit einem Pfeilerumgang.“"
                            },
                            {
                                "example_id": "0f57893c-5b8f-4188-931b-45a5b09b8f46",
                                "sense_id": "8891d453-79d1-30ab-826c-67b2f4c6d400",
                                "text": "„Der \"Alte Kreuzweg\" umfasst heute 13 Stationskapellen sowie die Kreuzigungsgruppe der XII. Station auf dem sog. \"Kalvarienberg\".“"
                            },
                            {
                                "example_id": "b961291f-3daa-43e1-8b1c-cb8d13788651",
                                "sense_id": "8891d453-79d1-30ab-826c-67b2f4c6d400",
                                "text": "„Die Kapelle wurde als Wege- und Stationskapelle eines Bittweges mit den sieben Fußfällen in Blickweite des befestigten Burghauses „Haus zum Haus“ errichtet und im Jahr 1685 fertiggestellt.“"
                            },
                            {
                                "example_id": "38431f27-b42d-4551-9129-0f9559f1071b",
                                "sense_id": "8891d453-79d1-30ab-826c-67b2f4c6d400",
                                "text": "„Die riesige Treppenanlage ist mit 14 Stationskapellen, Brunnen und Statuen geschmückt.“"
                            },
                            {
                                "example_id": "b6f9d6a8-a9ef-45cc-8b84-a40c26386472",
                                "sense_id": "8891d453-79d1-30ab-826c-67b2f4c6d400",
                                "text": "„Der Möserer Kalvarienberg - entstand um 1830 mit 8 Stationskapellen, heute sind es 11 Stationen.“"
                            },
                            {
                                "example_id": "2f4fc557-a11e-4948-948f-13ac28551921",
                                "sense_id": "8891d453-79d1-30ab-826c-67b2f4c6d400",
                                "text": "„Lange bevor das heutige Ehrenmal an die Gefallenen und Vermissten der zwei Weltkriege erinnern sollte, entstand an diesem Ort eine Stationskapelle des Kreuzweges - das geht aus den Unterlagen der Katholischen Kirchengemeinde Grevenstein hervor .“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
