                                            {
                                                "example_id": "f66161f9-bf8f-4d00-b75a-5e940330efef",
                                                "sense_id": "f23c0b06-976a-30de-808f-dc52123691e1",
                                                "text": "Lipiden zijn een belangrijk component van celmembranen."
                                            }
                                        ]
