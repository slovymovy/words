                "senses": [
                    {
                        "sense_id": "79ceae6f-bfd9-3eae-8ae9-861663307d10",
                        "entry_id": "91b52e7f-4f32-3e3d-b1b6-be6ec119fdf9",
                        "glosses": [
                            "Person, die beruflich die Füße von Kunden reinigt und pflegt"
                        ],
                        "tags": [
                            "Austrian German",
                            "especially",
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "5534cef4-a158-4fa4-b587-6e2a7b1bdbc6",
                                "sense_id": "79ceae6f-bfd9-3eae-8ae9-861663307d10",
                                "text": "Gestern ist er zum Pedikeur gegangen."
                            },
                            {
                                "example_id": "dd16e7eb-2709-4f28-b57c-aaf182756d98",
                                "sense_id": "79ceae6f-bfd9-3eae-8ae9-861663307d10",
                                "text": "„Nach der Entlassung vom Militär arbeitete Berndl in Wien als Pedikeur.“"
                            },
                            {
                                "example_id": "17df69fa-4808-42cc-b15e-5c654ed2c32e",
                                "sense_id": "79ceae6f-bfd9-3eae-8ae9-861663307d10",
                                "text": "„[S]ie trug verschiedene Sonnenbrillen, kaufte jede Menge luxuriöse Kosmetika und Parfüms, besuchte wöchentlich den Frisör, eine Kosmetikerin, einen Pedikeur, wurde massiert und in alle möglichen Körpermasken gepackt […].“"
                            },
                            {
                                "example_id": "7206315a-f8d8-45f3-9af2-746812762a51",
                                "sense_id": "79ceae6f-bfd9-3eae-8ae9-861663307d10",
                                "text": "„In unserem Altersheim in Lainz wird zwar Fußpflege regelmäßig durchgeführt, aber noch wäre es ein wichtiger Zweig prophylaktischer Medizin und sozialer Fürsorge, sie zur Pflicht zu machen, wobei gemäß der Seelenhaltung alter Menschen nur ein Teil, selbst bei unentgeltlicher Versorgung, zum Pedikeur gehen wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
