                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "cac83e72-40ae-4ce3-903d-7a7284120138",
                                "sense_id": "a3f82194-10a1-362c-bfe0-a3599dc2ca71",
                                "text": "Avicii steht in den Charts ganz oben."
                            },
                            {
                                "example_id": "ce26b70f-217a-4875-b75d-8ee899e461a6",
                                "sense_id": "a3f82194-10a1-362c-bfe0-a3599dc2ca71",
                                "text": "Die Band dominiert seit einem Jahr die Charts."
                            },
                            {
                                "example_id": "68fd3fad-ede4-4982-b6d3-c7eec6bde953",
                                "sense_id": "a3f82194-10a1-362c-bfe0-a3599dc2ca71",
                                "text": "„Der Spot führte ein Jahr lang die Charts an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "059ba032-b6e2-3d01-b323-0ea7d581ea3e",
                        "entry_id": "db5c81f0-c565-3e76-be27-21aeae87e968",
                        "glosses": [
                            "Diagramm, welches den Kursverlauf eines Wertpapiers anzeigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bab798a7-62e8-47e3-9cef-028ab0275d74",
                                "sense_id": "059ba032-b6e2-3d01-b323-0ea7d581ea3e",
                                "text": "Entdecken Sie endlich den interaktiven, großen, übersichtlichen Kurs-Chart der Firma BMW."
