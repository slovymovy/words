                                        "entry_id": "15b16836-03f3-3999-a8e0-1a6ef62c0f20",
                                        "glosses": [
                                            "een wetenschapper die de werking van giftige stoffen op biologische systemen bestudeert"
                                        ],
                                        "tags": [
                                            "beroep"
                                        ],
                                        "examples": [
                                            {
