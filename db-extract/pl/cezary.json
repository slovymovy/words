                "senses": [
                    {
                        "sense_id": "9d4d38de-9d63-3cde-981d-7c9823239d06",
                        "entry_id": "7330e490-c535-36a7-be38-807f020dc716",
                        "glosses": [
                            "imię męskie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3af1c38d-ec32-464b-872f-5e9e4276916e",
                                "sense_id": "9d4d38de-9d63-3cde-981d-7c9823239d06",
                                "text": "Głównym podręcznym był narzeczony, pan Barwicki. Lecz były również pomagiery drugorzędne, między innymi Hipolit Wielosławski i Cezary Baryka."
                            },
                            {
                                "example_id": "530d6d56-62ee-4476-b75b-1c61b7d61ee4",
                                "sense_id": "9d4d38de-9d63-3cde-981d-7c9823239d06",
                                "text": "Cezary Miżejewski (PPS) jest inicjatorem interpelacji do ministra sprawiedliwości w sprawie delegalizacji organizacji neofaszystowskich i skrajnej prawicy w Polsce."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
