                {
                    "sense_id": "0e69c16b-591f-3bde-becc-94a8493a4ad5",
                    "sense_definition": "Donner plus de puissance ou d'intensité à un son ou à la voix.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "intensification_sonore",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le comédien doit <w>renforcer</w> sa voix pour être bien entendu par tout le public.",
                            "target_lang_translations": {
                                "en": "The actor must <w>project</w> his voice so that the whole audience can hear him clearly.",
                                "ru": "Актёр должен <w>усилить</w> голос, чтобы его хорошо слышала вся публика.",
                                "de": "Der Schauspieler muss seine Stimme <w>verstärken</w>, damit ihn das ganze Publikum gut hören kann.",
                                "es": "El actor debe <w>proyectar</w> la voz para que todo el público lo oiga bien.",
                                "zh": "演员必须把嗓音<w>放大</w>，才能让全场观众听得清清楚楚。"
                            }
                        },
                        {
                            "text": "L'ingénieur a choisi de <w>renforcer</w> les basses sur cet enregistrement musical.",
                            "target_lang_translations": {
                                "en": "The engineer chose to <w>boost</w> the bass on this music recording.",
                                "ru": "Инженер решил <w>усилить</w> басы на этой музыкальной записи.",
                                "de": "Der Toningenieur hat sich entschieden, die Bässe auf dieser Musikaufnahme <w>zu verstärken</w>.",
                                "es": "El ingeniero optó por <w>reforzar</w> los bajos de esta grabación musical.",
                                "zh": "工程师在这段音乐录音中选择<w>增强</w>低音。"
                            }
                        }
                    ],
                    "antonyms": [
                        "affaiblir"
                    ],
                    "common_phrases": [
                        "renforcer la voix",
                        "renforcer le son"
                    ],
                    "target_lang_definitions": {
                        "en": "To give more power or intensity to a sound or voice.",
                        "ru": "Придавать звуку или голосу большую силу и громкость.",
                        "de": "Einem Klang oder einer Stimme mehr Kraft und Lautstärke geben.",
                        "es": "Dar más potencia o intensidad a un sonido o a la voz.",
                        "zh": "增大声音或嗓音的力量和音量。"
