                        "entry_id": "4f6f11c2-d650-304b-a939-e1c1497bba5f",
                        "glosses": [
                            "schematische afbeelding van een ruimtelijk gebied op een plat vlak in een verkleinde schaal"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fdec6d20-59b2-4073-8f30-1bf1169e99cb",
                                "sense_id": "aa3623f5-e7ad-3ad9-b5d5-7226a55733a9",
                                "text": "Ze duwt zachtjes met de punt van haar laars tegen de papieren en slaakt een kreet als ze de plattegrond van haar jeugd ontwaart, die jaren geleden is gemaakt."
                            },
                            {
                                "example_id": "9b201955-599e-45ab-901a-2a0b0645d1b7",
                                "sense_id": "aa3623f5-e7ad-3ad9-b5d5-7226a55733a9",
                                "text": "Ik buig me weer over de plattegrond en noteer de potentiële plekken voor de liquidatie."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
