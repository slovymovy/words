                "senses": [
                    {
                        "sense_id": "916e9133-45e9-3b87-813d-e313c503b606",
                        "entry_id": "7559138c-069e-3ad3-b9e2-b7f35cbbdd07",
                        "glosses": [
                            "Commune française, située dans le département de l’Aveyron."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4862dd71-9666-4875-97c7-b640875c2360",
                                "sense_id": "916e9133-45e9-3b87-813d-e313c503b606",
                                "text": "Tremblez bourgeois, assassins de Versailles\nNous compterons nos morts et nos tombeaux :\nMil huit cent trente et la Ricamarie\nSoixante-et-onze, Aubin, Paris, Lyon\nPuis les enfants, les femmes de Fourmie\nDebout ! voici la Révolution."
                            }
                        ]
                    },
                    {
                        "sense_id": "ef9bb211-90a8-3167-b466-85289233c455",
