                "senses": [
                    {
                        "sense_id": "78838d1c-fb59-30a0-8896-94544113fd89",
                        "entry_id": "89c76fb8-663a-3f21-9c46-b7bbc14f0e37",
                        "glosses": [
                            "Faire perdre son caractère berbère à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d620eb02-a9cf-4c2d-bc6b-137b41e07482",
                                "sense_id": "78838d1c-fb59-30a0-8896-94544113fd89",
                                "text": "On l’a même accusée d’avoir, ce faisant, contribué à déberbériser diverses tribus ; on peut au moins lui reprocher de ne les avoir pas préservées de l’arabisation."
                            },
                            {
                                "example_id": "75422bf8-9e36-4224-93e0-288944d06451",
                                "sense_id": "78838d1c-fb59-30a0-8896-94544113fd89",
                                "text": "Ne va-t-il pas jusqu’à comparer le fait de se déberbériser à l’acte de sortir de la jâhiliya en se faisant musulman ?"
                            }
                        ]
                    }
