                                    {
                                        "sense_id": "5e09aba7-30d8-335e-b650-0d7d00789489",
                                        "entry_id": "d8e1b119-f26b-3f50-8252-0d59cd0b7697",
                                        "glosses": [
                                            "The great artery which carries the blood from the heart to all parts of the body except the lungs; the main trunk of the arterial system."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1e5466c2-5203-3bc4-849d-4b1317995075",
                                        "entry_id": "d8e1b119-f26b-3f50-8252-0d59cd0b7697",
                                        "glosses": [
                                            "The liveliest part of something."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd4a08af-af8c-40cb-9504-ba6f353f080b",
                                                "sense_id": "1e5466c2-5203-3bc4-849d-4b1317995075",
                                                "text": "Tracing their battles, I had many occasions to walk along Second Avenue, the aorta of the Lower East Side, exploring places that were once as vibrant and tumultuous as Midtown Manhattan."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
