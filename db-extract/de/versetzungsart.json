                    {
                        "sense_id": "78a25e34-f9ed-34d6-9e09-6784194f83db",
                        "entry_id": "dd250e71-19da-3a7c-9be0-7247e2534078",
                        "glosses": [
                            "Art eindimensionaler Gitterfehler in einem Kristall (Versetzung)"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "2c2e401a-06ec-4bad-a9b4-3e63d7af0cfb",
                                "sense_id": "78a25e34-f9ed-34d6-9e09-6784194f83db",
                                "text": "Man unterscheidet zwei Versetzungsarten: Die Stufenversetzung und die Schraubenversetzung."
                            },
                            {
                                "example_id": "6b04a4c3-62d0-4549-bde6-1097c0cfedf3",
                                "sense_id": "78a25e34-f9ed-34d6-9e09-6784194f83db",
                                "text": "„Bei asymmetrischen Korngrenzen ist mehr als eine Versetzungsart erforderlich.“"
                            },
                            {
                                "example_id": "f6738439-5826-409b-84ce-5a506d77dc07",
                                "sense_id": "78a25e34-f9ed-34d6-9e09-6784194f83db",
                                "text": "„Es konnten jedoch grundsätzlich bei dieser Anordnung keine besonderen Unterschiede zur regelmäßigen Versetzungsart mit с = 0,5 festgestellt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
