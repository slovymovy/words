                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grafema",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "05261a38-23fe-327a-bfa3-53e8c78cfc8b",
                                        "entry_id": "4c2ad7ff-293d-38ec-846c-ef6450be2d03",
