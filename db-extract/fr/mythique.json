                                            },
                                            {
                                                "example_id": "d6c2483f-22fe-4986-991f-24afcf50245a",
                                                "sense_id": "e584a2a2-b095-307b-83fa-95172af0f6f7",
                                                "text": "mythical hero"
                                            },
                                            {
                                                "example_id": "8ab15a56-a83e-4433-857a-90ca9f4fc854",
                                                "sense_id": "e584a2a2-b095-307b-83fa-95172af0f6f7",
                                                "text": "He told a story about a mythical dragon."
                                            },
                                            {
                                                "example_id": "9d01d391-6d18-47fd-a771-f9616055e3e8",
                                                "sense_id": "e584a2a2-b095-307b-83fa-95172af0f6f7",
                                                "text": "The city was compared to a mythical paradise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77d4c82e-01a1-320e-b0a2-32dc421d21a4",
                                        "entry_id": "883f88bf-e3d6-3981-ab56-593f5be6cf3f",
                                        "glosses": [
                                            "Not real; false or fabricated."
                                        ],
