                                    {
                                        "sense_id": "103fec0e-af40-3a88-bce1-09d385dc2b76",
                                        "entry_id": "0c0dc6ea-2832-380f-94bd-4302df003e35",
                                        "glosses": [
                                            "die Kultur betreffend, von Kultur geprägt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e325c7e0-706a-419c-b53f-376e9ae84510",
                                                "sense_id": "103fec0e-af40-3a88-bce1-09d385dc2b76",
                                                "text": "Museen sind kulturell bedeutsame Einrichtungen."
                                            },
                                            {
                                                "example_id": "51fbda00-2bbd-48d7-b2ea-d18dff9196f9",
                                                "sense_id": "103fec0e-af40-3a88-bce1-09d385dc2b76",
                                                "text": "„Noch stärker als bisher müssen Sprachwissenschaft und Sprachdidaktik dazu beitragen, die mit kultureller Diversität und intrakulturellen Sprachdifferenzen verbundenen gesellschaftlichen Herausforderungen zu gestalten.“"
                                            },
                                            {
                                                "example_id": "15861811-8cd1-416a-9766-4d6e4d4b64a3",
                                                "sense_id": "103fec0e-af40-3a88-bce1-09d385dc2b76",
                                                "text": "„Die islamische Geschichtsschreibung dagegen beschreibt Mahmud als den Begründer einer kulturellen Hochphase.“"
                                            },
                                            {
                                                "example_id": "a4ee1504-89e3-4734-b633-be5893c2f455",
                                                "sense_id": "103fec0e-af40-3a88-bce1-09d385dc2b76",
                                                "text": "„Religiöse Feste oder Bräuche wie Weihnachten oder Ramadan sind kulturelle Phänomene – von Menschen für Menschen gemacht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
