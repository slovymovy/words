                ],
                "senses": [
                    {
                        "sense_id": "00365100-4ac9-32f8-ac6c-4b5763572c6a",
                        "entry_id": "f4303eda-7fae-3ea3-8e92-7629ec0cb956",
                        "glosses": [
                            "een gezin met veel maatschappelijke moeilijkheden dat vaak ook overlast veroorzaakt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b55c232b-b66b-4a79-a25f-31a8deaef2a3",
                                "sense_id": "00365100-4ac9-32f8-ac6c-4b5763572c6a",
                                "text": "Het team werkt in duo's en klopt net zo vaak aan bij een probleemgezin tot het binnen mag komen. Soms duurt dat wel een jaar. Vervolgens worden de kinderen gescreend en krijgen ze socialevaardigheidstrainingen, gebaseerd op het nieuwste wetenschappelijke onderzoek."
                            },
                            {
                                "example_id": "03ad4d30-52e0-4aae-8b9a-3174c792fdb6",
                                "sense_id": "00365100-4ac9-32f8-ac6c-4b5763572c6a",
                                "text": "'Voor probleemgezinnen moeten we tot een totaalaanpak komen. Verder willen wij met de zorgverzekeraars bepalen wat de wijkverpleegkundigen in de buurt doen, ook al worden ze door de verzekeraars betaald.'"
                            },
                            {
                                "example_id": "26eaa4a1-fb4b-4c68-9d41-751f37de72cb",
                                "sense_id": "00365100-4ac9-32f8-ac6c-4b5763572c6a",
                                "text": "Echtparen die in scheiding liggen en al bekend staan als 'probleemgezin', krijgen bij wijze van experiment een maatschappelijk werker en een bemiddelaar toegewezen, die moeten voorkomen dat de scheiding uit de hand loopt."
                            }
                        ]
                    }
