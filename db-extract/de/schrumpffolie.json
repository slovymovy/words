                                "target_senses": [
                                    {
                                        "sense_id": "01a174ed-476e-3f64-afdf-0bcf3e8c26be",
                                        "entry_id": "85acc6c2-6869-3259-948f-ba73d4ed22c2",
                                        "glosses": [
                                            "een transparante plastic film om materiaal te verpakken. Bij verhitting krimpt de folie strak om het verpakte materiaal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34247312-8f64-4afd-93cb-6056dc10313f",
                                                "sense_id": "01a174ed-476e-3f64-afdf-0bcf3e8c26be",
                                                "text": "Een ander opvallend hackprogramma dat de CIA bij door hen geselecteerde iPhones heeft gehanteerd, is NightSkies 1.2. Volgens gelekte documenten uit 2008 zou de CIA sinds toen implantaten in iPhones plaatsen die net uit de fabriek komen. Door middel van die implantaten heeft de CIA toegang tot gegevens van deze telefoon. De CIA zou postpakketten van bedrijven die ze in de gaten willen houden hebben onderschept om de iPhones vervolgens te voorzien van de spionageprogramma's. Door de telefoons vervolgens te voorzien van krimpfolie zijn eventuele sporen van sabotage verdoezeld. De gelekte documenten van WikiLeaks laten verder zien dat de stiekem geïnstalleerde malware van de CIA nauwelijks te verwijderen is. Zelfs als het hele besturingssysteem opnieuw wordt geïnstalleerd blijft de CIA-infectie actief."
                                            },
                                            {
                                                "example_id": "7a80849e-1c27-4429-b304-cb13c66ef406",
                                                "sense_id": "01a174ed-476e-3f64-afdf-0bcf3e8c26be",
                                                "text": "Seal and Go groeit gestaag. Het bedrijfje voorziet op Schiphol dagelijks 100 tot 120 rugzakken, koffers en tassen van een plastic jasje.... Vorig jaar startte het bedrijf en in december werden vijftig tot zeventig koffers per dag in krimpfolie gestoken. Seal and Go verwacht dat de groei doorgaat. 'Het zomerseizoen moet nog beginnen', zegt het bedrijf.Een extra duwtje is de rijksdaalder korting die verzekeringsmaatschappij de Europeesche sinds drie weken biedt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
