                    },
                    {
                        "translation_id": "55cb8cad-555e-4711-a350-632529933a45",
                        "source_entry_id": "ced3a56c-b4d3-31a6-b934-d1bf207a3e5c",
                        "source_sense_description": "unable to defecate",
                        "target_lang_word": "constipé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "constipé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d663abe5-2fc8-31e3-8464-203eff45eea3",
                                        "entry_id": "43d9707e-9705-3190-b859-dd9b06b8b48c",
                                        "glosses": [
                                            "Qualifie une personne ou animal qui a des problèmes de constipation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03fb7de0-5a95-4888-b8f4-129fc0078f4e",
                                                "sense_id": "d663abe5-2fc8-31e3-8464-203eff45eea3",
                                                "text": "Il mange trop de bananes ; il est toujours constipé."
                                            },
                                            {
                                                "example_id": "d93f50d0-ae18-48d6-9007-aec558638f75",
                                                "sense_id": "d663abe5-2fc8-31e3-8464-203eff45eea3",
                                                "text": "Il veut raisonner serré, lui, il ne veut pas d’une logique lâche, — ce qui le constipe, il paraît, et lui donne de grands maux de tête.\n« Le cerveau, vois-tu, dit-il à mon père, en se tapotant le front avec l’index…\n— Pas le cerveau, » dit le médecin, qui croit à une affection du gros intestin ; si bien qu’il ne sait pas au juste si M. Bergougnard est philosophe parce qu’il est constipé, ou s’il est constipé parce qu’il est philosophe.\nOn en parle ; il s’élève quelques petites discussions très aigres à ce propos dans les cafés. Le cerveau a ses partisans."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "constipé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "667ac01f-c916-3afa-8032-067549b93f6b",
                                        "entry_id": "d6593782-59dd-3ca4-b3cf-52cef2e59fe5",
                                        "glosses": [
                                            "Personne atteinte de constipation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee3a5cfe-a098-4097-a6f6-b9242c847807",
                                                "sense_id": "667ac01f-c916-3afa-8032-067549b93f6b",
                                                "text": "Nous préciserons seulement quelques notions générales indispensables à connaître pour traiter un constipé."
                                            },
                                            {
                                                "example_id": "c44ee34a-3db9-41f3-b8b5-dad97414229d",
                                                "sense_id": "667ac01f-c916-3afa-8032-067549b93f6b",
                                                "text": "Ceux-là feuillettent avidement quelques conseils sexuels pour la jeunesse ou les Dix Commandements du Constipé, en ayant l’air de s’intéresser au Voyage en Orient, de Gérard de Nerval."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a192e56b-c24c-3ccd-bd6a-79686c790d25",
                                        "entry_id": "d6593782-59dd-3ca4-b3cf-52cef2e59fe5",
                                        "glosses": [
                                            "Personne embarrassée, contrainte, qui reste sur sa réserve."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99ae8425-4f99-460b-949b-a85abc444aa3",
                                                "sense_id": "a192e56b-c24c-3ccd-bd6a-79686c790d25",
                                                "text": "En septembre 2008, Siné, l’ennemi héréditaire des constipés de la pensée, était évacué de Charlie Hebdo par un rédacteur en chef déflatulé."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "constipé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
