{
    "word_family": [
        "tranquil",
        "tranquilize",
        "tranquilizer",
        "tranquilly"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bb7cb6ba-ab8b-395a-a97a-43985071e5b1",
                    "sense_definition": "The state of being calm, peaceful, and free from disturbance or stress.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She enjoyed the absolute <w>tranquillity</w> of the countryside during her morning walk. ",
                            "target_lang_translations": {
                                "zh": "晨练散步时，她享受着乡村那份绝对的<w>宁静</w>。"
                            }
                        },
                        {
                            "text": "After a busy week at work, he loved the peace and <w>tranquillity</w> of his home.",
                            "target_lang_translations": {
                                "zh": "忙碌工作了一周后，他非常喜爱家中的清幽与<w>平静</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "calm",
                        "peace"
                    ],
                    "common_phrases": [
                        "peace and tranquillity",
                        "absolute tranquillity"
                    ],
                    "target_lang_definitions": {
                        "zh": "宁静、平静，没有干扰或压力的状态。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "宁静",
                                "target_lang_sense_clarification": "环境或心境安静平和"
                            },
                            {
                                "target_lang_word": "平静",
                                "target_lang_sense_clarification": "没有动荡或打扰"
                            },
                            {
                                "target_lang_word": "恬静",
                                "target_lang_sense_clarification": "安静舒适"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "c6b5de1e-5352-30c9-b371-77d94d4d45bf",
                    "sense_definition": "A census-designated place in Fresno County, California, United States.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The small community of <w>Tranquillity</w> is located in western Fresno County. ",
                            "target_lang_translations": {
                                "zh": "<w>特兰奎利蒂</w>这个小社区位于弗雷斯诺县西部。"
                            }
                        },
                        {
                            "text": "Many agricultural workers live in <w>Tranquillity</w>, California.",
                            "target_lang_translations": {
                                "zh": "许多农业工人居住在加利福尼亚州的<w>特兰奎利蒂</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "特兰奎利蒂（美国加利福尼亚州弗雷斯诺县的一个普查规定居民点）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "特兰奎利蒂",
                                "target_lang_sense_clarification": "美国加州地名"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "66914bf3-ff08-3250-bdb6-dda089cad49b",
                    "sense_definition": "Short form of the Sea of Tranquillity, a lunar mare on Earth's Moon.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "astronomical_name",
                    "examples": [
                        {
                            "text": "Apollo 11 landed in the Sea of <w>Tranquillity</w> in 1969. ",
                            "target_lang_translations": {
                                "zh": "阿波罗11号于1969年降落在<w>静海</w>。"
                            }
                        },
                        {
                            "text": "Astronomers studied the surface features of <w>Tranquillity</w> through the telescope.",
                            "target_lang_translations": {
                                "zh": "天文学家通过望远镜研究了<w>静海</w>的表面特征。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "“静海”的简写，月球上的一个月海。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "静海",
                                "target_lang_sense_clarification": "月球月海名称"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}