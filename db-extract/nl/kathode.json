                                        "examples": [
                                            {
                                                "example_id": "4d498b0d-d22a-4ebe-bb07-c5c932248a06",
                                                "sense_id": "1e431595-ea4a-3ee2-a990-46dba6a46d3d",
                                                "text": "Bei der Elektrolyse einer (mit Wasser) verdünnten Säure entsteht an der Kathode Wasserstoff."
                                            },
                                            {
                                                "example_id": "66c4e402-bce8-47e8-824b-f9d34cda3794",
                                                "sense_id": "1e431595-ea4a-3ee2-a990-46dba6a46d3d",
                                                "text": "In einem Akkumulator, der über einen Widerstand entladen wird, fließt der Strom von der negativeren Anode zur positiveren Kathode."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "63631455-36e1-34cd-94a9-a1a8f966fd33",
                                        "entry_id": "348324c9-2098-32d5-b003-4256b1546a85",
                                        "glosses": [
                                            "Elektrode, die Elektronen in das angrenzende Medium des Bauteils abgibt"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70d4dc25-def7-4ad1-90b0-ea6025d36b5c",
                                                "sense_id": "63631455-36e1-34cd-94a9-a1a8f966fd33",
                                                "text": "In einer in Durchlassrichtung betriebenen Diode fließt der Strom von der positiveren Anode zur negativeren Kathode."
                                            }
