                "senses": [
                    {
                        "sense_id": "8430bd9e-a2cd-37f2-978b-c8907081c071",
                        "entry_id": "49f04b68-3084-3f83-89e2-2d50e0a6af32",
                        "glosses": [
                            "weibliche Person, die sich nach der Philosophie der Steinzeiternährung (Paleo-Ernährung) ernährt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5341c13-4f7e-4dd3-9e80-723988138e23",
                                "sense_id": "8430bd9e-a2cd-37f2-978b-c8907081c071",
                                "text": "„Als Mutter, CrossFitterin und Paleoanerin liebe ich gesunde Ernährung, vielfältiges Essen und sportliche Aktivität.“"
                            },
                            {
                                "example_id": "a86221f4-f0dc-4b3d-b0ed-38d0c7e174bc",
                                "sense_id": "8430bd9e-a2cd-37f2-978b-c8907081c071",
                                "text": "„Gleichzeitig legt die überzeugte »Paleoanerin« Wert darauf, dass die Paleo-Naschereien kein tägliches Grundnahrungsmittel sind, sondern ein Highlight für besondere Anlässe.“"
                            },
                            {
                                "example_id": "83c97e6c-bf89-4ce6-8a64-0e030ee3b84a",
                                "sense_id": "8430bd9e-a2cd-37f2-978b-c8907081c071",
                                "text": "Ich bin eine Paleoanerin, da ich nur Lebensmittel konsumiere, die in der Altsteinzeit zur Verfügung standen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
