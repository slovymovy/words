                        "entry_id": "8c5e6656-9ff7-33b9-8f46-4f5de047a973",
                        "glosses": [
                            "een overeenstemming die nog moet worden bekrachtigd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa1befb5-e6d7-4e1f-afb7-a3dcdb702fb6",
                                "sense_id": "2ca6233b-3f33-3361-9662-18387e7718bf",
                                "text": "De vakbonden FNV, FBZ, LAD en CNV leggen het principeakkoord volgende week voor aan hun leden."
                            },
                            {
                                "example_id": "9a0a3caf-10c5-43cf-94c5-99ce9589a432",
                                "sense_id": "2ca6233b-3f33-3361-9662-18387e7718bf",
                                "text": "In december tekenden de betrokken partijen al een principeakkoord over een terugkeer van de Formule 1 naar Nederland in 2020. Het was aan Zandvoort om aan de gestelde voorwaarden te voldoen en daar lijkt de directie in geslaagd te zijn. \"Die principe-overeenkomst zegt genoeg over wat er gaat gebeuren\", vindt Lammers."
                            }
                        ]
                    }
