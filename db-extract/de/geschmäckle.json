                "senses": [
                    {
                        "sense_id": "3874e100-439f-34f0-a23f-761fca2076a9",
                        "entry_id": "38566cb5-658d-3ceb-9f39-f5d4378ced59",
                        "glosses": [
                            "leichte Anrüchigkeit, Beigeschmack des Unkorrekten"
                        ],
                        "tags": [
                            "umgangssprachlich,",
                            "abwertend; ursprünglich süddeutsch",
                            "mittlerweile in ganz Deutschland bekannt"
                        ],
                        "examples": [
                            {
                                "example_id": "85584b06-245f-44a8-b636-8c39dc89d245",
                                "sense_id": "3874e100-439f-34f0-a23f-761fca2076a9",
                                "text": "Es ist ein besonderes Geschmäckle dabei, wenn die Angehörigen der Abgeordneten gut dotierte Posten im Landtag bekommen."
                            },
                            {
                                "example_id": "b1844c7b-24eb-4f4f-86f7-b6b6206450ae",
                                "sense_id": "3874e100-439f-34f0-a23f-761fca2076a9",
                                "text": "Es hat schon ein Geschmäckle, wenn die Tochter des Bürgermeisters plötzlich Stadtkämmerin wird."
                            },
                            {
                                "example_id": "72fd4011-9202-47f5-b675-9d1775179f1d",
                                "sense_id": "3874e100-439f-34f0-a23f-761fca2076a9",
                                "text": "Ihr Vorgehen lässt das Geschmäckle der Vetternwirtschaft aufkommen, mein Lieber."
                            },
                            {
                                "example_id": "6022f5c2-c00a-4c65-bea2-ad0d6cafa5b1",
                                "sense_id": "3874e100-439f-34f0-a23f-761fca2076a9",
                                "text": "„Für die Opposition hat die jüngste Jugendstudie ein Geschmäckle. Denn sie wurde von der Staatskanzlei in Auftrag gegeben.“"
                            },
                            {
                                "example_id": "157633f2-eebb-4fd7-b87f-0560b45b1220",
                                "sense_id": "3874e100-439f-34f0-a23f-761fca2076a9",
                                "text": "„Der Bundespräsident lädt die Verlegerin Friede Springer zu einem Ehrenessen – hat das ein Geschmäckle?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
