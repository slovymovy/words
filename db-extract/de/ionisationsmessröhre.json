                "senses": [
                    {
                        "sense_id": "e43e6e46-888d-312c-a96e-da56e332712d",
                        "entry_id": "feee62a7-fa7b-3da1-aa9c-46225bf9d7a7",
                        "glosses": [
                            "eine Elektronenröhre zur Vakuummessung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2b01ed9-8f0f-478f-b905-3dd0a4384fee",
                                "sense_id": "e43e6e46-888d-312c-a96e-da56e332712d",
                                "text": "Die Ionisationsmessröhre wurde durch Werner von Siemens ca. 1905 entwickelt und war eine reine Vakuummessröhre."
                            },
                            {
                                "example_id": "7f2d8c2b-2311-4b84-9ab3-6edb26066732",
                                "sense_id": "e43e6e46-888d-312c-a96e-da56e332712d",
                                "text": "„Schalten Sie die Ionisationsmessr̈ohre ab und belüften Sie den Kessel.“"
                            },
                            {
                                "example_id": "23df03a9-1ab5-4bae-8295-0bc31f86bc83",
                                "sense_id": "e43e6e46-888d-312c-a96e-da56e332712d",
                                "text": "„In einer Ionisationsmessröhre wird ein konstanter Strom von Elektronen aus einer Glühkathode emittiert und beschleunigt.“"
                            },
                            {
                                "example_id": "f8307799-46d2-4318-bfcc-2718a0d6e0f2",
                                "sense_id": "e43e6e46-888d-312c-a96e-da56e332712d",
                                "text": "„Um nach einem Adsorptionsexperiment die genaue Menge des angebotenen Gases bestimmen zu können, wurde während der Experimente der von der Ionisationsmessröhre angezeigte Druck aufgezeichnet.“"
                            },
                            {
                                "example_id": "518235bb-b973-4b6d-818e-44157c529724",
                                "sense_id": "e43e6e46-888d-312c-a96e-da56e332712d",
                                "text": "„Der Druck im Rezipienten wird mit einer Bayard-Alpert-Ionisationsmessröhre gemessen (Typ Varian UHV-24, Steuerung durch eine Eigenkonstruktion des Instituts für Physikalische Chemie).“"
                            },
                            {
                                "example_id": "587d93d7-bb93-42ce-be61-a110fcb9f607",
                                "sense_id": "e43e6e46-888d-312c-a96e-da56e332712d",
                                "text": "„ Die Gaslinie verf̈ugt darüber hinaus über ein MKS-Barathron 121AA (PDR-D-2 Controller) sowie eine Ionisationsmessröhre IMR325(IMG 300 Controller, Pfeiffer Vacuum).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
