                                "target_senses": [
                                    {
                                        "sense_id": "20aa14bd-e1e8-3023-a7c9-8d980055a1ca",
                                        "entry_id": "9c682058-a5bb-3697-9f66-e59f7fc4d67d",
                                        "glosses": [
                                            "Francian-dialect; of or pertaining to the dialect of the langue d'oïl which developed in Île-de-France and Orléanais."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "067d1c98-7a02-3427-983f-02082fcb171e",
                                        "entry_id": "9c682058-a5bb-3697-9f66-e59f7fc4d67d",
                                        "glosses": [
                                            "Of or pertaining to Anatole France."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d383e27b-eeb5-495c-afd8-942d11e0a784",
                                                "sense_id": "067d1c98-7a02-3427-983f-02082fcb171e",
                                                "text": "But it is to be hoped in view of [Anatole] France's qualities and influence, that something like an impartial evaluation of the man may ultimately be achieved. […] Mr. Dargan has \"checked and verified with admirable patience every item of Francian lore,\" Mr. Michaud said[…]"
                                            },
                                            {
                                                "example_id": "d3a98bb5-387e-4dbe-9047-bc4fc4cb7e90",
                                                "sense_id": "067d1c98-7a02-3427-983f-02082fcb171e",
                                                "text": "From then on, Mr. Jefferson traces [Anatole] France's gradual political involvement, and in particular his fortunes with socialism […] Because, just before the War, Francian doctrines were at odds with a rising tide of nationalism, France's literary reputation began to suffer."
                                            },
                                            {
                                                "example_id": "823ee0a0-c846-41ff-9eac-54f83f6afab9",
                                                "sense_id": "067d1c98-7a02-3427-983f-02082fcb171e",
                                                "text": "The power of the parodist was native to the Francian genius and was almost always implemented for reasons that […] finds support for its pejorative appraisal in France's lack of originality, […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Francian",
                                "target_lang_code": "en",
                                "target_senses": [
