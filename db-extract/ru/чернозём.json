                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "df4ceec7-2ac7-49e7-9803-a87db8deabee",
                        "source_entry_id": "ba41800c-1e23-37e7-b05e-5a3122180e62",
                        "source_sense_id": "89929453-b05d-3acc-af5a-ded6c6372361",
                        "target_lang_word": "czarnoziem",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "czarnoziem",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "216a389c-ff96-3c71-bb9a-0b2c0f15cb43",
                                        "entry_id": "de4fe2d7-fefb-3115-8b6a-2d019e7ac4fd",
                                        "glosses": [
                                            "bardzo żyzna gleba wykształcona na lessach"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17c83b14-880d-4840-bb8d-0fb916beff21",
                                                "sense_id": "216a389c-ff96-3c71-bb9a-0b2c0f15cb43",
                                                "text": "Czarnoziemy są silnie próchnicznymi glebami, wytworzonymi na lessach przy udziale roślinności stepowej."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "27b5b86d-a6a9-44c2-bb8b-0c9932094d8b",
                        "source_entry_id": "ba41800c-1e23-37e7-b05e-5a3122180e62",
                        "source_sense_id": "89929453-b05d-3acc-af5a-ded6c6372361",
                        "target_lang_word": "tchernoziom",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tchernoziom",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4bfffdef-cf00-3489-8371-bf2741c9101f",
                                        "entry_id": "bb83c414-ec49-31e9-9ede-917236d63ccc",
                                        "glosses": [
                                            "Sol très fertile, de couleur noire, contenant un fort pourcentage d'humus (3% à 15%), riche en potasse, phosphore et microéléments."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0d781d2-9bdf-41f4-bc12-2e34ebcdd502",
                                                "sense_id": "4bfffdef-cf00-3489-8371-bf2741c9101f",
                                                "text": "Il y a plusieurs ceintures du tchernoziom au monde, l’une va de la Roumanie à la Sibérie en passant par l’Ukraine, l’autre dans la région des Grandes Plaines, va du Montana au Mississippi."
                                            },
                                            {
                                                "example_id": "993ee7f6-18a8-4d4a-bffc-40013629aa43",
                                                "sense_id": "4bfffdef-cf00-3489-8371-bf2741c9101f",
                                                "text": "La culture de Tournesol se localise en U.R.S.S. dans la zone de tchernoziom et de steppe de la Russie d’Europe méridionale. 80 % des superficies consacrées à cette culture se trouvent en Ukraine et dans les provinces de Krasnodar, Stavropol, Rostov, Tambov, Koursk, Saratov, Stalingrad, Kouibychev et Tchkalov."
                                            },
                                            {
                                                "example_id": "ff187932-bd79-4cb0-8661-6de7d4a76b56",
                                                "sense_id": "4bfffdef-cf00-3489-8371-bf2741c9101f",
                                                "text": "Grâce à ses tchernozioms, les fameuses terres noires très grasses et extrêmement fertiles, la Russie s’était hissée, ces dernières années, au troisième rang des plus gros exportateurs mondiaux de blé, avec 18 millions de tonnes vendues à l’étranger lors de la campagne 2009-2010, derrière les États-Unis (22,9) et l’Union européenne (19,5)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
