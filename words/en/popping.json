        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1fa256e4-45d7-3839-a34d-86c849b24ece",
                    "sense_definition": "The act or sound of something making a short, explosive noise.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sound_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The loud <w>popping</w> of the fireworks scared the dog.",
                            "target_lang_translations": {
                                "ru": "Громкие <w>хлопки</w> фейерверков напугали собаку.",
                                "nl": "De harde <w>knallen</w> van het vuurwerk maakten de hond bang."
                            }
                        },
                        {
                            "text": "We heard strange <w>poppings</w> coming from the old engine.",
                            "target_lang_translations": {
                                "ru": "Мы услышали странный <w>треск</w>, доносящийся из старого двигателя.",
                                "nl": "We hoorden vreemd <w>geplof</w> uit de oude motor komen."
                            }
                        }
                    ],
                    "synonyms": [
                        "bursting",
                        "cracking"
                    ],
                    "common_phrases": [
                        "popping sound",
                        "loud popping"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие или звук, напоминающий короткий, взрывной шум.",
                        "nl": "De handeling of het geluid van iets dat een kort, explosief geluid maakt."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хлопок",
                                "target_lang_sense_clarification": "резкий звук"
                            },
                            {
                                "target_lang_word": "треск",
                                "target_lang_sense_clarification": "серия резких звуков"
                            },
                            {
                                "target_lang_word": "лопанье",
                                "target_lang_sense_clarification": "процесс разрыва"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "knal",
                                "target_lang_sense_clarification": "een plotseling, kort geluid"
                            },
                            {
                                "target_lang_word": "geplof",
                                "target_lang_sense_clarification": "een reeks korte, doffe geluiden"
                            },
                            {
                                "target_lang_word": "geknetter",
                                "target_lang_sense_clarification": "een serie korte, scherpe geluiden"
                            }
                        ]
