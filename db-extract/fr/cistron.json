                        "glosses": [
                            "Région du génome qui ne porte qu’une seule information génétique transcrite en ARN. C'est la plus petite unité fonctionnelle d'un chromosome"
                        ],
                        "tags": [
                            "Génétique"
                        ],
                        "examples": [
                            {
                                "example_id": "a8d7c418-15e1-4e57-9018-1bb04896fbf1",
                                "sense_id": "5f7f589a-50d2-3f8f-b38e-52b9ba220c57",
                                "text": "On sait aujourd’hui que l’unité génétique fonctionnelle n’est plus le classique gène mendélien, mais le cistron."
                            }
                        ]
                    }
                ],
