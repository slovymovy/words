                "senses": [
                    {
                        "sense_id": "b9f2a431-25a6-3ae1-a21b-b691a75e3400",
                        "entry_id": "fb0fbd6d-ed04-332a-a436-a0b645dca52b",
                        "glosses": [
                            "Gerät, das zur Bestimmung der Viskosität von Flüssigkeiten und Gasen dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6840679b-e4d3-4feb-8450-6a861e3fca78",
                                "sense_id": "b9f2a431-25a6-3ae1-a21b-b691a75e3400",
                                "text": "„Das Viskosimeter wird vor der Messung mit rauchender Salpetersäure gereinigt und anschließend mit Wasser gut gespült.“"
                            },
                            {
                                "example_id": "9ce24d08-b303-4187-8210-cb2c868c4b27",
                                "sense_id": "b9f2a431-25a6-3ae1-a21b-b691a75e3400",
                                "text": "„Die Viskositätsmessungen wurden mit einem Viskosimeter der Firma Schott durchgeführt.“"
                            },
                            {
                                "example_id": "9470f35a-63dc-41be-9987-bf0bb4fb34e1",
                                "sense_id": "b9f2a431-25a6-3ae1-a21b-b691a75e3400",
                                "text": "„Die mit dem Englerschen Viskosimeter bestimmte Zähigkeit wird in Englergraden E angegeben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
