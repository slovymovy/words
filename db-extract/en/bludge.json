    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "018265dc-7dc1-30d2-817b-79920dbc8916",
                "word": "bludge",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "86dd2da1-9032-3232-b40e-0dd7cc7e1e6b",
                        "entry_id": "018265dc-7dc1-30d2-817b-79920dbc8916",
                        "glosses": [
                            "The act of bludging."
                        ],
                        "tags": [
                            "Australia",
                            "New-Zealand",
                            "slang",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "9656cb8b-2c69-4dd9-9b31-43ff3324c400",
                                "sense_id": "86dd2da1-9032-3232-b40e-0dd7cc7e1e6b",
                                "text": "A friend offered him a job working as a handyman in his carpet factory – a Mr Fix-it. Effectively off the bludge and back on track."
                            }
                        ]
                    },
                    {
                        "sense_id": "ae4b5508-859c-3ec2-8771-8b2306625b7e",
                        "entry_id": "018265dc-7dc1-30d2-817b-79920dbc8916",
                        "glosses": [
                            "Easy work, especially a subject at school that requires little effort."
                        ],
                        "tags": [
                            "Australia",
                            "New-Zealand",
                            "slang",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "b9210346-1b4f-4039-875b-00e99714c461",
                                "sense_id": "ae4b5508-859c-3ec2-8771-8b2306625b7e",
                                "text": "Oh, my name is Gecko and I just thought the whole unit was a bludge, sometimes it got really boring. But like I said I could just fall asleep and let my group members do all the work. And still almost pass."
                            },
                            {
                                "example_id": "4f5e9f86-99ce-4f13-a134-a3d26e84625d",
                                "sense_id": "ae4b5508-859c-3ec2-8771-8b2306625b7e",
                                "text": "‘Seriously, you′ve got sheep at school?’ I said.\n‘Yeah, heaps of kids here do Ag. Reckon it′s a big bludge, like drama.’"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
                    {
                        "linkage_id": "141bc815-f7cb-4174-9e74-33ee1e83a08d",
                        "source_entry_id": "018265dc-7dc1-30d2-817b-79920dbc8916",
                        "source_sense_ids": [
                            "ae4b5508-859c-3ec2-8771-8b2306625b7e"
                        ],
                        "linkage_type": "synonyms",
                        "word": "doddle"
                    }
                ]
            },
