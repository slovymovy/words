                "senses": [
                    {
                        "sense_id": "899cd87d-6d93-35bc-b925-3c36ac26bf76",
                        "entry_id": "737da885-fbcd-35eb-9013-1179f51a7d63",
                        "glosses": [
                            "tausendstel Sekunde"
