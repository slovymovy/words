                    },
                    {
                        "translation_id": "ee59a40a-a5d2-45f1-9ec3-0b720f15aa22",
                        "source_entry_id": "c47b4390-82e4-302b-ab33-a067dc2ccf2b",
                        "source_sense_id": "94b2d5d4-465b-3163-8bd6-f71bf091cb1a",
                        "target_lang_word": "vermouth",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vermouth",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b3193ae0-b453-3ee8-a060-ba8328571a13",
                                        "entry_id": "bd6cf3ed-8e1c-3e5d-99bf-40b8d758acc3",
                                        "glosses": [
                                            "A dry, or sweet apéritif wine flavored with aromatic herbs, and often used in mixed drinks."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae975d19-78ea-4990-8873-bea67b5244ef",
                                                "sense_id": "b3193ae0-b453-3ee8-a060-ba8328571a13",
                                                "text": "He gazed around until on the lid of a spinet he spotted a promising collection of bottles, gin, whiskey, vermouth and sherry, mixed with violin bows, a flute, a toppling pile of books, six volumes of Grove's Dictionary mingled with paperback thrillers, a guitar without any strings, a pair of binoculars, a meerschaum pipe and a jar half-full of wasps and apricot jam."
                                            },
                                            {
                                                "example_id": "470b9690-68a5-4428-838e-09822f9641c4",
                                                "sense_id": "b3193ae0-b453-3ee8-a060-ba8328571a13",
                                                "text": "Vermouth originated in the 18th century, when wine growers in the foothills of the French and Italian Alps developed a method of enhancing the taste of sour or uncompromising wines with the infusion of a variety of sweeteners, spices, herbs, roots, seeds, flowers, and peel."
                                            },
                                            {
                                                "example_id": "a029dcdb-0a69-43eb-8cc8-4e67449acfd5",
                                                "sense_id": "b3193ae0-b453-3ee8-a060-ba8328571a13",
                                                "text": "Earlier this year while in Madrid, I fell prey to what the Spanish call la hora del vermut, the vermouth hour, a break in the day for a glass, generally before eating."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "560b140c-d562-3738-bbd7-72767912f258",
                                        "entry_id": "bd6cf3ed-8e1c-3e5d-99bf-40b8d758acc3",
                                        "glosses": [
                                            "A serving of vermouth."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1974df4f-248b-4081-ba83-13519dcbc31b",
                                                "sense_id": "560b140c-d562-3738-bbd7-72767912f258",
                                                "text": "As we sat over our vermuths he glorified the Company’s business, and by-and-by I expressed casually my surprise at him not going out there."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
