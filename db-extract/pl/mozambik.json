                                    {
                                        "sense_id": "e8d45a76-0752-3a93-8165-07aae60850a6",
                                        "entry_id": "9639d9d8-21f3-3d89-9853-9e92c757ed91",
                                        "glosses": [
                                            "A broad strait, the modern Mozambique Channel, which separates the island of Madagascar from the African mainland of Mozambique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66dd9d91-5ad1-4d86-a064-f1dbdec351f5",
                                                "sense_id": "e8d45a76-0752-3a93-8165-07aae60850a6",
                                                "text": "During our cruise in the Mozambique we had generally light winds, almost invariably from E.S.E., or calms, and smooth water, nearly the whole time."
                                            }
                                        ]
                                    }
                                ]
