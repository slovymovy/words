                        "cross_references": [
                            {
                                "target_word": "Dickian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c365a885-6f36-304f-a012-37ed203d32b9",
                                        "entry_id": "2ae5f4f6-0edf-3470-a66e-5d9301030687",
                                        "glosses": [
                                            "Of, pertaining to or resembling the works of author Philip K. Dick or the themes expressed therein."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5ec7d43-8a1d-4845-ab43-2ba5f7367144",
                                                "sense_id": "c365a885-6f36-304f-a012-37ed203d32b9",
                                                "text": "Later, Dickian characters are frequently to find themselves trapped in hallucinations or fake worlds of various kinds, often without knowing it or, if knowing it, without being able to do anything about it."
                                            },
                                            {
                                                "example_id": "2e2499d2-dad1-40e5-81b1-d81a3025aacf",
                                                "sense_id": "c365a885-6f36-304f-a012-37ed203d32b9",
                                                "text": "A case in point is the announcement last spring that a Hong Kong company, Artificial Life, Inc.—what a Dickian name!—is about to provide the lonely men of this world with a virtual girlfriend named Vivienne, who can be accessed via cellphone for a basic monthly fee of six dollars."
                                            },
                                            {
                                                "example_id": "9be95aa7-61fd-4d95-9dbc-b44c2f7760e9",
                                                "sense_id": "c365a885-6f36-304f-a012-37ed203d32b9",
                                                "text": "Maybe the screenwriters thought the original stories were too hard to tell in movie form, but I suspect a clash between the Dickian worldview and the Holly-worldview is the real culprit. The Dickian worldview wouldn't work in a Hollywood movie (meaning less box office revenue). […] People don't like their belief in free will questioned."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
