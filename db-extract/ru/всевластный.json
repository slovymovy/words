                "senses": [
                    {
                        "sense_id": "5656fc9f-21a0-37b4-b5f3-cc6b11b1e882",
                        "entry_id": "b5019f45-8e29-3f1f-bb5a-507138d7100e",
                        "glosses": [
                            "обладающий неограниченной властью; всесильный, могущественный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "620814af-bf5a-4d03-b0bf-276d2f044059",
                                "sense_id": "5656fc9f-21a0-37b4-b5f3-cc6b11b1e882",
                                "text": "Он сидел против нее спокойный, всевластный, непреклонный."
                            },
                            {
                                "example_id": "d179848c-9955-4aec-89b8-a05534c53970",
                                "sense_id": "5656fc9f-21a0-37b4-b5f3-cc6b11b1e882",
                                "text": "Земля ― широкая могила, // Где спор за место каждый час, // Пока всевластной смерти сила // Усопшим поровну не даст."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
