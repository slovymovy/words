    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "55ed1728-3de4-3d38-88fa-acae11f09f7b",
                    "sense_definition": "Plaire vivement à quelqu'un, séduire par son attrait ou ses qualités.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce talentueux musicien a su <w>charmer</w> le public dès les premières notes du concert."
                        },
                        {
                            "text": "Par son élégance naturelle et sa grande gentillesse, elle <w>charme</w> tous ceux qu'elle rencontre."
                        }
                    ],
                    "synonyms": [
                        "séduire",
                        "ravir",
                        "enchanter"
                    ],
                    "antonyms": [
                        "déplaire",
                        "repousser"
                    ],
                    "common_phrases": [
                        "charmer le public",
                        "savoir charmer"
                    ]
                },
                {
                    "sense_id": "3912a043-c3c6-32ab-9662-b3ba764b162d",
                    "sense_definition": "Adoucir une peine, dissiper l'ennui ou rendre le temps plus agréable.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La lecture et la musique permettent souvent de <w>charmer</w> l'ennui des longues soirées d'hiver."
                        },
                        {
                            "text": "Cette promenade au bord de l'eau a suffi pour <w>charmer</w> la tristesse de son ami."
                        }
                    ],
                    "synonyms": [
                        "adoucir",
                        "apaiser",
                        "dissiper"
                    ],
                    "common_phrases": [
                        "charmer l'ennui",
                        "charmer la solitude"
                    ]
                },
                {
                    "sense_id": "b13677d6-c0ca-3428-9481-89cf8e3d0033",
                    "sense_definition": "Opérer un effet extraordinaire sur quelqu'un ou quelque chose par un pouvoir magique ou un sortilège.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans ce vieux conte, le magicien <w>charmait</w> les bêtes féroces pour traverser la forêt sans danger."
                        },
                        {
                            "text": "La sorcière tenta de <w>charmer</w> le prince afin de lui faire oublier son royaume natal."
                        }
                    ],
                    "synonyms": [
                        "ensorceler",
                        "envoûter"
                    ],
                    "antonyms": [
                        "désensorceler"
                    ],
                    "common_phrases": [
                        "charmer les serpents"
                    ]
                },
                {
                    "sense_id": "7f1119a2-3e48-3508-bbfc-6629d44f0c46",
                    "sense_definition": "Fasciner ou immobiliser une proie par le regard ou une attitude hypnotique.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "On raconte que certains serpents peuvent <w>charmer</w> les petits oiseaux avant de les attaquer."
                        },
                        {
                            "text": "Le prédateur semblait <w>charmer</w> sa proie immobile au lieu de se précipiter directement sur elle."
                        }
                    ],
                    "synonyms": [
                        "fasciner",
                        "hypnotiser",
                        "méduser"
                    ]
                }
            ]
        }
    ]
