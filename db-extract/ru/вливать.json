                "senses": [
                    {
                        "sense_id": "6d97eb8b-6f52-361c-8da0-e2176b9d554c",
                        "entry_id": "9da31824-8311-36a8-81f1-903084093759",
                        "glosses": [
                            "to pour"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "091ec13e-723b-41ca-be4e-9fba79b9020d",
                                "sense_id": "6d97eb8b-6f52-361c-8da0-e2176b9d554c",
                                "text": "Никто не вливает вина молодого в мехи ветхие: иначе молодое вино прорвет мехи, и вино вытечет, и мехи пропадут; но вино молодое надобно вливать в мехи новые.",
                                "translation": "And no one pours new wine into old wineskins. Otherwise, the wine will burst the skins, and both the wine and the wineskins will be ruined. No, they pour new wine into new wineskins.”",
                                "english": "And no one pours new wine into old wineskins. Otherwise, the wine will burst the skins, and both the wine and the wineskins will be ruined. No, they pour new wine into new wineskins.”"
                            },
                            {
                                "example_id": "6c029f91-876f-4317-a2d2-55e15c633dc5",
                                "sense_id": "6d97eb8b-6f52-361c-8da0-e2176b9d554c",
                                "text": "влива́ть во́ду в бо́чку",
                                "translation": "to pour water into a barrel",
                                "english": "to pour water into a barrel"
                            },
                            {
                                "example_id": "0f924ee3-d944-4afd-ab1a-ec21c0b65908",
                                "sense_id": "6d97eb8b-6f52-361c-8da0-e2176b9d554c",
                                "text": "влива́ть по ка́пле",
                                "translation": "to instill (put in) by drops; put in drop by drop",
                                "english": "to instill (put in) by drops; put in drop by drop"
                            }
                        ]
                    },
                    {
                        "sense_id": "535cc515-4789-3416-9162-f9f82e649b9a",
                        "entry_id": "9da31824-8311-36a8-81f1-903084093759",
                        "glosses": [
                            "to instill"
                        ],
                        "tags": [
                            "figuratively"
                        ],
