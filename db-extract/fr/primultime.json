                "senses": [
                    {
                        "sense_id": "ffddbf34-d72c-3ebe-bdfc-7ac1837f5ebe",
                        "entry_id": "68215c93-265a-3b16-8f83-b682e2fd0370",
                        "glosses": [
                            "Qui arrive pour la première et la dernière fois, qui n’arrive qu’une fois."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3338d09d-cdf1-48b8-ac36-fbd134dbe03a",
                                "sense_id": "ffddbf34-d72c-3ebe-bdfc-7ac1837f5ebe",
                                "text": "La naissance et la mort sont primultimes."
                            },
                            {
                                "example_id": "6049f61e-bb67-475f-8113-984fea766071",
                                "sense_id": "ffddbf34-d72c-3ebe-bdfc-7ac1837f5ebe",
                                "text": "Cette apparition-disparition, on la dira primultime, adjectif coquet et dramatique inventé par Jankélévitch : toute chose arrive pour la première et la dernière fois (Jankélévitch, 1974 : 46)."
                            },
                            {
                                "example_id": "91ba4b17-36b1-42c1-88c4-53d057b8dc6f",
                                "sense_id": "ffddbf34-d72c-3ebe-bdfc-7ac1837f5ebe",
                                "text": "Cette irréversibilité fait de chaque instant de notre existence une occasion unique, tout à la fois première et dernière. Jankélévitch ne cesse de revenir sur ce paradoxe de l’instant, sur sa fulgurance, sa « primultimité » : « Chaque “fois” est à la fois première et dernière, et pour cette raison nous la disons primultime »."
                            }
                        ]
                    }
                ],
