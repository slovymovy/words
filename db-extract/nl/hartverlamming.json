                "senses": [
                    {
                        "sense_id": "c69dbe94-f40e-322a-8514-eb61be933f70",
                        "entry_id": "d0b8cd01-78b2-3650-bceb-bd615449b147",
                        "glosses": [
                            "het plotseling niet meer samentrekken van het hart zodat er een circulatiestilstand ontstaat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80f64f2a-bbcb-41d4-8e97-a9485919e974",
                                "sense_id": "c69dbe94-f40e-322a-8514-eb61be933f70",
                                "text": "„Zo’n 30 jaar geleden viel er een man voor mij neer op straat. Hij had een hartverlamming. Ik had geen idee wat ik moest doen en kon het slachtoffer niet helpen. Na dat moment ben ik cursussen gaan volgen. Nooit wilde ik meer zo hulpeloos toekijken.”"
                            },
                            {
                                "example_id": "c8c5becd-ccaa-4fc4-86e3-7b92d8473314",
                                "sense_id": "c69dbe94-f40e-322a-8514-eb61be933f70",
                                "text": "Als de bedrijven niet voor 20 mei op de eis ingaan, dreigen de afpersers hun voedingswaren te vergiftigen met oleandrin, een giftige stof die hartverlamming kan veroorzaken."
                            }
                        ]
                    },
                    {
                        "sense_id": "ed6ecf00-d78c-3681-b4fa-1a49fe041c93",
                        "entry_id": "d0b8cd01-78b2-3650-bceb-bd615449b147",
                        "glosses": [
                            "een plotseling optredende heftige schrik"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "791cd199-5266-4f8d-919b-0a5a754a44a8",
                                "sense_id": "ed6ecf00-d78c-3681-b4fa-1a49fe041c93",
                                "text": ",,Ze belden bij ons aan, om twee uur 's nachts. Mijn vrouw hoorde het, ze heeft haar kamerjas aangedaan en is gaan kijken. Ze kreeg bijna een hartverlamming. Ze waren al die tijd in Frankrijk aan het rondrijden. Ze sliepen soms bij boeren. Op het laatst zijn ze nog overvallen. Toen was het geld op en zijn ze teruggekomen.\""
                            }
                        ]
                    }
