                ],
                "senses": [
                    {
                        "sense_id": "9863c224-4c78-3c78-a7b0-eecf6ddf46e7",
                        "entry_id": "e75318b8-f207-385b-ad4a-0f192d93033a",
                        "glosses": [
                            "Person, die das Fliegen des Menschen und das Flugwesen in seinen Anfängen bahnbrechend entwickelt und gefördert hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0447885-18d4-49ab-b44f-1004463a7548",
                                "sense_id": "9863c224-4c78-3c78-a7b0-eecf6ddf46e7",
                                "text": "„Dieses den jungen Goethe ergreifende Verlangen, sich in den unendlichen Luftraum zu stürzen und über den schauerlichen Abgründen zu schweben, frei zu werden wie der Adler im Äther, beflügelt und bewegt auch die heutigen Delta- und Gleitschirmpiloten, die dank des opferbereiten Wagemuts Lilienthals und anderer Flugpioniere diesen Traum heute zu realisieren vermögen.“"
                            },
                            {
                                "example_id": "f37f08a3-384a-488a-b5ea-f90b7a73ad9d",
                                "sense_id": "9863c224-4c78-3c78-a7b0-eecf6ddf46e7",
                                "text": "„Vor 120 Jahren kam der Flugpionier und Ingenieur Otto Lilienthal (1848-1896) bei einem Flugversuch mit seinem Normalsegelapparat ums Leben.“"
                            },
                            {
                                "example_id": "dbbeaab4-f1d4-4d0a-82c6-565d4d2d6509",
                                "sense_id": "9863c224-4c78-3c78-a7b0-eecf6ddf46e7",
                                "text": "„An die 2 000 Gleitflüge hatte der Flugpionier erfolgreich absolviert, als er am 9. August 1896 am Gollenberg abstürzte und dabei ums Leben kam.“"
                            },
                            {
                                "example_id": "5a50bd6d-f040-4a60-836d-8d7b44e48333",
                                "sense_id": "9863c224-4c78-3c78-a7b0-eecf6ddf46e7",
                                "text": "„Flugpionier Erich Henneberger, dessen Vorfahren aus Randersacker stammten, nahm ein tragisches Ende in der früheren Kolonie Deutsch-Ostafrika. Er starb beim Absturz des Flugzeuges am 15. November 1914, […].“"
                            },
                            {
                                "example_id": "b560e235-d3cf-4800-be44-410e03c6a0a7",
                                "sense_id": "9863c224-4c78-3c78-a7b0-eecf6ddf46e7",
                                "text": "„Im Gleitschirm kommt der Flugbegeisterte dem ursprünglichen Flugerlebnis der Flugpioniere am nächsten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
