    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1054a63a-e399-3d86-be9f-0408d05f27b7",
                    "sense_definition": "Having a twisted, spiral, or wavy shape.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She has beautiful <w>curled</w> hair that falls over her shoulders.",
                            "target_lang_translations": {
                                "ru": "У неё красивые <w>завитые</w> волосы, которые спадают на плечи."
                            }
                        },
                        {
                            "text": "The <w>curled</w> leaves of the plant looked dry in the summer heat.",
                            "target_lang_translations": {
                                "ru": "<w>Скрученные</w> листья растения выглядели сухими в летнюю жару."
                            }
                        }
                    ],
                    "synonyms": [
                        "curly",
                        "wavy",
                        "coiled"
                    ],
                    "antonyms": [
                        "straight"
                    ],
                    "common_phrases": [
                        "curled hair",
                        "curled leaves"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий закрученную, спиралевидную или волнистую форму."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "завитой",
                                "target_lang_sense_clarification": "о волосах или предметах, имеющих форму локонов"
                            },
                            {
                                "target_lang_word": "скрученный",
                                "target_lang_sense_clarification": "о предметах, свернутых в спираль или трубочку"
                            },
                            {
                                "target_lang_word": "кудрявый",
                                "target_lang_sense_clarification": "о волосах, имеющих естественную волнистую форму"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "09555139-03a9-3d72-b3b4-b06d2a0a5802",
                    "sense_definition": "Simple past and past participle of <w>curl</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cat <w>curled</w> up on the sofa and fell fast asleep.",
                            "target_lang_translations": {
                                "ru": "Кошка <w>свернулась</w> калачиком на диване и крепко уснула."
                            }
                        },
                        {
                            "text": "He <w>curled</w> his fingers around the handle of the heavy mug.",
                            "target_lang_translations": {
                                "ru": "Он <w>обхватил</w> пальцами ручку тяжелой кружки."
                            }
                        }
                    ],
                    "common_phrases": [
                        "curled up"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Grammatical form of the verb curl."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени глагола «завивать» или «сворачиваться»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "завил",
                                "target_lang_sense_clarification": "сделал что-то кудрявым или спиралевидным"
                            },
                            {
                                "target_lang_word": "свернулся",
                                "target_lang_sense_clarification": "принял форму клубка или спирали"
                            }
                        ]
                    }
                }
            ]
        }
    ]
