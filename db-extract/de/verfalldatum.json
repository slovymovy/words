                ],
                "senses": [
                    {
                        "sense_id": "398ec0be-23fe-3b32-8546-f3647117d2f0",
                        "entry_id": "afc24ec8-a78f-3036-8050-db065eb048a8",
                        "glosses": [
                            "Zeitpunkt, ab dem ein Lebensmittel, Arzneimittel oder Ähnliches nicht mehr verwendet werden soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ea1746c-d071-4b4f-9248-0a38617d9a9b",
                                "sense_id": "398ec0be-23fe-3b32-8546-f3647117d2f0",
                                "text": "„Die über Jahrtausende entwickelte starke emotionale Bindung kennt offensichtlich kein Verfalldatum.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "91400eef-b0d2-3fde-9b7a-050c99255641",
                        "entry_id": "afc24ec8-a78f-3036-8050-db065eb048a8",
                        "glosses": [
                            "Zeitpunkt, an dem etwas verfällt, an dem die Gültigkeits-, Lagerungs- oder Verwendungsfrist von etwas abläuft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80e0df3c-a378-4d7e-9013-952421f11d50",
                                "sense_id": "91400eef-b0d2-3fde-9b7a-050c99255641",
                                "text": "„Datenschutz können wir nicht mehr dem Staat überlassen, sagt Harvard-Professor Mayer-Schönberger. Deshalb fordert er ein Verfalldatum für gespeicherte Informationen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "069020ec-0bf5-35d0-85ab-dfcc900718b4",
                        "entry_id": "afc24ec8-a78f-3036-8050-db065eb048a8",
                        "glosses": [
                            "Fälligkeitstermin eines Wechsels, Optionsscheins oder Ähnlichem"
                        ],
                        "tags": [
                            "Bankwesen"
                        ],
                        "examples": [
                            {
                                "example_id": "3bfcd2c0-e6be-41ff-a152-da5259b8023b",
                                "sense_id": "069020ec-0bf5-35d0-85ab-dfcc900718b4",
                                "text": "„In der Vergangenheit sind Besitzer von Optionsscheinen, die sich mit der komplizierten Materie nicht befaßt haben und auch von ihren Banken nicht rechtzeitig genug vorgewarnt wurden, den Verfalldaten zum Opfer gefallen.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
