                "senses": [
                    {
                        "sense_id": "23e1b22f-ccda-32b4-ac75-dc8fee56d903",
                        "entry_id": "76ce11e3-1c51-3f8f-a715-81f289e16adf",
                        "glosses": [
                            "Hervorhebung einer Silbe im Wort durch Betonung (Dauer, Lautstärke oder Tonhöhe)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3004145c-04a7-4501-9327-e1bcb5e40abb",
                                "sense_id": "23e1b22f-ccda-32b4-ac75-dc8fee56d903",
                                "text": "„Aber noch in einer anderen, unmittelbareren Weise stellt sich die Einheit des Wortes lautlich dar: durch den Wortton oder Wortakzent.“"
                            },
                            {
                                "example_id": "8b141bfa-b2a9-4d08-a39a-c923c8d0e75f",
                                "sense_id": "23e1b22f-ccda-32b4-ac75-dc8fee56d903",
                                "text": "„Soweit die Vokale der Vorsilben vor dem Wortakzent stehen, unterliegen sie bereits in althochdeutscher Zeit der Reduzierung.“"
                            },
                            {
                                "example_id": "3b6b3bba-c8b4-475f-903b-1cf6a066ccf9",
                                "sense_id": "23e1b22f-ccda-32b4-ac75-dc8fee56d903",
                                "text": "„Die einzelnen Morpheme mit ihren festen Wortakzenten können also frei beweglich, zusätzlich einen Satzakzent erhalten.“"
                            },
                            {
                                "example_id": "1dd6bf26-070b-47f8-9681-361e6b170887",
                                "sense_id": "23e1b22f-ccda-32b4-ac75-dc8fee56d903",
                                "text": "„Auch der Metrikwitz entspringt der absichtlich falschen Betonung, der Diskrepanz von Wortakzent und metrischem Akzent.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
