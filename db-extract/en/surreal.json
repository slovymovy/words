                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6fb34984-8ecf-39af-9ba2-083b0f230a40",
                                        "entry_id": "bbf9c670-a485-3d29-b571-620a9602029b",
                                        "glosses": [
