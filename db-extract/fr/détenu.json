                ],
                "senses": [
                    {
                        "sense_id": "bc77b17c-731f-3483-8404-883823bbd6c5",
                        "entry_id": "9fcb6930-bbf6-3a97-a1ad-50f30c7c8433",
                        "glosses": [
                            "Personne en détention, emprisonnée."
                        ],
                        "tags": [
                            "Prison"
                        ],
                        "examples": [
                            {
                                "example_id": "0d1c73bd-9ac3-4947-bd06-f3ca758a1837",
                                "sense_id": "bc77b17c-731f-3483-8404-883823bbd6c5",
                                "text": "— Et elle m’a traité comme un chien, pis que cela, comme un laquais ; je dirai mieux : comme un détenu politique."
                            },
                            {
                                "example_id": "5ec502fb-3e21-43e1-858a-94c554a9d80d",
                                "sense_id": "bc77b17c-731f-3483-8404-883823bbd6c5",
                                "text": "Pas un détenu qui ne se retourne le soir sur sa paillasse à l'idée que l'aube peut être sinistre, qui ne s'endort sans souhaiter qu'il ne se passe rien."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "331a46cc-62fd-49a9-af76-e310f8c675e3",
                        "source_entry_id": "9fcb6930-bbf6-3a97-a1ad-50f30c7c8433",
                        "source_sense_id": "bc77b17c-731f-3483-8404-883823bbd6c5",
                        "target_lang_word": "Sträfling",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sträfling",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b8e90900-e166-3f20-ad97-82c4cad9b1ca",
                                        "entry_id": "49e5de8f-2c78-30b1-ac77-d08531a39ef5",
                                        "glosses": [
                                            "in einem Gefängnis seine Straftat absitzender Straftäter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6208e50-2c9b-4b2a-a8f1-f77eda2f6058",
                                                "sense_id": "b8e90900-e166-3f20-ad97-82c4cad9b1ca",
                                                "text": "Der Sträfling sitzt im Gefängnis."
                                            },
                                            {
                                                "example_id": "5967a966-3973-43a4-a42c-acef28c51765",
                                                "sense_id": "b8e90900-e166-3f20-ad97-82c4cad9b1ca",
                                                "text": "„Die Habseligkeiten der Sträflinge mussten zwischen den Beinen auf dem Boden gestapelt werden.“"
                                            },
                                            {
                                                "example_id": "49248edc-3f08-4a2d-a980-901ea04a439a",
                                                "sense_id": "b8e90900-e166-3f20-ad97-82c4cad9b1ca",
                                                "text": "„Im Dezember 1788 lebten einhunderteinundfünfzig weibliche Sträflinge in den drei Frauenzellen des Gefängnisses Newgate, das eigentlich nur für höchstens siebzig Insassen gebaut war.“"
                                            },
                                            {
                                                "example_id": "4a784d3e-4e5e-4946-b1ea-d2afd186669d",
                                                "sense_id": "b8e90900-e166-3f20-ad97-82c4cad9b1ca",
                                                "text": "„Dazu muss man wissen, dass den Sträflingen in Australien jede Woche der Kopf geschoren wird und sie weder Bart noch Schnurrbart tragen dürfen.“"
                                            },
                                            {
                                                "example_id": "c5e06697-3870-4506-afe8-0d534436364a",
                                                "sense_id": "b8e90900-e166-3f20-ad97-82c4cad9b1ca",
                                                "text": "„Ein Fremder hatte sich neben den entlassenen Sträfling gestellt, sah ihm zu.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
