                        ],
                        "examples": [
                            {
                                "example_id": "fffee77a-157f-46e5-8c0c-9350f175cf0d",
                                "sense_id": "404b8bd0-a80d-3640-b2bf-c788c3297913",
                                "text": "Au milieu des cosplayeurs en costume de Pokémon, de Dragon Ball ou de Naruto, Florian Philippot s’est glissé dans les allées du Parc des expositions de Villepinte."
                            },
                            {
                                "example_id": "2a28026e-5455-49ac-82f8-1bddf7c91ec1",
                                "sense_id": "404b8bd0-a80d-3640-b2bf-c788c3297913",
                                "text": "« Cette dernière option est plus souvent utilisée par les cosplayeurs débutants ou simplement timides » explique l’organisateur."
                            },
                            {
                                "example_id": "ef8a238a-d30d-45f2-aaf2-4c189e7d9776",
                                "sense_id": "404b8bd0-a80d-3640-b2bf-c788c3297913",
                                "text": "Lors des séances photo, les cosplayeurs doivent faire vivre leur héros, s’approprier ses gestes, ses sentiments, sa personnalité."
                            }
                        ]
                    }
