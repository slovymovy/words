                    "semantic_group_id": "wzrok",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W oddali majaczył <w>mglisty</w> zarys wysokich gór.",
                            "target_lang_translations": {
                                "en": "In the distance loomed the <w>hazy</w> outline of tall mountains.",
                                "ru": "Вдали маячили <w>туманные</w> очертания высоких гор.",
                                "nl": "In de verte doemden de <w>wazige</w> contouren van hoge bergen op.",
                                "de": "In der Ferne zeichneten sich die <w>verschwommenen</w> Umrisse der hohen Berge ab.",
                                "fr": "Au loin se dessinait la silhouette <w>indistincte</w> des hautes montagnes.",
                                "it": "In lontananza si profilava il profilo <w>indistinto</w> di alte montagne.",
                                "cs": "V dálce se rýsoval <w>mlhavý</w> obrys vysokých hor.",
                                "tr": "Uzayda yüksek dağların <w>bulanık</w> silüeti belirmekteydi.",
                                "es": "A lo lejos se vislumbraba la silueta <w>borrosa</w> de las altas montañas.",
                                "zh": "远方隐约显露出高山<w>朦胧的</w>轮廓。"
                            }
                        },
                        {
                            "text": "Widziałem tylko <w>mglisty</w> kształt postaci stojącej w ciemności.",
                            "target_lang_translations": {
                                "en": "I could only see the <w>misty</w> shape of a figure standing in the dark.",
                                "ru": "Я видел лишь <w>расплывчатый</w> силуэт стоящего в темноте человека.",
                                "nl": "Ik zag alleen een <w>vage</w> gestalte van een figuur die in het donker stond.",
                                "de": "Ich sah nur die <w>schemenhafte</w> Gestalt einer Figur, die in der Dunkelheit stand.",
                                "fr": "Je ne voyais que la forme <w>floue</w> d'une silhouette debout dans l'obscurité.",
                                "it": "Vedevo soltanto la sagoma <w>sfocata</w> di una figura in piedi nel buio.",
                                "cs": "Viděl jsem jen <w>mlhavý</w> tvar postavy stojící ve tmě.",
                                "tr": "Karanlıkta duran figürün sadece <w>silik</w> bir şeklini görebiliyordum.",
                                "es": "Solo vi la figura <w>imprecisa</w> de un personaje de pie en la oscuridad.",
                                "zh": "我只看到黑暗中站着的人影那<w>模糊不清的</w>外形。"
                            }
                        }
