                ],
                "translations": [
                    {
                        "translation_id": "678f43b5-8c28-4283-b971-1372dd62dd77",
                        "source_entry_id": "5ea70595-6220-360b-b84b-a644a534b525",
                        "source_sense_id": "3a76ea13-c457-32e9-991d-63cf6feafd0d",
                        "target_lang_word": "drainage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "drainage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "12cadd84-2310-303b-8615-b283526f8f56",
                                        "entry_id": "8c873e0d-01f6-3ae2-92d7-e1ffc1529ff9",
                                        "glosses": [
                                            "A natural or artificial means for the removal of fluids from a given area by its draining away."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4f677bd-6796-4fcf-b1d6-3d7843e0accb",
                                                "sense_id": "12cadd84-2310-303b-8615-b283526f8f56",
                                                "text": "It should move NR away from previous examples of repairs that have treated the symptoms (fixing the landslip) but not fixed the underlying cause (poor drainage), with the result that a second slip followed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89583c24-9dab-30d1-8d1d-7ff36c3d5ef4",
                                        "entry_id": "8c873e0d-01f6-3ae2-92d7-e1ffc1529ff9",
                                        "glosses": [
                                            "A system of drains."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6f9c99cb-bd03-3d5b-808c-099be30fb7d8",
                                        "entry_id": "8c873e0d-01f6-3ae2-92d7-e1ffc1529ff9",
                                        "glosses": [
                                            "A downward wind."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44ebc4d8-22f6-404d-81a0-a624ab2dda2e",
                                                "sense_id": "6f9c99cb-bd03-3d5b-808c-099be30fb7d8",
                                                "text": "In the forward part of the cyclone, drainage katabasis is checked; but its highest intensity is observed in the rear part of the cyclone."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a4745cdf-2540-479d-93c4-8135a5266f0b",
                        "source_entry_id": "5ea70595-6220-360b-b84b-a644a534b525",
                        "source_sense_id": "3a76ea13-c457-32e9-991d-63cf6feafd0d",
                        "target_lang_word": "Entwässerung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Entwässerung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d5bdbb2c-3f5a-3fae-b656-19fb7b35e78f",
                                        "entry_id": "9a6dcc3b-aac3-3133-b01a-61f1e156dec2",
                                        "glosses": [
                                            "das Entwässern; Verringerung oder Befreiung von zu viel Wasser"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1d44f38-de6e-47c6-a775-c105341a26f0",
                                                "sense_id": "d5bdbb2c-3f5a-3fae-b656-19fb7b35e78f",
                                                "text": "Durch Entwässerung sind viele Moore verloren gegangen."
                                            },
                                            {
                                                "example_id": "c33fb6bc-9f79-4ef4-9c87-ec5278039a0c",
                                                "sense_id": "d5bdbb2c-3f5a-3fae-b656-19fb7b35e78f",
                                                "text": "„Seit den 1460er Jahren hatte man nicht nur abgesoffene Bergwerke durch Entwässerung wieder in Betrieb genommen, sondern auch in rascher Folge neue Silberadern entdeckt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b7d88ca6-9dfd-4fa0-af5a-046388dff086",
                        "source_entry_id": "5ea70595-6220-360b-b84b-a644a534b525",
                        "source_sense_id": "3a76ea13-c457-32e9-991d-63cf6feafd0d",
                        "target_lang_word": "Drainage",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Drainage",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f59ad0f4-aa74-3bb1-aab3-42c0f7640875",
                                        "entry_id": "ad9ee772-8ce2-3c0a-9f6b-ccae16c1cd1f",
                                        "glosses": [
                                            "eine Art von Entwässerungskanal im Boden, der beispielsweise um Gebäude verlegt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5720b232-fa97-4bf5-8be5-b9a92fa77f2b",
                                                "sense_id": "f59ad0f4-aa74-3bb1-aab3-42c0f7640875",
                                                "text": "Wir müssen vor dem Haus noch eine Drainage verlegen."
                                            },
                                            {
                                                "example_id": "db4f6ea3-30ac-44be-987a-66f9ad7e7d7a",
                                                "sense_id": "f59ad0f4-aa74-3bb1-aab3-42c0f7640875",
                                                "text": "„Bei uns in Russland geht man auf eine Tiefe bis 60 Zentimeter, aber in Ostpreußen liegt die Drainage bei 40 Zentimeter Tiefe.“"
                                            },
                                            {
                                                "example_id": "0089fee1-821e-4b81-b31c-cd8b887a900a",
                                                "sense_id": "f59ad0f4-aa74-3bb1-aab3-42c0f7640875",
                                                "text": "„Das Frankfurter Waldstadion hatte keine gute Drainage.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "db350789-e36b-3c70-bb04-5f93ef400db6",
                                        "entry_id": "ad9ee772-8ce2-3c0a-9f6b-ccae16c1cd1f",
                                        "glosses": [
                                            "Ableitung von Flüssigkeiten aus Körperhöhlen mittels eingelegter Röhrchen oder Laschen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9159a7e8-1369-4eb9-96d3-d0d051c333f2",
                                                "sense_id": "db350789-e36b-3c70-bb04-5f93ef400db6",
                                                "text": "„Unter Drainage versteht man Ableitungssysteme, die der Ableitung von Wundflüssigkeit, Blut oder Eiter aus Körper-, Wund- oder Eiterhöhlen dienen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
