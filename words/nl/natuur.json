                {
                    "sense_id": "90284a40-8de0-3971-9988-8be56580c174",
                    "sense_definition": "De aangeboren eigenschappen of het karakter van een persoon, dier of ding.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het ligt in haar <w>natuur</w> om altijd eerlijk te zijn.",
                            "target_lang_translations": {
                                "en": "It is in her <w>nature</w> to always be honest.",
                                "ru": "Быть всегда честной — в её <w>натуре</w>.",
                                "pl": "To leży w jej <w>naturze</w>, aby zawsze być szczerą.",
                                "de": "Es liegt in ihrer <w>Natur</w>, immer ehrlich zu sein.",
                                "fr": "Il est dans sa <w>nature</w> d'être toujours honnête.",
                                "it": "È nella sua <w>natura</w> essere sempre onesta.",
                                "cs": "Je v její <w>povaze</w> být vždy upřímná.",
                                "tr": "Her zaman dürüst olmak onun <w>doğasında</w> var.",
                                "es": "Está en su <w>naturaleza</w> ser siempre honesta."
                            }
                        },
                        {
                            "text": "Dat is nu eenmaal zijn <w>natuur</w>.",
                            "target_lang_translations": {
                                "en": "That is simply his <w>nature</w>.",
                                "ru": "Такова уж его <w>натура</w>.",
                                "pl": "Taka już po prostu jego <w>natura</w>.",
                                "de": "Das ist nun einmal seine <w>Natur</w>.",
                                "fr": "C'est tout simplement sa <w>nature</w>.",
                                "it": "Questa è semplicemente la sua <w>natura</w>.",
                                "cs": "To už je prostě jeho <w>přirozenost</w>.",
                                "tr": "Onun <w>yaradılışı</w> böyle.",
                                "es": "Esa es simplemente su <w>naturaleza</w>."
                            }
                        }
                    ],
