                                    {
                                        "sense_id": "86c6a3f4-3bcf-3c71-b515-d7f2b98cf79b",
                                        "entry_id": "e61b26bf-5b84-342f-9469-1aa2984c91fc",
                                        "glosses": [
                                            "een cirkelvormige krans gemaakt van in elkaar hakende takken en bladeren, oorspronkelijk van de laurier"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78342316-7262-450b-a72e-0189a42eacfc",
                                                "sense_id": "86c6a3f4-3bcf-3c71-b515-d7f2b98cf79b",
                                                "text": "De lauwerkrans werd in de oudheid verleend aan een zegevierende veldheer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d234e5e2-3897-465b-b70d-223914e0244f",
                        "source_entry_id": "3e9b8668-b4e8-3e5a-b759-18fa310211ec",
                        "source_sense_id": "512b37e8-afd2-3d03-9ad2-9456cd749433",
