                                ]
                            },
                            {
                                "target_word": "orderly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a43ea2e0-1403-37a8-96bb-1fe09d2a593b",
                                        "entry_id": "644f3e6c-1514-30d8-b1c2-3c25da768b6a",
                                        "glosses": [
                                            "According to good order or practice; appropriately, in a well-behaved or orderly (adjective) way."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "141483b2-000e-4f05-a128-5647b8a8d7b5",
                                                "sense_id": "a43ea2e0-1403-37a8-96bb-1fe09d2a593b",
                                                "text": "You are blunt; go to it orderly."
                                            },
                                            {
                                                "example_id": "9c316b91-83a2-4882-9af3-1a3b64c1b407",
                                                "sense_id": "a43ea2e0-1403-37a8-96bb-1fe09d2a593b",
                                                "text": "Phase R: the rods are linked three by three and form planar twodimensional hexagonal networks. In both cases, the networks are orderly stacked in a three-dimensional lattice."
                                            },
                                            {
                                                "example_id": "38c4aa7c-9df6-4ede-a0c0-d812775b1ea5",
                                                "sense_id": "a43ea2e0-1403-37a8-96bb-1fe09d2a593b",
                                                "text": "The rectangles are orderly stacked with the topmost rectangle representing the most visible entity and subsequent rectangles representing entities underneath the mouse cursor, front to back."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e9680f6-ec9f-322a-83a0-4289b066fd50",
                                        "entry_id": "644f3e6c-1514-30d8-b1c2-3c25da768b6a",
                                        "glosses": [
                                            "In order; in a particular order or succession; with a suitable arrangement."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d80953da-f5be-4a54-96a5-9b621fe9ea0e",
                                                "sense_id": "9e9680f6-ec9f-322a-83a0-4289b066fd50",
                                                "text": "The earth from heaven, the sea from earth, he parted orderly, / And from the thicke and foggie ayre, he tooke the lightsome skie."
                                            },
                                            {
                                                "example_id": "3d1baa6d-42ba-4e0f-b75e-af19bfe121f6",
                                                "sense_id": "9e9680f6-ec9f-322a-83a0-4289b066fd50",
                                                "text": "Thus orderly marshaled, they take their course and swim whither their journey tends, as broad and wide behind as before[…]."
                                            },
                                            {
                                                "example_id": "4f571e17-8e7f-432f-913a-c7e52cf1bb93",
                                                "sense_id": "9e9680f6-ec9f-322a-83a0-4289b066fd50",
                                                "text": "And in the Tombe which is an arch made of mats, they lay them orderly."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
