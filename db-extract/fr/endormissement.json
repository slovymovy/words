                "entry_id": "25dfdb50-8c0a-3c3c-a142-6b897c589ee0",
                "word": "endormissement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "bff8db59-8d2e-4197-b6d4-4e4c928b51bf",
                        "entry_id": "25dfdb50-8c0a-3c3c-a142-6b897c589ee0",
                        "tags": [
                            "plural"
                        ],
