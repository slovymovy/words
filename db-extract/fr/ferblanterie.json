                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "79aa5597-7b42-401b-9357-c4a411d2d04f",
                        "entry_id": "1b8485cd-11d4-3209-beea-bf7903ec7706",
                        "tags": [
                            "plural"
