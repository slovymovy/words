                                            {
                                                "example_id": "d0336a60-a25d-404b-9805-3660ac29c620",
                                                "sense_id": "bdd88ba7-ea14-3964-bbfa-ca3a11913543",
                                                "text": "Er ist uns ein beständig zuverlässiger Freund."
                                            },
                                            {
                                                "example_id": "379b6eab-d1dc-4f6c-b61e-2462e99a6ead",
                                                "sense_id": "bdd88ba7-ea14-3964-bbfa-ca3a11913543",
                                                "text": "Das beständige Wetter erlaubt es, den geplanten Ausflug zu unternehmen."
                                            },
                                            {
                                                "example_id": "5af03566-6595-435c-bee3-c8846e6d9af6",
                                                "sense_id": "bdd88ba7-ea14-3964-bbfa-ca3a11913543",
                                                "text": "„Ein nahezu flächendeckender Zusammenbruch der Industrie, massenhafte Arbeitslosigkeit und beständige Abwanderung erschütterten in den neunziger Jahren die ostdeutschen Bundesländer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "81d11342-ea0d-466b-92da-e3eac4f6f0eb",
