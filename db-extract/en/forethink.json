                    {
                        "sense_id": "9e23ed2e-b76b-3474-89e0-bd540520ddcc",
                        "entry_id": "d822d79b-04c2-323c-8e45-728ee0b55513",
                        "glosses": [
                            "To plan (something) in advance; think, consider, or contrive beforehand; prognosticate."
                        ],
                        "tags": [
                            "rare",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "8e412782-b5a5-4078-8723-cde3d33448e5",
                                "sense_id": "9e23ed2e-b76b-3474-89e0-bd540520ddcc",
                                "text": "O vain sorceress , that could be wary to avoid the punishment of Saul ; careless to avoid the judgment of God ! Could we forethink what our sin would cost us , we durst not but be innocent"
                            }
                        ]
                    },
                    {
                        "sense_id": "d1e8751b-344b-3217-aba8-9f1c8c88ee4d",
                        "entry_id": "d822d79b-04c2-323c-8e45-728ee0b55513",
                        "glosses": [
                            "To think about beforehand; to anticipate."
                        ],
                        "tags": [
                            "rare",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "1bfaeb45-17d9-45c1-b900-f28629e7fe26",
                                "sense_id": "d1e8751b-344b-3217-aba8-9f1c8c88ee4d",
                                "text": "[…]and the soul of every man / Prophetically doth forethink thy fall."
                            },
                            {
                                "example_id": "c6952d7d-40ed-4493-9beb-35dc5c006601",
                                "sense_id": "d1e8751b-344b-3217-aba8-9f1c8c88ee4d",
                                "text": "Let not thy divining heart / Forethinke me any ill [...]."
                            }
                        ]
                    }
