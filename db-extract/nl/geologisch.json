                    {
                        "translation_id": "06741777-07fe-4cd3-b637-0d944614cb57",
                        "source_entry_id": "7b237384-427a-30bc-9164-17a50f67eafc",
                        "source_sense_id": "470196d4-064c-3035-8556-64bf5c066edf",
