                        "glosses": [
                            "ein am Erdboden aufliegender Nebel, der nicht über etwa 1m Höhe ansteigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a0bc4c0-78d1-4100-abaf-1d7f92a60465",
                                "sense_id": "972330aa-c704-38e5-8d90-68941fe93c71",
                                "text": "Bodennebel entsteht in Niederungen bei ruhigem Wetter und klarem Himmel, wenn die Ausstrahlung des Bodens groß ist und damit eine rasche Abkühlung der untersten Luftschicht bis zum Taupunkt eintritt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
