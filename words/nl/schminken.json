{
    "word_family": [
        "schmink",
        "geschminkt"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a9e32874-79bb-3fc6-a51f-343514b79574",
                    "sense_definition": "het gezicht beschilderen met speciale verf, vaak voor een toneelstuk of feest",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "uiterlijke verzorging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tijdens het carnaval laten veel kinderen zich als een tijger <w>schminken</w>.",
                            "target_lang_translations": {
                                "en": "During carnival, many children have their <w>faces painted</w> like a tiger."
                            }
                        },
                        {
                            "text": "De clown moet zich nog <w>schminken</w> voordat de voorstelling in het circus begint.",
                            "target_lang_translations": {
                                "en": "The clown still needs to <w>put on his makeup</w> before the circus performance begins."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zich laten schminken",
                        "een gezicht schminken"
                    ],
                    "target_lang_definitions": {
                        "en": "to paint the face with special paint, often for a play or party"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "face paint",
                                "target_lang_sense_clarification": "to apply decorative paint to the face"
                            },
                            {
                                "target_lang_word": "make up",
                                "target_lang_sense_clarification": "to prepare for a theatrical performance"
                            },
                            {
                                "target_lang_word": "paint",
                                "target_lang_sense_clarification": "to apply paint to the skin"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6acb2f6f-daa9-341b-9d1a-7c32e2cbd3f9",
                    "sense_definition": "cosmetica of make-up op het gezicht aanbrengen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "uiterlijke verzorging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij <w>schminkt</w> zich elke ochtend uitgebreid voor de spiegel in de badkamer.",
                            "target_lang_translations": {
                                "en": "She <w>puts on her makeup</w> extensively every morning in front of the bathroom mirror."
                            }
                        },
                        {
                            "text": "Het is belangrijk om je goed te <w>schminken</w> als je onder felle studiolampen staat.",
                            "target_lang_translations": {
                                "en": "It is important to <w>apply makeup</w> well when you are under bright studio lights."
                            }
                        }
                    ],
                    "synonyms": [
                        "opmaken"
                    ],
                    "common_phrases": [
                        "zich zwaar schminken"
                    ],
                    "target_lang_definitions": {
                        "en": "to apply cosmetics or makeup to the face"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "put on makeup",
                                "target_lang_sense_clarification": "to apply cosmetics"
                            },
                            {
                                "target_lang_word": "make up",
                                "target_lang_sense_clarification": "to apply cosmetics to the face"
                            },
                            {
                                "target_lang_word": "apply makeup",
                                "target_lang_sense_clarification": "the act of putting on cosmetics"
                            }
                        ]
                    }
                }
            ]
        }
    ]
