    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3a2af9bb-6155-3e3f-b575-67110d4d6407",
                    "sense_definition": "The process of becoming pregnant involving fertilization.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "biological_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The moment of <w>conception</w> marks the beginning of biological development.",
                            "target_lang_translations": {
                                "ru": "Момент <w>зачатия</w> знаменует начало биологического развития.",
                                "nl": "Het moment van <w>conceptie</w> markeert het begin van de biologische ontwikkeling.",
                                "zh": "<w>受孕</w>的那一刻标志着生物学发育的开始。"
                            }
                        },
                        {
                            "text": "Doctors can estimate the date of <w>conception</w> based on the size of the fetus.",
                            "target_lang_translations": {
                                "ru": "Врачи могут определить дату <w>зачатия</w> по размеру плода.",
                                "nl": "Artsen kunnen de datum van <w>bevruchting</w> schatten op basis van de grootte van de foetus.",
                                "zh": "医生可以根据胎儿的大小估算<w>受孕</w>日期。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fertilization"
                    ],
                    "common_phrases": [
                        "moment of conception",
                        "prevention of conception"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс наступления беременности, включающий оплодотворение.",
                        "nl": "Het proces van zwanger worden waarbij bevruchting plaatsvindt.",
                        "zh": "精卵结合形成胚胎并开始怀孕的过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зачатие",
                                "target_lang_sense_clarification": "биологический процесс"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "conceptie",
                                "target_lang_sense_clarification": "biologisch proces van bevruchting"
                            },
                            {
                                "target_lang_word": "bevruchting",
                                "target_lang_sense_clarification": "het samensmelten van zaadcel en eicel"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "受孕",
                                "target_lang_sense_clarification": "指精子与卵子结合形成胚胎的生理过程"
                            },
                            {
                                "target_lang_word": "怀胎",
                                "target_lang_sense_clarification": "指开始怀孕或受孕"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "69469130-763e-3f6d-8350-7055ee8d9234",
                    "sense_definition": "An idea, belief, or plan formed in the mind.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "mental_construct",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her <w>conception</w> of a successful life is very different from mine.",
                            "target_lang_translations": {
                                "ru": "Её <w>представление</w> об успешной жизни сильно отличается от моего.",
                                "nl": "Haar <w>opvatting</w> van een geslaagd leven is heel anders dan de mijne.",
                                "zh": "她对成功生活的<w>观念</w>和我的大不相同。"
                            }
                        },
                        {
                            "text": "The architect explained his original <w>conception</w> for the new museum design.",
                            "target_lang_translations": {
                                "ru": "Архитектор объяснил свою первоначальную <w>концепцию</w> дизайна нового музея.",
                                "nl": "De architect legde zijn oorspronkelijke <w>concept</w> voor het nieuwe museumontwerp uit.",
                                "zh": "建筑师解释了他对新博物馆设计的最初<w>构想</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "idea",
                        "notion",
                        "concept",
                        "plan"
                    ],
                    "antonyms": [
                        "misconception"
                    ],
                    "common_phrases": [
                        "original conception",
                        "conception of the world"
                    ],
                    "target_lang_definitions": {
                        "ru": "Идея, убеждение или план, сформированные в уме.",
                        "nl": "Een idee, overtuiging of plan dat in de geest is gevormd.",
                        "zh": "在脑海中形成的观点、构想或计划。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "концепция",
                                "target_lang_sense_clarification": "система взглядов, замысел"
                            },
                            {
                                "target_lang_word": "представление",
                                "target_lang_sense_clarification": "взгляд, мнение, образ"
                            },
                            {
                                "target_lang_word": "идея",
                                "target_lang_sense_clarification": "мысль, план"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "concept",
                                "target_lang_sense_clarification": "idee, ontwerp of abstract begrip"
                            },
                            {
                                "target_lang_word": "opvatting",
                                "target_lang_sense_clarification": "persoonlijke visie of idee"
                            },
                            {
                                "target_lang_word": "voorstelling",
                                "target_lang_sense_clarification": "beeld of idee dat men ergens van heeft"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "构想",
                                "target_lang_sense_clarification": "指初步的设计想法或创造性规划"
                            },
                            {
                                "target_lang_word": "观念",
                                "target_lang_sense_clarification": "指思想、看法或理解"
                            },
                            {
                                "target_lang_word": "设想",
                                "target_lang_sense_clarification": "指预先形成的计划或想法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "034de16e-015d-3724-8eb2-b262553e95eb",
                    "sense_definition": "The ability to understand or imagine something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "mental_ability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has absolutely no <w>conception</w> of how much work is required for this project.",
                            "target_lang_translations": {
                                "ru": "Он не имеет абсолютно никакого <w>понятия</w> о том, сколько работы требуется для этого проекта.",
                                "nl": "Hij heeft totaal geen <w>besef</w> van hoeveel werk er voor dit project nodig is.",
                                "zh": "他对于这个项目需要付出多少工作量完全没有<w>概念</w>。"
                            }
                        },
                        {
                            "text": "The vast distances in the universe are almost beyond human <w>conception</w>.",
                            "target_lang_translations": {
                                "ru": "Огромные расстояния во вселенной почти за гранью человеческого <w>понимания</w>.",
                                "nl": "De enorme afstanden in het universum gaan bijna het menselijk <w>begrip</w> te boven.",
                                "zh": "宇宙中遥远的距离几乎超出了人类的<w>想象</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "understanding",
                        "grasp"
                    ],
                    "common_phrases": [
                        "no conception of",
                        "beyond conception"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способность понять или представить что-либо.",
                        "nl": "Het vermogen om iets te begrijpen of zich voor te stellen.",
                        "zh": "理解或想象某事物的能力或认知。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "понятие",
                                "target_lang_sense_clarification": "осведомлённость, знание"
                            },
                            {
                                "target_lang_word": "представление",
                                "target_lang_sense_clarification": "понимание, способность вообразить"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "begrip",
                                "target_lang_sense_clarification": "het vermogen om iets te bevatten"
                            },
                            {
                                "target_lang_word": "besef",
                                "target_lang_sense_clarification": "het bewustzijn of inzicht in iets"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "概念",
                                "target_lang_sense_clarification": "指对某事物的基本认识或概念（常用于否定句）"
                            },
                            {
                                "target_lang_word": "理解",
                                "target_lang_sense_clarification": "指对事物认知或理解的能力"
                            },
                            {
                                "target_lang_word": "想象",
                                "target_lang_sense_clarification": "指在脑海中构想或体会的范围与能力"
                            }
                        ]
                    }
                }
            ]
