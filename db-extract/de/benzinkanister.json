                        "source_sense_id": "b0bc49fe-7712-3835-ab21-f630b2da3f6d",
                        "source_sense_description": "verschließbarer Behälter, der zum Transport und Aufbewahren von Benzin benutzt wird",
                        "target_lang_word": "jerrycan",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jerrycan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6972db71-98c4-3c3a-9d9f-bee287e7d4c1",
                                        "entry_id": "231e9293-cb2e-3d4e-842a-d7e54ff3814c",
                                        "glosses": [
                                            "A robust container for fuel or water, of a certain more or less rectangular shape, often made from pressed steel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d13eae70-f603-4a5d-8f4c-6af96f03774b",
                                                "sense_id": "6972db71-98c4-3c3a-9d9f-bee287e7d4c1",
                                                "text": "The police fell back, swatting and cursing. At the gateway, somebody grabbed a jerrycan of water from Jonamon's hut and flung its contents at the swarm."
                                            },
                                            {
                                                "example_id": "5ea24a51-fb18-423f-bcf8-0d3e3c8e9282",
                                                "sense_id": "6972db71-98c4-3c3a-9d9f-bee287e7d4c1",
                                                "text": "Anyone with half a brain and a jerrycan of fertilizer's got an army."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3b9c29ef-32e8-4745-91bc-e59f0bd77ca8",
                        "source_entry_id": "c2815bf3-9276-3487-8758-3a0b2a0279fc",
                        "source_sense_id": "b0bc49fe-7712-3835-ab21-f630b2da3f6d",
                        "source_sense_description": "verschließbarer Behälter, der zum Transport und Aufbewahren von Benzin benutzt wird",
                        "target_lang_word": "jerrican",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jerrican",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "355b2992-6578-3f8e-a80b-0f69812253a3",
                                        "entry_id": "995ecf3d-d6e3-3ad2-9f2d-8c8c2ea51a03",
                                        "glosses": [
                                            "Bidon pour carburant automobile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b29b90e-cdb5-4e52-a17a-2dae9cc05ed8",
                                                "sense_id": "355b2992-6578-3f8e-a80b-0f69812253a3",
                                                "text": "C’est à ce moment-là que Pierre débarque, tenant dans sa main un jerrican en fer."
                                            },
                                            {
                                                "example_id": "0f571342-56c6-4742-82f3-c872ebd8b517",
                                                "sense_id": "355b2992-6578-3f8e-a80b-0f69812253a3",
                                                "text": "Un jerrican l’y attendait, oublié. Un jerrican en plastique jaune, opaque et couvert de poussière, de terre, de toiles d’insectes ; celui qui servait de réserve à la grosse Talbot noire."
                                            },
                                            {
                                                "example_id": "b370bcc1-e435-44a0-b210-49b18c8d3d4c",
                                                "sense_id": "355b2992-6578-3f8e-a80b-0f69812253a3",
                                                "text": "Il faut d'abord souligner qu'il s'agit d'une installation de fortune : emploi de fûts d'essence pour la fumigérite, de Jerrican pour l'ammoniaque, de conduites et de robinets sommairement étudiés."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
