                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e6e4429-6b4e-4896-9c42-ce50da48c239",
                                "sense_id": "c313b403-657e-3efa-bc43-b3d53bcbb34c",
                                "text": "Шуга — одна из многочисленных рек, протекающих по территории России."
                            }
                        ]
                    },
                    {
                        "sense_id": "980d1838-39e0-3e31-a307-bc2ff58203ca",
                        "entry_id": "7b265d43-39a8-3059-9b92-0ffaa153335a",
                        "glosses": [
