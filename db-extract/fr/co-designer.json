                "senses": [
                    {
                        "sense_id": "0bf036d8-b42d-3727-bb39-702cebc2864f",
                        "entry_id": "75e79f7a-dd26-3204-ad58-dce29c224b02",
                        "glosses": [
                            "Designer, en commun avec au moins une autre personne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7724ce2d-3409-4f97-84d2-52f7bcd2af8d",
                                "sense_id": "0bf036d8-b42d-3727-bb39-702cebc2864f",
                                "text": "Cette politique de recherche implique des investissements plus importants en amont du processus, durant la genèse des idées, de mettre en place une véritable prospective, d'anticiper la versatilité du consommateur et de co-produire et co-designer le service avec ce dernier (différentiation concurrentielle et personnalisation de l'offre)."
                            },
                            {
                                "example_id": "2d4e25f1-5d58-4978-929e-37d3ddb4c619",
                                "sense_id": "0bf036d8-b42d-3727-bb39-702cebc2864f",
                                "text": "rencontrer et co-designer avec de potentiels futurs partenaires (chaine de valeur pré-constituée / time-to-market réduit)"
                            },
                            {
                                "example_id": "31d34db6-b0d9-4705-8b5c-3d54344ec1d4",
                                "sense_id": "0bf036d8-b42d-3727-bb39-702cebc2864f",
                                "text": "En tout cas pour cette nouvelle boutique ils ont mis le paquet, l’espace à une valeur de 14 millions de dollars, et inclura des vêtements glamour et flashy inspirés des shows de Vegas et seront co-designés par Christian Audigier et Michaël Jackson en personne."
                            }
                        ]
                    }
