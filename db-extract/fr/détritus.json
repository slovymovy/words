                "senses": [
                    {
                        "sense_id": "45dd6ab6-0e96-3bff-8fcb-807ed3ddf6c5",
                        "entry_id": "2260d467-fb70-30a9-8e75-bb6d0a8a1537",
                        "glosses": [
                            "Débris de matières organiques ou amas de ces débris."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20d6a3e3-d037-488c-89d7-ab296a71a192",
                                "sense_id": "45dd6ab6-0e96-3bff-8fcb-807ed3ddf6c5",
                                "text": "Détritus de végétaux, d’animaux."
                            }
                        ]
                    },
                    {
                        "sense_id": "ff6d3580-aea2-3600-bb13-65f7f1180b38",
                        "entry_id": "2260d467-fb70-30a9-8e75-bb6d0a8a1537",
                        "glosses": [
                            "Ces matériaux réduits à l’état de poussière ou de boue."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "d39839dd-b489-3c0b-b807-5fc30d75bd91",
                        "entry_id": "2260d467-fb70-30a9-8e75-bb6d0a8a1537",
                        "glosses": [
                            "Ordure, déchet, objet dont on n’a plus l’usage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91099f20-67c3-491f-8ba9-245c76f0edc6",
                                "sense_id": "d39839dd-b489-3c0b-b807-5fc30d75bd91",
                                "text": "Au coin du Marché-aux-Poissons, elle tourna, passa devant les pierres d’étal où gisaient encore des détritus puants."
                            }
                        ]
                    },
                    {
                        "sense_id": "7188a247-bd10-3342-8676-555d9d367efd",
                        "entry_id": "2260d467-fb70-30a9-8e75-bb6d0a8a1537",
                        "glosses": [
                            "Débris de roches."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "f5425b78-8d4d-39f9-8334-9a47dc3fc4ea",
                        "entry_id": "2260d467-fb70-30a9-8e75-bb6d0a8a1537",
                        "glosses": [
                            "Déchet provenant de la nécrose d’un tissu à la suite d’un traumatisme ou d’une infection."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "903498a9-63fa-46b1-80c0-d207a76f82b8",
                        "source_entry_id": "2260d467-fb70-30a9-8e75-bb6d0a8a1537",
                        "target_lang_word": "detritus",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "detritus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8bd853c1-3429-3de6-be32-30e17fb92e93",
                                        "entry_id": "3e0794b4-75f5-311e-9f53-d42b8ab2ec5c",
                                        "glosses": [
                                            "Pieces of rock broken off by ice, glacier, or erosion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a276769a-47d4-38e0-8fa0-0c57843783e0",
                                        "entry_id": "3e0794b4-75f5-311e-9f53-d42b8ab2ec5c",
                                        "glosses": [
                                            "Organic waste material from decomposing dead plants or animals."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "869f62ba-ae19-46c3-9236-09062fec9a73",
                                                "sense_id": "a276769a-47d4-38e0-8fa0-0c57843783e0",
                                                "text": "Woody detritus is an important component of forested ecosystems. It can reduce erosion and affects soil development, stores nutrients and water, provides a major source of energy and nutrients, and serves as a seedbed for plants and as a major habitat for decomposers and hetereotrophs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e80d6bb-3b6f-303c-a369-7da652397112",
                                        "entry_id": "3e0794b4-75f5-311e-9f53-d42b8ab2ec5c",
                                        "glosses": [
                                            "Any debris or fragments of disintegrated material."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9fd77975-5b1c-4ce0-86a5-d592a3e1f16e",
                                                "sense_id": "1e80d6bb-3b6f-303c-a369-7da652397112",
                                                "text": "But of course: no clutter. No newspapers, no renegade scraps of domestic detritus, no rubber bands, paper clips, coupons, pens or pencils, notebooks, magazines. No knives. Where were the knives?"
                                            },
                                            {
                                                "example_id": "3631d40a-c418-47a7-b129-815c546cd33c",
                                                "sense_id": "1e80d6bb-3b6f-303c-a369-7da652397112",
                                                "text": "The cutting head removes any chips out of the railhead and restores the required surface shape. The trains also clear up their own detritus as they travel. Neither milling chips nor grinding dust remain on the track."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91341402-57b4-3e39-adfc-21e2079df2c8",
                                        "entry_id": "3e0794b4-75f5-311e-9f53-d42b8ab2ec5c",
                                        "glosses": [
                                            "Rock consisting of accumulated debris from decayed rocks, like sand, that often is joined by cement."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "22f302cf-cabd-438b-911e-b0100250af14",
                        "source_entry_id": "2260d467-fb70-30a9-8e75-bb6d0a8a1537",
                        "target_lang_word": "afval",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "afval",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "e72b4e9f-b438-39cc-9d6c-fdac25784ef9",
                                        "entry_id": "34b84ade-492c-3b1c-825b-2c1dc21c7b32",
                                        "glosses": [
                                            "onbruikbare resten die weggegooid worden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1469735-1b0d-461e-a6a6-8217fdf47c1e",
                                                "sense_id": "e72b4e9f-b438-39cc-9d6c-fdac25784ef9",
                                                "text": "Morgen komen ze het afval ophalen."
                                            },
                                            {
                                                "example_id": "ae87c560-1556-482b-9e52-2f17187a1c41",
                                                "sense_id": "e72b4e9f-b438-39cc-9d6c-fdac25784ef9",
                                                "text": "Doordat ik vaak dagenlang geen afvalbak tegenkwam, droeg ik altijd een zak vol gebruikte wc-papiertjes bij me. Het was altijd weer een enorme opluchting om in een dorpje mijn wc-papier en ander afval weg te kunnen gooien."
                                            },
                                            {
                                                "example_id": "fd28333b-159b-4e59-bfc3-6fd3b73da78b",
                                                "sense_id": "e72b4e9f-b438-39cc-9d6c-fdac25784ef9",
                                                "text": "‘Wie heeft dat ook alweer gezegd? Over dat afval?’ kreunde ze. ‘Welk afval?’‘Dat de geschiedenis neerkomt op een berg afval die op je neerdondert.’"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "afval",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "9b4e0e7d-7b64-31a7-940d-e96a8d9bdf7e",
                                        "entry_id": "9bfa68eb-45fa-32b0-837d-9faeece5e95b",
                                        "glosses": [
                                            "het afvallen, verlating van een persoon of overtuiging waaraan men eerder was toegewijd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3be708b7-3ce2-4eb7-a69b-9b31c2520dfe",
                                                "sense_id": "9b4e0e7d-7b64-31a7-940d-e96a8d9bdf7e",
                                                "text": "De grondtoon van het boek getuigt van een cultuurpessimisme, dat vooral tot uiting komt in wantrouwen jegens een volledig geseculariseerde samenleving. De afval van God lijkt vanuit een gelovig gezichtspunt betekenis te hebben, maar dat is volgens hem een vergissing."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "afval",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "921201fe-e585-389b-acbe-05e9fb5ce56a",
                                        "entry_id": "c0a9add1-8ce8-33d3-916c-601f2e120f0a",
                                        "glosses": [
                                            "eerste persoon enkelvoud tegenwoordige tijd van afvallen"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "with-subordinate-clause"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5aa5ea3-3ea9-433b-9cca-2df43034940c",
                                                "sense_id": "921201fe-e585-389b-acbe-05e9fb5ce56a",
                                                "text": "... dat ik afval."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
