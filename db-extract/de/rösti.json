                        "source_sense_id": "3f5d134f-9576-3d9a-9859-e95047173d65",
                        "source_sense_description": "Gastronomie, Schweizer Küche: in der Pfanne knusprig gebratener Fladen aus geraffelten Kartoffeln",
                        "target_lang_word": "rösti",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rösti",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3cbe87d4-38ac-31fd-a6b4-2319472284fa",
                                        "entry_id": "9e072974-d6d9-30f6-bc1e-1d93753b2d87",
                                        "glosses": [
                                            "A traditional breakfast dish in Germanophone Switzerland (originally from Bern canton) made from potatoes, fried in a pan with butter or fat and widely varying other ingredients such as bacon, onions, cheese, apples or fresh herbs."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0177bc59-4d8e-45c8-8161-0d437757f36a",
                                                "sense_id": "3cbe87d4-38ac-31fd-a6b4-2319472284fa",
                                                "text": "The border between German- and French-speaking Switzerland is known as the “Röstigraben” because only the first traditionally serves rösti at breakfast."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
