                                    {
                                        "sense_id": "10594436-4961-3046-af1b-ce64d6a50bcd",
                                        "entry_id": "cf0eaf10-f96a-3e20-813b-3e55701a9fbc",
                                        "glosses": [
                                            "Caractère de ce qui est salé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc32ebf3-07b7-474f-ac53-eb1f75d1c41b",
                                                "sense_id": "10594436-4961-3046-af1b-ce64d6a50bcd",
                                                "text": "La salure en est beaucoup plus forte que celle de la mer, et elle produit sur les lèvres l’effet d’une forte solution d’alun."
                                            },
                                            {
                                                "example_id": "a44c0d1d-b56b-4ab5-8245-f80ab23d74f8",
                                                "sense_id": "10594436-4961-3046-af1b-ce64d6a50bcd",
                                                "text": "En 1601, 1620, 1627, 1677 le parlement de Paris la renouvelait par des arrêts successifs et fixait le prix du langueyage et la responsabilité des langueyeurs ; mais il autorisait, dans le premier de ces arrêts, la vente de la viande ladre après une salure de quarante jours."
                                            },
                                            {
                                                "example_id": "d54b0b0a-e15d-4884-9c5f-03b9f7ca24c1",
                                                "sense_id": "10594436-4961-3046-af1b-ce64d6a50bcd",
                                                "text": "Des femmes aux pieds blancs, un râteau à la main, ramassent les algues sèches ; le vent, avec la salure de la mer, leur arrive au visage, apportant une roulante harmonie de bruissements et une poussière d’écume."
                                            },
                                            {
                                                "example_id": "7ef9b03b-055f-44aa-8c77-9df111f16568",
                                                "sense_id": "10594436-4961-3046-af1b-ce64d6a50bcd",
                                                "text": "La poussière du Vieux-Port, chargée de salures, éparpille un relent lointain de choses épicées."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
