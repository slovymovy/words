    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "effd5347-0cf5-3cbf-83d0-11dd67963937",
                    "sense_definition": "A raised line of water that moves across the surface of the sea, ocean, or a lake.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "water_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>wave</w> traveled from the center of the lake to the shore.",
                            "target_lang_translations": {
                                "ru": "<w>Волна</w> прошла от центра озера к берегу.",
                                "zh": "<w>波浪</w>从湖中心传到了岸边。"
                            }
                        },
                        {
                            "text": "Surfers were waiting for a big <w>wave</w> to ride.",
                            "target_lang_translations": {
                                "ru": "Серферы ждали большую <w>волну</w>, чтобы оседлать её.",
                                "zh": "冲浪者们正在等待一个大<w>浪</w>去冲。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "ride a wave",
                        "huge wave",
                        "crashing waves"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поднятая гряда воды, движущаяся по поверхности моря, океана или озера.",
                        "zh": "水面上升起并移动的波浪。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "волна",
                                "target_lang_sense_clarification": "водная"
                            },
                            {
                                "target_lang_word": "вал",
                                "target_lang_sense_clarification": "высокая, большая волна"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "波浪",
                                "target_lang_sense_clarification": "水面上的波动"
                            },
                            {
                                "target_lang_word": "海浪",
                                "target_lang_sense_clarification": "海上的波浪"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "68394903-ed92-30c1-b7a9-6076908c184b",
                    "sense_definition": "A movement of the hand back and forth, usually to say hello or goodbye.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "hand_gesture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He dismissed her with a quick <w>wave</w> of his hand.",
                            "target_lang_translations": {
                                "ru": "Он отпустил её быстрым <w>взмахом</w> руки.",
                                "zh": "他<w>挥</w>了挥手，示意她离开。"
                            }
                        },
                        {
                            "text": "She gave a friendly <w>wave</w> as the train pulled away.",
                            "target_lang_translations": {
                                "ru": "Она дружелюбно <w>помахала</w>, когда поезд тронулся.",
                                "zh": "火车开走时，她友好地<w>挥</w>了挥手。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "give a wave",
                        "wave of the hand"
                    ],
                    "target_lang_definitions": {
                        "ru": "Движение рукой из стороны в сторону в знак приветствия или прощания.",
                        "zh": "手部来回摆动的动作，通常用于打招呼或告别。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взмах",
                                "target_lang_sense_clarification": "рукой"
                            },
