                ],
                "senses": [
                    {
                        "sense_id": "be2f3577-b867-384c-9ea5-7db774fe3439",
                        "entry_id": "3fa56a2b-ed2d-3a5a-8754-f137caa35f10",
                        "glosses": [
                            "medizinische Behandlung der Infektionskrankheit Tuberkulose, die durch das Bakterium Mycobacterium tuberculosis ausgelöst wird (meist mit Antibiotika, meist über einen langen Zeitraum, beispielsweise sechs Monate oder länger)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "afd4e0d9-16ef-447e-8c4e-79654546d381",
                                "sense_id": "be2f3577-b867-384c-9ea5-7db774fe3439",
                                "text": "„Ada arbeitete als Putzfrau und Näherin, doch das Geld reichte nicht, um eine Tuberkulosebehandlung ihres Sohnes bezahlen zu können.“"
                            },
                            {
                                "example_id": "a0a9e267-9097-4a32-bb83-c756069dc118",
                                "sense_id": "be2f3577-b867-384c-9ea5-7db774fe3439",
                                "text": "„Mit der Entdeckung des Streptomycins im Jahre 1943 in den USA begann eine neue Ära in der Tuberkulosebehandlung.“"
                            },
                            {
                                "example_id": "6af0a1e0-a0de-4db3-a42f-61ea0957371a",
                                "sense_id": "be2f3577-b867-384c-9ea5-7db774fe3439",
                                "text": "Isoniazid – Abk. INH, gebräuchliche Kurzform für Isonicotinsäurehydrazid; ein synthetisch hergestellter Wirkstoff zur Tuberkulosebehandlung."
                            },
                            {
                                "example_id": "760ea2a1-0f5c-40b2-8866-b9e8818770e5",
                                "sense_id": "be2f3577-b867-384c-9ea5-7db774fe3439",
                                "text": "„Die Kombinationstherapie zur Vermeidung von Resistenzbildungen wurde von dieser Zeit an Standard der Tuberkulosebehandlung.“"
                            },
                            {
                                "example_id": "9c64b80a-7526-417a-952e-e1303ddde991",
                                "sense_id": "be2f3577-b867-384c-9ea5-7db774fe3439",
                                "text": "„Ab 1910 war sie in Les Avants in der Schweiz in Tuberkulosebehandlung.“"
                            },
                            {
                                "example_id": "9a1772a0-5b0d-4e62-9da5-73306f5a1d10",
                                "sense_id": "be2f3577-b867-384c-9ea5-7db774fe3439",
                                "text": "„Im Jahre 1876 gründete Brehmers Schüler, Dettweiler, eine Lungenheilstätte in Falkenstein im Taunus. Er war es, der durch die Einführung der Liegekuren die Tuberkulosebehandlung wesentlich ausgestaltete.“"
                            },
                            {
                                "example_id": "249ec926-71bb-4d69-9dc0-80e105bfd7db",
                                "sense_id": "be2f3577-b867-384c-9ea5-7db774fe3439",
                                "text": "„Durch die neu eingeführte staatliche Sozialversicherung wurde es nun auch für breite Volksschichten möglich, eine der vielen rasch gegründeten Lungenheilstätten zu besuchen. Alle diese Neuentwicklungen auf dem Gebiet der Tuberkulosebehandlung führten schließlich zu einer massiven Eindämmung der Infektion.“"
                            },
                            {
                                "example_id": "b2322d1e-4c96-494c-a6f4-0cf9d1e14eac",
                                "sense_id": "be2f3577-b867-384c-9ea5-7db774fe3439",
                                "text": "„Deutlich erweitert wurde das Angebot der Klinik dann ab den 1960er Jahren, mit der Eröffnung der Asthma- und Allergieklinik 1964, der 1970 die Eröffnung der Augenabteilung folgte. Zwei Jahre später wurde dann die Tuberkulosebehandlung eingestellt.“"
                            },
                            {
                                "example_id": "178cee92-64e1-4651-b4ca-f8ab338c97b3",
                                "sense_id": "be2f3577-b867-384c-9ea5-7db774fe3439",
                                "text": "[Coronapandemie:] „»Die Auswirkung der Pandemie auf die Tuberkulosebehandlung war gewaltig«, sagte WHO-Generaldirektor Tedros Adhanom Ghebreyesus.“"
                            },
                            {
                                "example_id": "67d6e675-a98e-4873-b817-c4cb52936193",
                                "sense_id": "be2f3577-b867-384c-9ea5-7db774fe3439",
                                "text": "„Liegen Resistenzen vor, können bis zu 17 Tabletten täglich nötig werden, mit Nebenwirkungen bis hin zu Taubheit, mit unsicherer Aussicht auf Heilung und mit Kosten, die mehrere hundert mal höher als die einer normalen Tuberkulosebehandlung sein können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
