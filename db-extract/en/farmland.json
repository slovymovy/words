                    }
                ],
                "senses": [
                    {
                        "sense_id": "cbac4606-77fa-306c-9106-2872f7057a37",
                        "entry_id": "eaec8312-d9eb-30f2-b308-3b4529a3d2e1",
                        "glosses": [
                            "Land that is suitable for farming and agricultural production."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "c19d3512-87cf-4ae7-8d4b-c4375a00c58b",
                                "sense_id": "cbac4606-77fa-306c-9106-2872f7057a37",
                                "text": "From Blackwater there is a more or less level run through gently rolling farmlands and downs to Merstone, with its island platform and passing loop."
                            },
                            {
                                "example_id": "54f0efe2-abe5-4d77-b7cd-4c8f5b5914b2",
                                "sense_id": "cbac4606-77fa-306c-9106-2872f7057a37",
                                "text": "Other common farmland butterflies to have suffered steep declines include the small tortoiseshell (64%), the wall brown (37%) and the large skipper (35%)."
                            },
                            {
                                "example_id": "4f8d6169-3f56-4bef-886e-a2a913569fdb",
                                "sense_id": "cbac4606-77fa-306c-9106-2872f7057a37",
                                "text": "The CCC would restore the soil health of farmlands in the Heartland and power the Colorado River by constructing the Hoover Dam. Their work transformed the very landscape of America."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "836b629a-99fa-4b7b-a646-157a0059b6a8",
                        "source_entry_id": "eaec8312-d9eb-30f2-b308-3b4529a3d2e1",
