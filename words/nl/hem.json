                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>hemmen</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>hem</w> even om mijn keel te schrapen.",
                            "target_lang_translations": {
                                "ru": "Я <w>откашливаюсь</w>, чтобы прочистить горло.",
                                "en": "I <w>hem</w> for a moment to clear my throat.",
                                "it": "<w>Mi schiarisco la voce</w> un attimo per pulirmi la gola."
                            }
                        },
                        {
                            "text": "Telkens als ik zenuwachtig ben, <w>hem</w> ik onbewust.",
                            "target_lang_translations": {
                                "ru": "Каждый раз, когда я нервничаю, я неосознанно <w>хмыкаю</w>.",
                                "en": "Whenever I am nervous, I <w>hem</w> unconsciously.",
                                "it": "Ogni volta che sono nervoso, <w>mi schiarisco la voce</w> inconsciamente."
                            }
