                        "entry_id": "0a968248-16e6-3a00-8b8c-c5e451324cf3",
                        "glosses": [
                            "Region in Zentralasien, zum größten Teil im heutigen Usbekistan liegend"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "7e100d64-a9b2-42fa-83cc-5a8f14c3fb5f",
                                "sense_id": "2a4f2462-5b9c-3b54-bfcd-dfbaf8e2b973",
                                "text": "„Die Seldschuken waren ein Zweig des im 8. Jahrhundert in Transoxanien eingewanderten türkischen Stammesverbands der Oghusen, jener Nomaden, die noch im 10. Jahrhundert größtenteils in der heutigen Kasachensteppe umherzogen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
