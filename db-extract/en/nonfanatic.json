            {
                "entry_id": "d7046f19-d7e2-3a79-b0e2-bb6f39475209",
                "word": "nonfanatic",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "1abd882d-cc4c-4d2c-8e8f-d6819a28606c",
                        "entry_id": "d7046f19-d7e2-3a79-b0e2-bb6f39475209",
                        "tags": [
                            "plural"
                        ],
                        "form": "nonfanatics"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "130c5dd7-f07b-3895-b3f5-0df9ffd7f3c8",
                        "entry_id": "d7046f19-d7e2-3a79-b0e2-bb6f39475209",
                        "glosses": [
                            "One who is not a fanatic."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3198f5c2-3b6e-4bf4-94a7-e41e1f0cef2f",
                                "sense_id": "130c5dd7-f07b-3895-b3f5-0df9ffd7f3c8",
                                "text": "...but he is an important weapon in the hands of the determined nonfanatic — one who intends to live for the cause, in other words."
                            },
                            {
                                "example_id": "18b7cee1-f6d9-4ab1-9059-d5e4af58089c",
                                "sense_id": "130c5dd7-f07b-3895-b3f5-0df9ffd7f3c8",
                                "text": "As every udon fanatic (and even nonfanatic) in Japan knows, Takamatsu sits smack in the center of the Sanuki universe."
                            },
                            {
                                "example_id": "2561f7f7-ae8b-4711-a554-500dce13df7f",
                                "sense_id": "130c5dd7-f07b-3895-b3f5-0df9ffd7f3c8",
                                "text": "If the escape-route of adopting the indifferent-amoral position is not really open to the nonfanatic, then what about the silent-amoral position?"
                            },
                            {
                                "example_id": "b55e28f7-a74e-49d3-9abc-513a4d7d68f9",
                                "sense_id": "130c5dd7-f07b-3895-b3f5-0df9ffd7f3c8",
                                "text": "He does not precisely indicate how one distinguishes the fanatic from the nonfanatic."
                            }
                        ]
                    }
                ],
