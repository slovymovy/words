                                        "sense_id": "28f54131-ede9-3290-a1d3-3fa1ad6720a2",
                                        "entry_id": "e1189034-fc9d-35ac-8e15-ad1c4aaed0ca",
                                        "glosses": [
                                            "Stoßwaffe mit gerader, abgestumpfter, vierkantiger Klinge"
                                        ],
                                        "tags": [
                                            "Fechten"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "edd82897-068c-45f4-be05-8cb3dd25fa21",
                                                "sense_id": "28f54131-ede9-3290-a1d3-3fa1ad6720a2",
                                                "text": "„Er nahm zwei Florette, zeigte mir den geheimen Stoß, gab mir seinen Segen und führte mich zum Wagen.“"
                                            },
                                            {
                                                "example_id": "e73c52a4-9e40-42c4-8dfe-c37319069bf1",
                                                "sense_id": "28f54131-ede9-3290-a1d3-3fa1ad6720a2",
                                                "text": "„Eines Morgens nahm er daher ein Florett und forderte ihn zu einem Kampf heraus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
