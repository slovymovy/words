                "senses": [
                    {
                        "sense_id": "8170ee0f-4cea-3520-9e0a-1bd29e073364",
                        "entry_id": "9b40e717-c75b-3596-998c-0567a3f887aa",
                        "glosses": [
                            "A female given name from Hebrew."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82381c7d-1206-4896-8d63-f4410807bef5",
                                "sense_id": "8170ee0f-4cea-3520-9e0a-1bd29e073364",
                                "text": "Elsie Marley is so neat, / 'Tis hard for one to walk the street / But every lad a lass they meet, / Cries do you ken Elsie Marley, honey?"
                            },
                            {
                                "example_id": "d73753ce-05b3-4a2a-9e81-b688f85b0dc6",
                                "sense_id": "8170ee0f-4cea-3520-9e0a-1bd29e073364",
                                "text": "\"And did he not speak of me, Heyward?\" demanded Alice, with jealous affection; \"surely, he forgot not altogether his little Elsie?\""
                            },
                            {
                                "example_id": "e3ba45b1-a899-4636-9a91-848548613286",
                                "sense_id": "8170ee0f-4cea-3520-9e0a-1bd29e073364",
                                "text": "\"Obviously I wasn't going to go through life saddled with a name like Elsie. When I got up to London at the age of eighteen everybody laughed at me, so a boyfriend suggested a tiny amendment, two letters swopped, and I've been Elise for thirty years.\""
                            }
                        ]
                    }
