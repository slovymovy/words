                        "source_sense_id": "0289af27-c10e-3d57-ac81-e4c1ae85dcd9",
                        "source_sense_description": "orientalisches Gericht in vielen Varianten mit körnigem Reis",
                        "target_lang_word": "pilaf",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pilaf",
