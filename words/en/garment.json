{
    "word_family": [
        "garmentless",
        "garmentmaker"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f7435d16-5701-3b6d-b207-fd404436aa10",
                    "sense_definition": "A single item of clothing.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The designer showcased a beautiful silk <w>garment</w> during the fashion show.",
                            "target_lang_translations": {
                                "ru": "Дизайнер представил прекрасный шелковый <w>предмет одежды</w> во время показа мод."
                            }
                        },
                        {
                            "text": "Please make sure every outer <w>garment</w> is hung up in the cloakroom before entering.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, убедитесь, что вся верхняя <w>одежда</w> повешена в гардеробе перед входом."
                            }
                        }
                    ],
                    "synonyms": [
                        "article of clothing",
                        "apparel",
                        "attire"
                    ],
                    "common_phrases": [
                        "outer garment",
                        "silk garment",
                        "protective garment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отдельный предмет одежды."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предмет одежды",
                                "target_lang_sense_clarification": "единичное изделие"
                            },
                            {
                                "target_lang_word": "одежда",
                                "target_lang_sense_clarification": "в общем смысле"
                            },
                            {
                                "target_lang_word": "платье",
                                "target_lang_sense_clarification": "устаревшее или собирательное для наряда"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b58db220-5d4b-331b-8fa8-84c200ade179",
                    "sense_definition": "The visible exterior in which a thing is invested or embodied.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "metaphorical_covering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In many spiritual traditions, the body is seen merely as a <w>garment</w> of flesh for the soul.",
                            "target_lang_translations": {
                                "ru": "Во многих духовных традициях тело рассматривается лишь как плотское <w>одеяние</w> души."
                            }
                        },
                        {
                            "text": "The hills were covered in a <w>garment</w> of white snow after the blizzard.",
                            "target_lang_translations": {
                                "ru": "После метели холмы были укрыты белоснежным <w>покровом</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "covering",
                        "shroud",
                        "guise"
                    ],
                    "common_phrases": [
                        "garment of flesh"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Видимая внешняя оболочка, в которую что-либо облечено или воплощено."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "одеяние",
                                "target_lang_sense_clarification": "книжное, возвышенное"
                            },
                            {
                                "target_lang_word": "покров",
                                "target_lang_sense_clarification": "метафорическое покрытие"
                            },
                            {
                                "target_lang_word": "оболочка",
                                "target_lang_sense_clarification": "внешний слой"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6b61886b-101d-3975-861c-52546f274be0",
                    "sense_definition": "To clothe or cover someone or something in a garment.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "clothing_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The statues were <w>garmented</w> in fine linen for the duration of the festival.",
                            "target_lang_translations": {
                                "ru": "На время фестиваля статуи были <w>облечены</w> в тонкий лен."
                            }
                        },
                        {
                            "text": "The mountains were <w>garmented</w> in mist as the sun began to set.",
                            "target_lang_translations": {
                                "ru": "Горы были <w>окутаны</w> туманом, когда солнце начало садиться."
                            }
                        }
                    ],
                    "synonyms": [
                        "clothe",
                        "array",
                        "drape"
                    ],
                    "antonyms": [
                        "undress",
                        "strip"
                    ],
                    "common_phrases": [
                        "garmented in mist"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Одевать или покрывать кого-либо или что-либо одеждой или покровом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "облекать",
                                "target_lang_sense_clarification": "в одежду или метафорически"
                            },
                            {
                                "target_lang_word": "одевать",
                                "target_lang_sense_clarification": "в наряд"
                            },
                            {
                                "target_lang_word": "окутывать",
                                "target_lang_sense_clarification": "туманом или покровом"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}