{
    "word_family": [
        "assert",
        "assertion",
        "assertively",
        "assertiveness",
        "assertor"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ee209048-e52b-370f-aa03-df94a6ddc7e8",
                    "sense_definition": "Boldly self-assured; confident without being aggressive.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "personality_traits",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She has become much more <w>assertive</w> in meetings since she was promoted to manager.",
                            "target_lang_translations": {
                                "ru": "Она стала гораздо более <w>напористой</w> на собраниях с тех пор, как её повысили до менеджера."
                            }
                        },
                        {
                            "text": "Learning to use <w>assertive</w> communication helps you express your needs clearly without offending others.",
                            "target_lang_translations": {
                                "ru": "Обучение <w>ассертивному</w> общению помогает четко выражать свои потребности, не обижая других."
                            }
                        }
                    ],
                    "synonyms": [
                        "confident",
                        "decisive",
                        "self-assured",
                        "firm"
                    ],
                    "antonyms": [
                        "passive",
                        "timid",
                        "submissive",
                        "hesitant"
                    ],
                    "common_phrases": [
                        "assertive communication",
                        "assertive behavior",
                        "assertive personality"
                    ],
                    "target_lang_definitions": {
                        "ru": "Смелый и уверенный в себе; способный отстаивать свои права и мнение без агрессии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "напористый",
                                "target_lang_sense_clarification": "энергичный и уверенный в достижении целей"
                            },
                            {
                                "target_lang_word": "уверенный",
                                "target_lang_sense_clarification": "обладающий верой в свои силы"
                            },
                            {
                                "target_lang_word": "самоуверенный",
                                "target_lang_sense_clarification": "в значении уверенности в своих действиях"
                            },
                            {
                                "target_lang_word": "ассертивный",
                                "target_lang_sense_clarification": "психологический термин для уверенного поведения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "838de59d-9c80-375d-9121-cf35f3778fc2",
                    "sense_definition": "Having a strong, pungent, or distinct flavor or smell.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sensory_qualities",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chef warned that the blue cheese has an <w>assertive</w> flavor that might overpower the salad.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар предупредил, что у голубого сыра <w>резкий</w> вкус, который может перебить вкус салата."
                            }
                        },
                        {
                            "text": "This wine is known for its <w>assertive</w> aroma of oak and dark berries.",
                            "target_lang_translations": {
                                "ru": "Это вино известно своим <w>насыщенным</w> ароматом дуба и темных ягод."
                            }
                        }
                    ],
                    "synonyms": [
                        "pungent",
                        "strong",
                        "bold",
                        "pronounced"
                    ],
                    "antonyms": [
                        "mild",
                        "subtle",
                        "faint",
                        "bland"
                    ],
                    "common_phrases": [
                        "assertive flavor",
                        "assertive taste",
                        "assertive aroma"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладающий сильным, резким или ярко выраженным вкусом или запахом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "резкий",
                                "target_lang_sense_clarification": "сильно выраженный вкус или запах"
                            },
                            {
                                "target_lang_word": "насыщенный",
                                "target_lang_sense_clarification": "густой и выразительный аромат или вкус"
                            },
                            {
                                "target_lang_word": "выраженный",
                                "target_lang_sense_clarification": "явно ощутимый"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}