                "senses": [
                    {
                        "sense_id": "decc20e8-027e-3148-b1ce-4a44b5854c0e",
                        "entry_id": "03c4386b-f58e-3c28-9a42-cf0ddfaf89c0",
                        "glosses": [
                            "auf den Superlativ bezogen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56d7e49a-1e95-44e2-b526-f2eed4e4976c",
                                "sense_id": "decc20e8-027e-3148-b1ce-4a44b5854c0e",
                                "text": "„Die Stilmittel der Werbesprache entstammen der allgemeinen Rhetorik. Ihr werblicher Charakter wird vor allem dadurch deutlich, dass die Werbung so gut wie immer die positiven Seiten des Angebots stark überbetont, etwa durch Häufung von positiven Adjektiven oder superlativischen Wendungen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f4fa9f99-a101-3cea-ac46-bd2dc879b1f2",
                        "entry_id": "03c4386b-f58e-3c28-9a42-cf0ddfaf89c0",
                        "glosses": [
                            "ganz einzigartig, überragend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25346b48-0deb-4103-a70a-711700efb18b",
                                "sense_id": "f4fa9f99-a101-3cea-ac46-bd2dc879b1f2",
                                "text": "Es war der superlativische Urlaub. Ich habe nie einen Schöneren erlebt."
