                "senses": [
                    {
                        "sense_id": "69a56b39-4aad-303d-9a39-d5fa2bcbdbef",
                        "entry_id": "170fe6cb-7703-39b5-b1b7-9d44d58a6b56",
                        "glosses": [
                            "explosible Flüssigkeit, die als Sprengstoff und Arzneimittel Verwendung findet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53b6eb44-44db-4403-a959-063da399000e",
                                "sense_id": "69a56b39-4aad-303d-9a39-d5fa2bcbdbef",
                                "text": "Die Sache mit dem \"Sprengöl\", dem Nitroglyzerin, hat allerdings einen Haken: Bei der geringsten Unvorsichtigkeit, bei jeder merkbaren Erschütterung, geht die Substanz hoch."
                            },
                            {
                                "example_id": "d50e62e0-51c3-428d-9dc6-30f68a8e3ae0",
                                "sense_id": "69a56b39-4aad-303d-9a39-d5fa2bcbdbef",
                                "text": "Die hohe Energiedichte dieses Materials, die jener von Nitroglyzerin entspricht, wäre beispielsweise ein idealer Brennstoff für Mikro-Satelliten."
                            },
                            {
                                "example_id": "51554418-fdf4-41d1-b7a3-739aa855b4f6",
                                "sense_id": "69a56b39-4aad-303d-9a39-d5fa2bcbdbef",
                                "text": "Seit mehr als 130 Jahren wird Nitroglyzerin gegen Brustschmerzen bei Herzpatienten eingesetzt (Angina pectoris)."
                            },
                            {
                                "example_id": "765b1177-2de9-4cc8-aceb-2f2498252f08",
                                "sense_id": "69a56b39-4aad-303d-9a39-d5fa2bcbdbef",
                                "text": "Nitroglyzerin bewirkt eine schnelle Vasodilatation (Erweiterung der Blutgefäße) und vermindert dadurch die Vorlast des Herzens."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1f6b3b52-c62a-4754-8d02-199b67bfa870",
                        "source_entry_id": "170fe6cb-7703-39b5-b1b7-9d44d58a6b56",
                        "source_sense_id": "69a56b39-4aad-303d-9a39-d5fa2bcbdbef",
                        "source_sense_description": "explosible Flüssigkeit, die als Sprengstoff und Arzneimittel Verwendung findet",
                        "target_lang_word": "nitroglycerine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nitroglycerine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "59cd42c7-0787-3640-92ef-2af6536ed134",
                                        "entry_id": "bcad59f5-d8f1-3371-851d-40a7a2778375",
                                        "glosses": [
                                            "The compound glyceryl-tri-nitrate or 1,2,3 tri-nitrooxy propane; the ester of glycerol with nitric acid; prepared by the careful addition of a mixture of nitric and sulphuric acids to glycerol with constant stirring and cooling; it is a thick, pale yellow liquid, that is highly explosive on concussion or on exposure to sudden heat; it is used in medicine as a vasodilator, and as an explosive in the form of dynamite which is safe to handle."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11903d69-dfe6-48a1-bf66-820a960ea45d",
                                                "sense_id": "59cd42c7-0787-3640-92ef-2af6536ed134",
                                                "text": "Holonym: dynamite"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e3ec8731-720a-4ac2-829c-e94a3b7e56af",
                        "source_entry_id": "170fe6cb-7703-39b5-b1b7-9d44d58a6b56",
                        "source_sense_id": "69a56b39-4aad-303d-9a39-d5fa2bcbdbef",
                        "source_sense_description": "explosible Flüssigkeit, die als Sprengstoff und Arzneimittel Verwendung findet",
                        "target_lang_word": "nitroglycérine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nitroglycérine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "56b4accb-fe94-3dfd-80e4-3fb7f3ec3da3",
                                        "entry_id": "c7ec14f5-c9a2-3010-b0d7-dd9e94d2898d",
                                        "glosses": [
                                            "Ester du glycérol et de l’acide nitrique de formule brute C₃H₅N₃O₉ qui se présente comme une huile jaunâtre, corrosive, extrêmement toxique et d’une grande force explosive, qui peut également avoir un usage médical comme vasodilatateur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aad8a190-1462-4b7f-8a42-65a2f9ff24fc",
                                                "sense_id": "56b4accb-fe94-3dfd-80e4-3fb7f3ec3da3",
                                                "text": "L’arme par excellence des anarchistes, la dynamite, découle de la découverte de la nitroglycérine en 1846, et de sa maîtrise par Alfred Nobel en 1864."
                                            },
                                            {
                                                "example_id": "3cecfb4b-8e16-43d5-99da-dfe82264d319",
                                                "sense_id": "56b4accb-fe94-3dfd-80e4-3fb7f3ec3da3",
                                                "text": "La nitroglycérine, poursuit le gros O’Brien, en voici."
                                            },
                                            {
                                                "example_id": "a57cd329-0871-4450-8307-d7d6077efcd7",
                                                "sense_id": "56b4accb-fe94-3dfd-80e4-3fb7f3ec3da3",
                                                "text": "Dans les manipulations, quand pour charger une torpille, par exemple, on sera forcé de la décartoucher, opération qui ne peut guère être faite qu’avec les mains, il faudra, aussitôt le travail terminé, se laver avec soin et faire disparaître de la peau et surtout des ongles toute trace de nitroglycérine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "beb72a08-a57b-3382-8094-3883399a7b9a",
                                        "entry_id": "c7ec14f5-c9a2-3010-b0d7-dd9e94d2898d",
                                        "glosses": [
                                            "Utilisé pour qualifier des situations tendues, instables qui peuvent, comme le produit d’origine, exploser à tout instant."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1815b6c-31b5-4150-afad-ad4d640d5467",
                                                "sense_id": "beb72a08-a57b-3382-8094-3883399a7b9a",
                                                "text": "« La question du français au Québec ? C’est de la nitroglycérine ! Un sujet explosif ! », prévient Éric Bouchard, du mouvement pour un Québec français (MQF)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
