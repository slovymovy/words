                    },
                    {
                        "form_id": "95f8c084-6543-4213-9abc-ff781e86d6b9",
                        "entry_id": "1984191a-2c0f-30ad-86c4-79c5dfc6aef4",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Wendeltreppen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "af58c627-20c7-3bb2-865a-90e90eec355c",
                        "entry_id": "1984191a-2c0f-30ad-86c4-79c5dfc6aef4",
                        "glosses": [
                            "Treppe, deren Stufen spiralförmig um eine Achse verlaufen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a3de081-cca0-4f26-86a0-37f40718d520",
                                "sense_id": "af58c627-20c7-3bb2-865a-90e90eec355c",
                                "text": "„Die Wendeltreppe mußten sie natürlich einzeln hinuntergehen, doch unten angekommen, fanden sie sich wieder in Paaren zusammen.“"
                            },
                            {
                                "example_id": "7b503244-2dd9-47dd-bbeb-819277681004",
                                "sense_id": "af58c627-20c7-3bb2-865a-90e90eec355c",
                                "text": "„Er überprüfte die Gästeliste, nickte dann zustimmend und gab den Weg zu einer steilen Wendeltreppe frei.“"
                            },
                            {
                                "example_id": "a3f7d6ec-1b6d-48db-b310-9492c042dbeb",
                                "sense_id": "af58c627-20c7-3bb2-865a-90e90eec355c",
                                "text": "„Die Wendeltreppe, die das Hinterzimmer der Buchhandlung mit dem Vorzimmer unserer Wohnung verbindet, wird zum zentralen Dreh- und Angelpunkt unseres Lebens.“"
                            },
                            {
                                "example_id": "1e7be8f2-d384-43b7-9954-a84eed9b2a69",
                                "sense_id": "af58c627-20c7-3bb2-865a-90e90eec355c",
                                "text": "„In Koblenz befand sich die Bibliothek über dem Kapitelsaal und war über eine Wendeltreppe zu erreichen.“"
                            },
                            {
                                "example_id": "de361c85-1c3d-45e8-9a2a-f751761b558f",
                                "sense_id": "af58c627-20c7-3bb2-865a-90e90eec355c",
                                "text": "„Sie schlief diesmal nicht unweit der Eingangshalle, am Fuß der Wendeltreppe, wie sie es sonst immer tat, wenn ihre Herrin sich heimlich mit Mr. Dickens traf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
