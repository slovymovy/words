                        "sense_id": "148998a6-b86f-3b83-99aa-d06fc214ec01",
                        "entry_id": "7ce779df-5637-3692-bc2d-785a460ab68b",
                        "glosses": [
                            "Drunk; intoxicated."
                        ],
                        "tags": [
                            "Ireland",
