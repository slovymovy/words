                "senses": [
                    {
                        "sense_id": "7fb450ca-9a97-3941-af09-614341e01e7e",
                        "entry_id": "9df259b6-17a9-33a6-a854-f8fda02b9449",
                        "glosses": [
                            "невысокие кеды"
                        ],
                        "tags": [
                            "обычно мн. ч."
                        ],
                        "examples": [
                            {
                                "example_id": "5441e687-75ad-46b7-8334-0f056f6a2a16",
                                "sense_id": "7fb450ca-9a97-3941-af09-614341e01e7e",
                                "text": "Кстати, когда проходил службу по контракту в 2000-2001 гг. в Чеченской Республике, ходил в полукедах."
                            },
                            {
                                "example_id": "af30399d-067d-45b8-bde9-068a5840a445",
                                "sense_id": "7fb450ca-9a97-3941-af09-614341e01e7e",
                                "text": "На ногах ― полукеды, мокрые, потому что когда он вышел из машины на заправке, на коврике в машине остались лужи."
                            },
                            {
                                "example_id": "cfe82a6a-6bf5-4954-bfec-124ead78efcd",
                                "sense_id": "7fb450ca-9a97-3941-af09-614341e01e7e",
                                "text": "Несомненно, даже усталая старушка предпочтет этим кожаным кругломордым галошам более элегантные тряпичные полукеды."
                            }
                        ]
                    }
