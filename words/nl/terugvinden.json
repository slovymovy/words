                    "frequency": "Middle",
                    "semantic_group_id": "herontdekken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De politie kon de gestolen auto na een week <w>terugvinden</w>.",
                            "target_lang_translations": {
                                "en": "The police were able to <w>recover</w> the stolen car after a week.",
                                "ru": "Полиция смогла <w>разыскать</w> украденный автомобиль через неделю."
                            }
                        },
                        {
                            "text": "Zij moest en zou haar fles <w>terugvinden</w> in het park.",
                            "target_lang_translations": {
                                "en": "She was determined to <w>find</w> her bottle <w>back</w> in the park.",
                                "ru": "Она во что бы то ни стало должна была <w>отыскать</w> свою бутылку в парке."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gestolen goederen terugvinden"
                    ],
                    "target_lang_definitions": {
