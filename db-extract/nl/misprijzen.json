                    {
                        "sense_id": "8b3d433f-9112-33cb-b7a6-d84654d6595b",
                        "entry_id": "59f5ab35-f6fb-3eba-8b09-080a07230df8",
                        "glosses": [
                            "spot of afkeuring over iemand of iets uitspreken"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "7c52c122-e201-4e1d-8d4e-b552205c0dc0",
                                "sense_id": "8b3d433f-9112-33cb-b7a6-d84654d6595b",
                                "text": "Geëngageerde kunst wordt vaak misprezen."
                            },
                            {
                                "example_id": "2dc4066d-d402-44b7-9264-b4cff3927e93",
                                "sense_id": "8b3d433f-9112-33cb-b7a6-d84654d6595b",
                                "text": "Ter aanvulling wijst hij op de ouderdom van het dansen (zolang als er al mensen zijn, vs. 51), op de hemelse herkomst (de dans van de sterren aan het firmament (vs. 52-54), alsmede op verdere eerbiedwaardige voorbeelden van positief gebruik. Waarom zou men het dansen nu dan misprijzen (vs. 60)?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "804bc3b5-849d-491c-a5c3-9891a43731fd",
                        "source_entry_id": "59f5ab35-f6fb-3eba-8b09-080a07230df8",
                        "source_sense_id": "8b3d433f-9112-33cb-b7a6-d84654d6595b",
