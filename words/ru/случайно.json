    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "f49b90f3-87ba-3f67-adc0-6fa3f71b6aa9",
                    "sense_definition": "Без умысла, не желая того; по неосторожности.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "unintentional",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я <w>случайно</w> нажал не ту кнопку на пульте.",
                            "target_lang_translations": {
                                "en": "I <w>accidentally</w> pressed the wrong button on the remote.",
                                "es": "Presioné <w>sin querer</w> el botón equivocado del mando.",
                                "fr": "J'ai appuyé <w>par accident</w> sur le mauvais bouton de la télécommande."
                            }
                        },
                        {
                            "text": "Простите, я <w>случайно</w> задел вашу сумку в проходе.",
                            "target_lang_translations": {
                                "en": "Sorry, I <w>accidentally</w> hit your bag in the aisle.",
                                "es": "Disculpe, tropecé <w>por accidente</w> con su bolso en el pasillo.",
                                "fr": "Désolé, j'ai touché votre sac dans l'allée <w>sans le vouloir</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "нечаянно",
                        "ненароком",
                        "непредумышленно"
                    ],
                    "antonyms": [
                        "нарочно",
                        "преднамеренно"
                    ],
                    "common_phrases": [
                        "сделать случайно",
                        "получилось случайно",
                        "совершенно случайно"
                    ],
                    "target_lang_definitions": {
                        "en": "Done without intention, planning, or meaning to; by mistake.",
                        "es": "Hecho sin intención, involuntariamente o por error.",
                        "fr": "Fait sans intention, par erreur ou par maladresse."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "accidentally",
                                "target_lang_sense_clarification": "general unintentional action"
                            },
                            {
