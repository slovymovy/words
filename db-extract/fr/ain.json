        "fr-extract.jsonl": [
            {
                "entry_id": "e11ecdb4-ccfe-3baf-bace-860a379ab70a",
                "word": "Ain",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3d5d5c9e-234d-375e-a44e-b9d84b934004",
                        "entry_id": "e11ecdb4-ccfe-3baf-bace-860a379ab70a",
                        "glosses": [
                            "Rivière française."
                        ],
                        "tags": [
                            "Cours d’eau"
                        ],
                        "examples": [
                            {
                                "example_id": "12011a18-da52-4e16-99ac-82494b1e9955",
                                "sense_id": "3d5d5c9e-234d-375e-a44e-b9d84b934004",
                                "text": "La rivière d’Ain, qui traverse le département sur une largeur de 18 lieues, est encaissée dans une partie de son cours, et ne commence à prendre des rives de quelque étendue qu’à Poncin : […]."
                            },
                            {
                                "example_id": "abb515b3-1911-4228-a5d9-494ff08d2eb1",
                                "sense_id": "3d5d5c9e-234d-375e-a44e-b9d84b934004",
                                "text": "Comme au temps où il plongeait d’un pont dans l’eau glacée de la rivière d’Ain, il aspira une longue bouffée d’air et se leva presque brutalement."
                            }
                        ]
                    },
                    {
                        "sense_id": "0d44877e-ee6a-3363-ba8e-1b4d6de42cc1",
                        "entry_id": "e11ecdb4-ccfe-3baf-bace-860a379ab70a",
                        "glosses": [
                            "Département français de la région administrative d'Auvergne-Rhône-Alpes. Ce département porte le numéro 01."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0c2f662-baf9-48fc-8734-bd6d5d2ae6ff",
                                "sense_id": "0d44877e-ee6a-3363-ba8e-1b4d6de42cc1",
                                "text": "D’après le tableau 4.7, on observe que dans l’Ain, les entreprises que nous qualifions de grandes se trouvent dans le bâtiment et dans l'industrie du vêtement alors que pour la Haute-Savoie et Genève, on les rencontre dans la mécanique, l’horlogerie et le bâtiment."
                            },
                            {
                                "example_id": "e2398dc9-510e-47ac-a388-865786a7e2df",
                                "sense_id": "0d44877e-ee6a-3363-ba8e-1b4d6de42cc1",
                                "text": "Le département de l’Ain, créé le 25.01.1790, est limité à l’est et au sud par le Rhône, à l’ouest par la Saône et à l'est par la Suisse ; il couvre une superficie de 582.560 ha qui englobe trois grandes régions géographiques : […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f7b874d5-1b71-4dea-b348-ea9810c75b94",
                        "source_entry_id": "e11ecdb4-ccfe-3baf-bace-860a379ab70a",
                        "source_sense_description": "Département français",
                        "target_lang_word": "Ain",
