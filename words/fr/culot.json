    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "427894e9-cbf8-3a56-a6ba-c08294b62517",
                    "sense_definition": "Grande audace, effronterie ou impudence.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "audace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut avoir un sacré <w>culot</w> pour oser mentir avec autant d'assurance."
                        },
                        {
                            "text": "Elle ne manque pas de <w>culot</w> en réclamant cette faveur après son comportement."
                        }
                    ],
                    "synonyms": [
                        "audace",
                        "effronterie",
                        "toupet",
                        "aplomb"
                    ],
                    "antonyms": [
                        "timidité"
                    ],
                    "common_phrases": [
                        "avoir du culot",
                        "manquer de culot",
                        "sacré culot"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "familier"
                        }
                    ]
                },
                {
                    "sense_id": "87eae840-c47c-32bf-a1ce-2f5857fe76dd",
                    "sense_definition": "Partie métallique inférieure d'une ampoule électrique servant à la fixer et à établir le contact dans la douille.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "electricite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avant d'acheter une nouvelle ampoule, vérifiez attentivement le diamètre de son <w>culot</w>."
                        },
                        {
                            "text": "Cette lampe de chevet ancienne nécessite une ampoule dotée d'un <w>culot</w> à vis spécifique."
                        }
                    ],
                    "common_phrases": [
                        "culot d'ampoule",
                        "culot à vis",
                        "culot à baïonnette"
                    ]
                },
                {
                    "sense_id": "12538bf8-1e61-3661-8964-5b2b109d539e",
                    "sense_definition": "Partie inférieure ou fond épais d'un récipient ou d'un objet.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fond",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le verre renforcé au <w>culot</w> de la carafe garantit sa stabilité sur la table."
                        },
                        {
                            "text": "Un résidu sombre s'est déposé au fond, dans le <w>culot</w> du flacon en verre."
                        }
                    ],
                    "synonyms": [
                        "fond",
                        "base"
                    ],
                    "antonyms": [
                        "sommet"
                    ],
                    "common_phrases": [
                        "culot de bouteille"
                    ]
                },
                {
                    "sense_id": "1a1efee0-407c-357e-a6ff-954f774fc7c7",
                    "sense_definition": "Résidu charbonneux et durci de tabac qui tapisse le fond du fourneau d'une pipe au fil des utilisations.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "tabac",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il gratte régulièrement le <w>culot</w> de sa pipe pour préserver la qualité de la fumée."
                        },
                        {
                            "text": "L'apparition progressive d'un bon <w>culot</w> permet d'éviter de brûler le bois de la pipe."
                        }
                    ],
                    "common_phrases": [
                        "culot de pipe"
                    ]
                },
                {
                    "sense_id": "a0203af3-8bf5-334a-b3a3-653b0ded712d",
                    "sense_definition": "Dernier-né d'une portée d'animaux, d'une couvée ou, par extension, d'une famille.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "dernier_ne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le petit oisillon est le <w>culot</w> de la nichée et demande une attention constante."
                        },
                        {
                            "text": "En tant que <w>culot</w> de la famille, il a toujours été particulièrement protégé par ses aînés."
                        }
                    ],
                    "synonyms": [
                        "benjamin",
                        "cadet"
                    ],
                    "antonyms": [
                        "aîné"
                    ],
                    "common_phrases": [
                        "culot de la famille",
                        "culot de la couvée"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "familier"
                        }
                    ]
                }
            ]
        }
    ]
}