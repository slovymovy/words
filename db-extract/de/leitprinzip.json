                "senses": [
                    {
                        "sense_id": "a4c818c3-ff44-3ef8-988d-6c5444ff5cd3",
                        "entry_id": "a6f3101c-7a8a-30f2-a1e6-d7e2cf7cd862",
                        "glosses": [
                            "Prinzip, von dem man sich leiten lässt/das man befolgt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4bbf752f-5461-4f91-972f-233547c7fbd7",
                                "sense_id": "a4c818c3-ff44-3ef8-988d-6c5444ff5cd3",
                                "text": "„Und wer fast ein Jahrtausend lang keine sicheren Grenzen hat, macht eben nicht Freiheit, sondern Sicherheit und die bekannten preußischen Tugenden Gehorsam, Pflichtbewusstsein und Unterordnung zu seinen Leitprinzipien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
