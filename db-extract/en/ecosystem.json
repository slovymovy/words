    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "6a0fdd84-a289-34ea-9ec3-17664492fcd0",
                "word": "ecosystem",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "913c89de-5b6a-471c-8351-910f43fc23ab",
                        "entry_id": "6a0fdd84-a289-34ea-9ec3-17664492fcd0",
                        "tags": [
                            "plural"
                        ],
                        "form": "ecosystems"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "24b64d02-ed46-32e3-aa82-cede5b28e931",
                        "entry_id": "6a0fdd84-a289-34ea-9ec3-17664492fcd0",
                        "glosses": [
                            "A system formed by an ecological community and its environment that functions as a unit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49b4f309-4812-4db4-a9ad-da8908945555",
                                "sense_id": "24b64d02-ed46-32e3-aa82-cede5b28e931",
                                "text": "Phoenix and Lubbock are both caught in severe drought, and it is going to get much worse. We may see many such [dust] storms in the decades ahead, along with species extinctions, radical disturbance of ecosystems, and intensified social conflict over land and water. Welcome to the Anthropocene, the epoch when humans have become a major geological and climatic force."
                            }
                        ]
                    },
                    {
                        "sense_id": "d50fdf31-4c92-3da2-84a2-4dcb0f40c29d",
                        "entry_id": "6a0fdd84-a289-34ea-9ec3-17664492fcd0",
                        "glosses": [
                            "The interconnectedness of organisms (plants, animals, microbes) with each other and their environment."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "589af36e-0b20-3396-96a1-ca293c14d54d",
                        "entry_id": "6a0fdd84-a289-34ea-9ec3-17664492fcd0",
                        "glosses": [
                            "A network of interconnected people, organizations, products or services that resembles a natural ecosystem due to the complex interdependencies."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "8806f454-75ac-4f1d-ba17-fe2ab6bffbd6",
                                "sense_id": "589af36e-0b20-3396-96a1-ca293c14d54d",
                                "text": "The company’s ecosystem mainly comprises its supply chain, customers, end consumers and competitors."
                            },
                            {
                                "example_id": "0c4dfe72-86b9-40fc-a023-9b2e19ab3a58",
                                "sense_id": "589af36e-0b20-3396-96a1-ca293c14d54d",
                                "text": "It [The Kashmir Files] is being described by the leftist “liberal” ecosystem as a movie that peddles bigotry against Muslims."
                            },
                            {
                                "example_id": "82e30c5c-204a-41c2-9007-c59d63068207",
                                "sense_id": "589af36e-0b20-3396-96a1-ca293c14d54d",
                                "text": "There is a certain duality in how the Hindutva ecosystem is pushing the anti-hijab discourse into the mainstream."
                            },
                            {
                                "example_id": "194af071-e192-4ddf-ac1a-07382cfce68e",
                                "sense_id": "589af36e-0b20-3396-96a1-ca293c14d54d",
                                "text": "Money mules play an important role in the scam ecosystem primarily to get money out of Singapore to the foreign syndicates and facilitate scams."
                            },
                            {
                                "example_id": "355142f8-c1cf-4e38-b945-79c380f48028",
                                "sense_id": "589af36e-0b20-3396-96a1-ca293c14d54d",
                                "text": "The result, as Maria Farrell and Robin Berjon put it in a striking essay in Noema magazine, is that our online spaces are no longer open ecosystems."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5305e76a-5083-4e89-ab90-230c48193300",
                        "source_entry_id": "6a0fdd84-a289-34ea-9ec3-17664492fcd0",
