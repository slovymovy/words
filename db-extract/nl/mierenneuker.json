                "senses": [
                    {
                        "sense_id": "3b724124-6893-3521-ab41-447dd38bdb09",
                        "entry_id": "97cb53df-a2ff-330a-a801-f44279aa7447",
                        "glosses": [
                            "Korinthenkacker, Ameisenficker, Erbsenzähler"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "984ab2d2-1983-4df8-bf72-2d73ed762e96",
                        "source_entry_id": "97cb53df-a2ff-330a-a801-f44279aa7447",
                        "source_sense_id": "3b724124-6893-3521-ab41-447dd38bdb09",
                        "target_lang_word": "Korinthenkacker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Korinthenkacker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fc71e431-82c3-3b52-ae08-80e4ee738a65",
                                        "entry_id": "6cdcd77b-1d74-332f-9d9a-10095816e5c4",
                                        "glosses": [
                                            "pedantischer, kleinlicher, perfektionistischer und rechthaberischer Mensch, der sich an unwichtigen Details festbeißt"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "716cffb0-d2f3-4bb8-a3f7-2b7b1ed28917",
                                                "sense_id": "fc71e431-82c3-3b52-ae08-80e4ee738a65",
                                                "text": "Person X: „Auf meinem Brötchen ist Nutella.“",
                                                "translation": "Person X: „Du bist ein echter Korinthenkacker.“"
                                            },
                                            {
                                                "example_id": "517aa3c8-bd3e-4fbf-91a0-ec706e2da35f",
                                                "sense_id": "fc71e431-82c3-3b52-ae08-80e4ee738a65",
                                                "text": "„Nach zehn Jahren Kampf gegen Kleinkarierte und Korinthenkacker sieht der Ombudsmann es als Erfolg an, dass viele nationale Behörden einen EU-einheitlichen Verhaltenskodex für gutes Verwaltungshandeln anwenden.“"
                                            },
                                            {
                                                "example_id": "bd3e5d5f-a916-4338-913c-12d6cdef7c0e",
                                                "sense_id": "fc71e431-82c3-3b52-ae08-80e4ee738a65",
                                                "text": "„»Juristen sind natürlich immer im Verdacht, jetzt solche Korinthenkacker zu sein, die da die Erbsen zählen und mit spitzem Bleistift unverständliche Schachtelsätze produzieren.«“"
                                            },
                                            {
                                                "example_id": "af2c288d-ae74-4840-a9bc-b6b28a0d5492",
                                                "sense_id": "fc71e431-82c3-3b52-ae08-80e4ee738a65",
                                                "text": "„1968 kommt der Broadway-Hit \"The Odd Couple\" (Ein seltsames Paar) auf die Leinwand. Die ganze Welt lacht sich schlapp über die Katastrophen-WG von Oscar, dem schlampigen Sportreporter und Felix, dem putzfimmeligen Korinthenkacker.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ad72547a-3ab0-4f7f-a3f4-f3831cb3f08e",
                        "source_entry_id": "97cb53df-a2ff-330a-a801-f44279aa7447",
                        "source_sense_id": "3b724124-6893-3521-ab41-447dd38bdb09",
                        "target_lang_word": "Ameisenficker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "307fbddd-3b08-4f4b-b492-e3b08b569770",
                        "source_entry_id": "97cb53df-a2ff-330a-a801-f44279aa7447",
                        "source_sense_id": "3b724124-6893-3521-ab41-447dd38bdb09",
                        "target_lang_word": "Erbsenzähler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erbsenzähler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e5b99fd4-4d1f-3832-a0b2-a3ece5dae7dd",
                                        "entry_id": "5957219e-1e11-3c49-aa39-565726be5c7c",
                                        "glosses": [
                                            "jemand, der übertrieben genau, pingelig, kleinlich, geizig ist"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e40c8c7d-6716-495e-84f0-d241c9853c6e",
                                                "sense_id": "e5b99fd4-4d1f-3832-a0b2-a3ece5dae7dd",
                                                "text": "„Seit seiner Gründung 1832 ist der Baedeker bekannt für Zuverlässigkeit und Genauigkeit. Autor und Verleger Karl Baedeker war ein Erbsenzähler in wörtlichem Sinne: Um die Stufen des Mailänder Doms zu zählen, steckte er alle 20 Schritte eine Erbse von der Westen- in die Hosentasche.“"
                                            },
                                            {
                                                "example_id": "5e9015fa-23c7-4b0b-ab54-afb7a1ce9d6b",
                                                "sense_id": "e5b99fd4-4d1f-3832-a0b2-a3ece5dae7dd",
                                                "text": "„In Deutschland dagegen werden ganze Zeitungen mit detailbesessenen Artikeln und Anzeigen gefüllt, minutiös bis ins Letzte und so politikbesessen langweilig, dass hier aus amerikanischer Sicht nur ein Erbsenzähler wie Al Gore mithalten könnte.“"
                                            },
                                            {
                                                "example_id": "9484849f-1b20-4983-a7fa-a0e6ecaaf357",
                                                "sense_id": "e5b99fd4-4d1f-3832-a0b2-a3ece5dae7dd",
                                                "text": "„Erbsenzähler sind übergenau, Mauerblümchen zu schüchtern und auf Hallodris ist kein Verlass. Überflieger lernen schnell, Nieten können gar nichts.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
