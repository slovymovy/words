                    ],
                    "antonyms": [
                        "беспамятство"
                    ],
                    "common_phrases": [
                        "прийти в чувства"
                    ],
                    "target_lang_definitions": {
                        "en": "A state of being conscious, aware of one's surroundings, and in control of one's mental and physical faculties."
                    },
                    "translations": {
                        "en": [
                            {
