                    "sense_id": "85007d29-ac5c-3a76-b937-cc5e9ae513de",
                    "sense_definition": "Extrêmement mauvais, très désagréable ou pénible.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "qualite_negative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le film que nous avons vu hier soir était vraiment <w>épouvantable</w>.",
                            "target_lang_translations": {
                                "en": "The film we watched last night was really <w>awful</w>.",
                                "ru": "Фильм, который мы смотрели вчера вечером, был действительно <w>ужасным</w>.",
                                "de": "Der Film, den wir gestern Abend gesehen haben, war wirklich <w>furchtbar</w>.",
                                "es": "La película que vimos ayer por la noche era realmente <w>horrible</w>.",
                                "zh": "我们昨晚看的那部电影真是<w>糟糕</w>透了。"
                            }
                        },
                        {
                            "text": "Nous sommes restés enfermés toute la journée à cause d'un temps <w>épouvantable</w>.",
