                    {
                        "translation_id": "d0223a08-58c9-4d36-b992-34ff8595b744",
                        "source_entry_id": "c054158a-c802-338f-8e0c-6407f69840df",
                        "source_sense_id": "9fe4bd65-ab9c-3584-9437-b6126b55edee",
                        "target_lang_word": "punter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "punter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ecf33ced-9ec0-3d42-94ee-76af7c0cdb8e",
                                        "entry_id": "6f223cfa-032b-31b4-a4f0-c8514121399f",
                                        "glosses": [
                                            "One who rows or poles a punt (pontoon)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "punter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e9bc36eb-ca74-3e28-a886-a5d76de2e4d8",
                                        "entry_id": "d91c177f-3c9b-3583-923a-bbc46215425f",
                                        "glosses": [
                                            "One who punts a football."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cca5058f-b729-3c55-9044-0d1135253f64",
                                        "entry_id": "d91c177f-3c9b-3583-923a-bbc46215425f",
                                        "glosses": [
                                            "A program used to forcibly disconnect another user from a chat room."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97d066f7-2f82-4ac7-b5a1-5250133999a6",
                                                "sense_id": "cca5058f-b729-3c55-9044-0d1135253f64",
                                                "text": "Punters generate hundreds of information inquiries to a legitimate user's client, such as invitations to chat. […] The user is punted from the channel, and must rejoin to gain access."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "punter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ec5ae35d-bbf7-34a0-b868-b151b4511b81",
                                        "entry_id": "03fe83d9-78c5-3576-bf8b-964802900582",
                                        "glosses": [
                                            "One who bets (punts) against the bank."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8a87ad65-173a-3d74-8200-d806dd469c93",
                                        "entry_id": "03fe83d9-78c5-3576-bf8b-964802900582",
                                        "glosses": [
                                            "One who gambles or bets."
                                        ],
                                        "tags": [
                                            "Commonwealth",
                                            "Ireland",
                                            "UK",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "848e4243-40a8-4e31-bfd0-cb87ea1a876c",
                                                "sense_id": "8a87ad65-173a-3d74-8200-d806dd469c93",
                                                "text": "[…] and having only peeped into a play-room at Baden-Baden when he hung on Dobbin's arm, and where, of course, he was not permitted to gamble, came eagerly to this part of the entertainment and hankered round the tables where the croupiers and the punters were at work."
                                            },
                                            {
                                                "example_id": "5a9a5601-be63-4a11-bf17-e9884e284e20",
                                                "sense_id": "8a87ad65-173a-3d74-8200-d806dd469c93",
                                                "text": "By Savernake the train was 4½min early; we then had the thrill of sweeping through Newbury at 95 m.p.h.—and one wonders if any of the punters on the neighbouring racecourse had any eyes for our flying cavalcade as we swept by, for it was a race day—[…]."
                                            },
                                            {
                                                "example_id": "d217625d-9f74-4f4f-97b2-020356cc3158",
                                                "sense_id": "8a87ad65-173a-3d74-8200-d806dd469c93",
                                                "text": "Punters know the house usually wins, but most have no idea that bookies sharpen their edge via something called “stake factoring”, the process by which winning customers are dialled down, while losers are allowed to bet more."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18bd0fb5-b126-3d22-b86e-c1d013e1f73f",
                                        "entry_id": "03fe83d9-78c5-3576-bf8b-964802900582",
                                        "glosses": [
                                            "A customer of a commercial establishment, frequently of a pub or (alternatively) of a prostitute."
                                        ],
                                        "tags": [
                                            "Commonwealth",
                                            "Ireland",
                                            "UK",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "adc2a573-3ccf-4ea8-8a0c-45b1107b44f9",
                                                "sense_id": "18bd0fb5-b126-3d22-b86e-c1d013e1f73f",
                                                "text": "She's working the streets like she does every night / Pulling in punters left and right"
                                            },
                                            {
                                                "example_id": "cf40f944-ea90-4fe5-9e88-a81d111ad4ff",
                                                "sense_id": "18bd0fb5-b126-3d22-b86e-c1d013e1f73f",
                                                "text": "Everybody knows your mum is a whore / Getting 'round Piccadilly looking for willy / Punters pull up and say \"don't be silly\""
                                            },
                                            {
                                                "example_id": "9ee000f3-0d95-42bd-be4b-3947b40a00dc",
                                                "sense_id": "18bd0fb5-b126-3d22-b86e-c1d013e1f73f",
                                                "text": "The number of UK pubs is falling and there is less consensus about how punters should behave. Here’s a guide to getting the most out of a trip to the boozer[.]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56507e4e-495a-3c65-a3b2-6cea64b524ef",
                                        "entry_id": "03fe83d9-78c5-3576-bf8b-964802900582",
                                        "glosses": [
                                            "A beginner or unskilled climber."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3aa4de41-2500-3b2b-a342-46c94b267e57",
                                        "entry_id": "03fe83d9-78c5-3576-bf8b-964802900582",
                                        "glosses": [
                                            "The person who keeps score in basset or ombre."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f92ba57f-f4d4-33a1-b24f-a98fb4db0f28",
                                        "entry_id": "03fe83d9-78c5-3576-bf8b-964802900582",
                                        "glosses": [
                                            "A person who trades with a gang but is not a gang member."
                                        ],
                                        "tags": [
                                            "Scotland"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3feca66-8bc2-4572-83d6-c6a91b81f8f4",
                                                "sense_id": "f92ba57f-f4d4-33a1-b24f-a98fb4db0f28",
                                                "text": "He had stolen 'trannies' (transistor radios) and hub caps from cars outside the main hotels in Glasgow, turning the collection into money through dealing with a 'punter' at Charing Cross."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "476b7cca-b86e-4854-88cc-21fb6910adae",
                        "source_entry_id": "c054158a-c802-338f-8e0c-6407f69840df",
                        "source_sense_id": "9fe4bd65-ab9c-3584-9437-b6126b55edee",
                        "target_lang_word": "hazardní hráč",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "8cfef328-11d9-4ddd-877c-6e80172a2eb9",
                        "source_entry_id": "c054158a-c802-338f-8e0c-6407f69840df",
                        "source_sense_id": "9fe4bd65-ab9c-3584-9437-b6126b55edee",
                        "target_lang_word": "joueur de hasard",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "4152de51-62fc-4281-81d5-ab9adf15368f",
                        "source_entry_id": "c054158a-c802-338f-8e0c-6407f69840df",
                        "source_sense_id": "9fe4bd65-ab9c-3584-9437-b6126b55edee",
                        "target_lang_word": "parieur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "parieur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6885570a-a965-3a3d-9470-90edf5bf3866",
                                        "entry_id": "12875131-b578-3919-b56d-ba33a06a1486",
                                        "glosses": [
                                            "Personne qui parie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d793b00-28bb-4ecb-a1e6-93fce687588c",
                                                "sense_id": "6885570a-a965-3a3d-9470-90edf5bf3866",
                                                "text": "Les matches se disputaient au milieu d'un grand vacarme produit par les cris des parieurs comme les parties de chistera en Espagne."
                                            },
                                            {
                                                "example_id": "46298f0b-098f-4f27-b1b4-346cf380b25c",
                                                "sense_id": "6885570a-a965-3a3d-9470-90edf5bf3866",
                                                "text": "Toursène s’acharnait, comme un parieur qui, dans l’égarement de sa passion et contre tout bon sens va jusqu’à son dernier afghani."
                                            },
                                            {
                                                "example_id": "8465a8be-4d76-48e1-b061-335ad414c446",
                                                "sense_id": "6885570a-a965-3a3d-9470-90edf5bf3866",
                                                "text": "Chacun peut s'adonner aux joies des paris. Il faut alors entendre les hurlements des parieurs, et les cris des spectateurs. Seul un habitué des gallodromes est capable de comprendre ce qui est en train de se passer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
