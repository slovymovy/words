                    "frequency": "Middle",
                    "semantic_group_id": "repraesentation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Als offizielle <w>Vertreterin</w> der Schule nahm sie an der Konferenz teil."
                        },
                        {
                            "text": "Wenn die Chefin krank ist, übernimmt ihre <w>Vertreterin</w> alle wichtigen Aufgaben."
                        }
                    ],
                    "synonyms": [
                        "Repräsentantin",
                        "Stellvertreterin"
                    ],
                    "common_phrases": [
