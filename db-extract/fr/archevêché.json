                    }
                ],
                "senses": [
                    {
                        "sense_id": "50f1ea72-ac38-392d-8677-1e25e532d296",
                        "entry_id": "b77191b4-c47c-3f83-b82b-b9b164ed47aa",
                        "glosses": [
                            "Étendue de territoire sous l’autorité spirituelle d’un archevêque."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9631134a-5d43-4e74-b331-242b62b31d85",
                                "sense_id": "50f1ea72-ac38-392d-8677-1e25e532d296",
                                "text": "Cette cure est dans l’archevêché de Paris."
                            },
                            {
                                "example_id": "e659dc40-4048-4b41-9a05-f4f467bc51f9",
                                "sense_id": "50f1ea72-ac38-392d-8677-1e25e532d296",
                                "text": "C’est en 1197 que la seigneurie de Dieppe entra dans le temporel de l’archevêché de Rouen."
                            }
                        ]
                    },
                    {
                        "sense_id": "1c98c846-c5c9-3591-a816-94f4cacf6816",
                        "entry_id": "b77191b4-c47c-3f83-b82b-b9b164ed47aa",
                        "glosses": [
                            "Ville où est un siège archiépiscopal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6203bb7b-d9ff-48ef-8806-3d863fc49d1c",
                                "sense_id": "1c98c846-c5c9-3591-a816-94f4cacf6816",
                                "text": "Besançon est un archevêché."
                            },
                            {
                                "example_id": "5aefc583-244f-4c34-8c26-2a8930e56774",
                                "sense_id": "1c98c846-c5c9-3591-a816-94f4cacf6816",
                                "text": "Les deux archevêchés de l'Église d'Angleterre sont à Canterbury et à York."
                            }
                        ]
                    },
                    {
                        "sense_id": "5ccbd00a-31ec-3e60-bafc-fc14db72e756",
                        "entry_id": "b77191b4-c47c-3f83-b82b-b9b164ed47aa",
                        "glosses": [
                            "Demeure, palais de l’archevêque."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c0364c7-c407-44b5-9021-44e58a1e786c",
                                "sense_id": "5ccbd00a-31ec-3e60-bafc-fc14db72e756",
                                "text": "Je vais à l’archevêché. Dans la cour de l’archevêché."
                            }
                        ]
                    },
                    {
                        "sense_id": "7135335d-3379-356d-9f8e-6c539551066d",
                        "entry_id": "b77191b4-c47c-3f83-b82b-b9b164ed47aa",
                        "glosses": [
                            "Dignité d’archevêque."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ba5e433b-0e67-3928-bba6-875306d93828",
                        "entry_id": "b77191b4-c47c-3f83-b82b-b9b164ed47aa",
                        "glosses": [
                            "Droits et des revenus temporels attachés à l’archevêché."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44a55455-e4f4-4e5a-ae76-a27ab0e63b62",
                                "sense_id": "ba5e433b-0e67-3928-bba6-875306d93828",
                                "text": "Il obtint un archevêché. Un bon archevêché."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "efda58a4-4f7c-4734-b88c-5e718ff12da5",
                        "source_entry_id": "b77191b4-c47c-3f83-b82b-b9b164ed47aa",
                        "target_lang_word": "Erzbistum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erzbistum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "22aa5814-e42f-3d54-b33a-fbdcd1cd8426",
                                        "entry_id": "b1159b0c-5655-3b5d-bc2b-edb9cf144ccf",
                                        "glosses": [
                                            "kirchlicher Verwaltungsbezirk eines Erzbischofs; Sitz/Diözese des Vorstehers einer Kirchenprovinz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e117b16-baf3-4687-adc6-9b05a6903971",
                                                "sense_id": "22aa5814-e42f-3d54-b33a-fbdcd1cd8426",
                                                "text": "In Deutschland gibt es folgende Erzbistümer: Berlin, Hamburg, Köln, Paderborn, Freiburg i. Br., München-Freising und Bamberg."
                                            },
                                            {
                                                "example_id": "7cb57ca7-3bef-4892-8721-1127d07a6daf",
                                                "sense_id": "22aa5814-e42f-3d54-b33a-fbdcd1cd8426",
                                                "text": "„Am 1. Oktober 948 wurde auf dem Reichstage in Magdeburg das Bistum Havelberg als Suffraganbistum zunächst der Diözese Mainz, seit 968 des neu geschaffenen Erzbistums Magdeburg begründet.“"
                                            },
                                            {
                                                "example_id": "3d7e74f9-9291-4b37-b866-0449eaef80e3",
                                                "sense_id": "22aa5814-e42f-3d54-b33a-fbdcd1cd8426",
                                                "text": "„Zum Kloster gehörte auch der oberhalb gelegene Berghof, lange Zeit auch als Dechantshof bezeichnet, weil ihn im 13. Jahrhundert der Dechant vom Florins-Stift erwarb, der ihn später an das Erzbistum verkaufte.“"
                                            },
                                            {
                                                "example_id": "915bc8ec-2a2c-4c2f-b9cc-ff20446a1849",
                                                "sense_id": "22aa5814-e42f-3d54-b33a-fbdcd1cd8426",
                                                "text": "„Es ist eine Ausgabe der Beschlüsse der gleichermaßen verfassungsgeschichtlich und kirchenrechtlich für das Erzbistum Mainz wegweisenden Provinzialsynode, die vom 11. bis 13. Mai 1310 unter dem Vorsitz des Mainzer Erzbischofes Peter von Aspelt in Mainz abgehalten wurde.“"
                                            },
                                            {
                                                "example_id": "891b882c-cceb-4209-8343-d5d4a01343c4",
                                                "sense_id": "22aa5814-e42f-3d54-b33a-fbdcd1cd8426",
                                                "text": "„Das Erzbistum Bamberg […] half dem Priester Dieter Scholz, gegen den zwei Jungen 1963 Missbrauchsvorwürfe erhoben hatten, in Bolivien als Missionar zu arbeiten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e579850e-9fbf-4e7e-8fcf-cc11d29f1b86",
                        "source_entry_id": "b77191b4-c47c-3f83-b82b-b9b164ed47aa",
