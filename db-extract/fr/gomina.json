                                    },
                                    {
                                        "sense_id": "b7d15805-2ea6-3745-b380-b3ac4256c741",
                                        "entry_id": "5ae05a46-e4d7-356a-b280-1e85a598ad89",
                                        "glosses": [
                                            "To develop a rapport."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f94fdb6-3940-4cf3-8ff5-847de50f5b2f",
                                                "sense_id": "b7d15805-2ea6-3745-b380-b3ac4256c741",
                                                "text": "He was a nice guy, and I got on OK with his friends, but the two of us never really gelled."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98633282-056e-39a4-870f-a02447d4f851",
                                        "entry_id": "5ae05a46-e4d7-356a-b280-1e85a598ad89",
                                        "glosses": [
                                            "To come together to form something; to cohere."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cdb02cd9-4bae-435e-978c-f55b67d79b63",
                                                "sense_id": "98633282-056e-39a4-870f-a02447d4f851",
                                                "text": "We put our ideas together and they eventually gelled into a saleable product."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
