                        ],
                        "examples": [
                            {
                                "example_id": "02456f7e-0fc0-4c44-978f-42337cb0eab4",
                                "sense_id": "6cfee727-d78d-3f9d-b8e2-37ff0623ff59",
                                "text": "Morfeusz uchodził za syna Hypnosa, boga snu."
                            },
                            {
                                "example_id": "ecf906a7-699a-40e1-92a7-f2da57242fdf",
                                "sense_id": "6cfee727-d78d-3f9d-b8e2-37ff0623ff59",
                                "text": "W sztukach plastycznych Morfeusz bywa przedstawiany jako uskrzydlona istota."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
