                                        "examples": [
                                            {
                                                "example_id": "245c3e5d-5dc8-44db-9013-55e785ce51fe",
                                                "sense_id": "2866a4e4-fc3b-3cf5-8e01-bcd459044f0e",
                                                "text": "Having a tattoo or a bomberjack with the text '1312' or 'ACAB' (All Cops Are Bastards)."
                                            },
                                            {
                                                "example_id": "200a34ff-628d-4dbe-a33d-0d016687d959",
                                                "sense_id": "2866a4e4-fc3b-3cf5-8e01-bcd459044f0e",
                                                "text": "One group is simply called 'ACAB'; the other is called 'Visitors 1312'. The latter was formed from the amalgamation of two groups, '1312' and 'Visitors'. '1312' is significant because it refers to the numerical positions in the alphabet of the letters comprising 'ACAB'."
                                            }
                                        ]
