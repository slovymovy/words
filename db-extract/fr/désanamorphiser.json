                ],
                "senses": [
                    {
                        "sense_id": "81c3a47a-85e2-394d-8498-29e4de37fa92",
                        "entry_id": "15683a08-0fc6-3ed8-9b39-d1d6d6aecdbc",
                        "glosses": [
                            "Faire revenir à l’état d’origine quelque chose qui avait été anamorphisé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92dd9894-2c67-43cc-8bb6-359e3e80d33c",
                                "sense_id": "81c3a47a-85e2-394d-8498-29e4de37fa92",
                                "text": "À la lecture le téléviseur ou le vidéoprojecteur 16/9 désanamorphise l’image pour lui redonner ses dimensions au rapport 16/9."
                            },
                            {
                                "example_id": "0f081fa7-fba5-4dca-b56c-ba19666372bb",
                                "sense_id": "81c3a47a-85e2-394d-8498-29e4de37fa92",
                                "text": "Ce que tu ne veux pas comprendre c’est que désanamorphiser l'image pour la réencoder va la détériorer quoi qu’il arrive, seule la LECTURE de cette image pour la remettre dans sa résolution originale par une carte vidéo est efficace."
                            },
                            {
                                "example_id": "e97df7fb-f40b-4ced-a506-0657d808108d",
                                "sense_id": "81c3a47a-85e2-394d-8498-29e4de37fa92",
                                "text": "En fait s’il s’agit d’un film, le format est un 16/9 dans un format 4/3, il y a donc anamorphisme et le plasma va d’abord désanamorphiser le signal, passant de 768*576 à 1024*576, puis de 1024*576 à 852*480: ce qui du coup est plus simple et se trouve être un \"down\"scale."
                            }
                        ]
                    }
                ],
