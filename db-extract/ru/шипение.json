                "senses": [
                    {
                        "sense_id": "0395ebb6-03c3-3cf7-8f24-4d799f3e1c20",
                        "entry_id": "e9e012de-d61e-3131-8953-789079c1bc22",
                        "glosses": [
                            "действие по значению гл. шипеть"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "4e842863-01f6-31ca-9391-7879badacf5f",
                        "entry_id": "e9e012de-d61e-3131-8953-789079c1bc22",
                        "glosses": [
                            "звуки, возникающие в процессе такого действия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "554dc3c5-ca5c-4cdb-bc19-65542f969ea2",
                                "sense_id": "4e842863-01f6-31ca-9391-7879badacf5f",
                                "text": "На фоне его движения, на фоне этого беспрестанного шума шагания, мы слышали трамвайные звонки, скрип тормозов, шипение, создаваемое скольжением троллейбусных контактных антенн по электрическим проводам."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cf8ed573-304a-451e-ab65-b44fecb0ba5d",
                        "source_entry_id": "e9e012de-d61e-3131-8953-789079c1bc22",
                        "target_lang_word": "fizzle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fizzle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3fd43a78-4ea1-3d55-82f3-90bb84068e0e",
                                        "entry_id": "56d38170-abcc-3ee9-981b-b1d988c8050d",
                                        "glosses": [
                                            "To sputter or hiss."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac028e8d-804b-4a87-a390-dd0cebd4d7a0",
                                                "sense_id": "3fd43a78-4ea1-3d55-82f3-90bb84068e0e",
                                                "text": "The soda fizzled for several minutes after it was poured."
                                            },
                                            {
                                                "example_id": "55c60b82-ff1a-4799-9574-8c3653904826",
                                                "sense_id": "3fd43a78-4ea1-3d55-82f3-90bb84068e0e",
                                                "text": "It is the easest thing, sir, to be done, / As plain as fizzling."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a10a16b-0048-3d5b-867e-5cef99656adf",
                                        "entry_id": "56d38170-abcc-3ee9-981b-b1d988c8050d",
                                        "glosses": [
                                            "To decay or die off to nothing; to burn out; to end less successfully than previously hoped."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f10ab2f3-85c3-4c80-a2e4-6e2c36e4c7cf",
                                                "sense_id": "7a10a16b-0048-3d5b-867e-5cef99656adf",
                                                "text": "The entire project fizzled after the founder quit."
                                            },
                                            {
                                                "example_id": "623ad98f-cc06-4881-8008-dd8a7b270296",
                                                "sense_id": "7a10a16b-0048-3d5b-867e-5cef99656adf",
                                                "text": "And so it fizzled to its close with Gary Cahill galloping around as an extra centre-forward, mutinous chants of “you’re not fit to wear the shirt,” from the England followers and Hodgson’s media staff announcing he would not take any questions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2c91b68-b354-3ff5-b1d0-0008a896d2a3",
                                        "entry_id": "56d38170-abcc-3ee9-981b-b1d988c8050d",
                                        "glosses": [
                                            "To fail to generate the expected yield when exploded during testing."
                                        ],
                                        "tags": [
                                            "of a nuclear weapon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ffa736fc-60d2-407e-a82a-c5f61f762021",
                                                "sense_id": "d2c91b68-b354-3ff5-b1d0-0008a896d2a3",
                                                "text": "The shot fizzled, generating only 200 tons rather than the 30 kilotons they were aiming for."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fizzle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e6d60033-3326-317c-91df-6847aa6eceb5",
                                        "entry_id": "b0ad8b16-9517-3d4d-9e5d-25c38ab90748",
                                        "glosses": [
                                            "A spluttering or hissing sound."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c6ec0f02-5a08-368a-b314-2a511b1c2774",
                                        "entry_id": "b0ad8b16-9517-3d4d-9e5d-25c38ab90748",
                                        "glosses": [
                                            "Failure of an exploding nuclear bomb to meet its expected yield during testing."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7f59ffe4-3008-3d86-bcf7-b5e618bda4e7",
                                        "entry_id": "b0ad8b16-9517-3d4d-9e5d-25c38ab90748",
                                        "glosses": [
                                            "An abortive effort; a flop or dud."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f0b7656f-5b73-34c8-9ad3-ab274b859f65",
                                        "entry_id": "b0ad8b16-9517-3d4d-9e5d-25c38ab90748",
                                        "glosses": [
                                            "A state of agitation or worry."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7d3382ae-bb91-4183-8df4-abb21e586dc0",
                        "source_entry_id": "e9e012de-d61e-3131-8953-789079c1bc22",
                        "target_lang_word": "Zischen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zischen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "60756e79-c30a-332b-a153-d031e2a8ff26",
                                        "entry_id": "68ab46b9-0a0d-33d4-8ffb-22eb5b0649d3",
                                        "glosses": [
                                            "zischendes Geräusch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c8f53f5-396f-448c-a93e-ad0a74b37c24",
                                                "sense_id": "60756e79-c30a-332b-a153-d031e2a8ff26",
                                                "text": "„Er war schon recht angeheitert, und das Rauschen der Bäume zu beiden Seiten der Allee erinnerte ihn an das Zischen von Schlangen.“"
                                            },
                                            {
                                                "example_id": "d703708c-bb93-4c20-97e1-d7e05ce8c743",
                                                "sense_id": "60756e79-c30a-332b-a153-d031e2a8ff26",
                                                "text": "„Falls ein verräterisches Geräusch ertönt - ein Knurren, ein Zischen, ein hasserfüllter Schrei -, wird sie es wohl kaum rechtzeitig aus dem Tumult des Sturms heraushören, um sich zu retten.“"
                                            },
                                            {
                                                "example_id": "cb791ff4-a1c3-486c-9206-ec5bb447ee7a",
                                                "sense_id": "60756e79-c30a-332b-a153-d031e2a8ff26",
                                                "text": "„Ich stürzte nach hinten, schlug mit der Schulter gegen eine Kiste und hörte das Geschöpf nur Zentimeter von mir entfernt mit einem triumphierenden Zischen vorbeischlurfen.“"
                                            },
                                            {
                                                "example_id": "c3307371-a38a-4905-a324-b186b93b94bc",
                                                "sense_id": "60756e79-c30a-332b-a153-d031e2a8ff26",
                                                "text": "„Mit langgezogenem Zischen flog die Leuchtkugel im Bogen in die Düsternis empor und explodierte irgendwo über dem Wasser zu einem trüben Licht, das eine Zeitlang am Himmel hing.“"
                                            },
                                            {
                                                "example_id": "de138184-5710-45b3-9ea8-72d226d1a223",
                                                "sense_id": "60756e79-c30a-332b-a153-d031e2a8ff26",
                                                "text": "„Mein Weg kreuzte den Strom der Automobile, das Zischen und Knurren ihrer Reifen, den stotternden Donner der Motorbremsen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3566b7ec-b3d8-4576-87aa-da1478a567d0",
                        "source_entry_id": "e9e012de-d61e-3131-8953-789079c1bc22",
                        "target_lang_word": "sifflement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sifflement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "de24944b-fd21-320c-9385-7146ced7a86e",
                                        "entry_id": "06ff30db-e42a-3a77-81db-6489b08c833b",
                                        "glosses": [
                                            "Bruit que l’on fait en sifflant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1a2afdb-3bb9-463b-823f-966c1090846b",
                                                "sense_id": "de24944b-fd21-320c-9385-7146ced7a86e",
                                                "text": "Il détaillait ma beauté, un cri d'extase pour mes yeux, un béement prolongé pour mes mains, un sifflement coquin pour mes jambes, un silence bien préparé pour ma poitrine."
                                            },
                                            {
                                                "example_id": "fd9d9c85-faf2-482b-b9e8-9c3aafe3c1a2",
                                                "sense_id": "de24944b-fd21-320c-9385-7146ced7a86e",
                                                "text": "Il nous étourdit par ses sifflements continuels."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d11dbd98-fd83-310b-bd04-f794cb8b89e8",
                                        "entry_id": "06ff30db-e42a-3a77-81db-6489b08c833b",
                                        "glosses": [
                                            "Bruit que quelques animaux font en sifflant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad503602-4c0f-4922-8316-d0681fa151d0",
                                                "sense_id": "d11dbd98-fd83-310b-bd04-f794cb8b89e8",
                                                "text": "Le sifflement des serpents. Le sifflement des oies, du merle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf6db72c-54ca-396d-95a9-cdeb1c5cb557",
                                        "entry_id": "06ff30db-e42a-3a77-81db-6489b08c833b",
                                        "glosses": [
                                            "Bruit aigu que font diverses choses, comme le vent, une flèche, une balle de fusil, une pierre lancée avec force, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9db3ac0-5a4b-4fb7-b9a9-0b642df43947",
                                                "sense_id": "cf6db72c-54ca-396d-95a9-cdeb1c5cb557",
                                                "text": "Les éventails qui se ferment et s’épanouissent produisent un petit sifflement qui, répété plus de mille fois par minute, jette sa note à travers la confuse rumeur qui flotte sur la promenade, et a quelque chose d’étrange pour une oreille française."
                                            },
                                            {
                                                "example_id": "9baf5601-1a4b-4530-822c-e4edb599f233",
                                                "sense_id": "cf6db72c-54ca-396d-95a9-cdeb1c5cb557",
                                                "text": "Des sifflements aigus, passant entre les jointures des portes et des fenêtres, s’élevaient parfois jusqu’à la limite des sons perceptibles. Puis, un grand silence se faisait."
                                            },
                                            {
                                                "example_id": "28030a64-3ce5-4a9c-91ba-5bdbe39e91a3",
                                                "sense_id": "cf6db72c-54ca-396d-95a9-cdeb1c5cb557",
                                                "text": "Bitche n’est plus qu’une vaste fournaise : le sifflement des obus, les craquements de l’incendie, l’effondrement des maisons, […] toutes les terreurs, tous les fracas emplissent l’air."
                                            },
                                            {
                                                "example_id": "1834d499-9c12-418f-883d-c52f93780910",
                                                "sense_id": "cf6db72c-54ca-396d-95a9-cdeb1c5cb557",
                                                "text": "Et puis le silence , ce grand silence qui plane au-dessus des solitudes islandaises , et que trouble seul le sifflement du vent ou le cri des pluviers dorés."
                                            },
                                            {
                                                "example_id": "f9df0b07-cd9c-4e11-804f-37c7558717fc",
                                                "sense_id": "cf6db72c-54ca-396d-95a9-cdeb1c5cb557",
                                                "text": "À chaque coup de roulis ou de tangage le hurlement continu du vent s’amplifiait d’un sifflement sinistre […]"
                                            },
                                            {
                                                "example_id": "bd2faf20-6af8-41ce-8087-5e21a666d4a7",
                                                "sense_id": "cf6db72c-54ca-396d-95a9-cdeb1c5cb557",
                                                "text": "Il est bien clair qu’à ce balcon, avec un pare-balles à droite, et sans m’occuper beaucoup des sifflements et claque­ments, je ne pensais qu’à bien faire mon métier de guetteur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7b0b5b9-b424-359e-9232-91d6cf34dc37",
                                        "entry_id": "06ff30db-e42a-3a77-81db-6489b08c833b",
                                        "glosses": [
                                            "Certain bruit aigu que l’homme et quelques animaux font lorsqu’ils respirent avec peine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae3396d6-c0ff-4483-bf97-52379707d230",
                                                "sense_id": "d7b0b5b9-b424-359e-9232-91d6cf34dc37",
                                                "text": "Il procédait à de profondes aspirations puis rejetait l’air en produisant une espèce de sifflement particulier […] Ce sifflement est, je crois, particulier aux plongeurs tuamotus et je peux lui concevoir d’autre utilité que d’aider à régulariser la respiration."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9d316c71-e35c-4f49-8e81-54a0d6d99471",
                        "source_entry_id": "e9e012de-d61e-3131-8953-789079c1bc22",
                        "target_lang_word": "grésillement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grésillement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ffadef51-54bb-37b1-ae21-d488f3b170bd",
                                        "entry_id": "cb663eab-d35d-39eb-b4d8-50588168f4f3",
                                        "glosses": [
                                            "Action de grésiller ou résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb4ce5ed-c86e-4ef8-b6f1-55405c508880",
                                                "sense_id": "ffadef51-54bb-37b1-ae21-d488f3b170bd",
                                                "text": "Le silence était si profond dans cette pièce qu'elle entendait le léger grésillement du néon."
                                            },
                                            {
                                                "example_id": "f1ca5369-5351-4e90-b7cf-7bd1c1b9d58f",
                                                "sense_id": "ffadef51-54bb-37b1-ae21-d488f3b170bd",
                                                "text": "[…] le grésillement du rasoir électrique le matin, […]"
                                            },
                                            {
                                                "example_id": "d26a1384-9d5b-48f8-ba85-58716cf6d406",
                                                "sense_id": "ffadef51-54bb-37b1-ae21-d488f3b170bd",
                                                "text": "Je suis assise sur le banc, enveloppée par l’obscurité, ses mains et son souffle chauds, et j’écoute les grillons, émerveillée de leur grésillement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6361ff68-6fa1-39ca-99aa-35dd1114d063",
                                        "entry_id": "cb663eab-d35d-39eb-b4d8-50588168f4f3",
                                        "glosses": [
                                            "Bruit confus et sans signification."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10bdc72f-fd54-435a-a5d8-12d42703e58b",
                                                "sense_id": "6361ff68-6fa1-39ca-99aa-35dd1114d063",
                                                "text": "Comme je possédais pour tout bagage ce que m’avait enseigné l’abbé Trécourt, je commençai par tâtonner difficilement à travers les systèmes de Descartes et de Spinoza. Parfois, ils m’emportaient très haut, dans l’infini : j’apercevais la terre à mes pieds comme une fourmilière et la littérature même devenait un vain grésillement ; parfois je n’y voyais que de maladroits échafaudages, sans rapport avec la réalité."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a89259b4-abef-4836-bca0-9e9a7ed1368e",
                        "source_entry_id": "e9e012de-d61e-3131-8953-789079c1bc22",
                        "target_lang_word": "chuintement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chuintement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dd359926-c49d-3aa7-841b-c21f23780ca4",
                                        "entry_id": "53289408-efd5-3a21-a4c6-eb49f7d79485",
                                        "glosses": [
                                            "Son d’une consonne qui chuinte."
                                        ],
                                        "tags": [
                                            "Phonétique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51d6b4e3-b993-4825-a160-f218bb40b66a",
                                                "sense_id": "dd359926-c49d-3aa7-841b-c21f23780ca4",
                                                "text": "Dans le Marlois, en effet, le traitement habituel du C devant A est le chuintement, et notamment quand il s’agit de toponymes."
                                            },
                                            {
                                                "example_id": "86eec0ac-19c2-4f31-b7a9-45a3873fc1fe",
                                                "sense_id": "dd359926-c49d-3aa7-841b-c21f23780ca4",
                                                "text": "Un léger chuintement gênait son élocution"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c21adf1c-3c02-351e-9a7b-c944b12fff6a",
                                        "entry_id": "53289408-efd5-3a21-a4c6-eb49f7d79485",
                                        "glosses": [
                                            "Cri de la chouette."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80c4a20c-2280-47ce-8c63-a55fda71db9b",
                                                "sense_id": "c21adf1c-3c02-351e-9a7b-c944b12fff6a",
                                                "text": "Il entendait aussi […], deux ou trois couples de ces funèbres hulottes, dont le chuintement retentissait comme une plainte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e2c797b-4449-3891-b61f-3b9746dd65ca",
                                        "entry_id": "53289408-efd5-3a21-a4c6-eb49f7d79485",
                                        "glosses": [
                                            "Bruit que produit quelque chose qui chuinte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f547758-f4a6-4dad-adf0-62df1204b317",
                                                "sense_id": "3e2c797b-4449-3891-b61f-3b9746dd65ca",
                                                "text": "M. Chavanais entendit le bruit des chaises, le claquement d’un chiffon, le chuintement du balai, des heurts d’assiettes tandis que son esprit retournait sous le dôme des rhododendrons."
                                            },
                                            {
                                                "example_id": "74bd1d48-0dd6-43d8-bc91-ef4c9c009f33",
                                                "sense_id": "3e2c797b-4449-3891-b61f-3b9746dd65ca",
                                                "text": "Je me suis mise à entendre un chuintement, comme si une radio cachée au fond de ma tête grésillait délicatement."
                                            },
                                            {
                                                "example_id": "d0a39c77-0bce-4fc3-9bf5-0d6c9d48f7a4",
                                                "sense_id": "3e2c797b-4449-3891-b61f-3b9746dd65ca",
                                                "text": "Le train est arrivé sur moi, tête baissée, entouré de vapeurs, d’éclairs d’acier noir, de clignements de roues et de chuintements engorgés."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f112a3be-44f5-470a-aef8-8738f1fa6700",
                        "source_entry_id": "e9e012de-d61e-3131-8953-789079c1bc22",
                        "target_lang_word": "pétillement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pétillement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a255a515-2fd7-3a68-8c94-f28ab5ac6579",
                                        "entry_id": "2212dc1d-96bf-3bd4-9696-ae0571fa1045",
                                        "glosses": [
                                            "Action de pétiller."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a84cba48-a9ee-4134-b99e-3f91cd68badf",
                                                "sense_id": "a255a515-2fd7-3a68-8c94-f28ab5ac6579",
                                                "text": "Mais, de cette vie flamboyante, aucune lueur n’arrivait à la surface, […]; mais les oreilles de la mère aveugle en entendirent les pétillements."
                                            },
                                            {
                                                "example_id": "8b5b4777-8f57-4bec-a3e4-08e88da9f50e",
                                                "sense_id": "a255a515-2fd7-3a68-8c94-f28ab5ac6579",
                                                "text": "Était-ce l’œil d’un oiseau de nuit borgne ? car il n’y avait qu’un point lumineux. Cette supposition ne satisfaisait pas Sigognac ; on eût dit le pétillement d’une mèche d’arquebuse allumée."
                                            },
                                            {
                                                "example_id": "4e6a52b6-592d-48ac-8ddc-61152b5836c0",
                                                "sense_id": "a255a515-2fd7-3a68-8c94-f28ab5ac6579",
                                                "text": "Jeanne croit lire dans les yeux de cette femme un pétillement d’ironie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
