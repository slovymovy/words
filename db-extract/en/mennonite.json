                        "translation_id": "5bcf7d4c-e9d9-4117-8780-03327adc257e",
                        "source_entry_id": "7518dbd0-aeef-3bec-98ec-8913cdd720d5",
                        "source_sense_id": "f0e7a0f5-b40e-3ba2-abda-8c62435c66d6",
