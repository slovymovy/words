                "senses": [
                    {
                        "sense_id": "08c27331-235e-33bc-a7ca-4001de4198d4",
                        "entry_id": "2a5f2f9e-84b6-3617-8ada-5ec192cd3c85",
                        "glosses": [
                            "Dispositif de véhicule automobile, utilisé pour allumer des cigares ou des cigarettes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30686ba8-aabe-494c-9106-8d912f4093b3",
                                "sense_id": "08c27331-235e-33bc-a7ca-4001de4198d4",
                                "text": "Dans la bagnole, ce qui a le plus intéressé Memphis Charles, c’est le paquet de Marlboro et l’allume-cigare automatique qu’elle a dégottés, le premier dans le vide-poches, le second au tableau de bord."
                            },
                            {
                                "example_id": "62029df9-9c73-4ad7-b6cf-fd1f73fe1691",
                                "sense_id": "08c27331-235e-33bc-a7ca-4001de4198d4",
                                "text": "Sa grosse paluche tatouée d’une araignée, comme celle qui lui couvrait la moitié du visage, prit une cigarette et l’allume-cigare du tableau de bord."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0c24db45-1e8e-4c4c-91a3-4087f257fdb9",
                        "source_entry_id": "2a5f2f9e-84b6-3617-8ada-5ec192cd3c85",
                        "source_sense_id": "08c27331-235e-33bc-a7ca-4001de4198d4",
                        "target_lang_word": "Zigarettenanzünder",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zigarettenanzünder",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "44f0ae4c-680a-3303-aee9-1947a34d2316",
                                        "entry_id": "c8be95a3-f76c-3e53-baac-4adeeab9b537",
                                        "glosses": [
                                            "Gerät in einem Kraftfahrzeug, mit dem man Zigaretten anzünden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48be8892-32dd-4253-948b-db75fbec40b8",
                                                "sense_id": "44f0ae4c-680a-3303-aee9-1947a34d2316",
                                                "text": "„Ich drückte den Zigarettenanzünder rein, steckte mir eine zwischen die Lippen und knipste das Autoradio an.“"
                                            },
                                            {
                                                "example_id": "a8e6d09a-f5dd-4008-975d-ec1c97d9e3ba",
                                                "sense_id": "44f0ae4c-680a-3303-aee9-1947a34d2316",
                                                "text": "„Der Zigarettenanzünder im Armaturenbrett springt glühend heraus, und der Mechaniker sagt, ich soll die Kerzen auf der Geburtstagstorte anzünden.“"
                                            },
                                            {
                                                "example_id": "9d30b26c-53e6-440b-a67c-b5819a14ffac",
                                                "sense_id": "44f0ae4c-680a-3303-aee9-1947a34d2316",
                                                "text": "„Es herrscht auch kein besonders dichter Verkehr. Daher stöpselt Hiro seinen Computer in den Zigarettenanzünder und riskiert einen Blick ins Metaversum.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
