                    {
                        "translation_id": "3d896148-19eb-4db6-8cd4-1df0743d1744",
                        "source_entry_id": "4055c564-d315-3720-8934-2882a315eafe",
                        "target_lang_word": "camionnette",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "camionnette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e90007b0-4e89-3817-9b89-f896735b1804",
                                        "entry_id": "43662909-fb7b-35c1-8cf3-bbb363d30f28",
                                        "glosses": [
                                            "Petit camion automobile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b64d18b7-c0da-45b5-9881-add09cca2221",
                                                "sense_id": "e90007b0-4e89-3817-9b89-f896735b1804",
                                                "text": "Il s'déplace avec sa camionnette, en pépère, et son commerce aux yeux des flics c'est d'trimballer des peaux d'lapin."
                                            },
                                            {
                                                "example_id": "15959430-ca2f-41c4-b0bb-887f8950fd29",
                                                "sense_id": "e90007b0-4e89-3817-9b89-f896735b1804",
                                                "text": "— Daillat nous emmenait dans la camionnette de son père… Ce soir-là, elle était allée à Nevers pour charger des porcs…"
                                            },
                                            {
                                                "example_id": "8b53a9ab-3cf9-4d87-972e-4b573ba5bdba",
                                                "sense_id": "e90007b0-4e89-3817-9b89-f896735b1804",
                                                "text": "Des études sur simulateur (Rudin-Brown, 2004 ; Rudin-Brown et McCurdie, 2004 ; Lee, 1995), ainsi que des études expérimentales, laissent penser que les conducteurs de véhicules tout-terrain, de pick-up et de camionnettes évaluent leur vitesse avec moins de précision, parce qu'ils sont assis plus haut, au-dessus de la chaussée, que les conducteurs de voitures particulières."
                                            },
                                            {
                                                "example_id": "2df43bb1-bc03-4fb9-be01-58303f806290",
                                                "sense_id": "e90007b0-4e89-3817-9b89-f896735b1804",
                                                "text": "Pris d’un zèle soudain, il redéposa son fardeau dans la camionnette, bondit à son volant, et dégagea le véhicule avec une telle brusquerie, qu’un conducteur, trop serré, freina brutalement, et l’agonit d'insultes."
                                            },
                                            {
                                                "example_id": "e6c098e1-051e-4035-927c-daa1424eb048",
                                                "sense_id": "e90007b0-4e89-3817-9b89-f896735b1804",
                                                "text": "La camionnette grise du général était garée sur le chemin privatif."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
