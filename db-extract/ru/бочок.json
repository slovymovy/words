                                        "sense_id": "d5aee5b8-e66f-3960-9526-214eb7a78b7f",
                                        "entry_id": "61201eca-3252-3810-a0de-b109a24f90cf",
                                        "glosses": [
                                            "To attack the flank(s) of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d7ca72ae-9619-35c7-8f91-360f93e6cf7d",
                                        "entry_id": "61201eca-3252-3810-a0de-b109a24f90cf",
                                        "glosses": [
                                            "To defend the flank(s) of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "14889803-3f7a-36fb-9c42-139aeb693fe2",
                                        "entry_id": "61201eca-3252-3810-a0de-b109a24f90cf",
                                        "glosses": [
                                            "To place to the side(s) of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e3cd8a2-abbb-4791-8a7d-a1f8ff40b756",
                                                "sense_id": "14889803-3f7a-36fb-9c42-139aeb693fe2",
                                                "text": "Stately colonnades are flank'd with trees."
                                            },
                                            {
                                                "example_id": "5d1ddcbb-e4af-43c0-a24b-2dd62cde0f2f",
                                                "sense_id": "14889803-3f7a-36fb-9c42-139aeb693fe2",
                                                "text": "[...] Mr. M. N. Rollason points out that on four-track lines on which the fast lines, in the centre, are flanked by the slow lines, and running at speed is permissible on all four, the traveller can enjoy some quite exciting experiences when trains are doing a \"neck-and-neck\" on adjacent lines."
                                            },
                                            {
                                                "example_id": "d7aaef51-f5ac-4010-850a-57b35fb4a549",
                                                "sense_id": "14889803-3f7a-36fb-9c42-139aeb693fe2",
                                                "text": "It was a rural railway that served the fertile Fens of Cambridgeshire and Norfolk. But because it flanked public roads and was unfenced (to save costs), it was deemed a tramway and its locomotives had to be fitted with a cowcatcher."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a771d42e-8502-371d-9a39-35845362cbf9",
                                        "entry_id": "61201eca-3252-3810-a0de-b109a24f90cf",
                                        "glosses": [
                                            "To be placed to the side(s) of something (usually in terms of two objects, one on each side)."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "flank",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eb39c743-132a-3d26-b802-61d07aa7e5b3",
                                        "entry_id": "93b91ee9-d47a-33e0-897c-769c95385ea6",
                                        "glosses": [
                                            "The lateral flesh between the last rib and the hip."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "afb42e3e-ce8d-425a-95f1-5217a7a761f4",
                                                "sense_id": "eb39c743-132a-3d26-b802-61d07aa7e5b3",
                                                "text": "Holonym: side"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50fdb66e-9a99-3fa9-af9f-f12614e694c8",
                                        "entry_id": "93b91ee9-d47a-33e0-897c-769c95385ea6",
                                        "glosses": [
                                            "A cut of meat from the flank of an animal."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "52447207-bfe0-3a83-a6b5-47832681355d",
                                        "entry_id": "93b91ee9-d47a-33e0-897c-769c95385ea6",
                                        "glosses": [
                                            "The extreme left or right edge of a military formation, army etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d7cbac0e-ded9-39e5-b9e4-c0a39757c4f1",
                                        "entry_id": "93b91ee9-d47a-33e0-897c-769c95385ea6",
                                        "glosses": [
                                            "The sides of a bastion perpendicular to the wall from which the bastion projects."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bcd52f5e-4cd8-327b-bf3c-6b9d2bb6b2c5",
                                        "entry_id": "93b91ee9-d47a-33e0-897c-769c95385ea6",
                                        "glosses": [
                                            "The side of something, in general senses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68ba20d6-fceb-498d-be90-cf847ebcc7d9",
                                                "sense_id": "bcd52f5e-4cd8-327b-bf3c-6b9d2bb6b2c5",
                                                "text": "Cautiously I approached the flank of the cliffs, where they terminated in an abrupt escarpment as though some all powerful hand had broken off a great section of rock and set it upon the surface of the earth."
                                            },
                                            {
                                                "example_id": "7af8a1fc-49cb-4067-bd14-9f0db4724110",
                                                "sense_id": "bcd52f5e-4cd8-327b-bf3c-6b9d2bb6b2c5",
                                                "text": "Ahead the flanks of the Pennines gleamed faintly in the moonlight, looking as though they themselves were part of some dry and deserted lunar landscape."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7d6612d-e0df-3d89-b4f4-36fec8a66cdd",
                                        "entry_id": "93b91ee9-d47a-33e0-897c-769c95385ea6",
                                        "glosses": [
                                            "Either of the two pockets located on the seat of a pair of pants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d99370c6-ff53-4ded-96f2-151281c675dd",
                                                "sense_id": "e7d6612d-e0df-3d89-b4f4-36fec8a66cdd",
                                                "text": "I took the quarter I found and hid in my right flank."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ef64771-e6fd-33ea-804c-8ab4882309d3",
                                        "entry_id": "93b91ee9-d47a-33e0-897c-769c95385ea6",
                                        "glosses": [
                                            "An ideological faction within a political party."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "becb1282-964d-4a17-81ed-bac89af97601",
                                                "sense_id": "1ef64771-e6fd-33ea-804c-8ab4882309d3",
                                                "text": "Ford survived a primary challenge in 1976 from the right flank of the Republican Party by Ronald Reagan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8ecaa3a-187d-3895-95b9-56a2bb6dac22",
                                        "entry_id": "93b91ee9-d47a-33e0-897c-769c95385ea6",
                                        "glosses": [
                                            "The outermost strip of a road."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "242f3e9d-f232-3fe7-bb7c-aa02f17d237b",
                                        "entry_id": "93b91ee9-d47a-33e0-897c-769c95385ea6",
                                        "glosses": [
                                            "The wing, one side of the pitch."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14a0c90d-1c87-441c-a5fd-80cb952bfb42",
                                                "sense_id": "242f3e9d-f232-3fe7-bb7c-aa02f17d237b",
                                                "text": "The hosts also had Paul Robinson to thank for a string of saves, three of them coming against Jerome Thomas, who gave Michel Salgado a torrid time down the left flank."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a81eacf6-b376-3cab-9c34-ba050d28c058",
                                        "entry_id": "93b91ee9-d47a-33e0-897c-769c95385ea6",
                                        "glosses": [
                                            "That part of the acting surface of a gear wheel tooth that lies within the pitch line."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
