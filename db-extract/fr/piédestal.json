        "fr-extract.jsonl": [
            {
                "entry_id": "7f08c2e9-a8a8-37b7-8e88-4894d758c0a3",
                "word": "piédestal",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "aa7a34aa-1ddc-4289-8407-4f756776aaf4",
                        "entry_id": "7f08c2e9-a8a8-37b7-8e88-4894d758c0a3",
                        "tags": [
                            "plural"
                        ],
                        "form": "piédestaux"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e552d1ed-477f-3451-8b30-338c5ab0baee",
                        "entry_id": "7f08c2e9-a8a8-37b7-8e88-4894d758c0a3",
                        "glosses": [
                            "Support isolé avec base et corniche, qui soutient une statue, une colonne, un candélabre, etc."
                        ],
                        "tags": [
                            "Sculpture"
                        ],
                        "examples": [
                            {
                                "example_id": "fd6f3356-0254-443c-b1c1-37e4cdf7100d",
                                "sense_id": "e552d1ed-477f-3451-8b30-338c5ab0baee",
                                "text": "Et tout autour du perron, en dehors, vingt-quatre piédestaux se rangeaient, supportant aussi des statues de jeunes filles, toutes admirablement belles, mais toutes attaquées et domptées par l’outrage d’un invisible ennemi."
                            },
                            {
                                "example_id": "acc2d3ed-aeab-4e7a-b482-73e6a799b033",
                                "sense_id": "e552d1ed-477f-3451-8b30-338c5ab0baee",
                                "text": "Le maitre fut de l'avis du serviteur et ils passèrent ensemble de l’autre côté du vaste piédestal de la colonne."
                            },
                            {
                                "example_id": "c7e87ffc-ef6d-4bc2-b1be-b8033f6f64fc",
                                "sense_id": "e552d1ed-477f-3451-8b30-338c5ab0baee",
                                "text": "Jamais P’tit-Bonhomme et Bob n’avaient vu pareille foule d’illustres personnages sur leurs piédestaux !"
                            },
                            {
                                "example_id": "8907ef4a-0939-4918-b14a-90be8f6fd6f0",
                                "sense_id": "e552d1ed-477f-3451-8b30-338c5ab0baee",
                                "text": "Agenouillées, elles fleurissent de nouvelles fleurs son piédestal moussu."
                            }
                        ]
                    },
                    {
                        "sense_id": "c6a510cc-731d-3452-9c8c-ef7aca710322",
                        "entry_id": "7f08c2e9-a8a8-37b7-8e88-4894d758c0a3",
                        "glosses": [
                            "Soubassement d’une file de colonnes avec base et corniche."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "9fa2340b-32b8-4067-a784-2c0df6e528bc",
                                "sense_id": "c6a510cc-731d-3452-9c8c-ef7aca710322",
                                "text": "Piédestal continu."
                            }
                        ]
                    },
                    {
                        "sense_id": "df580b7b-7a41-374f-9681-8d538dc4e500",
                        "entry_id": "7f08c2e9-a8a8-37b7-8e88-4894d758c0a3",
                        "glosses": [
                            "Ce qui sert à hausser quelqu’un, à le faire paraître."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "dbad2886-91cf-4e4f-b2ab-9db912ba57bd",
                                "sense_id": "df580b7b-7a41-374f-9681-8d538dc4e500",
                                "text": "Le président de cette république pavoise sur son piédestal."
                            },
                            {
                                "example_id": "5fec5512-dd43-4311-9867-b86dfdcaf846",
                                "sense_id": "df580b7b-7a41-374f-9681-8d538dc4e500",
                                "text": "[…] quand on aborde ce sujet, ils ressentent inconsciemment le vertige de leur ignorance et, tout aussi inconsciemment, rejettent un dossier qui pourrait les faire tomber de leur piédestal."
                            },
                            {
                                "example_id": "d1eeb5c0-1e0a-416c-8cc2-2ede50e0a19c",
                                "sense_id": "df580b7b-7a41-374f-9681-8d538dc4e500",
                                "text": "Ainsi, on se sent obligé de la remercier et de cette façon, elle remonte sur son piédestal…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d355ebe1-3c64-4a29-87d5-fbf590a916c7",
                        "source_entry_id": "7f08c2e9-a8a8-37b7-8e88-4894d758c0a3",
                        "target_lang_word": "Sockel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sockel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "92886213-4d0c-324c-b192-34735158aab6",
                                        "entry_id": "7fb5d712-fb2a-382f-8adf-7b6e831c5013",
                                        "glosses": [
                                            "ein Block, auf dem etwas liegen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a133dbe-b24f-450e-a76c-e4ac5db78705",
                                                "sense_id": "92886213-4d0c-324c-b192-34735158aab6",
                                                "text": "„Eine griechische Inschrift, die man auf einem Sockel in der Nähe des Obelisken gefunden hatte, legte die Vermutung nahe, der Obelisk sei im Namen von Ptolemaios und Kleopatra geweiht gewesen.“"
                                            },
                                            {
                                                "example_id": "3e11ad93-987b-439b-9478-ed2a9bf56180",
                                                "sense_id": "92886213-4d0c-324c-b192-34735158aab6",
                                                "text": "„In ihrem Sockel war eine Mechanik aus Rollen und Schnüren verborgen, mit der sie sich unter Wasser an langen Stangen führen ließ – zu nichts nütze in dieser Stadt, die auf Sand gebaut war.“"
                                            },
                                            {
                                                "example_id": "3826aded-ff26-4dc0-b1b4-6a8e26beb274",
                                                "sense_id": "92886213-4d0c-324c-b192-34735158aab6",
                                                "text": "„Jessie Wight zieht dauernd die Ranken vom Sockel weg, damit die Inschrift zu sehen ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e6e23aff-30d3-3aa3-b2e6-c1c95b56b145",
                                        "entry_id": "7fb5d712-fb2a-382f-8adf-7b6e831c5013",
                                        "glosses": [
                                            "Vorrichtung, um wichtige Bauteile schnell auf einer Grundplatte oder Platine befestigen und lösen zu können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cbd3bf4f-b8e1-4a3a-8de4-78634ca9b9c8",
                                                "sense_id": "e6e23aff-30d3-3aa3-b2e6-c1c95b56b145",
                                                "text": "Man drückt das Bauteil mit sanftem Druck in den Sockel."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "db3fb531-be3e-443c-a883-70b018a5b35f",
                        "source_entry_id": "7f08c2e9-a8a8-37b7-8e88-4894d758c0a3",
                        "target_lang_word": "Grundstein",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Grundstein",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1c2e3828-9591-3534-befc-29a284040a11",
                                        "entry_id": "3aa554b9-00be-3ed3-8520-1cbad74c6339",
                                        "glosses": [
                                            "der erste, beim Bau eines Gebäudes symbolisch gesetzte Stein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6796a9ae-1dc6-4a6d-987f-cae3a7813540",
                                                "sense_id": "1c2e3828-9591-3534-befc-29a284040a11",
                                                "text": "Der Grundstein für das neue Haus ist gelegt; jetzt kann uns nichts mehr aufhalten."
                                            },
                                            {
                                                "example_id": "994fa844-5ffb-47a7-b11d-03b28d897cce",
                                                "sense_id": "1c2e3828-9591-3534-befc-29a284040a11",
                                                "text": "„Neulich haben sie dort den Grundstein für ein Gebäude gelegt, das die städtische Gesellschaft Saga errichten lässt: 179 Wohnungen, barrierefrei, 6,10 Euro pro Quadratmeter kalt.“"
                                            },
                                            {
                                                "example_id": "957cdf1f-7a89-48c0-8ebd-41563239c372",
                                                "sense_id": "1c2e3828-9591-3534-befc-29a284040a11",
                                                "text": "„Die Gelder waren für den Bau der neuen Peterskirche vorgesehen, für die Julius 1506 den Grundstein gelegt hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "381f1ebb-9737-3f9f-80cf-8ef84a398710",
                                        "entry_id": "3aa554b9-00be-3ed3-8520-1cbad74c6339",
                                        "glosses": [
                                            "Grundlage, Basis, Ausgangspunkt"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94e43143-f326-4880-9992-0db5878ad0ae",
                                                "sense_id": "381f1ebb-9737-3f9f-80cf-8ef84a398710",
                                                "text": "Mit dem Ja-Wort haben sie den Grundstein für ihre Ehe gelegt."
                                            },
                                            {
                                                "example_id": "731cb594-e91e-416f-b5a9-676a3ae86fa2",
                                                "sense_id": "381f1ebb-9737-3f9f-80cf-8ef84a398710",
                                                "text": "In Kitas wird […] der Grundstein für eine erfolgreiche Schullaufbahn gelegt."
                                            },
                                            {
                                                "example_id": "b54a76a6-4dd7-4b45-86c4-6a4fe91535c6",
                                                "sense_id": "381f1ebb-9737-3f9f-80cf-8ef84a398710",
                                                "text": "„Nach der Ermordung Nader Schahs eilte Ahmad Schah nach Kandahar, wo er den Grundstein für die Errichtung des Durrani-Reiches legte.“"
                                            },
                                            {
                                                "example_id": "0cd8eb84-4c92-44e9-b046-c267fda51e62",
                                                "sense_id": "381f1ebb-9737-3f9f-80cf-8ef84a398710",
                                                "text": "Der Grundstein unseres Erfolgs ist der Zusammenhalt im Team."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "ca1709a5-5e1f-3851-b123-a65720417571",
                                        "entry_id": "3aa554b9-00be-3ed3-8520-1cbad74c6339",
                                        "glosses": [
                                            "unterster Teil der Säule, Sockel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf55fa28-c823-4145-b538-0f46952267cd",
                                                "sense_id": "ca1709a5-5e1f-3851-b123-a65720417571",
                                                "text": "Die Säule ist von ihrem Grundstein an 23 Meter hoch."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "3e8f00b2-898d-3765-8565-564507e4c326",
                                        "entry_id": "3aa554b9-00be-3ed3-8520-1cbad74c6339",
                                        "glosses": [
                                            "der untere Mühlstein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad98c718-a80d-4f13-83dd-3eed55307843",
                                                "sense_id": "3e8f00b2-898d-3765-8565-564507e4c326",
                                                "text": "Der Grundstein ist noch gut erhalten."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "36936fa8-6688-39e0-8329-e9550a638fe7",
                                        "entry_id": "3aa554b9-00be-3ed3-8520-1cbad74c6339",
                                        "glosses": [
                                            "grobe sandige Steinart, die mit viel Quarz durchmengt ist"
                                        ],
