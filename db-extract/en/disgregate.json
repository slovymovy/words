                "senses": [
                    {
                        "sense_id": "b36f7bb8-aba4-3a41-975b-8b20dd6cff33",
                        "entry_id": "401ef27b-4106-33bb-be2c-317f3936f717",
                        "glosses": [
                            "To disperse; to scatter."
                        ],
                        "tags": [
                            "obsolete",
                            "transitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "5e2a26e2-3ffb-3201-a3d6-535a47f45a6a",
                        "entry_id": "401ef27b-4106-33bb-be2c-317f3936f717",
                        "glosses": [
                            "To separate into individual parts, disjoin, disintegrate."
                        ],
                        "tags": [
                            "obsolete",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "4a2de032-377d-4974-8cce-5a8e86b8f9cc",
                                "sense_id": "5e2a26e2-3ffb-3201-a3d6-535a47f45a6a",
                                "text": "Heat, seems to consist of rare parts, and disgregates bodies."
                            }
                        ]
                    },
                    {
                        "sense_id": "122c9c29-1b85-3bcf-a0ed-dec06b13c9ae",
                        "entry_id": "401ef27b-4106-33bb-be2c-317f3936f717",
                        "glosses": [
                            "(according to obsolete theories of vision) To scatter or make divergent (visual rays); (by extension) to dazzle, confuse, dim (the sight)."
                        ],
                        "tags": [
                            "obsolete",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "8521fb46-3caf-439d-b8dd-892db31c1b7f",
                                "sense_id": "122c9c29-1b85-3bcf-a0ed-dec06b13c9ae",
                                "text": "Black doth congregat, unite, and fortifie the sight; the other doth disgregat, scatter, and enfeeble it."
                            }
                        ]
                    }
                ],
