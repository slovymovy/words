                        "glosses": [
                            "Qui n’est pas souhaitable, qu’il ne faut pas souhaiter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b65acf2d-d17a-47db-b08c-d4bd74c1189c",
                                "sense_id": "2b30ee37-5d8e-3ca6-a785-d8c64d245232",
                                "text": "En attendant une chimérique et insouhaitable langue universelle, une traduction utilitaire s’impose."
                            },
                            {
                                "example_id": "bc1f053e-0a61-43c3-a260-df4e666cc416",
                                "sense_id": "2b30ee37-5d8e-3ca6-a785-d8c64d245232",
                                "text": "La charrette est placée à la verticale, ce qui me donne la position saugrenue et insouhaitable d’un homme « couché debout »."
                            },
                            {
                                "example_id": "1c07df52-0061-44f4-b89a-26cba9c8ac5d",
                                "sense_id": "2b30ee37-5d8e-3ca6-a785-d8c64d245232",
                                "text": "Au début du IVème siècle de l’hégire, la pratique directe de l’ijtihâd sur le Coran et la sunna, devient insouhaitable sinon impossible."
                            }
                        ]
                    }
