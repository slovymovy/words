                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2771c3dd-098e-4836-85b9-c9551730e627",
                                "sense_id": "02def1b3-17d8-3fd3-8e8b-7f98457841d6",
                                "text": "Na znaczku z podobizną króla Władysława Łokietka z 1995 roku Kopecki umieścił ukryte wyznanie – „Mira – Moja Miłość\"."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
