            {
                "entry_id": "fdcd0e81-676f-3005-939d-068601d7645b",
                "word": "quintal",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6c537d1c-6b17-413c-9c13-1b430018775f",
                        "entry_id": "fdcd0e81-676f-3005-939d-068601d7645b",
                        "tags": [
