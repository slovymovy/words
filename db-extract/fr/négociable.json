                                        "glosses": [
                                            "Able to be transferred to another person, with or without endorsement, in exchange for money."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16dbca1e-dd5b-4d57-9fd8-e52fccc55ad1",
                                                "sense_id": "e48302a6-c977-35d7-9493-ec02bc190b4a",
                                                "text": "The court had to decide if a \"telecheck\" had been \"signed\" by the purported \"drawer,\" and in doing so the court had to determine whether a \"telecheck\" is a negotiable instrument[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de65d51a-e806-3141-b9c1-e78780e64ada",
                                        "entry_id": "63088ab9-5837-30ff-a091-e074e3c8b515",
                                        "glosses": [
                                            "Open to negotiation or bargaining."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "407076d7-8be7-4357-bf2c-e3c7577dd797",
                                                "sense_id": "de65d51a-e806-3141-b9c1-e78780e64ada",
                                                "text": "Salary is negotiable, according to education and experience."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
