                "senses": [
                    {
                        "sense_id": "47659d14-105e-38ff-ba2e-e63534a11225",
                        "entry_id": "fa93e8c9-86ad-391b-91ed-deb51a539f67",
                        "glosses": [
                            "Faire perdre à quelque chose son caractère lié à une élite."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f34f22cb-e6b3-48e5-abe0-25d1f0c1aab9",
                                "sense_id": "47659d14-105e-38ff-ba2e-e63534a11225",
                                "text": "Naturellement, on pense de façon épidermique, que la nouvelle idéologie aura pour tâche essentielle de désintellectualiser et de désélitiser l’École, donc de supprimer ce coût-là, du moment que la masse des individus aura l’accès libre devant l’Enseignement secondaire et devant l’Enseignement supérieur."
                            },
                            {
                                "example_id": "871c8a08-08ef-4a85-bd68-647680e61402",
                                "sense_id": "47659d14-105e-38ff-ba2e-e63534a11225",
                                "text": "Le « sandwich » est un des moyens de désélitiser l’enseignement."
                            }
                        ]
                    }
