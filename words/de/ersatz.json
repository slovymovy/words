                    "frequency": "High",
                    "semantic_group_id": "substitut",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Da unser Stammtorhüter verletzt war, spielte heute ein junger Kollege als <w>Ersatz</w>."
                        },
                        {
                            "text": "Für das defekte Gerät schickte der Kundenservice umgehend einen kostenlosen <w>Ersatz</w>."
                        }
                    ],
                    "synonyms": [
