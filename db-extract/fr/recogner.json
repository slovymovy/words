                ],
                "senses": [
                    {
                        "sense_id": "28d0b95a-9beb-3017-8c21-dbc467a64cec",
                        "entry_id": "405c5854-ae96-3d0f-8579-e98312a5e4a2",
                        "glosses": [
                            "Cogner à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ede114d7-cb93-41c4-803f-5be479b0afb5",
                                "sense_id": "28d0b95a-9beb-3017-8c21-dbc467a64cec",
                                "text": "Je me suis battu avec le petit porcher, l’autre jour, nous nous sommes roulés dans les champs, arraché les cheveux, cognés, et recognés, il m’a poché un œil, je lui ai engourdi une oreille, nous nous sommes relevés, pour nous retomber encore dessus !"
                            },
                            {
                                "example_id": "2b716827-88d3-4c3c-87b9-ed79bc36ec75",
                                "sense_id": "28d0b95a-9beb-3017-8c21-dbc467a64cec",
                                "text": "Je vais donc cogner à la porte la plus proche. Rien ne se passe. Je recogne."
                            }
                        ]
                    },
                    {
                        "sense_id": "133bf104-d4f9-3b51-8954-f8140b78b0e2",
                        "entry_id": "405c5854-ae96-3d0f-8579-e98312a5e4a2",
                        "glosses": [
                            "Mettre ensemble ce qui est épars."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20419fb8-4ff8-4302-8b87-29695512cbef",
                                "sense_id": "133bf104-d4f9-3b51-8954-f8140b78b0e2",
                                "text": "Cette masse de métal [un boulet de canon] est beaucoup de terre recognée en un petit canton"
                            }
                        ]
                    }
                ],
