                                "sense_id": "363d73dd-49f8-3b4a-aaab-969082327b1c",
                                "text": "Heute nachmittag habe ich mit meiner Freundin Veronika telefoniert."
                            },
                            {
                                "example_id": "3f04488c-7abf-4e3e-a880-19fb62384c88",
                                "sense_id": "363d73dd-49f8-3b4a-aaab-969082327b1c",
                                "text": "Veronika, der Lenz ist da, die Mädchen singen tralala! (Comedian Harmonists)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
