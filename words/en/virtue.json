{
    "word_family": [
        "virtuous",
        "virtuosity",
        "virtuoso"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8f8b61e1-c9c7-3b82-86ba-e7c637d276a7",
                    "sense_definition": "Behavior showing high moral standards; conformity of behavior or thought with the strictures of morality.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "moral_excellence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The philosopher argued that <w>virtue</w> is an inner light that can prevail in every soul.",
                            "target_lang_translations": {
                                "ru": "Философ утверждал, что <w>добродетель</w> — это внутренний свет, который может возобладать в каждой душе."
                            }
                        },
                        {
                            "text": "He lived a life of <w>virtue</w> and was respected by everyone in the community.",
                            "target_lang_translations": {
                                "ru": "Он прожил жизнь в <w>добродетели</w>, и его уважали все в округе."
                            }
                        }
                    ],
                    "synonyms": [
                        "goodness"
                    ],
                    "antonyms": [
                        "vice"
                    ],
                    "common_phrases": [
                        "path of virtue",
                        "reward of virtue"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поведение, демонстрирующее высокие моральные стандарты; соответствие поступков или мыслей нормам нравственности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "добродетель",
                                "target_lang_sense_clarification": "высокая нравственность"
                            },
                            {
                                "target_lang_word": "нравственность",
                                "target_lang_sense_clarification": "соблюдение моральных норм"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4116b1ac-3b4d-317d-b617-80f249ec4c8a",
                    "sense_definition": "A particular commendable quality or admirable trait in a person's character.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "moral_excellence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Patience is a <w>virtue</w> that many people find difficult to master in modern times.",
                            "target_lang_translations": {
                                "ru": "Терпение — это <w>добродетель</w>, которую многим людям трудно освоить в наше время."
                            }
                        },
                        {
                            "text": "She possessed the <w>virtue</w> of honesty, always speaking the truth even when it was hard.",
                            "target_lang_translations": {
                                "ru": "Она обладала таким <w>достоинством</w>, как честность, всегда говоря правду, даже когда это было нелегко."
                            }
                        }
                    ],
                    "synonyms": [
                        "thew"
                    ],
                    "antonyms": [
                        "foible"
                    ],
                    "common_phrases": [
                        "patience is a virtue",
                        "cardinal virtues"
                    ],
                    "target_lang_definitions": {
                        "ru": "Определенное похвальное качество или достойная восхищения черта характера человека."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "добродетель",
                                "target_lang_sense_clarification": "положительное качество"
                            },
                            {
                                "target_lang_word": "достоинство",
                                "target_lang_sense_clarification": "положительная черта характера"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "68036832-cf97-3531-8932-5bf2843a0d23",
                    "sense_definition": "An inherently advantageous or excellent quality of something; a favorable point or advantage.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "advantage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The main <w>virtue</w> of this new software is its incredible speed and efficiency.",
                            "target_lang_translations": {
                                "ru": "Главное <w>достоинство</w> этого нового программного обеспечения — его невероятная скорость и эффективность."
                            }
                        },
                        {
                            "text": "One <w>virtue</w> of the plan was its simplicity, making it easy for everyone to follow.",
                            "target_lang_translations": {
                                "ru": "Одним из <w>преимуществ</w> плана была его простота, благодаря которой его было легко придерживаться."
                            }
                        }
                    ],
                    "common_phrases": [
                        "virtue of the plan",
                        "hidden virtues"
                    ],
                    "target_lang_definitions": {
                        "ru": "Присущее чему-либо полезное или превосходное качество; преимущество."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "достоинство",
                                "target_lang_sense_clarification": "преимущество предмета или плана"
                            },
                            {
                                "target_lang_word": "преимущество",
                                "target_lang_sense_clarification": "положительная сторона"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b5cfb61b-5f78-3513-b209-d2b244bdce3e",
                    "sense_definition": "The inherent power or efficacy of something, often used to explain how a result is achieved.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "power",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They won the competition by <w>virtue</w> of their superior discipline and experience.",
                            "target_lang_translations": {
                                "ru": "Они выиграли соревнование в <w>силу</w> своей превосходной дисциплины и опыта."
                            }
                        },
                        {
                            "text": "The medicine seemed to have lost its <w>virtue</w> after being left in the sun.",
                            "target_lang_translations": {
                                "ru": "Лекарство, казалось, потеряло свою <w>силу</w> после того, как его оставили на солнце."
                            }
                        }
                    ],
                    "common_phrases": [
                        "by virtue of"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внутренняя сила или эффективность чего-либо, часто используемая для объяснения того, как достигается результат."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сила",
                                "target_lang_sense_clarification": "эффективность или действие"
                            },
                            {
                                "target_lang_word": "свойство",
                                "target_lang_sense_clarification": "действующее начало"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9f355eaa-0191-373e-bc58-8903f0050077",
                    "sense_definition": "Moral conduct in sexual behavior; chastity or purity.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "moral_excellence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In many classic novels, the heroine must protect her <w>virtue</w> against various suitors.",
                            "target_lang_translations": {
                                "ru": "Во многих классических романах героиня должна защищать свое <w>целомудрие</w> от различных поклонников."
                            }
                        },
                        {
                            "text": "The story emphasizes that her <w>virtue</w> was her most precious possession.",
                            "target_lang_translations": {
                                "ru": "В рассказе подчеркивается, что её <w>добродетель</w> была её самым ценным достоянием."
                            }
                        }
                    ],
                    "common_phrases": [
                        "protect one's virtue"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "often used in historical or literary contexts regarding sexual purity"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Моральное поведение в сексуальной сфере; целомудрие или чистота."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "целомудрие",
                                "target_lang_sense_clarification": "невинность, чистота"
                            },
                            {
                                "target_lang_word": "добродетель",
                                "target_lang_sense_clarification": "женская честь"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1c89f389-2ed1-3a5d-8940-c0082ca6d210",
                    "sense_definition": "One of the orders of heavenly beings or angels in traditional Christian angelology.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "theology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient text describes the hierarchy of angels, including Thrones, Dominations, and <w>Virtues</w>.",
                            "target_lang_translations": {
                                "ru": "Древний текст описывает иерархию ангелов, включая Престолы, Господства и <w>Силы</w>."
                            }
                        },
                        {
                            "text": "In religious art, <w>Virtues</w> are often depicted as celestial beings of great power.",
                            "target_lang_translations": {
                                "ru": "В религиозном искусстве <w>Силы</w> часто изображаются как небесные существа, обладающие великой мощью."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "theological term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Один из чинов ангельской иерархии в традиционной христианской ангелологии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Силы",
                                "target_lang_sense_clarification": "ангельский чин"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "576ffdb3-3f60-33f9-a63b-9a0eeca9d7e1",
                    "sense_definition": "An English surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Virtue</w> was a well-known publisher in London during the nineteenth century.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Верчью</w> был известным издателем в Лондоне в девятнадцатом веке."
                            }
                        },
                        {
                            "text": "She researched her family history and discovered her ancestors carried the name <w>Virtue</w>.",
                            "target_lang_translations": {
                                "ru": "Она изучила историю своей семьи и обнаружила, что её предки носили фамилию <w>Верчью</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "less common English surname"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Английская фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Верчью",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}