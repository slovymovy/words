                        "examples": [
                            {
                                "example_id": "d0c4c0c3-afde-4db0-a095-a8c02d471b96",
                                "sense_id": "5849af85-a588-3e4c-b7c3-f55a01f80933",
                                "text": "„Tja, ab und zu bekommt er mal wieder einen Anfall von Mitteilungsbedürftigkeit.“"
                            },
                            {
                                "example_id": "617d9932-804a-4014-9aa1-cfd2b1532ec5",
                                "sense_id": "5849af85-a588-3e4c-b7c3-f55a01f80933",
                                "text": "„Er lässt kein Mikrofon aus, wird seiner Mitteilungsbedürftigkeit wegen auch schon mal ‚Die Schallplatte‘ genannt, äußert sich zuverlässig zu jeder wichtigen Frage im deutschen Fußball.“"
                            },
                            {
                                "example_id": "25ff7c55-a89d-4a61-b300-2a347fc4aa28",
                                "sense_id": "5849af85-a588-3e4c-b7c3-f55a01f80933",
                                "text": "„Meine Fehler wurden gegen mich verwendet, mein Liebeskummer wurde als Entertainment benutzt, und meine selbst geschriebenen Texte wurden als übertriebene Mitteilungsbedürftigkeit belächelt.“"
                            }
                        ],
