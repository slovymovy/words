                "senses": [
                    {
                        "sense_id": "2a970503-2ae0-3be3-91a9-a5a4bf7e0ad6",
                        "entry_id": "40f4ca3e-1e52-377d-af53-65e13d59fd8f",
                        "glosses": [
                            "Sack, der aus Jutefasern hergestellt wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b612ae89-bbe7-4259-9b8b-b69a5afe46b9",
                                "sense_id": "2a970503-2ae0-3be3-91a9-a5a4bf7e0ad6",
                                "text": "Die Kartoffeln wurden in Jutesäcken geliefert."
                            },
                            {
                                "example_id": "f8fd6cf2-e1bc-4630-a0b8-fb75582d3450",
                                "sense_id": "2a970503-2ae0-3be3-91a9-a5a4bf7e0ad6",
                                "text": "„Eines Morgens stand plötzlich ein großer Jutesack mit braunem Zucker in der Küche.“"
                            },
                            {
                                "example_id": "eee87c8b-c02a-4dad-9b76-69e2900cfbb8",
                                "sense_id": "2a970503-2ae0-3be3-91a9-a5a4bf7e0ad6",
                                "text": "„Sie stopften den Junker in einen Jutesack, den sie zubanden, und schleppten ihn mit sich hinaus auf den Weideplatz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
