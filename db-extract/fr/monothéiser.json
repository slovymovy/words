                "senses": [
                    {
                        "sense_id": "541c33d5-e90a-3028-a829-27081b49d2ba",
                        "entry_id": "c129db55-4c87-3ce1-bb60-c9d963c8ca6b",
                        "glosses": [
                            "Donner un caractère monothéiste à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e05ca2a-ebdb-4df1-a357-9997ce6a675e",
                                "sense_id": "541c33d5-e90a-3028-a829-27081b49d2ba",
                                "text": "Scholem soutient que le Shi’ur Komah fut en réalité une tentative des mystiques pour « monothéiser » les thèmes anthropomorphes gnostiques."
                            },
                            {
                                "example_id": "a0218524-0c34-4459-bd3b-464d07b611b6",
                                "sense_id": "541c33d5-e90a-3028-a829-27081b49d2ba",
                                "text": "Il lui parlait de Mahomet comme il lui aurait parlé d’un frère, il lui racontait sa vie, son mariage avec la veuve du négociant, puis avec Marie la Copte, il savait l’histoire particulière des vingt-quatre femmes de Mahomet, Mahomet qui avait entrepris de monothéiser l’islam."
                            }
                        ]
                    }
