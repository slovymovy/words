                                        "sense_id": "b5ae084b-82db-3fd4-abd6-13d719dfc537",
                                        "entry_id": "7b4ff313-4cab-3fa0-900e-0d4e4455356d",
                                        "glosses": [
                                            "To divide or classify into subgroups"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
