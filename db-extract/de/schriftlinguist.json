                "senses": [
                    {
                        "sense_id": "ec453317-0c57-3db6-834f-6da952a49218",
                        "entry_id": "12ab2915-0678-3cb9-bb22-9620aeb758c1",
                        "glosses": [
                            "Linguist (Sprachwissenschaftler), der sich intensiv mit der Erforschung der Schrift, des Schreibens widmet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ac60409-6322-4a0e-8fd1-2222b3629051",
                                "sense_id": "ec453317-0c57-3db6-834f-6da952a49218",
                                "text": "„Debatten um Rechtschreibung kippten schnell ins Persönliche, erklärt der Schriftlinguist.“"
                            },
                            {
                                "example_id": "00a9e6e3-292f-4e50-b10d-61941c939903",
                                "sense_id": "ec453317-0c57-3db6-834f-6da952a49218",
                                "text": "„Prof. Dr. Herbert E. Brekle ist historischer Schriftlinguist und emeritierter Professor für Allgemeine Sprachwissenschaft an der Universität Regensburg.“"
                            },
                            {
                                "example_id": "fd29a235-6759-4b36-8d31-9645541a969d",
                                "sense_id": "ec453317-0c57-3db6-834f-6da952a49218",
                                "text": "„Ziel der AG ist es, nicht nur Morphologen und Schriftlinguisten, sondern Forschern aller Disziplinen, etwa Psycholinguisten, Soziolinguisten, Computerlinguisten oder Sprachwandel- und Spracherwerbsforschern, eine Plattform zum Austausch ihrer Überlegungen zu bieten.“"
                            },
                            {
                                "example_id": "6542618f-d5e5-4f8d-ae5e-34e095026cff",
                                "sense_id": "ec453317-0c57-3db6-834f-6da952a49218",
                                "text": "„Selbst unter Schriftlinguisten ist die Terminologie uneinheitlich und bisweilen eurozentrisch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
