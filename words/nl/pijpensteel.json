{
    "word_family": [
        "pijp",
        "pijpenmaker",
        "pijpenrek",
        "pijpenlade"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e9edfc4f-97f8-3ca2-9866-9bb53b55f8d1",
                    "sense_definition": "Het lange, dunne en holle gedeelte van een tabakspijp dat de kop met het mondstuk verbindt.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "pijponderdelen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De archeoloog vond een gebroken <w>pijpensteel</w> in de bodem van de oude gracht.",
                            "target_lang_translations": {
                                "en": "The archaeologist found a broken <w>pipe stem</w> at the bottom of the old canal."
                            }
                        },
                        {
                            "text": "Vroeger waren deze lange <w>pijpenstelen</w> erg breekbaar omdat ze van klei werden gemaakt.",
                            "target_lang_translations": {
                                "en": "In the past, these long <w>pipe stems</w> were very fragile because they were made of clay."
                            }
                        }
                    ],
                    "synonyms": [
                        "pijpsteel"
                    ],
                    "antonyms": [
                        "pijpenkop"
                    ],
                    "common_phrases": [
                        "stenen pijpensteel",
                        "lange pijpensteel"
                    ],
                    "target_lang_definitions": {
                        "en": "The long, thin, hollow part of a tobacco pipe that connects the bowl to the mouthpiece."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pipe stem",
                                "target_lang_sense_clarification": "the part of a smoking pipe"
                            },
                            {
                                "target_lang_word": "stem",
                                "target_lang_sense_clarification": "of a tobacco pipe"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9f2ebb5a-a89c-323c-aac7-74b73728a21f",
                    "sense_definition": "Wordt vrijwel uitsluitend gebruikt in de uitdrukking 'het regent <w>pijpenstelen</w>' om aan te geven dat het zeer hard regent.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "regen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We konden niet naar buiten gaan omdat het buiten <w>pijpenstelen</w> regende.",
                            "target_lang_translations": {
                                "en": "We couldn't go outside because it was raining <w>cats and dogs</w> outside."
                            }
                        },
                        {
                            "text": "Zodra de wedstrijd begon, begon het plotseling <w>pijpenstelen</w> te regenen.",
                            "target_lang_translations": {
                                "en": "As soon as the match started, it suddenly started raining <w>pitchforks</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "bakstenen",
                        "stortregen"
                    ],
                    "common_phrases": [
                        "regent pijpenstelen"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Vrijwel alleen in de meervoudsvorm gebruikt binnen een vaste uitdrukking."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Used almost exclusively in the expression 'het regent pijpenstelen' to indicate that it is raining very hard."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cats and dogs",
                                "target_lang_sense_clarification": "used in the idiom 'raining cats and dogs'"
                            },
                            {
                                "target_lang_word": "stair rods",
                                "target_lang_sense_clarification": "British idiom for heavy rain"
                            },
                            {
                                "target_lang_word": "pitchforks",
                                "target_lang_sense_clarification": "used in the idiom 'raining pitchforks'"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}