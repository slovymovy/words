                    "sense_definition": "Bad, evil, or threatening in nature.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "evil",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The letter contained some <w>shrewd</w> news that caused great distress to the family.",
                            "target_lang_translations": {
                                "pl": "List zawierał <w>złe</w> wieści, które wywołały wielki niepokój w rodzinie.",
                                "tr": "Mektup, ailede büyük sıkıntıya neden olan <w>kötü</w> haberler içeriyordu."
                            }
