                        "sense_id": "fdccb303-4fa9-35d3-ae18-32475d839496",
                        "entry_id": "3f5f3b65-f267-3304-94ad-4d1535f669df",
                        "glosses": [
                            "Discothèque, boite de nuit."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "f4867e6a-61b5-425a-b35a-fe56af8a34ac",
                                "sense_id": "fdccb303-4fa9-35d3-ae18-32475d839496",
                                "text": "Tout au plus se concédait-il à l’occasion, comme hier soir, une cigarette (light) et un whisky (baby) dans le voukoum d’un night-club."
                            },
                            {
                                "example_id": "8edbc303-8b2d-4749-95ca-b036b0e78059",
                                "sense_id": "fdccb303-4fa9-35d3-ae18-32475d839496",
                                "text": "Perché sur son promontoire rocheux, non loin de la grotte où les avait emmenés Zef après la baston du night-club et la cavale qui s’en était suivie, Ticoq fut le premier à les apercevoir."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3eb71798-eb0a-41e8-a655-ffc5082b0d03",
                        "source_entry_id": "3f5f3b65-f267-3304-94ad-4d1535f669df",
                        "source_sense_id": "fdccb303-4fa9-35d3-ae18-32475d839496",
                        "source_sense_description": "boite de nuit",
                        "target_lang_word": "Nachtclub",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nachtclub",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4b6963aa-d5e4-3f5b-8a53-391a76a8f70e",
                                        "entry_id": "33947cf0-db74-3a63-ad01-c27dd004a4b5",
                                        "glosses": [
                                            "No glosses available"
                                        ],
                                        "tags": [
                                            "no-gloss"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f512c98-e0c3-475e-a38e-c7ed203e0170",
                                                "sense_id": "4b6963aa-d5e4-3f5b-8a53-391a76a8f70e",
                                                "text": "„Und wieder andere hatten sich umgezogen, um einen Nachtclub zu besuchen.“"
                                            },
                                            {
                                                "example_id": "39b5662f-a24d-430f-92ee-bb26cc65ba8c",
                                                "sense_id": "4b6963aa-d5e4-3f5b-8a53-391a76a8f70e",
                                                "text": "„Auf einer spanischen Insel könnte man ja mangels Nachtclubs ein paar Ruinen erwarten (barocke Klöster, mittelalterliche Festungen und dergleichen.“"
                                            },
                                            {
                                                "example_id": "9fe24b6a-ef94-4a55-87cd-f7300386b97d",
                                                "sense_id": "4b6963aa-d5e4-3f5b-8a53-391a76a8f70e",
                                                "text": "„Um den Nachtclub zu erreichen, mußte sie über dicke, an den Pollern befestigte Taue steigen, an denen sich Kleid un Haare verfingen.“"
                                            },
                                            {
                                                "example_id": "9b66592f-085e-443c-aa3f-16210b599faa",
                                                "sense_id": "4b6963aa-d5e4-3f5b-8a53-391a76a8f70e",
                                                "text": "„Nach ihrer Filmkarriere feierte die über Siebzigjährige in den Nachtclubs von Las Vegas, in den Theatern und Konzertsälen Amerikas und Europas als Chanson-Sängerin Triumphe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
