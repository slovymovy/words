                "senses": [
                    {
                        "sense_id": "81d680af-61f0-30a1-b295-b013550d8b2d",
                        "entry_id": "3c223208-4a94-34ab-addb-0b371d5f69f7",
                        "glosses": [
                            "privates Entscheidungsorgan, dessen Entscheidung (Schiedsspruch) zwischen den Parteien die Wirkung eines rechtskräftigen gerichtlichen Urteils hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85a9a033-c7b3-4721-931e-7a1c2314cf19",
                                "sense_id": "81d680af-61f0-30a1-b295-b013550d8b2d",
                                "text": "„Vor einem Schiedsgericht in Washington einigten sich die Streitparteien schließlich auf einen Vergleich.“"
                            },
                            {
                                "example_id": "d076398c-1259-4629-b3b3-375b3471743e",
                                "sense_id": "81d680af-61f0-30a1-b295-b013550d8b2d",
                                "text": "„»Gut, dass das Schiedsgericht so zügig und klar geurteilt hat«, sagte sie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f441be79-3c3d-30de-8cfd-d8982ce9a2bb",
                        "entry_id": "3c223208-4a94-34ab-addb-0b371d5f69f7",
                        "glosses": [
                            "Gremium von Sportfunktionären, das (als höchste Entscheidungsinstanz) über Einhaltung der Wettkampfsregel/Streitfälle entscheidet"
                        ],
