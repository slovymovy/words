                                                "text": "Sono di Roma."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7f9ace1-5ad6-31bd-bda2-6366cb2dc95f",
                                        "entry_id": "0fe6f593-fbfe-3062-a9ae-099c87e22474",
