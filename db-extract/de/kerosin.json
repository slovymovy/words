                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a42a6dd-0ad1-37f5-abc8-591b4481c970",
                                        "entry_id": "09a567ba-ec75-3ae5-b469-1472d494a8e2",
                                        "glosses": [
                                            "Strong home-brewed alcoholic drink; moonshine; everclear."
                                        ],
                                        "tags": [
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a7774e6-193a-4d64-9dfe-7d2adc11825b",
                                                "sense_id": "3a42a6dd-0ad1-37f5-abc8-591b4481c970",
                                                "text": "Sometimes I wish I were still out on the back porch, drinking jet fuel with the boys, getting louder and louder as the empty cans drop out of our paws like booster rockets falling back to Earth and we soar up into the summer stars."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f65f0791-4135-4f24-8db2-c66d2763f0ac",
                        "source_entry_id": "9d41af7e-33cd-3f28-994d-890106de84a4",
                        "source_sense_id": "d70da688-99e5-3d8c-82ed-08ce0dcb9c96",
                        "source_sense_description": "Kraftstoff für Turbostrahltriebwerke und Dieselmotoren von Flugzeugen",
                        "target_lang_word": "kérosène",
