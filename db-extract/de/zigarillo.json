                                        "entry_id": "67f2b2a8-8801-3d92-88fa-288b772d08ce",
                                        "glosses": [
                                            "Petit cigare."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b057b7eb-94ce-444c-a07b-4d6fa3256483",
                                                "sense_id": "f33ee303-0805-3471-9402-498a66bbb520",
                                                "text": "Il suçait un mégot de cigarille en papier et du jus de nicotine salissait son menton."
                                            }
