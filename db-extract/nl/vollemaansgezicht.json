                        "examples": [
                            {
                                "example_id": "3451ed9d-d607-4ca4-a827-bddfe7f202b5",
                                "sense_id": "c20c01fb-aec5-3966-97ca-11d50bfe242e",
                                "text": "Van haar kleine handen, die overigens bleek bleven, vormde ze dan een soort masker, dat helaas niet groot genoeg was om het vollemaansgezicht helemaal te bedekken."
                            },
                            {
                                "example_id": "e76aaa41-b4a5-4182-93b6-e662bb51304c",
                                "sense_id": "c20c01fb-aec5-3966-97ca-11d50bfe242e",
                                "text": "Daar lag Andy van der Meyde op een bank. Het programma heette ‘Jouw vrouw, mijn vrouw’. Andy’s vollemaansgezicht glom als een zojuist geglazuurde bolus. Hij had zijn vrouw – een voormalig Playboymodel dat Melissa heet – voor een paar dagen geruild met Judith Osborn, een keurig afgewerkte voorgevel met een gezellige mevrouw eraan."
                            }
                        ]
