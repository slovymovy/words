                                "sense_id": "fbbbf0ee-b990-3898-a5b9-ba51bf0feeb8",
                                "text": "„Unhöflichkeit schlägt einem auch bei alltäglichen Verrichtungen entgegen – auf Ämtern, beim Taxifahren, beim Versuch, sich in einer Schlange anzustellen. “"
                            },
                            {
                                "example_id": "59647e4e-7cbb-4222-a99e-c482741a0f21",
                                "sense_id": "fbbbf0ee-b990-3898-a5b9-ba51bf0feeb8",
                                "text": "„Taxifahren ist in an vielen Orten in Deutschland erheblich teurer geworden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "570951d5-4028-3dca-8d69-1cebb639eb6a",
