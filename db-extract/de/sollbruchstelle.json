                    {
                        "sense_id": "4dd28097-646d-3148-9217-bdd687539828",
                        "entry_id": "6b395e64-04ee-3c37-a293-a09fd127d6fe",
                        "glosses": [
                            "(predetermined) breaking point"
                        ],
