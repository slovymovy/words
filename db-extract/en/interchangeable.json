                                                "sense_id": "e823dcad-05d5-336b-8d9d-3dc1ea0530fc",
                                                "text": "„Das Leibniz‑Rechenzentrum der Bayerischen Akademie der Wissenschaften LRZ fungiert als eine Art Schaltzentrale, in der die Eingaben in die Computer tausender Wissenschaftler koordiniert und untereinander austauschbar gemacht werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "cfa174d8-3fdd-3e61-ae9f-d13ef1aa7d92",
                                        "entry_id": "2731c48a-e0ec-327b-80f5-504575069c4d",
                                        "glosses": [
                                            "beliebig durch jemand anderen ersetzbar"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "283c184d-d281-4ffb-a4d2-109db04073ba",
                                                "sense_id": "cfa174d8-3fdd-3e61-ae9f-d13ef1aa7d92",
                                                "text": "„Ich wollte nicht bloß hübsches, austauschbares Dekor in einem Film sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
