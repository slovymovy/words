                "senses": [
                    {
                        "sense_id": "5599d9c1-4c1f-34ff-9ee5-724096675a52",
                        "entry_id": "a3f82caa-32b2-3d23-a2f9-06ee41f082ab",
                        "glosses": [
                            "Donner un caractère diurne à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "855838e6-2e8c-4700-a151-606733336fc7",
                                "sense_id": "5599d9c1-4c1f-34ff-9ee5-724096675a52",
                                "text": "Diurniser la nuit, c'est vouloir extirper l'homme de sa condition, c'est soumettre la nature, étendre notre emprise à toute la planète."
                            },
                            {
                                "example_id": "ebdbd22a-907d-4938-bbde-ac44812e9853",
                                "sense_id": "5599d9c1-4c1f-34ff-9ee5-724096675a52",
                                "text": "De plus, doit-on nécessairement chercher à « diurniser » la nuit, à rendre l'espace nocturne aussi semblable que possible à l'espace diurne ?"
                            },
                            {
                                "example_id": "d03c3847-5177-4491-8c2d-05d44bd3ce24",
                                "sense_id": "5599d9c1-4c1f-34ff-9ee5-724096675a52",
                                "text": "Mais ce qui m'énerve le plus, c'est qu'on veut supprimer la nuit, non : on veut \"diurniser\" le monde."
                            }
                        ]
                    }
                ],
