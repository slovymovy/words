                ],
                "senses": [
                    {
                        "sense_id": "2f74afa5-1a30-3767-83d4-bf6f3b1aeb06",
                        "entry_id": "46705a99-ec58-303b-b9ee-d8051091fc6e",
                        "glosses": [
                            "ein Beleg, eine Bestätigung für den erfüllten Brandschutz in einem Gebäude"
                        ],
                        "tags": [
                            "Landesbauordnung"
                        ],
                        "examples": [
                            {
                                "example_id": "4521be5f-3af1-4197-95c1-b693a18e36a8",
                                "sense_id": "2f74afa5-1a30-3767-83d4-bf6f3b1aeb06",
                                "text": "„Ausgangspunkt der inhaltlichen Anforderungen an den Brandschutznachweis ist die allgemeine Anforderung an die Bauausführung in Bezug auf den Brandschutz nach Art. 12 BayBO, wonach bauliche Anlagen so anzuordnen, zu errichten, zu ändern und instand zu halten sind, dass der Entstehung eines Brandes und der Ausbreitung von Feuer und Rauch (Brandausbreitung) vorgebeugt wird und bei einem Brand die Rettung von Menschen und Tieren sowie wirksame Löscharbeiten möglich sind.“"
                            },
                            {
                                "example_id": "24c0cf05-b996-4745-92bc-f718fcdf75db",
                                "sense_id": "2f74afa5-1a30-3767-83d4-bf6f3b1aeb06",
                                "text": "„Der Brandschutznachweis gilt als Nachweis gegenüber den Bauaufsichtsbehörden oder den Prüfingenieuren für vorbeugenden Brandschutz.“"
                            },
                            {
                                "example_id": "5027c82e-840a-4441-85a4-5ced9531433b",
                                "sense_id": "2f74afa5-1a30-3767-83d4-bf6f3b1aeb06",
                                "text": "„Die Berechtigung zum Führen des Brandschutznachweises ist in einzelnen Bundesländern unterschiedlich geregelt.“"
                            },
                            {
                                "example_id": "3298dea2-2357-435e-aa15-3782ab74d246",
                                "sense_id": "2f74afa5-1a30-3767-83d4-bf6f3b1aeb06",
                                "text": "„Je nachdem um welches Bauvorhaben es sich handelt, ist ein Bandschutznachweis oder ein Brandschutzkonzept erforderlich.“"
                            },
                            {
                                "example_id": "c8fa16b4-acf1-4c40-8333-95b17a3291bf",
                                "sense_id": "2f74afa5-1a30-3767-83d4-bf6f3b1aeb06",
                                "text": "„Werden all die Anforderungen aus den Landesbauordnungen nachgewiesen und umgesetzt, spricht man von einem Brandschutznachweis.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
