            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e03bd910-62ee-38e6-94f3-ce12bf703708",
                    "sense_definition": "The act of speaking with excessive pride or self-satisfaction.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "boast_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His endless <w>boasting</w> annoyed everyone at the dinner table.",
                            "target_lang_translations": {
                                "es": "Su interminable <w>jactancia</w> molestó a todos en la mesa."
                            }
                        },
                        {
                            "text": "There was no substance behind all of his proud <w>boasting</w>.",
                            "target_lang_translations": {
                                "es": "No había sustancia detrás de todos sus orgullosos <w>alardes</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "bragging",
                        "vaunting"
                    ],
                    "antonyms": [
                        "modesty",
                        "humility"
                    ],
                    "common_phrases": [
                        "empty boasting",
                        "idle boasting"
                    ],
                    "target_lang_definitions": {
                        "es": "El acto o hábito de hablar con excesivo orgullo, vanagloria o autosatisfacción."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "jactancia",
                                "target_lang_sense_clarification": "acto de presumir o vanagloriarse"
                            },
                            {
                                "target_lang_word": "alarde",
                                "target_lang_sense_clarification": "ostentación o fanfarronería"
                            },
                            {
                                "target_lang_word": "fanfarronería",
                                "target_lang_sense_clarification": "comportamiento de presumir falsamente o en exceso"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "efbc1879-65a8-32d8-995d-727dd627465c",
                    "sense_definition": "An individual instance or utterance of speaking with excessive pride.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "boast_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her vain <w>boastings</w> quickly turned out to be completely untrue.",
                            "target_lang_translations": {
                                "es": "Sus vanas <w>fanfarronadas</w> pronto resultaron ser totalmente falsas."
                            }
                        },
                        {
                            "text": "He soon regretted his foolish <w>boasting</w> after failing the challenge.",
                            "target_lang_translations": {
                                "es": "Pronto se arrepintió de su tonta <w>fanfarronada</w> tras fracasar en el desafío."
                            }
                        }
                    ],
                    "synonyms": [
                        "brag",
                        "boast"
                    ],
                    "target_lang_definitions": {
                        "es": "Declaración, comentario o expresión concreta dicha con excesivo orgullo."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "fanfarronada",
                                "target_lang_sense_clarification": "comentario o dicho presuntuoso"
                            },
                            {
                                "target_lang_word": "alarde",
                                "target_lang_sense_clarification": "declaración ostentosa"
                            },
                            {
                                "target_lang_word": "jactancia",
                                "target_lang_sense_clarification": "dicho vanidoso"
                            }
                        ]
                    }
                }
            ]
        }
    ]
