                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "куде́сник",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a11b2f82-de8f-309c-8c4a-7e741e62082e",
                                        "entry_id": "2c790b89-4598-371b-91ff-8e1937ef91df",
                                        "glosses": [
                                            "нар.-поэт. волшебник; тот, кто делает что-либо сверхъестественное"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89b0b9f8-5005-40c6-8c48-17cef7cfa458",
                                                "sense_id": "a11b2f82-de8f-309c-8c4a-7e741e62082e",
                                                "text": "Скажи мне, кудесник, любимец богов, // Что сбудется в жизни со мною? // И скоро ль, на радость соседей-врагов, // Могильной засыплюсь землёю? // Открой мне всю правду, не бойся меня: // В награду любого возьмёшь ты коня."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05b1652d-45b9-3b39-8c05-6ce236757a40",
                                        "entry_id": "2c790b89-4598-371b-91ff-8e1937ef91df",
                                        "glosses": [
                                            "перен., разг. выдающийся мастер"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9bc3003-f4b2-4a5c-8779-251da130e4e0",
                                                "sense_id": "05b1652d-45b9-3b39-8c05-6ce236757a40",
                                                "text": "Он настоящий кудесник, такие блюда готовит — пальчики оближешь!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
