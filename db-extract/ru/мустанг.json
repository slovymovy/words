                ],
                "senses": [
                    {
                        "sense_id": "2855a5ab-25f0-34f5-b97d-484706ef6af0",
                        "entry_id": "d0dc9c9d-ea3f-3e01-b70b-329e034ec431",
                        "glosses": [
                            "одичавшая домашняя лошадь, завезённая европейцами в Северную Америку"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b73a0fb9-cc14-4956-b60e-d51fc3c01d65",
                                "sense_id": "2855a5ab-25f0-34f5-b97d-484706ef6af0",
                                "text": "Ему хотелось на волю, хотелось скакать на потном мустанге сквозь заросли."
                            },
                            {
                                "example_id": "1530125d-b949-4933-bef3-3d71c34e8c5f",
                                "sense_id": "2855a5ab-25f0-34f5-b97d-484706ef6af0",
                                "text": "Большинство пастухов ловили и объезжали диких мустангов."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4021e3b5-90fa-4707-bb12-aa0711457e8c",
                        "source_entry_id": "d0dc9c9d-ea3f-3e01-b70b-329e034ec431",
                        "source_sense_id": "2855a5ab-25f0-34f5-b97d-484706ef6af0",
                        "target_lang_word": "mustang",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mustang",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d26e8149-7720-3d9b-a829-bb8ad91f2583",
                                        "entry_id": "84e24852-1010-30c1-9cf5-4f97c168f77e",
                                        "glosses": [
                                            "A small, hardy, naturalized (feral) horse of the North American west."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51917f68-18ed-43c9-991e-b52fbb9ba57f",
                                                "sense_id": "d26e8149-7720-3d9b-a829-bb8ad91f2583",
                                                "text": "The mustang pony, the invariable companion of the inhabitant of the prairie, whether he is rich or poor, is a little creature, apparently narrow-chested, and small across the loins."
                                            },
                                            {
                                                "example_id": "2906133a-6c43-4660-81ae-27a8821d57d7",
                                                "sense_id": "d26e8149-7720-3d9b-a829-bb8ad91f2583",
                                                "text": "Having ridden a distance of two or three miles, Garey slackened his pace, and put the mustang to a slow walk."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e548cd97-5319-3561-9e83-27379b1680f0",
                                        "entry_id": "84e24852-1010-30c1-9cf5-4f97c168f77e",
                                        "glosses": [
                                            "A merchant marine who joined the U.S. Navy as a commissioned officer during the American Civil War."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "584ac3f2-d7d9-4f0b-a762-1cdbe586b8a6",
                                                "sense_id": "e548cd97-5319-3561-9e83-27379b1680f0",
                                                "text": "He is a product of the merchant marine and is one of the officers called \"Mustangs\" who entered the navy during the Civil War."
                                            },
                                            {
                                                "example_id": "83c8e392-b822-475a-9b5a-b2771adffc2a",
                                                "sense_id": "e548cd97-5319-3561-9e83-27379b1680f0",
                                                "text": "He was the son of a famous artist, and was what we termed a \"mustang\" officer, who had come into the navy from the merchant service during the Civil War."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e1aa500-5a62-3f17-8db6-e16de3cd9e7f",
                                        "entry_id": "84e24852-1010-30c1-9cf5-4f97c168f77e",
                                        "glosses": [
                                            "A commissioned officer who started military service as an enlisted person."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ebff9ed6-216a-4ec2-aa95-c31e59902b87",
                                                "sense_id": "3e1aa500-5a62-3f17-8db6-e16de3cd9e7f",
                                                "text": "[…] and the chief engineer is a \"mustang\" — that is, an officer who has risen from the ranks of enlisted men."
                                            },
                                            {
                                                "example_id": "01acccd7-27b9-48c4-b410-6e96580f4db7",
                                                "sense_id": "3e1aa500-5a62-3f17-8db6-e16de3cd9e7f",
                                                "text": "Mustang— Officer who came up through the ranks. None better."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mustang",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c7971ae4-3b67-3766-9603-6521745d35dc",
                                        "entry_id": "1383155e-aeb5-3d2d-875e-03dfc0e53633",
                                        "glosses": [
                                            "To hunt mustangs (wild horses), either for military use or for slaughter as pet food."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
