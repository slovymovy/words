                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b1a74ae-9ef6-418a-8b0e-7f0211e42dde",
                                "sense_id": "45b0b22b-f722-3639-838b-49ca50c087e8",
                                "text": "Grootmoeder is afhankelijk van onze hulp om alleen te kunnen wonen.",
                                "translation": "Grandma is dependent on our help to be able to live alone.",
                                "english": "Grandma is dependent on our help to be able to live alone."
                            }
                        ]
                    },
                    {
                        "sense_id": "582869bf-ae8d-3d62-ac1f-d1b68131d7cb",
