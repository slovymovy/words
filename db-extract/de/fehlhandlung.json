                "senses": [
                    {
                        "sense_id": "db9da3ca-b99e-3e5f-89c7-7b38e0591a41",
                        "entry_id": "06333726-f50e-3051-82fd-3e775e414874",
                        "glosses": [
                            "eine Fehlleistung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "592a4c72-416e-4f72-b1e0-dba2b4f31c46",
                                "sense_id": "db9da3ca-b99e-3e5f-89c7-7b38e0591a41",
                                "text": "„Ohne Strafen kann Erziehung nicht auskommen; Kinder können noch nicht gefestigte Charaktere sein und folgen daher oft Trieben, die sie zu Fehlhandlungen verleiten. Deshalb müssen sie durch St. gehemmt werden.“"
                            },
                            {
                                "example_id": "2283b4c2-fbad-4c5a-a149-dcfabff0f565",
                                "sense_id": "db9da3ca-b99e-3e5f-89c7-7b38e0591a41",
                                "text": "„Fehlhandlungen eines Partners, die diesem verhängnisvoll werden könnten, da sie dem Ritual zuwider laufen, »darf« der andere nicht ausnutzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "46f7f67c-ef4a-39e5-8a29-1004bc74abe1",
                        "entry_id": "06333726-f50e-3051-82fd-3e775e414874",
                        "glosses": [
                            "Ursache für das Auftreten eines Fehlerzustandes."
                        ],
                        "tags": [
                            "Softwaretesten"
                        ],
                        "examples": [
                            {
                                "example_id": "3aa2353d-d056-4dfe-b98c-e135b044e81b",
                                "sense_id": "46f7f67c-ef4a-39e5-8a29-1004bc74abe1",
                                "text": "Eine fehlerhafte Programmierung eines Entwicklers ist eine Fehlhandlung."
                            },
                            {
                                "example_id": "e72268f2-ec74-4d69-8519-c2cc359fc50a",
                                "sense_id": "46f7f67c-ef4a-39e5-8a29-1004bc74abe1",
                                "text": "Die Fehlhandlung wurde durch einen menschlichen Fehler verursacht, der zu Fehlerzuständen führte."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
