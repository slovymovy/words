                ],
                "senses": [
                    {
                        "sense_id": "0b057e4e-9693-36c9-889e-cb56799a9246",
                        "entry_id": "f712a079-2443-3913-a971-7142dc80e15f",
                        "glosses": [
                            "Personne qui croit en plusieurs dieux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7cb0ed91-c568-4c87-9576-5343c233747d",
                                "sense_id": "0b057e4e-9693-36c9-889e-cb56799a9246",
                                "text": "Je revis le père Éphraïm sous les traits d’un polythéiste qui sacrifiait des animaux pour les dieux."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bd4afa4b-2d97-42d0-8a4c-02321c9cd0ac",
                        "source_entry_id": "f712a079-2443-3913-a971-7142dc80e15f",
                        "source_sense_id": "0b057e4e-9693-36c9-889e-cb56799a9246",
                        "target_lang_word": "Polytheist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Polytheist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b14add8c-183f-3cff-8a06-d86dbd3ab8e4",
                                        "entry_id": "e5266379-30fb-312b-85e7-0beffa02f05b",
                                        "glosses": [
                                            "jemand, der glaubt, es gebe mehrere Götter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ee38ac7-40e6-4e37-8e69-0514ce70f60d",
                                                "sense_id": "b14add8c-183f-3cff-8a06-d86dbd3ab8e4",
                                                "text": "Polytheisten haben besondere Schwierigkeiten, ihren Glauben zu rechtfertigen."
                                            },
                                            {
                                                "example_id": "34123f04-dbd7-4557-b7db-0da66e35218e",
                                                "sense_id": "b14add8c-183f-3cff-8a06-d86dbd3ab8e4",
                                                "text": "Polytheisten verneinen, dass es einen einzigen Gott gibt, es gibt eben viele Götter, so wie es viele Dinge, Umstände, Situationen, Schicksale, Vorbilder, Heilige, Wege und überhaupt Andersartigkeiten gibt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
