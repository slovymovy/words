                        "source_sense_id": "18c89bef-7059-3810-a033-f062ae86562b",
                        "target_lang_word": "inquisitorial",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inquisitorial",
