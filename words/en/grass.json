                },
                {
                    "sense_id": "701bad4f-4c47-3f42-bdba-7f4ce7fdc1df",
                    "sense_definition": "A slang term for marijuana.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "drug",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police arrested the man for selling <w>grass</w>.",
