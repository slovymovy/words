                    "sense_definition": "verbindet Hauptsätze im Sinne einer logischen Konsequenz; folglich, daher",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "folgerung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er hatte gestern sehr hart gearbeitet, <w>also</w> schlief er am nächsten Morgen bis zum Mittag."
                        },
                        {
                            "text": "Die Straße war wegen Glatteis gesperrt, <w>also</w> mussten alle Autos eine lange Umleitung fahren."
                        }
                    ],
                    "synonyms": [
                        "daher",
                        "deshalb",
                        "deswegen",
                        "folglich",
                        "somit"
                    ],
                    "antonyms": [
                        "dennoch",
                        "trotzdem"
                    ]
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "e221a33b-d0aa-307f-a0c6-c5182d6eb4c3",
                    "sense_definition": "leitet eine Erzählung, eine Frage oder einen Gedanken ein",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "gespraechsfuehrung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Also</w>, worüber wolltet ihr gestern Nachmittag eigentlich mit mir und den anderen sprechen?"
                        },
                        {
                            "text": "<w>Also</w>, die Geschichte begann an einem sonnigen Tag vor vielen Jahren in Spanien."
                        }
                    ]
                },
                {
                    "sense_id": "902a0b17-e5c9-3107-a1eb-47d81269beff",
                    "sense_definition": "signalisiert Zustimmung, eine Einigung oder den Entschluss zum Handeln",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "gespraechsfuehrung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Also</w> gut, wir versuchen es genau so, wie du es gerade vorgeschlagen hast."
                        },
                        {
                            "text": "<w>Also</w> dann, packen wir die Sachen zusammen und fahren endlich los nach Hause!"
                        }
                    ],
                    "common_phrases": [
