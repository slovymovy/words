                    },
                    {
                        "form_id": "0a2fab98-6824-4335-91ae-8d971c2e5ad6",
                        "entry_id": "cd4b5147-512f-3331-8962-d4bd3009efe3",
                        "tags": [
                            "positive",
                            "predicative",
                            "plural"
                        ],
                        "form": "sie sind unverallgemeinerbar"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7cd91dec-7743-31b1-8f3a-f9c0da2c6439",
                        "entry_id": "cd4b5147-512f-3331-8962-d4bd3009efe3",
                        "glosses": [
                            "so, dass es nicht verallgemeinert werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0fe48677-c431-4217-95bf-311fbc7b3e59",
                                "sense_id": "7cd91dec-7743-31b1-8f3a-f9c0da2c6439",
                                "text": "„Auch werden Archive oft als so unverallgemeinerbar angesehen, dass die Auswahltätigkeit nicht in eine methodisch festgelegte, routinierte Praxis verwandelt werden kann.“"
                            },
                            {
                                "example_id": "c66a393f-0b81-4df6-a1ed-8a5c2c65bf52",
                                "sense_id": "7cd91dec-7743-31b1-8f3a-f9c0da2c6439",
                                "text": "„Jeder hätte seine spirituellen Privaterlebnisse, die schlechthin unverallgemeinerbar und somit unmitteilbar, letztlich so bedeutungslos wie ein gänzlich subjektives Rauscherlebnis blieben.“"
                            },
                            {
                                "example_id": "a1e1e3a7-9dc7-41a8-a612-28f4747eeae6",
                                "sense_id": "7cd91dec-7743-31b1-8f3a-f9c0da2c6439",
                                "text": "„Kann es sich um eine soziale oder gar eine moralische Welt handeln? Oder ist die van-Gogh-Welt idiosynkratisch, unverallgemeinerbar, nicht als Handlungswelt der Akteure denkbar?“"
                            },
                            {
                                "example_id": "81a8660d-2df9-421e-80e3-a4e6e6d82faa",
                                "sense_id": "7cd91dec-7743-31b1-8f3a-f9c0da2c6439",
                                "text": "„Die Gleichung »selten = entzückend«, im Falle des ‘da’, finde ich allenfalls originell, aber unverallgemeinerbar.“"
                            },
                            {
                                "example_id": "9ff1d3fa-1d8c-459c-8b2d-ab5dd93db6d8",
                                "sense_id": "7cd91dec-7743-31b1-8f3a-f9c0da2c6439",
                                "text": "„Nach der Fischanzahl zu fragen halte ich für ebenfalls ziemlich unverallgemeinerbar, weil ja nicht alle Fische exakt 3cm groß sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
