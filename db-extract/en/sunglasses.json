                    {
                        "translation_id": "66845036-7951-4a2c-a73c-f1f9d7dc17a7",
                        "source_entry_id": "870eab81-e05b-3fbf-bea0-98c67b40bfba",
                        "source_sense_description": "tinted glasses worn to protect the eyes from the sun",
                        "target_lang_word": "zonnebril",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zonnebril",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "084c3ff4-cb99-3463-80ad-f5f9863a9b7b",
                                        "entry_id": "0494724f-127e-3f14-bb95-8ae33ac83daa",
                                        "glosses": [
                                            "een bril met speciale glazen (dikwijls polaroid) om de ogen tegen het zonlicht te beschermen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45d510e9-183a-4475-ba7e-c464b2bbc091",
                                                "sense_id": "084c3ff4-cb99-3463-80ad-f5f9863a9b7b",
                                                "text": "Vergeet je zonnebril niet mee te nemen!"
                                            },
                                            {
                                                "example_id": "3795daa7-91c0-4b29-8243-82070f5242ef",
                                                "sense_id": "084c3ff4-cb99-3463-80ad-f5f9863a9b7b",
                                                "text": "De buren deinsden natuurlijk achteruit als je ze in de lift ontmoette, maar met het warme nazomerweer hoefde je alleen een zonnebril op te zetten om te verdwijnen in de anonimiteit van de miljoenenstad Hamburg."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "83472794-1af7-471c-829a-416e473d3c07",
                        "source_entry_id": "870eab81-e05b-3fbf-bea0-98c67b40bfba",
                        "source_sense_description": "tinted glasses worn to protect the eyes from the sun",
                        "target_lang_word": "lunettes de soleil",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lunettes de soleil",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cfcaa49e-7210-39af-add1-27710250d3f0",
                                        "entry_id": "a197aa58-fdfc-344d-a6a5-511f9573418e",
                                        "glosses": [
                                            "Lunettes qui servent à se protéger des rayons de la lumière, en particulier ceux du soleil."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0880bcd5-3384-4fd2-a32f-4a34189a9c6f",
                                                "sense_id": "cfcaa49e-7210-39af-add1-27710250d3f0",
                                                "text": "J’oublie de dire que ni Castor ni moi ne portions de lunettes dites de soleil, je ne suis même pas sûr que nous eussions su de quoi il retournait."
                                            },
                                            {
                                                "example_id": "ddca107f-81f6-4d2a-8062-d05573e9bcf5",
                                                "sense_id": "cfcaa49e-7210-39af-add1-27710250d3f0",
                                                "text": "Behnke, caché derrière ses lunettes de soleil, n’ouvrit pas la bouche de tout le trajet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e4352e9e-3884-469c-943f-52b51379e90e",
                        "source_entry_id": "870eab81-e05b-3fbf-bea0-98c67b40bfba",
                        "source_sense_description": "tinted glasses worn to protect the eyes from the sun",
                        "target_lang_word": "Sonnenbrille",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sonnenbrille",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "43d526f4-0dfc-3970-ad60-944fa52ed34c",
                                        "entry_id": "45d5b310-92bf-380c-a5ef-7c0ca80a0652",
                                        "glosses": [
                                            "Brille mit dunkel getönten Gläsern, die die Augen vor der Sonnenstrahlung schützen soll"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe76e12d-65df-498b-8af0-835cb7f0e09f",
                                                "sense_id": "43d526f4-0dfc-3970-ad60-944fa52ed34c",
                                                "text": "Im Sommer sind Sonnenbrillen für viele ein wichtiges Accessoire."
                                            },
                                            {
                                                "example_id": "6408720f-5f3f-47cd-b8e5-4ac06a8d6f54",
                                                "sense_id": "43d526f4-0dfc-3970-ad60-944fa52ed34c",
                                                "text": "„Ich verlasse die Markthalle, setze meine wiederhergestellte Sonnenbrille auf und blinzele glücklich in die strahlende Mittagssonne.“"
                                            },
                                            {
                                                "example_id": "4d6f6e4c-84ed-44bd-864a-9f7a7933ea06",
                                                "sense_id": "43d526f4-0dfc-3970-ad60-944fa52ed34c",
                                                "text": "„Meine Sonnenbrille beschlug und ich nahm sie ab.“"
                                            },
                                            {
                                                "example_id": "2fba8e48-4c7f-4058-918e-5c2d2d421eb7",
                                                "sense_id": "43d526f4-0dfc-3970-ad60-944fa52ed34c",
                                                "text": "„Sonnenbrille und dickes Eincremen waren jetzt wichtig.“"
                                            },
                                            {
                                                "example_id": "6e2a038c-ed15-4b1d-b39a-1fb7851c8947",
                                                "sense_id": "43d526f4-0dfc-3970-ad60-944fa52ed34c",
                                                "text": "„Sie tragen Sonnenbrillen.“"
                                            },
                                            {
                                                "example_id": "bbf00c02-14f8-47a8-87e9-08a4eaebd8dd",
                                                "sense_id": "43d526f4-0dfc-3970-ad60-944fa52ed34c",
                                                "text": "„In der Sonne setzte sie wieder Strohhut und Sonnenbrille auf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
