                        "examples": [
                            {
                                "example_id": "b66c950d-abcf-4367-94e6-64eb6fc79a78",
                                "sense_id": "cc336991-17fe-362d-b669-6413119ca116",
                                "text": "A short stop, but no refreshment. Such baits are frequently given by the natives of the principality to their keffels, or horses, particularly after climbing a hill."
                            },
                            {
                                "example_id": "7592986b-3836-4a56-bc00-a2884ac2831a",
                                "sense_id": "cc336991-17fe-362d-b669-6413119ca116",
                                "text": "Two keffels had been bespoke of our host, but as no time was to be lost in catching 'em, we mounted four men on two horses and once more traversed the rocky boggy plain to the hill-foot, just at which we met the keffels descending from the mountains."
                            }
                        ]
                    }
