                        "examples": [
                            {
                                "example_id": "48bd4afc-5486-4db6-b43b-aa3bea72c562",
                                "sense_id": "e9b6dd97-e22a-328e-bd5e-31cd6a2647c6",
                                "text": "Iedereen wist heel goed dat de ziekte van de mooie gravin voortkwam uit de onmogelijkheid met twee mannen tegelijk te trouwen en dat de behandelmethode van de Italiaan eruit bestond deze onmogelijkheid weg te nemen; maar in het bijzijn van Anna Pavlovna durfde niet alleen niemand dit te denken maar het was ook of niemand ervan wist."
                            },
                            {
                                "example_id": "25423e72-2fe9-48ff-8b15-fe49d5f792a7",
                                "sense_id": "e9b6dd97-e22a-328e-bd5e-31cd6a2647c6",
                                "text": "Uit eerdere studies lijkt er bewijs te zijn dat elektroshocktherapie een effectievere behandelmethode is in vergelijking met alleen medicatie. Desondanks kunnen elektroshocks bijwerkingen hebben, zoals geheugenverlies."
                            }
                        ]
