                    },
                    {
                        "translation_id": "45ac3762-6021-48bb-8c55-7f0d414046b6",
                        "source_entry_id": "df23dea1-b3cf-32c5-ae3c-de7c6c3d4930",
                        "target_lang_word": "LOL",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "LOL",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "25f23c03-07f3-3c24-bd05-6794a86a59aa",
                                        "entry_id": "e7a9c2af-c257-3263-a603-f9e2921d08fa",
                                        "glosses": [
                                            "Laughing (or laugh) out loud."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bdaee20e-bad2-43a8-8c7d-ff831bb274e8",
                                                "sense_id": "25f23c03-07f3-3c24-bd05-6794a86a59aa",
                                                "text": "I just saw the video where he opens the door and gets the surprise! LOL!"
                                            },
                                            {
                                                "example_id": "dce05945-d624-4694-8788-f041e704d344",
                                                "sense_id": "25f23c03-07f3-3c24-bd05-6794a86a59aa",
                                                "text": "Bro got milk spilt over his head! LOL!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c72c7ee-b400-397a-a1a0-ed97a772225f",
                                        "entry_id": "e7a9c2af-c257-3263-a603-f9e2921d08fa",
                                        "glosses": [
                                            "Lots of laughs. (occasionally used)"
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c33b09ca-2f69-4eab-8270-32c9e6715bf7",
                                                "sense_id": "2c72c7ee-b400-397a-a1a0-ed97a772225f",
                                                "text": "I love the one where he orders a cup of tea but then chaos ensues! LOL!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "afb93e50-9d0d-3017-b262-9b653881c7a2",
                                        "entry_id": "e7a9c2af-c257-3263-a603-f9e2921d08fa",
                                        "glosses": [
                                            "Indicates light-heartedness or amusement, or that the accompanying statement is not intended as serious; sometimes extends to irony or sardonicism, in the same way that spoken humor sometimes does."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1bd23ff4-29f3-4986-9ad7-7fc178c4fecb",
                                                "sense_id": "afb93e50-9d0d-3017-b262-9b653881c7a2",
                                                "text": "I hope you weren't expecting a welcome wagon, LOL."
                                            },
                                            {
                                                "example_id": "67c2bf46-789e-41ae-9037-09aa3784ea2f",
                                                "sense_id": "afb93e50-9d0d-3017-b262-9b653881c7a2",
                                                "text": "In the course of managing your expectations, you'll need to account for the usual amount of pettiness and dishonesty among your fellow humans lol."
                                            },
                                            {
                                                "example_id": "7d2984bb-73b0-401d-850e-d50b93caf7b0",
                                                "sense_id": "afb93e50-9d0d-3017-b262-9b653881c7a2",
                                                "text": "And if you're sad about someone, something that was fun once is now really painful. So it sorta started out as \"L-O-L, you're getting water in my mouth\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d46b27ad-41eb-3951-a4c3-ee62a41971f8",
                                        "entry_id": "e7a9c2af-c257-3263-a603-f9e2921d08fa",
                                        "glosses": [
                                            "Lots of love."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa8db101-9ea1-48c8-b370-b9b639261f41",
                                                "sense_id": "d46b27ad-41eb-3951-a4c3-ee62a41971f8",
                                                "text": "P.S.: Give my regards to Elizabeth and to the children! LOL!"
                                            },
                                            {
                                                "example_id": "c7a91c57-315b-436e-9f5a-0d0e36036254",
                                                "sense_id": "d46b27ad-41eb-3951-a4c3-ee62a41971f8",
                                                "text": "SHEESH !!!! ¶ LOL (Laugh out loud) &&&& ¶ LOL (Lots of love, coz I'm a sharing caring kinda gal) ¶ Nikki"
                                            },
                                            {
                                                "example_id": "cd1da529-7343-47e0-9fcc-d6eea6ce9c57",
                                                "sense_id": "d46b27ad-41eb-3951-a4c3-ee62a41971f8",
                                                "text": "Explaining how much I hated being away from him for another weekend, how I had to do it to pay for his school, for our life. Heartfelt, heart-full, I signed it \"LOL, Dad.\". Then a pause. And I see appearing on my screen these words. \"Dad: what exactly do you think LOL means?\" \"Lots of Love, obviously,\" I replied."
                                            },
                                            {
                                                "example_id": "11f63426-f4d0-4889-a734-d71840593150",
                                                "sense_id": "d46b27ad-41eb-3951-a4c3-ee62a41971f8",
                                                "text": "The answer is in Job 40:7 to the end of the chapter, and 2 tim 2:11 thru 2:21. LOL, Dad Miscommunication: I was thinking he was laughing he didn't tell that was not true. An on-looker said he may mean lots of love. I asked and he didn't answer but he hugged me the next time he saw me for two seconds. Progress not perfection."
                                            },
                                            {
                                                "example_id": "9938baed-659f-489b-9320-f3c3b185a964",
                                                "sense_id": "d46b27ad-41eb-3951-a4c3-ee62a41971f8",
                                                "text": "John 21:15, 16,17 Back in the fifties, when I used to write childish letters in long-hand to my grandmothers, I would delight in closing with LOL, by which I intended the sentiment \"Lots of Love\"! This was followed by \"XOXOXOXO\", which, of course, was hugs and kisses."
                                            },
                                            {
                                                "example_id": "cab01a7f-b780-4341-84b5-1c3555d4b2b8",
                                                "sense_id": "d46b27ad-41eb-3951-a4c3-ee62a41971f8",
                                                "text": "One of the most famous examples of this misunderstanding came to prominence three years ago, thanks to a screengrab of this text message sent by a mother to her son: \"Your great aunt just passed away. LOL\"."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "LOL",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "236ff5e8-3b43-3c84-a734-2f52fc65450a",
                                        "entry_id": "0f8dd6c5-5327-367c-b790-c7dd334d7372",
                                        "glosses": [
                                            "To laugh out loud."
