        "fr-extract.jsonl": [
            {
                "entry_id": "2d924b15-82fb-3e80-84cc-8166f8b556f6",
                "word": "bruxisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c269e759-e683-4ffd-88fe-a632ec49af66",
                        "entry_id": "2d924b15-82fb-3e80-84cc-8166f8b556f6",
                        "tags": [
                            "plural"
                        ],
                        "form": "bruxismes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "dc8f9506-e858-3cde-a3a2-dc9b8e6960ff",
                        "entry_id": "2d924b15-82fb-3e80-84cc-8166f8b556f6",
                        "glosses": [
                            "Pathologie entrainant un grincement des dents ou une contracture soutenue de la mâchoire."
                        ],
                        "tags": [
                            "Nosologie"
                        ],
                        "examples": [
                            {
                                "example_id": "8a2f198f-217c-4a88-87e9-4446294a63e4",
                                "sense_id": "dc8f9506-e858-3cde-a3a2-dc9b8e6960ff",
                                "text": "La piste du rôle des neuromédiateurs du système nerveux central dans l’initiation du bruxisme est actuellement privilégiée, bien que l’aspect multifactoriel (stress, drogues, médicaments,...) reste certain."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c8f6d92e-0ea0-484b-928d-da344e419ca5",
                        "source_entry_id": "2d924b15-82fb-3e80-84cc-8166f8b556f6",
                        "source_sense_id": "dc8f9506-e858-3cde-a3a2-dc9b8e6960ff",
                        "target_lang_word": "bruxism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bruxism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e0b9c61b-df75-3d93-a587-2c68391d235a",
                                        "entry_id": "2520c510-e59a-38c8-9906-2b483d7f0753",
                                        "glosses": [
                                            "The habit or practice of grinding the teeth, as while sleeping, or due to stress or certain drugs."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "711b73b7-79d7-4e32-be3a-2df4a01bbff4",
                                                "sense_id": "e0b9c61b-df75-3d93-a587-2c68391d235a",
                                                "text": "Bruxism is defined as occlusal stress during sleep."
                                            },
                                            {
                                                "example_id": "de2b99e1-7ff4-4b47-82eb-655c99eb8bc9",
                                                "sense_id": "e0b9c61b-df75-3d93-a587-2c68391d235a",
                                                "text": "Employment of autosuggestion in the treatment of \"bruxism\" may not be so well known."
                                            },
                                            {
                                                "example_id": "2cf97141-c574-42da-9966-84757886dfdc",
                                                "sense_id": "e0b9c61b-df75-3d93-a587-2c68391d235a",
                                                "text": "At the conclusion of the second International Conference on Endodontics in 1958 there was listed in the final summation the following very conservative statement: \"There is a possibility that in rare cases bruxism may cause the death of the pulp.\""
                                            },
                                            {
                                                "example_id": "065e45b9-74a3-4373-b787-0c4623989a31",
                                                "sense_id": "e0b9c61b-df75-3d93-a587-2c68391d235a",
                                                "text": "Disturbances of the Masticatory System gives a comprehensive outline of factors involved with a broad perspective as to the etiology of bruxisms, traumatic occlusion and functional disturbances of the temporomandibular joints and muscles."
                                            },
                                            {
                                                "example_id": "9adadc27-d1c9-4700-8645-d3b09247ec37",
                                                "sense_id": "e0b9c61b-df75-3d93-a587-2c68391d235a",
                                                "text": "[B. Z.] Rabinowitch feels that internal resorption may be caused by traumatic occlusion. He cites a case of internal resorption where there was no history or evidence other than continued bruxism as the etiology."
                                            },
                                            {
                                                "example_id": "0955b86f-e0b5-431c-acd9-af284c5a63bd",
                                                "sense_id": "e0b9c61b-df75-3d93-a587-2c68391d235a",
                                                "text": "Abnormal function [of the temporomandibular joint], in turn, may be the result of a structural problem such as dental malocclusion or a functional problem such as bruxism (clenching and grinding of the teeth)."
                                            },
                                            {
                                                "example_id": "ebca1209-86ba-44c1-917e-2466ffd310a7",
                                                "sense_id": "e0b9c61b-df75-3d93-a587-2c68391d235a",
                                                "text": "Caffeine intake in high quantity is linked with an increased risk of sleep bruxisms in 1.5 times through mechanisms currently unknown. Heavy drinking and frequent alcohol intake during the day have also been associated with sleep bruxism."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4c950904-d758-442c-b8a3-8da5d70239df",
                        "source_entry_id": "2d924b15-82fb-3e80-84cc-8166f8b556f6",
                        "source_sense_id": "dc8f9506-e858-3cde-a3a2-dc9b8e6960ff",
