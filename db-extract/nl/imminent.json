                "senses": [
                    {
                        "sense_id": "a1cc5613-c3c6-3a7f-9f8b-995c450cd1df",
                        "entry_id": "b7a84ee9-cd19-37e8-a821-9540e423a68d",
                        "glosses": [
                            "van iets dat het op korte termijn kan gebeuren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fcfcf543-d13e-4d48-8a0a-06ed24a133da",
                                "sense_id": "a1cc5613-c3c6-3a7f-9f8b-995c450cd1df",
                                "text": "De eerste rechtstreekse waarschuwingen voor een mogelijke aanval van al-Qaida dateren van de lente van 2001, schrijft hij. Op 1 mei schreef de geheime dienst CIA dat 'een momenteel in de VS aanwezige groep' een terreuraanslag aan het voorbereiden was. Op 22 juli luidde het dat aanvallen van al-Qaida 'imminent' konden zijn."
                            },
                            {
                                "example_id": "6ed51159-8240-483f-b067-f76b873461f2",
                                "sense_id": "a1cc5613-c3c6-3a7f-9f8b-995c450cd1df",
                                "text": "Dinsdag werd beslist om na de aanslagen op de luchthaven van Zaventem en het metrostation Maalbeek in Brussel het dreigingsniveau te verhogen naar vier. Dat betekent dat de dreiging 'zeer ernstig en imminent is'."
                            }
                        ]
                    }
                ],
                "translations": [
