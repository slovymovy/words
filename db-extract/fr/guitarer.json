                        "glosses": [
                            "Jouer de la guitare."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2cb72df-a855-4116-9da3-095f775d07ac",
                                "sense_id": "32fcea19-1d48-3342-9048-8741b35d0671",
                                "text": "Depuis quinze ans, en ça, poursuit-il, « tout notre monde s’est mis à guitarer »."
                            },
                            {
                                "example_id": "273e78bf-9ec2-41c8-885c-ac5acdf3a182",
                                "sense_id": "32fcea19-1d48-3342-9048-8741b35d0671",
                                "text": "Le temps n’est plus des sérénades, ni de mourir sous les balcons. Serait-ce bien la peine de « guitarer » sa peine ?"
                            }
                        ]
                    }
