                ],
                "translations": [
                    {
                        "translation_id": "169a35af-e58d-449d-b687-599f5af17dee",
                        "source_entry_id": "752c0886-5ec2-3423-961b-7ea52bf89ec0",
                        "source_sense_id": "1ef26983-fb29-3da1-ac21-5c7d2943ea3a",
                        "source_sense_description": "een zeer heftige regenbui",
                        "target_lang_word": "downpour",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "downpour",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7d5db4be-7990-378a-89ae-ea1b83d53826",
                                        "entry_id": "ec5200c8-e9cd-3c86-8ec8-954e09d92f0c",
                                        "glosses": [
                                            "A heavy rain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75af58f8-8d09-405d-9e47-bf50b5a7e750",
                                                "sense_id": "7d5db4be-7990-378a-89ae-ea1b83d53826",
                                                "text": "They got caught in a downpour without an umbrella and came back soaked."
                                            },
                                            {
                                                "example_id": "d5815f23-7541-4881-8c00-2cb063b41a22",
                                                "sense_id": "7d5db4be-7990-378a-89ae-ea1b83d53826",
                                                "text": "I left Inverness on a Saturday afternoon in July in a steady downpour of rain."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "downpour",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3dc469b6-5cb4-33f0-8b0f-ea4246a5f0aa",
                                        "entry_id": "1202e03f-54e7-3654-97a3-65b309fc9e33",
                                        "glosses": [
                                            "To pour down; rain heavily."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed8f2804-c6ae-4f28-9011-a09c406d91af",
                                                "sense_id": "3dc469b6-5cb4-33f0-8b0f-ea4246a5f0aa",
                                                "text": "It started to downpour, so Billy and I made our way back to our house, with Scotty following—or so I thought."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1ac42851-2f96-412a-aea6-9676a9974f03",
                        "source_entry_id": "752c0886-5ec2-3423-961b-7ea52bf89ec0",
                        "source_sense_id": "1ef26983-fb29-3da1-ac21-5c7d2943ea3a",
                        "source_sense_description": "een zeer heftige regenbui",
                        "target_lang_word": "douche",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "douche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "feb6ee0c-a6b7-3814-89bb-e66e159a6dff",
                                        "entry_id": "a1a6c968-344d-317b-a33b-ebdb5b67a800",
                                        "glosses": [
                                            "Eau naturelle ou minérale qu’on projette sur tout le corps ou sur une partie du corps pour produire une action hygiénique ou thérapeutique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b77960b-ee36-4ba3-a9eb-a388d6a1a07b",
                                                "sense_id": "feb6ee0c-a6b7-3814-89bb-e66e159a6dff",
                                                "text": "Voilà l’image de ma vie : je devrais fredonner gaiement sous la douche, tout à la joie de ce jour nouveau, et je m’engonce dans l’amère moiteur de maussades ruminements."
                                            },
                                            {
                                                "example_id": "d0e45667-e01c-4bca-9f1d-d96271efb8ad",
                                                "sense_id": "feb6ee0c-a6b7-3814-89bb-e66e159a6dff",
                                                "text": "Si tu permets, je vais prendre une bonne douche et me mettre à l'aise.\n— Faites donc, vous êtes chez vous. Moi aussi, j’ai pris une douche quand Valérie est partie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6dbb7866-49e5-32a2-9c4e-d3795ac77cb0",
                                        "entry_id": "a1a6c968-344d-317b-a33b-ebdb5b67a800",
                                        "glosses": [
                                            "Aménagement de salle de bain, de sauna ou hammam, etc. pour s’asperger ou se laver ainsi."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94bb6360-fca4-4e1c-b00c-36f113a474d3",
                                                "sense_id": "6dbb7866-49e5-32a2-9c4e-d3795ac77cb0",
                                                "text": "Elle n’aperçut qu’un petit lit de fer sans rideaux, un appareil à douches dans un coin, une longue table de bois noir, des chaises, et sur la table, sur des planches, le long des murs, toute une alchimie, des mortiers, des fourneaux, des machines, des trousses."
                                            },
                                            {
                                                "example_id": "01281182-de6a-4079-9a79-33a9032fbad3",
                                                "sense_id": "6dbb7866-49e5-32a2-9c4e-d3795ac77cb0",
                                                "text": "Tu as inspecté la douche, pas la penderie. Qui se planquerait dans une douche ? On a toutes les chances d’y être zigouillé. Tu ne vas pas au cinéma ? Psychose. Mort dans la douche."
                                            },
                                            {
                                                "example_id": "cd4bcdf6-b2bf-419b-86eb-5085490f3b0f",
                                                "sense_id": "6dbb7866-49e5-32a2-9c4e-d3795ac77cb0",
                                                "text": "Rozan prévint son ami et tous deux se ruèrent sur la douche afin d’éviter que cet étonnant produit ne leur décapât complètement la peau !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d1b67cf-de96-3050-b4d9-4cac7f8ebcff",
                                        "entry_id": "a1a6c968-344d-317b-a33b-ebdb5b67a800",
                                        "glosses": [
                                            "Réprimande ou invective, déception imprévue, violente et pénible."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c90c61d-dc8f-4597-acf8-dbb470a12a95",
                                                "sense_id": "2d1b67cf-de96-3050-b4d9-4cac7f8ebcff",
                                                "text": "Je lui ai donné la douche qu’il méritait."
                                            },
                                            {
                                                "example_id": "8bdf9524-5deb-4293-8bf3-6ea15bc0af28",
                                                "sense_id": "2d1b67cf-de96-3050-b4d9-4cac7f8ebcff",
                                                "text": "Il a reçu une bonne douche à laquelle il ne s’attendait pas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e39c7df-b99c-382f-bda3-1ea67d3aa60e",
                                        "entry_id": "a1a6c968-344d-317b-a33b-ebdb5b67a800",
                                        "glosses": [
                                            "Figure où les objets décrivent une trajectoire ovale en passant de la première main à la seconde de manière quasiment horizontale et de la seconde à la première en trajectoire parabolique."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e43677aa-2729-389c-bb86-de842d651ee6",
                                        "entry_id": "a1a6c968-344d-317b-a33b-ebdb5b67a800",
                                        "glosses": [
                                            "Projecteur placé verticalement au-dessus de la scène."
                                        ],
