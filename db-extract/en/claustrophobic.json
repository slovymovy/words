                ],
                "senses": [
                    {
                        "sense_id": "4ee3638b-1b29-3050-bcd6-cc77a0360fac",
                        "entry_id": "114748d2-b522-324a-8661-c75a03f6e5af",
                        "glosses": [
                            "Suffering from claustrophobia; being scared of being enclosed in a confined space."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca940c18-5d09-4ede-976b-b1ba5a285f3c",
                                "sense_id": "4ee3638b-1b29-3050-bcd6-cc77a0360fac",
                                "text": "Using her hands like windshield wipers, she tried to flick snow away from her mouth. When she clawed at her chest and neck, the crumbs maddeningly slid back onto her face. She grew claustrophobic."
                            }
                        ]
                    },
                    {
                        "sense_id": "eabc97a8-998a-320b-825e-d088c67e7aac",
                        "entry_id": "114748d2-b522-324a-8661-c75a03f6e5af",
                        "glosses": [
                            "Cramped and confined, so as to induce claustrophobia."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91d49b6d-a487-4a26-ab63-0faf2dadf244",
                                "sense_id": "eabc97a8-998a-320b-825e-d088c67e7aac",
                                "text": "...within the monstrous arrangements of dried flowers on the table-tops, against the Victorian clutter of that claustrophobic room..."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3562cabf-742a-40be-b6c0-639a0fb27a1b",
                        "source_entry_id": "114748d2-b522-324a-8661-c75a03f6e5af",
                        "source_sense_description": "Suffering from claustrophobia",
                        "target_lang_word": "claustrophobe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "claustrophobe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f6c84518-3137-3068-962e-0aea7cb960ea",
                                        "entry_id": "1002bc17-cb5d-3daa-9ca5-3f5772930ed8",
                                        "glosses": [
                                            "Personne atteinte de claustrophobie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b81678c-56c2-4f77-8b18-acbf0a5fd1ba",
                                                "sense_id": "f6c84518-3137-3068-962e-0aea7cb960ea",
                                                "text": "On a constaté que lorsqu’on emprisonne un claustrophobe (quelqu’un qui ne supporte pas d’être enfermé dans un espace exigu), il souffre très fort durant les premiers jours, mais qu’ensuite il s’adapte et est alors définitivement guéri."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "claustrophobe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fe4178b3-2803-355b-bed2-f3bdbbe1dae8",
                                        "entry_id": "d980f7dd-1941-3e75-adf7-3738d0c4a385",
                                        "glosses": [
                                            "Atteint de claustrophobie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b7eb050-97c4-401b-9e5a-3b010341ae9e",
                                                "sense_id": "fe4178b3-2803-355b-bed2-f3bdbbe1dae8",
                                                "text": "Par contre, soyez gentils et ouvrez vite la boîte, ôtez le couvercle, car j’ai peur de souffrir d’angoisse claustrophobe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
