                                        "sense_id": "6267db7e-ce20-3e9c-850a-b4b4a4ed5044",
                                        "entry_id": "361cf80a-0c5b-30cc-aae8-c5ddec942a62",
                                        "glosses": [
                                            "een bedrieglijke kopie maken van een waardevol voorwerp"
