                        {
                            "text": "Musisz poprosić rodziców o pisemną <zgodę> na wycieczkę.",
                            "target_lang_translations": {
                                "ru": "Ты должен попросить у родителей письменное <согласие> на экскурсию.",
                                "en": "You must ask your parents for written <consent> for the trip.",
                                "nl": "Je moet je ouders om schriftelijke <toestemming> vragen voor de uitstap.",
                                "de": "Du musst deine Eltern um eine schriftliche <w>Einverständniserklärung</w> für den Ausflug bitten.",
                                "fr": "Tu dois demander à tes parents une <autorisation> écrite pour la sortie.",
                                "it": "Devi chiedere ai tuoi genitori il <consenso> scritto per la gita.",
                                "cs": "Musíš požádat rodiče o písemný <w>souhlas</w> s výletem.",
                                "tr": "Gezi için velilerinden yazılı <izin> istemelisin.",
                                "es": "Tienes que pedir a tus padres un <w>permiso</w> por escrito para la excursión."
                            }
                        },
                        {
                            "text": "Dyrektor wyraził <zgodę> na mój urlop w przyszłym tygodniu.",
                            "target_lang_translations": {
                                "ru": "Директор дал <согласие> на мой отпуск на следующей неделе.",
                                "en": "The director gave his <permission> for my leave next week.",
                                "nl": "De directeur heeft <toestemming> gegeven voor mijn verlof volgende week.",
                                "de": "Der Direktor hat seine <w>Zustimmung</w> zu meinem Urlaub nächste Woche gegeben.",
                                "fr": "Le directeur a donné son <accord> pour mes congés la semaine prochaine.",
                                "it": "Il direttore ha dato il suo <benestare> per le mie ferie la prossima settimana.",
                                "cs": "Ředitel vyjádřil <w>souhlas</w> s mou dovolenou v příštím týdnu.",
                                "tr": "Müdür önümüzdeki haftaki iznim için <onay> verdi.",
                                "es": "El director dio su <w>aprobación</w> para mis vacaciones de la próxima semana."
                            }
                        }
