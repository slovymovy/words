                        "glosses": [
                            "strikte Aufforderung zur Unterlassung jeglichen Kontakts mit Sanktionsdrohung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "511a662d-b7db-4791-a9ec-a1e0c912ed3d",
                                "sense_id": "50a791a5-dc12-39b1-a7b9-b3fd3ec79fba",
