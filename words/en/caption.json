{
    "word_family": [
        "captious"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fce395b1-af2e-393a-b1dc-f2de476918c4",
                    "sense_definition": "A short title or explanation written under a picture, photograph, or cartoon.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "text_label",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>caption</w> under the photo explains who is in the picture.",
                            "target_lang_translations": {
                                "zh": "照片下方的<w>说明文字</w>解释了照片里的人是谁。"
                            }
                        },
                        {
                            "text": "Please read the <w>caption</w> to understand the context of this image.",
                            "target_lang_translations": {
                                "zh": "请阅读<w>题注</w>以了解这张图片的背景。"
                            }
                        }
                    ],
                    "synonyms": [
                        "label",
                        "legend"
                    ],
                    "common_phrases": [
                        "photo caption",
                        "write a caption"
                    ],
                    "target_lang_definitions": {
                        "zh": "图片、照片或漫画下方的简短说明文字。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "说明文字",
                                "target_lang_sense_clarification": "指图片下方的文字说明。"
                            },
                            {
                                "target_lang_word": "题注",
                                "target_lang_sense_clarification": "指图片或图表的标题或注释。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b92feb6b-c0bd-31ca-ba80-5006cb560aec",
                    "sense_definition": "Text displayed on a screen during a film or broadcast to provide dialogue for viewers who cannot hear.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "text_label",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The movie has a <w>caption</w> for every line of dialogue.",
                            "target_lang_translations": {
                                "zh": "这部电影的每一句对话都有<w>字幕</w>。"
                            }
                        },
                        {
                            "text": "Turn on the <w>caption</w> if you are watching in a noisy room.",
                            "target_lang_translations": {
                                "zh": "如果你在嘈杂的房间里看视频，请打开<w>字幕</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "subtitle"
                    ],
                    "common_phrases": [
                        "closed caption"
                    ],
                    "target_lang_definitions": {
                        "zh": "电影或电视节目中显示的文字，为听障人士提供对话内容。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "字幕",
                                "target_lang_sense_clarification": "指屏幕上显示的对话文字。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "122f6b62-c654-3b8c-9131-4df8659ce6e0",
                    "sense_definition": "A descriptive heading or title for a document or a section of a document.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "text_label",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>caption</w> at the top of the page summarizes the report.",
                            "target_lang_translations": {
                                "zh": "页面顶部的<w>标题</w>概括了这份报告的内容。"
                            }
                        },
                        {
                            "text": "Each section of the legal document has a clear <w>caption</w>.",
                            "target_lang_translations": {
                                "zh": "这份法律文件的每一部分都有清晰的<w>小标题</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "heading",
                        "title"
                    ],
                    "target_lang_definitions": {
                        "zh": "文档或文档章节的描述性标题。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "标题",
                                "target_lang_sense_clarification": "指文档或章节的名称。"
                            },
                            {
                                "target_lang_word": "小标题",
                                "target_lang_sense_clarification": "指文档中段落的标题。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3668685d-f3de-393d-89c4-eb1809ae9cf5",
                    "sense_definition": "The act of seizing or taking possession of property.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "legal_seizure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The legal <w>caption</w> of the goods was authorized by the court.",
                            "target_lang_translations": {
                                "zh": "法院授权了对这些货物的法律<w>扣押</w>。"
                            }
                        },
                        {
                            "text": "The officer recorded the <w>caption</w> of the stolen items in his report.",
                            "target_lang_translations": {
                                "zh": "警官在报告中记录了对被盗物品的<w>扣押</w>情况。"
                            }
                        }
                    ],
                    "synonyms": [
                        "seizure",
                        "capture"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Used primarily in legal contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "扣押或没收财产的行为（法律用语）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "扣押",
                                "target_lang_sense_clarification": "指法律上对财产的强制占有。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ccb46aa2-1cb1-3767-ae05-59a9b06fc88f",
                    "sense_definition": "To add a descriptive title or explanation to a text or illustration.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "text_label",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>caption</w> your photos before posting them online.",
                            "target_lang_translations": {
                                "zh": "你在网上发布照片前应该先<w>加注说明</w>。"
                            }
                        },
                        {
                            "text": "The editor will <w>caption</w> the images to make them easier to understand.",
                            "target_lang_translations": {
                                "zh": "编辑会为这些图片<w>加注说明</w>，以便读者更容易理解。"
                            }
                        }
                    ],
                    "synonyms": [
                        "label"
                    ],
                    "target_lang_definitions": {
                        "zh": "为文本或插图添加描述性标题或说明。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "加注说明",
                                "target_lang_sense_clarification": "指为图片添加文字说明。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2190ec4a-1de1-39f4-ad45-6d1d82ec1add",
                    "sense_definition": "To provide text for a film or broadcast for accessibility.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "text_label",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The studio decided to <w>caption</w> the entire documentary series.",
                            "target_lang_translations": {
                                "zh": "制片厂决定为整部纪录片系列<w>加字幕</w>。"
                            }
                        },
                        {
                            "text": "It is important to <w>caption</w> videos for viewers with hearing impairments.",
                            "target_lang_translations": {
                                "zh": "为听障观众的视频<w>加字幕</w>非常重要。"
                            }
                        }
                    ],
                    "synonyms": [
                        "subtitle"
                    ],
                    "target_lang_definitions": {
                        "zh": "为电影或广播节目添加字幕以提高无障碍性。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "加字幕",
                                "target_lang_sense_clarification": "指为视频制作字幕。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}