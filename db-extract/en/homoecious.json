                    {
                        "sense_id": "b1fec96d-0ec1-3151-b2b7-237bb65e0455",
                        "entry_id": "50f7eaa2-fb45-3ef7-9d62-97d3856085d4",
                        "glosses": [
                            "A plant species having only hermaphroditic flowers (also known as bisexual or perfect flowers), that is those with both carpels (female) and stamens (male)."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "fb477a84-73b8-4b9e-a9f2-67c1a545bf1c",
                                "sense_id": "b1fec96d-0ec1-3151-b2b7-237bb65e0455",
                                "text": "Further, we use homoecious to describe angiosperms with only bisexual flowers. This is an alternative state to heteroecious and complements monoecious and dioecious."
                            },
                            {
                                "example_id": "74fc8ae3-fe0f-4fff-bae1-55593191eb65",
                                "sense_id": "b1fec96d-0ec1-3151-b2b7-237bb65e0455",
                                "text": "Cryptanthus has been divided into two subgenera: (1) Cryptanthus, comprising andromonoecious plants, i.e. plants which harbour both hermaphroditic and male flowers on the same plant, and (2) Hoplocryptanthus Mez with homoecious plants (i.e. with hermaphroditic flowers only)"
                            }
                        ]
                    }
