                "senses": [
                    {
                        "sense_id": "f9b4b24e-6def-30f1-8947-62f021cdfaa2",
                        "entry_id": "96f5ea9d-5ef5-3601-bb4f-7ecd1fe8cf5c",
                        "glosses": [
                            "To ride a BMX bike."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "f7955a76-1162-4661-8d56-153976890ae2",
                                "sense_id": "f9b4b24e-6def-30f1-8947-62f021cdfaa2",
                                "text": "I BMXed from 1978 (my first race) till not too long ago. Although I don't see too many freestylers in the net, I get in touch with quite a few ex-BMXers like myself on rec.bicycles.off-road (I'm cross-posting to it)."
                            },
                            {
                                "example_id": "0b99dcfe-5866-4357-890d-b9de1661cba3",
                                "sense_id": "f9b4b24e-6def-30f1-8947-62f021cdfaa2",
                                "text": "Yeah, flippity trick things are fun. I've got a friend who has BMXed for 15-16 years! He rules, and he used to be sponsored."
                            }
                        ]
                    }
                ],
