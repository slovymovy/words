                    {
                        "translation_id": "5d998293-6f3e-4bc0-9388-06e30d4b532f",
                        "source_entry_id": "6e83b168-7c0c-3542-b929-a71e80a18b3c",
                        "source_sense_id": "1fcf312a-df0b-344f-b048-b18ac9a2be17",
