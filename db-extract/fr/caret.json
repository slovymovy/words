                    {
                        "sense_id": "469f6554-0a2d-32e7-8316-9d8ffb05d899",
                        "entry_id": "461b298f-8e4f-34b1-8d81-a0b8124e7f79",
                        "glosses": [
                            "carex, sedge"
                        ],
                        "tags": [
