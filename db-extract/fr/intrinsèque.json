        "fr-extract.jsonl": [
            {
                "entry_id": "2444530f-fd02-3a61-9777-0597a4e1e8fe",
                "word": "intrinsèque",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d0bd76f1-de69-4b53-8189-053485b7475f",
                        "entry_id": "2444530f-fd02-3a61-9777-0597a4e1e8fe",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "intrinsèques"
                    },
                    {
                        "form_id": "1ca850c2-8c8e-415c-9dfe-2898e0b37da0",
                        "entry_id": "2444530f-fd02-3a61-9777-0597a4e1e8fe",
                        "tags": [],
                        "form": "intrasèque"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f60c8865-798a-31d0-a5db-fa13c509b8b0",
                        "entry_id": "2444530f-fd02-3a61-9777-0597a4e1e8fe",
                        "glosses": [
                            "Propre à une chose ; indépendant d'un jugement ou facteur externe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7201483-4980-4d02-8765-2a8542d63560",
                                "sense_id": "f60c8865-798a-31d0-a5db-fa13c509b8b0",
                                "text": "[…] ils sont partis des solutions les plus catégoriques pour aboutir finalement à un constat d'impuissance, ce qui prouve que la Scolastique est morte d'elle-même, pour des raisons purement intrinsèques."
                            },
                            {
                                "example_id": "43242fd0-a0c4-4f75-b2c4-c2924c02b6fb",
                                "sense_id": "f60c8865-798a-31d0-a5db-fa13c509b8b0",
                                "text": "Dans toutes ses expressions extrinsèques et intrinsèques, visibles et invisibles, la Personne divino-humaine du Christ reste toujours une et indivisible."
                            },
                            {
                                "example_id": "f219ca22-c450-41bb-9b63-55b82aaa4bc9",
                                "sense_id": "f60c8865-798a-31d0-a5db-fa13c509b8b0",
                                "text": "Qualités, propriétés intrinsèques. — Bonté intrinsèque."
                            }
                        ]
                    },
                    {
                        "sense_id": "c86c1272-5627-3677-8513-54a1a0f8e083",
                        "entry_id": "2444530f-fd02-3a61-9777-0597a4e1e8fe",
                        "glosses": [
                            "Qualifie la valeur qu’ont les objets indépendamment de toute convention, valeur de quelqu’un ou de quelque chose en soi et pour soi, indépendamment de son utilité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5526ffda-279e-4d36-9a32-4daf1ac3b3c0",
                                "sense_id": "c86c1272-5627-3677-8513-54a1a0f8e083",
                                "text": "Nous sommes persuadés que la pauvreté n'est pas une propriété intrinsèque de notre pays. Et dès lors, nous pouvons nous en sortir."
                            }
                        ]
                    },
                    {
                        "sense_id": "083701fd-4058-3eb0-9057-6f8a6759924a",
                        "entry_id": "2444530f-fd02-3a61-9777-0597a4e1e8fe",
                        "glosses": [
                            "Qualifie la valeur des pièces de monnaie par rapport à leur poids."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "46b168ed-c9b1-4ad8-b1a9-7833c8f02531",
                                "sense_id": "083701fd-4058-3eb0-9057-6f8a6759924a",
                                "text": "Les peuples préhistoriques ont eu des conventions monétaires, de coquillages, pierres, pépites ou lingots de métaux précieux, de valeur intrinsèque relative constante, pour acheter des objets moins portatifs dont le possesseur était titulaire. C'était des constitutions financières démocratiques de l'âge d'or."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "79ead4fb-3d98-47ec-8b23-1b2364016f12",
                        "source_entry_id": "2444530f-fd02-3a61-9777-0597a4e1e8fe",
                        "target_lang_word": "intrinsisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intrinsisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f77ef09c-96c3-3975-983a-394fe6049272",
                                        "entry_id": "130ccf65-59a6-37c9-8f1f-1bb047e934c8",
                                        "glosses": [
                                            "von sich aus aufweisend; einem Ding oder System innewohnend, ohne äußere Ursache oder Beeinflussung vorliegend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b78eca1-edc6-4235-95ce-dd82f295b639",
                                                "sense_id": "f77ef09c-96c3-3975-983a-394fe6049272",
                                                "text": "Wer seine Arbeit aus eigenem Antrieb leistet, ist intrinsisch motiviert, wer dasselbe nur des Geldes wegen tut, dessen Motivation ist extrinsisch."
                                            },
                                            {
                                                "example_id": "e46174a9-c469-47ea-8485-efa0ff33cda8",
                                                "sense_id": "f77ef09c-96c3-3975-983a-394fe6049272",
                                                "text": "Die intrinsischen Gitterparameter eines Kristalls kann man messen, wenn er keinem Druck ausgesetzt und auch sonst nicht irgendwie verzerrt ist."
                                            },
                                            {
                                                "example_id": "98240daf-7bb6-4edb-a079-bdc1cf5d5d2b",
                                                "sense_id": "f77ef09c-96c3-3975-983a-394fe6049272",
                                                "text": "Dieser Gegenstand ist für mich von intrinsischem Wert."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1c6e9529-2c8b-4394-9740-648d26a161fa",
                        "source_entry_id": "2444530f-fd02-3a61-9777-0597a4e1e8fe",
