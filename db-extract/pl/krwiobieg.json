                                "target_senses": [
                                    {
                                        "sense_id": "713fbeb0-1e5c-38b8-8334-030bd3c2d9ef",
                                        "entry_id": "9a7e1cdb-65ea-31c6-b6ef-4717589fd814",
                                        "glosses": [
                                            "Das Strömungssystem des Blutes, das vom Herzen und einem Netz aus Blutgefäßen gebildet wird."
                                        ],
                                        "tags": [
                                            "Physiologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd8926a7-3646-4fb2-be04-8d1a5d5ba54d",
                                                "sense_id": "713fbeb0-1e5c-38b8-8334-030bd3c2d9ef",
                                                "text": "Durch Sport wird der Blutkreislauf angeregt."
                                            },
                                            {
                                                "example_id": "44823bc8-157c-4fee-b741-936e89c2e98d",
                                                "sense_id": "713fbeb0-1e5c-38b8-8334-030bd3c2d9ef",
                                                "text": "„Eine neue Blutung schwemmt die Tuberkelbazillen in den Blutkreislauf und erzeugt die todbringende Meningitis.“"
                                            },
                                            {
                                                "example_id": "ed64e457-4e21-463a-9c10-a29623afab83",
                                                "sense_id": "713fbeb0-1e5c-38b8-8334-030bd3c2d9ef",
                                                "text": "„Sein Blutkreislauf kam unter den Massagen wieder in Gang, er bewegte die Arme und schließlich auch den Kopf, dann murmelte er ein paar unverständliche Worte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
