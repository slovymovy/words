                                "target_senses": [
                                    {
                                        "sense_id": "40588829-e7bf-3965-a7f9-52f6d30d7f2d",
                                        "entry_id": "c00a60a8-8c75-3e0a-9120-87db8b9f47e8",
                                        "glosses": [
                                            "Eigenschaft von Lebewesen oder sozialen Gruppen, sich auf die Bedingungen ihrer Umwelt einstellen zu können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04553c87-dfae-468f-a171-7328357ffd10",
                                                "sense_id": "40588829-e7bf-3965-a7f9-52f6d30d7f2d",
                                                "text": "Ohne Anpassungsfähigkeit kommt man nicht durchs Leben."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7c40de83-60f7-43d8-bcd1-9d110303551a",
                        "source_entry_id": "7e7b1b9c-7a75-34e3-989d-3e43ed6d26b7",
                        "source_sense_id": "6c3014dc-1845-3797-9f07-ff7a374b1ed0",
                        "target_lang_word": "Anwendbarkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anwendbarkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e75d1264-1ee1-3594-8cce-20721096b3b8",
                                        "entry_id": "d3f4a65d-d31f-39ad-82f5-8a30bef9c948",
                                        "glosses": [
                                            "Möglichkeit, zielführend verwendet zu werden/werden zu können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c56bd18-02dc-4326-8e0b-2899fd32b156",
                                                "sense_id": "e75d1264-1ee1-3594-8cce-20721096b3b8",
                                                "text": "„Da über die Anwendbarkeit dieses Düngmittels wohl kein Zweifel mehr bestehen kann, so kommt es darauf an, zu zeigen, welche Pflanzen sich am besten hiezu eignen, welchem Boden die verschiedenen Arten am meisten zusagen, wann sie gesät und untergepflügt, und endlich wie sie behandelt werden müssen.“"
                                            },
                                            {
                                                "example_id": "fa115535-37b3-46b5-92d5-3ea0f945b5cd",
                                                "sense_id": "e75d1264-1ee1-3594-8cce-20721096b3b8",
                                                "text": "„Das Verfassungsgericht hat die vorläufige Anwendbarkeit von Ceta unter Auflage gebilligt.“"
                                            },
                                            {
                                                "example_id": "89e520a7-412e-48ab-8ab4-7520c6fb0131",
                                                "sense_id": "e75d1264-1ee1-3594-8cce-20721096b3b8",
                                                "text": "„In der Folge wurde die Anwendbarkeit dieser ausgewählten EProcurement-Tools für die elektronische Vergabe solcher Aufträge hinsichtlich rechtlicher, organisatorischer, technischer und ökonomischer Anforderungen untersucht.“"
                                            },
                                            {
                                                "example_id": "7ac53858-09df-4189-89df-15e5970a942b",
                                                "sense_id": "e75d1264-1ee1-3594-8cce-20721096b3b8",
                                                "text": "„Ich fand die Anwendbarkeit der Kontrastbetonung auf alle möglichen Lebensbereiche äußerst amüsant und erhellend.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d521e1a5-83de-44e4-befa-908338e2d61e",
                        "source_entry_id": "7e7b1b9c-7a75-34e3-989d-3e43ed6d26b7",
                        "source_sense_id": "6c3014dc-1845-3797-9f07-ff7a374b1ed0",
