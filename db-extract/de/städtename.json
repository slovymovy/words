                "senses": [
                    {
                        "sense_id": "74db1c8b-4d67-3587-aea8-221a01a32f6c",
                        "entry_id": "eeaa430e-806a-36a8-be15-e5673e0b57ad",
                        "glosses": [
                            "Name/Namen für eine Stadt/Städte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3d6bd97-50a1-40bc-a848-038169300c53",
                                "sense_id": "74db1c8b-4d67-3587-aea8-221a01a32f6c",
                                "text": "„Ich musste irgendwie schlucken und vermied während der nächsten Monate penibel, die deutschen Städtenamen zu benutzen, nicht einmal im Gespräch mit deutschen Landsleuten.“"
                            },
                            {
                                "example_id": "a2e5d262-c489-4155-bc31-389b16e516e7",
                                "sense_id": "74db1c8b-4d67-3587-aea8-221a01a32f6c",
                                "text": "„Damit ist dies, laut Guinness Buch der Rekorde, der längste Städtename der Welt.“"
                            },
                            {
                                "example_id": "4e24b08a-b01d-47be-85b1-39c7afa7d807",
                                "sense_id": "74db1c8b-4d67-3587-aea8-221a01a32f6c",
                                "text": "„Es ist mein Schicksal, denn in München lebte ich mal für ein paar Jahre, aber noch immer kann ich diesen Städtenamen nicht richtig aussprechen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
