                "senses": [
                    {
                        "sense_id": "fa28c842-9881-34ad-83f8-7b80b714d163",
                        "entry_id": "8dfc22b9-2641-38e8-a7df-44dfb1335364",
                        "glosses": [
                            "letzter Mast eines Segelschiffes hinter dem Großmast"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "456ddeba-ca0d-418b-8368-a1e7db61d19f",
                                "sense_id": "fa28c842-9881-34ad-83f8-7b80b714d163",
                                "text": "„Die Besanmasten waren längst verschwunden, die Großmasten in vierzig Fuß Höhe abgebrochen, die Fockmasten zwar mehr oder weniger intakt, aber ihrer Wanten beraubt.“"
                            },
                            {
                                "example_id": "dcada70c-3afe-4575-b342-0fd30f81fdea",
                                "sense_id": "fa28c842-9881-34ad-83f8-7b80b714d163",
                                "text": "„Er stemmte den Besanmast zur Seite, während ich das Rohr der Kanone mittschiffs schwenkte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
