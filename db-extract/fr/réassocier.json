                "senses": [
                    {
                        "sense_id": "38747846-dabb-343e-b7a7-e5d608b8234e",
                        "entry_id": "4146d34f-41d9-31c1-9d14-c37e654f97f5",
                        "glosses": [
                            "Associer à nouveau ou d’une nouvelle façon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86d90e75-7f2f-4bc4-b58e-a85f52311a87",
                                "sense_id": "38747846-dabb-343e-b7a7-e5d608b8234e",
                                "text": "Ils devaient donc rentrer dans la seule voie d’élévation qui leur fut connue ; manœuvrer pour se réassocier au sacerdoce, ou se mettre à sa place par un nouveau culte de leur invention."
                            },
                            {
                                "example_id": "0cc0ad46-c0c9-425c-b431-57f94a8f9ca4",
                                "sense_id": "38747846-dabb-343e-b7a7-e5d608b8234e",
                                "text": "Nous pouvons multiplier les associations et même réassocier des fragments de divers ensembles sans aucun rapport avec une réalité antérieurement perçue."
                            }
                        ]
                    }
                ],
