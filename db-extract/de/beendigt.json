                ],
                "senses": [
                    {
                        "sense_id": "f914253f-fa4c-3a2e-8d57-abc276606f3d",
                        "entry_id": "a65eb44d-f612-3bda-aeb6-7fea332a2b8b",
                        "glosses": [
                            "zu einem Abschluss gebracht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f1b67fe-3250-44e2-81cc-de3307e0317c",
                                "sense_id": "f914253f-fa4c-3a2e-8d57-abc276606f3d",
                                "text": "„Wassilew war im Juni 1982 „nach beendigter Mission“ nach Sofia zurückgerufen worden; Aiwasow flog am 12. November, während sich das Außenministerium und Regierungschef Giovanni Spadolini noch um die Verhaftungsmodalitäten zankten, „auf Urlaub“ nach Bulgarien.“"
                            },
                            {
                                "example_id": "03974e8c-ee1c-45c8-9f43-ce131a28f467",
                                "sense_id": "f914253f-fa4c-3a2e-8d57-abc276606f3d",
                                "text": "„Nach beendigter Vorstellung ging Frau von Heygendorf zu Goethe.“"
                            },
                            {
                                "example_id": "d02cc3d7-2d70-4157-8320-a8dbe8039ef7",
                                "sense_id": "f914253f-fa4c-3a2e-8d57-abc276606f3d",
                                "text": "„Das Ergebnis sind die Zeichen eines gebändigten Chaos, eines beendigten Kampfes.“"
                            },
                            {
                                "example_id": "d0af3012-c5bc-438d-b004-fb252bb69713",
                                "sense_id": "f914253f-fa4c-3a2e-8d57-abc276606f3d",
                                "text": "„Der spätere Weg der Expressionisten, nach beendigter Herrschaft der „Ausdruckskunst“, macht deutlicher sichtbar, als es die Manifeste und sogar die Kunstwerke selbst erkennen lassen, wodurch der Expressionismus in die Welt kam – und woran er zugrunde ging.“"
                            },
                            {
                                "example_id": "b99fc9d0-d1ed-4cbd-a375-ab65e48b002a",
                                "sense_id": "f914253f-fa4c-3a2e-8d57-abc276606f3d",
                                "text": "„Alle Spekulationen, der BMW-Cheflenker habe vor seiner durch einen Totalschaden beendigten Spritztour mit dem 1,5 Millionen Mark teuren McLaren-Sportwagen möglicherweise im Biergarten etwas zu tief ins Glas geschaut, sind obsolet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
