                ],
                "senses": [
                    {
                        "sense_id": "c52a496d-02a1-3f66-b360-d2a877b28c5c",
                        "entry_id": "1b7ad63b-951a-3e9a-a1b4-29c3d1377089",
                        "glosses": [
                            "den südöstlichen Teil des Atlantischen Ozeans betreffend"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "b526f3f4-dc5a-4890-880e-83d71a117131",
                                "sense_id": "c52a496d-02a1-3f66-b360-d2a877b28c5c",
                                "text": "„Die Südostatlantische Fischereiorganisation (SEAFO) soll zu ihrer formellen Gründung und ersten Sitzung im Herbst 2003 in Swakopmund / Namibia zusammenkommen.“"
                            },
                            {
                                "example_id": "a0216b87-9691-430e-b9ec-89103ce24273",
                                "sense_id": "c52a496d-02a1-3f66-b360-d2a877b28c5c",
                                "text": "„Wir kennen derzeit 2 geographisch isolierte Gruppen, eine nordostatlantische Gruppe zwischen Azoren, spanischer und marokkanischer Küste und eine südostatlantische Gruppe westlich von Mozambique und westlich und südlich von Südafrika (Fig. 1).“"
                            },
                            {
                                "example_id": "adb8ca08-0420-46fd-b4b8-9ac234bf25d4",
                                "sense_id": "c52a496d-02a1-3f66-b360-d2a877b28c5c",
                                "text": "„In diesem Zusammenhang ist es erwähnenswert, daß sich die Gruppe für eine möglichst unkomplizierte Maschenregulierung in der südostatlantischen Kaphechtfischerei aussprach.“"
                            },
                            {
                                "example_id": "1970390a-f189-4f39-9e30-0c533e50e031",
                                "sense_id": "c52a496d-02a1-3f66-b360-d2a877b28c5c",
                                "text": "„Die in den südostatlantischen Ozean einschiessenden Wassermassen des Kongo bilden eine bemerkenswerte Scheide zwischen den zwei Hauptmeeresströmungen daselbst, nämlich dem kalten Benguelastrom und der 25° warmen Guineaströmung, welche einen zurückgebogenen Zweig des südlichen Astes der Aequatorströmung im todten Winkel nördlich der Kongofluten bis zur Küste von Oberguinea darstellt.“"
                            },
                            {
                                "example_id": "b06cdb6d-c3e4-41c5-9eb4-907b027d3c5e",
                                "sense_id": "c52a496d-02a1-3f66-b360-d2a877b28c5c",
                                "text": "„Auch sind vereinzelte rauhe Felslandschaften bekannt, so die Miniaberge südwestlich von Island und der mittlere Walfischrücken im Südostatlantischen Ozean.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
