                                "target_senses": [
                                    {
                                        "sense_id": "cc161028-2279-3cdd-9644-882efea1f581",
                                        "entry_id": "281aeb3f-3521-3c12-86b8-694fb712b111",
                                        "glosses": [
                                            "Oscillation électromagnétique émise par le cerveau des êtres vivants, traduisant le rythme cérébral."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19e40814-0a64-42b2-8a15-989d75fe5e13",
                                                "sense_id": "cc161028-2279-3cdd-9644-882efea1f581",
                                                "text": "Lorsque l’on écoute de la musique répétitive et sans paroles – comme la techno, la house ou encore la EDM (electronic dance music) – nos ondes cérébrales se synchronisent au rythme de la musique, déclenchant des effets apaisants ou excitants, en fonction du tempo, sur notre cerveau"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
