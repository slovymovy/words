                        "entry_id": "c1745386-ea3b-3275-9e66-8ac2707678bc",
                        "glosses": [
                            "Ensemble de morceaux de musique sélectionnés par une station de radio pour les diffuser."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "fef70721-15d1-408d-9e5b-9f8b79ece90b",
                                "sense_id": "ec7b50f6-e40e-3f75-bdc5-dc11d235778b",
                                "text": "L’inscription de tout nouveau titre sur la playlist d’une radio commerciale ne se fait pas au hasard."
                            },
                            {
                                "example_id": "1eb0a230-139b-467b-8305-a79537873adf",
                                "sense_id": "ec7b50f6-e40e-3f75-bdc5-dc11d235778b",
                                "text": "La playlist d’Inter — Venez découvrir les choix musicaux défendus par France Inter !"
                            }
                        ]
                    },
                    {
                        "sense_id": "0f4997f5-e214-316f-a5c0-03ad5964c253",
                        "entry_id": "c1745386-ea3b-3275-9e66-8ac2707678bc",
                        "glosses": [
                            "Liste de morceaux de musique ou de vidéos, que l’on peut écouter ou visionner dans l’ordre ou de façon aléatoire."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "b2570b11-0ccc-4880-962a-e38017d7c886",
                                "sense_id": "0f4997f5-e214-316f-a5c0-03ad5964c253",
                                "text": "Le soir, l’adresse est fréquentée par une clientèle plutôt cool attirée par une playlist régulièrement dédiée à la musique électronique."
                            },
                            {
                                "example_id": "14ce4867-3ee9-4898-8f43-72cec4585d0b",
                                "sense_id": "0f4997f5-e214-316f-a5c0-03ad5964c253",
                                "text": "Qu’à cela ne tienne, le transmetteur audio Mohard BC61 vous permettra de diffuser, notamment, depuis votre smartphone, dans l’habitacle, vos playlists préférées."
                            }
                        ]
                    }
