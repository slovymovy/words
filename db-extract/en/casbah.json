                                "target_senses": [
                                    {
                                        "sense_id": "dd717b7c-6e31-36ef-a14e-8e7e17123545",
                                        "entry_id": "ee4d78a0-63fc-3015-be2b-c8cda16187f5",
                                        "glosses": [
                                            "Variante de casbah."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "882efbad-a3e2-4662-a0bf-21f59151ed25",
                                                "sense_id": "dd717b7c-6e31-36ef-a14e-8e7e17123545",
                                                "text": "Deux ou trois villages seulement, séparés par des solitudes ; villages aux maisonnettes basses, aussi blanches de chaux que des kasbah d’Algérie et entourées de certaines espèces de fleurs qui peuvent résister au vent marin."
                                            },
                                            {
                                                "example_id": "3a7e4041-5433-42da-b2cc-51bd7620bf30",
                                                "sense_id": "dd717b7c-6e31-36ef-a14e-8e7e17123545",
                                                "text": "Vers quelle kasbah s'acheminent toutes ces Maugrabines qui louvoient la-bas ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
