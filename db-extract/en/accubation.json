                    {
                        "sense_id": "37dac1b6-5e1d-35e9-842f-293cda67710a",
                        "entry_id": "8d93ca8b-96ce-3968-a942-ceb9527576f7",
                        "glosses": [
                            "The act or posture of reclining on a couch, as practiced by the ancients at meals."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "fdc185c3-2b9b-4970-a2ae-f14245c1a89e",
                                "sense_id": "37dac1b6-5e1d-35e9-842f-293cda67710a",
                                "text": "Accubation was introduced in Rome after the first Punic War (264-241 BC). In Greece accubation was unknown at the time of the Homeric poems (cf. Od. i. 145 ἑξείης ἕζοντο κατὰ κλισμούς τε θρόνους τε, XV. 134 ἑζέσθην δ᾽ ἄρ᾽ ἔπειτα κατὰ κλισμούς τε θρόνους τε), but afterwards the Greeks and Romans adopted this Oriental fashion and lay very nearly flat on their breasts while taking their meals, or in a semi-sitting posture supported on the left elbow."
                            },
                            {
                                "example_id": "ccb40a2b-5802-4ac4-b235-9dd9dabaa896",
                                "sense_id": "37dac1b6-5e1d-35e9-842f-293cda67710a",
                                "text": "Accubation, or lying down at meals, was a gesture used by very many Nations."
                            }
                        ]
                    }
                ],
