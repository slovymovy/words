            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3511acc2-b9d2-35d5-aae0-7df5e091aa3d",
                    "sense_definition": "gevoelens van onvrede of irritatie bij iemand anders veroorzaken",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "irritatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn luide muziek <w>ergert</w> de buren elke avond.",
                            "target_lang_translations": {
                                "en": "His loud music <w>annoys</w> the neighbors every evening."
                            }
                        },
                        {
                            "text": "Het lawaai van de bouwwerkzaamheden <w>ergerde</w> hem mateloos.",
                            "target_lang_translations": {
                                "en": "The noise from the construction work <w>irritated</w> him immensely."
                            }
                        }
                    ],
                    "synonyms": [
                        "irriteren",
                        "prikkelen",
                        "storen",
                        "dwarszitten"
                    ],
                    "antonyms": [
                        "plezieren",
                        "verblijden"
                    ],
                    "common_phrases": [
                        "iemand mateloos ergeren"
                    ],
                    "target_lang_definitions": {
                        "en": "To cause feelings of dissatisfaction or irritation in someone else."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "annoy",
                                "target_lang_sense_clarification": "to irritate or bother someone"
                            },
                            {
                                "target_lang_word": "irritate",
                                "target_lang_sense_clarification": "to cause someone to feel impatient or angry"
                            },
                            {
                                "target_lang_word": "bother",
                                "target_lang_sense_clarification": "to cause mild irritation or concern"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5f21301a-8b75-3e06-9d06-c6b4981fc4af",
                    "sense_definition": "zich ~ aan: gevoelens van onvrede of irritatie ervaren door iets of iemand",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "irritatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>erger</w> me aan mensen die altijd te laat komen.",
                            "target_lang_translations": {
                                "en": "I <w>am annoyed</w> by people who always arrive late."
                            }
                        },
                        {
                            "text": "Zij begon zich steeds meer aan kleine dingen te <w>ergeren</w> op haar werk.",
                            "target_lang_translations": {
                                "en": "She started <w>to get</w> more and more <w>irritated</w> by small things at work."
                            }
                        }
                    ],
                    "synonyms": [
                        "zich irriteren",
                        "zich storen"
                    ],
                    "common_phrases": [
                        "zich dood ergeren",
                        "zich groen en geel ergeren"
                    ],
                    "target_lang_definitions": {
                        "en": "To experience feelings of dissatisfaction or irritation caused by something or someone."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "be annoyed",
                                "target_lang_sense_clarification": "to feel irritated by something"
                            },
                            {
                                "target_lang_word": "be irritated",
                                "target_lang_sense_clarification": "to feel impatient or angry about something"
                            },
                            {
                                "target_lang_word": "be vexed",
                                "target_lang_sense_clarification": "to feel frustrated or worried"
                            }
                        ]
                    }
                }
            ]
        }
    ]
