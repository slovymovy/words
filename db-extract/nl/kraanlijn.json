                                        "sense_id": "813709ba-c22c-3097-9728-51615f779a51",
                                        "entry_id": "03446751-90f3-35f1-a7e5-217f1f476000",
                                        "glosses": [
                                            "Cordage qui soutient une vergue par ses deux extrémités ou par une seule et qui sert à la tenir suspendue horizontalement ou à l’incliner d’un côté ou de l’autre."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9037bc31-dda6-44b5-a5d4-271ebb65cf56",
                                                "sense_id": "813709ba-c22c-3097-9728-51615f779a51",
                                                "text": "Toute voile carrée a deux balancines."
                                            },
                                            {
                                                "example_id": "9bf8b101-f358-49fd-a2f2-a766057d365d",
                                                "sense_id": "813709ba-c22c-3097-9728-51615f779a51",
                                                "text": "chacun put apercevoir Robert suspendu aux balancines du petit perroquet à cent pieds en l’air."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d802228f-4a03-34f3-9e5f-e2e69ac169b7",
                                        "entry_id": "03446751-90f3-35f1-a7e5-217f1f476000",
                                        "glosses": [
                                            "Cordage permettant de régler la hauteur d'un espar sur un voilier, corde qui soutient le gui."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0cd19e2-da69-400d-befc-7c68deadd543",
                                                "sense_id": "d802228f-4a03-34f3-9e5f-e2e69ac169b7",
                                                "text": "Les deux balancines qui soutiennent le gui cédèrent ainsi que six des cercles qui maintiennent la grand'voile le long du mât."
                                            },
                                            {
                                                "example_id": "b88a4d23-3661-4c06-bb18-f5441c15c264",
                                                "sense_id": "d802228f-4a03-34f3-9e5f-e2e69ac169b7",
                                                "text": "Balancines rompues, le gui courut sur tribord, fauchant l'air avec un bruit aigre."
                                            },
                                            {
                                                "example_id": "a8dd4776-beed-4a01-8db8-848506290a6f",
                                                "sense_id": "d802228f-4a03-34f3-9e5f-e2e69ac169b7",
                                                "text": "Avant de prendre un ris, on pèse sur la balancine de grand-voile."
                                            },
                                            {
                                                "example_id": "25b61096-7e2f-4709-ba97-9e872c8c64ed",
                                                "sense_id": "d802228f-4a03-34f3-9e5f-e2e69ac169b7",
                                                "text": "Nœud de balancine, point de réunion des cordes intérieures de la suspension d’une nacelle de ballon, surtout de ballon captif."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a31fbd5c-6ae8-3532-8c85-0c05ca2a4834",
                                        "entry_id": "03446751-90f3-35f1-a7e5-217f1f476000",
                                        "glosses": [
                                            "Seconde sangle sur la selle d'amazone qui relie l’avant du côté gauche et l’arrière du côté droit pour éviter que la selle ne tourne."
