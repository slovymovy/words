                        "reculer une échéance"
                    ]
                },
                {
                    "sense_id": "f56392c6-35e2-3add-911b-1dae24bf5f59",
                    "sense_definition": "Déplacer des bornes ou des limites pour étendre un espace ou un domaine.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "limite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les découvertes de la médecine moderne permettent sans cesse de <w>reculer</w> les limites de la longévité."
                        },
                        {
                            "text": "Le traité de paix a officiellement permis de <w>reculer</w> la frontière entre les deux pays."
