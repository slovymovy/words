                        "examples": [
                            {
                                "example_id": "3f09a501-5546-44e2-bd11-416fe86b121c",
                                "sense_id": "eadbdefe-89a5-3d04-89cb-e85ae6f2674d",
                                "text": "De aanvragers van de subsidie moeten een uitgebreide uitleg geven waarvoor ze de subsidie nodig hebben."
                            },
                            {
                                "example_id": "9f9d4ec0-3e68-44f7-9fc4-e88a4be6eba1",
                                "sense_id": "eadbdefe-89a5-3d04-89cb-e85ae6f2674d",
                                "text": "De aanvrager van een uitkering moet een aantal officiële documenten meebrengen."
                            },
                            {
                                "example_id": "ef847f3f-5218-48ff-8ba3-9537347939fa",
                                "sense_id": "eadbdefe-89a5-3d04-89cb-e85ae6f2674d",
                                "text": "Daardoor komt een aanvrager niet in aanmerking, tenzij de gepleegde misdaad betrekkelijk onbeduidend is en verband houdt met het probleem rond de seksuele identiteit."
                            }
                        ]
