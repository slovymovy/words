                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dichotom",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aec44d95-71ab-386e-9237-dd359396b1c8",
                                        "entry_id": "b461d2f0-74c9-3d9f-9956-97da74afcce7",
                                        "glosses": [
