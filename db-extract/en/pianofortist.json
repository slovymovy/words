                        "sense_id": "2d25d2a0-94cf-36fe-bac8-f90d597c0840",
                        "entry_id": "0234e859-059a-3921-bc7e-61710cd9fb0d",
                        "glosses": [
                            "A person who plays the pianoforte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1342a80-f341-4700-97a4-fe9f341114ac",
                                "sense_id": "2d25d2a0-94cf-36fe-bac8-f90d597c0840",
                                "text": "Mr. E[dward]. Knight completed his musical education in Germany, under the celebrated Ferdinand Ries, and was esteemed an excellent pianofortist and composer."
                            },
                            {
                                "example_id": "d8a5df82-3b38-48a0-8911-34d3b7b832a7",
                                "sense_id": "2d25d2a0-94cf-36fe-bac8-f90d597c0840",
                                "text": "“My love,” he answered, stopping and holding her still before him, “have you not yet perceived how your great-grandmother’s marriage will affect us? When the Countess of Halston marries her butler, no one will even think twice about her great-grand-daughter wedding a pianofortist.”"
                            },
                            {
                                "example_id": "cfa80d4b-7c73-43de-9908-030f17bce970",
                                "sense_id": "2d25d2a0-94cf-36fe-bac8-f90d597c0840",
                                "text": "Miss Keele performed first and played exceptionally well, which was not surprising. She was by far a superior pianofortist."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3cada8b3-e7ad-4e2c-9a88-ad30b5d3584f",
                        "source_entry_id": "0234e859-059a-3921-bc7e-61710cd9fb0d",
                        "source_sense_id": "2d25d2a0-94cf-36fe-bac8-f90d597c0840",
                        "source_sense_description": "pianofortist",
                        "target_lang_word": "pianofortiste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pianofortiste",
