                "senses": [
                    {
                        "sense_id": "bf13d0c2-2b70-3431-aaa5-bdf124240926",
                        "entry_id": "feee2643-1cfd-3bbd-85ee-59c88e314a79",
                        "glosses": [
                            "Passieren eines langsameren oder anhaltenden Verkehrsmittels (des Überholten) durch ein schnelleres"
                        ],
                        "tags": [
                            "Straßenverkehr"
                        ],
                        "examples": [
                            {
                                "example_id": "eacb8c4a-8277-42fd-9274-cfba256dfd52",
                                "sense_id": "bf13d0c2-2b70-3431-aaa5-bdf124240926",
                                "text": "„Vermutlich bei einem Überholmanöver ist einer in den Graben gerast, hinter der Rheinbrücke, kurz vor der Abfahrt nach Nauheim.“"
                            },
                            {
                                "example_id": "5cbb42eb-ab12-4072-9849-9760250e204d",
                                "sense_id": "bf13d0c2-2b70-3431-aaa5-bdf124240926",
                                "text": "„Neun Runden vor Schluss gelang Buemi dann auch noch ein tolles Überholmanöver gegen Michael Schumacher.“"
                            },
                            {
                                "example_id": "2929df33-c74b-49b5-a11a-3d9407833633",
                                "sense_id": "bf13d0c2-2b70-3431-aaa5-bdf124240926",
                                "text": "„Es folgten Taxis mit waghalsigen Überholmanövern.“"
                            },
                            {
                                "example_id": "642ebca7-a285-4c6b-bb25-6013d59833c7",
                                "sense_id": "bf13d0c2-2b70-3431-aaa5-bdf124240926",
                                "text": "„Das Überholmanöver bescherte ihnen ein unerwartetes Quartier.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
