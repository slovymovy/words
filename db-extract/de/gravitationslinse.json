                "senses": [
                    {
                        "sense_id": "f2e7abf3-b06c-34bd-96a7-30c13585cceb",
                        "entry_id": "e694cbd6-ed7e-3070-a3be-75f7401bca69",
                        "glosses": [
                            "Objekt mit großer Masse, welches das Licht eines dahinterliegenden Objektes ablenkt und dadurch ähnlich wie eine optische Linse wirkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ee6e0cc-9ff4-4b8d-a7f1-65c83c3c25a8",
                                "sense_id": "f2e7abf3-b06c-34bd-96a7-30c13585cceb",
                                "text": "„Bei einer Gravitationslinse sieht der Beobachter das entfernte Objekt mehrfach, weil die Lichtstrahlen auf unterschiedlichen Wegen zu ihm gelangen können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ffb7c615-33f6-4266-a120-bd913e13c2db",
                        "source_entry_id": "e694cbd6-ed7e-3070-a3be-75f7401bca69",
                        "source_sense_id": "f2e7abf3-b06c-34bd-96a7-30c13585cceb",
                        "source_sense_description": "Astronomie: Objekt, das durch große Masse das Licht eines dahinterliegenden Objektes ablenkt und dadurch ähnlich wie eine optische Linse wirkt",
                        "target_lang_word": "gravitational lens",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gravitational lens",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b9d7500c-9f04-3187-b574-f3d7d9dc461a",
                                        "entry_id": "27f78d85-607a-3d5f-bb65-cd90937d9092",
                                        "glosses": [
                                            "A distribution of matter whose gravitational field bends the path of light rays sufficiently to distort, magnify or multiply images of more distant objects."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "126bba8a-bef7-4861-9622-348668dfdbdd",
                                                "sense_id": "b9d7500c-9f04-3187-b574-f3d7d9dc461a",
                                                "text": "Thus the galactic gravitational lens effect is not important in maintaining the radio reference coordinate system with mas accuracy, if quasars as fiduciary points are pertinently selected."
                                            },
                                            {
                                                "example_id": "dac5ecc5-7c4b-4a67-9fea-8c7169823a8b",
                                                "sense_id": "b9d7500c-9f04-3187-b574-f3d7d9dc461a",
                                                "text": "The two other examples of gravitational lenses discussed above have not been modeled as elaborately."
                                            },
                                            {
                                                "example_id": "fcf48191-37e1-41a4-8fcc-ab631f35f149",
                                                "sense_id": "b9d7500c-9f04-3187-b574-f3d7d9dc461a",
                                                "text": "Subsequent discoveries of several more examples of gravitational lenses eliminated all doubts about gravitational focussing predicted by general relativity."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9161597e-8624-4357-b4a5-72d07889c0f7",
                        "source_entry_id": "e694cbd6-ed7e-3070-a3be-75f7401bca69",
                        "source_sense_id": "f2e7abf3-b06c-34bd-96a7-30c13585cceb",
                        "source_sense_description": "Astronomie: Objekt, das durch große Masse das Licht eines dahinterliegenden Objektes ablenkt und dadurch ähnlich wie eine optische Linse wirkt",
                        "target_lang_word": "lentille gravitationnelle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lentille gravitationnelle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "75b52953-04a4-355b-8934-a4e60b473b0d",
                                        "entry_id": "d9f51925-870b-3eb9-b4ae-9a86825d741c",
                                        "glosses": [
                                            "Corps céleste dont la masse, conformément à la théorie de la relativité générale, entraîne une modification observable du trajet dans l’espace du rayonnement électromagnétique d’un astre, dont l’image se trouve ainsi déviée, déformée ou démultipliée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd177911-d2ca-4cce-86ef-68c267c67121",
                                                "sense_id": "75b52953-04a4-355b-8934-a4e60b473b0d",
                                                "text": "La masse se comporte comme une lentille gravitationnelle et dévie la lumière du quasar, à la manière d’une lentille optique déformant l’image de l’objet observé."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
