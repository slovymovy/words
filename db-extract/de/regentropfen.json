                        "form": "den Regentropfen"
                    },
                    {
                        "form_id": "f2c5bd57-f4b4-4b32-8e5b-687767fa9240",
                        "entry_id": "705331f7-63c8-391f-80c9-9bed3983811e",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Regentropfen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d2c4ca09-d778-3ac9-8ad6-96e32f550e0e",
                        "entry_id": "705331f7-63c8-391f-80c9-9bed3983811e",
                        "glosses": [
                            "ein einzelner Tropfen bestehend aus Regenwasser"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ab59c28-f483-4003-9453-cdf66457eeaf",
                                "sense_id": "d2c4ca09-d778-3ac9-8ad6-96e32f550e0e",
                                "text": "Die Regentropfen perlten von der Scheibe ab."
                            },
                            {
                                "example_id": "f85a5977-7d36-4986-9e4d-c88669b9ddd8",
                                "sense_id": "d2c4ca09-d778-3ac9-8ad6-96e32f550e0e",
                                "text": "„Ein paar Regentropfen fielen ins Gras.“"
                            },
                            {
                                "example_id": "69f1e6a4-e542-4d78-9a9c-22eac5bec3f0",
                                "sense_id": "d2c4ca09-d778-3ac9-8ad6-96e32f550e0e",
                                "text": "„Alle blicken fasziniert nach draußen und fotografieren durch die Scheiben, an denen getrocknete Regentropfen kleben.“"
                            },
                            {
                                "example_id": "1fcc3797-71ae-464d-9ec0-11a34fd22c32",
                                "sense_id": "d2c4ca09-d778-3ac9-8ad6-96e32f550e0e",
                                "text": "„Kurz darauf fallen große Regentropfen, dabei scheint die Sonne.“"
                            },
                            {
                                "example_id": "8d44199f-2832-48d5-8444-68abe992987e",
                                "sense_id": "d2c4ca09-d778-3ac9-8ad6-96e32f550e0e",
                                "text": "„Erste Regentropfen fallen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7da698a6-eb50-4639-ad1a-c708f2226751",
                        "source_entry_id": "705331f7-63c8-391f-80c9-9bed3983811e",
                        "source_sense_id": "d2c4ca09-d778-3ac9-8ad6-96e32f550e0e",
                        "source_sense_description": "ein einzelner Tropfen bestehend aus Regenwasser",
                        "target_lang_word": "raindrop",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "raindrop",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "07b5287a-be7c-34c7-b7c4-c1098e8c038b",
                                        "entry_id": "ed1a1c1a-bda6-3f23-919b-e40dd4fba0e9",
                                        "glosses": [
                                            "A single droplet of rainwater that has just fallen or is falling from the sky."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b610101-3ecd-4057-b4d6-4ac56c23ac3c",
                                                "sense_id": "07b5287a-be7c-34c7-b7c4-c1098e8c038b",
                                                "text": "It is all so fine and orderly that it would seem that not only had the clouds and streams been kept harmoniously busy in the making of it, but that every raindrop sent like a bullet to a mark had been the subject of a separate thought, so sure is the outcome of beauty through the stormy centuries."
                                            },
                                            {
                                                "example_id": "ff520c5c-b7ec-4e28-a2ea-181f0bd82eca",
                                                "sense_id": "07b5287a-be7c-34c7-b7c4-c1098e8c038b",
                                                "text": "1969, Hal David (lyricist), “Raindrops Keep Fallin' on My Head”."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
