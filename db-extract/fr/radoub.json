                "entry_id": "77014d7b-9169-3c18-b45f-0f15a4dcd06c",
                "word": "radoub",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "51b2d7e2-c917-48fd-8c1a-f9fecb181e12",
                        "entry_id": "77014d7b-9169-3c18-b45f-0f15a4dcd06c",
                        "tags": [
                            "plural"
