                    },
                    {
                        "form_id": "beaa0ecd-5cef-486b-a711-d9883cc652d2",
                        "entry_id": "1fcc1e63-7184-3a76-aa24-674dac891776",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "radio-actives"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "779c12df-9eb0-3f72-84e2-4fca53848d68",
                        "entry_id": "1fcc1e63-7184-3a76-aa24-674dac891776",
                        "glosses": [
                            "Qui est doué de radioactivité."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "a36f4af4-124a-4dfd-bee5-3a6b6d58eb61",
                                "sense_id": "779c12df-9eb0-3f72-84e2-4fca53848d68",
                                "text": "Nous dirons que l'uranium, le thorium et leurs composés émettent des rayons de Becquerel. J'ai appelé radio-actives les substances qui donnent lieu à une émission de ce genre. Ce nom a été depuis généralement adopté."
                            },
                            {
                                "example_id": "a89d62c0-96d6-412e-ae51-90868e0ec117",
                                "sense_id": "779c12df-9eb0-3f72-84e2-4fca53848d68",
                                "text": "L’utilisation des isotopes radio-actifs a fait considérablement progresser les connaissances sur la propagation des maladies par des insectes, et sur l’écologie et l’élimination naturelle des insectes vecteurs."
                            },
                            {
                                "example_id": "1f65183c-4461-4212-ac44-c2bf6e9435c7",
                                "sense_id": "779c12df-9eb0-3f72-84e2-4fca53848d68",
                                "text": "Le circuit primaire doit être muni d’une pompe sans fuite (eau radio-active) et d’un ensemble de filtration de l’eau."
                            },
                            {
                                "example_id": "febb1aff-5bf4-48dc-b778-5d36ed5559cc",
                                "sense_id": "779c12df-9eb0-3f72-84e2-4fca53848d68",
                                "text": "Non sans raison, on estime que les eaux des océans sont continuellement brassées par des courants qui, même des fosses les plus profondes, peuvent ramener à la surface des matières radio-actives."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d21e2b20-69c0-4446-8afa-bcc0c0e165ca",
                        "source_entry_id": "1fcc1e63-7184-3a76-aa24-674dac891776",
                        "source_sense_id": "779c12df-9eb0-3f72-84e2-4fca53848d68",
                        "target_lang_word": "radioaktiv",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "radioaktiv",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4b16f8e3-568f-330e-9ac0-5eae28db0d0f",
                                        "entry_id": "7e18c3c7-9d2e-37c1-a35b-8e247dd3dc18",
                                        "glosses": [
                                            "Radioaktivität aufweisend"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ce29522-eab0-466c-b312-838de2fd307b",
                                                "sense_id": "4b16f8e3-568f-330e-9ac0-5eae28db0d0f",
                                                "text": "Radium ist stark radioaktiv."
                                            },
                                            {
                                                "example_id": "8a168986-2fb5-4d28-9358-06c63eb54351",
                                                "sense_id": "4b16f8e3-568f-330e-9ac0-5eae28db0d0f",
                                                "text": "„Die sichtbare Verwüstung schließe die Opfer der radioaktiven Verstrahlung nicht ein.“"
                                            },
                                            {
                                                "example_id": "72bd18bc-0435-4367-aeb6-43663bad7b79",
                                                "sense_id": "4b16f8e3-568f-330e-9ac0-5eae28db0d0f",
                                                "text": "„Ihr Mann war Lehrer wie sie selbst und unterrichtete außer Mathematik noch Wehrschutz, deshalb kannte er sich ein wenig mit radioaktiven Strahlen aus und besorgte ihnen Jodtabletten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fbeeae37-898a-4097-a6b6-68ce78346137",
                        "source_entry_id": "1fcc1e63-7184-3a76-aa24-674dac891776",
                        "source_sense_id": "779c12df-9eb0-3f72-84e2-4fca53848d68",
                        "target_lang_word": "radioactive",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "radioactive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "04ada76a-38ac-3291-b96d-95bef75df626",
                                        "entry_id": "6b8c66a9-e9f6-36db-8505-e04a138a8d23",
                                        "glosses": [
                                            "Any radioactive substance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ed28580-847f-4a7a-a616-cfee9662c927",
                                                "sense_id": "04ada76a-38ac-3291-b96d-95bef75df626",
                                                "text": "Any ship nearby will receive a lethal dose of gamma rays, neutrons, and other radioactives."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "radioactive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "424f51a3-6b0f-38bc-88bc-12fddb1b524b",
                                        "entry_id": "ec32237c-742f-3daa-95a2-1f0bfd4daf37",
                                        "glosses": [
                                            "Exhibiting radioactivity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "880635ce-0c34-44b5-ac6a-bc984a6df247",
                                                "sense_id": "424f51a3-6b0f-38bc-88bc-12fddb1b524b",
                                                "text": "As a matter of fact many of our best drinking waters have all sorts of unspecified qualities. Burton water, for example, is radioactive by Beetham's standards up to the ninth degree."
                                            },
                                            {
                                                "example_id": "e85ec921-77ea-4a09-b0b8-1ad4f26a86f8",
                                                "sense_id": "424f51a3-6b0f-38bc-88bc-12fddb1b524b",
                                                "text": "Today, no one would intentionally smear radioactive materials on their face, but in 1933, the dangers of radioactivity were not yet fully understood."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a96fa3dc-8912-36b5-9b41-125a499b274c",
                                        "entry_id": "ec32237c-742f-3daa-95a2-1f0bfd4daf37",
                                        "glosses": [
                                            "Dangerous and disgusting, particularly of people or ideas."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b10b67f2-0971-4e60-a221-9c15165a07e0",
                                                "sense_id": "a96fa3dc-8912-36b5-9b41-125a499b274c",
                                                "text": "Even sleazy tactics and his radioactive mouth may not be able to contain this debacle."
                                            },
                                            {
                                                "example_id": "f7f42491-ff87-4cb0-ba29-4bc653574e24",
                                                "sense_id": "a96fa3dc-8912-36b5-9b41-125a499b274c",
                                                "text": "It was as though he was possessed of an invisible aura repelling incoming bodies. ‘Look. No one wants to be associated with him now. He’s become radioactive.’"
                                            },
                                            {
                                                "example_id": "4d833111-140d-459c-94c9-64835a0d4bfd",
                                                "sense_id": "a96fa3dc-8912-36b5-9b41-125a499b274c",
                                                "text": "And while Biden’s other nominees have done little to provoke Republican backlash thus far, [Neera] Tanden is “radioactive,” as Sen. John Cornyn (R-Texas) put it."
                                            },
                                            {
                                                "example_id": "bd257eb3-dc53-43c6-a1e6-bf9f9d803727",
                                                "sense_id": "a96fa3dc-8912-36b5-9b41-125a499b274c",
                                                "text": "If, by some miracle, Democrats hang on to one or both houses of Congress this November, it will be because of Cawthorn, Paul Gosar, Marjorie Taylor Greene, Lauren Boebert and other would-be G.O.P. candidates trying to be just like them — the Radioactive Republicans."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
