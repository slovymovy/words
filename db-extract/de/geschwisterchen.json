                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5acf4eea-10fe-45eb-a20e-2af0d3d04404",
                                                "sense_id": "cfedf5f1-561b-3d22-abd2-3fbadfd46218",
                                                "text": "Hey little sister, what have you done? / Hey little sister, who’s the only one? / Hey little sister, who’s your superman? / Hey little sister, who’s the one you want? / Hey little sister, shotgun!"
                                            }
                                        ]
