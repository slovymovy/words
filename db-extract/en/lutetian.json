                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "f429a28d-8d03-4d3e-a40c-39c3fcd99178",
                        "entry_id": "bcd208c5-e35d-3beb-b910-4c25f234e907",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more Lutetian"
                    },
                    {
                        "form_id": "13670334-2bd9-4546-bc96-fc543b212281",
                        "entry_id": "bcd208c5-e35d-3beb-b910-4c25f234e907",
                        "tags": [
                            "superlative"
                        ],
