    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "34eca235-03e8-3867-a181-8ef9d0a45356",
                    "sense_definition": "Plural form of <w>element</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The story combines <w>elements</w> of comedy and tragedy to create a unique atmosphere.",
                            "target_lang_translations": {
                                "zh": "这个故事结合了喜剧和悲剧的<w>元素</w>，营造出一种独特的氛围。"
                            }
                        },
                        {
                            "text": "Hydrogen and oxygen are the two chemical <w>elements</w> that make up water.",
                            "target_lang_translations": {
                                "zh": "氢和氧是构成水的两种化学<w>元素</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "构成事物的基本成分或化学元素。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "元素",
                                "target_lang_sense_clarification": "指构成事物的基本成分或化学元素"
                            },
                            {
                                "target_lang_word": "成分",
                                "target_lang_sense_clarification": "指构成整体的各个部分"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7cacf6ba-7d60-3481-ae5b-4dbaac7701c5",
                    "sense_definition": "The weather, especially when it is severe, such as strong wind or rain.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to brave the <w>elements</w> and go for a hike despite the storm.",
                            "target_lang_translations": {
                                "zh": "尽管有暴风雨，我们还是决定冒着<w>风雨</w>去徒步旅行。"
                            }
                        },
                        {
                            "text": "The homeless man was exposed to the <w>elements</w> during the freezing night.",
                            "target_lang_translations": {
                                "zh": "那个无家可归的人在寒冷的夜晚里暴露在<w>风雨</w>之中。"
                            }
                        }
                    ],
                    "synonyms": [
                        "weather"
                    ],
                    "common_phrases": [
                        "brave the elements",
                        "exposed to the elements",
                        "battle the elements"
                    ],
                    "target_lang_definitions": {
                        "zh": "指恶劣的天气，如狂风暴雨。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "风雨",
                                "target_lang_sense_clarification": "指代恶劣的天气环境"
                            },
                            {
                                "target_lang_word": "自然环境",
                                "target_lang_sense_clarification": "指暴露在外的自然气候条件"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bafb61e1-ad99-30ad-b084-9c85caf148bd",
                    "sense_definition": "The basic principles or fundamental parts of a subject or area of knowledge.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professor explained the <w>elements</w> of game theory to the new students.",
                            "target_lang_translations": {
                                "zh": "教授向新生讲解了博弈论的<w>基础</w>。"
                            }
                        },
                        {
                            "text": "She mastered the <w>elements</w> of graphic design before starting her own agency.",
                            "target_lang_translations": {
                                "zh": "她在创办自己的公司之前，已经掌握了平面设计的<w>基本原理</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "basics",
                        "fundamentals",
                        "essentials",
                        "rudiments",
                        "principles"
                    ],
                    "common_phrases": [
                        "elements of style",
                        "elements of law"
                    ],
                    "target_lang_definitions": {
                        "zh": "学科或知识领域的基本原理或基础知识。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "基础",
                                "target_lang_sense_clarification": "指学科的入门知识或基本原理"
                            },
                            {
                                "target_lang_word": "基本原理",
                                "target_lang_sense_clarification": "指构成理论体系的核心要素"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "51230435-4c26-365e-bf40-c8b4e2bbb053",
                    "sense_definition": "The bread and wine used in the Christian sacrament of the Eucharist.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The priest consecrated the <w>elements</w> on the altar before serving the congregation.",
                            "target_lang_translations": {
                                "zh": "牧师在为会众分发之前，先祝圣了祭坛上的<w>圣餐饼酒</w>。"
                            }
