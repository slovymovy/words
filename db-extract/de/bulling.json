                "senses": [
                    {
                        "sense_id": "102f802d-55ad-319c-9df9-80c56007aa58",
                        "entry_id": "e6ca8a8c-b766-3586-bf6e-7df8dc2395b4",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8053c3bc-0b0e-4d32-853b-207226123447",
                                "sense_id": "102f802d-55ad-319c-9df9-80c56007aa58",
                                "text": "Frau Bulling ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "354393ae-7177-4638-908a-3a6dc07f3a06",
                                "sense_id": "102f802d-55ad-319c-9df9-80c56007aa58",
                                "text": "Herr Bulling wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "812a5828-473d-46e2-a5d2-2563f3094ee4",
                                "sense_id": "102f802d-55ad-319c-9df9-80c56007aa58",
                                "text": "Die Bullings fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "5fa25dab-6063-4cce-98fc-4cb9dbfbca43",
                                "sense_id": "102f802d-55ad-319c-9df9-80c56007aa58",
                                "text": "Der Bulling trägt nie die Schals, die die Bulling ihm strickt."
                            },
                            {
                                "example_id": "db3408c9-dae2-463c-9be2-8f912dfe5ffe",
                                "sense_id": "102f802d-55ad-319c-9df9-80c56007aa58",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Bulling kommt, geht der Herr Bulling.“"
                            },
                            {
                                "example_id": "b4144cba-00c4-46e9-bae4-00af7d18d699",
                                "sense_id": "102f802d-55ad-319c-9df9-80c56007aa58",
                                "text": "Bulling kommt und geht."
                            },
                            {
                                "example_id": "1c2d5d36-171a-4324-8ddb-3c15fb774fc6",
                                "sense_id": "102f802d-55ad-319c-9df9-80c56007aa58",
                                "text": "Bullings kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
