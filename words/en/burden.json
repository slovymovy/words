                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "quantity_capacity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The harbor was filled with vessels of various sizes and <w>burden</w>.",
                            "target_lang_translations": {
                                "ru": "Гавань была заполнена судами разного размера и <w>грузоподъёмности</w>.",
                                "zh": "港口里停满了大小和<w>吨位</w>各异的船只。"
                            }
                        },
