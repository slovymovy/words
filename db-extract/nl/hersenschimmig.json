                                    {
                                        "sense_id": "53ba1707-2ce9-33fa-b892-fe982863f718",
                                        "entry_id": "9f4b5480-ed34-3030-ba08-76cc6c581d57",
                                        "glosses": [
                                            "Of or pertaining to a chimera."
                                        ],
                                        "tags": [],
