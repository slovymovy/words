                        "glosses": [
                            "Qui ne peut pas être consulté."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5202aa33-63e1-46b3-80d7-81ac0c1f1cf3",
                                "sense_id": "0c7ee04e-88bc-34bf-9017-fc02c14d8e11",
                                "text": "Une table de fer, des téléphones, de la paperasserie inconsultable."
                            },
                            {
                                "example_id": "67ad01c4-1837-48ee-a0ce-e02d6a6f1da2",
                                "sense_id": "0c7ee04e-88bc-34bf-9017-fc02c14d8e11",
                                "text": "En l’occurrence, il s’agit ici de deface, « défacement », consistant à modifier la page d’accueil d’un site pour le rendre inconsultable, en faisant plus ou moins de dégâts derrière cette vitrine."
                            },
                            {
                                "example_id": "dcad2e3e-0748-44f9-9203-1f0d936a87aa",
                                "sense_id": "0c7ee04e-88bc-34bf-9017-fc02c14d8e11",
                                "text": "[…] ; autrement dit que, faute de mesures adéquates, il ne se crée, comme en Suède, une catégorie de documents pourtant officiels et publics, mais pratiquement inconsultables, car non repérables, indissociables d'informations secrètes ou incompréhensibles."
                            }
                        ]
                    }
