                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "48e77582-a2ae-37e9-afd3-93ff806e2271",
                        "entry_id": "fc3dd49b-cd9f-3c41-9db5-b45606368069",
                        "glosses": [
