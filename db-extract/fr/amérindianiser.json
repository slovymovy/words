                "senses": [
                    {
                        "sense_id": "af767c14-0424-3521-b5cc-0ac9a8cd16bd",
                        "entry_id": "f726272f-e4ce-30cf-a3e8-10360ece9a73",
                        "glosses": [
                            "Donner un caractère amérindien à."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "7bb37aed-f8b3-4690-89d9-704a8956f4b4",
                                "sense_id": "af767c14-0424-3521-b5cc-0ac9a8cd16bd",
                                "text": "Selon certaines sources, le nom Kateri, qui lui est souvent attribué, tient son origine d'une tentative, au XIXe siècle, d'«amérindianiser» son nom."
                            },
                            {
                                "example_id": "20d8fbbf-32da-44b8-b7c3-f2879416b733",
                                "sense_id": "af767c14-0424-3521-b5cc-0ac9a8cd16bd",
                                "text": "Amérindianiser la ville."
                            },
                            {
                                "example_id": "34ce008d-c71c-4f89-866d-7e7e341afa09",
                                "sense_id": "af767c14-0424-3521-b5cc-0ac9a8cd16bd",
                                "text": "Ces Français qui vont tenter l'aventure américaine... vont s'amérindianiser et imprégner toute l'Amérique de leur présence."
                            }
                        ]
                    }
