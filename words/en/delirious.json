{
    "word_family": [
        "delirium"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e87a83de-850f-3252-a92f-fcc924e76382",
                    "sense_definition": "Experiencing a disturbed state of mind characterized by restlessness, illusions, and incoherence, often resulting from fever or illness.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "mental_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient became <w>delirious</w> as his fever climbed to dangerous levels during the night.",
                            "target_lang_translations": {
                                "zh": "病人夜间高烧达到危险水平时，开始变得<w>神志不清</w>。"
                            }
                        },
                        {
                            "text": "She was so <w>delirious</w> from the infection that she did not recognize her own family members.",
                            "target_lang_translations": {
                                "zh": "她因感染而<w>神志不清</w>，甚至认不出自己的家人。"
                            }
                        }
                    ],
                    "synonyms": [
                        "feverish",
                        "hallucinating",
                        "incoherent"
                    ],
                    "antonyms": [
                        "lucid",
                        "rational"
                    ],
                    "target_lang_definitions": {
                        "zh": "指因发烧或疾病导致神志不清、胡言乱语或产生幻觉的状态。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "神志不清",
                                "target_lang_sense_clarification": "形容因病或高烧导致意识模糊、无法正常思考。"
                            },
                            {
                                "target_lang_word": "胡言乱语",
                                "target_lang_sense_clarification": "形容因神志错乱而说出没有逻辑或不切实际的话。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3cc33396-9ba2-3432-8ea5-7300993d4734",
                    "sense_definition": "Feeling or showing extreme, uncontrolled excitement or joy.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mental_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fans were <w>delirious</w> with happiness after their team won the championship in the final seconds.",
                            "target_lang_translations": {
                                "zh": "球队在最后几秒钟赢得冠军后，球迷们<w>欣喜若狂</w>。"
                            }
                        },
                        {
                            "text": "The crowd went <w>delirious</w> when the famous singer finally appeared on the stage.",
                            "target_lang_translations": {
                                "zh": "当那位著名歌手终于出现在舞台上时，人群<w>陷入了狂喜</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ecstatic",
                        "euphoric",
                        "elated"
                    ],
                    "antonyms": [
                        "depressed",
                        "miserable"
                    ],
                    "common_phrases": [
                        "delirious with joy",
                        "delirious with excitement"
                    ],
                    "target_lang_definitions": {
                        "zh": "指因极度兴奋或快乐而失去理智的状态。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "欣喜若狂",
                                "target_lang_sense_clarification": "形容高兴到了极点，甚至有些失去控制。"
                            },
                            {
                                "target_lang_word": "狂喜",
                                "target_lang_sense_clarification": "形容极度兴奋和快乐的状态。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}