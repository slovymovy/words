                    {
                        "sense_id": "8270608f-06a9-3bd4-9c60-ce48c61a8689",
                        "entry_id": "c50dbc25-df97-3c2f-a7ab-078120220818",
                        "glosses": [
                            "kleiner gebratener Aal, meist Seeaal, der ohne Kopf mariniert wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96df979b-38cf-4a67-9e2a-5435cc291ceb",
                                "sense_id": "8270608f-06a9-3bd4-9c60-ce48c61a8689",
                                "text": "Wo werden heute Aalbricken angeboten?"
                            },
                            {
                                "example_id": "d8cfc6fc-30d9-4eac-8760-567ba292bf9a",
                                "sense_id": "8270608f-06a9-3bd4-9c60-ce48c61a8689",
                                "text": "„Die bekanntesten Bratfischwaren sind … Aalbricken - aus kleinen Aalen ohne Kopf.“ Internet-Beleg"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3ca677a2-3cf2-3739-9804-7ce1cc725fb7",
                        "entry_id": "c50dbc25-df97-3c2f-a7ab-078120220818",
                        "glosses": [
                            "Gerät zum Fangen von Aalen in der Form einer Gabel mit mehreren Zacken, die mit Widerhaken versehen sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09556bcd-3dd3-4214-8490-7b11d9d9724e",
                                "sense_id": "3ca677a2-3cf2-3739-9804-7ce1cc725fb7",
                                "text": "Mittels der Aalbricke oder Aalgabel, einem Instrument in der Form einer dreizackigen Mistgabel mit einem 12 bis 15 Fuß langen Stil und mehreren Widerhaken an den Zinken, sticht man die auf dem Grunde liegenden Aale an."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
