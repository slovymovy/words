                    {
                        "sense_id": "6f0de65a-8e2b-3c53-b901-7aab75b07585",
                        "entry_id": "5c2fcfbb-ab50-32a0-89e7-1953de344e91",
                        "glosses": [
                            "extrem unsympathische Person, sehr großes Arschloch"
                        ],
                        "tags": [
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "6468049c-a15d-4a2c-8534-4b048439ac42",
                                "sense_id": "6f0de65a-8e2b-3c53-b901-7aab75b07585",
                                "text": "„›Whitman. Was für ein beschissenes Riesenarschloch.‹“"
                            },
                            {
                                "example_id": "f1174eb2-8f32-4750-b6f3-bc6142f29376",
                                "sense_id": "6f0de65a-8e2b-3c53-b901-7aab75b07585",
                                "text": "„Ja, ich will in den Himmel - wer will das nicht? -, aber nicht, wenn ich dafür ein Riesenarschloch sein muss.“"
                            },
                            {
                                "example_id": "4a11b5e2-4e45-45bf-aca4-bc12dc9ba87f",
                                "sense_id": "6f0de65a-8e2b-3c53-b901-7aab75b07585",
                                "text": "„›Aber es gibt eben immer wieder irgendein neues Riesenarschloch, dem man sich in den Weg stellen muss, und es fällt mir verdammt schwer, das dann einfach anderen zu überlassen.‹“"
                            },
                            {
                                "example_id": "dd9bee64-c202-419d-afa2-b33b920b38d5",
                                "sense_id": "6f0de65a-8e2b-3c53-b901-7aab75b07585",
                                "text": "„›Nein, ich habe nichts von diesem Riesenarschloch namens Frank gehört.‹“"
                            },
                            {
                                "example_id": "ba44c81c-5990-4654-abb1-4e5d57c77bf2",
                                "sense_id": "6f0de65a-8e2b-3c53-b901-7aab75b07585",
                                "text": "„Das sind Riesenarschlöcher mit großer Klappe, und du kannst ihnen ruhig ausrichten, dass ich das gesagt habe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
