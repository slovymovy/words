                    }
                ],
                "senses": [
                    {
                        "sense_id": "229a6ed2-231a-35f2-9ff7-df52ed0240c0",
                        "entry_id": "4f8253a7-7e83-3dbc-879d-30d24ca987c4",
                        "glosses": [
                            "Baldness."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "b83fb213-41c8-32ec-9b16-c1b542d56df0",
                        "entry_id": "4f8253a7-7e83-3dbc-879d-30d24ca987c4",
                        "glosses": [
                            "Deficiency of the hair, which may be caused by failure to grow or loss after growth."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "754f02ce-ee94-3df3-8ad3-81a309f35b8c",
                        "entry_id": "4f8253a7-7e83-3dbc-879d-30d24ca987c4",
                        "glosses": [
                            "Loss of hair (especially on the head) or loss of wool or feathers, whether natural or caused by disease."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "63c6678d-a1e2-429c-b0e0-371439f47668",
                                "sense_id": "754f02ce-ee94-3df3-8ad3-81a309f35b8c",
                                "text": "“Jada, can’t wait for GI Jane 2,” Rock said in an apparent reference to her shaved hair, which is a result of the hair loss condition alopecia."
                            },
                            {
                                "example_id": "e689156c-5ed8-474d-b49a-603ae84b4b5b",
                                "sense_id": "754f02ce-ee94-3df3-8ad3-81a309f35b8c",
                                "text": "At least 40% of women experience hair loss or alopecia over their lifetimes. This could be alopecia areata (patchy hair loss), traction alopecia (strained hair loss) or another form. The different ways that women’s hair loss has been depicted across art history demonstrates the many different ways it has been interpreted over the years.\nIn 16th and 17th century Britain, for example, women’s alopecia was sometimes interpreted as retribution for sins, including adultery."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "20233a1d-2a54-4588-87f1-ac1d3c2145b0",
                        "source_entry_id": "4f8253a7-7e83-3dbc-879d-30d24ca987c4",
                        "source_sense_description": "pathology: deficiency of the hair",
                        "target_lang_word": "alopécie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alopécie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2b1ca128-0c24-3b90-b385-45606b71e461",
                                        "entry_id": "1acdc41f-60ab-3b39-a993-98e25a4d9c62",
                                        "glosses": [
                                            "Chute des cheveux, et quelquefois des sourcils, de la barbe, etc., avec dénudation de la peau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c2b9f0d-e78c-486d-8824-4a9428abd2c0",
                                                "sense_id": "2b1ca128-0c24-3b90-b385-45606b71e461",
                                                "text": "Lʼalopécie peut s’accompagner parallèlement dʼasthénie, dʼanémie."
                                            },
                                            {
                                                "example_id": "ca762d62-2247-4eb5-861c-4b952ed5f93c",
                                                "sense_id": "2b1ca128-0c24-3b90-b385-45606b71e461",
                                                "text": "Mais lorsque la chute de cheveux aboutit à une diminution de la densité de capillaire et que le cuir chevelu devient visible, on parle alors d'alopécie."
                                            },
                                            {
                                                "example_id": "7b5fe65c-549d-4d56-b149-998c0c0f476a",
                                                "sense_id": "2b1ca128-0c24-3b90-b385-45606b71e461",
                                                "text": "«Ma barbe est devenue blanche, elle tombe un peu, les cheveux aussi. La moustache est partie, je ne sais pas si elle reviendra, mais ça m'étonnerait», a-t-il dit. «Je suis atteint de ce qu'on appelle l’alopécie», a poursuivi M. Philippe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2a349888-df8d-4d4a-991c-7b5de4d553fb",
