{
    "word_family": [
        "какой",
        "каков",
        "никак",
        "кое-как",
        "как-то",
        "как-нибудь",
        "как-либо",
        "якобы"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "799b523c-c7a5-38b7-93a7-0d80347b71bd",
                    "sense_definition": "Вопросительное слово, обозначающее образ действия, способ или состояние (каким образом?).",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "adv_interrogative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Как</w> вас зову́т?",
                            "target_lang_translations": {
                                "en": "<w>What</w> is your name?",
                                "zh": "你叫<w>什么</w>名字？"
                            }
                        },
                        {
                            "text": "Я не зна́ю, <w>как</w> э́то рабо́тает.",
                            "target_lang_translations": {
                                "en": "I don't know <w>how</w> this works.",
                                "zh": "我不知道这<w>怎么</w>运作。"
                            }
                        },
                        {
                            "text": "<w>Как</w> вы себя́ чу́вствуете сего́дня?",
                            "target_lang_translations": {
                                "en": "<w>How</w> do you feel today?",
                                "zh": "你今天感觉<w>如何</w>？"
                            }
                        }
                    ],
                    "synonyms": [
                        "каким образом"
                    ],
                    "common_phrases": [
                        "как дела",
                        "как обычно",
                        "как правило",
                        "как раз",
                        "как можно скорее"
                    ],
                    "target_lang_definitions": {
                        "en": "An interrogative word used to ask about the manner, method, or condition of an action or state.",
                        "zh": "用于询问动作的方式、方法或状态的疑问词。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "how",
                                "target_lang_sense_clarification": "interrogative adverb asking about manner or condition"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "怎么",
                                "target_lang_sense_clarification": "询问方式或原因的疑问副词"
                            },
                            {
                                "target_lang_word": "如何",
                                "target_lang_sense_clarification": "询问方式或状态的疑问副词"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "90d7a4b5-9b19-346f-8307-304609f5a5f1",
                    "sense_definition": "Слово, используемое в восклицательных предложениях для обозначения высокой степени качества или действия.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "adv_degree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Как</w> здо́рово мы провели́ вре́мя!",
                            "target_lang_translations": {
                                "en": "<w>What</w> a great time we had!",
                                "zh": "我们玩得<w>多么</w>开心啊！"
                            }
                        },
                        {
                            "text": "<w>Как</w> жаль, что ты не пришёл.",
                            "target_lang_translations": {
                                "en": "<w>What</w> a pity that you didn't come.",
                                "zh": "你没来真是<w>太</w>可惜了。"
                            }
                        },
                        {
                            "text": "<w>Как</w> бы́стро лети́т вре́мя!",
                            "target_lang_translations": {
                                "en": "<w>How</w> fast time flies!",
                                "zh": "时间过得<w>多么</w>快啊！"
                            }
                        }
                    ],
                    "synonyms": [
                        "насколько",
                        "до чего"
                    ],
                    "common_phrases": [
                        "как жаль",
                        "как странно",
                        "как красиво"
                    ],
                    "target_lang_definitions": {
                        "en": "Used in exclamations to emphasize a high degree or quality.",
                        "zh": "用于感叹句，强调程度高或品质突出。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "how",
                                "target_lang_sense_clarification": "used in exclamations to emphasize degree"
                            },
                            {
                                "target_lang_word": "what",
                                "target_lang_sense_clarification": "used in 'what a' phrases for emphasis"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "多么",
                                "target_lang_sense_clarification": "用于感叹句强调程度"
                            },
                            {
                                "target_lang_word": "好",
                                "target_lang_sense_clarification": "用于感叹句表示程度"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "26f89840-0a9c-38f6-ad12-0e731b061b19",
                    "sense_definition": "Насколько, в какой степени (о мере и степени).",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "adv_degree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Как</w> далеко́ отсю́да до вокза́ла?",
                            "target_lang_translations": {
                                "en": "<w>How</w> far is it from here to the station?",
                                "zh": "从这儿到车站有<w>多</w>远？"
                            }
                        },
                        {
                            "text": "Я не знал, <w>как</w> э́то ва́жно для них.",
                            "target_lang_translations": {
                                "en": "I didn't know <w>how</w> important this was for them.",
                                "zh": "我不知道这对他们有<w>多</w>重要。"
                            }
                        }
                    ],
                    "synonyms": [
                        "насколько"
                    ],
                    "common_phrases": [
                        "как долго",
                        "как много",
                        "как часто"
                    ],
                    "target_lang_definitions": {
                        "en": "Used to ask or state the extent or degree of something.",
                        "zh": "用于询问或陈述某事物的程度或范围。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "how",
                                "target_lang_sense_clarification": "adverb of degree or extent"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "多",
                                "target_lang_sense_clarification": "询问程度或范围的副词"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3df25467-7963-3770-9383-0ef54fe9e8bc",
                    "sense_definition": "В сочетании с частицей «ни» выражает уступку: сколько бы ни, в какой бы степени ни.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "adv_concessive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Как</w> ни стра́нно, он оказа́лся прав.",
                            "target_lang_translations": {
                                "en": "Strange <w>as</w> it seems, he turned out to be right.",
                                "zh": "<w>无论</w>多么奇怪，他竟然是对的。"
                            }
                        },
                        {
                            "text": "<w>Как</w> он ни стара́лся, ничего́ не выходи́ло.",
                            "target_lang_translations": {
                                "en": "<w>No matter how</w> hard he tried, nothing worked.",
                                "zh": "<w>不管</w>他怎么努力，都没用。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "как ни странно",
                        "как ни крути",
                        "как бы то ни было"
                    ],
                    "target_lang_definitions": {
                        "en": "Used with the particle 'ni' to express concession (regardless of degree).",
                        "zh": "与“不”或“没”连用，表示让步，意为无论程度如何。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "however",
                                "target_lang_sense_clarification": "concessive adverb"
                            },
                            {
                                "target_lang_word": "no matter how",
                                "target_lang_sense_clarification": "phrase expressing concession"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "无论",
                                "target_lang_sense_clarification": "表示条件或让步"
                            },
                            {
                                "target_lang_word": "不管",
                                "target_lang_sense_clarification": "表示让步"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6c474e5b-fa86-3e5e-be0d-131e08144cc4",
                    "sense_definition": "Внезапно, неожиданно (обычно при описании прошедших событий для придания динамичности).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "adv_narrative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он сиде́л ти́хо, а пото́м <w>как</w> закричи́т!",
                            "target_lang_translations": {
                                "en": "He was sitting quietly, and then <w>suddenly</w> screamed!",
                                "zh": "他安静地坐着，<w>突然</w>大叫起来！"
                            }
                        },
                        {
                            "text": "Заяц <w>как</w> вы́скочит из кусто́в прямо нам под но́ги.",
                            "target_lang_translations": {
                                "en": "The hare <w>suddenly</w> jumped out of the bushes right under our feet.",
                                "zh": "兔子<w>突然</w>从灌木丛里跳出来，正好跳到我们脚下。"
                            }
                        }
                    ],
                    "synonyms": [
                        "вдруг",
                        "внезапно"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used in lively storytelling"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Used to indicate a sudden, unexpected action in a narrative.",
                        "zh": "用于叙述中，表示动作突然发生。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "suddenly",
                                "target_lang_sense_clarification": "indicating sudden action"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "突然",
                                "target_lang_sense_clarification": "表示动作发生得快且意外"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "631b045e-ae28-3825-93a2-9d318af2c833",
                    "sense_definition": "Союз, используемый для сравнения; указывает на сходство с кем-либо или чем-либо.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "conj_comparison",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Она́ говори́т по-ру́сски <w>как</w> носи́тель языка́.",
                            "target_lang_translations": {
                                "en": "She speaks Russian <w>like</w> a native speaker.",
                                "zh": "她说俄语说得<w>像</w>母语者一样。"
                            }
                        },
                        {
                            "text": "Вода́ в о́зере была́ прозра́чная <w>как</w> стекло́.",
                            "target_lang_translations": {
                                "en": "The water in the lake was clear <w>as</w> glass.",
                                "zh": "湖水清澈得<w>如同</w>玻璃。"
                            }
                        },
                        {
                            "text": "Бу́дьте <w>как</w> до́ма.",
                            "target_lang_translations": {
                                "en": "Make yourself <w>at</w> home.",
                                "zh": "请<w>像</w>在自己家一样。"
                            }
                        }
                    ],
                    "synonyms": [
                        "словно",
                        "будто",
                        "точно",
                        "будто бы",
                        "подобно"
                    ],
                    "common_phrases": [
                        "белый как снег",
                        "нужен как воздух",
                        "как две капли воды"
                    ],
                    "target_lang_definitions": {
                        "en": "A conjunction used to compare two things, indicating similarity.",
                        "zh": "用于比较两个事物，表示相似。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "like",
                                "target_lang_sense_clarification": "preposition indicating similarity"
                            },
                            {
                                "target_lang_word": "as",
                                "target_lang_sense_clarification": "conjunction indicating similarity"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "像",
                                "target_lang_sense_clarification": "表示相似的介词"
                            },
                            {
                                "target_lang_word": "如同",
                                "target_lang_sense_clarification": "表示相似的连词"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3dfb174b-4a82-3b99-a122-fec42fc9ba27",
                    "sense_definition": "Союз, присоединяющий придаточное предложение к глаголам восприятия (видеть, слышать, чувствовать) или мысли.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "conj_perception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я ви́дел, <w>как</w> она́ выходи́ла из до́ма.",
                            "target_lang_translations": {
                                "en": "I saw <w>how</w> she was leaving the house.",
                                "zh": "我<w>看到</w>她从屋里出来。"
                            }
                        },
                        {
                            "text": "Мы слы́шали, <w>как</w> игра́ла му́зыка в сосе́дней ко́мнате.",
                            "target_lang_translations": {
                                "en": "We heard <w>how</w> the music was playing in the next room.",
                                "zh": "我们<w>听到</w>隔壁房间在放音乐。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "видеть как",
                        "слышать как",
                        "смотреть как"
                    ],
                    "target_lang_definitions": {
                        "en": "A conjunction linking a subordinate clause to verbs of perception or thought.",
                        "zh": "连接从句与感知或思维动词。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "how",
                                "target_lang_sense_clarification": "conjunction introducing a clause"
                            },
                            {
                                "target_lang_word": "that",
                                "target_lang_sense_clarification": "conjunction introducing a fact"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "看到",
                                "target_lang_sense_clarification": "感知动词后接从句"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "484befe0-a4b6-39f1-9203-15d93ea85616",
                    "sense_definition": "Союз, указывающий на роль, функцию или качество, в котором выступает лицо или предмет.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "conj_role",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я говорю́ с ва́ми <w>как</w> врач.",
                            "target_lang_translations": {
                                "en": "I am speaking to you <w>as</w> a doctor.",
                                "zh": "我<w>作为</w>医生和你谈话。"
                            }
                        },
                        {
                            "text": "Э́то зда́ние изве́стно <w>как</w> са́мое высо́кое в го́роде.",
                            "target_lang_translations": {
                                "en": "This building is known <w>as</w> the tallest in the city.",
                                "zh": "这座建筑被公认<w>为</w>城里最高的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "в качестве"
                    ],
                    "common_phrases": [
                        "известен как",
                        "работать как",
                        "использовать как"
                    ],
                    "target_lang_definitions": {
                        "en": "A conjunction indicating the role, function, or capacity of a person or thing.",
                        "zh": "表示身份、角色、功能或品质。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "as",
                                "target_lang_sense_clarification": "in the capacity or role of"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "作为",
                                "target_lang_sense_clarification": "表示身份或角色"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d168d3bf-2272-3117-98ba-8c503b77d417",
                    "sense_definition": "Союз, указывающий на время совершения действия; в то время как, когда.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "conj_temporal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я позвоню́ тебе́, <w>как</w> то́лько прие́ду.",
                            "target_lang_translations": {
                                "en": "I will call you <w>as</w> soon as I arrive.",
                                "zh": "我一到<w>就</w>给你打电话。"
                            }
                        },
                        {
                            "text": "Прошёл год с тех пор, <w>как</w> мы ви́делись.",
                            "target_lang_translations": {
                                "en": "A year has passed <w>since</w> we met.",
                                "zh": "我们<w>自从</w>上次见面已经过了一年了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "когда"
                    ],
                    "common_phrases": [
                        "как только",
                        "с тех пор как",
                        "перед тем как",
                        "после того как",
                        "в то время как"
                    ],
                    "target_lang_definitions": {
                        "en": "A conjunction indicating the time an action takes place.",
                        "zh": "表示动作发生的时间。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "as",
                                "target_lang_sense_clarification": "temporal conjunction"
                            },
                            {
                                "target_lang_word": "when",
                                "target_lang_sense_clarification": "at the time that"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "一……就……",
                                "target_lang_sense_clarification": "表示时间先后"
                            },
                            {
                                "target_lang_word": "自从",
                                "target_lang_sense_clarification": "表示时间起点"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "85d652ed-e8ed-3868-9e8b-c6b47a5f3b7b",
                    "sense_definition": "Часть составного союза «как..., так и...», выражающего объединение (и..., и...).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "conj_correlative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Э́тот фильм нра́вится <w>как</w> де́тям, так и взро́слым.",
                            "target_lang_translations": {
                                "en": "This movie is liked by <w>both</w> children and adults.",
                                "zh": "这部电影<w>既</w>受孩子欢迎，也受大人欢迎。"
                            }
                        },
                        {
                            "text": "В меню́ есть <w>как</w> мя́сные, так и вегетариа́нские блю́да.",
                            "target_lang_translations": {
                                "en": "The menu has <w>both</w> meat and vegetarian dishes.",
                                "zh": "菜单上<w>既</w>有肉食也有素食。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "как так и"
                    ],
                    "target_lang_definitions": {
                        "en": "Part of a correlative conjunction pair expressing inclusion.",
                        "zh": "关联连词“既……又……”的一部分，表示并列。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "both",
                                "target_lang_sense_clarification": "part of 'both... and...'"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "既",
                                "target_lang_sense_clarification": "表示并列关系"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "18666e02-c00d-3c47-837b-7c274cdb931f",
                    "sense_definition": "По причине того что; так как.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "conj_causal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "И <w>как</w> он до́лго не приходи́л, мы на́чали обе́дать без него́.",
                            "target_lang_translations": {
                                "en": "And <w>since</w> he didn't come for a long time, we started lunch without him.",
                                "zh": "<w>因为</w>他迟迟没来，我们没等他就先吃午饭了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "так как",
                        "поскольку"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "mostly found in literature; modern Russian prefers 'так как'"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A conjunction indicating cause or reason.",
                        "zh": "表示原因。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "since",
                                "target_lang_sense_clarification": "causal conjunction"
                            },
                            {
                                "target_lang_word": "as",
                                "target_lang_sense_clarification": "because"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "因为",
