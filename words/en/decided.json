                                "target_lang_sense_clarification": "фраза"
                            },
                            {
                                "target_lang_word": "определился",
                                "target_lang_sense_clarification": "сделал выбор"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "决定",
                                "target_lang_sense_clarification": "做出选择或决定"
                            },
                            {
                                "target_lang_word": "选定",
                                "target_lang_sense_clarification": "确定选择"
                            }
                        ]
                    }
                }
