                        "sense_id": "69b79359-46f3-3cf8-8ba4-8f61aa6f74b6",
                        "entry_id": "1274c25c-36c3-3020-8fb1-f3e4a9358854",
                        "glosses": [
                            "Maison de tolérance, lieu de prostitution, bordel. → voir boxon, bobinard, claque etc. par extension, endroit sale et mal tenu."
                        ],
                        "tags": [
                            "dated",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "2b9e3dc9-8ce2-4223-b418-31aeadf761be",
                                "sense_id": "69b79359-46f3-3cf8-8ba4-8f61aa6f74b6",
                                "text": "Baise-la ! Ou bien, si elle ne veut pas, va tirer ton coup au bouic."
                            },
                            {
                                "example_id": "8cdac8e4-9378-44c2-a774-13b411454b89",
                                "sense_id": "69b79359-46f3-3cf8-8ba4-8f61aa6f74b6",
                                "text": "Pour notre groupe scolaire, l’épreuve souhaitée et redoutée à la fois se déroulait dans les locaux de l’école de la rue Ferdinand-Flocon, proche de la mairie du XVIIIe, voie connue de tous les galopins du quartier pour une petite maison d’un étage aux volets verts toujours clos, un petit bouic de faubourg : Chez Rachel, du nom de la tenancière."
                            }
                        ]
                    },
                    {
                        "sense_id": "4532bfa4-350e-3202-8952-b8f65171f431",
                        "entry_id": "1274c25c-36c3-3020-8fb1-f3e4a9358854",
                        "glosses": [
                            "Café, restaurant."
                        ],
                        "tags": [
                            "dated",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "794032ec-2100-406d-98f4-8aa2a0e5e4ae",
                                "sense_id": "4532bfa4-350e-3202-8952-b8f65171f431",
                                "text": "Ils menaient une vie phénoménale du soir au matin, d’un bistrot à l’autre, d’un cabaret louche à un bouic occulte."
                            },
                            {
                                "example_id": "4c479e3f-d063-4c70-a6db-f67150c620c2",
                                "sense_id": "4532bfa4-350e-3202-8952-b8f65171f431",
                                "text": "Bon, le vin me réchauffait. Mais ce bouic me sortait par les trous de nez."
                            }
                        ]
                    }
                ],
