        "pl-extract.jsonl": [
            {
                "entry_id": "bdbd4be3-c352-3d72-85ed-1acfdb0d6fb6",
                "word": "krótkoterminowy",
                "pos": "adj",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8c79e90b-37f9-36e2-9ac8-d897994c1342",
                        "entry_id": "bdbd4be3-c352-3d72-85ed-1acfdb0d6fb6",
                        "glosses": [
                            "taki, który został przewidziany na krótki okres lub który ma krótki termin realizacji"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "3875344d-0ad3-3d07-b1b1-d63380d40f38",
                        "entry_id": "bdbd4be3-c352-3d72-85ed-1acfdb0d6fb6",
                        "glosses": [
                            "taki, który krótko trwa"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8d900dd6-6a05-42d9-8f1c-9efb41df0867",
                        "source_entry_id": "bdbd4be3-c352-3d72-85ed-1acfdb0d6fb6",
                        "source_sense_id": "8c79e90b-37f9-36e2-9ac8-d897994c1342",
                        "target_lang_word": "краткосрочный",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "краткосрочный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "9a461e28-ae22-31ca-9a6d-d5a93aeb3c4c",
                                        "entry_id": "8203cb79-93e0-3585-80b7-13d2903621af",
                                        "glosses": [
                                            "рассчитанный на короткий срок"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05ac6fd8-9af4-4c91-8db3-47aaa9d30922",
                                                "sense_id": "9a461e28-ae22-31ca-9a6d-d5a93aeb3c4c",
                                                "text": "Как объяснил представитель Nokia, её уход был мотивирован тем, что деятельность альянса не пересекалась с краткосрочными планами корпорации, а возвращение-тем, что к форуму присоединилось большое количество других представителей телекоммуникационной индустрии."
                                            },
                                            {
                                                "example_id": "5f15cdf4-a81b-4d01-8645-95614923be9b",
                                                "sense_id": "9a461e28-ae22-31ca-9a6d-d5a93aeb3c4c",
                                                "text": "Наибольшей достоверностью обладают краткосрочные сценарии, рассчитанные на 5, 10 и 15 лет."
                                            },
                                            {
                                                "example_id": "3c26dd2a-1aaa-4b11-884a-27f527bd55da",
                                                "sense_id": "9a461e28-ae22-31ca-9a6d-d5a93aeb3c4c",
                                                "text": "\"Насколько я знаю, в случае с пенсионными деньгами ответственность управляющего весьма ограниченна, ― говорит Олег Солнцев, ведущий эксперт Центра макроэкономического анализа и краткосрочного прогнозирования (ЦМАКП)."
                                            },
                                            {
                                                "example_id": "9d95a930-69fd-4e07-a46b-669e8995bc47",
                                                "sense_id": "9a461e28-ae22-31ca-9a6d-d5a93aeb3c4c",
                                                "text": "Конечно, мы не говорим о посланиях Президента Федеральному собранию, положения которых определяют краткосрочную социально-экономическую стратегию страны."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ee81496-79b5-35d8-a880-ab7e728b1208",
                                        "entry_id": "8203cb79-93e0-3585-80b7-13d2903621af",
                                        "glosses": [
                                            "длящийся в течение короткого срока"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01f16414-f96c-4351-bada-b899568264f3",
                                                "sense_id": "8ee81496-79b5-35d8-a880-ab7e728b1208",
                                                "text": "Между тем война с Ираком, как прогнозируют аналитики мировых рынков, приведёт к краткосрочному росту цен на нефть ― вплоть до отметки 100 долларов за баррель."
                                            },
                                            {
                                                "example_id": "e3b1028e-1553-409c-aaf0-d9000e9d1217",
                                                "sense_id": "8ee81496-79b5-35d8-a880-ab7e728b1208",
                                                "text": "Всего 100 мг кофеина (эта доза эквивалентна двум чашечкам кофе) не только стимулирует, но и повышает активность тех участков мозга, которые ответственны за краткосрочную память."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "345e5c49-0656-3104-80e8-3f5d4580ad51",
                                        "entry_id": "8203cb79-93e0-3585-80b7-13d2903621af",
                                        "glosses": [
                                            "предоставляемый, длящийся и имеющий силу на условленный установленный короткий срок"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b62a11b3-6ce3-47ac-8e73-b3aa0c9b556d",
                                                "sense_id": "345e5c49-0656-3104-80e8-3f5d4580ad51",
                                                "text": "Государственный Банк городского и земского кредита учреждается для выдачи городским и поселковым самоуправлениям и земским учреждениям долгосрочных и краткосрочных ссуд."
                                            },
                                            {
                                                "example_id": "85e22909-878c-4031-872b-25b347a6a8ab",
                                                "sense_id": "345e5c49-0656-3104-80e8-3f5d4580ad51",
                                                "text": "В августе установилось относительное затишье, и казаки, приходившие с фронта в краткосрочные отпуска, говорили о том, что к осени надо ждать перемирия."
                                            },
                                            {
                                                "example_id": "07ff4931-18ff-464f-8a8e-1994317d43a4",
                                                "sense_id": "345e5c49-0656-3104-80e8-3f5d4580ad51",
                                                "text": "― Я устала, захотела немного отдохнуть и поэтому устроила краткосрочные каникулы."
                                            },
                                            {
                                                "example_id": "7b10f5ba-d168-4463-86f5-fb4024cfc56f",
                                                "sense_id": "345e5c49-0656-3104-80e8-3f5d4580ad51",
                                                "text": "Во-первых, нужно выпустить краткосрочный финансовый инструмент с умеренным доходом, рассчитанный не на изворотливых финансовых спекулянтов, а на среднестатистического жителя нашей страны, который согласен меньше рисковать, сохранить свои сбережения с возвратом их в срок и с умеренным купонным процентным доходом, который будет выше средней ставки по депозиту Сбербанка (0, 5-1 пункт), что позволит получать положительную реальную доходность."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "111ae718-a9fd-30e4-bd0f-70d5a74ed529",
                                        "entry_id": "8203cb79-93e0-3585-80b7-13d2903621af",
                                        "glosses": [
                                            "наступающий в ближайшее время и длящийся в течение короткого срока"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5514779-f42d-40ad-8b3a-4fa6e69bf3db",
                                                "sense_id": "111ae718-a9fd-30e4-bd0f-70d5a74ed529",
                                                "text": "Первый путь, по меньшей мере, в краткосрочной перспективе, нелегко реализовать в силу политических ограничений."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bb0cd0cd-0410-45f3-8626-67d2ee942c91",
                        "source_entry_id": "bdbd4be3-c352-3d72-85ed-1acfdb0d6fb6",
                        "source_sense_id": "3875344d-0ad3-3d07-b1b1-d63380d40f38",
                        "target_lang_word": "краткосрочный",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "краткосрочный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "9a461e28-ae22-31ca-9a6d-d5a93aeb3c4c",
                                        "entry_id": "8203cb79-93e0-3585-80b7-13d2903621af",
                                        "glosses": [
                                            "рассчитанный на короткий срок"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05ac6fd8-9af4-4c91-8db3-47aaa9d30922",
                                                "sense_id": "9a461e28-ae22-31ca-9a6d-d5a93aeb3c4c",
                                                "text": "Как объяснил представитель Nokia, её уход был мотивирован тем, что деятельность альянса не пересекалась с краткосрочными планами корпорации, а возвращение-тем, что к форуму присоединилось большое количество других представителей телекоммуникационной индустрии."
                                            },
                                            {
                                                "example_id": "5f15cdf4-a81b-4d01-8645-95614923be9b",
                                                "sense_id": "9a461e28-ae22-31ca-9a6d-d5a93aeb3c4c",
                                                "text": "Наибольшей достоверностью обладают краткосрочные сценарии, рассчитанные на 5, 10 и 15 лет."
                                            },
                                            {
                                                "example_id": "3c26dd2a-1aaa-4b11-884a-27f527bd55da",
                                                "sense_id": "9a461e28-ae22-31ca-9a6d-d5a93aeb3c4c",
                                                "text": "\"Насколько я знаю, в случае с пенсионными деньгами ответственность управляющего весьма ограниченна, ― говорит Олег Солнцев, ведущий эксперт Центра макроэкономического анализа и краткосрочного прогнозирования (ЦМАКП)."
                                            },
                                            {
                                                "example_id": "9d95a930-69fd-4e07-a46b-669e8995bc47",
                                                "sense_id": "9a461e28-ae22-31ca-9a6d-d5a93aeb3c4c",
                                                "text": "Конечно, мы не говорим о посланиях Президента Федеральному собранию, положения которых определяют краткосрочную социально-экономическую стратегию страны."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ee81496-79b5-35d8-a880-ab7e728b1208",
                                        "entry_id": "8203cb79-93e0-3585-80b7-13d2903621af",
                                        "glosses": [
                                            "длящийся в течение короткого срока"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01f16414-f96c-4351-bada-b899568264f3",
                                                "sense_id": "8ee81496-79b5-35d8-a880-ab7e728b1208",
                                                "text": "Между тем война с Ираком, как прогнозируют аналитики мировых рынков, приведёт к краткосрочному росту цен на нефть ― вплоть до отметки 100 долларов за баррель."
                                            },
                                            {
                                                "example_id": "e3b1028e-1553-409c-aaf0-d9000e9d1217",
                                                "sense_id": "8ee81496-79b5-35d8-a880-ab7e728b1208",
                                                "text": "Всего 100 мг кофеина (эта доза эквивалентна двум чашечкам кофе) не только стимулирует, но и повышает активность тех участков мозга, которые ответственны за краткосрочную память."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "345e5c49-0656-3104-80e8-3f5d4580ad51",
                                        "entry_id": "8203cb79-93e0-3585-80b7-13d2903621af",
                                        "glosses": [
                                            "предоставляемый, длящийся и имеющий силу на условленный установленный короткий срок"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b62a11b3-6ce3-47ac-8e73-b3aa0c9b556d",
                                                "sense_id": "345e5c49-0656-3104-80e8-3f5d4580ad51",
                                                "text": "Государственный Банк городского и земского кредита учреждается для выдачи городским и поселковым самоуправлениям и земским учреждениям долгосрочных и краткосрочных ссуд."
                                            },
                                            {
                                                "example_id": "85e22909-878c-4031-872b-25b347a6a8ab",
                                                "sense_id": "345e5c49-0656-3104-80e8-3f5d4580ad51",
                                                "text": "В августе установилось относительное затишье, и казаки, приходившие с фронта в краткосрочные отпуска, говорили о том, что к осени надо ждать перемирия."
                                            },
                                            {
                                                "example_id": "07ff4931-18ff-464f-8a8e-1994317d43a4",
                                                "sense_id": "345e5c49-0656-3104-80e8-3f5d4580ad51",
                                                "text": "― Я устала, захотела немного отдохнуть и поэтому устроила краткосрочные каникулы."
                                            },
                                            {
                                                "example_id": "7b10f5ba-d168-4463-86f5-fb4024cfc56f",
                                                "sense_id": "345e5c49-0656-3104-80e8-3f5d4580ad51",
                                                "text": "Во-первых, нужно выпустить краткосрочный финансовый инструмент с умеренным доходом, рассчитанный не на изворотливых финансовых спекулянтов, а на среднестатистического жителя нашей страны, который согласен меньше рисковать, сохранить свои сбережения с возвратом их в срок и с умеренным купонным процентным доходом, который будет выше средней ставки по депозиту Сбербанка (0, 5-1 пункт), что позволит получать положительную реальную доходность."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "111ae718-a9fd-30e4-bd0f-70d5a74ed529",
                                        "entry_id": "8203cb79-93e0-3585-80b7-13d2903621af",
                                        "glosses": [
                                            "наступающий в ближайшее время и длящийся в течение короткого срока"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5514779-f42d-40ad-8b3a-4fa6e69bf3db",
                                                "sense_id": "111ae718-a9fd-30e4-bd0f-70d5a74ed529",
                                                "text": "Первый путь, по меньшей мере, в краткосрочной перспективе, нелегко реализовать в силу политических ограничений."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
