            {
                "entry_id": "4a685284-de11-3fbe-bc28-d050fdd5d7aa",
                "word": "cardan",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "37ef463a-5c8e-40c1-b195-2400e6de5558",
                        "entry_id": "4a685284-de11-3fbe-bc28-d050fdd5d7aa",
                        "tags": [
                            "plural"
                        ],
                        "form": "cardans"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3b55b6a1-c095-3c63-afb9-418098b47761",
                        "entry_id": "4a685284-de11-3fbe-bc28-d050fdd5d7aa",
                        "glosses": [
                            "Système mécanique permettant, entre autres, de maintenir l'axe vertical d'un objet malgré les oscillations de son support."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b4871ac-4ea9-4661-b9e0-c4f2dcce135c",
                                "sense_id": "3b55b6a1-c095-3c63-afb9-418098b47761",
                                "text": "Un anneau de suspension articulé à cardan assure une horizontalité parfaite de l'appareil, contrôlée par un niveau à bulles. Il faut signaler cependant la fragilité de cet appareil."
                            },
                            {
                                "example_id": "21e36c74-493e-455f-8c2d-a9f25edb37d2",
                                "sense_id": "3b55b6a1-c095-3c63-afb9-418098b47761",
                                "text": "Le compas entier pèse environ 12 kilogs et est monté dans un cardan porté par un cercle lui-même supporté par un système antichoc."
                            }
                        ]
                    },
                    {
                        "sense_id": "89b7274f-0544-3c7b-91f5-add08cf34613",
                        "entry_id": "4a685284-de11-3fbe-bc28-d050fdd5d7aa",
                        "glosses": [
                            "Système mécanique permettant la transmission d’un mouvement de rotation entre deux axes non parallèles entre eux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d25b465-7a86-44c9-8f7e-d0a7ac985e0f",
                                "sense_id": "89b7274f-0544-3c7b-91f5-add08cf34613",
                                "text": "Je préfère la transmission par cardans transversaux, tant au point de vue de la facilité de la construction, qu'au point de vue entretien et économie."
                            },
                            {
                                "example_id": "b90850d8-affb-4364-b9a7-7b364bb4a6c4",
                                "sense_id": "89b7274f-0544-3c7b-91f5-add08cf34613",
                                "text": "J’avais acheté une vieille 4L dont les cardans exténués rendaient d’inquiétants sons de castagnettes et je roulais des journées entières sur des routes où la mort guettait à chaque virage."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a211db13-6895-4286-9d08-cec3aade5344",
                        "source_entry_id": "4a685284-de11-3fbe-bc28-d050fdd5d7aa",
                        "target_lang_word": "Kreuzgelenk",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "cf7ee890-50cf-4518-84f1-5eee6766cd76",
                        "source_entry_id": "4a685284-de11-3fbe-bc28-d050fdd5d7aa",
                        "target_lang_word": "Kardangelenk",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kardangelenk",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a15e1d2d-94ad-3c37-9585-fd50c48ef9f5",
                                        "entry_id": "0bd6ca9c-2a06-37bd-bcb6-a8eaedac5e14",
                                        "glosses": [
                                            "Gelenk, zur Verbindung zweier nicht fluchtender Wellen (Kardanwellen)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f4c9c13-df88-48ba-bbf4-6dcddac72f92",
                                                "sense_id": "a15e1d2d-94ad-3c37-9585-fd50c48ef9f5",
                                                "text": "„Diese ist mit der Ausgangswelle des Getriebes mit einem Kardangelenk verbunden.“"
                                            },
                                            {
                                                "example_id": "fee8d8b9-7e26-4960-a914-09518250cb34",
                                                "sense_id": "a15e1d2d-94ad-3c37-9585-fd50c48ef9f5",
                                                "text": "„Wie das größte österreichische Unternehmen in der Weltraumtechnik am Dienstag mitteilte, erhielt es kürzlich einen Auftrag für die Entwicklung eines Kardangelenks zur beweglichen Aufhängung eines neu entwickelten Motors für die neue Oberstufe der Ariane-5.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
