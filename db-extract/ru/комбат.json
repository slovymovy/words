                    },
                    {
                        "translation_id": "5abaa832-678c-432d-a15f-d7ec4c7ec847",
                        "source_entry_id": "526130ac-922b-3057-a160-119661205b64",
                        "source_sense_description": "командир батальона",
                        "target_lang_word": "chef de bataillon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chef de bataillon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f866d063-1502-3b0b-a944-07a00f65be1b",
                                        "entry_id": "019261b3-a325-3967-abdc-05eafc71e96e",
                                        "glosses": [
                                            "Grade militaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82bf2668-b811-4487-ad07-0b71630e7728",
                                                "sense_id": "f866d063-1502-3b0b-a944-07a00f65be1b",
                                                "text": "Dès l'année 1837 , Charlet avait voulu résigner son grade de chef de bataillon de la garde nationale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02886a66-58f8-3bcb-aa40-0d99d958f04d",
                                        "entry_id": "019261b3-a325-3967-abdc-05eafc71e96e",
                                        "glosses": [
                                            "Officier supérieur de ce grade, situé hiérarchiquement entre son supérieur, le lieutenant-colonel, et son subordonné, le capitaine, dans certaines armes."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd7a70e1-daa4-46e4-8444-85e53c35651e",
                                                "sense_id": "02886a66-58f8-3bcb-aa40-0d99d958f04d",
                                                "text": "Quelles fonctions plus pénibles et plus dispendieuses que celles de capitaine et de chef de bataillon de la garde nationale, dans une commune de campagne ?"
                                            },
                                            {
                                                "example_id": "37398101-a81e-4a22-8d24-2665a4839c69",
                                                "sense_id": "02886a66-58f8-3bcb-aa40-0d99d958f04d",
                                                "text": "C’était un homme d’environ cinquante ans, à moustaches blanches, fort et grand, le dos voûté à la manière des vieux officiers d’infanterie qui ont porté le sac. Il en avait l’uniforme, et l’on entrevoyait une épaulette de chef de bataillon sous un petit manteau bleu court et usé."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
