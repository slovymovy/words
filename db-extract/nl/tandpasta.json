                "senses": [
                    {
                        "sense_id": "f0da9f35-fb80-3a0d-b54b-8a5fe0a1c467",
                        "entry_id": "52ad5c5c-c0bf-3138-bc51-eadeb8433f0b",
                        "glosses": [
                            "een poetsmiddel voor de tanden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5dc6df35-9a04-4111-9a05-dfcbaa14f2e1",
                                "sense_id": "f0da9f35-fb80-3a0d-b54b-8a5fe0a1c467",
                                "text": "Doe je voor het poetsen wel tandpasta op je borstel?"
                            },
                            {
                                "example_id": "ae42f4d6-b602-4d3a-9611-5ee2a494ad95",
                                "sense_id": "f0da9f35-fb80-3a0d-b54b-8a5fe0a1c467",
                                "text": "Ten derde is het voor adverteerders van belang om loyaliteit naar een merk zo vroeg mogelijk te stimuleren, zegt Van Reijmersdal. \"Als kinderen op jonge leeftijd een bepaald merk tandpasta gebruiken, is de kans groot dat ze dit later als volwassene ook blijven gebruiken.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4f659ea9-076a-48b2-a0d6-18e7059cc287",
                        "source_entry_id": "52ad5c5c-c0bf-3138-bc51-eadeb8433f0b",
