                        "glosses": [
                            "устар. неповоротливый, неуклюжий человек"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44329fa3-06b4-4212-97a2-edf33abfe14b",
                                "sense_id": "8041f855-8fba-3a04-b164-cf20af0b0770",
                                "text": "Ротозей Емельян, беги к повару-телепню, чтобы потрошил поскорей осетра."
                            },
                            {
                                "example_id": "d015447b-0b3b-4dfd-8d84-8d03661d9b1e",
                                "sense_id": "8041f855-8fba-3a04-b164-cf20af0b0770",
                                "text": "А не услышит, телепень этакий, звоните, топайте и кричите!"
                            }
                        ]
                    }
