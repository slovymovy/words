                    },
                    {
                        "translation_id": "353b648b-8978-42ba-a437-70f57bcb1634",
                        "source_entry_id": "fbc3add9-a033-306a-b415-047d2b5fc839",
                        "source_sense_id": "27ab6272-a8b6-31ba-b004-972139702bd0",
                        "source_sense_description": "een klein vast hemellichaam dat net als een planeet om de zon draait",
                        "target_lang_word": "astéroïde",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "astéroïde",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cce1cfb2-daae-3d29-9d01-bc1ce22078b7",
                                        "entry_id": "05ce43da-9ef0-3dfe-b166-29326c612ff3",
                                        "glosses": [
                                            "Objet céleste dont la taille varie de quelques mètres à plusieurs centaines de kilomètres de diamètre, qui tourne autour du Soleil ou fait partie d’un autre système stellaire."
                                        ],
                                        "tags": [
                                            "Planétologie",
                                            "Astronomie observationnelle"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "105921ed-555d-4317-b0d0-db6057ebad4b",
                                                "sense_id": "cce1cfb2-daae-3d29-9d01-bc1ce22078b7",
                                                "text": "Au siècle suivant, les astronomes ont observé une nouvelle classe d’objets célestes qu’ils ont qualifiés d’« astéroïdes », et non de « planétoïdes », en dépit du fait qu’ils orbitaient autour du Soleil comme les planètes. Les premiers astéroïdes ont reçu le nom de Ceres, Pallas, Juno et Vesta. Comme des milliers d’autres, ils circulent entre les orbites de Mars et de Jupiter dans ce que l’on a conséquemment appelé la Ceinture d’astéroïdes."
                                            },
                                            {
                                                "example_id": "53ee3f54-7b36-45d8-b9c9-acd6524e4b64",
                                                "sense_id": "cce1cfb2-daae-3d29-9d01-bc1ce22078b7",
                                                "text": "Le premier objet interstellaire à avoir été observé passant près de notre système solaire est Oumuamua. Classé à l'origine comme une comète, Oumuamua a ensuite été reclassé comme un astéroïde, parce qu'il n'avait pas de coma."
                                            },
                                            {
                                                "example_id": "ee25de5c-0e13-430e-8202-5484c8c889e6",
                                                "sense_id": "cce1cfb2-daae-3d29-9d01-bc1ce22078b7",
                                                "text": "La ceinture de Kuiper est une région peuplée de milliers d’astéroïdes et de comètes de plus de 100 kilomètres de large."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d537ea7-7732-3fc5-ab98-2c8933ffd867",
                                        "entry_id": "05ce43da-9ef0-3dfe-b166-29326c612ff3",
                                        "glosses": [
                                            "Météorite."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9f74c12-40bd-4162-8554-526905c396b7",
                                                "sense_id": "6d537ea7-7732-3fc5-ab98-2c8933ffd867",
                                                "text": "Les mouvements apparents des étoiles filantes sont quelquefois directs, quelquefois rétrogrades, c’est-à-dire qu’au lieu de paraître provenir du Lion, les étoiles filantes semblent quelquefois être dirigées vers cette constellation. M. Valz a appelé avec raison l’attention sur cette particularité du phénomène qu’on ne peut expliquer qu’en admettant que le mouvement direct absolu des anneaux d’astéroïdes qui entourent au loin le Soleil est tantôt un peu plus lent, tantôt un peu plus rapide que celui de la Terre."
                                            },
                                            {
                                                "example_id": "f69349ac-4afe-4bb2-83a9-24c4ad825f00",
                                                "sense_id": "6d537ea7-7732-3fc5-ab98-2c8933ffd867",
                                                "text": "Barbicane avait saisi la main de ses deux compagnons, et tous trois regardaient à travers leurs paupières à demi fermées cet astéroïde chauffé à blanc. Si la pensée n’était pas détruite en eux, si leur cerveau fonctionnait encore au milieu de son épouvante, ils devaient se croire perdus !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4af0bf61-45f3-3756-8df5-6b148e29dc33",
                                        "entry_id": "05ce43da-9ef0-3dfe-b166-29326c612ff3",
                                        "glosses": [
                                            "Petit corps céleste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c1e1949-68e5-4414-a800-35b15c89c180",
                                                "sense_id": "4af0bf61-45f3-3756-8df5-6b148e29dc33",
                                                "text": "Le Juste restait droit sur ses hanches solides :\nUn rayon lui dorait l’épaule ; des sueurs\nMe prirent : « Tu veux voir rutiler les bolides ?\nEt, debout, écouter bourdonner les flueurs\nD’astres lactés, et les essaims d’astéroïdes ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56898bae-ab57-3aaa-b938-09690a16cbb9",
                                        "entry_id": "05ce43da-9ef0-3dfe-b166-29326c612ff3",
                                        "glosses": [
                                            "Petite tache blanche et opaque, en forme d’étoile, dans le corps vitré de l’œil."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4bddffe3-c190-36bc-b0dc-c0c0053b0b15",
                                        "entry_id": "05ce43da-9ef0-3dfe-b166-29326c612ff3",
                                        "glosses": [
                                            "Objet en forme d’étoile."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e549f8cf-9031-4b86-a004-8a5c0c414008",
                                                "sense_id": "4bddffe3-c190-36bc-b0dc-c0c0053b0b15",
                                                "text": "Les anges n’empruntent à la forme humaine que la tête ; le corps est remplacé par des ailes en plus ou moins grand nombre. On dirait des flammes nageant dans l’azur du ciel, et c’est au milieu de ces astéroïdes qu’apparaît, sur fond d’or, l’image du Christ, immense et dominant toute l’église."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "astéroïde",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ee0e9154-7c59-305e-b057-31252d03bcb2",
                                        "entry_id": "bbe52abf-3c31-3a75-ba8e-a7351af23faa",
                                        "glosses": [
                                            "Variante de astéride."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5412fe28-887a-4aad-8775-35a5c8f19d42",
                                                "sense_id": "ee0e9154-7c59-305e-b057-31252d03bcb2",
                                                "text": "L’assertion de Sars, que l’animal qu’il avait autrefois appelé Bipinnaria asterigera, n’est probablement qu’une Astéroïde en voie de développement et pourvue d’un grand appareil de natation, mérite d’être prise en considération."
                                            },
                                            {
                                                "example_id": "fb06c6ef-d844-40da-9e35-e731afcc5f7b",
                                                "sense_id": "ee0e9154-7c59-305e-b057-31252d03bcb2",
                                                "text": "Mlle Dubois : un des volumes d’un savant ouvrage richement illustré L’univers et l’Humanité et une Astéroïde de la famille des Astérniées : Palmipes membranaerus, cette étoile de mer provient des environs de St-Vaast-la-Hougue."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "astéroïde",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3a38faf4-f698-3228-8df2-65de52852f06",
                                        "entry_id": "5d2d6eed-789a-3af6-9c0f-0babec842868",
                                        "glosses": [
                                            "Genre d'astéracées à capitules jaunes appartenant au genre Buphthalmum; synonyme de buphthalme. → voir buphthalme"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca5e91a4-41a2-4f3c-8c95-42c137bae013",
                                                "sense_id": "3a38faf4-f698-3228-8df2-65de52852f06",
                                                "text": "L’astéroïde à feuille de Saule. Buphthalmum salicifolium. La tige herbacée, velue, ronde, droite, haute d’un pied ; les feuilles alternes, lancéolées comme dentelées, velues. Les calices nus ; les fleurs d’un jaune foncé. On trouve cette plante, qui est vivace, dans plusieurs de nos provinces."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "astéroïde",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "aad492d3-fe07-330e-a0b3-0353fd60a05e",
                                        "entry_id": "a95a1f97-5821-3b85-8699-6e946c968d21",
                                        "glosses": [
                                            "Courbe ressemblant au carreau des cartes à jouer et obtenue par le déplacement d’un point fixe situé sur un cercle de rayon 1 qui « roule » le long de l’intérieur d’un cercle de rayon 4."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ec7c158-8e42-48b3-be12-5d4da6db645a",
                                                "sense_id": "aad492d3-fe07-330e-a0b3-0353fd60a05e",
                                                "text": "Les courbes parallèles aux astéroïdes sont-elles toujours des astéroïdes ? Une astéroïde est la courbe enveloppée par une droite mobile r sur laquelle deux droites fixes a, b, formant un angle 2a, déterminent un segment à longueur donnée l ; si 2a = ½π, on dit que l’astéroïde est régulière."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "astéroïde",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2b80b5f9-f91d-3e0a-9f6f-e33acb569deb",
                                        "entry_id": "256a983c-2b0d-3919-8773-8aaca27fe29d",
                                        "glosses": [
                                            "Qualifie un organisme en forme d’étoile."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "68045047-c86e-43a7-86bc-674a4fed65f1",
                                                "sense_id": "2b80b5f9-f91d-3e0a-9f6f-e33acb569deb",
                                                "text": "L’in­térêt de ces observations n’est pas d’ordre clinique, mais consiste en ce que le champignon pathogène s’est présenté, dans le pus gom­meux, sous la forme astéroïde si curieuse, signalée par Splendore, au Brésil, en 1908, à propos d’un cas de sporotrichose humaine seul connu jusqu’ici."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22e19e88-d695-3eff-b947-6bfd2d3af392",
                                        "entry_id": "256a983c-2b0d-3919-8773-8aaca27fe29d",
                                        "glosses": [
                                            "Qui ressemble à une astérie."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
