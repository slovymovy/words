                    {
                        "sense_id": "82ac1e98-ea66-3a63-9fa4-df819b4719e7",
                        "entry_id": "e404c16a-0ec0-32fd-9a37-9cc95b317411",
                        "glosses": [
                            "Qui a la conviction délirante d’être aimé d'une autre personne, qui est atteint d’érotomanie."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "d4cc2b3c-8f1b-39d0-849f-96dccc689217",
                        "entry_id": "e404c16a-0ec0-32fd-9a37-9cc95b317411",
                        "glosses": [
                            "Qui a un besoin excessif de rapports sexuels."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2794df3-226b-4edf-8afb-87e37e4ff9e9",
                                "sense_id": "d4cc2b3c-8f1b-39d0-849f-96dccc689217",
                                "text": "Philippe est aussi érotomane. Il ne trompe jamais sa femme car il est très pieux mais il lui faut cinq à six rapports par jour."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
