                "senses": [
                    {
                        "sense_id": "dbdad509-ac26-37eb-963d-850936023209",
                        "entry_id": "c7ef1dc9-541e-31cf-8e4a-2b7e02f7e2a2",
                        "glosses": [
                            "sinnvolle oder notwendige Ausstattung, um eine Sache nutzen zu können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79fcfd79-b375-4bfd-b722-4660080187ef",
                                "sense_id": "dbdad509-ac26-37eb-963d-850936023209",
                                "text": "Die Grundausstattung der deutschen Lesesäle erfolgt Nutzer- und bedarfsorientiert in enger Absprache mit den Partnerbibliotheken."
                            },
                            {
                                "example_id": "f844084a-3011-4396-9f12-160f53c866f1",
                                "sense_id": "dbdad509-ac26-37eb-963d-850936023209",
                                "text": "Anna ist erst im 2 Monat schwanger und hat schon die gesamte Grundausstattung für das Baby gekauft."
                            },
                            {
                                "example_id": "ffb4c7fc-b4f5-4497-aa9e-0aa882adbf83",
                                "sense_id": "dbdad509-ac26-37eb-963d-850936023209",
                                "text": "Als Grundausstattung bietet der neue Mercedes ein Lenkrad für den Fahrer."
                            },
                            {
                                "example_id": "f4f4de6e-01c2-44fc-b663-908a3155aaa9",
                                "sense_id": "dbdad509-ac26-37eb-963d-850936023209",
                                "text": "„In kaum einem Kinderzimmer fehlte ein Satz Bleisoldaten, ebenso gehörte der Matrosenanzug zur Grundausstattung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
