                        "glosses": [
                            "afsluitbare bak waarin gereedschap opgeborgen en bijeengehouden wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfbc9a70-e667-40dd-b226-0a0bb5d02bfe",
                                "sense_id": "14e03ae0-3dfb-3b51-8dc1-ed6049efe7f6",
                                "text": "Leg dat alsjeblieft terug in de gereedschapskist!"
                            }
                        ]
                    },
                    {
                        "sense_id": "03fed809-cbd2-3416-9214-0e3d005e12eb",
                        "entry_id": "a02a47b3-4ea7-366e-9508-ca48da061b6a",
                        "glosses": [
                            "aantal mogelijkheden tot actie"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "e4b05190-aed8-4f75-a737-a28a5e82f642",
                                "sense_id": "03fed809-cbd2-3416-9214-0e3d005e12eb",
                                "text": "Het is „typisch Rutte”, vindt R. W. Maar ook weer niet helemaal. „Als premier doseerde hij het wat meer. Nu doet hij er een extra schep bovenop. Zijn hele gereedschapskist met overtuigende taal zet hij open voor onze Donald.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d5a75486-1fb4-4ed5-845c-97b42e5b9ea5",
                        "source_entry_id": "a02a47b3-4ea7-366e-9508-ca48da061b6a",
                        "source_sense_id": "14e03ae0-3dfb-3b51-8dc1-ed6049efe7f6",
                        "source_sense_description": "afsluitbare bak waarin gereedschap opgeborgen en bijeengehouden wordt",
                        "target_lang_word": "Werkzeugkasten",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Werkzeugkasten",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7f1c8149-fca3-3e07-94ac-438ce796fc0f",
                                        "entry_id": "f2cad64e-2dc3-360a-999c-a39f83ffacbe",
                                        "glosses": [
                                            "Behälter, in dem kleineres Werkzeug aufbewahrt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17a2fa8f-3e3b-4a18-a3c9-521f169d97ef",
                                                "sense_id": "7f1c8149-fca3-3e07-94ac-438ce796fc0f",
                                                "text": "Den Werkzeugkasten musste der Lehrling aus dem ersten Lehrjahr zur Baustelle schleppen."
                                            },
                                            {
                                                "example_id": "7d996916-b8fb-49f8-ac74-cd1168b9edef",
                                                "sense_id": "7f1c8149-fca3-3e07-94ac-438ce796fc0f",
                                                "text": "Klaus hatte neben den üblichen Schraubenziehern und Zangen auch immer etwas Hanf in seinem Werkzeugkasten."
                                            },
                                            {
                                                "example_id": "394cb173-b443-4b00-b759-eac9dcbc24b2",
                                                "sense_id": "7f1c8149-fca3-3e07-94ac-438ce796fc0f",
                                                "text": "„Er hat eine Kanzel gemacht, die noch verzierter und verzwickter als sein Werkzeugkasten ist: mit Tafeln aus Mahagoni und Perlmuttereinlagen, die in Bildern die Zehn Gebote darstellen.“"
                                            },
                                            {
                                                "example_id": "5476e894-87a6-4584-947b-e10df45a0ab1",
                                                "sense_id": "7f1c8149-fca3-3e07-94ac-438ce796fc0f",
                                                "text": "„Ob Japansäge, Stechbeitelsatz oder Edel-Hobel – Ihre feinen Handwerkzeuge sind in diesem soliden Werkzeugkasten vor Beschädigung und Verstauben geschützt.“"
                                            },
                                            {
                                                "example_id": "36d6c62a-f908-4231-bde1-065f093b9d9d",
                                                "sense_id": "7f1c8149-fca3-3e07-94ac-438ce796fc0f",
                                                "text": "„Schraubenschlüssel wie ein Satz Sechskant-Steckschlüssel und eine Gabelschlüssel-Garnitur aus Chrom-Vanadium in den Größen 8, 10, 13, 15, 17 und 19 sind unabdingbare Bestandteile eines Werkzeugkastens.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "83a640f8-2b08-4f00-840d-124734d6900c",
                        "source_entry_id": "a02a47b3-4ea7-366e-9508-ca48da061b6a",
                        "source_sense_id": "14e03ae0-3dfb-3b51-8dc1-ed6049efe7f6",
                        "source_sense_description": "afsluitbare bak waarin gereedschap opgeborgen en bijeengehouden wordt",
                        "target_lang_word": "toolkit",
