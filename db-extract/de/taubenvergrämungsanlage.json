                "senses": [
                    {
                        "sense_id": "17a56006-318d-3594-8c5d-2091f7914e86",
                        "entry_id": "d7bcccfd-17e4-34d0-91b7-dd3d0d19b248",
                        "glosses": [
                            "bauliche oder technische Maßnahme zur Vertreibung von Tauben und anderer Vögel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23df3e93-1d5d-4c57-9b44-75b6e9aa760c",
                                "sense_id": "17a56006-318d-3594-8c5d-2091f7914e86",
                                "text": "„Projekt: Alte Oper Frankfurt, Installation und Wartung einer Taubenvergrämungsanlage zum Schutz von Blech- und Glasdachflächen“"
                            },
                            {
                                "example_id": "7f6ff20c-6867-46e3-9391-4b745626c34c",
                                "sense_id": "17a56006-318d-3594-8c5d-2091f7914e86",
                                "text": "„Darum verfolgt er seit 2008 den Plan, eine sogenannte Taubenvergrämungsanlage auf dem Dach zu installieren.“"
                            },
                            {
                                "example_id": "d4827691-4e01-40fd-8511-43c1f3c6a769",
                                "sense_id": "17a56006-318d-3594-8c5d-2091f7914e86",
                                "text": "„Neben sinnlichen Details (Gestühl aus Tannenholz, Innenraum-Farbe aus Firnis, Eidotter und Leinöl), sickerten auch kuriose ins neugierige Publikum: ein Klohäuschen am Kuppelrund für höhenmutige Bauarbeiter musste befestigt werden (temporär), und eine \"Taubenvergrämungsanlage\" (stationär) an Fensterbänken und Gesimse.“"
                            },
                            {
                                "example_id": "c6639d56-600a-4e4f-83f8-d062ac582d52",
                                "sense_id": "17a56006-318d-3594-8c5d-2091f7914e86",
                                "text": "„Im Sommer 2013 konnten wir den Abbau einer mehreren hundert Meter langen Taubenvergrämungsanlage am Berliner Bahnhof Zoo erzwingen, weil diese gegen das Tierschutzgesetz verstieß.“"
                            },
                            {
                                "example_id": "588a93a6-3efd-4e10-8b67-6c318e9bd4ae",
                                "sense_id": "17a56006-318d-3594-8c5d-2091f7914e86",
                                "text": "„Der Wurst-Basar hat bislang ein offenes Konzept mit ganztägig geöffneten Glastüren. „Das ging bisher, weil wir eine teure Taubenvergrämungsanlage installiert haben“, sagt Hinsemann, „aber die Tiere haben sich wohl daran gewöhnt, sie werden immer dreister.““"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
