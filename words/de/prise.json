                },
                {
                    "sense_id": "89e37dff-5cb3-33c0-9556-88d8785930e9",
                    "sense_definition": "Ein im Seekrieg gekapertes feindliches Schiff oder dessen beschlagnahmte Ladung als Beute.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das Kriegsschiff brachte das feindliche Handelsschiff als wertvolle <w>Prise</w> in den heimatlichen Hafen."
                        },
                        {
                            "text": "Nach dem Seerecht durfte die Besatzung einen Anteil am Wert der <w>Prise</w> behalten."
