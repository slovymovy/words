{
    "word_family": [
        "enthralling",
        "enthralment",
        "enthrallment",
        "thrall",
        "thralldom"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "71ef7722-e2d2-3331-92d7-a596656bb597",
                    "sense_definition": "To capture the fascinated attention of; to hold completely spellbound.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "captivate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The magician managed to <w>enthrall</w> the entire audience with his dazzling final trick.",
                            "target_lang_translations": {
                                "ru": "Фокуснику удалось <w>заворожить</w> всю публику своим ослепительным финальным трюком."
                            }
                        },
                        {
                            "text": "Her extraordinary vocal performance continued to <w>enthrall</w> music lovers across the world.",
                            "target_lang_translations": {
                                "ru": "Её выдающееся вокальное мастерство продолжало <w>очаровывать</w> любителей музыки по всему миру."
                            }
                        }
                    ],
                    "synonyms": [
                        "bewitch",
                        "captivate",
                        "charm",
                        "enchant",
                        "transfix"
                    ],
                    "common_phrases": [
                        "enthrall the audience",
                        "enthrall the crowd"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полностью захватить внимание, очаровать или заворожить."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "очаровывать",
                                "target_lang_sense_clarification": "пленить, вызывать восторг и восхищение"
                            },
                            {
                                "target_lang_word": "зачаровывать",
                                "target_lang_sense_clarification": "приводить в восхищение, держать как под гипнозом"
                            },
                            {
                                "target_lang_word": "завораживать",
                                "target_lang_sense_clarification": "приковывать внимание, гипнотизировать"
                            },
                            {
                                "target_lang_word": "пленять",
                                "target_lang_sense_clarification": "покорять сердце или внимание"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a214a5b1-5391-3c1a-8570-7a5a690549db",
                    "sense_definition": "To reduce to slavery or subjugate.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "enslave",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The conquering empire sought to entirely <w>enthrall</w> the conquered population.",
                            "target_lang_translations": {
                                "ru": "Империя-завоеватель стремилась полностью <w>поработить</w> побеждённое население."
                            }
                        },
                        {
                            "text": "Cruel monarchs would routinely <w>enthrall</w> neighbouring tribes after claiming victory.",
                            "target_lang_translations": {
                                "ru": "Жестокие монархи обычно <w>обращали в рабство</w> соседние племена после одержанной победы."
                            }
                        }
                    ],
                    "antonyms": [
                        "disenthrall"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "literary and historical usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обращать в рабство или полностью подчинять своей воле (устаревшее)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "порабощать",
                                "target_lang_sense_clarification": "обращать в рабство, лишать свободы"
                            },
                            {
                                "target_lang_word": "закрепощать",
                                "target_lang_sense_clarification": "ставить в зависимое, подневольное положение"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}