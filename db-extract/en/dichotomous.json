                "forms": [],
                "senses": [
                    {
                        "sense_id": "b90ca612-e109-31ee-adef-cce2b6589e2d",
                        "entry_id": "fb095974-8947-37dc-acb9-08a20dcb6b4e",
                        "glosses": [
                            "Dividing or branching into two mutually exclusive pieces."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "bed24f35-3b0c-46e1-a739-3675181030b8",
                                "sense_id": "b90ca612-e109-31ee-adef-cce2b6589e2d",
                                "text": "Genus Riccia L. Plants are thalloid, forming rosettes or loose, dichotomous patches."
                            },
                            {
                                "example_id": "364447eb-ea77-44f8-a70d-cc4c7c5b0d75",
                                "sense_id": "b90ca612-e109-31ee-adef-cce2b6589e2d",
                                "text": "The second half of the book switches to the increasingly dark story of how, from the 17th century onwards, European thinkers and politicians constructed a more and more dichotomous worldview."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9ffe79e8-749b-450b-8b63-e7bd226b52d3",
                        "source_entry_id": "fb095974-8947-37dc-acb9-08a20dcb6b4e",
                        "source_sense_id": "b90ca612-e109-31ee-adef-cce2b6589e2d",
                        "source_sense_description": "dividing or branching into two pieces",
