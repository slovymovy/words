                "senses": [
                    {
                        "sense_id": "50994194-3cd8-33ed-9411-a52b5fbce26e",
                        "entry_id": "5c671159-d337-3da2-b26f-fa8aba753fdd",
                        "glosses": [
                            "Sammlung von Dokumenten eines Krankenhauses"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cae0b33f-fda5-494b-b973-fbcdf7953144",
                                "sense_id": "50994194-3cd8-33ed-9411-a52b5fbce26e",
                                "text": "„Das Krankenhausarchiv spielt daher eine wichtige Rolle in der Organisation und in der Logistik unseres Hauses.“"
                            },
                            {
                                "example_id": "222adc35-87e7-4a3b-bd43-47b26e044512",
                                "sense_id": "50994194-3cd8-33ed-9411-a52b5fbce26e",
                                "text": "„Bei der neuen Detektortechnik werden die Röntgenaufnahmen direkt nach der Anfertigung volldigital von der Röntgenanlage in das digitale Krankenhausarchiv gesendet und der jeweiligen Patientenakte unmittelbar zugeordnet, so dass der Arzt noch während der Diagnostik auf die Bilder zugreifen kann.“"
                            },
                            {
                                "example_id": "e80a3b39-7f24-4ba9-93ad-25c450232a6a",
                                "sense_id": "50994194-3cd8-33ed-9411-a52b5fbce26e",
                                "text": "„Zugegeben, ein paar Meter Aktentaschen findet man auch noch im Quedlinburger Krankenhausarchiv.“"
                            },
                            {
                                "example_id": "036597e1-14a5-4721-967f-3de392f19144",
                                "sense_id": "50994194-3cd8-33ed-9411-a52b5fbce26e",
                                "text": "„Etwa 19 Jahre später stößt Armbruster dann bei einer neuerlichen Recherche im Krankenhausarchiv auf die Akte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
