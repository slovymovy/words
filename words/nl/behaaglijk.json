                },
                {
                    "sense_id": "f880a3f4-bba5-3e82-8669-aad95b842dbd",
                    "sense_definition": "Een gevoel van tevredenheid en rust uitstralend of ervarend; op zijn gemak.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "gemoedstoestand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De oude man zat met een <w>behaaglijke</w> glimlach op het terras naar de voorbijgangers te kijken.",
                            "target_lang_translations": {
                                "en": "The old man sat watching the passers-by on the terrace with a <w>contented</w> smile.",
                                "ru": "Старик сидел на террасе с <w>довольной</w> улыбкой и наблюдал за прохожими."
                            }
                        },
                        {
                            "text": "Hij voelde zich volkomen <w>behaaglijk</w> in het gezelschap van zijn oude studievrienden.",
                            "target_lang_translations": {
                                "en": "He felt completely <w>at ease</w> in the company of his old college friends.",
                                "ru": "Он чувствовал себя совершенно <w>непринужденно</w> в компании старых университетских друзей."
                            }
                        }
                    ],
                    "synonyms": [
                        "behagelijk"
                    ],
                    "antonyms": [
                        "onbehaaglijk"
                    ],
                    "common_phrases": [
                        "zich behaaglijk voelen"
                    ],
                    "target_lang_definitions": {
                        "en": "Radiating or experiencing a sense of contentment, peace, and ease.",
                        "ru": "Испытывающий или выражающий довольство, покой и душевный комфорт; непринужденный."
                    },
