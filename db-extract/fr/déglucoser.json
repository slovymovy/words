                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83e5f438-f328-423c-8626-5b058cc8e0fc",
                                "sense_id": "15901475-73ca-373b-8b72-e126e02c6c81",
                                "text": "Il est d'ailleurs assez logique de déglucoser les sucres avec des sirops assez purs pour que l'élimination des impuretés se fasse assez facilement."
                            },
                            {
                                "example_id": "c432ca20-b513-464c-8995-e463deda5f57",
                                "sense_id": "15901475-73ca-373b-8b72-e126e02c6c81",
                                "text": "Ainsi, dès 1970 a-t-on pu « déglucoser » du blanc d'œuf avant séchage par atomisation (procédé consistant à pulvériser sous forme de très fines particules le liquide à sécher, dans une enceinte chauffée)."
                            }
                        ]
