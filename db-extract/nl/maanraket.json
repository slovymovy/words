                        "examples": [
                            {
                                "example_id": "688fe885-f239-4686-ad09-f230f09a66e9",
                                "sense_id": "0147e20c-c1a0-36fa-bd21-fefa43a15914",
                                "text": "De lancering van de raket van Cape Canaveral in Florida verliep vlot. Bij de operatie werd de krachtigste raket ooit gebruikt sinds de maanraket. Twee van de onderste stuwraketten keerden kort na de lancering terug naar de aarde en landden veilig aan het Kennedy Space Center. Ze kunnen weer opnieuw gebruikt worden."
                            },
                            {
                                "example_id": "db9331e1-904c-41b1-a55b-1e8b41971a0e",
                                "sense_id": "0147e20c-c1a0-36fa-bd21-fefa43a15914",
                                "text": "De overbekende maanraket uit Hergé’s Kuifje-verhaal staat volgende week (opnieuw) op een Belgische uitgifte, gewijd aan het Belgische Stripmuseum in Brussel (dus niet: het gloednieuwe Hergémuseum)."
                            }
