{
    "word_family": [
        "deployment",
        "deployable",
        "deployer",
        "redeploy"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2d8d54a3-c62c-3c72-bf6a-7efd7bf3dedf",
                    "sense_definition": "To position or arrange resources, troops, or equipment for a specific purpose or action.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "positioning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The general decided to <w>deploy</w> two units of infantry along the enemy's flank to secure the area.",
                            "target_lang_translations": {
                                "ru": "Генерал решил <w>развернуть</w> два подразделения пехоты вдоль фланга противника, чтобы обезопасить район."
                            }
                        },
                        {
                            "text": "Teachers can <w>deploy</w> resources effectively to help students understand complex scientific concepts.",
                            "target_lang_translations": {
                                "ru": "Учителя могут эффективно <w>задействовать</w> ресурсы, чтобы помочь ученикам понять сложные научные концепции."
                            }
                        }
                    ],
                    "synonyms": [
                        "position",
                        "station",
                        "arrange",
                        "distribute"
                    ],
                    "antonyms": [
                        "withdraw",
                        "recall"
                    ],
                    "common_phrases": [
                        "deploy resources",
                        "deploy troops",
                        "deploy personnel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Размещать или распределять ресурсы, войска или оборудование для определенной цели или действия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "развёртывать",
                                "target_lang_sense_clarification": "войска или ресурсы"
                            },
                            {
                                "target_lang_word": "дислоцировать",
                                "target_lang_sense_clarification": "войска"
                            },
                            {
                                "target_lang_word": "размещать",
                                "target_lang_sense_clarification": "оборудование или персонал"
                            },
                            {
                                "target_lang_word": "задействовать",
                                "target_lang_sense_clarification": "ресурсы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6be529eb-67bc-39e2-be68-541f2e631db6",
                    "sense_definition": "To open out or unfold so as to become ready for use.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "opening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pilot waited tensely for his parachute to <w>deploy</w> after jumping from the plane.",
                            "target_lang_translations": {
                                "ru": "Пилот в напряжении ждал, когда его парашют <w>раскроется</w> после прыжка с самолета."
                            }
                        },
                        {
                            "text": "Modern safety systems ensure that the airbag will <w>deploy</w> instantly upon a high-speed collision.",
                            "target_lang_translations": {
                                "ru": "Современные системы безопасности гарантируют, что подушка безопасности <w>сработает</w> мгновенно при высокоскоростном столкновении."
                            }
                        }
                    ],
                    "synonyms": [
                        "unfold",
                        "open",
                        "expand"
                    ],
                    "antonyms": [
                        "stow",
                        "fold"
                    ],
                    "common_phrases": [
                        "deploy the airbag",
                        "parachute to deploy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Раскрываться или разворачиваться, становясь готовым к использованию."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раскрываться",
                                "target_lang_sense_clarification": "о парашюте или подушке безопасности"
                            },
                            {
                                "target_lang_word": "срабатывать",
                                "target_lang_sense_clarification": "о системе безопасности"
                            },
                            {
                                "target_lang_word": "разворачиваться",
                                "target_lang_sense_clarification": "о механизме"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "754e673e-91f9-3301-a27b-f35cc3dde857",
                    "sense_definition": "To move a computer system or software application into an operational environment.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The IT team plans to <w>deploy</w> the software update across all company computers this weekend.",
                            "target_lang_translations": {
                                "ru": "ИТ-команда планирует <w>развернуть</w> обновление программного обеспечения на всех компьютерах компании в эти выходные."
                            }
                        },
                        {
                            "text": "After testing the code, the developers will <w>deploy</w> the application to the production server.",
                            "target_lang_translations": {
                                "ru": "После тестирования кода разработчики <w>выкатят</w> приложение на рабочий сервер."
                            }
                        }
                    ],
                    "synonyms": [
                        "implement",
                        "install",
                        "launch"
                    ],
                    "antonyms": [
                        "uninstall",
                        "rollback"
                    ],
                    "common_phrases": [
                        "deploy the application",
                        "deploy software updates"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Переносить компьютерную систему или программное приложение в рабочую среду."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "развёртывать",
                                "target_lang_sense_clarification": "ПО или инфраструктуру"
                            },
                            {
                                "target_lang_word": "деплоить",
                                "target_lang_sense_clarification": "жаргон программистов"
                            },
                            {
                                "target_lang_word": "внедрять",
                                "target_lang_sense_clarification": "систему в эксплуатацию"
                            },
                            {
                                "target_lang_word": "устанавливать",
                                "target_lang_sense_clarification": "обновления или программы"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9bfb4c67-57f8-3752-81f7-f05e2f4b5a40",
                    "sense_definition": "An instance of a <w>deployment</w>, especially in software development.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Rolling back the bad <w>deploy</w> will usually solve the immediate production problem for the users.",
                            "target_lang_translations": {
                                "ru": "Откат неудачного <w>деплоя</w> обычно решает текущую проблему в рабочей среде для пользователей."
                            }
                        },
                        {
                            "text": "The team scheduled a late-night <w>deploy</w> to minimize the impact on website traffic.",
                            "target_lang_translations": {
                                "ru": "Команда запланировала ночное <w>развёртывание</w>, чтобы минимизировать влияние на трафик сайта."
                            }
                        }
                    ],
                    "synonyms": [
                        "deployment",
                        "release",
                        "launch"
                    ],
                    "common_phrases": [
                        "failed deploy",
                        "production deploy"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "technical jargon"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Экземпляр или процесс развертывания, особенно в разработке программного обеспечения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "деплой",
