                                        "glosses": [
                                            "A genre of slow electronica combining elements of hip hop with melodic, often psychedelic, sounds and impressionistic lyrics."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
