                                    },
                                    {
                                        "sense_id": "6b2f7111-81b0-3143-b742-92453fde570a",
                                        "entry_id": "868e301a-875a-3efc-b792-9f94e0b3ad14",
                                        "glosses": [
                                            "La condición de tener menos que lo deseable de ingredientes, cualidades, valores, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "195c4679-ac26-43bf-896e-292d9f06e831",
                                                "sense_id": "6b2f7111-81b0-3143-b742-92453fde570a",
                                                "text": "La mayoría de los autores concuerdan en señalar que la pobreza de vocabulario en los sordos se relaciona con el grado de pérdida auditiva"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "5082e919-e206-39dd-a255-c24993745ab2",
