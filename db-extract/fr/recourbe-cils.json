        "fr-extract.jsonl": [
            {
                "entry_id": "375bd8bb-372f-3824-8d3f-d44437b2b874",
                "word": "recourbe-cils",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e42765fe-b2cc-301d-9527-0927cb846d97",
                        "entry_id": "375bd8bb-372f-3824-8d3f-d44437b2b874",
                        "glosses": [
                            "Sorte de petite pince destinée à recourber les cils."
                        ],
                        "tags": [
                            "Cosmétologie"
                        ],
                        "examples": [
                            {
                                "example_id": "cbe35b74-82af-4f83-93ca-8d4d5e0a0edc",
                                "sense_id": "e42765fe-b2cc-301d-9527-0927cb846d97",
                                "text": "Si vous êtes pressée et si vous voulez vous rafraîchir en quelques secondes, suivez ce conseil: quelques gouttes pour les yeux, du mascara, un recourbe-cils et un gloss."
                            },
                            {
                                "example_id": "8ebfd840-0ff2-482f-80d7-d23ce35f8044",
                                "sense_id": "e42765fe-b2cc-301d-9527-0927cb846d97",
                                "text": "À moins d'avoir les cils très raides et courts, le recourbe-cils suffira souvent à obtenir le même résultat glam."
                            },
                            {
                                "example_id": "4429fb01-5ada-4fef-9bee-4b05afea8a2f",
                                "sense_id": "e42765fe-b2cc-301d-9527-0927cb846d97",
                                "text": "J'attrapai le mascara et l'eye-liner - seuls instruments que j'utilisais parfois - et allai jeter un coup d'œil dans la salle de bains des parents. Maman avait un recourbe-cils, ça ferait sans doute plus professionnel."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "29fb1b78-e85d-4fb0-a891-380bda970d16",
                        "source_entry_id": "375bd8bb-372f-3824-8d3f-d44437b2b874",
                        "source_sense_id": "e42765fe-b2cc-301d-9527-0927cb846d97",
                        "target_lang_word": "Wimpernzange",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wimpernzange",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a111222f-9643-3a44-bfce-d9299adc6bdc",
                                        "entry_id": "bce16268-dd45-37cf-a8b8-571caf28405e",
                                        "glosses": [
                                            "ein Gerät, um die Wimpern stärker zu krümmen, als sie von Natur aus gekrümmt sind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd4a0536-08ca-4de2-b9fa-78032e9fb343",
                                                "sense_id": "a111222f-9643-3a44-bfce-d9299adc6bdc",
                                                "text": "„Mascara betont die Wimpern, indem es sie länger und voluminöser erscheinen lässt, die Wimpernzange zaubert einen verführerischen Schwung hinein, der Millionizer macht aus einer Wimper eine Million davon und künstliche Wimpern (Fake Lashes) erlauben Formen, wie sie trotz aller Hilfsmittel mit der natürlichen Ausstattung nicht zu erreichen sind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4f1f2739-3c48-4834-bf3a-4be1e05ece11",
                        "source_entry_id": "375bd8bb-372f-3824-8d3f-d44437b2b874",
                        "source_sense_id": "e42765fe-b2cc-301d-9527-0927cb846d97",
                        "target_lang_word": "eyelash curler",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eyelash curler",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fa2cf5bf-0383-37f9-a040-53f2eb90e921",
                                        "entry_id": "1f04e934-444c-3bcf-9472-1d3132e660a8",
                                        "glosses": [
                                            "A tool used to curl the eyelashes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a15d31e-bfd9-4b59-954b-24f6eb7c21c8",
                                                "sense_id": "fa2cf5bf-0383-37f9-a040-53f2eb90e921",
                                                "text": "Curling the lashes with an eyelash curler prior to mascara application will make the eyes seem more wide open and bright."
                                            },
                                            {
                                                "example_id": "e4a3e780-2543-456e-ac39-22e56184d3cc",
                                                "sense_id": "fa2cf5bf-0383-37f9-a040-53f2eb90e921",
                                                "text": "She instructs: “Then you’re going to put [the eyelash curler] down and use your phone … to search up what’s happening in China"
                                            },
                                            {
                                                "example_id": "1608ae84-1bbe-4cfb-8f79-ceffc25f68a6",
                                                "sense_id": "fa2cf5bf-0383-37f9-a040-53f2eb90e921",
                                                "text": "I pick up my hairbrush, my eyelash curler, my mascara: my arsenal of weapons, my quiver."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "36495d7d-e66f-433e-b653-a2eb0f6bc7ae",
                        "source_entry_id": "375bd8bb-372f-3824-8d3f-d44437b2b874",
                        "source_sense_id": "e42765fe-b2cc-301d-9527-0927cb846d97",
                        "target_lang_word": "eyelash-curler",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eyelash-curler",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f1fa239a-be57-3578-a2c5-425c0aeb52e5",
                                        "entry_id": "61ba6608-d545-3581-ad43-3ce583a75c89",
                                        "glosses": [
                                            "Alternative form of eyelash curler."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e3a2ce6-c916-4d7f-83ed-b8e3296cb304",
                                                "sense_id": "f1fa239a-be57-3578-a2c5-425c0aeb52e5",
                                                "text": "In Your Face: There is nothing coy about Dave Quick’s motorized assemblages at Ovsey Gallery. With the push of a button or the turn of a handle, they come at you. Toy Christmas trees rattle and quake. Eyelash-curlers snap their metallic jaws."
                                            },
                                            {
                                                "example_id": "785f9bbb-bb44-4e0e-b8d4-cc5fe471ff50",
                                                "sense_id": "f1fa239a-be57-3578-a2c5-425c0aeb52e5",
                                                "text": "Peter Sendall, from Newcastle, says that he and his family have far more appliances even than the 47 listed in the report, including electric eyelash-curlers for his two daughters."
                                            },
                                            {
                                                "example_id": "98ef9e3f-f68c-4314-851d-268e0c544f9d",
                                                "sense_id": "f1fa239a-be57-3578-a2c5-425c0aeb52e5",
                                                "text": "Asked whether she [Arianna Huffington] had any remaining professional fears, Huffington responded, “I am afraid of curling my eyelashes. You know, of that thing you put on your eyelashes to curl them. I am afraid it will blind me.” […] Eyelash-curlers aside, her remaining professional fear ought to be this: Can an intellectual butterfly settle down long enough to make a substantive difference?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
