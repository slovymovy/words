                    {
                        "sense_id": "da93732f-15bf-3bbc-9967-7a8af047458b",
                        "entry_id": "e4aacbd5-a154-39d6-bec0-35281416972a",
                        "glosses": [
                            "…ja z końcówką czasownikową"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4127ecdb-0aa8-4389-b34a-d04160111da0",
                                "sense_id": "da93732f-15bf-3bbc-9967-7a8af047458b",
                                "text": "Jam jest Pan, Bóg twój, który cię wywiódł z ziemi egipskiej, z domu niewoli"
                            },
                            {
                                "example_id": "f819627b-8145-4dcd-a0e4-ef8dbd603601",
                                "sense_id": "da93732f-15bf-3bbc-9967-7a8af047458b",
                                "text": "Jam to widział, a mnie należy wierzyć"
                            },
                            {
                                "example_id": "5a5f97e4-5556-4b21-9228-bfb8727e0921",
                                "sense_id": "da93732f-15bf-3bbc-9967-7a8af047458b",
                                "text": "Ja jestem Dawid, jam jest pasterz – / Błagalną wiodę pieśń, / byś się zmiłować chciał nad Piastem, / byś żniwo zwolił zwieść"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
