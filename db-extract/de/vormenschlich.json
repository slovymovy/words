                "senses": [
                    {
                        "sense_id": "f1e2e675-1944-316c-98f3-21070a38236e",
                        "entry_id": "171b785f-677d-38ea-acbe-cb991dffc7c7",
                        "glosses": [
                            "aus der Zeit vor der Entstehung des Menschen stammend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7dd667ee-724d-441f-8b7c-534de33c5832",
                                "sense_id": "f1e2e675-1944-316c-98f3-21070a38236e",
                                "text": "„Ich wappnete meine Seele, beschwor die Macht des Schlüssels von Xoth und rief den Vater aller Würmer höchstselbst aus seinen schwarzen, stinkenden Tunneln, den unsterblichen, fauligen Ubb, Führer und Urahn der gefürchteten Yuggya, der entsetzlichen vormenschlichen Diener meines Gottes, die sich einst im Schlamm zu Seinen Füßen wanden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6bf83e3f-7193-43e1-a23c-cdb05297fb30",
