                        "entry_id": "bd090bff-d832-3424-a14c-b06f931fa7a2",
                        "glosses": [
                            "A termite colony."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31910f86-5d3f-4781-ae40-285e12706684",
                                "sense_id": "b45fbd4a-e5b6-3f51-82de-be6f7bf6df2c",
                                "text": "When an opening is made in a termitarium, soldiers crowd into the breach, and either stop the invaders or fill the breach with their termite dead."
                            },
                            {
                                "example_id": "f13713de-b1ba-4e51-ab4f-88ca61ee6c62",
                                "sense_id": "b45fbd4a-e5b6-3f51-82de-be6f7bf6df2c",
                                "text": "The females are winged, but shed all but the stumps of the anterior veins after mating, before entering the termitarium."
                            },
                            {
                                "example_id": "b1c4acba-801f-48ed-9eb0-20f9aa274bc9",
                                "sense_id": "b45fbd4a-e5b6-3f51-82de-be6f7bf6df2c",
                                "text": "Likewise, given time, the initially rather random clay-gathering activity of termites results in a colossal termitarium, thanks to simple innate inclinations such as the preference to deposit one's ball of clay on larger balls of clay."
                            }
                        ]
                    }
                ],
