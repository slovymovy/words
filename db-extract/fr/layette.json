        "fr-extract.jsonl": [
            {
                "entry_id": "081b9a17-37b5-3813-a4ea-411159eb6d1a",
                "word": "layette",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "df76001a-fdf4-4160-a168-0b949254fab8",
                        "entry_id": "081b9a17-37b5-3813-a4ea-411159eb6d1a",
                        "tags": [
                            "plural"
                        ],
                        "form": "layettes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b66f5d15-cbdf-3c05-9762-92014bbd0485",
                        "entry_id": "081b9a17-37b5-3813-a4ea-411159eb6d1a",
                        "glosses": [
                            "Petit coffret de bois mince et léger où l’on serrait des papiers."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53bbc75a-3d9e-421d-8294-15a5b88879f9",
                                "sense_id": "b66f5d15-cbdf-3c05-9762-92014bbd0485",
                                "text": "Ennemi farouche de ses compatriotes, chaque jour, du lever au coucher du soleil, seul en son grenier poudreux, sous le toit de la préfecture, il compulsait furieusement les six cent trente-sept mille layettes qui y étaient entassées, à la seule fin d’y découvrir des anecdotes scandaleuses sur les principales familles du département. Et là, dans l’amas des parchemins gothiques et des papiers timbrés par deux siècles de fiscaux aux armes de six rois, de deux empereurs et de trois républiques, il riait dans la poussière, en soulevant les témoignages, à demi dévorés par les vers et par les souris, des crimes anciens et des fautes expiées."
                            }
                        ]
                    },
                    {
                        "sense_id": "59a37e55-216e-395f-a464-fced9b5d7530",
                        "entry_id": "081b9a17-37b5-3813-a4ea-411159eb6d1a",
                        "glosses": [
                            "Coffre où étaient conservées les archives."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "f678e063-2416-4d05-8cca-2664d20503fa",
                                "sense_id": "59a37e55-216e-395f-a464-fced9b5d7530",
                                "text": "La layette du trésor des chartes du roi."
                            }
                        ]
                    },
                    {
                        "sense_id": "da8a2851-e6e2-30bb-8c1c-4110d57f88bb",
                        "entry_id": "081b9a17-37b5-3813-a4ea-411159eb6d1a",
                        "glosses": [
                            "Coffret ou tiroir d’armoire"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "58065d1c-54b5-37bd-a672-c01ea886c0c4",
                        "entry_id": "081b9a17-37b5-3813-a4ea-411159eb6d1a",
                        "glosses": [
                            "Contenu de ce coffre (linge, langes, maillot etc.) qui sert à vêtir un nouveau-né."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "0edec6b8-eae4-41fd-866f-fc780c211626",
                                "sense_id": "58065d1c-54b5-37bd-a672-c01ea886c0c4",
                                "text": "Préparer, donner une layette, une belle layette."
                            },
                            {
                                "example_id": "afe09e0c-a501-4661-b4fc-b67199018104",
                                "sense_id": "58065d1c-54b5-37bd-a672-c01ea886c0c4",
                                "text": "M. Jules […] m’a donné cinquante francs pour venir à Paris, disant qu’il me ferait passer vingt francs tous les mois pour ma layette et pour mes couches."
                            },
                            {
                                "example_id": "24add4cb-0dad-4933-86a6-15913ef21c6a",
                                "sense_id": "58065d1c-54b5-37bd-a672-c01ea886c0c4",
                                "text": "Elle quitta la fenêtre, elle vint ouvrir la grande armoire de chêne, pour y serrer son travail, resté sur la table. C’était dans cette armoire, si pleine autrefois des manuscrits du docteur, et vide aujourd’hui, qu’elle avait rangé la layette de l’enfant."
                            },
                            {
                                "example_id": "3e1b707b-be52-4fd6-af83-22ac17f411b2",
                                "sense_id": "58065d1c-54b5-37bd-a672-c01ea886c0c4",
                                "text": "Toute la matinée fut employée à improviser une layette et à faire un paquet de linge que Maria, notre bonne, apporta un peu plus tard à la gisante avec du lait et du bouillon […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "0c96a03f-6272-3aeb-90e7-738522fbe77a",
                        "entry_id": "081b9a17-37b5-3813-a4ea-411159eb6d1a",
                        "glosses": [
                            "Qualifie une couleur douce, qui rappelle celles utilisées pour le linge des nourrissons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "744dd97d-0621-43d1-9b60-c1c14d79e5c0",
                                "sense_id": "0c96a03f-6272-3aeb-90e7-738522fbe77a",
                                "text": "Comme toutes les primevères des jardins, celle-ci, couleur layette, aime la mi-ombre, mais tolère le soleil si le sol est frais."
                            }
                        ]
                    }
                ],
