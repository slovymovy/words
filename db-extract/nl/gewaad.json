                    },
                    {
                        "form_id": "58e66ecc-559c-491b-afb2-e1ad590251be",
                        "entry_id": "e138561e-ec45-3030-8e38-5a3efdefdaa3",
                        "tags": [
                            "diminutive",
                            "plural"
                        ],
                        "form": "gewaadjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b299d7d9-d807-3ee1-9517-823116eb2c8c",
                        "entry_id": "e138561e-ec45-3030-8e38-5a3efdefdaa3",
                        "glosses": [
                            "een voornaam en omhullend kledingstuk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b43346fa-dea4-4d98-bca3-19b21291f00f",
                                "sense_id": "b299d7d9-d807-3ee1-9517-823116eb2c8c",
                                "text": "Zij verscheen gehuld in een prachtig gewaad en gesierd met prachtige juwelen."
                            },
                            {
                                "example_id": "2eeaa518-b96a-412f-bd39-15480a0cdf92",
                                "sense_id": "b299d7d9-d807-3ee1-9517-823116eb2c8c",
                                "text": "De soupers aan het hof beginnen me behoorlijk de keel uit te hangen. Niet alleen omdat ze eindeloos duren, of omdat we ons moeten onderwerpen aan de laatste modes zoals bepoederde gezichten, martelend strakke, met edelstenen bezette kapsels als ramshoorns, zijden gewaden waarvan de mouwen zo krap zitten dat het bijna onmogelijk is om een lepel naar onze zorgvuldig gekleurde lippen te brengen... Nee, het ergst zijn de roddels, het kwaadaardige gegons van wespen die hun giftige angels maar al te graag in welke tere huid dan ook steken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "52bf57ad-eb58-4384-a999-1f2921710f7f",
                        "source_entry_id": "e138561e-ec45-3030-8e38-5a3efdefdaa3",
                        "source_sense_id": "b299d7d9-d807-3ee1-9517-823116eb2c8c",
                        "source_sense_description": "een voornaam en omhullend kledingstuk",
                        "target_lang_word": "Gewand",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gewand",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f15280c2-2db5-3229-beba-1e8bba57997f",
                                        "entry_id": "81920484-05f4-3b45-86aa-42a0783e17e4",
                                        "glosses": [
                                            "geschneiderte Materialien (meist Stoff, Leder oder Kunststoffe), die einem Körper als Schutz dienen"
                                        ],
                                        "tags": [
                                            "Austrian German",
                                            "South-German",
                                            "Swiss Standard German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d4ea3a5-9b3e-48be-a767-9f7d789d4e45",
                                                "sense_id": "f15280c2-2db5-3229-beba-1e8bba57997f",
                                                "text": "Nachdem Hans aufgewacht war, zog er sich sein Gewand an."
                                            },
                                            {
                                                "example_id": "c9d00851-00ee-4550-bed9-b71c503c4e81",
                                                "sense_id": "f15280c2-2db5-3229-beba-1e8bba57997f",
                                                "text": "„Er raffte sein Gewand zusammen und setzte sich in die abgewetzte Schulbank.“"
                                            },
                                            {
                                                "example_id": "a0abfdc6-c911-4864-909c-61d6ac8c5928",
                                                "sense_id": "f15280c2-2db5-3229-beba-1e8bba57997f",
                                                "text": "„Ich befürchtete, dass der Diener mich nicht hereinlassen würde, wenn ich im Gewand eines einfachen Seemanns anklopfte, also öffnete ich die Eingangstür ohne Umschweife und ging direkt durch zum Salon, bevor man mich aufhalten konnte.“"
                                            },
                                            {
                                                "example_id": "2fd2208a-2625-4fd8-8313-9e0b44c48544",
                                                "sense_id": "f15280c2-2db5-3229-beba-1e8bba57997f",
                                                "text": "„Sie warf ihnen die Gewänder über den Kopf.“"
                                            },
                                            {
                                                "example_id": "47bafe6c-4978-4349-a8c2-5ee298c30dc0",
                                                "sense_id": "f15280c2-2db5-3229-beba-1e8bba57997f",
                                                "text": "„Selbst beim Schembartlauf steckte unter manchem Gewand das Messer, und so manche Rechnung wurde im Menschentrubel durch einen Dolchstich von hinten beglichen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "dfa56603-2a72-3033-b361-49771e0d7dcb",
                                        "entry_id": "81920484-05f4-3b45-86aa-42a0783e17e4",
                                        "glosses": [
                                            "Kleidung, die besonders prächtig ist oder einem besonderen Anlass dient"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "647c428c-e2c0-4acc-ac18-55ddeb98f0b6",
                                                "sense_id": "dfa56603-2a72-3033-b361-49771e0d7dcb",
                                                "text": "Sheikha Lubna ist wie die Studentinnen von Kopf bis Fuß in das traditionelle schwarze Gewand der Golfaraberinnen gehüllt. Das scheint aber auch ihre einzige Konzession an die Tradition zu sein."
                                            },
                                            {
                                                "example_id": "4b361923-b733-48c5-abd8-5f389a1fcae5",
                                                "sense_id": "dfa56603-2a72-3033-b361-49771e0d7dcb",
                                                "text": "„Auch der Vater des jungen Tishu-Lama trug ein gelb atlassenes Gewand, das mit goldenen Drachen, dem chinesischen Wappen, reich durchwirkt war.“"
                                            },
                                            {
                                                "example_id": "39de4b6b-9c49-4029-88ed-2fb7ec4d57fe",
                                                "sense_id": "dfa56603-2a72-3033-b361-49771e0d7dcb",
                                                "text": "„Sie trug ein mattgelbes Gewand mit Stickereien in Farbtönen von ineinander verblaßtem Blau und Rot.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
