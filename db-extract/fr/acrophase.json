                                        "entry_id": "07b22145-bc4c-37b1-8831-ef169ccafc69",
                                        "glosses": [
                                            "The time period in a cycle during which the cycle crests or peaks, especially the upper part of a sine wave fitted to a measurement of a circadian pattern or other biological rhythm."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d642c60-18cc-4ef9-8c5c-801544a06367",
                                                "sense_id": "8bf56ea4-683b-304e-8c6d-d5eeaeb5f0e3",
                                                "text": "The acrophase of the metabolic process ran from shortly mid-morning until sunset, with the peak amplitude recorded in mid-afternoon."
                                            }
                                        ]
                                    }
