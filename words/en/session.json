{
    "word_family": [
        "sessional",
        "sessionist",
        "intersessional"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "81d79a23-2ca9-3ef8-8451-c55532bc8199",
                    "sense_definition": "A period of time devoted to a particular activity.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "activity_period",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gym offers a morning <w>session</w> for beginners every Tuesday.",
                            "target_lang_translations": {
                                "ru": "Спортзал предлагает утреннее <w>занятие</w> для начинающих каждый вторник."
                            }
                        },
                        {
                            "text": "We had a very productive training <w>session</w> to learn the new software.",
                            "target_lang_translations": {
                                "ru": "У нас была очень продуктивная <w>тренировка</w> по изучению нового программного обеспечения."
                            }
                        }
                    ],
                    "synonyms": [
                        "period",
                        "meeting"
                    ],
                    "common_phrases": [
                        "training session",
                        "recording session",
                        "jam session",
                        "counseling session"
                    ],
                    "target_lang_definitions": {
                        "ru": "Период времени, посвященный определенному виду деятельности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "занятие",
                                "target_lang_sense_clarification": "урок или тренировка"
                            },
                            {
                                "target_lang_word": "сеанс",
                                "target_lang_sense_clarification": "ограниченный по времени период деятельности"
                            },
                            {
                                "target_lang_word": "сессия",
                                "target_lang_sense_clarification": "специализированный период, например, записи или фотосъемки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "05e45738-e5a7-3b6d-8794-13a93381ea7a",
                    "sense_definition": "An official meeting or term of a council, court, or other body to conduct its business.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "official_meeting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The judge announced that the court is now in <w>session</w>.",
                            "target_lang_translations": {
                                "ru": "Судья объявил, что <w>заседание</w> суда началось."
                            }
                        },
                        {
                            "text": "Parliament will hold a special <w>session</w> to discuss the new budget.",
                            "target_lang_translations": {
                                "ru": "Парламент проведет специальную <w>сессию</w> для обсуждения нового бюджета."
                            }
                        }
                    ],
                    "synonyms": [
                        "sitting",
                        "assembly"
                    ],
                    "common_phrases": [
                        "in session",
                        "legislative session",
                        "court session",
                        "emergency session"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальное заседание или срок полномочий совета, суда или другого органа для ведения дел."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заседание",
                                "target_lang_sense_clarification": "собрание членов организации"
                            },
                            {
                                "target_lang_word": "сессия",
                                "target_lang_sense_clarification": "совокупность рабочих заседаний"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "63524658-61c1-3e6d-9d3f-fc44b0c59d19",
                    "sense_definition": "The sequence of interactions between a user and a computer system or server while connected.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Logging out or shutting down the computer will end your <w>session</w>.",
                            "target_lang_translations": {
                                "ru": "Выход из системы или выключение компьютера завершит вашу <w>сессию</w>."
                            }
                        },
                        {
                            "text": "Your login <w>session</w> has expired for security reasons.",
                            "target_lang_translations": {
                                "ru": "Ваш <w>сеанс</w> входа в систему истек по соображениям безопасности."
                            }
                        }
                    ],
                    "common_phrases": [
                        "login session",
                        "user session",
                        "end session"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Последовательность взаимодействий между пользователем и компьютерной системой или сервером во время подключения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сессия",
                                "target_lang_sense_clarification": "в информационных технологиях"
                            },
                            {
                                "target_lang_word": "сеанс",
                                "target_lang_sense_clarification": "период работы в системе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e95a7cda-ab75-3cca-86f4-415ba8ef0422",
                    "sense_definition": "An academic term, semester, or school year.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "education",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The summer <w>session</w> at the university is shorter than the fall term.",
                            "target_lang_translations": {
                                "ru": "Летний <w>семестр</w> в университете короче осеннего."
                            }
                        },
                        {
                            "text": "Students must register for classes before the start of the next academic <w>session</w>.",
                            "target_lang_translations": {
                                "ru": "Студенты должны записаться на занятия до начала следующего <w>учебного года</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "semester",
                        "term"
                    ],
                    "common_phrases": [
                        "academic session",
                        "summer session"
                    ],
                    "target_lang_definitions": {
                        "ru": "Академический семестр или учебный год."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "семестр",
                                "target_lang_sense_clarification": "учебное полугодие"
                            },
                            {
                                "target_lang_word": "учебный период",
                                "target_lang_sense_clarification": "время обучения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "60086781-826e-387d-9777-6f6407339c7e",
                    "sense_definition": "An extended period of drinking, typically consuming beer with low alcohol content.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "drinking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They went for a long <w>session</w> at the pub after the match.",
                            "target_lang_translations": {
                                "ru": "После матча они отправились на долгие <w>посиделки</w> в паб."
                            }
                        },
                        {
                            "text": "He preferred a drinking <w>session</w> with light ales so he could stay out longer.",
                            "target_lang_translations": {
                                "ru": "Он предпочитал <w>выпивать</w> светлый эль, чтобы иметь возможность задержаться подольше."
                            }
                        }
                    ],
                    "common_phrases": [
                        "drinking session"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Длительный период употребления алкоголя, обычно пива с низким содержанием спирта."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "посиделки",
                                "target_lang_sense_clarification": "неформальное общение с выпивкой"
                            },
                            {
                                "target_lang_word": "запой",
                                "target_lang_sense_clarification": "длительное употребление, разг."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ed8bf3de-a213-3763-b9af-782cbb425bd4",
                    "sense_definition": "Any of the three scheduled two-hour playing periods in a game of cricket.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "sport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The morning <w>session</w> was dominated by the bowlers.",
                            "target_lang_translations": {
                                "ru": "В утренней <w>сессии</w> доминировали боулеры."
                            }
                        },
                        {
                            "text": "Rain interrupted the final <w>session</w> of the day's play.",
                            "target_lang_translations": {
                                "ru": "Дождь прервал финальную <w>сессию</w> игрового дня."
                            }
                        }
                    ],
                    "common_phrases": [
                        "morning session",
                        "afternoon session",
                        "evening session"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "cricket"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Любой из трех запланированных двухчасовых игровых периодов в крикете."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сессия",
                                "target_lang_sense_clarification": "игровой период в крикете"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1102c51f-3b0f-3d0b-acc6-4484769a8a17",
                    "sense_definition": "The act of sitting, or the state of being seated.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "posture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She rose from her <w>session</w> on the bench to greet the visitors.",
                            "target_lang_translations": {
                                "ru": "Она поднялась со своего <w>места</w> на скамье, чтобы поприветствовать посетителей."
                            }
                        },
                        {
                            "text": "The ancient text describes his <w>session</w> at the right hand of the king.",
                            "target_lang_translations": {
                                "ru": "Древний текст описывает его <w>пребывание</w> по правую руку от короля."
                            }
                        }
                    ],
                    "synonyms": [
                        "sitting"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт сидения или состояние нахождения в сидячем положении."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сидение",
                                "target_lang_sense_clarification": "нахождение в сидячем положении"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "33dbf953-8da5-35c6-82e8-5c3dae9cb5e4",
                    "sense_definition": "To hold or participate in a jam session with other musicians.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "music_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The drummer has <w>sessioned</w> on all kinds of records throughout his career.",
                            "target_lang_translations": {
                                "ru": "За свою карьеру барабанщик <w>участвовал в записи</w> самых разных пластинок."
                            }
                        },
                        {
                            "text": "They spent the whole weekend <w>sessioning</w> in the basement studio.",
                            "target_lang_translations": {
                                "ru": "Они провели все выходные, <w>джемя</w> в студии в подвале."
                            }
                        }
                    ],
                    "synonyms": [
                        "jam"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "music industry jargon"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Проводить или участвовать в джем-сейшене с другими музыкантами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "джемить",
                                "target_lang_sense_clarification": "участвовать в импровизации"
                            },
                            {
                                "target_lang_word": "сессионно играть",
                                "target_lang_sense_clarification": "выступать в качестве приглашенного музыканта"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
