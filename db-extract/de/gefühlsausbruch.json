                "senses": [
                    {
                        "sense_id": "a61e596e-291e-317a-bc44-f19cb5754bf5",
                        "entry_id": "7b00e2d5-004e-32cc-a399-f61d61056ef6",
                        "glosses": [
                            "plötzliche, oft heftige Entladung aufgestauter Gefühle"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0657d722-e4f8-43e6-a2d2-6bc558d8982c",
                                "sense_id": "a61e596e-291e-317a-bc44-f19cb5754bf5",
                                "text": "Die gelesene Nachricht führte bei Annemarie zu heftigen Gefühlsausbrüchen, sodass sie weinte und untröstbar zu sein schien."
                            },
                            {
                                "example_id": "fe38d97e-83da-4f6c-9704-2a26eb919a9f",
                                "sense_id": "a61e596e-291e-317a-bc44-f19cb5754bf5",
                                "text": "Mit abnehmender körperlicher Leistungsfähigkeit ging auch bei Federer eine deutliche Zunahme der Gefühlsausbrüche einher."
                            },
                            {
                                "example_id": "ced390b1-d73f-460c-b4a6-cf440e4b1def",
                                "sense_id": "a61e596e-291e-317a-bc44-f19cb5754bf5",
                                "text": "„Er versuchte sich zu fassen, war aber nicht fähig, diesen heftigen Gefühlsausbruch zu bremsen.“"
                            },
                            {
                                "example_id": "949ede7f-5ceb-4c7e-81de-053d2e0dc4a2",
                                "sense_id": "a61e596e-291e-317a-bc44-f19cb5754bf5",
                                "text": "„Das war ein törichter Gefühlsausbruch ihrerseits.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
