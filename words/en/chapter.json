{
    "word_family": [
        "chapterhouse",
        "subchapter"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0ac4b971-c1b9-327c-b331-ce9a25adb024",
                    "sense_definition": "One of the main sections into which a published work is divided, especially a book.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "book_division",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author decided to end the <w>chapter</w> with a surprising cliffhanger.",
                            "target_lang_translations": {
                                "ru": "Автор решил закончить <w>главу</w> неожиданным поворотом сюжета."
                            }
                        },
                        {
                            "text": "I am currently reading the final <w>chapter</w> of this fascinating biography.",
                            "target_lang_translations": {
                                "ru": "Сейчас я читаю последнюю <w>главу</w> этой увлекательной биографии."
                            }
                        }
                    ],
                    "synonyms": [
                        "ch.",
                        "chpt."
                    ],
                    "common_phrases": [
                        "final chapter",
                        "opening chapter",
                        "next chapter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Одна из основных частей, на которые делится опубликованное произведение, особенно книга."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "глава",
                                "target_lang_sense_clarification": "раздел книги"
                            },
                            {
                                "target_lang_word": "раздел",
                                "target_lang_sense_clarification": "структурная единица текста"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8e44e34b-d0d7-3e2e-bffd-ddce61db6fb0",
                    "sense_definition": "An administrative division of an organization, usually local to a specific area.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "organization_unit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local <w>chapter</w> of the Red Cross is organizing a blood drive next week.",
                            "target_lang_translations": {
                                "ru": "Местное <w>отделение</w> Красного Креста организует сбор крови на следующей неделе."
                            }
                        },
                        {
                            "text": "She was elected president of the university <w>chapter</w> of the honor society.",
                            "target_lang_translations": {
                                "ru": "Её избрали президентом университетского <w>филиала</w> почетного общества."
                            }
                        }
                    ],
                    "synonyms": [
                        "capitule",
                        "ch."
                    ],
                    "common_phrases": [
                        "local chapter",
                        "regional chapter",
                        "student chapter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Административное подразделение организации, обычно местное в определенном районе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отделение",
                                "target_lang_sense_clarification": "местное подразделение организации"
                            },
                            {
                                "target_lang_word": "филиал",
                                "target_lang_sense_clarification": "самостоятельное подразделение компании"
                            },
                            {
                                "target_lang_word": "ячейка",
                                "target_lang_sense_clarification": "первичная организация"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b1fa3b17-e01d-3a0d-9bab-0ee207a273d8",
                    "sense_definition": "A distinct period or sequence of events in history or a person's life.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "time_period",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Moving to a new city felt like starting a new <w>chapter</w> in her life.",
                            "target_lang_translations": {
                                "ru": "Переезд в новый город казался началом новой <w>главы</w> в её жизни."
                            }
                        },
                        {
                            "text": "The treaty marked the end of a dark <w>chapter</w> in the nation's history.",
                            "target_lang_translations": {
                                "ru": "Договор ознаменовал конец мрачной <w>главы</w> в истории страны."
                            }
                        }
                    ],
                    "common_phrases": [
                        "new chapter",
                        "dark chapter",
                        "closing chapter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отдельный период или последовательность событий в истории или жизни человека."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "глава",
                                "target_lang_sense_clarification": "этап или период жизни"
                            },
                            {
                                "target_lang_word": "этап",
                                "target_lang_sense_clarification": "ступень развития"
                            },
                            {
                                "target_lang_word": "страница",
                                "target_lang_sense_clarification": "переносное значение для истории"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0c22246d-e05c-3b04-8a9f-55ddb07282bb",
                    "sense_definition": "An assembly of monks or other clergymen connected with a cathedral or religious order.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "religious_body",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cathedral <w>chapter</w> met to discuss the maintenance of the historic building.",
                            "target_lang_translations": {
                                "ru": "Соборный <w>капитул</w> собрался, чтобы обсудить содержание исторического здания."
                            }
                        },
                        {
                            "text": "Decisions regarding the monastery were made during the daily <w>chapter</w> meeting.",
                            "target_lang_translations": {
                                "ru": "Решения относительно монастыря принимались во время ежедневного собрания <w>капитула</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cathedral chapter",
                        "general chapter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Собрание монахов или других священнослужителей, связанных с собором или религиозным орденом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "капитул",
                                "target_lang_sense_clarification": "коллегия духовных лиц"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "41e7e36d-6a41-396a-84e7-565ec900ee78",
                    "sense_definition": "To divide a text or work into chapters.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "organize_text",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The editor suggested that the author <w>chapter</w> the manuscript more logically.",
                            "target_lang_translations": {
                                "ru": "Редактор предложил автору более логично <w>разбить</w> рукопись <w>на главы</w>."
                            }
                        },
                        {
                            "text": "It is difficult to <w>chapter</w> a long narrative without losing the flow of the story.",
                            "target_lang_translations": {
                                "ru": "Трудно <w>делить на главы</w> длинное повествование, не теряя при этом плавности рассказа."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Разделять текст или произведение на главы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "делить на главы",
                                "target_lang_sense_clarification": "структурировать текст"
                            },
                            {
                                "target_lang_word": "разбивать на главы",
                                "target_lang_sense_clarification": "разделять рукопись"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a8963032-a42f-3f53-bf51-4f65565ff906",
                    "sense_definition": "To use administrative procedures to remove someone from a service, especially the military.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "administrative_removal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The commander threatened to <w>chapter</w> him out of the army for repeated misconduct.",
                            "target_lang_translations": {
                                "ru": "Командир пригрозил <w>уволить</w> его из армии за неоднократные нарушения дисциплины."
                            }
                        },
                        {
                            "text": "They will <w>chapter</w> you out if you fail to meet the physical requirements.",
                            "target_lang_translations": {
                                "ru": "Тебя <w>комиссуют</w>, если ты не будешь соответствовать физическим требованиям."
                            }
                        }
                    ],
                    "common_phrases": [
                        "chapter out"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "military slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Использовать административные процедуры для увольнения кого-либо со службы, особенно из армии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "комиссовать",
                                "target_lang_sense_clarification": "увольнять по административным причинам"
                            },
                            {
                                "target_lang_word": "увольнять",
                                "target_lang_sense_clarification": "отстранять от службы"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}