        "fr-extract.jsonl": [
            {
                "entry_id": "82bf897a-3cc1-348c-9bf8-f002ac52dc7a",
                "word": "incolore",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "81f7ee04-5a90-4653-b32b-0c14074b69f1",
                        "entry_id": "82bf897a-3cc1-348c-9bf8-f002ac52dc7a",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "incolores"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b2f8d6c5-53d6-3233-baa6-2bd55536bf3a",
                        "entry_id": "82bf897a-3cc1-348c-9bf8-f002ac52dc7a",
                        "glosses": [
                            "Qui n’est pas coloré."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "257d42a4-c46a-4a5d-aacf-d0e00ffe1c6c",
                                "sense_id": "b2f8d6c5-53d6-3233-baa6-2bd55536bf3a",
                                "text": "COULEUR incolore, violet, pourpre, vert, jaune, orangé, rose, rose-orangé (« Padparadscha »), noir (étoilé), parfois polychrome ou dichroïque"
                            },
                            {
                                "example_id": "80617cbe-6a85-4c4b-9655-2a9558b59bfb",
                                "sense_id": "b2f8d6c5-53d6-3233-baa6-2bd55536bf3a",
                                "text": "Au fond de la place, la butte se dresse ravinée, couverte d’une herbe lépreuse, fanée comme du velours râpé, jaunâtre ou plutôt incolore."
                            }
                        ]
                    },
                    {
                        "sense_id": "e0933d81-dd2d-37df-9081-07580294bf15",
                        "entry_id": "82bf897a-3cc1-348c-9bf8-f002ac52dc7a",
                        "glosses": [
                            "Sans éclat."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "45397a48-b1a2-4d95-83e2-614441a17574",
                                "sense_id": "e0933d81-dd2d-37df-9081-07580294bf15",
                                "text": "Les poëtes académiques du XVIIᵉ et du XIIIᵉ siècle n'auraient pas plus compris de telles inspirations que les paysans n'eussent admiré leurs odes, leurs épîtres et leurs poésies fugitives, si incolores, si gourmées."
                            },
                            {
                                "example_id": "227925ba-095c-4ab6-87ac-81a843336e7a",
                                "sense_id": "e0933d81-dd2d-37df-9081-07580294bf15",
                                "text": "En résumé donc la définition que l'auteur donne de l'usure, — « l'accaparement subreptice, au nom du capital, de la partie des bénéfices destinée à rémunérer soit les autres parties du capital, soit le travail » — est aussi vague, aussi incolore que toutes les définitions hasardées par d'autres écrivains."
                            },
                            {
                                "example_id": "1596ef9d-7849-47f7-8f77-3df12d263ca0",
                                "sense_id": "e0933d81-dd2d-37df-9081-07580294bf15",
                                "text": "– Madame Donis est jeune aussi, belle, très belle, passionnée, mariée à un homme plein de qualités, cela est certain, mais de ces qualités incolores qui constituent le genre « bon mari »."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0e8639d4-8fd6-4de5-a8b5-23f060399e9d",
                        "source_entry_id": "82bf897a-3cc1-348c-9bf8-f002ac52dc7a",
                        "target_lang_word": "farblos",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "farblos",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0e477b35-e9e8-3ab2-aad5-9150a1e09576",
                                        "entry_id": "89163ad0-b231-3cf2-b18b-200bed4c78ee",
                                        "glosses": [
                                            "ohne Farbe"
                                        ],
                                        "tags": [
                                            "ohne Steigerung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b3b25e1-45d2-4954-8216-5b5ff99ff7aa",
                                                "sense_id": "0e477b35-e9e8-3ab2-aad5-9150a1e09576",
                                                "text": "Das Holz wird mit farblosem Lack überzogen."
                                            },
                                            {
                                                "example_id": "1d547c97-5443-45cf-8f7e-182e4b261958",
                                                "sense_id": "0e477b35-e9e8-3ab2-aad5-9150a1e09576",
                                                "text": "Wasser ist eine farblose Flüssigkeit."
                                            },
                                            {
                                                "example_id": "4cd67532-6dbf-4f3d-b35a-a20513a566ad",
                                                "sense_id": "0e477b35-e9e8-3ab2-aad5-9150a1e09576",
                                                "text": "[Methan:] „Die Erdatmosphäre enthält natürlicherweise eine kleine Menge des farb- und geruchlosen Gases – viel weniger als CO2.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "75494bf0-de99-3f02-9402-44b7be89cea0",
                                        "entry_id": "89163ad0-b231-3cf2-b18b-200bed4c78ee",
                                        "glosses": [
                                            "blass, ohne Reiz, Stimmung, Liebe oder Ähnliches"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1598a65d-82e9-4688-818e-f2893e7fbaf6",
                                                "sense_id": "75494bf0-de99-3f02-9402-44b7be89cea0",
                                                "text": "Die Ballettaufführung war farbloser als jemals zuvor."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "05c9e5fd-f165-41f3-a3e6-f27c6fec4a63",
                        "source_entry_id": "82bf897a-3cc1-348c-9bf8-f002ac52dc7a",
                        "target_lang_word": "colourless",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "colourless",
