        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "42e02458-c79d-3192-a25e-475af7a42a80",
                    "sense_definition": "zijn positie verdedigen door te verwijzen naar een bestaande regel, wet of recht",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "juridisch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De verdachte wilde zich op zijn zwijgrecht <w>beroepen</w> tijdens het verhoor.",
                            "target_lang_translations": {
                                "en": "The suspect wanted to <w>invoke</w> his right to remain silent during the interrogation."
                            }
                        },
                        {
                            "text": "Hij <w>beriep</w> zich op de wet op vrije nieuwsgaring om de informatie te verkrijgen.",
                            "target_lang_translations": {
                                "en": "He <w>appealed</w> to the law on free news gathering to obtain the information."
                            }
                        }
                    ],
                    "synonyms": [
                        "refereren",
                        "verwijzen"
                    ],
                    "common_phrases": [
                        "zich beroepen op",
                        "op de wet beroepen"
                    ],
                    "target_lang_definitions": {
                        "en": "to defend one's position by referring to an existing rule, law, or right"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "invoke",
                                "target_lang_sense_clarification": "to cite a law or right as a basis for an action"
                            },
                            {
                                "target_lang_word": "appeal to",
                                "target_lang_sense_clarification": "to refer to a rule or authority"
                            },
                            {
                                "target_lang_word": "justify",
                                "target_lang_sense_clarification": "to provide a legal explanation for one's actions"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5dc9cf22-6db0-3237-b33f-efa39273946a",
                    "sense_definition": "iemand officieel vragen om predikant of voorganger van een kerkelijke gemeente te worden",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "religie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kerkenraad besloot om de jonge predikant naar hun gemeente te <w>beroepen</w>.",
                            "target_lang_translations": {
                                "en": "The church council decided to <w>call</w> the young minister to their congregation."
                            }
                        },
                        {
                            "text": "Men <w>beriep</w> hem het volgende jaar in Kampen voor de openstaande vacature.",
                            "target_lang_translations": {
                                "en": "He was <w>called</w> to Kampen the following year for the open vacancy."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een predikant beroepen"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "religieuze context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to officially ask someone to become a minister or pastor of a church congregation"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "call",
                                "target_lang_sense_clarification": "to invite a minister to lead a congregation"
