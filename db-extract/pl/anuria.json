                "senses": [
                    {
                        "sense_id": "789e5d64-2b8d-385e-a73a-1d1aef678876",
                        "entry_id": "c0d74f5d-361e-3a4a-a56a-55855be96e91",
                        "glosses": [
                            "zob. bezmocz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1868b48f-6782-4673-ab58-4cb1bdb7d6eb",
                                "sense_id": "789e5d64-2b8d-385e-a73a-1d1aef678876",
                                "text": "… u mężczyzny miało miejsce \"uogólnione zakażenie bakteryjne zakończone wstrząsem z obrazem uszkodzeń wielonarządowych — układ krążenia, oddechowy, nerek z anurią\"."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f70ed6bc-49c6-4887-9965-0c86e63625f1",
                        "source_entry_id": "c0d74f5d-361e-3a4a-a56a-55855be96e91",
                        "source_sense_id": "789e5d64-2b8d-385e-a73a-1d1aef678876",
                        "target_lang_word": "anuria",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anuria",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c49a0844-898e-3ea1-a054-daa7ea7445fb",
                                        "entry_id": "dbcd7867-b2bc-3f88-a54c-4d1c6f281008",
                                        "glosses": [
                                            "A condition in which the kidneys do not produce urine."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b335b219-10f0-4ced-9354-31afa041b02a",
                                                "sense_id": "c49a0844-898e-3ea1-a054-daa7ea7445fb",
                                                "text": "Clinically defined as urine output of less than 100 ml in 24 hours, anuria indicates either urinary tract obstruction or acute renal failure due to various mechanisms.[…]Anuria is rare; even with renal failure, the kidneys usually produce at least 75 ml of urine daily."
                                            },
                                            {
                                                "example_id": "6de2ab92-fd47-4311-8a92-c4b8e253ba01",
                                                "sense_id": "c49a0844-898e-3ea1-a054-daa7ea7445fb",
                                                "text": "Changes in urinary pattern such as polyuria, oliguria, anuria, enuresis, and excessive thirst can be associated with tubular dysfunction."
                                            },
                                            {
                                                "example_id": "85f2bf4e-3f2a-4b5e-a94c-b5fea2c0ea9e",
                                                "sense_id": "c49a0844-898e-3ea1-a054-daa7ea7445fb",
                                                "text": "It goes without saying, therefore, that obstructive anuria can occur only if the outflow from both kidneys or from the only functioning kidney is obstructed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
