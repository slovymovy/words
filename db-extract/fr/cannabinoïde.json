                                                "example_id": "679cb658-683b-4927-a1d0-13f13fd5eb7f",
                                                "sense_id": "6c6454a0-27e8-33b6-ba13-c3612b5d4bc2",
                                                "text": "Similar in chemical structure to cannabis, the cannabinoids made by our bodies surge in number during pleasant activities, such as orgasms, and also when we run, studies show."
                                            }
