                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "787b2547-3570-4b64-a6d8-05b6b26a4af0",
                                                "sense_id": "9602d8ad-4c49-3589-9ae8-6ba90ee7e3c5",
                                                "text": "De hofdansen zijn merkwaardig, er is een ganzenrace in slow-motion: het potsierlijke van de pruikentijd buit hij uit tot in het extreme."
                                            }
