            "senses": [
                {
                    "sense_id": "937d44a9-6695-37b9-90ec-318a6cdf78bd",
                    "sense_definition": "Iets gedetailleerd en nauwkeurig onderzoeken om te begrijpen hoe het in elkaar zit.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We moeten dit probleem nauwkeurig <w>analyseren</w> voordat we een oplossing kunnen vinden.",
                            "target_lang_translations": {
                                "ru": "Мы должны тщательно <w>проанализировать</w> эту проблему, прежде чем сможем найти решение.",
                                "en": "We must <w>analyze</w> this problem carefully before we can find a solution.",
                                "zh": "在找到解决方案之前，我们必须仔细<w>分析</w>这个问题。"
                            }
                        },
                        {
                            "text": "De wetenschapper <w>analyseert</w> de resultaten van het onderzoek in het laboratorium.",
                            "target_lang_translations": {
                                "ru": "Ученый <w>анализирует</w> результаты исследования в лаборатории.",
                                "en": "The scientist <w>analyzes</w> the results of the research in the laboratory.",
                                "zh": "科学家正在实验室里<w>分析</w>研究结果。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ontleden",
                        "onderzoeken"
                    ],
                    "common_phrases": [
                        "gegevens analyseren",
                        "een probleem analyseren",
                        "de situatie analyseren"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подробно и тщательно исследовать что-либо, чтобы понять его суть или устройство.",
                        "en": "To examine something in detail to understand its structure or nature.",
                        "zh": "对某事物进行详细而精确的研究，以了解其构成或本质。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "анализировать",
                                "target_lang_sense_clarification": "общий смысл"
                            },
