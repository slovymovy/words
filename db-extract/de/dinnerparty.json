                ],
                "senses": [
                    {
                        "sense_id": "1164f2be-ec5c-37b4-bc55-1dc927d22e6c",
                        "entry_id": "51cf5ad9-50b4-3053-b722-74c3dd5ae717",
                        "glosses": [
                            "Party, die ein Abendessen beinhaltet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce335cad-0634-48eb-aaae-f4265b82020a",
                                "sense_id": "1164f2be-ec5c-37b4-bc55-1dc927d22e6c",
                                "text": "„Tammy und Tony warten vor den Schranken von Eagle Hills, einer geschlossenen Wohnanlage, sie reden nicht miteinander und sind zehn Minuten verspätet für eine Dinnerparty.“"
                            },
                            {
                                "example_id": "866631f8-37d5-4e5a-859b-b85db253854d",
                                "sense_id": "1164f2be-ec5c-37b4-bc55-1dc927d22e6c",
                                "text": "„Es gehört zu meinem Job, mir das geplante Menü für die Dinnerparty heute Abend vorher anzusehen.“"
                            },
                            {
                                "example_id": "13f88596-324a-4352-84f0-de5e9b0be470",
                                "sense_id": "1164f2be-ec5c-37b4-bc55-1dc927d22e6c",
                                "text": "„Während der obligatorischen Dinnerpartys oder wenn Gäste zu Besuch kamen, sollte ich ihnen das Baby überlassen, aber ansonsten waren sie beide dafür viel zu beschäftigt.“"
                            },
                            {
                                "example_id": "bbbdb7a3-282f-45db-a422-6a69fa06ff62",
                                "sense_id": "1164f2be-ec5c-37b4-bc55-1dc927d22e6c",
                                "text": "„Sylvia und Adrienne gingen öfter denn je zu Dinnerpartys und Lesungen, Konzerten und Vorträgen.“"
                            },
                            {
                                "example_id": "9bb2c912-1bb3-4220-9fba-a9600c0b9e6d",
                                "sense_id": "1164f2be-ec5c-37b4-bc55-1dc927d22e6c",
                                "text": "„Beispielsweise hatte Chaim Weizmann im März 1918 bei einer Dinnerparty in Jerusalem mehreren prominenten Arabern gesagt, sie sollten »verräterischen Unterstellungen, dass die Zionisten nach politischer Macht strebten, keinen Glauben schenken«, aber die meisten wussten, dass solche Behauptungen nur eine täuschende Fassade waren.“"
                            },
                            {
                                "example_id": "56828cc1-7af7-46e2-ae5a-c01e7e265261",
                                "sense_id": "1164f2be-ec5c-37b4-bc55-1dc927d22e6c",
                                "text": "„Die Hälfte der Strecke haben sie durch Fleißarbeit geschafft: Garvey und Kincaid haben jedes Detail von Fraziers Aussage geprüft und dabei unter anderem festgestellt, dass das Alibi mit der Dinnerparty nicht viel taugt.“"
                            },
                            {
                                "example_id": "435c6bd8-cb29-4a11-9804-d9994ae9d2be",
                                "sense_id": "1164f2be-ec5c-37b4-bc55-1dc927d22e6c",
                                "text": "„In Paris, bei einer exklusiven Dinnerparty auf der obersten Etage des Eiffelturms, bekam Penny die Gelegenheit, Alouette D'Ambrosia persönlich kennenzulernen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
