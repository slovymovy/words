                    "frequency": "VeryLow",
                    "semantic_group_id": "grammatica",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In oude steden zie je vaak nog historische <w>wagen</w> waar vroeger goederen werden gewogen.",
                            "target_lang_translations": {
                                "en": "In old cities, you often still see historical <w>weighing houses</w> where goods used to be weighed."
                            }
                        },
                        {
                            "text": "De architect bestudeerde de verschillende <w>wagen</w> in de provincie Utrecht.",
                            "target_lang_translations": {
                                "en": "The architect studied the various <w>weighing houses</w> in the province of Utrecht."
                            }
                        }
                    ],
                    "target_lang_definitions": {
