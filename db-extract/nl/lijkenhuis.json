                                "target_senses": [
                                    {
                                        "sense_id": "53c789d0-fb63-32f4-8a72-503892a57ac7",
                                        "entry_id": "8980bf54-d207-37f6-bddf-d83b0b32cd21",
                                        "glosses": [
                                            "Gebäude auf dem Friedhof, in dem der Sarg einer/eines Verstorbenen vor der Beerdigung aufgebahrt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6980d49c-83e8-46b7-9862-e9a5b0ff8f25",
                                                "sense_id": "53c789d0-fb63-32f4-8a72-503892a57ac7",
                                                "text": "„Ohnehin kam er immer öfter nur morgens, um im Schatten hinter der Leichenhalle die Kisten mit den Pflanzen abzustellen.“"
                                            },
                                            {
                                                "example_id": "3672be6c-9ee4-4a56-a9ef-a289ba3e9e24",
                                                "sense_id": "53c789d0-fb63-32f4-8a72-503892a57ac7",
                                                "text": "„Hier in Amerika konnte er sich endlich ohne Sorgen entfalten; niemand wartete am Friedhofsausgang oder an der Tür der Leichenhalle auf ihn, um ihn nach seinem Paß zu fragen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d1f4ea2d-7e56-4c74-8163-530b27a3b844",
