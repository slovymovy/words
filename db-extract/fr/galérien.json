        "fr-extract.jsonl": [
            {
                "entry_id": "8b57aa7b-586f-39bb-a3b1-520990d2567e",
                "word": "galérien",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "461ec8aa-144a-4436-80ac-2c43c04ff7ee",
                        "entry_id": "8b57aa7b-586f-39bb-a3b1-520990d2567e",
                        "tags": [
                            "plural"
                        ],
                        "form": "galériens"
                    },
                    {
                        "form_id": "5922856c-8872-4b3a-9a44-ef5f6ce0a349",
                        "entry_id": "8b57aa7b-586f-39bb-a3b1-520990d2567e",
                        "tags": [
                            "feminine"
                        ],
                        "form": "galérienne"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6038603d-c166-3a18-b098-0ef6994983ed",
                        "entry_id": "8b57aa7b-586f-39bb-a3b1-520990d2567e",
                        "glosses": [
                            "Celui qui était condamné aux galères, forçat."
                        ],
                        "tags": [
                            "Prison"
                        ],
                        "examples": [
                            {
                                "example_id": "22fc1a98-f77a-43c3-91fe-4f6e1c29d569",
                                "sense_id": "6038603d-c166-3a18-b098-0ef6994983ed",
                                "text": "Ne serait-il pas convenable qu’un grand nombre de galériens fussent employés à nettoyer les rues, à en enlever journellement des boues, les immondices, les gravats, les neiges, ainsi que cela se pratique à Berne ?"
                            },
                            {
                                "example_id": "06c4a05c-c320-478e-b1b9-4c09168c6582",
                                "sense_id": "6038603d-c166-3a18-b098-0ef6994983ed",
                                "text": "– Voici. Je m’appelle Jean Valjean. Je suis un galérien. J’ai passé dix-neuf ans au bagne. Je suis libéré depuis quatre jours et en route pour Pontarlier qui est ma destination."
                            }
                        ]
                    },
                    {
                        "sense_id": "cfd68492-1701-3eb8-ae52-a8dc0b5ec207",
                        "entry_id": "8b57aa7b-586f-39bb-a3b1-520990d2567e",
                        "glosses": [
                            "Personne qui galère."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "4eee2e64-56e3-4683-b6e7-09cba4924230",
                                "sense_id": "cfd68492-1701-3eb8-ae52-a8dc0b5ec207",
                                "text": "Allons! Aux rames, galériens… toujours la même vieille routine…"
                            },
                            {
                                "example_id": "e33d0ad8-97e1-41f2-b512-9caf77bad606",
                                "sense_id": "cfd68492-1701-3eb8-ae52-a8dc0b5ec207",
                                "text": "Au cours de leur périple, ces galériens consentants auront notamment à traverser le riveau (petit cours d’eau) qui longe le Parc des sports."
                            },
                            {
                                "example_id": "230c4aae-cc59-4d93-8e32-dd76af6e97ae",
                                "sense_id": "cfd68492-1701-3eb8-ae52-a8dc0b5ec207",
                                "text": "– On te propose d’aller dans un pays que tu ne connais pas, et puis pas n’importe lequel, celui de ta mère, de tes origines, pour rencontrer ta famille et toi... tu préfères rester glandouiller à Versailles Rive-Droite tout l’été comme un gros galérien ! T’es teubé ou tu le fais exprès ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d696dda4-9dd1-4620-9a87-80d00d5e41b7",
                        "source_entry_id": "8b57aa7b-586f-39bb-a3b1-520990d2567e",
                        "target_lang_word": "galley slave",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "galley slave",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a17745fb-88b3-3122-b764-882e0b2de62d",
                                        "entry_id": "0ff0c9c4-6430-31ba-94e2-0bcff2cb05e2",
                                        "glosses": [
                                            "A slave who rows in a galley (type of ship)."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1be3a8dd-30cb-49d3-a4f7-d79beeb740b9",
                                                "sense_id": "a17745fb-88b3-3122-b764-882e0b2de62d",
                                                "text": "\"That is a chain of galley slaves, on the way to the galleys by force of the king's orders.\" \"How by force?\" asked Don Quixote; \"is it possible that the king uses force against anyone?\" \"I do not say that,\" answered Sancho, \"but that these are people condemned for their crimes to serve by force in the king's galleys.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f55c912e-37a4-3248-a4a1-a1135d4f1206",
                                        "entry_id": "0ff0c9c4-6430-31ba-94e2-0bcff2cb05e2",
                                        "glosses": [
                                            "A typesetter (person who arranged type in a galley for printing)."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e147f04b-6a23-4b75-b6a0-98c684ad260f",
                                                "sense_id": "f55c912e-37a4-3248-a4a1-a1135d4f1206",
                                                "text": "The \"galley slaves\" in those days were the genuine article, and by the \"chains that bound them\" were no doubt the original members of the union."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8f93cab8-82db-4705-aacd-7c1acd03540d",
