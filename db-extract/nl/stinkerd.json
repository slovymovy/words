                                    },
                                    {
                                        "sense_id": "6b90c360-467c-3f78-a053-48afd6d1aa91",
                                        "entry_id": "d994463e-c881-33cb-b4f2-fc9093e2f893",
                                        "glosses": [
                                            "der Mensch an sich"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8f69887-4e6f-45af-ad0a-293635f1ef76",
                                                "sense_id": "6b90c360-467c-3f78-a053-48afd6d1aa91",
                                                "text": "Wir armen Drecksäcke müssen am Ende alle sterben."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "a66b3157-09f3-3f41-b00e-5f9f2dc1c76c",
