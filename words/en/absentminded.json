                    "sense_id": "9c85a186-b0b5-34d5-8b3d-7879728be831",
                    "sense_definition": "So lost in thought that one does not notice what is happening around them; forgetful or inattentive.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "inattentive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>absentminded</w> professor frequently misplaced his glasses while they were perched on his head.",
                            "target_lang_translations": {
                                "fr": "Le professeur <w>distrait</w> égarait fréquemment ses lunettes alors qu'elles étaient posées sur sa tête."
                            }
                        },
                        {
                            "text": "She gave an <w>absentminded</w> nod without really listening to what he was saying.",
                            "target_lang_translations": {
                                "fr": "Elle a fait un signe de tête <w>distrait</w> sans vraiment écouter ce qu'il disait."
                            }
                        }
                    ],
                    "synonyms": [
                        "distracted",
                        "forgetful",
                        "inattentive"
                    ],
                    "antonyms": [
                        "attentive",
                        "alert"
                    ],
                    "common_phrases": [
                        "absentminded professor"
                    ],
                    "target_lang_definitions": {
                        "fr": "Tellement absorbé par ses pensées qu'on ne remarque pas ce qui se passe autour de soi ; distrait ou oublieux."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "distrait",
