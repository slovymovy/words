                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6913f4bf-5a96-4b63-a97f-bb13be564b0e",
                        "source_entry_id": "eaccff75-7166-328a-b5f3-b01cc9bf4934",
                        "source_sense_id": "4e5accdb-879c-3053-9fee-477ae47689d9",
                        "source_sense_description": "person regarded as outcaste",
                        "target_lang_word": "dalit",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dalit",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "40ad1c49-c819-345f-ab78-e5ea65d48296",
                                        "entry_id": "6386e0de-47cf-3b7a-9718-aa0d84ac6b95",
                                        "glosses": [
                                            "Intouchable, en Inde."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9fae3c7-38b3-4f45-be0b-3b7f8873103c",
                                                "sense_id": "40ad1c49-c819-345f-ab78-e5ea65d48296",
                                                "text": "Sans compter que Mayawati faisait preuve d’un dévouement baroque, voire carnavalesque pour les opprimés de son État : non seulement elle leur distribuait des dons à tour de bras, mais elle apportait aussi de la dignité à leur statut par le biais d’une campagne de constructions symboliques et d’une statuaire publique qui la plaçait dans une catégorie rare de personnages politiques indiens. Sans doute personne depuis Nehru n’avait montré un tel intérêt pour la mission politique de l’architecture. À la porte de Delhi, où l’on passe dans l’Uttar Pradesh, dans la grande banlieue de Noida, elle a créé un parc grandiose, où vingt-quatre statues gigantesques en grès, des éléphants (symboles de son parti), accompagnant celles de quinze icônes dalits, dont elle-même."
                                            },
                                            {
                                                "example_id": "a02d40dd-c50f-4701-a226-a7fadae64b4b",
                                                "sense_id": "40ad1c49-c819-345f-ab78-e5ea65d48296",
                                                "text": "L’adolescent appartient à la plus basse caste dans le complexe système de stratification sociale en Inde, les dalits ou \"intouchables\"."
                                            },
                                            {
                                                "example_id": "6133f9ff-bdbe-4f1d-a271-58aa41c550b4",
                                                "sense_id": "40ad1c49-c819-345f-ab78-e5ea65d48296",
                                                "text": "Il a été tué en 2007, juste après l’arrivée de Mayawati, la « reine des dalits » à la tête de l’Uttar Pradesh."
                                            },
                                            {
                                                "example_id": "e9e58206-f1d4-4833-b2e8-ff4cca0deff8",
                                                "sense_id": "40ad1c49-c819-345f-ab78-e5ea65d48296",
                                                "text": "Issue de la communauté des dalits (hors-castes), elle (Mayawati Kumari) veut être le porte-parole des plus démunis."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
