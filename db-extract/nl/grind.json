        "nl-extract.jsonl": [
            {
                "entry_id": "ef390fa1-4c95-3e0a-9153-006d9df20b85",
                "word": "grind",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7996bd3c-25e9-3242-9b5e-6408974053f5",
                        "entry_id": "ef390fa1-4c95-3e0a-9153-006d9df20b85",
                        "glosses": [
                            "een erosieproduct, ontstaan uit gesteente"
                        ],
                        "tags": [
                            "materiaalkunde"
                        ],
                        "examples": [
                            {
                                "example_id": "3c63944b-984e-431e-8587-ec95b6595ba5",
                                "sense_id": "7996bd3c-25e9-3242-9b5e-6408974053f5",
                                "text": "Omdat het mij speet dat mijn aankomst zijn rookpauze had verstoord, en omdat het waar was, zei ik hem, terwijl de taxi zich over het grind van ons verwijderde, dat mijn bagage wel even kon wachten, dat ik een lange reis achter de rug had en dat ik ook wel een sigaret zou lusten."
                            },
                            {
                                "example_id": "163135ad-807f-4aac-b810-732ed56cb4ac",
                                "sense_id": "7996bd3c-25e9-3242-9b5e-6408974053f5",
                                "text": "Eerst lag er vrijwel alleen grind, maar nu is er zand toegevoegd en een pletwals strijkt wat oneffenheden weg."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f65774c6-d582-4628-8478-582fc0bab3cf",
                        "source_entry_id": "ef390fa1-4c95-3e0a-9153-006d9df20b85",
                        "source_sense_id": "7996bd3c-25e9-3242-9b5e-6408974053f5",
                        "target_lang_word": "Kies",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kies",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c357716f-54b0-3c1d-8074-eb8b8bd7f376",
                                        "entry_id": "3d91e4e3-56ad-30d2-a46a-d3e26ca46e1d",
                                        "glosses": [
                                            "lose Gesteinsstücke in einer Korngröße von etwa 3 mm bis 30 mm"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "077b1ef8-0942-4c26-8694-ec6e3da4d80a",
                                                "sense_id": "c357716f-54b0-3c1d-8074-eb8b8bd7f376",
                                                "text": "Das Ufer des Flusses besteht aus Kies."
                                            },
                                            {
                                                "example_id": "04ac04e3-3992-40c8-ada7-9dcea1addca7",
                                                "sense_id": "c357716f-54b0-3c1d-8074-eb8b8bd7f376",
                                                "text": "„Der vulkanische Kies ist ein hervorragender Boden, die Besonnung ist kräftig; die Trauben, die hier gelesen werden, ergeben einen sehr wohlduftenden Muskatwein.“"
                                            },
                                            {
                                                "example_id": "b882cd7f-6b2c-47ca-bb79-8730ef7c2c05",
                                                "sense_id": "c357716f-54b0-3c1d-8074-eb8b8bd7f376",
                                                "text": "„Auf dem Nachhauseweg, den Blick auf meine Füße gerichtet, während unter meinen Schuhen Kies, Kopfsteinpflaster und Betonplatten abwechselten, ging mir die Sache mit den beiden wieder und wieder durch den Kopf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "26405d68-3dd1-3973-ad9d-33cbebe7bb57",
                                        "entry_id": "3d91e4e3-56ad-30d2-a46a-d3e26ca46e1d",
                                        "glosses": [
                                            "Baustoff und Bauzuschlagstoff, Filtermaterial aus [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa3d54e8-241d-4c72-ae93-fccf3aba4ae8",
                                                "sense_id": "26405d68-3dd1-3973-ad9d-33cbebe7bb57",
                                                "text": "Der Weg ist aus Kies."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "ca030a22-9ea3-32f8-8394-2943db9f6dee",
                                        "entry_id": "3d91e4e3-56ad-30d2-a46a-d3e26ca46e1d",
                                        "glosses": [
                                            "(bares) Geld"
                                        ],
                                        "tags": [
                                            "casual",
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a6f4801-ada5-4d05-834a-f44c39c3991b",
                                                "sense_id": "ca030a22-9ea3-32f8-8394-2943db9f6dee",
                                                "text": "Wo hast du den Kies versteckt?"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d0ae8711-4e69-4cdf-8093-41673d2a1e31",
                        "source_entry_id": "ef390fa1-4c95-3e0a-9153-006d9df20b85",
                        "source_sense_id": "7996bd3c-25e9-3242-9b5e-6408974053f5",
