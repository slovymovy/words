                                "target_senses": [
                                    {
                                        "sense_id": "fdc5733d-af6e-3f2a-b75f-c9dce4f7c0e6",
                                        "entry_id": "18f1325d-8ccf-3b14-ad4d-0e33ff3a8ca7",
                                        "glosses": [
                                            "Prénom mixte, le plus souvent féminin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "630056d1-1492-4ee2-9805-ba7f609ca120",
                                                "sense_id": "fdc5733d-af6e-3f2a-b75f-c9dce4f7c0e6",
                                                "text": "C’est moi qui conduisais Catherine à la grand-messe et aux vêpres, et, pendant la fête, elle ne quittait pas mon bras et refusait de danser avec les autres garçons du village."
                                            },
                                            {
                                                "example_id": "da8097a3-bfc4-48e1-9ac5-4e8f37d841e9",
                                                "sense_id": "fdc5733d-af6e-3f2a-b75f-c9dce4f7c0e6",
                                                "text": "Issu d’une famille de bonne bourgeoisie, Dominique-Catherine de Perignon, après de solides études à Toulouse, entre dans l’armée en 1780, mais voit son avancement bloqué par la réforme du marquis de Ségur."
                                            },
                                            {
                                                "example_id": "97a502fe-355e-41a5-90d0-4bd3fcc2cc63",
                                                "sense_id": "fdc5733d-af6e-3f2a-b75f-c9dce4f7c0e6",
                                                "text": "La maire, Catherine Bréard, qui présidera la cérémonie, y convie les habitants de Fouquebrune, Mouthiers-sur-Boëme et Torsac."
                                            },
                                            {
                                                "example_id": "c58b4e1e-2bda-4a86-9b17-f89528865eaf",
                                                "sense_id": "fdc5733d-af6e-3f2a-b75f-c9dce4f7c0e6",
                                                "text": "La ministre des Affaires étrangères, Catherine Colonna, a qualifié, mardi, de « mascarades » les référendums d’annexion organisés en Ukraine par Moscou."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
