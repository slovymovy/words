                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Islamismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bc748326-99af-31ed-afeb-bfefd9638937",
                                        "entry_id": "e727c952-acf6-31bd-82c0-1fb001b90c37",
                                        "glosses": [
                                            "politische Bewegung innerhalb des Islams, die die Errichtung eines islamischen Staatswesens, die Einführung der Scharia (islamisches Recht), und die Besinnung auf die Normen des Propheten Mohammed und der ersten vier Kalifen (Sunna) anstrebt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9574ddd0-7f08-4291-b906-45dd4f2692e9",
                                                "sense_id": "bc748326-99af-31ed-afeb-bfefd9638937",
                                                "text": "Der niederländische Schriftsteller Leon de Winter titulierte den Islamismus als den Faschismus des 21. Jahrhunderts."
                                            },
                                            {
                                                "example_id": "6b932208-6d82-4662-beaa-a274b8247499",
                                                "sense_id": "bc748326-99af-31ed-afeb-bfefd9638937",
                                                "text": "Bei Islamismus kann man an Al-Kaida, Hamas, Hisbollah, Millî Görüş, Taliban, Fiqh, Koran, Hadith, Dhimmi und Harbi denken."
                                            },
                                            {
                                                "example_id": "83b5b05a-bfa6-4de6-8f47-b90aa6c8e4dc",
                                                "sense_id": "bc748326-99af-31ed-afeb-bfefd9638937",
                                                "text": "„Auch der radikale Islamismus im Sinne der Salafisten, der Muslimbrüder und der Taliban ist eine durchschlagende Idee, die viele Menschen anzieht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
