                {
                    "sense_id": "5604a6f3-c760-33b1-bbaf-ecc5c92d7f88",
                    "sense_definition": "Qui est devenu solide ou pâteux sous l'effet du froid, en particulier pour un corps gras ou un liquide.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "matière",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La graisse de canard était déjà <w>figée</w> à la surface du plat.",
                            "target_lang_translations": {
                                "en": "The duck fat had already <w>congealed</w> on the surface of the dish.",
                                "ru": "Утиный жир уже <w>застыл</w> на поверхности блюда.",
                                "de": "Das Entenfett war schon auf der Oberfläche der Platte <w>erstarrt</w>.",
                                "es": "La grasa de pato ya se había <w>solidificado</w> en la superficie del plato.",
                                "zh": "鸭油早已在盘子表面<w>凝固</w>了。"
                            }
                        },
                        {
                            "text": "Il faut réchauffer l'huile d'olive devenue <w>figée</w> dans la cave.",
                            "target_lang_translations": {
                                "en": "The olive oil that has <w>congealed</w> in the cellar needs to be reheated.",
                                "ru": "Оливковое масло, <w>застывшее</w> в погребе, нужно разогреть.",
                                "de": "Das im Keller <w>erstarrte</w> Olivenöl muss wieder erwärmt werden.",
                                "es": "Hay que volver a calentar el aceite de oliva que se ha <w>endurecido</w> en el sótano.",
                                "zh": "地窖里的橄榄油<w>凝结</w>了，需要重新加热。"
                            }
                        }
                    ],
                    "synonyms": [
                        "coagulé",
                        "solidifié"
                    ],
                    "antonyms": [
                        "fondu",
                        "liquide"
                    ],
                    "common_phrases": [
                        "graisse figée",
                        "huile figée"
