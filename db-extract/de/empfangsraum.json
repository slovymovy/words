                "senses": [
                    {
                        "sense_id": "194a5efa-ce0e-3fc6-bbc9-4bdac6b53a24",
                        "entry_id": "122cc35a-e439-3c00-ab0c-f91b82568310",
                        "glosses": [
                            "Raum, in dem Personen begrüßt/empfangen werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f6c7347-5df9-4161-b6e0-f961f65a5ef2",
                                "sense_id": "194a5efa-ce0e-3fc6-bbc9-4bdac6b53a24",
                                "text": "„Sie hatte in der Hotelhalle gestanden, die keine Halle war, sondern nur ein Empfangsraum mit einer dunkelbraunen geprägten Tapete, die aussah, als sei sie aus Leder.“"
                            },
                            {
                                "example_id": "05cd5e3c-1237-4f32-8738-ab12da2aa3b0",
                                "sense_id": "194a5efa-ce0e-3fc6-bbc9-4bdac6b53a24",
                                "text": "„Stumm geleitete Doktor Eisentür den Heimkehrer in den mittleren Empfangsraum.“"
                            },
                            {
                                "example_id": "790b4da8-5ad0-4293-b8c7-65a3b952fb9c",
                                "sense_id": "194a5efa-ce0e-3fc6-bbc9-4bdac6b53a24",
                                "text": "„Dann wurde er von einem anderen Boten in den Empfangsraum des oberen Kommissariats für die Stadtverwaltung geleitet.“"
                            },
                            {
                                "example_id": "97538288-4dc3-4042-a65a-1373788c9425",
                                "sense_id": "194a5efa-ce0e-3fc6-bbc9-4bdac6b53a24",
                                "text": "„Meukoff rumorte in dem kleinen Empfangsraum nebenan.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
