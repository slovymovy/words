                    ]
                },
                {
                    "sense_id": "0d9b5b2e-74b7-3607-af82-c8d99606198e",
                    "sense_definition": "lautstark, grob oder wütend schimpfen und seinem Ärger unkontrolliert Luft machen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "schimpfen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der unzufriedene Abteilungsleiter <w>polterte</w> durch die Gänge und kritisierte alle Anwesenden."
                        },
                        {
                            "text": "Bei der hitzigen Debatte <w>polterte</w> der Politiker lautstark gegen die neuen Steuerpläne."
                        }
                    ],
                    "antonyms": [],
                    "common_phrases": [
                        "lautstark poltern",
                        "gegen jemanden poltern"
                    ],
                    "synonyms": [
