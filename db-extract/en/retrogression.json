                    {
                        "sense_id": "6467820e-2393-364f-9095-989a8b4acf43",
                        "entry_id": "5d072536-588c-339d-873a-74ba879e113f",
                        "glosses": [
                            "A deterioration or decline to a previous state."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "350d74d3-a4ca-40cb-923a-f634698f9d2e",
                                "sense_id": "6467820e-2393-364f-9095-989a8b4acf43",
                                "text": "History and experience, the enshriners of the past, and investigation, the discoverer of the present and preparer for the future, will prevent retrogression."
                            },
                            {
                                "example_id": "0ed82afc-b092-4a9f-9719-f984ff3811b2",
                                "sense_id": "6467820e-2393-364f-9095-989a8b4acf43",
                                "text": "Suns spring into being, and then their height of power being reached, the process of retrogression begins, and after aeons they become dead masses of matter, awaiting another impulse which starts again their inner energies into activity and a new solar life cycle is begun."
                            }
                        ]
                    },
                    {
                        "sense_id": "cd7ca37b-bff5-3476-8a3b-1c0237e3e125",
                        "entry_id": "5d072536-588c-339d-873a-74ba879e113f",
                        "glosses": [
                            "A return to a less complex condition."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
