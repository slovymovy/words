                ],
                "senses": [
                    {
                        "sense_id": "c570b98e-e7ce-3f94-a77c-2025b440be97",
                        "entry_id": "b4e89843-ad02-302f-a806-810a55d6cb8e",
                        "glosses": [
                            "Variante orthographique de ilo-dionysien."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a858208a-c2ac-42be-9f49-951afcde339a",
                                "sense_id": "c570b98e-e7ce-3f94-a77c-2025b440be97",
                                "text": "Vincent Ganivet, artiste îlodionysien, a été choisi pour installer une œuvre sur la place."
                            },
                            {
                                "example_id": "76843fef-9eef-48f3-afbf-a9245b1011db",
                                "sense_id": "c570b98e-e7ce-3f94-a77c-2025b440be97",
                                "text": "Denise Ardines : arrivée à L’Île-Saint-Denis en 1956 ; infirmière de métier ; conseillère municipale et maire adjointe ; militante des droits de la femme ; co-fondatrice de l’antenne îlodionysienne du Secours Populaire."
                            },
                            {
                                "example_id": "5d36e6d7-9030-43ab-b3ee-c25f9a03a965",
                                "sense_id": "c570b98e-e7ce-3f94-a77c-2025b440be97",
                                "text": "Ainsi, vous pourrez, sans débourser un centime d’euro, vous offrir un « canotage amoureux » en barque au ponton des Impressionnistes et rêver lors d’une « promenade exotique » en bateaux dragons, en pirogues polynésiennes, en canoës ou en avirons îlodionysiens."
                            },
                            {
                                "example_id": "a8183866-ebba-45dc-a597-f3ff7be380e7",
                                "sense_id": "c570b98e-e7ce-3f94-a77c-2025b440be97",
                                "text": "Le collectif îlodionysien Archives et patrimoines plaide pour un aménagement alternatif, qui préserverait l’allure du pont, « avec une partie en site propre, et un système de rond-points avant et après les ponts »."
                            },
                            {
                                "example_id": "24bfb92a-d37b-4529-809a-4dacb32391bd",
                                "sense_id": "c570b98e-e7ce-3f94-a77c-2025b440be97",
                                "text": "Mais les communistes îlodionysiens et la mairie de cette ville sont décidés à aider André Fleurantin."
                            }
                        ]
                    }
                ],
