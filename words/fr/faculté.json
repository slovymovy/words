    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8abc98a5-6bdd-308d-808f-ade2cadd6881",
                    "sense_definition": "Division ou établissement d'enseignement supérieur au sein d'une université.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "universite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après l'obtention de son baccalauréat, il s'est inscrit à la <w>faculté</w> de droit."
                        },
                        {
                            "text": "Les étudiants se rassemblent devant la <w>faculté</w> de médecine avant le début des cours."
                        }
                    ],
                    "synonyms": [
                        "fac",
                        "U.F.R."
                    ],
                    "common_phrases": [
                        "faculté de médecine",
                        "faculté de droit",
                        "faculté des sciences"
                    ]
                },
                {
                    "sense_id": "5164e877-242c-37a5-aad4-45203e54c7f7",
                    "sense_definition": "Aptitude ou capacité physique ou intellectuelle propre à un être vivant.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "capacite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet enfant a une remarquable <w>faculté</w> d'adaptation face aux situations nouvelles."
                        },
                        {
                            "text": "Malgré son grand âge, il conserve toutes ses <w>facultés</w> intellectuelles."
                        }
                    ],
                    "synonyms": [
                        "aptitude"
                    ],
                    "common_phrases": [
                        "facultés intellectuelles",
                        "perdre ses facultés",
                        "faculté d'adaptation"
                    ]
                },
                {
                    "sense_id": "342c9acb-b562-3271-acae-c0ec97468f43",
                    "sense_definition": "Droit ou possibilité légale d'accomplir un acte ou d'exercer un choix.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "pouvoir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le contrat réserve à l'acheteur la <w>faculté</w> de résilier sous trente jours."
                        },
                        {
                            "text": "Vous avez la <w>faculté</w> de refuser cette proposition sans aucune pénalité financière."
                        }
                    ],
                    "synonyms": [
                        "possibilité",
                        "pouvoir"
                    ],
                    "common_phrases": [
                        "avoir la faculté de",
                        "laisser la faculté de"
                    ]
                },
                {
                    "sense_id": "26d5ddc0-3c3e-3978-ad58-564dcef01af8",
                    "sense_definition": "Propriété naturelle ou capacité d'une chose matérielle à produire un effet.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "capacite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette plante médicinale possède la <w>faculté</w> d'accélérer la cicatrisation des plaies."
                        },
                        {
                            "text": "L'aimant a la <w>faculté</w> d'attirer certains métaux comme le fer."
                        }
                    ],
                    "synonyms": [
                        "propriété"
                    ],
                    "common_phrases": [
                        "faculté d'absorption"
                    ]
                },
                {
                    "sense_id": "4bf8b90f-3db7-3641-8300-1fcfc993781a",
                    "sense_definition": "Biens matériels, fortune ou ressources financières dont dispose une personne.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "finances",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque citoyen doit contribuer aux charges publiques en proportion de ses <w>facultés</w>."
                        },
                        {
                            "text": "Le juge a évalué les <w>facultés</w> contributives des deux époux avant de fixer la pension."
                        }
                    ],
                    "common_phrases": [
                        "selon ses facultés"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Principalement utilisé au pluriel dans la langue juridique ou formelle"
                        }
                    ]
                },
                {
                    "sense_id": "9568e1f8-b4f5-33f3-a089-29a42aeeb304",
                    "sense_definition": "Corps médical ou autorité représentée par l'ensemble des médecins.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "universite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le malade a suivi rigoureusement le traitement prescrit par la <w>faculté</w>."
                        },
                        {
                            "text": "Cet avis unanime émis par la <w>faculté</w> a rassuré l'ensemble des patients."
                        }
                    ],
                    "common_phrases": [
                        "ordonnance de la faculté"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Emploi traditionnel ou ironique désignant les médecins"
                        }
                    ]
                }
            ]
        }
    ]
