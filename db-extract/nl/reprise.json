                ],
                "senses": [
                    {
                        "sense_id": "e4619402-8af5-338e-a8ac-9084daa123e4",
                        "entry_id": "8dfe2667-e592-3d9c-8bbc-fa7542b10af1",
                        "glosses": [
                            "term voor de wederopvoering van een vroeger gespeeld toneelstuk (opera, musical)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91dabdac-fbc0-47c4-ad56-be18eeffa5d1",
                                "sense_id": "e4619402-8af5-338e-a8ac-9084daa123e4",
                                "text": "Lady Gaga is weer terug op de werkvloer. De zangeres was de afgelopen twee dagen in de Electric Lady Studio in New York om te werken aan de soundtrack van de reprise van de film A Star is Born, geregisseerd door Bradley Cooper. Dat heeft een bron bevestigd aan US Weekly."
                            },
                            {
                                "example_id": "86ec87cb-6ee4-4804-ac1c-08ca807fac32",
                                "sense_id": "e4619402-8af5-338e-a8ac-9084daa123e4",
                                "text": "Mamma Mia! gaat op 23 september in première in het Beatrix Theater in Utrecht. Het stuk was al tweemaal eerder in Nederland te zien. Tussen 2003 en 2006 werd Mamma Mia! al meer dan achthonderd keer opgevoerd in het Beatrix Theater. De hoofdrol werd toen afwisselend gespeeld door Simone Kleinsma en Lenette van Dongen. In 2009 volgde er een eerste reprise, toen met Lone van Roosendaal in de rol van Donna."
                            },
                            {
                                "example_id": "237d5427-d44f-4185-a758-e600e4a0b7e2",
                                "sense_id": "e4619402-8af5-338e-a8ac-9084daa123e4",
                                "text": "De Hagenaar won in 2010 het Cameretten Festival. Daarvoor maakte hij deel uit van de groep Delfts Blok, die in 2001 het Groninger Studenten Cabaret Festival won. Komend seizoen speelt Van Kuijk nog wel een reprise van zijn nieuwe show Janus."
                            },
                            {
                                "example_id": "dae73415-2f00-4ed8-bb00-0db8010ff08c",
                                "sense_id": "e4619402-8af5-338e-a8ac-9084daa123e4",
                                "text": "De Bond was vrijdagavond tot op de laatste plaats bezet bij de opvoering van de eerste jubileumrevue van de Oldenzaalse Köpperbloazers. Ook zaterdag was het opnieuw een volle bak voor het stadstheater bij een reprise van deze revue ter gelegenheid van het 33-jarig bestaan."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f79ad7a8-ef34-433c-8f2d-251329903693",
                        "source_entry_id": "8dfe2667-e592-3d9c-8bbc-fa7542b10af1",
                        "source_sense_id": "e4619402-8af5-338e-a8ac-9084daa123e4",
                        "target_lang_word": "repeat",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "repeat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "618d202f-9104-3ff7-9088-025e15b1824d",
                                        "entry_id": "b1b16a4c-276f-3581-aa7d-b223de0a30b2",
                                        "glosses": [
                                            "To do or say again (and again)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c711e294-b5ce-49f7-9f6b-1b7a5c37d0da",
                                                "sense_id": "618d202f-9104-3ff7-9088-025e15b1824d",
                                                "text": "The scientists repeated the experiment in order to confirm the result."
                                            },
                                            {
                                                "example_id": "8bc6d2df-1601-4047-a587-b88556eab5e2",
                                                "sense_id": "618d202f-9104-3ff7-9088-025e15b1824d",
                                                "text": "I'll tell you my secret, but first promise me you won't repeat it to anyone else!"
                                            },
                                            {
                                                "example_id": "1dbe91a7-7037-4538-a5d5-e158342df910",
                                                "sense_id": "618d202f-9104-3ff7-9088-025e15b1824d",
                                                "text": "I don't mind talking about the incident, but one gets tired of repeating themself after the hundredth time."
                                            },
                                            {
                                                "example_id": "787f6e79-18b5-42f3-8a89-c09af1b5c8dc",
                                                "sense_id": "618d202f-9104-3ff7-9088-025e15b1824d",
                                                "text": "When this conversation was repeated in detail within the hearing of the young woman in question, and undoubtedly for his benefit, Mr. Trevor threw shame to the winds and scandalized the Misses Brewster then and there by proclaiming his father to have been a country storekeeper."
                                            },
                                            {
                                                "example_id": "e932861c-27b8-4e3d-834d-7a333d2ac577",
                                                "sense_id": "618d202f-9104-3ff7-9088-025e15b1824d",
                                                "text": "From Berlin and Tokyo and Rome, we have been described as a nation of weaklings- playboys- who would hire British soldiers or Russian soldiers or Chinese soldiers to do our fighting for us. Let them repeat that now. Let them tell that to General McArthur and his men. Let them tell that to the sailors who today are hitting hard in the far waters of the Pacific. Let them tell that to the boys in the Flying Fortresses. Let them tell that to the Marines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "535d847b-6136-3523-84e0-149788ab2018",
                                        "entry_id": "b1b16a4c-276f-3581-aa7d-b223de0a30b2",
                                        "glosses": [
                                            "To refill (a prescription)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "73a54d80-0084-337a-b8da-6ca3e8d8f9f6",
                                        "entry_id": "b1b16a4c-276f-3581-aa7d-b223de0a30b2",
                                        "glosses": [
                                            "To happen again; recur."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58cc6b56-12f0-427f-aed8-a718fefd88d2",
                                                "sense_id": "73a54d80-0084-337a-b8da-6ca3e8d8f9f6",
                                                "text": "A day like that has not yet repeated itself."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d15d23d8-3be0-3216-926e-c92d4bf12a60",
                                        "entry_id": "b1b16a4c-276f-3581-aa7d-b223de0a30b2",
                                        "glosses": [
                                            "To echo the words of (a person)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ace57da1-02ef-414d-a9c8-aaabd7de9ebf",
                                                "sense_id": "d15d23d8-3be0-3216-926e-c92d4bf12a60",
                                                "text": "Their rationale with repeating me was that the prior program had not been of sufficient quality to teach me the error of my ways."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2de58c53-6bda-3787-8c1b-06f373f65f3d",
                                        "entry_id": "b1b16a4c-276f-3581-aa7d-b223de0a30b2",
                                        "glosses": [
                                            "To strike the hours, as a watch does."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c992155f-f985-3bbc-afe9-c327589749cc",
                                        "entry_id": "b1b16a4c-276f-3581-aa7d-b223de0a30b2",
                                        "glosses": [
                                            "To make trial of again; to undergo or encounter again."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "732bd65e-5623-45aa-8229-a6ad16fa4fa7",
                                                "sense_id": "c992155f-f985-3bbc-afe9-c327589749cc",
                                                "text": "He[…] repeats the danger of the burning town."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "275f5b85-a98f-3cad-b205-20552ab3d012",
                                        "entry_id": "b1b16a4c-276f-3581-aa7d-b223de0a30b2",
                                        "glosses": [
                                            "To repay or refund (an excess received)."
                                        ],
                                        "tags": [
                                            "Scotland"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fc115ec7-e36f-3cd5-aa23-1c95ea4f3490",
                                        "entry_id": "b1b16a4c-276f-3581-aa7d-b223de0a30b2",
                                        "glosses": [
                                            "To call in a previous artillery fire mission with the same ammunition and method either on the coordinates or adjusted either because destruction of the target was insufficient or missed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d63ef46-6770-4278-94f4-5e4eab988ffb",
                                                "sense_id": "fc115ec7-e36f-3cd5-aa23-1c95ea4f3490",
                                                "text": "Add 100, left 50. Repeat, over."
                                            },
                                            {
                                                "example_id": "f49e10b4-824f-4fac-81c3-4c5cd3914779",
                                                "sense_id": "fc115ec7-e36f-3cd5-aa23-1c95ea4f3490",
                                                "text": "Use \"say again\" instead of repeat on the radio. Repeat will bring in artillery fire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e3e62d1-866a-3fd5-94e9-0187ee1a0012",
                                        "entry_id": "b1b16a4c-276f-3581-aa7d-b223de0a30b2",
                                        "glosses": [
                                            "To commit fraud in an election by voting more than once for the same candidate."
                                        ],
