                "senses": [
                    {
                        "sense_id": "c570d18c-69fa-3394-87f4-51e872e96016",
                        "entry_id": "1fb6fe4e-97b4-37b0-9ab7-460565080593",
                        "glosses": [
                            "Having no back."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "ca0d41da-93c6-4184-bf69-af77e8354b98",
                                "sense_id": "c570d18c-69fa-3394-87f4-51e872e96016",
                                "text": "an unbacked bench"
                            }
                        ]
                    },
                    {
                        "sense_id": "1fb03bca-505e-3ab4-a8f6-2a5cc0cc370b",
                        "entry_id": "1fb6fe4e-97b4-37b0-9ab7-460565080593",
                        "glosses": [
                            "Not supported or backed up (by someone or something)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b6733d5-6340-4683-b89d-06252a888f6f",
                                "sense_id": "1fb03bca-505e-3ab4-a8f6-2a5cc0cc370b",
                                "text": "The warlike Wench amongst the Greekes doth stand\nVnbackt by Troy, left of her Damsels all,\nThe battery of a thousand swords she bides,\nTill her yron plates are hew’d off from her sides."
                            },
                            {
                                "example_id": "73283d98-e15d-4257-9842-b6833be89db6",
                                "sense_id": "1fb03bca-505e-3ab4-a8f6-2a5cc0cc370b",
                                "text": "The simple statement, unbacked by any proof but the weight of Ralph’s new authority, brought light and happiness."
                            },
                            {
                                "example_id": "4de24c62-f1f6-4600-b739-112193840867",
                                "sense_id": "1fb03bca-505e-3ab4-a8f6-2a5cc0cc370b",
                                "text": "This was an intellectual decision, unbacked by moral energy."
                            }
                        ]
                    },
                    {
                        "sense_id": "107e08a4-02ef-361b-86b1-26d38ef94b66",
                        "entry_id": "1fb6fe4e-97b4-37b0-9ab7-460565080593",
                        "glosses": [
                            "Having no (or few) backers."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05311471-df73-40c5-a320-d5168d11190d",
                                "sense_id": "107e08a4-02ef-361b-86b1-26d38ef94b66",
                                "text": "an unbacked racehorse"
                            },
                            {
                                "example_id": "97df7b5e-d2a0-4e6b-a571-c36d663f6634",
                                "sense_id": "107e08a4-02ef-361b-86b1-26d38ef94b66",
                                "text": "a largely unbacked fundraising project"
                            }
                        ]
                    },
                    {
                        "sense_id": "61b57577-6305-3cbe-a1bb-410a7453cfa8",
                        "entry_id": "1fb6fe4e-97b4-37b0-9ab7-460565080593",
                        "glosses": [
                            "Of an animal: never having been ridden or not accustomed to being ridden; not (currently) being ridden."
                        ],
                        "tags": [
                            "not-comparable",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "4ce63cdc-24f4-4f3a-ad55-cd9cf1d9795c",
                                "sense_id": "61b57577-6305-3cbe-a1bb-410a7453cfa8",
                                "text": "[…] like unback’d colts, they prick’d their ears,\nAdvanced their eyelids, lifted up their noses\nAs they smelt music:"
                            },
                            {
                                "example_id": "99fbd8ee-a89f-450d-bc73-b2a3d2caaf52",
                                "sense_id": "61b57577-6305-3cbe-a1bb-410a7453cfa8",
                                "text": "[…] a well wayed horse will safely convay thee to thy journeys end, when an unbackt Filly may by chance give thee a fall:"
                            },
                            {
                                "example_id": "e45b9d45-11bc-43c6-bbff-5591a1482042",
                                "sense_id": "61b57577-6305-3cbe-a1bb-410a7453cfa8",
                                "text": "[…] whoever has seen a fine arabian war-horse, unback’d and at liberty, and in a wanton trot, cannot but remember what a large waving line his rising, and at the same time pressing forward, cuts through the air;"
                            },
                            {
                                "example_id": "8c632130-d2b8-40a0-8124-412747ff1474",
                                "sense_id": "61b57577-6305-3cbe-a1bb-410a7453cfa8",
                                "text": "1823, Mary Shelley, Valperga, London: G. and W.B. Whittaker, Volume 2, Chapter 10, p. 237,\n[…] having visited his charger which was to be led unbacked to the field, he mounted a black palfrey;"
                            },
                            {
                                "example_id": "8f692ac0-d842-4a41-b97a-96c12c55be41",
                                "sense_id": "61b57577-6305-3cbe-a1bb-410a7453cfa8",
                                "text": "Shakbolt must have had apoplexy at the thought of his ramping war-horses answering to that description. He used to buy unbacked devils, and tame them by starvation."
                            }
                        ]
                    },
                    {
                        "sense_id": "d55357bc-5d74-3134-a492-c9ee38e03107",
                        "entry_id": "1fb6fe4e-97b4-37b0-9ab7-460565080593",
                        "glosses": [
                            "(of a plate) Not having an antihalation backing."
                        ],
