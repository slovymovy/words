                            {
                                "example_id": "538a50ac-73a2-490e-b3f1-d1f025bb8d84",
                                "sense_id": "372f9815-c632-3f5b-b9fd-18800b5351e6",
                                "text": "Der Katar-Riyal (QAR) und der Saudi-Riyal (SAR) sind ab sofort uneingeschränkt als Abwicklungswährungen bei Clearstream, dem internationalen Zentralverwahrer der Gruppe Deutsche Börse, zugelassen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
