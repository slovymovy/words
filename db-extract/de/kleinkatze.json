                    {
                        "sense_id": "c3e3e397-9e36-378f-88d0-58d87491c200",
                        "entry_id": "d70c5d33-e469-30a0-8490-d35c0cafc61f",
                        "glosses": [
                            "Unterart der Katzen; Raubtier, das Schnurren, aber nicht Brüllen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c1f1107-5c13-4362-b3d1-e4f08567fbf0",
                                "sense_id": "c3e3e397-9e36-378f-88d0-58d87491c200",
                                "text": "In der zoologischen Systematik herrschte Unsicherheit darüber, ob der Puma nun eine kleine Großkatze oder eine große Kleinkatze sei."
                            }
                        ],
