                    {
                        "translation_id": "284d9ca7-bec1-428f-86fc-f262eb4b1911",
                        "source_entry_id": "25957ae2-daeb-30cc-8fc3-27f2fc3a6d93",
                        "source_sense_id": "64317205-d7db-3917-850e-e2f38c72762c",
                        "source_sense_description": "Wende in die entgegengesetzte Richtung",
                        "target_lang_word": "about-face",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "about-face",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c5f4875e-30bd-38b1-ac86-fc2547576c2b",
                                        "entry_id": "51f00004-94b7-3e58-bbd4-9115f154a603",
                                        "glosses": [
                                            "An abrupt turn to face the opposite direction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f41e441-39c6-4fa7-ae86-d6532138ad16",
                                                "sense_id": "c5f4875e-30bd-38b1-ac86-fc2547576c2b",
                                                "text": "The soldier did an about-face and marched off."
                                            },
                                            {
                                                "example_id": "0b6c5faa-91f2-4180-99e3-733dbd04bdfe",
                                                "sense_id": "c5f4875e-30bd-38b1-ac86-fc2547576c2b",
                                                "text": "Deciding that he hasn't had enough action for one day, Captain Evans of the Johnston orders another 180-degree about-face to give gunfire support to the new arrivals, this time picking on the heavy cruiser Tone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10a8f1ad-80c5-3d51-bd4d-a1a395b8b759",
                                        "entry_id": "51f00004-94b7-3e58-bbd4-9115f154a603",
                                        "glosses": [
                                            "A reversal in direction; a reversal of attitude or opinion."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c15fc715-b219-4b06-9b14-4b4eb5a17f8c",
                                                "sense_id": "10a8f1ad-80c5-3d51-bd4d-a1a395b8b759",
                                                "text": "When Luke heard the news, he did an abrupt about-face on the policy."
                                            },
                                            {
                                                "example_id": "6955cf68-7402-4905-a0ff-508e312121ba",
                                                "sense_id": "10a8f1ad-80c5-3d51-bd4d-a1a395b8b759",
                                                "text": "Sidney Powell does an about-face on her Stop the Steal claims [title]"
                                            },
                                            {
                                                "example_id": "e905d5c5-eb71-47ed-b7a4-aa3e9c70d457",
                                                "sense_id": "10a8f1ad-80c5-3d51-bd4d-a1a395b8b759",
                                                "text": "In yet another about-face decision on speech, Mr. Zuckerberg announced that Facebook was planning to de-emphasize political content in the News Feed because, he said, “people don’t want politics and fighting to take over their experience on our service.”"
                                            },
                                            {
                                                "example_id": "bbbca33a-05e3-41ca-963f-0adea5b94ac1",
                                                "sense_id": "10a8f1ad-80c5-3d51-bd4d-a1a395b8b759",
                                                "text": "His about-face is such that he is even taking his case back to court to ask his guilty plea to be reversed. And he is far from the alone in changing his mind about the events at the Capitol."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "about-face",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "51a2d916-506f-37ad-b18f-c32a598894bc",
                                        "entry_id": "4d5db4dc-2d33-3abe-9151-bfd4727743a5",
                                        "glosses": [
                                            "To turn 180 degrees to face the opposite direction."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "595b6c3a-0bbf-4e81-85c3-3e06b2e908eb",
                                                "sense_id": "51a2d916-506f-37ad-b18f-c32a598894bc",
                                                "text": "The soldiers would about-face immediately after the order was given."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed3b6b0a-f962-3aac-b18c-46d2d7fb1b27",
                                        "entry_id": "4d5db4dc-2d33-3abe-9151-bfd4727743a5",
                                        "glosses": [
                                            "To change opinion or attitude drastically."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90c7e18d-80ea-4d80-a1aa-86aaa532fedb",
                                                "sense_id": "ed3b6b0a-f962-3aac-b18c-46d2d7fb1b27",
                                                "text": "A politician will about-face at the drop of a hat if he thinks there are votes in it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e9d02482-ecae-48b4-8681-0cb5b1806f50",
                        "source_entry_id": "25957ae2-daeb-30cc-8fc3-27f2fc3a6d93",
                        "source_sense_id": "64317205-d7db-3917-850e-e2f38c72762c",
                        "source_sense_description": "Wende in die entgegengesetzte Richtung",
                        "target_lang_word": "volte-face",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "volte-face",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "79293985-1129-3571-997c-b69e746cd762",
                                        "entry_id": "620086c0-83d4-3cd6-9c83-a6395ad514aa",
                                        "glosses": [
                                            "A reversal of attitude, policy, or principle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e73a50ea-a05f-4380-8a45-08d6c798c5c2",
                                                "sense_id": "79293985-1129-3571-997c-b69e746cd762",
                                                "text": "Psychoanalysis has sprung many surprises on us, performed more than one volte face before our indignant eyes."
                                            },
                                            {
                                                "example_id": "10c83497-4824-4a2c-aeb4-327c70b7706d",
                                                "sense_id": "79293985-1129-3571-997c-b69e746cd762",
                                                "text": "Then, on July 15, 1971, came Nixon's sudden announcement that Kissinger had just made a secret trip to Peking and that he himself had accepted Chou En-lai's invitation to visit the Chinese mainland sometime before May, 1972. This was instantly interpreted in chancelleries all over the world as a sign that the United States was about to execute a volte-face in its China policy."
                                            },
                                            {
                                                "example_id": "818c85f7-f1f3-4061-b2aa-8939df5906b7",
                                                "sense_id": "79293985-1129-3571-997c-b69e746cd762",
                                                "text": "My next stop is Oxford, which has also grown with the addition of new platforms to accommodate the Chiltern Railways service to London via Bicester – although, short sightedly, the planned electrification from Paddington was canned. Evidence of the volte-face can be seen along the line at places such as Radley, where mast piles are already sunk or lie discarded at the lineside."
                                            },
                                            {
                                                "example_id": "90937a36-7532-4bf3-93c5-82981e8a3ea5",
                                                "sense_id": "79293985-1129-3571-997c-b69e746cd762",
                                                "text": "For one-time advocates of unfettered globalisation, this volte-face has resulted in cognitive dissonance, because the new suite of policy proposals implies that longstanding rules of the international trading system will be bent or broken."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5573f636-fbf4-3779-a167-712cc1a3378c",
                                        "entry_id": "620086c0-83d4-3cd6-9c83-a6395ad514aa",
                                        "glosses": [
                                            "A dramatic change in mood or tone."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27b6e0f0-888e-4d8a-97bb-0487d63c4313",
                                                "sense_id": "5573f636-fbf4-3779-a167-712cc1a3378c",
                                                "text": "Shakespeare often used volte-faces in the rhyming couplets at the end of his sonnets."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ba6bc56e-6538-4e9a-8dd4-705fcc4bcc53",
                        "source_entry_id": "25957ae2-daeb-30cc-8fc3-27f2fc3a6d93",
                        "source_sense_id": "64317205-d7db-3917-850e-e2f38c72762c",
                        "source_sense_description": "Wende in die entgegengesetzte Richtung",
