                        "entry_id": "2fcd2bad-70e3-34db-a803-341151710919",
                        "glosses": [
                            "Action d’éborgner ; état de celui qui est éborgné."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22843fa7-eeb5-49f5-9f36-6af63ca0d565",
                                "sense_id": "9b8d5060-70f4-3699-bdda-7c96ca638c92",
                                "text": "Ce nom d’esclaire, en latin Chelidonium, est donné à ceste herbe, à cause que d’icelle les arondelles guerissent leurs petits de l’esborgnement, selon la commune creance."
                            },
                            {
                                "example_id": "3f6e66a3-5058-4199-9891-1c55f441cadc",
                                "sense_id": "9b8d5060-70f4-3699-bdda-7c96ca638c92",
                                "text": "J’ai à peine le temps d’esquiver et il frôle ma joue, m’évitant de justesse l’éborgnement."
                            }
                        ]
                    }
                ],
