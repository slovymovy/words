                        "glosses": [
                            "Lit de camp, lit-canapé en lanières de cuir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "582f1a2b-d14f-4cdb-a6cb-7f074526a808",
                                "sense_id": "4d1e1ea7-607e-3599-8fbb-358b071e3ea5",
                                "text": "Dans une pièce assez spacieuse, remplie de serviteurs, de vassaux, de soldats, corps de garde plutôt que salon, se tenait à demi couché sur un alga (lit de camp que les Arabes nomment angareb) le seigneur du lieu, dont le teint noir répondait assez à ce qu’on m’avait dit de son origine kamante."
                            },
                            {
                                "example_id": "15ccaec2-53e3-44b4-9143-e8ea0ed5ba9e",
                                "sense_id": "4d1e1ea7-607e-3599-8fbb-358b071e3ea5",
                                "text": "Angareb (en arabe), alga (en abyssin), sorte de lit-canapé en lanières de cuir ou de peau d’hippopotame. Voyage au Taka, Guillaume Lejean, Notes de fin de page."
                            }
                        ]
                    }
