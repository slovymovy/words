                    {
                        "form_id": "2e85fc13-6a0b-4d61-923f-0511ecfcfa07",
                        "entry_id": "dbd4d1d9-4495-36e9-86d5-6419df379aa5",
                        "tags": [
                            "past"
                        ],
                        "form": "mafficked"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c2439f1c-38d8-3ef4-a6dd-034bb1e9c409",
                        "entry_id": "dbd4d1d9-4495-36e9-86d5-6419df379aa5",
                        "glosses": [
                            "To celebrate a victory in a boisterous manner."
                        ],
                        "tags": [
                            "historical",
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "7bf6dcbf-71a8-4167-ab8e-67c1c7aaa5c1",
                                "sense_id": "c2439f1c-38d8-3ef4-a6dd-034bb1e9c409",
                                "text": "[…] we crown our work by putting into our children’s hands a book that reeks of Jingoism, Imperialism, and Patriotism; that “mafficks” on every other page, that sings the glories of all the ruffianly kings who bore rule in the Dark Ages, and never fails to applaud their most disreputable military adventures!"
                            },
                            {
                                "example_id": "44c90c30-f600-4c14-8eff-ffa1a04a799e",
                                "sense_id": "c2439f1c-38d8-3ef4-a6dd-034bb1e9c409",
                                "text": "[…] father has given a day from business, mother has helped, even those shiny-headed nuts, the sons, have condescended to assist, and now villadom, feeling a little safer, is ready with the dinner-bell, its characteristic instrument of music, to maffick at the victories it has done its best to spoil."
                            },
                            {
                                "example_id": "c5d020d4-d835-45db-b1b8-269773ef5eac",
                                "sense_id": "c2439f1c-38d8-3ef4-a6dd-034bb1e9c409",
                                "text": "“[…] but if to be foreign is to be mad, I think I’d rather be English.”\n“There!” cried Miss Haymer. “That’s typical! Pure jingoism, Connie! You can’t maffick under my roof! […]”"
                            }
                        ]
                    }
                ],
