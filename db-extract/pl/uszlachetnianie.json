                        "translation_id": "f3920915-234d-4586-8615-6e2984391878",
                        "source_entry_id": "c9a6b093-b6e2-38f0-bd3f-47bb8a6f6996",
                        "source_sense_id": "335be5e0-c15b-3996-a6d3-915f9eb04bde",
                        "target_lang_word": "Veredelung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Veredelung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "13ec9918-61d5-39b0-b901-0162e13c9718",
                                        "entry_id": "33b5fe9a-b466-30ec-bb73-d1fcc69ed164",
                                        "glosses": [
                                            "Wertsteigerung von Materialien und Produkten durch intelligente Bearbeitung, Verarbeitung oder Ausbesserung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ace3086c-da36-4ee3-b5df-610b1cfc69d8",
                                                "sense_id": "13ec9918-61d5-39b0-b901-0162e13c9718",
                                                "text": "Stattdessen hat Südostasiaten Synergien mit dem Riesenreich entwickelt: China stellt Grundprodukte her, Südostasien übernimmt deren Veredelung."
                                            },
                                            {
                                                "example_id": "c8eacbdb-b31b-4eb3-a9f6-677c676c985a",
                                                "sense_id": "13ec9918-61d5-39b0-b901-0162e13c9718",
                                                "text": "Die Papierindustrie benötigt Stärke als Hilfsstoff zur Verleimung und Veredelung – jährlich 75.000 Tonnen. Interessant ist dabei aber nur das Amylopektin."
                                            },
                                            {
                                                "example_id": "fdb1ffe8-af32-4b61-90a3-c8ad349171fc",
                                                "sense_id": "13ec9918-61d5-39b0-b901-0162e13c9718",
                                                "text": "Richten Sie Ihren Eifer vor allem auf die Verbesserung des Bodens, auf eine gute Düngung, auf die Veredelung der Pferde-, Rinder-, Schafe- und Schweinezucht!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0a5eb05a-3f55-3cf2-bcf2-7ac1968ad5e0",
                                        "entry_id": "33b5fe9a-b466-30ec-bb73-d1fcc69ed164",
                                        "glosses": [
                                            "vegetative Vermehrung von Nutz- und Zierpflanzen mit Hilfe von Wirtspflanzen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df60528e-dadb-4c52-a491-21751bb1a4c5",
                                                "sense_id": "0a5eb05a-3f55-3cf2-bcf2-7ac1968ad5e0",
                                                "text": "\"Mein Gärnterberuf hat mich den Umgang mit Rosen gelehrt, mit den Rosen und ihrer Veredelung. Meine Kunst ist das Okulieren. …\""
                                            },
                                            {
                                                "example_id": "ceecb753-acc8-4314-b220-fc1100665433",
                                                "sense_id": "0a5eb05a-3f55-3cf2-bcf2-7ac1968ad5e0",
                                                "text": "Durch Veredelung der robusten Acacia dealbata und ihrer Artgenossen entwickelte er 180 Spielarten des anmutigen Frühblühers und avancierte zum Mimosenprimus der Nation."
                                            },
                                            {
                                                "example_id": "7b46d9ec-22d6-48b8-b053-f609af02c737",
                                                "sense_id": "0a5eb05a-3f55-3cf2-bcf2-7ac1968ad5e0",
                                                "text": "Darauf werden Arten wie Salix repens, Salix subopposita oder Salix integra veredelt. Ein schönes Beispiel für eine solche Veredelung ist Salix integra,Hakuro Nishik‘."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "6ddf24d9-eb64-3099-bd9e-9c48ead2624c",
                                        "entry_id": "33b5fe9a-b466-30ec-bb73-d1fcc69ed164",
                                        "glosses": [
                                            "charakterliche, sittliche und geistige Verbesserung der Menschen oder der Gesellschaft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8feae739-46be-4649-bca6-d43868ebc810",
                                                "sense_id": "6ddf24d9-eb64-3099-bd9e-9c48ead2624c",
                                                "text": "Die Erforschung der Ursachen der geistigen und materiellen Erscheinungen ist das Ziel aller Wissenschaften und der Gewinn für das Lehen der Völker, die Befreiung von den Banden der Rohheit und Unkultur, für den Menschen die Veredelung seines individuellen Daseins."
                                            },
                                            {
                                                "example_id": "ee0793f2-d555-4c79-878a-a715ff436565",
                                                "sense_id": "6ddf24d9-eb64-3099-bd9e-9c48ead2624c",
                                                "text": "Auf die geglaubten Motive, nicht auf die wirklichen, kommt es an bei der Veredelung."
                                            },
                                            {
                                                "example_id": "a2dc58d9-5fec-4546-9f9a-d20626078bc1",
                                                "sense_id": "6ddf24d9-eb64-3099-bd9e-9c48ead2624c",
                                                "text": "Die Individualkultur und die wesentlichen Bedürfnisse unserer sittlichen und geistigen Veredelung sowie unseres häuslichen Lebens und Wohlstands gehen überwiegend von den Ansprüchen unseres inneren, höheren und göttlichen Wesens aus."
                                            },
                                            {
                                                "example_id": "842ad609-97ad-4b64-bb08-6f558175fb27",
                                                "sense_id": "6ddf24d9-eb64-3099-bd9e-9c48ead2624c",
                                                "text": "Die Duncan-Schule hatte als leitenden Gedanken „Veredelung der Rasse und Kultivierung der aus diesem Streben sich notwendigerweise ergebenden ethischen wie ästhetischen Lebensäußerungen und Formen\"."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
