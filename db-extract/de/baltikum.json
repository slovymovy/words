                                        "sense_id": "64c9bf13-0ab8-3705-9af8-839a82e0cbd6",
                                        "entry_id": "1a6e7ef8-2eff-36a1-a71a-aa86cc06807b",
                                        "glosses": [
                                            "Trois pays situés au sud-est de la mer Baltique : l’Estonie, la Lettonie et la Lituanie."
                                        ],
                                        "tags": [
                                            "Pays"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74e942a0-5097-445a-91a9-2cc47a8c0af5",
                                                "sense_id": "64c9bf13-0ab8-3705-9af8-839a82e0cbd6",
                                                "text": "Même si leur histoire ancienne et leur culture nordique les rapproche plutôt de la Scandinavie, les trois pays baltes ont fait longuement partie de l’Empire russe et de l’Union soviétique, qui y ont laissé d’importantes minorités russes."
                                            }
                                        ]
