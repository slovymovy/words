                "senses": [
                    {
                        "sense_id": "c0b61d3f-8a66-3d38-80f0-1bf48797b281",
                        "entry_id": "12ea4b4d-3b1b-30af-b856-2268d1b4c489",
                        "glosses": [
                            "Se stupéfier soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0da9452-6b10-4e65-b66c-982787140974",
                                "sense_id": "c0b61d3f-8a66-3d38-80f0-1bf48797b281",
                                "text": "Pardon, je suis tombé dans les pommes en écrivant ça, je me suis auto-stupéfié, le truc complètement dingue !"
                            },
                            {
                                "example_id": "582ceb7a-c673-483a-85f3-0ef9aaada79a",
                                "sense_id": "c0b61d3f-8a66-3d38-80f0-1bf48797b281",
                                "text": "Et, dans un élan de frénésie qui m'auto-stupéfie, la troisième partie de la campagne lupanar a été jouée aujourd'hui."
                            },
                            {
                                "example_id": "ae57482b-3bf8-408a-a471-033a198dde6a",
                                "sense_id": "c0b61d3f-8a66-3d38-80f0-1bf48797b281",
                                "text": "alors ça franchement j'ai une telle mémoire que je m'auto-stupéfie."
                            }
                        ]
                    }
