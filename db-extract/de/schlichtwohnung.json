                    {
                        "sense_id": "3b2430ee-9474-3d8d-a5ca-163f0883ccca",
                        "entry_id": "259b0ef2-0c82-304a-bd6a-fe210196ad87",
                        "glosses": [
                            "Wohnung mit geringstmöglicher Ausstattung und Größe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8062627-ec89-4469-a541-56f614e7ad7c",
                                "sense_id": "3b2430ee-9474-3d8d-a5ca-163f0883ccca",
                                "text": "Manche können sich nicht einmal eine Schlichtwohnung leisten."
                            },
                            {
                                "example_id": "9cbd574b-a1ee-41ac-a3aa-6c14bd74fa8a",
                                "sense_id": "3b2430ee-9474-3d8d-a5ca-163f0883ccca",
                                "text": "„Schlichtwohnungen sind Wohnungen mit einfachster Ausstattung und einem minimalen Raumbedarf, die von Gemeinden für sozial schwache Personen zur Verfügung gestellt werden.“"
                            },
                            {
                                "example_id": "4b27b4ae-e9e0-4d84-ac5d-90c74e679d0a",
                                "sense_id": "3b2430ee-9474-3d8d-a5ca-163f0883ccca",
                                "text": "„Brandverletzungen erlitt ein 41-jähriger Bewohner einer Schlichtwohnung in der Friedrichshöfer Straße bei einem Feuer, das er selbst am Samstag, gegen 04.30 Uhr bemerkt hatte.“"
                            }
                        ],
