                                                "sense_id": "4c49d5dd-3d94-349a-939e-bb86cb0e918b",
                                                "text": "Die Ganache kann auch als Topping für Cupcakes verwendet werden. Auch zum Füllen von Pralinen."
                                            },
                                            {
                                                "example_id": "771fa7f2-e678-4db7-a790-42cf84668700",
                                                "sense_id": "4c49d5dd-3d94-349a-939e-bb86cb0e918b",
                                                "text": "Die Ganache sollte eine Konsistenz wie Nuss-Nougat-Creme haben."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
