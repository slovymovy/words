                        "sense_id": "8f98b467-1e8c-32df-962b-270bd4f49887",
                        "entry_id": "9ee29424-e252-36eb-8831-baaea109b2c8",
                        "glosses": [
                            "freistehendes Möbelstück, an dem man Kleidungsstücke aufhängen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "955f9566-e31c-4508-92e0-1d454ca06914",
                                "sense_id": "8f98b467-1e8c-32df-962b-270bd4f49887",
                                "text": "„Die stand neben dem Kleiderständer.“"
                            },
                            {
                                "example_id": "f57ac52d-0a24-404f-adc9-180c1837adc1",
                                "sense_id": "8f98b467-1e8c-32df-962b-270bd4f49887",
                                "text": "„Sie verschwand zwischen den Reihen aus Kleiderständern und brachte zwei Blazer und Hosen in drei neuen Farben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
