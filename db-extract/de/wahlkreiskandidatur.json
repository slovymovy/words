                                "example_id": "97809c5c-dc2b-4c76-9559-7c808699ad1f",
                                "sense_id": "9f95519d-d532-354d-bc15-acfbd5b6e64a",
                                "text": "„In Grimmen, bei ihrer Wahlkreiskandidatur, gibt es Momente, in denen sie unendlich müde wirkt.“"
                            },
