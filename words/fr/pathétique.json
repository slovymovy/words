    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4f403aae-a42c-315b-9aaf-4a6544f58cf6",
                    "sense_definition": "Qui inspire le mépris ou la pitié par sa médiocrité, sa faiblesse ou son ridicule.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "pitoyable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sa tentative d'explication était tellement <w>pathétique</w> que personne dans la salle n'y a cru."
                        },
                        {
                            "text": "Il a fait une scène <w>pathétique</w> devant tout le monde pour attirer l'attention des journalistes."
                        }
                    ],
                    "synonyms": [
                        "pitoyable"
                    ],
                    "common_phrases": [
                        "spectacle pathétique",
                        "tentative pathétique"
                    ]
                },
                {
                    "sense_id": "09917850-f515-3411-8cfd-b06a54a754b4",
                    "sense_definition": "Qui suscite une vive émotion de pitié, de tristesse ou de compassion.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "emouvant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le récit de ce réfugié est particulièrement <w>pathétique</w> et a bouleversé toute l'assemblée réunie."
                        },
                        {
                            "text": "L'acteur a interprété son rôle avec un ton <w>pathétique</w> qui a ému tous les spectateurs."
                        }
                    ],
                    "common_phrases": [
                        "ton pathétique",
                        "discours pathétique"
                    ]
                },
                {
                    "sense_id": "bd4f6737-89b2-3815-8ca4-3dfbda6b1c3e",
                    "sense_definition": "En ancienne terminologie anatomique, relatif au muscle oblique supérieur de l'œil ou au nerf crânien qui le dessert.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "anatomie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le nerf <w>pathétique</w> est l'ancien nom donné au nerf trochléaire par les spécialistes de l'anatomie."
                        },
                        {
                            "text": "Le médecin a examiné le muscle <w>pathétique</w> pour vérifier la bonne mobilité de l'œil du patient."
                        }
                    ],
                    "common_phrases": [
                        "nerf pathétique",
                        "muscle pathétique"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Ancienne nomenclature médicale"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9a159e63-d917-31c1-847e-cae791580414",
                    "sense_definition": "Caractère de ce qui émeut profondément, suscite la pitié ou l'angoisse dramatique.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette tragédie classique repose entièrement sur le <w>pathétique</w> de la situation dramatique des héros."
                        },
                        {
                            "text": "L'auteur évite le <w>pathétique</w> excessif afin de conserver un ton juste et sobre dans son roman."
