                "forms": [
                    {
                        "form_id": "bfbfa0c8-6728-4847-9f25-d72083edfe5a",
                        "entry_id": "65d976ef-2ff0-3642-a9c5-0904b0540faf",
                        "tags": [
                            "plural"
                        ],
                        "form": "radicalités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a83a9617-ba0f-31c8-abf9-3a92e2038981",
                        "entry_id": "65d976ef-2ff0-3642-a9c5-0904b0540faf",
                        "glosses": [
                            "Extrémisme, état de ce qui est radical."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "825d3ab2-e781-4d76-85da-9b55031ac969",
                                "sense_id": "a83a9617-ba0f-31c8-abf9-3a92e2038981",
                                "text": "…radicalité critique et analyse de la situation concrète, sans idéaliser la puissance d'une contreviolence révolutionnaire qui peut se révéler contreproductive, sans se faire non plus des illusions sur la bonne volonté des castes dirigeantes."
                            },
                            {
                                "example_id": "59d9a66e-c832-497d-ac83-b8d206afb70d",
                                "sense_id": "a83a9617-ba0f-31c8-abf9-3a92e2038981",
                                "text": "La secrétaire générale est décidée à resyndicaliser ses discours et à désarmer l'opposition par plus de radicalité."
                            },
                            {
                                "example_id": "b62849dc-c432-497c-8a0e-0c9cfe20c21e",
                                "sense_id": "a83a9617-ba0f-31c8-abf9-3a92e2038981",
                                "text": "Oui, ces phénomènes terroristes émanent d'une radicalité qu'il faut séparer de l'islam, mais on doit chercher les racines du mal du côté de ce qu'Abdelwahab Meddeb appelait \"la maladie de l'islam\", de ce que j'appelle tous les \"ismes\" de l'obscurantisme - dogmatisme, antisémitisme, machisme..."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2139c681-c746-4a1b-832d-8a173664bf9a",
                        "source_entry_id": "65d976ef-2ff0-3642-a9c5-0904b0540faf",
                        "source_sense_id": "a83a9617-ba0f-31c8-abf9-3a92e2038981",
                        "target_lang_word": "Radikalität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Radikalität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f6256489-61e2-3c45-ac46-a2d1b045223c",
                                        "entry_id": "76f243e4-e358-33b6-98e3-55168361b0b0",
                                        "glosses": [
                                            "Eigenschaft/Haltung/Handlungsweise, die in deutlichem Maße rücksichtsloses (radikales) Verhalten zeigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06f27fa5-9a67-4ced-b237-6bff16ea3fa7",
                                                "sense_id": "f6256489-61e2-3c45-ac46-a2d1b045223c",
                                                "text": "„Aber zugleich bedeutet der Friedenspakt mit den Sozialisten eine gründliche Vertagung aller Radikalitäten, und namentlich sozialer. Niemals ist der Kapitalismus besser geborgen als in den Zeiten, wo Sozialisten am Ruder sitzen.“"
                                            },
                                            {
                                                "example_id": "56ae07ea-1efc-4a6e-971f-9d8ee40684b0",
                                                "sense_id": "f6256489-61e2-3c45-ac46-a2d1b045223c",
                                                "text": "„[…] einmalig ist der Text auch, weil er ein in solcher Radikalität vom Autor früher nicht gewagtes und später nicht wiederholtes Experiment darstellt, dem eine achtjährige literarische Schaffenspause folgte.“"
                                            },
                                            {
                                                "example_id": "960bdaf3-35ba-4550-a816-01b29c87335d",
                                                "sense_id": "f6256489-61e2-3c45-ac46-a2d1b045223c",
                                                "text": "„In der endzeitlichen Radikalität erkannten alle, die sie nicht teilten, die gefährlichste Bedrohung jeder konfessionellen Konsolidierung, sei es aufseiten der Reformation oder aufseiten der Gegenreformation.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cc37dff5-e67c-4e52-941a-64ecba9a799d",
                        "source_entry_id": "65d976ef-2ff0-3642-a9c5-0904b0540faf",
                        "source_sense_id": "a83a9617-ba0f-31c8-abf9-3a92e2038981",
