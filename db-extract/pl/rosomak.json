                                ]
                            },
                            {
                                "target_word": "glotón",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "1d2d80b5-3842-308d-b57b-b135b566e161",
                                        "entry_id": "ff84e942-61e6-36d4-9ed8-cbf8b4d20e1a",
                                        "glosses": [
                                            "(Gulo gulo) Mamífero carnívoro de cuerpo robusto y pelaje largo y denso, cuyo aspecto recuerda al del oso. Es también el más grande de los mustélidos, llegando a pesar 20 e incluso 30 kg."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6d2db191-746d-4bd2-81b7-e19029642cac",
                        "source_entry_id": "61876372-6d3b-3215-935a-9a809809b9aa",
                        "source_sense_id": "22e7ae6a-fd9b-397a-a18d-34fb3aeefb3e",
                        "target_lang_word": "veelvraat",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "veelvraat",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "a004fe43-454d-39ef-8a03-4c0fe951993c",
                                        "entry_id": "f9556870-34e5-358e-8a23-c1a9d250999a",
                                        "glosses": [
                                            "bepaald soort zoogdier, Gulo gulo, een marterachtig roofdier, de grootste in de familie Mustelidae"
                                        ],
                                        "tags": [
                                            "roofdieren"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84e42e53-77ad-49dc-8555-e5e5a26dd62e",
                                                "sense_id": "a004fe43-454d-39ef-8a03-4c0fe951993c",
                                                "text": "Met zijn gewicht tot 35 kilo is de veelvraat (ook wel warg genaamd) de zwaarste Europese marterachtige. Hij kan een lengte van maximaal 85 cm. hebben met een staart van 15 cm. Hij heeft donkere haren met lichte vlekken op de kop en gele aan de zijkant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7cfbeb02-26f9-3cfb-ae25-2e6501c57b90",
                                        "entry_id": "f9556870-34e5-358e-8a23-c1a9d250999a",
                                        "glosses": [
                                            "dagactieve nachtvlinder en rups Macrothylacia rubi"
                                        ],
                                        "tags": [
                                            "vlinders"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fc6f0db7-30cd-31ce-b3dd-7653793c098c",
                                        "entry_id": "f9556870-34e5-358e-8a23-c1a9d250999a",
                                        "glosses": [
                                            "vraatzuchtig, gulzig persoon of dier, een gulzigaard"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14321cf1-33cc-4a7d-a244-30dd3fb37cdf",
                                                "sense_id": "fc6f0db7-30cd-31ce-b3dd-7653793c098c",
                                                "text": "Een luieraar en een luiwammes verschillen evenveel van elkaar als een lekkerbek en een veelvraat. Keek naar het verheven genot van parende libellen. Hoorde zelfs hun vleugels, een extatisch geluid, als flapperend papier tussen de spaken van een fiets. Tuurde naar een hazelworm die rond de wortels waar ik lag een miniatuur-Amazone verkende. Stilte? Niet helemaal, nee."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4e3cc7d4-551b-4bac-896d-180a37cc3a06",
                        "source_entry_id": "61876372-6d3b-3215-935a-9a809809b9aa",
                        "source_sense_id": "22e7ae6a-fd9b-397a-a18d-34fb3aeefb3e",
                        "target_lang_word": "Vielfraß",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vielfraß",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "679a43fd-9b96-3c1e-9d5f-a01f9b9751da",
                                        "entry_id": "d689d32c-d718-3a4c-9f69-bb9f7ab9a14c",
                                        "glosses": [
                                            "im hohen Norden Eurasiens und Amerikas lebende Raubtierart aus der Familie der Marder (Mustelidae), mit gedrungenem Körper, kräftigen Gliedmaßen, zottigem dunkelbraunem oder schwarzem Fell und oft einer hellen Bandzeichnung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9709a34-60b8-42d3-ae1b-a537f78ca2f5",
                                                "sense_id": "679a43fd-9b96-3c1e-9d5f-a01f9b9751da",
                                                "text": "Vielfraß ist eine Tierart."
                                            },
                                            {
                                                "example_id": "bd5df696-c143-49f7-9241-ff6cf159b141",
                                                "sense_id": "679a43fd-9b96-3c1e-9d5f-a01f9b9751da",
                                                "text": "„Der Vielfraß nutzt Analdrüsen dazu, sein Territorium zu markieren.“"
                                            },
                                            {
                                                "example_id": "2e527444-0518-4adc-9785-f7a458594914",
                                                "sense_id": "679a43fd-9b96-3c1e-9d5f-a01f9b9751da",
                                                "text": "„Er sieht aus wie ein kleiner Bär, hat mächtige Kiefer wie eine Hyäne, und die Finnen nennen ihn \"Felsenkatze\". Viele Mythen ranken sich um den Vielfraß, den größten Marder der Welt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6f1e78b0-2bce-3e8a-9c30-992da0502f2f",
                                        "entry_id": "d689d32c-d718-3a4c-9f69-bb9f7ab9a14c",
                                        "glosses": [
                                            "für eine Person, die (zu) viel isst"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "daed148f-a3a0-4a15-bd4f-7061319572de",
                                                "sense_id": "6f1e78b0-2bce-3e8a-9c30-992da0502f2f",
                                                "text": "Obelix ist ein echter Vielfraß."
                                            },
                                            {
                                                "example_id": "a0db301b-3aa7-4946-858b-ad3360b6750c",
                                                "sense_id": "6f1e78b0-2bce-3e8a-9c30-992da0502f2f",
                                                "text": "„Erich Snider wirkte völlig bedürfnislos, und auch seine Tochter machte nicht den Eindruck eines Vielfraßes, sondern schien eher gleichgültig gegenüber kulinarischen Genüssen.“"
                                            },
                                            {
                                                "example_id": "e4ea9807-0c3c-4afa-8edb-ba63d84a1ecf",
                                                "sense_id": "6f1e78b0-2bce-3e8a-9c30-992da0502f2f",
                                                "text": "„Mandrill Enuro ist ein Vielfraß. Als Chef der Affenbande pickt er sich immer die süßesten und kalorienreichsten Stücke aus dem morgendlichen Buffet raus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "83016b2b-c2f5-4a4d-bc48-7db43181460e",
                        "source_entry_id": "61876372-6d3b-3215-935a-9a809809b9aa",
                        "source_sense_id": "22e7ae6a-fd9b-397a-a18d-34fb3aeefb3e",
                        "target_lang_word": "росомаха",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "росомаха",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "7a784be6-3b79-3e79-abb5-f0fb8ba722c7",
                                        "entry_id": "6723ad10-b273-3ebb-81d8-8558c95e5d65",
                                        "glosses": [
                                            "зоол. хищное млекопитающее семейства куньих"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "206f07c7-de19-420b-9f2a-5f911581c817",
                                                "sense_id": "7a784be6-3b79-3e79-abb5-f0fb8ba722c7",
                                                "text": "Чаще росомах бьют настороженными ружьями и луками, ловят в ямы, капканами и другими снастями; в Сибири эти снасти устраиваются таким образом, чтобы росомаха могла добраться до приманки не иначе, как лёгши на спину; в противном случае, придавленная ловушкой по спине, росомаха, обладая чрезвычайной крепостью корпуса и силой в ногах, ухитряется освободиться."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
