                                        "glosses": [
                                            "The cherry-like fruit of such plants, certain of which are edible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d8541c6-ab74-4e48-a7cf-08559384a70b",
                                                "sense_id": "7df4ba6e-dc39-3a87-ba8b-4b0393736f33",
                                                "text": "Cornels, and ſalvage Berries of the Wood, / And Roots and Herbs have been my meagre Food."
                                            },
                                            {
                                                "example_id": "8877faf0-de7e-4dc3-9c16-006fcc11c4de",
                                                "sense_id": "7df4ba6e-dc39-3a87-ba8b-4b0393736f33",
