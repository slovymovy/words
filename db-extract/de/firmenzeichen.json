                "senses": [
                    {
                        "sense_id": "e63401c3-7997-303e-a216-745877b1d004",
                        "entry_id": "0a4b4818-0ac4-33a1-8363-26967631e2f1",
                        "glosses": [
                            "Zeichen einer Firma, zum Beispiel auf deren Produkten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fdb90eea-8b73-4c0a-822b-319e63fdd095",
                                "sense_id": "e63401c3-7997-303e-a216-745877b1d004",
                                "text": "Ein Schokoladenhersteller verwendet als Firmenzeichen eine Kuh."
                            },
                            {
                                "example_id": "53bfd62f-9dbd-440e-a2d9-dfe402cf4b6e",
                                "sense_id": "e63401c3-7997-303e-a216-745877b1d004",
                                "text": "„Er hatte keinerlei Verständnis für den Überschuh, der das Firmenzeichen eines Schuhwarenhändlers gewesen war, noch für das Steingutfäßchen, einen gewöhnlichen Apfelweinkrug; und der heilige Petrus mit seinem Säufergesicht sei, offen gesagt, geradezu jämmerlich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "639136da-d7dc-49f9-8e27-450e527eec8d",
                        "source_entry_id": "0a4b4818-0ac4-33a1-8363-26967631e2f1",
                        "source_sense_id": "e63401c3-7997-303e-a216-745877b1d004",
                        "source_sense_description": "Zeichen einer Firma, zum Beispiel auf deren Produkten",
