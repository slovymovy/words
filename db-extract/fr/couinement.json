            {
                "entry_id": "c041555e-da3a-38fe-9f5d-92a2d543fe92",
                "word": "couinement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5bd2ca37-14f3-47eb-bf4d-2fc674054898",
                        "entry_id": "c041555e-da3a-38fe-9f5d-92a2d543fe92",
                        "tags": [
                            "plural"
                        ],
                        "form": "couinements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6b0de23c-36d4-3f0b-bfb1-484f4e1749ac",
                        "entry_id": "c041555e-da3a-38fe-9f5d-92a2d543fe92",
                        "glosses": [
                            "Grincement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ef23ba8-2dde-42aa-944f-0ce98c58eb53",
                                "sense_id": "6b0de23c-36d4-3f0b-bfb1-484f4e1749ac",
                                "text": "Il range ensuite la bouteille avec d’infinies précautions, mais il est trahi par la porte disjointe du buffet dont les gonds en pivotant font entendre un léger couinement."
                            },
                            {
                                "example_id": "9a1159db-2373-4fe4-a5d2-f153c51d6a92",
                                "sense_id": "6b0de23c-36d4-3f0b-bfb1-484f4e1749ac",
                                "text": "Sur les marches, leurs semelles produisaient de désagréables couinements que réverbérait la cage d’escalier."
                            }
                        ]
                    },
                    {
                        "sense_id": "8c150791-400b-34b4-8f9a-15fa7c82f2f4",
                        "entry_id": "c041555e-da3a-38fe-9f5d-92a2d543fe92",
                        "glosses": [
                            "Cri du lapin et du lièvre lorsqu’ils sont pris en chasse."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "933a8b02-20b1-356a-a7d0-8bde1a2cec82",
                        "entry_id": "c041555e-da3a-38fe-9f5d-92a2d543fe92",
                        "glosses": [
                            "Cri animal aigu."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "388b4957-31f2-43bc-9921-5cbad0b9a40f",
                                "sense_id": "933a8b02-20b1-356a-a7d0-8bde1a2cec82",
                                "text": "Les bruits de la brousse — craquements, caquètements, craquètements, cliquètements, coassements, croassements, criaillements, couinements, chuchotements — forment un langage secret."
                            },
                            {
                                "example_id": "a4722f6f-fb70-439e-9704-befb72cb709c",
                                "sense_id": "933a8b02-20b1-356a-a7d0-8bde1a2cec82",
                                "text": "Il avait parcouru le relevé de mon compte, enregistrant d’un couinement approbateur l’arrivée systématique depuis plusieurs semaines, dans la colonne des recettes, des sommes gagnées grâce à mes cours de français et mes heures de travail de nuit dans les locaux de la Gazette régionale."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "60649c23-2728-448e-838d-2a8b52562cc6",
                        "source_entry_id": "c041555e-da3a-38fe-9f5d-92a2d543fe92",
