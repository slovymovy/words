                    "sense_id": "93230c8c-1238-3ae7-a5e8-06cbd2a84719",
                    "sense_definition": "ein gedrucktes Dokument oder Bild mithilfe eines optischen Geräts digital erfassen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "digitalisieren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das moderne Gerät im Büro kann drucken, <w>scannen</w> und kopieren."
                        },
                        {
                            "text": "Ich muss den Vertrag noch schnell <w>scannen</w> und per Mail senden."
                        }
                    ],
                    "synonyms": [
