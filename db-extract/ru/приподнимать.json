                    },
                    {
                        "translation_id": "b21ec514-6e9e-4a59-8171-54368e63bbf7",
                        "source_entry_id": "11fddd35-d71a-3393-a3d2-5f4913c64518",
                        "source_sense_description": "возбуждать, оживлять",
                        "target_lang_word": "uplift",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "uplift",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "338e55cf-87fa-37ef-a001-e9708e2da39f",
                                        "entry_id": "8dea4fea-c360-3a11-92e4-31d9293c21e0",
                                        "glosses": [
                                            "To raise something or someone to a higher physical, social, moral, intellectual, spiritual or emotional level."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58202ff9-0d7f-4957-b4ae-c1f1eb154798",
                                                "sense_id": "338e55cf-87fa-37ef-a001-e9708e2da39f",
                                                "text": "Whether you find it by your power as a man, or because, being near the gods, a god has whispered you. Uplift our State; think upon your fame; your coming brought us luck, be lucky to us still, remember that it is better to rule over men than over a waste place, since neither walled town nor ship is anything if it be empty and no man within it."
                                            },
                                            {
                                                "example_id": "8406ffb9-4f55-4096-b076-e34528bbb9fa",
                                                "sense_id": "338e55cf-87fa-37ef-a001-e9708e2da39f",
                                                "text": "They recognised that their free-lay properties were just right for premises where there had to be easy access to underfloor cables or where office layouts needed to be readily changed without having to uplift the carpet every time."
                                            },
                                            {
                                                "example_id": "ee0a4093-6bca-40fc-badf-412501345664",
                                                "sense_id": "338e55cf-87fa-37ef-a001-e9708e2da39f",
                                                "text": "At the behest of the London Midland Region, the infrastructure was built with a capability for running at up to 110mph with conventional rolling stock, as well as the raising of speed limits - such as the 60mph over Shap summit uplifted to 80mph."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3b647f2-a80c-3d6d-994b-49d2dad1e99f",
                                        "entry_id": "8dea4fea-c360-3a11-92e4-31d9293c21e0",
                                        "glosses": [
                                            "To raise something or someone to a higher physical, social, moral, intellectual, spiritual or emotional level.",
                                            "To raise (a nonsentient species) into sentience."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c1deb2d-9292-4d45-a299-18bb5965198b",
                                                "sense_id": "d3b647f2-a80c-3d6d-994b-49d2dad1e99f",
                                                "text": "—genetically uplifted the ancestors of the saurs, and culturally—at least—uplifted the kraken. We are used to thinking of these species as wise and ancient, which indeed they are, but the octopods are their 'Elder Race.'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "589d266c-419a-3d3a-a4ed-e3b10f8a1a60",
                                        "entry_id": "8dea4fea-c360-3a11-92e4-31d9293c21e0",
                                        "glosses": [
                                            "To aggravate; to increase."
                                        ],
                                        "tags": [
                                            "of a penalty"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9def407b-947c-4cc8-9c87-10a942d3471c",
                                                "sense_id": "589d266c-419a-3d3a-a4ed-e3b10f8a1a60",
                                                "text": "A man who abused a Police Community Support Officer for being transgender has received an uplifted sentence at Mold Magistrates' Court... At Court the prosecutor applied for the sentence for the public order offence to be uplifted to reflect the hate crime aspect. This resulted in the Court imposing a greater penalty."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a48ffb6-8147-39fa-b09a-5b077b20008c",
                                        "entry_id": "8dea4fea-c360-3a11-92e4-31d9293c21e0",
                                        "glosses": [
                                            "To be accepted for carriage on a flight."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a37b4f16-dfb8-3068-a1d6-f765ff6fdc6a",
                                        "entry_id": "8dea4fea-c360-3a11-92e4-31d9293c21e0",
                                        "glosses": [
                                            "To remove (a child) from a damaging home environment by a social welfare organization."
                                        ],
                                        "tags": [
                                            "New-Zealand"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ccea5b7e-fb46-4e81-9f58-4cbd8ec16454",
                                                "sense_id": "a37b4f16-dfb8-3068-a1d6-f765ff6fdc6a",
                                                "text": "In an affidavit supporting an application for a court order to uplift the child, a social worker said there were ongoing family violence issues between the baby's mother and father."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ae9dcdf-6733-3e23-91cc-6276986d124c",
                                        "entry_id": "8dea4fea-c360-3a11-92e4-31d9293c21e0",
                                        "glosses": [
                                            "To remove (a document) from its current possessor and take it into one's own possession."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3b83a6c2-3f5d-3298-878f-38fa883362d5",
                                        "entry_id": "8dea4fea-c360-3a11-92e4-31d9293c21e0",
                                        "glosses": [
                                            "To backport."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "uplift",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6404436a-9e71-3374-9d4b-9d3deac9dd2a",
                                        "entry_id": "332e3303-78f6-35e7-b3af-2f961f9fd770",
                                        "glosses": [
                                            "The act or result of uplifting (in various senses)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74076e6f-9df5-4734-a8f9-5baa54c4717b",
                                                "sense_id": "6404436a-9e71-3374-9d4b-9d3deac9dd2a",
                                                "text": "The EMR Regional timetable improvements also include a significant uplift in Sunday services."
                                            },
                                            {
                                                "example_id": "f5416a28-d6a5-48ab-82ee-9fbc56b9dc29",
                                                "sense_id": "6404436a-9e71-3374-9d4b-9d3deac9dd2a",
                                                "text": "This means that while initial funding will come from the public purse, landowners along the route will eventually pay back a share of the uplift in land values created by the new line."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "267f36d7-92cd-3dee-b12f-5f7db0f443d5",
                                        "entry_id": "332e3303-78f6-35e7-b3af-2f961f9fd770",
                                        "glosses": [
                                            "A tectonic upheaval, especially one that takes place in the process of mountain building."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a636f60-8454-4988-8af6-093ca0c7c4fd",
                                                "sense_id": "267f36d7-92cd-3dee-b12f-5f7db0f443d5",
                                                "text": "Recent uplift of the Maine and Oregon coasts has not been enough to \"undrown\" the larger valleys; the shorelines are still submergent."
                                            },
                                            {
                                                "example_id": "3ae10884-6664-4d04-a9e3-f2a2f15aa46e",
                                                "sense_id": "267f36d7-92cd-3dee-b12f-5f7db0f443d5",
                                                "text": "This is explained as an uplift in the coast at a rate of 16.2 mm/y in the period before 1900, a downlift of 2.8 mm/y in the period 1900-1906 and a rapid «sinking» of the coast at 22.7 mm/y in the 24 months before the earthquake."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60f589bb-c5ea-3f79-a862-70cc4aaf5061",
                                        "entry_id": "332e3303-78f6-35e7-b3af-2f961f9fd770",
                                        "glosses": [
                                            "The picking up and loading of goods to be transported by a mover."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f9c7d68f-bc03-3acd-91b4-036ee1b915f8",
                                        "entry_id": "332e3303-78f6-35e7-b3af-2f961f9fd770",
                                        "glosses": [
                                            "A brassiere that raises the breasts."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "935d9e09-da07-4e53-9959-e3414566ef1d",
                                                "sense_id": "f9c7d68f-bc03-3acd-91b4-036ee1b915f8",
                                                "text": "Dressed in a light silk brassiere and scanties, which was all she wore under her frock, she was unkind enough to say, \"I think those uplift fakes of yours are a mistake, Sadie dear. They raise false expectations in the amorous male.\" \"But my breasts are all right,\" said Sadie, hurt, and pushing her breasts up from under to prove they were in the right place[.]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a72f52e4-a2d1-39f0-a73a-1fe53772bd75",
                                        "entry_id": "332e3303-78f6-35e7-b3af-2f961f9fd770",
                                        "glosses": [
                                            "An increase in a fine or penalty due to aggravating circumstances."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19b6d902-07e5-4f67-b214-a2877b793e32",
                                                "sense_id": "a72f52e4-a2d1-39f0-a73a-1fe53772bd75",
                                                "text": "The CMA fined the companies involved £3.4 million, which included uplifts for director level involvement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
