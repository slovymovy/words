                "senses": [
                    {
                        "sense_id": "e3518a4c-02d6-31ef-9ca0-589c199d4532",
                        "entry_id": "937973d4-8ab2-3978-9e15-d3b7f3566e89",
                        "glosses": [
                            "Plantation de cyprès."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5e921ba-f781-4c84-a145-ca9f4e95fd50",
                                "sense_id": "e3518a4c-02d6-31ef-9ca0-589c199d4532",
                                "text": "Outougamitz se sentit près de mourir de joie lorsqu’il aborda la cyprière."
                            },
                            {
                                "example_id": "3fb8cddb-c9c8-40e1-8ce6-a51366506920",
                                "sense_id": "e3518a4c-02d6-31ef-9ca0-589c199d4532",
                                "text": "Les grues qui font de si beaux voyages au-dessus des savannes, des cyprières."
                            },
                            {
                                "example_id": "b9be6258-3b54-4d79-bdba-37b5f257ac94",
                                "sense_id": "e3518a4c-02d6-31ef-9ca0-589c199d4532",
                                "text": "Rien de ce qui existait sur terre ne pouvait vivre dans ma grand’mère, de l’autre côté de ses yeux : ni la ville avec sa peau de truite sur laquelle passaient les frissons verts, roses et bleus des tuiles, des zincs, des verrières et des fumées ; ni l’amphithéâtre des collines de craie, ni les lointains villages d’or pendus à des rostres de roches comme des boucliers, ni la mer qui haletait contre nos falaises déchiquetées comme le ventre sensible d’un immense lézard, ni les vastes et lointains paysages chargés de bosquets, d’aqueducs, de cyprières, d’olivaies, de prés, de garrigues et du troupeau pressé des montagnes qui, au-delà de notre cirque de collines, s’arrondissait vers Aix et les Alpes."
                            }
                        ]
                    }
