                "senses": [
                    {
                        "sense_id": "c53a8d66-d0ed-3a16-ac69-21c6fd8ce061",
                        "entry_id": "eab3d132-6e36-33ee-9fb2-1b37f887185d",
                        "glosses": [
                            "spezielle Bauart von Zahnradgetrieben, bei der sich mehrere äußere Zahnräder um ein inneres Zahnrad drehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2870f5de-c529-41ba-b363-51dc594207c5",
                                "sense_id": "c53a8d66-d0ed-3a16-ac69-21c6fd8ce061",
                                "text": "Planetengetriebe werden dort eingesetzt, wo wenig Platz zur Verfügung steht."
                            },
                            {
                                "example_id": "3bc2ed2c-0e91-4583-ad36-ebb4aace4c12",
                                "sense_id": "c53a8d66-d0ed-3a16-ac69-21c6fd8ce061",
                                "text": "„Die Schnittstelle zwischen Verbrennungs- und Hydraulikmotor ist ein Planetengetriebe.“"
                            },
                            {
                                "example_id": "958ebaeb-44ad-4647-aa7c-aaaf79088c3c",
                                "sense_id": "c53a8d66-d0ed-3a16-ac69-21c6fd8ce061",
                                "text": "„Im Normalfall bewegt der große Elektromotor die Vorderräder des Autos alleine, bei starker Beschleunigung wird der Generator über ein Planetengetriebe dazugekoppelt, und beide E-Maschinen sorgen für Vortrieb.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
