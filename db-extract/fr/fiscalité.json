                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "fbcf2a65-d73c-4d39-b87b-d30d0a967bad",
                                "sense_id": "1043edcd-41ab-3564-8805-c4cfda67ac27",
                                "text": "Esprit de fiscalité."
