                "senses": [
                    {
                        "sense_id": "0508ccc0-59c3-34d1-9581-5c7e23889325",
                        "entry_id": "0d36566f-49e8-365d-908e-c8bc684ec02a",
                        "glosses": [
                            "członek stronnictwa zawiązanego wokół arystokracji kapłańskiej i rodowej starożytnego Izraela istniejącego między II w. p.n.e. a I w. n.e. przeciwstawiającego się faryzeuszom, uznającego Torę pisaną za jedyne źródło objawienia i odrzucającego tradycję ustną"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70cc930c-e171-4c18-af1d-c19b21c59678",
                                "sense_id": "0508ccc0-59c3-34d1-9581-5c7e23889325",
                                "text": "Jeżeli nawet niektórzy Żydzi skłaniali się do wiary w życie po śmierci, saduceusze przeciwnie, uczyli, że Biblii obcy jest taki pogląd […]."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
