                "senses": [
                    {
                        "sense_id": "d0cc4edc-5429-3a73-9d15-34297ed4aee1",
                        "entry_id": "f5ff0437-63e9-3fd2-baf1-25318ab822c2",
                        "glosses": [
                            "etwas besonders Großes/Wichtiges"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "2074f7ee-5484-4ab1-b98d-825507502c20",
                                "sense_id": "d0cc4edc-5429-3a73-9d15-34297ed4aee1",
                                "text": "Der Hecht, den mein Bruder aus dem Stadtweiher zog, war ein Riesending."
                            },
                            {
                                "example_id": "8991cb6f-acca-42fc-b347-d0d6417e0628",
                                "sense_id": "d0cc4edc-5429-3a73-9d15-34297ed4aee1",
                                "text": "„Das ist ja ein Riesending, das da im Weltall installiert ist, mit mehreren Stockwerken und nach außen hin durchsichtig, so daß man also die Erde sehen kann.“"
                            },
                            {
                                "example_id": "26967701-aec9-4f61-a2a9-23b7cab0c055",
                                "sense_id": "d0cc4edc-5429-3a73-9d15-34297ed4aee1",
                                "text": "„Ja, klar, denn die WM hautnah vor der Haustüre und bei uns im Stadion zu erleben, ist ein Riesending.“"
                            },
                            {
                                "example_id": "9ea5ae5d-1e28-46f4-935f-c0cbbe0de1de",
                                "sense_id": "d0cc4edc-5429-3a73-9d15-34297ed4aee1",
                                "text": "„Der Wunsch der guten Nolte, war eine große Brust. Auf so schöne Riesendinger, hatte sie echt Lust.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
