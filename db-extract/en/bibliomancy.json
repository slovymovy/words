                                        "entry_id": "a171be11-b37d-3867-a229-d2c4cf6c052c",
                                        "glosses": [
                                            "Wahrsagung mithilfe von heiligen oder bedeutenden Texten, insbesondere der Bibel oder des I Ging"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44f2cae2-9fa6-4c45-b95e-0cb7b3b985cd",
                                                "sense_id": "8c8749d0-fc66-3dae-8bd8-8d9fef5444bd",
                                                "text": "Durch die Bibliomantie hatte er erfahren, dass er eines Tages reich sein wird."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
