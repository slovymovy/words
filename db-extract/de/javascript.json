                "senses": [
                    {
                        "sense_id": "415af408-3ddd-3b50-b73f-cbe749251e12",
                        "entry_id": "6d581dcf-9533-31e6-b917-2c25fdeb7c52",
                        "glosses": [
                            "objektorientierte, plattformunabhängige Skriptsprache, die ursprünglich für die Darstellung von dynamischem HTML in Webbrowsern entwickelt wurde"
                        ],
                        "tags": [
                            "Skriptsprache"
                        ],
                        "examples": [
                            {
                                "example_id": "e98e69ca-9986-48bc-8142-bba2a4690049",
                                "sense_id": "415af408-3ddd-3b50-b73f-cbe749251e12",
                                "text": "„Add-ons wie Ghostery helfen ein wenig, sind aber keine perfekte Lösung. Zuverlässiger sei der Tor-Browser, sagt Günes Acar von der KU Leuven, weil er standardmäßig auf Flash und JavaScript verzichtet.“"
                            },
                            {
                                "example_id": "14af2fb4-b745-4f19-be8a-a5065e919d28",
                                "sense_id": "415af408-3ddd-3b50-b73f-cbe749251e12",
                                "text": "„Die gängigen Browser (Netscape und der Internet Explorer) beherrschen JavaScript, aber JavaScript läßt sich auch deaktivieren.“"
                            },
                            {
                                "example_id": "a4a99610-8a77-4886-a0a0-3b9c330e0453",
                                "sense_id": "415af408-3ddd-3b50-b73f-cbe749251e12",
                                "text": "„Das macht man nicht mit Maus oder Tastatur, sondern mit Programmierbefehlen in Python oder Javascript, zwei sehr verbreiteten Programmiersprachen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "23ccbaa9-fcaa-448c-912b-9af4a4919cec",
                        "source_entry_id": "6d581dcf-9533-31e6-b917-2c25fdeb7c52",
                        "source_sense_id": "415af408-3ddd-3b50-b73f-cbe749251e12",
