                    {
                        "sense_id": "d97b048e-2337-3ee1-a3b1-459c57ae19e4",
                        "entry_id": "a4b64665-93d1-3a28-9b5e-7e5c6d2d60b9",
                        "glosses": [
                            "paardensprong waarbij tijdens het zweefmoment de achterbenen fel achteruit slaan, aanvankelijk ter verdediging tegen belagers (soldaten, wolven)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32d29d93-0c22-4797-bdd8-0fff3a71c63b",
                                "sense_id": "d97b048e-2337-3ee1-a3b1-459c57ae19e4",
                                "text": "In de Spaanse rijschool kan men mooie sprongen bewonderen zoals de spectaculaire capriool."
                            }
                        ]
                    },
                    {
                        "sense_id": "6b7aae53-07a9-3eb2-9523-3c9962c1cb44",
                        "entry_id": "a4b64665-93d1-3a28-9b5e-7e5c6d2d60b9",
                        "glosses": [
                            "een onbezonnen daad, een gekke streek"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "b927fd19-7e05-4d16-baf1-001d9b6d8481",
                                "sense_id": "6b7aae53-07a9-3eb2-9523-3c9962c1cb44",
                                "text": "- Na dat verlies kan hij zich geen financiële capriolen meer veroorloven."
                            },
                            {
                                "example_id": "cc9443d4-d7c1-4094-8531-bc282d2dc61b",
                                "sense_id": "6b7aae53-07a9-3eb2-9523-3c9962c1cb44",
                                "text": "- Ander onmiskenbaar veldkenmerk: de houtduif vliegt op met luid vleugelgeklepper. In de stad ontwijkt hij elke keer in een snelle capriool de aanstormende fiets of auto."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b0245289-8883-4e3c-97db-06568c246a13",
                        "source_entry_id": "a4b64665-93d1-3a28-9b5e-7e5c6d2d60b9",
                        "source_sense_id": "d97b048e-2337-3ee1-a3b1-459c57ae19e4",
