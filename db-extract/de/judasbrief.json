                "senses": [
                    {
                        "sense_id": "6d416e8b-dbf3-3907-ae04-f959fe87f41d",
                        "entry_id": "a27d38c9-7d96-3640-92b1-5fe08106294c",
                        "glosses": [
                            "ein um 80 n. Chr. verfasster, flugblattartiger Brief an jene Gemeinden, die von der gnostisch-libertinistischen Irrlehre, deren Anhänger sich höherer Erkenntnis rühmen, bedroht werden"
                        ],
                        "tags": [
                            "Theologie"
                        ],
                        "examples": [
                            {
                                "example_id": "7ea30679-fb74-4254-9518-da73e2aa98cd",
                                "sense_id": "6d416e8b-dbf3-3907-ae04-f959fe87f41d",
                                "text": "„Die Henochapokalypse ist im Neuen Testament selbst als prophetische Schrift anerkannt und wird im Judasbrief als Autorität zitiert.“"
                            },
                            {
                                "example_id": "c56fdcab-ef81-4236-8e14-6ec61c5d0f4d",
                                "sense_id": "6d416e8b-dbf3-3907-ae04-f959fe87f41d",
                                "text": "„Tatsächlich richtet sich der Judasbrief »an die Berufenen, die von Gott, dem Vater, geliebt und für Jesus Christus bestimmt und bewahrt sind« (V. 1).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
