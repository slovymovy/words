                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "arme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le collectionneur a examiné avec soin le <w>fusil</w> de cette arquebuse ancienne."
                        },
                        {
                            "text": "Le silex venait heurter violemment le <w>fusil</w> pour enflammer la poudre du bassinet."
                        }
                    ],
                    "synonyms": [
                        "batterie"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Armurerie ancienne"
                        }
                    ]
                },
                {
                    "sense_id": "4b3959d1-700b-3513-92ee-48b400a1c1de",
                    "sense_definition": "Estomac, dans la langue familière ou argotique.",
