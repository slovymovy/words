{
    "word_family": [
        "separation",
        "separator",
        "separable",
        "separately",
        "inseparable"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "bc25bfd7-dc15-3be6-87a2-b769fc2f021f",
                    "sense_definition": "Not connected to or attached to anything else; existing or happening apart from others.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "adj_distinct",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please pack the shoes in a <w>separate</w> bag to keep the clothes clean.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, упакуй обувь в <w>отдельный</w> пакет, чтобы не испачкать одежду.",
                                "zh": "请把鞋子装进一个<w>单独的</w>袋子里，以保持衣服干净。"
                            }
                        },
                        {
                            "text": "The children sleep in <w>separate</w> bedrooms now that they are older.",
                            "target_lang_translations": {
                                "ru": "Теперь, когда дети стали старше, они спят в <w>отдельных</w> спальнях.",
                                "zh": "孩子们长大了，现在睡在<w>分开的</w>卧室里。"
                            }
                        }
                    ],
                    "synonyms": [
                        "detached",
                        "distinct",
                        "unconnected",
                        "independent",
                        "discrete",
                        "different"
                    ],
                    "antonyms": [
                        "joined",
                        "unified",
                        "conjunct"
                    ],
                    "common_phrases": [
                        "separate room",
                        "separate ways",
                        "separate entity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не соединенный с чем-либо еще; существующий или происходящий отдельно от других.",
                        "zh": "不与任何其他事物相连或附着；独立存在或发生。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отдельный",
                                "target_lang_sense_clarification": "существующий сам по себе, обособленный"
                            },
                            {
                                "target_lang_word": "раздельный",
                                "target_lang_sense_clarification": "не совместный, осуществляемый порознь"
                            },
                            {
                                "target_lang_word": "обособленный",
                                "target_lang_sense_clarification": "изолированный, стоящий особняком"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "单独的",
                                "target_lang_sense_clarification": "指某物是独立的，不与其他事物混在一起"
                            },
                            {
                                "target_lang_word": "分开的",
                                "target_lang_sense_clarification": "指事物之间存在间隔或不相连"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "396dec11-b569-31a4-bc7a-971af7d26fe2",
                    "sense_definition": "To cause people or things to be apart from one another; to divide something into parts or keep them from touching.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "verb_divide",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A high wall <w>separates</w> the garden from the street.",
                            "target_lang_translations": {
                                "ru": "Высокая стена <w>отделяет</w> сад от улицы.",
                                "zh": "一堵高墙把花园和街道<w>隔开</w>了。"
                            }
                        },
                        {
                            "text": "The referee had to <w>separate</w> the players to stop the fight.",
                            "target_lang_translations": {
                                "ru": "Судье пришлось <w>разнять</w> игроков, чтобы прекратить драку.",
                                "zh": "裁判不得不把球员们<w>分开</w>以制止打架。"
                            }
                        }
                    ],
                    "synonyms": [
                        "divide",
                        "disconnect",
                        "split",
                        "detach",
                        "sever",
                        "isolate",
                        "part"
                    ],
                    "antonyms": [
                        "combine",
                        "annex"
                    ],
                    "common_phrases": [
                        "separate the wheat from the chaff",
                        "separate fact from fiction"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разъединять людей или предметы; делить что-либо на части или препятствовать их соприкосновению.",
                        "zh": "使人或事物彼此分开；将某物分成若干部分或防止它们接触。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отделять",
                                "target_lang_sense_clarification": "проводить границу, отграничивать одно от другого"
                            },
                            {
                                "target_lang_word": "разделять",
                                "target_lang_sense_clarification": "делить на части или разъединять кого-то"
                            },
                            {
                                "target_lang_word": "разъединять",
                                "target_lang_sense_clarification": "нарушать соединение, связь между предметами"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "分开",
                                "target_lang_sense_clarification": "使连接在一起的事物不再相连"
                            },
                            {
                                "target_lang_word": "隔开",
                                "target_lang_sense_clarification": "在两者之间设置障碍或界限"
                            },
                            {
                                "target_lang_word": "拆散",
                                "target_lang_sense_clarification": "指将原本在一起的人或物分开"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "325d267e-9eba-3674-b7b1-8e204b9a45f8",
                    "sense_definition": "To stop living together as a couple; to divide into different parts or substances naturally.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "verb_intransitive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My parents decided to <w>separate</w> after twenty years of marriage.",
                            "target_lang_translations": {
                                "ru": "Мои родители решили <w>разойтись</w> после двадцати лет брака.",
                                "zh": "我父母在结婚二十年后决定<w>分居</w>。"
                            }
                        },
                        {
                            "text": "If you let the dressing sit, the oil will <w>separate</w> from the vinegar.",
                            "target_lang_translations": {
                                "ru": "Если дать заправке постоять, масло <w>отделится</w> от уксуса.",
                                "zh": "如果你让调料静置，油就会从醋中<w>分离</w>出来。"
                            }
                        }
                    ],
                    "synonyms": [
                        "split up",
                        "break up",
                        "part"
                    ],
                    "common_phrases": [
                        "separate from"
                    ],
                    "target_lang_definitions": {
                        "ru": "Перестать жить вместе (о паре); естественным образом разделяться на разные части или вещества.",
                        "zh": "指伴侣停止共同生活；或指物质自然地分解成不同的部分。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расходиться",
                                "target_lang_sense_clarification": "прекращать отношения, переставать жить вместе"
                            },
                            {
                                "target_lang_word": "отделяться",
                                "target_lang_sense_clarification": "о веществах: отходить, обособляться от смеси"
                            },
                            {
                                "target_lang_word": "разделяться",
                                "target_lang_sense_clarification": "распадаться на составные части"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "分居",
                                "target_lang_sense_clarification": "指夫妻停止共同生活"
                            },
                            {
                                "target_lang_word": "分离",
                                "target_lang_sense_clarification": "指物质从混合物中析出或分开"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1e61e4cc-d925-3992-99c6-584477bb85f7",
                    "sense_definition": "Individual items of clothing, such as skirts, trousers, or jackets, that are sold individually and can be worn in different combinations.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "noun_clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She prefers buying <w>separates</w> because they are easier to mix and match.",
                            "target_lang_translations": {
                                "ru": "Она предпочитает покупать <w>отдельные вещи</w>, потому что их легче комбинировать.",
                                "zh": "她更喜欢买<w>单件服装</w>，因为它们更容易搭配。"
                            }
                        },
                        {
                            "text": "The store offers a wide collection of silk <w>separates</w> for evening wear.",
                            "target_lang_translations": {
                                "ru": "Магазин предлагает широкую коллекцию шелковых <w>предметов одежды</w> для вечернего гардероба.",
                                "zh": "这家店提供各种适合晚装的丝绸<w>单件服装</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "usually plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отдельные предметы одежды (юбки, брюки, пиджаки), которые продаются отдельно и могут комбинироваться друг с другом.",
                        "zh": "可单独购买并能自由搭配的服装单品，如裙子、裤子或上衣。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отдельные предметы одежды",
                                "target_lang_sense_clarification": "вещи, не являющиеся частью костюма"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "单件服装",
                                "target_lang_sense_clarification": "指非套装的、可自由组合的服装"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}