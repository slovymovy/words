                                            {
                                                "example_id": "10716b9d-3f3c-4f6e-87a5-720ea609b558",
                                                "sense_id": "1f9f856f-ed74-3de6-bdee-e04fa23dfc68",
                                                "text": "physical deformity"
                                            },
                                            {
                                                "example_id": "815ce82c-213d-4485-a229-86fd59adf70a",
                                                "sense_id": "1f9f856f-ed74-3de6-bdee-e04fa23dfc68",
                                                "text": "The accident left him with a slight facial deformity."
                                            },
                                            {
                                                "example_id": "e11db4f0-f92e-4ec8-8de0-089a0123f767",
                                                "sense_id": "1f9f856f-ed74-3de6-bdee-e04fa23dfc68",
