                            {
                                "example_id": "8158435b-546e-4b96-b95b-2b3989aecf82",
                                "sense_id": "b9a1c0e2-d457-32f3-bf6c-ee378c6354f9",
                                "text": "„Die Haut dieser Scharen allzu nackter Männer ist bedeckt mit Tattoos und Narben. Ausschlag und Schorf. Dehnungsstreifen und Sonnenbrand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cbc2b4c6-e0d5-498b-9533-78c7031f2804",
                        "source_entry_id": "a97820c3-db75-3a75-a0dc-bd10e3b037b3",
                        "source_sense_id": "b9a1c0e2-d457-32f3-bf6c-ee378c6354f9",
                        "source_sense_description": "Verfärbung der Unterhaut",
                        "target_lang_word": "stretch mark",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stretch mark",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "25776b9c-152b-378b-b57c-22416e8ca37c",
                                        "entry_id": "80db9631-0a27-3164-95df-40b364712d9b",
                                        "glosses": [
                                            "Any of a series of red (or purple or faded), irregular stripes on the surface of the skin caused by rapid growth of the tissues lying just underneath. They may appear as a result of pregnancy, puberty, obesity, rapid muscle growth or family history."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "224e3d45-7a80-4dc9-a8e2-5f299a155c73",
                                                "sense_id": "25776b9c-152b-378b-b57c-22416e8ca37c",
                                                "text": "Nobody in Cameron's family has stretch marks, and he thinks it's because their tissues grow slowly enough for the skin to catch up."
                                            },
                                            {
                                                "example_id": "ba966e26-de68-41ce-8855-4d90b9d2d78e",
                                                "sense_id": "25776b9c-152b-378b-b57c-22416e8ca37c",
                                                "text": "She hadn't even looked pregnant, especially with her clothes on. She'd gotten only one stretch mark. A thin, jagged line on her left booty cheek."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9d57a32c-b606-4577-9e41-a93e964c862e",
                        "source_entry_id": "a97820c3-db75-3a75-a0dc-bd10e3b037b3",
                        "source_sense_id": "b9a1c0e2-d457-32f3-bf6c-ee378c6354f9",
                        "source_sense_description": "Verfärbung der Unterhaut",
                        "target_lang_word": "vergeture",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vergeture",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "51a5b7e7-0216-301e-bd4e-da450014ee68",
                                        "entry_id": "200edc34-bc69-39e5-bf2d-60413bf43d28",
                                        "glosses": [
                                            "Marque sur la peau, produite par un coup de baguette ou analogue à celle que produit un coup de baguette."
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "73feddb5-4c6e-3d6b-9c53-3414a6ca200a",
                                        "entry_id": "200edc34-bc69-39e5-bf2d-60413bf43d28",
                                        "glosses": [
                                            "Marque sur la peau liée à un étirement de celle-ci, qui peut être dû la prise de poids, la grossesse ou encore la prise de masse musculaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5ea2ea0-a569-4a0b-987b-105196f03d9e",
                                                "sense_id": "73feddb5-4c6e-3d6b-9c53-3414a6ca200a",
                                                "text": "Sur son ventre, j’ai caressé les vergetures qui dataient de l’époque où elle était enceinte de Jamie."
                                            },
                                            {
                                                "example_id": "5a7beb98-8cdf-4630-908e-a1ba476f476b",
                                                "sense_id": "73feddb5-4c6e-3d6b-9c53-3414a6ca200a",
                                                "text": "Rouge, lézardé de vergetures plus claires, ce nez paraissait faux, comme un colombin de pâte à modeler grossièrement collé au milieu de la figure, entre un trait de sourcils et un rectangle de moustache qui auraient pu être dessinés au crayon gras par un maquilleur de foire."
                                            },
                                            {
                                                "example_id": "c6cb4abb-cea1-4631-8ec4-9e8529534b98",
                                                "sense_id": "73feddb5-4c6e-3d6b-9c53-3414a6ca200a",
                                                "text": "Malheureusement, les adeptes de muscu ont souvent un objectif en tête : gagner de la masse musculaire et pouvoir afficher des biceps, pectoraux et abdos sculptés et volumineux. Ce volume a un prix : les vergetures."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
