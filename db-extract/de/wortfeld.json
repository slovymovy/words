                "senses": [
                    {
                        "sense_id": "4334c8cd-5643-3abf-b181-b16c59004215",
                        "entry_id": "32d58a92-e238-3a0f-8ce5-8a83c0377216",
                        "glosses": [
                            "Gruppe bedeutungsverwandter Wörter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f7bb821-2c0f-44b0-983f-e5b6fd5af992",
                                "sense_id": "4334c8cd-5643-3abf-b181-b16c59004215",
                                "text": "Zum Wortfeld der Verkehrswege gehören u.a. die Wörter \"Autobahn\", \"Kanal\" und \"Luftkorridor\"."
                            },
                            {
                                "example_id": "4791388a-37a9-4fb7-8001-60ba54e0a465",
                                "sense_id": "4334c8cd-5643-3abf-b181-b16c59004215",
                                "text": "„Ich möchte nachfolgend ‚auf Nummer sicher gehen‘ und einige Redewendungen aus dem Wortfeld der Zahlen und Ziffern genauer betrachten…“"
                            },
                            {
                                "example_id": "5b74b59b-f0e9-4bf4-9576-3e53c935ba6a",
                                "sense_id": "4334c8cd-5643-3abf-b181-b16c59004215",
                                "text": "„Wir sagen, dass die Farbwörter feldmäßig gegliedert sind, und sprechen demgemäß von einem Wortfeld oder Bedeutungsfeld (…), in diesem Falle von dem Farbfeld.“"
                            },
                            {
                                "example_id": "0c206420-0f74-4cb9-a59d-516a6601aa97",
                                "sense_id": "4334c8cd-5643-3abf-b181-b16c59004215",
                                "text": "„Die Erhebung eines Wortfeldes der Sexualität bzw. einzelner Bereiche von Sexualität gestaltet sich im Rahmen dieser Untersuchung auf der Grundlage des Schemakonstrukts relativ einfach…“"
                            },
                            {
                                "example_id": "e1f86b76-a170-4fbd-b780-042b92dde4f9",
                                "sense_id": "4334c8cd-5643-3abf-b181-b16c59004215",
                                "text": "„Daher lässt sich das Wortfeld »Religion« im Jiddischen nicht klar eingrenzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
