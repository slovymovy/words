                "senses": [
                    {
                        "sense_id": "97c3c0a2-86fd-39f3-a486-ad174105e177",
                        "entry_id": "dcb3275b-fe78-3397-b102-d51053cda356",
                        "glosses": [
                            "A physiological disorder in plants, especially leafy vegetables such as lettuce and cabbage, characterized by necrosis or browning of leaf tips or margins, often due to localized calcium deficiency and environmental stress during rapid growth."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "4a6ce245-dbc7-4256-b20f-274ae12d4ac4",
                                "sense_id": "97c3c0a2-86fd-39f3-a486-ad174105e177",
                                "text": "The crop was at once harvested for fear that rot might follow the tipburn and vitiate the results of the work."
                            },
                            {
                                "example_id": "7850d4f6-f0ce-40b2-9017-a2072a609297",
                                "sense_id": "97c3c0a2-86fd-39f3-a486-ad174105e177",
                                "text": "Tipburn of cabbage consists of a breakdown of tissue near the center of the head, developing as the crop approaches maturity."
                            },
                            {
                                "example_id": "d64436e8-0d42-451c-a458-af0dadb092c6",
                                "sense_id": "97c3c0a2-86fd-39f3-a486-ad174105e177",
                                "text": "The occurrence of tipburn is corelated with environmental conditions that either decrease transpiration from the leaf surface or promote rapid growth, both of which impair the plants (sic) ability to supply sufficient calcium to growing tissues, which then results in tipburn."
                            }
                        ]
                    }
