{
    "word_family": [
        "sprayer",
        "spraying",
        "hairspray",
        "bugspray"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4488e04e-922b-30e5-a266-b6777bd04dad",
                    "sense_definition": "To send out liquid in very small drops, or to be sent out in this way.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "liquid_mist",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gardener decided to <w>spray</w> the roses with water to keep the bugs away.",
                            "target_lang_translations": {
                                "ru": "Садовник решил <w>опрыскать</w> розы водой, чтобы отогнать жуков.",
                                "zh": "园丁决定用水<w>喷洒</w>玫瑰，以防虫害。"
                            }
                        },
                        {
                            "text": "She used a bottle to <w>spray</w> some perfume on her wrist before the party.",
                            "target_lang_translations": {
                                "ru": "Она использовала флакон, чтобы <w>брызнуть</w> немного духов на запястье перед вечеринкой.",
                                "zh": "聚会前，她用瓶子往手腕上<w>喷</w>了些香水。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "spray paint",
                        "spray water",
                        "spray on"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разбрызгивать жидкость мелкими каплями или распыляться таким образом.",
                        "zh": "将液体以细小液滴的形式喷射出来，或指液体以这种方式喷出。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "брызгать",
                                "target_lang_sense_clarification": "обдавать каплями жидкости"
                            },
                            {
                                "target_lang_word": "опрыскивать",
                                "target_lang_sense_clarification": "обрабатывать растения или поверхности"
                            },
                            {
                                "target_lang_word": "распылять",
                                "target_lang_sense_clarification": "превращать жидкость в пыль или туман"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "喷",
                                "target_lang_sense_clarification": "喷射液体或气体"
                            },
                            {
                                "target_lang_word": "喷洒",
                                "target_lang_sense_clarification": "将液体散布在物体表面"
                            },
                            {
                                "target_lang_word": "喷雾",
                                "target_lang_sense_clarification": "使液体变成雾状喷出"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b5d05ad8-b46f-3c38-83f6-de5134a71026",
                    "sense_definition": "To urinate on a place or object in order to mark territory, typically done by male animals.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "animal_behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Male cats often <w>spray</w> around the garden to warn other cats to stay away.",
                            "target_lang_translations": {
                                "ru": "Коты часто <w>метят</w> территорию в саду, чтобы предупредить других котов держаться подальше.",
                                "zh": "公猫经常在花园里<w>撒尿标记</w>，警告其他猫离远点。"
                            }
                        },
                        {
                            "text": "We had to neuter the cat because he started to <w>spray</w> on the furniture indoors.",
                            "target_lang_translations": {
                                "ru": "Нам пришлось кастрировать кота, потому что он начал <w>метить</w> мебель в доме.",
                                "zh": "我们不得不给猫做了绝育手术，因为它开始在室内的家具上<w>撒尿标记</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "cats spray",
                        "spray territory"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мочиться на место или предмет, чтобы пометить территорию (обычно о самцах животных).",
                        "zh": "动物（通常指雄性）为了标记领地而在某处排尿。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "метить",
                                "target_lang_sense_clarification": "оставлять пахучие метки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "撒尿标记",
                                "target_lang_sense_clarification": "动物通过排泄物标记领地"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5b51f7da-ca77-3513-b9db-f3a606057aea",
                    "sense_definition": "A mass of very small drops of liquid carried through the air.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "liquid_mist",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ocean <w>spray</w> felt cool and refreshing on our faces as the boat sped up.",
                            "target_lang_translations": {
                                "ru": "Морские <w>брызги</w> холодили и освежали наши лица, когда лодка набирала скорость.",
                                "zh": "随着船速加快，海面溅起的<w>水雾</w>打在脸上，感觉清凉舒爽。"
                            }
                        },
                        {
                            "text": "A fine <w>spray</w> of water from the fountain cooled the air in the garden.",
                            "target_lang_translations": {
                                "ru": "Мелкая <w>водяная пыль</w> от фонтана охлаждала воздух в саду.",
                                "zh": "喷泉喷出的细小<w>水雾</w>让花园里的空气凉爽了许多。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "sea spray",
                        "fine spray",
                        "ocean spray"
                    ],
                    "target_lang_definitions": {
                        "ru": "Масса мельчайших капель жидкости, переносимых по воздуху.",
                        "zh": "在空气中飘散的极小液滴团。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "брызги",
                                "target_lang_sense_clarification": "летящие капли"
                            },
                            {
                                "target_lang_word": "водяная пыль",
                                "target_lang_sense_clarification": "очень мелкие капли, туман"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "水雾",
                                "target_lang_sense_clarification": "空气中悬浮的细小水滴"
                            },
                            {
                                "target_lang_word": "飞沫",
                                "target_lang_sense_clarification": "溅起的小水滴"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2a1f8d09-fa40-3fea-a4ba-1e9ca1c9a565",
                    "sense_definition": "A liquid product kept in a pressurized container that is forced out in small drops.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "liquid_mist",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She keeps a small bottle of pepper <w>spray</w> in her purse for safety while walking at night.",
                            "target_lang_translations": {
                                "ru": "Она носит в сумочке маленький баллончик с перцовым <w>спреем</w> для безопасности, когда гуляет ночью.",
                                "zh": "为了夜间行走安全，她在钱包里放了一小瓶防狼<w>喷雾剂</w>。"
                            }
                        },
                        {
                            "text": "The doctor prescribed a nasal <w>spray</w> to help clear my blocked sinuses during the allergy season.",
                            "target_lang_translations": {
                                "ru": "Врач прописал назальный <w>спрей</w>, чтобы помочь очистить заложенный нос в сезон аллергии.",
                                "zh": "医生给我开了鼻用<w>喷雾剂</w>，以缓解过敏季节的鼻塞。"
                            }
                        }
                    ],
                    "synonyms": [
                        "spray can"
                    ],
                    "common_phrases": [
                        "hair spray",
                        "bug spray",
                        "nasal spray",
                        "pepper spray"
                    ],
                    "target_lang_definitions": {
                        "ru": "Жидкое средство в баллончике под давлением, которое распыляется мелкими каплями.",
                        "zh": "装在压力容器中，能以细小液滴形式喷出的液体产品。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спрей",
                                "target_lang_sense_clarification": "косметическое или бытовое средство"
                            },
                            {
                                "target_lang_word": "аэрозоль",
                                "target_lang_sense_clarification": "тип упаковки и распыления"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "喷雾剂",
                                "target_lang_sense_clarification": "用于医疗或日常的喷雾产品"
                            },
                            {
                                "target_lang_word": "气雾剂",
                                "target_lang_sense_clarification": "压力罐装的喷雾产品"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "95a9f2c0-18fb-3ced-b231-2ac23a906959",
                    "sense_definition": "A single small branch or stem with leaves, flowers, or berries on it, often used for decoration.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "botany",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bride carried a beautiful <w>spray</w> of white orchids as she walked down the aisle.",
                            "target_lang_translations": {
                                "ru": "Невеста несла красивую <w>ветку</w> белых орхидей, идя к алтарю.",
                                "zh": "新娘走过过道时，手里拿着一束美丽的白色<w>花枝</w>。"
                            }
                        },
                        {
                            "text": "He pinned a small <w>spray</w> of holly to his coat to celebrate the winter holidays.",
                            "target_lang_translations": {
                                "ru": "Он приколол маленькую <w>веточку</w> остролиста к пальто, чтобы отпраздновать зимние праздники.",
                                "zh": "为了庆祝冬日假期，他在外套上别了一小枝冬青<w>花枝</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sprig"
                    ],
                    "common_phrases": [
                        "spray of flowers",
                        "spray of orchids"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшая ветка с цветами, листьями или ягодами, используемая для украшения.",
                        "zh": "带有叶子、花朵或浆果的小枝条，常用于装饰。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "веточка",
                                "target_lang_sense_clarification": "небольшая часть растения"
                            },
                            {
                                "target_lang_word": "букетик",
                                "target_lang_sense_clarification": "маленькая связка цветов"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "花枝",
                                "target_lang_sense_clarification": "带有花朵的枝条"
                            },
                            {
                                "target_lang_word": "小花束",
                                "target_lang_sense_clarification": "装饰用的小型花束"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2daf58a3-8d44-30c0-a9af-0b93e858e039",
                    "sense_definition": "A loud and angry scolding or reprimand.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The coach gave the team a massive <w>spray</w> at half-time for playing so poorly.",
                            "target_lang_translations": {
                                "ru": "Тренер устроил команде серьезный <w>разнос</w> в перерыве за такую плохую игру.",
                                "zh": "中场休息时，教练因为球队表现太差而对他们进行了严厉的<w>训斥</w>。"
                            }
                        },
                        {
                            "text": "He expected a <w>spray</w> from his boss after missing the important deadline.",
                            "target_lang_translations": {
                                "ru": "Он ожидал <w>нагоняй</w> от начальника после того, как пропустил важный срок.",
                                "zh": "错过了重要的截止日期后，他预料到会遭到老板的<w>痛骂</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "give a spray",
                        "cop a spray"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in sports contexts, particularly in Australian English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Громкий и сердитый выговор или критика.",
                        "zh": "大声且愤怒的责骂或训斥。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разнос",
                                "target_lang_sense_clarification": "суровая критика"
                            },
                            {
                                "target_lang_word": "нагоняй",
                                "target_lang_sense_clarification": "выговор"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "训斥",
                                "target_lang_sense_clarification": "严厉的批评"
                            },
                            {
                                "target_lang_word": "痛骂",
                                "target_lang_sense_clarification": "激烈的言语责备"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}