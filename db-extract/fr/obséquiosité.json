                                        "sense_id": "0db4d5cf-5c2c-3281-8342-5f8006f1872c",
                                        "entry_id": "2828d0fb-c769-3370-bafc-9cdb5dd3bd00",
                                        "glosses": [
                                            "het al of niet vrijwillig erkennen dat iemand anders de baas is"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e56245a-ba1f-4004-be5c-7cbc28b020bd",
                                                "sense_id": "0db4d5cf-5c2c-3281-8342-5f8006f1872c",
                                                "text": "Hij merkte dat ze onderling begonnen te fluisteren, waarbij ze met iets van angst en zelfs met iets van onderdanigheid naar hem leken te kijken."
                                            },
                                            {
                                                "example_id": "07bbb73a-99c4-4214-9ddb-0bbba8625481",
                                                "sense_id": "0db4d5cf-5c2c-3281-8342-5f8006f1872c",
                                                "text": "Voor Evenhuis-van Essen is Groeneweg een voorbeeld geweest. \"Zij liet zien dat men geen genoegen moest nemen met de onderdanigheid van de vrouw aan de man.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d73afb27-6cc3-3a1d-a9b9-8b6bd47c0912",
                                        "entry_id": "2828d0fb-c769-3370-bafc-9cdb5dd3bd00",
                                        "glosses": [
                                            "de erkenning dat iemand anders de baas is"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "265a4622-1fe9-4d06-9a88-63713192980a",
                        "source_entry_id": "124666fe-f9a0-3141-b961-0fe1e099e5e7",
                        "target_lang_word": "kruiperigheid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kruiperigheid",
