                        "examples": [
                            {
                                "example_id": "8417b09c-64fd-4649-aa8e-880dd084a0d2",
                                "sense_id": "33d98ff7-286b-308e-9020-9917c58d9309",
                                "text": "La machine à écrire sur la consolette Louis XV, la ronéotype sur le bureau Napoléon III, des paquets de papier partout sur un vestige de tapis de la Savonnerie, et des cendriers pleins de clopes dans tous les coins."
                            },
                            {
                                "example_id": "e5886020-a0e7-4826-936d-90aa74d8775f",
                                "sense_id": "33d98ff7-286b-308e-9020-9917c58d9309",
                                "text": "La maîtresse de maison tombe en arrêt devant une composition florale, placée sur une consolette Louis XV…"
                            },
                            {
                                "example_id": "90572a93-854d-4470-a0b5-e2d4512cd581",
                                "sense_id": "33d98ff7-286b-308e-9020-9917c58d9309",
                                "text": "Ici, tout était plongé dans l’obscurité, sauf cinq écrans dont la lueur palpitait sur une consolette."
                            }
                        ]
                    }
