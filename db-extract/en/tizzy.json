                        "target_lang_word": "nerveux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nerveux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2aa2429a-85da-3c59-9eed-3bbc30df0a5d",
                                        "entry_id": "de203a58-f602-3808-b488-465bd751a388",
                                        "glosses": [
                                            "Relatif aux nerfs et au système nerveux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19a66240-fa7c-4aff-9a8f-43cb487c4171",
                                                "sense_id": "2aa2429a-85da-3c59-9eed-3bbc30df0a5d",
                                                "text": "Quelle est l’importance de la théorie de Pavlov sur l’activité nerveuse supérieure pour la philosophie marxiste-léniniste ?"
                                            },
                                            {
                                                "example_id": "fa6ad68e-660a-4623-8df6-684bdfbf8c30",
                                                "sense_id": "2aa2429a-85da-3c59-9eed-3bbc30df0a5d",
                                                "text": "Inspirée par le fonctionnement des cellules nerveuses des organismes vivants, la logique neuromorphique propose une alternative à la logique booléenne. Ces concepts introduits en 1943 ont conduit à des applications relativement limitées jusqu'à ce jour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "508afdf4-f787-3f4c-819e-d21ac201f594",
                                        "entry_id": "de203a58-f602-3808-b488-465bd751a388",
                                        "glosses": [
                                            "Qualifie une personne qui a les nerfs sensibles ou irritables."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71397a96-6e8d-44d5-a969-e5ad99a539ba",
                                                "sense_id": "508afdf4-f787-3f4c-819e-d21ac201f594",
                                                "text": "Plus le cheval est irritable, nerveux ou craintif plus il faut être modéré dans l’emploi de la chambrière ; […]."
                                            },
                                            {
                                                "example_id": "52c918e8-1dfd-4523-a010-f10a83006885",
                                                "sense_id": "508afdf4-f787-3f4c-819e-d21ac201f594",
                                                "text": "Cette femme est très nerveuse."
                                            },
                                            {
                                                "example_id": "cbeafb59-1529-4e94-b799-c719781dde5e",
                                                "sense_id": "508afdf4-f787-3f4c-819e-d21ac201f594",
                                                "text": "Et aussi le mot « nerveux » quand il est appliqué à Lili prend son sens positif… « Elle est nerveuse » veut dire : « Quelle force vitale elle a, comme elle est vivante ! »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45b2e675-9286-3335-8c03-b3a20b120bb5",
                                        "entry_id": "de203a58-f602-3808-b488-465bd751a388",
                                        "glosses": [
                                            "Qualifie un état de nervosité accidentelle ou passagère."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f89b274f-9ac6-4820-8da9-22b2f4cea642",
                                                "sense_id": "45b2e675-9286-3335-8c03-b3a20b120bb5",
                                                "text": "Dès qu’il fut descendu de voiture, celui-ci, contrairement à toutes ses habitudes, ne monta pas directement à sa chambre, il entra dans le salon et s’y promena, le visage à l’orage, très agité, très nerveux, s’impatientant de ce qu'on ne servît pas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aee9d32c-1614-36a5-9ac4-4a330534c452",
                                        "entry_id": "de203a58-f602-3808-b488-465bd751a388",
                                        "glosses": [
                                            "Qui a de bons nerfs ; qui a de la force dans les muscles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "032de1de-33bc-47b2-b211-b660d7c1dd3b",
                                                "sense_id": "aee9d32c-1614-36a5-9ac4-4a330534c452",
                                                "text": "Bras, corps nerveux."
                                            },
                                            {
                                                "example_id": "453dc440-d445-4718-a48d-6060ae6df63e",
                                                "sense_id": "aee9d32c-1614-36a5-9ac4-4a330534c452",
                                                "text": "C’est un petit homme nerveux."
                                            },
                                            {
                                                "example_id": "a312a3d0-413f-439a-898b-dd813196f3fe",
                                                "sense_id": "aee9d32c-1614-36a5-9ac4-4a330534c452",
                                                "text": "Un cheval nerveux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68c6537c-85b3-3040-b3e0-02ebc1afbbbb",
                                        "entry_id": "de203a58-f602-3808-b488-465bd751a388",
                                        "glosses": [
                                            "Qualifie ce qui a de la fermeté, de la vigueur."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d4ec1df-49c5-42ed-b10b-5678e0e5f394",
                                                "sense_id": "68c6537c-85b3-3040-b3e0-02ebc1afbbbb",
                                                "text": "Le pinot meunier, rouge aussi, régulier et rustique, atténue l’acidité mais donne des vins fins moins nerveux."
                                            },
                                            {
                                                "example_id": "5f10d79e-8d26-47fa-94b1-1a1e4c9eff99",
                                                "sense_id": "68c6537c-85b3-3040-b3e0-02ebc1afbbbb",
                                                "text": "Ce style, ce discours est nerveux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d53c3567-48a4-3a0e-a367-8116a5ab9a9d",
                                        "entry_id": "de203a58-f602-3808-b488-465bd751a388",
                                        "glosses": [
                                            "Qui est plein de nerfs et de muscles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3fa81816-1e6f-48a0-be78-32bbaa5a0f63",
                                                "sense_id": "d53c3567-48a4-3a0e-a367-8116a5ab9a9d",
                                                "text": "Le pied est la partie du corps la plus nerveuse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c7eca74-6780-3d5d-b8a2-eea6e8007d28",
                                        "entry_id": "de203a58-f602-3808-b488-465bd751a388",
                                        "glosses": [
                                            "Qualifie une viande trop dure."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4080e533-75ba-3a1d-b9a1-b77eb7db6ef5",
                                        "entry_id": "de203a58-f602-3808-b488-465bd751a388",
                                        "glosses": [
                                            "Qui tend à se déformer après l’abattage, en particulier lors de son utilisation en menuiserie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e01ed0a-deaa-4ae8-8034-91312d9a8be3",
                                                "sense_id": "4080e533-75ba-3a1d-b9a1-b77eb7db6ef5",
                                                "text": "Un bois est parfois qualifié de nerveux lorsqu’il se déforme au moment du sciage alors que ces déformations ne sont dues qu’à des tensions internes. Il peut également être qualifié de nerveux lorsque, pendant le séchage, les débits subissent des déformations dues à de grandes différences entre retrait radial et retrait tangentiel."
                                            },
                                            {
                                                "example_id": "0f702c11-31d0-431a-be2b-7c59ba8f450f",
                                                "sense_id": "4080e533-75ba-3a1d-b9a1-b77eb7db6ef5",
                                                "text": "Le mélèze développe un bois brun-rougeâtre, résineux, aux qualités mécaniques remarquables (pour les arbres de montagne) et de très bonne durabilité naturelle. Le mélèze de plaine aurait des propriétés mécaniques inférieures, mais serait aussi moins nerveux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d83e147f-8877-3a3f-8094-99538e4df60c",
                                        "entry_id": "de203a58-f602-3808-b488-465bd751a388",
                                        "glosses": [
                                            "Qualifie un charbon particulièrement dur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2baed4e3-7511-44aa-ad24-5fe5f770098c",
                                                "sense_id": "d83e147f-8877-3a3f-8094-99538e4df60c",
                                                "text": "Le charbon à travers lequel on se frayait un passage était ce que les mineurs appellent nerveux, c’est-à-dire très-dur,"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "nerveux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "292c08fc-520b-3801-8a9a-58a875342da1",
                                        "entry_id": "2d5f15e2-3651-3644-9a5f-f1fb8dc707ec",
                                        "glosses": [
                                            "Personne ou animal excité, irritable."
                                        ],
                                        "tags": [
                                            "Par substantivation"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c04bbf6d-bed6-4910-b2d2-c9ff2889465f",
                                                "sense_id": "292c08fc-520b-3801-8a9a-58a875342da1",
                                                "text": "Une annonce comme celle-là exerce une attirance irrésistible sur tous les détraqués, les imaginatifs, les grands nerveux, les épileptiques…"
                                            },
                                            {
                                                "example_id": "d1e23a0f-7503-451c-b861-d7fc45039302",
                                                "sense_id": "292c08fc-520b-3801-8a9a-58a875342da1",
                                                "text": "Puis le nerveux à peau rouge est entré."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
