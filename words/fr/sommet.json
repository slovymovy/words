    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7ed3eaec-a40a-3ab2-a74e-42ce32a3fa2d",
                    "sense_definition": "Partie la plus élevée de quelque chose, en particulier d'une montagne ou d'une élévation de terrain.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "relief",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les randonneurs ont enfin atteint le <w>sommet</w> de la montagne après cinq heures d'effort."
                        },
                        {
                            "text": "Une épaisse couche de neige blanche recouvre le <w>sommet</w> des collines en hiver."
                        }
                    ],
                    "synonyms": [
                        "cime",
                        "crête",
                        "faîte"
                    ],
                    "common_phrases": [
                        "au sommet de la montagne",
                        "atteindre le sommet"
                    ]
                },
                {
                    "sense_id": "3118e993-488e-319f-856e-07a4a5d7272c",
                    "sense_definition": "Rassemblement ou conférence diplomatique de premier plan réunissant des chefs d'État ou de gouvernement.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "politique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le prochain <w>sommet</w> international sur le climat réunira les dirigeants du monde entier."
                        },
                        {
                            "text": "Les ministres préparent soigneusement chaque <w>sommet</w> avant l'arrivée des chefs de gouvernement."
                        }
                    ],
                    "common_phrases": [
                        "sommet international",
                        "rencontre au sommet"
                    ]
                },
                {
                    "sense_id": "31b920d5-1495-37c9-ba11-587c3510a4da",
                    "sense_definition": "Point d'intersection de deux ou plusieurs lignes qui forment un angle dans une figure géométrique.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "geometrie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque <w>sommet</w> d'un triangle relie deux côtés adjacents de la figure."
                        },
                        {
                            "text": "Tracez une droite qui part du <w>sommet</w> supérieur pour couper la base au milieu."
                        }
                    ],
                    "common_phrases": [
                        "sommet d'un triangle",
                        "sommet d'un polygone"
                    ]
                },
                {
                    "sense_id": "3450699f-549c-37a7-9299-688d46a75c2f",
                    "sense_definition": "Point le plus haut ou degré maximal qu'un individu ou une situation peut atteindre.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "apogee",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette grande actrice a décidé de se retirer alors qu'elle était au <w>sommet</w> de sa gloire."
                        },
                        {
                            "text": "La tension politique entre les deux nations a atteint son <w>sommet</w> lors de cette crise."
                        }
                    ],
                    "synonyms": [
                        "acmé",
                        "apogée",
                        "summum",
                        "zénith"
                    ],
                    "common_phrases": [
                        "au sommet de sa gloire",
                        "au sommet de sa carrière"
                    ]
                },
                {
                    "sense_id": "28e29ce5-db71-35fa-9a98-0e6e67ef3ccd",
                    "sense_definition": "Nœud ou élément de base servant de point de connexion dans la théorie des graphes et les réseaux.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "informatique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet algorithme efficace calcule le trajet le plus rapide entre deux <w>sommets</w> du graphe."
                        },
                        {
                            "text": "Une arête non orientée relie chaque <w>sommet</w> à son voisin le plus proche."
