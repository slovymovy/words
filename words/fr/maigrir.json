                                "target_lang_word": "显瘦",
                                "target_lang_sense_clarification": "服装搭配带来的视觉效果"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "89481aa8-e9f2-34a2-859d-72c0d03c49fc",
                    "sense_definition": "Rendre maigre, affaiblir ou réduire la substance de quelque chose.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "affaiblissement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette longue maladie le <w>maigrit</w> et épuise ses dernières forces.",
                            "target_lang_translations": {
                                "en": "This long illness <w>emaciates</w> him and drains his last strength.",
                                "ru": "Эта долгая болезнь <w>истощает</w> его и выматывает последние силы.",
                                "de": "Diese langwierige Krankheit <w>zehrt</w> ihn <w>aus</w> und raubt ihm seine letzten Kräfte.",
                                "es": "Esta larga enfermedad lo <w>demacra</w> y agota sus últimas fuerzas.",
                                "zh": "这场漫长的疾病让他<w>消瘦</w>，耗尽了他最后的力气。"
                            }
                        },
                        {
                            "text": "Le manque d'eau prolongé <w>maigrissait</w> visiblement le bétail pendant la saison sèche.",
                            "target_lang_translations": {
                                "en": "Prolonged lack of water visibly <w>emaciated</w> the cattle during the dry season.",
                                "ru": "Длительная нехватка воды заметно <w>истощала</w> скот в засушливый сезон.",
                                "de": "Der lang anhaltende Wassermangel ließ das Vieh während der Trockenzeit sichtlich <w>abmagern</w>.",
                                "es": "La falta prolongada de agua <w>enflaquecía</w> visiblemente al ganado durante la estación seca.",
                                "zh": "旱季期间，长期缺水让牲畜明显<w>消瘦</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "amaigrir"
                    ],
                    "antonyms": [
                        "engraisser"
                    ],
                    "target_lang_definitions": {
                        "en": "To make someone very thin or weak, or reduce the substance of something.",
                        "ru": "Делать кого-либо очень худым или слабым, уменьшать содержание чего-либо.",
                        "de": "Jemanden sehr dünn oder schwach machen oder den Gehalt von etwas verringern.",
                        "es": "Debilitar a alguien o reducir la sustancia o la fuerza de algo.",
                        "zh": "使人非常消瘦或衰弱，或使某物的成分减少。"
                    },
                    "translations": {
