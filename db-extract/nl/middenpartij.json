                "senses": [
                    {
                        "sense_id": "0f6675a4-7065-318e-8775-5f11c6e16b5d",
                        "entry_id": "380127d7-696b-3f05-a7c3-ee19427c38e3",
                        "glosses": [
                            "een politieke partij met een programma dat tussen twee uitersten in zit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7ca22d3-2398-400a-a6dc-e1d5d2475267",
                                "sense_id": "0f6675a4-7065-318e-8775-5f11c6e16b5d",
                                "text": "Demissionair premier Netanyahu van de rechtse Likud-partij bereikte vorige maand een overeenkomst met zijn voormalig rivaal Benny Gantz van de middenpartij Blauw en Wit. Volgens het akkoord wordt Netanyahu eerst premier en lost Gantz hem na anderhalf jaar af."
                            },
                            {
                                "example_id": "4e34b5f3-97ba-4471-9797-96bc3aa81ad2",
                                "sense_id": "0f6675a4-7065-318e-8775-5f11c6e16b5d",
                                "text": "Van Thijn was de bedenker van de polarisatiestrategie, waarbij de tegenstelling tussen links en rechts centraal werd gesteld. Het moest de macht van de confessionele middenpartijen breken. Van Thijn vond dat de PvdA alleen met hen moest regeren als ze vóór de verkiezingen een voorkeur uitspraken voor een progressief kabinet. Dat zou bij hen 'een scheiding der geesten' teweegbrengen."
                            }
                        ]
                    },
