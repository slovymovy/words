{
    "word_family": [
        "Buddhism",
        "Buddha",
        "Buddhistic"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e580ede6-51de-3147-ab00-86ad5ecddf39",
                    "sense_definition": "A practitioner of the religion and philosophy of Buddhism.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As a devout <w>Buddhist</w>, he spends time meditating every morning.",
                            "target_lang_translations": {
                                "ru": "Будучи набожным <w>буддистом</w>, он каждое утро проводит время в медитации.",
                                "zh": "作为一名虔诚的<w>佛教徒</w>，他每天早上都会花时间冥想。",
                                "es": "Como <w>budista</w> devoto, dedica tiempo a meditar cada mañana."
                            }
                        },
                        {
                            "text": "Many <w>Buddhists</w> believe in the importance of compassion and non-violence.",
                            "target_lang_translations": {
                                "ru": "Многие <w>буддисты</w> верят в важность сострадания и ненасилия.",
                                "zh": "许多<w>佛教徒</w>相信慈悲与非暴力至关重要。",
                                "es": "Muchos <w>budistas</w> creen en la importancia de la compasión y la no violencia."
                            }
                        }
                    ],
                    "common_phrases": [
                        "practicing Buddhist",
                        "devout Buddhist",
                        "become a Buddhist"
                    ],
                    "target_lang_definitions": {
                        "ru": "Последователь религии и философии буддизма.",
                        "zh": "佛教的信徒或修行者。",
                        "es": "Persona que practica la religión y filosofía del budismo."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "будди́ст",
                                "target_lang_sense_clarification": "последователь буддизма"
                            },
                            {
                                "target_lang_word": "будди́стка",
                                "target_lang_sense_clarification": "женский род"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "佛教徒",
                                "target_lang_sense_clarification": "佛教的信徒"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "budista",
                                "target_lang_sense_clarification": "seguidor o practicante del budismo"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a0ddfa9e-f814-3b67-bb57-60e00d20cb11",
                    "sense_definition": "Of, relating to, or practicing Buddhism.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We visited a beautiful <w>Buddhist</w> temple during our trip to Japan.",
                            "target_lang_translations": {
                                "ru": "Во время нашей поездки в Японию мы посетили красивый <w>буддийский</w> храм.",
                                "zh": "我们在日本旅行期间参观了一座美丽的<w>佛教</w>寺庙。",
                                "es": "Visitamos un hermoso templo <w>budista</w> durante nuestro viaje a Japón."
                            }
                        },
                        {
                            "text": "She is very interested in <w>Buddhist</w> philosophy and reads about it often.",
                            "target_lang_translations": {
                                "ru": "Она очень интересуется <w>буддийской</w> философией и часто читает о ней.",
                                "zh": "她对<w>佛教</w>哲学非常感兴趣，经常阅读相关书籍。",
                                "es": "Ella está muy interesada en la filosofía <w>budista</w> y lee sobre ella a menudo."
                            }
                        }
                    ],
                    "common_phrases": [
                        "Buddhist monk",
                        "Buddhist temple",
                        "Buddhist teachings",
                        "Buddhist art"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к буддизму, связанный с ним или исповедующий его.",
                        "zh": "与佛教有关的，或属于佛教的。",
                        "es": "Que pertenece, se relaciona o está vinculado con el budismo."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "будди́йский",
                                "target_lang_sense_clarification": "относящийся к учению или культуре"
                            },
                            {
                                "target_lang_word": "будди́стский",
                                "target_lang_sense_clarification": "относящийся к последователям"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "佛教",
                                "target_lang_sense_clarification": "用于修饰名词，表示与佛教相关"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "budista",
                                "target_lang_sense_clarification": "adjetivo relativo al budismo"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}