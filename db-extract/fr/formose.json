            {
                "entry_id": "82c2a6d9-5404-3ab9-9d97-37baf9139a25",
                "word": "Formose",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f52843c2-f816-3483-916d-1457a798c67b",
                        "entry_id": "82c2a6d9-5404-3ab9-9d97-37baf9139a25",
                        "glosses": [
                            "Autre nom de Taïwan (île asiatique)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71b4707b-0409-4870-af60-ea16098ba5c9",
                                "sense_id": "f52843c2-f816-3483-916d-1457a798c67b",
                                "text": "Le Torquemada faisait partie de la longue cohorte de navires qui évacuaient les contenus des banques et des musées à Formose, où Tchang Kaï-Chek s'est replié après la victoire des troupes de Mao."
                            }
                        ]
                    },
                    {
                        "sense_id": "a69f915e-2887-3d79-80a7-e147b44c4f9c",
                        "entry_id": "82c2a6d9-5404-3ab9-9d97-37baf9139a25",
                        "glosses": [
                            "Ancien nom du fleuve Benin, séparant autrefois les royaumes de Warri et de Benin et situé dans l’actuel Nigéria."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "d729f126-7371-4d83-8eb5-3a85f23dc007",
                                "sense_id": "a69f915e-2887-3d79-80a7-e147b44c4f9c",
                                "text": "Nous cinglâmes de nouveau, le premier juillet, vers les côtes d’Afrique. Après une traversée de cinquante-deux jours, suivant le bas de la Côte-d’or, nous entrâmes dans les eaux de la rivière Formose, au Benin."
                            },
                            {
                                "example_id": "c40965e3-f84b-40e7-b141-76a22d57c172",
                                "sense_id": "a69f915e-2887-3d79-80a7-e147b44c4f9c",
                                "text": "FORMOSE et mieux FORMOSA, fleuve de la Guinée sept., dont le cours supérieur est encore inconnu. Il vient du N. E., sépare le roy. de Benin de celui d’Ouary, et se jette, par plusieurs bras, dans le golfe de Benin, par 6° 20′ de lat. N. et 1°30′ de long. E."
                            }
                        ]
                    }
                ],
