                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f1e8d658-1ae4-31e0-b75a-88fb38bee830",
                                        "entry_id": "3c4addc1-21ad-34da-8453-04bd2cc6edb7",
                                        "glosses": [
                                            "To devote or pledge (oneself) to a given person, cause etc."
                                        ],
