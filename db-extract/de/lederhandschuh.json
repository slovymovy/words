                ],
                "senses": [
                    {
                        "sense_id": "435aa086-94e3-318a-8ec2-21121ec37ac2",
                        "entry_id": "40e0d7e5-629d-30e3-b756-dcffc1328e27",
                        "glosses": [
                            "aus Leder bestehender Handschuh"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2c45a1f-0f75-43a7-9479-1d7a884c331c",
                                "sense_id": "435aa086-94e3-318a-8ec2-21121ec37ac2",
                                "text": "Viele Motorradfahrer tragen Lederhandschuhe."
                            },
                            {
                                "example_id": "b61f9b32-2b26-4afb-8e77-3e2b5d7bb921",
                                "sense_id": "435aa086-94e3-318a-8ec2-21121ec37ac2",
                                "text": "„Der Wachtmeister soll einen Lederhandschuh getragen haben, mit dem er allen, die zu spät herauskamen, ‚eine drübergezogen‘ haben soll.“"
                            },
                            {
                                "example_id": "5644da6c-65d1-4fc9-b7cc-a18dc64e64e4",
                                "sense_id": "435aa086-94e3-318a-8ec2-21121ec37ac2",
                                "text": "„Die Ausstellung wird außerdem in einer Vitrine einen schwarzen Lederhandschuh präsentieren.“"
                            },
                            {
                                "example_id": "b14f83f2-f79a-4862-b871-fee4dea8f6a6",
                                "sense_id": "435aa086-94e3-318a-8ec2-21121ec37ac2",
                                "text": "„Dieser Mann blieb zunächst stehen, und es war deutlich zu merken, dass er eben erst aus dem Hellen ins Dunkle gekommen war; dann ging er mit vorsichtigen Schritten an den Tisch und legte seine kleinen in Lederhandschuhen steckenden Hände darauf.“"
                            },
                            {
                                "example_id": "4fff3887-43aa-42e1-a91b-0c0f00ae7342",
                                "sense_id": "435aa086-94e3-318a-8ec2-21121ec37ac2",
                                "text": "„Dem Hemdsärmeligen war es gelungen, für die Stiefel Lammfellmütze und Lederhandschuhe einzuhandeln, um beides mitsamt dem Gürtel, den er eingespart hatte, wieder gegen einen Mantel herzugeben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
