                ],
                "senses": [
                    {
                        "sense_id": "fd0a1f63-5a41-3962-8b48-a0937bf9b069",
                        "entry_id": "fc704906-7851-369d-8db8-caa964a279be",
                        "glosses": [
                            "Möglichkeit/Fähigkeit, aus der Hülle eines Atoms Elektronen herauszuschlagen und das Material damit zu ionisieren, zum Beispiel von radioaktiver Strahlung oder von elektrischem Strom oder von Licht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66b2cdf7-da59-472f-83b2-3735fb92db4f",
                                "sense_id": "fd0a1f63-5a41-3962-8b48-a0937bf9b069",
                                "text": "„Die Al-Messungen von K. Diebner und H. Pose und die Fluormessungen von H. Pose werden bezüglich des Ionisationsvermögens der erzeugten Protonen ausgewertet und die differentielle Ionisation in Abhängigkeit von der Restreichweite untersucht.“"
                            },
                            {
                                "example_id": "1e9c1f01-c0e9-4e54-bb91-edc28e197f9e",
                                "sense_id": "fd0a1f63-5a41-3962-8b48-a0937bf9b069",
                                "text": "„Bei Zählrohrspannungen unter 300 V hängt die Zählrate von dem Ionisationsvermögen der einfallenden Strahlung ab.“"
                            },
                            {
                                "example_id": "0b448aa6-e11c-4d8b-a4d6-f8a63c1dace8",
                                "sense_id": "fd0a1f63-5a41-3962-8b48-a0937bf9b069",
                                "text": "„Ionisationsvermögen: Parameter der Stossionisation, der angibt, wie viele Atome oder Moleküle ein geladenes Teilchen beim Durchgang durch ein Gas auf einer Flugstrecke von 1 m durch Stossionisation ionisiert.“"
                            },
                            {
                                "example_id": "e86d2cb4-087c-42de-a4a7-c23faa5536a5",
                                "sense_id": "fd0a1f63-5a41-3962-8b48-a0937bf9b069",
                                "text": "„Protonen haben aufgrund ihrer Masse ein viel größeres Ionisationsvermögen als Elektronen vergleichbarer Energie und wir bemerken anhand der besseren Ausbreitungsbedingungen auf den oberen Kurzwellenbändern, daß nach Protonenflares die F-Schicht oft ‚besser reflektiert‘.“"
                            },
                            {
                                "example_id": "20044569-a16a-42c6-b6d9-16a6d3cdc2b3",
                                "sense_id": "fd0a1f63-5a41-3962-8b48-a0937bf9b069",
                                "text": "„Das Ionisationsvermögen einer Strahlung ist um so größer, je höher die Masse, denn das Ionisationsvermögen einer Strahlung oder eines Teilchens gibt an, wie stark ein Stoff von ihm ionisiert wird, also die Strahlung Atome durch das Herausschlagen der Elektronen aus der Hülle zu Ionen macht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
