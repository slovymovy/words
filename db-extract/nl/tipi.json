                        "glosses": [
                            "tent met een puntdak die o.a. gebruikt wordt door de Noord-Amerikaanse indianen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "438769d7-0d70-4cc8-a90b-c43f20434da0",
                                "sense_id": "6b8e0b86-ef68-3c1e-8cc4-93eee7d64306",
                                "text": "Hij is zo gefascineerd door de indianen dat hij een echte tipi aangeschaft heeft."
