                                        "entry_id": "861105f9-1a46-315b-acb3-d94c6c7a44c1",
                                        "glosses": [
                                            "Designating a creolized language."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "061b616c-b848-3345-bb5e-9ebfe2026c80",
                                        "entry_id": "861105f9-1a46-315b-acb3-d94c6c7a44c1",
                                        "glosses": [
                                            "Prepared according to a cooking style developed in a Creole area, now especially that of Louisiana, characterised by a mixture of European and African influences."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Creole",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "10d8f222-2b7a-3d0c-990b-da060e07ca38",
                                        "entry_id": "c07080b6-6d75-37b5-ad6a-c5c632560f4f",
                                        "glosses": [
                                            "Any specific creole language, especially that of Haiti."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1f8fd1c-2b02-4b2f-bac8-87e00fe2b80e",
                                                "sense_id": "10d8f222-2b7a-3d0c-990b-da060e07ca38",
                                                "text": "She grew up speaking Creole."
                                            },
                                            {
                                                "example_id": "b87f6b04-3f2c-4994-83ce-4788a9d827ae",
                                                "sense_id": "10d8f222-2b7a-3d0c-990b-da060e07ca38",
                                                "text": "Along with French, Creole is one of Haiti's official languages."
                                            },
                                            {
                                                "example_id": "42f56de3-5221-4395-81f0-d15d36c679b4",
                                                "sense_id": "10d8f222-2b7a-3d0c-990b-da060e07ca38",
                                                "text": "His English is still in its beginning stages, like my Creole, but he was able to translate some Creole songs that he's written into English—not the best English, but English nonetheless."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
