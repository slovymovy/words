                "senses": [
                    {
                        "sense_id": "a6b8be92-d901-3a50-a7ac-8869529ffebd",
                        "entry_id": "20c29ff7-8c34-3bf1-a6b4-9eba8f58e7db",
                        "glosses": [
                            "Donner un caractère liminaire à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cdb2ff20-a047-445c-8fcd-570d591cbe3a",
                                "sense_id": "a6b8be92-d901-3a50-a7ac-8869529ffebd",
                                "text": "Mais en obligeant les cultures et les grands récits territoriaux à se rencontrer, à s'affronter, à se mélanger, à s'articuler, bref à se « liminariser », la mondialisation joue sur eux un rôle déstabilisateur et dissolvant."
                            },
                            {
                                "example_id": "912de2ec-0dc2-45c0-a408-b6465aed42fc",
                                "sense_id": "a6b8be92-d901-3a50-a7ac-8869529ffebd",
                                "text": "De ce fait, prenant part au rite du dévoilement, le spectateur est momentanément « liminarisé »."
                            }
                        ]
                    }
                ],
