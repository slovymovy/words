                ],
                "senses": [
                    {
                        "sense_id": "2b2a4183-8588-3620-9a00-1fe3cff2b42a",
                        "entry_id": "a4959079-fe9a-36f4-b87c-4a0f2278e7e3",
                        "glosses": [
                            "кажущееся или действительное свечение, продолжающееся или возникающее после окончания какого-либо воздействия на источник"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5fa18e2-82f7-4172-86f0-fc5f00ef0937",
                                "sense_id": "2b2a4183-8588-3620-9a00-1fe3cff2b42a",
                                "text": "Послесвечение гамма-всплеска было зафиксировано рядом оптических телескопов."
                            },
                            {
                                "example_id": "9a3517cc-fb80-4a78-b46e-71d05d63c277",
                                "sense_id": "2b2a4183-8588-3620-9a00-1fe3cff2b42a",
                                "text": "Длительное послесвечение люминофора ЭЛТ является в большинстве случаев вредным фактором."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "afb6a5d2-1382-44d3-9768-22e88c8ff02d",
                        "source_entry_id": "a4959079-fe9a-36f4-b87c-4a0f2278e7e3",
                        "source_sense_id": "2b2a4183-8588-3620-9a00-1fe3cff2b42a",
                        "target_lang_word": "afterglow",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "afterglow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5b9285b1-4446-3181-94dc-f8675eb5c163",
                                        "entry_id": "9280662e-c0ee-3af5-90be-58caeb29d560",
                                        "glosses": [
                                            "The glow seen in the sky after sunset."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "621fabdb-7a14-404e-9112-deaaa335d9e3",
                                                "sense_id": "5b9285b1-4446-3181-94dc-f8675eb5c163",
                                                "text": "That the sunset in Egypt is gorgeous, every body knows; but I, for one, was not aware that there is a renewal of beauty, some time after the sun has departed and left all grey. […] everything begins to brighten again in twenty minutes;—the hills are again purple or golden,—the sands orange,—the palms verdant,—the moonlight on the water, a pale green ripple on a lilac surface: and this after-glow continues for ten minutes, when it slowly fades away."
                                            },
                                            {
                                                "example_id": "17922c11-658a-4130-9e4b-f5599bedd98a",
                                                "sense_id": "5b9285b1-4446-3181-94dc-f8675eb5c163",
                                                "text": "Let my thoughts come to you, when I am gone, like the afterglow of sunset at the margin of starry silence."
                                            },
                                            {
                                                "example_id": "b9345935-e443-4e18-925d-6fc1c2911829",
                                                "sense_id": "5b9285b1-4446-3181-94dc-f8675eb5c163",
                                                "text": "Why did dusk and fir-scent and the afterglow of autumnal sunsets make people say absurd things?"
                                            },
                                            {
                                                "example_id": "2233bebf-e821-45e6-b2e2-697428f91be2",
                                                "sense_id": "5b9285b1-4446-3181-94dc-f8675eb5c163",
                                                "text": "At Stirling, we obtained a wonderful silhouette view of the Wallace Monument, and the dark line of the Ochil Hills, and the castle stood out clearly against the afterglow of the sunset."
                                            },
                                            {
                                                "example_id": "b0bd3d49-7efd-4b32-b11e-03ca3995499f",
                                                "sense_id": "5b9285b1-4446-3181-94dc-f8675eb5c163",
                                                "text": "The sun had just gone down, and its afterglow was backlighting the city, which formed low cliffs around the bucolic void to the idle stockyards."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8afb0be9-4ef2-3a8d-9440-575d6c9c14e7",
                                        "entry_id": "9280662e-c0ee-3af5-90be-58caeb29d560",
                                        "glosses": [
                                            "The light emitted by an incandescent object while cooling."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6687f0ea-04da-4939-9e18-89d51d7bbe13",
                                                "sense_id": "8afb0be9-4ef2-3a8d-9440-575d6c9c14e7",
                                                "text": "1984, Paul Auster (as Paul Benjamin), Squeeze Play, London: Faber & Faber, 1991, Chapter 19, p. 176,\nNothing will matter to you more than that [base]ball. It will hold you so completely that when you at last file out and return to the normal world, it will stay with you like the afterglow of a flashbulb that’s gone off in your eyes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1aa43d3-0e8d-3cb5-b101-7f5bbb20735a",
                                        "entry_id": "9280662e-c0ee-3af5-90be-58caeb29d560",
                                        "glosses": [
                                            "The light emitted by a phosphor after excitation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "edad4a77-3f70-301c-bcdc-7a2071638976",
                                        "entry_id": "9280662e-c0ee-3af5-90be-58caeb29d560",
                                        "glosses": [
                                            "The mildly euphoric feeling experienced after a pleasurable experience, especially after an orgasm or drug-induced high."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "491061f9-7b60-40f0-9596-8814528684d4",
                                                "sense_id": "edad4a77-3f70-301c-bcdc-7a2071638976",
                                                "text": "[…] he threw down his book, stretched his legs towards the embers in the grate, and clasped his hands at the back of his head, in that agreeable afterglow of excitement when thought lapses from examination of a specific object into a suffusive sense of its connections with all the rest of our existence […]"
                                            },
                                            {
                                                "example_id": "58c9e67b-6897-4051-a5d3-a33d700018ce",
                                                "sense_id": "edad4a77-3f70-301c-bcdc-7a2071638976",
                                                "text": "She herself had grown old as people should grow old—steadily and firmly. No interruptions, no belated after-glows and spasmodic returns."
                                            },
                                            {
                                                "example_id": "2a30bbe8-1617-4d6d-9207-c671a896846b",
                                                "sense_id": "edad4a77-3f70-301c-bcdc-7a2071638976",
                                                "text": "Nor did he cease attentions once himself glutted: he remained a wooing protagonist even in the “afterglow,” as the sex manuals call it."
                                            },
                                            {
                                                "example_id": "e7507135-bcbb-4725-a7d4-f6e40eb76092",
                                                "sense_id": "edad4a77-3f70-301c-bcdc-7a2071638976",
                                                "text": "We were merely observers, getting totally absorbed in some exciting movie, our palms all sweaty, only to find that, after the houselights came on and we exited the theater, the thrilling afterglow that coursed through us ultimately meant nothing whatsoever."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54252b61-5fcc-3c78-8e6a-2a1b0cc17753",
                                        "entry_id": "9280662e-c0ee-3af5-90be-58caeb29d560",
                                        "glosses": [
                                            "An afterparty."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ddf3ac29-19ef-47c2-8a2c-9c80ceb22c00",
                                                "sense_id": "54252b61-5fcc-3c78-8e6a-2a1b0cc17753",
                                                "text": "There's an afterglow with singing after the evening worship."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3bd3bc39-c38b-40f3-a5fe-307147381a00",
                        "source_entry_id": "a4959079-fe9a-36f4-b87c-4a0f2278e7e3",
                        "source_sense_id": "2b2a4183-8588-3620-9a00-1fe3cff2b42a",
                        "target_lang_word": "afterimage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "afterimage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cd3fdf31-f423-326b-88e4-e139bf83e002",
                                        "entry_id": "7de38789-4160-36da-a6b1-b4b56f7f1e78",
                                        "glosses": [
                                            "An image which persists or remains in negative after the original stimulation has ended."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f7fb64a-6ca4-4fa9-8dc5-8f61181b7a03",
                                                "sense_id": "cd3fdf31-f423-326b-88e4-e139bf83e002",
                                                "text": "If the fixation is wavering, especially when receiving the horizontal afterimage with the centroscope a thin pointer is used by the child to touch the fixation spot."
                                            },
                                            {
                                                "example_id": "2d771d39-b9cf-4366-9507-2d02d893a306",
                                                "sense_id": "cd3fdf31-f423-326b-88e4-e139bf83e002",
                                                "text": "The first paper, \"The hypnotic induction of hallucinatory color vision followed by pseudonegative afterimages,\" introduces an ingenious experimental paradigm whereby Erickson is able to explore the genuineness of hallucinatory color vision."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
