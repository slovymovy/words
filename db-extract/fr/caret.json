                    {
                        "sense_id": "4042af0b-cb25-33e8-bb40-193e12be8afc",
                        "entry_id": "bb74ce29-31a1-3618-a42f-e8b3379eaed5",
                        "glosses": [
                            "loggerhead turtle (Caretta caretta)"
