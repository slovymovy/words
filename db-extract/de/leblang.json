                "senses": [
                    {
                        "sense_id": "97edf3c4-a19d-3b73-9418-e199a70d6fb5",
                        "entry_id": "0766393a-81b8-3272-952d-7b8edc17b416",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fe03e49-9897-42a1-a99b-cf8ffae0fc20",
                                "sense_id": "97edf3c4-a19d-3b73-9418-e199a70d6fb5",
                                "text": "Leblangs kamen, sahen und siegten."
                            },
                            {
                                "example_id": "ac5dc9a6-96d5-485e-90ad-264adcac1816",
                                "sense_id": "97edf3c4-a19d-3b73-9418-e199a70d6fb5",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Leblang kommt, geht der Herr Leblang.“"
                            },
                            {
                                "example_id": "e23927a8-4ad4-494e-ba68-71a981ceb184",
                                "sense_id": "97edf3c4-a19d-3b73-9418-e199a70d6fb5",
                                "text": "Leblang kommt und geht."
                            },
                            {
                                "example_id": "cad95074-8fda-4840-b5b1-96d2ce973b91",
                                "sense_id": "97edf3c4-a19d-3b73-9418-e199a70d6fb5",
                                "text": "Frau Leblang ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "3290b040-207e-4c33-85bf-da0483a9cec5",
                                "sense_id": "97edf3c4-a19d-3b73-9418-e199a70d6fb5",
                                "text": "Herr Leblang wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "7a94e53d-d1a3-4957-914c-ed793a33044f",
                                "sense_id": "97edf3c4-a19d-3b73-9418-e199a70d6fb5",
                                "text": "Die Leblangs fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "74594ddb-2007-4feb-be9f-75d1ba19bf51",
                                "sense_id": "97edf3c4-a19d-3b73-9418-e199a70d6fb5",
                                "text": "Der Leblang trägt nie die Schals, die die Leblang ihm strickt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
