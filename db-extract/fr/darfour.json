        "fr-extract.jsonl": [
            {
                "entry_id": "7a254c04-9702-3028-88c5-33dc5b0c8d5d",
                "word": "Darfour",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7108c9cf-cc77-39d4-a5c1-04f51ba52d26",
                        "entry_id": "7a254c04-9702-3028-88c5-33dc5b0c8d5d",
                        "glosses": [
                            "Région de l’ouest du Soudan, dans le désert du Sahara."
                        ],
                        "tags": [
                            "toponymic"
                        ],
                        "examples": [
                            {
                                "example_id": "5e9db3c5-fde8-4986-a43d-a84e2f61ad22",
                                "sense_id": "7108c9cf-cc77-39d4-a5c1-04f51ba52d26",
                                "text": "C’est ce qui t’explique mon amour pour les torrents, les gaves, toutes les folles rivières. Je ne conçois pas un pays sans que de l’eau y bouge et y gazouille : les Causses et le Darfour, pour moi, c’est tout un."
                            },
                            {
                                "example_id": "09177b2f-15b4-4c7e-8b07-92a4e0148935",
                                "sense_id": "7108c9cf-cc77-39d4-a5c1-04f51ba52d26",
                                "text": "La zone sahélienne est peu peuplée. Entre Dakar et le Darfour, les habitants de ce « biome » ne dépassent pas vingt millions d'habitants, soit 2 % de tout le continent africain (un milliard d'habitants), et toute la population des zones de sahel ne représente pas une province du Nigeria."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fc8dcd3e-55ba-42fc-98f9-a329086e2a08",
                        "source_entry_id": "7a254c04-9702-3028-88c5-33dc5b0c8d5d",
                        "source_sense_id": "7108c9cf-cc77-39d4-a5c1-04f51ba52d26",
                        "target_lang_word": "Darfur",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Darfur",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "609eb0b0-cb26-3449-a857-7b67bd2667dc",
                                        "entry_id": "b6450650-5672-3881-a47a-ad4525db42c7",
                                        "glosses": [
                                            "Region im Westen des Sudan"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d9f4ae1-e51f-472a-a29f-2f133b555128",
                                                "sense_id": "609eb0b0-cb26-3449-a857-7b67bd2667dc",
                                                "text": "„In anderen Fällen stufte man ethnische Säuberungen als Kriegsverbrechen ein, auch wenn kein rechtliches Verfahren eingeleitet wurde (das gilt z.B. für das Vorgehen der sudanesischen Regierung in Darfur).“"
                                            },
                                            {
                                                "example_id": "66b71cfb-7feb-48a9-8f40-0197d43e799b",
                                                "sense_id": "609eb0b0-cb26-3449-a857-7b67bd2667dc",
                                                "text": "„Bei meinem Dad das Gleiche: Warum sonst versucht er immer mehr dankbare Kinder an entsetzlichen Orten wie Darfur oder Baton Rouge aufzulesen?“"
                                            },
                                            {
                                                "example_id": "c9a3b333-ec86-4b47-a544-12fb91f5aa1e",
                                                "sense_id": "609eb0b0-cb26-3449-a857-7b67bd2667dc",
                                                "text": "„›Wo haben sie dich trainiert, Youssef?‹, fragte er. ›Jaffna? Darfur?‹“"
                                            },
                                            {
                                                "example_id": "4ff55f3d-a250-40ec-80dc-0a8a6227f556",
                                                "sense_id": "609eb0b0-cb26-3449-a857-7b67bd2667dc",
                                                "text": "„Das UNO-Kriegsverbrechertribunal in Den Haag hat wegen des Völkermords in Darfur einen Haftbefehl gegen ihn ausgestellt.“"
                                            },
                                            {
                                                "example_id": "62e9bf6c-ccb8-4dcf-bdac-57e779f77648",
                                                "sense_id": "609eb0b0-cb26-3449-a857-7b67bd2667dc",
                                                "text": "„Wir könnten uns in Darfur einsetzen lassen und ein Baby adoptieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d79f9a49-0210-4fd9-ab85-8b28d2165534",
                        "source_entry_id": "7a254c04-9702-3028-88c5-33dc5b0c8d5d",
                        "source_sense_id": "7108c9cf-cc77-39d4-a5c1-04f51ba52d26",
