                "senses": [
                    {
                        "sense_id": "ac9d7faf-ec37-341e-93c0-b12ae4fa2620",
                        "entry_id": "ddba904a-1fe2-39a5-b387-c236e083c8d7",
                        "glosses": [
                            "verschiedenen Heiligen namens Katharina geweihtes Gotteshaus, das für Gottesdienste genutzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04d78d63-8a38-4a63-9fc0-31aa6f0c731b",
                                "sense_id": "ac9d7faf-ec37-341e-93c0-b12ae4fa2620",
                                "text": "„Zur in der angrenzenden früheren Katharinenkirche untergebrachten Staatsgalerie gelangt man über das Schaezlerpalais.“"
                            },
                            {
                                "example_id": "9729b256-87c2-4a82-9d59-643c5ad6a5d9",
                                "sense_id": "ac9d7faf-ec37-341e-93c0-b12ae4fa2620",
                                "text": "„Im Zuge der Christianisierung Mitteldeutschlands vor nunmehr 1.000 Jahren ist mit Marien-, Barbara- und Katharinenkirchen nicht selten auf bestimmte Qualitäten heidnischer Vorgängeranlagen reagiert worden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
