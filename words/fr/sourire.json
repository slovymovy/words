{
    "word_family": [
        "souriant",
        "resourire"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "99204d93-7492-3a6d-988c-ee5493aad937",
                    "sense_definition": "Prendre une expression faciale marquant la bienveillance, la joie ou l'amusement, par un mouvement de la bouche et des yeux.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "expression_faciale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Quand il a vu son ami arriver, il a <w>souri</w> chaleureusement."
                        },
                        {
                            "text": "La petite fille <w>sourit</w> en ouvrant son cadeau d'anniversaire."
                        }
                    ],
                    "common_phrases": [
                        "sourire aux anges",
                        "sourire de toutes ses dents"
                    ]
                },
                {
                    "sense_id": "fffb4b56-70dc-3947-aaae-8d4269862091",
                    "sense_definition": "Être favorable ou plaire à quelqu'un, en parlant du destin, de la chance ou d'une perspective.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "faveur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après des années d'efforts, la chance lui <w>sourit</w> enfin dans son travail."
                        },
                        {
                            "text": "Cette proposition de voyage ne me <w>sourit</w> pas vraiment."
                        }
                    ],
                    "synonyms": [
                        "plaire"
                    ]
                },
                {
                    "sense_id": "d27bbc19-045f-395a-ae89-04c91b45b0b0",
                    "sense_definition": "Considérer quelque chose avec une légère ironie, de la condescendance ou du scepticisme.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "ironie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ses prétentions exagérées font <w>sourire</w> tous ses collègues de bureau."
                        },
                        {
                            "text": "Le professeur a <w>souri</w> avec ironie devant cette réponse absurde."
                        }
                    ],
                    "common_phrases": [
                        "faire sourire"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "715ccc40-b8be-3b38-8195-0a4f6208bcb5",
                    "sense_definition": "Mouvement des lèvres et du visage qui exprime la joie, la sympathie ou la bienveillance.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "expression_faciale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle accueille toujours ses clients avec un grand <w>sourire</w>."
                        },
                        {
                            "text": "Malgré les difficultés de la journée, il a réussi à garder le <w>sourire</w>."
                        }
                    ],
                    "common_phrases": [
                        "garder le sourire",
                        "large sourire",
                        "esquisser un sourire",
                        "avec le sourire"
                    ]
                }
            ]
        }
    ]
}