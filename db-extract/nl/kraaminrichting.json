                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42f4783b-8f7d-4442-822a-4818d3eec4d3",
                                "sense_id": "201f072d-dc3a-3ea6-8f33-d8831f048b3a",
                                "text": "Het is geen kraaminrichting, maar een ziekenhuis en het is voor alle ziekten behalve besmettelijke, zei hij."
                            },
                            {
                                "example_id": "43f4fd6e-6bce-4062-bfdb-b26c42dfe225",
                                "sense_id": "201f072d-dc3a-3ea6-8f33-d8831f048b3a",
                                "text": "Een vrouw ontvoerde dinsdagavond een pasgeboren baby uit een kraaminrichting in de Franse stad Nancy. Op beelden van de bewakingscamera is te zien dat de vrouw een ziekenhuisjas droeg, waardoor ze waarschijnlijk niet was opgevallen bij het personeel. Dat meldden Franse media woensdag."
                            }
                        ]
                    }
