                        "glosses": [
                            "Molécule d'hydrogène où les deux protons sont alignés."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b53203b0-4f74-4869-b606-80e2087e4156",
                                "sense_id": "cae2042a-6051-3b4d-9f52-e09ef3b90aca",
                                "text": "L'orthohydrogène est instable à basse température, et se transforme spontanément en parahydrogène avec le temps, ce qui libère de la chaleur indésirable."
                            },
                            {
                                "example_id": "6518fb61-0262-42ce-a2ba-3f739d9ec6a0",
                                "sense_id": "cae2042a-6051-3b4d-9f52-e09ef3b90aca",
                                "text": "Cette multiplicité introduit donc un facteur trois dans la probabilité a priori des états de l’orthohydrogène."
                            }
                        ]
                    }
