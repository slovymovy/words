    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a454d199-dfc3-3764-89a7-071d1f75a892",
                    "sense_definition": "ein lautes, anhaltendes und brausendes Geräusch erzeugen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "geraeusch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Wellen <w>tosten</w> mit unbändiger Wucht gegen die steilen Felsen an der Küste."
                        },
                        {
                            "text": "Als die Band endlich die Bühne betrat, <w>toste</w> begeisterter Beifall durch die gesamte Halle."
                        }
                    ],
                    "common_phrases": [
                        "die Brandung tost",
                        "der Beifall tost"
                    ]
                },
                {
                    "sense_id": "c951d00f-1f0c-35f2-ab8c-758bdb266a2d",
                    "sense_definition": "sich mit brausendem oder dröhnendem Geräusch schnell vorwärtsbewegen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bewegung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ein gewaltiger Sturm <w>toste</w> die ganze Nacht über die weiten Felder."
                        },
                        {
                            "text": "Dunkle Wolken zogen auf, und der Wind <w>toste</w> unerbittlich durch die engen Straßen."
                        }
                    ],
                    "common_phrases": [
                        "durch die Nacht tosen",
                        "über das Land tosen"
                    ]
                },
                {
                    "sense_id": "2bbc82d5-6c62-3102-b47f-9e24c8c15979",
                    "sense_definition": "wild, laut und ausgelassen herumrennen oder toben",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "bewegung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die fröhlichen Kinder <w>tosten</w> den ganzen Nachmittag lautstark durch das große Haus."
                        },
                        {
                            "text": "Die Hunde <w>tosen</w> voller Energie über die grüne Wiese und jagen einander hinterher."
                        }
                    ],
                    "common_phrases": [
                        "durch das Haus tosen"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0c397117-ce91-3430-8182-7d4b8067f6ac",
                    "sense_definition": "lautes, anhaltendes und brausendes Geräusch",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "geraeusch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das laute <w>Tosen</w> des Wasserfalls übertönte alle anderen Geräusche im tiefen Tal."
                        },
                        {
                            "text": "Schon aus weiter Ferne konnte man das bedrohliche <w>Tosen</w> des herannahenden Sturms hören."
                        }
                    ],
                    "synonyms": [
                        "Getöse",
                        "Getose"
                    ],
                    "common_phrases": [
                        "das Tosen des Meeres",
                        "das Tosen des Wasserfalls"
                    ]
                }
            ]
        }
    ]
}