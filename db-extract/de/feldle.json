                ],
                "senses": [
                    {
                        "sense_id": "ea129881-e6b9-3d64-8522-3486c20b21a7",
                        "entry_id": "9a4dd3e3-f567-308b-8c89-f180a5791a9b",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e464f6ef-0833-4f29-b264-d35588c16f8c",
                                "sense_id": "ea129881-e6b9-3d64-8522-3486c20b21a7",
                                "text": "Frau Feldle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "c6e714d0-b8b1-4257-a0e1-b9ab43713802",
                                "sense_id": "ea129881-e6b9-3d64-8522-3486c20b21a7",
                                "text": "Herr Feldle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "c1828cc8-c1dc-4538-ac1b-feebbd2407f0",
                                "sense_id": "ea129881-e6b9-3d64-8522-3486c20b21a7",
                                "text": "Die Feldles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "3b3e5fc0-4bc4-4cbe-aa73-7822af666b3b",
                                "sense_id": "ea129881-e6b9-3d64-8522-3486c20b21a7",
                                "text": "Der Feldle trägt nie die Pullover, die die Feldle ihm strickt."
                            },
                            {
                                "example_id": "f6092d66-89f6-4e8a-afff-7bf2fe05e2dc",
                                "sense_id": "ea129881-e6b9-3d64-8522-3486c20b21a7",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Feldle kommt, geht der Herr Feldle.“"
                            },
                            {
                                "example_id": "adca35df-9fd3-4fca-a596-8abf4e136c2a",
                                "sense_id": "ea129881-e6b9-3d64-8522-3486c20b21a7",
                                "text": "Feldle kommt und geht."
                            },
                            {
                                "example_id": "4920709d-2965-4b7d-b06e-5a63da952966",
                                "sense_id": "ea129881-e6b9-3d64-8522-3486c20b21a7",
                                "text": "Feldles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
