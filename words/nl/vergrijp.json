{
    "word_family": [
        "vergrijpen"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6e75257e-dad4-30a1-bba9-9fc551166e63",
                    "sense_definition": "een handeling die tegen de wet of een regel ingaat",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "overtreding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het stelen van een brood is een strafbaar <w>vergrijp</w>.",
                            "target_lang_translations": {
                                "en": "Stealing a loaf of bread is a punishable <w>offense</w>."
                            }
                        },
                        {
                            "text": "De politie onderzoekt of er sprake is van een ernstig <w>vergrijp</w> tegen de openbare orde.",
                            "target_lang_translations": {
                                "en": "The police are investigating whether there has been a serious <w>violation</w> of public order."
                            }
                        }
                    ],
                    "synonyms": [
                        "misdaad",
                        "overtreding"
                    ],
                    "common_phrases": [
                        "strafbaar vergrijp",
                        "ernstig vergrijp"
                    ],
                    "target_lang_definitions": {
                        "en": "an act that goes against the law or a rule"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "offense",
                                "target_lang_sense_clarification": "a breach of law or rule"
                            },
                            {
                                "target_lang_word": "misdemeanor",
                                "target_lang_sense_clarification": "a minor wrongdoing"
                            },
                            {
                                "target_lang_word": "violation",
                                "target_lang_sense_clarification": "an act of breaking a rule or law"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1f421814-0091-3e70-bc6b-ab3ab114d092",
                    "sense_definition": "een verkeerde manier van denken of een onjuiste mening",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fout",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is een groot <w>vergrijp</w> om te denken dat succes alleen door geluk komt.",
                            "target_lang_translations": {
                                "en": "It is a major <w>misconception</w> to think that success comes only through luck."
                            }
                        },
                        {
                            "text": "Zijn bewering bleek achteraf een pijnlijke <w>vergissing</w> en een intellectueel <w>vergrijp</w>.",
                            "target_lang_translations": {
                                "en": "His claim later turned out to be a painful mistake and an intellectual <w>error</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "misvatting",
                        "vergissing"
                    ],
                    "common_phrases": [
                        "intellectueel vergrijp"
                    ],
                    "target_lang_definitions": {
                        "en": "a wrong way of thinking or an incorrect opinion"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "misconception",
                                "target_lang_sense_clarification": "a view or opinion that is incorrect"
                            },
                            {
                                "target_lang_word": "error",
                                "target_lang_sense_clarification": "a mistake in judgment or thought"
                            },
                            {
                                "target_lang_word": "fallacy",
                                "target_lang_sense_clarification": "a mistaken belief"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a01adf86-c3f9-30b4-8038-36c5585be56b",
                    "sense_definition": "eerste persoon enkelvoud tegenwoordige tijd van <w>vergrijpen</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>vergrijp</w> me nooit aan andermans eigendommen.",
                            "target_lang_translations": {
                                "en": "I never <w>help myself</w> to other people's property."
                            }
                        },
                        {
                            "text": "Soms <w>vergrijp</w> ik me aan een extra stukje chocolade bij de koffie.",
                            "target_lang_translations": {
                                "en": "Sometimes I <w>indulge</w> in an extra piece of chocolate with my coffee."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "first-person singular present indicative"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "first-person singular present indicative of 'vergrijpen' (to help oneself to, to violate, or to commit an offense)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "help myself to",
                                "target_lang_sense_clarification": "taking something one shouldn't"
                            },
                            {
                                "target_lang_word": "violate",
                                "target_lang_sense_clarification": "to break a law or treat someone/something wrongly"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c6a70ca9-5a86-3af6-9efc-4f4b1a11040f",
                    "sense_definition": "gebiedende wijs van <w>vergrijpen</w>",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Vergrijp</w> je niet aan de voorraad die voor de gasten bestemd is!",
                            "target_lang_translations": {
                                "en": "Do not <w>help yourself</w> to the supplies intended for the guests!"
                            }
                        },
                        {
                            "text": "<w>Vergrijp</w> u niet aan geweld, hoe moeilijk de situatie ook is.",
                            "target_lang_translations": {
                                "en": "Do not <w>resort</w> to violence, no matter how difficult the situation is."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "imperative"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "imperative form of 'vergrijpen' (to help oneself to, to violate, or to commit an offense)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "do not help yourself to",
                                "target_lang_sense_clarification": "commanding not to take something"
                            },
                            {
                                "target_lang_word": "do not violate",
                                "target_lang_sense_clarification": "commanding not to break a law or rule"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}