                "senses": [
                    {
                        "sense_id": "6935e7eb-cd61-3374-84a7-a664cc6bec9f",
                        "entry_id": "0a4bcce7-70cc-3d7f-b6eb-2321c44430e8",
                        "glosses": [
                            "een regering, groepering of persoon die heerst door de bevolking schrik aan te jagen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db54dcc2-27ea-4f84-8406-858fe6b61de7",
                                "sense_id": "6935e7eb-cd61-3374-84a7-a664cc6bec9f",
                                "text": "Dit weekend werd bekend­gemaakt dat Reyes na vier jaar schrikbewind opnieuw was opgepakt na een inval van de politie in zijn huis. De voorbije maand zou hij minstens tien moorden op zijn geweten hebben."
                            },
                            {
                                "example_id": "6e4472b6-6bb2-4081-83e4-28a225ed8021",
                                "sense_id": "6935e7eb-cd61-3374-84a7-a664cc6bec9f",
                                "text": "In Ethiopië wacht E. A. (63) de doodstraf. Maar Nederland wil hem zelf berechten voor de 321 oorlogsmisdaden die de Ethiopische Nederlander gepleegd zou hebben tijdens het schrikbewind van kolonel Mengistu in de jaren 70. In Den Haag begint vandaag de rechtszaak."
                            }
                        ]
                    }
                ],
