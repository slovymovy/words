                "senses": [
                    {
                        "sense_id": "992ef691-286f-3abd-bff8-629517180b3b",
                        "entry_id": "840b19a1-e20e-3de4-9f2c-a49115a5e01c",
                        "glosses": [
                            "Region, in das viele Flüchtlinge geflohen sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf3b3415-c456-4ea8-a5c9-9c8b1fb0d9b6",
                                "sense_id": "992ef691-286f-3abd-bff8-629517180b3b",
                                "text": "„Fast die Hälfte aller Zechen beschäftigt eigene Werksärzte, und über ein Drittel aller Zechen besitzt eigene Gesundheitshäuser. In 70 Berglehrlingsheimen und 5 Pestalozzidörfern haben vor allem solche Berglehrlinge Aufnahme gefunden, die aus Flüchtlingsgebieten stammen. Der Berglehrling verdient während seiner Ausbildung mehr als jeder andere Lehrling, und zwar monatlich bei 25 Schichten und einem Lehrbeginn im Alter von 14 ( 15 , 16 ) Jahren im ersten Lehrjahr über Tage 138 ( 165 , 192 ) DM, ein Betrag, der sich im dritten Lehrjahr unter Tage auf 238 ( 266 , 294 ) DM steigert.“"
                            }
                        ],
