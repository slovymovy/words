                "translations": [
                    {
                        "translation_id": "5defb79c-8ee0-4708-96ba-6dabd9598b21",
                        "source_entry_id": "c3f2751c-5d24-3a66-844d-206b4d6609f1",
                        "source_sense_description": "being or having been flambéed",
                        "target_lang_word": "flambé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flambé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ab7832c9-ad70-363a-967e-8cf8fab56c4c",
                                        "entry_id": "b713d488-8bdf-3f04-8c9e-7343a9ba5d5b",
                                        "glosses": [
                                            "Enflammé à l’aide d’alcool ou d’un spiritueux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9154f1ee-a72d-49fa-94cf-1d1db778c4fe",
                                                "sense_id": "ab7832c9-ad70-363a-967e-8cf8fab56c4c",
                                                "text": "Ce n’est pas boire, je suppose, que goûter à ces pêches flambées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6cac5e8d-09b6-3745-bb0f-f2c01c4985d7",
                                        "entry_id": "b713d488-8bdf-3f04-8c9e-7343a9ba5d5b",
                                        "glosses": [
                                            "Qui est ruiné ou perdu ; dont il n’y a plus rien à attendre."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "318ed03d-6af6-4dba-87c7-95023d2be846",
                                                "sense_id": "6cac5e8d-09b6-3745-bb0f-f2c01c4985d7",
                                                "text": "[…] je sais ce que c'est... j'ai eu un coup de sang... j'en aurai un second dans deux heures ou dans deux mois... c'est une affaire de temps... je suis f... lambé... je m'en fiche... mais il y a un gamin, ça m'intéresse... […]"
                                            },
                                            {
                                                "example_id": "6c0a7b5a-a9fd-4755-a97c-36f1c8ef6717",
                                                "sense_id": "6cac5e8d-09b6-3745-bb0f-f2c01c4985d7",
                                                "text": "[…] ; et voilà ma comédie flambée, pour plaire aux princes mahométans, dont pas un, je crois ne sait lire, et qui nous meurtrissent l’omoplate, en nous disant : Chiens de chrétiens !"
                                            },
                                            {
                                                "example_id": "fce8e171-fec9-4085-8b16-a22ff5aaa1f4",
                                                "sense_id": "6cac5e8d-09b6-3745-bb0f-f2c01c4985d7",
                                                "text": "Il me faut cent francs pour dimanche, reprit Hutin. Si je ne me fais pas mes douze francs par jour en moyenne, je suis flambé."
                                            },
                                            {
                                                "example_id": "44ae879b-ef6c-4b57-933e-4bd5f413cf57",
                                                "sense_id": "6cac5e8d-09b6-3745-bb0f-f2c01c4985d7",
                                                "text": "Plantin n’était plus sur la terre commune, Plantin était flambé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7256fbe7-c6b6-3e32-9015-c40257d05228",
                                        "entry_id": "b713d488-8bdf-3f04-8c9e-7343a9ba5d5b",
                                        "glosses": [
                                            "Qualifie un tissu chiné par la chaîne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7165e54-7e88-40f7-9432-c46693dd396e",
                                                "sense_id": "7256fbe7-c6b6-3e32-9015-c40257d05228",
                                                "text": "Elle y avait trouvé une grande robe en taffetas flambé, qui criait du froissement de ses plis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58e46092-712a-3968-924b-56394a39ce54",
                                        "entry_id": "b713d488-8bdf-3f04-8c9e-7343a9ba5d5b",
                                        "glosses": [
                                            "Qualifie un navire, à qui l’amiral signalait par un pavillon que sa manœuvre était mal exécutée."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "flambé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "310aca1e-2a89-3f9c-a5e4-bb9e02217572",
                                        "entry_id": "1024df6c-2d00-32ec-900d-03d02c47f817",
                                        "glosses": [
                                            "Insecte lépidoptère de la famille des papilionidés, grand papillon diurne vivement coloré (blanc, bandes noires, bleu et jaune-orange), et pourvu d'une longue queue aux ailes postérieures."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff6c1cf6-e62b-430d-b615-6f06d0c143d7",
                                                "sense_id": "310aca1e-2a89-3f9c-a5e4-bb9e02217572",
                                                "text": "La chenille du flambé se nourrit sur des rosacées : fruitiers, Prunus (prunelier)."
                                            },
                                            {
                                                "example_id": "a551306a-44a2-4039-bdbb-8353727f72b0",
                                                "sense_id": "310aca1e-2a89-3f9c-a5e4-bb9e02217572",
                                                "text": "[Un papillon] portant queue, à la manière des flambés de France."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "flambé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "82e2c71f-e0a4-31a6-84fe-7637971a88e0",
                                        "entry_id": "3e3f1f91-6a06-3e6e-9fd7-c03db1c3f961",
                                        "glosses": [
                                            "Participe passé masculin singulier du verbe flamber."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "580b99e1-4d60-4634-bd2d-b102ed77d46d",
                                                "sense_id": "82e2c71f-e0a4-31a6-84fe-7637971a88e0",
                                                "text": "Et je n’évoque pas les honoraires des cabinets d’architecture, qui ont flambé depuis que les foilers se sont imposés il y a huit ans."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
