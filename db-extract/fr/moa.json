                "senses": [
                    {
                        "sense_id": "aafc9817-325d-347a-871c-f451d90194cc",
                        "entry_id": "a63bc16e-675e-3990-8f60-7921d72ad1a1",
                        "glosses": [
                            "Une des espèces d'oiseaux terrestres (ratites) géants (jusqu'à trois mètres de haut), incapables de voler, originaires de Nouvelle-Zélande, éteintes après l'arrivée des ancêtres des Maori."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4ff572d-097e-4685-9c42-ba62b921001d",
                                "sense_id": "aafc9817-325d-347a-871c-f451d90194cc",
                                "text": "Après quelques minutes de chasse, ces insaisissables moas disparurent derrière les grands arbres."
                            },
                            {
                                "example_id": "b6867112-e9b8-4583-b46a-5c32b2987621",
                                "sense_id": "aafc9817-325d-347a-871c-f451d90194cc",
                                "text": "Parmi les animaux victimes de ces événements, on note les mammouths, les mastodontes, les mégathériums, les rhinocéros laineux, certains kangourous, les moas (oiseaux non volants qui vivaient en Nouvelle-Zélande)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c0ebf14b-ec81-4df5-8ac8-8397155c1684",
                        "source_entry_id": "a63bc16e-675e-3990-8f60-7921d72ad1a1",
                        "source_sense_id": "aafc9817-325d-347a-871c-f451d90194cc",
                        "target_lang_word": "moa",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "moa",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c8705f7e-9e12-3c0f-b1b8-0c5d1da24d81",
                                        "entry_id": "7d7ff2e3-a7d2-33f2-ab97-fedf43826184",
                                        "glosses": [
                                            "Any of several species of large, extinct, flightless birds of the family Dinornithidae that were native to New Zealand; until its extinction, one species was the largest bird in the world."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e5c2ec7-b7b7-4dc7-96a0-e256bd2cb215",
                                                "sense_id": "c8705f7e-9e12-3c0f-b1b8-0c5d1da24d81",
                                                "text": "The moas (order Dinornithiformes) of New Zealand are likewise extinct but almost certainly some still survived when Tasman first sighted the islands in 1642."
                                            },
                                            {
                                                "example_id": "b9a647ba-8872-4e60-ae7e-c1a0ad7c69b7",
                                                "sense_id": "c8705f7e-9e12-3c0f-b1b8-0c5d1da24d81",
                                                "text": "For instance, the little bush moa fed nearly exclusively on forest vegetation, whereas the heavy-footed moa was a grazer in open vegetation habitats."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "529b1575-078c-3319-955e-e0fe019db459",
                                        "entry_id": "7d7ff2e3-a7d2-33f2-ab97-fedf43826184",
                                        "glosses": [
                                            "An extremely tall individual."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "uncommon"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
