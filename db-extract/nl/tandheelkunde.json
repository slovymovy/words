                    {
                        "sense_id": "12d1a83e-0474-379c-8d8e-4da654c39adf",
                        "entry_id": "265f96b4-1858-3815-b4f4-3ed8b6962d1d",
                        "glosses": [
                            "wetenschap voor de verzorging van de tanden"
                        ],
                        "tags": [],
