                "forms": [],
                "senses": [
                    {
                        "sense_id": "69b7a996-c1a8-301a-b3f9-3557a2b7b85e",
                        "entry_id": "0d293d64-e970-3b44-80cf-8866e068ac6f",
                        "glosses": [
                            "A female given name from Ancient Greek, the Spanish and Italian form of Theresa."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "407f8374-2814-448f-ae54-59c16264c36a",
                                "sense_id": "69b7a996-c1a8-301a-b3f9-3557a2b7b85e",
                                "text": "My friends call me Terry. My husband always used my full name, Teresa. He said it made him feel like he was married to a foreign woman."
                            },
                            {
                                "example_id": "c31fcc52-f9d8-4567-9f0c-7f3e751b065e",
                                "sense_id": "69b7a996-c1a8-301a-b3f9-3557a2b7b85e",
                                "text": "Cynthia and Melinda, reduced to Cindy and Mindy, as Carella had dreaded would happen from the moment she named them. Her older daughter had fared better. Tess, modern and sleek for Teresa, which conjured up cobblestoned streets in a mountain village in Potenza."
                            }
                        ]
                    },
                    {
                        "sense_id": "5855d7ec-a867-3d59-854c-e87a91b79e82",
                        "entry_id": "0d293d64-e970-3b44-80cf-8866e068ac6f",
                        "glosses": [
                            "A municipality of Rizal, Philippines."
