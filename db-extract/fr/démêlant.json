                        "sense_id": "20928a8a-7a15-385f-acda-e817871a4691",
                        "entry_id": "780033f5-2fb9-3fcf-9da8-475d44369837",
                        "glosses": [
                            "Qui démêle ou facilite le démêlage des cheveux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0729610f-4581-46e8-a514-603108b513d1",
                                "sense_id": "20928a8a-7a15-385f-acda-e817871a4691",
                                "text": "Un shampoing démêlant."
                            },
                            {
                                "example_id": "5f885a1b-2be0-44b5-9f5a-50f713f165fd",
                                "sense_id": "20928a8a-7a15-385f-acda-e817871a4691",
                                "text": "Une lotion démêlante."
                            },
                            {
                                "example_id": "bfaacbc2-12ec-4f22-bdc2-cd4bf9072694",
                                "sense_id": "20928a8a-7a15-385f-acda-e817871a4691",
                                "text": "Une brosse démêlante."
                            }
                        ]
                    },
                    {
                        "sense_id": "f9203578-7ce0-3a31-b329-12c148e08347",
                        "entry_id": "780033f5-2fb9-3fcf-9da8-475d44369837",
                        "glosses": [
                            "Qui démêle ou facilite le démêlage des poils d’animaux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3cad5890-fc1a-42a5-b4af-f9a35e1ebddc",
                                "sense_id": "f9203578-7ce0-3a31-b329-12c148e08347",
                                "text": "Le bain de votre chat ne doit pas être effectué plus de 4 fois par an. N’oubliez surtout pas d’utiliser un shampoing pour chat. Si le pelage de votre chat est mi-long à long, vous pouvez également opter pour un shampoing démêlant qui facilitera le brossage qui s’ensuivra."
                            }
                        ]
                    }
                ],
