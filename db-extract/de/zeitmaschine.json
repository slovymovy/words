                    {
                        "sense_id": "65b9a2b8-bafc-33c3-a4ae-cee5f754ba1e",
                        "entry_id": "558935b7-bb70-3676-9077-116b17f1df59",
                        "glosses": [
                            "fiktive Apparatur, mit deren Hilfe Zeitreisen in die Vergangenheit oder Zukunft durchgeführt werden können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "382e260e-6bc5-4010-9625-6b2617bfcca9",
                                "sense_id": "65b9a2b8-bafc-33c3-a4ae-cee5f754ba1e",
                                "text": "Zeitmaschinen sind ein beliebtes Thema in Büchern und Filmen der Science-Fiction."
                            },
                            {
                                "example_id": "44e61e3e-60a7-4c6e-8276-95395ac52d3c",
                                "sense_id": "65b9a2b8-bafc-33c3-a4ae-cee5f754ba1e",
                                "text": "„Es war wie ein Ausflug mit der Zeitmaschine.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d1e9b1a7-fe6a-400d-bbb0-580f9f6e35e4",
                        "source_entry_id": "558935b7-bb70-3676-9077-116b17f1df59",
                        "source_sense_id": "65b9a2b8-bafc-33c3-a4ae-cee5f754ba1e",
                        "source_sense_description": "fiktive Apparatur zur Durchführuung von Zeitreisen in die Vergangenheit oder Zukunft",
                        "target_lang_word": "time machine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "time machine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "702844bb-a668-3a30-a17a-7959f83772f6",
                                        "entry_id": "b2aee70b-a8be-343b-ae32-ec44e51fcacc",
                                        "glosses": [
                                            "A hypothetical device used to travel into the past or the future."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "188f1fb4-487b-4d05-806f-ad2eece16fb8",
                                                "sense_id": "702844bb-a668-3a30-a17a-7959f83772f6",
                                                "text": "If I had a time machine / And if life was a movie scene / I'd rewind, and I'd tell me / \"Ru-u-u-u-u-u-u-un\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce5d4c25-07f8-3752-9379-75d9d1c0a72a",
                                        "entry_id": "b2aee70b-a8be-343b-ae32-ec44e51fcacc",
                                        "glosses": [
                                            "Something that appears to take a person or thing to another time, for example through nostalgia or delay."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a324325c-ccb1-4d45-abbb-c2c180bb4043",
                                                "sense_id": "ce5d4c25-07f8-3752-9379-75d9d1c0a72a",
                                                "text": "It's a time machine for Photoshop. It's magic. Image makers can not just combine different images, but different points in time from each image."
                                            },
                                            {
                                                "example_id": "ebabc866-b459-4e5d-a17f-28fed49ffbb0",
                                                "sense_id": "ce5d4c25-07f8-3752-9379-75d9d1c0a72a",
                                                "text": "Conrad Riker, The Last Days of Manhood\nMayo Clinic research shows heavy squats spike growth hormone by 530%. That's not exercise — it's a time machine for your cells."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c0a637fc-c3c1-4c98-9808-d824dde8af38",
                        "source_entry_id": "558935b7-bb70-3676-9077-116b17f1df59",
                        "source_sense_id": "65b9a2b8-bafc-33c3-a4ae-cee5f754ba1e",
                        "source_sense_description": "fiktive Apparatur zur Durchführuung von Zeitreisen in die Vergangenheit oder Zukunft",
                        "target_lang_word": "macchina del tempo",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "macchina del tempo",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "93c7c4b5-3b06-3585-8d25-fa37bfa1b4b6",
                                        "entry_id": "6fdf707d-b358-3ede-9aee-37718a2a77d9",
                                        "glosses": [
                                            "nella letteratura e nel cinema di fantascienza, macchina per trasferirsi nel futuro o nel passato quindi al di là del presente, spesso con più cose concentrate nel medesimo luogo, sia anche in modo \\\"surreale\\\", in modo da approfondire i \\\"retroscena\\\" ed agire conseguentemente, sia per sé sia per chi è vicino o prossimo nel cosiddetto \\\"viaggio nel tempo\\"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43771e6a-b1bb-4c3c-b275-f1463ad1ee69",
                                                "sense_id": "93c7c4b5-3b06-3585-8d25-fa37bfa1b4b6",
                                                "text": "\"La macchina del tempo sembra letteralmente una follia... e forse anche come parabola\""
                                            }
                                        ]
                                    }
                                ]
                            }
