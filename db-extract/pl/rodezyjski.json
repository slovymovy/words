                                        "glosses": [
                                            "Qui a un rapport avec la Rhodésie ou ses habitants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6462d238-3d14-4d6e-b9d7-de57a1557893",
                                                "sense_id": "2d61f360-1c0c-39bf-b9d7-8bcd9432598d",
                                                "text": "Il doit mener le télégraphe jusqu’à l’extrémité septentrionale du territoire britannique, si toutefois, l’Allemagne ou l’État du Congo lui permettent de poursuivre son œuvre au delà du Nord rhodésien."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2fd6072a-47c6-3e49-bf15-2c64574ee990",
                                        "entry_id": "d6a2caaa-73be-3f80-a8fb-f2de5155a3f9",
                                        "glosses": [
                                            "Qui a rapport avec la Rhodésie et ses politiques de discrimination et de suprémacisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2889e634-6e3a-46a9-9dab-03c58fd61a3f",
                                                "sense_id": "2fd6072a-47c6-3e49-bf15-2c64574ee990",
                                                "text": "Dans tout le tollé d’indignation soulevé par l’arrogance rhodésienne du PDG d’Air Canada, une rare voix s’est élevée pour s’en réjouir."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
