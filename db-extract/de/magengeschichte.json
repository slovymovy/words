                ],
                "senses": [
                    {
                        "sense_id": "97683d02-92cb-32f0-ad0b-3fae8fd7f845",
                        "entry_id": "e2749a1f-7dbe-3148-a1f9-9aec3f577b9f",
                        "glosses": [
                            "vom Magen ausgehende Beschwerden"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "c1af7dd1-45f0-4eb4-b416-118b940a92f5",
                                "sense_id": "97683d02-92cb-32f0-ad0b-3fae8fd7f845",
                                "text": "„Dr. Stalkowski, der erfahren hat, daß Tiltmann gegen Magengeschichten Arzneien nimmt, diagnostiziert auf Arzneimittelvergiftung.“"
                            },
                            {
                                "example_id": "ec644b99-4523-4f3b-9a6a-c60256c2ea06",
                                "sense_id": "97683d02-92cb-32f0-ad0b-3fae8fd7f845",
                                "text": "„An jenem Freitagabend, von den Schweden kommend, muß ich mit einer Magengeschichte, die ich mir am Nil eingehandelt habe, ins Bett.“"
                            },
                            {
                                "example_id": "b2c342d3-dd3b-4288-89cf-2d08abb10386",
                                "sense_id": "97683d02-92cb-32f0-ad0b-3fae8fd7f845",
                                "text": "„Zudem seien vor allem viele ältere Menschen im Februar von Magen-Darm-Infektionen heimgesucht worden: ‚Diese Magengeschichte kommt überfallartig und dauert dann etwa drei Tage.‘“"
                            },
                            {
                                "example_id": "420be1ba-a246-490c-8324-7a8dbec46586",
                                "sense_id": "97683d02-92cb-32f0-ad0b-3fae8fd7f845",
                                "text": "„Auffallend ist, dass es gerade in dieser Generation ein hohes Maß an psychosomatischen Erkrankungen gibt: Magengeschichten, Herzbeschwerden, nervöse Störungen.“"
                            },
                            {
                                "example_id": "4efeb53b-aa44-4d80-8ad0-5e296578e8d8",
                                "sense_id": "97683d02-92cb-32f0-ad0b-3fae8fd7f845",
                                "text": "„War der Papa in einem guten Zustand, dann plagte sich die Mama, meistens mit einer Magengeschichte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3171f772-5298-4ef5-a1e0-16cf588e0097",
                        "source_entry_id": "e2749a1f-7dbe-3148-a1f9-9aec3f577b9f",
                        "source_sense_id": "97683d02-92cb-32f0-ad0b-3fae8fd7f845",
                        "source_sense_description": "umgangssprachlich: vom Magen ausgehende Beschwerden",
                        "target_lang_word": "truc",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "truc",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d0a32e32-bb59-3240-bbd2-eb09f271f2b0",
                                        "entry_id": "fc8a8199-938d-3363-ae9d-ded0e25b52a0",
                                        "glosses": [
                                            "Astuce, tour de main, procédé ingénieux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71527043-9172-4ca0-9a37-52f67801543e",
                                                "sense_id": "d0a32e32-bb59-3240-bbd2-eb09f271f2b0",
                                                "text": "C’est un de leurs trucs, un cuisinier (espion) d’un nouveau genre, répondit Fil-de-Soie."
                                            },
                                            {
                                                "example_id": "fba08ce4-2c7b-4208-aa06-9cd753fc9aa0",
                                                "sense_id": "d0a32e32-bb59-3240-bbd2-eb09f271f2b0",
                                                "text": "On vient d’arrêter et d’envoyer au Dépôt un charbonnier, le nommé Gandillot, qui avait trouvé un excellent truc pour faire fortune aux dépens de la bourse et de la santé de ses clients. Cet honnête industriel livrait à ses pratiques, au lieu de l’eau qu’on lui demandait, un petit vin blanc de son pays qu’il achetait à vil prix."
                                            },
                                            {
                                                "example_id": "b52d061b-50ce-4ff4-b69a-2f0d484a1f7c",
                                                "sense_id": "d0a32e32-bb59-3240-bbd2-eb09f271f2b0",
                                                "text": "Tous les trucs qu’il avait vu pratiquer, toutes les ficelles enregistrées au cours d’une expérience de camionneur déjà longue, des pistes pourries du llano vénézuélien aux pentes escarpées des Andes, il les passa en revue, et un par un les rejeta : ça ne collait pas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "567dea69-1d8d-3722-88f7-faa729cfec8c",
                                        "entry_id": "fc8a8199-938d-3363-ae9d-ded0e25b52a0",
                                        "glosses": [
                                            "Quelque chose dont on ne connait pas le nom, ou dont on se méfie."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f508e036-a06b-4684-addd-6b092e3ea430",
                                                "sense_id": "567dea69-1d8d-3722-88f7-faa729cfec8c",
                                                "text": "On n'a pas envie de blablater. Il nous arrive un truc fumant, une dégueulasserie de haut style. Pour se dépêtrer d'une merderie pareille, il convient de conserver la tête froide."
                                            },
                                            {
                                                "example_id": "922c2a73-42ae-4d50-8776-4c31eeaf46b6",
                                                "sense_id": "567dea69-1d8d-3722-88f7-faa729cfec8c",
                                                "text": "Faut que tu te lèves, que tu te tapes le R.E.R., que tu répondes pas quand le patron te donne des ordres pour taffer un truc de merde. Trop relou."
                                            },
                                            {
                                                "example_id": "4c09df12-c0f5-4ef5-a7ce-8f0b85050ad2",
                                                "sense_id": "567dea69-1d8d-3722-88f7-faa729cfec8c",
                                                "text": "Ils le laissèrent sur le carreau les quatre fers en l'air, la bouche ensanglantée, gueulant des trucs incompréhensibles, genre poursuites pénales, dommages et intérêts, liberté de la presse, le tout au milieu d'une myriade de projos et de micros, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0082368e-fab5-3b38-90c9-f88dbf6cac92",
                                        "entry_id": "fc8a8199-938d-3363-ae9d-ded0e25b52a0",
                                        "glosses": [
                                            "Montagne arrondie."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "70599533-b41c-3f13-a68b-2bc4e14b7384",
                                        "entry_id": "fc8a8199-938d-3363-ae9d-ded0e25b52a0",
                                        "glosses": [
                                            "Performance très bonne et inattendue d'un cheval dans une course."
                                        ],
                                        "tags": [
                                            "Sports hippiques"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3dc3a2e1-e961-4997-a407-b085cbe70af1",
                                                "sense_id": "70599533-b41c-3f13-a68b-2bc4e14b7384",
                                                "text": "Après son truc sur la cendrée de Vincennes la dernière fois, ce cheval est dans la ligne de mire des parieurs."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "truc",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cfa08b92-c851-3069-99d1-a4194e37b3df",
                                        "entry_id": "7abf179c-6905-3635-8768-f9d94d550cc8",
                                        "glosses": [
                                            "Long wagon, ou chariot en manière de plate-forme destiné au transport des matières lourdes sur les chemins de fer."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "truc",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "93ff45cc-d351-3f17-ab19-f9d3c0cb9493",
                                        "entry_id": "f7ce6502-bba0-3cc4-b9e5-bf2bb35c1198",
                                        "glosses": [
                                            "En substitution à un adjectif que l’on ne souhaite pas préciser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "986ab7ec-6fa2-4e8d-a699-9adde36c601c",
                                                "sense_id": "93ff45cc-d351-3f17-ab19-f9d3c0cb9493",
                                                "text": "Espaces localement truc."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "04b23e93-b64c-44cc-a984-d26d23ebf3a2",
                        "source_entry_id": "e2749a1f-7dbe-3148-a1f9-9aec3f577b9f",
                        "source_sense_id": "97683d02-92cb-32f0-ad0b-3fae8fd7f845",
                        "source_sense_description": "umgangssprachlich: vom Magen ausgehende Beschwerden",
                        "target_lang_word": "estomac",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "estomac",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8dd1dc07-31a3-3231-a9f6-acfaa837799f",
                                        "entry_id": "76f81a89-60a1-3ac1-bee7-e7306c1cbd89",
                                        "glosses": [
                                            "Organe interne qui, dans le corps de l’être humain ou de l’animal, est destiné à recevoir et à digérer les aliments."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02e17e5b-8a6f-40f4-b25a-c3d0336a0d7a",
                                                "sense_id": "8dd1dc07-31a3-3231-a9f6-acfaa837799f",
                                                "text": "Dans l'état de vacuité, la membrane muqueuse de l’estomac est d'une couleur grisâtre."
                                            },
                                            {
                                                "example_id": "bc8ed1b6-3907-49cb-beb6-d08214fe8047",
                                                "sense_id": "8dd1dc07-31a3-3231-a9f6-acfaa837799f",
                                                "text": "Nous, nous attendions confiants, car nous savons que ni la trifluraline, ni la clopyralid, ni la propyzamide ne peuvent intoxiquer les animaux. Même si les lièvres avaient effectivement les estomacs remplis de colza."
                                            },
                                            {
                                                "example_id": "426966f2-8ace-426d-86dc-823015f012fb",
                                                "sense_id": "8dd1dc07-31a3-3231-a9f6-acfaa837799f",
                                                "text": "Je fondis plus vite encore que l’antihypertenseur dans la soupe acide de mon estomac."
                                            },
                                            {
                                                "example_id": "fdb74324-2a57-4aa7-a786-ebb956121f90",
                                                "sense_id": "8dd1dc07-31a3-3231-a9f6-acfaa837799f",
                                                "text": "Avec son appétit, son esprit s’était éveillé. C’était dans l’estomac qu’était placé chez lui l’organe de la bienveillance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a986fc42-2ece-3190-8b30-946875aedeff",
                                        "entry_id": "76f81a89-60a1-3ac1-bee7-e7306c1cbd89",
                                        "glosses": [
                                            "Symbolise le processus de digestion, la capacité à digérer."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28c5d14e-9626-48bf-8a74-e06d59e25ef2",
                                                "sense_id": "a986fc42-2ece-3190-8b30-946875aedeff",
                                                "text": "Et ce pauvre hère, ragaillardi lui aussi par le thé et la bonne chère, traduit alors la reconnaissance de son estomac repu par un concert qui porte la satisfaction générale à son comble."
                                            },
                                            {
                                                "example_id": "bcd71a5e-e16f-4444-9c30-c48e852ac76a",
                                                "sense_id": "a986fc42-2ece-3190-8b30-946875aedeff",
                                                "text": "Avoir un bon estomac, avoir un estomac solide."
                                            },
                                            {
                                                "example_id": "0326d255-042f-4d26-9f87-efc36f22f058",
                                                "sense_id": "a986fc42-2ece-3190-8b30-946875aedeff",
                                                "text": "Ces viandes pèsent sur l’estomac. — Elles sont difficiles à digérer."
                                            },
                                            {
                                                "example_id": "b75bcb3c-2371-4ce8-8e8a-317824c532fb",
                                                "sense_id": "a986fc42-2ece-3190-8b30-946875aedeff",
                                                "text": "Avoir un estomac d’autruche. — Avoir une grande facilité à digérer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "979efaaf-8900-3bba-8f84-864414f22a60",
                                        "entry_id": "76f81a89-60a1-3ac1-bee7-e7306c1cbd89",
                                        "glosses": [
                                            "Cran, courage."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4ca9309-de4b-4f30-96c6-3a27a9e197b0",
                                                "sense_id": "979efaaf-8900-3bba-8f84-864414f22a60",
                                                "text": "— Dites, mais c’est votre père avec cette Silviane ! Regardez-les, regardez-les… Ah bien ! il en a un estomac, de se montrer ici avec elle !"
                                            },
                                            {
                                                "example_id": "361831b4-019e-483b-9a16-80756086c8d6",
                                                "sense_id": "979efaaf-8900-3bba-8f84-864414f22a60",
                                                "text": "Ce que le grade vous donne de « l’estomac ! » Ce que la subalternisation vous déprime !…"
                                            },
                                            {
                                                "example_id": "ac24f735-d4d0-4147-89c0-5608bd589d51",
                                                "sense_id": "979efaaf-8900-3bba-8f84-864414f22a60",
                                                "text": "Avoir de l’estomac. — Avoir du cran."
                                            },
                                            {
                                                "example_id": "6cd78c41-6e5a-40c1-baf7-934fa19a810d",
                                                "sense_id": "979efaaf-8900-3bba-8f84-864414f22a60",
                                                "text": "Faire à l'estomac. - Crâner, faire le brave."
                                            },
                                            {
                                                "example_id": "02ca352f-1bcd-46f4-9234-d6b047124794",
                                                "sense_id": "979efaaf-8900-3bba-8f84-864414f22a60",
                                                "text": "Dès notre première entrevue, il m’était apparu que cette créature chétive, que ce serf manquerait d’estomac, et que sa mère, hantée par des souvenirs judiciaires, lui conseillerait de composer avec la famille et de vendre son secret le plus cher possible."
                                            },
                                            {
                                                "example_id": "c5953fb8-4181-409f-af99-a1699b588b7b",
                                                "sense_id": "979efaaf-8900-3bba-8f84-864414f22a60",
                                                "text": "… c'est du flan. Le général est en train de le lui faire à l'estomac."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "853906e9-b87a-39ff-8c9b-e88399b116b1",
                                        "entry_id": "76f81a89-60a1-3ac1-bee7-e7306c1cbd89",
                                        "glosses": [
                                            "Partie extérieure du corps qui correspond au bas de la poitrine et au haut de l’abdomen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "503385d6-38ae-4a01-8655-bb5cb8020b8c",
                                                "sense_id": "853906e9-b87a-39ff-8c9b-e88399b116b1",
                                                "text": "J’avais comme une barre à l’estomac, et dans le cerveau quelque chose qui me brûlait. Je fus près de défaillir."
                                            },
                                            {
                                                "example_id": "22760a3b-7fbf-4b7d-9f47-77a7f0004179",
                                                "sense_id": "853906e9-b87a-39ff-8c9b-e88399b116b1",
                                                "text": "[…] avec cette chaleur, en pleine nuit, il porte sur le crâne, de guingois, un Borsalino beige, une chemise à pois blancs sur fond noir qui zigzague au bombé de l’estomac […]"
                                            },
                                            {
                                                "example_id": "fd75688e-c53e-47d0-833b-3a16bba88afc",
                                                "sense_id": "853906e9-b87a-39ff-8c9b-e88399b116b1",
                                                "text": "En s’allongeant sur le dos, l’estomac rentré, et en tirant fort sur la fermeture Éclair, elle parvint à fermer le pantalon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
