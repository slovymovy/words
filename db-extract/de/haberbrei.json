                        "glosses": [
                            "Speise aus geschrotetem Hafer, der in Wasser oder Milch zu einem Brei gekocht wird"
                        ],
                        "tags": [
                            "Austrian German",
                            "South-German",
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "5c4bd76d-ccdb-450f-92fe-afd7c5a61f94",
                                "sense_id": "4f540cf4-9d64-3839-a28a-7775484d69d3",
                                "text": "„Habermus und Haberbrei sind gegenwärtig auf einem reichen Bauerntisch, was Kutteln und Krös auf einem Herrentisch, und mit Unrecht: Haberspeisen waren unserer Väter Speisen, sind sicher nahrhafter als dünne Kaffeebrühe und blosse Kartoffeln.“"
                            },
                            {
                                "example_id": "2bf2770a-2368-413f-a18c-9593331a9a35",
                                "sense_id": "4f540cf4-9d64-3839-a28a-7775484d69d3",
                                "text": "„»Gerstenschleim und Haberbrei / Lieben wir ja alle!«“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
