                ],
                "senses": [
                    {
                        "sense_id": "f032510f-96c1-30b2-abde-edc4c65dbfbe",
                        "entry_id": "f730faeb-e547-3192-8249-99b73a398ac3",
                        "glosses": [
                            "Literatur über Reisen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fe2fc66-45a0-4ead-b2c8-6fc11a23f312",
                                "sense_id": "f032510f-96c1-30b2-abde-edc4c65dbfbe",
                                "text": "„Das Büchlein hat das Genre der Reiseliteratur auf den Kopf gestellt.“"
                            },
                            {
                                "example_id": "ad95e927-2b2d-4bc0-b6c9-df0624d72267",
                                "sense_id": "f032510f-96c1-30b2-abde-edc4c65dbfbe",
                                "text": "„Anders als heutige Reisende, die mit einem Tagebuch, einer Kamera und einem Vertrag für ein Buch in der Tasche aufbrechen, hatte er nie die Absicht, durch einen Beitrag zur Reiseliteratur berühmt zu werden.“"
                            },
                            {
                                "example_id": "4fc230a3-08d3-4a86-b78e-46a55d5a7f33",
                                "sense_id": "f032510f-96c1-30b2-abde-edc4c65dbfbe",
                                "text": "„Seltsamerweise hat Reiseliteratur einen schlechten Ruf.“"
                            },
                            {
                                "example_id": "d16470af-6cc2-42fe-8e3c-de36b79cefe4",
                                "sense_id": "f032510f-96c1-30b2-abde-edc4c65dbfbe",
                                "text": "„Als mir 2002 die Slawistin Sabine Hartmann zu Hilfe kam und die russischsprachige Reiseliteratur zu untersuchen begann, wussten wir nichts von Dolinins Anmerkungen zur Simposium-Augabe, sonst hätten wir unsere Suche möglicherweise abgebrochen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
