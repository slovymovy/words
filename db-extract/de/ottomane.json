                    {
                        "form_id": "81895d27-b055-4cb4-8171-06a716e66e09",
                        "entry_id": "f8404f19-d5e3-3892-8a02-8d207910d7c5",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Ottomanen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fe352fca-4516-3807-bbcb-a2fe2fdd3fb6",
                        "entry_id": "f8404f19-d5e3-3892-8a02-8d207910d7c5",
                        "glosses": [
                            "niedriges, breites Liegemöbel mit keiner oder nur niedriger Rückenlehne"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef15ba94-ba37-4d28-8029-8476099bd64b",
                                "sense_id": "fe352fca-4516-3807-bbcb-a2fe2fdd3fb6",
                                "text": "„Sie nahm auf der Ottomane Platz, während wir beide ihr auf Stühlen gegenübersaßen.“"
                            },
                            {
                                "example_id": "75375931-f2e0-4370-993e-cc459673b7ba",
                                "sense_id": "fe352fca-4516-3807-bbcb-a2fe2fdd3fb6",
                                "text": "„Sollten wir sorgengesichtigen Europäer uns nicht in diesen Film hineinfallen lassen wie in die abgeschabte Ottomane vom Flohmarkt, bei der es eh nicht mehr darauf ankommt?“"
                            },
                            {
                                "example_id": "59e48bd0-dc33-4473-8486-7ed1a82618b7",
                                "sense_id": "fe352fca-4516-3807-bbcb-a2fe2fdd3fb6",
                                "text": "„Zuletzt warf er den klassischen Roman ungestüm auf die Ottomane, trat auf den Zehenspitzen hinter ihren Sessel und schaute ihr über die Achsel in die Zeichnung.“"
                            },
                            {
                                "example_id": "4df9aa9c-1a1e-4c18-bf0c-f307f6d0fa20",
                                "sense_id": "fe352fca-4516-3807-bbcb-a2fe2fdd3fb6",
                                "text": "„Sie setzte sich auf die Ottomane und begann zu lesen.“"
                            },
                            {
                                "example_id": "ac75de4e-9373-426f-b05a-2a625a198728",
                                "sense_id": "fe352fca-4516-3807-bbcb-a2fe2fdd3fb6",
                                "text": "„Nach dem Leichenbegräbnis, das nahezu ein Staatsakt gewesen war, lag er auf der Ottomane, wies jede Speise zurück und las nur immer wieder die Nachrufe in den Zeitungen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "74f745ed-b2e3-45c4-8120-c3cb65defc51",
                        "source_entry_id": "f8404f19-d5e3-3892-8a02-8d207910d7c5",
                        "source_sense_id": "fe352fca-4516-3807-bbcb-a2fe2fdd3fb6",
                        "source_sense_description": "niedriges, breites Liegemöbel mit keiner oder nur niedriger Rückenlehne",
                        "target_lang_word": "ottoman",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ottoman",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "22935f32-284c-33df-80e6-9aff490b0ea2",
                                        "entry_id": "f9a2aaf8-c6fa-3967-a4a6-0410e42e17a0",
                                        "glosses": [
                                            "An upholstered sofa, without arms or a back, sometimes with a compartment for storing linen etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f2178a9-cbf9-466b-b922-703054e09248",
                                                "sense_id": "22935f32-284c-33df-80e6-9aff490b0ea2",
                                                "text": "In the middle of the room there is a big ottoman; and this, with the carpet, the Morris wall-papers, and the Morris chintz window curtains and brocade covers of the ottoman and its cushions, supply all the ornament, and are much too handsome to be hidden by odds and ends of useless things."
                                            },
                                            {
                                                "example_id": "4901ce10-f3ed-4b82-a391-1928976c9737",
                                                "sense_id": "22935f32-284c-33df-80e6-9aff490b0ea2",
                                                "text": "These hefty features were on display together with dry-point engravings, marble busts, and mahogany whatnots, which the guests now squeezed between, plumping themselves down on over-stuffed ottomans beneath gleaming crystal electroliers."
                                            },
                                            {
                                                "example_id": "4286825b-c529-4285-b98c-82d0f61e6924",
                                                "sense_id": "22935f32-284c-33df-80e6-9aff490b0ea2",
                                                "text": "A 39-year-old British woman was killed when a malfunctioning ottoman bed fell on her neck and asphyxiated her, a coroner’s report said."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12b3db7d-611a-3ffd-b96b-6985a5920c73",
                                        "entry_id": "f9a2aaf8-c6fa-3967-a4a6-0410e42e17a0",
                                        "glosses": [
                                            "A low stool or thick cushion used to rest the feet or as a seat."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5fc26db5-5552-4055-a2e1-a77ee8816761",
                                                "sense_id": "12b3db7d-611a-3ffd-b96b-6985a5920c73",
                                                "text": "This ottoman is set on casters, and is a great convenience for holding articles, while serving also as a seat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8952b967-8399-3853-aefc-70bc1fc4e2ff",
                                        "entry_id": "f9a2aaf8-c6fa-3967-a4a6-0410e42e17a0",
                                        "glosses": [
                                            "A fabric with a pronounced ribbed or corded effect, often made of silk or a mixture of cotton and silk-like yarns."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9fcd5ba4-319f-48f8-a88b-368fc0e33d5b",
                        "source_entry_id": "f8404f19-d5e3-3892-8a02-8d207910d7c5",
                        "source_sense_id": "fe352fca-4516-3807-bbcb-a2fe2fdd3fb6",
                        "source_sense_description": "niedriges, breites Liegemöbel mit keiner oder nur niedriger Rückenlehne",
                        "target_lang_word": "ottomane",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ottomane",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1248190d-7559-3c7f-8dc5-4b3e0608d713",
                                        "entry_id": "96a59f0f-8f51-3b4e-b3f5-d380b6e8c43f",
                                        "glosses": [
                                            "Sorte de grand siège, avec ou sans dossier, où plusieurs personnes peuvent être assises à la fois, attribué autrefois à la façon supposée des Turcs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fbd2210-f0ff-484d-986b-0a7a75b91774",
                                                "sense_id": "1248190d-7559-3c7f-8dc5-4b3e0608d713",
                                                "text": "L'heureux Chevalier me releva, et mon pardon fut scellé sur cette même ottomane où vous et moi scellâmes si gaiement et de la même manière notre éternelle rupture."
                                            },
                                            {
                                                "example_id": "0cb99b82-b761-4de3-b11f-73f4ba3a4322",
                                                "sense_id": "1248190d-7559-3c7f-8dc5-4b3e0608d713",
                                                "text": "Après avoir achevé ce grand ouvrage, je courus avec mes vers chez ma bien-aimée. Je la trouvai seule dans un négligé charmant, assise sur une ottomane."
                                            },
                                            {
                                                "example_id": "a0b96be6-57dd-4b10-bf52-8ffe85e34c2e",
                                                "sense_id": "1248190d-7559-3c7f-8dc5-4b3e0608d713",
                                                "text": "Sur le premier plan, à gauche de l’acteur, une ottomane placée dans un petit réduit demi-circulaire et orné de tapisseries."
                                            },
                                            {
                                                "example_id": "ba8b4d61-9928-497c-a123-32dd1c34ec72",
                                                "sense_id": "1248190d-7559-3c7f-8dc5-4b3e0608d713",
                                                "text": "J’aperçus une femme d’environ vingt-deux ans, de moyenne taille, vêtue de blanc, entourée d’un cercle d’hommes, mollement couchée sur une ottomane, et tenant à la main un écran de plumes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ottomane",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7557e403-f619-3f33-975a-b9b37f465711",
                                        "entry_id": "5a400aad-03b8-3aa9-a11e-87f6201fb9cc",
                                        "glosses": [
                                            "Féminin singulier de ottoman."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58de0778-3c92-4e63-a2c2-3b8f14cf6090",
                                                "sense_id": "7557e403-f619-3f33-975a-b9b37f465711",
                                                "text": "Pour se défendre de l'offensive ottomane, les Viennois avaient monté plus de trois cents canons sur les ravelins et les bastions."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
