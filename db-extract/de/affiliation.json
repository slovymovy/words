                "senses": [
                    {
                        "sense_id": "6b86d09a-33d6-33cb-98af-950e4643e4c4",
                        "entry_id": "4fb42090-a4bb-3b29-9f27-55ca78b14cbf",
                        "glosses": [
                            "Tendenz, unabhängig von den Gefühlen gegenüber anderen Personen die Gesellschaft anderer zu suchen."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1de881cf-5b1a-4a40-8f59-f0a6fe2a8380",
                                "sense_id": "6b86d09a-33d6-33cb-98af-950e4643e4c4",
                                "text": "Seine Kontaktsuche nach fremden Menschen könnte man schon als Affiliation bezeichnen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "fe7bbbf9-429b-3565-8da8-0164894cf1a6",
                        "entry_id": "4fb42090-a4bb-3b29-9f27-55ca78b14cbf",
                        "glosses": [
                            "Zuordnung einer Sprache zu einer Sprachfamilie und Feststellung der Position, Stellung von Sprachen in einer Sprachfamilie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cbca9643-fa9f-4f31-97cf-d729b9839761",
                                "sense_id": "fe7bbbf9-429b-3565-8da8-0164894cf1a6",
                                "text": "Deutsch gehört zu den germanischen Sprachen. Entsprechend kann man seine Affiliation im Verhältnis zu den anderen germanischen Sprachen bestimmen: Es ist eng verwandt mit dem Niederländischen, weniger eng mit dem Englischen oder gar dem Isländischen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0b27a4ef-010a-4fec-b024-7fa1aaad8844",
                        "source_entry_id": "4fb42090-a4bb-3b29-9f27-55ca78b14cbf",
                        "source_sense_id": "6b86d09a-33d6-33cb-98af-950e4643e4c4",
