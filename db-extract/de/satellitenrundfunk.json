                        "sense_id": "e6245216-a79b-3841-933f-e08abeb3c5aa",
                        "entry_id": "01b85fc9-35b5-35c6-b0cc-ff823355be1d",
                        "glosses": [
                            "Übertragung von Rundfunkprogrammen mit Hilfe von Satelliten"
