                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d5b8a12-6ff5-4f11-97b1-11abb56498c3",
                                                "sense_id": "67ae1128-73c9-32ff-adad-f6d0686a3db4",
                                                "text": "„Jahrzehntelang hatte man sich daran gewöhnt, die römischen Schutzgottheiten und den Princeps in einem Zusammenhang zu sehen.“"
                                            },
                                            {
                                                "example_id": "2f156bb0-52a5-456d-a2e4-e6b948edc1cf",
                                                "sense_id": "67ae1128-73c9-32ff-adad-f6d0686a3db4",
                                                "text": "„Extrembergsteiger Reinhold Messner (67) ist jahrzehntelang auf der Suche nach dem Glück gewesen.“"
                                            },
                                            {
                                                "example_id": "048dae59-184b-448f-9b20-d17de5eba041",
                                                "sense_id": "67ae1128-73c9-32ff-adad-f6d0686a3db4",
                                                "text": "„Mnangagwa, der während seiner jahrzehntelangen politischen Tätigkeit nie zimperlich gewesen war und auf dessen Konto etliche Morde gehen dürften, präsentierte sich plötzlich als Freund des Westens.“"
                                            }
                                        ],
