                ],
                "senses": [
                    {
                        "sense_id": "2e302eb5-bc1e-3fe9-a7ad-1ea4144bb168",
                        "entry_id": "fd63a564-9590-3ce1-8c6b-86dc687eb158",
                        "glosses": [
                            "Teilgebiet der Physik, das sich mit kleinsten Elementarteilchen, den Quanten, befasst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1edef70f-9657-4e6e-a33c-dc490a7c63ff",
                                "sense_id": "2e302eb5-bc1e-3fe9-a7ad-1ea4144bb168",
                                "text": "Die Quantenphysik ist ein sehr interessanter Teilbereich der Physik, in deren Mittelpunkt die Frage steht, ob Elektronen oder Photonen nun Teilchen oder Wellen sind."
                            },
                            {
                                "example_id": "c5b55e06-f645-4feb-8975-032237c4a15b",
                                "sense_id": "2e302eb5-bc1e-3fe9-a7ad-1ea4144bb168",
                                "text": "„Vor wenigen Wochen hatte er noch Server installiert, und nun saß er in den USA mit einem Nobelpreisträger an einem Tisch, trank mit ihm Kaffee und diskutierte über Quantenphysik.“"
                            },
                            {
                                "example_id": "48eb5bcb-967b-48c6-a204-1580f26c345a",
                                "sense_id": "2e302eb5-bc1e-3fe9-a7ad-1ea4144bb168",
                                "text": "„Die indeterministische Naturauffassung der Quantenphysik regte dazu an, sie auf außerphysikalische Phänomene anzuwenden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9afd09cd-4c97-488c-97f1-057f3e868a52",
                        "source_entry_id": "fd63a564-9590-3ce1-8c6b-86dc687eb158",
                        "source_sense_id": "2e302eb5-bc1e-3fe9-a7ad-1ea4144bb168",
