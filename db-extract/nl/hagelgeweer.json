                        "target_lang_word": "Schrotflinte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schrotflinte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "596638a5-bde7-3004-a2c2-8ba61d29b6f8",
                                        "entry_id": "eaa50341-04f1-354e-9cca-20823fe7b856",
                                        "glosses": [
                                            "Gewehr mit glattem Lauf, zum Verschießen von Schrot"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9109e755-ee01-4ae3-ae52-2012fe50af63",
                                                "sense_id": "596638a5-bde7-3004-a2c2-8ba61d29b6f8",
                                                "text": "Der Jäger schoss sich mit seiner Schrotflinte versehentlich in den linken Fuß."
                                            },
                                            {
                                                "example_id": "9dc36aac-b7d1-48f3-8638-7fb6c6bac9e5",
                                                "sense_id": "596638a5-bde7-3004-a2c2-8ba61d29b6f8",
                                                "text": "„Ein 45-Jähriger soll in einer Wohnung in Wien-Ottakring einen um zwei Jahre älteren Mann mit einer Schrotflinte in den Kopf geschossen und tagelang neben der Leiche gelebt haben.“"
                                            },
                                            {
                                                "example_id": "5a674fc7-ab96-40b7-93ba-1152abd19aa5",
                                                "sense_id": "596638a5-bde7-3004-a2c2-8ba61d29b6f8",
                                                "text": "„Außerdem sei er müde, weil er die letzten drei Nächte mit seiner Schrotflinte auf die \"Kids\" gewartet habe.“"
                                            },
                                            {
                                                "example_id": "3e334520-5cfe-423f-a85e-bc28829866c6",
                                                "sense_id": "596638a5-bde7-3004-a2c2-8ba61d29b6f8",
                                                "text": "„Ich habe einen zerrissenen Tag hinter mir und fühle mich, als hätte jemand aus einer Schrotflinte mit Salzpatronen auf mich geschossen.“"
                                            },
                                            {
                                                "example_id": "d99085ed-f919-4cb4-8adc-d366a0ec8e2a",
                                                "sense_id": "596638a5-bde7-3004-a2c2-8ba61d29b6f8",
                                                "text": "„Man hätte meinen können, Köhler hätte in aller Öffentlichkeit besoffen die Schrotflinte auf das Lieblingskaninchen seines blond gelockten Enkelkindes angelegt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
