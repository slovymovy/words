                "senses": [
                    {
                        "sense_id": "87656f14-2062-36eb-b4f2-4f31c765a634",
                        "entry_id": "6165f3e2-5a7c-3d30-9797-192d7730f005",
                        "glosses": [
                            "Of an ash-gray colour."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "058fbfb6-91d1-41f6-b5d4-85ace73755b0",
                                "sense_id": "87656f14-2062-36eb-b4f2-4f31c765a634",
                                "text": "With a bill two inches and a half long , very ſlender , and a little recurvated : head , and upper part of neck , cinereous , with dusky lines : over each eye a white line"
                            },
                            {
                                "example_id": "0d5810d1-2508-4b5c-915e-7356388e85d2",
                                "sense_id": "87656f14-2062-36eb-b4f2-4f31c765a634",
                                "text": "Coluber cinereus, the cinereous viper; a native cf South America and India; of a cinereous grey colour; the abdomen white, angulated ; the scales of the tail ferruginous at the edges."
                            },
                            {
                                "example_id": "5acb97d2-2a4f-4d2c-92e6-0364d5735835",
                                "sense_id": "87656f14-2062-36eb-b4f2-4f31c765a634",
                                "text": "Wings tailed, white, with a brown border; beneath varied with ferruginous and yellow, the lower ones with two cinereous streaks."
                            },
                            {
                                "example_id": "d8d1aec0-bd52-4751-b16f-7389dfccc3a1",
                                "sense_id": "87656f14-2062-36eb-b4f2-4f31c765a634",
                                "text": "[…] breast and front of the neck cinereous brown; belly, vent, and under tail-coverts, pure white […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "57152300-f735-3f6a-8b4c-053faa0e8f12",
                        "entry_id": "6165f3e2-5a7c-3d30-9797-192d7730f005",
                        "glosses": [
                            "Like ashes."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "59890957-c21d-379a-947c-e560755fac27",
                        "entry_id": "6165f3e2-5a7c-3d30-9797-192d7730f005",
                        "glosses": [
                            "Containing ashes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bcd9c05b-9fad-4457-b741-0d80b3ef4f03",
                                "sense_id": "59890957-c21d-379a-947c-e560755fac27",
                                "text": "We likewise see by the valuable Work of Andrew Burdon, professor of the Royal French Academy of Painting, that the Antients occasionally used the Amphora form in other parts of the world as both cinereous and lachrymal urns; […]"
                            }
                        ]
