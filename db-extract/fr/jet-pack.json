                    {
                        "sense_id": "4acb08cf-6990-335b-9fd7-aecd89cfa993",
                        "entry_id": "f507571c-42a3-3fc6-8f79-535aa97335b9",
                        "glosses": [
                            "Équipement portable permettant à son utilisateur de décoller, de se propulser et d’atterrir de façon autonome."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "4ca55e25-e17a-403b-80da-d9bbef9e4df5",
                                "sense_id": "4acb08cf-6990-335b-9fd7-aecd89cfa993",
                                "text": "Équipé d’un casque de réalité virtuelle, le visiteur se fait pilote de jet-pack pour explorer l’abbaye du Mont-Saint-Michel, survoler le Mont-Blanc ou se faire surprendre par la lumière si particulière du château d’Azay-le-Rideau et du pont du Gard."
                            },
                            {
                                "example_id": "25f9ffd3-a4d7-44e8-9ea6-925eb31aac22",
                                "sense_id": "4acb08cf-6990-335b-9fd7-aecd89cfa993",
                                "text": "Il s’empare de la grenade et la colle sur le jet-pack de Saturna."
                            },
                            {
                                "example_id": "b3166430-bb7b-4063-87eb-dd0195075a48",
                                "sense_id": "4acb08cf-6990-335b-9fd7-aecd89cfa993",
                                "text": "Et pourquoi pas prendre un peu de hauteur façon Iron man avec le flyboard ou le jet-pack initié par une équipe jeune, dynamique et, de plus, compétente ?"
                            }
                        ]
                    }
