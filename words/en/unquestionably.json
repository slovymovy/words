    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "5199160b-6c25-312c-9e42-1f6cb02d7c8f",
                    "sense_definition": "Without question; beyond doubt; indubitably.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is <w>unquestionably</w> the most qualified candidate for this position.",
                            "target_lang_translations": {
                                "ru": "Она, <w>бесспорно</w>, самый квалифицированный кандидат на эту должность."
                            }
                        },
                        {
                            "text": "It was <w>unquestionably</w> the best performance of his entire musical career.",
                            "target_lang_translations": {
                                "ru": "Это было <w>несомненно</w> лучшее выступление во всей его музыкальной карьере."
                            }
                        }
                    ],
                    "synonyms": [
                        "undoubtedly",
                        "indubitably",
                        "definitely",
                        "certainly"
                    ],
                    "antonyms": [
                        "questionably",
                        "doubtfully"
                    ],
                    "common_phrases": [
                        "unquestionably true",
                        "unquestionably the best"
                    ],
                    "target_lang_definitions": {
                        "ru": "Без сомнения; бесспорно; не вызывая никаких вопросов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бесспорно",
                                "target_lang_sense_clarification": "не допуская сомнений или возражений"
                            },
                            {
                                "target_lang_word": "несомненно",
                                "target_lang_sense_clarification": "с абсолютной уверенностью, очевидно"
                            },
                            {
                                "target_lang_word": "без сомнения",
                                "target_lang_sense_clarification": "явно, безусловно"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "51157978-20c1-3f89-83db-4040ccaaff34",
                    "sense_definition": "Used as an exclamation or agreement; OK, absolutely, right on.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "\"Are you going to support the proposal?\" \"<w>Unquestionably</w>!\"",
                            "target_lang_translations": {
                                "ru": "— Ты поддержишь это предложение? — <w>Безусловно</w>!"
                            }
                        },
                        {
                            "text": "\"Will you join us for dinner tonight?\" \"<w>Unquestionably</w>, I would love to.\"",
                            "target_lang_translations": {
                                "ru": "— Присоединишься к нам сегодня на ужин? — <w>Конечно</w>, с удовольствием."
                            }
                        }
                    ],
                    "synonyms": [
                        "absolutely",
                        "definitely"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used as an affirmative response"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется как утвердительный ответ или восклицание согласия: безусловно, конечно, несомненно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "безусловно",
                                "target_lang_sense_clarification": "выражение полного согласия"
                            },
                            {
                                "target_lang_word": "несомненно",
                                "target_lang_sense_clarification": "выражение согласия в ответ на вопрос"
                            },
                            {
                                "target_lang_word": "конечно",
                                "target_lang_sense_clarification": "утвердительный ответ"
                            }
                        ]
                    }
                }
            ]
        }
    ]
