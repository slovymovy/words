                "senses": [
                    {
                        "sense_id": "e247fc7a-3563-3cdc-8445-395bb82b335e",
                        "entry_id": "e2ee1d33-f4a4-3f48-9de2-4747b479857a",
                        "glosses": [
                            "A means of passing through a wall or floor, having a hatch (especially on a ship); a doorway with a hatch rather than a door."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5daece16-e9aa-4337-8a82-0653ef97fa13",
                                "sense_id": "e247fc7a-3563-3cdc-8445-395bb82b335e",
                                "text": "Up through the great hatchways rimmed with racks of heavy shot, the watch below came pouring […]"
                            },
                            {
                                "example_id": "f405f48a-980e-4ea8-bcc2-3e53a5e8a66a",
                                "sense_id": "e247fc7a-3563-3cdc-8445-395bb82b335e",
                                "text": "Full-depth, hinged doors are provided on each side of the engine and generator housing, and hatchways are fitted in the roof over the engine."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "30dbbc81-7dc6-4dc3-b0c8-fc3d7b29b9c7",
                        "source_entry_id": "e2ee1d33-f4a4-3f48-9de2-4747b479857a",
                        "source_sense_id": "e247fc7a-3563-3cdc-8445-395bb82b335e",
                        "source_sense_description": "doorway with hatch",
                        "target_lang_word": "écoutille",
