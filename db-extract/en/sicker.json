                            {
                                "example_id": "ee7f82eb-373b-4ca7-aa88-f6fc319d3858",
                                "sense_id": "1b0a0ed4-5c98-3cb6-96ba-abf7f408151a",
                                "text": "And here was we made sicker than he was wi' you[…]"
