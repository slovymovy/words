                    {
                        "translation_id": "11792f5f-9135-4fbb-90d2-dea3e93d10da",
                        "source_entry_id": "36c0d29a-af35-3da8-baad-78e97ac9a632",
                        "source_sense_id": "e4d0e14c-789c-36dc-834f-cd7482e81396",
