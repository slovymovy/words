                    }
                ],
                "senses": [
                    {
                        "sense_id": "99ceb86c-cf7b-379a-8c66-0b7bf2f4baf4",
                        "entry_id": "7cbfa824-9ab5-3348-97ce-380973a512ec",
                        "glosses": [
                            "A gaseous or vaporous emission, especially a foul-smelling one."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "456df088-3871-4653-8cdb-0c0b25d0ddc9",
                                "sense_id": "99ceb86c-cf7b-379a-8c66-0b7bf2f4baf4",
                                "text": "She was now bending over a huge light wood blaze, with a pipe of rude structure and no small dimensions in her mouth, from which the occasional puff went forth, filling the apartment with the unpleasant effluvia of the vilest leaf-tobacco."
                            },
                            {
                                "example_id": "fa370c07-f907-4605-87fb-5ce1b3aad590",
                                "sense_id": "99ceb86c-cf7b-379a-8c66-0b7bf2f4baf4",
                                "text": "It was the mere effluvium of the flame, the subtle ether that it cast off as it passed, working on us, and making us feel strong as giants and swift as eagles."
                            },
                            {
                                "example_id": "b86ac18b-229e-444a-8fe2-30e8dc60af29",
                                "sense_id": "99ceb86c-cf7b-379a-8c66-0b7bf2f4baf4",
                                "text": "And he breathed the breath of the house—a dank savour rather than a smell—a cold, musty effluvium as from underground vaults mingled with the reeking exhalations of linoleum and mildewed and rotten woodwork."
                            }
                        ]
                    },
                    {
                        "sense_id": "7506bccf-7fe1-3d8e-92ad-5bd8df0543af",
                        "entry_id": "7cbfa824-9ab5-3348-97ce-380973a512ec",
                        "glosses": [
                            "A condition causing the shedding of hair."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "f9546931-c23b-4d00-82df-d78a273f8cc8",
                                "sense_id": "7506bccf-7fe1-3d8e-92ad-5bd8df0543af",
                                "text": "Reversible hair loss or effluvium occurs following either endogenous or exogenous damage to anagen hair follicles[…]."
                            }
                        ]
                    }
                ],
