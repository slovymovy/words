                ],
                "senses": [
                    {
                        "sense_id": "77f84baf-115b-321a-95a8-899d3011888c",
                        "entry_id": "c72996ef-e1b8-30d4-ad59-37ceff2e2461",
                        "glosses": [
                            "Épier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "712f995d-2944-4fc6-875b-dc1bd0f355f5",
                                "sense_id": "77f84baf-115b-321a-95a8-899d3011888c",
                                "text": "Dressé sur les miches, dans mon paddock, je borgnotais les alentours, détaillant le décor."
                            },
                            {
                                "example_id": "0c4ea042-8f45-44e4-a593-edf7194aef23",
                                "sense_id": "77f84baf-115b-321a-95a8-899d3011888c",
                                "text": "Il me borgnotait de temps à autre au-dessus de ses lunettes. Je le fixais durement."
                            }
                        ]
                    },
                    {
                        "sense_id": "5afb6657-b3ac-3d4d-9abe-fb2ac95cbc68",
                        "entry_id": "c72996ef-e1b8-30d4-ad59-37ceff2e2461",
                        "glosses": [
                            "Scruter."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "889e114f-7465-446a-9d4e-ecfaaa951105",
                                "sense_id": "5afb6657-b3ac-3d4d-9abe-fb2ac95cbc68",
                                "text": "Sitôt que nous parvenons devant l'huis, dans un lieu privilégié où il n'y a plus personne, je sors ma carte de police. Ils borgnotent pour en prendre connaissance, l'éclairage étant plutôt faiblard."
                            }
                        ]
                    },
