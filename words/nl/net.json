                    "sense_definition": "precies zoals; op dezelfde manier als",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "vergelijking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het was <w>net</w> een sprookje toen we door het bos liepen.",
