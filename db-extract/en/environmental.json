                    },
                    {
                        "translation_id": "76b7861e-08f5-466f-a19e-1f892f6ee41a",
                        "source_entry_id": "40cc1797-7b42-33d9-9b8c-dd89061a1b86",
                        "source_sense_description": "pertaining to the environment",
