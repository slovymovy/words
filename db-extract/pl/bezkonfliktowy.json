                ],
                "senses": [
                    {
                        "sense_id": "bf681730-6169-3ae0-a0a8-6d8c8b94f8b7",
                        "entry_id": "bce7e47f-a09c-315e-8bf7-f344902038ec",
                        "glosses": [
                            "nie wywołujący konfliktów, stroniący od agresji, przyjazny"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ed68cb4e-60c5-4ae5-b622-d44fc179003f",
                        "source_entry_id": "bce7e47f-a09c-315e-8bf7-f344902038ec",
                        "source_sense_id": "bf681730-6169-3ae0-a0a8-6d8c8b94f8b7",
                        "target_lang_word": "frictionless",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "frictionless",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7f957846-b722-3b0a-aeb3-33c2116aa35f",
                                        "entry_id": "6b6fbec6-f7d8-30e1-b7c0-64aa0bcd69e7",
                                        "glosses": [
                                            "Of or pertaining to lack of friction."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f98f2173-1ad2-46d5-82ba-04e26fc96ff0",
                                                "sense_id": "7f957846-b722-3b0a-aeb3-33c2116aa35f",
                                                "text": "It would last many years because of its frictionless bearings."
                                            },
                                            {
                                                "example_id": "f7b03ef9-6b82-491f-8748-c65a86ee26dd",
                                                "sense_id": "7f957846-b722-3b0a-aeb3-33c2116aa35f",
                                                "text": "A hard border is a real possibility, and a frictionless border is almost an oxymoron."
                                            },
                                            {
                                                "example_id": "e7f98d1f-ef37-4cb4-98cc-84be8162b8d7",
                                                "sense_id": "7f957846-b722-3b0a-aeb3-33c2116aa35f",
                                                "text": "In the decade ahead, the story must be one of increasingly frictionless travel."
                                            },
                                            {
                                                "example_id": "dd143339-b395-437d-a81f-7cbd0e7654ba",
                                                "sense_id": "7f957846-b722-3b0a-aeb3-33c2116aa35f",
                                                "text": "To her, adding AI into relationships “presupposes inadequacy” in them, and offers a sterile alternative: always saying the right thing, back and forth, frictionless forever."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2607b1b-7a9d-30b0-9acc-e7bef4a56586",
                                        "entry_id": "6b6fbec6-f7d8-30e1-b7c0-64aa0bcd69e7",
                                        "glosses": [
                                            "Of a transaction or trade, without tariffs and non-tariff barriers."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d66bffd-5d4b-4010-9892-f46005d929f1",
                                                "sense_id": "b2607b1b-7a9d-30b0-9acc-e7bef4a56586",
                                                "text": "\"There can be no frictionless trade outside of the customs union and the single market,\" said Donald Tusk, president of the council of all 28 EU member states."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f159e56d-74fe-40e2-939a-f85026978a5f",
                        "source_entry_id": "bce7e47f-a09c-315e-8bf7-f344902038ec",
                        "source_sense_id": "bf681730-6169-3ae0-a0a8-6d8c8b94f8b7",
                        "target_lang_word": "konfliktfrei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "a25dfff6-25da-4111-a2e9-e318304e6824",
                        "source_entry_id": "bce7e47f-a09c-315e-8bf7-f344902038ec",
                        "source_sense_id": "bf681730-6169-3ae0-a0a8-6d8c8b94f8b7",
                        "target_lang_word": "konfliktlos",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "konfliktlos",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e1842e50-3793-33a0-8b57-0aa0d2e9daba",
                                        "entry_id": "297360dd-26c2-39af-a90d-1405a109d39a",
                                        "glosses": [
                                            "ohne Konflikte, keine Konflikte auslösend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ab4dc77-0912-4143-bcec-8a0edbaff70e",
                                                "sense_id": "e1842e50-3793-33a0-8b57-0aa0d2e9daba",
                                                "text": "„Die Beute wurde unter den Conquistadoren aufgeteilt, doch geschah dies keineswegs konfliktlos, wie Bernal Díaz berichtete.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
