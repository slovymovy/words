{
    "word_family": [
        "boo"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a3a1b2e2-475c-3c9a-8138-0a446564f84e",
                    "sense_definition": "present participle and gerund of <w>boo</w>",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "vocal_expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crowd started <w>booing</w> loudly when the referee made a controversial decision.",
                            "target_lang_translations": {
                                "ru": "Толпа начала громко <w>освистывать</w>, когда судья принял спорное решение."
                            }
                        },
                        {
                            "text": "He left the stage quickly after <w>booing</w> from the audience became too much to handle.",
                            "target_lang_translations": {
                                "ru": "Он быстро покинул сцену после того, как <w>освистывание</w> публики стало невыносимым."
                            }
                        }
                    ],
                    "synonyms": [
                        "jeering",
                        "heckling"
                    ],
                    "antonyms": [
                        "cheering",
                        "applauding"
                    ],
                    "common_phrases": [
                        "start booing",
                        "keep booing",
                        "booing the referee"
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола «boo» (освистывать)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "освистывание",
                                "target_lang_sense_clarification": "процесс выражения недовольства"
                            },
                            {
                                "target_lang_word": "освистывающий",
                                "target_lang_sense_clarification": "в значении причастия"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "21984761-c7c6-385b-8e4d-2c72d35c0057",
                    "sense_definition": "The act of making a disapproving sound or exclamation to show dislike for a performance or person.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vocal_expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constant <w>booing</w> from the back of the theater made it hard for the actors to concentrate.",
                            "target_lang_translations": {
                                "ru": "Постоянное <w>улюлюканье</w> с задних рядов театра мешало актерам сосредоточиться."
                            }
                        },
                        {
                            "text": "Despite the loud <w>booing</w>, the politician continued his speech without pausing.",
                            "target_lang_translations": {
                                "ru": "Несмотря на громкое <w>освистывание</w>, политик продолжил свою речь без пауз."
                            }
                        }
                    ],
                    "synonyms": [
                        "jeer",
                        "catcall"
                    ],
                    "antonyms": [
                        "applause",
                        "cheer"
                    ],
                    "common_phrases": [
                        "loud booing",
                        "chorus of booing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по изданию неодобрительных звуков или восклицаний для выражения неприязни к выступлению или человеку."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "освистывание",
                                "target_lang_sense_clarification": "громкое выражение неодобрения"
                            },
                            {
                                "target_lang_word": "улюлюканье",
                                "target_lang_sense_clarification": "насмешливые выкрики"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}