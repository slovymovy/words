                ],
                "senses": [
                    {
                        "sense_id": "d4493c1a-94cf-337d-91ae-6f79bd60ded5",
                        "entry_id": "fd9e17e0-7ec2-325b-861b-e00b7fa63d67",
                        "glosses": [
                            "Se déconsidérer soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2be8477-6812-4354-b9fa-4fe6fca34009",
                                "sense_id": "d4493c1a-94cf-337d-91ae-6f79bd60ded5",
                                "text": "Il leur est facile, dans le contexte, de réaliser le manque d’attractivité financière du statut, les difficultés structurelles du quotidien et l’absence de considération de la structure pour un corps médical sans projet qui s’est auto-déconsidéré depuis 30 ans."
                            },
                            {
                                "example_id": "8f726239-a48c-4586-bc70-a2d4d0f0a654",
                                "sense_id": "d4493c1a-94cf-337d-91ae-6f79bd60ded5",
                                "text": "Pour le cas particulier de la Grèce, la droite en falsifiant les comptes de la nation pour satisfaire les critères d'intégration à l'UE, s'est auto-déconsidérée en entraînant ensuite le pays dans processus d'endettement \"mortifère\"."
                            },
                            {
                                "example_id": "0e41eb88-4aea-472d-9fe2-8142b66cf8a4",
                                "sense_id": "d4493c1a-94cf-337d-91ae-6f79bd60ded5",
                                "text": "Aucune hiérarchie ne s'instaure entre les personnages qui s'auto-déconsidèrent."
                            }
                        ]
                    }
                ],
