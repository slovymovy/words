                "senses": [
                    {
                        "sense_id": "83a73fce-7350-3ef6-967b-351b155aa786",
                        "entry_id": "5353169b-1d7f-3331-8bf6-df79dae8e82f",
                        "glosses": [
                            "een griezelige film met vaak fantasie-elementen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff3585a8-e153-43ef-8bb2-44dd5508ef2a",
                                "sense_id": "83a73fce-7350-3ef6-967b-351b155aa786",
                                "text": "Als je echt goed in de ban raakt van spookhuishorrorfilm The Bye Bye Man dan durf je na afloop niet eens meer de titel uit te spreken. Want de naam van de bloeddorstige schim die drie studenten in hun goedkoop gehuurde landhuis - te betaalbaar, te mooi, te lang leeg, ze hadden beter moeten weten - in wanhopige moordenaars verandert, is genoeg om hem tot leven te wekken. „Don’t think, don’t say”, murmelt iedereen die door hem bezeten is. Maar dan is het al te laat. Als je zo erg je best moet doen om iets niet te denken, dan heeft het zich al als een dodelijke worm in je gedachten gevreten. Het is een effectieve metafoor voor angst, en ook voor waarom we zo graag naar horrorfilms kijken: weten dat je beter niet kunt kijken, en dan toch kijken."
                            },
                            {
                                "example_id": "5c7095ad-e926-4ef1-b7d0-6838e9fdde64",
                                "sense_id": "83a73fce-7350-3ef6-967b-351b155aa786",
                                "text": "Wij zijn naar een horrorfilm gegaan waarin spoken en vampiers de hoofdrol speelden."
                            }
                        ]
                    }
                ],
