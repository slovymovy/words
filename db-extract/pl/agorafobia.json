                                    {
                                        "sense_id": "7063a537-022f-3ad3-bc1e-d7ff471b9a45",
                                        "entry_id": "df333b0d-7d15-30e7-8a05-275ca6245ce4",
                                        "glosses": [
                                            "психол. боязнь открытого пространства; бессознательный страх, испытываемый при прохождении без провожатых большой площади или безлюдной улицы"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76d88685-2fd6-451b-aede-e4ba38841de6",
                                                "sense_id": "7063a537-022f-3ad3-bc1e-d7ff471b9a45",
                                                "text": "Только они больны тем синдромом, что противоположен клаустрофобии. Агорафобией. Боязнью открытого пространства."
                                            }
                                        ]
                                    }
