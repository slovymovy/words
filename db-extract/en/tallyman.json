                        "glosses": [
                            "A person who keeps a tally of something."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1079f386-5cc8-4f2b-8845-131573909886",
                                "sense_id": "73b37bf2-5ed6-3672-bcb7-7985c8b55193",
                                "text": "Uncoupling a train into cuts in the reception sidings - as a shunter wields his pole, the tallyman reads off details of the train to the Traffic Office through his portable radio transmitter."
                            },
                            {
                                "example_id": "67a36561-7cbd-40f1-8b3f-af028deeadf7",
                                "sense_id": "73b37bf2-5ed6-3672-bcb7-7985c8b55193",
                                "text": "At the prefab site entrance, we collect our breathing apparatus from the 'tallyman' who books people in and out of the tunnel."
                            }
                        ]
                    },
                    {
                        "sense_id": "2a916538-00f5-3f83-936e-6ba2e70e2918",
                        "entry_id": "b2d3b4d9-a659-3c43-ab85-5c04f8f1160a",
                        "glosses": [
                            "A man who conducts the tally trade."
                        ],
