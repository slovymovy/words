                "senses": [
                    {
                        "sense_id": "e3f7b0e1-619a-3c78-9492-36b79ed4a019",
                        "entry_id": "c961baa3-edaa-36a5-bff6-7430b12ff68a",
                        "glosses": [
                            "a work of art suspended above and behind an altar in a church"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b50dd0b-3f6c-45c4-b8e1-9e0ba3ff2a14",
                                "sense_id": "e3f7b0e1-619a-3c78-9492-36b79ed4a019",
                                "text": "I walked across the concrete to examine the altarpiece of the atomic age. A large crack ran through it."
                            },
                            {
                                "example_id": "967dd6f1-a635-46eb-aec2-fa7269c605e7",
                                "sense_id": "e3f7b0e1-619a-3c78-9492-36b79ed4a019",
                                "text": "“It’s this snaggletoothed, little bird-footed homunculus caricature,” Bourneuf said. “Many artists at this time were trying to make new altarpieces. Klee tended to take a very skeptical distance from the sort of grandiose projects of many of his expressionist peers, so I think it’s actually kind of mocking those hopes.”"
                            }
                        ]
                    }
                ],
