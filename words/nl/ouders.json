                    "examples": [
                        {
                            "text": "De <w>ouders</w> man liep langzaam en voorzichtig door het park.",
                            "target_lang_translations": {
                                "en": "The <w>elderly</w> man walked slowly and carefully through the park.",
                                "ru": "<w>Пожилой</w> мужчина медленно и осторожно шел по парку.",
                                "pl": "<w>Starszy</w> mężczyzna szedł powoli i ostrożnie przez park.",
                                "de": "Der <w>ältere</w> Mann ging langsam und vorsichtig durch den Park.",
                                "fr": "L'homme <w>âgé</w> marchait lentement et prudemment dans le parc.",
                                "it": "L'uomo <w>anziano</w> camminava lentamente e con cautela nel parco.",
                                "cs": "Ten <w>starý</w> muž šel pomalu a opatrně parkem.",
                                "tr": "<w>Yaşlı</w> adam parkta yavaşça ve dikkatlice yürüyordu.",
                                "es": "El hombre <w>anciano</w> caminaba lenta y cuidadosamente por el parque."
                            }
                        },
                        {
                            "text": "Zij zorgt al jaren voor haar <w>ouders</w> buurvrouw.",
                            "target_lang_translations": {
                                "en": "She has been taking care of her <w>elderly</w> neighbor for years.",
                                "ru": "Она уже много лет ухаживает за своей <w>пожилой</w> соседкой.",
                                "pl": "Ona od lat opiekuje się swoją <w>starszą</w> sąsiadką.",
                                "de": "Sie kümmert sich schon seit Jahren um ihre <w>ältere</w> Nachbarin.",
                                "fr": "Elle s'occupe de sa voisine <w>âgée</w> depuis des années.",
                                "it": "Si prende cura della sua vicina <w>anziana</w> ormai da anni.",
                                "cs": "Už roky se stará o svou <w>starou</w> sousedku.",
                                "tr": "Yıllardır <w>yaşlı</w> komşusuna bakıyor.",
                                "es": "Ella cuida desde hace años a su vecina <w>anciana</w>."
                            }
                        }
