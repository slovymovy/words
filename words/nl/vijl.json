                            }
                        },
                        {
                            "text": "<w>Vijl</w> die scherpe randjes van het metaal even weg.",
                            "target_lang_translations": {
                                "en": "<w>File</w> those sharp edges off the metal.",
                                "ru": "<w>Спили</w> эти острые края с металла."
                            }
