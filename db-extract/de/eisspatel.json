                        "entry_id": "f6d3b5d8-836a-3d8e-af7f-4618d2d7974e",
                        "glosses": [
                            "Besteck, das zum Löffeln oder Schaben von Speiseeis verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93d7865c-af41-48ef-be73-82bdacd6f758",
                                "sense_id": "2f495447-14aa-3fd9-b1df-9396a2544723",
                                "text": "Der Eisverkäufer reichte das Speiseeis mit Waffel und Eisspatel in einen Eisbecher."
                            },
                            {
                                "example_id": "d0c3f7d6-90ce-4458-85be-4cbafae7651a",
                                "sense_id": "2f495447-14aa-3fd9-b1df-9396a2544723",
                                "text": "„Das besteht aus einer Eismaschine, Speiseeis-Vitrine, Portionierdusche und Schaleneinsätzen aus Kunststoff sowie die empfohlene Grundausstattung. Darin enthalten sind neben einigen Werbematerialien Edelstahleisschalen, Eis-portionierer, Eisspatel und Reiniger für Maschine und Portionierer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
