                "senses": [
                    {
                        "sense_id": "998aaa9c-0bbc-337f-bcba-fc94c172e121",
                        "entry_id": "94ca099a-fb11-3394-87e0-26d9711a5c5b",
                        "glosses": [
                            "Ne plus communier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27024f92-65a4-46b3-9e00-019fb13431bc",
                                "sense_id": "998aaa9c-0bbc-337f-bcba-fc94c172e121",
                                "text": "Oui parce que quand on communie ensemble il est difficile de décommunier!"
                            },
                            {
                                "example_id": "a79a25c2-78d7-4f23-ad3f-cc990fc4580d",
                                "sense_id": "998aaa9c-0bbc-337f-bcba-fc94c172e121",
                                "text": "Pardon de ne pas décommunier d'avec notre esprit d'équipe mais oui, ça ne devrait pas arriver : www.youareheroes.org."
                            },
                            {
                                "example_id": "5059cd45-5339-4e40-81b8-d018a8d5fd4d",
                                "sense_id": "998aaa9c-0bbc-337f-bcba-fc94c172e121",
                                "text": "je recommande à chacun de se connecter à la Fraternité d'Amour et de Lumiere de Melchisedech avec l'aide des maitres ascensionnés, et surtout un travail de pardon total(on ne peut pas communier avec le Divin si on se décommunie d'un seul prochain) et apprendre à vivre sans manger ou presque(c'est assez facile!) au cas où...!!"
                            }
                        ]
                    }
