{
    "word_family": [
        "glijden",
        "uitglijden",
        "afglijden",
        "glijbaan"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3d805cc6-1eaf-31ef-a4e0-88b2176e8cc5",
                    "sense_definition": "zich onbedoeld verplaatsen over een glad oppervlak",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "glijden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pas op dat je niet gaat <w>wegglijden</w> op de gladde vloer.",
                            "target_lang_translations": {
                                "en": "Be careful not to <w>slip</w> on the slippery floor."
                            }
                        },
                        {
                            "text": "Door de ijzel begon de auto langzaam over de weg te <w>wegglijden</w>.",
                            "target_lang_translations": {
                                "en": "Because of the black ice, the car began to <w>skid</w> slowly across the road."
                            }
                        }
                    ],
                    "synonyms": [
                        "slippen",
                        "glijden"
                    ],
                    "antonyms": [
                        "vaststaan"
                    ],
                    "common_phrases": [
                        "over het ijs wegglijden"
                    ],
                    "target_lang_definitions": {
                        "en": "To move unintentionally over a smooth or slippery surface"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "slip",
                                "target_lang_sense_clarification": "to lose one's footing or balance"
                            },
                            {
                                "target_lang_word": "slide away",
                                "target_lang_sense_clarification": "to move smoothly and unintentionally from a position"
                            },
                            {
                                "target_lang_word": "skid",
                                "target_lang_sense_clarification": "to slide out of control, often of a vehicle"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "affc6614-3c18-305b-8895-f366c6a18504",
                    "sense_definition": "zich soepel en gelijkmatig verplaatsen van een plek vandaan",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "glijden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We zagen de boot heel rustig van de kade <w>wegglijden</w>.",
                            "target_lang_translations": {
                                "en": "We saw the boat <w>glide away</w> from the quay very quietly."
                            }
                        },
                        {
                            "text": "De zon begon langzaam achter de horizon te <w>wegglijden</w>.",
                            "target_lang_translations": {
                                "en": "The sun began to slowly <w>slip away</w> behind the horizon."
                            }
                        }
                    ],
                    "synonyms": [
                        "wegdrijven",
                        "verglijden"
                    ],
                    "common_phrases": [
                        "langzaam wegglijden"
                    ],
                    "target_lang_definitions": {
                        "en": "To move smoothly and steadily away from a place"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "glide away",
                                "target_lang_sense_clarification": "to move away with a smooth, continuous motion"
                            },
                            {
                                "target_lang_word": "drift away",
                                "target_lang_sense_clarification": "to move slowly and steadily away, often on water"
                            },
                            {
                                "target_lang_word": "slip away",
                                "target_lang_sense_clarification": "to depart quietly or smoothly"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "65548823-f074-374d-abaa-bab8437e11cd",
                    "sense_definition": "met een glijdende beweging naar beneden vallen of zakken",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vallen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Een groot deel van de modder is na de regen van de berg <w>weggegleden</w>.",
                            "target_lang_translations": {
                                "en": "A large part of the mud <w>slid down</w> from the mountain after the rain."
                            }
                        },
                        {
                            "text": "Het zand onder zijn voeten begon te <w>wegglijden</w> toen hij de duin opklom.",
                            "target_lang_translations": {
                                "en": "The sand under his feet began to <w>slip away</w> as he climbed the dune."
                            }
                        }
                    ],
                    "synonyms": [
                        "afglijden",
                        "verschuiven"
                    ],
                    "common_phrases": [
                        "naar beneden wegglijden"
                    ],
                    "target_lang_definitions": {
                        "en": "To fall or sink downwards with a sliding motion"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "slide down",
                                "target_lang_sense_clarification": "to move downward along a surface"
                            },
                            {
                                "target_lang_word": "slip down",
                                "target_lang_sense_clarification": "to slide downwards unintentionally"
                            },
                            {
                                "target_lang_word": "slump",
                                "target_lang_sense_clarification": "to slide or fall down heavily"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}