                        "form": "зерца́лах"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c4cd5f47-f00c-3081-aa2f-e0ae7a388a72",
                        "entry_id": "deacfb33-95e4-3b87-8286-191d308ce6bf",
                        "glosses": [
                            "старин. то же, что зеркало"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "965f09d3-bec4-4e13-b950-c3d5f3003f9d",
                                "sense_id": "c4cd5f47-f00c-3081-aa2f-e0ae7a388a72",
                                "text": "В той половине, где присутствие, находятся две комнаты чистые, выбеленные: одна — передняя для просителей; в другой стол, убранный чернильными пятнами; на нём зерцало."
                            }
                        ]
                    },
                    {
                        "sense_id": "d06d5723-1411-3d9d-a322-96b4e2d9e4e9",
                        "entry_id": "deacfb33-95e4-3b87-8286-191d308ce6bf",
                        "glosses": [
                            "устар. перен. спокойная гладкая поверхность воды (реки, пруда и т.п.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "920f6cbe-5d93-4407-baec-74574e43b053",
                                "sense_id": "d06d5723-1411-3d9d-a322-96b4e2d9e4e9",
                                "text": "И луч его (солнца) в зерцале зыбком вод неверным золотом трепещет."
                            },
                            {
                                "example_id": "f5c91684-e9db-467f-b2bf-6f7773db054b",
                                "sense_id": "d06d5723-1411-3d9d-a322-96b4e2d9e4e9",
                                "text": "Когда луна златая // Глядит в зерцало вод, // В лучах её играя, // Как сон она плывёт; // Наступит ли денница, // Она спешит уж прочь; // Пушок — ей колесница, // Её отчизна — ночь."
                            }
                        ]
                    },
                    {
                        "sense_id": "9543ed19-2be0-349e-a560-264d776fd24f",
                        "entry_id": "deacfb33-95e4-3b87-8286-191d308ce6bf",
                        "glosses": [
                            "устар. перен. отражение чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e0d184a-1508-4e8d-b2e1-bb86ac78f4af",
                                "sense_id": "9543ed19-2be0-349e-a560-264d776fd24f",
                                "text": "Этот человек зерцало правды."
                            }
                        ]
                    },
                    {
                        "sense_id": "67b3feae-14b8-36d1-bc34-d9a220d36f64",
                        "entry_id": "deacfb33-95e4-3b87-8286-191d308ce6bf",
                        "glosses": [
                            "истор., половинка стальных кованых лат, нагрудник вместе с наспинником"
                        ],
                        "tags": [
                            "только мн."
                        ],
                        "examples": [
                            {
                                "example_id": "fe0cd322-81be-47a2-99a9-e79aaa04d832",
                                "sense_id": "67b3feae-14b8-36d1-bc34-d9a220d36f64",
                                "text": "И наплечники и зерцала погнулись у обоих от ударов."
                            }
                        ]
                    },
                    {
                        "sense_id": "c54f2c8f-8d3c-37c9-9cf4-d18af3d3098e",
                        "entry_id": "deacfb33-95e4-3b87-8286-191d308ce6bf",
                        "glosses": [
                            "истор. трёхгранная призма с написанными на её гранях тремя указами Петра I, увенчанная двуглавым орлом и устанавливавшаяся в присутственных местах как эмблема правосудия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27f654e5-2508-44cd-b29b-4862b14c62a7",
                                "sense_id": "c54f2c8f-8d3c-37c9-9cf4-d18af3d3098e",
                                "text": "И один из священнодействующих, тут же находившихся, приносивший с таким усердием жертвы Фемиде, что оба рукава лопнули на локтях и давно лезла оттуда подкладка, за что и получил в своё время коллежского регистратора, прислужился нашим приятелям, как некогда Виргилий прислужился Данту, и провёл их в комнату присутствия, где стояли одни только широкие кресла и в них перед столом, за зерцалом и двумя толстыми книгами, сидел один, как солнце, председатель."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "81c3622f-2191-4386-8ef0-caa72a6597ea",
                        "source_entry_id": "deacfb33-95e4-3b87-8286-191d308ce6bf",
                        "target_lang_word": "mirror",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mirror",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e2e608a2-3949-3e5d-8ebb-352478bca2d9",
                                        "entry_id": "b6eb62ff-5420-3b40-809f-efaff3c26077",
                                        "glosses": [
                                            "A smooth surface, usually made of glass with reflective material painted on the underside, that reflects light so as to give an image of what is in front of it."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3663bcd2-c224-4cdb-8e1d-bea184dff5ac",
                                                "sense_id": "e2e608a2-3949-3e5d-8ebb-352478bca2d9",
                                                "text": "I had a look in the mirror to see if the blood had come off my face."
                                            },
                                            {
                                                "example_id": "754dbe19-96c2-4814-a1a1-b08a0a80e716",
                                                "sense_id": "e2e608a2-3949-3e5d-8ebb-352478bca2d9",
                                                "text": "He broke the mirror with the pickaxe."
                                            },
                                            {
                                                "example_id": "26e50122-6f03-4582-aff9-fda0740cac7c",
                                                "sense_id": "e2e608a2-3949-3e5d-8ebb-352478bca2d9",
                                                "text": "We could see the lorry in the mirror, so decided to change lanes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92420862-2b7d-33f3-93f9-26daa574081d",
                                        "entry_id": "b6eb62ff-5420-3b40-809f-efaff3c26077",
                                        "glosses": [
                                            "An object, person, or event that reflects or gives a picture of another."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "466802e4-6b82-48f2-a4ba-a3f212928fde",
                                                "sense_id": "92420862-2b7d-33f3-93f9-26daa574081d",
                                                "text": "His story is a mirror into the life of orphans growing up."
                                            },
                                            {
                                                "example_id": "7fbe96b7-7148-434c-8521-9dfb686b582f",
                                                "sense_id": "92420862-2b7d-33f3-93f9-26daa574081d",
                                                "text": "O goddess, heavenly bright, / Mirror of grace and majesty divine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88b0ce12-7dde-37cb-b9de-2b20d344de9d",
                                        "entry_id": "b6eb62ff-5420-3b40-809f-efaff3c26077",
                                        "glosses": [
                                            "A website or server that contains replicated data from another site."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cef6696e-e933-4400-837c-eebce212dffc",
                                                "sense_id": "88b0ce12-7dde-37cb-b9de-2b20d344de9d",
                                                "text": "Although the content had been deleted from his blog, it was still found on some mirrors."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ded9752-34c4-33cc-b90f-de675abce517",
                                        "entry_id": "b6eb62ff-5420-3b40-809f-efaff3c26077",
                                        "glosses": [
                                            "A mirror carp."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "03f8cd2c-8a47-3b31-bf14-43a3f3230fca",
                                        "entry_id": "b6eb62ff-5420-3b40-809f-efaff3c26077",
                                        "glosses": [
                                            "A kind of political self-help book, advising kings, princes, etc. on how to behave."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
