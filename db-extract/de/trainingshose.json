                    {
                        "sense_id": "ccb4b834-6354-3b4b-b81c-74e55b30de29",
                        "entry_id": "7e6f669c-176a-3766-a83e-d42dc41d9bda",
                        "glosses": [
                            "lange, bequeme Hose, oft als Teil eines Sportanzugs, die beim Training getragen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2bdd0f7c-dbba-4faf-b777-c7bf6c3f613a",
                                "sense_id": "ccb4b834-6354-3b4b-b81c-74e55b30de29",
                                "text": "„Das war ein Opa mit Schiebermütze, der beim Laufen immer seine Trainingshose hochzog, wobei ich einmal seinen blanken Arsch sehen konnte.“"
                            },
                            {
                                "example_id": "4c86bf77-165f-4e4e-8036-81baec7c369d",
                                "sense_id": "ccb4b834-6354-3b4b-b81c-74e55b30de29",
                                "text": "„Ein Mann in Trainingshose und Gummistiefeln kam vom Ufer herauf, wo er mit ein paar Helfern ein Floß zu Wasser gelassen hatte.“"
                            },
                            {
                                "example_id": "fd79df7b-abe2-4172-b4bf-c95f6bae8aa4",
                                "sense_id": "ccb4b834-6354-3b4b-b81c-74e55b30de29",
                                "text": "„War ich außer Sichtweite, krempelte ich die Trainingshose wieder herunter und wurschtelte mein Kleid in den Hosenbund.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
