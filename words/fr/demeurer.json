    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5aa016c1-697a-3c03-bf8b-3ed59226f31a",
                    "sense_definition": "Rester ou continuer d'être dans un certain état.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "etat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Face aux provocations répétées, le responsable a su <w>demeurer</w> calme et poli."
                        },
                        {
                            "text": "Le mystère entourant cette étrange disparition est longtemps <w>demeuré</w> sans explication satisfaisante."
                        }
                    ],
                    "synonyms": [
                        "rester"
                    ],
                    "antonyms": [
                        "changer"
                    ],
                    "common_phrases": [
                        "demeurer calme",
                        "demeurer silencieux",
                        "demeurer sans réponse"
                    ]
                },
                {
                    "sense_id": "5f77eacf-8afe-313e-a782-b7898c8ffde8",
                    "sense_definition": "Avoir son logement ou son domicile principal dans un endroit ; habiter.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "logement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant toute la durée de ses études, cet étudiant a <w>demeuré</w> chez sa tante."
                        },
                        {
                            "text": "Ils préfèrent la tranquillité de la campagne et <w>demeurent</w> dans un ancien moulin rénové."
                        }
                    ],
                    "common_phrases": [
                        "demeurer à la campagne",
                        "demeurer en ville"
                    ],
                    "synonyms": [
                        "habiter",
                        "résider"
                    ]
                },
                {
                    "sense_id": "9c571775-c80f-3a24-93f3-a81fad245fd5",
                    "sense_definition": "S'arrêter ou séjourner en un lieu pendant un temps plus ou moins long.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sejour",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En raison des fortes chutes de neige, les voyageurs sont <w>demeurés</w> plusieurs heures dans le train."
                        },
                        {
                            "text": "Nous sommes <w>demeurés</w> au sommet de la colline pour observer le magnifique coucher de soleil."
                        }
                    ],
                    "synonyms": [
                        "rester"
                    ],
                    "antonyms": [
                        "partir",
                        "s'en aller"
                    ],
                    "common_phrases": [
                        "demeurer sur place",
                        "demeurer au lit"
                    ]
                },
                {
                    "sense_id": "c0f958ba-893e-3b24-a89a-e069ca5b8cf5",
                    "sense_definition": "Continuer d'exister, de subsister à travers le temps ; persister.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "persistance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette belle mélodie de notre enfance est <w>demeurée</w> gravée dans nos cœurs."
                        },
                        {
                            "text": "Même des siècles après sa rédaction, cette œuvre littéraire <w>demeure</w> d'actualité pour les lecteurs."
                        }
                    ],
                    "synonyms": [
                        "rester"
                    ],
                    "antonyms": [
                        "disparaître",
                        "s'effacer"
                    ],
                    "common_phrases": [
                        "demeurer d'actualité",
                        "demeurer gravé"
                    ]
                }
            ]
        }
    ]
