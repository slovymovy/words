                ],
                "senses": [
                    {
                        "sense_id": "7ebfedb1-872d-36a6-812b-cdc1cc65e256",
                        "entry_id": "bc55551c-9e54-3c3d-b4b3-6fb24e3a2f68",
                        "glosses": [
                            "in Streifen geschnittene Soden sortenreinen Rasens, die in aufgerollter Form transportiert und am zuvor präparierten Bestimmungsort zur Schaffung einer Rasenfläche verlegt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5e80431-ecfb-4f41-88f0-7a7ff2d9c599",
                                "sense_id": "7ebfedb1-872d-36a6-812b-cdc1cc65e256",
                                "text": "Wer nicht warten will und ein paar Euro übrig hat, oder sicher sein will, dass nicht zurerst die Unkräuter wachsen, sollte sich für Rollrasen entscheiden."
                            },
                            {
                                "example_id": "15bfa10f-0f2d-45b7-93b5-f8a31f67ceff",
                                "sense_id": "7ebfedb1-872d-36a6-812b-cdc1cc65e256",
                                "text": "Denn durch das Auslegen mit Rollrasen kann die Zeitspanne bis zum Beginn des Spielbetriebs in einem Fußballstadion oder bis zum Betreten einer Liegewiese in einem Freibad auf etwa sechs Wochen verkürzt werden."
                            },
                            {
                                "example_id": "2b94ee43-6283-4457-85e4-376c51231756",
                                "sense_id": "7ebfedb1-872d-36a6-812b-cdc1cc65e256",
                                "text": "Während in Deutschland erst etwa 10 bis 15 Prozent der jährlich angelegten Rasenflächen mit Fertigrasen belegt werden, hat Rollrasen in Amerika und in den Niederlanden eine viel größere Bedeutung."
                            },
                            {
                                "example_id": "579f9ca9-e7db-49f8-a55b-0a4c121e887a",
                                "sense_id": "7ebfedb1-872d-36a6-812b-cdc1cc65e256",
                                "text": "Bei Neuanlagen wird Rasen meist gesät, während sich Rollrasen für Sanierungen gut eignet."
                            },
                            {
                                "example_id": "b0d508ca-54a9-40f5-b828-37723d3d5fa1",
                                "sense_id": "7ebfedb1-872d-36a6-812b-cdc1cc65e256",
                                "text": "Aber jetzt war mir der Garten nicht mehr egal, meine Sorge begann, als der Rollrasen geliefert und auf den Mutterboden gelegt wurde."
                            },
                            {
                                "example_id": "7d872a84-5f2c-4e82-823a-bfb4f1291a76",
                                "sense_id": "7ebfedb1-872d-36a6-812b-cdc1cc65e256",
                                "text": "Da sind ja unsere Alterspräsidenten\", sagt Milan und stoppt an einem Zaun, dunkelgrün gestrichen, dahinter feinster Rollrasen, hellgrün."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
