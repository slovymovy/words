    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "65a5dc5d-b5d2-3bea-8c9d-bdf258bca1e8",
                    "sense_definition": "Orde in een verzameling aanbrengen door soort bij soort te leggen.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "ordenen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De eieren worden zorgvuldig naar gewicht <w>gesorteerd</w>.",
                            "target_lang_translations": {
                                "it": "Le uova vengono accuratamente <w>selezionate</w> in base al peso.",
                                "en": "The eggs are carefully <w>sorted</w> by weight."
                            }
                        },
                        {
                            "text": "We moeten eerst het afval <w>sorteren</w> voordat we het weggooien.",
                            "target_lang_translations": {
                                "it": "Dobbiamo prima <w>differenziare</w> i rifiuti prima di gettarli via.",
                                "en": "We first need to <w>sort</w> the waste before throwing it away."
                            }
                        }
                    ],
                    "synonyms": [
                        "ordenen",
                        "rangschikken"
                    ],
                    "common_phrases": [
                        "afval sorteren",
                        "post sorteren"
                    ],
                    "target_lang_definitions": {
                        "it": "Mettere in ordine una collezione raggruppando gli elementi simili.",
                        "en": "To arrange a collection of items into order by grouping like with like."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "smistare",
                                "target_lang_sense_clarification": "per posta, merci o oggetti"
                            },
                            {
                                "target_lang_word": "differenziare",
                                "target_lang_sense_clarification": "riferito ai rifiuti"
                            },
                            {
                                "target_lang_word": "selezionare",
                                "target_lang_sense_clarification": "scegliere in base a criteri di qualità o peso"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "sort",
                                "target_lang_sense_clarification": "to group items into categories"
                            },
                            {
                                "target_lang_word": "separate",
                                "target_lang_sense_clarification": "to divide items into different types or piles"
                            },
                            {
                                "target_lang_word": "classify",
                                "target_lang_sense_clarification": "to arrange systematically in categories"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e1e35ced-3db4-33f8-87b6-a16905871277",
                    "sense_definition": "Het in een bepaalde volgorde zetten van de elementen van een lijst.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ordenen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je kunt de lijst met namen alfabetisch <w>sorteren</w>.",
                            "target_lang_translations": {
                                "it": "Puoi <w>ordinare</w> l'elenco dei nomi in ordine alfabetico.",
                                "en": "You can <w>sort</w> the list of names alphabetically."
                            }
                        },
                        {
                            "text": "Het is handig om de bestanden op datum te <w>sorteren</w>.",
                            "target_lang_translations": {
                                "it": "È utile <w>ordinare</w> i file per data.",
                                "en": "It is useful to <w>sort</w> the files by date."
                            }
                        }
                    ],
                    "synonyms": [
                        "ordenen",
                        "rangschikken"
                    ],
                    "common_phrases": [
                        "alfabetisch sorteren",
                        "op datum sorteren"
                    ],
                    "target_lang_definitions": {
                        "it": "Disporre gli elementi di una lista in un ordine specifico.",
                        "en": "To arrange the elements of a list in a particular order (e.g., alphabetical or chronological)."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "ordinare",
                                "target_lang_sense_clarification": "in base a un criterio come l'ordine alfabetico o cronologico"
                            },
                            {
                                "target_lang_word": "classificare",
                                "target_lang_sense_clarification": "disporre in categorie"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "sort",
                                "target_lang_sense_clarification": "into an orderly sequence like alphabetical or numerical"
                            },
                            {
                                "target_lang_word": "order",
                                "target_lang_sense_clarification": "to put in a specified sequence"
                            },
                            {
                                "target_lang_word": "arrange",
                                "target_lang_sense_clarification": "to place in a particular sequence or pattern"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}