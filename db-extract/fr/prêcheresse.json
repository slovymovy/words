                        "entry_id": "e2449dbd-9f94-3820-a14a-109e662dadd9",
                        "glosses": [
                            "Celle qui prêche, qui donne des leçons."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "adecb978-56c8-4ec4-bca2-5a0f45ba43f5",
                                "sense_id": "8e7965f7-1d20-3037-8c4f-9a8b2ceb5997",
                                "text": "De sa Macette enfin, la prude prêcheresse,\nEnseignant à bien vivre à sa jeune maîtresse."
                            }
                        ]
