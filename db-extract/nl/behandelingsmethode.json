                        "sense_id": "e2f4ead1-3a49-3583-b6b5-b479e13735dc",
                        "entry_id": "85041c8d-bb8e-32c2-8e93-b242f2f4ddde",
                        "glosses": [
                            "de manier hoe men een patiënt gezond kan maken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d8b2c66-cd80-4c7b-9eff-d07c13c8d04e",
                                "sense_id": "e2f4ead1-3a49-3583-b6b5-b479e13735dc",
                                "text": "De onderzoekers presenteerden hun bevindingen op een conferentie in Parijs. Door het kind uit Zuid-Afrika te bestuderen hopen ze een nieuwe behandelingsmethode te ontdekken voor hiv-patiënten."
                            },
                            {
                                "example_id": "b14bdc1a-60e1-44ec-93f2-7d0e23cccbd6",
                                "sense_id": "e2f4ead1-3a49-3583-b6b5-b479e13735dc",
                                "text": "De kliniek verklaarde eerder altijd het advies te geven aan zijn patiënten om ook met hun eigen arts in contact te blijven. In de verklaring stond ook dat de kliniek achter zijn behandelingsmethode blijft staan."
                            },
                            {
                                "example_id": "d01c22db-cd55-412d-8224-5aacd84b22f7",
                                "sense_id": "e2f4ead1-3a49-3583-b6b5-b479e13735dc",
                                "text": "Dankzij een hersenscan kunnen artsen beter voorspellen of elektroshocktherapie een geschikte behandelmethode is voor een depressieve patiënt. Dat blijkt uit een klein onderzoek van Nederlandse artsen dat vandaag wordt gepubliceerd in het wetenschappelijke tijdschrift Molecular Psychiatry, schrijft de Volkskrant."
                            }
                        ]
                    }
