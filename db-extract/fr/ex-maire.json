                        "glosses": [
                            "Ancien maire (qui ne l’est plus)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e67b0bf-43f4-4cd9-b765-9ef484e02929",
                                "sense_id": "dd3b24df-e5f9-3feb-b8df-9303614a6d61",
                                "text": "Ce lundi, se tient le procès en diffamation intenté par l’ex-maire de Drancy contre la journaliste Eve Szeftel pour son livre Le Maire et les Barbares, dans lequel elle dénonçait notamment les pratiques clientélistes de Jean-Christophe Lagarde."
                            },
                            {
                                "example_id": "8f722fa8-25b2-45fb-ab38-08c500fd8ce1",
                                "sense_id": "dd3b24df-e5f9-3feb-b8df-9303614a6d61",
                                "text": "Nous avons, aux articles de la capacité des parties contractantes, rapporté un arrêt qui a déclaré un ex-maire personnellement responsable d’un emprunt qu’il avait fait en cette qualité."
                            },
                            {
                                "example_id": "360653ae-185b-4b41-b73d-462e1033bf0d",
                                "sense_id": "dd3b24df-e5f9-3feb-b8df-9303614a6d61",
                                "text": "Les autres bénéficiaires furent deux gouverneurs, 11 députés régionaux, cinq maires, huit ex-députés fédéraux, trois ex-gouverneurs, huit ex-maires et 23 autres politiques."
                            }
                        ]
                    }
