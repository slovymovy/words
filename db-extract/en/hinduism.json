                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f516ad92-85bc-4345-9572-46af97b32333",
                                                "sense_id": "5811ff77-b48c-3a9d-af27-5263f39db09b",
                                                "text": "Der Hinduismus ist nach dem Christentum und dem Islam mit zirka 800 Millionen Anhängern die drittgrößte Religion der Welt."
                                            },
                                            {
                                                "example_id": "7fd73ef1-e5ae-4186-998d-20a9c19d2e44",
                                                "sense_id": "5811ff77-b48c-3a9d-af27-5263f39db09b",
                                                "text": "„Für die Sufis war der Gedanke einer Versöhnung des Islam mit dem Hinduismus nichts Neues.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
