                        "source_sense_id": "dcfca9da-26fc-30fd-88d8-d1848f8e5af6",
                        "source_sense_description": "Biologie: undifferenzierte Zelle, die sich zu jeden Zelltyp oder Art von Gewebezelle entwickeln kann",
                        "target_lang_word": "stem cell",
                        "target_lang_code": "en",
