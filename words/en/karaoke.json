                    "frequency": "Middle",
                    "semantic_group_id": "entertainment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The office party ended with a long <w>karaoke</w> that lasted until midnight.",
                            "target_lang_translations": {
                                "ru": "Офисная вечеринка закончилась долгим <w>караоке</w>, которое продолжалось до полуночи."
                            }
                        },
                        {
                            "text": "After dinner, we had a fun <w>karaoke</w> in the living room.",
                            "target_lang_translations": {
                                "ru": "После ужина мы устроили веселое <w>караоке</w> в гостиной."
