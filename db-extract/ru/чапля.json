                            {
                                "example_id": "6f4801b0-857b-4471-ae24-7641988e2417",
                                "sense_id": "9b187b13-3f9a-306e-9e7f-65179321a57e",
                                "text": "Чаплей в нашем селе зовут тех, кто из ума выжил, ― по имени давно умершего Ивана Чапли."
                            }
                        ]
                    },
