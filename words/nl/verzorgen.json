                {
                    "sense_id": "63130fb3-0add-3d6e-bfed-6dd652999c04",
                    "sense_definition": "het regelen of aanbieden van een bepaalde dienst of voorziening",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "aanbieden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het bedrijf zal de catering voor het grote feest volledig <w>verzorgen</w>.",
                            "target_lang_translations": {
                                "en": "The company will fully <w>provide</w> the catering for the large party.",
                                "ru": "Компания полностью <w>обеспечит</w> кейтеринг для большого праздника."
                            }
                        },
                        {
                            "text": "Zij <w>verzorgt</w> de administratie voor verschillende kleine ondernemers in de stad.",
                            "target_lang_translations": {
                                "en": "She <w>handles</w> the administration for several small business owners in the city.",
                                "ru": "Она <w>занимается</w> административными делами нескольких мелких предпринимателей в городе."
                            }
                        }
                    ],
                    "common_phrases": [
                        "de catering verzorgen",
                        "de muziek verzorgen",
                        "een presentatie verzorgen"
                    ],
                    "target_lang_definitions": {
                        "en": "to arrange, provide, or be responsible for a specific service, task, or facility",
                        "ru": "организовывать, предоставлять или брать на себя ответственность за определенную услугу или задачу"
                    },
