                    {
                        "translation_id": "bfc5b5b0-5edb-4ced-b096-d509f913e682",
                        "source_entry_id": "5b938130-af1d-333a-8690-c82c3ec6a532",
                        "source_sense_id": "6e351142-6701-368d-8b50-47c5cb1b3859",
