                        "sense_id": "889505f9-cc98-3dd8-83d1-7525aa4d1ab1",
                        "entry_id": "4d1976b8-808e-32c1-a228-2a4910da22cc",
                        "glosses": [
                            "een ruimte in een gebouw dat gelegen is voor een belangrijker vertrek"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28ebadcd-56e8-4510-a04a-9084996a1fcd",
                                "sense_id": "889505f9-cc98-3dd8-83d1-7525aa4d1ab1",
                                "text": "Hoewel hij met pensioen was en nu geen invloed meer had in staatszaken, achtte iedere hoge ambtenaar van het gouvernement waarin het landgoed van de vorst lag, het zijn plicht zijn opwachting bij hem te maken, en dus wachtte hij, net als de architect, de tuinman of freule Marja, in het hoge voorvertrek tot de vorst op het afgesproken tijdstip verscheen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "98b3a55b-fd73-4e12-8bbb-780f367ca650",
                        "source_entry_id": "4d1976b8-808e-32c1-a228-2a4910da22cc",
                        "source_sense_id": "889505f9-cc98-3dd8-83d1-7525aa4d1ab1",
                        "source_sense_description": "een ruimte in een gebouw dat gelegen is voor een belangrijker vertrek",
                        "target_lang_word": "front room",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "front room",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7cb5dddb-dc0a-3ae2-ad39-3ffa39fc7cb1",
                                        "entry_id": "2747f596-ffec-334a-b182-929504a6e6db",
                                        "glosses": [
                                            "A room in the front of a house; especially, a living room in such position that is used for entertaining guests or for special occasions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4ba943f-74a2-4f95-b8b5-7c41ae7f1e91",
                                                "sense_id": "7cb5dddb-dc0a-3ae2-ad39-3ffa39fc7cb1",
                                                "text": "She did not knock at the door, which stood open, but, somewhat to Fermi's amazement, walked at once into the front room, which was plainly the room of state."
                                            },
                                            {
                                                "example_id": "18e2957e-30a8-4414-aca2-dea689d0d711",
                                                "sense_id": "7cb5dddb-dc0a-3ae2-ad39-3ffa39fc7cb1",
                                                "text": "He found the door open, and in the front room, which is bare of furniture, discovered the body of a gentleman, well dressed, and having cards in his pocket bearing the name of ‘Enoch J. Drebber, Cleveland, Ohio, U.S.A.‘"
                                            },
                                            {
                                                "example_id": "0a6256b7-7097-4154-ab81-8aa755675893",
                                                "sense_id": "7cb5dddb-dc0a-3ae2-ad39-3ffa39fc7cb1",
                                                "text": "The front room, the parlor, seemed to us children to be a room of much splendor, but was open for general use only on Sunday evening or on rare occasions when there were parties."
                                            },
                                            {
                                                "example_id": "9c0f9ba4-ba28-4559-a060-bfb533ea2d60",
                                                "sense_id": "7cb5dddb-dc0a-3ae2-ad39-3ffa39fc7cb1",
                                                "text": "She had a whole floor of everlasting flowers spread to dry in her front room."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7ca07c0d-7640-4d3e-9d93-38003cb4ccdb",
                        "source_entry_id": "4d1976b8-808e-32c1-a228-2a4910da22cc",
                        "source_sense_id": "889505f9-cc98-3dd8-83d1-7525aa4d1ab1",
