                "senses": [
                    {
                        "sense_id": "277741f0-7a2f-3b02-aebf-316a4bbc37b6",
                        "entry_id": "5c6c9160-5a8e-35eb-863a-2b883b000958",
                        "glosses": [
                            "Gerät, bei dem im Gegensatz zu einer Zigarette kein Tabak verbrannt, sondern bei dem eine aromatisierte Flüssigkeit elektrisch verdampft wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8583935f-5ff1-4599-9d9a-b42e3210878b",
                                "sense_id": "277741f0-7a2f-3b02-aebf-316a4bbc37b6",
                                "text": "„Die E-Zigarette ist aber längst auf dem Weg zum Massenphänomen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e944ffac-2a24-4224-a28b-58a0f3ad641b",
                        "source_entry_id": "5c6c9160-5a8e-35eb-863a-2b883b000958",
                        "source_sense_id": "277741f0-7a2f-3b02-aebf-316a4bbc37b6",
                        "source_sense_description": "Gerät, bei dem eine aromatisierte Flüssigkeit elektrisch verdampft wird",
                        "target_lang_word": "e-cig",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "e-cig",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a24d53ae-77b3-3337-947f-cc41a60245bb",
                                        "entry_id": "22b80b6b-e27b-38b5-a4c3-afdb0348b6b0",
                                        "glosses": [
                                            "Syllabic abbreviation of electronic cigarette."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7121970-4e1e-46a4-82e6-93ad71024278",
                                                "sense_id": "a24d53ae-77b3-3337-947f-cc41a60245bb",
                                                "text": "The tobacco industry is pushing a new kind of smoking device — the e-cig or vape pen — that it says is far healthier than traditional cigarettes: no tobacco, no tar, just nicotine and flavored vapor."
                                            },
                                            {
                                                "example_id": "41f23c60-f911-4831-9051-58b6c143f77d",
                                                "sense_id": "a24d53ae-77b3-3337-947f-cc41a60245bb",
                                                "text": "Laranya Caslin [...] told the health and social care committee e-cigs are “a much bigger issue” than smoking - estimating one in four kids uses them."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ff57448f-c907-4ccd-b079-ac5387fe14c4",
                        "source_entry_id": "5c6c9160-5a8e-35eb-863a-2b883b000958",
                        "source_sense_id": "277741f0-7a2f-3b02-aebf-316a4bbc37b6",
                        "source_sense_description": "Gerät, bei dem eine aromatisierte Flüssigkeit elektrisch verdampft wird",
                        "target_lang_word": "e-cigarette",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "e-cigarette",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "31c0b2b1-1dc2-33b6-a01f-c141e9479f64",
                                        "entry_id": "306b16e0-53d6-38f4-8cd8-264c807148d2",
                                        "glosses": [
                                            "Synonym of electronic cigarette."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9af425dd-23b5-48d7-9afe-45a0822ed0aa",
                                                "sense_id": "31c0b2b1-1dc2-33b6-a01f-c141e9479f64",
                                                "text": "Electronic cigarettes, battery-powered devices that convert a solution of nicotine and other chemicals into a vapor that can be inhaled, or \"vaped,\" have the potential to wean a vast number of smokers off cigarettes. […] The problem is, not enough smokers are switching to e-cigarettes, despite their relative safety – and understandably so. Smokers are barraged with news about inaccurate labeling, shoddy counterfeits and poorly made e-cigarettes that emit toxins and cancer-causing chemicals in vapor."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
