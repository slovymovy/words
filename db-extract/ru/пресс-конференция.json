                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "290c63ad-3c97-4b91-a9f2-e189314103d0",
                        "source_entry_id": "60fcfb4f-78f6-31a0-88eb-9f45f31aefa0",
                        "source_sense_id": "519b05d6-38be-396c-931d-1f65e04f9ba4",
                        "target_lang_word": "conferenza stampa",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "218c91d2-8ded-48ff-94a8-4669ca007a14",
                        "source_entry_id": "60fcfb4f-78f6-31a0-88eb-9f45f31aefa0",
                        "source_sense_id": "519b05d6-38be-396c-931d-1f65e04f9ba4",
                        "target_lang_word": "Pressekonferenz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pressekonferenz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e0c79503-96fc-3656-8da5-5ee743e81f99",
                                        "entry_id": "d7b1d2b0-cac5-3f55-b9dd-f4c1c3fe00e8",
                                        "glosses": [
                                            "Treffen, bei dem Personen öffentlichen Interesses aktuelle Informationen an Journalisten weitergeben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9540356-56ae-49c2-96a7-160245afd10d",
                                                "sense_id": "e0c79503-96fc-3656-8da5-5ee743e81f99",
                                                "text": "Nach mancher Pressekonferenz fragt man sich, wieso sie überhaupt abgehalten wurde."
                                            },
                                            {
                                                "example_id": "20960ea9-900e-479d-8559-0c46a577e6b9",
                                                "sense_id": "e0c79503-96fc-3656-8da5-5ee743e81f99",
                                                "text": "„Merkel selbst äußerte sich erst am späten Nachmittag während einer gemeinsamen Pressekonferenz mit Nato-Generalsekretär Fogh Rasmussen zu den Vorfällen.“"
                                            },
                                            {
                                                "example_id": "46784456-594b-4864-bd25-43dab600d013",
                                                "sense_id": "e0c79503-96fc-3656-8da5-5ee743e81f99",
                                                "text": "„Regelmäßig werden Statistiken erhoben und veröffentlicht, mit Pressekonferenz und sonstiger medialer Begleitung.“"
                                            },
                                            {
                                                "example_id": "46c7e0b2-6c3b-4953-9765-8d414b120a09",
                                                "sense_id": "e0c79503-96fc-3656-8da5-5ee743e81f99",
                                                "text": "„So pries er seinen Wahlsieg vergangene Woche als den größten seit Ronald Reagan – was Quatsch war, wie ihm gleich in der Pressekonferenz aufgezeigt wurde.“"
                                            },
                                            {
                                                "example_id": "3ee31af2-8667-469c-969b-e9683f40b994",
                                                "sense_id": "e0c79503-96fc-3656-8da5-5ee743e81f99",
                                                "text": "„Am Tag zuvor hatte ich ihn bei einer Pressekonferenz kennengelernt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a0f4f857-d261-4098-9d54-27c8f1888db5",
                        "source_entry_id": "60fcfb4f-78f6-31a0-88eb-9f45f31aefa0",
                        "source_sense_id": "519b05d6-38be-396c-931d-1f65e04f9ba4",
                        "target_lang_word": "persconferentie",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "persconferentie",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "892d36af-efc6-3708-ba55-63f0b148ca44",
                                        "entry_id": "278486dd-01ce-36e8-853c-4269b913626e",
                                        "glosses": [
                                            "een bijeenkomst van journalisten waar een persoon of woordvoerder van en organisatie een verklaring aflegt of vragen beantwoordt"
                                        ],
                                        "tags": [
                                            "media"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bfea02fa-b5c7-40e5-9081-29b624ce38cf",
                                                "sense_id": "892d36af-efc6-3708-ba55-63f0b148ca44",
                                                "text": "Van die persconferentie zijn we nog niet veel wijzer geworden."
                                            },
                                            {
                                                "example_id": "5491a63e-50c3-4ec4-bfe1-7a0ca7c3bc92",
                                                "sense_id": "892d36af-efc6-3708-ba55-63f0b148ca44",
                                                "text": "Meer dan een vage schets is het niet, maar het beeld dat astronomen vanmiddag vrijgaven op zes simultane persconferenties over de hele wereld vormt een grote mijlpaal in de astronomie."
                                            },
                                            {
                                                "example_id": "320ddbe5-625f-4c2b-b294-19a91bd09004",
                                                "sense_id": "892d36af-efc6-3708-ba55-63f0b148ca44",
                                                "text": "In een persconferentie liet Johnson weten dat de zoektocht naar zijn opvolger volgende week begint. \"In de politiek is niemand ook maar enigszins onvervangbaar. Ons geweldige systeem zal een andere leider produceren\", aldus Johnson. Hij beloofde dat hij die nieuwe leider \"alle steun zal geven die ik kan geven\"."
                                            },
                                            {
                                                "example_id": "66fafd04-7086-4674-8f27-8c9933095d6a",
                                                "sense_id": "892d36af-efc6-3708-ba55-63f0b148ca44",
                                                "text": "Journalisten vroegen Merkel tijdens de persconferentie hoe lang ze nog kan wachten op het rapport van de trojka over Griekenland. Als het klaar is, is het klaar, zei Merkel. \"Gedegenheid is belangrijker is dan snelheid.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "35203abe-6f2d-4fbc-8139-693b74c141dd",
                        "source_entry_id": "60fcfb4f-78f6-31a0-88eb-9f45f31aefa0",
                        "source_sense_id": "519b05d6-38be-396c-931d-1f65e04f9ba4",
                        "target_lang_word": "konferencja prasowa",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "konferencja prasowa",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "6784c97d-9da8-38cf-9218-825cc466a544",
                                        "entry_id": "87cff9ef-3238-32d9-bdca-d0433501a06f",
                                        "glosses": [
                                            "spotkanie przedstawicieli jakiejś instytucji z dziennikarzami, wysłannikami mediów"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34857ad3-e206-40e7-ba4b-ee1deae32eb1",
                                                "sense_id": "6784c97d-9da8-38cf-9218-825cc466a544",
                                                "text": "Konferencja prasowa odbyła się o godz. 14:00."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cb1cd286-2576-44a5-96d9-2704e562a720",
                        "source_entry_id": "60fcfb4f-78f6-31a0-88eb-9f45f31aefa0",
                        "source_sense_id": "519b05d6-38be-396c-931d-1f65e04f9ba4",
                        "target_lang_word": "conférence de presse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conférence de presse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7fdb2574-30dd-3abc-ad3c-3d967fabf787",
                                        "entry_id": "22352b45-48ab-3d65-971b-99af27da9fbb",
                                        "glosses": [
                                            "Évènement médiatique dans lequel des personnalités ou des représentants invitent les journalistes à les entendre parler et, le plus souvent, poser des questions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1574e4d-b1ae-4bf0-9418-a99c2ddd235d",
                                                "sense_id": "7fdb2574-30dd-3abc-ad3c-3d967fabf787",
                                                "text": "Si certains de leurs membres sont en prison, comme on l'a vu à Okacha à Casablanca, aussitôt des conférences de presse sont organisées et il est fait appel aux défenseurs des Droits de l’Homme et aux démocrates. Ceux-ci sont cependant mal à l'aise."
                                            },
                                            {
                                                "example_id": "0df4655f-c1d8-4557-81b5-f95e1c3f7b26",
                                                "sense_id": "7fdb2574-30dd-3abc-ad3c-3d967fabf787",
                                                "text": "\"Et malheureusement, on en a la preuve\", a-t-il déclaré lors d'une conférence de presse destinée à présenter le plan de vaccination du gouvernement Legault, qui prévoit la priorisation des résidents en CHSLD."
                                            },
                                            {
                                                "example_id": "f025f00e-3766-4927-bed6-c560b958dd4c",
                                                "sense_id": "7fdb2574-30dd-3abc-ad3c-3d967fabf787",
                                                "text": "Jusque-là, donc, le PSG semblait jouer dans un fauteuil face à une Juventus qui, à l’image de son coach, Massimiliano Allegri, la veille en conférence de presse, transpirait à peu près autant la confiance qu’un lapin pris dans les phares d’une Ferrari."
                                            },
                                            {
                                                "example_id": "32ae8507-b2af-40cd-b67b-de1022db068d",
                                                "sense_id": "7fdb2574-30dd-3abc-ad3c-3d967fabf787",
                                                "text": "Et « des médias diffusant la propagande russe sont également autorisés » dans les conférences de presse du gouvernement, a-t-il aussi affirmé."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
