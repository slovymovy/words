                                    {
                                        "sense_id": "b3fd596a-17e0-339e-bee7-2d35d14056e1",
                                        "entry_id": "8b8e21ca-27eb-3bc6-8b76-65c1c2b797c9",
                                        "glosses": [
                                            "The science of the dynamics of bodies moving relative to gases, especially the interaction of moving objects with the atmosphere."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "93f9a6b2-79d5-3289-a2ab-fb137ec4065a",
                                        "entry_id": "8b8e21ca-27eb-3bc6-8b76-65c1c2b797c9",
                                        "glosses": [
                                            "The aerodynamic properties of a particular object (typically a car)."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8177f23-e7b4-4022-8a87-4ca9ef7ae8c6",
                                                "sense_id": "93f9a6b2-79d5-3289-a2ab-fb137ec4065a",
                                                "text": "However, it can also make the aerodynamics more difficult to control, and it becomes much harder to stop the nose of the car scraping against the surface of the track."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
