        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d457187c-bf2b-3d6c-b52c-e3ccb97135ad",
                    "sense_definition": "To blink with only one eye as a signal or suggestion, often implying a secret or conspiracy.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "eye_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>winked</w> at me to show that he was only joking."
                        },
                        {
                            "text": "She <w>winked</w> her eye to signal that the plan was ready."
                        }
                    ],
                    "synonyms": [
                        "😉",
                        ";)",
                        ";-)"
                    ],
                    "common_phrases": [
                        "wink at someone"
                    ]
                },
                {
