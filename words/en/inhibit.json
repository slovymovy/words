{
    "word_family": [
        "inhibitor",
        "inhibition",
        "inhibitory",
        "uninhibited"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c01307ad-79e1-3d77-9af3-e2fc938c1e61",
                    "sense_definition": "To hold back, restrain, or prevent a process or action from happening freely.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "restraint",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Strict regulations can often <w>inhibit</w> growth in small businesses by creating too much paperwork.",
                            "target_lang_translations": {
                                "ru": "Строгие правила часто могут <w>сдерживать</w> рост малого бизнеса, создавая слишком много бумажной волокиты."
                            }
                        },
                        {
                            "text": "The cold weather will <w>inhibit</w> plant growth if the temperature stays below freezing for too long.",
                            "target_lang_translations": {
                                "ru": "Холодная погода будет <w>подавлять</w> рост растений, если температура будет оставаться ниже нуля слишком долго."
                            }
                        }
                    ],
                    "synonyms": [
                        "restrain",
                        "hinder",
                        "impede",
                        "obstruct",
                        "prevent",
                        "restrict",
                        "hamper"
                    ],
                    "antonyms": [
                        "encourage",
                        "promote",
                        "facilitate",
                        "assist"
                    ],
                    "common_phrases": [
                        "inhibit growth",
                        "inhibit progress",
                        "inhibit the development"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сдерживать, ограничивать или препятствовать свободному протеканию процесса или действия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подавлять",
                                "target_lang_sense_clarification": "сдерживать развитие или рост"
                            },
                            {
                                "target_lang_word": "сдерживать",
                                "target_lang_sense_clarification": "замедлять или мешать прогрессу"
                            },
                            {
                                "target_lang_word": "препятствовать",
                                "target_lang_sense_clarification": "создавать помехи для действия"
                            },
                            {
                                "target_lang_word": "тормозить",
                                "target_lang_sense_clarification": "замедлять процесс"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "19ffea9e-6023-3146-af79-5bc2cd7d8630",
                    "sense_definition": "To formally forbid or prohibit, especially in a legal or ecclesiastical context.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "legal_prohibition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The court may <w>inhibit</w> the publication of sensitive documents to protect the privacy of the individuals involved.",
                            "target_lang_translations": {
                                "ru": "Суд может <w>запретить</w> публикацию конфиденциальных документов для защиты частной жизни вовлеченных лиц."
                            }
                        },
                        {
                            "text": "The decree was issued to <w>inhibit</w> the priest from performing any further official duties.",
                            "target_lang_translations": {
                                "ru": "Указ был издан, чтобы <w>воспретить</w> священнику дальнейшее исполнение любых официальных обязанностей."
                            }
                        }
                    ],
                    "synonyms": [
                        "prohibit",
                        "forbid",
                        "interdict"
                    ],
                    "antonyms": [
                        "allow",
                        "permit",
                        "authorize"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Used in formal or legal contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Официально запрещать, особенно в юридическом или церковном контексте."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запрещать",
                                "target_lang_sense_clarification": "официальный запрет"
                            },
                            {
                                "target_lang_word": "налагать запрет",
                                "target_lang_sense_clarification": "юридическое ограничение"
                            },
                            {
                                "target_lang_word": "воспрещать",
                                "target_lang_sense_clarification": "строгий формальный запрет"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}