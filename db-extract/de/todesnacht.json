                    {
                        "sense_id": "7eb346dd-d561-37c7-a3d3-7c89bd0e4ea6",
                        "entry_id": "52d531d7-0f06-3d7f-90be-c4e02bde8e27",
                        "glosses": [
                            "diejenige Nacht, in der jemand oder etwas stirbt, gestorben ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "280d86cf-090b-48a8-b7e0-7deff626defa",
                                "sense_id": "7eb346dd-d561-37c7-a3d3-7c89bd0e4ea6",
                                "text": "In der Todesnacht des Königs durchbrachen die Belagerer die Verteidigungslinien."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1baac296-8d3f-3e1f-ba50-de87c98856de",
                        "entry_id": "52d531d7-0f06-3d7f-90be-c4e02bde8e27",
                        "glosses": [
                            "eine fürchterliche Nacht, die an den finsteren Tod erinnert; eine Nacht, in der man dem Tode nahekommt"
                        ],
                        "tags": [
                            "outdated",
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "3fc442d0-28c3-4bee-a43f-cfc42fae02eb",
                                "sense_id": "1baac296-8d3f-3e1f-ba50-de87c98856de",
                                "text": "„Es schmachteten in finst’rer Todesnacht, Gefesselt von des Elends Eisenketten, Die nicht auf Gottes Worte hatten Acht, Des Hocherhabenen Gesetz verschmähten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
