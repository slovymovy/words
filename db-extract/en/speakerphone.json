                        "source_entry_id": "21b9096e-61b8-3a12-9ec5-12243646dfe9",
                        "source_sense_description": "telephone with a microphone and loudspeaker separate from those in the handset",
                        "target_lang_word": "Freisprechanlage",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Freisprechanlage",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5a49656b-38e5-3b73-9b51-d726e934d029",
                                        "entry_id": "6ce3a447-7054-39a7-8555-541fb114d1f9",
                                        "glosses": [
                                            "technische Vorrichtung mit Mikrofon und Lautsprecher (besonders in Autos beim Fahren), mit dessen Hilfe man telefonieren kann, ohne das Handy oder Telefon in die Hand nehmen zu müssen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99c98d63-4440-4a71-b4a0-c546daa442c8",
                                                "sense_id": "5a49656b-38e5-3b73-9b51-d726e934d029",
                                                "text": "Um im Auto telefonieren zu können, wird eine Freisprechanlage benötigt."
                                            },
                                            {
                                                "example_id": "e3e7af1d-081e-45c4-ba80-8bc01d510775",
                                                "sense_id": "5a49656b-38e5-3b73-9b51-d726e934d029",
                                                "text": "„Das Telefonieren während der Fahrt ist ausschließlich mit Freisprechanlage erlaubt.“"
                                            },
                                            {
                                                "example_id": "be5b4e7e-df67-4954-8762-a780ee218405",
                                                "sense_id": "5a49656b-38e5-3b73-9b51-d726e934d029",
                                                "text": "„Meist benutzte er die Freisprechanlage, doch gelegentlich nahm er das Telefon in die Hand und besprach Privates.“"
                                            },
                                            {
                                                "example_id": "8c246010-d7cb-4bb4-9d17-640cfaa2d094",
                                                "sense_id": "5a49656b-38e5-3b73-9b51-d726e934d029",
                                                "text": "„Vogt nahm den Anruf nicht über die Freisprechanlage entgegen, sondern nahm das Handy ans Ohr, obwohl das eigentlich nicht den Vorschriften entsprach.“"
                                            },
                                            {
                                                "example_id": "5f8d3b38-f64a-47a8-855d-42e29d42f319",
                                                "sense_id": "5a49656b-38e5-3b73-9b51-d726e934d029",
                                                "text": "„Grollend betätigt er einen Knopf am Lenkrad und empfängt das Gespräch über die Freisprechanlage.“"
                                            },
                                            {
                                                "example_id": "77f662e6-1288-4546-ae3b-7d30f0170fde",
                                                "sense_id": "5a49656b-38e5-3b73-9b51-d726e934d029",
                                                "text": "„Ich halte die Luft an, während es über die Freisprechanlage meines Wagens klingelt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b85bb5e4-1b35-4c07-a4d0-8eb883def3cb",
                        "source_entry_id": "21b9096e-61b8-3a12-9ec5-12243646dfe9",
                        "source_sense_description": "telephone with a microphone and loudspeaker separate from those in the handset",
                        "target_lang_word": "Freisprecheinrichtung",
