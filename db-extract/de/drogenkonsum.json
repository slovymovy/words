                ],
                "senses": [
                    {
                        "sense_id": "5416299e-d093-3c13-af97-219102bf5ade",
                        "entry_id": "7e2ba8de-3bf9-31f1-b027-817a609938bd",
                        "glosses": [
                            "das Einnehmen von (illegalen) Drogen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1a1a2f2-ce4e-489c-a1c1-c9b8bbb58946",
                                "sense_id": "5416299e-d093-3c13-af97-219102bf5ade",
                                "text": "„Die Staatsanwaltschaft ordnete eine Blutentnahme zur Überprüfung auf Alkohol- und Drogenkonsum an.“"
                            },
                            {
                                "example_id": "b27abbc2-8c3a-446c-8659-9c3c271128c5",
                                "sense_id": "5416299e-d093-3c13-af97-219102bf5ade",
                                "text": "„Einer dieser Glückritter war der französische Dichter Arthur Rimbaud, berüchtigt für hemmungslosen Freiheitsdrang, Drogenkonsum und sexuelle Eskapaden.“"
                            },
                            {
                                "example_id": "85c47fae-d9e2-4f00-9265-2aec4f9e7fcc",
                                "sense_id": "5416299e-d093-3c13-af97-219102bf5ade",
                                "text": "„Die 315 Textsegmente stellen kein Vademecum des Drogenkonsums dar, vielmehr nutzt Jünger unentwegt das Thema zu Einschüben und Exkursen literarischer und biographischer, kulturkritischer und philosophischer Art.“"
                            },
                            {
                                "example_id": "5f0ebfc0-7fb3-47bf-9bc0-3ddd3f50bdf0",
                                "sense_id": "5416299e-d093-3c13-af97-219102bf5ade",
                                "text": "„Es klingt banal, aber es ist anscheinend der einzig richtige Weg, Jugendliche vor dem ersten Drogenkonsum von der Gefährlichkeit der Sucht zu überzeugen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
