                        "form": "arcures"
                    },
                    {
                        "form_id": "83ae23df-2c49-49a5-954f-6ead014f09a2",
                        "entry_id": "bbe753fa-6f9e-3c78-9f89-1a08e97ba962",
                        "tags": [],
                        "form": "arqûre"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2ba9b25e-afb1-3848-bd2f-a7c28d10c29c",
                        "entry_id": "bbe753fa-6f9e-3c78-9f89-1a08e97ba962",
                        "glosses": [
                            "Forme d’arc ou de cintre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ccb51adc-54d8-4203-bef9-dfd0367cde2b",
                                "sense_id": "2ba9b25e-afb1-3848-bd2f-a7c28d10c29c",
                                "text": "Pour qu’elle fût sympathique, il y avait en Mme de Ferjol quelque chose de trop impérieux, de trop despotique, de trop romain, jusque dans son buste de matrone, dans la fière arcure de son profil, et dans cette masse de cheveux noirs largement empâtés de blanc sur des tempes qu’ils rendaient plus austères et presque cruelles…."
                            }
                        ]
                    },
                    {
                        "sense_id": "50a42f66-86a8-359f-923b-9748ecb7b9bf",
                        "entry_id": "bbe753fa-6f9e-3c78-9f89-1a08e97ba962",
                        "glosses": [
                            "Opération consistant à courber en demi-cercle, l'extrémité inclinée vers le sol, une branche, un rameau, un sarment afin qu’il produise davantage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f3af636-ce96-4a11-9b6a-95471c7d4d71",
                                "sense_id": "50a42f66-86a8-359f-923b-9748ecb7b9bf",
                                "text": "L’arcure est un procédé de mise à fruit qui rend de véritables services à l’arboriculture fruitière; aussi elle ne manque pas de partisans."
                            }
                        ]
                    },
                    {
                        "sense_id": "7fc28c65-0a00-3f12-939a-b6c73243a8af",
                        "entry_id": "bbe753fa-6f9e-3c78-9f89-1a08e97ba962",
                        "glosses": [
                            "Déformation structurelle d’un navire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e5f8739-491a-49a0-9f2f-18843c9aaa55",
                                "sense_id": "7fc28c65-0a00-3f12-939a-b6c73243a8af",
                                "text": "Mais l’arcure que l’on remarque du côté de tribord du navire et par le travers de ses grands porte-haubans, laisse craindre que ce beau bâtiment n’ait éprouvé de grandes avaries, dans les fortes secousses qu'il a essuyées."
                            }
                        ]
                    },
                    {
                        "sense_id": "c732e8a5-259b-3062-9b80-7f33e84d0df6",
                        "entry_id": "bbe753fa-6f9e-3c78-9f89-1a08e97ba962",
                        "glosses": [
                            "Déviation du carpe chez les équidés ou les bovins."
                        ],
                        "tags": [
                            "Médecine vétérinaire"
                        ],
                        "examples": [
                            {
                                "example_id": "7b39ef78-f712-49ee-8fa8-9cfd894809a0",
                                "sense_id": "c732e8a5-259b-3062-9b80-7f33e84d0df6",
                                "text": "L’arcure est une déviation du genou (carpe) en avant de la ligne d’aplomb du membre thoracique, liée à une obliquité des rayons de l’avant-bras et du canon."
                            }
                        ]
                    },
                    {
                        "sense_id": "4b9c7001-a41e-3712-9911-64e54c533cec",
                        "entry_id": "bbe753fa-6f9e-3c78-9f89-1a08e97ba962",
                        "glosses": [
                            "Défaut d’un canon entrainant une courbure entre l’âme et la bouche à feu."
                        ],
                        "tags": [
                            "Armement"
                        ],
                        "examples": []
                    }
                ],
