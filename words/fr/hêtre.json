                    "frequency": "Middle",
                    "semantic_group_id": "matière",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette table robuste a été entièrement fabriquée en bois de <w>hêtre</w> massif."
                        },
                        {
                            "text": "Le <w>hêtre</w> est couramment utilisé en menuiserie pour fabriquer des meubles et des parquets résistants."
