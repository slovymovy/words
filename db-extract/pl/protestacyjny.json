                            {
                                "example_id": "aa752112-0744-49f7-98e6-8c708558a268",
                                "sense_id": "e046ad5a-836b-3634-a2fa-85e7c7b0f82a",
                                "text": "Powstał już komitet protestacyjny, z którym spotkał się również pan burmistrz"
                            },
                            {
