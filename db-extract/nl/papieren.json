                        ],
                        "examples": [
                            {
                                "example_id": "f97e77db-3049-4c37-9ae8-da3e5052f35e",
                                "sense_id": "36b6a1e6-b1e9-3f47-8916-1cf4cc24f13f",
                                "text": "Doordat ik meer en meer dingen las, en ik meer en meer gelijkenissen zag begon zelfs mijn hart veel sneller te slaan, begonnen ik te trillen en volledig te papieren."
                            },
                            {
                                "example_id": "80e2739a-63b1-4de2-be87-5fa796602b59",
                                "sense_id": "36b6a1e6-b1e9-3f47-8916-1cf4cc24f13f",
                                "text": "Wil-je niet brave zijn, 'k ga-je papieren!"
                            }
                        ]
