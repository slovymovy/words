                ],
                "senses": [
                    {
                        "sense_id": "2bbae3f8-514f-3c01-9d09-0f032502c33e",
                        "entry_id": "010ca8bf-fc74-311c-955c-d9e39dc04745",
                        "glosses": [
                            "kleines, dünnes Heft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "acf3cd16-aa8b-40b6-8bcf-b39399b1c9fe",
                                "sense_id": "2bbae3f8-514f-3c01-9d09-0f032502c33e",
                                "text": "„In feierlich hohem Bogen legte sie der neuen Genossin das rote Heftchen in die Hände.“"
                            },
                            {
                                "example_id": "a34a3826-eb50-422b-b89d-40bae1800464",
                                "sense_id": "2bbae3f8-514f-3c01-9d09-0f032502c33e",
                                "text": "„Sie öffnete eine Schublade, nahm Briefmarken aus einem Heftchen und gab sie mir, und ich klebte zwei auf den Umschlag.“"
                            },
                            {
                                "example_id": "e7e6a820-e208-4386-a5cb-ada18cf24736",
                                "sense_id": "2bbae3f8-514f-3c01-9d09-0f032502c33e",
                                "text": "„Für die Menschen der Epoche indessen waren die Einblattdrucke, die Heftchen mit zwei oder drei Liedern, die Broschüren mit zwei oder drei Dutzend davon und die mehrbändigen Sammlungen wichtig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
