                                    {
                                        "sense_id": "34a1b468-3d12-3910-84c8-37c576fcad5d",
                                        "entry_id": "7eecf727-4ae2-3c29-9f7c-db5b45723ca5",
                                        "glosses": [
                                            "Vomit."
                                        ],
                                        "tags": [
                                            "Australia",
