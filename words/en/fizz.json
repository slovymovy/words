{
    "word_family": [
        "fizzy",
        "fizzily",
        "fizziness"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4cfb81e8-18b6-31af-b75e-3944b9c92464",
                    "sense_definition": "To produce small bubbles of gas; to effervesce.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bubble_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mineral water began to <w>fizz</w> as soon as the bottle was opened.",
                            "target_lang_translations": {
                                "de": "Das Mineralwasser begann zu <w>sprudeln</w>, sobald die Flasche geöffnet wurde."
                            }
                        },
                        {
                            "text": "The tablet started to <w>fizz</w> violently in the glass of water.",
                            "target_lang_translations": {
                                "de": "Die Tablette fing im Wasserglas heftig an zu <w>brausen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "bubble",
                        "effervesce"
                    ],
                    "common_phrases": [
                        "fizz up"
                    ],
                    "target_lang_definitions": {
                        "de": "Kleine Gasbläschen bilden; aufschäumen oder moussieren."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "sprudeln",
                                "target_lang_sense_clarification": "Gasbläschen in Flüssigkeit bilden"
                            },
                            {
                                "target_lang_word": "zischen",
                                "target_lang_sense_clarification": "unter Bläschenbildung und Geräusch schäumen"
                            },
                            {
                                "target_lang_word": "brausen",
                                "target_lang_sense_clarification": "durch Gasbildung aufschäumen (z. B. Brausetabletten)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d99b620a-0d5e-3499-8fe5-edea556899ca",
                    "sense_definition": "To make a continuous hissing or bubbling sound.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sound_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We listened to the fuse <w>fizz</w> before the fireworks erupted into light.",
                            "target_lang_translations": {
                                "de": "Wir lauschten dem <w>Zischen</w> der Zündschnur, bevor das Feuerwerk in hellem Licht erstrahlte."
                            }
                        },
                        {
                            "text": "The sparklers began to <w>fizz</w> and crackle in the night air.",
                            "target_lang_translations": {
                                "de": "Die Wunderkerzen fingen an, in der Nachtluft zu <w>sprühen</w> und zu knistern."
                            }
                        }
                    ],
                    "synonyms": [
                        "hiss",
                        "sizzle",
                        "sputter"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein anhaltendes zischendes oder blubberndes Geräusch von sich geben."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "zischen",
                                "target_lang_sense_clarification": "ein zischendes Geräusch machen"
                            },
                            {
                                "target_lang_word": "brizzeln",
                                "target_lang_sense_clarification": "knistern oder leise zischen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e82dc4a6-dca5-3a1e-b183-f47b84205f5d",
                    "sense_definition": "To move or travel with great speed and often a hissing sound.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The striker saw the ball <w>fizz</w> past the post into the crowd.",
                            "target_lang_translations": {
                                "de": "Der Stürmer sah, wie der Ball am Pfosten vorbei in die Menge <w>zischte</w>."
                            }
                        },
                        {
                            "text": "He watched the puck <w>fizz</w> across the ice toward the empty net.",
                            "target_lang_translations": {
                                "de": "Er sah zu, wie der Puck über das Eis auf das leere Tor zu <w>sauste</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Sich mit hoher Geschwindigkeit und oft mit einem zischenden Geräusch bewegen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "zischen",
                                "target_lang_sense_clarification": "sich rasant und pfeifend/zischend fortbewegen"
                            },
                            {
                                "target_lang_word": "sausen",
                                "target_lang_sense_clarification": "sehr schnell fliegen oder gleiten"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b6f4a53e-fce5-3512-9c81-4e37ee564ca2",
                    "sense_definition": "The mass or stream of small bubbles formed in a liquid.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bubble_thing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She poured a fresh soda and waited for the <w>fizz</w> to settle down.",
                            "target_lang_translations": {
                                "de": "Sie goss eine frische Limonade ein und wartete, bis sich der <w>Schaum</w> gelegt hatte."
                            }
                        },
                        {
                            "text": "If you leave the bottle uncapped, the drink will lose its <w>fizz</w>.",
                            "target_lang_translations": {
                                "de": "Wenn du die Flasche offen lässt, verliert das Getränk seine <w>Kohlensäure</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "effervescence",
                        "foam",
                        "froth"
                    ],
                    "common_phrases": [
                        "lose its fizz"
                    ],
                    "target_lang_definitions": {
                        "de": "Kohlensäure oder die aufsteigenden Gasbläschen in einer Flüssigkeit."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "die Kohlensäure",
                                "target_lang_sense_clarification": "Gasgehalt in Getränken (Spritzigkeit)"
                            },
                            {
                                "target_lang_word": "der Schaum",
                                "target_lang_sense_clarification": "Schicht aus aufsteigenden Blasen"
                            },
                            {
                                "target_lang_word": "das Sprudeln",
                                "target_lang_sense_clarification": "das Aufsteigen von Bläschen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "46b8b2d6-ba9b-31d1-a4e3-9be49ca4e381",
                    "sense_definition": "A hissing or crackling sound produced by escaping bubbles.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sound_thing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He relaxed on the deck and listened to the gentle <w>fizz</w> of the waves.",
                            "target_lang_translations": {
                                "de": "Er entspannte sich auf dem Deck und lauschte dem sanften <w>Rauschen</w> der Wellen."
                            }
                        },
                        {
                            "text": "The soft <w>fizz</w> of the champagne was audible across the quiet room.",
                            "target_lang_translations": {
                                "de": "Das leise <w>Prickeln</w> des Champagners war im ganzen stillen Raum zu hören."
                            }
                        }
                    ],
                    "synonyms": [
                        "hiss",
                        "sputter"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein leises zischendes oder knisterndes Geräusch entweichender Gasbläschen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "das Zischen",
                                "target_lang_sense_clarification": "Geräusch entweichender Kohlensäure oder Luft"
                            },
                            {
                                "target_lang_word": "das Prickeln",
                                "target_lang_sense_clarification": "leises Knistern von Gasbläschen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7fd9ca4f-5286-38e7-96cb-b4528fe590b3",
                    "sense_definition": "A carbonated beverage, such as sparkling wine or a cocktail with soda.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "beverage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They ordered two glasses of <w>fizz</w> to celebrate their anniversary.",
                            "target_lang_translations": {
                                "de": "Sie bestellten zwei Gläser <w>Sekt</w>, um ihr Jubiläum zu feiern."
                            }
                        },
                        {
                            "text": "The bartender prepared a refreshing gin <w>fizz</w> for the customer.",
                            "target_lang_translations": {
                                "de": "Der Barkeeper bereitete einen erfrischenden Gin <w>Fizz</w> für den Gast zu."
                            }
                        }
                    ],
                    "synonyms": [
                        "pop",
                        "seltzer",
                        "soda"
                    ],
                    "common_phrases": [
                        "gin fizz",
                        "glass of fizz"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used casually for sparkling wine or specific mixed drinks"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein kohlensäurehaltiges Getränk wie Schaumwein, Sekt oder ein bestimmter Cocktail mit Sodawasser."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "der Sekt",
                                "target_lang_sense_clarification": "Schaumwein (umgangssprachlich)"
                            },
                            {
                                "target_lang_word": "der Schaumwein",
                                "target_lang_sense_clarification": "kohlensäurehaltiger Wein"
                            },
                            {
                                "target_lang_word": "der Fizz",
                                "target_lang_sense_clarification": "Cocktailart mit Zitrone und Sodawasser"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}