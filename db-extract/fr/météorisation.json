                                        "entry_id": "40f80424-cb52-3d22-a126-3d30fd4f5fbe",
                                        "glosses": [
                                            "van gesteente is het natuurlijke proces waarbij dit materiaal verandert als gevolg van invloeden van weer en klimaat, zogeheten exogene krachten, tijdens dit proces blijft het materiaal op dezelfde plaats"
                                        ],
                                        "tags": [],
                                        "examples": [
