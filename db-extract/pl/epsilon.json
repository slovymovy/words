                                        "examples": [
                                            {
                                                "example_id": "735c12ec-0642-4f9b-a3a9-34d759443552",
                                                "sense_id": "07ff6269-892e-3413-97d3-0eb35de2189a",
                                                "text": "La moyenne des epsilons calculés pour chaque procédure est supérieure à 0,75."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50019803-4160-3bdc-9d34-1b03abf0cb30",
                                        "entry_id": "e4922ce3-4542-3a5b-a12a-35fb57a70d95",
                                        "glosses": [
