        "fr-extract.jsonl": [
            {
                "entry_id": "0f2e1b53-508f-3370-b61a-6ad5e6eb52e2",
                "word": "anti",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "148ccb8e-b2cd-33aa-9405-9083831fbe22",
                        "entry_id": "0f2e1b53-508f-3370-b61a-6ad5e6eb52e2",
                        "glosses": [
                            "Personne opposée ou hostile à un projet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a29bc74-4c3a-483a-8c98-c235cd96d00b",
                                "sense_id": "148ccb8e-b2cd-33aa-9405-9083831fbe22",
                                "text": "On ne soumet pas la liberté à l’épreuve ; celui qui a l’impression de ne pas être libre, celui qui croit qu’il n’est pas libre, celui-là est un anti."
                            },
                            {
                                "example_id": "edeb77e0-df2b-4a45-bf3a-a36840c67eda",
                                "sense_id": "148ccb8e-b2cd-33aa-9405-9083831fbe22",
                                "text": "Sur le non-cumul, pro et anti jouent la surenchère"
                            },
                            {
                                "example_id": "b3a898be-85bc-4e8b-a407-78f2f5d50180",
                                "sense_id": "148ccb8e-b2cd-33aa-9405-9083831fbe22",
                                "text": "Mariage homo : les arguments des pros et des antis devant les Sages"
                            },
                            {
                                "example_id": "ad187464-245b-4501-b2c7-3b78e9ca5e4e",
                                "sense_id": "148ccb8e-b2cd-33aa-9405-9083831fbe22",
                                "text": "Mariage gay : la mobilisation des antis ne faiblit pas."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "14fc32a6-140d-450d-b1a2-005c853e2f39",
                        "source_entry_id": "0f2e1b53-508f-3370-b61a-6ad5e6eb52e2",
                        "source_sense_id": "148ccb8e-b2cd-33aa-9405-9083831fbe22",
                        "source_sense_description": "Personne opposée ou hostile",
                        "target_lang_word": "anti",
