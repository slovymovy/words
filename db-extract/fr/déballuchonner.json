                ],
                "senses": [
                    {
                        "sense_id": "97e74c14-29f7-3655-b53a-9149c70305e6",
                        "entry_id": "1406db50-b1c5-32c9-bf00-ed89762e0996",
                        "glosses": [
                            "Rendre un objet qui avait été balluchonné, pour le rendre à nouveau utilisable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd179f05-df9e-42cb-af2e-79c1ba6b79b6",
                                "sense_id": "97e74c14-29f7-3655-b53a-9149c70305e6",
                                "text": "Si j'ai bien compris, pour gratter \"en sécurité\", je vais devoir déballuchonner mes compos avec une première dla, déballuchonner mon parcho (2Pa), gratter (3Pa) et reballuchonner (1Pa) avec une seconde dla."
                            },
                            {
                                "example_id": "b098b6ad-3da8-4e22-854f-8c09a99a3e95",
                                "sense_id": "97e74c14-29f7-3655-b53a-9149c70305e6",
                                "text": "Compétence de niveau 1 et un coût de 1 PA (+1 PA pour déballuchonner)"
                            },
                            {
                                "example_id": "658170f9-e734-4739-8608-4c8c00924111",
                                "sense_id": "97e74c14-29f7-3655-b53a-9149c70305e6",
                                "text": "Il est possible de lancer une potion sans la déballuchonner, mais on ne peut utiliser une potion balluchonnée."
                            }
                        ]
                    }
                ],
