                "senses": [
                    {
                        "sense_id": "d0e31c26-87b4-37e7-bf80-6436d747e962",
                        "entry_id": "d7207497-a305-31dd-bc0d-8f68f2827a5b",
                        "glosses": [
                            "kriminelle Organisation, die Menschenschlepperei betreibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "778eb821-aed2-4f52-bc8b-50cc5cb4eedf",
                                "sense_id": "d0e31c26-87b4-37e7-bf80-6436d747e962",
                                "text": "„Nach dem grausigen Fund von 71 toten Flüchtlingen in einem LKW suchen die Ermittler nach den Hintermännern des Schleusernetzwerkes. Vier Verdächtige, die einem bulgairsch-ungarischem Schlepperring angehören sollen, werden derzeit in Belgrad vernommen.“"
                            },
                            {
                                "example_id": "b966e7ca-c9ba-4889-8d96-1f1120a20cc3",
                                "sense_id": "d0e31c26-87b4-37e7-bf80-6436d747e962",
                                "text": "„Der Polizei ist ein Schlag gegen einen Schlepperring gelungen, der hunderte Menschen aus der Türkei via Rumänien nach Österreich, Deutschland und Spanien geschmuggelt haben soll.“"
                            },
                            {
                                "example_id": "eb6eded7-1c19-4017-a3da-cb1520d55b1c",
                                "sense_id": "d0e31c26-87b4-37e7-bf80-6436d747e962",
                                "text": "„Gegen den Schlepperring, der vermutlich auch den Transport von 64 Kurden in Kühltransportern organisiert hatte, die auf der A2 bei Zöbern gestoppt worden waren […], ist der Exekutive nun ein erfolgreicher Schlag geglückt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
