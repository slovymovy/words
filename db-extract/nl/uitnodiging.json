                "senses": [
                    {
                        "sense_id": "b35e0420-294b-3e4f-bcd4-ccb22f7af5ec",
                        "entry_id": "d6cacea2-b82a-30c1-9b88-8d4e8a2c87eb",
                        "glosses": [
                            "een verzoek om iets bij te wonen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "deab23d2-b5d6-4fc7-9999-a0ff609d0e67",
                                "sense_id": "b35e0420-294b-3e4f-bcd4-ccb22f7af5ec",
                                "text": "Hij had uitnodigingen voor het feest aan zijn beste vrienden gestuurd."
                            },
                            {
                                "example_id": "f2e4003d-07aa-414d-b335-4171261e4cac",
                                "sense_id": "b35e0420-294b-3e4f-bcd4-ccb22f7af5ec",
                                "text": "Met haar metalen golfplaten dak leek deze plek me niet geschikt om bescherming te bieden, eerder een uitnodiging aan de bliksem om in te slaan."
                            },
                            {
                                "example_id": "90948dd8-8303-468e-8539-c2d9f008255e",
                                "sense_id": "b35e0420-294b-3e4f-bcd4-ccb22f7af5ec",
                                "text": "Hij kwam overeind met de uitnodigingen in zijn hand, liep naar het haardvuur en legde ze keurig boven op het brandende blok berkenhout."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6fa4981b-b44a-401f-9750-b7492ec2e25d",
                        "source_entry_id": "d6cacea2-b82a-30c1-9b88-8d4e8a2c87eb",
                        "source_sense_id": "b35e0420-294b-3e4f-bcd4-ccb22f7af5ec",
                        "source_sense_description": "een verzoek om iets bij te wonen",
                        "target_lang_word": "Einladung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Einladung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "340ca763-d46c-3a1e-8652-003c182dcd5b",
                                        "entry_id": "91a2add4-be0b-34d5-86ce-66fd2650b1b2",
                                        "glosses": [
                                            "Angebot (schriftlich oder mündlich) etwas zu essen/trinken oder zu jemandem zu kommen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ef6d3cc-765a-4b8f-9f11-7acc27017f03",
                                                "sense_id": "340ca763-d46c-3a1e-8652-003c182dcd5b",
                                                "text": "Ich schreibe die Einladungen für meine Geburtstagsfeier."
                                            },
                                            {
                                                "example_id": "8ca268cd-85f8-425b-a706-9834e83e8945",
                                                "sense_id": "340ca763-d46c-3a1e-8652-003c182dcd5b",
                                                "text": "„Die Einladung habe ich den Biologen von Nuuk Basic zu verdanken, einem Freiluftlabor eine halbe Stunde südlich der Hauptstadt.“"
                                            },
                                            {
                                                "example_id": "2c75dc6e-b41e-405b-85be-759c03a61e84",
                                                "sense_id": "340ca763-d46c-3a1e-8652-003c182dcd5b",
                                                "text": "„Marie weigerte sich zunächst, die Einladung nach Nonnenwerth anzunehmen.“"
                                            },
                                            {
                                                "example_id": "240f92c7-1a05-4a67-8883-54176ba64fd6",
                                                "sense_id": "340ca763-d46c-3a1e-8652-003c182dcd5b",
                                                "text": "„Der Sozialdemokrat Peter Glotz nahm einst meine Einladung an.“"
                                            },
                                            {
                                                "example_id": "0be54563-bcee-403c-92d4-0316aba4e4ad",
                                                "sense_id": "340ca763-d46c-3a1e-8652-003c182dcd5b",
                                                "text": "„In diesem Brief erklärte er dem vorbereitenden Fünfzigerausschuss, warum er die Einladung zur Mitwirkung bei der Vorbereitung einer deutschen Nationalversammlung zurückweisen müsse.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "02f083aa-33bf-3f45-baf2-0893457bad1f",
                                        "entry_id": "91a2add4-be0b-34d5-86ce-66fd2650b1b2",
                                        "glosses": [
                                            "Einlagerung in einen Bereich oder Raum"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a3801cc-5b9a-46a7-9ce7-c08cd42fc2f3",
                                                "sense_id": "02f083aa-33bf-3f45-baf2-0893457bad1f",
                                                "text": "Die Einladung der Kohle in den Keller musste über die Kellerfenster erfolgen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3803a740-6f3b-4efa-bdb3-e59c14dc600d",
                        "source_entry_id": "d6cacea2-b82a-30c1-9b88-8d4e8a2c87eb",
