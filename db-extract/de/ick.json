                                                "sense_id": "25d0408a-8874-36b3-af9b-aacf2d65af20",
                                                "text": "Come with me."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71715a92-8d6c-3e00-8cae-37cde27ef94d",
                                        "entry_id": "c20151ce-7b62-3f4b-bc3e-00053dda1ff2",
