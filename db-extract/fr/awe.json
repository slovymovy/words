                "word": "awe",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b2ab91c5-4f0a-3b9b-ab8a-bc59636899bc",
                        "entry_id": "1b227521-4189-3ddf-8e71-8516ce327015",
                        "glosses": [
                            "Stupéfaction mêlée de crainte et de révérence, effroi, intimidation."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "7e7af109-438d-4f8e-9fa5-cebaf54ed1a0",
                                "sense_id": "b2ab91c5-4f0a-3b9b-ab8a-bc59636899bc",
                                "text": "Comment vit-on une expérience qui provoque l’awe ? La réaction est avant tout liée à la personalité de celui qui l’éprouve. Certains adorent. Ils en font, par la suite, le sens de leur vie, la justification de leurs convictions."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4647590f-fd2b-4edb-9adb-099c40304d1a",
                        "source_entry_id": "1b227521-4189-3ddf-8e71-8516ce327015",
                        "source_sense_id": "b2ab91c5-4f0a-3b9b-ab8a-bc59636899bc",
                        "target_lang_word": "awe",
