                                    },
                                    {
                                        "sense_id": "e9ee313f-b164-3bf0-bde7-ea0c88560e55",
                                        "entry_id": "1cfa713c-1787-360b-99ce-f32a03b84c6f",
                                        "glosses": [
                                            "A Muslim, especially one involved in the Crusades."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da0d3e52-5f5c-44f6-8e92-9dad9dae503e",
                                                "sense_id": "e9ee313f-b164-3bf0-bde7-ea0c88560e55",
                                                "text": "We pretend to be Christians, and, from the superior Light we enjoy, ought to exceed Heathens, Turks, Saracens, Moors, Negroes, and Indians, in the Knowledge and Practice of what is right."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f20c561-770e-3849-a8a9-67c21a6499a0",
                                        "entry_id": "1cfa713c-1787-360b-99ce-f32a03b84c6f",
                                        "glosses": [
                                            "A pirate in the Mediterranean."
                                        ],
