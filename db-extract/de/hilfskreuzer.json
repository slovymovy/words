                "senses": [
                    {
                        "sense_id": "dbd13052-ec07-34f4-814d-affd9df53453",
                        "entry_id": "0bfa5647-c8fc-3014-bf6e-71d2319c88f4",
                        "glosses": [
                            "Kriegsschiff, das durch nachträgliche Bewaffnung eines ursprünglich zivilen Schiffes zu einem solchen wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b344a029-aef6-43c4-ae6c-f6a61c5d7071",
                                "sense_id": "dbd13052-ec07-34f4-814d-affd9df53453",
                                "text": "„Mit dem Hilfskreuzer S.M.S. »Seeadler«, zwei Geschütze an Bord, durchstieß er die britische Seeblockade und begab sich auf eine kühne Kaperfahrt quer über die Weltmeere.“"
                            },
                            {
                                "example_id": "9f6f96ba-2384-4b15-bdcb-27a2f247d022",
                                "sense_id": "dbd13052-ec07-34f4-814d-affd9df53453",
                                "text": "„Als Erstes übernahmen wir Proviant, den deutsche Hilfskreuzer auf gekaperten amerikanischen Schiffen nach Singapur oder Penang umgeleitet hatten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
