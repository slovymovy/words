                ],
                "translations": [
                    {
                        "translation_id": "b11b9b0a-354c-4137-b5fb-7b8abdfe2631",
                        "source_entry_id": "61f16c09-d286-3685-be35-53e4598ae402",
                        "source_sense_id": "2fb16036-31dc-3e31-ba07-86e4b1a37741",
                        "target_lang_word": "shame",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shame",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2b42d786-952f-33bf-89bb-941895900c67",
                                        "entry_id": "fe5a13fb-46ee-3896-b752-fde439302135",
                                        "glosses": [
                                            "An uncomfortable or painful feeling due to recognition or consciousness of one's own impropriety or dishonor, or something being exposed that should have been kept private."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7fca657-6704-42c9-a7eb-303a7fac6bf0",
                                                "sense_id": "2b42d786-952f-33bf-89bb-941895900c67",
                                                "text": "When I realized that I had hurt my friend, I felt deep shame."
                                            },
                                            {
                                                "example_id": "8f4aabe5-9031-48fc-93c5-7d69ef37f62b",
                                                "sense_id": "2b42d786-952f-33bf-89bb-941895900c67",
                                                "text": "The teenager couldn’t bear the shame of introducing his parents."
                                            },
                                            {
                                                "example_id": "9633a661-0989-43ed-961e-4abac450d2f9",
                                                "sense_id": "2b42d786-952f-33bf-89bb-941895900c67",
                                                "text": "When he had saied no: what (ſaid Ariſtippus) is it ſhame to ſaile in a Shippe, that hath afoꝛetymes caried a great nomber mo: […]"
                                            },
                                            {
                                                "example_id": "b73b6521-4bbb-4216-81f9-a6a969d65f0c",
                                                "sense_id": "2b42d786-952f-33bf-89bb-941895900c67",
                                                "text": "Have you no modesty, no maiden shame?"
                                            },
                                            {
                                                "example_id": "fbbbd47a-2d10-4877-ac19-ae69207629f2",
                                                "sense_id": "2b42d786-952f-33bf-89bb-941895900c67",
                                                "text": "When this conversation was repeated in detail within the hearing of the young woman in question, and undoubtedly for his benefit, Mr. Trevor threw shame to the winds and scandalized the Misses Brewster then and there by proclaiming his father to have been a country storekeeper."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "169ad37c-49e1-3344-8338-140061ccf3b9",
                                        "entry_id": "fe5a13fb-46ee-3896-b752-fde439302135",
                                        "glosses": [
                                            "Something to regret."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06fcd089-a205-416b-8b1a-ccf7ac0f22db",
                                                "sense_id": "169ad37c-49e1-3344-8338-140061ccf3b9",
                                                "text": "It was a shame not to see the show after driving all that way."
                                            },
                                            {
                                                "example_id": "0d70c4e1-a7fe-4a4f-9350-0ee7fd779265",
                                                "sense_id": "169ad37c-49e1-3344-8338-140061ccf3b9",
                                                "text": "Nor can thy ſhame giue phiſicke to my griefe,"
                                            },
                                            {
                                                "example_id": "4703ada2-33d5-46e0-9ee4-f6d70f272d4b",
                                                "sense_id": "169ad37c-49e1-3344-8338-140061ccf3b9",
                                                "text": "And what you do to me is a shame."
                                            },
                                            {
                                                "example_id": "bc8aee6e-c10e-4323-ae19-60119f0b6ffa",
                                                "sense_id": "169ad37c-49e1-3344-8338-140061ccf3b9",
                                                "text": "But why does it always seem to be / Me lookin' at you, you lookin' at me / It's always the same, it's just a shame, that's all"
                                            },
                                            {
                                                "example_id": "239ce2df-92e0-48fb-84bc-9de097609570",
                                                "sense_id": "169ad37c-49e1-3344-8338-140061ccf3b9",
                                                "text": "Time is running out, so I renounce a spin on a Class 387 for a fast run to Paddington on another Class 800 – a shame as the weather was perfect for pictures. Even so, it's enjoyable – boy, can those trains shift under the wires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f81d8e37-b04f-3fe5-8f9a-792d04555446",
                                        "entry_id": "fe5a13fb-46ee-3896-b752-fde439302135",
                                        "glosses": [
                                            "Reproach incurred or suffered; dishonour; ignominy; derision."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d94ed906-bd0a-4d3c-831b-6a3e11d2586a",
                                                "sense_id": "f81d8e37-b04f-3fe5-8f9a-792d04555446",
                                                "text": "[…] because ye haue borne the shame of the heathen,"
                                            },
                                            {
                                                "example_id": "67bac0a6-ded7-4a6c-a9f5-88d7ad8b5d17",
                                                "sense_id": "f81d8e37-b04f-3fe5-8f9a-792d04555446",
                                                "text": "Honour and shame from no condition rise."
                                            },
                                            {
                                                "example_id": "31ffceeb-7956-4026-b762-1f82ba97d0d8",
                                                "sense_id": "f81d8e37-b04f-3fe5-8f9a-792d04555446",
                                                "text": "And every woe a tear can claim\n Except an erring sister's shame."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64130193-053f-38a1-9fa8-87f0c21d1494",
                                        "entry_id": "fe5a13fb-46ee-3896-b752-fde439302135",
                                        "glosses": [
                                            "The cause or reason of shame; that which brings reproach and ignominy."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec9e1dd6-ef93-4a92-a8c1-dfe2bb85421d",
                                                "sense_id": "64130193-053f-38a1-9fa8-87f0c21d1494",
                                                "text": "guides who are the shame of religion"
                                            },
                                            {
                                                "example_id": "cb2e5981-b8cd-4775-84fe-553e7ceab295",
                                                "sense_id": "64130193-053f-38a1-9fa8-87f0c21d1494",
                                                "text": "Rimmer ducked his body low into his chair, so just his head remained above the table top, and peered past the backs of the examinees in front of him, waiting for the adjudicator to make his move. Waiting for him to leap forward and rip off his flimsy flightsuit, exposing his shame: his illustrated body, Rimmer's cheating frame."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0afda48-3341-3688-92a0-b3e243dbf02f",
                                        "entry_id": "fe5a13fb-46ee-3896-b752-fde439302135",
                                        "glosses": [
                                            "That which is shameful and private, especially private parts."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c1eac6f-d7e3-44f3-bfce-da561c303dee",
                                                "sense_id": "a0afda48-3341-3688-92a0-b3e243dbf02f",
                                                "text": "And he took fig-leaves and sewed (them) together, and made an apron for himself, and covered his shame."
                                            },
                                            {
                                                "example_id": "4f1c64c0-5780-4e1c-a151-24ce61b71aea",
                                                "sense_id": "a0afda48-3341-3688-92a0-b3e243dbf02f",
                                                "text": "She turns to lift her robe, and lays it across her as though she were revealing her shame, as though she were naked."
                                            },
                                            {
                                                "example_id": "8ba1fb55-274b-4425-91c5-23f3aab16512",
                                                "sense_id": "a0afda48-3341-3688-92a0-b3e243dbf02f",
                                                "text": "She didn't even have her handbag, because Zelda had thoughtfully left it in the kitchen along with her clothes. And nobody had even offered her so much as a T-shirt to cover her shame."
                                            },
                                            {
                                                "example_id": "9625b5e5-0283-4d3b-86be-f7f6e02c8073",
                                                "sense_id": "a0afda48-3341-3688-92a0-b3e243dbf02f",
                                                "text": "The trouble started early this morning when Pop was shoving his shirt and vest into his pants so he could cover his shame, as he puts it."
                                            },
                                            {
                                                "example_id": "ae773604-7d81-4a39-b836-c3dfe2f644a1",
                                                "sense_id": "a0afda48-3341-3688-92a0-b3e243dbf02f",
                                                "text": "His genitals lank between his legs, his chin dipped upon his breast, staring down at his shame."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9965c45-b7d9-3a5d-8677-5667eca2ec4c",
                                        "entry_id": "fe5a13fb-46ee-3896-b752-fde439302135",
                                        "glosses": [
                                            "The capacity to be ashamed, inhibiting one from brazen behaviour; due regard for one's own moral conduct and how one is perceived by others; restraint, moderation, decency."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85e7c83c-9d03-442f-8149-d2de4918bd3e",
                                                "sense_id": "e9965c45-b7d9-3a5d-8677-5667eca2ec4c",
                                                "text": "Don't you have any shame?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "shame",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cd0f92a2-a23f-3d4c-9886-4c15be651e4f",
                                        "entry_id": "071f3cc2-3ba3-3899-9edb-d463f2f01469",
                                        "glosses": [
                                            "A cry of admonition for the subject of a speech, either to denounce the speaker or to agree with the speaker's denunciation of some person or matter; often used reduplicated, especially in political debates."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c115ca37-15e9-40b9-ae07-c8d9d8112289",
                                                "sense_id": "cd0f92a2-a23f-3d4c-9886-4c15be651e4f",
                                                "text": "Mr John Golding: One would not realise that it came from the same Government, because in that letter the Under-Secretary states: \"The future of BT's pension scheme is a commercial matter between BT, its workforce, and the trustees of the pensions scheme, and the Government cannot give any guarantees about future pension arrangements.\"\n#*: Mr. Charles R. Morris: Shame."
                                            },
                                            {
                                                "example_id": "da2cda4e-cd7b-4d62-8a83-a14ac86cdf99",
                                                "sense_id": "cd0f92a2-a23f-3d4c-9886-4c15be651e4f",
                                                "text": "[…] the Duke of Dorset charged in the list with \"not known, but supposed forty thousand per year\" (charitable supposition) had when formerly in office only about 3 or £4,000, and has not now, nor when the black list was printed, any office whatever — (Much tumult, and cries of \"shame\" and \"doust the liars\")"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "864b5307-27c7-3105-a265-57410d332704",
                                        "entry_id": "071f3cc2-3ba3-3899-9edb-d463f2f01469",
                                        "glosses": [
                                            "Expressing sympathy."
                                        ],
                                        "tags": [
                                            "South-Africa"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55d397a1-2a7d-4118-ae39-edceb2bebbd9",
                                                "sense_id": "864b5307-27c7-3105-a265-57410d332704",
                                                "text": "Shame, you poor thing, you must be cold!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "shame",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c38a8a57-6649-3e2f-83ae-9320c9a571e2",
                                        "entry_id": "a979894a-9513-322a-9e89-a4508f94fb2c",
                                        "glosses": [
                                            "Feeling shame; ashamed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73b5c8ae-f0c0-4747-9a00-b5ce2653a3d3",
                                                "sense_id": "c38a8a57-6649-3e2f-83ae-9320c9a571e2",
                                                "text": "She says that she doesn't touch them, this is important, sometimes maybe a handshake may make them more shame, that is shy or embarrassed."
                                            },
                                            {
                                                "example_id": "1d3c428d-e826-40df-aecd-93d2892603cd",
                                                "sense_id": "c38a8a57-6649-3e2f-83ae-9320c9a571e2",
                                                "text": "Int.[:] What types of things have you learnt about at AIME, like about yourselves or about others?\nDeon[:] To be confident.\nGreg[:] Yeah be confident. And not be shame…"
                                            },
                                            {
                                                "example_id": "1e44bad0-60ce-4f4a-b240-9f50ed63dcb5",
                                                "sense_id": "c38a8a57-6649-3e2f-83ae-9320c9a571e2",
                                                "text": "Aunty Gracelyn is most famous for her role in developing 'Condoman', the Indigenous superhero whose catchcry and public health message 'don’t be shame be game, use condoms!' became a defining figure of Australia's HIV and AIDS crisis."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "shame",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "514885c3-4588-3fd2-9362-b72416255b50",
                                        "entry_id": "be9709a0-c1c2-32b3-b5fc-3cbb1cde7e43",
                                        "glosses": [
                                            "To cause to feel shame."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9693bcb6-3722-469f-a371-ce46be00ec1a",
                                                "sense_id": "514885c3-4588-3fd2-9362-b72416255b50",
                                                "text": "I was shamed by the teacher's public disapproval."
                                            },
                                            {
                                                "example_id": "e8b6eed9-abc6-40d7-8911-ae9dab6dbe11",
                                                "sense_id": "514885c3-4588-3fd2-9362-b72416255b50",
                                                "text": "Were there but one righteous in the world, he would[…]shame the world, and not the world him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3372e41d-3206-3db6-88d8-b204f9b7ab42",
                                        "entry_id": "be9709a0-c1c2-32b3-b5fc-3cbb1cde7e43",
                                        "glosses": [
                                            "To cover with reproach or ignominy; to dishonor; to disgrace."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1966b983-df58-4786-84fa-ce1d569faef1",
                                                "sense_id": "3372e41d-3206-3db6-88d8-b204f9b7ab42",
                                                "text": "And with fowle cowardize his carcas ſhame,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "01a8e6da-8f2b-33bd-b830-2b85cc7d483f",
                                        "entry_id": "be9709a0-c1c2-32b3-b5fc-3cbb1cde7e43",
                                        "glosses": [
                                            "To denounce as having done something shameful; to criticize with the intent or effect of causing a feeling of shame."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b8b5eb3-b235-4fee-b409-0d899f5ac92f",
                                                "sense_id": "01a8e6da-8f2b-33bd-b830-2b85cc7d483f",
                                                "text": "Stop shaming others about their food choices."
                                            },
                                            {
                                                "example_id": "71e4debc-80e7-43ea-8636-e1e807f5ce75",
                                                "sense_id": "01a8e6da-8f2b-33bd-b830-2b85cc7d483f",
                                                "text": "It is disgraceful that you should be used by adults for the purpose of trying to shame us because our extraction of timber from our forests."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe9af164-5a59-34a5-bff0-77e95bf1f3c4",
                                        "entry_id": "be9709a0-c1c2-32b3-b5fc-3cbb1cde7e43",
                                        "glosses": [
                                            "To drive or compel by shame."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78e338bb-29e8-4e97-ab96-9c1ffa1688de",
                                                "sense_id": "fe9af164-5a59-34a5-bff0-77e95bf1f3c4",
                                                "text": "The politician was shamed into resigning."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "027d427b-f1b4-3f3f-b47c-99a71ee237d5",
                                        "entry_id": "be9709a0-c1c2-32b3-b5fc-3cbb1cde7e43",
                                        "glosses": [
                                            "To feel shame, be ashamed."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8eca9bb-29b6-4d9d-9d7a-47376a287533",
                                                "sense_id": "027d427b-f1b4-3f3f-b47c-99a71ee237d5",
                                                "text": "Broder she said I can not telle yow For it was not done by me nor by myn assente\n For he is my lord and I am his\n and he must be myn husband\n therfore my broder I wille that ye wete I shame me not to be with hym\n nor to doo hym alle the pleasyr that I can"
                                            },
                                            {
                                                "example_id": "506a7a10-4647-4513-ab9a-2812444e18fe",
                                                "sense_id": "027d427b-f1b4-3f3f-b47c-99a71ee237d5",
                                                "text": "I do ſhame to thinke of what a noble ſtraine you are, and of how coward a ſpirit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bbf93bc9-0274-3e5f-addb-f502cc844d84",
                                        "entry_id": "be9709a0-c1c2-32b3-b5fc-3cbb1cde7e43",
                                        "glosses": [
                                            "To mock at; to deride."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2cdaf0e3-e55c-47b7-af4b-5184163b698d",
                                                "sense_id": "bbf93bc9-0274-3e5f-addb-f502cc844d84",
                                                "text": "Ye have shamed the counsel of the poor, because the Lord is his refuge."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c48f504c-5c5e-4e4d-9904-ad34fed222c0",
                        "source_entry_id": "61f16c09-d286-3685-be35-53e4598ae402",
                        "source_sense_id": "2fb16036-31dc-3e31-ba07-86e4b1a37741",
                        "target_lang_word": "infamy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "infamy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "07072305-e6cf-3d55-a0d4-31d005bffa28",
                                        "entry_id": "aae81add-5522-388b-a28d-16c541b26209",
                                        "glosses": [
                                            "The state of being infamous."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cddc789d-fb3e-475f-8d7d-b2422235a8a2",
                                                "sense_id": "07072305-e6cf-3d55-a0d4-31d005bffa28",
                                                "text": "... but the cars of chaste women have either coverings thrown over them, or white sheets hung over; for instance, on the cars of the female part of the family of the deceased Nawabs Khanduran and Muzaffar Khan, there used generally to be fastened thick dirty white cloths, and in like manner also on their palanquins—although one brother was the chief treasurer, and the other a commander of seven thousand men. And most assuredly this is a requirement of modesty; for one whose palanquin or cart is turned out with much splendour, verily the idea comes to the minds of the sight-seers and common people, that in it there must be some lovely one, bright as the morning, the envy of the fairies. Hence, for the cars or palanquins for women to ride in to be greatly embroidered is, in the opinion of certain men of standing, who are worthy to be trusted, of great infamy."
                                            },
                                            {
                                                "example_id": "195ffa58-ac09-4b12-a1f4-b934ff675b1f",
                                                "sense_id": "07072305-e6cf-3d55-a0d4-31d005bffa28",
                                                "text": "Yesterday, December seventh, 1941, a date which will live in infamy, the United States of America was suddenly and deliberately attacked by naval and air forces of the Empire of Japan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2906d73a-967b-3a3e-97c7-714efe95cf4c",
                                        "entry_id": "aae81add-5522-388b-a28d-16c541b26209",
                                        "glosses": [
                                            "A reprehensible occurrence or situation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6426483-ca12-43a8-afe1-a2e42300fe08",
                                                "sense_id": "2906d73a-967b-3a3e-97c7-714efe95cf4c",
                                                "text": "All for a pig of a man who should have gone to the chair. It is an infamy that he did not."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ed627f0-a262-372b-bcaf-e9a842e0a42d",
                                        "entry_id": "aae81add-5522-388b-a28d-16c541b26209",
                                        "glosses": [
                                            "A stigma attaching to a person's character that disqualifies them from being a witness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f244f416-6305-461e-9dd1-368b13491cf6",
                        "source_entry_id": "61f16c09-d286-3685-be35-53e4598ae402",
                        "source_sense_id": "2fb16036-31dc-3e31-ba07-86e4b1a37741",
                        "target_lang_word": "dishonor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dishonor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2cbad5be-52a6-3fd2-9956-454072cc3bf3",
                                        "entry_id": "aacac82e-6b10-3fd2-86f3-b3dc69a2c812",
                                        "glosses": [
                                            "American standard spelling of dishonour."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc99c79a-0db9-48d6-9925-e1458f1e602c",
                                                "sense_id": "2cbad5be-52a6-3fd2-9956-454072cc3bf3",
                                                "text": "This prince bare alwaies in the field a greene shield, whereof he tooke his surname, and of him some forraine authors affirme, that he made an attempt to bring the whole realme of France vnder his subiection, which he performed, because his father susteined some dishonor and losse in his last voiage into that countrie."
                                            },
                                            {
                                                "example_id": "824f33e3-fac7-4d5b-ba8e-03d038939d59",
                                                "sense_id": "2cbad5be-52a6-3fd2-9956-454072cc3bf3",
                                                "text": "Indeed, those old insurgents, of 1868, are gradually being canonized with crimson death-names, because they neither knew dishonor, no, nor suffered it."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dishonor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8085228a-d90d-39dd-9516-00940305ddc5",
                                        "entry_id": "e2cc514b-aa6d-3d3c-8e81-0515beb92465",
                                        "glosses": [
                                            "American standard spelling of dishonour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73afb286-a144-458e-8651-c2c2b847c5c9",
                                                "sense_id": "8085228a-d90d-39dd-9516-00940305ddc5",
                                                "text": "It was while he was performing the duties of the store that he acquired the soubriquet \"Honest Abe\"--a characterization that he never dishonored, and an abbreviation that he never outgrew."
                                            },
                                            {
                                                "example_id": "04ed3d76-ece1-4d13-b776-44bf9ab34bee",
                                                "sense_id": "8085228a-d90d-39dd-9516-00940305ddc5",
                                                "text": "The three lured him to their home to kill him for dishonoring their family by filing a paternity suit in family court."
                                            },
                                            {
                                                "example_id": "96f7d764-37ff-4e9f-9cc8-aad2d2769f74",
                                                "sense_id": "8085228a-d90d-39dd-9516-00940305ddc5",
                                                "text": "The DNC organized the petition drive when it became clear this week that the network was prepared to ignore criticism of its decision to air a right-wing, factually inaccurate mocudrama that dishonors the memory of 9/11 victims in order to serve a cheap, callous political agenda two months before the election."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
