                "senses": [
                    {
                        "sense_id": "597f2205-3857-3fe2-8c58-72361ac38923",
                        "entry_id": "2d5ce453-9fd7-377e-be73-4f848d56fc7d",
                        "glosses": [
                            "Arrêter de clignoter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4535e040-1a44-437f-a183-37ab02231170",
                                "sense_id": "597f2205-3857-3fe2-8c58-72361ac38923",
                                "text": "Et que ça clignote et que ça reclignote et que ça déclignote..."
                            },
                            {
                                "example_id": "f4bf398c-f47f-4775-8c3a-da260eab5324",
                                "sense_id": "597f2205-3857-3fe2-8c58-72361ac38923",
                                "text": "De la part de mes yeux, merci Maître Po d'avoir fait \"déclignoter\" les images en haut de la colonne de gauche"
                            },
                            {
                                "example_id": "cb1c9aa1-b1af-4d0f-83a8-5491545ca9d9",
                                "sense_id": "597f2205-3857-3fe2-8c58-72361ac38923",
                                "text": "Bon, en résumé : quand je veux klaxonner, je déclignote et quand je veux reclignoter, je déklaxonne"
                            },
                            {
                                "example_id": "f6f1af17-36de-4360-995c-7d0043cb45ec",
                                "sense_id": "597f2205-3857-3fe2-8c58-72361ac38923",
                                "text": "Il ne se \"déclignote\" pas en sortie de rond-point, par exemple."
                            }
                        ]
                    }
                ],
