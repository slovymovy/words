                    },
                    {
                        "sense_id": "73059329-1ad4-3d3c-be30-a7c83a369c4f",
                        "entry_id": "8ddcadf3-8702-3763-b5b9-40095028cd1e",
                        "glosses": [
                            "спец. зазор, необходимый для беспрепятственного движения деталей мебели"
                        ],
                        "tags": [],
