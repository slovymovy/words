{
    "word_family": [
        "dwarsboom",
        "boom"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e137048e-f151-3622-8dce-26510b3f1a14",
                    "sense_definition": "iemand of iets opzettelijk tegenwerken om een plan of actie te verhinderen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tegenwerken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>dwarsboomde</w> ons plan om dat land te veroveren door de grenzen te sluiten.",
                            "target_lang_translations": {
                                "en": "He <w>thwarted</w> our plan to conquer that country by closing the borders."
                            }
                        },
                        {
                            "text": "De oppositie probeert de nieuwe wetgeving op alle mogelijke manieren te <w>dwarsbomen</w>.",
                            "target_lang_translations": {
                                "en": "The opposition is trying to <w>obstruct</w> the new legislation in every possible way."
                            }
                        }
                    ],
                    "synonyms": [
                        "frustreren",
                        "belemmeren",
                        "blokkeren",
                        "stremmen"
                    ],
                    "antonyms": [
                        "helpen",
                        "bevorderen",
                        "ondersteunen"
                    ],
                    "common_phrases": [
                        "plannen dwarsbomen",
                        "iemand dwarsbomen"
                    ],
                    "target_lang_definitions": {
                        "en": "to deliberately work against someone or something in order to prevent a plan or action"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "thwart",
                                "target_lang_sense_clarification": "to prevent someone from accomplishing something"
                            },
                            {
                                "target_lang_word": "frustrate",
                                "target_lang_sense_clarification": "to prevent a plan or effort from progressing"
                            },
                            {
                                "target_lang_word": "obstruct",
                                "target_lang_sense_clarification": "to block or get in the way of a process"
                            },
                            {
                                "target_lang_word": "counteract",
                                "target_lang_sense_clarification": "to act in opposition to something to neutralize it"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b03d931c-a6ed-33f5-ae03-604ea395db70",
                    "sense_definition": "meervoud van <w>dwarsboom</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De oude <w>dwarsbomen</w> werden gebruikt om de toegang tot de haven volledig af te sluiten.",
                            "target_lang_translations": {
                                "en": "The old <w>crossbars</w> were used to completely close off access to the harbor."
                            }
                        },
                        {
                            "text": "Men plaatste zware <w>dwarsbomen</w> over de weg om de vijandelijke voertuigen tegen te houden.",
                            "target_lang_translations": {
                                "en": "Heavy <w>barriers</w> were placed across the road to stop the enemy vehicles."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "plural of 'dwarsboom' (crossbar or physical barrier)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "crossbars",
                                "target_lang_sense_clarification": "horizontal bars used as a barrier"
                            },
                            {
                                "target_lang_word": "barriers",
                                "target_lang_sense_clarification": "physical obstacles used to block access"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}