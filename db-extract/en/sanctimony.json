    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "5a64ec05-ebb6-396f-8180-d1cf1a475ea7",
                "word": "sanctimony",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "10880690-4d3d-4b4a-9f0f-ef10a00849e6",
                        "entry_id": "5a64ec05-ebb6-396f-8180-d1cf1a475ea7",
                        "tags": [
                            "plural"
                        ],
                        "form": "sanctimonies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "16613e03-6acb-3a06-a1b3-a5872bdf5a2e",
                        "entry_id": "5a64ec05-ebb6-396f-8180-d1cf1a475ea7",
                        "glosses": [
                            "A hypocritical form of excessive piety, considered to be an affectation merely for public show."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "4ba7cc8d-2f4e-309c-bc27-95768179b38c",
                        "entry_id": "5a64ec05-ebb6-396f-8180-d1cf1a475ea7",
                        "glosses": [
                            "much older meaning: a state of holiness"
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "d12da577-dc64-4e37-83bf-6b8d78d2950f",
                                "sense_id": "4ba7cc8d-2f4e-309c-bc27-95768179b38c",
                                "text": "At its best[…] “The Newsroom” has a wit, sophistication and manic energy that recalls James L. Brooks’s classic movie “Broadcast News.” But at its worst, the show chokes on its own sanctimony."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d7ccfe1d-06e2-4dbb-94f3-ecc66d2956f9",
                        "source_entry_id": "5a64ec05-ebb6-396f-8180-d1cf1a475ea7",
                        "source_sense_description": "a hypocritical form of excessive piety",
                        "target_lang_word": "tartuferie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tartuferie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "608e5af1-e67b-357d-adbe-141c99af8bc5",
                                        "entry_id": "32a0194e-2828-3125-a6df-63798ea79260",
                                        "glosses": [
                                            "Caractère ou action hypocrite, manière d’agir de tartufe."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bbfa5a6e-0613-45d6-b14c-0954bbbce776",
                                                "sense_id": "608e5af1-e67b-357d-adbe-141c99af8bc5",
                                                "text": "Pour ces paroles hardies, ces fermes expressions qui violent la niaiserie émasculée ou la tartuferie bienséante, l’art les condamnerait-il, le Catholicisme les veut !"
                                            },
                                            {
                                                "example_id": "b78efb20-2680-4221-9e50-6cfafc35be72",
                                                "sense_id": "608e5af1-e67b-357d-adbe-141c99af8bc5",
                                                "text": "Donc, loin d’ébranler le système d’oppression qu’ils condamnent, ces activistes participeront à une vaste opération de mascarade destinée à démontrer que les colonialistes sont ouverts et gentils !\nQuelle vaste tartuferie..."
                                            },
                                            {
                                                "example_id": "e888a453-b5a9-4111-b047-5eb1e4d60875",
                                                "sense_id": "608e5af1-e67b-357d-adbe-141c99af8bc5",
                                                "text": "Je hais sa tartuferie."
                                            },
                                            {
                                                "example_id": "13c94956-cd1e-4d72-948e-289eb32e3bc8",
                                                "sense_id": "608e5af1-e67b-357d-adbe-141c99af8bc5",
                                                "text": "Il y a de la tartuferie dans cette action."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b9b99f2a-2645-4fe4-b015-58db54657fd0",
                        "source_entry_id": "5a64ec05-ebb6-396f-8180-d1cf1a475ea7",
                        "source_sense_description": "a hypocritical form of excessive piety",
                        "target_lang_word": "Scheinheiligkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Scheinheiligkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bd2accf7-07b8-30ba-9d69-da93a52b3920",
                                        "entry_id": "850195e7-eb16-3d1c-9159-f668c1ae8bcf",
                                        "glosses": [
                                            "Einstellung/Haltung, etwas vorzutäuschen, unaufrichtig zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3fc44665-f915-4663-9b5c-05a1d2e76947",
                                                "sense_id": "bd2accf7-07b8-30ba-9d69-da93a52b3920",
                                                "text": "„Nun werden die Brüder in der Broschüre der Gottlosigkeit und Scheinheiligkeit bezichtigt.“"
                                            },
                                            {
                                                "example_id": "a7d0b38b-a472-4629-b0d5-05336f6080e4",
                                                "sense_id": "bd2accf7-07b8-30ba-9d69-da93a52b3920",
                                                "text": "„Wahre Glückseligkeit besteht nicht in bürgerlicher Ehrbarkeit oder Scheinheiligkeit, die Stricke des Teufels unter dem hellen Licht des Evangeliums sind.“"
                                            },
                                            {
                                                "example_id": "52dc889e-26f0-4e2d-a728-d2098908b44a",
                                                "sense_id": "bd2accf7-07b8-30ba-9d69-da93a52b3920",
                                                "text": "„Das eiserne Pflichtgefühl eines Gutmenschen dagegen erinnert eher an schmierige Scheinheiligkeit.“"
                                            },
                                            {
                                                "example_id": "3de0adf5-4b2e-4863-8c9d-790f4d5c5788",
                                                "sense_id": "bd2accf7-07b8-30ba-9d69-da93a52b3920",
                                                "text": "„Er war zwar kein Mann des Wortes, aber was Scheinheiligkeit war, wusste er trotzdem.“"
                                            },
                                            {
                                                "example_id": "14448259-c5be-47f3-99fe-6e33185c4ef5",
                                                "sense_id": "bd2accf7-07b8-30ba-9d69-da93a52b3920",
                                                "text": "„Es ist ein Reich der Wahrheit und straft alle Lügen und entlarvt alle Scheinheiligkeit und Scheinherrlichkeit.“"
                                            },
                                            {
                                                "example_id": "cce5f338-2f86-41e8-a5cc-6f472714028b",
                                                "sense_id": "bd2accf7-07b8-30ba-9d69-da93a52b3920",
                                                "text": "„Und er sei ein Satiriker gewesen, jemand, der die Realität hinter den Phänomenen, den rhetorischen Platitüden und Scheinheiligkeiten offenlegt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "903edde1-18f5-4690-98ad-220431989af6",
                        "source_entry_id": "5a64ec05-ebb6-396f-8180-d1cf1a475ea7",
                        "source_sense_description": "a hypocritical form of excessive piety",
                        "target_lang_word": "Frömmelei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Frömmelei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "588e8021-4d88-34a8-bcec-b79fbad69aa1",
                                        "entry_id": "2ea86178-df0c-350b-8ba2-42d5a7e7eb61",
                                        "glosses": [
                                            "überzogene, demonstrativ zur Schau getragene Frömmigkeit"
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6073c9d4-2ebe-4dc2-a93c-68cae0de86ed",
                                                "sense_id": "588e8021-4d88-34a8-bcec-b79fbad69aa1",
                                                "text": "„Selten sind im tiefgläubigen Amerika nationale Machtinteressen und fundamentalistische Frömmelei eine so innige Verbindung eingegangen.“"
                                            },
                                            {
                                                "example_id": "e827fcfe-5b07-44a9-ae46-363b42839a81",
                                                "sense_id": "588e8021-4d88-34a8-bcec-b79fbad69aa1",
                                                "text": "„In Wien war alles schön. Viel Geld und viel Luxus. Aber infolge der Frömmelei der Kaiserin war es außerordentlich schwer, sich Cytherens Freuden zu verschaffen, besonders für Fremde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "26f19e8f-405f-37fb-bfd7-b477a9bbd3ba",
                                        "entry_id": "2ea86178-df0c-350b-8ba2-42d5a7e7eb61",
                                        "glosses": [
                                            "Äußerung, Handlung, der eine als unangenehm empfundene, übertriebene Frömmigkeit zugrunde liegt"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01e22745-3c48-4ac9-870f-e0cf3a5b7f2f",
                                                "sense_id": "26f19e8f-405f-37fb-bfd7-b477a9bbd3ba",
                                                "text": "„Im Reich der Religion entstehen mitunter manch obskure Frömmeleien, über die man sich nur schwer das Gelächter verkeifen kann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
