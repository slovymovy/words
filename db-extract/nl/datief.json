                                    {
                                        "sense_id": "9402287c-13fb-3098-8ded-c3a5ecc3575b",
                                        "entry_id": "5e0a7618-fbca-3b36-abc9-0fd26fe8ac94",
                                        "glosses": [
                                            "Qui est donnée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f334de95-ae9a-4196-9f88-3ab5f9366023",
                                                "sense_id": "9402287c-13fb-3098-8ded-c3a5ecc3575b",
                                                "text": "Tutelle dative : Tutelle en l'absence de désignation par testament ou si le désigné refuse sa charge, tuteur désigné par le conseil de famille, à la différence de celle qui est déférée par voie testamentaire."
                                            },
                                            {
                                                "example_id": "9105c2a1-5dfe-4570-9878-994da88a9b72",
                                                "sense_id": "9402287c-13fb-3098-8ded-c3a5ecc3575b",
                                                "text": "On dit dans un sens analogue :"
                                            },
                                            {
                                                "example_id": "ef882a32-dd28-4baf-93de-6f9ae448dd52",
                                                "sense_id": "9402287c-13fb-3098-8ded-c3a5ecc3575b",
                                                "text": "Tuteur datif."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "datif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a3822b50-1fa3-36e1-a6ba-05a2ec119e06",
                                        "entry_id": "ef53a987-aa0b-373e-a168-48180ce01130",
                                        "glosses": [
                                            "Cas grammatical qui sert à marquer le complément d’attribution."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "962010eb-14d1-408c-9fda-89849ed384c8",
                                                "sense_id": "a3822b50-1fa3-36e1-a6ba-05a2ec119e06",
                                                "text": "Strasbourg boit de la bière comme une ville d’université d’au-delà du Rhin, et sur les enseignes de ses brasseries le datif germanique se substitue souvent au génitif français."
                                            },
                                            {
                                                "example_id": "ec5afc53-c514-4181-bf8b-154d0284de05",
                                                "sense_id": "a3822b50-1fa3-36e1-a6ba-05a2ec119e06",
                                                "text": "En effet, aussi bien Herslund que Jacob font observer que le datif se présente très souvent sous forme de clitique, simple (comme en français) ou par redoublement (comme en espagnol)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "090da65d-a44a-46ee-9d38-3cc7d9764ef6",
                        "source_entry_id": "f8d4ff9c-8bec-36f2-ab1c-db99d32b39dc",
