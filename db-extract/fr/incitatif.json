                                        "entry_id": "6def5727-0561-3bf1-8d8d-f064d5e91f26",
                                        "glosses": [
                                            "Having the ability to inspire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4c5c8a9-4231-4094-a646-37bdad167499",
                                                "sense_id": "2850f1d8-71a1-30a9-8f53-8ba952b5467c",
                                                "text": "Near-synonym: motivational"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "inspirational",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "823bb8ac-d2a4-348b-aece-2a480f78920d",
                                        "entry_id": "f2c6695a-b9b0-3655-9ed0-a865e8348fd0",
                                        "glosses": [
                                            "A book or article intended to inspire people with positive feelings."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e755331-690a-4f57-b319-907077e3dd05",
                                                "sense_id": "823bb8ac-d2a4-348b-aece-2a480f78920d",
                                                "text": "She is the author of fifteen books for children, and her inspirationals have appeared in numerous magazines […]"
                                            },
                                            {
                                                "example_id": "553f453e-9aa9-4aa5-b986-1d6a869d66c6",
                                                "sense_id": "823bb8ac-d2a4-348b-aece-2a480f78920d",
                                                "text": "“All right, then,” Mel said. “Let's fill in the bestsellers, the inspirationals, and some of the children's books.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
