                        ]
                    },
                    {
                        "translation_id": "462c4f13-6e70-4049-8482-1105bba65f7b",
                        "source_entry_id": "4b2ba3ce-d447-333f-b842-3a3832047354",
                        "source_sense_description": "state of being motile",
                        "target_lang_word": "motilité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "motilité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "73f1de26-0490-312d-a6eb-6039cffad931",
                                        "entry_id": "7cc10f1d-2f16-395c-b304-c6d022a12557",
                                        "glosses": [
                                            "Faculté physiologique d’une partie d’un être vivant (pattes, ailes, muscles, cellules…) à se mouvoir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2cffaad6-8dd2-44da-8619-f2fb770c5189",
                                                "sense_id": "73f1de26-0490-312d-a6eb-6039cffad931",
                                                "text": "La motilité mandibulaire est définie par l’ampleur qu’a la mâchoire à s’ouvrir."
                                            },
                                            {
                                                "example_id": "b9c24125-4f6e-4a6a-9cb5-c0f845ba46b3",
                                                "sense_id": "73f1de26-0490-312d-a6eb-6039cffad931",
                                                "text": "Et si, à son avis, Febvre ne venait qu’après Thiron, ou Delaunay qu’après Coquelin, la soudaine motilité que Coquelin perdant la rigidité de la pierre, contractait dans mon esprit pour y passer au deuxième rang, et l’agilité miraculeuse, la féconde animation dont se voyait doté Delaunay pour reculer au quatrième, rendait la sensation du fleurissement et de la vie à mon cerveau assoupli et fertilisé."
                                            },
                                            {
                                                "example_id": "cc57fde1-da7c-40a7-aa7b-1ee754d7a101",
                                                "sense_id": "73f1de26-0490-312d-a6eb-6039cffad931",
                                                "text": "Mme Verdurin pour que son silence n’eût pas l’air d’un consentement, mais du silence ignorant des choses inanimées, avait soudain dépouillé son visage de toute vie, de toute motilité."
                                            },
                                            {
                                                "example_id": "86b3a621-8d87-447f-a90d-5284e194b9e0",
                                                "sense_id": "73f1de26-0490-312d-a6eb-6039cffad931",
                                                "text": "… elle prêtait à ses moindres sensations une importance extraordinaire ; elle les douait d’une motilité qui lui rendait difficile de les garder pour elle […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9fcf8016-2fab-3ea1-9def-fbcc7e671854",
                                        "entry_id": "7cc10f1d-2f16-395c-b304-c6d022a12557",
                                        "glosses": [
                                            "Mobilité potentielle et projetée d'un individu ou d'un groupe d'individus dans l'espace vers un lieu recherché."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9f380b6-aa87-4d4a-983a-a85c640f5d0b",
                                                "sense_id": "9fcf8016-2fab-3ea1-9def-fbcc7e671854",
                                                "text": "[La motilité] est la manière dont un individu ou un groupe fait sien le champ du possible en matière de mobilité et en fait usage pour développer ses projets."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "71d8996a-184e-4b64-b33b-105f28a5a441",
                        "source_entry_id": "4b2ba3ce-d447-333f-b842-3a3832047354",
                        "source_sense_description": "state of being motile",
                        "target_lang_word": "Motilität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Motilität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "74fab24a-acea-39a6-b2b8-c9dde515f6da",
                                        "entry_id": "bd1a54a8-8ac9-3d42-88c1-49e3adc2d16c",
                                        "glosses": [
                                            "Bewegungsfähigkeit des menschlichen Körpers und seiner Organe, dies aber auf unwillkürliche Bewegungsvorgänge beschränkt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03c86808-c76d-4cb1-8011-9d4203ca4a0d",
                                                "sense_id": "74fab24a-acea-39a6-b2b8-c9dde515f6da",
                                                "text": "„Eine Dysbiose des Dünndarms stellt eine häufige Komplikation einer veränderten gastrointestinalen Motilität dar und kann wiederum zur Entwicklung der klinischen Symptomatik beitragen.“"
                                            },
                                            {
                                                "example_id": "1b8928b2-eff0-4c9f-a908-a3ed05440ffa",
                                                "sense_id": "74fab24a-acea-39a6-b2b8-c9dde515f6da",
                                                "text": "„Motilität lässt sich definieren als die Fähigkeit eines Organs oder Gewebes, seine Form oder Morphologie zu verändern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "488391b3-a2fc-3ea8-ae6f-f8621199230b",
                                        "entry_id": "bd1a54a8-8ac9-3d42-88c1-49e3adc2d16c",
                                        "glosses": [
                                            "Bewegungsfähigkeit von Organismen und Strukturen innerhalb einer Zelle"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d28dc787-6951-4972-9cd2-eb5bab69a136",
                                                "sense_id": "488391b3-a2fc-3ea8-ae6f-f8621199230b",
                                                "text": "„Motilität lässt sich definieren als die Fähigkeit eines Organs oder Gewebes, seine Form oder Morphologie zu verändern.“"
                                            },
                                            {
                                                "example_id": "cb4de205-3899-40bf-9524-c08047f6ff9d",
                                                "sense_id": "488391b3-a2fc-3ea8-ae6f-f8621199230b",
                                                "text": "„Dagegen waren in embryonalen Fibroblasten vom knt11loxP/1loxP Genotyp Veränderungen in der Organisation des Zytoplasmas erkennbar, insbesondere in der Verteilung membranöser Organellen und der Motilität von Mitochondrien.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
