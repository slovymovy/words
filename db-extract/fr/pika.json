                "senses": [
                    {
                        "sense_id": "c2d7b187-317d-389c-8c11-3d3f4e750b5d",
                        "entry_id": "dd61b613-be2a-3edb-bd64-179e01ef3bd9",
                        "glosses": [
                            "Maison d’édition française spécialisée dans les mangas."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ff1bc85-1a12-4a62-9cfc-6c85d88a0eb6",
                                "sense_id": "c2d7b187-317d-389c-8c11-3d3f4e750b5d",
                                "text": "C’est un manga phénomène, parce qu’il a connu un succès à la fois commercial et critique, explique Mehdi Benrabah, directeur éditorial chez Pika Éditions."
                            },
                            {
                                "example_id": "89f22aca-7776-463b-986e-07642fe0eb63",
                                "sense_id": "c2d7b187-317d-389c-8c11-3d3f4e750b5d",
                                "text": "Enfin, Pika Édition publie des mangas adaptés au jeune public et des albums jeunesse autour du Japon via sa marque nobi nobi !."
                            },
                            {
                                "example_id": "b8ce564e-94b8-431a-866a-b21f3f13859c",
                                "sense_id": "c2d7b187-317d-389c-8c11-3d3f4e750b5d",
                                "text": "La maison d’édition Pika est née en 2000 et se focalise sur les livres mangas."
                            }
                        ]
                    }
                ],
