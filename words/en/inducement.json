            "senses": [
                {
                    "sense_id": "36df8ea2-4640-30c5-9808-f826af31ffdd",
                    "sense_definition": "An incentive or factor that encourages someone to do something or helps bring about a desired result.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "incentive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government offered tax breaks as an <w>inducement</w> for companies to invest in the region."
                        },
                        {
                            "text": "Higher wages served as a strong <w>inducement</w> for workers to stay with the company."
                        }
                    ],
                    "synonyms": [
                        "incentive",
                        "motivation",
                        "encouragement"
                    ],
                    "antonyms": [
                        "deterrent"
                    ],
                    "common_phrases": [
                        "financial inducement",
                        "strong inducement"
                    ]
                },
                {
                    "sense_id": "3e99dca5-c4bc-3b41-828e-9c6fa64699ae",
                    "sense_definition": "An introductory statement of facts or background information, often used in legal contexts.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "introduction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>inducement</w> in the contract clearly outlined the historical background of the agreement."
                        },
                        {
                            "text": "Before presenting the main arguments, the lawyer provided an <w>inducement</w> to set the scene."
                        }
                    ],
                    "synonyms": [
