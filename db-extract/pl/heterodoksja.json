                "senses": [
                    {
                        "sense_id": "8ed2a73d-6579-327b-9100-34407de37bfd",
                        "entry_id": "5c80d274-7df8-3020-8bb5-351cb62a55d8",
                        "glosses": [
                            "uznawanie odmiennych poglądów, niezgodnych z obowiązującą doktryną wiary; szerzej: niezgodnych z obowiązującymi zasadami, kanonem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44bcdf9b-b197-4405-af35-ad200fa7f35d",
                                "sense_id": "8ed2a73d-6579-327b-9100-34407de37bfd",
                                "text": "W późnym średniowieczu Pikardia stała się terenem działalności licznych ruchów heterodoksji religijnej, waldensów, begardów, a także braci i sióstr herezji wolnego ducha"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
