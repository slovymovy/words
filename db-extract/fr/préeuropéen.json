                ],
                "senses": [
                    {
                        "sense_id": "9e70b320-664e-3ba6-9ec1-05c86ae91770",
                        "entry_id": "3b58050d-1430-332d-8d03-7a97266658d8",
                        "glosses": [
                            "Antérieur à l'arrivée des Européens."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d465a0c-bd56-4657-af23-52419e68fbe2",
                                "sense_id": "9e70b320-664e-3ba6-9ec1-05c86ae91770",
                                "text": "Ainsi s'explique le caractère grandiose des aménagements agraires préeuropéens visibles en parcourant la Grande-Terre néo-calédonienne."
                            }
                        ]
                    },
                    {
                        "sense_id": "29c715f9-5ab2-3480-a94a-f485c82afe83",
                        "entry_id": "3b58050d-1430-332d-8d03-7a97266658d8",
                        "glosses": [
                            "Proto-indo-européen."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "56a6c42e-95b9-4a61-85fe-f7f4cd79c9ec",
                                "sense_id": "29c715f9-5ab2-3480-a94a-f485c82afe83",
                                "text": "Heureusement il n'est plus indispensable aujourd'hui de recueillir les indications de ces trois grandes familles d'idiomes, car l'existence d'une unité préeuropéenne opposée à l'unité indo-iranienne est un fait acquis."
                            },
                            {
                                "example_id": "ad554e7a-8b0f-49ad-96ce-50b52db7bacf",
                                "sense_id": "29c715f9-5ab2-3480-a94a-f485c82afe83",
                                "text": "Ainsi, un fait commun au sanscrit et au grec seuls serait indo-européen de toute nécessité, tandis qu'un fait attesté à la fois par le grec, l'italique, le slave, le germanique et le celtique ne pourrait être que préeuropéen."
                            }
                        ]
                    }
