                                                "example_id": "e5fcdf3a-30c7-40aa-aa2e-4f8636336128",
                                                "sense_id": "283b141a-b2cc-3b79-a0a4-5bb9b72b0d34",
                                                "text": "Римская империя времени упадка."
                                            },
                                            {
                                                "example_id": "e3996395-5013-4a10-9f0c-6018640850a7",
                                                "sense_id": "283b141a-b2cc-3b79-a0a4-5bb9b72b0d34",
                                                "text": "Эклектизм, дробность, крохоборство, мелочность, мозаичность, верхоглядство — вот внутренне необходимые черты общественной мысли в эпоху упадка."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
