    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "fa089a6f-3365-3d46-97dd-6b071b383018",
                    "sense_definition": "verbogen vorm van de stellende trap van <w>mank</w>",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toen zij de stal weer uitkwam, ontdekte zij een kip met een <w>manke</w> poot.",
                            "target_lang_translations": {
                                "en": "When she came out of the stable again, she discovered a chicken with a <w>lame</w> leg."
                            }
                        },
                        {
                            "text": "De <w>manke</w> hond liep langzaam achter zijn baasje aan in het park.",
                            "target_lang_translations": {
                                "en": "The <w>limping</w> dog walked slowly behind its owner in the park."
                            }
                        }
                    ],
                    "synonyms": [
                        "kreupele"
                    ],
                    "antonyms": [
                        "gezonde"
                    ],
                    "common_phrases": [
                        "een manke poot",
                        "de manke hond"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "verbogen vorm"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "inflected form of the positive degree of 'mank' (lame, limping)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lame",
                                "target_lang_sense_clarification": "unable to walk properly due to injury or illness"
                            },
                            {
                                "target_lang_word": "limping",
                                "target_lang_sense_clarification": "walking with difficulty, typically because of a damaged leg or foot"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "343801e4-5889-3d9a-8383-4c8949f88937",
                    "sense_definition": "iemand die door een aandoening aan één of beide benen niet goed lopen kan",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ze liep met een scheve tred die aan een <w>manke</w> denken deed.",
                            "target_lang_translations": {
                                "en": "She walked with a crooked gait that brought to mind a <w>lame person</w>."
                            }
                        },
                        {
                            "text": "De oude man hielp de <w>manke</w> om veilig de drukke straat over te steken.",
                            "target_lang_translations": {
                                "en": "The old man helped the <w>lame person</w> cross the busy street safely."
                            }
                        }
                    ],
                    "synonyms": [
                        "kreupele",
                        "mankpoot"
                    ],
                    "target_lang_definitions": {
                        "en": "someone who cannot walk properly due to a condition in one or both legs"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lame person",
                                "target_lang_sense_clarification": "someone who walks with a limp"
                            },
                            {
                                "target_lang_word": "cripple",
                                "target_lang_sense_clarification": "offensive or dated term for a person with a physical disability"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "985dd819-6632-3615-9c41-ad5079abbfc0",
                    "sense_definition": "aanvoegende wijs van <w>manken</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wie beter wil worden, <w>manke</w> dan maar naar deze wonderbaarlijke genezer.",
                            "target_lang_translations": {
                                "en": "Whoever wishes to get well, let him <w>limp</w> to this miraculous healer."
                            }
                        },
                        {
                            "text": "Al <w>manke</w> hij de hele weg, hij wilde absoluut de top van de berg bereiken.",
                            "target_lang_translations": {
                                "en": "Even though he might <w>limp</w> the whole way, he absolutely wanted to reach the top of the mountain."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "aanvoegende wijs"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "subjunctive form of 'manken' (to limp, to walk with a limp)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "limp",
                                "target_lang_sense_clarification": "subjunctive form of the verb to limp"
                            }
                        ]
                    }
                }
            ]
        }
    ]
