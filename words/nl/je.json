                },
                {
                    "sense_id": "6aeb72e2-afb7-3424-9e36-f9d72f6c3568",
                    "sense_definition": "Verwijzing naar mensen in het algemeen, inclusief de spreker en luisteraar; informeel alternatief voor 'men'.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "generic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In Nederland kun <w>je</w> overal veilig fietsen.",
                            "target_lang_translations": {
                                "en": "In the Netherlands <w>you</w> can cycle safely everywhere.",
                                "ru": "В Нидерландах <w>ты</w> везде можешь безопасно ездить на велосипеде.",
                                "de": "In den Niederlanden kann <w>man</w> überall sicher Fahrrad fahren.",
                                "es": "En los Países Bajos <w>se</w> puede montar en bicicleta de forma segura por todas partes."
                            }
                        },
                        {
                            "text": "<w>Je</w> weet nooit wat er in de toekomst gaat gebeuren.",
                            "target_lang_translations": {
                                "en": "<w>You</w> never know what is going to happen in the future.",
                                "ru": "<w>Ты</w> никогда не знаешь, что произойдет в будущем.",
                                "de": "<w>Man</w> weiß nie, was in der Zukunft passieren wird.",
                                "es": "<w>Uno</w> nunca sabe qué va a pasar en el futuro."
                            }
                        }
                    ],
                    "synonyms": [
                        "men"
                    ],
                    "common_phrases": [
                        "je weet maar nooit",
                        "dat heb je",
                        "zo zie je maar"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informeler dan 'men'"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Reference to people in general, including the speaker and listener; informal alternative for 'one'.",
                        "ru": "Указание на людей в целом, включая говорящего и слушающего; неформальная альтернатива 'men'.",
                        "de": "Bezugnahme auf Menschen im Allgemeinen, einschließlich Sprecher und Hörer; informelle Alternative zu 'men' (man).",
                        "es": "Uso genérico o impersonal para referirse a la gente en general (equivalente a 'uno' o al 'tú' generalizador)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "you",
                                "target_lang_sense_clarification": "generic pronoun"
                            },
                            {
                                "target_lang_word": "one",
                                "target_lang_sense_clarification": "formal generic pronoun"
                            }
                        ],
                        "ru": [
