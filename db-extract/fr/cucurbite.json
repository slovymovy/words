                                        "glosses": [
                                            "Any member of the family Cucurbitaceae of gourds."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "acda505a-6a19-41d3-b94b-75d14c1f54ac",
                                                "sense_id": "592a37ea-55e0-3ec7-a06d-271a19e0f7bb",
                                                "text": "Our efforts are directed against species of African origin because these include several notorious pests (such as medfly, Ceratitis capitata), as well as some of the most poorly known ones (species of Dacus feeding on cucurbits)."
                                            }
                                        ]
                                    },
