                                        "glosses": [
                                            "A crystalline compound C₁₄H₂₂N₂O that is used in the form of its hydrochloride as a local anesthetic and as an antiarrhythmic agent."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
