                "senses": [
                    {
                        "sense_id": "18945e7e-703a-3093-a71e-9efc50bfd920",
                        "entry_id": "c37b2b26-5a48-30a8-8090-5b0d5b6895b2",
                        "glosses": [
                            "Rembourser d’une arnaque."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "421147dc-ae2f-4bf5-9daa-7d3c658dfb38",
                                "sense_id": "18945e7e-703a-3093-a71e-9efc50bfd920",
                                "text": "Puis mon père s'est fait cambrioler genre 1 an après et on lui a volé entre autres ladite boite a outils mais comme c'est un gros pigeon trop honnête, au lieu de déclarer le vol de la boite et des 2 tronçonneuses (vu qu'il avait la \"facture\" ( franchement qui profite pas de faire passer des trucs en plus à l'assurance ?) histoire de se faire désarnaquer, bah nan \"Oui mais si ils chopent le voleur et qu'il dit qu'il a pas volé ca ?\"."
                            },
                            {
                                "example_id": "dfdc0e9f-1b76-4ad1-bb5c-637b0def390e",
                                "sense_id": "18945e7e-703a-3093-a71e-9efc50bfd920",
                                "text": "1/ arriver à se faire \"désarnaquer\""
                            },
                            {
                                "example_id": "2e11cd00-b62d-40e1-87e8-a1f11e047642",
                                "sense_id": "18945e7e-703a-3093-a71e-9efc50bfd920",
                                "text": "que faire pour se \"désarnaquer\""
                            }
                        ]
                    },
                    {
                        "sense_id": "90266b3f-6386-37f6-8a49-6703c5bca637",
                        "entry_id": "c37b2b26-5a48-30a8-8090-5b0d5b6895b2",
                        "glosses": [
                            "Faire perdre son caractère d’arnaque à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8877e98f-7bc0-47a8-a128-e38a33c3efbd",
                                "sense_id": "90266b3f-6386-37f6-8a49-6703c5bca637",
                                "text": "Je lui ai fait remarqué que ce numéro était surtaxé. Elle m'a répondu qu'en ce cas, le courrier serait livré à mon adresse le jour même ! Une arnaque \"désarnaquée\" !"
                            }
                        ]
                    }
