                "senses": [
                    {
                        "sense_id": "c5c14ebc-95d5-32b2-b6d2-341c9663f6b8",
                        "entry_id": "6bd40635-6cfd-3c09-9dae-0943b1ac8f20",
                        "glosses": [
                            "страд. к встряхнуть"
                        ],
                        "tags": [
                            "passive"
                        ],
                        "examples": [
                            {
                                "example_id": "53e82c7b-3cad-4971-b9b0-c1fd370adbd5",
                                "sense_id": "c5c14ebc-95d5-32b2-b6d2-341c9663f6b8",
                                "text": "Як тут не згадати повість відомого російського письменника О. Купріна “Поєдинок”, у якій є досить цікавий опис проскурівського вокзалу: “… вокзал служил единственным местом, куда обыватели ездили частенько покутить, встряхнуться и даже поиграть в карты. Ездили туда и дамы к приходу пассажирских поездов, что служило маленьким разнообразием в глубокой скуке провинциальной жизни”."
                            }
                        ]
                    }
