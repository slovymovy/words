            {
                "entry_id": "0e23d33b-e312-3ff4-bcd0-f6d8760b9989",
                "word": "Crépin",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0acc90f4-52e1-34b9-9496-508d06bd7157",
                        "entry_id": "0e23d33b-e312-3ff4-bcd0-f6d8760b9989",
                        "glosses": [
                            "Prénom masculin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71045ea4-1343-4345-b88e-1e0f511f888c",
                                "sense_id": "0acc90f4-52e1-34b9-9496-508d06bd7157",
                                "text": "Le Commissaire. — Madame, je suis le commissaire de police de votre arrondissement et je viens à la requête de M. Crépin Vatelin, votre époux…"
                            }
                        ]
                    },
                    {
                        "sense_id": "b49cad66-08b9-3f58-801c-5694a4c6528b",
                        "entry_id": "0e23d33b-e312-3ff4-bcd0-f6d8760b9989",
                        "glosses": [
                            "Saint martyr du IIIᵉ siècle, traditionnellement considéré, avec son frère Crépinien, comme le patron des cordonniers."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7023428f-82bc-4c12-b73e-0b821c5dddd7",
                                "sense_id": "b49cad66-08b9-3f58-801c-5694a4c6528b",
                                "text": "Après les blancs, les noirs, les gniafs empoissés, qui dansaient en faisant claquer leurs tire-pieds, autour de saint Crépin."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "42555236-73bb-463b-8ee4-54151cc46493",
                        "source_entry_id": "0e23d33b-e312-3ff4-bcd0-f6d8760b9989",
                        "source_sense_description": "Prénom masculin",
                        "target_lang_word": "Crispin",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Crispin",
