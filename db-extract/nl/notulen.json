                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2bd6e182-0c05-3ba9-8f90-4afc48647b39",
                                        "entry_id": "72864946-b69c-3553-bc70-6a5fc04bfa49",
                                        "glosses": [
                                            "schriftliche Aufzeichnung oder Niederschrift nach einem genau definierten Schema"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aea26fd8-710c-4bfc-b407-1992caef2d01",
                                                "sense_id": "2bd6e182-0c05-3ba9-8f90-4afc48647b39",
                                                "text": "Herr Müller schreibt heute das Protokoll!"
                                            },
                                            {
                                                "example_id": "188f01f4-aa4a-45c1-88fb-3792710908f9",
                                                "sense_id": "2bd6e182-0c05-3ba9-8f90-4afc48647b39",
                                                "text": "Ich möchte noch zu Protokoll geben, dass ich bei der letzten Sitzung nicht anwesend war."
                                            },
                                            {
                                                "example_id": "b42c4132-ef66-46bb-9590-c9d50810587f",
                                                "sense_id": "2bd6e182-0c05-3ba9-8f90-4afc48647b39",
                                                "text": "Der Zeuge gab seine Beobachtungen zu Protokoll."
                                            },
                                            {
                                                "example_id": "1b0c13af-bf9a-4da5-a6cc-0b085eef433c",
                                                "sense_id": "2bd6e182-0c05-3ba9-8f90-4afc48647b39",
                                                "text": "„Teilweise konnten Zeugen befragt oder ihre Protokolle genutzt werden.“"
                                            },
                                            {
                                                "example_id": "6fdd2cdc-a998-44c5-b80a-ab833089f156",
                                                "sense_id": "2bd6e182-0c05-3ba9-8f90-4afc48647b39",
                                                "text": "„Am 11. September erhält dieses Urteil Rechtskraft, wird am Tage darauf in effigie vollzogen und ein dementsprechendes Protokoll angefertigt.“"
                                            },
                                            {
                                                "example_id": "a48a04dc-7f94-4114-b424-a461695d8853",
                                                "sense_id": "2bd6e182-0c05-3ba9-8f90-4afc48647b39",
                                                "text": "„Das Protokoll schildert den Lauf der Ereignisse.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "446ba0e6-aeb0-3918-b851-d46abaafb78c",
                                        "entry_id": "72864946-b69c-3553-bc70-6a5fc04bfa49",
                                        "glosses": [
                                            "bestimmte Regeln des Umgangs bei zwischenstaatlichen Kontakten"
                                        ],
                                        "tags": [
                                            "Diplomatie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2af9c74-1d46-4e97-b1a8-7114a1cd88fb",
                                                "sense_id": "446ba0e6-aeb0-3918-b851-d46abaafb78c",
                                                "text": "Der Botschafter hielt sich an das vorgegebene Protokoll."
                                            },
                                            {
                                                "example_id": "c790885f-db29-4530-845b-ffbf7469ce18",
                                                "sense_id": "446ba0e6-aeb0-3918-b851-d46abaafb78c",
                                                "text": "Es verstößt gegen das Protokoll, laut zu lachen."
                                            },
                                            {
                                                "example_id": "992c70d3-7caf-4663-a69d-c7eb7ce08ab8",
                                                "sense_id": "446ba0e6-aeb0-3918-b851-d46abaafb78c",
                                                "text": "„Dann tritt Lumumba ans Mikrofon – was im Protokoll gar nicht vorgesehen ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a2e02705-3d41-3303-840c-3f9631d8dc90",
                                        "entry_id": "72864946-b69c-3553-bc70-6a5fc04bfa49",
                                        "glosses": [
                                            "durch die Polizei ausgestellte Strafe meist als Folge eines Verkehrsvergehens"
                                        ],
                                        "tags": [
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e676268-3019-49d9-a692-d22b5b1aac7d",
                                                "sense_id": "a2e02705-3d41-3303-840c-3f9631d8dc90",
                                                "text": "Ich habe schon wieder ein Protokoll wegen Falschparkens bekommen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "f4e52b12-c33a-3883-9639-fc2c5352108b",
                                        "entry_id": "72864946-b69c-3553-bc70-6a5fc04bfa49",
                                        "glosses": [
                                            "Satz von Befehlen, eine bestimmte Implementation, zur Steuerung der Kommunikation zwischen zwei Geräten, zum Beispiel zwischen zwei Computern"
                                        ],
                                        "tags": [
                                            "Telekommunikation"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1fda0ab-cc21-402a-bf24-a69969716cfc",
                                                "sense_id": "f4e52b12-c33a-3883-9639-fc2c5352108b",
                                                "text": "Das Hypertext Transfer Protokoll (HTTP) ist nicht das einzige Protokoll, das im Internet verwendet wird."
                                            }
