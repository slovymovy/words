                        },
                        {
                            "text": "Zij is de <w>oudste</w> leerling van de klas.",
                            "target_lang_translations": {
                                "en": "She is the <w>oldest</w> pupil in the class.",
                                "ru": "Она — самая <w>старшая</w> ученица в классе.",
                                "pl": "Ona jest <w>najstarszą</w> uczennicą w klasie.",
                                "de": "Sie ist die <w>älteste</w> Schülerin der Klasse.",
                                "fr": "Elle est l'élève la plus <w>âgée</w> de la classe.",
                                "it": "Lei è l'alunna più <w>anziana</w> della classe.",
                                "cs": "Ona je <w>nejstarší</w> žákyní ve třídě.",
                                "tr": "O, sınıfın en <w>yaşlı</w> öğrencisidir.",
                                "es": "Ella es la alumna más <w>mayor</w> de la clase."
