                    {
                        "form_id": "4a2f2c12-74ee-414d-802b-9d8fb14e0422",
                        "entry_id": "8b7f99e9-2aab-3a34-92dc-07361bcecc7d",
                        "tags": [
                            "plural"
                        ],
                        "form": "proviseuses"
                    },
                    {
                        "form_id": "778f6cfd-c87a-4cf0-9d38-d3fe0e06a083",
                        "entry_id": "8b7f99e9-2aab-3a34-92dc-07361bcecc7d",
                        "tags": [
                            "masculine"
                        ],
                        "form": "proviseur"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b154df5f-281e-3775-a6b5-adb47796d898",
                        "entry_id": "8b7f99e9-2aab-3a34-92dc-07361bcecc7d",
                        "glosses": [
                            "Religieuse chargée de pourvoir aux besoins de fonctionnement d’une abbaye, d’un couvent, d’un monastère."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97adfc86-c3f5-4c8b-8b22-469bf83fb587",
                                "sense_id": "b154df5f-281e-3775-a6b5-adb47796d898",
                                "text": "[une confrérie] est administrée, sous la direction de M. le Curé, par trois Proviseuses qui accomplissent avec un infatigable dévouement la tâche laborieuse de conserver florissante l’œuvre sainte qui leur est confiée."
                            },
                            {
                                "example_id": "f44ab800-3c21-4b1f-ae3a-fe12a9d9693f",
                                "sense_id": "b154df5f-281e-3775-a6b5-adb47796d898",
                                "text": "Il y a eu de tout temps un proviseur ou une proviseuse de la chapelle de la Vierge."
                            }
                        ]
                    },
                    {
                        "sense_id": "b04a7c52-f612-32d7-a6de-c327320a3e2e",
                        "entry_id": "8b7f99e9-2aab-3a34-92dc-07361bcecc7d",
                        "glosses": [
                            "Directrice d’un lycée."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "6ba76d06-fb72-4f44-b5f9-f609edb9dc49",
                                "sense_id": "b04a7c52-f612-32d7-a6de-c327320a3e2e",
                                "text": "Et si on ne pliait pas à cette punition, on filait droit dans le bureau de la proviseuse."
                            }
                        ]
                    },
                    {
                        "sense_id": "c96d8ae2-eeda-3f54-a508-0791b9b0b1b8",
                        "entry_id": "8b7f99e9-2aab-3a34-92dc-07361bcecc7d",
                        "glosses": [
                            "Épouse d’un proviseur."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "c14a0225-ac49-4cf4-b0a2-5e43bc19adbd",
                                "sense_id": "c96d8ae2-eeda-3f54-a508-0791b9b0b1b8",
                                "text": "Je fus reçu par la proviseuse, une grande femme, sèche et maigre, très imposante, qui était flanquée de trois filles de seize à vingt ans."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a5e42080-27b5-4520-829f-93652a6fe43c",
                        "source_entry_id": "8b7f99e9-2aab-3a34-92dc-07361bcecc7d",
                        "source_sense_id": "b04a7c52-f612-32d7-a6de-c327320a3e2e",
                        "source_sense_description": "Directrice d’un lycée",
                        "target_lang_word": "Direktorin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Direktorin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9fd369b0-c9bc-3ed3-90c4-cac6c8d1131e",
                                        "entry_id": "5a019d86-8ec7-3be0-97a1-0972f1864b08",
                                        "glosses": [
                                            "Leiterin einer öffentlichen Institution (Hochschule, Schule, Behörde …)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "675a6edf-7c8a-4587-b858-b34420b0845b",
                                                "sense_id": "9fd369b0-c9bc-3ed3-90c4-cac6c8d1131e",
                                                "text": "Manche öffentliche Einrichtungen werden von einer Direktorin geleitet, so zum Beispiel ein Zoo durch den Zoodirektor."
                                            },
                                            {
                                                "example_id": "95c3d474-a0d2-4095-9d66-56630ac428e9",
                                                "sense_id": "9fd369b0-c9bc-3ed3-90c4-cac6c8d1131e",
                                                "text": "„Dieses Wissen bleibt ihr, auch wenn die 72-jährige Kunsthändlerin, eine der profiliertesten Figuren des Schweizer Auktionsgeschäfts, das Ganthaus Christie’s Ende 2007 verlassen hat, für das sie als Direktorin und zuletzt als Beraterin tätig war."
                                            },
                                            {
                                                "example_id": "20f597ed-333f-4d34-b3c9-4ae45743bbc6",
                                                "sense_id": "9fd369b0-c9bc-3ed3-90c4-cac6c8d1131e",
                                                "text": "„Meine Mutter wurde daraufhin zur Direktorin bestellt.“"
                                            },
                                            {
                                                "example_id": "27b11dc1-1275-428b-acdc-88342a45768a",
                                                "sense_id": "9fd369b0-c9bc-3ed3-90c4-cac6c8d1131e",
                                                "text": "„Die stellvertretende Direktorin drehte noch immer selbstvergessen am Band ihrer Spiegelreflex, die sie um den Hals gehängt hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e2c487ac-d328-3178-8be3-50d8736a1807",
                                        "entry_id": "5a019d86-8ec7-3be0-97a1-0972f1864b08",
                                        "glosses": [
                                            "Leiterin eines Betriebes, eines Betriebsteils, einer oder mehrerer Abteilungen oder Zuständigkeitsbereichen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ecf98f4b-e2f7-4755-b3a4-de426f56662a",
                                                "sense_id": "e2c487ac-d328-3178-8be3-50d8736a1807",
                                                "text": "In einem diesem Betrieb gibt es Direktorinnen für verschiedene Betriebszweige."
                                            },
                                            {
                                                "example_id": "e79dcfe4-4b55-4aaa-b2b6-ee39e59fcab1",
                                                "sense_id": "e2c487ac-d328-3178-8be3-50d8736a1807",
                                                "text": "Mehrere Direktorinnen können ein Direktorium bilden."
                                            },
                                            {
                                                "example_id": "9450a3dc-dd0e-4830-9ad4-d95203942b2b",
                                                "sense_id": "e2c487ac-d328-3178-8be3-50d8736a1807",
                                                "text": "Dem Vorstand sind die Bereichsleiter, Direktoren und Abteilungsdirektorinnen unmittelbar unterstellt. Sie bilden die Spitze der Hierarchie eines Unternehmens."
                                            },
                                            {
                                                "example_id": "f91f2735-848c-4985-a9de-68ac1e9d8620",
                                                "sense_id": "e2c487ac-d328-3178-8be3-50d8736a1807",
                                                "text": "„Eines Nachts wurde die Direktorin wegen Helenas Zimmer alarmiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6b685743-d84b-4d69-a196-48f146d27f39",
                        "source_entry_id": "8b7f99e9-2aab-3a34-92dc-07361bcecc7d",
                        "source_sense_id": "b04a7c52-f612-32d7-a6de-c327320a3e2e",
