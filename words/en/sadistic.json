{
    "word_family": [
        "sadism",
        "sadist"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "09f79883-cb90-37b0-a3ce-6ab68dceab7b",
                    "sense_definition": "Delighting in or feeling pleasure from the pain or humiliation of others.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "cruelty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The villain in the movie was known for his <w>sadistic</w> nature and lack of empathy.",
                            "target_lang_translations": {
                                "ru": "Злодей в фильме был известен своей <w>садистской</w> натурой и полным отсутствием сострадания."
                            }
                        },
                        {
                            "text": "He displayed a <w>sadistic</w> pleasure when watching his rivals struggle during the competition.",
                            "target_lang_translations": {
                                "ru": "Он проявлял <w>садистское</w> удовольствие, наблюдая, как его соперники терпят трудности во время соревнований."
                            }
                        }
                    ],
                    "synonyms": [
                        "cruel",
                        "vicious",
                        "callous"
                    ],
                    "antonyms": [
                        "kind",
                        "compassionate"
                    ],
                    "common_phrases": [
                        "sadistic pleasure",
                        "sadistic nature"
                    ],
                    "target_lang_definitions": {
                        "ru": "Испытывающий удовольствие от чужой боли или унижения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "садистский",
                                "target_lang_sense_clarification": "о человеке, характере или наклонностях"
                            },
                            {
                                "target_lang_word": "садистический",
                                "target_lang_sense_clarification": "испытывающий садистское удовольствие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "78d92069-751b-386a-b65b-e94e7017bf10",
                    "sense_definition": "Of behaviour which gives pleasure in the pain or humiliation of others.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "cruelty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bully engaged in <w>sadistic</w> behavior that left the other children feeling deeply hurt.",
                            "target_lang_translations": {
                                "ru": "Хулиган проявлял <w>садистское</w> поведение, из-за которого другие дети чувствовали себя глубоко уязвлёнными."
                            }
                        },
                        {
                            "text": "Such <w>sadistic</w> behavior is completely unacceptable in any professional or social environment.",
                            "target_lang_translations": {
                                "ru": "Такое <w>садистское</w> поведение совершенно неприемлемо ни в профессиональной, ни в социальной среде."
                            }
                        }
                    ],
                    "synonyms": [
                        "cruel",
                        "malicious"
                    ],
                    "antonyms": [
                        "benevolent"
                    ],
                    "common_phrases": [
                        "sadistic behavior"
                    ],
                    "target_lang_definitions": {
                        "ru": "Свойственный поведению, направленному на получение удовольствия от чужих страданий или унижения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "садистский",
                                "target_lang_sense_clarification": "о поступках и поведении"
                            },
                            {
                                "target_lang_word": "садистический",
                                "target_lang_sense_clarification": "о действиях и поведении"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b8c5adc3-6a99-32d6-87a8-c9a13e4b91db",
                    "sense_definition": "Causing a high degree of pain or humiliation.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "cruelty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The prisoner was subjected to <w>sadistic</w> treatment throughout his long and difficult confinement.",
                            "target_lang_translations": {
                                "ru": "На протяжении всего долгого и тяжёлого заключения пленник подвергался <w>садистскому</w> обращению."
                            }
                        },
                        {
                            "text": "They endured a <w>sadistic</w> ordeal that lasted for several hours under the hot sun.",
                            "target_lang_translations": {
                                "ru": "Они перенесли <w>садистское</w> испытание, которое длилось несколько часов под палящим солнцем."
                            }
                        }
                    ],
                    "synonyms": [
                        "brutal",
                        "inhumane"
                    ],
                    "common_phrases": [
                        "sadistic treatment",
                        "sadistic ordeal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Причиняющий крайнюю боль, страдания или глубокое унижение; чрезвычайно жестокий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "садистский",
                                "target_lang_sense_clarification": "крайне жестокий, бесчеловечный"
                            },
                            {
                                "target_lang_word": "бесчеловечный",
                                "target_lang_sense_clarification": "жестокий, мучительный"
                            },
                            {
                                "target_lang_word": "издевательский",
