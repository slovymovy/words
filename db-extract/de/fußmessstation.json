                ],
                "senses": [
                    {
                        "sense_id": "2839117c-03be-3d94-bfee-991dba9e9175",
                        "entry_id": "5377ba88-09fe-32de-8abd-ff174d716e0f",
                        "glosses": [
                            "Station zum Durchführen von Fußmessungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4de22bb-e8f2-44a8-8433-4e5f00f80e6f",
                                "sense_id": "2839117c-03be-3d94-bfee-991dba9e9175",
                                "text": "So war der Stand der SABU-Konzeption „Laufgut ®“ prominent im Eingangsbereich positioniert, wo Konzeptionsleiter Kay Wegerhoff gleich drei verschiedene Fußmessstationen präsentierte: Die bewährte Laufgut-2D-Station, die neue Laufgut-3D-Station und eine Fußmessstation speziell für Kinderfüße."
                            },
                            {
                                "example_id": "6c29a40e-52d4-4c39-8410-08b39150b3db",
                                "sense_id": "2839117c-03be-3d94-bfee-991dba9e9175",
                                "text": "„[…] Unterhaltungsprogramm für die Kleinen: z.B. der Elefanten Walking Act, eine Malecke für Kinder, ein Fuß-Erlebnisparcours, eine Fußmessstation […]“"
                            },
                            {
                                "example_id": "4ddae71e-2044-406a-af08-024723292b07",
                                "sense_id": "2839117c-03be-3d94-bfee-991dba9e9175",
                                "text": "Tatütata – die lustige Fußmessstation von Salamander fährt vor!"
                            },
                            {
                                "example_id": "89df6c69-b357-4f2f-90ea-dce6254c4fc2",
                                "sense_id": "2839117c-03be-3d94-bfee-991dba9e9175",
                                "text": "Nun hört er gespannt zu, während Andreas König vom Sanitätshaus Kraft ihm die Vorteile der Fußmessstation erläutert."
                            },
                            {
                                "example_id": "143ce5b3-df3d-4cda-9509-a9630d4f50af",
                                "sense_id": "2839117c-03be-3d94-bfee-991dba9e9175",
                                "text": "Ein bunter Parcours aus vielfältigen Stationen wie etwa Gummistiefel-Weitwurf, Flossenrennen und Fußmessstation rund um die Schule sollen spielerisch Lust auf Bewegung machen und das Gemeinschaftsgefühl von Jung und Alt, mit und ohne Handicap, fördern."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
