                {
                    "sense_id": "8e87a910-d2df-3f69-b7c4-0399c013c8aa",
                    "sense_definition": "Feeling or showing fear and concern because you think that something bad has happened or could happen.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "emotion_anxiety",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am really <w>worried</w> about my final exam results.",
                            "target_lang_translations": {
                                "ru": "Я очень <w>обеспокоен</w> результатами моих выпускных экзаменов.",
                                "nl": "Ik ben erg <w>bezorgd</w> over mijn resultaten voor het eindexamen.",
                                "pl": "Naprawdę <w>martwię</w> się o wyniki moich egzaminów końcowych.",
                                "de": "Ich bin wirklich <w>besorgt</w> wegen meiner Prüfungsergebnisse."
                            }
                        },
                        {
                            "text": "She gave him a <w>worried</w> look when he mentioned the cost.",
                            "target_lang_translations": {
                                "ru": "Она бросила на него <w>обеспокоенный</w> взгляд, когда он упомянул цену.",
                                "nl": "Ze wierp hem een <w>bezorgde</w> blik toe toen hij de kosten noemde.",
                                "pl": "Rzuciła mu <w>zaniepokojone</w> spojrzenie, gdy wspomniał o kosztach.",
                                "de": "Sie warf ihm einen <w>besorgten</w> Blick zu, als er die Kosten erwähnte."
                            }
                        }
                    ],
                    "synonyms": [
                        "anxious",
                        "concerned",
                        "uneasy",
                        "apprehensive",
                        "nervous"
