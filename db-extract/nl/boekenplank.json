                        "tags": [],
                        "examples": [
                            {
                                "example_id": "475665e1-8737-4fa5-a37b-42d97f6fcdb8",
                                "sense_id": "cbb1cc68-dc35-3fe8-ac33-4261984ec7c4",
                                "text": "Lee Jae-yong, topman van Samsung, het op een na grootste elektronicabedrijf ter wereld, opgesloten in een cel van 6,56 vierkante meter met een opvouwbaar bed, een tv, een bureautje en een boekenplank. Met verbazing zagen tv-kijkers in Zuid-Korea, China en Japan hoe dinsdagavond Samsungs vicebestuursvoorzitter en op twee na rijkste ondernemer van zijn land geboeid en met gebogen hoofd en gesloten blik werd afgevoerd naar zijn gevangenis."
                            }
                        ]
                    }
