                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "acdd3417-c996-46c1-b6c3-7cce0e9a80f5",
                        "source_entry_id": "3d6ef487-cc89-32c0-8069-9d6e86fc40a8",
                        "source_sense_id": "72540157-4a99-3cc6-9071-52de40da16c0",
                        "source_sense_description": "Versammlung ohne Redebeiträge, um auf ein politisches Anliegen aufmerksam zu machen",
                        "target_lang_word": "protest",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "protest",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "04a50ec1-e2b5-3c36-86eb-959cfc26a745",
                                        "entry_id": "7b6473b1-e816-3ac8-b4b4-fb349b3818c2",
                                        "glosses": [
                                            "To make a strong objection."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "696f9eeb-029c-43a3-89bd-f60fce78c936",
                                                "sense_id": "04a50ec1-e2b5-3c36-86eb-959cfc26a745",
                                                "text": "How dare you, I protest!"
                                            },
                                            {
                                                "example_id": "164a9638-7363-4408-9dff-96d602cea4b9",
                                                "sense_id": "04a50ec1-e2b5-3c36-86eb-959cfc26a745",
                                                "text": "The public took to the streets to protest over the planned change to the law."
                                            },
                                            {
                                                "example_id": "340e4878-4d6b-4088-b52d-5a7b054277d8",
                                                "sense_id": "04a50ec1-e2b5-3c36-86eb-959cfc26a745",
                                                "text": "As a political system democracy seems to me extraordinarily foolish, but I would not go out of my way to protest against it. My servant is, so far as I am concerned, welcome to as many votes as he can get. I would very gladly make mine over to him if I could."
                                            },
                                            {
                                                "example_id": "38e6b7fe-92f5-4ee5-8217-70c8bf933e6d",
                                                "sense_id": "04a50ec1-e2b5-3c36-86eb-959cfc26a745",
                                                "text": "U.S. and European protested against Spanish conduct in Cuba."
                                            },
                                            {
                                                "example_id": "71cbe5bb-5bce-4854-84b6-eb2e7b8fa0e7",
                                                "sense_id": "04a50ec1-e2b5-3c36-86eb-959cfc26a745",
                                                "text": "On November 29 1952, a special train ran from Sunderland to Leeds for Christmas shoppers and those attending a Leeds vs. Brentford match. It caused controversy, with Sunderland traders protesting that their shops were just as good as those in Leeds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a659d694-9b09-32a9-9eb0-7e0e79c21548",
                                        "entry_id": "7b6473b1-e816-3ac8-b4b4-fb349b3818c2",
                                        "glosses": [
                                            "To affirm (something)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d32d200-dda1-4b06-bf65-3b9d4a98dbf9",
                                                "sense_id": "a659d694-9b09-32a9-9eb0-7e0e79c21548",
                                                "text": "I protest my innocence."
                                            },
                                            {
                                                "example_id": "011d6eb1-86f4-4b25-bff2-d0f55d860324",
                                                "sense_id": "a659d694-9b09-32a9-9eb0-7e0e79c21548",
                                                "text": "I do protest and declare …"
                                            },
                                            {
                                                "example_id": "0f1c7f16-c066-4163-8974-1b78ae758085",
                                                "sense_id": "a659d694-9b09-32a9-9eb0-7e0e79c21548",
                                                "text": "I will protest your cowardice."
                                            },
                                            {
                                                "example_id": "99dc3883-8baa-4f4a-a462-636a3203445f",
                                                "sense_id": "a659d694-9b09-32a9-9eb0-7e0e79c21548",
                                                "text": "Our youth, now, emboldened with his success, resolved to push the matter farther, and ventured even to beg her recommendation of him to her father's service; protesting that he thought him one of the honestest fellows in the country, and extremely well qualified for the place of a gamekeeper, which luckily then happened to be vacant."
                                            },
                                            {
                                                "example_id": "c11c6a9e-fcb1-4ccf-ac57-d4a73ec7393b",
                                                "sense_id": "a659d694-9b09-32a9-9eb0-7e0e79c21548",
                                                "text": "She flashed a smile at me, and, protesting an engagement with her dentist, jauntily walked on."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5748621c-7ab9-3ce3-9430-bacb5087fbe1",
                                        "entry_id": "7b6473b1-e816-3ac8-b4b4-fb349b3818c2",
                                        "glosses": [
                                            "To object to."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b95902b9-74c5-45c4-8681-b1af9e8202f0",
                                                "sense_id": "5748621c-7ab9-3ce3-9430-bacb5087fbe1",
                                                "text": "\"The gay community would love to point to Patti and say, 'She's one of us'\" […] I protest the statement I have mentioned, as well as others like it. Few people I know, gay or straight, identify with the often outrageous thoughts of Patti Smith. Among other things, she's indicated in interviews that she thinks violence and rape are dandy experiences."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6636cdaf-4dfa-3484-b7d3-c9c649f4c785",
                                        "entry_id": "7b6473b1-e816-3ac8-b4b4-fb349b3818c2",
                                        "glosses": [
                                            "To publicly demonstrate against."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f395a90c-42b1-4a1c-bb1d-24105eb71945",
                                                "sense_id": "6636cdaf-4dfa-3484-b7d3-c9c649f4c785",
                                                "text": "They protested the demolition of the school."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "daaec877-95b7-3385-9aff-e50a7dddc0bb",
                                        "entry_id": "7b6473b1-e816-3ac8-b4b4-fb349b3818c2",
                                        "glosses": [
                                            "To call as a witness in affirming or denying, or to prove an affirmation; to appeal to."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "834d027b-c8d5-408d-a3a4-af6815397769",
                                                "sense_id": "daaec877-95b7-3385-9aff-e50a7dddc0bb",
                                                "text": "Fiercely [they] opposed / My journey strange, with clamorous uproar / Protesting fate supreme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67f5cc90-22fc-3c36-80b4-5579c5b116cc",
                                        "entry_id": "7b6473b1-e816-3ac8-b4b4-fb349b3818c2",
                                        "glosses": [
                                            "to make a solemn written declaration, in due form, on behalf of the holder, against all parties liable for any loss or damage to be sustained by non-acceptance or non-payment of (a bill or note). This should be made by a notary public, whose seal it is the usual practice to affix."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "92b15d96-1ece-33c5-aad3-c6f34e1f6149",
                                        "entry_id": "7b6473b1-e816-3ac8-b4b4-fb349b3818c2",
                                        "glosses": [
                                            "To publish; to make known."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "protest",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4e7567e2-ebd7-3554-b84f-a0014560f543",
                                        "entry_id": "2516e4de-1b9e-3b62-ab25-95a1ababaf81",
                                        "glosses": [
                                            "A formal objection, especially one by a group."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1028bc43-f9ef-46a8-b8f8-e0605e94851b",
                                                "sense_id": "4e7567e2-ebd7-3554-b84f-a0014560f543",
                                                "text": "They lodged a protest with the authorities."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5687530-8fd0-3123-b1d6-cca7f3bc8987",
                                        "entry_id": "2516e4de-1b9e-3b62-ab25-95a1ababaf81",
                                        "glosses": [
                                            "A collective gesture of disapproval; a demonstration."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8e0c02c-f699-4828-b108-7973f52d0143",
                                                "sense_id": "a5687530-8fd0-3123-b1d6-cca7f3bc8987",
                                                "text": "We held a protest in front of City Hall."
                                            },
                                            {
                                                "example_id": "0b844ffc-2509-4a52-a8fe-0182be6d76cc",
                                                "sense_id": "a5687530-8fd0-3123-b1d6-cca7f3bc8987",
                                                "text": "All this has led to an explosion of protest across China, including among a middle class that has discovered nimbyism."
                                            },
                                            {
                                                "example_id": "a795746d-0f37-4484-9120-e6aca09daecd",
                                                "sense_id": "a5687530-8fd0-3123-b1d6-cca7f3bc8987",
                                                "text": "Sage Ip, a 29-year-old flight attendant who cast her ballot on Sunday in the Sai Ying Pun district, said she voted in the primary because she was worried that she would never get a chance to do so again. “Voting is something that is still within our capacity. We can’t express ourselves at protests anymore.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08973dda-e5b6-3b5c-a372-4c7b22fa0d55",
                                        "entry_id": "2516e4de-1b9e-3b62-ab25-95a1ababaf81",
                                        "glosses": [
                                            "The noting by a notary public of an unpaid or unaccepted bill."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7398bd08-f414-30cb-800a-16743ee02649",
                                        "entry_id": "2516e4de-1b9e-3b62-ab25-95a1ababaf81",
                                        "glosses": [
                                            "A written declaration, usually by the master of a ship, stating the circumstances attending loss or damage of ship or cargo, etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
