            {
                "entry_id": "152b0b90-80c9-328a-b818-2a6bdb1bb05a",
                "word": "Mélanie",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b8456f60-adb7-36f6-8b50-5d931277df13",
                        "entry_id": "152b0b90-80c9-328a-b818-2a6bdb1bb05a",
                        "glosses": [
                            "Prénom féminin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ded627b-6543-4947-803b-7687a64190aa",
                                "sense_id": "b8456f60-adb7-36f6-8b50-5d931277df13",
                                "text": "Délicate, jolie et spirituelle, mariée en province exprès par sa mère, qui ne la voulait point près d’elle, et l’avait tirée de son pensionnat quelques jours avant son mariage, Mélanie Roguin se considérait comme en exil à Provins, et s’y conduisait admirablement bien."
                            },
                            {
                                "example_id": "3b322a01-2a29-4f9d-919c-ad146fb9f690",
                                "sense_id": "b8456f60-adb7-36f6-8b50-5d931277df13",
                                "text": "Lorsque moins gros, moins laid, il essayait de faire son muguet, l’ombre s’appelait Mélanie : prénom vieillot, ancillaire et porté en effet dans le style « je suis votre servante » par une petite cousine."
                            },
                            {
                                "example_id": "f81cb9b5-e703-484c-890f-67b17efe84eb",
                                "sense_id": "b8456f60-adb7-36f6-8b50-5d931277df13",
                                "text": "Tout en haut de la hiérarchie, trône la femme de charge de la douairière, Mélanie, qui a les clefs et l’oreille de Madame, et que chacun fuit comme la peste."
                            },
                            {
                                "example_id": "c6c57470-815a-4211-9d30-0c3eefb4acf2",
                                "sense_id": "b8456f60-adb7-36f6-8b50-5d931277df13",
                                "text": "Je pars confiant car je sais que Mélanie m’attend."
                            },
                            {
                                "example_id": "968e01cb-4282-488c-8e45-af967a6fa328",
                                "sense_id": "b8456f60-adb7-36f6-8b50-5d931277df13",
                                "text": "En parlant de cœur, citons Les Petites Victoires, de Mélanie Auffret, qui a obtenu le Prix spécial du jury et le Prix du public."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "88230e2a-344a-4702-aa9f-3181e647ade0",
                        "source_entry_id": "152b0b90-80c9-328a-b818-2a6bdb1bb05a",
