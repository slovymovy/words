{
    "word_family": [
        "podchodzić",
        "podejście"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4856f88d-00ca-3f3f-ae95-8bf502cd985d",
                    "sense_definition": "Zbliżyć się do kogoś lub czegoś, idąc w tamtym kierunku.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "movement_approach",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mężczyzna <w>podszedł</w> do recepcji, aby odebrać klucze do pokoju.",
                            "target_lang_translations": {
                                "ru": "Мужчина <w>подошёл</w> к стойке регистрации, чтобы забрать ключи от номера.",
                                "en": "The man <w>walked up</w> to the reception desk to collect his room keys."
                            }
                        },
                        {
                            "text": "Czy możesz <w>podejść</w> tu na chwilę i mi pomóc?",
                            "target_lang_translations": {
                                "ru": "Ты можешь <w>подойти</w> сюда на минутку и помочь мне?",
                                "en": "Can you <w>come over</w> here for a moment and help me?"
                            }
                        }
                    ],
                    "synonyms": [
                        "zbliżyć się"
                    ],
                    "antonyms": [
                        "odejść",
                        "oddalić się"
                    ],
                    "common_phrases": [
                        "podejść do okna",
                        "podejść bliżej",
                        "podejść do lady"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приблизиться к кому-либо или чему-либо, идя в этом направлении.",
                        "en": "To come near or walk up to someone or something."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подойти",
                                "target_lang_sense_clarification": "приблизиться"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "come up",
                                "target_lang_sense_clarification": "to walk over towards someone or something"
                            },
                            {
                                "target_lang_word": "approach",
                                "target_lang_sense_clarification": "to draw near in physical space"
                            },
                            {
                                "target_lang_word": "walk up",
                                "target_lang_sense_clarification": "to walk towards someone"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9a92d859-343c-3822-8790-e470caf38eac",
                    "sense_definition": "Przystąpić do egzaminu lub sprawdzianu w celu uzyskania oceny lub kwalifikacji.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wszyscy uczniowie w naszej szkole <w>podejdą</w> do matury w maju.",
                            "target_lang_translations": {
                                "ru": "Все ученики нашей школы будут <w>сдавать</w> выпускные экзамены в мае.",
                                "en": "All students at our school will <w>take</w> the high school graduation exam in May."
                            }
                        },
                        {
                            "text": "Niestety nie udało mi się <w>podejść</w> do tego testu w pierwszym terminie.",
                            "target_lang_translations": {
                                "ru": "К сожалению, мне не удалось <w>сдать</w> этот тест в первый срок.",
                                "en": "Unfortunately, I wasn't able to <w>sit</w> this test on the first date."
                            }
                        }
                    ],
                    "synonyms": [
                        "przystąpić"
                    ],
                    "common_phrases": [
                        "podejść do egzaminu",
                        "podejść do matury",
                        "podejść do poprawki"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приступить к экзамену или тесту для получения оценки или квалификации.",
                        "en": "To take or sit an exam or test."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сдавать",
                                "target_lang_sense_clarification": "экзамен"
                            },
                            {
                                "target_lang_word": "приступить",
                                "target_lang_sense_clarification": "начать выполнение"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "take",
                                "target_lang_sense_clarification": "an exam or test"
                            },
                            {
                                "target_lang_word": "sit",
                                "target_lang_sense_clarification": "an exam (British English)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7109515c-6b39-38bf-b201-f65969cac435",
                    "sense_definition": "Wejść na wzniesienie lub górę; pokonać pewien odcinek drogi pod górę.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "movement_climb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Turyści musieli <w>podejść</w> kawałek pod stromą górę, aby zobaczyć widok.",
                            "target_lang_translations": {
                                "ru": "Туристам пришлось немного <w>подняться</w> по крутой горе, чтобы увидеть вид.",
                                "en": "The tourists had to <w>hike up</w> the steep mountain for a bit to see the view."
                            }
                        },
                        {
                            "text": "Udało nam się <w>podejść</w> pod schronisko tuż przed zachodem słońca.",
                            "target_lang_translations": {
                                "ru": "Нам удалось <w>подняться</w> к приюту как раз перед закатом.",
                                "en": "We managed to <w>walk up</w> to the mountain hut just before sunset."
                            }
                        }
                    ],
                    "synonyms": [
                        "wejść",
                        "wspiąć się"
                    ],
                    "antonyms": [
                        "zejść"
                    ],
                    "common_phrases": [
                        "podejść pod górę",
                        "podejść pod szczyt"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подняться на возвышенность или гору; преодолеть определенный участок пути вверх.",
                        "en": "To walk uphill or hike up towards a hill or mountain."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подняться",
                                "target_lang_sense_clarification": "вверх, в гору"
                            },
                            {
                                "target_lang_word": "взойти",
                                "target_lang_sense_clarification": "на вершину"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "hike up",
                                "target_lang_sense_clarification": "to walk uphill"
                            },
                            {
                                "target_lang_word": "walk up",
                                "target_lang_sense_clarification": "to ascend on foot"
                            },
                            {
                                "target_lang_word": "ascend",
                                "target_lang_sense_clarification": "to climb or go up on foot"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3765c04f-6f3f-315b-bc91-600f0efbac8b",
                    "sense_definition": "Zbliżyć się do kogoś lub czegoś ostrożnie i niepostrzeżenie, często w celu schwytania.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement_stalk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kot cicho <w>podszedł</w> ptaka siedzącego na niskim płocie.",
                            "target_lang_translations": {
                                "ru": "Кот тихо <w>подкрался</w> к птице, сидящей на низком заборе.",
                                "en": "The cat quietly <w>stalked</w> the bird sitting on the low fence."
                            }
                        },
                        {
                            "text": "Myśliwy starał się <w>podejść</w> zwierzynę pod wiatr, aby nie zostać wyczutym.",
                            "target_lang_translations": {
                                "ru": "Охотник старался <w>подойти</w> к зверю против ветра, чтобы его не учуяли.",
                                "en": "The hunter tried to <w>sneak up on</w> the game upwind so as not to be detected."
                            }
                        }
                    ],
                    "synonyms": [
                        "podkraść się",
                        "zakraść się"
                    ],
                    "common_phrases": [
                        "podejść zwierzynę",
                        "podejść wroga"
                    ],
                    "target_lang_definitions": {
                        "ru": "Осторожно и незаметно приблизиться к кому-либо или чему-либо, часто с целью поимки.",
                        "en": "To creep up on or stalk someone or something carefully and unnoticed."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подкрасться",
                                "target_lang_sense_clarification": "незаметно"
                            },
                            {
                                "target_lang_word": "подойти",
                                "target_lang_sense_clarification": "охотн. к зверю"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "stalk",
                                "target_lang_sense_clarification": "to pursue game or prey stealthily"
                            },
                            {
                                "target_lang_word": "sneak up on",
                                "target_lang_sense_clarification": "to approach stealthily"
                            },
                            {
                                "target_lang_word": "creep up on",
                                "target_lang_sense_clarification": "to quietly advance on prey or target"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "75722544-92ba-3d92-b064-46b5aaedf11c",
                    "sense_definition": "Napełnić się lub nabiec cieczą, taką jak krew, ropa lub woda (często o częściach ciała).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jej oczy <w>podeszły</w> łzami, gdy usłyszała tę smutną wiadomość.",
                            "target_lang_translations": {
                                "ru": "Её глаза <w>наполнились</w> слезами, когда она услышала эту печальную новость.",
                                "en": "Her eyes <w>welled up</w> with tears when she heard the sad news."
                            }
                        },
                        {
                            "text": "Rana na nodze była głęboka i szybko <w>podeszła</w> krwią.",
                            "target_lang_translations": {
                                "ru": "Рана на ноге была глубокой и быстро <w>налилась</w> кровью.",
                                "en": "The wound on the leg was deep and quickly <w>filled</w> with blood."
                            }
                        }
                    ],
                    "synonyms": [
                        "nabiec"
                    ],
                    "common_phrases": [
                        "podejść krwią",
                        "podejść łzami",
                        "podejść ropą"
                    ],
                    "target_lang_definitions": {
                        "ru": "Наполниться жидкостью, такой как кровь, гной или вода (часто о частях тела).",
                        "en": "To fill or swell with fluid, such as tears or blood."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "налиться",
                                "target_lang_sense_clarification": "кровью"
                            },
                            {
                                "target_lang_word": "наполниться",
                                "target_lang_sense_clarification": "слезами"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "fill with",
                                "target_lang_sense_clarification": "of eyes with tears, or a wound with blood"
                            },
                            {
                                "target_lang_word": "well up with",
                                "target_lang_sense_clarification": "of eyes filling with tears"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d67d3139-2ee5-31cb-94a1-7f6e15fca8ad",
                    "sense_definition": "Forma dopełniacza liczby mnogiej rzeczownika <w>podejście</w>.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mamy kilka różnych <w>podejść</w> do rozwiązania tego trudnego problemu.",
                            "target_lang_translations": {
                                "ru": "У нас есть несколько разных <w>подходов</w> к решению этой сложной проблемы.",
                                "en": "We have several different <w>approaches</w> to solving this difficult problem."
                            }
                        },
                        {
                            "text": "Analiza tych dwóch <w>podejść</w> zajmie nam trochę czasu.",
                            "target_lang_translations": {
                                "ru": "Анализ этих двух <w>подходов</w> займет у нас некоторое время.",
                                "en": "Analyzing these two <w>approaches</w> will take us some time."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "genitive plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма родительного падежа множественного числа существительного 'podejście' (подход).",
                        "en": "Genitive plural form of the noun 'podejście' (approaches, attempts)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подходов",
                                "target_lang_sense_clarification": "родительный падеж мн. ч."
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "approaches",
                                "target_lang_sense_clarification": "genitive plural form"
                            },
                            {
                                "target_lang_word": "attempts",
                                "target_lang_sense_clarification": "genitive plural form"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}