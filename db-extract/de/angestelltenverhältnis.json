                "senses": [
                    {
                        "sense_id": "3014c3ee-c9ed-387d-bc18-9d8d0da82235",
                        "entry_id": "c77d516d-1850-3dea-b071-08e7bc6e6461",
                        "glosses": [
                            "vertragliche Beziehung zwischen Arbeitgeber und Arbeitnehmer mit monatlicher Gehaltsauszahlung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c2f02b5-668d-48ed-8220-e3eafd46afba",
                                "sense_id": "3014c3ee-c9ed-387d-bc18-9d8d0da82235",
                                "text": "„Einen Beruf im Angestelltenverhältnis streben 29,7 Prozent an, gefolgt von der Beamtenlaufbahn (12,6 Prozent) und dem Wunsch, Unternehmer zu werden (11,8 Prozent).“"
                            },
                            {
                                "example_id": "2eb4ae0f-a856-4adf-83cd-9c8eeabe512b",
                                "sense_id": "3014c3ee-c9ed-387d-bc18-9d8d0da82235",
                                "text": "„Es wurde debattiert, ob jeder, der sich zu Wort melde, vorher sagen müsse, ob er in einem Angestelltenverhältnis zu welchem AfD-Politiker stehe und in wessen Auftrag er damit mutmaßlich spreche – ein Indiz für das Misstrauen im Landesverband.“"
                            },
                            {
                                "example_id": "6dc9ba83-6cfb-4b66-8c90-f89795d52850",
                                "sense_id": "3014c3ee-c9ed-387d-bc18-9d8d0da82235",
                                "text": "„Der amerikanische Begriff der Professionals bezeichnet die Berufe, die eine naturwissenschaftliche Spezialisierung beinhalten, wie z. B. Ingenieure, Chemiker, Softwaretechniker, die aber im Angestelltenverhältnis stehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
