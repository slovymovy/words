                                    {
                                        "sense_id": "1c6f9221-dae8-382c-8f26-3820b7aa84be",
                                        "entry_id": "6282f035-2c75-360c-9bfd-8b0e6f960597",
                                        "glosses": [
                                            "Pays insulaire du golfe Persique dont la capitale est Manama."
                                        ],
                                        "tags": [
                                            "Pays"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0005c3f-0096-45c1-87da-ce3d997d2c36",
                                                "sense_id": "1c6f9221-dae8-382c-8f26-3820b7aa84be",
                                                "text": "Il existe un chemin, dit Édrisi, pour se rendre, en suivant le littoral de l’Oman, à Bahreïn. Il passe par Sohar, Damar, Mascat, El-Djebel et Djolfar, lieux où sont des pêcheries de perles."
                                            },
                                            {
                                                "example_id": "cc8d692c-5807-4a16-a9ff-b2905cf8e1f4",
                                                "sense_id": "1c6f9221-dae8-382c-8f26-3820b7aa84be",
                                                "text": "Stroll n'a pas voulu trop s'avancer sur la suite de cette saison qui doit compter 23 courses, surtout après qu'on lui ait fait remarquer que le cirque de la F1 se dirigera vers l'Europe après la course à Bahreïn."
                                            },
                                            {
                                                "example_id": "208547d6-af50-47ad-aba9-e5401ee8fe9d",
                                                "sense_id": "1c6f9221-dae8-382c-8f26-3820b7aa84be",
                                                "text": "Je pense qu’il est trop tôt pour tirer des conclusions sur notre état de forme, confiait Mike Krack, le patron d’Aston Martin, à l’issue de la course à Bahreïn."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d88fef97-2159-42a7-902c-cba33cd67942",
                        "source_entry_id": "c8de458f-df11-3e42-848b-81a45e9880fc",
                        "source_sense_id": "85550b7c-d58c-30ae-a207-9b98e9b96554",
