                            {
                                "example_id": "e6a9c6a1-f410-44b2-9621-81d79fe26435",
                                "sense_id": "7c7d08c3-cf78-3d09-bbda-9866064d3002",
                                "text": "„Das Verteidigungsministerium von Taiwan erklärte Samstagfrüh, neun chinesische Kampfjets und eine Militärdrohne seien in den letzten 24 Stunden über die Mittellinie geflogen.“"
                            },
                            {
                                "example_id": "ce4c94e4-3758-4c42-8c67-190a48e0a8d6",
                                "sense_id": "7c7d08c3-cf78-3d09-bbda-9866064d3002",
                                "text": "„Nach dem Absturz einer unbemannten Militärdrohne über dem Schwarzen Meer hat das amerikanische Militär Bildmaterial von dem Vorfall veröffentlicht.“"
                            }
