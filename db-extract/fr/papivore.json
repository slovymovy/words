                                        "glosses": [
                                            "Any of various insects that infest books."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6cbb5f02-0f57-34f0-b7c4-bd4e115a06bb",
                                        "entry_id": "dcc83b75-7ca7-3a71-9bef-aba35ed01187",
                                        "glosses": [
                                            "An avid book reader."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95bb8eda-c339-4711-939e-034f4b543698",
                                                "sense_id": "6cbb5f02-0f57-34f0-b7c4-bd4e115a06bb",
                                                "text": "“This,” remarked the sedate observer beside me, “is a bookworm,—one of those men who are born to gnaw dead thoughts. His clothes, you see, are covered with the dust of libraries."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
