                "senses": [
                    {
                        "sense_id": "490f5a89-72f4-30d6-952e-7dc24a7214f5",
                        "entry_id": "9314935c-f3c5-3609-b115-82571f97c6a2",
                        "glosses": [
                            "Personne stricte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c2690f4-89ff-4952-90a8-18493f96b6f1",
                                "sense_id": "490f5a89-72f4-30d6-952e-7dc24a7214f5",
                                "text": "Un monsieur arrive, mince, un peu raide, maigre, avec un peu de barbe, ni petit ni grand, un pète-sec ;"
                            }
                        ]
                    },
                    {
                        "sense_id": "b129354e-4c7c-3095-b75a-2780b902fe8e",
                        "entry_id": "9314935c-f3c5-3609-b115-82571f97c6a2",
                        "glosses": [
                            "Personne autoritaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ddf6b98-6fbc-4e21-b900-16ca3632c29b",
                                "sense_id": "b129354e-4c7c-3095-b75a-2780b902fe8e",
                                "text": "Tous rigolèrent de la faim du capitaine, qui n’avait pas su se faire aimer de ses hommes, trop jeune et trop dur, un pète- sec, comme ils l’appelaient."
                            },
                            {
                                "example_id": "9dfe30b3-4caa-40bd-87f9-d264ee9f1f59",
                                "sense_id": "b129354e-4c7c-3095-b75a-2780b902fe8e",
                                "text": "Ce n'est pas parce que Victoria était une pète-sec que Londres se dote des urinoirs les plus parfaits..."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3a2d5cf8-1254-44bc-bc4d-11822b6e4326",
                        "source_entry_id": "9314935c-f3c5-3609-b115-82571f97c6a2",
                        "source_sense_description": "personne sèche",
                        "target_lang_word": "droogstoppel",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "droogstoppel",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "d20e7c76-651a-3c67-b157-2c62defc0120",
                                        "entry_id": "472bacd1-cb7d-30f5-8261-0c4b8f362bf4",
                                        "glosses": [
                                            "een saai, vervelend, schijnheilig en fantasieloos persoon (oftewel een typische Hollandse koopman)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1bd4bc39-d90a-43bf-b145-ded020d24d2c",
                                                "sense_id": "d20e7c76-651a-3c67-b157-2c62defc0120",
                                                "text": "Droogstoppelige factcheckers hebben later gaten geschoten in dit reisverhaal. Ze wijzen erop dat Jezus volgens de evangelist Matteüs is geboren toen Herodes regeerde als koning der Joden; die is in het jaar 4 vóór Christus gestorven. Dit klopt niet met de volkstelling uit het Lucas-verhaal, die waarschijnlijk is gehouden in 6 ná Christus. En om het nog ingewikkelder te maken: onze christelijke jaartelling, die bij Jezus’ geboorte begint, berust sowieso op een rekenfout die een Bulgaarse monnik, Dionysius Exigeus, ook wel Dennis de Dwerg genoemd, in het jaar 525 heeft gemaakt. Algemeen wordt nu aangenomen dat Jezus is geboren in het jaar 6 vóór Christus."
                                            },
                                            {
                                                "example_id": "86cf7637-cba4-4365-86cc-86aa47b4c80a",
                                                "sense_id": "d20e7c76-651a-3c67-b157-2c62defc0120",
                                                "text": "Dwars door het relaas over de aanleg van paden en gazons loopt in De tuin die wij maakten het verhaal over de strijd tussen Margery en haar 'brute droogstoppel van een man'. De tuin was het slagveld waarop zij elkaar over de hoofden van hun bloemen heen bevochten. Ze vinden elkaar in hun liefde voor planten, maar over de inrichting van de tuin hebben ze zeer verschillende opvattingen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
