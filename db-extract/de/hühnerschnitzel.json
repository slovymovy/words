                "senses": [
                    {
                        "sense_id": "9ecb1fb6-02ee-329a-b9c6-b72651090e7b",
                        "entry_id": "8d7a9ae5-4e4d-3da8-b566-1347c8384096",
                        "glosses": [
                            "Schnitzel, zubereitet aus dem Fleisch eines Huhnes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc7cdaed-7a43-44c3-9470-223763d627f0",
                                "sense_id": "9ecb1fb6-02ee-329a-b9c6-b72651090e7b",
                                "text": "„Sie lieferten sich eine wilde Schlacht um die Hühnerschnitzel, die zum Auftauen auf der Abtropftasse der Abwasch lagen.“"
                            },
                            {
                                "example_id": "e81c0b8a-9497-4ab8-92ab-c84ee106db16",
                                "sense_id": "9ecb1fb6-02ee-329a-b9c6-b72651090e7b",
                                "text": "„Er und seine Kollegen äßen oft Tortillas, weil es auf der ISS kein Brot gebe. ‚Wir haben Fleisch, und was ich am liebsten mag sind Hühnerschnitzel.‘“"
                            },
                            {
                                "example_id": "e14a86f5-d20c-4b1e-a23b-b400dd0df1d6",
                                "sense_id": "9ecb1fb6-02ee-329a-b9c6-b72651090e7b",
                                "text": "„Laut Waitz ist also das Hühnerschnitzel oder das Schweinskotelett in der Kantine, dem Wirtshaus ums Eck oder dem Schnellimbiss in vielen Fällen mit multiresistenten Keimen belastet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
