                    {
                        "sense_id": "0e1ca6fd-0813-342c-a093-e200a9333a85",
                        "entry_id": "7b98637b-6afc-30af-ba6d-36961d8848f0",
                        "glosses": [
                            "Relatif à l’Aalénien, étage supérieur du Jurassique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "819f2cb3-c909-4fbc-96f4-e3c98e350c92",
                                "sense_id": "0e1ca6fd-0813-342c-a093-e200a9333a85",
                                "text": "Un éclat retouché en silex noir (Jurassique inf. aalénien ?) débité sur une hache polie (fig. 34, nᵒ 2) et le petit galet d’hématite complètent cet inventaire."
                            },
                            {
                                "example_id": "fffea98c-48fc-4eb5-a440-fb9bd6a95853",
                                "sense_id": "0e1ca6fd-0813-342c-a093-e200a9333a85",
                                "text": "C’est dans les marnes aaléniennes du talus de la route, sous le château, que je découvrirai les premières ammonites."
                            }
                        ]
                    }
                ],
