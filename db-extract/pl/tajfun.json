                                        "entry_id": "6e8dab1b-110e-3d64-9a0f-0a50ff33483c",
                                        "glosses": [
                                            "mohutná tropická cyklóna s ničivými účinky uprostřed"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57878bd0-1f94-4629-86ff-bc33c6eed9b5",
                                                "sense_id": "4cd5de2a-cceb-32b0-8aec-5e0e18036a2a",
                                                "text": "Krajinou se prohnal tajfun."
