                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "continuation",
                                "target_lang_sense_clarification": "the state of continuing"
                            },
                            {
                                "target_lang_word": "persistence",
                                "target_lang_sense_clarification": "the ongoing existence of an event or condition"
                            }
                        ]
                    }
                }
