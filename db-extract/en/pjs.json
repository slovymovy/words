                                "example_id": "a648f551-4131-4615-9b2b-1970c64e4d84",
                                "sense_id": "3a5d46ce-6e78-39fa-be47-e059f1318d1b",
                                "text": "We lived in the PJs, that's what we called the projects. It was integrated. The people next door were white, and there weren't that many blacks […]"
                            },
                            {
                                "example_id": "6d27a360-94ba-45d0-aa21-416e4af4edf0",
                                "sense_id": "3a5d46ce-6e78-39fa-be47-e059f1318d1b",
                                "text": "He had to win over the children in the PJs. Come rain or shine, he continued to walk his parish."
                            }
                        ]
