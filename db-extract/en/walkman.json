                                "target_senses": [
                                    {
                                        "sense_id": "3cc73e09-7b8a-3b52-8818-2ebe7fd1e70d",
                                        "entry_id": "ac2cecc7-f1c6-30c6-b950-3d98cae9dfc4",
                                        "glosses": [
                                            "Qui se balade."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
