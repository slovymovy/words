                    "sense_id": "b3f43321-e389-3f99-896b-215868be5f8a",
                    "sense_definition": "Vloeibaar gerecht dat bereid wordt door ingrediënten zoals groenten en vlees in water of bouillon te koken.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik eet graag een kom warme <w>soep</w> als lunch.",
                            "target_lang_translations": {
                                "en": "I like to eat a bowl of hot <w>soup</w> for lunch.",
                                "ru": "Я люблю съесть тарелку горячего <w>супа</w> на обед.",
                                "pl": "Chętnie jem miskę ciepłej <w>zupy</w> na obiad.",
                                "de": "Ich esse mittags gerne eine Schüssel warme <w>Suppe</w>.",
                                "fr": "J'aime manger un bol de <w>soupe</w> chaude pour le déjeuner.",
                                "it": "Mi piace mangiare una ciotola di <w>zuppa</w> calda a pranzo.",
                                "cs": "K obědu si rád dávám misku teplé <w>polévky</w>.",
                                "tr": "Öğle yemeğinde bir kase sıcak <w>çorba</w> içmeyi severim.",
                                "es": "Me gusta comer un tazón de <w>sopa</w> caliente para el almuerzo."
                            }
                        },
                        {
                            "text": "Mijn moeder maakt elke zondag verse <w>soep</w>.",
                            "target_lang_translations": {
                                "en": "My mother makes fresh <w>soup</w> every Sunday.",
                                "ru": "Моя мама каждое воскресенье готовит свежий <w>суп</w>.",
                                "pl": "Moja mama w każdą niedzielę gotuje świeżą <w>zupę</w>.",
                                "de": "Meine Mutter macht jeden Sonntag frische <w>Suppe</w>.",
                                "fr": "Ma mère prépare de la <w>soupe</w> fraîche tous les dimanches.",
                                "it": "Mia madre prepara la <w>zuppa</w> fresca ogni domenica.",
                                "cs": "Moje maminka dělá každou neděli čerstvou <w>polévku</w>.",
                                "tr": "Annem her pazar taze <w>çorba</w> yapar.",
                                "es": "Mi madre hace <w>sopa</w> fresca todos los domingos."
                            }
                        }
                    ],
