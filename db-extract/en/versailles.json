                    },
                    {
                        "sense_id": "407b8fbd-efc8-33cb-a5bb-4a8ec15d2cb6",
                        "entry_id": "912f8ff0-e582-3d2d-9de7-4b5a9a626737",
                        "glosses": [
                            "The Treaty of Versailles (1919)."
                        ],
