                        "sense_id": "f81a7062-09e8-343a-8908-8d47c1632acd",
                        "entry_id": "752ed009-1a9e-3f64-85af-1a3df01c418f",
                        "glosses": [
                            "op een ongezonde manier opgezwollen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c81aa1a-8397-45eb-968c-5710b4e9a488",
                                "sense_id": "f81a7062-09e8-343a-8908-8d47c1632acd",
                                "text": "De familie Simons kan in het Zwitserse Sankt Gallen op krachten komen en keert in de zomer terug naar bevrijd Nederland. 'Pa is nog mager, Ma is nog paffig van hongeroedeem, maar Jan zien er alweer best uit', schrijft Ida bij een foto voor het Haagse pension waar ze de eerste weken bivakkeren."
                            },
                            {
                                "example_id": "68253dbe-464e-4eed-abb6-8a31d94826a0",
                                "sense_id": "f81a7062-09e8-343a-8908-8d47c1632acd",
                                "text": "De overtollige ballast geeft Bill Clinton en Bill Richardson het uiterlijk van een kwajongen, maar dat geldt helaas niet voor Gore. Te veel kaasburgers en ijscoupes hebben hem opgeblazen en paffig gemaakt."
                            }
                        ]
                    }
