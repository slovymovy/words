                "senses": [
                    {
                        "sense_id": "e35d5291-0c45-3b71-a5ed-528ba86866ea",
                        "entry_id": "6465bd8b-54c0-3eef-b814-86a9e91ae058",
                        "glosses": [
                            "Of or relating to the wall of a body part, organ or cavity."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39fccc6b-32bd-4498-9313-6cc50cbf3e34",
                                "sense_id": "e35d5291-0c45-3b71-a5ed-528ba86866ea",
                                "text": "Hydrochloric acid is secreted by the parietal cells of the gastric glands, located on the wall of the fundus of the stomach."
                            },
                            {
                                "example_id": "a7de4434-26f0-49ab-a0b3-303336601c74",
                                "sense_id": "e35d5291-0c45-3b71-a5ed-528ba86866ea",
                                "text": "The superior aspect of the supramarginal gyrus lies underneath the euryon, which corresponds to the most prominent point of the parietal tuberosity or bossa […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "fe0b9dcb-35f5-3e9f-9423-fc45e7c591b5",
                        "entry_id": "6465bd8b-54c0-3eef-b814-86a9e91ae058",
                        "glosses": [
                            "Of or relating to the parietal bones."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "56924803-d4dd-3bc4-830a-8a5c039a8de9",
                        "entry_id": "6465bd8b-54c0-3eef-b814-86a9e91ae058",
                        "glosses": [
                            "Of or relating to college living and, especially, its regulation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a13ac6d2-2d7c-40db-bc13-8b18790cc7d0",
                                "sense_id": "56924803-d4dd-3bc4-830a-8a5c039a8de9",
                                "text": "At Harvard College, the officers resident within the college walls constitute a permanent standing committee, called the Parietal Committee."
                            }
                        ]
                    },
                    {
                        "sense_id": "bde18853-ad6b-3bc1-9be5-6e7cdd067277",
                        "entry_id": "6465bd8b-54c0-3eef-b814-86a9e91ae058",
                        "glosses": [
                            "Attached to the main wall of the ovary, and not to the axis; said of a placenta."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "64bb0272-11de-4b7d-a317-8d0aca0df049",
                        "source_entry_id": "6465bd8b-54c0-3eef-b814-86a9e91ae058",
                        "source_sense_description": "of or relating to the wall of a body part, organ or cavity",
                        "target_lang_word": "pariétal",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pariétal",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "38b88c3e-f750-3d03-8796-a35c9e5aa3c8",
                                        "entry_id": "945acbee-d72b-31b5-9d29-68ec3d5a04ef",
                                        "glosses": [
                                            "Qui a rapport à une paroi, à un mur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ed6b03b-b80e-40c5-a02c-92dff07f32c5",
                                                "sense_id": "38b88c3e-f750-3d03-8796-a35c9e5aa3c8",
                                                "text": "Au gré de Fleurissoire cette ampoule bleue versait trop de lumière encore ; il donna un tour de plus à la clavette ; la veilleuse s’éteignit, mais s’allumèrent aussitôt deux appliques pariétales, plus désobligeantes que le lustre du milieu ; un tour encore, et la veilleuse de nouveau : il s’y tint."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "abf5d123-1ea3-3d97-8643-9bbfac77f95a",
                                        "entry_id": "945acbee-d72b-31b5-9d29-68ec3d5a04ef",
                                        "glosses": [
                                            "Se dit d’un art que l’on trouve réalisé sur les parois d’une grotte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c124e98-8ccd-457d-bf16-5e47efdb7d95",
                                                "sense_id": "abf5d123-1ea3-3d97-8643-9bbfac77f95a",
                                                "text": "Les grottes les plus connues dans lesquelles on peut admirer de l’art pariétal sont Lascaux (France, Dordogne) et Altamira (Nord de l’Espagne.)"
                                            },
                                            {
                                                "example_id": "463fc328-db7a-4248-8b56-005cdb00833d",
                                                "sense_id": "abf5d123-1ea3-3d97-8643-9bbfac77f95a",
                                                "text": "Au cours du temps […] apparaissent des rudiments d’activité religieuse et esthétique qui se développent au Paléolithique supérieur […] par un art pariétal puissamment naturaliste et mythique."
                                            },
                                            {
                                                "example_id": "cc9b95d1-eac8-4c3d-bc3f-5d632a10f8a0",
                                                "sense_id": "abf5d123-1ea3-3d97-8643-9bbfac77f95a",
                                                "text": "Ses découvreurs, des archéologues de l'Université de Guangzhou, en Chine, et de l'Université de Bournemouth, au Royaume-Uni, estiment que ces empreintes datant de 169 000 à 226 000 ans sont les plus anciennes traces d’art pariétal jamais découvertes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5253339f-008a-326c-95f3-bbda1684e33d",
                                        "entry_id": "945acbee-d72b-31b5-9d29-68ec3d5a04ef",
                                        "glosses": [
                                            "Se dit d’un art que l’on trouve réalisé sur les parois d’un chemin encaissé, comme par exemple une voie de chemin de fer à ciel ouvert, située en contrebas de son environnement."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84b9bc85-37a8-42bc-bbfc-8fb5dba4eb7e",
                                                "sense_id": "5253339f-008a-326c-95f3-bbda1684e33d",
                                                "text": "On n’y entre vraiment de plain-pied, Val-d’Oise inclus, que par les trains de la gare du Nord, en enfilant ces longs corridors sinistres que sont les voies ferrées de la région parisienne, couvertes d’inscriptions pariétales indéchiffrables et de graffitis agressifs comme des pitbulls déchaînés prêts à sauter à la gorge du voyageur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b416321-1e62-3319-b806-7bea0db9daa8",
                                        "entry_id": "945acbee-d72b-31b5-9d29-68ec3d5a04ef",
                                        "glosses": [
                                            "Qui s’insère dans la paroi d’une partie voisine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "318cfa01-5c16-4988-961a-ead4bf11bf22",
                                                "sense_id": "6b416321-1e62-3319-b806-7bea0db9daa8",
                                                "text": "Insertion pariétale : Insertion des étamines sur le calice."
                                            },
                                            {
                                                "example_id": "aa06bc79-81d9-4415-b7b2-2236d5c9a442",
                                                "sense_id": "6b416321-1e62-3319-b806-7bea0db9daa8",
                                                "text": "Plantes pariétales ou, par ellipse, les pariétales : Classe de plantes dicotylédones dont le placenta se trouve sur les parois du fruit."
                                            },
                                            {
                                                "example_id": "708d0575-55f7-4d8f-bd5d-a972e226aa52",
                                                "sense_id": "6b416321-1e62-3319-b806-7bea0db9daa8",
                                                "text": "Quand le pistil est multiple et attaché à la paroi intérieure d’un calice très-resserré, les ovaires sont dits pariétaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "734691cc-885d-3a7b-b892-2fd320545ad2",
                                        "entry_id": "945acbee-d72b-31b5-9d29-68ec3d5a04ef",
                                        "glosses": [
                                            "Qui a rapport à la paroi d’une cavité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3dda3212-04ea-43da-b180-d2e50925c56d",
                                                "sense_id": "734691cc-885d-3a7b-b892-2fd320545ad2",
                                                "text": "Neurologiquement, l’hypnose n’est pas un état de sommeil, mais de veille, bien qu’elle soit liée à la désactivation des aires du précunéus et des régions postéro-médiales pariétales (typiquement actives à l’état de veille normale)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pariétal",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "978e077d-463c-3452-bc1b-f732724a60b8",
                                        "entry_id": "300d67fc-8a3c-3b0f-93de-4281f54ebe7b",
                                        "glosses": [
                                            "Synonyme d’os pariétal."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cbc9dd84-8abe-4901-aeb9-1a96061c2590",
                                                "sense_id": "978e077d-463c-3452-bc1b-f732724a60b8",
                                                "text": "On retrouve aussi des traumas sur le temporal gauche, le pariétal droit et l’occipital."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
