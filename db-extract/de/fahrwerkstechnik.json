                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17525644-6b96-424f-a575-262e607fa6d9",
                                "sense_id": "fecf5367-d25d-3bbe-bce3-a040cc83eb4b",
                                "text": "„BMW punktet bei Connectivity und alternativen Antrieben, Mercedes bei Fahrwerkstechnik und Assistenzsystemen.“"
                            },
                            {
                                "example_id": "0b29f62c-4462-4cc8-a5df-9c28a0443ad4",
                                "sense_id": "fecf5367-d25d-3bbe-bce3-a040cc83eb4b",
                                "text": "„[…] Er könnte in Gestalt des neuen Zweier Coupés zum Beispiel mit der Fahrwerkstechnik des M3 bestückt werden und technisch auch Anleihen beim M4 nehmen - obwohl der einen Respektabstand gegenüber dem M2 behalten soll.“"
                            },
                            {
                                "example_id": "dfc1ca2b-47ee-4b8d-a5cf-8a54c4b94237",
                                "sense_id": "fecf5367-d25d-3bbe-bce3-a040cc83eb4b",
                                "text": "„Mit Fahrwerkstechnik des Zulieferers ZF ist die neue Generation des Opel Astra zu haben.“"
                            },
                            {
                                "example_id": "b63866e2-f422-4811-922a-99f9e5a65cc4",
                                "sense_id": "fecf5367-d25d-3bbe-bce3-a040cc83eb4b",
                                "text": "„Vor allem die Varianten mit 1,6 und 2,0 Liter großen Motoren fanden reißenden Absatz, die Käufer sahen großzügig über die antiquierte Fahrwerkstechnik mit hinterer Starrachse hinweg.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
