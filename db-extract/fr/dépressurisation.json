                "senses": [
                    {
                        "sense_id": "a612b4dc-a2dc-34e5-a097-7a4a9a02126b",
                        "entry_id": "2ac4f290-21ac-3b69-b148-906c237d3757",
                        "glosses": [
                            "Baisse brutale de pression atmosphérique au sein d’un espace clos."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "146e3c30-cf26-4513-8c72-c468c36bdea3",
                                "sense_id": "a612b4dc-a2dc-34e5-a097-7a4a9a02126b",
                                "text": "Comme la dépressurisation continuait, l’atmosphère de l’Habitat comprima le sas et AL102 s’étira pour la dernière fois."
                            },
                            {
                                "example_id": "8b53e01d-3113-4428-8803-ced0136d3303",
                                "sense_id": "a612b4dc-a2dc-34e5-a097-7a4a9a02126b",
                                "text": "Si l'avion n'est pas totalement étanche, il est possible que l'air s'échappe de manière plus ou moins rapide, c'est ce que l'on appelle une dépressurisation. Si la dépressurisation est lente, les pilotes vont se mettre en descente pour revenir à une altitude de vol de 10 000 pieds, soit un peu plus de 3000 mètres. […].\nSi la dépressurisation est rapide, on parle alors de dépressurisation explosive."
                            }
                        ]
                    }
