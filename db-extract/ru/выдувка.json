                        "source_sense_id": "487ccb0b-97e7-3f9b-b18a-ff3e0e53d3de",
                        "target_lang_word": "soufflage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "soufflage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0853a9ac-0c59-376f-8f7b-68b0d860c450",
                                        "entry_id": "62e83373-2c83-3962-bdfa-c4c8b5eb757a",
                                        "glosses": [
                                            "Action de souffler."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0156e27-09cb-415c-b50c-8fade2ac105a",
                                                "sense_id": "0853a9ac-0c59-376f-8f7b-68b0d860c450",
                                                "text": "Les deux autres chantiers ont vu le remplacement de traverses entre Les Martels et Giroussens, le curage des fossés, le soufflage des feuilles, l’évacuation des vieilles traverses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11930103-88cb-328a-86cf-2f22a36782ad",
                                        "entry_id": "62e83373-2c83-3962-bdfa-c4c8b5eb757a",
                                        "glosses": [
                                            "Art de souffler le verre."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6b1e6c43-f315-3b03-9dfb-1d167252adf4",
                                        "entry_id": "62e83373-2c83-3962-bdfa-c4c8b5eb757a",
                                        "glosses": [
                                            "Technique de boulangerie dans l'élaboration du pain."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e786ed59-253a-3510-b195-63466006bf4e",
                                        "entry_id": "62e83373-2c83-3962-bdfa-c4c8b5eb757a",
                                        "glosses": [
                                            "Action de séparer par la ventilation les poils légers des poils lourds non susceptibles d'être feutrés."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "25718afd-423e-33bd-bf5c-9f9b1fd280dd",
                                        "entry_id": "62e83373-2c83-3962-bdfa-c4c8b5eb757a",
                                        "glosses": [
                                            "Revêtement de planches qu'on applique sur la carène d'un navire, un peu au-dessus et au-dessous de sa flottaison, pour ajouter à sa stabilité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3ff3a61-da2c-44db-a072-bae7ff3775ab",
                                                "sense_id": "25718afd-423e-33bd-bf5c-9f9b1fd280dd",
                                                "text": "[…], mais les glaces s'étant rapprochées, il fallut user des grands moyens pour nous dégager, intervention d'espars, carambolages, chocs violents ; notre soufflage y laissa quelques esquilles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ad76fb5-7505-3cc0-a9d5-51519033f197",
                                        "entry_id": "62e83373-2c83-3962-bdfa-c4c8b5eb757a",
                                        "glosses": [
                                            "Dans le jargon scolaire, action de souffler la réponse à celui qui ne la sait pas."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a905b34-fe58-4a39-b2af-f3cd96392bef",
                                                "sense_id": "0ad76fb5-7505-3cc0-a9d5-51519033f197",
                                                "text": "Le héros est en train de réviser en vue d’une interrogation trimestrielle Sa mére a décidé de l’aider.\n- C’est ça que tu dois savoir ? Avec les encadrés ?.. Alors, récite.\nComme ça, tout de go, à froid, sans préparation ? Pas le moindre petit soufflage pour amorcer la pompe"
                                            },
                                            {
                                                "example_id": "14982085-1baf-4d46-b17a-f554c05d6e9b",
                                                "sense_id": "0ad76fb5-7505-3cc0-a9d5-51519033f197",
                                                "text": "Ce sont des soufflages que tente Topaze : Des moutons... Des moutons... étaient en sûreté... […] Des moutons... moutonss...(L’Élève le regarde ahuri.) Voyons, mon enfant, faites un effort. Je dis moutonsse. Etaient (il reprend avec finesse) étai-eunnt. C'est-à-dire qu'il n'y avait pas qu'un moutonne. Il y avait plusieurs moutonsse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37523536-fca7-3b26-8e3f-21d4e6980589",
                                        "entry_id": "62e83373-2c83-3962-bdfa-c4c8b5eb757a",
                                        "glosses": [
                                            "Opération qui consiste à remettre à niveau des pavés enfoncés, en mettant du sable dessous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11fd2fdf-d126-4e93-bea4-2f36a82ee675",
                                                "sense_id": "37523536-fca7-3b26-8e3f-21d4e6980589",
                                                "text": "Lors d'un second soufflage sur ces mêmes points , la quantité de pavés à remplacer a été à peu près la même … — (Annales des ponts et chaussées, 2ème série, 1ᵉʳ semestre, Éd.Carilian, Gœury et Vve Dalmont, Paris 1841)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "074b4b7d-bd92-3258-8ed5-563b724705b7",
                                        "entry_id": "62e83373-2c83-3962-bdfa-c4c8b5eb757a",
                                        "glosses": [
                                            "Action qui consiste à remettre du ballast sur une voie dont les rails se sont affaissés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01a5dc25-a3cd-496c-90ea-41376623d7c1",
                                                "sense_id": "074b4b7d-bd92-3258-8ed5-563b724705b7",
                                                "text": "Le soufflage a permis d'éviter des réfections de ballast qui paraissaient s'imposer , … — (Annales des ponts et chaussée, Éd. Dumas, 1918)"
                                            },
                                            {
                                                "example_id": "ff96f0a3-dccd-46e5-80e2-2b36b4e1f2a1",
                                                "sense_id": "074b4b7d-bd92-3258-8ed5-563b724705b7",
                                                "text": "Le soufflage est plus rapide et fatigue beaucoup moins les ouvriers de la voie que le bourrage ; en outre, le bourrage détruit toujours plus ou moins les traverses et le ballast."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
