                        "source_sense_id": "76d67405-db54-3440-87a0-32459b9c65d7",
                        "target_lang_word": "esnobismo",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "esnobismo",
