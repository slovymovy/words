                        ],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "d38891cf-d9db-3802-a44a-56287cbad3f6",
                        "entry_id": "9cbc68a8-e94d-30aa-8caf-c73ea7c4dc4f",
                        "glosses": [
                            "prostytutka"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "c24efe0d-b5a4-4ca7-bc79-e82e37e68bc1",
                                "sense_id": "d38891cf-d9db-3802-a44a-56287cbad3f6",
                                "text": "Major poszedł do domu publicznego, by spotkać się tam z kurtyzanami."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "70e1df75-1748-49b7-b20a-76a776ac99c0",
                        "source_entry_id": "9cbc68a8-e94d-30aa-8caf-c73ea7c4dc4f",
                        "source_sense_id": "d38891cf-d9db-3802-a44a-56287cbad3f6",
                        "target_lang_word": "courtesan",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "courtesan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d7930dba-0c37-3d5d-9364-087bad6baa64",
                                        "entry_id": "afbfd30d-8e98-38eb-84ee-f742151552ed",
                                        "glosses": [
                                            "A female prostitute, especially one with high-status or wealthy clients."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fbee7bc4-1837-47fe-b2c4-cbc2faaa5c95",
                                                "sense_id": "d7930dba-0c37-3d5d-9364-087bad6baa64",
                                                "text": "What wine, what drug, what philtre known of man / Will drown this ancient foe, / Ruthless and ravenous as a courtesan, / Sure as an ant, and slow?"
                                            },
                                            {
                                                "example_id": "790167b1-5631-495f-9815-faef9935310b",
                                                "sense_id": "d7930dba-0c37-3d5d-9364-087bad6baa64",
                                                "text": "In the notes he wrote for Nana, his novel about a courtesan in Second Empire Paris, Zola imagined ‘a whole society hurling itself’ at her body, ‘a pack of hounds after a bitch, who is not even on heat and makes fun of the hounds following her’. This might also describe the life of Harriette Wilson, whose unguarded pursuit by the leaders of the British aristocracy, the army, the government and opposition made her the most desired, and then the most dangerous, woman in Regency London."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff175b4e-b478-3d1b-8475-f57d7486fa89",
                                        "entry_id": "afbfd30d-8e98-38eb-84ee-f742151552ed",
                                        "glosses": [
                                            "The mistress of a royal or noble."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6fc74807-1838-3468-a19a-34244da1a0d6",
                                        "entry_id": "afbfd30d-8e98-38eb-84ee-f742151552ed",
                                        "glosses": [
                                            "A woman of a royal or noble court."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e417d55f-fafe-3942-b826-4cbbbfb48469",
                                        "entry_id": "afbfd30d-8e98-38eb-84ee-f742151552ed",
                                        "glosses": [
                                            "A fairy chess piece that can move to any adjacent square, that, when captured, the capturing piece is also eliminated."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e387737e-fb10-46e4-9aea-22bfe011fa2c",
                                                "sense_id": "e417d55f-fafe-3942-b826-4cbbbfb48469",
                                                "text": "The courtesan moves like a mann, but whatever piece captures her is also removed from the board (unless it’s a king)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2b6acd8d-5e7d-4c16-84bc-cc2e43bdd59a",
                        "source_entry_id": "9cbc68a8-e94d-30aa-8caf-c73ea7c4dc4f",
                        "source_sense_id": "707ad98b-c57f-3627-882a-ec56e09feb0e",
                        "target_lang_word": "куртизанка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "куртизанка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "c5cecb8e-9eee-3ea4-beb0-18f809cc8552",
                                        "entry_id": "ab992e33-485b-39f2-88ed-0fad19716257",
                                        "glosses": [
                                            "женщина лёгкого поведения, вращающаяся в высшем свете"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c44d3f12-7bde-48e6-a852-1488044f2dd0",
                                                "sense_id": "c5cecb8e-9eee-3ea4-beb0-18f809cc8552",
                                                "text": "Египетская куртизанка Родопис продавала свою любовь царю за деньги, а Эзопу — за остроумие."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
