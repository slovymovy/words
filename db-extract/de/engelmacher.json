                                        "entry_id": "c8b32927-eec3-3cc7-b2ae-3929b619c2bc",
                                        "glosses": [
                                            "Personne pratiquant un avortement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddfaaeff-6d04-457b-8013-82a7808e7273",
                                                "sense_id": "52a7e2c3-27d0-3a89-9519-56d3eb4e71d2",
                                                "text": "Les peines sont criminelles lorsque l’avortement a été procuré en l’absence de consentement de la femme, lorsque la femme est décédée des suites des manœuvres abortives et lorsque l’avorteur est membre du corps médical."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
