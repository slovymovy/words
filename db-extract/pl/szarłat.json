                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c1f4c8b-1c6b-4935-bb55-5fe580f019f4",
                                                "sense_id": "2783e270-9a82-3380-b07c-36af4a960397",
                                                "text": "Da Amarant glutenfrei ist, ist er für Allergiker ein guter Getreideersatz."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
