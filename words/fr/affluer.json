    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "dfa07119-ded3-37e9-8789-bcadf902ee26",
                    "sense_definition": "Arriver en très grand nombre ou en abondance, en parlant de personnes ou de choses.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "arriver_abondance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dès l'ouverture des portes, des milliers de visiteurs ont commencé à <w>affluer</w> vers le salon."
                        },
                        {
                            "text": "Les messages de soutien continuent d'<w>affluer</w> sur les réseaux sociaux depuis ce matin."
                        }
                    ],
                    "synonyms": [
                        "accourir",
                        "déferler"
                    ],
                    "common_phrases": [
                        "affluer de partout"
                    ]
                },
                {
                    "sense_id": "716017b7-fac6-382c-a6e2-028ddfa11a22",
                    "sense_definition": "Couler ou se déverser vers un même lieu ou cours d'eau, en parlant des eaux.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "ecoulement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Plusieurs ruisseaux de montagne <w>affluent</w> dans cette rivière principale après de fortes pluies."
                        },
                        {
                            "text": "Les torrents gonflés par la fonte des neiges <w>affluaient</w> rapidement vers la vallée."
                        }
                    ],
                    "synonyms": [
                        "confluer",
                        "se jeter"
                    ]
                },
                {
                    "sense_id": "8104f772-9b74-3319-8291-9adca9b7177a",
                    "sense_definition": "Se porter en grande quantité vers une partie déterminée du corps, en parlant du sang ou d'un liquide organique.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "ecoulement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sous le coup de l'émotion soudaine, le sang s'est mis à <w>affluer</w> à son visage."
                        },
                        {
                            "text": "L'effort physique intense fait <w>affluer</w> le sang directement vers les muscles sollicités."
                        }
                    ],
                    "synonyms": [
                        "monter"
                    ],
                    "common_phrases": [
                        "faire affluer le sang",
                        "affluer au visage"
                    ]
                }
            ]
        }
    ]
