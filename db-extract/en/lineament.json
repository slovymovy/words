                                            {
                                                "example_id": "2cebb793-5804-4ba5-a749-efe8c74fa82f",
                                                "sense_id": "66e4d45f-6070-3408-bba9-0303627acda2",
                                                "text": "είναι χαρακτηριστικό αυτού του ανθρώπου η ευγένεια"
                                            }
