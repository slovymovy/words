                "senses": [
                    {
                        "sense_id": "953cca70-6bc2-3edb-ab45-96b46157f929",
                        "entry_id": "e160484d-96a6-3f01-9053-6c63891edabe",
                        "glosses": [
                            "der einstimmige Gesang der kirchlichen Gemeinden, die sich in den ersten Jahrhunderten nach Christus bildeten. Dieser Gesang erhielt um 600 n. Chr. den Namen „Gregorianischer Choral“, da sich zu dieser Zeit Papst Gregor I. intensiv für eine Reform dieser Musik stark machte."
                        ],
                        "tags": [
                            "ursprünglich"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ccd5e0cc-827d-3cc4-8068-2991ee7f4881",
                        "entry_id": "e160484d-96a6-3f01-9053-6c63891edabe",
                        "glosses": [
                            "das von der Gemeinde gesungene Kirchenlied, das wie der alte Gregorianische Choral unbegleitet und im Rhythmus und Akzent des Verses gesungen wird"
                        ],
                        "tags": [
                            "protestantische Kirche"
                        ],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
                ],
