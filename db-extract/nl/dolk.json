                "senses": [
                    {
                        "sense_id": "b9a413fb-61ae-3d17-9f41-1c2527cb9753",
                        "entry_id": "0e3a130e-6a7c-3ec4-895a-79e835691a8e",
                        "glosses": [
                            "kort steekwapen in de vorm van een stevig mes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84cb3d22-083c-46ba-b232-c94851ce8523",
                                "sense_id": "b9a413fb-61ae-3d17-9f41-1c2527cb9753",
                                "text": "Met een lange dolk bracht hij een groot stuk slang naar me toe. Dankbaar pakte ik het aan en nam voorzichtig een hap om te proeven hoe het smaakte."
                            },
                            {
                                "example_id": "4113ee82-d741-4037-91db-52eff04db1fb",
                                "sense_id": "b9a413fb-61ae-3d17-9f41-1c2527cb9753",
                                "text": "Hij moest op een dolk en een keizerlijk vaandel zweren niemand iets te vertellen over wat hij nu te horen zou krijgen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bcfbcf53-9a85-4756-84fe-c6485047eedc",
                        "source_entry_id": "0e3a130e-6a7c-3ec4-895a-79e835691a8e",
                        "source_sense_id": "b9a413fb-61ae-3d17-9f41-1c2527cb9753",
                        "target_lang_word": "Dolch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dolch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "41c25c8d-2312-37de-a32a-350e830973cc",
                                        "entry_id": "7e98bcbd-7842-3d4b-8c7f-2bd46713c0d6",
                                        "glosses": [
                                            "ein Messer mit zwei Schneiden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b8308e1-04c3-41f3-a31e-4c2c869d0d92",
                                                "sense_id": "41c25c8d-2312-37de-a32a-350e830973cc",
                                                "text": "Der Dolch ist mit Diamanten und Edelsteinen verziert."
                                            },
                                            {
                                                "example_id": "3a9f316a-0bb5-4163-a2e5-d8ba1460c03a",
                                                "sense_id": "41c25c8d-2312-37de-a32a-350e830973cc",
                                                "text": "„Von dem Goldschmuck des Fürsten ist der Halsring, ein Torques (von lateinisch »torquere« = drehen), am markantesten, aber auch ein goldverzierter Dolch mit einem sogenannten Antennengriff fällt auf.“"
                                            },
                                            {
                                                "example_id": "c0cab770-2e17-44af-a95d-a09f02abf91d",
                                                "sense_id": "41c25c8d-2312-37de-a32a-350e830973cc",
                                                "text": "„Endlich zog er seinen Dolch und griff nach ihr.“"
                                            },
                                            {
                                                "example_id": "a58294e0-abed-40df-8cea-52c808339492",
                                                "sense_id": "41c25c8d-2312-37de-a32a-350e830973cc",
                                                "text": "„Ich machte mich mit dem blutigen Dolch in der Hand auf die Suche nach Moro.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d37fc318-38aa-4066-b571-de02d17c20ce",
                        "source_entry_id": "0e3a130e-6a7c-3ec4-895a-79e835691a8e",
                        "source_sense_id": "b9a413fb-61ae-3d17-9f41-1c2527cb9753",
                        "target_lang_word": "dagger",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dagger",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "adf5e110-1576-3f31-8eca-bfa51fd6cb0c",
                                        "entry_id": "6ef0feda-5b0b-36cf-91f7-cfb58aaefd37",
                                        "glosses": [
                                            "A stabbing weapon, similar to a sword but with a short, double-edged blade."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1bb6aed6-dd9a-43d7-ba40-ce805402282c",
                                                "sense_id": "adf5e110-1576-3f31-8eca-bfa51fd6cb0c",
                                                "text": "The dagger, under the title cultellum and misericorde, has been the constant companion of the sword, at least from the days of Edward I. and is mentioned in the statute of Winchester."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27d8dfaa-9cf2-3191-9522-83b51bd095d0",
                                        "entry_id": "6ef0feda-5b0b-36cf-91f7-cfb58aaefd37",
                                        "glosses": [
                                            "The typographical mark †."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1fd59921-5ef8-3a27-a3ca-8c1e7cbfd1fd",
                                        "entry_id": "6ef0feda-5b0b-36cf-91f7-cfb58aaefd37",
                                        "glosses": [
                                            "A point scored near the end of the game (clutch time) to take or increase the scorer's team lead, so that they are likely to win."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd14770f-0437-4a1a-99c9-67b136979caa",
                                                "sense_id": "1fd59921-5ef8-3a27-a3ca-8c1e7cbfd1fd",
                                                "text": "His last-minute 3-point dagger silenced the criticism for his so-called failure to come up big in big moments."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dagger",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2a0d884f-b98f-349b-89ba-0c4ade1fb9de",
