                "senses": [
                    {
                        "sense_id": "e1038246-0b33-3057-9d5f-e785184ebaf0",
                        "entry_id": "76ba5475-b1a9-3551-ae04-f71d4d672a28",
                        "glosses": [
                            "Produktion von elektrischer Energie, die in einen elektrischen Strom umgewandelt werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e72a867a-7ed4-4368-94a1-a36e2b0d9415",
                                "sense_id": "e1038246-0b33-3057-9d5f-e785184ebaf0",
                                "text": "„Dies wird noch erweitert durch die Stromherstellung mit Windkrafträdern, womit der Kohleverbrauch eingeschränkt und die Luft reiner wird.“"
                            },
                            {
                                "example_id": "b52b7e70-ddd9-4063-95eb-5d24ad26ca40",
                                "sense_id": "e1038246-0b33-3057-9d5f-e785184ebaf0",
                                "text": "„Bei der Stromherstellung könnten gewaltige Turbinen mit Wasserstoff angetrieben werden.“"
                            },
                            {
                                "example_id": "32edd05a-7bbb-42de-b3d0-2bc2cd187c27",
                                "sense_id": "e1038246-0b33-3057-9d5f-e785184ebaf0",
                                "text": "„Dieser positive Trend kann sich zukünftig durch eine angenommene Reduzierung der spezifischen CO2-Emissionen bei der Stromherstellung noch verbessern.“"
                            },
                            {
                                "example_id": "b111c50b-1d85-4a69-b299-177bc0d130fb",
                                "sense_id": "e1038246-0b33-3057-9d5f-e785184ebaf0",
                                "text": "„Denn im Vergleich zur Kraftstoffbereitstellung haben die regionalen Besonderheiten der Stromherstellung den größten Einfluss auf die CO2- und Energiebilanz.“"
                            },
                            {
                                "example_id": "91fe99d7-6a85-4247-b431-3d6d6fded894",
                                "sense_id": "e1038246-0b33-3057-9d5f-e785184ebaf0",
                                "text": "„Doch neben den ganzen Vorteilen des Ökostromes gefährdet diese Art von Stromherstellung die Bevölkerung, die Tierwelt und die Umwelt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8f3fe7cc-dacc-46fd-ae4c-422c42edc64e",
