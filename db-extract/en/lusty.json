                        "examples": [
                            {
                                "example_id": "9510fb1a-10f4-404c-9eae-e18a1601a7e9",
                                "sense_id": "1bbbabd6-1afb-3cc7-b4de-4db6a3036476",
                                "text": "How luſh and luſty the graſſe lookes ? How greene ?"
                            },
                            {
                                "example_id": "08826d3b-49a9-4067-a152-fa790f35c63d",
                                "sense_id": "1bbbabd6-1afb-3cc7-b4de-4db6a3036476",
                                "text": "I ſaw him [Ferdinand] beare the ſurges vnder him, / And ride vpon their backes ; he trod the water / Whoſe enmity he flung aſide : and breſted / The ſurge moſt ſwolne that met him : his bold head / 'Bove the contentious waues he kept, and oared / Himſelfe with his good armes in luſty ſtroke / To th'ſhore ; that ore his waue-worne baſis bowed / As ſtooping to releeue him[…]"
                            }
                        ]
                    },
                    {
                        "sense_id": "8f602a4f-d065-3e53-8610-0fd669f9c01e",
                        "entry_id": "d16bac9b-f1dd-3d21-a58e-7740ff8a383d",
