                            {
                                "target_word": "Batman",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d125bda3-9c90-38b9-98cc-09ebb1ddb3ab",
                                        "entry_id": "a2712292-965b-3d24-a9fd-87565078d85e",
                                        "glosses": [
                                            "A fictional hero and the main protagonist of DC Comics, noted for his intellect and stealth, who uses a bat-themed costume and equipment (including a belt with an array of utilities) and is assisted by his sidekick Robin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70b1dc04-a13f-4687-911a-4590ba342017",
                                                "sense_id": "d125bda3-9c90-38b9-98cc-09ebb1ddb3ab",
                                                "text": "You’re afraid of being ashes. You’re afraid of being forgotten. And you will be forgotten, Joker. Because of me. I am vengeance! I am the night! I am Batman!"
                                            },
                                            {
                                                "example_id": "417e4d0f-eb0f-4baa-8e0f-bdd40207692e",
                                                "sense_id": "d125bda3-9c90-38b9-98cc-09ebb1ddb3ab",
                                                "text": "“But next time—” Night vanished before the guard could finish—just kind of disappeared like Batman—which Viv found almost as annoying as the fact that he'd dragged her down a well. He didn't think he had to explain himself?"
                                            },
                                            {
                                                "example_id": "107f482c-bf07-445a-934c-2e163c6eddac",
                                                "sense_id": "d125bda3-9c90-38b9-98cc-09ebb1ddb3ab",
                                                "text": "I watched through squinted eyes as the driver-side door opened and a man stepped out wielding a Maglite, his other hand placed on his Batman-like utility belt. What all did they keep in those things? Surely the pistol, a few clips, handcuffs […]"
                                            },
                                            {
                                                "example_id": "579283e5-cb4d-4b84-afe1-e28d42960f60",
                                                "sense_id": "d125bda3-9c90-38b9-98cc-09ebb1ddb3ab",
                                                "text": "For quotations using this term, see Citations:Batman."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Batman",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fd3bdb89-a2ef-3c5f-b74a-7eed55cc49c9",
                                        "entry_id": "db3479e6-706c-38f1-82ed-97e11bc6a189",
                                        "glosses": [
                                            "An intensifier for interjections created with the adjective holy, in imitation of dialogue between Batman and his sidekick Robin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a679809-e024-4ad5-9c1e-41c2efbea414",
                                                "sense_id": "fd3bdb89-a2ef-3c5f-b74a-7eed55cc49c9",
                                                "text": "Holy guacamole, Batman!"
                                            },
                                            {
                                                "example_id": "4e1139e8-1aa3-473b-9637-da538f37f7e7",
                                                "sense_id": "fd3bdb89-a2ef-3c5f-b74a-7eed55cc49c9",
                                                "text": "Holy nostalgic flashback, Batman! Aly and AJ Michalka, the actor-musician sister duo known for dominating Radio Disney in the late aughts (they’ve also released some very good music since then), just sent us straight back to our tweens by wearing none other than iconic mall brand Limited Too."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Batman",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1b599e92-3dd2-34cf-b782-6f6d87290909",
                                        "entry_id": "1c73c700-83c2-3c81-aec1-094b9691cbfc",
                                        "glosses": [
                                            "Alternative letter-case form of batman."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "229bb2ba-e2da-43fb-9c32-6cf221a24d4f",
                                                "sense_id": "1b599e92-3dd2-34cf-b782-6f6d87290909",
                                                "text": "He laughed, Batmanned back up to his last piece of gear and hammered a 5/8-inch angle piton into the crack with an ascending ring like any nail met with a hammer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
