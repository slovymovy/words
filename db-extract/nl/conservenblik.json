                        "sense_id": "89d562b8-811e-33d1-8a9f-b9d5a25f38b8",
                        "entry_id": "2940c7b0-701d-3e6a-b6ba-df31020a9a89",
                        "glosses": [
                            "blik waarin voedsel vrij van lucht wordt bewaard en dat geopend kan worden met een blikopener of met een (meegeleverd) sleuteltje, of door aan een lipje te trekken"
                        ],
                        "tags": [
                            "cilindervormig"
                        ],
                        "examples": [
                            {
                                "example_id": "122424e2-4e28-4554-8893-e3705e425754",
                                "sense_id": "89d562b8-811e-33d1-8a9f-b9d5a25f38b8",
                                "text": "Of beter: waarom zijn ze alleen maar rond? Simon Terpstra vraagt zich af waarom de conservenblikken en glazen potten waarin groenten en fruit verkocht worden enkel die vorm hebben. „De kosten van vervoer zouden flink beperkt kunnen worden met vierkante blikken en potten”, denkt hij."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7276a92a-bf9e-47db-967f-a29f1bbee594",
                        "source_entry_id": "2940c7b0-701d-3e6a-b6ba-df31020a9a89",
                        "source_sense_id": "89d562b8-811e-33d1-8a9f-b9d5a25f38b8",
                        "target_lang_word": "Konservendose",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Konservendose",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f48a07b6-f344-37e3-905e-8665f327b0d5",
                                        "entry_id": "030c0641-08d7-3856-a1c0-709d7a3b7bdc",
                                        "glosses": [
                                            "runder Blechbehälter zur langfristigen Aufbewahrung von Lebensmitteln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6776a237-e464-41b4-b510-7e05408f5305",
                                                "sense_id": "f48a07b6-f344-37e3-905e-8665f327b0d5",
                                                "text": "Sie bewahrt die Ananasstückchen in einer Konservendose auf."
                                            },
                                            {
                                                "example_id": "c093b74f-4b80-4b7c-9b4d-67a065820fce",
                                                "sense_id": "f48a07b6-f344-37e3-905e-8665f327b0d5",
                                                "text": "„Das waren an Draht befestigte Konservendosen, deren Deckelseite entfernt und deren Metallboden mehr oder weniger symmetrisch von Nägeln durchlöchert worden war.“"
                                            },
                                            {
                                                "example_id": "f207eb24-47c5-4252-b589-ae905611b96d",
                                                "sense_id": "f48a07b6-f344-37e3-905e-8665f327b0d5",
                                                "text": "„Wir zwangen ihm ein paar Konservendosen auf, als er ausstieg, und fuhren schnell davon, bevor er sie zurückgeben konnte.“"
                                            },
                                            {
                                                "example_id": "faceeedc-683f-4289-84bb-ffe171962a37",
                                                "sense_id": "f48a07b6-f344-37e3-905e-8665f327b0d5",
                                                "text": "„Sie gingen in die Küche, woselbst sich der Lohn der verkauften Souvenirs in Form von Konservendosen, Fleisch und Whiskyflaschen präsentierte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
