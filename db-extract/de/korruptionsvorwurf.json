                            {
                                "example_id": "67e30ab2-fe71-4184-a35b-33c71d608a29",
                                "sense_id": "1a004dde-055b-3a3a-8ff7-36deddecd5b5",
                                "text": "„Nach der Festnahme von Ministersöhnen in der Türkei wegen Korruptionsvorwürfen sind fünf hochrangige Polizisten versetzt worden.“"
                            },
                            {
                                "example_id": "b6ede1c9-4406-40b1-8488-d8ca5adfc131",
                                "sense_id": "1a004dde-055b-3a3a-8ff7-36deddecd5b5",
                                "text": "„Gleichzeitig gaben ihm Korruptionsvorwürfe die Möglichkeit, diejenigen, die zu mächtig geworden waren und ihm gefährlich werden konnten, politisch auszuschalten.“"
                            }
                        ],
