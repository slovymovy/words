                                ]
                            },
                            {
                                "target_word": "tectiform",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e1be0892-51c6-3a66-b087-bdaa65fc883a",
                                        "entry_id": "619d2a64-39b6-3f1e-9597-9f1f2550123f",
                                        "glosses": [
                                            "A type of cave painting or engraving, having in its simplest form the shape of an upward-pointing wedge or arrow, thought to represent the roof of a tent or rudimentary building."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d640c29-f5e6-48e3-aa4c-1e9bd2926f41",
                                                "sense_id": "e1be0892-51c6-3a66-b087-bdaa65fc883a",
                                                "text": "1924, American Anthropologist, Volume 26, New Series, page 48,\nThe tectiforms reproduce in a remarkable manner the simple shelters, tents, and huts in use today among primitive and nomadic races in various parts of the world."
                                            },
                                            {
                                                "example_id": "47a68b5c-2db5-4147-844e-e4a551a4f57b",
                                                "sense_id": "e1be0892-51c6-3a66-b087-bdaa65fc883a",
                                                "text": "Because of their composition and the coexistence in them of meanders and tectiforms they differ from chimpanzee drawings, which are in many other ways a comparable phenomenon."
                                            },
                                            {
                                                "example_id": "1fec4dbf-0789-490e-9ac7-3f7753e04091",
                                                "sense_id": "e1be0892-51c6-3a66-b087-bdaa65fc883a",
                                                "text": "Inclusion of both ideomorphs and tectiforms as proto-art, and adaptation of the images to the natural textures of the rock surfaces as proto-cinema, suggests that the need to animate and annotate go beyond mere literal representation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
