                            "singular"
                        ],
                        "form": "die Zeichensprache"
                    },
                    {
                        "form_id": "5d1459ce-8491-4bd6-9e06-d5a25af8e66e",
                        "entry_id": "3c0eed0f-f961-378f-bd85-920e2bea96e2",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Zeichensprachen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cde7a8de-3ba8-3cc7-804e-87dbdd33dcc1",
                        "entry_id": "3c0eed0f-f961-378f-bd85-920e2bea96e2",
                        "glosses": [
                            "Art der Kommunikation, bei der die sprachliche Kommunikation durch nichtsprachliche Zeichen ergänzt oder auch ersetzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c03e1340-a630-45d4-80c4-c298cacf18da",
                                "sense_id": "cde7a8de-3ba8-3cc7-804e-87dbdd33dcc1",
                                "text": "„Hier findest du einige hilfreiche Informationsquellen, um die Zeichensprache besser zu verstehen.“"
                            },
                            {
                                "example_id": "12d95204-748a-440e-b0f1-45c980811278",
                                "sense_id": "cde7a8de-3ba8-3cc7-804e-87dbdd33dcc1",
                                "text": "„Mit dieser Zeichensprache (egal ob mit Gesten oder gemalten Zeichen) waren die Indianer also in der Lage sich zu auszutauschen, zu handeln oder Verträge zu schließen - dies alles klappte ganz hervorragend, ohne ein einziges Wort dabei zu sagen.“"
                            },
                            {
                                "example_id": "50f44ee4-06a1-49be-9d7f-ed8ff4fba325",
                                "sense_id": "cde7a8de-3ba8-3cc7-804e-87dbdd33dcc1",
                                "text": "„Im Zusammenhang mit einigen Beobachtungen über die amerikanische Zeichensprache (ASL) gelangt er zu der radikalen Konsequenz, daß die Phonologie kein wesentlicher, sondern ein akzidentieller Bestandteil der Sprache sei.“"
                            },
                            {
                                "example_id": "d2f39445-0ca3-4727-8ee6-c39e67ede169",
                                "sense_id": "cde7a8de-3ba8-3cc7-804e-87dbdd33dcc1",
                                "text": "„Zum Beispiel muss man Zeichensprache lernen, weil man unter Wasser ja nicht quatschen kann.“"
                            },
                            {
                                "example_id": "7d082164-6774-4dc4-b99d-47e395e822da",
                                "sense_id": "cde7a8de-3ba8-3cc7-804e-87dbdd33dcc1",
                                "text": "„Als der Pate ging, um den Buchhalter wegen des fehlenden Geldes zur Rede zu stellen, nahm er seinen Rechtsanwalt mit, weil dieser die Zeichensprache beherrschte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6eefabd5-4432-4e00-86ca-8baa47bc3656",
                        "source_entry_id": "3c0eed0f-f961-378f-bd85-920e2bea96e2",
                        "source_sense_id": "cde7a8de-3ba8-3cc7-804e-87dbdd33dcc1",
                        "source_sense_description": "Linguistik: sprachliche Kommunikation durch nichtsprachliche Zeichen",
                        "target_lang_word": "sign language",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sign language",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2b5a499c-b42e-39b7-9ad1-0380212498fc",
                                        "entry_id": "bf4d6296-81ed-3da6-b968-788819961161",
                                        "glosses": [
                                            "One of several natural languages, typically used by the deaf, in which words consist of hand shapes, motions, positions, and facial expressions."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d4bab63-1701-4e80-9545-664787bee543",
                                                "sense_id": "2b5a499c-b42e-39b7-9ad1-0380212498fc",
                                                "text": "It is safe to say that the academic world is now convinced that sign languages are real languages in every sense of the term."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d5662df-b40c-321f-86ab-c6f0c6074e82",
                                        "entry_id": "bf4d6296-81ed-3da6-b968-788819961161",
                                        "glosses": [
                                            "The sign language (sense 1) that is used locally or that is mistakenly believed to be the only one."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb5f7055-ffbe-412e-b983-1f8d5028ab96",
                                                "sense_id": "1d5662df-b40c-321f-86ab-c6f0c6074e82",
                                                "text": "I'm taking night classes to learn sign language."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3606d53f-ea5b-3695-9d04-8edeb92c347f",
                                        "entry_id": "bf4d6296-81ed-3da6-b968-788819961161",
                                        "glosses": [
                                            "Sign languages (sense 1) considered collectively."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a69fd08-1545-42a2-9f34-1011cf3af3d0",
                                                "sense_id": "3606d53f-ea5b-3695-9d04-8edeb92c347f",
                                                "text": "There are some unique properties found in sign language compared to spoken language."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af40b8a4-eafc-3a53-9685-f62ebaa092b8",
                                        "entry_id": "bf4d6296-81ed-3da6-b968-788819961161",
                                        "glosses": [
                                            "Communication through gestures as a substitute for language, for example, between monks under a vow of silence or during trade amongst different linguistic groups."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6c40c14-85e4-4397-a0eb-e4d84a8a8736",
                                                "sense_id": "af40b8a4-eafc-3a53-9685-f62ebaa092b8",
                                                "text": "Even Maxwell the trader, who has been most among them, is compelled to resort to the curious sign language common to most of the prairie tribes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
