                    "target_lang_definitions": {
                        "en": "Without the knowledge or participation of someone; contrary to something.",
                        "zh": "在某人不知情或未参与的情况下；违背某事。",
                        "nl": "Zonder medeweten of deelname van iemand; in strijd met iets.",
                        "pl": "Bez wiedzy lub udziału kogoś; wbrew czemuś.",
                        "de": "Ohne das Wissen oder die Beteiligung von jemandem; entgegen etwas.",
                        "fr": "Sans la connaissance ou la participation de quelqu'un ; contrairement à quelque chose.",
                        "it": "Senza la conoscenza o la partecipazione di qualcuno; contro la volontà di qualcuno.",
                        "cs": "Bez vědomí nebo účasti někoho; v rozporu s něčím.",
                        "tr": "Birinin bilgisi veya katılımı olmaksızın; bir şeye aykırı olarak.",
                        "es": "Sin el conocimiento o la participación de alguien; en contra de algo."
                    },
