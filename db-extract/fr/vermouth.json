        "fr-extract.jsonl": [
            {
                "entry_id": "c47b4390-82e4-302b-ab33-a067dc2ccf2b",
                "word": "vermouth",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e31708d9-f5dc-4062-b0dc-4f4252cbbd18",
                        "entry_id": "c47b4390-82e4-302b-ab33-a067dc2ccf2b",
                        "tags": [],
                        "form": "vermout"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "94b2d5d4-465b-3163-8bd6-f71bf091cb1a",
                        "entry_id": "c47b4390-82e4-302b-ab33-a067dc2ccf2b",
                        "glosses": [
                            "Vin blanc dans lequel on a fait infuser des plantes amères, toniques et aromatiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be24610f-257c-47bb-af80-e1a654907e4f",
                                "sense_id": "94b2d5d4-465b-3163-8bd6-f71bf091cb1a",
                                "text": "Je leur dis : « Vous ne passerez pas devant chez nous sans prendre un joyeux vermouth. Il est rustique, mais pas trop mauvais.\n— Il ferait beau voir, — répliqua Vivier, — qu’on refusât un vermouth par un temps pareil ! »"
                            },
                            {
                                "example_id": "98b9c8a8-ebba-466b-bf8c-63c06b052259",
                                "sense_id": "94b2d5d4-465b-3163-8bd6-f71bf091cb1a",
                                "text": "– Elle n’a qu’à ne pas se marier ! Pour ce qu’elle épouse !… Un type qui sent le vermouth ! D’abord, elle a toujours vécu sans nous, elle n’a pas davantage besoin de nous pour se marier !"
                            },
                            {
                                "example_id": "d4919930-e85c-4da6-8a0a-f2668d4ff1ae",
                                "sense_id": "94b2d5d4-465b-3163-8bd6-f71bf091cb1a",
                                "text": "« Et qu’est-ce que je lui sers, au jeune homme ? » Papa dit : « Un petit turin ». Je bois mon dé à coudre de vermouth, à petites gorgées, les yeux fermés pour bien sentir le goût."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "97a6830c-4026-4607-8869-0cffbdce2157",
                        "source_entry_id": "c47b4390-82e4-302b-ab33-a067dc2ccf2b",
                        "source_sense_id": "94b2d5d4-465b-3163-8bd6-f71bf091cb1a",
                        "target_lang_word": "Wermut",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wermut",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e9236c75-0713-3342-8f75-9b76ecf71412",
                                        "entry_id": "2f0ffc0d-7aac-3cb2-8999-bc212851ea9c",
                                        "glosses": [
                                            "ein gelbblühender Beifuß (Absinth, Artemisia absinthium), dessen seidenhaarige, aromatisch unangenehm schmeckende Blätter magenstärkend wirken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "749730ba-22f5-4fe2-bfc7-813545c024fb",
                                                "sense_id": "e9236c75-0713-3342-8f75-9b76ecf71412",
                                                "text": "Er hat seine Kuh mit Wermut kuriert."
                                            },
                                            {
                                                "example_id": "1aa2606d-e524-4f7b-81d0-51fbada8bf81",
                                                "sense_id": "e9236c75-0713-3342-8f75-9b76ecf71412",
                                                "text": "„Die Flammen schüfen Raum für Heidelbeeren und für Medizinpflanzen wie Wermut und Pfefferholz.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cf5d8188-2af4-3a7d-9e3d-7acb5dcaf5b3",
                                        "entry_id": "2f0ffc0d-7aac-3cb2-8999-bc212851ea9c",
                                        "glosses": [
                                            "aus 1 hergestellter Branntwein oder Likör"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a5b08e37-0845-3cf6-b945-9be94944766e",
                                        "entry_id": "2f0ffc0d-7aac-3cb2-8999-bc212851ea9c",
                                        "glosses": [
                                            "mit 1 gewürzter bittersüßer, appetitanregender Weißwein"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
