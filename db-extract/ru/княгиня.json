                ],
                "senses": [
                    {
                        "sense_id": "cd09ff50-c076-3448-89ad-738902e9b905",
                        "entry_id": "bc27a4ab-73fe-3582-ad6b-ecc86eb755f5",
                        "glosses": [
                            "жена или вдова князя"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2eb5eec2-1784-4601-bf51-8d483237d95c",
                                "sense_id": "cd09ff50-c076-3448-89ad-738902e9b905",
                                "text": "Приезжали князь и княгиня с семейством: князь, седой старик, с выцветшим пергаментным лицом, тусклыми навыкате глазами и большим плешивым лбом, с тремя звездами, с золотой табакеркой, с тростью с яхонтовым набалдашником, в бархатных сапогах; княгиня ― величественная красотой, ростом и объемом женщина, к которой, кажется, никогда никто не подходил близко, не обнял, не поцеловал ее, даже сам князь, хотя у ней было пятеро детей."
                            }
                        ]
                    },
                    {
                        "sense_id": "1a098646-2988-36bc-9db9-59220bda1f6f",
                        "entry_id": "bc27a4ab-73fe-3582-ad6b-ecc86eb755f5",
                        "glosses": [
                            "нар.-поэт. невеста, новобрачная в старинном свадебном обряде"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8359582e-4b96-43cc-b113-657d0f3f8df5",
                        "source_entry_id": "bc27a4ab-73fe-3582-ad6b-ecc86eb755f5",
                        "target_lang_word": "princess",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "princess",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5f087d0d-ae03-3251-930b-61a9a8cd1a2f",
                                        "entry_id": "48edb1e6-4f8b-30da-93cb-9a3951c0a3c7",
                                        "glosses": [
                                            "A female member of a royal family other than a queen, especially a daughter or granddaughter of a monarch."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3328b3b2-1da3-45e7-95cc-d18ece42abdf",
                                                "sense_id": "5f087d0d-ae03-3251-930b-61a9a8cd1a2f",
                                                "text": "She did not cry long, however, for she was as brave as could be expected of a princess of her age."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57fc5558-d470-3dbe-b1cd-f5d72d39de0e",
                                        "entry_id": "48edb1e6-4f8b-30da-93cb-9a3951c0a3c7",
                                        "glosses": [
                                            "A woman or girl who excels in a given field or class."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64140d3c-c3b6-4b0b-ba7f-17104493bd2c",
                                                "sense_id": "57fc5558-d470-3dbe-b1cd-f5d72d39de0e",
                                                "text": "Michael Jackson was the king of pop. Britney Spears was the pop princess. Until they weren't."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9eff0c63-0a44-382f-a1d9-7d561c00037f",
                                        "entry_id": "48edb1e6-4f8b-30da-93cb-9a3951c0a3c7",
                                        "glosses": [
                                            "A female ruler or monarch; a queen."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf42a43c-ce02-4a3f-871e-24f9c6018e67",
                                                "sense_id": "9eff0c63-0a44-382f-a1d9-7d561c00037f",
                                                "text": "And running all with greedie ioyfulnesse / To faire Irena, at her feet did fall, / And her adored with due humblenesse, / As their true Liege and Princesse naturall […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7b1bd7a-87c3-30ea-9911-1e5c3296c97c",
                                        "entry_id": "48edb1e6-4f8b-30da-93cb-9a3951c0a3c7",
                                        "glosses": [
                                            "The wife of a prince; the female ruler of a principality."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42422f06-f624-47b3-8ec3-f339106f8688",
                                                "sense_id": "f7b1bd7a-87c3-30ea-9911-1e5c3296c97c",
                                                "text": "Princess Grace was the Princess of Monaco."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f06f9fab-cb72-33d7-bf74-942e87c65d79",
                                        "entry_id": "48edb1e6-4f8b-30da-93cb-9a3951c0a3c7",
                                        "glosses": [
                                            "A young girl; used as a term of endearment."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ae4cf061-1f16-3da3-82f3-828941125830",
                                        "entry_id": "48edb1e6-4f8b-30da-93cb-9a3951c0a3c7",
                                        "glosses": [
                                            "A young girl or woman (or less commonly a man) who is vain, spoiled, or selfish; a prima donna."
                                        ],
                                        "tags": [
                                            "US",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eeb8e02d-ce6b-4769-a4a4-1b7d05ca3a49",
                                                "sense_id": "ae4cf061-1f16-3da3-82f3-828941125830",
                                                "text": "Jonathan, if you hear this, you're a beautiful princess, but you're also a big, fat dork."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36d74f3d-a930-36aa-abd7-ca7f4878228d",
                                        "entry_id": "48edb1e6-4f8b-30da-93cb-9a3951c0a3c7",
                                        "glosses": [
                                            "A tinted crystal marble used in children's games."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3602c81a-100d-3569-88a5-18c1807e3708",
                                        "entry_id": "48edb1e6-4f8b-30da-93cb-9a3951c0a3c7",
                                        "glosses": [
                                            "A type of court card in the Tarot pack, coming between the 10 and the prince (Jack)."
                                        ],
                                        "tags": [],
