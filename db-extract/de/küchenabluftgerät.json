                "senses": [
                    {
                        "sense_id": "e0389734-010d-3281-94cb-b601e84374e1",
                        "entry_id": "27c0393b-65bd-3989-9bf8-ea46bd95dfa8",
                        "glosses": [
                            "technische Einrichtung, die Wrasen-Luft aus der Küche absaugt, reinigt und als Fortluft ins Freie bläst"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "eda9851c-f9b6-42ae-b4ae-45f8d5e672d9",
                                "sense_id": "e0389734-010d-3281-94cb-b601e84374e1",
                                "text": "„In Küchenabluftgeräten, insbesondere bei liegendem Einbau des Plattenwärmetauschers, ist mit verstärkter Fettablagerung an den Platten zu rechnen – diese müssen regelmäßig gereinigt werden.“"
                            },
                            {
                                "example_id": "98cce0b5-160f-4edb-b025-9802e3dad9a3",
                                "sense_id": "e0389734-010d-3281-94cb-b601e84374e1",
                                "text": "„Das Küchenabluftgerät ist zusätzlich mit einem Fettfangfilterteil ausgestattet.“"
                            },
                            {
                                "example_id": "dc29dd50-6a0c-4822-ad9e-305b2f72118d",
                                "sense_id": "e0389734-010d-3281-94cb-b601e84374e1",
                                "text": "„Küchenabluftgerät L 90, einseitig saugend, als Radialventilator mit rückwärtsgekrümmten Schaufeln, eingebaut in ein Brandschutzgehäuse mit einer Klassifizierung L 90, DIN 4102.“"
                            },
                            {
                                "example_id": "80dffa87-a32a-4414-94a2-2b1662952076",
                                "sense_id": "e0389734-010d-3281-94cb-b601e84374e1",
                                "text": "„Küchenabluftgerät kombiniert mit einem Fettfangfilterteil, Luftrichtung horizontal.“"
                            },
                            {
                                "example_id": "67fafab2-cf57-48a1-9476-22c76eb7c798",
                                "sense_id": "e0389734-010d-3281-94cb-b601e84374e1",
                                "text": "„Die Spezialisten kümmern sich außerdem um Klimakanäle, Küchenabluftgeräte, die Schädlingsbekämpfung und die sanitären Anlagen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
