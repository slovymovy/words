                        "translation_id": "371801a6-d8b5-4d11-9c97-cd1fd97caf3a",
                        "source_entry_id": "d7504fb9-ab31-3aec-9f07-a0f748d0fde7",
                        "source_sense_description": "неся, переместить внутрь",
                        "target_lang_word": "bring in",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bring in",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "122ae588-1771-384e-abe6-f97b4a94d5b6",
                                        "entry_id": "2ea251e1-a54a-3e61-9b10-84ea406b5ca1",
                                        "glosses": [
                                            "To move something indoors, or into an area."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd6deb49-189e-4b32-a6bf-52c2e1377ba3",
                                                "sense_id": "122ae588-1771-384e-abe6-f97b4a94d5b6",
                                                "text": "Could you bring in the groceries?"
                                            },
                                            {
                                                "example_id": "fdacc085-36fb-431d-af87-ce54f2a915d6",
                                                "sense_id": "122ae588-1771-384e-abe6-f97b4a94d5b6",
                                                "text": "The country brings in raw materials from overseas."
                                            },
                                            {
                                                "example_id": "70163591-535d-4752-96db-6894845b3b57",
                                                "sense_id": "122ae588-1771-384e-abe6-f97b4a94d5b6",
                                                "text": "The causeways were laid as hard paths for heavily laden pack-animals bringing in wool from outlying hamlets and farms."
                                            },
                                            {
                                                "example_id": "ec16f816-6a70-4c41-9ec4-f7640896ab91",
                                                "sense_id": "122ae588-1771-384e-abe6-f97b4a94d5b6",
                                                "text": "Unlike South Heath, where the tunnel segments are made on site, the ones used here are made off-site and brought in by road."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8fb1c2d-350c-3011-9d3b-301890bb0679",
                                        "entry_id": "2ea251e1-a54a-3e61-9b10-84ea406b5ca1",
                                        "glosses": [
                                            "To introduce a new rule, law, or system of organisation."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c7a0e982-1c1a-3a1b-99d9-b96d4d49a494",
                                        "entry_id": "2ea251e1-a54a-3e61-9b10-84ea406b5ca1",
                                        "glosses": [
                                            "To introduce, add or initiate a person or group of people to an organisation; to give (someone) a share or portion of something."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24882c16-e999-4f68-a229-c34adefef768",
                                                "sense_id": "c7a0e982-1c1a-3a1b-99d9-b96d4d49a494",
                                                "text": "I've brought him in on the plan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d58a8fd7-07f9-383a-98ce-5d452653e006",
                                        "entry_id": "2ea251e1-a54a-3e61-9b10-84ea406b5ca1",
                                        "glosses": [
                                            "To earn money for a company or for the family."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e605c0e-df49-4b88-bfa2-140c6f00da0b",
                                                "sense_id": "d58a8fd7-07f9-383a-98ce-5d452653e006",
                                                "text": "BT shelled out almost £1bn for the Champions League over the same period, while the FA has just brought in around £820m over six seasons for the international rights to the FA Cup alone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b11d584d-aefd-3d3d-9de2-62c4505f0b56",
                                        "entry_id": "2ea251e1-a54a-3e61-9b10-84ea406b5ca1",
