                "senses": [
                    {
                        "sense_id": "9e95838d-1c30-3e07-81ad-ed86aed8d982",
                        "entry_id": "326db578-5efb-3637-baa9-aacb80254d65",
                        "glosses": [
                            "Élément chimique ayant un même nombre de protons que l’élément chimique de référence, donc une même « place » dans le tableau périodique des éléments, mais un nombre de neutrons différent."
                        ],
                        "tags": [
                            "Chimie physique"
                        ],
                        "examples": [
                            {
                                "example_id": "8498dd08-5d3f-49f7-8577-06f137c370e8",
                                "sense_id": "9e95838d-1c30-3e07-81ad-ed86aed8d982",
                                "text": "Il y a là un exemple de « transmutation avec capture » donnant lieu à la production d’un isotope d’oxygène de masse 17."
                            },
                            {
                                "example_id": "0fa81527-fdd2-42c5-ac0a-67b8fc1c1221",
                                "sense_id": "9e95838d-1c30-3e07-81ad-ed86aed8d982",
                                "text": "Nous avons déjà vu que les procédés de détection des isotopes sont suffisamment sensibles pour permettre des dilutions très considérables de l'élément marqué."
                            },
                            {
                                "example_id": "5667dcd6-662c-4b2a-8987-658e414511a4",
                                "sense_id": "9e95838d-1c30-3e07-81ad-ed86aed8d982",
                                "text": "Il y a là un exemple de « transmutation avec capture » donnant lieu à la production d’un isotope d’oxygène de masse 17."
                            },
                            {
                                "example_id": "384e32ae-82f0-4a31-82cd-872056ddb34f",
                                "sense_id": "9e95838d-1c30-3e07-81ad-ed86aed8d982",
                                "text": "Selon ce maître de conférences en sciences des planètes, l'instrument \"donne une connaissance inédite des isotopes de l'eau dans l'atmosphère de Mars en fonction à la fois du temps et de leur localisation\" sur la planète, …\"."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
