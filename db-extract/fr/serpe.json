            {
                "entry_id": "93d22dde-b142-346e-b045-41e24bb2ff04",
                "word": "serpe",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e4859b04-838f-45f1-9066-d0252928012f",
                        "entry_id": "93d22dde-b142-346e-b045-41e24bb2ff04",
                        "tags": [
                            "plural"
                        ],
                        "form": "serpes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f34d5ead-84b4-35a8-b99f-cbe8fe2c2d6a",
                        "entry_id": "93d22dde-b142-346e-b045-41e24bb2ff04",
                        "glosses": [
                            "Lame de fer, large et tranchante, recourbée en forme de croissant, emmanchée de bois et dont on se sert pour émonder les arbres, pour les tailler, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8537afc8-7f39-4c2e-b65d-5408b32a2403",
                                "sense_id": "f34d5ead-84b4-35a8-b99f-cbe8fe2c2d6a",
                                "text": "II avait un grand diable de nez tranchant et recourbé comme une serpe."
                            },
                            {
                                "example_id": "19a30179-6815-4a5b-b165-dc2be4a56a25",
                                "sense_id": "f34d5ead-84b4-35a8-b99f-cbe8fe2c2d6a",
                                "text": "[…] leurs maisons coquettement peintes, leurs vertes prairies, leurs arbres que la serpe n’a jamais ébranchés."
                            },
                            {
                                "example_id": "50b78a48-1b8f-4843-8e97-2d23de00910f",
                                "sense_id": "f34d5ead-84b4-35a8-b99f-cbe8fe2c2d6a",
                                "text": "Ici et là, la serpe légère a tranché une gaule trop hardie et qui obstrue le ciel, amputé un chicot qui pourrait servir de perchoir."
                            },
                            {
                                "example_id": "1d634840-1369-4d77-8938-6337c4f71f77",
                                "sense_id": "f34d5ead-84b4-35a8-b99f-cbe8fe2c2d6a",
                                "text": "Cette vieille serpe le servirait encore. Il l’aimait bien parce qu’elle était équilibrée, pas trop lourde, mais assez pour ajouter par son poids à la force de l’homme qui la maniait. C’était une vraie serpe de fagotage."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c2dce893-3401-4803-87cc-60e99e67535a",
                        "source_entry_id": "93d22dde-b142-346e-b045-41e24bb2ff04",
                        "source_sense_id": "f34d5ead-84b4-35a8-b99f-cbe8fe2c2d6a",
                        "target_lang_word": "Hippe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hippe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8ad6d49a-8010-3d49-abf7-e3bc399bd95d",
                                        "entry_id": "f741edae-6a6f-32b0-ba06-6e05470b4b94",
                                        "glosses": [
                                            "Messer mit sichelförmig geschwungener Klinge, das zum Beispiel zum Abschneiden von Ästen benutzt wird, teilweise als Klappmesser ausgeführt"
                                        ],
                                        "tags": [
                                            "Gartenbau"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6766902b-98a2-4114-aa8d-40d10601e740",
                                                "sense_id": "8ad6d49a-8010-3d49-abf7-e3bc399bd95d",
                                                "text": "„Dazwischen standen billige Werkuhren und ein bemaltes Gehäuse mit Barockengeln, die eine alte Uhr hielten, deren Sekundenzeiger ein hin- und herschwankender Tod mit einer Hippe war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0420c08e-dc0a-3a5e-a211-ca4406bfeb0f",
                                        "entry_id": "f741edae-6a6f-32b0-ba06-6e05470b4b94",
                                        "glosses": [
                                            "Sense des Todes"
                                        ],
                                        "tags": [
                                            "allegorisch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a78edc7-c67c-4941-a985-bc5e07742eba",
                                                "sense_id": "0420c08e-dc0a-3a5e-a211-ca4406bfeb0f",
                                                "text": "„Sitzt einmal ein Gerippe",
                                                "translation": "aber der Wagen, der rollt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f1deff87-31cd-3d25-a127-10b00c5e422e",
                                        "entry_id": "f741edae-6a6f-32b0-ba06-6e05470b4b94",
                                        "glosses": [
                                            "Gebäck aus einer weichen makronenähnlichen Masse, die sehr dünn ausgestrichen wird"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
