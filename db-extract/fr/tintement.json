        "fr-extract.jsonl": [
            {
                "entry_id": "ab681824-28cf-3bee-a378-44a84bbfccc5",
                "word": "tintement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8ada1ee6-f491-4426-8906-81c087567c00",
                        "entry_id": "ab681824-28cf-3bee-a378-44a84bbfccc5",
                        "tags": [
                            "plural"
                        ],
                        "form": "tintements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bb3c8e0e-f75c-3bf4-b24d-06f027a4f95a",
                        "entry_id": "ab681824-28cf-3bee-a378-44a84bbfccc5",
                        "glosses": [
                            "Bruit d'une cloche que l'on fait tinter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b228bbc1-95de-4982-a44f-827f2205104b",
                                "sense_id": "bb3c8e0e-f75c-3bf4-b24d-06f027a4f95a",
                                "text": "Jusqu’au matin, la colonne en marche, qu’un glas funèbre semblait suivre dans la nuit d’un tintement obstiné, vit ainsi l’insurrection courir le long de la vallée comme une traînée de poudre."
                            },
                            {
                                "example_id": "480b832e-7d22-4a4f-b4f2-3aeb13bf3216",
                                "sense_id": "bb3c8e0e-f75c-3bf4-b24d-06f027a4f95a",
                                "text": "Aux alentours et dans les lointains invisibles, les tintements joyeux des clochettes argentines et les bourdons graves des sonneaux indiquaient à Mimile que les autres petits bergers, ainsi que les bergères de son âge rapatriaient comme lui vers l’abreuvoir et vers l’étable leurs troupeaux repus."
                            },
                            {
                                "example_id": "a2e191d7-04b8-4008-b536-cc2beac12df0",
                                "sense_id": "bb3c8e0e-f75c-3bf4-b24d-06f027a4f95a",
                                "text": "Des caisses enregistreuses qui ne font pas entendre le tintement de leurs clochettes, c’est plus que du silence."
                            }
                        ]
                    },
                    {
                        "sense_id": "8b8fd523-9516-304b-9529-d45770d226b0",
                        "entry_id": "ab681824-28cf-3bee-a378-44a84bbfccc5",
                        "glosses": [
                            "Prolongement du son d’une cloche, diminuant dans l’air après que le coup a frappé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04d0784e-02fa-4f81-8d93-d0589bd1c0e5",
                                "sense_id": "8b8fd523-9516-304b-9529-d45770d226b0",
                                "text": "L'écho de la forêt voisine répétait nos cris, le mugissement des troupeaux, le tintement des clochettes et le claquement du fouet […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "32c83d3b-5ae4-3e2b-9ecf-54aff0002a00",
                        "entry_id": "ab681824-28cf-3bee-a378-44a84bbfccc5",
                        "glosses": [
                            "Bruit d'un objet métallique."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "b622c485-0ed8-480d-bd41-ba52d89ae801",
                                "sense_id": "32c83d3b-5ae4-3e2b-9ecf-54aff0002a00",
                                "text": "Et c'est Gina qui est au centre de ses penseés, non sa propre mère … qui a … au poignet gauche des bracelets dont le tintement dans les grandes pièces sonores, dépourvues de meubles, signalent de loin son arrivée, et permettent de s'esquiver à temps."
                            }
                        ]
                    },
                    {
                        "sense_id": "8522d9ca-78ae-37c5-ba76-a031929a1dc8",
                        "entry_id": "ab681824-28cf-3bee-a378-44a84bbfccc5",
                        "glosses": [
                            "Son imaginé et répété, évoqué par l'idée du bruit d'une chose métallique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e539b97-1e6d-4773-a048-0baed127caf9",
                                "sense_id": "8522d9ca-78ae-37c5-ba76-a031929a1dc8",
                                "text": "L’argent ! ce mot retentissait à mes oreilles, toutes les minutes. Je n’entendais jamais que le tintement de ce mot qui, à la fin, avait pris comme une sonorité d’écus remués."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "deaf8ea3-eec2-4355-bfc4-3dc348b1f4dc",
                        "source_entry_id": "ab681824-28cf-3bee-a378-44a84bbfccc5",
                        "target_lang_word": "tinkle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tinkle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6f5db54d-524c-3a60-b23e-d87ad873ba73",
                                        "entry_id": "09593351-69b2-380c-b862-e833b3e59995",
                                        "glosses": [
                                            "To make light metallic sounds, rather like a very small bell."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff73bf8c-95df-4d71-8963-36ebb7c5e313",
                                                "sense_id": "6f5db54d-524c-3a60-b23e-d87ad873ba73",
                                                "text": "The glasses tinkled together as they were placed on the table."
                                            },
                                            {
                                                "example_id": "d9a6ca77-59cd-4a4c-9fda-713b06f34ee6",
                                                "sense_id": "6f5db54d-524c-3a60-b23e-d87ad873ba73",
                                                "text": "The sprightly horse / Moves to the music of his tinkling bells."
                                            },
                                            {
                                                "example_id": "39b98900-983d-406b-b5e2-dc09ea0bb404",
                                                "sense_id": "6f5db54d-524c-3a60-b23e-d87ad873ba73",
                                                "text": "With a sound like tinkling bells, far off in a land of shepherds hidden by some hill, the waters of many fountains turned again home."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f076eed1-0eac-36a6-a390-3aabeba63623",
                                        "entry_id": "09593351-69b2-380c-b862-e833b3e59995",
                                        "glosses": [
                                            "To cause to tinkle."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b45d8032-77ca-3bbb-824f-9522750c443d",
                                        "entry_id": "09593351-69b2-380c-b862-e833b3e59995",
                                        "glosses": [
                                            "To indicate, signal, etc. by tinkling."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d06bbef5-e805-4785-856d-2993cfc7f46f",
                                                "sense_id": "b45d8032-77ca-3bbb-824f-9522750c443d",
                                                "text": "The butler tinkled dinner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c708549-588c-35bd-a7b6-3e205a2809f8",
                                        "entry_id": "09593351-69b2-380c-b862-e833b3e59995",
                                        "glosses": [
                                            "To hear, or resound with, a small, sharp sound."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04dfb2e1-7376-4e2c-a44f-c99acdbb5bcc",
                                                "sense_id": "5c708549-588c-35bd-a7b6-3e205a2809f8",
                                                "text": "And his ears tinkled, and the colour fled."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc7a2423-bdd1-3c33-a37b-1f29c3b227e7",
                                        "entry_id": "09593351-69b2-380c-b862-e833b3e59995",
                                        "glosses": [
                                            "To urinate."
                                        ],
                                        "tags": [
                                            "informal",
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "tinkle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4672f238-6b06-3cef-b295-63b8d341cb14",
                                        "entry_id": "083701f0-31c5-3e76-8c2b-ffbf3de99aa4",
                                        "glosses": [
                                            "A light metallic sound, resembling the tinkling of bells or wind chimes."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ef08cd9-0e3b-40df-8899-f4702aa11bf0",
                                                "sense_id": "4672f238-6b06-3cef-b295-63b8d341cb14",
                                                "text": "The Man's Wife heard the tinkle-tinkle of little stones and loose earth falling off the roadway, and the sliding roar of the man and horse going down."
                                            },
                                            {
                                                "example_id": "05179d30-972a-49d6-8615-989c5cb6f5bc",
                                                "sense_id": "4672f238-6b06-3cef-b295-63b8d341cb14",
                                                "text": "She laughed, her voice a tinkle in the silence of the circular chamber."
                                            },
                                            {
                                                "example_id": "65d10fc8-ef60-435b-a296-850c9987fddd",
                                                "sense_id": "4672f238-6b06-3cef-b295-63b8d341cb14",
                                                "text": "At the very moment he cried out, David realised that what he had run into was only the Christmas tree. . . . There were no sounds of any movement upstairs: no shouts, no sleepy grumbles, only a gentle tinkle from the decorations as the tree had recovered from the collision."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3914eed-caa2-3e3d-9b14-dd22644cd2ba",
                                        "entry_id": "083701f0-31c5-3e76-8c2b-ffbf3de99aa4",
                                        "glosses": [
                                            "A telephone call."
                                        ],
                                        "tags": [
                                            "UK",
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6209ffe1-d221-4557-b273-b9cc028354a5",
                                                "sense_id": "d3914eed-caa2-3e3d-9b14-dd22644cd2ba",
                                                "text": "Give me a tinkle when you arrive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af51f1c2-50c7-3ec7-b1b6-6a93ddac87d0",
                                        "entry_id": "083701f0-31c5-3e76-8c2b-ffbf3de99aa4",
