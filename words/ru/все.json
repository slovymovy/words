    "entries": [
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "be36d67b-faae-3d1b-99c8-7aa7887297e6",
                    "sense_definition": "Каждый человек; все люди.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "everyone",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Тепе́рь <w>все</w> зна́ют её секре́т.",
                            "target_lang_translations": {
                                "en": "Now <w>everyone</w> knows her secret.",
                                "zh": "现在<w>大家</w>都知道她的秘密了。"
                            }
                        },
                        {
                            "text": "На пра́здник пришли́ <w>все</w>.",
                            "target_lang_translations": {
                                "en": "<w>Everyone</w> came to the party.",
                                "zh": "<w>所有人</w>都来参加聚会了。"
                            }
                        }
                    ],
                    "antonyms": [
                        "никто"
                    ],
                    "common_phrases": [
                        "все знают",
                        "все вместе",
                        "все говорят"
                    ],
                    "target_lang_definitions": {
                        "en": "Every person; all people.",
                        "zh": "指代所有人或每一个个体。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "everyone",
                                "target_lang_sense_clarification": "referring to all people in a group"
                            },
                            {
                                "target_lang_word": "everybody",
                                "target_lang_sense_clarification": "synonym for everyone"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "大家",
                                "target_lang_sense_clarification": "指代群体中的所有人"
                            },
                            {
                                "target_lang_word": "所有人",
                                "target_lang_sense_clarification": "指代所有的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fe7592e8-d826-3659-bed9-d515dfcd63d4",
                    "sense_definition": "Форма множественного числа местоимения <w>весь</w>, обозначающая полную группу предметов или лиц.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "all_subst",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мне нра́вятся не́которые, но не <w>все</w>.",
                            "target_lang_translations": {
                                "en": "I like some, but not <w>all</w>.",
                                "zh": "我喜欢其中一些，但不是<w>全部</w>。"
                            }
                        },
                        {
                            "text": "Я хочу́ купи́ть <w>все</w>.",
                            "target_lang_translations": {
                                "en": "I want to buy <w>all of them</w>.",
                                "zh": "我想把<w>所有</w>这些都买下来。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Plural form of the pronoun 'ves'', denoting a complete group of objects or persons.",
                        "zh": "代词“全部”的复数形式，指代完整的一组事物或人。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "all",
                                "target_lang_sense_clarification": "the whole quantity or number"
                            },
                            {
                                "target_lang_word": "all of them",
                                "target_lang_sense_clarification": "referring to specific items mentioned"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "全部",
                                "target_lang_sense_clarification": "指代整体数量"
                            },
                            {
                                "target_lang_word": "所有",
                                "target_lang_sense_clarification": "指代特定的事物集合"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "27053c98-c473-3ac5-bfd8-c864ae146ec3",
                    "sense_definition": "Используется после сравнительной степени прилагательных или наречий для выражения превосходства над всеми остальными.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "superlative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Том бе́гает быстре́е <w>всех</w>.",
                            "target_lang_translations": {
                                "en": "Tom runs faster than <w>anyone</w>.",
                                "zh": "汤姆跑得比<w>谁</w>都快。"
                            }
                        },
                        {
                            "text": "Она́ поёт лу́чше <w>всех</w> в кла́ссе.",
                            "target_lang_translations": {
                                "en": "She sings better than <w>anyone</w> in the class.",
                                "zh": "她在班里唱歌唱得<w>最</w>好。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "лучше всех",
                        "больше всех",
                        "прежде всего"
                    ],
                    "target_lang_definitions": {
                        "en": "Used after the comparative degree of adjectives or adverbs to express superiority over all others.",
                        "zh": "用于形容词或副词比较级之后，表示在群体中程度最高。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "everyone",
                                "target_lang_sense_clarification": "in comparisons (e.g., faster than everyone)"
                            },
                            {
                                "target_lang_word": "anyone",
                                "target_lang_sense_clarification": "in comparisons (e.g., better than anyone)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "最",
                                "target_lang_sense_clarification": "用于比较级结构中表示最高程度"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "949258f5-5b5c-3753-ae74-4f93f364551d",
                    "sense_definition": "Альтернативное написание слова <w>всё</w> (в значении «всё» или «постоянно»).",
                    "learner_level": "A1",
                    "frequency": "Middle",
                    "semantic_group_id": "spelling_var",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он забы́л <w>все</w>, что знал.",
                            "target_lang_translations": {
                                "en": "He forgot <w>everything</w> he knew.",
                                "zh": "他忘记了自己知道的<w>一切</w>。"
                            }
                        },
                        {
                            "text": "Мы <w>все</w> ещё ждём отве́та.",
                            "target_lang_translations": {
                                "en": "We are <w>still</w> waiting for an answer.",
                                "zh": "我们<w>仍然</w>在等待回复。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "spelling variant without 'ё'"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Alternative spelling of the word 'всё' (meaning 'everything' or 'constantly').",
                        "zh": "词汇“一切”或“仍然”的拼写变体。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "everything",
                                "target_lang_sense_clarification": "all things (spelling variant of всё)"
                            },
                            {
                                "target_lang_word": "still",
                                "target_lang_sense_clarification": "continuing to happen (in phrase 'все ещё')"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "一切",
                                "target_lang_sense_clarification": "指代所有事物"
                            },
                            {
                                "target_lang_word": "仍然",
                                "target_lang_sense_clarification": "表示动作持续进行"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "determiner",
            "senses": [
                {
                    "sense_id": "6a55e48e-6a76-391e-a76c-4b4ff130cc50",
                    "sense_definition": "Множественное число местоимения <w>весь</w>; употребляется с существительными для обозначения полного охвата.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "all_det",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Не <w>все</w> соба́ки лю́бят пла́вать.",
                            "target_lang_translations": {
                                "en": "Not <w>all</w> dogs like to swim.",
                                "zh": "并非<w>所有</w>狗都喜欢游泳。"
                            }
                        },
                        {
                            "text": "<w>Все</w> студе́нты сда́ли экза́мен.",
                            "target_lang_translations": {
                                "en": "<w>All</w> the students passed the exam.",
                                "zh": "<w>所有</w>学生都通过了考试。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "все люди",
                        "все виды",
                        "во все времена"
                    ],
                    "target_lang_definitions": {
                        "en": "Plural of the pronoun 'ves''; used with nouns to denote full coverage.",
                        "zh": "代词“全部”的复数形式，与名词连用表示完全覆盖。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "all",
                                "target_lang_sense_clarification": "determiner used with plural nouns"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "所有",
                                "target_lang_sense_clarification": "限定名词表示全部"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}