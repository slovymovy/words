                "senses": [
                    {
                        "sense_id": "f74a97af-d58f-311c-b06c-320e30e02cb1",
                        "entry_id": "e5355419-4b3b-3fa6-98f8-6b2c778ec127",
                        "glosses": [
                            "Celui qui est savant en droit canon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cceb4d4d-35a4-48fb-a4cb-b66b54643bd4",
                                "sense_id": "f74a97af-d58f-311c-b06c-320e30e02cb1",
                                "text": "N’en doutez point, leur dit ce savant canoniste,\nCe coup part, j’en suis sûr, d’une main janséniste."
                            },
                            {
                                "example_id": "44dc5cf8-0b45-4c62-9bf3-7be09f981f75",
                                "sense_id": "f74a97af-d58f-311c-b06c-320e30e02cb1",
                                "text": "Canonistes et théologiens se sont retrouvés à Lyon, vendredi, pour relire ensemble le Synode sur la famille. Le motu proprio sur les nullités de mariage, voulu par le pape, suscite un certain nombre de réserves dans les officialités."
                            },
                            {
                                "example_id": "27b66a62-4d48-491a-9696-1b0191679d16",
                                "sense_id": "f74a97af-d58f-311c-b06c-320e30e02cb1",
                                "text": "Comme le soutient avec justesse la canoniste Marie Zimmermann, la femme au sein de l'Église est inexistante, même si par ailleurs elle s'y révèle extrêmement active."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ee7a5153-1c7b-48cd-8672-9b864c8c2ce0",
                        "source_entry_id": "e5355419-4b3b-3fa6-98f8-6b2c778ec127",
                        "source_sense_id": "f74a97af-d58f-311c-b06c-320e30e02cb1",
                        "target_lang_word": "Kanonist",
                        "target_lang_code": "de",
