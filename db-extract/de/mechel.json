                ],
                "senses": [
                    {
                        "sense_id": "d14eaba7-b0a9-37b4-82a3-67770c2edeb6",
                        "entry_id": "4bf7639d-1b56-32fc-a336-f8bd74425e09",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d73f185-fc9e-444a-a86a-0e4ef91a174b",
                                "sense_id": "d14eaba7-b0a9-37b4-82a3-67770c2edeb6",
                                "text": "Frau Mechel ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "04bc4d6b-b515-4340-abc1-c55c7ccab65f",
                                "sense_id": "d14eaba7-b0a9-37b4-82a3-67770c2edeb6",
                                "text": "Herr Mechel wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "35c9d08b-cffe-4e40-b963-1aaffe43da62",
                                "sense_id": "d14eaba7-b0a9-37b4-82a3-67770c2edeb6",
                                "text": "Die Mechels fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "13339e05-376c-426a-b744-a1fd37e1714d",
                                "sense_id": "d14eaba7-b0a9-37b4-82a3-67770c2edeb6",
                                "text": "Der Mechel trägt nie die Schals, die die Mechel ihm strickt."
                            },
                            {
                                "example_id": "5b93560c-db16-4ea1-b668-2fb63ea1555a",
                                "sense_id": "d14eaba7-b0a9-37b4-82a3-67770c2edeb6",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Mechel kommt, geht der Herr Mechel.“"
                            },
                            {
                                "example_id": "4df09000-30f0-4ecb-923b-1adcce4221e0",
                                "sense_id": "d14eaba7-b0a9-37b4-82a3-67770c2edeb6",
                                "text": "Mechel kommt und geht."
                            },
                            {
                                "example_id": "f596df5c-fcd4-4062-ac1c-2a6e0f7440c6",
                                "sense_id": "d14eaba7-b0a9-37b4-82a3-67770c2edeb6",
                                "text": "Mechels kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
