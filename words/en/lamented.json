                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "56dcba4f-274a-381a-8b41-4fc497084e0a",
                    "sense_definition": "mourned for, deeply missed, or grieved for, especially after death or loss",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "grieve",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The university honored their late and widely <w>lamented</w> professor with a memorial lecture.",
                            "target_lang_translations": {
                                "nl": "De universiteit eerde haar overleden en alom <w>betreurde</w> professor met een herdenkingslezing."
                            }
                        },
                        {
                            "text": "The much <w>lamented</w> railway line was officially closed down forty years ago.",
                            "target_lang_translations": {
                                "nl": "De veel <w>betreurde</w> spoorlijn werd veertig jaar geleden officieel gesloten."
                            }
                        }
                    ],
                    "synonyms": [
                        "mourned",
                        "missed"
                    ],
                    "antonyms": [
                        "unlamented",
                        "unmourned"
                    ],
                    "common_phrases": [
                        "much lamented",
                        "late lamented"
                    ],
                    "target_lang_definitions": {
                        "nl": "beweend, diep gemist of betreurd, vooral na overlijden of verlies"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "betreurd",
                                "target_lang_sense_clarification": "diep gemist of om gerouwd"
                            },
                            {
                                "target_lang_word": "beweend",
