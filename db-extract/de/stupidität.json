                ],
                "senses": [
                    {
                        "sense_id": "f38db601-6a61-3948-87f6-9dade062f4e7",
                        "entry_id": "cf5f5ebd-21f2-3335-81a5-59bb0e6ca6da",
                        "glosses": [
                            "Eigenschaft/Haltung/Handlungsweise, die in deutlichem Maße dummes (stupides) Verhalten zeigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38121ebc-d169-493d-99a0-94c77aab85ff",
                                "sense_id": "f38db601-6a61-3948-87f6-9dade062f4e7",
                                "text": "„Kein Land in Europa hat solche Stupiditäten begangen wie wir.“"
                            },
                            {
                                "example_id": "a104d1e1-1b23-4e3b-a444-df22861cd2f3",
                                "sense_id": "f38db601-6a61-3948-87f6-9dade062f4e7",
                                "text": "„Jener Partnertausch und jener Gruppensex, die Furore machten, waren als zeitgemäße Sumpfblüten spezifisch zerstörter Sinnlichkeit an kleinbürgerlicher Stupidität kaum zu überbieten.“"
                            },
                            {
                                "example_id": "c799093f-b0e8-4ee2-9be1-28e6cbecf26b",
                                "sense_id": "f38db601-6a61-3948-87f6-9dade062f4e7",
                                "text": "„Mit einer Gelassenheit, die an Stupidität grenzte, nahm er jeden Tag, jedes Wetter und jeden Menschen hin.“ (1844)"
                            },
                            {
                                "example_id": "ae17a3bf-12a8-4c22-88af-8cca98d31afe",
                                "sense_id": "f38db601-6a61-3948-87f6-9dade062f4e7",
                                "text": "„Offenbar lag ihnen daran, die Kranken, die aus ihren Zimmern vielleicht auf die Mauer blicken konnten, mit ihrer unbeschreiblichen Stupidität zu deprimieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7ac98ffe-d629-335a-91ab-c1b21036da18",
                        "entry_id": "cf5f5ebd-21f2-3335-81a5-59bb0e6ca6da",
                        "glosses": [
                            "Eigenschaft/Haltung/Handlungsweise, die in deutlichem Maße eintöniges (stupides) Verhalten zeigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "062186ed-8d26-4d49-9fb4-6f04ee2fda25",
                                "sense_id": "7ac98ffe-d629-335a-91ab-c1b21036da18",
                                "text": "„Mit einer Gelassenheit, die an Stupidität grenzte, nahm er jeden Tag, jedes Wetter und jeden Menschen hin.“ (1844)"
                            },
                            {
                                "example_id": "d2aba99a-8d4b-4707-9ab3-5b3d48fad0ef",
                                "sense_id": "7ac98ffe-d629-335a-91ab-c1b21036da18",
                                "text": "„Offenbar lag ihnen daran, die Kranken, die aus ihren Zimmern vielleicht auf die Mauer blicken konnten, mit ihrer unbeschreiblichen Stupidität zu deprimieren.“"
                            },
                            {
                                "example_id": "cafa99f1-eb4f-4501-8243-da02b4415ce2",
                                "sense_id": "7ac98ffe-d629-335a-91ab-c1b21036da18",
                                "text": "„Diese gesellschaftliche Dimension der Arbeit wäre geeignet, der Stupidität von Routinetätigkeiten etwas entgegenzusetzen und Grundlage eines stolzen Selbstbildes zu sein.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bfb9a0ae-11c2-4106-bf55-d831a11569a3",
                        "source_entry_id": "cf5f5ebd-21f2-3335-81a5-59bb0e6ca6da",
                        "source_sense_id": "f38db601-6a61-3948-87f6-9dade062f4e7",
                        "source_sense_description": "Eigenschaft/Haltung/Handlungsweise, die in deutlichem Maße dummes (stupides) Verhalten zeigt",
                        "target_lang_word": "stupidity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stupidity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "072a3d7d-6ff5-3a40-8566-124fc5662f87",
                                        "entry_id": "44f4e45f-b2b2-33e4-b4e7-8b7235bccdf0",
                                        "glosses": [
                                            "The property of being stupid."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de1f608d-64aa-4ebe-a084-c4cc0a076684",
                                                "sense_id": "072a3d7d-6ff5-3a40-8566-124fc5662f87",
                                                "text": "I suppose you can put it down to gross stupidity, but that's not much of an excuse."
                                            },
                                            {
                                                "example_id": "7326125d-66d4-486b-beed-5a78d23abb45",
                                                "sense_id": "072a3d7d-6ff5-3a40-8566-124fc5662f87",
                                                "text": "And Vickers launched forth into a tirade very different from his platform utterances. He spoke with extreme contempt of the dense stupidity exhibited on all occasions by the working classes. He said that if you wanted to do anything for them, you must rule them, not pamper them. Soft heartedness caused more harm than good."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d548616e-b335-328e-b034-e4dcdeff84f5",
                                        "entry_id": "44f4e45f-b2b2-33e4-b4e7-8b7235bccdf0",
                                        "glosses": [
                                            "An act that is stupid."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "299ef560-36cd-4e25-8d1d-8b6d21083b4b",
                                                "sense_id": "d548616e-b335-328e-b034-e4dcdeff84f5",
                                                "text": "Jimmy's stupidity cost him his car."
                                            },
                                            {
                                                "example_id": "81d94253-4d45-4c29-a849-5474c3e9b753",
                                                "sense_id": "d548616e-b335-328e-b034-e4dcdeff84f5",
                                                "text": "8. They require that crass stupidities shall not be played upon the reader as “the craft of the woodsman, the delicate art of the forest,” by either the author or the people in the tale."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
