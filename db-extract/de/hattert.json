                "senses": [
                    {
                        "sense_id": "3f35eeb0-3eca-3caf-917e-d08ef1ae3b09",
                        "entry_id": "96ee36c2-aedf-3ed6-9a46-59364325ec77",
                        "glosses": [
                            "Gebiet einer Gemeinde samt dazugehörigem Umland (Wald- und Weideland); gesamte Fläche einer Gemeinde"
                        ],
                        "tags": [
                            "Rumänien"
                        ],
                        "examples": [
                            {
                                "example_id": "f853d85b-d19f-4d29-8bd7-700fea62e140",
                                "sense_id": "3f35eeb0-3eca-3caf-917e-d08ef1ae3b09",
                                "text": "„Diese Familie beanspruchte einen Teil des Schäßburger Hatterts (Hattert = Gemarkung, das zur Stadt gehörende Umland) sowie einen Teil der Nachbardörfer Lasseln und Dunesdorf aufgrund einer von König Ludwig I. erlassenen Urkunde.“"
                            },
                            {
                                "example_id": "ea274903-ae17-48ec-8b76-9572ed8fcce0",
                                "sense_id": "3f35eeb0-3eca-3caf-917e-d08ef1ae3b09",
                                "text": "„Im Südwesten durchquert den Heldsdörfer Hattert eine Gasleitung von Zeiden zum Uran-Werk Marienburg.“"
                            },
                            {
                                "example_id": "25f416be-506b-4f56-8920-3b36e2644cfb",
                                "sense_id": "3f35eeb0-3eca-3caf-917e-d08ef1ae3b09",
                                "text": "„Der Reichesdorfer Bauer Hans Schaas kann sich noch gut daran erinnern, als sie beide den ganzen Hattert abgrasten, um heimische Obstsorten ausfindig zu machen.“"
                            },
                            {
                                "example_id": "0b5d40ca-376f-4a74-b7a9-366a54213c8b",
                                "sense_id": "3f35eeb0-3eca-3caf-917e-d08ef1ae3b09",
                                "text": "„Dieser zweite Salzbrunnen liegt heute auf Sommerburger Hattert, also Gemarkung.“"
                            },
                            {
                                "example_id": "93486b21-e10d-4196-8945-0bc14a68fe8b",
                                "sense_id": "3f35eeb0-3eca-3caf-917e-d08ef1ae3b09",
                                "text": "„Ein Krug Wein von jedem Hauswirt war der Dank für das Säubern der acht Quellen auf dem Schönauer Hattert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
