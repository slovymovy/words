                                        "sense_id": "c3c07e8b-10e3-3a8a-b751-3987466da967",
                                        "entry_id": "18a6f3bb-2f48-3d2f-97f7-c24577a32d3a",
                                        "glosses": [
                                            "An essential part of something that provides support."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ee8c983-e0eb-4343-a3d9-552e3c0228cf",
                                                "sense_id": "c3c07e8b-10e3-3a8a-b751-3987466da967",
                                                "text": "He's a pillar of the community."
                                            },
                                            {
                                                "example_id": "111d0bc9-3cfd-4157-9cc8-820cc5ba1f79",
                                                "sense_id": "c3c07e8b-10e3-3a8a-b751-3987466da967",
                                                "text": "In the Shanghai Communiqué of 1972, we recognized the fact that both Beijing and Taipei viewed Taiwan as part of China but unequivocally expressed our support for a peaceful settlement of the unification issue. While we should not alter the fundamental pillars of our policy, we should consider certain steps that will raise Taiwan's international standing."
                                            },
                                            {
                                                "example_id": "28d8e8cd-0ba5-4cb7-8a5b-f2bd474692b3",
                                                "sense_id": "c3c07e8b-10e3-3a8a-b751-3987466da967",
                                                "text": "Star Trek is one of the pillars of modern entertainment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0dea8da9-875b-3eed-92da-6531f5ae623b",
                                        "entry_id": "18a6f3bb-2f48-3d2f-97f7-c24577a32d3a",
                                        "glosses": [
                                            "A portable ornamental column, formerly carried before a cardinal, as emblematic of his support to the church."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43869aa0-6c7b-4c09-8bea-406ed5735bab",
                                                "sense_id": "0dea8da9-875b-3eed-92da-6531f5ae623b",
                                                "text": "two laye-men secular\neache of theym holdynge a pillar\nIn their hondes, steade of a mace"
                                            }
                                        ]
