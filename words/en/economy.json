{
    "word_family": [
        "economic",
        "economical",
        "economics",
        "economist",
        "economize"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "56b81383-8b6d-361b-b564-5fe9ec151978",
                    "sense_definition": "The system of trade, industry, and money organization in a country or region.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "financial_system",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government promised to boost the national <w>economy</w> by creating more jobs.",
                            "target_lang_translations": {
                                "ru": "Правительство пообещало укрепить национальную <w>экономику</w>, создав больше рабочих мест.",
                                "zh": "政府承诺通过创造更多就业机会来促进国民<w>经济</w>。"
                            }
                        },
                        {
                            "text": "Tourism contributes significantly to the local <w>economy</w> of the island.",
                            "target_lang_translations": {
                                "ru": "Туризм вносит значительный вклад в местную <w>экономику</w> острова.",
                                "zh": "旅游业对该岛的当地<w>经济</w>贡献巨大。"
                            }
                        }
                    ],
                    "synonyms": [
                        "financial system",
                        "market"
                    ],
                    "common_phrases": [
                        "global economy",
                        "market economy",
                        "boost the economy",
                        "strong economy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Система производства, распределения и потребления товаров и услуг в стране или регионе.",
                        "zh": "一个国家或地区的贸易、工业和货币组织体系。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "эконо́мика",
                                "target_lang_sense_clarification": "финансовая система страны"
                            },
                            {
                                "target_lang_word": "хозя́йство",
                                "target_lang_sense_clarification": "производственная деятельность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "经济",
                                "target_lang_sense_clarification": "指国家或地区的经济体系"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "67050eb4-2950-3000-a255-00ca849716e9",
                    "sense_definition": "The cheapest class of travel on an airplane or train.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "travel_class",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to fly <w>economy</w> to save money for our hotel.",
                            "target_lang_translations": {
                                "ru": "Мы решили лететь <w>эконом-классом</w>, чтобы сэкономить деньги на отель.",
                                "zh": "我们决定<w>坐经济舱</w>，以便为酒店省钱。"
                            }
                        },
                        {
                            "text": "The seats in <w>economy</w> are often quite narrow with little legroom.",
                            "target_lang_translations": {
                                "ru": "Сиденья в <w>эконом-классе</w> часто довольно узкие, с небольшим пространством для ног.",
                                "zh": "<w>经济舱</w>的座位通常很窄，腿部空间很小。"
                            }
                        }
                    ],
                    "synonyms": [
                        "coach class",
                        "tourist class",
                        "coach",
                        "standard class"
                    ],
                    "antonyms": [
                        "first class",
                        "business class"
                    ],
                    "common_phrases": [
                        "fly economy",
                        "economy class",
                        "premium economy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Самый дешевый класс обслуживания в самолете или поезде.",
                        "zh": "飞机或火车上最便宜的旅行舱位。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "эконо́м-класс",
                                "target_lang_sense_clarification": "класс обслуживания"
                            },
                            {
                                "target_lang_word": "эконо́м",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "经济舱",
                                "target_lang_sense_clarification": "旅行舱位等级"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e849c03b-5eef-31e8-be67-566da8997587",
                    "sense_definition": "The intentional saving of money, time, or resources; the practice of avoiding waste.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "frugality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Buying cheap tools is often a false <w>economy</w> because they break so quickly.",
                            "target_lang_translations": {
                                "ru": "Покупка дешевых инструментов часто оказывается ложной <w>экономией</w>, так как они очень быстро ломаются.",
                                "zh": "购买廉价工具往往是一种虚假的<w>节约</w>，因为它们坏得太快了。"
                            }
                        },
                        {
                            "text": "She managed the household budget with great <w>economy</w> and care.",
                            "target_lang_translations": {
                                "ru": "Она распоряжалась семейным бюджетом с большой <w>экономией</w> и осмотрительностью.",
                                "zh": "她非常<w>节省</w>且细心地管理着家庭预算。"
                            }
                        }
                    ],
                    "synonyms": [
                        "thrift",
                        "frugality",
                        "saving"
                    ],
                    "antonyms": [
                        "extravagance",
                        "wastefulness"
                    ],
                    "common_phrases": [
                        "false economy",
                        "practice economy",
                        "with economy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Намеренное сбережение денег, времени или ресурсов; избегание расточительства.",
                        "zh": "有意识地节省金钱、时间或资源；避免浪费的做法。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "эконо́мия",
                                "target_lang_sense_clarification": "сбережение ресурсов"
                            },
                            {
                                "target_lang_word": "бережли́вость",
                                "target_lang_sense_clarification": "качество личности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "节约",
                                "target_lang_sense_clarification": "节省资源的行为"
                            },
                            {
                                "target_lang_word": "节省",
                                "target_lang_sense_clarification": "减少开支或消耗"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "88e1c4dd-8f2e-3c58-9881-752b866bce41",
                    "sense_definition": "The careful arrangement or organization of parts within a whole system or work.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The critic praised the <w>economy</w> of the poem, noting that every word was essential.",
                            "target_lang_translations": {
                                "ru": "Критик похвалил <w>лаконичность</w> поэмы, отметив, что каждое слово было необходимым.",
                                "zh": "评论家称赞了这首诗的<w>简洁</w>，指出每一个字都是必不可少的。"
                            }
                        },
                        {
                            "text": "He admired the elegant <w>economy</w> of the machine's design.",
                            "target_lang_translations": {
                                "ru": "Он восхищался элегантной <w>рациональностью</w> конструкции машины.",
                                "zh": "他钦佩该机器设计中优雅的<w>精炼</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "structure",
                        "organization",
                        "composition"
                    ],
                    "common_phrases": [
                        "economy of style",
                        "economy of language"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in literary or formal contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тщательная организация частей внутри целого; лаконичность и отсутствие лишнего.",
                        "zh": "在一个整体系统或作品中对各部分的精心安排或组织，指简洁、精炼。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лакони́чность",
                                "target_lang_sense_clarification": "стиля или языка"
                            },
                            {
                                "target_lang_word": "рациона́льность",
                                "target_lang_sense_clarification": "конструкции или устройства"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "简洁",
                                "target_lang_sense_clarification": "指语言或设计的精炼"
                            },
                            {
                                "target_lang_word": "精炼",
                                "target_lang_sense_clarification": "指结构或表达的紧凑"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1bf93395-e3e6-3157-ab3c-d067cf7e5b37",
                    "sense_definition": "Designed to be cheap to buy or use; offering good value for money.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "cheap_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We rented a small <w>economy</w> car for our weekend trip.",
                            "target_lang_translations": {
                                "ru": "Мы арендовали небольшой <w>экономичный</w> автомобиль для нашей поездки на выходные.",
                                "zh": "我们为周末旅行租了一辆小型<w>经济型</w>轿车。"
                            }
                        },
                        {
                            "text": "The supermarket sells an <w>economy</w> pack of pasta that is much cheaper.",
                            "target_lang_translations": {
                                "ru": "Супермаркет продает <w>экономичную</w> упаковку макарон, которая стоит намного дешевле.",
                                "zh": "超市出售一种<w>经济型</w>包装的意大利面，价格便宜得多。"
                            }
                        }
                    ],
                    "synonyms": [
                        "budget",
                        "inexpensive",
                        "economical",
                        "cheap",
                        "value"
                    ],
                    "antonyms": [
                        "luxury",
                        "premium",
                        "expensive"
                    ],
                    "common_phrases": [
                        "economy car",
                        "economy size",
                        "economy pack"
                    ],
                    "target_lang_definitions": {
                        "ru": "Недорогой при покупке или использовании; выгодный по соотношению цены и качества.",
                        "zh": "设计为购买或使用成本较低的；性价比高的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "экономи́чный",
                                "target_lang_sense_clarification": "выгодный в использовании"
                            },
                            {
                                "target_lang_word": "бюдже́тный",
                                "target_lang_sense_clarification": "недорогой"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "经济型",
                                "target_lang_sense_clarification": "指产品价格实惠"
                            },
                            {
                                "target_lang_word": "实惠",
                                "target_lang_sense_clarification": "指性价比高"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "cdc7d1aa-8f1a-3abc-9b82-ada1e91534b5",
                    "sense_definition": "In or via the cheapest class of air or rail travel.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "travel_adv",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Most students have to travel <w>economy</w> because of their limited budget.",
                            "target_lang_translations": {
                                "ru": "Большинству студентов приходится путешествовать <w>эконом-классом</w> из-за ограниченного бюджета.",
                                "zh": "大多数学生因为预算有限，不得不<w>坐经济舱</w>旅行。"
                            }
                        },
                        {
                            "text": "If you book early, you can fly <w>economy</w> for a very low price.",
                            "target_lang_translations": {
                                "ru": "Если бронировать заранее, можно улететь <w>эконом-классом</w> по очень низкой цене.",
                                "zh": "如果你提前预订，可以用很低的价格<w>坐经济舱</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "fly economy",
                        "travel economy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Путешествие самым дешевым классом (в самолете или поезде).",
                        "zh": "以最便宜的舱位（飞机或火车）旅行。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "эконо́м-классом",
                                "target_lang_sense_clarification": "наречие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "坐经济舱",
                                "target_lang_sense_clarification": "以经济舱方式旅行"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}