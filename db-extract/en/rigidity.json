                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79afe12d-3265-4e4e-9a36-be0afdf2d257",
                                                "sense_id": "626e2293-ef2c-3c6b-86ac-0e00f8b19430",
                                                "text": "Les magistrats font observer cette loi avec une extrême rigidité."
                                            },
                                            {
                                                "example_id": "8283629e-e036-4189-852d-62a0a96b5da7",
                                                "sense_id": "626e2293-ef2c-3c6b-86ac-0e00f8b19430",
                                                "text": "La rigidité de ses mœurs."
                                            },
                                            {
                                                "example_id": "0dbd7930-07de-40fe-b66b-7bebd222b264",
                                                "sense_id": "626e2293-ef2c-3c6b-86ac-0e00f8b19430",
                                                "text": "La rigidité de sa morale, de la discipline qu’il veut établir."
                                            },
                                            {
                                                "example_id": "287ab675-ade9-412c-a66c-2d59d8c790a6",
                                                "sense_id": "626e2293-ef2c-3c6b-86ac-0e00f8b19430",
                                                "text": "La rigidité des puritains, des jansénistes."
                                            }
                                        ]
                                    }
                                ]
                            }
