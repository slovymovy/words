                        "tags": [
                            "plural"
                        ],
                        "form": "personnalisations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a120c70f-d3a8-3f91-8218-3bad2191c139",
                        "entry_id": "219cb889-988e-3a4b-b96a-b60ab3c44f7e",
                        "glosses": [
                            "customization, personalization"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "ced86018-274f-49db-be86-6dbee06d6fce",
                                "sense_id": "a120c70f-d3a8-3f91-8218-3bad2191c139",
                                "text": "Plutôt que de concevoir une nouvelle plate-forme, élargir la gamme des moteurs, enrichir habitacle ou retravailler le rapport encombrement-habitabilité, la marque italienne est attachée à lancer de nouvelles teintes (un bordeaux assez élégant et un rouge fraise écrasée du meilleur effet), des harmonies intérieures pimpantes et proposer, imitant exemple de la DS3 ou de la Mini, des solutions de personnalisation afin que chacun puisse imaginer son propre modèle."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
