                "senses": [
                    {
                        "sense_id": "18ee98e2-ec3b-3641-bcdf-175e0905686d",
                        "entry_id": "43882e17-1074-3de7-a800-2a3ba562fa7a",
                        "glosses": [
                            "Variante orthographique de ramponeau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "184fb2d4-2d58-493a-bfeb-84188981ee6a",
                                "sense_id": "18ee98e2-ec3b-3641-bcdf-175e0905686d",
                                "text": "Comme je suis un gars pratique, prudent et fièrement pacifique, pour éviter la tentation d'un ramponneau vengeur et ses emmouscaillements collatéraux, je me fais rare dans les parages.\nD'autres, moins matois, se sont fait épingler."
                            },
                            {
                                "example_id": "50fc60c1-c623-4012-adcc-37662950de4b",
                                "sense_id": "18ee98e2-ec3b-3641-bcdf-175e0905686d",
                                "text": "Moi, je le sais. Comme je sais que vous êtes revenue… peut-être pas spécialement pour m’administrer un ramponneau derrière les oreilles… mais, enfin, j’y ai eu droit."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
