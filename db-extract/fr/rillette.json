                        "entry_id": "306d7ed2-bbc4-3223-b346-076cf4ead325",
                        "glosses": [
                            "Viande de porc hachée menu et mêlée de graisse, dont on fait des conserves."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba47c13d-955a-4fda-a0ac-305a4406766c",
                                "sense_id": "a9a2b5cf-3ea1-3aaf-b426-ef2ae117f1d7",
                                "text": "La véritable rillette du Mans."
                            },
                            {
                                "example_id": "d7d7aea3-86ce-4153-b128-03b9b0190ce0",
                                "sense_id": "a9a2b5cf-3ea1-3aaf-b426-ef2ae117f1d7",
                                "text": "Je me souviens d’avoir pendant la guerre dû casser la croûte à proximité d’une dizaine de morts et l’ami de l’un d’eux piochait dans une boîte avec son couteau en disant : « Ça, c’est de la rillette ! Ce pauvre Albert, tiens, il était du Mans, il les adorait. »"
                            }
                        ]
                    },
                    {
                        "sense_id": "d88f623a-9d3d-3907-b289-b62e2781c71d",
                        "entry_id": "306d7ed2-bbc4-3223-b346-076cf4ead325",
                        "glosses": [
                            "Viande ou chair de poisson hachée et mêlée de graisse, dont on fait des conserves."
                        ],
