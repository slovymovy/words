                            {
                                "example_id": "c8ebc589-b5d5-4327-b687-79e2aea571ae",
                                "sense_id": "b836558e-fcc4-3d7b-bd17-b8ad1ca44b85",
                                "text": "Quant à moi, en bonne pillarde que je suis, je prends ce qui me tombe de plus précieux sous la main et je rentre par le premier bateau."
                            },
                            {
                                "example_id": "e2901123-1cc1-46fb-b5c3-e5dbf4ff8d8d",
                                "sense_id": "b836558e-fcc4-3d7b-bd17-b8ad1ca44b85",
                                "text": "La pillarde souleva l’homme de terre sans le toucher et exerça une pression à distance sur sa gorge."
                            }
                        ]
