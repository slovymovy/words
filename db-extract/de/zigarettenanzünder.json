                "senses": [
                    {
                        "sense_id": "44f0ae4c-680a-3303-aee9-1947a34d2316",
                        "entry_id": "c8be95a3-f76c-3e53-baac-4adeeab9b537",
                        "glosses": [
                            "Gerät in einem Kraftfahrzeug, mit dem man Zigaretten anzünden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48be8892-32dd-4253-948b-db75fbec40b8",
                                "sense_id": "44f0ae4c-680a-3303-aee9-1947a34d2316",
                                "text": "„Ich drückte den Zigarettenanzünder rein, steckte mir eine zwischen die Lippen und knipste das Autoradio an.“"
                            },
                            {
                                "example_id": "a8e6d09a-f5dd-4008-975d-ec1c97d9e3ba",
                                "sense_id": "44f0ae4c-680a-3303-aee9-1947a34d2316",
                                "text": "„Der Zigarettenanzünder im Armaturenbrett springt glühend heraus, und der Mechaniker sagt, ich soll die Kerzen auf der Geburtstagstorte anzünden.“"
                            },
                            {
                                "example_id": "9d30b26c-53e6-440b-a67c-b5819a14ffac",
                                "sense_id": "44f0ae4c-680a-3303-aee9-1947a34d2316",
                                "text": "„Es herrscht auch kein besonders dichter Verkehr. Daher stöpselt Hiro seinen Computer in den Zigarettenanzünder und riskiert einen Blick ins Metaversum.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
