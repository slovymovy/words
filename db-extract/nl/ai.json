                                    {
                                        "sense_id": "fc625e79-9a54-38bf-a310-eff1880f73ee",
                                        "entry_id": "9f5c2869-6d6c-3bc8-b707-d2b317359100",
                                        "glosses": [
                                            "To be idle; to idle (away time)."
