                                        "glosses": [
                                            "Of, or relating to modernism."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "911d4d6d-5733-4ffb-b3a8-ac868f25a961",
                                                "sense_id": "032fcaaa-630e-340e-928e-77e3626e6007",
                                                "text": "It survived the overreach of progress once before, escaping demolition and rebuilding in the 1970s. That survival was a triumph against the \"stridently modernist\" plans then put forth."
                                            }
                                        ]
