        "fr-extract.jsonl": [
            {
                "entry_id": "9bfcafcd-7d6f-3fd1-8db1-01abac95f47b",
                "word": "mercantilisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "15a4b78d-e377-4989-9a77-34df71d9c6c7",
                        "entry_id": "9bfcafcd-7d6f-3fd1-8db1-01abac95f47b",
                        "tags": [
                            "plural"
                        ],
                        "form": "mercantilismes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3d9a6360-7c34-30de-9235-f466790565e5",
                        "entry_id": "9bfcafcd-7d6f-3fd1-8db1-01abac95f47b",
                        "glosses": [
                            "Propension à rechercher en toute circonstance un gain, un profit ; état d'esprit d'une personne mercantile. Ne s’emploie qu’en mauvaise part."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e6b95a2-b9ae-4b39-8018-e006a8426847",
                                "sense_id": "3d9a6360-7c34-30de-9235-f466790565e5",
                                "text": "Ce mercantilisme qui vient empoisonner l’atmosphère des vieux pays, apporte l’envie, la soif de l’argent, les grandes inégalités sociales, les misères et les déchéances de la ville, et transforme en larbins les nobles montagnards d’antan."
                            },
                            {
                                "example_id": "50f71133-8f5f-420a-9617-ea57e587f866",
                                "sense_id": "3d9a6360-7c34-30de-9235-f466790565e5",
                                "text": "À l’appui du panneau, Clépont expliqua la philosophie ambiante : le Cludien éprouve tellement de joie à voir l’autre s’amuser que, pour rien au monde, il ne voudrait entacher son bonheur d’un quelconque mercantilisme."
                            }
                        ]
                    },
                    {
                        "sense_id": "64245ba8-2d8d-3e84-9a6b-cdeb8dad3670",
                        "entry_id": "9bfcafcd-7d6f-3fd1-8db1-01abac95f47b",
                        "glosses": [
                            "Nom donné à une doctrine économique des XVIᵉ et XVIIᵉ siècles préconisant l'accroissement des réserves de l'État en métaux précieux notamment par le développement des activités économiques et des exportations et par l'adoption de mesures protectionnistes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11d05b01-3b26-41b8-8f13-58e2d56d394c",
                                "sense_id": "64245ba8-2d8d-3e84-9a6b-cdeb8dad3670",
                                "text": "Le premier courant de pensée à remettre complètement en cause le mercantilisme est l’école des physiocrates en France."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "be263c65-8597-4c12-b04d-b794af7de71f",
                        "source_entry_id": "9bfcafcd-7d6f-3fd1-8db1-01abac95f47b",
                        "source_sense_description": "École économique prônant le commerce extérieur",
                        "target_lang_word": "mercantilism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mercantilism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ad749172-33c6-3d31-9001-597c894971c8",
                                        "entry_id": "48113517-f35b-3e50-a215-41be8534157e",
                                        "glosses": [
                                            "The theory that a nation must always have a positive balance of trade, in the manner that a merchant would operate a shop. Typically this model presupposes protectionism."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "439928cd-c432-3404-940c-6e5b972a92eb",
                                        "entry_id": "48113517-f35b-3e50-a215-41be8534157e",
                                        "glosses": [
                                            "The theory that holds that the prosperity of a nation depends upon its supply of capital, and that the global volume of trade is unchangeable."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
