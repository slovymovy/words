                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39f90b07-2af9-4b49-bf05-4c522dd65604",
                                "sense_id": "1be8d2d3-16cb-3328-a9a2-339e2f08129f",
                                "text": "L’homoérotisme est un thème artistique qui diffère de la pornographie gay en ce qu’il ne dépeint pas d’acte sexuel."
                            },
                            {
                                "example_id": "438ad718-25c3-45f9-96a2-61118a604400",
                                "sense_id": "1be8d2d3-16cb-3328-a9a2-339e2f08129f",
                                "text": "L’histoire littéraire arabe nous apprend qu’Abû Nuwas (742/762-813/815) a chanté l’homoérotisme bien avant l’âge moderne."
                            }
                        ]
                    }
