        "fr-extract.jsonl": [
            {
                "entry_id": "38823966-f88d-3ce6-b07e-6d3a5145ba92",
                "word": "fashionable",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "05757e4f-60d3-40a0-98b9-2d0a3831d145",
                        "entry_id": "38823966-f88d-3ce6-b07e-6d3a5145ba92",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "fashionables"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1617cfe1-3f98-32b7-8565-1b211062c900",
                        "entry_id": "38823966-f88d-3ce6-b07e-6d3a5145ba92",
                        "glosses": [
                            "Qui est élégant ; qui se pique d’être à la mode."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "941f7606-a8c3-4146-bc9d-3e7a65bd4952",
                                "sense_id": "1617cfe1-3f98-32b7-8565-1b211062c900",
                                "text": "Le grog est fashionable, et le vieux vin de France / Réveille au fond du cœur la gaieté qui s’endort."
                            },
                            {
                                "example_id": "6535bdc2-6034-4d6b-9071-dc772f6210b7",
                                "sense_id": "1617cfe1-3f98-32b7-8565-1b211062c900",
                                "text": "Il est à la mode d’aller à Rome et à Naples ; la Sicile n’est pas encore fashionable."
                            },
                            {
                                "example_id": "e99d23a2-ae35-4edf-a94b-046300e1fab4",
                                "sense_id": "1617cfe1-3f98-32b7-8565-1b211062c900",
                                "text": "En 1772 , la fortune du père de Méhul était dans une prospérité plus que satisfaisante ; ce brave homme possédait un petit cabaret assez fashionable pour y recevoir quelques officiers du régiment suisse de Salis , en garnison à Givet."
                            },
                            {
                                "example_id": "1a297da9-1488-4bd6-8151-7f64d9ee7db5",
                                "sense_id": "1617cfe1-3f98-32b7-8565-1b211062c900",
                                "text": "Un Petit Dunkerque est une sorte de bazar de fines porcelaines et de curiosités artistiques, de charmantes et délicates inutilités , qui en font un bric-à-brac fashionable."
                            },
                            {
                                "example_id": "aa3eed94-ea73-4046-b6e2-800c02366a29",
                                "sense_id": "1617cfe1-3f98-32b7-8565-1b211062c900",
                                "text": "Les gens du peuple ont peur des officiers ministériels comme ils ont peur des restaurants fashionables."
                            },
                            {
                                "example_id": "192a5025-118f-4ad4-87d1-1a9d47123e00",
                                "sense_id": "1617cfe1-3f98-32b7-8565-1b211062c900",
                                "text": "Avec son inséparable ami, Paul Hervieu, il me représentait ce que la littérature a, s’il se peut dire, de plus fashionable et élégant."
                            },
                            {
                                "example_id": "258c3303-410b-4deb-bf3c-32031ec29d15",
                                "sense_id": "1617cfe1-3f98-32b7-8565-1b211062c900",
                                "text": "Par la suite, dans le Dieu fashionable qu’on m’enseigna, je ne reconnus pas celui qu’attendait mon âme : il me fallait un Créateur, on me donnait un Grand Patron."
                            }
                        ]
                    }
                ],
