                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antilope",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "b3625ce8-7242-306f-ae50-fdc2a84695a3",
                                        "entry_id": "de2a4481-3d73-3457-9368-1394845c5e54",
                                        "glosses": [
                                            "een verzamelnaam voor slanke holhoornige hoefdieren die voornamelijk in Afrika leven"
                                        ],
                                        "tags": [
                                            "evenhoevigen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "018aa18f-d8f2-4fe0-b8de-21ec740a6e7f",
                                                "sense_id": "b3625ce8-7242-306f-ae50-fdc2a84695a3",
                                                "text": "De antilopen zetten het op een lopen toen zij de luipaard in de gaten kregen."
                                            },
                                            {
                                                "example_id": "aad873c1-6a0b-4f04-8ac2-15c40a96b99b",
                                                "sense_id": "b3625ce8-7242-306f-ae50-fdc2a84695a3",
                                                "text": "En hij genoot van de bevrediging wanneer hij raak schoot, om de vijand spastisch spartelend te zien sterven, op de grond te zien vallen met wild trappende benen, wat alleen zenuwreflexen waren van iemand die al dood was, ongeveer zoals met een schot door de kop van een antilope."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1ec22627-5e77-4c28-9531-2c6aa6dba30d",
                        "source_entry_id": "38f1b754-2eb5-3a77-9e24-fa4057521a5c",
                        "source_sense_id": "491ffce7-1e7c-3448-852b-2d9ab48e7c0f",
                        "target_lang_word": "Antilope",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Antilope",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d2084e8a-53b8-3dd8-8ed5-d6f32d4ea717",
                                        "entry_id": "3a1fc6a1-74f2-31cf-b42d-c656584a8eae",
                                        "glosses": [
                                            "Sammelbezeichnung für alle Hornträger (Bovidae) außer Rindern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f732c6e-9c73-4def-8b33-48f4d07912bf",
                                                "sense_id": "d2084e8a-53b8-3dd8-8ed5-d6f32d4ea717",
                                                "text": "Die Gams ist die einzige europäische Antilope."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7d6b9c66-d71d-408d-8431-a295128ba3f6",
                        "source_entry_id": "38f1b754-2eb5-3a77-9e24-fa4057521a5c",
                        "source_sense_id": "491ffce7-1e7c-3448-852b-2d9ab48e7c0f",
                        "target_lang_word": "антило́па",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "антило́па",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "bd0a515e-125d-3e1a-9e22-0cc1d5f23b64",
                                        "entry_id": "497a1dc5-14f4-35ff-aeb6-db15a82bac6f",
                                        "glosses": [
                                            "зоол. жвачное млекопитающее семейства полорогих (название объединяет различные подсемейства и рода)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5c28050-83b3-4d3c-b068-ac416768e8b0",
                                                "sense_id": "bd0a515e-125d-3e1a-9e22-0cc1d5f23b64",
                                                "text": "По соседству с ними ходили несколько антилоп огромной величины, буро-жёлтых с чёрными пятнами, как у леопарда, с длинными саблевидными рогами."
                                            },
                                            {
                                                "example_id": "507ad7ff-2c9d-4f8f-b731-97b336453a9f",
                                                "sense_id": "bd0a515e-125d-3e1a-9e22-0cc1d5f23b64",
                                                "text": "Два пастуха позади несли на коромыслах в корзинах маленьких новорождённых антилоп; их матери доверчиво шли рядом и косились чёрными влажными глазами на медленно переступавших людей."
                                            },
                                            {
                                                "example_id": "1b22210c-9681-4c30-aa7a-11286793f0b7",
                                                "sense_id": "bd0a515e-125d-3e1a-9e22-0cc1d5f23b64",
                                                "text": "Самая маленькая из известных антилоп и самое маленькое из жвачных животных ― королевская антилопа, обитающая на западе Африки."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
