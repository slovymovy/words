                            {
                                "example_id": "7587b3bb-fdd8-454a-b906-5c30b4ca056b",
                                "sense_id": "6b86a6a3-3fd5-3fe1-a1dc-e6435edb060f",
                                "text": "Podział na starożytność, średniowiecze i nowożytność znajduje zastosowanie przede wszystkim w historii Europy, choć jest wykorzystywany także w badaniach nad krajami pozaeuropejskimi, szczególnie w opracowaniach syntetycznych."
                            }
                        ],
