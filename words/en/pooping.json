            "senses": [
                {
                    "sense_id": "2c342a82-71f9-3603-a871-6d3c6b345b28",
                    "sense_definition": "The present participle and gerund of <w>poop</w>, referring to the act of defecating.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "defecation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The toddler is finally <w>pooping</w> on the potty by himself.",
                            "target_lang_translations": {
                                "pl": "Maluch w końcu sam <w>robi kupę</w> na nocnik."
                            }
                        },
                        {
                            "text": "I think the puppy is <w>pooping</w> in the backyard right now.",
                            "target_lang_translations": {
                                "pl": "Myślę, że szczeniak właśnie <w>robi kupę</w> na podwórku."
                            }
                        }
                    ],
                    "synonyms": [
                        "defecating"
                    ],
                    "common_phrases": [
                        "stop pooping",
                        "finished pooping"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal but standard usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Forma gerundium i imiesłów czasu teraźniejszego czasownika oznaczającego wypróżnianie się."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "robienie kupy",
                                "target_lang_sense_clarification": "potoczne określenie wypróżniania się"
                            },
                            {
                                "target_lang_word": "wypróżnianie się",
                                "target_lang_sense_clarification": "bardziej formalne określenie czynności fizjologicznej"
                            },
                            {
                                "target_lang_word": "sranie",
                                "target_lang_sense_clarification": "wulgarne określenie wypróżniania się"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1fbced4a-9da3-3fca-a60e-92070e401c2f",
                    "sense_definition": "The act of a wave or another vessel striking the stern of a ship.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "nautical_impact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy seas led to the <w>pooping</w> of the small yacht by a massive wave.",
                            "target_lang_translations": {
                                "pl": "Wzburzone morze doprowadziło do <w>zalania rufy</w> małego jachtu przez potężną falę."
                            }
                        },
                        {
                            "text": "To prevent <w>pooping</w>, the captain tried to keep the vessel ahead of the breaking swells.",
                            "target_lang_translations": {
                                "pl": "Aby zapobiec <w>uderzeniom fal w rufę</w>, kapitan starał się utrzymać jednostkę przed załamującymi się falami."
                            }
                        }
                    ],
                    "common_phrases": [
                        "risk of pooping"
                    ],
                    "target_lang_definitions": {
                        "pl": "Uderzenie fali lub innego statku w rufę jednostki pływającej."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "zalewanie rufy",
                                "target_lang_sense_clarification": "w kontekście uderzenia fali w tył statku"
                            },
                            {
                                "target_lang_word": "uderzenie w rufę",
                                "target_lang_sense_clarification": "ogólne określenie kolizji lub uderzenia fali od tyłu"
                            }
                        ]
                    }
                }
            ]
        }
    ]
