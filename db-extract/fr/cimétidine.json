                "word": "cimétidine",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ff6428dd-b082-35e5-9528-43aa16b60405",
                        "entry_id": "a2c6097f-fc9f-3139-921a-9c6b13f8c6b3",
                        "glosses": [
                            "Composé chimique de formule brute C₁₀H₁₆N₆S, antisécrétoire gastrique antihistaminique H2 utilisé comme antiulcéreux."
                        ],
                        "tags": [
                            "Médicament"
                        ],
                        "examples": [
                            {
                                "example_id": "20956e62-9c72-45e6-849a-4e51ea7dc33e",
                                "sense_id": "ff6428dd-b082-35e5-9528-43aa16b60405",
                                "text": "La cimétidine n’exerce donc pas d’effet significatif sur l’automatisme sinusal, ni la conduction dans les conditions expérimentales précédemment décrites."
                            },
                            {
                                "example_id": "47fc2e26-2479-4c24-8333-9fc79845b6f2",
                                "sense_id": "ff6428dd-b082-35e5-9528-43aa16b60405",
                                "text": "Les anti-H2 disponibles en France sont la cimétidine, la ranitidine, la nizatidine et la famotidine."
                            }
                        ]
                    }
                ],
                "translations": [
