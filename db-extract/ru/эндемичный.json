                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "endemico",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "85b326f4-711c-3cf6-967a-439ae1cabbd6",
                                        "entry_id": "865f9027-5a7e-358f-b845-42d470f3dded",
                                        "glosses": [
                                            "di malattia generalmente contagiosa che insorge con uniformità nel tempo e con casi sporadici in una determinata regione, cui rimane confinata per il persistere nell'ambiente degli organismi patogeni che la provocano"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4dd2e043-181f-4b85-8771-42e70a6eff19",
                                                "sense_id": "85b326f4-711c-3cf6-967a-439ae1cabbd6",
                                                "text": "la malaria è ancora endemica in quella fascia geografica intorno ai tropici ricca di acqua stagnante in cui prospera la zanzara Anopheles"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cbd452a4-6dbd-36cf-822d-cc2581c2d7ba",
                                        "entry_id": "865f9027-5a7e-358f-b845-42d470f3dded",
                                        "glosses": [
                                            "si dice in modo improprio di pandemia che, colpendo strati uniformi dal punto di vista socio-economico e vastissimi di popolazione in zone altrettanto vaste, risparmiandone nel contempo altri, pare essersi scelta i confini entro cui mietere vittime"
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc180561-4cf7-4415-b2d3-c89651dcf5f9",
                                                "sense_id": "cbd452a4-6dbd-36cf-822d-cc2581c2d7ba",
                                                "text": "l'AIDS è endemico in Africa"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b5e025f-1924-37ea-b9da-f5b8bdad0ace",
                                        "entry_id": "865f9027-5a7e-358f-b845-42d470f3dded",
                                        "glosses": [
                                            "in zoologia e botanica, di specie o altre categorie sistematiche (vedi taxon) diffuse in modo esclusivo in un territorio circoscritto (endemismo)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0b5f0b0-0546-4505-b7f8-b5c7b18f5059",
                                                "sense_id": "5b5e025f-1924-37ea-b9da-f5b8bdad0ace",
                                                "text": "il gibbone è un primate endemico dell'Asia sud-orientale"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5c5e770-8532-3f28-aa5a-706873f0a2d9",
                                        "entry_id": "865f9027-5a7e-358f-b845-42d470f3dded",
                                        "glosses": [
                                            "detto di ciò che si manifesta in modo ricorrente o persistente, specialmente se negativo, in un contesto culturale, sociale ed economico ben definito; radicato"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81978960-1c80-409e-8699-aa1d5c2af7e8",
                                                "sense_id": "c5c5e770-8532-3f28-aa5a-706873f0a2d9",
                                                "text": "il contadino è ridotto alla fame endemica"
                                            }
                                        ]
                                    }
                                ]
                            }
