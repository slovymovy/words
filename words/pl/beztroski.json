{
    "word_family": [
        "beztroska",
        "beztrosko"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "53896f53-2d93-3c9e-9ea9-117e82d4ef17",
                    "sense_definition": "osoba nieposiadająca zmartwień, żyjąca lekkomyślnie",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "osobowość",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Młody i <w>beztroski</w> podróżnik wyruszył w świat bez żadnego planu.",
                            "target_lang_translations": {
                                "ru": "Молодой и <w>беспечный</w> путешественник отправился в путь без всякого плана."
                            }
                        },
                        {
                            "text": "Jej <w>beztroski</w> styl życia często irytował bardziej odpowiedzialnych znajomych.",
                            "target_lang_translations": {
                                "ru": "Её <w>беспечный</w> образ жизни часто раздражал более ответственных знакомых."
                            }
                        }
                    ],
                    "synonyms": [
                        "niefrasobliwy",
                        "luzacki"
                    ],
                    "common_phrases": [
                        "beztroski młodzieniec",
                        "beztroski podróżnik"
                    ],
                    "target_lang_definitions": {
                        "ru": "человек, не имеющий забот, живущий легкомысленно"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "беспечный",
                                "target_lang_sense_clarification": "не задумывающийся о последствиях, легкомысленный"
                            },
                            {
                                "target_lang_word": "беззаботный",
                                "target_lang_sense_clarification": "не обремененный заботами и тревогами"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a9c64187-914d-3bcb-9802-50f84f3d27b6",
                    "sense_definition": "stan lub czas wolny od zmartwień i problemów",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "stan",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wspominam swoje <w>beztroskie</w> dzieciństwo spędzone na wsi u dziadków.",
                            "target_lang_translations": {
                                "ru": "Я вспоминаю своё <w>беззаботное</w> детство, проведённое в деревне у бабушки с дедушкой."
                            }
                        },
                        {
                            "text": "To był <w>beztroski</w> czas wakacji, kiedy nie musieliśmy o nic martwić.",
                            "target_lang_translations": {
                                "ru": "Это было <w>беззаботное</w> время каникул, когда нам не нужно было ни о чём беспокоиться."
                            }
                        }
                    ],
                    "synonyms": [
                        "idylliczny",
                        "sielankowy"
                    ],
                    "common_phrases": [
                        "beztroskie dzieciństwo",
                        "beztroski czas"
                    ],
                    "target_lang_definitions": {
                        "ru": "состояние или время, свободное от забот и проблем"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "беззаботный",
                                "target_lang_sense_clarification": "протекающий без тревог и проблем"
                            },
                            {
                                "target_lang_word": "беспечный",
                                "target_lang_sense_clarification": "характеризующий время, лишенное серьезных забот"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "311625c4-b50c-3f65-a5c9-8901e108f9d8",
                    "sense_definition": "wyglądający na wolny od problemów lub świadczący o braku trosk",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "stan",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na jej twarzy malował się <w>beztroski</w> uśmiech, mimo trudnej sytuacji.",
                            "target_lang_translations": {
                                "ru": "На её лице сияла <w>безмятежная</w> улыбка, несмотря на трудную ситуацию."
                            }
                        },
                        {
                            "text": "Wysłuchał wiadomości z <w>beztroski</w> wyrazem twarzy, jakby go to nie dotyczyło.",
                            "target_lang_translations": {
                                "ru": "Он выслушал новости с <w>безмятежным</w> выражением лица, как будто его это не касалось."
                            }
                        }
                    ],
                    "synonyms": [
                        "bezproblemowy"
                    ],
                    "common_phrases": [
                        "beztroski uśmiech"
                    ],
                    "target_lang_definitions": {
                        "ru": "выглядящий свободным от проблем или свидетельствующий об отсутствии забот"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "безмятежный",
                                "target_lang_sense_clarification": "спокойный, чуждый тревоги, ничем не омраченный"
                            },
                            {
                                "target_lang_word": "беззаботный",
                                "target_lang_sense_clarification": "выражающий отсутствие беспокойства"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d36161ff-0d66-38ad-ae07-b9fb634eb39f",
                    "sense_definition": "forma dopełniacza liczby pojedynczej rzeczownika <w>beztroska</w>",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W jego zachowaniu brakowało <w>beztroski</w>, do której przywykliśmy.",
                            "target_lang_translations": {
                                "ru": "В его поведении не хватало <w>беззаботности</w>, к которой мы привыкли."
                            }
                        },
                        {
                            "text": "Nie zaznał w życiu prawdziwej <w>beztroski</w> z powodu ciągłych obowiązków.",
                            "target_lang_translations": {
                                "ru": "Он не познал в жизни настоящей <w>беззаботности</w> из-за постоянных обязанностей."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "forma gramatyczna"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "форма родительного падежа единственного числа существительного «беззаботность»"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "беззаботности",
                                "target_lang_sense_clarification": "форма существительного в родительном падеже"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}