                "senses": [
                    {
                        "sense_id": "9385774d-48ee-39d2-bf67-6b433090b235",
                        "entry_id": "42662c27-3dd9-3dc9-99bc-1a1c3ebba152",
                        "glosses": [
                            "ein Kaminzimmer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80334dd6-6fc9-4ff2-954f-b4e8f4b0c415",
                                "sense_id": "9385774d-48ee-39d2-bf67-6b433090b235",
                                "text": "Sie trug die soeben gespaltenen Holzscheite in die Kemenate und legte sie neben den Kamin."
                            },
                            {
                                "example_id": "f68617ba-d180-4aa0-8b8c-fefad0976883",
                                "sense_id": "9385774d-48ee-39d2-bf67-6b433090b235",
                                "text": "„Dort sitzt in ihrer Kemenate eine blauäugige Frau mit goldschimmernder Gesichtsfarbe und stickt in eine Borte die uralte Saga von Sigurd aus dem Geschlecht der Völsungen, der den Drachen Fafnir bezwang und das Gold eroberte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8d6d7b25-156b-38f1-bb5e-92d9a790fda3",
                        "entry_id": "42662c27-3dd9-3dc9-99bc-1a1c3ebba152",
                        "glosses": [
                            "ein kleiner, gemütlicher Raum"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "3bdb8264-25c2-4afd-a6e9-7fe52b0cbd61",
                                "sense_id": "8d6d7b25-156b-38f1-bb5e-92d9a790fda3",
                                "text": "„Ich sitz mit der Renate in meiner Kemenate bei einer Flasche Sekt, weil zu zweit sie besser schmeckt.“"
                            },
                            {
                                "example_id": "69f324ff-4396-4336-a519-a5cd8367a89c",
                                "sense_id": "8d6d7b25-156b-38f1-bb5e-92d9a790fda3",
                                "text": "„Ich wanderte zurück in meine Kemenate und wartete ebenfalls.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "c711147f-119c-3e58-91c4-63ba9526808d",
                        "entry_id": "42662c27-3dd9-3dc9-99bc-1a1c3ebba152",
                        "glosses": [
                            "ein massiver, heizbarer Steinbau einer Burg"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "ba805c4d-e9e6-4d07-9ce8-1e1d4d11d1c7",
                                "sense_id": "c711147f-119c-3e58-91c4-63ba9526808d",
                                "text": "Die Kemenate war der einzige beheizte Bereich in der gesamten Burg."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b3962b22-77c8-43eb-9be8-5e49ed3c27aa",
                        "source_entry_id": "42662c27-3dd9-3dc9-99bc-1a1c3ebba152",
                        "source_sense_id": "9385774d-48ee-39d2-bf67-6b433090b235",
                        "source_sense_description": "ein Kaminzimmer",
                        "target_lang_word": "cabinet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cabinet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "41c3017a-3940-3467-ab8d-7a24ad588c1f",
                                        "entry_id": "586eed20-f0c0-3446-9485-debf9008cce7",
                                        "glosses": [
                                            "A storage closet either separate from, or built into, a wall."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "007bbc95-17aa-33ad-bf56-0f4392d5dd39",
                                        "entry_id": "586eed20-f0c0-3446-9485-debf9008cce7",
                                        "glosses": [
                                            "A cupboard."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23ae1518-fa91-4946-bef5-369f49eb52cc",
                                                "sense_id": "007bbc95-17aa-33ad-bf56-0f4392d5dd39",
                                                "text": "‘[…] There's every Staffordshire crime-piece ever made in this cabinet, and that's unique. The Van Hoyer Museum in New York hasn't that very rare second version of Maria Marten's Red Barn over there, nor the little Frederick George Manning—he was the criminal Dickens saw hanged on the roof of the gaol in Horsemonger Lane, by the way—’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "915d72ca-51e2-374f-b11d-a05c08ebbab0",
                                        "entry_id": "586eed20-f0c0-3446-9485-debf9008cce7",
                                        "glosses": [
                                            "A source of valuable things; a storehouse."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da862cc1-525c-4a32-bda5-ab09545a1880",
                                                "sense_id": "915d72ca-51e2-374f-b11d-a05c08ebbab0",
                                                "text": "It is a perfect cabinet of faithful, valuable, and extensive information; and it ought to have a place on the shelves of the most select and compact library, and be in the possession of every private family, as a work both of valuable reference."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae7d9f87-d1bd-3780-a91f-691f3ac27122",
                                        "entry_id": "586eed20-f0c0-3446-9485-debf9008cce7",
                                        "glosses": [
                                            "The upright assembly that houses a coin-operated arcade game, a cab."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "317c18ea-383a-3e09-9625-ade230214552",
                                        "entry_id": "586eed20-f0c0-3446-9485-debf9008cce7",
                                        "glosses": [
                                            "A size of photograph, specifically one measuring 3⅞\\\" by 5½\\\"."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "885f5a19-4664-4d16-855c-93515ef2bd15",
                                                "sense_id": "317c18ea-383a-3e09-9625-ade230214552",
                                                "text": "Holmes took a note of it. “One other question,” said he. “Was the photograph a cabinet?”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1acd9061-9b6c-3b49-989a-0af57cd26aff",
                                        "entry_id": "586eed20-f0c0-3446-9485-debf9008cce7",
                                        "glosses": [
                                            "A group of advisors to a government or business entity."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0be5cc8c-d60e-3009-b92e-9d59ee0767f1",
                                        "entry_id": "586eed20-f0c0-3446-9485-debf9008cce7",
                                        "glosses": [
                                            "In parliamentary and some other systems of government, the group of ministers responsible for creating government policy and for overseeing the departments comprising the executive branch."
                                        ],
                                        "tags": [
                                            "capitalized",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a9c73dd-c810-4828-a05d-05821275b6f1",
                                                "sense_id": "0be5cc8c-d60e-3009-b92e-9d59ee0767f1",
                                                "text": "Lincoln had a great deal of trouble with his Cabinet because some of them got it into their heads that they, and not the President, were the policy-makers. James K. Polk had the same difficulty with his Cabinet. Franklin Roosevelt never had any difficulty with his Cabinet for the simple reason that he himself, in my opinion, spent too much time doing the work that should have been delegated to the Cabinet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4059893e-7089-3828-8e61-ade246a9e0ee",
                                        "entry_id": "586eed20-f0c0-3446-9485-debf9008cce7",
                                        "glosses": [
                                            "In parliamentary and some other systems of government, the group of ministers responsible for creating government policy and for overseeing the departments comprising the executive branch.",
                                            "A cabinet-level agency in the executive branch; that is, an agency headed by a member of the governor's cabinet."
                                        ],
                                        "tags": [
                                            "capitalized",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13dba8fe-ddf6-4ce1-923d-d35867cfd61a",
                                                "sense_id": "4059893e-7089-3828-8e61-ade246a9e0ee",
                                                "text": "The executive branch of Kentucky state government is structured on a program cabinet system consisting of 14 program cabinets, each headed by a secretary, who is appointed by the Governor. The program cabinets listed below and the agencies within each cabinet are designated in the statutes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f929cc6f-891d-3b0f-9921-a4fc521ef6f8",
                                        "entry_id": "586eed20-f0c0-3446-9485-debf9008cce7",
                                        "glosses": [
                                            "A small chamber or private room."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f323536b-be58-488c-84ef-e2a95bb37a7b",
                                                "sense_id": "f929cc6f-891d-3b0f-9921-a4fc521ef6f8",
                                                "text": "Philip passed some hours every day in his father's cabinet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d0bd4a2-2d06-37ff-857f-309963d777b9",
                                        "entry_id": "586eed20-f0c0-3446-9485-debf9008cce7",
                                        "glosses": [
                                            "A collection of art or ethnographic objects."
                                        ],
                                        "tags": [
                                            "capitalized",
                                            "often"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ecbd9691-a2f7-3123-9dad-f0d1ad5755b2",
                                        "entry_id": "586eed20-f0c0-3446-9485-debf9008cce7",
                                        "glosses": [
                                            "Milkshake."
                                        ],
                                        "tags": [
                                            "dialectal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa4b6e29-bd14-4e8f-8457-270dc17e88cf",
                                                "sense_id": "ecbd9691-a2f7-3123-9dad-f0d1ad5755b2",
                                                "text": "One of Rhode Island's most famous beverages is the Awful Awful, an enormous 32-ounce, rich, creamy milk shake sold at the Newport Creamery stores, a soda fountain and casual restaurant chain. This ultra-thick cabinet is \"awful big and awful good,\" thus the name."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "399cebd0-5e3c-3bc1-8056-bb601fea7ebd",
                                        "entry_id": "586eed20-f0c0-3446-9485-debf9008cce7",
                                        "glosses": [
                                            "A hut; a cottage; a small house."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9270984-bde5-4e8a-875e-89fa4882319f",
                                                "sense_id": "399cebd0-5e3c-3bc1-8056-bb601fea7ebd",
                                                "text": "Hearken a while from thy green cabinet, / The rural song of careful Colinet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5e8665b-dc1b-33c7-a0ca-2ed977c0ffce",
                                        "entry_id": "586eed20-f0c0-3446-9485-debf9008cce7",
                                        "glosses": [
                                            "An enclosure for mechanical or electrical equipment."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9fe2eb97-fb24-4cee-8510-0a758f09c63a",
                        "source_entry_id": "42662c27-3dd9-3dc9-99bc-1a1c3ebba152",
