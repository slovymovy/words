                        "glosses": [
                            "Characteristic of a curmudgeon; churlish."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f28a864a-7b99-432c-b443-332719c97474",
                                "sense_id": "bdca5513-44a0-3a40-8fa0-b2453a8f8c60",
                                "text": "In A League of Their Own (1992), as the shouty baseball coach to an all-girls team, he's once again a curmudgeonly but lovable mentor figure."
                            },
                            {
                                "example_id": "a4368a02-5450-4618-995a-c14e17080ae5",
                                "sense_id": "bdca5513-44a0-3a40-8fa0-b2453a8f8c60",
                                "text": "Since Swift and Kelce debuted their relationship early in the season, certain (curmudgeonly) NFL fans grumbled over the numerous camera shots of the singer’s private box."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5efdb239-80a9-4ef9-ad4f-7741f40a950a",
                        "source_entry_id": "58980ec7-bc13-3697-894c-b5674f6c50ae",
                        "source_sense_id": "bdca5513-44a0-3a40-8fa0-b2453a8f8c60",
                        "source_sense_description": "churlish",
                        "target_lang_word": "griesgrämig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "griesgrämig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "266d7cca-0445-3ca2-8121-fd146fca7b63",
                                        "entry_id": "892243a1-c2eb-3131-84d9-19cfd1bd9ab1",
                                        "glosses": [
                                            "(ohne nachvollziehbaren Grund) schlecht gelaunt/übellaunig/verdrossen und damit gegenüber anderen unfreundlich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c60c4cb-f87b-484a-a4e0-4799ece47148",
                                                "sense_id": "266d7cca-0445-3ca2-8121-fd146fca7b63",
                                                "text": "„»Computerwissenschaft hat ein Marketing-Problem, wir gelten als die griesgrämige Nerds«, räumte er vergangene Woche bei der hauseigenen Konferenz Google I/O ein.“"
                                            },
                                            {
                                                "example_id": "c7d24686-7583-4cfa-9488-baec9a2aaa19",
                                                "sense_id": "266d7cca-0445-3ca2-8121-fd146fca7b63",
                                                "text": "„So ist ein Foto zu sehen, auf dem sich eine griesgrämige Katze ins Bild schmuggelt.“"
                                            },
                                            {
                                                "example_id": "785537a4-f766-4cb9-a979-70ff0aa87a55",
                                                "sense_id": "266d7cca-0445-3ca2-8121-fd146fca7b63",
                                                "text": "„Nicht Clinton, sondern der fast 75-jährige, oft griesgrämig dreinschauende Sanders repräsentiert für Kaliforniens einflussreiche Demokraten die Zukunft.“"
                                            },
                                            {
                                                "example_id": "9822f93b-5dc1-40c1-b79a-e890493fc877",
                                                "sense_id": "266d7cca-0445-3ca2-8121-fd146fca7b63",
                                                "text": "„Plötzlich war John McCain wieder der griesgrämige alte Mann, der seine Wut und seinen Ärger nur schwer im Zaum halten kann.“"
                                            },
                                            {
                                                "example_id": "603f8725-7ba5-48e7-a56a-395723f0a9dc",
                                                "sense_id": "266d7cca-0445-3ca2-8121-fd146fca7b63",
                                                "text": "„Griesgrämige Nachbarn hatten Alarm geschlagen, die Ordnungshüter fanden zwölf gut gelaunte, wohlerzogene Jugendliche zwischen 16 und 19 Jahren vor, dazu sechs Dosen Leichtbier, die Hälfte noch verschlossen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6da7eb71-c0dc-427c-85a8-9580c4696cc9",
                        "source_entry_id": "58980ec7-bc13-3697-894c-b5674f6c50ae",
