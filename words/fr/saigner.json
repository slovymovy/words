                    "semantic_group_id": "saigner_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après sa chute dans la cour, son genou a commencé à <w>saigner</w> abondamment."
                        },
                        {
                            "text": "Le petit garçon <w>saigne</w> du nez parce qu'il a pris un coup de ballon."
