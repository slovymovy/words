                                "target_senses": [
                                    {
                                        "sense_id": "8762ff41-53ed-3de1-a563-4999c687fb53",
                                        "entry_id": "634ff804-b93d-3622-bd97-284f5e186795",
                                        "glosses": [
                                            "periodo più recente dell'età della pietra del terzo e ultimo periodo dell'età della pietra, (che corrisponde dall'8000 a.C. al 3500 a.C. circa) in cui riuscì ad arrotondarla per foggiare armi e altro, ad innalzare capanne e palafitte, a coltivare i campi e ad rendere domestici alcuni animali"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48ac447a-6189-4e10-9306-11b7d96bc4fc",
                                                "sense_id": "8762ff41-53ed-3de1-a563-4999c687fb53",
                                                "text": "con il neolitico, l’ultima fase della preistoria, si registra una maggiore stanzialità delle popolazioni umane rispetto al paleolitico perché si passa dalla caccia all'agricoltura"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c1a27dad-f3f7-4cd8-8f75-857df3582462",
                        "source_entry_id": "466d80a2-9eee-303b-ae86-4e2853dd2121",
                        "source_sense_id": "419e8348-8c42-353c-9634-74dad027b094",
                        "target_lang_word": "Jungsteinzeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jungsteinzeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e1ca327f-e2ca-3b35-9b79-545309a84b22",
                                        "entry_id": "e1bc56c9-2f9a-37a3-a0cd-241f61797984",
                                        "glosses": [
                                            "Epoche der Menschheitsgeschichte, die als letzter Abschnitt der Steinzeit angesehen wird und durch die Entwicklung von frühen Siedlungen, Landwirtschaft, Domestikation von Wildtieren und Religion gekennzeichnet ist."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "adfbf65b-c5a0-4b1e-8f6b-50f247325a3c",
                                                "sense_id": "e1ca327f-e2ca-3b35-9b79-545309a84b22",
                                                "text": "„Doch dann, mit Beginn der Jungsteinzeit vor 10.000 Jahren, explodierte die Menschenzahl – um das 1000-Fache in nur 500 Generationen.“"
                                            },
                                            {
                                                "example_id": "2dda3c56-fb5e-40cc-9f59-9d3cb0136da1",
                                                "sense_id": "e1ca327f-e2ca-3b35-9b79-545309a84b22",
                                                "text": "„Bereits in der Jungsteinzeit entdeckte man die hervorragende Eignung des hiesigen Basalts für das Mahlen von Getreide.“"
                                            },
                                            {
                                                "example_id": "1040a4d2-c36d-4518-9400-e338290301fa",
                                                "sense_id": "e1ca327f-e2ca-3b35-9b79-545309a84b22",
                                                "text": "„Die ersten Exemplare entstanden in der Jungsteinzeit, dabei handelt es sich um mächtige Erd- oder Steinpackungen über Großsteingräbern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "48596c31-0694-41d2-be2e-81ef72619cad",
                        "source_entry_id": "466d80a2-9eee-303b-ae86-4e2853dd2121",
                        "source_sense_id": "419e8348-8c42-353c-9634-74dad027b094",
                        "target_lang_word": "Neolithikum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Neolithikum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "549583c9-bf45-393b-bf59-682d02db3941",
                                        "entry_id": "38f42f14-ab0e-39dd-b0c8-23b999d6891a",
                                        "glosses": [
                                            "Epoche zwischen Mittelsteinzeit und Kupferzeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8c23f24-2b83-4b0c-834a-bcb5fde0f088",
                                                "sense_id": "549583c9-bf45-393b-bf59-682d02db3941",
                                                "text": "„Erste, grob-tonige, einfarbige und bei niederen Temperaturen (<650 °C) gebrannte Töpferwaren tauchen zu Beginn des Neolithikums auf.“"
                                            },
                                            {
                                                "example_id": "28e75e82-a652-4793-bd98-8f20f2100a96",
                                                "sense_id": "549583c9-bf45-393b-bf59-682d02db3941",
                                                "text": "„Man versucht, diese Sprachen mit den dort während des Neolithikums und der frühen Bronzezeit lebenden Völkern zu identifizieren, die man nach ihrer charakteristischen Bestattungsweise in Grabhügeln (Kurgan) als Kurgankultur bezeichnet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
