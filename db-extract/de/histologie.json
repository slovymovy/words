                    {
                        "translation_id": "1546b1c3-f0b7-4c15-bd22-24ce6ff97728",
                        "source_entry_id": "dd0d2e94-809a-3a00-bb70-785bb492687c",
                        "source_sense_id": "61eacbcf-2e1e-33fa-9e2d-1d4d968f399e",
