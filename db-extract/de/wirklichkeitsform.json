                                        "sense_id": "81bcea32-7cab-3f0b-b279-68c11c677137",
                                        "entry_id": "088897b3-2e3c-300f-ad6c-c5d27f189cfa",
                                        "glosses": [
                                            "Courte séquence sonore qui permet l’identification d’une émission régulière."
                                        ],
                                        "tags": [
