        "fr-extract.jsonl": [
            {
                "entry_id": "95a1e26a-08f1-313d-a820-1a1269dd6c31",
                "word": "Euphrate",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c09a392a-02c8-3694-86b0-5afa628b3889",
                        "entry_id": "95a1e26a-08f1-313d-a820-1a1269dd6c31",
                        "glosses": [
                            "Fleuve de Turquie, de Syrie et d’Iraq."
                        ],
                        "tags": [
                            "Cours d’eau"
                        ],
                        "examples": [
                            {
                                "example_id": "6ca87b7a-ee88-462a-b2ca-c1961a339915",
                                "sense_id": "c09a392a-02c8-3694-86b0-5afa628b3889",
                                "text": "Malgré le grand nombre de descriptions et de voyages publiés sur les contrées qui s’étendent depuis l’Euphrate jusqu'à l’Indus, il faut avouer qu’on ne sait absolument rien de positif sur leur population."
                            },
                            {
                                "example_id": "1beae1c4-8452-4e97-aefa-2afa299d80d4",
                                "sense_id": "c09a392a-02c8-3694-86b0-5afa628b3889",
                                "text": "C'est ainsi que, dans l'Antiquité, les riches vallées du Nil et de l’Euphrate (Mésopotamie) furent toujours convoitées par des hordes conquérantes."
                            },
                            {
                                "example_id": "0fc5a765-fb7c-44d7-b662-215aad3aacf2",
                                "sense_id": "c09a392a-02c8-3694-86b0-5afa628b3889",
                                "text": "Le Louvre conserve une tablette votive sumérienne, venant de l’embouchure de l’Euphrate et datant de 2850 avant J.C., faite d’un mélange artificiel de bitume et d’argile."
                            }
                        ]
                    },
