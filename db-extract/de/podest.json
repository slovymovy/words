                    },
                    {
                        "form_id": "125b830f-5b5a-4769-824d-36e352821963",
                        "entry_id": "8d5bdffa-c032-3edb-8c4c-5369c1f00898",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Podeste"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a72966cb-5efa-37b5-ba0f-b678d9c6b613",
                        "entry_id": "8d5bdffa-c032-3edb-8c4c-5369c1f00898",
                        "glosses": [
                            "Erhöhung, die für jedermann (beispielsweise im Saal oder im Stadion) gut sichtbar ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ad50856-a154-4a0a-8931-46742cc96acc",
                                "sense_id": "a72966cb-5efa-37b5-ba0f-b678d9c6b613",
                                "text": "Die Gewinner strahlten über das ganze Gesicht, als Ihnen auf dem Podest die Medaillen um den Hals gehängt wurden."
                            },
                            {
                                "example_id": "31a18d79-b142-461b-8b3a-b8f02975ac13",
                                "sense_id": "a72966cb-5efa-37b5-ba0f-b678d9c6b613",
                                "text": "Der Autor las aus seinem Buch und jedermann im Saal konnte ihn auf seinem Podest sitzend gut sehen."
                            },
                            {
                                "example_id": "269eb2ca-6b6a-42b5-83b2-4e3302613e66",
                                "sense_id": "a72966cb-5efa-37b5-ba0f-b678d9c6b613",
                                "text": "Der Dirigent sprang mit Energie auf sein Podest, hob kurz die Arme und es wurde still im Saal."
                            },
                            {
                                "example_id": "8c5dc3e5-03a6-4d41-8eac-2fe5e1b01801",
                                "sense_id": "a72966cb-5efa-37b5-ba0f-b678d9c6b613",
                                "text": "Während Bundestrainer Joachim Löw auf dem Podest der Pressekonferenz von Recife zu den Journalisten spricht, will Müller, der als Spieler des Spiels ebenfalls zur Pressekonferenz geladen ist, schon mal Platz nehmen neben seinem Coach. Doch der FIFA-Pressemann schickt ihn wieder weg - er möge bitte am Rand bleiben, bis er an der Reihe ist."
                            },
                            {
                                "example_id": "da449162-56e5-474a-8341-b890625d12cf",
                                "sense_id": "a72966cb-5efa-37b5-ba0f-b678d9c6b613",
                                "text": "Vorne, an der abgehängten Fensterfront, steht Auktionator Peter Graf zu Eltz im grauen Anzug auf einem Podest. Neben ihm zwei junge Frauen, die per Telefon mit Bietern aus aller Welt sprechen. Vor dem Podest stehen junge Frauen und Männer in gestärkten weißen Hemden und Schürzen. Mit weiß behandschuhten Händen präsentieren sie die zu versteigernden Gegenstände."
                            },
                            {
                                "example_id": "a9616120-2d1f-45a2-a208-5006b1d135c7",
                                "sense_id": "a72966cb-5efa-37b5-ba0f-b678d9c6b613",
                                "text": "„An der Wand stand auf einem weißen Podest eine mannshohe Vitrine aus dickem Sicherheitsglas, dahinter ein einfacher Holzstuhl.“"
                            },
                            {
                                "example_id": "40cd8426-33fc-4a5b-b69f-a0ad6c4ce0de",
                                "sense_id": "a72966cb-5efa-37b5-ba0f-b678d9c6b613",
                                "text": "„Man schlief auf hölzernen Podesten mit Strohmatratzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e0ad6809-19e6-37f8-99b4-fafb58845dd3",
                        "entry_id": "8d5bdffa-c032-3edb-8c4c-5369c1f00898",
                        "glosses": [
                            "Ergebnis eines Teilnehmers in einem Wettkampfes mit einer Platzierung unter den ersten Dreien"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "65ab62bf-9c70-40d7-bfa8-7d1eed97a9e4",
                                "sense_id": "e0ad6809-19e6-37f8-99b4-fafb58845dd3",
                                "text": "Alle deutschen Skifahrer verpassten in Ihrem Rennen das Podest."
                            },
                            {
                                "example_id": "e502bdf8-bada-4289-9ee8-8f9d5ffdbb8d",
                                "sense_id": "e0ad6809-19e6-37f8-99b4-fafb58845dd3",
                                "text": "Sie hat es bei der letzten Olympiade aufs Podest geschafft."
                            },
                            {
                                "example_id": "a1ac450e-ab9c-4f74-b0f6-0ab094810c38",
                                "sense_id": "e0ad6809-19e6-37f8-99b4-fafb58845dd3",
                                "text": "Bei seinem Weltcupdebüt vor zwei Jahren wurde er [der Skispringer Andreas Wellinger ] auf Anhieb Fünfter. Seither schaffte er es sechsmal auf das Podest, davon einmal ganz nach oben."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
