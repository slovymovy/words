    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "35e53430-d56f-31e3-9c2e-17b3c764ea5e",
                    "sense_definition": "Exempter une personne d'une obligation, d'une charge ou d'une règle.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "exempter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin lui a rédigé un certificat médical pour le <w>dispenser</w> d'éducation physique."
                        },
                        {
                            "text": "Ce résultat brillant le <w>dispense</w> de passer l'épreuve orale finale."
                        }
                    ],
                    "synonyms": [
                        "exempter",
                        "exonérer",
                        "décharger"
                    ],
                    "antonyms": [
                        "contraindre",
                        "imposer",
                        "obliger"
                    ],
                    "common_phrases": [
                        "être dispensé de",
                        "dispenser de cours",
                        "dispenser d'épreuve"
                    ]
                },
                {
                    "sense_id": "5e7a61c3-4595-317e-bb4d-2681e33886b1",
                    "sense_definition": "Distribuer ou donner largement des soins, un enseignement ou des bienfaits.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "distribuer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette université réputée <w>dispense</w> un enseignement de grande qualité aux étudiants internationaux."
                        },
                        {
                            "text": "L'infirmière <w>dispense</w> des soins quotidiens aux personnes âgées de la résidence."
                        }
                    ],
                    "synonyms": [
                        "donner",
                        "distribuer",
                        "prodiguer",
                        "fournir"
                    ],
                    "antonyms": [
                        "priver",
                        "retenir"
                    ],
                    "common_phrases": [
                        "dispenser un cours",
                        "dispenser des soins",
                        "dispenser une formation"
                    ]
                },
                {
                    "sense_id": "b936bb13-0c18-3b80-8f82-a93a68beaf60",
                    "sense_definition": "S'abstenir de faire quelque chose, s'éviter une corvée ou un devoir.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "s_abstenir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vous auriez pu vous <w>dispenser</w> de faire cette remarque désobligeante devant tout le monde."
                        },
                        {
                            "text": "Il a préféré se <w>dispenser</w> de cette réunion interminable et continuer son travail."
                        }
                    ],
                    "synonyms": [
                        "s'abstenir",
                        "s'exempter",
                        "s'éviter"
                    ],
                    "antonyms": [
                        "s'astreindre",
                        "s'obliger"
                    ],
                    "common_phrases": [
                        "se dispenser de venir",
                        "se dispenser de commentaire"
                    ]
                }
            ]
        }
    ]
