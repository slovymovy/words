                "senses": [
                    {
                        "sense_id": "3270bc8c-6a12-31fe-95cf-2d992eb81c61",
                        "entry_id": "60344549-924c-30af-9a6b-0cc024fce14d",
                        "glosses": [
                            "Se poursuivre soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2138375a-b5be-47d6-a3f0-c37ed63e6709",
                                "sense_id": "3270bc8c-6a12-31fe-95cf-2d992eb81c61",
                                "text": "Tu me diras, gagner la Guerre, emporter le Pouvoir, et s'autopoursuivre devant les Juges, c'est un peu con."
                            },
                            {
                                "example_id": "3244ae93-ed2e-4c60-b178-12e7dde7072f",
                                "sense_id": "3270bc8c-6a12-31fe-95cf-2d992eb81c61",
                                "text": "M. le procureur de la république de Bobigny va-t-il s'autopoursuivre ou poursuivre ses substituts ?"
                            },
                            {
                                "example_id": "1621329f-7dce-4dac-91ea-cd28e3f35137",
                                "sense_id": "3270bc8c-6a12-31fe-95cf-2d992eb81c61",
                                "text": "Qu'il commence donc par s'autopoursuivre....car des \"conneries\" , il en sort à chaque fois qu'il s'exprime !"
                            }
                        ]
                    }
