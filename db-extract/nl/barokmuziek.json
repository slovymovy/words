                        "examples": [
                            {
                                "example_id": "5399573d-9903-4b91-a0c9-b9a054ffe45d",
                                "sense_id": "31c602af-1e98-3ebe-8ad4-efa238f11754",
                                "text": "Marriner begon zijn carrière als violist. Later kwam daar nog het dirigeren bij en vaak combineerde hij de twee op het podium. Hij dirigeerde vooral barokmuziek, maar verbreedde zich in de loop der jaren."
                            },
                            {
                                "example_id": "eda190ff-52d9-47b9-8043-72dd85b9a0c3",
                                "sense_id": "31c602af-1e98-3ebe-8ad4-efa238f11754",
                                "text": "Cecilia Bartoli, vooral bekend om haar uitvoeringen van barokmuziek, zocht in het verleden en stuitte op componist Agostino Steffani (1654-1728), een muzikale ontdekkking en een tijdgenoot van Vivaldi. Steffani leidde een spannend en spectaculair leven. Hij was gezant van de paus, betrokken bij vele diplomatieke en duistere zaken en ondertussen componist van muziek die het werk van Vivaldi naar de kroon steekt."
                            }
                        ]
