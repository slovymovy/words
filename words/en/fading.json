                                "target_lang_sense_clarification": "diminution de force ou d'enthousiasme"
                            },
                            {
                                "target_lang_word": "déclin",
                                "target_lang_sense_clarification": "perte progressive d'intensité"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "desvanecimiento",
                                "target_lang_sense_clarification": "pérdida progresiva de intensidad, sonido o recuerdos"
                            },
                            {
                                "target_lang_word": "decoloración",
                                "target_lang_sense_clarification": "pérdida de color debida a la luz o al tiempo"
                            },
                            {
                                "target_lang_word": "apagamiento",
                                "target_lang_sense_clarification": "pérdida de brillo, luz o entusiasmo"
                            },
                            {
                                "target_lang_word": "declive",
                                "target_lang_sense_clarification": "disminución gradual de fuerza o vigor"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "褪色",
                                "target_lang_sense_clarification": "颜色逐渐变浅或脱落"
                            },
                            {
                                "target_lang_word": "消退",
                                "target_lang_sense_clarification": "热情、声音或力量逐渐减弱"
                            },
                            {
                                "target_lang_word": "衰退",
                                "target_lang_sense_clarification": "力量或状态下降"
                            }
                        ]
                    }
