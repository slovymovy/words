                "senses": [
                    {
                        "sense_id": "1c6d08c9-5a4f-31af-b84c-2c5d3a91b8fe",
                        "entry_id": "13786318-c9f0-38be-803a-fd5be799860e",
                        "glosses": [
                            "female equivalent of интрига́н (intrigán): female schemer"
                        ],
                        "tags": [
                            "feminine",
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "44ca6eed-3a72-4cf0-8246-a231b89dc1fd",
                                "sense_id": "1c6d08c9-5a4f-31af-b84c-2c5d3a91b8fe",
                                "text": "Одни́ реши́ли, что она́ мно́го о себе́ ду́мает; други́е, что она́ ехи́дная-преехи́дная: всё молчи́т да выслу́шивает; тре́тьи да́же счита́ли её на э́том же основа́нии интрига́нкой, а четвёртые, наконе́ц, не соглаша́ясь ни с одни́м из трёх вышеприведённых мне́ний, утвержда́ли, что она́ про́сто ду́ра и коке́тка.",
                                "translation": "Nikolai Leskov",
                                "english": "Nikolai Leskov"
                            }
                        ]
                    }
                ],
