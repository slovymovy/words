                        "glosses": [
                            "Of or pertaining to decisions."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "84438bc7-5533-4592-97cb-57cbf49d09fe",
                                "sense_id": "cff3431f-ddbb-35df-9a61-fce13c9193f3",
                                "text": "Subjects characterized as having achieved decisional equilibrium were well distributed throughout the range of decisional situations, although none of these individuals participated in more than nine different decisions."
                            }
                        ]
                    },
                    {
                        "sense_id": "16c18d12-f450-3d9b-8490-b340695bfe6e",
                        "entry_id": "89703eda-105a-3e40-8908-8f0f8fd4a4f0",
                        "glosses": [
                            "Having the power or authority to make decisions."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "16879b9f-1a7a-4362-aefb-f7cf9f8d71e6",
                                "sense_id": "16c18d12-f450-3d9b-8490-b340695bfe6e",
                                "text": "The procedures should also make plain that a decisional official, whether or not challenged, may voluntarily abstain from participating in a particular proceeding."
                            }
                        ]
                    }
                ],
