                "forms": [
                    {
                        "form_id": "f847eead-e982-4719-9209-1a36ee12b3c4",
                        "entry_id": "20c3ffe0-dc4e-3d18-9f7d-6e27bf0c95dc",
                        "tags": [
                            "plural"
                        ],
                        "form": "métathèses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6126c800-1f76-352c-b120-b0dd767cf0d6",
                        "entry_id": "20c3ffe0-dc4e-3d18-9f7d-6e27bf0c95dc",
                        "glosses": [
                            "Métaplasme qui consiste dans l’inversion de deux lettres ou phonèmes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58c33fe2-bf72-454e-a4f7-d902b057ab0b",
                                "sense_id": "6126c800-1f76-352c-b120-b0dd767cf0d6",
                                "text": "La métathèse désigne l’échange de deux lettres, ainsi le nom ancien Bleinliuet donne Brélivet et sa variante Berlivet ; Melénec admet pour variante Ménélec."
                            },
                            {
                                "example_id": "c0ee5ef7-66b3-4dff-84c5-f86f32fbe8c7",
                                "sense_id": "6126c800-1f76-352c-b120-b0dd767cf0d6",
                                "text": "Les rhéteurs parlent aussi de la métathèse et de l’antithèse. Dans le cas de la métathèse, on transpose des lettres dans le même mot."
                            }
                        ]
                    },
                    {
                        "sense_id": "28da5701-9139-375b-b344-fd32c5ddbcbf",
                        "entry_id": "20c3ffe0-dc4e-3d18-9f7d-6e27bf0c95dc",
                        "glosses": [
                            "Échange d’une ou de plusieurs liaisons ou groupes d’atomes entre espèces chimiques structuralement apparentées, conduisant sur le plan formel à des composés dans lesquels les liaisons des différents types sont en même nombre et de même nature, ou presque, que dans les réactifs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3eb189f6-18b8-4bba-ac13-bda0e0b3b70e",
                                "sense_id": "28da5701-9139-375b-b344-fd32c5ddbcbf",
                                "text": "Une métathèse est une réaction qui permet d’échanger des atomes ou groupes d’atomes de deux molécules de structures similaires en respectant les liaisons impliquées."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ee7989c7-14e4-49ce-a62a-10f837824ff7",
                        "source_entry_id": "20c3ffe0-dc4e-3d18-9f7d-6e27bf0c95dc",
                        "source_sense_id": "6126c800-1f76-352c-b120-b0dd767cf0d6",
