                "senses": [
                    {
                        "sense_id": "8d547c59-9e28-3180-ac2f-2887d675bee8",
                        "entry_id": "094c1651-dafa-3f2e-812c-b9d4a5f9d057",
                        "glosses": [
                            "Antrag auf gerichtliche Entscheidung durch eine Organisation im Namen vieler Betroffener"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eebaeb47-11a5-4562-a87b-19bd7a99f224",
                                "sense_id": "8d547c59-9e28-3180-ac2f-2887d675bee8",
                                "text": "„Die Musterfeststellungsklage, die Heiko Maas vorschlägt, ist den großen Verbraucherverbänden und Handelskammern vorbehalten.“"
                            },
                            {
                                "example_id": "cc81d3fc-297c-47cf-8b0f-2a317732f0d5",
                                "sense_id": "8d547c59-9e28-3180-ac2f-2887d675bee8",
                                "text": "„Das Bundesjustizministerium hat eine Musterfeststellungsklage auf den Weg gebracht – ohne Erfolgshonorare, aber mit Verbraucherinteressen im Zentrum.“"
                            },
                            {
                                "example_id": "3947ad72-e95c-4a59-8f09-64aeceab812f",
                                "sense_id": "8d547c59-9e28-3180-ac2f-2887d675bee8",
                                "text": "„Medienberichten zufolge hatte sich vor allem Bundesverkehrsminister Alexander Dobrindt (CSU) gegen die Einführung der Musterfeststellungsklage stark gemacht.“"
                            },
                            {
                                "example_id": "d3ce6586-82c1-45e9-8502-5723b38f6b67",
                                "sense_id": "8d547c59-9e28-3180-ac2f-2887d675bee8",
                                "text": "„Erforderlich sei, eine sogenannte Musterfeststellungsklage mit allgemeiner verjährungsunterbrechender Wirkung einzuführen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
