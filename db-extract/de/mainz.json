                    {
                        "translation_id": "333fa576-4aca-4fd9-b86d-344708192649",
                        "source_entry_id": "e0bfc6a5-e4cd-3344-9637-f781b99f3684",
                        "source_sense_id": "624bb411-0d90-3330-bf8e-3ba801ab7d65",
                        "source_sense_description": "Stadt in Deutschland, Hauptstadt von Rheinland-Pfalz",
                        "target_lang_word": "Mayence",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mayence",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e1394766-546d-3197-97d0-c2a14f4dd34c",
                                        "entry_id": "0fdc8dbb-e2e9-3c3e-859f-41be5d8d65c5",
                                        "glosses": [
                                            "Nom de famille."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Mayence",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "75f186cf-849d-3ea4-b70b-55908a7a04df",
                                        "entry_id": "d3607c61-9d56-38bb-bab5-a0d535a67645",
                                        "glosses": [
                                            "Ville, commune et arrondissement d’Allemagne, capitale de la Rhénanie-Palatinat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c126d769-1875-48d3-8771-2703b0a1922e",
                                                "sense_id": "75f186cf-849d-3ea4-b70b-55908a7a04df",
                                                "text": "Aussitôt après mon arrivée à Mayence, j'allai rendre visite à M. de Stein l'aîné, chambellan et grand maître des eaux et forêts du roi de Prusse."
                                            },
                                            {
                                                "example_id": "8f5b49c6-1aad-4e4d-8871-cc69e05d6fe5",
                                                "sense_id": "75f186cf-849d-3ea4-b70b-55908a7a04df",
                                                "text": "Le Mein se jette dans le Rhin presque en face de Mainz, que nous appelons Mayence, par suite de ce système absurde de traduction des noms qu’on devrait bien abandonner. — Cependant jambon de Mainz ferait un singulier effet ! — C’est toujours un beau spectacle que la rencontre de deux grands cours d’eau dont l’un absorbe l’autre et l’entraîne à la mer en lui ôtant son nom : — ainsi l’homme débaptise la femme qu’il épouse."
                                            },
                                            {
                                                "example_id": "7b887081-e38f-463f-899e-3465f232795e",
                                                "sense_id": "75f186cf-849d-3ea4-b70b-55908a7a04df",
                                                "text": "On savait malheureusement trop peu l’excellent poème de son évasion de Mayence, le lendemain même du jour où il y fut amené avec deux ou trois mille de ses compagnons de Metz."
                                            },
                                            {
                                                "example_id": "2d3d7653-8f99-4c3b-ae67-66fc155ac0a0",
                                                "sense_id": "75f186cf-849d-3ea4-b70b-55908a7a04df",
                                                "text": "À Mayence se trouve une colonie sarmatique intéressante où les sables portent des Stipa et diverses Composées."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
