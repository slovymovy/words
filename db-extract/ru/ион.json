                    {
                        "translation_id": "6f50b588-79b5-4444-8761-534f53ffe880",
                        "source_entry_id": "d13b4ead-8c55-3dd7-99fd-ea5d6f31f16e",
                        "source_sense_id": "d4ec5767-3706-313d-b85c-468074f06bb7",
