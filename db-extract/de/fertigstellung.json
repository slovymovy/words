                ],
                "senses": [
                    {
                        "sense_id": "93fb8c47-ae99-3637-8ceb-89a1a86dd2dd",
                        "entry_id": "ae718041-e9e7-3cb5-ac02-b10e4667198a",
                        "glosses": [
                            "Vorgang, bei dem etwas (zum Beispiel eine Arbeit oder Aufgabe) zu Ende gebracht wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73d49f08-c252-44d6-acce-926fce88fa99",
                                "sense_id": "93fb8c47-ae99-3637-8ceb-89a1a86dd2dd",
                                "text": "Bei der Fertigstellung des Filmes wurden keine Fehler entdeckt."
                            },
                            {
                                "example_id": "1ab3e563-6a23-41ee-bb4e-9c0ba0acdf71",
                                "sense_id": "93fb8c47-ae99-3637-8ceb-89a1a86dd2dd",
                                "text": "Bis zu seiner Fertigstellung bekam allein der Maler das Bild zu Gesicht."
                            },
                            {
                                "example_id": "e5606861-6958-4627-9fc4-f0b8e47d6b09",
                                "sense_id": "93fb8c47-ae99-3637-8ceb-89a1a86dd2dd",
                                "text": "„Erst 1880 konnte die Fertigstellung des Doms gefeiert werden.“"
                            },
                            {
                                "example_id": "2b7cabc9-cc12-4893-aedf-3e9098204f9c",
                                "sense_id": "93fb8c47-ae99-3637-8ceb-89a1a86dd2dd",
                                "text": "„Tom erarbeitete erstmals Ergebnisse, die der Fehlerreduktion dienten und die auch bei der Fertigstellung der nächsten Vier-Bit-Module berücksichtigt werden konnten.“"
                            },
                            {
                                "example_id": "da018f23-501f-45df-b721-bc924dc181de",
                                "sense_id": "93fb8c47-ae99-3637-8ceb-89a1a86dd2dd",
                                "text": "„Der Albert sieht keinen Sinn mehr in der Fertigstellung des Hauses.“"
                            },
                            {
                                "example_id": "2681e84b-ec04-47e5-a66c-76438b823e26",
                                "sense_id": "93fb8c47-ae99-3637-8ceb-89a1a86dd2dd",
                                "text": "„Er selbst ringt um die Fertigstellung der neuen Romane.“"
                            },
                            {
                                "example_id": "f5407868-a9e3-4229-9693-d77eea3f862a",
                                "sense_id": "93fb8c47-ae99-3637-8ceb-89a1a86dd2dd",
                                "text": "„Legendär die milliardenteure Dauerbaustelle des neuen Grossflughafens, der sich schon bei der um ein Jahrzehnt verspäteten Fertigstellung als zu klein erweist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
