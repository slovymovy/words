                                        "sense_id": "f20852db-fb51-30c6-8676-146a8cbc54db",
                                        "entry_id": "020d8cd3-aed5-309e-a234-8708c71d799d",
                                        "glosses": [
                                            "A plant, grown for it, or its fruits or seeds, to be harvested as food, livestock fodder, or fuel or for any other economic purpose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ed1f7de-d76c-450e-8470-fac90b9e6fe4",
                                                "sense_id": "f20852db-fb51-30c6-8676-146a8cbc54db",
                                                "text": "The farmer had to decide which crop to grow as his main bet for the coming year. Would it be barley, oats, or something else?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4952072b-e93a-3477-9702-a8908892d210",
                                        "entry_id": "020d8cd3-aed5-309e-a234-8708c71d799d",
                                        "glosses": [
                                            "The production amount of such an output for a specific season or year, particularly of plants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b554020d-795d-4325-8ea4-2e4e3ee24a40",
                                                "sense_id": "4952072b-e93a-3477-9702-a8908892d210",
                                                "text": "It was a good crop of oats this year. What a nice change after last year's crop!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bbd3a994-79d2-3def-af2d-ae078b79b53c",
                                        "entry_id": "020d8cd3-aed5-309e-a234-8708c71d799d",
                                        "glosses": [
                                            "A group, cluster, or collection of things occurring at the same time."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92770923-579e-4f95-bb45-aa7eaab61718",
                                                "sense_id": "bbd3a994-79d2-3def-af2d-ae078b79b53c",
                                                "text": "The decade produced a whole crop of ideas about space travel."
                                            },
                                            {
                                                "example_id": "6a14edd9-0cec-4474-95c5-102d7eb24d78",
                                                "sense_id": "bbd3a994-79d2-3def-af2d-ae078b79b53c",
                                                "text": "The university had an exceptional crop of graduates in 1892, including three who went on to win Nobel Prizes."
                                            },
                                            {
                                                "example_id": "8260b488-a7f6-4562-8bea-3fec05949aba",
                                                "sense_id": "bbd3a994-79d2-3def-af2d-ae078b79b53c",
                                                "text": "And even if Anna Wintour wanted to invite a fresh crop of internet talent, who would she choose? Can you name anyone in the past year who has ascended in a major way?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c8b5611-c8a1-35f9-b7f6-f13b6b8fe99c",
                                        "entry_id": "020d8cd3-aed5-309e-a234-8708c71d799d",
                                        "glosses": [
                                            "A group of vesicles at the same stage of development in a disease."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8aceea72-6c8b-42a3-a301-65f6332ef9a3",
                                                "sense_id": "0c8b5611-c8a1-35f9-b7f6-f13b6b8fe99c",
                                                "text": "The patient had a crop of bumps indicative of chicken pox."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06eaf5e8-a719-3eab-8e6a-ff05529394c1",
                                        "entry_id": "020d8cd3-aed5-309e-a234-8708c71d799d",
