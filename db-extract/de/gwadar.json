                "senses": [
                    {
                        "sense_id": "0045fd86-913d-3859-87be-8821d2c1812e",
                        "entry_id": "93c4bbe7-5b95-3150-9043-29be1b463bb2",
                        "glosses": [
                            "Hafenstadt in der pakistanischen Provinz Belutschistan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ab2414b-cbc6-4203-8025-734a41a128e6",
                                "sense_id": "0045fd86-913d-3859-87be-8821d2c1812e",
                                "text": "Gwadar war bis 1958 eine Exklave des Oman."
                            },
                            {
                                "example_id": "4e9faf26-7c0f-46bb-9222-eb0b1549218c",
                                "sense_id": "0045fd86-913d-3859-87be-8821d2c1812e",
                                "text": "„Viel traumatischer für die lokale Bevölkerung war jedoch, dass das Land in und um Gwadar enteignet wurde und mit Hilfe von Fälschungen in den Kataster- und Landregistern in die Hände von Spekulanten, Politikern und Industriellen - vornehmlich aus dem Punjab - gelangte, die es für riesige Summen an Investoren verkauften.“"
                            },
                            {
                                "example_id": "a6c13a6f-bc02-4321-978f-66bbbabd8b51",
                                "sense_id": "0045fd86-913d-3859-87be-8821d2c1812e",
                                "text": "„Die amerikanische Alternative lautete, eine Pipeline durch West- und Südafghanistan zum pakistanischen Hafen Gwadar zu bauen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
