                        "glosses": [
                            "Histoire des géants ; traité sur les géants."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5e19f63-e5de-4155-8a65-871ffc0f031d",
                                "sense_id": "3faa4272-a207-32b5-bff4-50edb3e643da",
                                "text": "L’auteur de cette gigantologie espagnole attribue ces dents énormes et ces grands os [fossiles] à des géants de l’espèce humaine ; mais est-il croyable qu’il y ait jamais eu des hommes dont la tête ait eu huit à dix pieds de circonférence ?"
                            },
                            {
                                "example_id": "8da75b8c-0029-4357-8cd7-5ac6091440d9",
                                "sense_id": "3faa4272-a207-32b5-bff4-50edb3e643da",
                                "text": "Riolan publia un écrit sous le nom de gigantologie, où il prétend non-seulement que les os en question ne sont pas des os humains, mais encore que les hommes en général n’ont jamais été plus grands qu’ils ne le sont aujourd'hui."
                            }
                        ]
                    }
