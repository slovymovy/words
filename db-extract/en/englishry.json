                        ],
                        "examples": [
                            {
                                "example_id": "1869cf7f-fb2c-443d-8d76-29910ea7966f",
                                "sense_id": "3581da9a-938d-3057-85fa-896c6abd34c4",
                                "text": "Blue-eyed women he believed there were in Kashmir, but here was the mythical Englishry of fair hair as well."
                            },
                            {
                                "example_id": "89734c6c-506b-478b-b4c1-58e4baf3adb4",
                                "sense_id": "3581da9a-938d-3057-85fa-896c6abd34c4",
                                "text": "It is these people who, taking with them so much furniture and Englishry of all kinds have set up everywhere communities with names like ‘Little England’, ‘Newest England’, ‘England Again’ which are more English than England ever was."
                            },
                            {
                                "example_id": "56feae4b-8dcd-4e24-9de2-ed61d7dcc29f",
                                "sense_id": "3581da9a-938d-3057-85fa-896c6abd34c4",
                                "text": "Yes, [Philip] Larkin was an icon of Englishry, and a fine specimen of its complexes and neuroses: not only arrogant and xenophobic hut also inward-looking, frightened, and depressive."
                            }
                        ]
                    },
                    {
                        "sense_id": "1ad7bc71-4345-3a4f-a8de-d9a8535493c6",
