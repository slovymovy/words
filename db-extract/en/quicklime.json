                        "entry_id": "c34a9ba2-0b6e-3212-8807-5188beda76d3",
                        "glosses": [
                            "Calcium oxide, which is produced by heating (calcining) limestone and gives slaked lime on treatment with water."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "292dacc3-d29c-4745-b882-984c1d19d0c9",
                                "sense_id": "0ac9d223-76c4-3489-ada9-5841bb01d2b1",
                                "text": "The Warders strutted up and down, / And kept their herd of brutes, / Their uniforms were spick and span, / And they wore their Sunday suits, / But we knew the work they had been at, / By the quicklime on their boots."
                            }
                        ]
                    }
