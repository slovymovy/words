                "senses": [
                    {
                        "sense_id": "2ffc013e-9c7e-3da6-80e7-ef39a6037ff6",
                        "entry_id": "3890bc2d-cc5f-3d0e-a43a-3a0572e5f03b",
                        "glosses": [
                            "schwerer Ball mit derber Hülle aus Leder oder Gummi, der zum Krafttraining benutzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b16d0c02-0752-42a0-8833-8e0795c00097",
                                "sense_id": "2ffc013e-9c7e-3da6-80e7-ef39a6037ff6",
                                "text": "Ein Medizinball springt nicht wieder hoch, wenn man ihn auf den Boden wirft, da er nicht mit Luft gefüllt ist."
                            },
                            {
                                "example_id": "ed907a99-6ac8-42ce-aad9-b0fedaeabaa4",
                                "sense_id": "2ffc013e-9c7e-3da6-80e7-ef39a6037ff6",
                                "text": "„Die Bezeichnung Medizinball kommt aus den USA, wo diese Art Bälle zuerst als Medizin für den Körper Verwendung fanden, da beim Werfen und Fangen nahezu die gesamte Muskulatur gekräftigt wird.“"
                            },
                            {
                                "example_id": "f5241cb9-7c96-47cc-b357-9dcd88afc8f2",
                                "sense_id": "2ffc013e-9c7e-3da6-80e7-ef39a6037ff6",
                                "text": "„Er betrieb Krafttraining, warf schwere Medizinbälle und erfand allerlei Übungen, um seine Finger beweglicher zu machen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
