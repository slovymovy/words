{
    "word_family": [
        "Кондрат",
        "Кондратий"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ed364f9b-446e-3279-9d0f-d7351d49b0ef",
                    "sense_definition": "Апоплексический удар, острое нарушение мозгового кровообращения.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "stroke_death",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Старика хватила <w>кондрашка</w>, и у него отнялась правая рука.",
                            "target_lang_translations": {
                                "en": "The old man had a <w>stroke</w> and lost the use of his right arm."
                            }
                        },
                        {
                            "text": "Раньше апоплексический удар в народе называли просто <w>кондрашкой</w>.",
                            "target_lang_translations": {
                                "en": "In the old days, ordinary people simply called apoplexy a <w>stroke</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "инсульт",
                        "апоплексический удар",
                        "кондратий"
                    ],
                    "common_phrases": [
                        "кондрашка хватил",
                        "кондрашка пришиб"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "просторечное"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Apoplectic stroke, acute violation of cerebral circulation."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stroke",
                                "target_lang_sense_clarification": "medical condition"
                            },
                            {
                                "target_lang_word": "apoplexy",
                                "target_lang_sense_clarification": "dated or colloquial term for a stroke"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "78a5df60-7c9b-39e1-94b0-8f5d7e4c1e2c",
                    "sense_definition": "Внезапная смерть.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "stroke_death",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Сосед был здоров как бык, а потом его вдруг <w>кондрашка</w> хватила — умер прямо в огороде.",
                            "target_lang_translations": {
                                "en": "Our neighbor was as healthy as a horse, and then out of nowhere he was <w>struck down</w> and died right there in his vegetable garden."
                            }
                        },
                        {
                            "text": "Не кричи так, а то тебя <w>кондрашка</w> хватит!",
                            "target_lang_translations": {
                                "en": "Stop shouting like that or you’ll give yourself a <w>heart attack</w>!"
                            }
                        }
                    ],
                    "synonyms": [
                        "косая"
                    ],
                    "common_phrases": [
                        "ждать кондрашку"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "просторечное"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Sudden death."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sudden death",
                                "target_lang_sense_clarification": "unexpected end of life"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "59f1c800-f16c-34d0-bcbc-595f2120c7fc",
                    "sense_definition": "Уменьшительная форма мужского имени <w>Кондрат</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "На печи сидел маленький <w>Кондрашка</w> и внимательно слушал бабушкину сказку.",
                            "target_lang_translations": {
                                "en": "Little <w>Kondrashka</w> sat on the stove and listened attentively to grandmother's fairy tale."
                            }
                        },
                        {
                            "text": "Соседский мальчик <w>Кондрашка</w> часто прибегал к нам играть во двор.",
                            "target_lang_translations": {
                                "en": "The neighbor boy <w>Kondrashka</w> often ran over to our yard to play."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Diminutive form of the male name <w>Kondrat</w>."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Kondrashka",
                                "target_lang_sense_clarification": "given name"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}