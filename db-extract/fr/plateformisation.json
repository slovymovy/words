                "senses": [
                    {
                        "sense_id": "d50f9e78-b42c-32cd-91d4-ccd727979161",
                        "entry_id": "848e9b79-f715-33b1-bf3c-2218f1b7143e",
                        "glosses": [
                            "Domination croissante de l’Internet par un certain nombre de grandes entreprises dont les produits fonctionnent comme des marchés de contenu."
                        ],
                        "tags": [
                            "Internet"
                        ],
                        "examples": [
                            {
                                "example_id": "6d2b945c-c2ab-4c1d-b4ff-e9ff321c55b7",
                                "sense_id": "d50f9e78-b42c-32cd-91d4-ccd727979161",
                                "text": "La révolution digitale bouleverse les business models traditionnels et l'ensemble des organisations. Elle a donné naissance à la plateformisation de l'économie avec comme pionniers des acteurs tels qu' Amazon, Alibaba, Airbnb ou Uber."
                            },
                            {
                                "example_id": "77d82ecc-835f-4f01-a35e-5faea952c43d",
                                "sense_id": "d50f9e78-b42c-32cd-91d4-ccd727979161",
                                "text": "Le modèle de plateformisation délègue en effet toute la partie administrative du travail aux livreurs eux-mêmes, en même temps qu’elle met chaque livreur en concurrence."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1870ef11-6461-4679-ac52-5a172476e86f",
                        "source_entry_id": "848e9b79-f715-33b1-bf3c-2218f1b7143e",
                        "source_sense_id": "d50f9e78-b42c-32cd-91d4-ccd727979161",
                        "target_lang_word": "platformization",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "platformization",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "16a3f952-349a-312d-ac9b-742629259d1a",
                                        "entry_id": "8cb33d10-4040-3cc2-a8cf-7ef77b9bdea6",
                                        "glosses": [
                                            "The increasing domination of the Internet by a number of large companies whose products function as markets for content."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c23412fb-cd66-430c-a39f-8e4911391a14",
                                                "sense_id": "16a3f952-349a-312d-ac9b-742629259d1a",
                                                "text": "For [Anne] Helmond, the platformization of the web is a process whereby social media platforms[…]extend their tentacles into the rest of the web, following users in their browsing activities, using API plugins to permit Facebook commentary on far-flung websites, allowing Facebook the ability to sell users ads about things they were browsing, and generally connecting the web at large back into the closed Facebook platform."
                                            },
                                            {
                                                "example_id": "8df55709-a51d-4d4a-9928-ed99ff0ce145",
                                                "sense_id": "16a3f952-349a-312d-ac9b-742629259d1a",
                                                "text": "For Miguel Ardanuy, a former participation coordinator of Podemos, the ultimate aim of this “platformisation of the party” is to “construct a different model of party, a party more open and responsive to society, where you do not need a membership card in order to participate”."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44cc4a2c-f130-3fd5-aef8-66ab0b41ad05",
                                        "entry_id": "8cb33d10-4040-3cc2-a8cf-7ef77b9bdea6",
                                        "glosses": [
                                            "Conversion into a self-contained platform."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf1f3595-26e8-4ae7-8ba7-8dc11768e67e",
                                                "sense_id": "44cc4a2c-f130-3fd5-aef8-66ab0b41ad05",
                                                "text": "These developments are framed conceptually by the distinctions between platforms and portals and, in turn, the processes of platformization and portalization."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
