{
    "word_family": [
        "downward",
        "downwardly",
        "downwardness"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "fe5c1111-3ffc-3ec8-a7cc-fb86c8e13a9e",
                    "sense_definition": "Towards a lower place or position; towards what is below.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The water flows <w>downwards</w> from the top of the mountain into the valley.",
                            "target_lang_translations": {
                                "ru": "Вода течет <w>вниз</w> с вершины горы в долину."
                            }
                        },
                        {
                            "text": "Please look <w>downwards</w> to see the small flowers growing near your feet.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, посмотрите <w>вниз</w>, чтобы увидеть маленькие цветы, растущие у ваших ног."
                            }
                        }
                    ],
                    "synonyms": [
                        "downward",
                        "down"
                    ],
                    "antonyms": [
                        "upwards",
                        "up"
                    ],
                    "common_phrases": [
                        "look downwards",
                        "facing downwards",
                        "sloping downwards"
                    ],
                    "target_lang_definitions": {
                        "ru": "По направлению к более низкому месту или положению; к тому, что находится внизу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вниз",
                                "target_lang_sense_clarification": "направление движения к нижней точке"
                            },
                            {
                                "target_lang_word": "книзу",
                                "target_lang_sense_clarification": "по направлению вниз"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4f6b971f-7ef7-365c-be2f-d7027138669c",
                    "sense_definition": "Towards a lower level, value, or rank; decreasing in amount or quality.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "trend",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company's profits have been moving <w>downwards</w> for the last three months.",
                            "target_lang_translations": {
                                "ru": "Прибыль компании снижалась <w>вниз</w> на протяжении последних трех месяцев."
                            }
                        },
                        {
                            "text": "Economists are worried that the current trend <w>downwards</w> will lead to a recession.",
                            "target_lang_translations": {
                                "ru": "Экономисты обеспокоены тем, что текущая тенденция <w>вниз</w> приведет к рецессии."
                            }
                        }
                    ],
                    "synonyms": [
                        "downward"
                    ],
                    "antonyms": [
                        "upwards"
                    ],
                    "common_phrases": [
                        "trend downwards",
                        "spiral downwards",
                        "revised downwards"
                    ],
                    "target_lang_definitions": {
                        "ru": "По направлению к более низкому уровню, значению или рангу; уменьшение количества или качества."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вниз",
                                "target_lang_sense_clarification": "в контексте снижения показателей или цен"
                            },
                            {
                                "target_lang_word": "по нисходящей",
                                "target_lang_sense_clarification": "о тенденции к снижению"
                            },
                            {
                                "target_lang_word": "в сторону уменьшения",
                                "target_lang_sense_clarification": "о пересмотре значений или цифр"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}