                        "translation_id": "42c8ace0-f2c5-4570-87f7-336130854845",
                        "source_entry_id": "91d8d77b-7820-3d8e-b867-c182fc4883b6",
                        "source_sense_description": "department",
                        "target_lang_word": "Dordogne",
