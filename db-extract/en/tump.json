                                "example_id": "9cb7ab65-8485-473a-a2cf-8e95c8097ce2",
                                "sense_id": "f3a223d8-410b-312c-aca3-ce5ec17c7ed2",
                                "text": "The island was two rocks grey as twilight between which a tump of iron loam ribbed with flint bore a stand of fir and spruce."
                            },
                            {
                                "example_id": "b4ab35b8-767e-4eb8-96b0-4479d521109e",
                                "sense_id": "f3a223d8-410b-312c-aca3-ce5ec17c7ed2",
                                "text": "[…] winding to the southward, he stopped his little nag short of the crest, and got off and looked ahead of him, from behind a tump of whortles."
                            }
                        ]
                    }
