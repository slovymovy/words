                                                "example_id": "93098eb1-137b-447f-8198-ef981b506ff6",
                                                "sense_id": "281c6f22-a44c-3348-908f-5dfb6fe9a231",
                                                "text": "[A] baker's boy in a white apron and blue jumpers went by carrying a basket of bread on his head; and from the nearby tobacconist's, a spruce young lieutenant dressed in a black uniform emerged lighting a cigarette."
                                            },
                                            {
                                                "example_id": "c572c776-f6b7-43dc-8790-169d35772c25",
                                                "sense_id": "281c6f22-a44c-3348-908f-5dfb6fe9a231",
                                                "text": "He had great neatness of person, and he continued to wear his spruce black coat and his bowler hat, always a little too small for him, in a dapper, jaunty manner."
                                            },
                                            {
                                                "example_id": "fca6824b-135b-4c08-aeeb-9cfb772ff6f1",
                                                "sense_id": "281c6f22-a44c-3348-908f-5dfb6fe9a231",
                                                "text": "A spruce young lieutenant came over, saluted and clambered into the back of our jeep, and we were off."
                                            },
                                            {
                                                "example_id": "0612c916-b12f-4e73-b614-76c9b1230218",
                                                "sense_id": "281c6f22-a44c-3348-908f-5dfb6fe9a231",
                                                "text": "The two clean rooms, where chips are made, are sprucer than a hospital theatre."
                                            }
                                        ]
                                    }
                                ]
                            },
