                ],
                "senses": [
                    {
                        "sense_id": "60a0154e-facd-383d-9525-98763b67f5b8",
                        "entry_id": "c992c5da-df92-3699-86ad-6ac267639dc3",
                        "glosses": [
                            "Vertreter des Jiddischismus, einer Bewegung, die sich für das Jiddische und seine Geltung als Sprache der Juden einsetzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0fa095fe-67fc-4d92-adf2-ddec0b1fdce0",
                                "sense_id": "60a0154e-facd-383d-9525-98763b67f5b8",
                                "text": "„1916 forderten die Jiddischisten auch von den assimilierten Westjuden die (Wieder-)Erlernung des Jiddischen nach vom Deutschen möglichst weit entfernten Normen.“"
                            },
                            {
                                "example_id": "4e1648e5-1595-4d35-9afd-1a8267f93ca2",
                                "sense_id": "60a0154e-facd-383d-9525-98763b67f5b8",
                                "text": "„Die Jiddischisten, diese kleine Zahl von Israelis, die diese alte Sprache noch sprechen, sind selbst alt geworden.“"
                            },
                            {
                                "example_id": "86a5b256-86ce-488a-a82b-2c735d18458b",
                                "sense_id": "60a0154e-facd-383d-9525-98763b67f5b8",
                                "text": "„Die dritte, im Wesentlichen Nordamerika-basierte [Sprecher-]Gruppe ist zwar klein, aber umso rühriger und besteht aus überwiegend sekulär ausgerichteten, sich oft als ‚Jiddischisten‘ verstehenden Personen, die ganz bewusst trotz anderssprachiger Umgebung die jiddische Sprache ihren Kindern weitergeben oder sie selbst als Erwachsene erlernen.“"
                            },
                            {
                                "example_id": "2f296f63-626a-477f-9eb1-087df4113961",
                                "sense_id": "60a0154e-facd-383d-9525-98763b67f5b8",
                                "text": "„Dagegen wiesen die Anhänger des Jiddischen, die Jiddischisten, darauf hin, dass Jiddisch die Muttersprache der weitaus überwiegenden Mehrheit der Juden sei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
