                                        "glosses": [
                                            "incluir, conter ou compreender dentro do escopo de operação"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "12ca19d0-0787-35e0-ba84-2093e8541975",
