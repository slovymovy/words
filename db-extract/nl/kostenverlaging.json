                            {
                                "example_id": "6309bcca-f4dd-4973-a745-b31c3fc58456",
                                "sense_id": "b5bd6f27-b6c8-31f0-be3c-e105eb849fb6",
                                "text": "Je kunt eurocommissaris Neelie Kroes voor de kostenverlaging bedanken. Al jaren strijdt zij voor afschaffing van extra telefoonkosten in het buitenland. Uiteindelijk wil het parlement alle kosten voor roaming in het buitenland afschaffen. Dit gaat nu stap voor stap gebeuren."
                            },
                            {
                                "example_id": "f9316d20-46a0-4568-9599-212803d7dcd1",
                                "sense_id": "b5bd6f27-b6c8-31f0-be3c-e105eb849fb6",
                                "text": "Hoge kosten leiden volgens het onderzoeksrapport tot een lager pensioen. \"Een kostenverlaging van 0,25 procent levert op een termijn van veertig jaar 7,5 procent meer collectief pensioenvermogen op.\" Vermogensbeheerders moeten volgens de AFM veel eerlijker melden welke kosten zij bij de pensioenfondsen in rekening brengen."
                            }
                        ]
