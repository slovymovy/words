                "senses": [
                    {
                        "sense_id": "989cb6f4-8238-32a5-9d09-7b448f93479d",
                        "entry_id": "f4a16644-f574-35cf-ae80-6472162095b6",
                        "glosses": [
                            "Anhängerin des Pazifismus; weibliche Person, die den Krieg und die Gewalt ablehnt und sich für den Frieden einsetzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "036f14df-4782-4256-8799-f4da5f095d18",
                                "sense_id": "989cb6f4-8238-32a5-9d09-7b448f93479d",
                                "text": "Wir sind zwei überzeugte Pazifistinnen!"
                            },
                            {
                                "example_id": "4096c343-321e-4785-82f0-44985b732314",
                                "sense_id": "989cb6f4-8238-32a5-9d09-7b448f93479d",
                                "text": "„Ihr Mann lehnte Eisner und seine Revolution ab, sie selbst näherte sich als Frauenrechtlerin und Pazifistin mehr und mehr dem Sozialismus an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9541de9e-d538-4e37-9048-ffecf7c6546d",
                        "source_entry_id": "f4a16644-f574-35cf-ae80-6472162095b6",
                        "source_sense_id": "989cb6f4-8238-32a5-9d09-7b448f93479d",
                        "target_lang_word": "pacifist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pacifist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a12e45b9-3f9c-3b16-adc4-0e577433b930",
                                        "entry_id": "63d1e80c-1148-3ea8-b0fc-8dfccb8b4eb5",
                                        "glosses": [
                                            "One who loves, supports, or favours peace."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc415330-10e7-4518-b853-f9dd2993aab1",
                                                "sense_id": "a12e45b9-3f9c-3b16-adc4-0e577433b930",
                                                "text": "Mahatma Gandhi was one of the world's most famous pacifists."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb753401-57f2-3923-957f-74aee42fac39",
                                        "entry_id": "63d1e80c-1148-3ea8-b0fc-8dfccb8b4eb5",
                                        "glosses": [
                                            "One who loves, supports, or favours peace.",
                                            "One who prefers to avoid violence in daily life."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bbc02612-4d3c-3539-871d-eb638361c946",
                                        "entry_id": "63d1e80c-1148-3ea8-b0fc-8dfccb8b4eb5",
                                        "glosses": [
                                            "One who loves, supports, or favours peace.",
                                            "One who is anti-war."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "750babf1-4599-4dcf-970e-ae2c005562bc",
                                                "sense_id": "bbc02612-4d3c-3539-871d-eb638361c946",
                                                "text": "No matter what pacifist \"flubdubs and flapdoodle mollycoddles\" might say, the President [Teddy Roosevelt] knew that if there were a general war then America could well be drawn into it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed9ad6e7-77df-3df8-852a-0a5151213698",
                                        "entry_id": "63d1e80c-1148-3ea8-b0fc-8dfccb8b4eb5",
                                        "glosses": [
                                            "One who loves, supports, or favours peace.",
                                            "One who both abstains from inflicting violence on others and opposes others doing so."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "830c5c54-8ca5-3415-b514-ee3a3f00d6a1",
                                        "entry_id": "63d1e80c-1148-3ea8-b0fc-8dfccb8b4eb5",
                                        "glosses": [
                                            "A player who attempts the challenge of winning a game without attacking any enemy characters."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "pacifist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "00014971-4070-3f74-b93f-a508408024ed",
                                        "entry_id": "dab412a3-4d72-3386-afdb-9f8369646d31",
                                        "glosses": [
                                            "Of or relating to pacifism; pacifistic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c5ca40d-00bd-431e-8882-d99132bc56b3",
                                                "sense_id": "00014971-4070-3f74-b93f-a508408024ed",
                                                "text": "Therefore, because Hauerwas is a United Methodist, a church that is clearly not pacifist even if it is not clear what it is, he is not (yet) a pacifist."
