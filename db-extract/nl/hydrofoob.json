                "translations": [
                    {
                        "translation_id": "a73f527d-e21b-4069-a327-d420690c06f1",
                        "source_entry_id": "e55ddddf-c5eb-3872-becd-b1363aad9d54",
                        "source_sense_id": "e74dfaa9-da4b-3f8c-87df-ecf7d185e88d",
                        "source_sense_description": "waterafstotend",
                        "target_lang_word": "wasserabweisend",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wasserabweisend",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a023be4b-5941-367f-9114-04b5461a28d6",
                                        "entry_id": "2fd2e1db-42b0-3565-8b59-dc45f7c0370b",
                                        "glosses": [
                                            "Wasser nicht oder kaum eindringen lassend, Wasser nicht oder kaum aufsaugend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2296df36-8647-40bc-b485-8824001518dd",
                                                "sense_id": "a023be4b-5941-367f-9114-04b5461a28d6",
                                                "text": "Diese Regenjacke ist aus wasserabweisendem Stoff gefertigt."
                                            },
                                            {
                                                "example_id": "89d85389-9a35-4896-aaa2-532994718f98",
                                                "sense_id": "a023be4b-5941-367f-9114-04b5461a28d6",
                                                "text": "Die Oberflächenstruktur dieses Blattes ist wasserabweisend."
                                            },
                                            {
                                                "example_id": "35352a92-4ed2-4015-b81d-ed553bccbd53",
                                                "sense_id": "a023be4b-5941-367f-9114-04b5461a28d6",
                                                "text": "Das Gefieder ist sehr dicht und wird mit dem Sekret der gut entwickelten Bürzeldrüse regelmäßig eingeölt, um es wasserabweisend zu machen."
                                            },
                                            {
                                                "example_id": "d7f449c4-6a8c-487e-84cd-5e219ae56fbe",
                                                "sense_id": "a023be4b-5941-367f-9114-04b5461a28d6",
                                                "text": "Die Jungtiere [der Kegelrobben] sind klein und flauschig und zunächst Nichtschwimmer, da ihr Fell noch nicht wasserabweisend ist."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8ed63441-174d-4aaf-a9f2-a860872f9564",
                        "source_entry_id": "e55ddddf-c5eb-3872-becd-b1363aad9d54",
                        "source_sense_id": "e74dfaa9-da4b-3f8c-87df-ecf7d185e88d",
                        "source_sense_description": "waterafstotend",
                        "target_lang_word": "hydrophobic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hydrophobic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7390f90f-19db-3b68-a260-39fe429f6151",
                                        "entry_id": "0ddbfe8e-fd2a-3179-b448-387324a16113",
                                        "glosses": [
                                            "Of, or having, hydrophobia (rabies)."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "hydrophobic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ab06ac42-574d-3349-9887-88f269181526",
                                        "entry_id": "1400dd91-62c9-336c-a49b-f83695107d67",
                                        "glosses": [
                                            "Lacking an affinity for water; unable to absorb or to be wetted by water."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2c5631e1-cd2a-44bb-ac29-f6bcdf7f1145",
                        "source_entry_id": "e55ddddf-c5eb-3872-becd-b1363aad9d54",
                        "source_sense_id": "e74dfaa9-da4b-3f8c-87df-ecf7d185e88d",
                        "source_sense_description": "waterafstotend",
                        "target_lang_word": "hydrophobe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hydrophobe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "976f72b8-33bf-3653-8008-45229d0942fc",
                                        "entry_id": "a6d72db9-85fa-3487-840e-f59e44363567",
                                        "glosses": [
                                            "Qui est atteint d’hydrophobie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7edd5acb-0ae9-4b1f-85ef-95807ed76590",
                                                "sense_id": "976f72b8-33bf-3653-8008-45229d0942fc",
                                                "text": "Il est hydrophobe, il est incapable de s’approcher de la moindre goutte d’eau."
                                            },
                                            {
                                                "example_id": "c768a609-c0a4-4b5a-9896-dc712be12652",
                                                "sense_id": "976f72b8-33bf-3653-8008-45229d0942fc",
                                                "text": "Tout cela ne nous empêcha pas de faire un excellent dîner, arrosé des meilleurs vins, assaisonné des plus aimables propos, et aussi de diaboliques épices indiennes qui feraient boire un hydrophobe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18da97a0-7631-313c-97fa-71c5c054d1d6",
                                        "entry_id": "a6d72db9-85fa-3487-840e-f59e44363567",
                                        "glosses": [
                                            "Enragé. Qualifiait, jusqu’au début du XXᵉ siècle, un homme ou un animal enragé, l’hydrophobie étant un des symptômes de la rage."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de43af75-740b-4726-956c-0763b3b65ba6",
                                                "sense_id": "18da97a0-7631-313c-97fa-71c5c054d1d6",
                                                "text": "Qui de nous n'a frémi au récit des atroces souffrances morales et physiques endurées par les malheureux mordus par un chien hydrophobe ?"
                                            },
                                            {
                                                "example_id": "7d38ec1b-f76a-40c6-a00c-a45c0c822a6d",
                                                "sense_id": "18da97a0-7631-313c-97fa-71c5c054d1d6",
                                                "text": "Qu'on se figure un loup affamé, furieux, hydrophobe, harcelé pendant tout un jour..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b89cd9e7-dadf-3b92-8581-7d4ab9e7c1ab",
                                        "entry_id": "a6d72db9-85fa-3487-840e-f59e44363567",
                                        "glosses": [
                                            "Se dit d’une substance, ou d’une portion de molécule, qui ne se dissout pas dans l’eau et qui n’a pas d’affinité avec elle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b22c838e-374c-4747-9733-462b00db16f4",
                                                "sense_id": "b89cd9e7-dadf-3b92-8581-7d4ab9e7c1ab",
                                                "text": "Il faut cependant observer que :\n— le caractère hydrophile (solubilité dans l'eau) et le caractère hydrophobe (solubilité dans les solvants organiques) dépendent de la polarisabilité et de l'ionisabilité des molécules, […]."
                                            },
                                            {
                                                "example_id": "9fb7d65d-ae91-4648-9544-e5983c847801",
                                                "sense_id": "b89cd9e7-dadf-3b92-8581-7d4ab9e7c1ab",
                                                "text": "Le savon est obtenu à partir d’un mélange d’acide gras et d’une base forte (hydroxyde de sodium ou de potassium). Les molécules le composant sont amphiphiles et leur structure peut être comparée à celle d’une épingle. La tête de l’épingle est hydrophile alors que la tige est composée d’une longue chaîne d’acide gras, hydrophobe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b6f788f-719a-3f92-9fd8-27548afe44c0",
                                        "entry_id": "a6d72db9-85fa-3487-840e-f59e44363567",
                                        "glosses": [
                                            "Nomme les surfaces qui repoussent l'eau, des surfaces non mouillables."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07d9ec53-8e11-4ef5-8864-4d1f88a7840b",
                                                "sense_id": "5b6f788f-719a-3f92-9fd8-27548afe44c0",
                                                "text": "Sur une surface hydrophobe, comme le silicone ou un parquet ciré, l’eau forme des gouttes qui ne s’étalent pas."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hydrophobe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d38406bc-2c77-31ca-b58c-8fbc0b103390",
                                        "entry_id": "b62bbcd3-f12e-30f2-9313-8621ba6e2d51",
                                        "glosses": [
                                            "Personne qui souffre d’hydrophobie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07a135e8-e104-4001-9720-f9a519fbf3a9",
                                                "sense_id": "d38406bc-2c77-31ca-b58c-8fbc0b103390",
                                                "text": "Cette mer était infiniment plus gaie et plus colorée que l’océan que je fréquentais depuis ma tendre enfance ; moins menaçante aussi pour un hydrophobe comme moi."
                                            }
                                        ]
                                    }
                                ]
                            }
