                        "examples": [
                            {
                                "example_id": "1834b3e9-89a5-40bc-ad97-008b391f4a00",
                                "sense_id": "cbb7cd04-c09d-38e0-8f20-2ef5ecc30de0",
                                "text": "Bei der Beschaffung von Militärflugzeugen kommt es oft zu Bestechungsskandalen.",
                                "translation": "Les achats d’avions militaires sont souvent impliqués dans des scandales de corruption."
                            },
                            {
                                "example_id": "c9b66ad0-a904-4d75-9268-d8baa6ca1be4",
                                "sense_id": "cbb7cd04-c09d-38e0-8f20-2ef5ecc30de0",
                                "text": "Ein russisches Militärflugzeug hat nach kanadischen Angaben eine kanadische Fregatte im Schwarzen Meer überflogen und mehrfach umkreist.",
                                "translation": "Selon les forces du Canada, un avion militaire russe aurait survolé et tourné plusieurs fois autour d’une frégate canadienne navigant dans la mer Noire."
                            }
                        ]
                    }
