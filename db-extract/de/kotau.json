                    {
                        "form_id": "4dbf77ef-b08b-4408-b8d8-b49367dd351c",
                        "entry_id": "3f298ce8-7ec0-3892-8a66-6f28d42e4eb1",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Kotau"
                    },
                    {
                        "form_id": "a71d6d9a-b8f0-4539-8d28-6998bb0a2216",
                        "entry_id": "3f298ce8-7ec0-3892-8a66-6f28d42e4eb1",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Kotaus"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e86cd15d-7b60-3d4e-8d3b-47dd4f1646f4",
                        "entry_id": "3f298ce8-7ec0-3892-8a66-6f28d42e4eb1",
                        "glosses": [
                            "ehrerbietiger Gruß im Kaiserreich China, indem der Besucher sich auf den Boden wirft und mehrmals mit der Stirn den Boden berührt, besonders auch als Demutsbezeugung vor dem chinesischen Kaiser; chinesische Ehrenbezeigung; Unterwerfungsgeste; chinesische Verbeugung"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "5236ed11-28ac-4e6f-b01b-d5a5f05d3e98",
                                "sense_id": "e86cd15d-7b60-3d4e-8d3b-47dd4f1646f4",
                                "text": "Nach der Revolution von 1912 und der Ausrufung der Republik China wurde der Kotau offiziell abgeschafft."
                            },
                            {
                                "example_id": "2383b40a-45ef-4df9-b31f-0b709b8615e7",
                                "sense_id": "e86cd15d-7b60-3d4e-8d3b-47dd4f1646f4",
                                "text": "„Geistesgegenwärtig ließ er sich auf die Knie nieder und neigte sich hurtig zum Kotau – oh, nicht bloß zu einem, vielmehr gleich zu einer ganzen Reihe von Stirnaufschlägen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d7ce9bc6-d56d-3466-b905-d0fe119a9d05",
                        "entry_id": "3f298ce8-7ec0-3892-8a66-6f28d42e4eb1",
                        "glosses": [
                            "Umschreibung für Unterwerfung, Eingliederung in eine Rangordnung oder nicht ganz freiwilliges Nachgeben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b30709a-21cd-4d4a-9fc5-60a57100729f",
                                "sense_id": "d7ce9bc6-d56d-3466-b905-d0fe119a9d05",
                                "text": "Wieder einmal hat eine deutsche Regierung den Kotau vor den USA gemacht."
                            },
                            {
                                "example_id": "b7b7bd88-d6eb-46d3-a556-2cd64cdd1653",
                                "sense_id": "d7ce9bc6-d56d-3466-b905-d0fe119a9d05",
                                "text": "„Das feiernde Volk huldigt ihm, er nimmt den Kotau mit dem generösen Gestus eines Monarchen entgegen, der seine Untertanen mit einer Erklärung zum hundertjährigen Frieden beglückt.“"
                            },
                            {
                                "example_id": "287330cf-0641-45c6-abee-3542eebb2e31",
                                "sense_id": "d7ce9bc6-d56d-3466-b905-d0fe119a9d05",
                                "text": "„Dem schändlichen Kotau zog man die Selbstauflösung vor.“"
                            },
                            {
                                "example_id": "6a6c7fd3-3d0f-4138-a36a-b433ee899093",
                                "sense_id": "d7ce9bc6-d56d-3466-b905-d0fe119a9d05",
                                "text": "„Erst im Jahr 1862, in dem Max Müllers Vorlesungen veröffentlicht wurden, kehrte er nach England zurück – und machte Darwin vom ersten Moment an mit einem tiefen Kotau den Weg frei.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d9dfa915-db7a-4add-a5d8-7ba313874a9c",
                        "source_entry_id": "3f298ce8-7ec0-3892-8a66-6f28d42e4eb1",
                        "source_sense_id": "e86cd15d-7b60-3d4e-8d3b-47dd4f1646f4",
                        "target_lang_word": "kowtow",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kowtow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f5ba35c1-eee8-32fd-8ca3-cc6f095614c2",
                                        "entry_id": "70822a64-c871-3ad4-8598-f63087bc8965",
                                        "glosses": [
                                            "To kneel and bow low enough to touch one’s forehead to the ground."
                                        ],
                                        "tags": [
                                            "historical",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4cf25f8-9739-45c6-bd55-73f09f9c12a3",
                                                "sense_id": "f5ba35c1-eee8-32fd-8ca3-cc6f095614c2",
                                                "text": "When the weather turned cold, the tears that he shed would become frozen like veins; the blood on his forehead from kowtowing would also freeze and would not drip."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c64fbbd-b3ab-3e57-9251-1a92173e59e5",
                                        "entry_id": "70822a64-c871-3ad4-8598-f63087bc8965",
                                        "glosses": [
                                            "To grovel, act in a very submissive manner; to show obeisance to (someone or something) in such a manner; to bow."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e428e41-5217-485b-989c-72c028d9b271",
                                                "sense_id": "8c64fbbd-b3ab-3e57-9251-1a92173e59e5",
                                                "text": "I suppose you're going to be nice to Odie and kowtow to Jon and lick the mailman's boots! I don't like you already."
                                            },
                                            {
                                                "example_id": "57590b01-4f99-45ce-be61-17219db06a6e",
                                                "sense_id": "8c64fbbd-b3ab-3e57-9251-1a92173e59e5",
                                                "text": "The letter to Razin contained another thought that preoccupied Stalin in the first months after the war: the need to avoid “kowtowing to the West,” including showing “unwarranted respect” for the “military authorities of Germany.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9d72fd2-c2bf-38df-964a-41dc4c103364",
                                        "entry_id": "70822a64-c871-3ad4-8598-f63087bc8965",
                                        "glosses": [
                                            "To bow very deeply."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "kowtow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "63c5a3d1-f297-31cb-adee-2cb29e1d209e",
                                        "entry_id": "e49dfb1c-8b2f-3ba7-97aa-75f5ec666f93",
                                        "glosses": [
                                            "The act of kowtowing."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0238f4b5-d435-4c42-850d-9904bb096bb8",
                                                "sense_id": "63c5a3d1-f297-31cb-adee-2cb29e1d209e",
                                                "text": "Three elders dressed in their long silk ceremonial gowns perform the kowtow before the altar in their clan ancestral hall."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
