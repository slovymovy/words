                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f4b09167-c963-4b71-a3af-b24a87854de7",
                        "entry_id": "7dafee1f-0c27-3379-a6bd-68924448b655",
                        "tags": [
                            "plural"
                        ],
