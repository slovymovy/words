                "senses": [
                    {
                        "sense_id": "4b70a87d-d5f0-32ba-b448-af4edc1312ad",
                        "entry_id": "878c53dd-446c-3b35-9a71-73da341e4219",
                        "glosses": [
                            "ботан. смолистое вещество, выделяющееся при повреждении стволов хвойных деревьев"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0fb77583-f185-49f8-b78c-6c495425333e",
                                "sense_id": "4b70a87d-d5f0-32ba-b448-af4edc1312ad",
                                "text": "В сосняке поживёт человек недели три-четыре, пособирает эту живицу из коробочек в бочки ― глядишь, и деньги заработает и дыханье легче станет"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bc130dbf-83e8-4858-83b8-97ec0a98edaf",
                        "source_entry_id": "878c53dd-446c-3b35-9a71-73da341e4219",
                        "source_sense_id": "4b70a87d-d5f0-32ba-b448-af4edc1312ad",
                        "target_lang_word": "sap",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sap",
