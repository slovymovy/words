                        "examples": [
                            {
                                "example_id": "cb31bd47-a7ce-4876-ad98-ad4570ee4460",
                                "sense_id": "9c7b392e-4feb-3347-ae3b-71db92a5fe2b",
                                "text": "„Die Grundausbildung bei den Elitesoldaten der Aufklärer des Heeres gilt als härter und anspruchsvoller als bei den meisten anderen Waffengattungen, ausgenommen natürlich das Jagdkommando, welches die militärische Spezialeinheit des Heeres darstellt und mit ihren intensiv ausgebildeten Elitesoldaten für Sonderverwendung auch zum großen Teil mehr und andere Aufgaben zu erfüllen hat.“"
                            },
                            {
                                "example_id": "63113fa3-6148-4018-81ee-5c1993b1565b",
                                "sense_id": "9c7b392e-4feb-3347-ae3b-71db92a5fe2b",
                                "text": "„In einem bescheidenen Reihenhäuschen in Pakistan wurde Osama bin Laden von amerikanischen Elitesoldaten zur Strecke gebracht.“"
                            }
