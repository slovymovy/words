{
    "word_family": [
        "disparagement",
        "disparager",
        "disparagingly"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "785ad9bb-9cf5-3498-b986-c2634eb4cdbc",
                    "sense_definition": "To speak about someone or something in a way that shows you do not think they are important or valuable.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "criticize",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is unprofessional to <w>disparage</w> your colleagues during a public meeting."
                        },
                        {
                            "text": "The critic continued to <w>disparage</w> the artist's work despite its growing popularity."
                        }
                    ],
                    "synonyms": [
                        "belittle",
                        "depreciate",
                        "denigrate"
                    ],
                    "antonyms": [
                        "praise",
                        "commend"
                    ],
                    "common_phrases": [
                        "disparage the efforts"
                    ]
                },
                {
                    "sense_id": "4d1d6b52-5b3e-3e3a-83e7-a370a007c8c3",
                    "sense_definition": "To mock or discredit someone or something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "criticize",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He tried to <w>disparage</w> her achievements by claiming they were merely a matter of luck."
                        },
                        {
                            "text": "Do not <w>disparage</w> the hard work of others just because you disagree with their methods."
                        }
                    ],
                    "synonyms": [
                        "ridicule",
                        "mock",
                        "discredit"
                    ]
                },
                {
                    "sense_id": "87fdee70-95b2-3881-b1c7-f2e217606b50",
                    "sense_definition": "To lower the rank or honor of someone or something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "degrade",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scandal served to <w>disparage</w> the reputation of the entire royal family."
                        },
                        {
                            "text": "Such actions only serve to <w>disparage</w> the dignity of the office."
                        }
                    ],
                    "synonyms": [
                        "degrade",
                        "dishonor"
                    ],
                    "antonyms": [
                        "exalt"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is largely archaic in modern English."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b85930d7-4461-3771-bd73-23fbdac32080",
                    "sense_definition": "An unequal marriage or a marriage with someone of an inferior social rank.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "degrade",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In historical literature, a <w>disparage</w> was often seen as a threat to family status."
                        },
                        {
                            "text": "The noble family forbade the union, fearing it would be a <w>disparage</w> to their lineage."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This noun usage is obsolete in contemporary English."
                        }
                    ]
                }
            ]
        }
    ]
}