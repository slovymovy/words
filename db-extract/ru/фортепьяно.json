                                        "glosses": [
                                            "To become softer and less intense."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6abef3f8-9293-403b-b3e8-0b7d1cbb251c",
                                                "sense_id": "1817a12d-2c73-33a2-9658-d96df42034ea",
                                                "text": "His tone pianoed on intimacy."
                                            },
                                            {
                                                "example_id": "424a9580-9109-4b72-a15a-dbb0bfda9511",
                                                "sense_id": "1817a12d-2c73-33a2-9658-d96df42034ea",
                                                "text": "A day pianoed, swelled acutest, pianoed."
                                            },
                                            {
                                                "example_id": "dab39002-432b-4c9d-81dc-acca64b15705",
                                                "sense_id": "1817a12d-2c73-33a2-9658-d96df42034ea",
                                                "text": "“You know, Mrs. Wrigglechops,” pianoed Miss Drucilla , even more meekly and mildly than before, \"the ace is either one or eleven.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
