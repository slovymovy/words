                "senses": [
                    {
                        "sense_id": "dfbf612e-252d-38b9-bfa1-fdd1af71c824",
                        "entry_id": "fddfd540-036c-3e94-99d9-50831576473b",
                        "glosses": [
                            "Having the equipment, resources, and skills one needs; prepared."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c09a6927-3289-4d57-a4be-e76374ba443c",
                                "sense_id": "dfbf612e-252d-38b9-bfa1-fdd1af71c824",
                                "text": "Hence, the delivery of animal health services in Cameroon faces a peculiar paradox: those who are most qualified and most equipped to deliver services are not the ones delivering them."
                            },
                            {
                                "example_id": "00cf9850-9279-43ab-8c89-91676abc9baa",
                                "sense_id": "dfbf612e-252d-38b9-bfa1-fdd1af71c824",
                                "text": "My hope for you is that this book reads you as much as you read it, that you see your reflection in the stories I share, and find yourself inspired and more equipped to live life with more ease and more joy, and to more often access the deepest realms of creativity, connection, and compassion—to be more"
                            },
                            {
                                "example_id": "21ae3907-a22c-4a92-9511-5599ceb0b9d6",
                                "sense_id": "dfbf612e-252d-38b9-bfa1-fdd1af71c824",
                                "text": "You don't seem very equipped for the cellars."
                            }
                        ]
                    }
