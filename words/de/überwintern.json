                    "sense_definition": "den Winter oder die kalte Jahreszeit an einem bestimmten Ort verbringen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "verbringen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Viele Vogelarten fliegen in den Süden und <w>überwintern</w> dort in wärmeren Regionen."
                        },
                        {
                            "text": "Einige Säugetiere fressen sich vor dem Frost satt und <w>überwintern</w> in tiefen Höhlen."
                        }
                    ],
                    "synonyms": [
