                    {
                        "sense_id": "77b6b2dd-a32c-398d-99bd-da090e1eab70",
                        "entry_id": "5cbf2719-7dc3-3770-9e7f-3bc8405d1bc5",
                        "glosses": [
                            "iemand die zwartrijdt, iemand die van het openbaar vervoer gebruikmaakt zonder te betalen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e10fdbab-aed5-4e06-8d55-36e408e09593",
                                "sense_id": "77b6b2dd-a32c-398d-99bd-da090e1eab70",
                                "text": "Hij is een gewiekste zwartrijder."
                            },
                            {
                                "example_id": "660fe68b-edd0-4613-b197-04698e23c95a",
                                "sense_id": "77b6b2dd-a32c-398d-99bd-da090e1eab70",
                                "text": "Mijn vader reed als zwartrijder met hem mee."
                            }
                        ]
                    },
                    {
                        "sense_id": "72795078-304f-39aa-86e6-34042e3a35ae",
                        "entry_id": "5cbf2719-7dc3-3770-9e7f-3bc8405d1bc5",
                        "glosses": [
                            "iemand die nalaat wegenbelasting te betalen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1694eb72-96d5-4fa7-a038-2a2137424084",
                                "sense_id": "72795078-304f-39aa-86e6-34042e3a35ae",
                                "text": "Bij een grootscheepse controle werd de zwartrijder aangehouden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b02ca698-8bad-4bd9-8dac-abebe9f42a4d",
                        "source_entry_id": "5cbf2719-7dc3-3770-9e7f-3bc8405d1bc5",
                        "source_sense_id": "77b6b2dd-a32c-398d-99bd-da090e1eab70",
                        "source_sense_description": "iemand die van het openbaar vervoer gebruikmaakt zonder te betalen",
                        "target_lang_word": "Schwarzfahrer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schwarzfahrer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b15d8d17-33bc-3c4c-915e-72f25a9ba1cd",
                                        "entry_id": "efc9a0a0-8da0-3d26-9b85-4a8bccb737cb",
                                        "glosses": [
                                            "Person, die ein Verkehrsmittel in Anspruch nimmt, ohne dafür den Fahrpreis zu entrichten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00150319-47f9-45a8-be68-08de4baef24e",
                                                "sense_id": "b15d8d17-33bc-3c4c-915e-72f25a9ba1cd",
                                                "text": "Wenn Schwarzfahrer erwischt werden, müssen sie Strafe zahlen."
                                            },
                                            {
                                                "example_id": "9173404f-1647-434f-8c60-01340c10947e",
                                                "sense_id": "b15d8d17-33bc-3c4c-915e-72f25a9ba1cd",
                                                "text": "„Als ich allein mit dem Zug zurückfuhr, blieb ich immer nur so kurz wie möglich auf dem Klo, damit der Schaffner nicht dachte, daß ich mich da als Schwarzfahrer eingeschlossen hätte.“"
                                            },
                                            {
                                                "example_id": "63c4a0b6-b18c-4830-9662-3a4ee29b6469",
                                                "sense_id": "b15d8d17-33bc-3c4c-915e-72f25a9ba1cd",
                                                "text": "„Als Einzige starre ich ihn an. Nicht, dass ich den Schwarzfahrer ansprechen will, um ihm eine Predigt zu halten, oder dass mich seine rebellische Geste schockiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d09d3d16-6f5a-3f78-bf07-e7a3f0f00752",
                                        "entry_id": "efc9a0a0-8da0-3d26-9b85-4a8bccb737cb",
                                        "glosses": [
                                            "Person, die ein Fahrzeug ohne gültigen Führerschein/ohne Erlaubnis des Eigentümers führt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b5be929-08d7-44aa-940e-183a6a42b0a3",
                                                "sense_id": "d09d3d16-6f5a-3f78-bf07-e7a3f0f00752",
                                                "text": "Wenn Schwarzfahrer erwischt werden, müssen sie Strafe zahlen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0c96762a-6307-463a-81d1-fd7510549d65",
                        "source_entry_id": "5cbf2719-7dc3-3770-9e7f-3bc8405d1bc5",
                        "source_sense_id": "77b6b2dd-a32c-398d-99bd-da090e1eab70",
                        "source_sense_description": "iemand die van het openbaar vervoer gebruikmaakt zonder te betalen",
                        "target_lang_word": "fare dodger",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fare dodger",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dc0130a6-2e12-3e03-b3fb-777e6dccd14b",
                                        "entry_id": "0039c65b-7b35-3e40-a7dd-c86ea990d350",
                                        "glosses": [
                                            "A person who deliberately avoids payment for public transport."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9ca2ff0-6590-4466-af4a-f173c472a986",
                                                "sense_id": "dc0130a6-2e12-3e03-b3fb-777e6dccd14b",
                                                "text": "Police officers and prosecutors were forced to spend sizeable proportions of their capacity on arresting and prosecuting faredodgers."
                                            },
                                            {
                                                "example_id": "5c973b70-08ae-4d1d-9364-e09d39797384",
                                                "sense_id": "dc0130a6-2e12-3e03-b3fb-777e6dccd14b",
                                                "text": "The fare-dodger and the gate-crasher do, after all, commit a trespass [...]"
                                            },
                                            {
                                                "example_id": "7fc0a705-7c53-4a1c-be1b-66db7fe8e9c7",
                                                "sense_id": "dc0130a6-2e12-3e03-b3fb-777e6dccd14b",
                                                "text": "Alan Pollock was hailed as a hero after millions on the internet watched a video of the ‘Big Man’ hauling an alleged fare dodger off a train."
                                            },
                                            {
                                                "example_id": "c0f79ac4-d217-4a34-adcc-f8fa168af4dd",
                                                "sense_id": "dc0130a6-2e12-3e03-b3fb-777e6dccd14b",
                                                "text": "The subject of dealing with fare dodgers seems to be ripe, particularly on crowded trains where the 'train manager-cum-ticket collector' can have difficulty getting through the carriages."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
