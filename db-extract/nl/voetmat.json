                                "target_senses": [
                                    {
                                        "sense_id": "a78acb25-95e1-3da1-b799-9c64dcd8f10d",
                                        "entry_id": "09b34849-7593-3130-a6cb-768d0257cf7f",
                                        "glosses": [
