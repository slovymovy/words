                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b0866a9c-2ee1-33a1-b131-1dbf4e8987a8",
                                        "entry_id": "125737dc-15bd-3c87-900b-f92b14142d26",
                                        "glosses": [
                                            "A male given name from the Germanic languages, popular in England since the Middle Ages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "efaf26a8-f0a5-4055-9959-1e8797915c14",
                                                "sense_id": "b0866a9c-2ee1-33a1-b131-1dbf4e8987a8",
                                                "text": "And now I feare that fatall Prophecie, / Which in the time of Henry, nam'd the Fift, / Was in the mouth of euery ſucking Babe, / That Henry borne at Monmouth ſhould winne all, / And Henry borne at Windſor, looſe all: […]"
                                            },
                                            {
                                                "example_id": "503c1ae3-d894-4875-b6d1-7d57eb4df8ce",
                                                "sense_id": "b0866a9c-2ee1-33a1-b131-1dbf4e8987a8",
                                                "text": "Henry now, what a soft swain your Henry is! the proper theme of gentle poesy; a name to fall in love withal; devoted at the font to song and sonnet, and the tender passion; a baptized inamorato; a christened hero. Call him Harry, and see how you ameliorate his condition."
                                            },
                                            {
                                                "example_id": "ac239144-f2d9-4809-95dd-2b4ff923093c",
                                                "sense_id": "b0866a9c-2ee1-33a1-b131-1dbf4e8987a8",
                                                "text": "Walter [Map] was one of the remarkable men who stand before us as the representatives of a sudden outburst of literary, social, and religious criticism which followed the growth of romance and the appearance of a freer historical tone in the court of the two Henrys."
                                            },
                                            {
                                                "example_id": "da40b505-a6bb-473b-8916-78cb2b43b328",
                                                "sense_id": "b0866a9c-2ee1-33a1-b131-1dbf4e8987a8",
                                                "text": "Eight Henries, one Mary, / One Elizabeth; / Crowned and throned Kings and Queens / Now lie still in death."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2d22110-1b70-3b64-a1af-040039b59294",
                                        "entry_id": "125737dc-15bd-3c87-900b-f92b14142d26",
                                        "glosses": [
                                            "A French and English surname originating as a patronymic."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
