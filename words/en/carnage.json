{
    "word_family": [
        "carnal",
        "carnality",
        "carnally"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "48dc2c09-7199-3d8c-931a-400b2e3094ea",
                    "sense_definition": "The killing of a large number of people, especially in a bloody or violent way.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "violence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The battlefield was a scene of absolute <w>carnage</w> after the heavy artillery fire ceased.",
                            "target_lang_translations": {
                                "ru": "Поле боя представляло собой сцену абсолютной <w>резни</w> после того, как прекратился огонь тяжелой артиллерии."
                            }
                        },
                        {
                            "text": "Witnesses described the bloody <w>carnage</w> that followed the explosion in the crowded market.",
                            "target_lang_translations": {
                                "ru": "Очевидцы описывали кровавую <w>бойню</w>, последовавшую за взрывом на переполненном рынке."
                            }
                        }
                    ],
                    "synonyms": [
                        "massacre",
                        "bloodbath"
                    ],
                    "common_phrases": [
                        "bloody carnage",
                        "scene of carnage",
                        "total carnage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Убийство большого количества людей, особенно совершенное жестоким или насильственным способом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "резня",
                                "target_lang_sense_clarification": "массовое жестокое убийство"
                            },
                            {
                                "target_lang_word": "бойня",
                                "target_lang_sense_clarification": "кровавое побоище с множеством жертв"
                            },
                            {
                                "target_lang_word": "побоище",
                                "target_lang_sense_clarification": "кровопролитное сражение"
                            },
                            {
                                "target_lang_word": "кровопролитие",
                                "target_lang_sense_clarification": "пролитие крови, гибель людей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b318a5c0-711b-3226-bdab-835ded6ddf2d",
                    "sense_definition": "A situation of extreme chaos, confusion, or widespread destruction.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "chaos",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden policy change caused absolute <w>carnage</w> in the financial markets this morning.",
                            "target_lang_translations": {
                                "ru": "Внезапное изменение политики вызвало сегодня утром настоящий <w>хаос</w> на финансовых рынках."
                            }
                        },
                        {
                            "text": "It was total <w>carnage</w> in the kitchen as the amateur chefs tried to prepare the banquet.",
                            "target_lang_translations": {
                                "ru": "На кухне царил полный <w>разгром</w>, пока повара-любители пытались приготовить банкет."
                            }
                        }
                    ],
                    "common_phrases": [
                        "absolute carnage",
                        "total carnage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ситуация крайнего хаоса, неразберихи или масштабных разрушений."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хаос",
                                "target_lang_sense_clarification": "полная неразбериха"
                            },
                            {
                                "target_lang_word": "разгром",
                                "target_lang_sense_clarification": "полное разрушение или беспорядок"
                            },
                            {
                                "target_lang_word": "кошмар",
                                "target_lang_sense_clarification": "ужасающая ситуация"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f2ffcb77-2100-345d-a5ec-e32d9ca9bd33",
                    "sense_definition": "The messy or chaotic aftermath of a period of heavy drinking or wild partying.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "chaos",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hotel room was a scene of drunken <w>carnage</w> after the stag party left.",
                            "target_lang_translations": {
                                "ru": "Гостиничный номер представлял собой картину пьяного <w>погрома</w> после ухода мальчишника."
                            }
                        },
                        {
                            "text": "They returned from their holiday exhausted by the holiday <w>carnage</w> of the local nightclubs.",
                            "target_lang_translations": {
                                "ru": "Они вернулись из отпуска, измотанные праздничным <w>безумием</w> местных ночных клубов."
                            }
                        }
                    ],
                    "synonyms": [
                        "rampage"
                    ],
                    "common_phrases": [
                        "drunken carnage",
                        "holiday carnage"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used to describe wild social behavior"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Грязные или хаотичные последствия периода сильного пьянства или бурной вечеринки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "погром",
                                "target_lang_sense_clarification": "беспорядок после бурного веселья"
                            },
                            {
                                "target_lang_word": "хаос",
                                "target_lang_sense_clarification": "беспорядок в помещении"
                            },
                            {
                                "target_lang_word": "содом и гоморра",
                                "target_lang_sense_clarification": "крайний беспорядок и распущенность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e815d0ad-f1e6-3b6a-b316-2844f2a8ee82",
                    "sense_definition": "A sporting event or game in which one side is defeated overwhelmingly.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "competition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The championship final turned into pure <w>carnage</w> as the home team lost by fifty points.",
                            "target_lang_translations": {
                                "ru": "Финал чемпионата превратился в чистый <w>разгром</w>, когда хозяева поля проиграли пятьдесят очков."
                            }
                        },
                        {
                            "text": "Fans were shocked by the sporting <w>carnage</w> when the underdog was crushed in the first half.",
                            "target_lang_translations": {
                                "ru": "Болельщики были шокированы спортивной <w>бойней</w>, когда аутсайдер был разгромлен в первом тайме."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pure carnage",
                        "sporting carnage"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used metaphorically in sports contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Спортивное событие или игра, в которой одна сторона терпит сокрушительное поражение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разгром",
                                "target_lang_sense_clarification": "поражение с крупным счетом"
                            },
                            {
                                "target_lang_word": "избиение",
                                "target_lang_sense_clarification": "метафорически о легкой победе над слабым соперником"
                            },
                            {
                                "target_lang_word": "бойня",
                                "target_lang_sense_clarification": "жестокое спортивное противостояние"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}