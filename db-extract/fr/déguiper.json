                "senses": [
                    {
                        "sense_id": "ff94f967-57e7-33d9-9f36-ba190b077f2f",
                        "entry_id": "54cd1424-c10c-3691-aef8-f33e99cbe571",
                        "glosses": [
                            "Enlever le guipage mis sur quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1fc4fece-fb95-49fd-bc08-e12d604a3855",
                                "sense_id": "ff94f967-57e7-33d9-9f36-ba190b077f2f",
                                "text": "On avait eu soin de ne pas encore déguiper les bouts de manière à éviter toute trace d’humidité entre le conducteur et la surface de l’isolant."
                            },
                            {
                                "example_id": "a7a9cd68-21ed-49da-8eaa-4f18f52d86e4",
                                "sense_id": "ff94f967-57e7-33d9-9f36-ba190b077f2f",
                                "text": "Appareils pour déguiper rapidement les fils et câbles."
                            },
                            {
                                "example_id": "5adfca61-3848-4a8c-a8f6-ca705fb1d69f",
                                "sense_id": "ff94f967-57e7-33d9-9f36-ba190b077f2f",
                                "text": "Tiens nous au courant, si tu y arrives vraiment pas, à la limite je pourrais peut être me déplacer ou toi venir chez moi pour déguiper les vis."
                            }
                        ]
                    }
