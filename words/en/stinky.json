{
    "word_family": [
        "stink"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5964d55e-4dfd-3a2b-9ec9-b5420d36ab72",
                    "sense_definition": "Having a strong, unpleasant smell.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "smell",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please take out the <w>stinky</w> trash before it makes the whole kitchen smell bad.",
                            "target_lang_translations": {
                                "zh": "请把<w>臭</w>垃圾倒掉，不然整个厨房都会有味道。"
                            }
                        },
                        {
                            "text": "The dog rolled in something <w>stinky</w> while we were walking in the park.",
                            "target_lang_translations": {
                                "zh": "我们在公园散步时，狗在一些<w>臭</w>东西里打滚。"
                            }
                        }
                    ],
                    "synonyms": [
                        "smelly",
                        "foul"
                    ],
                    "antonyms": [
                        "fragrant"
                    ],
                    "common_phrases": [
                        "stinky feet",
                        "stinky cheese"
                    ],
                    "target_lang_definitions": {
                        "zh": "有强烈的、令人不快的气味。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "臭",
                                "target_lang_sense_clarification": "形容气味难闻。"
                            },
                            {
                                "target_lang_word": "难闻",
                                "target_lang_sense_clarification": "形容气味不好。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b4d1938e-3e10-36ff-bb96-8abdc90f870e",
                    "sense_definition": "Bad, unpleasant, or undesirable.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was a <w>stinky</w> situation to be stuck in traffic for three hours.",
                            "target_lang_translations": {
                                "zh": "堵车三个小时真是个<w>糟糕</w>的情况。"
                            }
                        },
                        {
                            "text": "He made a <w>stinky</w> decision to quit his job without having another one lined up.",
                            "target_lang_translations": {
                                "zh": "他在没找好下家的情况下就辞职，这个决定太<w>烂</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "awful",
                        "lousy"
                    ],
                    "antonyms": [
                        "great",
                        "excellent"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used by children or in informal contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "糟糕的、令人不快的或不理想的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "糟糕",
                                "target_lang_sense_clarification": "形容情况或决定很差。"
                            },
                            {
                                "target_lang_word": "烂",
                                "target_lang_sense_clarification": "口语中形容事物很差。"
                            }
                        ]
                    }
                }
            ]
        },
        {
