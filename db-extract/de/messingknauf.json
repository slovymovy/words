                "senses": [
                    {
                        "sense_id": "b73e1f89-3083-3453-bd44-8d96f9534661",
                        "entry_id": "e6acb1e6-e300-3fcc-bd86-a52877537a9f",
                        "glosses": [
                            "Knauf aus Messing"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dff1b7ea-417d-49b3-9678-7cc340a27fec",
                                "sense_id": "b73e1f89-3083-3453-bd44-8d96f9534661",
                                "text": "„Es war das stetige, verstohlene Knarren der Treppenstufen hinter der verschlossenen Tür, als stiege eine barfüßige oder Fellschuhe tragende Horde sie hinauf; und schließlich das vorsichtige, doch entschlossene Rütteln an dem Messingknauf, der im schwachen Licht der Kerzen funkelte.“"
                            },
                            {
                                "example_id": "6ad6fc9f-22b8-439a-bb94-210d449e497e",
                                "sense_id": "b73e1f89-3083-3453-bd44-8d96f9534661",
                                "text": "„Bouncer trottete von der Frau zu einer Tür, um daran zu schnuppern und mit der Pfote zu kratzen, einer kleinen Tür mit einem Messingknauf.“"
                            },
                            {
                                "example_id": "f22a3ec8-33ed-4408-8908-e06901f485a6",
                                "sense_id": "b73e1f89-3083-3453-bd44-8d96f9534661",
                                "text": "„Er schlich zur Tür des Arbeitszimmers und griff nach dem ziselierten Messingknauf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
