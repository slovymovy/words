                "senses": [
                    {
                        "sense_id": "859687df-3cf6-3f01-aff0-044ce0478099",
                        "entry_id": "e6121ca2-f781-39f1-a10b-6368eceba75f",
                        "glosses": [
                            "Bereich einer Stadt (= Viertel, Quartier), in dem der Hafen liegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2b65ee5-eb7c-4618-be20-7ebbc10bb993",
                                "sense_id": "859687df-3cf6-3f01-aff0-044ce0478099",
                                "text": "„Seit 2004 gehört das Hafenviertel [Liverpools] zum UNESCO-Weltkulturerbe.“"
                            },
                            {
                                "example_id": "8bb3a663-99fe-4837-8599-7c71f8ebb411",
                                "sense_id": "859687df-3cf6-3f01-aff0-044ce0478099",
                                "text": "„15 historische Bergbahnen (Ascensores) verbinden das Hafenviertel mit den auf den Hügeln gelegenen Quartieren.“"
                            },
                            {
                                "example_id": "b373bb9d-35f3-420e-aaf4-db14fe764f4a",
                                "sense_id": "859687df-3cf6-3f01-aff0-044ce0478099",
                                "text": "„Am östlichen [Flensburger] Fördeufer liegt der Stadtteil Mürwik. Auf einem ehemaligen Marinegelände ist das neue Hafenviertel Sonwik entstanden. Denkmalgeschützte Marinegebäude wurden zu Apartmenthäusern umgebaut.“"
                            },
                            {
                                "example_id": "9497eb10-c326-4093-866b-1c15b536cd62",
                                "sense_id": "859687df-3cf6-3f01-aff0-044ce0478099",
                                "text": "„Wenn man Erdoğan verstehen will, sofern das überhaupt geht, muss man wohl ins alte Istanbuler Hafenviertel Kasimpasa gehen.“"
                            },
                            {
                                "example_id": "793e4097-fd43-49ee-b1f4-e3a5979ae40f",
                                "sense_id": "859687df-3cf6-3f01-aff0-044ce0478099",
                                "text": "„Wenn man wissen will, wie die Bibliothek der Zukunft aussehen könnte, schaut man am besten ins dänische Aarhus. 2015 eröffnete dort im Hafenviertel die neue städtische Bibliothek Dokk 1.“"
                            },
                            {
                                "example_id": "e363b825-9aa7-4d89-b209-b545932aa939",
                                "sense_id": "859687df-3cf6-3f01-aff0-044ce0478099",
                                "text": "„Lessing mietet sich auf dem Holländischen Brook ein, im Hafenviertel, und beginnt enthusiastisch mit der Arbeit.“"
                            },
                            {
                                "example_id": "59c41e5d-a798-4e99-bdc9-fec63ff5afbf",
                                "sense_id": "859687df-3cf6-3f01-aff0-044ce0478099",
                                "text": "„Die serbische Regierung will am Belgrader Hafen ein neues Viertel mit luxuriösen Wolkenkratzern bauen. Scheichs liefern das Geld, Kritiker sprechen von Größenwahn und einem Ausverkauf des alten Hafenviertels.“"
                            },
                            {
                                "example_id": "53e5b572-a0ac-4bbb-8bb5-ea6ca853318b",
                                "sense_id": "859687df-3cf6-3f01-aff0-044ce0478099",
                                "text": "„[1943] hatten die Nazis die südfranzösische Stadt [Marseille …] besetzt und ein Hafenviertel gesprengt.“"
                            },
                            {
                                "example_id": "be288bc8-e2bd-453b-9ada-9caca20750f3",
                                "sense_id": "859687df-3cf6-3f01-aff0-044ce0478099",
                                "text": "„Wenigen ist bekannt, dass die Deutschen 1943 einen Teil des Hafenviertels von Marseille zerstörten.“"
                            },
                            {
                                "example_id": "9f201df0-24c5-4c77-a829-73e5486d40d8",
                                "sense_id": "859687df-3cf6-3f01-aff0-044ce0478099",
                                "text": "„Die Nazis haben in dem Hafenviertel [Lissabons] im Zweiten Weltkrieg unter den Prostituierten ein Netz von Informantinnen unterhalten und den Damen sogar Englisch beigebracht, damit sie von betrunkenen englischen Matrosen wichtige Informationen über die Alliierten erfahren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
