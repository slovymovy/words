                                            {
                                                "example_id": "0ba39592-bc1d-4290-a557-c3d20cfc2470",
                                                "sense_id": "bbe6d307-6b22-3058-9c44-a2e4b52b3df7",
                                                "text": "Herein lies an unsummed world of grief. For in this plaintive fable we find embodied the Hamletism of the antique world; the Hamletism of three thousand years ago: “The flower of virtue cropped by a too rare mischance.”"
                                            },
                                            {
                                                "example_id": "f8e5b7ca-0c7a-4994-b45d-dc37921ae49c",
                                                "sense_id": "bbe6d307-6b22-3058-9c44-a2e4b52b3df7",
                                                "text": "At last, out of sheer Hamletism, he kills himself, leaving Marianne to Solomine, whom he feels that (despite her promise to him) she has began^([sic]) to look on with an admiration very much akin to love."
                                            }
                                        ]
                                    }
