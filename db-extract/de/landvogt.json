                ],
                "senses": [
                    {
                        "sense_id": "6bbd707f-852b-3700-a5ca-d16d59aedd30",
                        "entry_id": "649fbcda-1e0e-3edd-a615-24153beed5cb",
                        "glosses": [
                            "vom König mit der Verwaltung eines Gebietes, das direkt dem Reich unterstand, beauftragte Person"
                        ],
                        "tags": [
                            "Mittelalter"
                        ],
                        "examples": [
                            {
                                "example_id": "61fa0343-2308-4cb5-bdee-1b8aa7900a6b",
                                "sense_id": "6bbd707f-852b-3700-a5ca-d16d59aedd30",
                                "text": "„Du weißt, wie hier\n Zu Schwyz sich alle Redlichen beklagen\n Ob dieses Landvogts Geiz und Wüterei.“"
                            },
                            {
                                "example_id": "5da425d3-1ff7-41c6-b133-ef8d868e52e0",
                                "sense_id": "6bbd707f-852b-3700-a5ca-d16d59aedd30",
                                "text": "„Nur der dänische Landvogt hatte blanke Stulpenstiefel aus weichem, schön braunem und frisch eingefettetem Leder, die bis zu den Knien reichten, mit blitzblanken silbernen Sporen.“"
                            },
                            {
                                "example_id": "25715a4b-7084-4355-a1e0-bc14c0a21a4b",
                                "sense_id": "6bbd707f-852b-3700-a5ca-d16d59aedd30",
                                "text": "„Im Jahr 1540 ließ der Wittenberger Landvogt eine Herumtreiberin mit Namen Prista Frühbottin verhaften.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7c61d9a7-2be2-398c-bb18-4e0af841fa65",
                        "entry_id": "649fbcda-1e0e-3edd-a615-24153beed5cb",
                        "glosses": [
                            "Person, die ein Landgut verwaltet"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "6ac666c0-7867-4be7-84b9-de9db11e459b",
                                "sense_id": "7c61d9a7-2be2-398c-bb18-4e0af841fa65",
                                "text": "Mein Gatte ist der neue Landvogt auf dieser Besitzung."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "732860f3-08a0-40e8-b371-3e8bab8991ec",
                        "source_entry_id": "649fbcda-1e0e-3edd-a615-24153beed5cb",
                        "source_sense_id": "6bbd707f-852b-3700-a5ca-d16d59aedd30",
                        "source_sense_description": "Verwalter eines Gebietes",
                        "target_lang_word": "bailli",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bailli",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "39d7ead8-e400-3de7-9eea-d8eb064a82f5",
                                        "entry_id": "19e226a0-3b5b-3279-8a2f-51da266036a7",
                                        "glosses": [
                                            "Officier royal ou seigneurial, au nom duquel la justice se rendait dans l’étendue d’une certaine juridiction (baillie) où il exerce par délégation un pouvoir administratif et militaire, et surtout des attributions judiciaires."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df5a8382-c02c-4b29-8e9b-903803e144a4",
                                                "sense_id": "39d7ead8-e400-3de7-9eea-d8eb064a82f5",
                                                "text": "Le bailli de Rouen."
                                            },
                                            {
                                                "example_id": "2a72155c-7472-4aff-8518-db386a5d053f",
                                                "sense_id": "39d7ead8-e400-3de7-9eea-d8eb064a82f5",
                                                "text": "Le grand bailli de Vermandois."
                                            },
                                            {
                                                "example_id": "6b99884e-2f8a-4a48-be8d-a90b07bd3065",
                                                "sense_id": "39d7ead8-e400-3de7-9eea-d8eb064a82f5",
                                                "text": "Le grand bailli de Touraine."
                                            },
                                            {
                                                "example_id": "ff2f4f93-6595-4980-af17-f9d250314147",
                                                "sense_id": "39d7ead8-e400-3de7-9eea-d8eb064a82f5",
                                                "text": "Vers 1255, le bailli de Pont-Audemer, nommé Jean de Neuvy, était sous le poids des plus graves accusations, et parmi les nombreux méfaits qui lui étaient reprochés se trouvait l’impunité d’un assassinat commis sur un homme de Bourneville."
                                            },
                                            {
                                                "example_id": "451917df-428b-4d97-8ba1-a552b9c8a191",
                                                "sense_id": "39d7ead8-e400-3de7-9eea-d8eb064a82f5",
                                                "text": "Peu à peu le maître et le bailli sentaient monter en eux un malaise, leurs phrases se mitaient de silences, bientôt ils se turent en s’entre-regardant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "819b66c1-f3c6-33bb-8a87-83f1fbb1a2f7",
                                        "entry_id": "19e226a0-3b5b-3279-8a2f-51da266036a7",
                                        "glosses": [
                                            "Chevalier de l’ordre de Saint-Jean de Jérusalem, revêtu d’une dignité qui le mettait au-dessus des commandeurs et qui lui donnait le privilège de porter la grand-croix."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a28fcbce-c0b3-4f4d-a4b0-1b7601ddbf5b",
                                                "sense_id": "819b66c1-f3c6-33bb-8a87-83f1fbb1a2f7",
                                                "text": "Le bailli de la Morée."
                                            },
                                            {
                                                "example_id": "97b9f3f4-f757-403e-8472-146d25f12225",
                                                "sense_id": "819b66c1-f3c6-33bb-8a87-83f1fbb1a2f7",
                                                "text": "Le bailli de Suffren."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
