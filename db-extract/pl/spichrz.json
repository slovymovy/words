                                    },
                                    {
                                        "sense_id": "c9c94337-2795-3421-babc-5de78657162b",
                                        "entry_id": "23368f92-8d8c-388c-a38c-03199e3e675a",
                                        "glosses": [
                                            "Territorio o país rico en cereales."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c6e078a-8afd-4f79-ac70-78a7162e7038",
                                                "sense_id": "c9c94337-2795-3421-babc-5de78657162b",
                                                "text": "Ucrania es el granero de Europa."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ab73c4fb-95a7-42b1-b577-95aff3ff590a",
                        "source_entry_id": "7726a7f5-a712-3368-9120-c1d7f8b874bc",
                        "source_sense_id": "6ae5ace7-d5ac-34f2-b3aa-b9d18b3d0a9e",
                        "target_lang_word": "Speicher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Speicher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "97553117-2af0-3c30-90ea-b2d5e38b1bd0",
                                        "entry_id": "ade7791e-da78-3470-8045-706341b22338",
                                        "glosses": [
                                            "Gebäude, das zur Lagerung von Vorräten dient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ce892c2-d099-48fc-a7f0-a7685699db23",
                                                "sense_id": "97553117-2af0-3c30-90ea-b2d5e38b1bd0",
                                                "text": "Dort ist der Speicher für unsere Ernte."
                                            },
                                            {
                                                "example_id": "46bfb05f-5cb6-43db-b637-081c442d4c77",
                                                "sense_id": "97553117-2af0-3c30-90ea-b2d5e38b1bd0",
                                                "text": "„Es macht einen seltsamen Eindruck, mitten in diesem modernen Treiben vor jedem Speicher Reihen von Kamelen zu sehen, die daliegen, um mit Waren beladen zu werden.“"
                                            },
                                            {
                                                "example_id": "a10b5138-966f-4d88-b538-3bb2d31105a8",
                                                "sense_id": "97553117-2af0-3c30-90ea-b2d5e38b1bd0",
                                                "text": "„Reis und Getreide füllten seine Speicher.“"
                                            },
                                            {
                                                "example_id": "e9c0675f-ec0e-4444-a545-3bb9c12021b2",
                                                "sense_id": "97553117-2af0-3c30-90ea-b2d5e38b1bd0",
                                                "text": "„Sie liess sich schildern, wo es zum Speicher ging, wie sie sich schweigend hinstellen und horchen müsse.“"
                                            },
                                            {
                                                "example_id": "fb5a74e0-4b43-4972-a138-c8f3e3f9b551",
                                                "sense_id": "97553117-2af0-3c30-90ea-b2d5e38b1bd0",
                                                "text": "„Stattdessen wurde nun beim Donautor ein überdurchschnittlich großes Gebäude errichtet, das ebenfalls als Speicher interpretiert wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4022618e-faa0-3d46-838b-e914d69ef3c6",
                                        "entry_id": "ade7791e-da78-3470-8045-706341b22338",
                                        "glosses": [
                                            "Gerät/Gerätschaft/Anlage, dass/die der Speicherung eines (meist wertvollen) Mediums dient (beispielsweise Erdgas, Wasser, Strom, Wärme)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b20807a6-89dd-496d-a3b3-b7d9b26e485b",
                                                "sense_id": "4022618e-faa0-3d46-838b-e914d69ef3c6",
                                                "text": "„Die Anlage, die Ende kommenden Jahres ans Netz gehen soll, ist dann der größte Speicher seiner Art in Europa.“"
                                            },
                                            {
                                                "example_id": "d3709ffe-0ac8-4e87-a4f6-98c7e1993f54",
                                                "sense_id": "4022618e-faa0-3d46-838b-e914d69ef3c6",
                                                "text": "„Wurde 2017 noch der Speicher in Braderup (Kreis Nordfriesland) als einer der größten mit 2 Megawattstunden (MWh) gefeiert, so geht es jetzt um 239 MWh im Bollingstedter Ortsteil Gammelund (Kreis Schleswig-Flensburg).“"
                                            },
                                            {
                                                "example_id": "0dde7175-daea-43d9-bbdb-9e4fc935f8f8",
                                                "sense_id": "4022618e-faa0-3d46-838b-e914d69ef3c6",
                                                "text": "[Batteriespeicher:] „Ein Verkaufsargument: Weil die neuartigen Batterien nicht brennbar sind, können sie zu beliebig großen Speichern zusammengefügt werden.“"
                                            },
                                            {
                                                "example_id": "4e137ba4-9d06-48e1-8d91-7431e1d52138",
                                                "sense_id": "4022618e-faa0-3d46-838b-e914d69ef3c6",
                                                "text": "[Batteriespeicher:] „Weil Wind- und Sonnenenergie stark wetterabhängig sind, benötigen sie solche Speicher, um eine durchgängige Versorgung sicherzustellen.“"
                                            },
                                            {
                                                "example_id": "3572e54f-244e-4aa7-8ac4-3c177d3e01c3",
                                                "sense_id": "4022618e-faa0-3d46-838b-e914d69ef3c6",
                                                "text": "„Der Energiekonzern EWE etwa plant, einen Erdgasspeicher in Huntorf (Landkreis Wesermarsch) als Speicher für grünen Wasserstoff umzubauen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a4ddbc73-a3c3-3fb1-8555-ac2f82c0e6aa",
                                        "entry_id": "ade7791e-da78-3470-8045-706341b22338",
                                        "glosses": [
                                            "Raum unter dem Dach, der zum Abstellen dient"
                                        ],
                                        "tags": [
                                            "South-German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a86c54e-a8f6-4ef6-8544-22ba33b75636",
                                                "sense_id": "a4ddbc73-a3c3-3fb1-8555-ac2f82c0e6aa",
                                                "text": "Wie findest du dein neues Zimmer auf dem Speicher?"
                                            },
                                            {
                                                "example_id": "02543166-b4a9-4ba6-acb7-2d57e2dcfe1c",
                                                "sense_id": "a4ddbc73-a3c3-3fb1-8555-ac2f82c0e6aa",
                                                "text": "„Einmal schlich sich ein Junge in den Speicher, obwohl es die Eltern ausdrücklich verboten hatten.“"
                                            },
                                            {
                                                "example_id": "917e2441-0d5c-446e-b3fc-b3db719c6d55",
                                                "sense_id": "a4ddbc73-a3c3-3fb1-8555-ac2f82c0e6aa",
                                                "text": "„Im Schein der Handytaschenlampe stieg ich die schmale Treppe zum Speicher hinauf, die schließlich vor einer Leiter endete.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
