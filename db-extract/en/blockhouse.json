                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "блокга́уз",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "391ff3fe-58a6-3199-a49e-4dbc1d845d46",
                                        "entry_id": "96587c63-a125-3e57-b115-6e24bfa1ce71",
                                        "glosses": [
                                            "оборонительное сооружение со стенами и покрытием из дерева, бетона и т. п. с жилым помещением для гарнизона, предназначенное для ведения кругового ружейно-пулеметного, а иногда и артиллерийского огня"
                                        ],
                                        "tags": [],
