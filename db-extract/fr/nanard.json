                "senses": [
                    {
                        "sense_id": "6b6fb45e-ecef-3a25-b74b-48681b408e5b",
                        "entry_id": "433cddce-cc4e-3adb-b0ea-4db3c9ac476e",
                        "glosses": [
                            "Variante orthographique de nanar."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "7c5271d2-5f76-4cce-8fa5-6c6790dca7fc",
                                "sense_id": "6b6fb45e-ecef-3a25-b74b-48681b408e5b",
                                "text": "Le voisin vous déplie un journal dans le nez, la moindre turbulence vous expédie le verre sur les genoux, on éteint la cabine pour vous infliger un nanard sur l’écran !"
                            },
                            {
                                "example_id": "f261bf75-17e7-4958-97ae-475d24594995",
                                "sense_id": "6b6fb45e-ecef-3a25-b74b-48681b408e5b",
                                "text": "Mais on s'en fout, on passe à la caisse, on se marre, nos proches font semblant de nous trouver admirables dans ces nanards. En résumé, notre envie de réussir est aussi frénétique que celle de croquer la vie à pleines dents."
                            },
                            {
                                "example_id": "6c90c38d-1a49-43f5-9cf1-880497184f01",
                                "sense_id": "6b6fb45e-ecef-3a25-b74b-48681b408e5b",
                                "text": "Ce film musical nous baigne dans les années soixante-dix avec tout ce qu'il y a de plus kitch ; mais comme souvent, certains films comme celui-ci, qualifiés de « nanards » par les critiques, deviennent incontournables après leur sortie."
                            }
                        ]
                    }
