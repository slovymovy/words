                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Och, <w>przepraszam</w> najmocniej, nie chciałem cię potrącić.",
                            "target_lang_translations": {
                                "ru": "Ох, <w>простите</w> великодушно, я не хотел тебя толкнуть.",
                                "en": "Oh, I am so <w>sorry</w>, I didn't mean to bump into you.",
                                "nl": "Oh, mijn oprechte <w>excuses</w>, ik wilde je niet aanstoten.",
                                "de": "Oh, <w>entschuldigen Sie</w> bitte vielmals, ich wollte Sie nicht anstoßen.",
