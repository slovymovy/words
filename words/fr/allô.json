            "senses": [
                {
                    "sense_id": "e0c8a223-5758-3533-b8b8-b6c3f685ac02",
                    "sense_definition": "Formule rituelle employée pour engager ou rétablir une communication téléphonique.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Allô</w>, bonjour, est-ce que Thomas est disponible pour me parler ?"
                        },
                        {
                            "text": "Quand le téléphone a sonné, elle a répondu <w>allô</w> d'une voix endormie."
                        }
                    ],
                    "common_phrases": [
                        "dire allô"
                    ]
                },
                {
                    "sense_id": "b7f65047-3c10-3fde-96fe-86cb39efb134",
                    "sense_definition": "Salutation familière adressée à quelqu'un lors d'une rencontre en personne.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "salutation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En entrant dans le bureau, elle a lancé un chaleureux <w>allô</w> à ses collègues."
                        },
                        {
                            "text": "Dès qu'il m'a aperçu sur le trottoir, il m'a fait un signe amical en criant <w>allô</w>."
                        }
                    ],
                    "synonyms": [
                        "bonjour",
                        "salut"
                    ],
                    "antonyms": [
                        "au revoir"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "principalement au Québec"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ]
                },
                {
                    "sense_id": "80b3ed51-1fe0-32d9-adaf-fd55072cc89d",
                    "sense_definition": "Exclamation employée pour s'assurer que l'interlocuteur écoute ou pour solliciter son attention.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "interpellation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Allô</w>, tu m'écoutes ou tu es complètement perdu dans tes pensées ?"
                        },
                        {
                            "text": "La connexion était mauvaise et il répétait sans cesse <w>allô</w> pour savoir si j'étais là."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
