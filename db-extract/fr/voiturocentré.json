                        "sense_id": "7271f5d8-b3ea-3470-acd4-7dfdba819729",
                        "entry_id": "9fe35730-e6e9-39a9-9534-f9e0e9d6cfe9",
                        "glosses": [
                            "Pensé pour la voiture au détriment d'autre chose, telle que les autres modes de transport, les interactions sociales ou même de la finalité initiale du lieu."
                        ],
                        "tags": [
                            "Extrêmement rare"
                        ],
                        "examples": [
                            {
                                "example_id": "dd021098-f76b-4123-a9d4-923be637bed7",
                                "sense_id": "7271f5d8-b3ea-3470-acd4-7dfdba819729",
                                "text": "[…] où le développement immobilier s’est basé sur une accessibilité voiture faute de desserte efficace en transports en commun. Le site Reyers pourrait connaître le même sort ; d’ailleurs, aucune mesure de limitation du stationnement automobile n’est prise dans le projet de PAD : on se retrouverait dès lors dans un quartier « voiturocentré »."
                            },
                            {
                                "example_id": "08f94e8d-656b-48c0-97e8-3ee1a447cede",
                                "sense_id": "7271f5d8-b3ea-3470-acd4-7dfdba819729",
                                "text": "Ces parkings d'hypermarché sont tellement voiturocentré qu'on n'y a même pas prévu l'espace où le client laisse son caddie pour remplir son coffre."
                            }
                        ]
                    }
