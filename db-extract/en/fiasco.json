                    {
                        "translation_id": "0fda63bc-ea5f-4c36-bb6e-48bff4c3502b",
                        "source_entry_id": "9442e23b-fabd-3679-b95b-c4e34f9fa66b",
                        "source_sense_description": "ludicrous or humiliating situation",
                        "target_lang_word": "фиа́ско",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
