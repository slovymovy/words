                    },
                    {
                        "translation_id": "820965a2-651e-4376-8985-923189d32b5f",
                        "source_entry_id": "946207db-6bfc-3601-b095-1bb4eb25dfa6",
                        "source_sense_id": "0a11fda0-12ad-332e-910e-c1bd6162e2b5",
                        "target_lang_word": "lomo de cerdo",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "8850ca71-84f8-456f-a340-66e75ab437e2",
                        "source_entry_id": "946207db-6bfc-3601-b095-1bb4eb25dfa6",
                        "source_sense_id": "0a11fda0-12ad-332e-910e-c1bd6162e2b5",
                        "target_lang_word": "корейка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "корейка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a2e87b02-3692-3d55-9a4a-5ac187024994",
                                        "entry_id": "79d13036-54bd-3e61-b83d-21abe7febc76",
                                        "glosses": [
                                            "гастрон. часть свиной или телячьей туши, расположенная вдоль по обе стороны позвоночного столба; копчёный подсолённый продукт, приготовленный из такой части туши"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79995772-350e-4b50-9ce2-2790e7159527",
                                                "sense_id": "a2e87b02-3692-3d55-9a4a-5ac187024994",
                                                "text": "Самое любимое блюдо — яичница с колбасой, ветчиной или корейкой."
                                            },
                                            {
                                                "example_id": "a2b2af44-9641-46a9-872e-b21d2492608e",
                                                "sense_id": "a2e87b02-3692-3d55-9a4a-5ac187024994",
                                                "text": "На обратном пути пытался купить поесть и обрадовался, как дитя, двухфунтовому куску жирной корейки."
                                            },
                                            {
                                                "example_id": "3229254a-f741-4a08-974a-1903c4f83155",
                                                "sense_id": "a2e87b02-3692-3d55-9a4a-5ac187024994",
                                                "text": "Мяса нет никакого. Очень хочется колбасы. Когда Галка приедет с юга, пусть пришлёт немного копчёной колбасы или корейки."
                                            },
                                            {
                                                "example_id": "fd623d1e-eca7-493e-8ddf-25675ec3ed76",
                                                "sense_id": "a2e87b02-3692-3d55-9a4a-5ac187024994",
                                                "text": "Свинину лучше сохранять в виде копчёных окороков, кореек и грудинок."
                                            },
                                            {
                                                "example_id": "58b9c811-41b8-48a6-bd1a-6ed3367e826b",
                                                "sense_id": "a2e87b02-3692-3d55-9a4a-5ac187024994",
                                                "text": "Особой популярностью у одесситов пользуются копчёности фирмы: окорока, рулеты, беконы, грудинки, корейки, варёные ветчины, запечённые продукты из свинины, сырокопчёные шейки, окорока, бекон, балыки."
                                            },
                                            {
                                                "example_id": "7e03295c-2e3e-4e54-bc25-ee66ef331690",
                                                "sense_id": "a2e87b02-3692-3d55-9a4a-5ac187024994",
                                                "text": "Александр Николаевич, побывав в Елисеевском магазине, дома рассказал, что хотел купить кусочек корейки .."
                                            },
                                            {
                                                "example_id": "7ebff3c0-d19a-472a-9471-9db6dc7b8f21",
                                                "sense_id": "a2e87b02-3692-3d55-9a4a-5ac187024994",
                                                "text": "Он .. внимательно осмотрел витрину, поинтересовался .., что есть на кухне, расспросил в дверь поваров, из чего шашлык и не жирна ли корейка."
                                            },
                                            {
                                                "example_id": "a5b591f0-e061-4b84-8e2f-4638cf6e9981",
                                                "sense_id": "a2e87b02-3692-3d55-9a4a-5ac187024994",
                                                "text": ".. мы посидели ещё с моей мамой, накормившей нас необыкновенно вкусным в тот день гороховым супом с корейкой, за время нашего отсутствия сваренным ею .."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
