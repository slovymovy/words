                    {
                        "sense_id": "a6bff7eb-65d2-3b55-bc4e-1ddc9af1926f",
                        "entry_id": "67f49d59-0fc0-3e1b-9c0e-a5e8d1557037",
                        "glosses": [
                            "Sorte d’orgue portatif, piano uni à quelques registres d’orgue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26f5df43-7540-4c19-867d-cab1688b6cbf",
                                "sense_id": "a6bff7eb-65d2-3b55-bc4e-1ddc9af1926f",
                                "text": "Il est de fait que cet orchestrion est véritablement le premier instrument à anche libre répandu en Europe."
                            },
                            {
                                "example_id": "ec0a737d-c75c-405d-a768-b5c6fb74a574",
                                "sense_id": "a6bff7eb-65d2-3b55-bc4e-1ddc9af1926f",
                                "text": "Non loin des coucous les orchestrions résonnent.... c'est la Forêt-Noire qui fabrique tant de coucous et d'orchestrions."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cff82462-16ec-4d11-b041-78226343ad8e",
                        "source_entry_id": "67f49d59-0fc0-3e1b-9c0e-a5e8d1557037",
                        "source_sense_id": "a6bff7eb-65d2-3b55-bc4e-1ddc9af1926f",
                        "target_lang_word": "Orchestrion",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Orchestrion",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5e9cfe6f-3893-34dd-b11c-f37fb8709c30",
                                        "entry_id": "07380f4d-9061-3754-9f94-ee2dc93ac212",
                                        "glosses": [
                                            "mechanisches Musikinstrument"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0738e799-f816-45a0-b55c-f6e8bde625b5",
                                                "sense_id": "5e9cfe6f-3893-34dd-b11c-f37fb8709c30",
                                                "text": "„Das Orchestrion donnert zum dritten Mal den Marsch aus der Lustigen Witwe.“"
                                            },
                                            {
                                                "example_id": "b1aec754-ba7c-4da9-8ed1-9dc68332de4e",
                                                "sense_id": "5e9cfe6f-3893-34dd-b11c-f37fb8709c30",
                                                "text": "„Manchmal fällt aus einer Kneipe Lichtschein auf die Steine, über die er geht, ein Orchestrion lärmt mit Zimbeln und Schellen, ein Grammophon kreischt.“"
                                            },
                                            {
                                                "example_id": "c7225b95-ef75-4b1d-8a45-0a1d4b24357a",
                                                "sense_id": "5e9cfe6f-3893-34dd-b11c-f37fb8709c30",
                                                "text": "„Das Orchestrion macht ununterbrochen Krach.“"
                                            },
                                            {
                                                "example_id": "7d5b7a53-8168-4321-8cd0-fe63c0c4a18a",
                                                "sense_id": "5e9cfe6f-3893-34dd-b11c-f37fb8709c30",
                                                "text": "„Und sofort beginnt ein Orchestrion zu spielen.“"
                                            },
                                            {
                                                "example_id": "23197146-43f2-46d0-9f60-087d027253e0",
                                                "sense_id": "5e9cfe6f-3893-34dd-b11c-f37fb8709c30",
                                                "text": "„Von Karl Valentin, dem Klassiker des Münchner (und des süddeutschen) Witzes überhaupt wissen wir, daß er einstmals als Charles Frey mit einem Orchestrion, das er sich aus zwölf verschiedenen Instrumenten zusammengebaut hatte, von Stadt zu Stadt – und von Land zu Land zog.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
