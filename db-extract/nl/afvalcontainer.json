                "senses": [
                    {
                        "sense_id": "c40664cd-b001-3e6a-b657-ed1cf07de9f3",
                        "entry_id": "92724ea9-b745-36da-944e-94a3b47ac565",
                        "glosses": [
                            "verrijdbare bak waarin men afval kan doen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e8384d1-a61f-44c8-ac15-f5863f4e475e",
                                "sense_id": "c40664cd-b001-3e6a-b657-ed1cf07de9f3",
                                "text": "Zelfs de toneelstukken van Albert Egberts niet, want die had hij in het Huis van Bewaring aan de Havenstraat laten liggen, en waren nu misschien wel een afvalcontainer in geveegd."
                            },
                            {
                                "example_id": "0415ba90-4cf1-4a4a-beaa-32120033e852",
                                "sense_id": "c40664cd-b001-3e6a-b657-ed1cf07de9f3",
                                "text": "Uit het onderzoek blijkt ook dat 58 procent van de Nederlanders wel meer zou willen doen voor anderen, vooral als het gaat om lichtere vormen van hulpverlening (vuilnisbak buiten zetten, planten of huisdieren verzorgen). Vrouwen willen best meer eenzame mensen gezelschap houden, mannen denken vooral aan helpen met de administratie, met de computer of met de afvalcontainer buiten zetten."
                            }
                        ]
                    },
                    {
                        "sense_id": "ad0dc023-557e-3c5c-a3d5-c0df0edc6259",
                        "entry_id": "92724ea9-b745-36da-944e-94a3b47ac565",
                        "glosses": [
                            "grotere vaste bak waarin het huisvuil van meerdere huishoudens wordt verzameld"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "563b81f4-7ddd-4963-84fc-58840781d781",
                                "sense_id": "ad0dc023-557e-3c5c-a3d5-c0df0edc6259",
                                "text": "De rechtbank in Amsterdam heeft donderdag een 31-jarige vrouw wegens poging tot doodslag vier jaar gevangenisstraf opgelegd. Volgens de rechtbank staat vast dat Todisoa R. in 2014 haar baby van een maand oud achterliet in een ondergrondse afvalcontainer in Amsterdam-Slotermeer. De straf is gelijk aan de eis van de officier van justitie twee weken geleden."
                            }
                        ]
                    }
