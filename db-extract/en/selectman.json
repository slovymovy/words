                        "glosses": [
                            "Any of a board of municipal officers elected to manage some New England towns."
                        ],
                        "tags": [
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "260d4b4d-cfb3-4f81-bfc6-30c9010757bd",
                                "sense_id": "5f6c7eca-c0d3-353b-aa86-81a43c0e348d",
                                "text": "Every selectman in the state of New Hampshire seems to be positive that growth in a town will lower taxes, but if you plot growth rates against tax rates, you find a scatter as random as the stars in a New Hampshire winter sky."
                            },
                            {
                                "example_id": "7ab6d36e-db89-4fa8-8c6d-f9ee005d691c",
                                "sense_id": "5f6c7eca-c0d3-353b-aa86-81a43c0e348d",
                                "text": "The New England […] town had its own government: a group of selectmen elected by the adult male members of the church. The selectmen acted as a plural executive, while the town’s eligible voters gathered for town meetings and functioned as a miniature parliament."
                            }
                        ]
                    }
