                "senses": [
                    {
                        "sense_id": "3abb6f5f-98f7-3296-b628-eb21dee99643",
                        "entry_id": "2c87e801-f163-3106-8254-a88ebaae3032",
                        "glosses": [
                            "Corrompre, pratiquer le pot-de-vin."
                        ],
                        "tags": [
                            "Cameroun"
                        ],
                        "examples": [
                            {
                                "example_id": "3c1b4cb8-43b7-466a-8c3c-99d9718fd5ab",
                                "sense_id": "3abb6f5f-98f7-3296-b628-eb21dee99643",
                                "text": "Une fois k’il a utilisé tous ces gens pour parvenir au pouvoir, il s’est dépéché de ne « gombotiser » grassement ke ceux ki sont de sa région."
                            },
                            {
                                "example_id": "5261f550-4829-4002-8690-0ad63a25aa7b",
                                "sense_id": "3abb6f5f-98f7-3296-b628-eb21dee99643",
                                "text": "je suis un homme intègre je n'ai pas besoin, de \"gombotiser\" mes voisines pour m'attirer leurs faveurs."
                            },
                            {
                                "example_id": "414361f5-cb76-4ef1-87c1-cf7b500bcf94",
                                "sense_id": "3abb6f5f-98f7-3296-b628-eb21dee99643",
                                "text": "Le fait de « bien parler » consistait à « gombotiser »."
                            }
                        ]
                    }
