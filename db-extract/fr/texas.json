        "fr-extract.jsonl": [
            {
                "entry_id": "021f477c-e029-3b13-99af-8e46a2ec5851",
                "word": "Texas",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "45207faa-9918-32bb-83f8-b7bab55a9662",
                        "entry_id": "021f477c-e029-3b13-99af-8e46a2ec5851",
                        "glosses": [
                            "Vaste État des États-Unis (code postal TX), bordé par la Louisiane à l’est, l’Arkansas au nord-est, l’Oklahoma au nord, le Nouveau-Mexique à l’ouest, le Mexique (Chihuahua, Coahuila, Nuevo León et Tamaulipas) et du golfe du Mexique au sud, et dont la capitale est Austin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "947683ea-c04b-4712-b53d-8125d0a4354c",
                                "sense_id": "45207faa-9918-32bb-83f8-b7bab55a9662",
                                "text": "Dans la seconde moitié du XXᵉ siècle, les Américains avaient détourné le cours du fleuve Colorado ; ce dernier ne se déversait plus dans la mer de Cortez, mais servait à irriguer les États du Nouveau-Mexique et du Texas. Côté États-Unis, on voyait des champs verdoyants ; côté Mexique, tout était aride."
                            },
                            {
                                "example_id": "852ff8ac-6db8-4f86-a874-2f1952896397",
                                "sense_id": "45207faa-9918-32bb-83f8-b7bab55a9662",
                                "text": "L’expérience consista à faire disparaître un dé à jouer en acajou dans une salle d’expérience de l’Université du Texas afin qu’il réapparaisse dans un laboratoire de GeoTricks, quelques kilomètres plus loin."
                            },
                            {
                                "example_id": "6285ada5-cafc-4efe-8b5a-aebc37818a45",
                                "sense_id": "45207faa-9918-32bb-83f8-b7bab55a9662",
                                "text": "La Francilienne de 28 ans, installée au Texas, assume l’étiquette de favorite, qu’elle doit aussi à son incontestable rang de nᵒ 1 tricolore."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "383a30f0-be13-47ac-8b25-4c129d106d76",
                        "source_entry_id": "021f477c-e029-3b13-99af-8e46a2ec5851",
                        "source_sense_id": "45207faa-9918-32bb-83f8-b7bab55a9662",
                        "target_lang_word": "Texas",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Texas",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "477bc9ca-f1d2-36d2-898b-bc70f4f81598",
                                        "entry_id": "51aa689e-1e97-32ed-8b81-7c5e5c606486",
                                        "glosses": [
                                            "Bundesstaat im Südwesten der USA"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef65afc2-3a8f-4e19-b5d0-0d5a32b87ab9",
                                                "sense_id": "477bc9ca-f1d2-36d2-898b-bc70f4f81598",
                                                "text": "Ich komme aus Texas."
                                            },
                                            {
                                                "example_id": "46e32212-8dcc-4d35-ae48-44b56f3e9fb3",
                                                "sense_id": "477bc9ca-f1d2-36d2-898b-bc70f4f81598",
                                                "text": "„In Texas waren nach wochenlanger Dürre von Seen und Flüssen nur rissige Erdkrusten übrig, einigen Gemeinden ging das Trinkwasser aus.“"
                                            },
                                            {
                                                "example_id": "a5578afb-a0e4-40b5-b8bb-82e8d3bbebbe",
                                                "sense_id": "477bc9ca-f1d2-36d2-898b-bc70f4f81598",
                                                "text": "„Tausende Migranten versuchen, jeden Monat unentdeckt in die USA zu gelangen. Texas’ Gouverneur will sie mit einer mehr als 300 Meter langen Mauer aus Bojen an der Überquerung des Rio Grande hindern.“"
                                            },
                                            {
                                                "example_id": "f76e883f-0777-4cb5-86df-e0b3d36bc747",
                                                "sense_id": "477bc9ca-f1d2-36d2-898b-bc70f4f81598",
                                                "text": "„Allen Amerikanern, nicht nur den Texanern, ist schließlich sonnenklar, dass die texanische Mentalität grundsätzlich anders ist als im Rest des Landes, und außerdem ist Texas ja wohl reich genug, um ohne die anderen 49 Bundesstaaten auszukommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
