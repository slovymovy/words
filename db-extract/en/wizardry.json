                    {
                        "translation_id": "aa9992e3-70bf-4a7c-afa6-97bedf3d1375",
                        "source_entry_id": "f2ec45af-6bdf-380f-afac-aa501c2a380e",
                        "source_sense_id": "d39f5482-b86d-32de-9ab7-a79448969f57",
                        "source_sense_description": "sdÜ",
                        "target_lang_word": "Hexerei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hexerei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0c708a39-1caf-3853-a19e-089e4a2698ef",
                                        "entry_id": "871ba13b-2a21-31e8-ad8a-8b9cf0addd6f",
                                        "glosses": [
                                            "Handlung einer Person, der unterstellt wird, über magische Kräfte zu verfügen und diese in der Regel zum Nachteil anderer einzusetzen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b476363-468a-4bff-8d72-dff40a9765c7",
                                                "sense_id": "0c708a39-1caf-3853-a19e-089e4a2698ef",
                                                "text": "„Es gibt durchaus mehrere Theorien über den Ursprung des Hexenwahns und der daraus erwachsenen Verfolgung von Frauen, die der Hexerei beschuldigt worden sind.“"
                                            },
                                            {
                                                "example_id": "bc64f4bc-56d3-4c10-989f-131d1d9aff85",
                                                "sense_id": "0c708a39-1caf-3853-a19e-089e4a2698ef",
                                                "text": "„Denn dieses Ausnahmeverfahren versagte jeder wegen Hexerei angeklagten Person das Recht auf eine ordnungsgemäße Verteidigung, die sonst allen anderen Angeklagten im ordentlichen Gerichtsverfahren zustand.“"
                                            },
                                            {
                                                "example_id": "f9f2511c-4c06-46dd-b114-5ccef688599d",
                                                "sense_id": "0c708a39-1caf-3853-a19e-089e4a2698ef",
                                                "text": "„Der Roszkower Rabbi hatte erklärt, es sei verboten, bei so etwas mitzumachen, weil das Hexerei sei.“"
                                            },
                                            {
                                                "example_id": "633ad1eb-776f-4214-ba99-860eaeb4ceb4",
                                                "sense_id": "0c708a39-1caf-3853-a19e-089e4a2698ef",
                                                "text": "„Er soll die letzten der Hexerei verdächtigen Frauen aus dem Kerker befreit haben, bevor es zu einem Prozess kam.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "695cec1e-60f2-3c85-86b6-19e071f8b999",
                                        "entry_id": "871ba13b-2a21-31e8-ad8a-8b9cf0addd6f",
                                        "glosses": [
                                            "unerwartet/ungewöhnlich erfolgreiche Handlung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b40a610-0e9a-40b8-9a51-07bb4d20719b",
                                                "sense_id": "695cec1e-60f2-3c85-86b6-19e071f8b999",
                                                "text": "Es grenzt an Hexerei, dass das Fest trotz der geringen Vorbereitungszeit noch organisiert werden konnte."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
