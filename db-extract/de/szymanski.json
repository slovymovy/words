                ],
                "senses": [
                    {
                        "sense_id": "61dcbbba-b3ff-38f8-a059-850a2ef8dd9b",
                        "entry_id": "f95ba9f5-e774-3532-bb22-8cc2fc0ff66d",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c959b6e-b97a-46fe-b0d5-c8ef14d9c660",
                                "sense_id": "61dcbbba-b3ff-38f8-a059-850a2ef8dd9b",
                                "text": "Frau Szymanski ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "40cd03af-a1e4-4b6d-a099-f8a0201700dd",
                                "sense_id": "61dcbbba-b3ff-38f8-a059-850a2ef8dd9b",
                                "text": "Herr Szymanski wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "7e9a9aa1-1d1a-45be-bb10-d25fea7a481b",
                                "sense_id": "61dcbbba-b3ff-38f8-a059-850a2ef8dd9b",
                                "text": "Die Szymanskis fahren heute nach Graz."
                            },
                            {
                                "example_id": "be3c3642-5d07-47c8-8f44-1852dba1e3b5",
                                "sense_id": "61dcbbba-b3ff-38f8-a059-850a2ef8dd9b",
                                "text": "Der Szymanski trägt nie die Schals, die die Szymanski ihm strickt."
                            },
                            {
                                "example_id": "b5c821bf-e3a9-4f7b-9832-2960c01c9722",
                                "sense_id": "61dcbbba-b3ff-38f8-a059-850a2ef8dd9b",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Szymanski kommt, geht der Herr Szymanski.“"
                            },
                            {
                                "example_id": "ac166c3e-a1db-4047-9763-a5a6fa9d856f",
                                "sense_id": "61dcbbba-b3ff-38f8-a059-850a2ef8dd9b",
                                "text": "Szymanski kommt und geht."
                            },
                            {
                                "example_id": "b0d41d02-15b4-49c3-be21-b4f65fc58d3b",
                                "sense_id": "61dcbbba-b3ff-38f8-a059-850a2ef8dd9b",
                                "text": "Szymanskis kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
