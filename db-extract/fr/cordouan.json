                "senses": [
                    {
                        "sense_id": "3bb8c350-68f7-3f8c-b39f-ca30600b9533",
                        "entry_id": "110c65b9-50c9-3d22-b394-812a072ab98c",
                        "glosses": [
                            "Relatif à la ville de Cordoue, en Espagne, ou à ses habitants."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e0fd8ff-7500-4a4a-a1d4-46f63636afef",
                                "sense_id": "3bb8c350-68f7-3f8c-b39f-ca30600b9533",
                                "text": "À droite de la cheminée, la muraille, tapissée de cuir cordouan d’un brun très-foncé, montrait une tache blanche qui était un bouton d’ivoire."
                            },
                            {
                                "example_id": "c452be67-3545-423e-aeb2-42de8a1b72bd",
                                "sense_id": "3bb8c350-68f7-3f8c-b39f-ca30600b9533",
                                "text": "Il s’asseyait dans un grand fauteuil de cuir cordouan, devant une table chargée d’une lourde écritoire d’argent massif, pourvue de poudres de toutes les couleurs et de plumes d’oie qu’il taillait avec soin."
                            }
                        ]
                    }
                ],
