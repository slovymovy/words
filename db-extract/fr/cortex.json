                                        "sense_id": "6adcd00c-1dfa-397a-82ff-edc0e44c8d67",
                                        "entry_id": "8c5efad1-d5c2-3a0b-8700-22cb808046f9",
                                        "glosses": [
                                            "The tissue of a stem or root that lies inward from the epidermis, but exterior to the vascular tissue."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
