                                        "sense_id": "cfda809d-68b1-312e-9a6f-3151a70b0250",
                                        "entry_id": "b61a434f-a779-315a-a546-02d69f57fa07",
                                        "glosses": [
                                            "A former administrative region and historical province of France, since 2016 part of the region of Auvergne-Rhône-Alpes."
                                        ],
                                        "tags": [],
