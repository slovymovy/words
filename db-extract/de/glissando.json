                ],
                "senses": [
                    {
                        "sense_id": "18fff002-6b99-37bd-81cd-82007cd090a7",
                        "entry_id": "ff72b789-efbf-3b6e-b020-2bff06dcae91",
                        "glosses": [
                            "ein Spieleffekt, bei Streichinstrumenten hervorgerufen durch Gleiten des Fingers auf den Saiten, beim Klavier durch Streichen der Tasten mit dem Fingernagel, der eine kontinuierlich gleitende Veränderung der Tonhöhe zur Folge hat. Im Unterschied zum Portamento, das dem Bereich des Vortrags angehört, ist das Glissando immer ein notierter, fester Bestandteil des jeweiligen Musikwerkes"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "6d676fa8-2677-4f1d-91d2-109b81dbce73",
                                "sense_id": "18fff002-6b99-37bd-81cd-82007cd090a7",
                                "text": "„Töne können, ohne ihre Intervallbildungsfähigkeit einzubüßen, durch Gleitbewegungen (Glissando, Portamento) miteinander verbunden … werden.“"
                            },
                            {
                                "example_id": "c932818d-18fa-4d85-8c9d-c6b749267fce",
                                "sense_id": "18fff002-6b99-37bd-81cd-82007cd090a7",
                                "text": "„Während Strawinsky die Violine oft wie ein Schlaginstrument behandelt, ist Bartók besonders einfallsreich im Erfinden neuer Klänge … oder neuartiger Behandlung alter Techniken, unter ihnen das Glissando in melodisch-struktureller Bedeutung …“"
                            },
                            {
                                "example_id": "d660179d-fbae-42c9-9e81-8b2ae52df95d",
                                "sense_id": "18fff002-6b99-37bd-81cd-82007cd090a7",
                                "text": "„Ohne es zu merken, war ich aufgestanden und lauschte den glasfeinen Tönen und perlenden Glissandi eines Cembalos oder Spinetts, die wie ein kühler, belebender Lufthauch durch das stickige Treppenhaus des Wehrturms strichen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
