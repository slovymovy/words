                "senses": [
                    {
                        "sense_id": "b2b4d6ca-826b-38db-a178-605b478a7a4f",
                        "entry_id": "30f48394-24d5-3cbe-b15d-220fa5de2b23",
                        "glosses": [
                            "Unternehmen, das lüftungstechnische Anlagen plant und baut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c44d199a-c3bc-4ca4-aec8-82c39c084939",
                                "sense_id": "b2b4d6ca-826b-38db-a178-605b478a7a4f",
                                "text": "„Die Firma Hoffmann aus Damme zieht in den Niedersachsenpark. Der Lüftungsanlagenbauer für Tierställe will das neu entstehende Gebäude Ende des Jahres beziehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "85028b54-c096-3bcc-8e9e-087c2cf8a28d",
                        "entry_id": "30f48394-24d5-3cbe-b15d-220fa5de2b23",
                        "glosses": [
                            "(männliche^☆) Person, die lüftungstechnische Anlagen baut (Berufsbezeichnung)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e5255eb-0fb5-4b9a-970c-2ad388c9da25",
                                "sense_id": "85028b54-c096-3bcc-8e9e-087c2cf8a28d",
                                "text": "„Die Lüftungsanlagenbauer/innen stellen manche Teile der Anlage in der Werkstatt anhand von Montageplänen selber her.“"
                            },
                            {
                                "example_id": "13364ef4-322f-498c-a38d-1453bf6dd678",
                                "sense_id": "85028b54-c096-3bcc-8e9e-087c2cf8a28d",
                                "text": "„Lüftungsanlagenbauer wissen auch Bescheid über Anlagen zur Luftbefeuchtung oder zur Kühlung, zur Wärmerückgewinnung oder zur Entstaubung.“"
                            },
                            {
                                "example_id": "d4087459-36c7-473e-9f91-cf33236f82bc",
                                "sense_id": "85028b54-c096-3bcc-8e9e-087c2cf8a28d",
                                "text": "„Lüftungsanlagenbauer und Lüftungsanlagenbauerinnen befassen sich mit der Herstellung und Montage von Lüftungs- und Klimaanlagen.“"
                            },
                            {
                                "example_id": "59fc6ed6-1d46-4219-b2ef-d70a8c2562c3",
                                "sense_id": "85028b54-c096-3bcc-8e9e-087c2cf8a28d",
                                "text": "„Der Lüftungsanlagenbauer montiert im Gebäude die Luftaufbereitungsgeräte, Armaturen und Regelapparate und baut die zugehörigen Kanäle und Rohre zusammen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
