                    "common_phrases": [
                        "get an E"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неудовлетворительная оценка в школе, обычно ниже D.",
                        "zh": "学校评级中的不及格成绩，通常低于D等级；戊等。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оценка E",
                                "target_lang_sense_clarification": "низкий балл в западной системе"
                            },
                            {
                                "target_lang_word": "неуд",
                                "target_lang_sense_clarification": "аналог в русской системе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "E等",
                                "target_lang_sense_clarification": "学校评级"
                            },
                            {
                                "target_lang_word": "戊",
                                "target_lang_sense_clarification": "第五等，相当于E等不及格"
                            }
                        ]
                    }
                },
                {
