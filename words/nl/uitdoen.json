                {
                    "sense_id": "e0578a81-8d43-3584-9284-f88dbd7b5077",
                    "sense_definition": "Een apparaat, lamp of vuur uitschakelen of doven.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "uitschakelen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wil je het licht <w>uitdoen</w> als je de kamer verlaat?",
                            "target_lang_translations": {
                                "en": "Would you mind <w>turning off</w> the light when you leave the room?",
                                "ru": "Не мог бы ты <w>выключить</w> свет, когда будешь выходить из комнаты?",
                                "pl": "Czy możesz <w>zgasić</w> światło, kiedy wychodzisz z pokoju?",
                                "de": "Möchtest du das Licht <w>ausmachen</w>, wenn du das Zimmer verlässt?",
                                "fr": "Veux-tu <w>éteindre</w> la lumière quand tu quittes la pièce ?",
                                "it": "Vuoi <w>spegnere</w> la luce quando esci dalla stanza?",
                                "cs": "Mohl bys <w>zhasnout</w> světlo, až budeš odcházet z pokoje?",
                                "tr": "Odadan çıkarken ışığı <w>kapatır</w> mısın?",
                                "es": "¿Quieres <w>apagar</w> la luz cuando salgas de la habitación?"
                            }
                        },
                        {
                            "text": "Hij <w>deed</w> de televisie <w>uit</w> en ging meteen naar bed.",
                            "target_lang_translations": {
                                "en": "He <w>turned off</w> the television and went straight to bed.",
                                "ru": "Он <w>выключил</w> телевизор и сразу лег спать.",
                                "pl": "<w>Wyłączył</w> telewizor i od razu poszedł spać.",
                                "de": "Er <w>schaltete</w> den Fernseher <w>aus</w> und ging sofort ins Bett.",
                                "fr": "Il a <w>éteint</w> la télévision et est allé directement se coucher.",
                                "it": "<w>Spense</w> la televisione e andò subito a letto.",
                                "cs": "<w>Vypnul</w> televizi a šel rovnou spát.",
                                "tr": "Televizyonu <w>kapattı</w> ve hemen yatmaya gitti.",
                                "es": "<w>Apagó</w> la televisión y se fue directo a la cama."
                            }
                        }
                    ],
