                        "sense_id": "5b207545-5466-354e-ac8e-ff0c7f808ebd",
                        "entry_id": "259faeb7-3141-34da-804e-a141d0063302",
                        "glosses": [
                            "(längliches) Weißbrot (mit Rosinen)"
                        ],
                        "tags": [
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "b13b50bb-0e38-4434-a7b5-43d50e04afc1",
                                "sense_id": "5b207545-5466-354e-ac8e-ff0c7f808ebd",
                                "text": "Heute essen wir mal Stuten zum Kaffee."
                            },
                            {
                                "example_id": "0b52250c-f49b-48d2-a1f2-334c42f717c7",
                                "sense_id": "5b207545-5466-354e-ac8e-ff0c7f808ebd",
                                "text": "Kommt'n Hengst in'n Bäckerladen: „Guten Tach, haben Sie Stuten?“"
                            },
                            {
                                "example_id": "67bdab57-aca1-47d4-8d26-0153c3cde681",
                                "sense_id": "5b207545-5466-354e-ac8e-ff0c7f808ebd",
                                "text": "„Während der Abfahrt werfe ich diese Stuten dann unter die Kinder.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
