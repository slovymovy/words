                                "target_senses": [
                                    {
                                        "sense_id": "bfabc0f7-b130-3ca9-8887-7e3d774bdb04",
                                        "entry_id": "2d8fe8c9-84ca-3d07-9e9b-081e65b67b01",
                                        "glosses": [
                                            "A horse used as a pack animal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04401d04-29f8-4285-a371-b74344b8e327",
                                                "sense_id": "bfabc0f7-b130-3ca9-8887-7e3d774bdb04",
                                                "text": "Finally they put him on one of De Soto's packhorses, but even on a packhorse his feet hung down to within a few inches of the ground."
                                            },
                                            {
                                                "example_id": "1ac0f6e3-dd1e-4672-844e-f8c0cc237bb0",
                                                "sense_id": "bfabc0f7-b130-3ca9-8887-7e3d774bdb04",
                                                "text": "Procter had a handsome half-breed girl with him and two splendid elk heads and meat on his packhorses that he was taking to Fort Lincoln for sale."
                                            },
                                            {
                                                "example_id": "488f57d5-f1b1-4228-9808-24bf8fb36d81",
                                                "sense_id": "bfabc0f7-b130-3ca9-8887-7e3d774bdb04",
                                                "text": "While I was destroying my parka, the packhorse that Bob had been leading laid down. So now all our supplies were supine along with the napping packhorse. Looking upon a reclining packhorse while facing a wind-driven rain, wearing a tattered rain parka, with lightning flashing every fifteen seconds followed by thunder so loud my clothes shuddered was not how I had expected the afternoon to unfold. Each time we got the packhorse to his feet he would promptly lie down again."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f48fcdfe-860b-4e27-bb33-c9d549f5f16d",
                        "source_entry_id": "fe86d4c8-194d-3142-95cc-a665e76b673d",
                        "source_sense_id": "3b75cc9c-4e64-36d2-99a5-1a492d7cfb75",
                        "source_sense_description": "übertragen: Person, der schwere Lasten aufgebürdet werden",
                        "target_lang_word": "baudet",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "baudet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "af6755fd-09db-387d-91c8-4f434725edea",
                                        "entry_id": "f33bc2af-b9b9-37f6-b28c-ca6c0df67e57",
                                        "glosses": [
                                            "Nom commun de l’âne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33fd62a4-c6ec-4a41-ba13-1047b729f3a8",
                                                "sense_id": "af6755fd-09db-387d-91c8-4f434725edea",
                                                "text": "La nécessité des guenilles, des cadenettes et de la moustache aux talons n'est certainement pas démontrée d'une manière très-rigoureuse; mais l'éleveur de mules repousserait le baudet qui ne les porterait pas."
                                            },
                                            {
                                                "example_id": "2e9b51a9-9e34-4d3c-a303-334d5540aaaa",
                                                "sense_id": "af6755fd-09db-387d-91c8-4f434725edea",
                                                "text": "Être chargé comme un baudet, être excessivement chargé."
                                            },
                                            {
                                                "example_id": "c9f05342-dd73-45f2-a654-eb6011356c7c",
                                                "sense_id": "af6755fd-09db-387d-91c8-4f434725edea",
                                                "text": "Maraîchères, elles n’ont pour amener leurs lourds paniers de choux-fleurs et leurs sacs d’artichauts, qu’un petit baudet de louage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52b2e3d3-69bb-3135-a76b-e89440b07da4",
                                        "entry_id": "f33bc2af-b9b9-37f6-b28c-ca6c0df67e57",
