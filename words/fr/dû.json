    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ee96c060-f6e4-38a2-b86c-0357a8f7dc95",
                    "sense_definition": "Participe passé masculin singulier de <w>devoir</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "obligation_passée",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a <w>dû</w> rentrer chez elle à pied après la panne du bus.",
                            "target_lang_translations": {
                                "en": "She <w>had</w> to walk home on foot after the bus broke down.",
                                "ru": "Ей <w>пришлось</w> вернуться домой пешком после поломки автобуса.",
                                "de": "Sie <w>musste</w> nach der Panne des Busses zu Fuß nach Hause gehen.",
                                "es": "<w>Tuvo</w> que volver a casa a pie después de la avería del autobús.",
                                "zh": "公交车抛锚后，她<w>不得不</w>步行回家。"
                            }
                        },
                        {
                            "text": "Tu aurais <w>dû</w> me prévenir plus tôt de ton absence.",
                            "target_lang_translations": {
                                "en": "You <w>should</w> have warned me sooner about your absence.",
                                "ru": "Тебе <w>следовало</w> раньше предупредить меня о своём отсутствии.",
                                "de": "Du hättest mir früher von deiner Abwesenheit Bescheid sagen <w>sollen</w>.",
                                "es": "<w>Deberías</w> haberme avisado antes de tu ausencia.",
                                "zh": "你<w>应该</w>早点跟我说你要缺席。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Masculine singular past participle of devoir, used with an infinitive to express past obligation or necessity.",
                        "ru": "Причастие прошедшего времени мужского рода: выражает прошедшую необходимость или долг вместе с инфинитивом.",
                        "de": "Partizip Perfekt von „devoir“, das zusammen mit einem Infinitiv eine vergangene Notwendigkeit oder Pflicht ausdrückt.",
                        "es": "Participio pasado de deber, que se usa con infinitivo para expresar una obligación o necesidad pasada.",
                        "zh": "与不定式连用，表示过去应当做某事或不得不做某事。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "owe",
                                "target_lang_sense_clarification": "money or favour owed"
                            },
                            {
                                "target_lang_word": "must",
                                "target_lang_sense_clarification": "obligation or necessity, modal"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "должен",
                                "target_lang_sense_clarification": "модальный, с инфинитивом"
                            },
                            {
                                "target_lang_word": "обязан",
                                "target_lang_sense_clarification": "обязанность по закону или правилам"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "müssen",
                                "target_lang_sense_clarification": "Modalverb, Notwendigkeit in der Vergangenheit"
                            },
                            {
                                "target_lang_word": "sollen",
                                "target_lang_sense_clarification": "Pflicht oder Rat, rückblickend"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "deber",
                                "target_lang_sense_clarification": "obligación pasada, seguido de infinitivo"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "不得不",
                                "target_lang_sense_clarification": "表示过去的被迫"
                            },
                            {
                                "target_lang_word": "应该",
                                "target_lang_sense_clarification": "表示过去本应如此"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "fe3794a1-3f34-3cf8-8817-2258ffa12972",
                    "sense_definition": "Causé par quelque chose, qui a pour origine ou motif un facteur déterminé.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "causalité",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le retard du train était <w>dû</w> à un incident technique sur la voie.",
                            "target_lang_translations": {
                                "en": "The train's delay was <w>due</w> to a technical incident on the track.",
                                "ru": "Задержка поезда была <w>вызвана</w> технической поломкой на путях.",
                                "de": "Die Verspätung des Zuges war auf einen technischen Zwischenfall auf der Strecke <w>zurückzuführen</w>.",
                                "es": "El retraso del tren fue <w>debido</w> a un incidente técnico en la vía.",
                                "zh": "火车晚点是线路上的一起技术故障<w>引起的</w>。"
                            }
                        },
                        {
                            "text": "Cet échec cuisant est <w>dû</w> à un manque évident d'organisation.",
                            "target_lang_translations": {
                                "en": "This crushing failure is <w>due</w> to an obvious lack of organization.",
                                "ru": "Этот громкий провал <w>обусловлен</w> явной нехваткой организованности.",
                                "de": "Dieser bittere Misserfolg ist auf einen offensichtlichen Mangel an Organisation <w>zurückzuführen</w>.",
                                "es": "Este rotundo fracaso es <w>debido</w> a una clara falta de organización.",
                                "zh": "这次惨败是明显缺乏组织<w>造成的</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "attribuable",
                        "causé",
                        "imputable"
                    ],
                    "common_phrases": [
                        "être dû à"
                    ],
                    "target_lang_definitions": {
                        "en": "Caused by something, or having a particular origin or reason.",
                        "ru": "Вызванный какой-либо причиной; имеющий определённый источник или основание.",
                        "de": "Durch etwas verursacht oder auf einen bestimmten Grund zurückzuführen.",
                        "es": "Causado por algo, o que tiene un origen o motivo concreto.",
                        "zh": "由某种原因引起的，有明确的起因或来源。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "due",
                                "target_lang_sense_clarification": "caused by; followed by 'to'"
                            },
                            {
                                "target_lang_word": "owing",
                                "target_lang_sense_clarification": "as in 'owing to'"
                            },
                            {
                                "target_lang_word": "attributable",
                                "target_lang_sense_clarification": "formal; traced to a source"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "вызванный",
                                "target_lang_sense_clarification": "причина, с предлогом «из-за»"
                            },
                            {
                                "target_lang_word": "обусловленный",
                                "target_lang_sense_clarification": "официальный стиль, причинная связь"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "bedingt",
                                "target_lang_sense_clarification": "mit „durch“, Ursache angebend"
                            },
                            {
                                "target_lang_word": "zurückzuführen",
                                "target_lang_sense_clarification": "formell, mit „auf“"
                            },
                            {
                                "target_lang_word": "verursacht",
                                "target_lang_sense_clarification": "hervorgerufen durch ein Ereignis"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "debido",
                                "target_lang_sense_clarification": "causa, seguido de «a»"
                            },
                            {
                                "target_lang_word": "atribuible",
                                "target_lang_sense_clarification": "uso formal, origen identificado"
                            },
                            {
                                "target_lang_word": "causado",
                                "target_lang_sense_clarification": "provocado por un hecho concreto"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "引起的",
                                "target_lang_sense_clarification": "由某事物导致的结果"
                            },
                            {
                                "target_lang_word": "造成的",
                                "target_lang_sense_clarification": "多指不良后果"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5fcbfba4-1972-3f02-9df1-b0da58279b29",
                    "sense_definition": "Qui constitue une dette financière ou matérielle devant être remboursée.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "dette",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le montant <w>dû</w> devra être réglé avant la fin du mois en cours.",
                            "target_lang_translations": {
                                "en": "The amount <w>due</w> must be settled before the end of the current month.",
                                "ru": "<w>Причитающаяся</w> сумма должна быть оплачена до конца текущего месяца.",
                                "de": "Der <w>ausstehende</w> Betrag muss bis zum Ende des laufenden Monats beglichen werden.",
                                "es": "El importe <w>pendiente</w> deberá saldarse antes de que acabe el mes en curso.",
                                "zh": "<w>应付的</w>金额须在本月底前结清。"
                            }
                        },
                        {
                            "text": "Elle a finalement remboursé la somme <w>due</w> à son associé.",
                            "target_lang_translations": {
                                "en": "She finally repaid the sum <w>due</w> to her business partner.",
                                "ru": "Наконец она вернула компаньону <w>причитающуюся</w> ему сумму.",
                                "de": "Schließlich hat sie die <w>geschuldete</w> Summe ihrem Geschäftspartner zurückgezahlt.",
                                "es": "Finalmente reembolsó la suma <w>debida</w> a su socio comercial.",
                                "zh": "她终于把<w>应付的</w>款项还给了合伙人。"
                            }
                        }
                    ],
                    "synonyms": [
                        "exigible",
                        "impayé"
                    ],
                    "antonyms": [
                        "acquitté",
                        "payé"
                    ],
                    "common_phrases": [
                        "montant dû",
                        "somme due"
                    ],
                    "target_lang_definitions": {
                        "en": "Owed as a financial or material debt that must be repaid.",
                        "ru": "Представляющий собой денежный или материальный долг, который нужно вернуть.",
                        "de": "Als Geld- oder Sachschuld noch zurückzuzahlen.",
                        "es": "Que constituye una deuda de dinero o de bienes que hay que devolver.",
                        "zh": "指尚未偿还、需要支付的金钱或财物。"
                    },
                    "translations": {
