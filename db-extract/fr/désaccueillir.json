                "senses": [
                    {
                        "sense_id": "d4001834-e0a5-3146-a41c-b7dd098b090e",
                        "entry_id": "c91db2c3-2f03-3104-af6a-173c4ee10d1a",
                        "glosses": [
                            "Se comporter d’une certaine façon avec quelqu'un au moment où il part."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0182d8e1-43f9-4dd9-9d23-46d4c9f2d441",
                                "sense_id": "d4001834-e0a5-3146-a41c-b7dd098b090e",
                                "text": "Toutes les procédures liées à l’accueil sont formalisées (répondre au téléphone, désaccueillir au moment de la fermeture, etc.)."
                            },
                            {
                                "example_id": "20ab4ccd-c76b-4210-b887-12c5d07b885d",
                                "sense_id": "d4001834-e0a5-3146-a41c-b7dd098b090e",
                                "text": "Nous avons été très bien accueillis et désaccueillis."
                            }
                        ]
                    },
                    {
                        "sense_id": "155871bc-4a6d-3664-8692-253d64c656fe",
                        "entry_id": "c91db2c3-2f03-3104-af6a-173c4ee10d1a",
                        "glosses": [
                            "Se comporter d’une manière inaccueillante envers quelqu’un."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4caa430-9d17-4f23-91f9-c78af0c69c58",
                                "sense_id": "155871bc-4a6d-3664-8692-253d64c656fe",
                                "text": "Pour une fois, l’ambiance glaciale, militaire, inhospitalière, nous « désaccueille » ; plus vite nous serons partis, mieux ça vaudra."
                            }
                        ]
                    }
