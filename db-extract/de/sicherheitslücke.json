                        "entry_id": "0d78692d-94e8-323f-aa0b-0412bdae66fc",
                        "glosses": [
                            "Schwachstelle in einer Software, durch die ein schädliches Programm oder ein Hacker in den Rechner eindringen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ec4c38b-59d9-4841-87a5-52893bf86bec",
                                "sense_id": "e9a28d01-9877-3a88-b86d-79c05ad4cc81",
                                "text": "Das Betriebssystem weist Sicherheitslücken auf."
                            },
                            {
                                "example_id": "d7c9c766-b9d8-4eff-9776-4a4f9b495ac4",
                                "sense_id": "e9a28d01-9877-3a88-b86d-79c05ad4cc81",
                                "text": "Um die Sicherheitslücken zu schließen, musst du dein Programm aktualisieren."
                            },
                            {
                                "example_id": "8c804a1d-9295-4222-aa03-fd1e4f7cce32",
                                "sense_id": "e9a28d01-9877-3a88-b86d-79c05ad4cc81",
                                "text": "„Hacker haben eine schwerwiegende Sicherheitslücke im Mobilfunknetz entdeckt.“"
                            }
                        ],
