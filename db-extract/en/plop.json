                                "target_senses": [
                                    {
                                        "sense_id": "7f6af9e0-d4a8-3987-8916-f1a471efa88a",
                                        "entry_id": "3bd74abd-950a-37e4-bab9-7b83814d0d2d",
                                        "glosses": [
                                            "звук, производимый падающей водой или другой жидкостью, а также ударом по воде или движением твёрдого предмета по поверхности воды"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "022f0951-be42-4b8a-b520-7bed2f956083",
                                                "sense_id": "7f6af9e0-d4a8-3987-8916-f1a471efa88a",
                                                "text": "С шумом и плеском врезалась она в воду."
                                            },
                                            {
                                                "example_id": "9ebe5e20-6d8a-4de9-902c-9a28cd30c342",
                                                "sense_id": "7f6af9e0-d4a8-3987-8916-f1a471efa88a",
                                                "text": "Земля наполняется шумом, плеском, игрой капель и талых вод — тысячами признаков весны, тогда как, повторяю, солнечная теплота остаётся неизменной."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a406aba3-a980-3614-8c52-4422db401457",
                                        "entry_id": "3bd74abd-950a-37e4-bab9-7b83814d0d2d",
                                        "glosses": [
                                            "устар. то же, что рукоплескание"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b82e4791-a037-4d9d-b3df-4df8f8664088",
                                                "sense_id": "a406aba3-a980-3614-8c52-4422db401457",
                                                "text": "Татьяна чуть жива; Трике, // К ней обратясь с листком в руке, // Запел, фальшивя. Пле́ски, клики // Его приветствуют."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
