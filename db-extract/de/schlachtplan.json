                "senses": [
                    {
                        "sense_id": "c8bc41d1-d408-313f-b2e8-ac5064314e96",
                        "entry_id": "ec3f40b1-92c4-3897-8532-ef1a37dba5ad",
                        "glosses": [
                            "Entwicklung, Planung einer Strategie für ein Vorhaben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f60357b1-a535-4e93-9ed1-73a6b566cdff",
                                "sense_id": "c8bc41d1-d408-313f-b2e8-ac5064314e96",
                                "text": "Wir müssen uns für das Projekt zuerst einen Schlachtplan machen."
                            },
                            {
                                "example_id": "9f8d9ccd-cafb-41e0-9e18-6b548621c1a8",
                                "sense_id": "c8bc41d1-d408-313f-b2e8-ac5064314e96",
                                "text": "„Die Sonne brannte heiß auf den Perron nieder, und Cécile, die nach Art aller Nervösen sehr empfindlich gegen extreme Temperaturverhältnisse war, suchte nach einer schattigen Stelle, bis Gordon endlich vorschlug, in die große Flurhalle des Bahnhofsgebäudes eintreten und hier in aller Ruhe den in der Schwebe gebliebenen Schlachtplan feststellen zu wollen.“"
                            },
                            {
                                "example_id": "fc0bc407-314d-4df4-8775-57eb1fcb3e10",
                                "sense_id": "c8bc41d1-d408-313f-b2e8-ac5064314e96",
                                "text": "„Nach dem, was der flüsternde Äther verriet, richtete Thomas seinen Schlachtplan ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
