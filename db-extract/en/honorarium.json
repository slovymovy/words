                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "20dddf4b-c535-4173-bad4-92166d867464",
                        "source_entry_id": "267795c0-04df-3e5f-9dd2-c3cda00ba4f6",
                        "source_sense_id": "82273e73-7fe7-360c-9dda-65d1194e617f",
                        "source_sense_description": "compensation for services",
                        "target_lang_word": "Honorar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Honorar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1e24e1ee-269f-3a2c-b866-799956ad8206",
                                        "entry_id": "3abdceeb-89d2-354f-870c-3b57d670ff96",
                                        "glosses": [
                                            "Entgelt/Vergütung für eine bestimmte erbrachte Leistung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "593c648c-a99c-4370-b8ac-7e372875a02f",
                                                "sense_id": "1e24e1ee-269f-3a2c-b866-799956ad8206",
                                                "text": "Für seinen Vortrag erhielt er ein gutes Honorar."
                                            },
                                            {
                                                "example_id": "51617455-dd50-4090-bc13-c4830ebb41b4",
                                                "sense_id": "1e24e1ee-269f-3a2c-b866-799956ad8206",
                                                "text": "[Apotheker bekommen] „fürs Blutdruckmessen mit kurzer Beratung ein Honorar von rund elf Euro.“"
                                            },
                                            {
                                                "example_id": "e043e5d0-713f-49fe-bf6c-96be1c5c4ed0",
                                                "sense_id": "1e24e1ee-269f-3a2c-b866-799956ad8206",
                                                "text": "„Niemand ist freigebiger und verschwenderischer als er, wenn er nach Tagen wirklicher Not in den Besitz längst erwarteter Honorare kommt, was ihm endlich erlaubt, seine Freunde nach seinem Geschmack zu bewirten.“"
                                            },
                                            {
                                                "example_id": "d70531b3-1084-4134-9602-e383fdd5fb3e",
                                                "sense_id": "1e24e1ee-269f-3a2c-b866-799956ad8206",
                                                "text": "„Die Oberin übergibt mir mein Honorar.“"
                                            },
                                            {
                                                "example_id": "10c6354b-5850-4649-b882-b41cf3b50a91",
                                                "sense_id": "1e24e1ee-269f-3a2c-b866-799956ad8206",
                                                "text": "„Wieland und die Erwähnten bezogen ihre Honorare von der Universität.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "acec39e6-ca32-472b-aa98-31b4a85927cb",
                        "source_entry_id": "267795c0-04df-3e5f-9dd2-c3cda00ba4f6",
                        "source_sense_id": "82273e73-7fe7-360c-9dda-65d1194e617f",
                        "source_sense_description": "compensation for services",
                        "target_lang_word": "Vergütung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vergütung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b5ffe114-f69a-316a-a9e3-90d964ce09f6",
                                        "entry_id": "c0d3fd89-c9a5-3bd6-9419-0e0b6d8f1433",
                                        "glosses": [
                                            "Geldsumme, mit der etwas vergütet wird; zum Beispiel Geld als Gegenleistung für eine Arbeit, Ware, Entschädigung oder ein Nutzungsrecht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6d28abb-22e6-40cf-a04b-371055dd8c45",
                                                "sense_id": "b5ffe114-f69a-316a-a9e3-90d964ce09f6",
                                                "text": "Eine Vergütung gilt als stillschweigend vereinbart, wenn die Dienstleistung den Umständen nach nur gegen eine Vergütung zu erwarten ist."
                                            },
                                            {
                                                "example_id": "12b1987b-85e3-426b-a92b-c7efb443f030",
                                                "sense_id": "b5ffe114-f69a-316a-a9e3-90d964ce09f6",
                                                "text": "Wieso sollte ich ohne eine Vergütung arbeiten wollen? Ich möchte Geld sehen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b0307f37-e2d2-3382-b3b8-73b09b8f3f44",
                                        "entry_id": "c0d3fd89-c9a5-3bd6-9419-0e0b6d8f1433",
                                        "glosses": [
                                            "Schutzschicht eines Werkstoffs, zum Beispiel bei Glas, Holz oder Metall"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7d326df-0d9b-4930-9b9a-087cc4689d71",
                                                "sense_id": "b0307f37-e2d2-3382-b3b8-73b09b8f3f44",
                                                "text": "Die Vergütung optischer Linsen durch Aufdampfen dünner Schichten im Hochvakuum ist noch nicht so lange bekannt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "1e73f702-08fc-308c-88ee-a802e13bfffe",
                                        "entry_id": "c0d3fd89-c9a5-3bd6-9419-0e0b6d8f1433",
                                        "glosses": [
                                            "Vergütungsvorgang; das Vergüten; das Vergütetwerden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4b66c4e-5b22-4681-af19-8ccf909efa88",
                                                "sense_id": "1e73f702-08fc-308c-88ee-a802e13bfffe",
                                                "text": "Die Vergütung wird in der Lohn- und Gehaltsabteilung abgewickelt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "24bc07dc-7c78-4814-875c-c68f1a899009",
                        "source_entry_id": "267795c0-04df-3e5f-9dd2-c3cda00ba4f6",
                        "source_sense_id": "82273e73-7fe7-360c-9dda-65d1194e617f",
                        "source_sense_description": "compensation for services",
                        "target_lang_word": "Ehrensold",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ehrensold",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2bfd6c4f-0856-3d98-8d8f-4c5e7268ec65",
                                        "entry_id": "618062f7-725f-3fba-84aa-627818ac93e3",
                                        "glosses": [
                                            "einmalig oder regelmäßig gewährte materielle Zuwendung, meistens als Beigabe zu einem Verdienstorden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ff39a5a-ca47-49e4-9352-e655342b7734",
                                                "sense_id": "2bfd6c4f-0856-3d98-8d8f-4c5e7268ec65",
                                                "text": "Arthur, 8. Herzog von Wellington, 83, Nachfahre des Kriegshelden, der Napoleon bei Waterloo eben dasselbe bereitete, will nicht auf einen Ehrensold des belgischen Staates verzichten."
                                            },
                                            {
                                                "example_id": "2404432c-bfec-4eb4-90ae-46bb9abeb839",
                                                "sense_id": "2bfd6c4f-0856-3d98-8d8f-4c5e7268ec65",
                                                "text": "Gelohnt wurde dem Helden mit einem monatlichen \"Ehrensold\" von zuletzt 1600 Mark, sofern er als \"Kämpfer\" eingestuft war, als \"Opfer\" gab es 200 Mark weniger."
                                            },
                                            {
                                                "example_id": "3a48be77-d2ba-44cd-bf05-19d39fd75aa8",
                                                "sense_id": "2bfd6c4f-0856-3d98-8d8f-4c5e7268ec65",
                                                "text": "Doch der Kaiser ließ Mozart immerhin nicht ganz im Stich. Von Dezember 1787 an bekam er den Ehrensold eines k. k. Kammer-Kompositeurs, und im Mai 1788 wurde in Wien Don Giovanni herausgebracht, wofür Mozart noch einmal ein Honorar bekam."
                                            },
                                            {
                                                "example_id": "cda37582-44b5-474f-a70e-2f32952fa50c",
                                                "sense_id": "2bfd6c4f-0856-3d98-8d8f-4c5e7268ec65",
                                                "text": "Allein sein Vater war ein reicher Nürnberger gewesen, und der genügsame Künstler bedurfte des Ehrensoldes für die Oper kaum."
                                            },
                                            {
                                                "example_id": "418d649f-4955-49db-a789-47ae0b2fd75b",
                                                "sense_id": "2bfd6c4f-0856-3d98-8d8f-4c5e7268ec65",
                                                "text": "Sie alle bekommen nun aus dem Staatshaushalt einen monatlichen Ehrensold von 3000 Rubel."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8df8c6f4-f496-3ef4-90ae-b805cd35c2cd",
                                        "entry_id": "618062f7-725f-3fba-84aa-627818ac93e3",
                                        "glosses": [
                                            "Ruhegehalt des deutschen Bundespräsidenten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8b83a7e-1f64-41c1-8b1e-f02024762b7f",
                                                "sense_id": "8df8c6f4-f496-3ef4-90ae-b805cd35c2cd",
                                                "text": "Scheidet der Bundespräsident mit Ablauf seiner Amtszeit oder vorher aus politischen oder gesundheitlichen Gründen aus seinem Amt aus, so erhält er einen Ehrensold in Höhe der Amtsbezüge mit Ausnahme der Aufwandsgelder."
                                            },
                                            {
                                                "example_id": "0b3c1273-4e74-48ab-900b-22bcaf5dbb35",
                                                "sense_id": "8df8c6f4-f496-3ef4-90ae-b805cd35c2cd",
                                                "text": "Der nach rund 20 Monaten Amtszeit zurückgetretene Bundespräsident Christian Wulff bekommt den üblichen Ehrensold für aus dem Amt ausgeschiedene Präsidenten."
                                            },
                                            {
                                                "example_id": "2fdb620d-803b-4bd1-92d2-d85b6ae7e9c9",
                                                "sense_id": "8df8c6f4-f496-3ef4-90ae-b805cd35c2cd",
                                                "text": "Es steckt, man muss es deutlich sagen, etwas Hämisches, geradezu Rachsüchtiges in der Forderung, Christian Wulff den Ehrensold zu verweigern, der Bundespräsidenten nach ihrem Rücktritt zusteht – 199.000 Euro im Jahr, bis ans Lebensende, plus Büro, Dienstwagen und persönlichem Referenten."
                                            },
                                            {
                                                "example_id": "992b298a-7ee9-4683-ab66-45c76f84c4aa",
                                                "sense_id": "8df8c6f4-f496-3ef4-90ae-b805cd35c2cd",
                                                "text": "Politiker der FDP und der SPD forderten in der Bild-Zeitung, Wulff solle auf den Ehrensold verzichten."
                                            },
                                            {
                                                "example_id": "a32ffdb7-6f83-4231-b192-1a1e84d0dbb1",
                                                "sense_id": "8df8c6f4-f496-3ef4-90ae-b805cd35c2cd",
                                                "text": "Von Arnim verwies zudem darauf, dass im Falle des Ablebens von Christian Wulff dessen Witwe \"60 Prozent des Ehrensoldes auf Lebenszeit erhalten\" würde."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
