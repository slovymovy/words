                        "de": "Partizip Präsens und Gerundium von 'starve' (hungern, verhungern lassen oder metaphorisch nach etwas dürsten)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "морить голодом",
                                "target_lang_sense_clarification": "заставлять кого-то голодать"
                            },
                            {
                                "target_lang_word": "голодать",
