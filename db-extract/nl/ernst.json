                        "examples": [
                            {
                                "example_id": "49140238-1995-4f65-a355-eaca1e2d74b2",
                                "sense_id": "e99063cb-a3d5-36f6-b0a6-d2e2400be329",
                                "text": "De ernst van de situatie bereikte zijn hoogtepunt."
                            }
                        ]
                    },
                    {
                        "sense_id": "829b2b08-359a-3990-a440-20c83bec4ac0",
                        "entry_id": "24f9367b-6e61-3a7d-9ab1-b80c13d21f94",
                        "glosses": [
                            "de keer dat men ernstig is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed77a85c-3fdc-4829-a69d-22a6f3e5ab8d",
                                "sense_id": "829b2b08-359a-3990-a440-20c83bec4ac0",
                                "text": "Ze sprak met grote ernst aan de gevolgen van haar beslissing."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aceb62a2-eb06-47a2-867a-42276770fe2c",
                        "source_entry_id": "24f9367b-6e61-3a7d-9ab1-b80c13d21f94",
                        "source_sense_id": "e99063cb-a3d5-36f6-b0a6-d2e2400be329",
