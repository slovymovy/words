                                        "entry_id": "ff39ff5d-ef9c-3479-9911-0d3dca432816",
                                        "glosses": [
                                            "Que pertenece o concierne al culturismo (desarrollo extremo de los músculos por medio de ejercicios físicos)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f047f3a-2308-47cc-9194-72769ef1750b",
                                                "sense_id": "b0ca968b-8e47-35e9-85e1-298b939aa477",
                                                "text": "Kraemer dedujo que el entrenamiento con cargas muy pesadas interviene más sobre las fibras tipo II que el entrenamiento tipo culturista"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "23ff0902-7c56-30e8-8036-f6f04dd6387d",
