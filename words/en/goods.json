    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "42a7e0c6-97aa-33ef-9831-1bb7d88f86bd",
                    "sense_definition": "Things that are produced, bought, or sold.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "merchandise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The store sells a wide range of household <w>goods</w>.",
                            "target_lang_translations": {
                                "ru": "Магазин продает широкий ассортимент хозяйственных <w>товаров</w>.",
                                "cs": "Obchod prodává široký sortiment domácích <w>potřeb</w>.",
                                "tr": "Mağaza geniş bir ev <w>eşyaları</w> yelpazesi satıyor."
                            }
                        },
                        {
                            "text": "Prices for consumer <w>goods</w> have increased significantly this year.",
                            "target_lang_translations": {
                                "ru": "Цены на потребительские <w>товары</w> значительно выросли в этом году.",
                                "cs": "Ceny spotřebního <w>zboží</w> se letos výrazně zvýšily.",
                                "tr": "Tüketim <w>mallarının</w> fiyatları bu yıl önemli ölçüde arttı."
                            }
                        }
