                ],
                "senses": [
                    {
                        "sense_id": "c7eaf55e-4347-39e2-a959-6be496bbe380",
                        "entry_id": "846a97ff-0480-31e9-9250-5419403e6cfa",
                        "glosses": [
                            "Laisser sortir l’humidité d'une substance."
                        ],
                        "tags": [
                            "generically"
                        ],
                        "examples": [
                            {
                                "example_id": "8a0be032-71bc-41da-8955-3f4698d003e5",
                                "sense_id": "c7eaf55e-4347-39e2-a959-6be496bbe380",
                                "text": "On observera que les cloches neuves ne conviennent point aux Laitues. Il faut qu'elles ayent servi durant quelque temps à d'autres plants, ou qu'elles ayent été exposées le long d'un mur, au soleil du midi, pour y ressuer durant un mois ou plus."
                            }
                        ]
                    },
                    {
                        "sense_id": "4c3689d4-56c9-3b3a-a998-0de8363bf44e",
                        "entry_id": "846a97ff-0480-31e9-9250-5419403e6cfa",
                        "glosses": [
                            "Laisser sortir l’humidité d'une substance.",
                            "Subir l’opération du ressuage, c’est-à-dire séparer de l'argent contenu dans du cuivre par liquation."
                        ],
                        "tags": [
                            "generically",
                            "specifically"
                        ],
                        "examples": [
                            {
                                "example_id": "43e08b71-f790-485b-a3de-c978864f2a82",
                                "sense_id": "4c3689d4-56c9-3b3a-a998-0de8363bf44e",
                                "text": "Torréfier ou faire ressuer le cuivre, c'est la même chose."
                            }
                        ]
                    },
                    {
                        "sense_id": "6667cd3c-b673-3d14-9883-9474b0b39471",
                        "entry_id": "846a97ff-0480-31e9-9250-5419403e6cfa",
                        "glosses": [
                            "Laisser sortir l’humidité d'une substance.",
                            "Laisser s’échapper l’humidité du pain, après défournement pendant un certain temps."
                        ],
                        "tags": [
                            "generically"
                        ],
                        "examples": [
                            {
                                "example_id": "0058208e-25e8-40ef-abc6-4d6289938ebe",
                                "sense_id": "6667cd3c-b673-3d14-9883-9474b0b39471",
                                "text": "On doit laisser ressuer et refroidir le pain avant que de le manger, non seulement afin qu’il ne nuise pas, mais encore pour qu’il dure davantage."
                            }
                        ]
                    }
                ],
