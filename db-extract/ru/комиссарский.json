                "senses": [
                    {
                        "sense_id": "77ea6032-c336-3c4e-9ccb-cdcdd5aceb0f",
                        "entry_id": "a22d012f-1b5c-38c5-b3f2-d3b5a4bcacbf",
                        "glosses": [
                            "свойственный комиссару, принадлежащий комиссару, подчинённый комиссару, либо имеющий к комиссару иное непосредственное отношение. Отсюда комиссарский автомобиль мог проследовать куда угодно. Предложить командованию и поарму подтянуть комиссарский и комсостав, обязать комиссаров и комсостав жить вместе с красноармейцами."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e096d89a-b911-42c1-9da8-38a126e664ea",
                        "source_entry_id": "a22d012f-1b5c-38c5-b3f2-d3b5a4bcacbf",
                        "source_sense_id": "77ea6032-c336-3c4e-9ccb-cdcdd5aceb0f",
                        "target_lang_word": "commissar",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "commissar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "91dd3e7e-9529-31ac-835a-97d7ef190428",
                                        "entry_id": "033ee21c-f9bb-3553-bdad-9d6787f0f908",
                                        "glosses": [
                                            "An official of the Communist Party, often attached to a military unit, who was responsible for political education."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "668e7449-fa48-437d-9a1a-a9335dd5e656",
                                                "sense_id": "91dd3e7e-9529-31ac-835a-97d7ef190428",
                                                "text": "On Monday, state media named Wang Houbin as commander of the Rocket Force and Xu Xisheng as the political commissar of the force in a report highlighting their promotion to the rank of general by Chinese leader Xi Jinping."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "088acd32-add3-3878-b28f-2d2f67eb3011",
                                        "entry_id": "033ee21c-f9bb-3553-bdad-9d6787f0f908",
                                        "glosses": [
                                            "The head of a commissariat."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b2cf85d4-5536-3cdd-a214-8a796b5c3c52",
                                        "entry_id": "033ee21c-f9bb-3553-bdad-9d6787f0f908",
                                        "glosses": [
                                            "A political functionary whose job is to push the party or government line."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "humorous",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "387cdbab-37c7-4f06-b8bd-f4e5dce85c56",
                                                "sense_id": "b2cf85d4-5536-3cdd-a214-8a796b5c3c52",
                                                "text": "There is a dangerous censoriousness pulsing through American society. In small towns and big cities alike, would-be commissars are fighting, in the name of a distinct minority of Americans, to stifle open discussion and impose their views on the community at large. Dissenters, when they speak out, are hounded, ostracized and sometimes even forced from their jobs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
