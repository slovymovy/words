                "senses": [
                    {
                        "sense_id": "aa064bc1-ffb4-3e17-b7dc-2b061fb084a9",
                        "entry_id": "6d078d0c-1eee-38f5-8346-b5fb26667033",
                        "glosses": [
                            "political instructor"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "44df41f1-e97e-4ff0-9d42-549d7b46b78c",
                                "sense_id": "aa064bc1-ffb4-3e17-b7dc-2b061fb084a9",
                                "text": "– Зна́чит, – заговори́л подполко́вник ти́хим го́лосом, – неда́вно на закры́том совеща́нии арме́йских политрабо́тников вре́мя, в кото́рое мы живём, бы́ло определено́ как предвое́нное!",
                                "translation": "“Right,” said the lieutenant-colonel in a quiet voice. “At a recent closed session of the political instructors of the armed forces, the times we are living in were defined as a Pre-War Period!”",
                                "english": "“Right,” said the lieutenant-colonel in a quiet voice. “At a recent closed session of the political instructors of the armed forces, the times we are living in were defined as a Pre-War Period!”"
                            }
                        ]
