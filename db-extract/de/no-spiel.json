                "senses": [
                    {
                        "sense_id": "4fd16deb-3943-34fe-b57f-ffd753524a96",
                        "entry_id": "df695369-9dce-316f-94dc-7e46e4eb9180",
                        "glosses": [
                            "traditionelles japanisches Singspiel, das sehr formstreng ist und historische oder mythologische Stoffe behandelt"
                        ],
                        "tags": [
                            "Theater"
                        ],
                        "examples": [
                            {
                                "example_id": "932c280c-b43d-4917-ae7d-af75ab954aff",
                                "sense_id": "4fd16deb-3943-34fe-b57f-ffd753524a96",
                                "text": "„Im Westen konzentriert sich heute das Interesse der Fachleute am japanischen Theater vor allem auf das No-Spiel.“"
                            },
                            {
                                "example_id": "eb1689cb-1e68-43c5-8efb-fcab62fd07c0",
                                "sense_id": "4fd16deb-3943-34fe-b57f-ffd753524a96",
                                "text": "„Das japanische No-Spiel ist seit 500 Jahren quasi unverändert. Symbolik, Gestik und Rollenverständnis werden in Schauspielerdynastien vom Vater an den Sohn weitergegeben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
