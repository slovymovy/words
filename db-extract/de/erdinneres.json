                "senses": [
                    {
                        "sense_id": "d8d2003c-3165-342b-be33-63db511cbb2a",
                        "entry_id": "bcfebfa6-0629-3cc6-b866-121167fa8235",
                        "glosses": [
                            "unterhalb der Erdkruste liegende Erdschichten; Inneres der Erde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7da8c9de-2495-4cc2-bf39-16700ae777ac",
                                "sense_id": "d8d2003c-3165-342b-be33-63db511cbb2a",
                                "text": "„Er befreite sich und trat damit weiter Erde ein, sodass er sich erneut ein paar Meter Richtung Erdinneres bewegte.“"
                            },
                            {
                                "example_id": "0a26c321-5d4b-4dbd-8db0-d03904737479",
                                "sense_id": "d8d2003c-3165-342b-be33-63db511cbb2a",
                                "text": "„Die Tethys wurde immer kleiner, ihre ozeanische Kruste in Richtung Erdinneres gedrückt.“"
                            },
                            {
                                "example_id": "97e9bebb-27e1-4c64-a387-900ed59b1dbd",
                                "sense_id": "d8d2003c-3165-342b-be33-63db511cbb2a",
                                "text": "„Da Gold außerordentlich schwer ist, wäre es gen Erdinneres gesunken und hätte sich dort angesammelt, möglicherweise in großer Menge.“"
                            },
                            {
                                "example_id": "9c6cb03e-3d87-4c30-b459-b29f7e93b633",
                                "sense_id": "d8d2003c-3165-342b-be33-63db511cbb2a",
                                "text": "„Genau das war Ende 2004 geschehen, als die Indo-Australische Platte beim ‚Abtauchen‘ unter Indonesien mal wieder einen Ruck in Richtung Erdinneres machte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
