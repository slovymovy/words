                        "overeat"
                    ],
                    "common_phrases": [
                        "pig out"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Есть много и жадно; обжираться.",
                        "zh": "贪婪地吃大量食物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обжираться",
                                "target_lang_sense_clarification": "есть слишком много"
                            },
                            {
                                "target_lang_word": "насвинячить",
                                "target_lang_sense_clarification": "намусорить во время еды"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "暴饮暴食",
                                "target_lang_sense_clarification": "指吃得过多"
                            },
                            {
                                "target_lang_word": "大吃大喝",
                                "target_lang_sense_clarification": "指放纵饮食"
                            }
                        ]
                    }
                },
                {
