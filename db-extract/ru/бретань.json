                    },
                    {
                        "translation_id": "dfd46b66-580a-477e-bb25-a5c514b734c6",
                        "source_entry_id": "c20a472c-f8f3-3bfc-879b-fa91a590dc2d",
                        "target_lang_word": "Bretagne",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bretagne",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "71ca958f-c993-38d1-864c-e3d1a3a884f9",
                                        "entry_id": "c8916920-0b9d-374a-971c-0dc1fe7996db",
                                        "glosses": [
                                            "Region im Nordwesten Frankreichs"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40cf2353-fb78-4ff8-bf8a-4dbbd3e2ee7a",
                                                "sense_id": "71ca958f-c993-38d1-864c-e3d1a3a884f9",
                                                "text": "Wir fahren im Sommer in die Bretagne."
                                            },
                                            {
                                                "example_id": "a4b643ac-c11f-4266-b974-437b354652f1",
                                                "sense_id": "71ca958f-c993-38d1-864c-e3d1a3a884f9",
                                                "text": "„Napoleon schuf damit eine französische Identität, die sich auf gallische und römische Traditionen berief – auch, um separatistischen Tendenzen in der Bretagne zu begegnen.“"
                                            },
                                            {
                                                "example_id": "4c2057d0-38e5-49ca-9929-333a3208df68",
                                                "sense_id": "71ca958f-c993-38d1-864c-e3d1a3a884f9",
                                                "text": "„Das war jedoch kein Grund, die Reise in die Bretagne aufzugeben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "eef7ffd6-ead2-31a6-b6e2-351b33c9bd18",
                                        "entry_id": "c8916920-0b9d-374a-971c-0dc1fe7996db",
                                        "glosses": [
                                            "größte Halbinsel Frankreichs"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3d0aaa68-6e17-4295-84d1-8a3f4c995683",
                        "source_entry_id": "c20a472c-f8f3-3bfc-879b-fa91a590dc2d",
                        "target_lang_word": "Bretagne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bretagne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9dc6367c-c17b-3a6b-8fa3-0f46d3efbbb7",
                                        "entry_id": "53658112-1045-3023-9f1a-39d48e6ab414",
                                        "glosses": [
                                            "Grande péninsule de l’ouest de la France s'identifiant avec la région historique dont la superficie avoisine celle des cinq départements qui se situent sur ce territoire : le Finistère, le Morbihan, l’Ille-et-Vilaine, la Loire-Atlantique et les Côtes-d’Armor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13f3202d-d55c-41f6-a2bf-2d9c4d3a0cbf",
                                                "sense_id": "9dc6367c-c17b-3a6b-8fa3-0f46d3efbbb7",
                                                "text": "Il ne faut pas croire que tous les chevaux qui s’élèvent dans le Perche y soient nés; les éleveurs vont les chercher en Bretagne, en Franche-Comté, en Bourgogne, en Poitou."
                                            },
                                            {
                                                "example_id": "6751817c-9e67-4a2c-9a49-5724d56daba8",
                                                "sense_id": "9dc6367c-c17b-3a6b-8fa3-0f46d3efbbb7",
                                                "text": "Mais l’odeur dépassait tout. Pour en trouver l’équivalent, il me fallait combiner en mon esprit celle qui règne chez les doux Chippewayans – les seuls sauvages vraiment sales – et les Esquimaux. Même en y ajoutant le relent propre aux demeures islandaises des pêcheries du lac Winnipeg, je n’arrivais pas à trouver un équivalent. Grâce à la Bretagne, la France battait enfin un record !"
                                            },
                                            {
                                                "example_id": "7cb73dff-52b4-4820-8782-eb545370c9b1",
                                                "sense_id": "9dc6367c-c17b-3a6b-8fa3-0f46d3efbbb7",
                                                "text": "Que la Bretagne, considérée dans son ensemble, soit encore aujourd’hui, une province de zélée pratique religieuse, voilà, je crois, un point qui ne sera contesté sérieusement par personne."
                                            },
                                            {
                                                "example_id": "8e4e5c38-a98b-4e67-907e-0888325d5353",
                                                "sense_id": "9dc6367c-c17b-3a6b-8fa3-0f46d3efbbb7",
                                                "text": "La Rochefortaise Violette Dorange (« Devenir »), désormais basée en Bretagne, à Port-la-Forêt, a elle aussi un bel appétit."
                                            },
                                            {
                                                "example_id": "8c6582aa-a7d8-4915-908a-d0f1e277dd4a",
                                                "sense_id": "9dc6367c-c17b-3a6b-8fa3-0f46d3efbbb7",
                                                "text": "Ailleurs ce sont des landes où poussent de durs petits buissons, la mer qu'on sent et qu'on devnie, l'âpreté, la virilité. Terre à tempête. Endroit de semaine. Bretagne. Je préfère ce pays à celui du sud qui est au bord de la Méditerranée, peut-être parce qu'il ressemble plus à la Gaspésie de mon pays. J'aime moins le sud où c'est tous les jours dimanche."
                                            },
                                            {
                                                "example_id": "844ca216-f411-4c9c-9678-7ec80e4a3f29",
                                                "sense_id": "9dc6367c-c17b-3a6b-8fa3-0f46d3efbbb7",
                                                "text": "Il ne saurait être question en Bretagne d’un État impérialiste au point de galliciser les Bretonnants pas plus que celtiser linguistiquement les Bretons Gallots."
                                            },
                                            {
                                                "example_id": "d747cf54-bb2a-4d0d-b372-a27067cffa23",
                                                "sense_id": "9dc6367c-c17b-3a6b-8fa3-0f46d3efbbb7",
                                                "text": "Moi je rigole quand je pense\nÀ ceux qui partent en vacances\nEn Bretagne ou en Provence\nRien ne vaut l’air de Paris."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ea474d2-0ee1-3a30-9296-bd778df0a30d",
                                        "entry_id": "53658112-1045-3023-9f1a-39d48e6ab414",
                                        "glosses": [
                                            "Ancien royaume, puis duché rattaché au royaume de France."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3dbe6254-d0b1-4500-9112-7056c3ea6e26",
                                                "sense_id": "2ea474d2-0ee1-3a30-9296-bd778df0a30d",
                                                "text": "Le lendemain, il prend le château de Damville, à vingt kilomètres de Verneuil, et regagne ensuite Rouen, d’où il envoie aussitôt ses mercenaires en Bretagne, vers Fougères et Dol."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e62f6ee4-bd2e-3652-b6e6-a25a5d14b387",
                                        "entry_id": "53658112-1045-3023-9f1a-39d48e6ab414",
                                        "glosses": [
                                            "Région administrative française composée de quatre départements : le Finistère, le Morbihan, l’Ille-et-Vilaine et les Côtes-d’Armor."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
