        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bcbbaecc-8a13-31be-94a0-a16a0b60f297",
                    "sense_definition": "A narrow part of a navigable waterway.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "waterway",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ship had to navigate carefully through the <w>narrows</w> to reach the open sea.",
                            "target_lang_translations": {
                                "pl": "Statek musiał ostrożnie przepłynąć przez <w>cieśninę</w>, aby dotrzeć na otwarte morze."
                            }
                        },
                        {
                            "text": "Strong currents often develop within the <w>narrows</w> of the river.",
                            "target_lang_translations": {
                                "pl": "Silne prądy często tworzą się w <w>zwężeniach</w> rzeki."
                            }
                        }
                    ],
                    "synonyms": [
                        "strait",
                        "channel"
                    ],
                    "common_phrases": [
                        "river narrows"
                    ],
                    "target_lang_definitions": {
                        "pl": "Wąska część żeglownej drogi wodnej."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "cieśnina",
                                "target_lang_sense_clarification": "wąskie przejście między dwoma akwenami"
                            },
                            {
                                "target_lang_word": "przesmyk",
                                "target_lang_sense_clarification": "wąskie przejście wodne lub lądowe"
                            }
                        ]
