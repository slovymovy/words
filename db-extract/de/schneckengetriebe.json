                "senses": [
                    {
                        "sense_id": "c4f35ad5-0393-39f8-9492-55af818bc232",
                        "entry_id": "4f41246e-7392-37e0-a3e5-cfe3daecfcf6",
                        "glosses": [
                            "Getriebe, bei dem eine schraubenförmige sogenannte Schnecke ein Zahnrad (Schneckenrad) dreht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95f8ba4b-05a3-4f77-b641-6bbceb78766c",
                                "sense_id": "c4f35ad5-0393-39f8-9492-55af818bc232",
                                "text": "„Beim Handmixer werden die Rührbesen von einem Schneckengetriebe bewegt.“"
                            },
                            {
                                "example_id": "ad1a1d78-db3b-4816-ad0a-f35412b691ff",
                                "sense_id": "c4f35ad5-0393-39f8-9492-55af818bc232",
                                "text": "„Kupplung und Bremsen sind weit nach hinten verlegt, ebenso der Gasgriff, der schwer nach Bastelei aussieht: ein viereckiges Klötzchen, schwergängig und mit einem Schneckengetriebe so übersetzt, dass Vollgas erst nach mehreren Umdrehungen zu erreichen ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
