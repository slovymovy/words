                                    {
                                        "sense_id": "edab4312-801b-32c5-944b-3a854383347d",
                                        "entry_id": "7e277995-1aa9-37fe-8a21-b0244f50f275",
                                        "glosses": [
                                            "A spiritualist or practitioner of mystic arts."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef09fe4d-7a1a-4658-83d3-48b930985975",
                                                "sense_id": "edab4312-801b-32c5-944b-3a854383347d",
                                                "text": "The truth is that [Isaac] Newton was very much a product of his time. The colossus of science was not the first king of reason, Keynes wrote after reading Newton’s unpublished manuscripts. Instead “he was the last of the magicians”."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34007c1c-fa53-32ff-aa95-7cbacff68428",
                                        "entry_id": "7e277995-1aa9-37fe-8a21-b0244f50f275",
                                        "glosses": [
                                            "A performer of tricks or an escapologist or an illusionist."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9844c99d-7d6e-3600-bdd8-9338a3634fb4",
                                        "entry_id": "7e277995-1aa9-37fe-8a21-b0244f50f275",
                                        "glosses": [
                                            "An amazingly talented craftsman or scientist."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "89277be3-c94c-3600-8ed1-d47e7e3abdef",
                                        "entry_id": "7e277995-1aa9-37fe-8a21-b0244f50f275",
