                                "target_senses": [
                                    {
                                        "sense_id": "9eac80e0-11b2-374b-ba77-393853bc2076",
                                        "entry_id": "e7e523f9-2621-33ca-8dcb-c0ad3d0ae88d",
                                        "glosses": [
                                            "Wissenschaft der Technik"
                                        ],
                                        "tags": [
                                            "Wissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01006cb7-9932-47d7-9ff6-3dcc8953ff93",
                                                "sense_id": "9eac80e0-11b2-374b-ba77-393853bc2076",
                                                "text": "Technologie wird an technischen Hochschulen gelehrt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "39fac96c-3fb7-38f4-91ee-1ee380fc427b",
                                        "entry_id": "e7e523f9-2621-33ca-8dcb-c0ad3d0ae88d",
                                        "glosses": [
                                            "Synonym für Technik"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f78348f8-9a13-4f34-bb54-0e3be16ec061",
                                                "sense_id": "39fac96c-3fb7-38f4-91ee-1ee380fc427b",
                                                "text": "Wir sind auf dem neuesten Stand der Technologie."
                                            },
                                            {
                                                "example_id": "e72e8104-a2bf-4b20-bc6a-f1c196ef9387",
                                                "sense_id": "39fac96c-3fb7-38f4-91ee-1ee380fc427b",
                                                "text": "„Er lebte von neuer Technologie und förderte sie auch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "bbfa7696-4d12-341c-8d37-c9bff5957bd7",
                                        "entry_id": "e7e523f9-2621-33ca-8dcb-c0ad3d0ae88d",
                                        "glosses": [
                                            "Verfahren, das in der industriellen Produktion/Verarbeitung zur Anwendung kommt"
                                        ],
                                        "tags": [
                                            "Produktion"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac58d6f4-6d56-45e6-839b-bf5d231ab2b6",
                                                "sense_id": "bbfa7696-4d12-341c-8d37-c9bff5957bd7",
                                                "text": "Er schafft das mit einer ganz bestimmten Technik (kennt einen Kniff, hat den Bogen raus)."
                                            },
                                            {
                                                "example_id": "301e13a8-4807-42be-b659-e8e88e76f358",
                                                "sense_id": "bbfa7696-4d12-341c-8d37-c9bff5957bd7",
                                                "text": "„Mit der Entwicklung des Offsetdrucks, bei dem ein Gummituchzylinder das Druckbild von der Form auf das Papier überträgt, wurde diese Technologie auch für den Hochdruck entdeckt.“"
                                            },
                                            {
                                                "example_id": "00197e52-105b-465d-ae44-49e095fd5f58",
                                                "sense_id": "bbfa7696-4d12-341c-8d37-c9bff5957bd7",
                                                "text": "„Das war die Gelegenheit, in neue Technologien zu investieren und trotz der Befürchtungen der europäischen Alliierten jene Industrie weiter auszubauen, die eben noch weggebombt worden war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
