        "fr-extract.jsonl": [
            {
                "entry_id": "d5c5d205-1650-350f-92e1-d296d769d565",
                "word": "allochtone",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f2c9c88d-a5fc-4b62-ba62-f54c902d845b",
                        "entry_id": "d5c5d205-1650-350f-92e1-d296d769d565",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
