                ],
                "senses": [
                    {
                        "sense_id": "75ad91a9-e895-3e43-8a75-2eb25471a836",
                        "entry_id": "e9a590ee-eb88-3fa8-9787-6cb626b3a3a7",
                        "glosses": [
                            "von Sturm gepeitschter Wasseranstau an Küsten; verursacht besonders an Flachküsten (wie an der Nordsee) die Zerstörung von Deichen und Uferbefestigungen, Landabriss und weit ins Land dringende Überschwemmungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46183359-b149-41bb-8ce1-b12c7c8f876a",
                                "sense_id": "75ad91a9-e895-3e43-8a75-2eb25471a836",
                                "text": "In der Sturmflut 1962 mussten 340 Menschen ihr Leben lassen."
                            },
                            {
                                "example_id": "797f7aef-8852-4bdd-80e5-8b51ed67ade0",
                                "sense_id": "75ad91a9-e895-3e43-8a75-2eb25471a836",
                                "text": "„Doch bald schon erzwangen die Sturmfluten, die immer wieder das Dorf überspülten, erste Veränderungen.“"
                            },
                            {
                                "example_id": "8a203dbe-6601-46d6-8c9e-16e7968ff1fa",
                                "sense_id": "75ad91a9-e895-3e43-8a75-2eb25471a836",
                                "text": "„Wie bei einer Sturmflut spült die Wut durch die Parlamente im Norden.“"
                            },
                            {
                                "example_id": "d95d3401-2fc4-487f-a904-cb49daadc6e9",
                                "sense_id": "75ad91a9-e895-3e43-8a75-2eb25471a836",
                                "text": "„Die Sturmflut mußte in der Nacht die Granitwand erreicht haben.“"
                            },
                            {
                                "example_id": "931a3635-0a21-435e-8694-59080e5ccfd4",
                                "sense_id": "75ad91a9-e895-3e43-8a75-2eb25471a836",
                                "text": "„Sie fällten die größte Linde des Laubenganges (die übrigens schon zu drei Vierteln abgestorben war) und legten sie in ihrer ganzen Länge quer durch den Garten, so daß man hätte glauben können, sie sei durch eine Sturmflut angeschwemmt oder vom Blitz zerschmettert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "92004554-f6b1-40a0-9f63-7263382601b0",
                        "source_entry_id": "e9a590ee-eb88-3fa8-9787-6cb626b3a3a7",
                        "source_sense_id": "75ad91a9-e895-3e43-8a75-2eb25471a836",
                        "source_sense_description": "von Sturm gepeitschter Wasseranstau an Küsten",
                        "target_lang_word": "storm tide",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "storm tide",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d26adb48-d40b-3cf7-91c7-20bb96e9dc84",
                                        "entry_id": "d9243c6f-e141-39ac-982c-aff5de3e1399",
                                        "glosses": [
                                            "A rise in local sea level caused by the combination of regular tides and a storm surge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d58a411e-a879-4bd8-b984-745d837bcf1a",
                                                "sense_id": "d26adb48-d40b-3cf7-91c7-20bb96e9dc84",
                                                "text": "At 8pm of the 27th there was 1.0 ft of storm tide at both Pensacola and Port Eads."
                                            },
                                            {
                                                "example_id": "d02ecd97-05fa-4262-ab77-7cec4e1e37ca",
                                                "sense_id": "d26adb48-d40b-3cf7-91c7-20bb96e9dc84",
                                                "text": "South Florida and Louisiana, August 23-26, 1992: Natural Disaster Survey -- Jennifer J. Wilson, James P. Travers, 1997 →ISBN\nStorm surge is water height above normal tide level. Storm tide is the water height relative to NGVD, the mean sea level of 1929."
                                            },
                                            {
                                                "example_id": "5ebfeee4-f021-4b0d-8b3f-7e2e3af3c6aa",
                                                "sense_id": "d26adb48-d40b-3cf7-91c7-20bb96e9dc84",
                                                "text": "All About Camille -- the Great Storm, Dan Ellis, 2000 →ISBN\nThe advancing storm surge combines with the normal astronomical tide to create the storm tide."
                                            },
                                            {
                                                "example_id": "abc65219-ad6f-4d7b-8e84-3faebfd8fd0f",
                                                "sense_id": "d26adb48-d40b-3cf7-91c7-20bb96e9dc84",
                                                "text": "Extreme events: a physical reconstruction and risk assessment, Jonathan Nott 2006 →ISBN\nRandomly selected cyclones are then run through a numerical storm tide model."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1f74b4fa-1f7c-4c60-a943-e8eaeb10859e",
                        "source_entry_id": "e9a590ee-eb88-3fa8-9787-6cb626b3a3a7",
                        "source_sense_id": "75ad91a9-e895-3e43-8a75-2eb25471a836",
                        "source_sense_description": "von Sturm gepeitschter Wasseranstau an Küsten",
                        "target_lang_word": "storm surge",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "storm surge",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0a35e3a1-49bd-3a9e-aaba-70215f273516",
                                        "entry_id": "bafdddd0-9994-306b-9257-89888b24a9d9",
                                        "glosses": [
                                            "An unusual rise in the sea level on a coast due to the action of high winds."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0166e7fa-5e39-4923-bb74-72b65a48f22f",
                                                "sense_id": "0a35e3a1-49bd-3a9e-aaba-70215f273516",
                                                "text": "The storm surge is defined as the difference between the observed tide and the predicted astronomical tide and is considered to be the meteorological effect on sea level."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
