    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "77ec5ed1-b9d7-35c7-ac05-77d2731cd3bb",
                    "sense_definition": "Qui est composé d'éléments de différentes natures ou d'espèces dissemblables.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "composition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette classe forme un groupe <w>hétérogène</w> avec des élèves de niveaux scolaires très différents."
                        },
                        {
                            "text": "Le musée présente une collection <w>hétérogène</w> rassemblant des peintures, des sculptures et des objets artisanaux."
                        }
                    ],
                    "synonyms": [
                        "disparate",
                        "divers",
                        "composite"
                    ],
                    "antonyms": [
                        "homogène"
                    ],
                    "common_phrases": [
                        "groupe hétérogène",
                        "ensemble hétérogène",
                        "population hétérogène"
                    ]
                },
                {
                    "sense_id": "3a7fa4bc-420e-39b0-9f10-dde602fb7c5b",
                    "sense_definition": "Qualifie un mélange dans lequel on peut distinguer plusieurs constituants à l'œil nu.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "matiere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'eau et l'huile forment un mélange <w>hétérogène</w> car les deux liquides ne se mélangent pas."
                        },
                        {
                            "text": "Le professeur a montré aux élèves comment séparer les composants d'une solution <w>hétérogène</w>."
                        }
                    ],
                    "antonyms": [
                        "homogène"
                    ],
                    "common_phrases": [
                        "mélange hétérogène",
                        "système hétérogène"
                    ]
                },
                {
                    "sense_id": "15d174f4-6424-3caa-a576-2be5449a1044",
                    "sense_definition": "Qualifie une distribution ou une répartition inégale dans l'espace ou le temps.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "distribution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La répartition <w>hétérogène</w> des précipitations sur le territoire provoque des sécheresses localisées."
                        },
                        {
                            "text": "L'étude montre des densités de population très <w>hétérogènes</w> entre le littoral et l'intérieur des terres."
                        }
                    ],
                    "synonyms": [
                        "inégal",
                        "irrégulier"
                    ],
                    "antonyms": [
                        "homogène"
                    ],
                    "common_phrases": [
                        "répartition hétérogène",
                        "distribution hétérogène"
                    ]
                },
                {
                    "sense_id": "8d753420-0219-34fe-a790-20dcbd196c34",
                    "sense_definition": "Qualifie un bois dont les cernes de printemps sont très différenciés de ceux d'été.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "matiere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chêne est considéré comme un bois <w>hétérogène</w> en raison de ses cernes de croissance bien marqués."
                        },
                        {
                            "text": "Le menuisier préfère travailler des essences régulières plutôt qu'un matériau trop <w>hétérogène</w>."
                        }
                    ],
                    "antonyms": [
                        "homogène"
                    ],
                    "common_phrases": [
                        "bois hétérogène"
                    ]
                }
            ]
        }
    ]
