                            {
                                "example_id": "bb27645b-e4ef-447b-b456-f93413e3a071",
                                "sense_id": "cc869adf-ffbd-3999-aad3-ccd191275380",
                                "text": "Het is weer de tweeënzestig die het niet doet, kunnen we die niet simpel vervangen?"
                            },
                            {
                                "example_id": "b07dd4e9-ea3c-4a51-ad68-2c583e4f18d4",
                                "sense_id": "cc869adf-ffbd-3999-aad3-ccd191275380",
                                "text": "Haar drieënzestigste verjaardag was een belangrijk moment, want haar leven werd heel anders toen ze de tweeënzestig eenmaal voorbij was."
                            }
                        ]
                    },
                    {
                        "sense_id": "d51b3b29-b674-37c6-9dff-3df49a477dc6",
                        "entry_id": "9f7d0479-a22d-3487-ba22-73bc20c955e3",
                        "glosses": [
