                "senses": [
                    {
                        "sense_id": "b914de61-96e5-3784-8bf3-32a3a878c4da",
                        "entry_id": "c186f680-6ecc-3555-9a56-69d9b0703a49",
                        "glosses": [
                            "Eigenschaft, der Öffentlichkeit (einem [breiteren] Publikum) bekannt (publik) zu sein"
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "1e35083b-db67-4eb7-bf37-d4f80bec8d1a",
                                "sense_id": "b914de61-96e5-3784-8bf3-32a3a878c4da",
                                "text": "„Turbulenzen im Familienleben und Verlockungen von Publizität und Show begleiten die Karriere eines Literaturkritikers und Ex-Professors.“"
                            },
                            {
                                "example_id": "abe2a183-c38c-4b05-a21b-288d0e6db6ac",
                                "sense_id": "b914de61-96e5-3784-8bf3-32a3a878c4da",
                                "text": "„Was nur ein Beweis dafür ist, um wieviel geschickter Lottie Grump unliebsame Publizität zu vermeiden versteht als Sir James Brown - dachte Adam.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a03df07b-2e1d-387e-b15f-2cae6ae45de1",
                        "entry_id": "c186f680-6ecc-3555-9a56-69d9b0703a49",
                        "glosses": [
                            "Eigenschaft, der Öffentlichkeit zugänglich zu sein"
                        ],
                        "tags": [
                            "Medien"
                        ],
                        "examples": [
                            {
                                "example_id": "23d370a0-c43d-4dc9-a8c4-8db89f489756",
                                "sense_id": "a03df07b-2e1d-387e-b15f-2cae6ae45de1",
                                "text": "„Die Publizität als viertes Wesensmerkmal der ‚Zeitung‘ ist – wie ihre Periodizität – ein Formbegriff und bezieht sich als solcher auf die Erscheinungsweise der ‚Zeitung‘. Publizität meint nach Groth die ‚Zugänglichkeit für jedermann und damit die allgemeine Kundbarkeit alles dessen, was die Zeitung bringt, so dass grundsätzlich jeder davon Kenntnis nehmen kann, niemand von dem Empfang des Inhaltes ausgeschlossen ist‘ (Groth 1960: 206).“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "260bfccc-6ea6-3fc1-9e47-c68c64712945",
                        "entry_id": "c186f680-6ecc-3555-9a56-69d9b0703a49",
                        "glosses": [
                            "Handlung, der Öffentlichkeit bestimmte Informationen über ein Unternehmen zugänglich zu machen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bcceb572-9ae6-4d97-9f70-aefac23f1d9c",
                                "sense_id": "260bfccc-6ea6-3fc1-9e47-c68c64712945",
                                "text": "„Publizität bedeutet die Abgabe von Informationen über die einzelnen VU. Sie soll ein Urteil über die Qualität, insbesondere die gesicherte Fähigkeit des Versicherers, seine Zahlungsversprechen zu erfüllen, ermöglichen.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
