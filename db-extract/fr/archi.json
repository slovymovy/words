                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a6d043cc-4327-3d4c-96d5-51ca21d5a178",
                                        "entry_id": "22ba2ca0-191e-35e2-ad01-041ae3c14e05",
                                        "glosses": [
                                            "Better than average, better than usual; wonderful."
                                        ],
                                        "tags": [
