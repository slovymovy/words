                                    {
                                        "sense_id": "a13da93c-aca8-35f3-9494-fea16542f61d",
                                        "entry_id": "b9a9f7c4-3f1a-3c3c-8013-b5497fc68a3e",
                                        "glosses": [
                                            "toetsinstrument waarbij de in het verlengde van de toetsen geplaatste snaren worden getokkeld"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad581abf-349b-46c2-abbc-c43ca4672283",
                                                "sense_id": "a13da93c-aca8-35f3-9494-fea16542f61d",
                                                "text": "Een klavecimbel heeft vaak twee manualen."
                                            },
                                            {
                                                "example_id": "e9f5e2ce-5a7a-4a15-8d37-90d1cce87005",
                                                "sense_id": "a13da93c-aca8-35f3-9494-fea16542f61d",
                                                "text": "Ze regelen alles, tot en met een huurbusje waar het klavecimbel straks precies in past."
                                            },
                                            {
                                                "example_id": "40a10aee-6985-4a17-a440-c3ffebc7f952",
                                                "sense_id": "a13da93c-aca8-35f3-9494-fea16542f61d",
                                                "text": "Op het Parijse conservatorium ontdekte Haïm de klavecimbel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bf726a1d-443d-43f1-802a-067773588d74",
                        "source_entry_id": "a3272bae-f119-35c5-9374-846f9bbd7135",
                        "source_sense_id": "d5f03f8a-544c-3c25-85dc-3d8bf9029e56",
                        "source_sense_description": "musical instrument",
                        "target_lang_word": "clavecin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clavecin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4f7492ff-33c8-383a-ad42-9a2f0594b1ca",
                                        "entry_id": "4b2db162-c654-30e8-8edc-66f3518d2ab6",
                                        "glosses": [
                                            "Instrument de musique, longue épinette à un ou plusieurs claviers dont les cordes sont de métal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b5a3f04-91df-4bfb-b1c6-f493bff2e877",
                                                "sense_id": "4f7492ff-33c8-383a-ad42-9a2f0594b1ca",
                                                "text": "Il entendit Herman jouer sa Coquette, pièce de clavecin qui faisait fureur dans les salons."
                                            },
                                            {
                                                "example_id": "4c7ba97a-9263-4008-82c1-2eaa70f4ce2c",
                                                "sense_id": "4f7492ff-33c8-383a-ad42-9a2f0594b1ca",
                                                "text": "Tenant dans ses bras Marie, âgée de trois ans, il la présentait avec orgueil aux ambassadeurs étrangers et voulait qu'elle jouât du clavecin en leur présence. C’était merveille de voir courir de si faibles doigts sur les touches avec précision et rapidité."
                                            },
                                            {
                                                "example_id": "5c32dc9e-3b29-4ae9-946a-1aececfeb3f0",
                                                "sense_id": "4f7492ff-33c8-383a-ad42-9a2f0594b1ca",
                                                "text": "Un instant après on entendit Andrée attaquer vigoureusement les touches de son clavecin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f82f0618-376f-475c-839e-840d29f30edd",
                        "source_entry_id": "a3272bae-f119-35c5-9374-846f9bbd7135",
                        "source_sense_id": "d5f03f8a-544c-3c25-85dc-3d8bf9029e56",
                        "source_sense_description": "musical instrument",
                        "target_lang_word": "Spinett",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Spinett",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d2a8536f-7a86-3948-bbf7-4755c0cf596d",
                                        "entry_id": "9b80fc8f-6ddd-332d-a1bb-0e44c33c8a9a",
                                        "glosses": [
                                            "vom 16. bis 18. Jahrhundert verbreitete Kleinform des Cembalos, dessen Saiten schräg-seitlich zur Klaviatur verlaufen"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd700200-4705-4117-87b7-2c341e4a6046",
                                                "sense_id": "d2a8536f-7a86-3948-bbf7-4755c0cf596d",
                                                "text": "Das Spinett ist ein Vorläufer des Klaviers, das in Deutschland sehr beliebt war."
                                            },
                                            {
                                                "example_id": "b62f458f-7fa2-4c3d-beca-d09bd5686d04",
                                                "sense_id": "d2a8536f-7a86-3948-bbf7-4755c0cf596d",
                                                "text": "„Schon als sie ein kleines Kind war, hatte das Spinett der Mutter eine magische Anziehung auf sie ausgeübt.“"
                                            },
                                            {
                                                "example_id": "2119b2db-6819-4213-8987-8235e9cb8507",
                                                "sense_id": "d2a8536f-7a86-3948-bbf7-4755c0cf596d",
                                                "text": "„Auf Drängen von Don Sancho setzte sich nach Tisch Bellino – so hieß der Kastrat, der die Primadonna spielte – an das Spinett und begleitete sich zu einer Arie, die er mit Engelsstimme und betörender Anmut sang.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4d5feea7-b4aa-4cb4-ad45-0e9b636439e5",
                        "source_entry_id": "a3272bae-f119-35c5-9374-846f9bbd7135",
                        "source_sense_id": "d5f03f8a-544c-3c25-85dc-3d8bf9029e56",
                        "source_sense_description": "musical instrument",
                        "target_lang_word": "Cembalo",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Cembalo",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "16e58b37-e9ec-3f6e-8733-172f5d848985",
                                        "entry_id": "9e75ee6e-a456-3546-844b-fbd9578c1423",
                                        "glosses": [
                                            "Tasteninstrument in Form eines Flügels mit Zupfmechanik (Kurzform für Clavicembalo)"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1747224b-1603-461a-b886-b8523e194c95",
                                                "sense_id": "16e58b37-e9ec-3f6e-8733-172f5d848985",
                                                "text": "„Ohne es zu merken, war ich aufgestanden und lauschte den glasfeinen Tönen und perlenden Glissandi eines Cembalos oder Spinetts, die wie ein kühler, belebender Lufthauch durch das stickige Treppenhaus des Wehrturms strichen.“"
                                            },
                                            {
                                                "example_id": "7858d390-c157-4a4f-a417-b9760526fb98",
                                                "sense_id": "16e58b37-e9ec-3f6e-8733-172f5d848985",
                                                "text": "„Er entdeckte auf dem Cembalo zehn oder zwölf Datteln und aß sie auf.“"
                                            },
                                            {
                                                "example_id": "5ea580cd-9a13-4301-90c2-1519df963d9e",
                                                "sense_id": "16e58b37-e9ec-3f6e-8733-172f5d848985",
                                                "text": "„Der dünne Silberklang des Cembalos zitterte manchmal ein wenig wie das Werk einer Spieldose.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
