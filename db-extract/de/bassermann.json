                ],
                "senses": [
                    {
                        "sense_id": "9d24f8ae-c8b4-316a-b63e-9712b538885d",
                        "entry_id": "97597759-7f74-3b78-b5bb-03ed24340733",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87ea4ecd-5774-4b03-b8b2-3f9b2c14450e",
                                "sense_id": "9d24f8ae-c8b4-316a-b63e-9712b538885d",
                                "text": "Frau Bassermann ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "809f38b1-1907-44fd-b8b2-8a24c77c92c0",
                                "sense_id": "9d24f8ae-c8b4-316a-b63e-9712b538885d",
                                "text": "Herr Bassermann wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "3164edb6-6c96-4db5-b79a-600e48fc009f",
                                "sense_id": "9d24f8ae-c8b4-316a-b63e-9712b538885d",
                                "text": "Die Bassermanns fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "3c86f43d-0c88-4664-a38a-8d7b4c86e60e",
                                "sense_id": "9d24f8ae-c8b4-316a-b63e-9712b538885d",
                                "text": "Der Bassermann trägt nie die Schals, die die Bassermann ihm strickt."
                            },
                            {
                                "example_id": "92d82f01-d160-4194-b31b-ba930e90578f",
                                "sense_id": "9d24f8ae-c8b4-316a-b63e-9712b538885d",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Bassermann kommt, geht der Herr Bassermann.“"
                            },
                            {
                                "example_id": "8d5d496e-e94e-4483-9527-ce30a1dce128",
                                "sense_id": "9d24f8ae-c8b4-316a-b63e-9712b538885d",
                                "text": "Bassermann kommt und geht."
                            },
                            {
                                "example_id": "014353b6-413b-4bae-b17f-047bf4305a61",
                                "sense_id": "9d24f8ae-c8b4-316a-b63e-9712b538885d",
                                "text": "Bassermanns kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
