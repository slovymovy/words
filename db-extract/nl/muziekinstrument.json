                        "entry_id": "18f851ea-bc81-3f20-b288-2a3df5b0fe00",
                        "glosses": [
                            "instrument om muziek mee te spelen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec94b7e9-2796-4efa-a1d6-6d0109fdffcb",
                                "sense_id": "52b384a0-7caa-3633-9589-d9148420bcf9",
                                "text": "Jan koos voor een gitaar toen hij een muziekinstrument mocht kiezen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "823b6816-2926-4a09-a957-4aa97cbfb93b",
                        "source_entry_id": "18f851ea-bc81-3f20-b288-2a3df5b0fe00",
                        "source_sense_id": "52b384a0-7caa-3633-9589-d9148420bcf9",
                        "source_sense_description": "instrument om muziek mee te spelen",
                        "target_lang_word": "Musikinstrument",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Musikinstrument",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ff27c35e-d4ad-3432-b542-e2161d05baf4",
                                        "entry_id": "bb364006-ca9d-311b-9faf-1bb42454cc53",
                                        "glosses": [
                                            "manuelle, klangerzeugende Apparatur, auf der Musik gespielt wird"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5fedcb44-5e69-4b82-85cd-17f2ff735b62",
                                                "sense_id": "ff27c35e-d4ad-3432-b542-e2161d05baf4",
                                                "text": "Zur Ausstattung eines Orchesters werden viele Musikinstrumente benötigt."
                                            },
                                            {
                                                "example_id": "03cbbd62-f938-422c-8302-2be556bb5039",
                                                "sense_id": "ff27c35e-d4ad-3432-b542-e2161d05baf4",
                                                "text": "Jedes Musikinstrument wird von einem Musiker gespielt."
                                            },
                                            {
                                                "example_id": "73c27d4f-88e8-41b2-91e3-708d2385e2b2",
                                                "sense_id": "ff27c35e-d4ad-3432-b542-e2161d05baf4",
                                                "text": "„Einige brachten ihre Musikinstrumente mit.“"
                                            },
                                            {
                                                "example_id": "b82836e9-a0fe-4ef4-b153-f663b0ca1bdf",
                                                "sense_id": "ff27c35e-d4ad-3432-b542-e2161d05baf4",
                                                "text": "„Wovon hängt es ab, ob ein Musikinstrument zu den Holz- oder Blechblasinstrumenten gehört?“"
                                            },
                                            {
                                                "example_id": "79fce241-eebd-4879-a79f-61a0b06b0b70",
                                                "sense_id": "ff27c35e-d4ad-3432-b542-e2161d05baf4",
                                                "text": "„Ein paar Leute mit Musikinstrumenten stellten sich in der Mitte des Bahnsteigs auf.“"
                                            },
                                            {
                                                "example_id": "3d97661d-b976-454b-9f02-cccdcb577d51",
                                                "sense_id": "ff27c35e-d4ad-3432-b542-e2161d05baf4",
                                                "text": "„Einige Gäste haben Musikinstrumente mit, ein Frauenzimmer tanzt auf dem Flügel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f384f285-2c27-4e70-8727-b725f1793342",
                        "source_entry_id": "18f851ea-bc81-3f20-b288-2a3df5b0fe00",
