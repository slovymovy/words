                                    },
                                    {
                                        "sense_id": "8fc62a9f-0bb7-3ab4-b64a-a0fc254f3055",
                                        "entry_id": "9d10c96d-b215-3150-a5bc-d9b07ff4b940",
                                        "glosses": [
                                            "Physical appendage.",
                                            "Any short peptide sequence artificially attached to proteins mostly in order to help purify, solubilize or visualize these proteins."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d5af122a-501a-31a5-9040-b74098a771b6",
                                        "entry_id": "9d10c96d-b215-3150-a5bc-d9b07ff4b940",
                                        "glosses": [
                                            "Physical appendage.",
                                            "Something mean and paltry; the rabble, originally refer to rag as torn cloth."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dba5b1b0-e7d8-4eaa-9fd0-854cb81ec474",
                                                "sense_id": "d5af122a-501a-31a5-9040-b74098a771b6",
                                                "text": "For upon the like Proclamation there, they all came in, both tag and rag"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e48db92-4bbe-398f-a5e1-59c7b0085799",
                                        "entry_id": "9d10c96d-b215-3150-a5bc-d9b07ff4b940",
                                        "glosses": [
                                            "Last nonphysical appendage.",
                                            "The last line (or last two lines) of a song's chorus that is repeated to indicate the end of the song."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3276f865-e287-3af7-803f-5f71f106f2e9",
                                        "entry_id": "9d10c96d-b215-3150-a5bc-d9b07ff4b940",
                                        "glosses": [
                                            "Last nonphysical appendage.",
                                            "The last scene of a TV program, often focusing on the program's subplot."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d73bf19a-87c6-45de-a076-de6b1f3d4edc",
                                                "sense_id": "3276f865-e287-3af7-803f-5f71f106f2e9",
                                                "text": "Often, the tag punctuates the \"we're all in this together\" theme and is topped with a laugh."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee514360-394f-3959-85c4-7442e698c1d3",
                                        "entry_id": "9d10c96d-b215-3150-a5bc-d9b07ff4b940",
                                        "glosses": [
                                            "Last nonphysical appendage.",
                                            "The end, or catchword, of an actor's speech; cue."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ff2ea37e-7bf7-3027-b8d4-24c6e33e9dfc",
                                        "entry_id": "9d10c96d-b215-3150-a5bc-d9b07ff4b940",
                                        "glosses": [
                                            "Nonphysical label.",
                                            "An attribution in narrated dialogue (eg, \\\"he said\\\") or attributed words (e.g. \\\"he thought\\\")."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4049c78-ee6a-43a6-95d5-b9daa171e3fd",
                                                "sense_id": "ff2ea37e-7bf7-3027-b8d4-24c6e33e9dfc",
                                                "text": "If you want to start with talk, stick a tag in right away"
                                            },
                                            {
                                                "example_id": "d8a42f22-b7c0-4b4e-8455-76facfb0389e",
                                                "sense_id": "ff2ea37e-7bf7-3027-b8d4-24c6e33e9dfc",
                                                "text": "Seems here like Russ would be speaking. You could use a tag here."
                                            },
                                            {
                                                "example_id": "3bb5317f-8ee3-4b97-9be9-f38918f3edba",
                                                "sense_id": "ff2ea37e-7bf7-3027-b8d4-24c6e33e9dfc",
                                                "text": "You could combine these two paragraphs, I think, and rewrite to lose the tag portion of the third sentence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29f33c27-b143-3e77-a222-7c730f57f691",
                                        "entry_id": "9d10c96d-b215-3150-a5bc-d9b07ff4b940",
                                        "glosses": [
                                            "Nonphysical label.",
                                            "A piece of markup representing an element in a markup language."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5bddb21-9bac-4e66-aea3-121a17aa81cc",
                                                "sense_id": "29f33c27-b143-3e77-a222-7c730f57f691",
                                                "text": "The <title> tag provides a title for the Web page."
                                            },
                                            {
                                                "example_id": "c9f4a5c2-f198-4ab5-a23b-48d0ecf665e0",
                                                "sense_id": "29f33c27-b143-3e77-a222-7c730f57f691",
                                                "text": "The <sarcasm> tag conveys sarcasm in Internet slang."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f0806e9-5e57-350e-bb53-caf71dc9a36c",
                                        "entry_id": "9d10c96d-b215-3150-a5bc-d9b07ff4b940",
                                        "glosses": [
                                            "Nonphysical label.",
                                            "A keyword, term, or phrase associated with or assigned to data, media, and/or information enabling keyword-based classification; often used to categorize content."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38ac2632-73d3-49f3-8d94-09cbd766eb36",
                                                "sense_id": "8f0806e9-5e57-350e-bb53-caf71dc9a36c",
                                                "text": "I want to add genre and artist tags to the files in my music collection."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c781d80d-95df-3c77-bf47-0b826231e819",
                                        "entry_id": "9d10c96d-b215-3150-a5bc-d9b07ff4b940",
                                        "glosses": [
                                            "Identity.",
                                            "A vehicle number plate; a medal bearing identification data (animals, soldiers)."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1cdb71c1-2f8b-447c-a779-48f8abef4f87",
                                                "sense_id": "c781d80d-95df-3c77-bf47-0b826231e819",
                                                "text": "The subwoofer in the trunk was so loud, it vibrated the tag like an aluminum can."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8aa53e4a-75d2-3356-9bc7-4fef5e1d48a9",
                                        "entry_id": "9d10c96d-b215-3150-a5bc-d9b07ff4b940",
                                        "glosses": [
                                            "Identity.",
                                            "A person's name."
