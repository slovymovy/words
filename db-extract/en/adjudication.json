                    },
                    {
                        "translation_id": "dc76ba33-5f66-4974-aab6-73c62cdd32e4",
                        "source_entry_id": "356b8b98-60d5-3831-ac1f-4265852861cd",
                        "source_sense_description": "judgment",
                        "target_lang_word": "jugement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jugement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "99a0aacf-00f6-3849-969d-6ae662077fe9",
                                        "entry_id": "6c661c3d-cc3e-331e-a8e6-e14a89556c37",
                                        "glosses": [
                                            "Décision rendue par un tribunal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9afef674-9ce5-4c1b-ad32-34fe454a9767",
                                                "sense_id": "99a0aacf-00f6-3849-969d-6ae662077fe9",
                                                "text": "Écoutez la voix de la justice et de la raison ; elle vous crie que les jugements humains ne sont jamais assez certains pour que la société puisse donner la mort à un homme condamné par d'autres hommes sujets à l'erreur."
                                            },
                                            {
                                                "example_id": "1cba08eb-cd99-4066-9d3e-e04ef8edb8cf",
                                                "sense_id": "99a0aacf-00f6-3849-969d-6ae662077fe9",
                                                "text": "Quelques maisons furent livrées au pillage, et trois des principaux habitants fusillés par jugement du conseil de guerre, exécution qui ne violait pas la capitulation, dont les clauses avaient mis les Véronais à la discrétion des vainqueurs."
                                            },
                                            {
                                                "example_id": "351bf25c-37d8-48e7-8e38-1671829d9a76",
                                                "sense_id": "99a0aacf-00f6-3849-969d-6ae662077fe9",
                                                "text": "Des créanciers récalcitrants ont obtenu un jugement contre moi et mon compte est bloqué chez Hachette."
                                            },
                                            {
                                                "example_id": "59f53ca3-1249-4b2c-b4aa-51f0c16eb5f8",
                                                "sense_id": "99a0aacf-00f6-3849-969d-6ae662077fe9",
                                                "text": "[…], la comtesse fit incarcérer le meurtrier et, après jugement, celui-ci fut pendu. L'exécution eut lieu le jour de Pourim."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b67a563-4581-36de-807d-dca2e910b609",
                                        "entry_id": "6c661c3d-cc3e-331e-a8e6-e14a89556c37",
                                        "glosses": [
                                            "Évaluation par Dieu de l’âme du défunt pour l'orienter vers l'enfer ou vers le paradis."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c276600-07c7-49d9-a133-c1573a24fa93",
                                                "sense_id": "9b67a563-4581-36de-807d-dca2e910b609",
                                                "text": "Il avait quatre-vingt-trois ans , quand Mahmoud, approchant de la mort et du Jugement, voulu expier, réparer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f488a69-4ac9-382c-8321-843539af6512",
                                        "entry_id": "6c661c3d-cc3e-331e-a8e6-e14a89556c37",
                                        "glosses": [
                                            "Approbation ou condamnation d'ordre moral."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7ae7335-fe45-4536-86af-18d12c14bd44",
                                                "sense_id": "6f488a69-4ac9-382c-8321-843539af6512",
                                                "text": "Un jugement favorable, charitable."
                                            },
                                            {
                                                "example_id": "524e5c7d-9398-49c1-bca8-9e8d8fb56996",
                                                "sense_id": "6f488a69-4ac9-382c-8321-843539af6512",
                                                "text": "Vous pensez mal de votre prochain, vous en faites de mauvais jugements."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59259d44-c58e-30cf-a80f-a062b3337fa2",
                                        "entry_id": "6c661c3d-cc3e-331e-a8e6-e14a89556c37",
                                        "glosses": [
                                            "Acte par lequel on affirme ou nie une chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "477d992f-c8b7-4377-afb3-9c64ce9cb0ba",
                                                "sense_id": "59259d44-c58e-30cf-a80f-a062b3337fa2",
                                                "text": "Tout jugement qu’on exprime est une proposition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21e32c10-c744-31c7-8668-ddc00673e448",
                                        "entry_id": "6c661c3d-cc3e-331e-a8e6-e14a89556c37",
                                        "glosses": [
                                            "Faculté de l’entendement qui compare et qui juge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b589682-5e8f-4cef-ae8d-314e5100f567",
                                                "sense_id": "21e32c10-c744-31c7-8668-ddc00673e448",
                                                "text": "Le plus souvent, il ne trouvait pas grand’chose à lui répondre, toujours plus étonné de rencontrer autant de jugement dans une si petite tête."
                                            },
                                            {
                                                "example_id": "a8ffc4e9-d7d5-4932-b599-011f84654e15",
                                                "sense_id": "21e32c10-c744-31c7-8668-ddc00673e448",
                                                "text": "[…]; nous travaillâmes désormais ensemble, avec un accord et une communauté de jugement qu'il est rare de trouver entre deux hommes."
                                            },
                                            {
                                                "example_id": "06a2b0a3-028a-4213-97cc-bf6c9a68450a",
                                                "sense_id": "21e32c10-c744-31c7-8668-ddc00673e448",
                                                "text": "Il a le jugement bon, le jugement solide, le jugement sain."
                                            },
                                            {
                                                "example_id": "351fcf0d-7c28-42f5-b6d8-e16ba3913b54",
                                                "sense_id": "21e32c10-c744-31c7-8668-ddc00673e448",
                                                "text": "C’est un homme de bon jugement, de grand jugement."
                                            },
                                            {
                                                "example_id": "bd048b1e-d43b-4cc9-bc9e-77c0c1b68b00",
                                                "sense_id": "21e32c10-c744-31c7-8668-ddc00673e448",
                                                "text": "Il est dénué de jugement."
                                            },
                                            {
                                                "example_id": "58e93e81-2714-46cc-8461-0ce9a4e21a60",
                                                "sense_id": "21e32c10-c744-31c7-8668-ddc00673e448",
                                                "text": "Il a de l’esprit, mais il n’a point de jugement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e5abc9a-b042-32df-a0ab-bd9d10b4d71c",
                                        "entry_id": "6c661c3d-cc3e-331e-a8e6-e14a89556c37",
                                        "glosses": [
                                            "Avis, sentiment, opinion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3abf992-379b-4eec-a208-7c07f7ab3f43",
                                                "sense_id": "4e5abc9a-b042-32df-a0ab-bd9d10b4d71c",
                                                "text": "… les jugements sont les actions de notre esprit, lorsqu'après avoir assemblé plusieurs idées, il assure que l'une convient à l'autre, ou que l'une ne convient pas à l'autre."
                                            },
                                            {
                                                "example_id": "fc424da9-91a2-464c-be93-37d3be1641e8",
                                                "sense_id": "4e5abc9a-b042-32df-a0ab-bd9d10b4d71c",
                                                "text": "Le vrai, indépendant de mes caprices, doit être la règle de mes jugements ; et je ne ferai point un crime à celui-ci de ce que j’admirerai dans celui-là comme une vertu."
                                            },
                                            {
                                                "example_id": "16b7b037-c10a-41ed-8952-0d406d1ea91c",
                                                "sense_id": "4e5abc9a-b042-32df-a0ab-bd9d10b4d71c",
                                                "text": "Les sociologues savent bien que les jugements en disent souvent plus sur leurs auteurs que sur les choses dont ils parlent."
                                            },
                                            {
                                                "example_id": "366d00d2-9eac-4aae-8a95-ce1957946aa3",
                                                "sense_id": "4e5abc9a-b042-32df-a0ab-bd9d10b4d71c",
                                                "text": "Porter, donner son jugement sur quelque chose, sur un écrit, sur un ouvrage, sur un auteur."
                                            },
                                            {
                                                "example_id": "6a813bbd-4c91-41a4-ba8a-88e0241b30c0",
                                                "sense_id": "4e5abc9a-b042-32df-a0ab-bd9d10b4d71c",
                                                "text": "Asseoir, fonder son jugement sur un fait précis."
                                            },
                                            {
                                                "example_id": "641da6f0-0a58-4705-b047-5fa218bc9e44",
                                                "sense_id": "4e5abc9a-b042-32df-a0ab-bd9d10b4d71c",
                                                "text": "Le jugement de l’histoire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e98e52cb-7a71-32c8-a05f-2433af2d8c82",
                                        "entry_id": "6c661c3d-cc3e-331e-a8e6-e14a89556c37",
                                        "glosses": [
                                            "Vingtième atout du tarot de Marseille."
                                        ],
                                        "tags": [
                                            "Cartes à jouer"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aa51fc29-78ca-4942-a58b-064c148e548d",
                        "source_entry_id": "356b8b98-60d5-3831-ac1f-4265852861cd",
