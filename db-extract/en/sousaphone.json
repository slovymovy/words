                    },
                    {
                        "translation_id": "325a68a0-5966-463b-a39d-710ba796ac72",
                        "source_entry_id": "66544db8-3ecb-3c13-b54d-bfbd5d276618",
                        "source_sense_id": "a9738d5b-b913-3ac8-8d37-5aa1c522b7af",
