                        "entry_id": "54afb6f2-290b-3703-908b-52d12fdca1c6",
                        "glosses": [
                            "Vorgang, bei dem Wasser mit Hilfe von Gleichstrom in Wasserstoff und Sauerstoff zerlegt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de725093-1441-454c-951c-5690e8facbd3",
                                "sense_id": "599001c5-99b8-36a3-b673-46b5230960e5",
                                "text": "„Einige Stahlkonzerne optimieren die Wasserelektrolyse gerade in Pilotanlagen.“"
                            },
                            {
                                "example_id": "4475db86-2572-4e6f-93f1-cc2a0fcfcc1c",
                                "sense_id": "599001c5-99b8-36a3-b673-46b5230960e5",
                                "text": "„In der saudiarabischen Wüste, 40 Kilometer nordwestlich der Hauptstadt Riad, wird seit Anfang des Monats erstmals die technische Produktion von Wasserstoff durch direkte Kopplung von solarer Stromerzeugung und Wasserelektrolyse in großem Stil erprobt.“"
                            }
                        ],
