                    {
                        "sense_id": "4899ebe2-7bc4-3b5b-ab22-7828449ff19c",
                        "entry_id": "180c87e9-013e-3c43-8ff0-f0bbc1e4f26c",
                        "glosses": [
                            "door lezen iets opnieuw tot je nemen; opnieuw lezen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5df5cff6-ed21-473b-9a92-99782738d82e",
                                "sense_id": "4899ebe2-7bc4-3b5b-ab22-7828449ff19c",
                                "text": "Als je het niet meer precies weet kun je het in de de notulen teruglezen."
                            },
                            {
                                "example_id": "96db60cf-7a34-4e6c-acf5-be9c69d2b75c",
                                "sense_id": "4899ebe2-7bc4-3b5b-ab22-7828449ff19c",
                                "text": "Je kunt het liveblog van dag 2 van de Algemene Politieke Beschouwingen hier teruglezen."
                            },
                            {
                                "example_id": "dc42ece2-9a0d-4910-996a-3f7d5865044f",
                                "sense_id": "4899ebe2-7bc4-3b5b-ab22-7828449ff19c",
                                "text": "Op de website nos.nl/75jaarbevrijding worden nog tot en met woensdag 2 september nieuwe verhalen geplaatst. Je kunt er alle artikelen van het afgelopen jaar ook teruglezen."
                            }
                        ]
                    }
