                        "entry_id": "e0edc8bb-a753-3207-8823-93a0798cc0c6",
                        "glosses": [
                            "belangrijk persoon die als gast met extra grote eer wordt ontvangen en door zijn komst ook extra eer geeft aan de bijeenkomst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b395ae94-53f9-4147-a466-511606413b34",
                                "sense_id": "3d261fd3-66fb-32f3-8883-5b0f8f028148",
                                "text": "De koning was als eregast uitgenodigd op het feest."
                            },
                            {
                                "example_id": "1b256138-3197-4dac-bdd4-e5e04724855b",
                                "sense_id": "3d261fd3-66fb-32f3-8883-5b0f8f028148",
                                "text": "Halvemaanvormige broodjes, zogenaamde krombroodjes, worden in Sittard vanaf 1923 van een helling in de Kollenberg te grabbel gegooid voor de kinderen van de stad. Deze traditie bestaat nog steeds. Ieder jaar halverwege de vastenperiode, halfvasten, worden zo'n 15.000 broodjes uitgegooid door het Sittardse Krombroodcomité en een jaarlijkse eregast ."
                            }
                        ]
                    }
