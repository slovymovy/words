                                                "sense_id": "43a88db7-d286-3754-bac0-acecbd583d18",
                                                "text": "Die Kosten haben sich verringert."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
