                    },
                    {
                        "translation_id": "ab05144c-dfd9-4607-9829-ebf4821578b4",
                        "source_entry_id": "708b6d82-967c-3b9c-8449-a711835560ac",
                        "source_sense_description": "something that is instrumental; an instrument",
                        "target_lang_word": "Werkzeug",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Werkzeug",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "10dbe21e-f3a1-3279-b36f-2d1d715988d1",
                                        "entry_id": "3cf0551a-a41f-3065-8f58-bc7918b50561",
                                        "glosses": [
                                            "allgemeines Mittel oder Gerät, um Dinge herzustellen oder zu reparieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e81f47fc-424e-46c7-8f16-7fc81003c942",
                                                "sense_id": "10dbe21e-f3a1-3279-b36f-2d1d715988d1",
                                                "text": "Der Hammer ist ein Werkzeug, welches in jedem guten Haushalt vorhanden sein sollte."
                                            },
                                            {
                                                "example_id": "abf1334b-3eca-46bf-9b36-914aa8527c98",
                                                "sense_id": "10dbe21e-f3a1-3279-b36f-2d1d715988d1",
                                                "text": "Die sinnvolle Benutzung eines Werkzeuges unterscheidet den Mensch von Tier."
                                            },
                                            {
                                                "example_id": "6f3f7b7a-a069-415b-af57-1d7707063042",
                                                "sense_id": "10dbe21e-f3a1-3279-b36f-2d1d715988d1",
                                                "text": "Der Handwerker bringt sein eigenes Werkzeug auf die Baustelle."
                                            },
                                            {
                                                "example_id": "ece4f878-4f89-46a7-99c8-697a8babfbad",
                                                "sense_id": "10dbe21e-f3a1-3279-b36f-2d1d715988d1",
                                                "text": "„Werkzeug bedeutete mir viel.“"
                                            },
                                            {
                                                "example_id": "1bb29d53-76c1-45b2-affc-a3379422113d",
                                                "sense_id": "10dbe21e-f3a1-3279-b36f-2d1d715988d1",
                                                "text": "„Der Mensch ist ein Werkzeuge benutzendes Wesen. Er vermag Werkzeuge zu gebrauchen und zu fertigen; mit ihnen verwandelt er den gigantischen Fels in Staub und formt glühendes Eisen wie weiches Wachs. Nirgends findet man ihn ohne Werkzeuge; ohne Werkzeuge ist er Nichts, mit Werkzeugen vermag er alles.“"
                                            },
                                            {
                                                "example_id": "3b16db1f-5377-4751-a252-a5ccf55e7697",
                                                "sense_id": "10dbe21e-f3a1-3279-b36f-2d1d715988d1",
                                                "text": "„Als er fertig war, wusch er sein Werkzeug und ging nach Hause, um Abendbrot zu essen.“"
                                            },
                                            {
                                                "example_id": "58b88b99-b89a-44aa-a4e3-12b37f9cf1b6",
                                                "sense_id": "10dbe21e-f3a1-3279-b36f-2d1d715988d1",
                                                "text": "„Obwohl noch unschlüssig, stellte ich etwas fest, das war alles; voll Anmut sagte sie nun einige Verse zu Ehren des Werkzeugs der Fortpflanzung und des Liebesaktes.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "40d50f9f-1ede-45ad-830c-48a16e0126df",
                        "source_entry_id": "708b6d82-967c-3b9c-8449-a711835560ac",
