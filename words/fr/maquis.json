                        "combattants du maquis",
                        "prendre le maquis"
                    ]
                },
                {
                    "sense_id": "8f7ccd70-aa48-35d5-b5a9-eefe5d82fee6",
                    "sense_definition": "Ensemble particulièrement obscur, confus et complexe de règles, de textes ou de formalités où l'on a du mal à se repérer.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "figurative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est difficile pour les nouveaux entrepreneurs de s'orienter dans ce véritable <w>maquis</w> administratif."
