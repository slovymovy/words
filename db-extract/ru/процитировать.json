                ],
                "translations": [
                    {
                        "translation_id": "488c646f-25a9-4bfb-be69-0a93b748a875",
                        "source_entry_id": "c6908417-3950-3237-b54b-8845eb5d87a6",
                        "source_sense_id": "2b442a93-5414-3cf8-9cce-3f1ebb6dfb96",
                        "target_lang_word": "cite",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2010a2c4-144e-390d-81f4-63a70a2582f7",
                                        "entry_id": "4d2eba9a-8174-3540-a71b-992c383004d3",
                                        "glosses": [
                                            "To quote; to repeat, as a passage from a book, or the words of another."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a403b34-7f73-47a4-a4d6-657fd03d86bf",
                                                "sense_id": "2010a2c4-144e-390d-81f4-63a70a2582f7",
                                                "text": "WikiLeaks did not cause these uprisings but it certainly informed them. The dispatches revealed details of corruption and kleptocracy that many Tunisians suspected, but could not prove, and would cite as they took to the streets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8abc8fc4-77a8-39ab-b4a1-fc3ae6522334",
                                        "entry_id": "4d2eba9a-8174-3540-a71b-992c383004d3",
                                        "glosses": [
                                            "To mention; to make mention of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc5ccecd-1db4-4112-aff7-a52916618801",
                                                "sense_id": "8abc8fc4-77a8-39ab-b4a1-fc3ae6522334",
                                                "text": "Until then, the Sunak administration remains a study in ineffectuality on multiple fronts, leading Goldsmith to cite, not unreasonably, “a kind of paralysis”."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d048de78-0e7e-3353-938f-f5745de69468",
                                        "entry_id": "4d2eba9a-8174-3540-a71b-992c383004d3",
                                        "glosses": [
                                            "To mention; to make mention of.",
                                            "To mention by way of explanation."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fde6caba-7431-4e88-b470-9ae1c19317c0",
                                                "sense_id": "d048de78-0e7e-3353-938f-f5745de69468",
                                                "text": "Citing the risk involved with being out as a gay person and a union activist while simultaneously dealing with racism, Susan notes that there are no out gays or lesbians of color in her local, though its membership is about 80 percent people of color."
                                            },
                                            {
                                                "example_id": "dc5489c8-9a1a-468b-82b1-df7baf7d3e04",
                                                "sense_id": "d048de78-0e7e-3353-938f-f5745de69468",
                                                "text": "Jonathan Hill, professor of international relations in the School of Security Studies at King’s College London, points to ongoing social unrest among rural youths in Morocco as another key reason why the law was passed. He cites the 2011 Arab Spring as an indicator of where such behaviour might lead if left unchecked."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1aeb6f4-23df-367c-a02a-a276a27dc95e",
                                        "entry_id": "4d2eba9a-8174-3540-a71b-992c383004d3",
                                        "glosses": [
                                            "To list the source(s) from which one took information, words or literary or verbal context."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3bc7d581-8bb9-3885-9960-b79cd808c090",
                                        "entry_id": "4d2eba9a-8174-3540-a71b-992c383004d3",
                                        "glosses": [
                                            "To summon officially or authoritatively to appear in court."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "055a7c2f-91cc-4d5e-a96f-54c0828f1cbb",
                                                "sense_id": "3bc7d581-8bb9-3885-9960-b79cd808c090",
                                                "text": "According to the tribe’s chairman, rangers cited five of the demonstrators, who had traveled to Nevada from New York, Washington, California and the European country of Malta. The chairman did not say what they were cited for."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3c1f4002-cddc-3e38-9043-714a828494a8",
                                        "entry_id": "a1e5482f-68bb-35f0-b541-8617074c9f28",
                                        "glosses": [
                                            "A citation."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1b867fd-a5a6-4a68-a986-921bc3b91080",
                                                "sense_id": "3c1f4002-cddc-3e38-9043-714a828494a8",
                                                "text": "We used the number of cites as a rough measure of the significance of each published paper."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "55bfb104-59e6-4459-a3ef-11689b612d7b",
                        "source_entry_id": "c6908417-3950-3237-b54b-8845eb5d87a6",
                        "source_sense_id": "2b442a93-5414-3cf8-9cce-3f1ebb6dfb96",
                        "target_lang_word": "quote",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quote",
