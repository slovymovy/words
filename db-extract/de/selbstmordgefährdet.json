                "senses": [
                    {
                        "sense_id": "d5c5b2b8-d5d2-37cb-a130-6d10861df160",
                        "entry_id": "125e2011-5abc-3e03-90d2-1f503a511a1d",
                        "glosses": [
                            "in einem Zustand, bei dem die Gefahr besteht, Selbstmord zu begehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "491210ef-5d76-4c8c-93e6-fb41e3b3b475",
                                "sense_id": "d5c5b2b8-d5d2-37cb-a130-6d10861df160",
                                "text": "„Ohne Quatsch, so was kommt gar nicht selten vor, und auch das St. Anthony’s muss eine bestimmte Zahl ausgesetzter Omas und von Ecstasy um den Verstand gebrachter Straßenmädchen und selbstmordgefährdeter Pennerinnen aufnehmen.“"
                            },
                            {
                                "example_id": "45e03939-d222-44ec-bc92-2fc6d02b5dc6",
                                "sense_id": "d5c5b2b8-d5d2-37cb-a130-6d10861df160",
                                "text": "„Dennoch - die Tatsache, dass man so gewaltsam reagierte, anstatt die Polizei zu rufen und einen Hausfriedensbruch zu melden, verriet Shaw, dass dies kein Ort für verletzliche und selbstmordgefährdete Personen war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [],
                "word_linkages": [
