                                "example_id": "a7a92575-7b47-4b1d-8867-ed0a42680133",
                                "sense_id": "3a0e11ce-fd97-3f92-a6f6-1de00a69e665",
                                "text": "Yin wordt in verband gebracht met de donkere maan (die afgekeerd is van de zon) en staat voor de vrouwelijke natuur."
                            }
                        ]
