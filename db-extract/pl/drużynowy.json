                    }
                ],
                "senses": [
                    {
                        "sense_id": "30e68b34-8288-34e4-b90f-f852a365fa53",
                        "entry_id": "b54ee8bb-4e0f-31de-88a8-b949725b2a73",
                        "glosses": [
                            "osoba opiekująca się drużyną harcerską"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b77a484-ee1f-4157-8f64-8788a04892ae",
                                "sense_id": "30e68b34-8288-34e4-b90f-f852a365fa53",
                                "text": "Płonie ognisko i szumią knieje, drużynowy jest wśród nas. Opowiada starodawne dzieje, bohaterski wskrzesza czas."
                            }
                        ],
                        "sense_index_json": "\"2.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a6e74256-d14a-4c8f-a4ab-4d7189527aeb",
                        "source_entry_id": "b54ee8bb-4e0f-31de-88a8-b949725b2a73",
                        "source_sense_id": "30e68b34-8288-34e4-b90f-f852a365fa53",
                        "target_lang_word": "звеньевой",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "звеньевой",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "3b0ef07b-3903-35ef-b20d-cf4b623f9d8b",
                                        "entry_id": "b8ab2e66-ec8a-3047-a4b6-f4c7a909cd91",
                                        "glosses": [
                                            "прилагательное от звено"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8dbd75a9-d4ff-4e27-b45c-1bf0940b67af",
                                                "sense_id": "3b0ef07b-3903-35ef-b20d-cf4b623f9d8b",
                                                "text": "Нужно только строго соблюдать звеньевой и бригадный принцип организации труда."
                                            },
                                            {
                                                "example_id": "66a45be1-2338-4fc2-a5d4-4c7314edeec0",
                                                "sense_id": "3b0ef07b-3903-35ef-b20d-cf4b623f9d8b",
                                                "text": "Тогда я особенно понял, что весь вопрос в том, чтобы уметь отделить важное от неважного, главное от неглавного, суметь выделить те звеньевые вопросы, которые рассыпаны в так называемых текущих делах, как золотинки в песке."
                                            },
                                            {
                                                "example_id": "8a38f7e8-90f1-469d-a41a-3513895e4c6f",
                                                "sense_id": "3b0ef07b-3903-35ef-b20d-cf4b623f9d8b",
                                                "text": "После вклинения в боевой порядок «Сейбров» бой распадался на звеньевые, а затем и парные схватки."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61a73c9c-e631-3f26-99c0-f3cacb14dfad",
                                        "entry_id": "b8ab2e66-ec8a-3047-a4b6-f4c7a909cd91",
                                        "glosses": [
                                            "истор., субстантивир. в структуре некоторых организаций — руководитель звена"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96907062-c4c5-49e7-bf85-ad52f9c58977",
                                                "sense_id": "61a73c9c-e631-3f26-99c0-f3cacb14dfad",
                                                "text": "Вспомнят о том, как ребята помогали отстающим по учебе, чему научились, на сборах, как всеми делами руководил звеньевой."
                                            },
                                            {
                                                "example_id": "d539b780-688b-49da-88ac-42ff754ac962",
                                                "sense_id": "61a73c9c-e631-3f26-99c0-f3cacb14dfad",
                                                "text": "За несколько дней до выборов нового вожака прежний звеньевой должен оповестить об этом всех ребят и рассказать, как подготовиться к сбору."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
