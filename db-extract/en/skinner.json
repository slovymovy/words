                                    {
                                        "sense_id": "712ad684-b99d-3b1b-9ca9-e2b6a0412369",
                                        "entry_id": "35597806-4e88-3dd0-86d4-69aaed3d848a",
                                        "glosses": [
                                            "Celui qui écorche les bêtes, les dépouille de leur peau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90855718-51f3-4b3b-a157-4e09a199e2f5",
                                                "sense_id": "712ad684-b99d-3b1b-9ca9-e2b6a0412369",
                                                "text": "Ce cheval n’est plus bon que pour l’écorcheur, qu’à envoyer à l’écorcheur."
                                            },
                                            {
                                                "example_id": "af316837-84f8-42c5-9173-e26d648a57f4",
                                                "sense_id": "712ad684-b99d-3b1b-9ca9-e2b6a0412369",
                                                "text": "De ces enceintes horribles s’échappent, avec une atmosphère chargée d’émanations fétides, des cris féroces d’écorcheurs, des aboiements sinistres de chiens, des hurlements prolongés de bêtes expirantes …"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82264765-5e68-3f41-9c93-af36450054d8",
                                        "entry_id": "35597806-4e88-3dd0-86d4-69aaed3d848a",
                                        "glosses": [
                                            "Hôtelier, homme d’affaires, commerçant qui pratique des prix abusifs."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6168b56-565b-4629-ae40-9121d2b0ee98",
                                                "sense_id": "82264765-5e68-3f41-9c93-af36450054d8",
                                                "text": "C’est un prix d’écorcheur"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5019c816-3be4-3af0-a6d6-560af92f123b",
                                        "entry_id": "35597806-4e88-3dd0-86d4-69aaed3d848a",
                                        "glosses": [
                                            "Tortionnaire."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8598550a-814a-4635-b6d6-149aec06f954",
                                                "sense_id": "5019c816-3be4-3af0-a6d6-560af92f123b",
                                                "text": "Dans les mains de ces écorcheurs, il dut avouer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
