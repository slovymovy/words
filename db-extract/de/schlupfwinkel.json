                "senses": [
                    {
                        "sense_id": "2d9e3338-cfd6-3c1f-a656-94f8e6a4e209",
                        "entry_id": "618ab1bb-d05f-3f25-ac52-5c55b4797681",
                        "glosses": [
                            "Stelle, an die man sich zurückziehen, wo man sich verstecken kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8cb28892-d13c-4cbc-9b51-20f99e2bd4f6",
                                "sense_id": "2d9e3338-cfd6-3c1f-a656-94f8e6a4e209",
                                "text": "„Mir ist, als säße ich in einem Schlupfwinkel und als hätte es noch lange keine Eile, nach Hause zu gehen.“"
                            },
                            {
                                "example_id": "b9fb33b0-57ff-4bfc-9498-6c3e61292a2f",
                                "sense_id": "2d9e3338-cfd6-3c1f-a656-94f8e6a4e209",
                                "text": "„Es war ihm klar, daß der Seeräuber ihn mit seinen Gefährten aufgehoben, um der Entdeckung seines Schlupfwinkels zu entgehen.“"
                            },
                            {
                                "example_id": "9b2ec921-0b4e-4bf8-a2ce-d089ad071cbd",
                                "sense_id": "2d9e3338-cfd6-3c1f-a656-94f8e6a4e209",
                                "text": "„Er hatte nur das Gefühl gehabt, einen Schlupfwinkel suchen zu müssen für den äußersten Fall.“"
                            },
                            {
                                "example_id": "59df5dff-266f-4822-8a4b-1ec2bc38c7d9",
                                "sense_id": "2d9e3338-cfd6-3c1f-a656-94f8e6a4e209",
                                "text": "„Noch war ja nicht einmal gewiß, daß ihr Schlupfwinkel verraten sei, denn die beiden, die ihn auskundschaften sollten, konnten unschädlich gemacht werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
