                            {
                                "example_id": "2743a275-e4cd-467e-bada-2037e4d83662",
                                "sense_id": "42a4fb1f-825f-30af-a4c6-fea5cece4fe4",
                                "text": "On compte généralement un fileur et quatre rattacheurs par 1.000 broches de renvideur et huit rattacheurs et un fileur pour 960 broches de continu."
