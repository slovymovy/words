                "translations": [
                    {
                        "translation_id": "4ac7943c-8379-493c-b73c-a24d4661cc66",
                        "source_entry_id": "cc9248ce-6c52-3bf0-bc99-2e14da11874b",
                        "source_sense_id": "69d351b6-e625-3359-8f46-fa8796320f7b",
                        "source_sense_description": "immer wenn, jedes Mal wenn",
                        "target_lang_word": "whenever",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "whenever",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9f53eb64-b5e4-3640-b8f5-224afb9f8146",
                                        "entry_id": "a7aec0be-7c00-3ff4-bcfa-d623576fc06f",
                                        "glosses": [
                                            "At any time that."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d123b81e-6fef-4343-a04d-64c87892c3c0",
                                                "sense_id": "9f53eb64-b5e4-3640-b8f5-224afb9f8146",
                                                "text": "Visit whenever you want to."
                                            },
                                            {
                                                "example_id": "c11c2b8a-7e07-45c8-a0ec-2480b9590bfa",
                                                "sense_id": "9f53eb64-b5e4-3640-b8f5-224afb9f8146",
                                                "text": "I did not see the program, but Mrs. Nixon told me that you were great on the Donahue Show.\nAs you can imagine, she is an expert on politics and she predicts that whenever you decide to run for office you will be a winner!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6e37c8f-af62-35a6-b89c-8146def31b60",
                                        "entry_id": "a7aec0be-7c00-3ff4-bcfa-d623576fc06f",
                                        "glosses": [
                                            "At the (single) time that, no matter when."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70ff364d-1c62-403d-b539-23fb8d3bc975",
                                                "sense_id": "d6e37c8f-af62-35a6-b89c-8146def31b60",
                                                "text": "Tomorrow I'll get up whenever the sun rises."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2dedb621-a1a6-3913-8d38-1fa82101edf7",
                                        "entry_id": "a7aec0be-7c00-3ff4-bcfa-d623576fc06f",
                                        "glosses": [
                                            "Every time that."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24f01463-8045-4ae4-a81a-7cd501b160c4",
                                                "sense_id": "2dedb621-a1a6-3913-8d38-1fa82101edf7",
                                                "text": "Whenever he has a pair of aces, his eyelids twitch."
                                            },
                                            {
                                                "example_id": "808e57ef-e837-4adf-9da9-0c9f38161295",
                                                "sense_id": "2dedb621-a1a6-3913-8d38-1fa82101edf7",
                                                "text": "Working around an ancient monument has meant having an archaeologist on site whenever there were excavations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36cee27a-e705-3818-906d-105d26a1a529",
                                        "entry_id": "a7aec0be-7c00-3ff4-bcfa-d623576fc06f",
                                        "glosses": [
                                            "Regardless of the time that."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05820190-9038-4ceb-a4d4-9e1114539bc0",
                                                "sense_id": "36cee27a-e705-3818-906d-105d26a1a529",
                                                "text": "Income must be reported in the period in which it is earned, whenever payment is actually received."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f641fd04-0b6c-351e-8f59-3f9a4b39ca57",
                                        "entry_id": "a7aec0be-7c00-3ff4-bcfa-d623576fc06f",
                                        "glosses": [
                                            "When."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "US",
                                            "nonstandard",
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "247dfc17-2534-44a2-96f5-6e42cb1bb84a",
                                                "sense_id": "f641fd04-0b6c-351e-8f59-3f9a4b39ca57",
                                                "text": "Whenever I was a child, I lived in Arkansas."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "whenever",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2baa98ae-dd6c-3c43-8009-2f03366d733e",
                                        "entry_id": "f79ca771-eef3-3698-97ec-e6a733c8c957",
                                        "glosses": [
                                            "When ever: emphatic form of when."
                                        ],
                                        "tags": [
                                            "interrogative"
                                        ],
                                        "examples": [
                                            {
