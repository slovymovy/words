                        "examples": [
                            {
                                "example_id": "d59c1655-4b55-4cc0-9dbb-9b7a0fd8fa34",
                                "sense_id": "325dcd0b-9119-36a6-877d-b2c6279c65fc",
                                "text": "For the sake of convenience, we may call these pointings or signifyings the secondary phase of meaning."
                            }
                        ]
