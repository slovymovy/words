                ],
                "senses": [
                    {
                        "sense_id": "cd8d3eaf-cc19-329f-9405-8c64dd98ffb7",
                        "entry_id": "cbb166fc-c8bb-3837-a4a4-b558d950ef0c",
                        "glosses": [
                            "weibliche Person, die im Wasserrettungsdienst tätig ist und dort als Spezialistin vor allem für die Rettung aus stark strömenden Gewässern sowie für die Rettung und Bergung aus Schluchten (mit Wildbach) eingesetzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02fe9ba3-4f27-4c37-8530-c7c69fbbded2",
                                "sense_id": "cd8d3eaf-cc19-329f-9405-8c64dd98ffb7",
                                "text": "„Als Strömungsretterin ist sie in die Aufgaben des Katastrophenschutzes eingebunden.“"
                            },
                            {
                                "example_id": "ef03d534-54fe-49d6-b54c-12b92925d33f",
                                "sense_id": "cd8d3eaf-cc19-329f-9405-8c64dd98ffb7",
                                "text": "„Für diese Aufgabe sollten Strömungsretter bzw. Strömungsretterinnen von DLRG oder Wasserwacht mit ihrer speziell für diese Anforderungen geeigneten Ausrüstung eingesetzt werden.“"
                            },
                            {
                                "example_id": "9fa3030a-9870-4231-9aec-37b0bb1a8ea7",
                                "sense_id": "cd8d3eaf-cc19-329f-9405-8c64dd98ffb7",
                                "text": "„Eine erste Strömungsretterin wurde bereits ausgebildet, weitere sind in Ausbildung, bereiten sich mit Grundlehrgängen vor.“"
                            },
                            {
                                "example_id": "e95ee4e5-5056-468b-b934-4ec2666c5169",
                                "sense_id": "cd8d3eaf-cc19-329f-9405-8c64dd98ffb7",
                                "text": "„Laura Hartung (20) ist den Weg zur Rettungsschwimmerin erst mit 13 Jahren gegangen. Inzwischen ist sie Ausbilderin und Strömungsretterin bei der DLRG.“"
                            },
                            {
                                "example_id": "daaa3c8c-7bc6-4088-8fe0-f76ce6f96647",
                                "sense_id": "cd8d3eaf-cc19-329f-9405-8c64dd98ffb7",
                                "text": "„Derzeit besteht die Abteilung aus drei Gruppenführern, fünf Taucheinsatzführern, sieben Einsatztauchern, drei Signalfrauen, neun Signalmännern (einer in Ausbildung), einer Bootsführerin, zwei Bootsführern, einer Strömungsretterin und drei Strömungsrettern.“"
                            },
                            {
                                "example_id": "596113ec-7689-4e4c-a453-20c5dabc6431",
                                "sense_id": "cd8d3eaf-cc19-329f-9405-8c64dd98ffb7",
                                "text": "„Schwimmen gehört zur Freizeitaktivität der jungen Frau. So will sie in Kürze die Prüfung zur Strömungsretterin ablegen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
