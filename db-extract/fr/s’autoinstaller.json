                    },
                    {
                        "sense_id": "bfd70a23-2a14-32bf-b7a6-1e349d4e82f5",
                        "entry_id": "4832fcc4-2591-3f3f-9a72-ac22d5590f20",
                        "glosses": [
                            "S’installer par soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76cb2950-62fb-4c2b-a471-2022e587c8df",
                                "sense_id": "bfd70a23-2a14-32bf-b7a6-1e349d4e82f5",
                                "text": "On répond avec cette filiale à la réalité du marché qui ne se compose pas uniquement de personnes compétentes et capables de s'autoinstaller."
                            }
                        ]
                    },
                    {
                        "sense_id": "832b1da4-e754-3fca-bb6d-ef0a908d42bc",
                        "entry_id": "4832fcc4-2591-3f3f-9a72-ac22d5590f20",
                        "glosses": [
                            "S’installer automatiquement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8623d7a5-bcaa-4483-9d9d-70c0381c3e09",
                                "sense_id": "832b1da4-e754-3fca-bb6d-ef0a908d42bc",
                                "text": "Il faut en plus de ça aller télécharger un pack de drivers/utilitaires qui est censé s'autoinstaller mais qui ne le fait qu'à moitié."
                            },
                            {
                                "example_id": "0f859040-54ab-4e35-9e7f-ae1e5864a466",
                                "sense_id": "832b1da4-e754-3fca-bb6d-ef0a908d42bc",
                                "text": "J'ai laissé Mandrake autopartitionner et s'autoinstaller dans le reste du disque dur."
                            }
                        ]
