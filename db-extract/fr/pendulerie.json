                    {
                        "sense_id": "635a9372-72c4-3f60-82ab-2d9abfe97501",
                        "entry_id": "be8e0bf7-35c3-3477-8295-0070377b0a42",
                        "glosses": [
                            "Branche de l’horlogerie spécialisée dans la fabrication et la restauration de pendules et horloges, et non de montres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4474b89f-393a-4625-92ef-9e578bb8442b",
                                "sense_id": "635a9372-72c4-3f60-82ab-2d9abfe97501",
                                "text": "Quoique la pendulerie ne fasse pas une partie essentielle de la fabrique genevoise , nous avons vu à l’exposition quelques morceaux de ce genre, qui méritent d'être notés."
                            },
                            {
                                "example_id": "fd1cb348-2d93-4b9d-8dda-765f1f694cbd",
                                "sense_id": "635a9372-72c4-3f60-82ab-2d9abfe97501",
                                "text": "Dans l’atelier de fabrication, de montage et de pendulerie installé depuis 24 ans dans la friche industrielle de la Rhodiaceta, à Besançon, devenue friche artistique, une petite armée d’horloges Hortense et Pop’Up de toutes les couleurs se dresse fièrement, comme de bons petits soldats."
                            },
                            {
                                "example_id": "29d165d0-0324-4234-bd93-c8d4f7f5303d",
                                "sense_id": "635a9372-72c4-3f60-82ab-2d9abfe97501",
                                "text": "L’horloger leur confie des travaux de pendulerie sur des carillons, pendules de Paris, horloges comtoises."
                            },
                            {
                                "example_id": "753678c7-c75f-454e-9f45-2b9686a5faf7",
                                "sense_id": "635a9372-72c4-3f60-82ab-2d9abfe97501",
                                "text": "Le tableau n’est guère plus reluisant en ce qui concerne la pendulerie. Il y a de moins en moins d’horloges mais aussi de moins en moins d’horlogers."
                            }
                        ]
                    }
                ],
