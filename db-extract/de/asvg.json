                        "entry_id": "3b6beb78-8eeb-336f-965c-f340ff4b069f",
                        "glosses": [
                            "Allgemeines Sozialversicherungsgesetz"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "0e074b9a-0c1c-4314-9cf7-e97535e750cc",
                                "sense_id": "d0d61376-6f68-3502-9ed1-f5adb96bf9b7",
                                "text": "Die Pensionsversicherung erlebt im Jahr 2014 zwei bahnbrechende Neuerungen: Das Pensionskonto ist die größte Systemumstellung seit der Einführung des ASVGs, von den Neuerungen unter dem Titel „Invalidität – Neu“ erwartet man sich einen Wendepunkt bzgl. der krankheitsbedingten Pensionen."
                            },
                            {
                                "example_id": "54e7f0e3-4e4c-4421-8e62-2ee0ba6392bf",
                                "sense_id": "d0d61376-6f68-3502-9ed1-f5adb96bf9b7",
                                "text": "Bundespräsident Heinz Fischer nahm heute den Festakt anlässlich 60 Jahre ASVG im Parlament wahr, um ein klares Bekenntnis zur bestehenden Pflichtversicherung und zum Umlageverfahren abzulegen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "72b63524-7046-350d-8af3-52bc0cd299b4",
                        "entry_id": "3b6beb78-8eeb-336f-965c-f340ff4b069f",
                        "glosses": [
                            "Agrarstrukturverbesserungsgesetz"
                        ],
                        "tags": [
                            "Baden-Württemberg"
                        ],
                        "examples": [
                            {
                                "example_id": "e93da498-0ad3-4ac3-96ed-549c013f3fe0",
                                "sense_id": "72b63524-7046-350d-8af3-52bc0cd299b4",
                                "text": "Das Gesetz über Maßnahmen zur Verbesserung der Agrarstruktur in Baden-Württemberg (Agrarstrukturverbesserungsgesetz ASVG; gültig seit 01.07.2010) regelt die rechtsgeschäftliche Veräußerung von land- bzw. forstwirtschaftlichen Grundstücken."
                            },
                            {
                                "example_id": "6a418a0d-616a-4267-adeb-d141685a3567",
                                "sense_id": "72b63524-7046-350d-8af3-52bc0cd299b4",
                                "text": "Aufgabe des ASVG ist die Abwehr von Gefahren für die Agrarstruktur."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
