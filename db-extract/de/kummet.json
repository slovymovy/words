                        "sense_id": "7f157472-37ad-33c9-92b4-8dfcee20a357",
                        "entry_id": "3bb943d0-7487-3ded-a024-d22151519379",
                        "glosses": [
                            "gepolsterter und mit Stroh und Rehhaar gefüllter Bügel, der den Pferden um den Hals gelegt wird, Teil des Zuggeschirrs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "432048d6-c43a-44f5-bc88-1dc94e8932de",
                                "sense_id": "7f157472-37ad-33c9-92b4-8dfcee20a357",
                                "text": "Lege dem Pferd das Kummet an."
                            },
                            {
                                "example_id": "296b429e-8816-46f2-bf5a-6444022998fb",
                                "sense_id": "7f157472-37ad-33c9-92b4-8dfcee20a357",
                                "text": "„Technische Innovationen wie der Kummet ermöglichten nun den Einsatz von Pferden und Pflüge aus Eisen lösten die Hakenpflüge aus Holz ab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "12c341e6-637e-419d-82f4-e3260727b9b9",
