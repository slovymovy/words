                "senses": [
                    {
                        "sense_id": "d68e5283-cc46-3fff-bd39-5736bc77209e",
                        "entry_id": "2c205452-8acf-37b7-ad19-e79b07cd29e3",
                        "glosses": [
                            "Feder, die von einem Pfau stammt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08fe170d-4251-4c7c-86cd-ce4da1f6752a",
                                "sense_id": "d68e5283-cc46-3fff-bd39-5736bc77209e",
                                "text": "„Burberry bewarb das händisch mit Pfauenfedern besetzte Stück auf der Homepage mit der Beschreibung, die hochwertigen Federn würden zu hundert Prozent von in Indien gezüchteten Tieren stammen.“"
                            },
                            {
                                "example_id": "aa9fa599-febc-4495-b221-487582d6f7c3",
                                "sense_id": "d68e5283-cc46-3fff-bd39-5736bc77209e",
                                "text": "„Ich wollte mir die runtergefallene Pfauenfeder holen, aber ein anderer Junge war schneller als ich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
