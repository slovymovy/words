                "senses": [
                    {
                        "sense_id": "cbd0d9d9-fa5e-3486-9b98-66cb42495531",
                        "entry_id": "7fc9a0e3-7ec5-3365-90ab-c5e8cd701dd9",
                        "glosses": [
                            "sehr markanter, wahrnehmbarer Geruch nach Chloraminen an sich selbst und in der Umgebung; durch das Geruchsorgan (auch Mund und Augen) wahrgenommene Reizungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8398f7cc-967d-47ed-96f7-f40815626b90",
                                "sense_id": "cbd0d9d9-fa5e-3486-9b98-66cb42495531",
                                "text": "„Wenn Trichloramin verdunstet, verbreitet es den für manche Schwimmbäder typischen \"Chlorgeruch\" (der sich vom stechenden Geruch des Chlorgases deutlich unterscheidet).“"
                            },
                            {
                                "example_id": "d3db34b7-8bee-4915-a812-94f1958888ab",
                                "sense_id": "cbd0d9d9-fa5e-3486-9b98-66cb42495531",
                                "text": "„Die Chloramine sind es, die den bisweilen starken Chlorgeruch in überfüllten Bädern ausmachen.“"
                            },
                            {
                                "example_id": "47755685-65c5-487f-a736-dc84ad563564",
                                "sense_id": "cbd0d9d9-fa5e-3486-9b98-66cb42495531",
                                "text": "„Wegen Chlorgeruchs an Bord ist am Freitagmittag eine Maschine der Fluggesellschaft Germanwings rund 30 Minuten nach dem Start wieder zum Flughafen Köln/Bonn zurückgekehrt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
