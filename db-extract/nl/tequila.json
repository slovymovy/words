                                        "entry_id": "ffae017c-0791-30d5-ab26-3aac68984a26",
                                        "glosses": [
                                            "An alcoholic liquor distilled from the fermented juice of the Central American century plant Agave tequilana."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36ef02a9-2dd1-4fe0-8166-239754e0f80b",
                                                "sense_id": "89d15811-4ec8-3212-80e4-69595765652f",
                                                "text": "For a moment the bottle of tequila at the bottom of the garden gleamed on his soul, then the Consul stumbled into his bedroom."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4bf62d87-83df-4d15-86ed-4eeeabe5c6ac",
                        "source_entry_id": "c44b6200-93d2-349e-b755-6d59f4344f75",
                        "source_sense_id": "6e659f24-5cf8-32cc-9d19-73deca3354af",
                        "source_sense_description": "alcoholische drank afkomstig uit Mexico",
