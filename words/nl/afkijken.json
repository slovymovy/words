{
    "word_family": [
        "kijken",
        "kijker",
        "bekijken",
        "nakijken",
        "uitkijken"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b5346fb4-2d14-3aa4-a3a6-5ac426c2ec64",
                    "sense_definition": "stiekem antwoorden of werk van een ander kopiëren, bijvoorbeeld tijdens een examen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "kopiëren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De leraar zag dat de leerling probeerde <w>af te kijken</w> bij zijn buurman.",
                            "target_lang_translations": {
                                "en": "The teacher saw that the student was trying to <w>cheat</w> by looking at his neighbor's work."
                            }
                        },
                        {
                            "text": "Tijdens de toets mag je absoluut niet <w>afkijken</w> van een ander.",
                            "target_lang_translations": {
                                "en": "During the test, you are absolutely not allowed to <w>copy</w> from someone else."
                            }
                        }
                    ],
                    "synonyms": [
                        "spieken"
                    ],
                    "common_phrases": [
                        "niet mogen afkijken",
                        "bij de buren afkijken"
                    ],
                    "target_lang_definitions": {
                        "en": "to secretly copy answers or work from someone else, for example during an exam"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cheat",
                                "target_lang_sense_clarification": "in an exam or test"
                            },
                            {
                                "target_lang_word": "copy",
                                "target_lang_sense_clarification": "from a classmate's work"
                            },
                            {
                                "target_lang_word": "crib",
                                "target_lang_sense_clarification": "informal term for cheating in school"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "36d96d73-6bff-3711-9fc1-4226e13cfe2f",
                    "sense_definition": "iets tot het einde toe bekijken, zoals een film of programma",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "voltooien",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik was zo moe dat ik de film gisteravond niet kon <w>afkijken</w>.",
                            "target_lang_translations": {
                                "en": "I was so tired that I couldn't <w>finish watching</w> the movie last night."
                            }
                        },
                        {
                            "text": "Heb je die spannende serie op Netflix al helemaal <w>afgekeken</w>?",
                            "target_lang_translations": {
                                "en": "Have you <w>watched</w> that exciting series on Netflix <w>to the end</w> yet?"
                            }
                        }
                    ],
                    "synonyms": [
                        "uitkijken"
                    ],
                    "common_phrases": [
                        "een film afkijken",
                        "de serie afkijken"
                    ],
                    "target_lang_definitions": {
                        "en": "to watch something until the end, such as a movie or program"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "finish watching",
                                "target_lang_sense_clarification": "a movie or show"
                            },
                            {
                                "target_lang_word": "watch to the end",
                                "target_lang_sense_clarification": "completing a video"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "da9f3ff1-4326-34d2-bb21-baa6bb2f6464",
                    "sense_definition": "iets leren of een vaardigheid overnemen door goed naar iemand anders te kijken",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "kopiëren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij heeft de fijne kneepjes van het vak van zijn vader <w>afgekeken</w>.",
                            "target_lang_translations": {
                                "en": "He <w>picked up</w> the tricks of the trade from his father."
                            }
                        },
                        {
                            "text": "Je kunt veel <w>afkijken</w> door simpelweg te observeren hoe professionals te werk gaan.",
                            "target_lang_translations": {
                                "en": "You can <w>learn</w> a lot <w>by watching</w> simply by observing how professionals work."
                            }
                        }
                    ],
                    "synonyms": [
                        "kopiëren",
                        "overnemen",
                        "nadoen"
                    ],
                    "common_phrases": [
                        "de kunst afkijken"
                    ],
                    "target_lang_definitions": {
                        "en": "to learn something or adopt a skill by watching someone else closely"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pick up",
                                "target_lang_sense_clarification": "a skill by observing"
                            },
                            {
                                "target_lang_word": "learn by watching",
                                "target_lang_sense_clarification": "observational learning"
                            },
                            {
                                "target_lang_word": "copy",
                                "target_lang_sense_clarification": "someone's technique"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e8d5db4d-bfc8-3035-aa2c-e4f80567be8b",
                    "sense_definition": "een idee of ontwerp van een ander overnemen of stelen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "kopiëren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het ontwerp van deze nieuwe smartphone lijkt wel <w>afgekeken</w> van de concurrent.",
                            "target_lang_translations": {
                                "en": "The design of this new smartphone seems to have been <w>copied</w> from the competitor."
                            }
                        },
                        {
                            "text": "De stoelopstelling van deze auto is duidelijk <w>afgekeken</w> van de luchtvaart.",
                            "target_lang_translations": {
                                "en": "The seating arrangement of this car is clearly <w>modeled</w> after aviation."
                            }
                        }
                    ],
                    "synonyms": [
                        "ontlenen",
                        "imiteren"
                    ],
                    "common_phrases": [
                        "een idee afkijken"
                    ],
                    "target_lang_definitions": {
                        "en": "to adopt or steal an idea or design from someone else"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "copy",
                                "target_lang_sense_clarification": "an idea or design"
                            },
                            {
                                "target_lang_word": "imitate",
                                "target_lang_sense_clarification": "a style or concept"
                            },
                            {
                                "target_lang_word": "rip off",
                                "target_lang_sense_clarification": "informal for stealing a design"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}