                    },
                    {
                        "translation_id": "1cc28cdb-009c-41bf-ad2b-7b2fbd52c63c",
                        "source_entry_id": "4d00559c-dc61-3fa1-a3c4-b300e862beb0",
                        "source_sense_id": "a9cd4922-6391-3447-bfd6-8aca793d17ca",
                        "target_lang_word": "gyaru",
                        "target_lang_code": "en",
