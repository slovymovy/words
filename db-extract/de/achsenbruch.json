                ],
                "senses": [
                    {
                        "sense_id": "3dddd7f5-73f3-3cda-b035-0c79897cf7c4",
                        "entry_id": "f5b22fe4-3224-38ef-a6e8-d62dd13124f1",
                        "glosses": [
                            "Bruch einer Achse (= des verbindenden Teils zwischen zwei Rädern)"
                        ],
                        "tags": [
                            "Fahrzeugtechnik"
                        ],
                        "examples": [
                            {
                                "example_id": "f25287c0-abf7-49d6-a1c0-e6a14b3d3f70",
                                "sense_id": "3dddd7f5-73f3-3cda-b035-0c79897cf7c4",
                                "text": "Achsenbrüche bei LKWs oder PKWs kommen heute nur noch selten vor."
                            },
                            {
                                "example_id": "36b6dc26-8ee1-49bd-be37-528f253738b4",
                                "sense_id": "3dddd7f5-73f3-3cda-b035-0c79897cf7c4",
                                "text": "„In der Beusselstraße kippte ein 40 Tonnen-Lastwagen um und erlitt einen Achsenbruch.“"
                            },
                            {
                                "example_id": "a837a27e-3e61-477e-9f92-a309ab0ed8b9",
                                "sense_id": "3dddd7f5-73f3-3cda-b035-0c79897cf7c4",
                                "text": "[In Syrien, Persien und Afghanistan waren] „Straßen oft nicht vorhanden oder wurden weggeschwemmt, Autos und Lastwagen blieben mit Achsenbruch liegen, manchmal kam man nur mit Pferden weiter.“"
                            },
                            {
                                "example_id": "7dd49c0b-1955-4dd0-8977-1cef697c9cd9",
                                "sense_id": "3dddd7f5-73f3-3cda-b035-0c79897cf7c4",
                                "text": "[Schlagzeile:] „Bahn: Ursache für Achsenbruch noch unbekannt“"
                            },
                            {
                                "example_id": "094789c2-7de7-4fbd-8811-3149a04794f8",
                                "sense_id": "3dddd7f5-73f3-3cda-b035-0c79897cf7c4",
                                "text": "[Die Deutsche Bahn] „hatte bereits am 16. Oktober mitgeteilt, ein vorläufiger Untersuchungsbericht der BAM enthalte den Hinweis, dass der Achsenbruch von Köln mit einem Herstellungsfehler zusammenhängen könnte.“"
                            },
                            {
                                "example_id": "b13a5fcb-b5ea-4a7f-bf54-b0255f38fdc7",
                                "sense_id": "3dddd7f5-73f3-3cda-b035-0c79897cf7c4",
                                "text": "„Die Pannenserie der S-Bahn begann im Mai 2009 mit einem Achsenbruch.“"
                            },
                            {
                                "example_id": "db04f416-81b1-4892-9c22-4271bb40a590",
                                "sense_id": "3dddd7f5-73f3-3cda-b035-0c79897cf7c4",
                                "text": "„Auch bei den Bahnen erscheint z. B. ein Achsenbruch jetzt noch trotz aller Vorsicht unvermeidlich, […].“"
                            },
                            {
                                "example_id": "55fdd1d7-5890-4014-b5dc-0577d5112af2",
                                "sense_id": "3dddd7f5-73f3-3cda-b035-0c79897cf7c4",
                                "text": "„Der Dortmunder Vorfall erinnert an das Entgleisen eines ICE 3 am Kölner Hauptbahnhof im Jahr 2008; damals war ein Achsenbruch die Ursache, der sich bei niedriger Geschwindigkeit ereignete.“"
                            },
                            {
                                "example_id": "3ffada13-52eb-44e9-bca1-dbf8d6a5825c",
                                "sense_id": "3dddd7f5-73f3-3cda-b035-0c79897cf7c4",
                                "text": "„Derzeit sind 237 Züge dieser Art im Einsatz - sie stellen knapp die Hälfte der Straßenbahn-Flotte. Alle wurden nach Angaben der BVG in der Nacht zu Dienstag auf Achsenbrüche untersucht.“"
                            },
                            {
                                "example_id": "afcd5593-f3fe-4297-980b-de531da04563",
                                "sense_id": "3dddd7f5-73f3-3cda-b035-0c79897cf7c4",
                                "text": "Der Achſenbruch aber iſt die gefährlichſte Veranlaſſung zu Unglücksfällen. Das ſchauerliche Ereigniß von Verſailles war die Folge eines Achſenbruches."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
