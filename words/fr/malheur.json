                    "frequency": "High",
                    "semantic_group_id": "evenement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un grave <w>malheur</w> est arrivé à cette famille l'hiver dernier."
                        },
                        {
                            "text": "Ce terrible <w>malheur</w> a plongé tout le village dans la tristesse et le deuil."
                        }
                    ],
                    "common_phrases": [
