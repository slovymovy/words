                                        "sense_id": "4007bdfd-911b-3c22-8409-b87173d95607",
                                        "entry_id": "532f09dd-daaf-360b-afd4-9e932a66de80",
                                        "glosses": [
                                            "aus einer gültigen Ehe stammend (Nachkommen)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f03a98a6-3929-4686-879f-b5cfa751b737",
                                                "sense_id": "4007bdfd-911b-3c22-8409-b87173d95607",
                                                "text": "„Deutsche Kinder, die ehelich geboren sind, bei denen jedoch der biologische Vater ein anderer als der Ehegatte ist, gelten rechtlich automatisch als Kinder des Ehemannes.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "14ee1d7e-4238-30b5-b5e9-09703ddf931a",
                                        "entry_id": "532f09dd-daaf-360b-afd4-9e932a66de80",
                                        "glosses": [
                                            "sich auf die Ehe beziehend, in der Ehe üblich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2394bf2f-9609-407c-871b-f087b950dfda",
                                                "sense_id": "14ee1d7e-4238-30b5-b5e9-09703ddf931a",
                                                "text": "„Es ist entweder zu viel Wind oder zu wenig, die Enge an Bord beginnt die eheliche Harmonie empfindlich zu stören und das ewige Geschaukel braucht auch kein Mensch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
