                        "examples": [
                            {
                                "example_id": "c85f28af-45a8-4da9-afdb-7fd3a8a3d656",
                                "sense_id": "4c07e8eb-7f32-33d5-9f52-32780de303a2",
                                "text": "Juan Carlos, die in 2014 aftrad ten voordele van zijn zoon Felipe VI, won de race - die sinds maandag aan de gang was - na acht regatta’s op de Stille Oceaan. Aan boord van zijn zes meter lange Bribon Gallant bleef Juan Carlos de Amerikaan Peter Hofmann en de Braziliaan Lars Grael voor. De Spaanse koning won slechts één regatta, maar toonde zich het meest regelmatig in zeer winderige weersomstandigheden."
                            },
                            {
                                "example_id": "0a9d35e2-855f-424f-8cd0-d21ced216cb7",
                                "sense_id": "4c07e8eb-7f32-33d5-9f52-32780de303a2",
                                "text": "Afgelopen zomer haalden Martine en Marike Veldhuis in hun leeftijdsklasse zilver op het WK roeien. Komend weekend stapt de 20-jarige tweeling uit Wierden in de boot voor de Cottwich Almelo Regatta. Bij Amycus, de roeivereniging waar het voor hen allemaal begon."
                            },
                            {
                                "example_id": "a593768d-97c0-4e0f-9fe0-90a413739fc0",
                                "sense_id": "4c07e8eb-7f32-33d5-9f52-32780de303a2",
                                "text": "De regatta in Kiel was in haar jeugd een voortdurend herhaalde sociale dwang voor haar geweest omdat ze geboren was in een van de bekendste zeilfamilies."
                            }
                        ]
                    }
