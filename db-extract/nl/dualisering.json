                        "examples": [
                            {
                                "example_id": "0143b9e8-ac14-48f9-9559-a2553490f504",
                                "sense_id": "e8a5c5f7-8a39-3f35-ba62-5019fd115227",
                                "text": "Het onderzoek van Binnenlands Bestuur gaat terug tot het jaar 2002. In dat jaar werd de Wet dualisering gemeentebestuur van kracht. Wethouders maken sindsdien geen deel meer uit van de gemeenteraad."
                            },
                            {
                                "example_id": "3064ebab-d776-4379-8b10-c0f520ebfa65",
                                "sense_id": "e8a5c5f7-8a39-3f35-ba62-5019fd115227",
                                "text": "Staatscommissies (vaak met politici en wetenschappers) adviseren de regering, vooral over staatsrechtelijke kwesties. Voorbeeld is de staatscommissie-Elzinga, die in 2000 advies uitbracht over verbeteringen in de lokale democratie. In reactie daarop werd onder meer de zogenoemde dualisering ingevoerd, waarbij wethouders niet meer in gemeenteraden mogen zitten."
                            }
                        ]
                    }
