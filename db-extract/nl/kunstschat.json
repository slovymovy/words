                        "examples": [
                            {
                                "example_id": "cb6a5462-eed4-40d0-bd41-11deb24a94af",
                                "sense_id": "a6a497ee-86a5-32c7-a53a-27e996b4b9b6",
                                "text": "Tussen honderden museumgasten in Rijksmuseum Twenthe liepen zaterdagmiddag tientallen diplomaten, op uitnodiging van de ambassadeur van Italië. Ze bekeken de expositie ‘In het hart van de renaissance’, vol met Italiaanse kunstschatten."
                            },
                            {
                                "example_id": "f94b615e-2ecb-4ba2-9e4e-d77e539b7445",
                                "sense_id": "a6a497ee-86a5-32c7-a53a-27e996b4b9b6",
                                "text": "Kalasjnikovs en RPG-raketwerpers uit Oekraïne en Moldavië in ruil voor archeologische kunstschatten geroofd uit Irak, Syrië en Libië. De Italiaanse krant La Stampa schrijft op basis van eigen onderzoek dat de illegale handel tussen de Calabrese maffia 'Ndrangheta en de terreurgroep Islamitische Staat welig tiert."
                            }
                        ]
                    }
