                "senses": [
                    {
                        "sense_id": "95642591-53b9-30a3-be37-0d8e4a5e2c6e",
                        "entry_id": "d2e771a2-8627-3a06-9c53-bd945545b850",
                        "glosses": [
                            "człowiek zbytnio przywiązujący wagę do formalności, zewnętrznych form działania"
                        ],
                        "tags": [],
                        "examples": [],
