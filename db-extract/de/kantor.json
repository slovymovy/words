                        "form": "den Kantor"
                    },
                    {
                        "form_id": "59e9fd2f-a3be-4060-82b1-3d891afcd592",
                        "entry_id": "467d794c-2b9e-3a67-a8fa-01f081aa0124",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Kantoren"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f5699c49-9c36-35ed-9d69-c475827b250c",
                        "entry_id": "467d794c-2b9e-3a67-a8fa-01f081aa0124",
                        "glosses": [
                            "Person, die im christlichen oder jüdischen Gottesdienst die Orgel spielt und/oder den Chor leitet"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "162cef22-5cfc-44e9-b048-36ea0caa2a1a",
                                "sense_id": "f5699c49-9c36-35ed-9d69-c475827b250c",
                                "text": "Johann Sebastian Bach war Kantor der Kirchengemeinde St. Thomas zu Leipzig."
                            },
                            {
                                "example_id": "4c828602-31c1-4ca3-80db-c3de381207a7",
                                "sense_id": "f5699c49-9c36-35ed-9d69-c475827b250c",
                                "text": "„Der Kantor senkte den Blick und fragte nicht weiter.“"
                            },
                            {
                                "example_id": "b9d434de-6cf6-4830-aadd-627140849d54",
                                "sense_id": "f5699c49-9c36-35ed-9d69-c475827b250c",
                                "text": "„Es war nicht für die einfachen Gläubigen bestimmt, von denen die meisten es ohnehin weder hätten bezahlen noch benutzen können, sondern für Chorsänger und Kantoren.“"
                            },
                            {
                                "example_id": "c6648dbe-c53b-4d22-9307-df1835023590",
                                "sense_id": "f5699c49-9c36-35ed-9d69-c475827b250c",
                                "text": "„Trommelwirbel ertönte, ein silbernes Kreuz tauchte auf; dann erschienen zwei Leuchter, von Kantoren getragen, sowie der Herr Pfarrer mit Stola, Chorhemd, Chormantel und Barett.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d5e96027-0ab5-471c-9fc3-168d2bf16c37",
                        "source_entry_id": "467d794c-2b9e-3a67-a8fa-01f081aa0124",
                        "source_sense_id": "f5699c49-9c36-35ed-9d69-c475827b250c",
                        "source_sense_description": "Organist und/oder Chorleiter",
                        "target_lang_word": "cantor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cantor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3d797c5d-3208-3fe9-9c13-3b25b113822a",
                                        "entry_id": "b8002ad6-e86e-33e7-8a25-6b4f53f5d20f",
                                        "glosses": [
                                            "singer, especially someone who takes a special role of singing or song leading at a ceremony"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c7da1f8-a14f-442c-96e6-83486bda9100",
                                                "sense_id": "3d797c5d-3208-3fe9-9c13-3b25b113822a",
                                                "text": "The cantor's place in church is on the right of the choir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e69acc4-5214-3ac1-919d-fab3fbbbc591",
                                        "entry_id": "b8002ad6-e86e-33e7-8a25-6b4f53f5d20f",
                                        "glosses": [
                                            "A prayer leader in a Jewish service; a hazzan"
                                        ],
                                        "tags": [
                                            "Judaism"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7002934d-e5d5-4fe4-b4a3-60c5ac6f3edc",
                        "source_entry_id": "467d794c-2b9e-3a67-a8fa-01f081aa0124",
                        "source_sense_id": "f5699c49-9c36-35ed-9d69-c475827b250c",
                        "source_sense_description": "Organist und/oder Chorleiter",
                        "target_lang_word": "chantre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chantre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3a6ecb7e-619e-3525-8070-2c29848d09ed",
                                        "entry_id": "d0af45a2-ea60-3187-a253-1d7dfeea7cb3",
                                        "glosses": [
                                            "Celui ou celle qui chante aux offices religieux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4252a1ae-6ff6-4694-86c8-d9359bf57df9",
                                                "sense_id": "3a6ecb7e-619e-3525-8070-2c29848d09ed",
                                                "text": "Quant à la procession en elle-même, outre le personnel d’un nombreux clergé, prêtres, chantres, porte-châsses, porte-bannières, etc., elle s’avançait précédée de deux tambours, avec une escorte de six hallebardiers et douze porte-torches."
                                            },
                                            {
                                                "example_id": "6b3ffb0d-7da8-4e1d-9a20-490764a46b2a",
                                                "sense_id": "3a6ecb7e-619e-3525-8070-2c29848d09ed",
                                                "text": "Au milieu d’eux, se trouvaient les chantres, en chapes de soie rouge, qui avaient commencé l’antienne, à pleine voix."
                                            },
                                            {
                                                "example_id": "da7d8d96-1b67-4d05-9f0b-a2f1ef43dcae",
                                                "sense_id": "3a6ecb7e-619e-3525-8070-2c29848d09ed",
                                                "text": "J’entends toujours ce glas, toujours j’entends le curé me dire en pleurant : « Pauvre petit diable ! », et je revois le bedeau et ses tintenelles, les chantres et leurs chapes."
                                            },
                                            {
                                                "example_id": "4c9b0f68-39bc-42e9-967c-add6d038f606",
                                                "sense_id": "3a6ecb7e-619e-3525-8070-2c29848d09ed",
                                                "text": "Des gros chantres, les veines du cou gonflées, faisaient sonner leurs basses profondes, ayant l’air de tirer les notes de leurs talons."
                                            },
                                            {
                                                "example_id": "e98de006-a9e4-47a4-a8e0-f883b468d1d9",
                                                "sense_id": "3a6ecb7e-619e-3525-8070-2c29848d09ed",
                                                "text": "Il demanda à Dubuisson, le sacristain, si son ami, qui était chantre à la cathédrale de Moulins, allait bientôt venir le voir. La dernière fois, il avait très bien chanté."
                                            },
                                            {
                                                "example_id": "92a56ac9-caee-4f2f-b155-6680fbf6c1a2",
                                                "sense_id": "3a6ecb7e-619e-3525-8070-2c29848d09ed",
                                                "text": "Solomine était l’unique fils d’un chantre d’église."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e7c7c36-d172-3f43-a214-63d401d922b9",
                                        "entry_id": "d0af45a2-ea60-3187-a253-1d7dfeea7cb3",
                                        "glosses": [
                                            "Poète, principalement poète épique ou lyrique."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8fe10af0-6e8d-40d8-9a8a-351c91e77800",
                                                "sense_id": "4e7c7c36-d172-3f43-a214-63d401d922b9",
                                                "text": "Le chantre de la Thrace, Orphée."
                                            },
                                            {
                                                "example_id": "8afd5a55-77c6-477c-9ce9-fbc57d8494f7",
                                                "sense_id": "4e7c7c36-d172-3f43-a214-63d401d922b9",
                                                "text": "Le chantre d’Ascra, Hésiode."
                                            },
                                            {
                                                "example_id": "b6b8dc0a-d2a0-423b-955a-1e0ec9b8e878",
                                                "sense_id": "4e7c7c36-d172-3f43-a214-63d401d922b9",
                                                "text": "Le chantre thébain, Pindare."
                                            },
                                            {
                                                "example_id": "6fe332c7-f03b-4bba-9f82-a104b7c232b2",
                                                "sense_id": "4e7c7c36-d172-3f43-a214-63d401d922b9",
                                                "text": "Le chantre d’Ionie, le chantre d’Ilion, le chantre d’Ulysse, le chantre d’Achille, Homère."
                                            },
                                            {
                                                "example_id": "04d391f2-c779-4892-9df6-944c6bcac101",
                                                "sense_id": "4e7c7c36-d172-3f43-a214-63d401d922b9",
                                                "text": "Le chantre d’Ausonie, le chantre d’Énée, Virgile."
                                            },
                                            {
                                                "example_id": "97a44d63-f93c-42b5-a3af-96bd3a282fad",
                                                "sense_id": "4e7c7c36-d172-3f43-a214-63d401d922b9",
                                                "text": "Le chantre de Téos, Anacréon."
                                            },
                                            {
                                                "example_id": "b97dc9e2-03af-46a2-8eaa-b0cdc062c875",
                                                "sense_id": "4e7c7c36-d172-3f43-a214-63d401d922b9",
                                                "text": "Le chantre de Roland, l’Arioste."
                                            },
                                            {
                                                "example_id": "98c328cc-5319-40cb-bc2b-a8207d7c28ba",
                                                "sense_id": "4e7c7c36-d172-3f43-a214-63d401d922b9",
                                                "text": "Le chantre des jardins, Delille."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a551bfd0-bafd-3b2c-a4b4-0c65ac778cce",
                                        "entry_id": "d0af45a2-ea60-3187-a253-1d7dfeea7cb3",
                                        "glosses": [
                                            "Celui ou celle qui glorifie, loue quelqu’un ou quelque chose."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d60d17be-1684-4c33-9868-f5501af7cdff",
                                                "sense_id": "a551bfd0-bafd-3b2c-a4b4-0c65ac778cce",
                                                "text": "Partout dans le monde les manuels scolaires sont quelque peu malmenés, dans des sens divers : les chantres de l'électronique en prédisent la disparition au profit du multimédia."
                                            },
                                            {
                                                "example_id": "1a66b173-34aa-4de1-86ab-2610c5781bd1",
                                                "sense_id": "a551bfd0-bafd-3b2c-a4b4-0c65ac778cce",
                                                "text": "Des contempteurs de la religion, des chantres du désordre et des forces de l’ordre."
                                            },
                                            {
                                                "example_id": "22b8315c-a56e-4900-80b8-30fb20862091",
                                                "sense_id": "a551bfd0-bafd-3b2c-a4b4-0c65ac778cce",
                                                "text": "Charles-Amédée de Courson, député depuis 1993, centriste et chantre du sérieux budgétaire, «populiste» ? Il faut avouer qu’on ne l’aurait pas dit comme ça."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
