                "senses": [
                    {
                        "sense_id": "b5176c4f-aa11-3636-9de1-af8e1b9a6516",
                        "entry_id": "8bde00c2-407e-32e3-ba96-7d86f22659e6",
                        "glosses": [
                            "Fleisch, das speziell für die Zubereitung auf dem Grill vorbereitet wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9cd0e65f-b93b-4c3f-8f3a-5e4015d8a433",
                                "sense_id": "b5176c4f-aa11-3636-9de1-af8e1b9a6516",
                                "text": "Der Metzger bietet heute marinierte Hühnerbrust, Schwenksteaks, Bauchspeck und anderes Grillfleisch um 10% günstiger an."
                            },
                            {
                                "example_id": "cbe6a413-2e71-4044-aefc-022d8f6da3f6",
                                "sense_id": "b5176c4f-aa11-3636-9de1-af8e1b9a6516",
                                "text": "Für das Familienfest brauchen wir noch Getränke, Holzkohle, Würstchen und Grillfleisch."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "40c571c0-c75b-37fc-902d-66fd34161e8f",
                        "entry_id": "8bde00c2-407e-32e3-ba96-7d86f22659e6",
                        "glosses": [
                            "Fleisch, das auf dem Grill zubereitet wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da90597f-91d3-4be0-a176-b29f544e6f23",
                                "sense_id": "40c571c0-c75b-37fc-902d-66fd34161e8f",
                                "text": "Es war wieder alles wie am Vorabend, sie aßen Grillfleisch und gutes Brot, die Kinder aßen wieder Unmengen, legten sich anschließend auf den Rasen und hielten sich die Bäuche."
                            },
                            {
                                "example_id": "cd995832-88fd-45a7-b205-9c910d1f3faf",
                                "sense_id": "40c571c0-c75b-37fc-902d-66fd34161e8f",
                                "text": "Duarte bestellte Grillfleisch mit Pommes frites für drei Personen, eine Flasche Wein und eine große CocaCola."
                            },
                            {
                                "example_id": "0a20ab80-fd87-476d-a394-d599608f8bb3",
                                "sense_id": "40c571c0-c75b-37fc-902d-66fd34161e8f",
                                "text": "Während sie zum Palast hinaufzogen, ließ König Schahriyar die Tafeln decken mit Grillfleisch, Getränken, Süßigkeiten und Gerichten aller Art."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
