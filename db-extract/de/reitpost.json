                "senses": [
                    {
                        "sense_id": "8a569706-211a-32f6-a8eb-5a31dcd4d684",
                        "entry_id": "b1aaff3b-14b9-3c5b-8e0c-95cae85ad4cf",
                        "glosses": [
                            "Beförderung der Post durch Reiter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2d9548e-a21b-4fa1-87e8-a93ef9da9dc6",
                                "sense_id": "8a569706-211a-32f6-a8eb-5a31dcd4d684",
                                "text": "„Die erste Reitpost, die diesen Namen wirklich verdient, war die Taxissche Postlinie.“"
                            },
                            {
                                "example_id": "9293659c-f475-4297-bd86-f8b22d94a9ae",
                                "sense_id": "8a569706-211a-32f6-a8eb-5a31dcd4d684",
                                "text": "„Mit Edikt vom 14. April 1649 wird ein Postkurs eingerichtet, der von Kleve über Berlin, Danzig, die Frische Nehrung, Pillau, die Kurische Nehrung bis nach Memel führt, die sogenannte Reit- oder Dragonerpost.“"
                            },
                            {
                                "example_id": "6fcda932-2ab8-4e62-ace8-fe277ba970ea",
                                "sense_id": "8a569706-211a-32f6-a8eb-5a31dcd4d684",
                                "text": "„Im Innern nicht an Bahnen gelegene Postanstalten werden durch regelmäßige Botenposten, in Deutsch-Südwestaftika auch durch die landesüblichen Karrenposten und durch Reitposten versorgt.“"
                            }
                        ],
