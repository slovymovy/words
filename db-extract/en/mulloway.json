                        "glosses": [
                            "Any of the species Argyrosomus japonicus of large fish, found along the eastern coast of Africa and the coasts of Australia, prized for sport."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eda8e23a-628b-435c-8d70-c56db9217094",
                                "sense_id": "52f11c47-87a3-3067-9040-d01a294c7e38",
                                "text": "I clawed my way up a long, evil hissing slope and saw the light on the lonely beach and my father with a mulloway slung across his back like an aura […]."
                            },
                            {
                                "example_id": "6b7ca73d-145d-46a4-930d-01cecbc3c19e",
                                "sense_id": "52f11c47-87a3-3067-9040-d01a294c7e38",
                                "text": "To us, a rainy day may mean that we have to rug up and stay inside out of the elements, but the coming of a storm or the rising swell will find a mulloway that lives and feeds along the beaches, waiting around a river entrance for the mullet..."
                            }
                        ]
