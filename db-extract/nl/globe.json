                ],
                "senses": [
                    {
                        "sense_id": "7657c089-d10e-3074-9ab1-f5b86e54b42d",
                        "entry_id": "1b51cfbb-e494-3fa9-b75d-9294b157f04e",
                        "glosses": [
                            "Erdball, Erdkugel, Globus"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "05425f20-291a-4f51-b6af-ab49ddcd3005",
                        "source_entry_id": "1b51cfbb-e494-3fa9-b75d-9294b157f04e",
                        "source_sense_id": "7657c089-d10e-3074-9ab1-f5b86e54b42d",
                        "source_sense_description": "Erdball, Erdkugel, Globus",
                        "target_lang_word": "Erdball",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erdball",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0d50214f-53c8-33dc-940b-84497bfeb2bd",
                                        "entry_id": "4bc786e8-543b-3ce3-8ca6-f460595a870c",
                                        "glosses": [
                                            "der Planet Erde, wobei seine Kugelform betont wird"
                                        ],
                                        "tags": [
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0c8bfa9-172b-4fbc-9799-b440deaccc00",
                                                "sense_id": "0d50214f-53c8-33dc-940b-84497bfeb2bd",
                                                "text": "Tragt über den Erdball, tragt über die Meere / Die Fahne der Arbeitermacht! - (Roter Flottenmarsch)"
                                            },
                                            {
                                                "example_id": "5c5fc042-f6d1-49fd-b5c1-211230ac07cc",
                                                "sense_id": "0d50214f-53c8-33dc-940b-84497bfeb2bd",
                                                "text": "„Auf dem ganzen Erdball gab es keine abgelegenere europäische Siedlung.“"
                                            },
                                            {
                                                "example_id": "90dfa29c-d2b6-4ce2-a12b-9f501f53a4d5",
                                                "sense_id": "0d50214f-53c8-33dc-940b-84497bfeb2bd",
                                                "text": "„In Europa schwiegen die Waffen, doch auf der anderen Seite des Erdballs, im Pazifik, dauerte der Krieg an.“"
                                            },
                                            {
                                                "example_id": "be53fcd0-50c5-4472-84f2-7f27ca1a4596",
                                                "sense_id": "0d50214f-53c8-33dc-940b-84497bfeb2bd",
                                                "text": "„Einige meinten, es läge gleich hinter den nächsten Hügeln, andere sahen sich um den halben Erdball marschieren, bis ins Reich der Chinesen, das der Kaiser auch erobern wollte.“"
                                            },
                                            {
                                                "example_id": "0fb32915-c27f-4023-ae12-8e716e2f7365",
                                                "sense_id": "0d50214f-53c8-33dc-940b-84497bfeb2bd",
                                                "text": "„Das Feuer des Erdinnern hatte die Kruste des Erdballs gesprengt, Erdteile emporgehoben und Täler gebildet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f15e3672-b261-3afe-92e0-984b0c1dab65",
                                        "entry_id": "4bc786e8-543b-3ce3-8ca6-f460595a870c",
                                        "glosses": [
                                            "Name für ein Spielgerät sowie für ein Spiel, bei dem die Spielenden einen aufblasbaren, voluminösen Kunststoffball, der die Erdoberfläche abbildet und den Planeten symbolisiert, miteinander durch das Spielgelände bewegen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91ff1c3a-10b5-41d2-b618-9e51d349026f",
                                                "sense_id": "f15e3672-b261-3afe-92e0-984b0c1dab65",
                                                "text": "„In einigen Ländern kennt man ein Spiel, das mit einem riesigen Ball durchgeführt wird […]. Seine Ursprünge reichen weit zurück, bis in eine Zeit, in welcher der Ball die Erdkugel symbolisierte. Daher hat das Spiel auch seinen Namen: Erdball.“"
                                            },
                                            {
                                                "example_id": "b8f22891-e417-438e-987d-9444b921b481",
                                                "sense_id": "f15e3672-b261-3afe-92e0-984b0c1dab65",
                                                "text": "„Wenn die Gefahr besteht, daß der Erdball seitlich abrutscht, können die Spieler ihre Füße zu Hilfe nehmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "faaf8616-b341-3268-9b21-c524eee960c7",
                                        "entry_id": "4bc786e8-543b-3ce3-8ca6-f460595a870c",
                                        "glosses": [
                                            "Ball, der bei einem Abwurfspiel zuerst den Boden und dann eine Person berührt und somit ungültig ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f84a2811-c05c-4f5a-bc64-609313ee284a",
                                                "sense_id": "faaf8616-b341-3268-9b21-c524eee960c7",
                                                "text": "„Abgeworfen werden kann ein Spieler nur direkt (kein Erdball) und wenn der Ball danach den Boden berührt.“"
                                            },
                                            {
                                                "example_id": "8673018b-5d55-4cac-8e0e-06a95d0e62c9",
                                                "sense_id": "faaf8616-b341-3268-9b21-c524eee960c7",
                                                "text": "„Berührt der Ball vor dem/der Spieler/in den Boden, ist dies als „Erdball“ zu werten und zählt nicht als Treffer.“"
                                            },
                                            {
                                                "example_id": "d7d5c772-db5b-4446-860d-1620f978c111",
                                                "sense_id": "faaf8616-b341-3268-9b21-c524eee960c7",
                                                "text": "„Nicht als Fehler gelten dagegen der sogenannte Erdball (wenn der vom Gegner kommende Ball erst den Boden berührt und dann trifft) und wenn ein vom Gegner kommender Ball einen Spieler trifft, abprellt und von ihm selbst oder einem anderen Spieler anschließend gefangen wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
