                                "target_senses": [
                                    {
                                        "sense_id": "f627cfe6-f837-3639-a6f7-768e254100e4",
                                        "entry_id": "72cb5e21-404f-3bd1-9bff-eafbea926dab",
                                        "glosses": [
                                            "Tropo que designa una cosa con el nombre de otra con la que guarda una relación de causa efecto, de autor a obra, o de algún otro tipo de contigüidad temporal, causal o espacial."
                                        ],
                                        "tags": [
                                            "Retórica"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "070947cc-e02d-4dc1-9579-016531aa6d80",
                                                "sense_id": "f627cfe6-f837-3639-a6f7-768e254100e4",
                                                "text": "\"laurel\" por \"triunfo\"; \"un Goya\" por un \"cuadro de Goya\"."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
