                ],
                "senses": [
                    {
                        "sense_id": "c8f299af-600f-329d-9a2c-22ef1fb7d4b6",
                        "entry_id": "901f0fb1-0d5f-39f3-9400-809d9480ddf7",
                        "glosses": [
                            "Teich mit Fischen, die verwertet/verkauft werden sollen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85baaed7-cdd5-455b-909d-b350c4a6277e",
                                "sense_id": "c8f299af-600f-329d-9a2c-22ef1fb7d4b6",
                                "text": "„Mit Volker fuhr ich zu den Fischteichen an der Straße zwischen Hillscheid und Vallendar.“"
                            },
                            {
                                "example_id": "047aba54-92e1-4370-aca4-0b9c59e6032a",
                                "sense_id": "c8f299af-600f-329d-9a2c-22ef1fb7d4b6",
                                "text": "„Nachdem zunächst der Suchbereich laufend ausgedehnt wurde, nahmen die Trupps ab Dienstagmittag wieder den Nahbereich der Fischteiche, wo Franca zuletzt von ihrem Großvater gesehen wurde, in den Fokus, besonders die Strecke bis zum rund zwei Kilometer entfernten Wohnhaus des Kindes.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b1540c45-0abe-4bcd-8edd-91e3ac5cd2e5",
                        "source_entry_id": "901f0fb1-0d5f-39f3-9400-809d9480ddf7",
                        "source_sense_id": "c8f299af-600f-329d-9a2c-22ef1fb7d4b6",
                        "source_sense_description": "Teich mit Fischen, die verwertet/verkauft werden sollen",
                        "target_lang_word": "fishpond",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fishpond",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "70bfd1fc-f5d1-33d8-8f71-419255a35adb",
                                        "entry_id": "e0dd0774-5a63-32a7-95fc-863048328ecb",
                                        "glosses": [
                                            "A freshwater pond stocked with fish; especially one formerly attached to a monastery etc as a source of food."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7419d6cd-be42-40db-a17e-62829072e461",
                                                "sense_id": "70bfd1fc-f5d1-33d8-8f71-419255a35adb",
                                                "text": "Constructed of hard flint stone, which came as ballast from England and is now painted coral white, the house has a fishpond, or catchment, roof, dating from 1788, to collect rainwater."
                                            },
                                            {
                                                "example_id": "32054096-b421-49f3-91d7-92636659bc24",
                                                "sense_id": "70bfd1fc-f5d1-33d8-8f71-419255a35adb",
                                                "text": "Incarcerated in earth-filled boxes, the hapless annelids face execution in the morning. Death by immersion in fishponds, death by cruel hooks."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
