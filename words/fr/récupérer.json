{
    "word_family": [
        "récupération",
        "récupérable",
        "irrécupérable",
        "récupérateur"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "562c444d-f055-361b-a92f-8413835ccbb1",
                    "sense_definition": "Entrer de nouveau en possession de ce que l'on avait perdu, laissé ou prêté ; aller chercher quelque chose ou quelqu'un.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "possession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je dois passer à la gare pour <w>récupérer</w> ma valise oubliée dans le train."
                        },
                        {
                            "text": "Elle a enfin réussi à <w>récupérer</w> l'argent que son ami lui devait depuis un an."
                        }
                    ],
                    "synonyms": [
                        "recouvrer",
                        "reprendre",
                        "retrouver"
                    ],
                    "antonyms": [
                        "perdre",
                        "abandonner"
                    ],
                    "common_phrases": [
                        "récupérer ses affaires",
                        "récupérer un colis",
                        "récupérer son argent"
                    ]
                },
                {
                    "sense_id": "51d1fa51-29f1-3962-b4bb-9406e3caba23",
                    "sense_definition": "Retrouver ses forces, son énergie ou sa santé après une période d'effort, de maladie ou de fatigue.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sante",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après ce long voyage de nuit, il a besoin de dormir pour bien <w>récupérer</w>."
                        },
                        {
                            "text": "Le médecin lui a conseillé quelques jours de repos afin de <w>récupérer</w> plus vite."
                        }
                    ],
                    "synonyms": [
                        "se reposer",
                        "se rétablir"
                    ],
                    "antonyms": [
                        "s'épuiser"
                    ],
                    "common_phrases": [
                        "récupérer de la fatigue"
                    ]
                },
                {
                    "sense_id": "6e846646-3d20-3bc6-a4f5-8fe381ec1a76",
                    "sense_definition": "Collecter des objets ou des matières usagées afin de les réutiliser ou de les recycler.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "recyclage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous pouvons <w>récupérer</w> ces vieux cartons pour fabriquer des jeux pour les enfants."
                        },
                        {
                            "text": "Cette association s'occupe de <w>récupérer</w> les meubles usagés pour leur donner une seconde vie."
                        }
                    ],
                    "synonyms": [
                        "recycler",
                        "réutiliser"
                    ],
                    "antonyms": [
                        "jeter"
                    ],
                    "common_phrases": [
                        "récupérer des matériaux",
                        "récupérer de vieux objets"
                    ]
                },
                {
                    "sense_id": "16f17bea-00a8-33e9-baa1-dc0982fa58d6",
                    "sense_definition": "Rattraper des heures de travail ou du temps de repos que l'on n'a pas pu utiliser.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "travail",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Comme j'ai travaillé tout le week-end, je vais <w>récupérer</w> mes heures vendredi."
                        },
                        {
                            "text": "L'employé a demandé s'il pouvait <w>récupérer</w> sa journée fériée la semaine prochaine."
                        }
                    ],
                    "synonyms": [
                        "rattraper",
                        "compenser"
                    ],
                    "common_phrases": [
                        "récupérer des heures",
                        "récupérer un jour férié"
                    ]
                },
                {
                    "sense_id": "9828887d-c69b-38bf-b879-e0e52b736a6d",
                    "sense_definition": "S'approprier une idée, un mouvement ou un événement pour le détourner à son propre profit.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "politique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Plusieurs partis ont tenté de <w>récupérer</w> la colère populaire avant les élections législatives."
                        },
                        {
                            "text": "Les manifestants refusent qu'un groupe politique vienne <w>récupérer</w> leur combat citoyen."
                        }
                    ],
                    "synonyms": [
                        "instrumentaliser",
                        "détourner",
                        "s'approprier"
                    ],
                    "common_phrases": [
                        "récupérer une crise",
                        "récupérer un mouvement"
                    ]
                }
            ]
        }
    ]
}