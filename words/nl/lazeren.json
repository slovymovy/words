{
    "word_family": [
        "gelazer",
        "lazer"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a806acb4-b97b-3fd6-998b-72ca8b5f57c2",
                    "sense_definition": "Met kracht of onhandig vallen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vallen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij maakte een misstap en <w>lazerde</w> zo van het perron af.",
                            "target_lang_translations": {
                                "en": "He took a misstep and <w>tumbled</w> right off the platform."
                            }
                        },
                        {
                            "text": "Kijk uit dat je niet van die wankele trap af <w>lazert</w>.",
                            "target_lang_translations": {
                                "en": "Watch out that you don't <w>fall</w> off that shaky ladder."
                            }
                        }
                    ],
                    "synonyms": [
                        "donderen",
                        "duvelen",
                        "flikkeren",
                        "sodemieteren"
                    ],
                    "common_phrases": [
                        "van de trap lazeren"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informeel en ietwat plat"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To fall down hard, clumsily, or violently"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to tumble",
                                "target_lang_sense_clarification": "to fall clumsily"
                            },
                            {
                                "target_lang_word": "to fall",
                                "target_lang_sense_clarification": "to drop down, especially in a rough or sudden manner"
                            },
                            {
                                "target_lang_word": "to crash down",
                                "target_lang_sense_clarification": "to fall with force"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2160615b-9ae4-34b7-8bd0-215303973cb5",
                    "sense_definition": "Met kracht of op een ruwe manier werpen of gooien",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "gooien",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij was zo boos dat hij zijn oude boeken in de vuilnisbak <w>lazerde</w>.",
                            "target_lang_translations": {
                                "en": "He was so angry that he <w>chucked</w> his old books into the trash can."
                            }
                        },
                        {
                            "text": "Je kunt die oude spullen gewoon in de container <w>lazeren</w>.",
                            "target_lang_translations": {
                                "en": "You can just <w>toss</w> those old things into the dumpster."
                            }
                        }
                    ],
                    "synonyms": [
                        "donderen",
                        "flikkeren",
                        "sodemieteren"
                    ],
                    "common_phrases": [
                        "in de vuilnisbak lazeren"
                    ],
                    "traits": [
                        {
