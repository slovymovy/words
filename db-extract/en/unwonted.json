                "translations": [
                    {
                        "translation_id": "bcb9ad9b-e779-43df-86ed-64065b7985d6",
                        "source_entry_id": "a636cb42-86a0-3a40-a89f-386031909ded",
                        "source_sense_id": "ecd891a6-a955-3ccc-8748-ea46fea0ea57",
                        "source_sense_description": "attributiv: ungewohnt",
                        "target_lang_word": "ungewohnt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ungewohnt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2faf5352-3107-376a-bca2-7862f0af5fc0",
                                        "entry_id": "f85d1fbf-0662-3227-8c3b-81ae9ddec6de",
                                        "glosses": [
                                            "so, dass es nicht wie sonst ist, man es so nicht kennt oder gewohnt ist, es nicht vertraut, sondern fremd ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e078fa65-804c-4b39-a337-3c1db68ca80e",
                                                "sense_id": "2faf5352-3107-376a-bca2-7862f0af5fc0",
                                                "text": "Nachdem ich über 15 Jahre lang tagsüber gearbeitet hatte, war die Nachtarbeit für mich sehr ungewohnt."
                                            },
                                            {
                                                "example_id": "d7eae0e5-7dc5-4fe5-8561-0d1ce5c09856",
                                                "sense_id": "2faf5352-3107-376a-bca2-7862f0af5fc0",
                                                "text": "„Das ungewohnt intensive, komprimierte Erleben macht es erklärlich, dass Gleitschirmflieger im Verlust des Zeitgefühls die Erlebnisspanne länger einschätzen, als sie real war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
