                "senses": [
                    {
                        "sense_id": "e1e606f6-78c3-392a-9163-c4104158df23",
                        "entry_id": "87d36fdd-d57d-30de-9e9d-25e236f35c6f",
                        "glosses": [
                            "Donner un caractère dorsal à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ddc7800-5005-4f91-9302-970c5f99a886",
                                "sense_id": "e1e606f6-78c3-392a-9163-c4104158df23",
                                "text": "Ces embryologistes expérimentaux ont démontré qu’une région mésodermique mise au contact de l’ectoderme avait la vertu de dorsaliser cet ectoderme et de lui donner un « destin nerveux »."
                            },
                            {
                                "example_id": "cf2edc66-de36-4574-8d1d-ba338ad3c9e1",
                                "sense_id": "e1e606f6-78c3-392a-9163-c4104158df23",
                                "text": "Il devint alors possible de cloner les ADNc correspondant à des ARNm extraits du pourtour du blastopore, et d’examiner ensuite lesquels parmi ces clones étaient capables de dorsaliser l’embryon."
                            },
                            {
                                "example_id": "d3dce9d9-1963-4999-a3a8-36ac10fd7888",
                                "sense_id": "e1e606f6-78c3-392a-9163-c4104158df23",
                                "text": "Un traitement aux LiCL va dorsaliser les embryons."
                            }
                        ]
                    }
