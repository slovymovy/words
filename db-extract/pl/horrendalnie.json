                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a7d4fec-5476-41db-9d29-96940ff1ae59",
                                "sense_id": "e105f2b0-cea1-3143-896c-3a2a3c0ab523",
                                "text": "Ceny w alpejskich pensjonatach były horrendalnie wysokie, jak na tę porę roku."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "869d9dcf-b1b1-476c-a313-a588252b0a14",
                        "source_entry_id": "80d63626-8b1a-3d41-9221-c5c9bb304ccf",
                        "source_sense_id": "e105f2b0-cea1-3143-896c-3a2a3c0ab523",
                        "target_lang_word": "horrendously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "horrendously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "374f3d39-16dc-3471-87e9-0bf7bbedf4dc",
                                        "entry_id": "27c8b534-2f08-3594-8eee-4f8df3688294",
                                        "glosses": [
                                            "In a horrendous manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1d7a171-175d-42b0-a0c1-56542cacf3e4",
                                                "sense_id": "374f3d39-16dc-3471-87e9-0bf7bbedf4dc",
                                                "text": "The car handled horrendously when I took it for a test drive."
                                            },
                                            {
                                                "example_id": "07a2015a-e557-4fdb-91b0-357e59d98951",
                                                "sense_id": "374f3d39-16dc-3471-87e9-0bf7bbedf4dc",
                                                "text": "Mean-times, spelling and pronunciation are horrendously uncircumvoluted and the English vocabulary simply oozes with unloquaciousness. Irregardless of whether I say “wreck a nice beach” or “recognize speech,” you know what I mean, unless I say it too fast."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "700cbcab-bb8f-496d-887a-afba74ee9739",
                        "source_entry_id": "80d63626-8b1a-3d41-9221-c5c9bb304ccf",
                        "source_sense_id": "e105f2b0-cea1-3143-896c-3a2a3c0ab523",
                        "target_lang_word": "alarmingly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alarmingly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "57df4e9f-9ea9-3808-8db3-fd48a62499c7",
                                        "entry_id": "38aef9bc-90ff-3bee-8a08-7b94c9783d0a",
                                        "glosses": [
                                            "In an alarming way, frighteningly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12d6f298-281a-4ba7-9aab-dde6b0dd6b9a",
                                                "sense_id": "57df4e9f-9ea9-3808-8db3-fd48a62499c7",
                                                "text": "He sneezed alarmingly."
                                            },
                                            {
                                                "example_id": "1f1ea18c-3ada-445f-86b3-7141b4b1284b",
                                                "sense_id": "57df4e9f-9ea9-3808-8db3-fd48a62499c7",
                                                "text": "Even a small camber one way caused the whole outfit to list alarmingly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9b5794d-4a95-3b4a-a9bc-4f03be3adeba",
                                        "entry_id": "38aef9bc-90ff-3bee-8a08-7b94c9783d0a",
                                        "glosses": [
                                            "Causing fear or concern."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b72aa37-4f2c-4cf2-b4f9-1e1fa9ed79f8",
                                                "sense_id": "f9b5794d-4a95-3b4a-a9bc-4f03be3adeba",
                                                "text": "Alarmingly, he went into a severe sneezing fit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce94f6e5-2215-3d43-a0e4-dac183c8880b",
                                        "entry_id": "38aef9bc-90ff-3bee-8a08-7b94c9783d0a",
                                        "glosses": [
                                            "To an extent that causes alarm."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3497e20-1feb-4144-b78c-41181072d7c4",
                                                "sense_id": "ce94f6e5-2215-3d43-a0e4-dac183c8880b",
                                                "text": "He went into an alarmingly severe sneezing fit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c86a30f9-c458-4b01-a6db-4bd54ec13276",
                        "source_entry_id": "80d63626-8b1a-3d41-9221-c5c9bb304ccf",
                        "source_sense_id": "e105f2b0-cea1-3143-896c-3a2a3c0ab523",
                        "target_lang_word": "dreadfully",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dreadfully",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "94c395d4-d4c6-3f08-be36-32cc3b26b906",
                                        "entry_id": "32bc75ea-7e5c-33b1-858c-d086d185c20f",
                                        "glosses": [
                                            "In a dreadful manner; terribly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "599e71ce-9c61-4317-9274-e7f60bad3536",
                                                "sense_id": "94c395d4-d4c6-3f08-be36-32cc3b26b906",
                                                "text": "You behaved dreadfully yesterday night"
                                            },
                                            {
                                                "example_id": "5018de07-1c29-47a5-bf53-d8fd4acc26bd",
                                                "sense_id": "94c395d4-d4c6-3f08-be36-32cc3b26b906",
                                                "text": "The smellful old heathen was snoring dreadfully."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "620d5562-5732-39f9-9326-ec1bdcfb3569",
                                        "entry_id": "32bc75ea-7e5c-33b1-858c-d086d185c20f",
                                        "glosses": [
                                            "Exceptionally, eminently, very much."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc17c583-6508-4475-bd7c-5edbc5ecfe97",
                                                "sense_id": "620d5562-5732-39f9-9326-ec1bdcfb3569",
                                                "text": "That restaurant seems dreadfully expensive."
                                            },
                                            {
                                                "example_id": "decabd5a-c069-4871-9803-4f4bd460a01f",
                                                "sense_id": "620d5562-5732-39f9-9326-ec1bdcfb3569",
                                                "text": "At that moment a curious crack sounded inside the statue, as if something had broken. The fact is that the leaden heart had snapped right in two. It certainly was a dreadfully hard frost."
                                            },
                                            {
                                                "example_id": "1d5283ef-8d94-49c7-9d46-05132f5adfe5",
                                                "sense_id": "620d5562-5732-39f9-9326-ec1bdcfb3569",
                                                "text": "“Here it is,” said Eddie. “‘Why Must it Always be Tomato Soup?’ It's so deeply true, don't you feel? Tomato soup is so dreadfully eternal.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a0d27a1a-5e76-424c-a67d-4cd0ca0cbecf",
                        "source_entry_id": "80d63626-8b1a-3d41-9221-c5c9bb304ccf",
                        "source_sense_id": "e105f2b0-cea1-3143-896c-3a2a3c0ab523",
                        "target_lang_word": "horribly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "horribly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "42f7dd5f-89ed-3b46-a432-f98670247ffc",
                                        "entry_id": "620dd897-c21f-351b-95c2-943e68d948fa",
                                        "glosses": [
                                            "In a horrible way; very badly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc9875d8-09f0-407c-bcf3-760b17d2cbfa",
                                                "sense_id": "42f7dd5f-89ed-3b46-a432-f98670247ffc",
                                                "text": "The beginning art students displayed their horribly executed paintings with hopeful faces."
                                            },
                                            {
                                                "example_id": "4c855ae6-11eb-4601-9aa4-c2c7067359e1",
                                                "sense_id": "42f7dd5f-89ed-3b46-a432-f98670247ffc",
                                                "text": "Looking back at the 2020s from our vantage point in 2030, the first great event was the complete destruction of Donald Trump’s Republican Party. As the former Republican consultant Mike Murphy had noticed, there were roughly 300 state and federal elections during the Trump years and Republicans did horribly in most of them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2fa7ede4-665a-3e19-bdbd-f745435c0174",
                                        "entry_id": "620dd897-c21f-351b-95c2-943e68d948fa",
                                        "glosses": [
                                            "To an extreme degree or extent."
                                        ],
                                        "tags": [
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7cf53b48-b404-4920-8b50-f38976daf77c",
                                                "sense_id": "2fa7ede4-665a-3e19-bdbd-f745435c0174",
                                                "text": "Then everything went horribly wrong."
                                            },
                                            {
                                                "example_id": "6281f130-faaa-4dfe-9320-c831272193bb",
                                                "sense_id": "2fa7ede4-665a-3e19-bdbd-f745435c0174",
                                                "text": "The man was horribly nice, yet she still wouldn't marry him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95d65d44-af93-34ee-a4d2-8af620006128",
                                        "entry_id": "620dd897-c21f-351b-95c2-943e68d948fa",
                                        "glosses": [
                                            "With a very bad effect."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df7e1ff3-323c-41b3-be5a-6db5ea610fe4",
                                                "sense_id": "95d65d44-af93-34ee-a4d2-8af620006128",
                                                "text": "Horribly, as he was dying, his eyes reddened."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2a3c5481-edee-48d9-808e-92ce7cb121d0",
                        "source_entry_id": "80d63626-8b1a-3d41-9221-c5c9bb304ccf",
                        "source_sense_id": "e105f2b0-cea1-3143-896c-3a2a3c0ab523",
                        "target_lang_word": "horriblement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "horriblement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3035b24f-9fa8-3c1e-8f1c-8f009f2ea97d",
                                        "entry_id": "95a7bf6a-6292-3e27-a1b8-cc85c734a2ab",
                                        "glosses": [
                                            "D’une manière horrible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c01a14d4-5d5f-4da3-81f4-d3a9ebf95856",
                                                "sense_id": "3035b24f-9fa8-3c1e-8f1c-8f009f2ea97d",
                                                "text": "Des corps mutilés horriblement."
                                            },
                                            {
                                                "example_id": "f88f03e1-28ff-4312-9760-cfb35278ef06",
                                                "sense_id": "3035b24f-9fa8-3c1e-8f1c-8f009f2ea97d",
                                                "text": "Sa chevelure blême, en lanières épaisses,\nCrépitait au travers de l’ombre horriblement ;\nEt, derrière, en un rauque et long bourdonnement,\nSe déroulaient, selon la taille et les espèces,\nLes bêtes de la terre et du haut firmament."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5940481b-047d-3762-959d-4e6cfeea027d",
                                        "entry_id": "95a7bf6a-6292-3e27-a1b8-cc85c734a2ab",
                                        "glosses": [
                                            "Très mal."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9cd55003-9a87-43ad-9158-be964aae9c7d",
                                                "sense_id": "5940481b-047d-3762-959d-4e6cfeea027d",
                                                "text": "Je suis distrait ; je perds ; je joue horriblement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3dae5de3-91ad-39b7-8e0a-4b86d6b811f0",
                                        "entry_id": "95a7bf6a-6292-3e27-a1b8-cc85c734a2ab",
                                        "glosses": [
                                            "Extrêmement ; excessivement."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be50ad4d-60b9-4db3-a6a3-87de7c5dacbb",
                                                "sense_id": "3dae5de3-91ad-39b7-8e0a-4b86d6b811f0",
                                                "text": "Le temps a dû vous sembler horriblement long dans cette grotte ; […]."
                                            },
                                            {
                                                "example_id": "a7747417-2e1c-4e5a-bf25-e62680cf0efa",
                                                "sense_id": "3dae5de3-91ad-39b7-8e0a-4b86d6b811f0",
                                                "text": "Nous atteignons bientôt la région des nuages, et la température tombe si bas, que le froid nous mord horriblement les mains et les pieds."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
