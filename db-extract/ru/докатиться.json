                        ],
                        "examples": [
                            {
                                "example_id": "322d4891-092a-4b42-bd08-9aed7575038d",
                                "sense_id": "8c774eef-2d10-3fae-9c9b-9a5d2c242e04",
                                "text": "докати́ться до преступле́ния",
                                "translation": "to sink into crime",
                                "english": "to sink into crime"
                            },
                            {
                                "example_id": "74d9897a-427e-4d16-8a79-e6e540a10fb4",
                                "sense_id": "8c774eef-2d10-3fae-9c9b-9a5d2c242e04",
                                "text": "докати́ться до тюрьмы",
                                "translation": "to end up in jail",
                                "english": "to end up in jail"
                            },
                            {
                                "example_id": "a4a9a47c-3662-49e9-9cc5-4e65a4fc2423",
                                "sense_id": "8c774eef-2d10-3fae-9c9b-9a5d2c242e04",
                                "text": "вот до чего́ он докати́лся!",
                                "translation": "that's what he has come down to!",
                                "english": "that's what he has come down to!"
                            }
                        ]
