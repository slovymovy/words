                "senses": [
                    {
                        "sense_id": "8c1276a9-4f5d-3c75-ba67-64bc5d9ec09a",
                        "entry_id": "203658ce-2179-3afe-8140-80065d7d85cb",
                        "glosses": [
                            "Initialism of information technology equipment."
                        ],
                        "tags": [
                            "abbreviation",
                            "alt-of",
                            "initialism",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "81a61c6c-61ea-493a-96a4-c64b6604c5d3",
                                "sense_id": "8c1276a9-4f5d-3c75-ba67-64bc5d9ec09a",
                                "text": "Many electronic products fall under Information Technology Equipment (ITE) — equipment that enters, stores, displays, retrieves, transmits, processes, switches, or controls data or telecommunication messages. As of 2003 almost all worldwide safety standards for ITE are based on IEC 950/60950, Safety of information technology equipment"
                            }
                        ]
                    },
                    {
                        "sense_id": "89e8bddd-caa9-3384-9618-f39f0560a8ac",
                        "entry_id": "203658ce-2179-3afe-8140-80065d7d85cb",
                        "glosses": [
                            "Initialism of Institute of Technical Education."
                        ],
                        "tags": [
                            "Singapore",
                            "abbreviation",
                            "alt-of",
                            "initialism",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "ccdbc8bd-f7c0-4709-91a3-c385dbdb15f3",
                                "sense_id": "89e8bddd-caa9-3384-9618-f39f0560a8ac",
                                "text": "ITE doing comprehensive review of worker education courses."
                            },
                            {
                                "example_id": "43ad9bdb-45e0-4dfa-88b1-fc80b06ae276",
                                "sense_id": "89e8bddd-caa9-3384-9618-f39f0560a8ac",
                                "text": "The first regional campus, the ITE College East, was built in 2005. The remaining two, ITE College West and ITE College Central, will be completed by 2009 and 2011, respectively."
                            },
                            {
                                "example_id": "9d7e4df7-1a87-4c81-b5f4-b1a657c7e0a8",
                                "sense_id": "89e8bddd-caa9-3384-9618-f39f0560a8ac",
                                "text": "In 2011, Mr Haikal graduated from the Institute of Technical Education (ITE) with a diploma in technical engineering in machine technology and went on to complete his national service."
                            },
                            {
                                "example_id": "7323d449-8062-469d-9747-2afd593e41af",
                                "sense_id": "89e8bddd-caa9-3384-9618-f39f0560a8ac",
                                "text": "Mr Tharman, who is also Coordinating Minister for Economic and Social Policies, said that the ITE has been \"a remarkable success\" and one that many did not expect when the vocational training institute was set up in 1992."
                            },
                            {
                                "example_id": "7641cd07-4193-454d-989b-1d1006d7dc28",
                                "sense_id": "89e8bddd-caa9-3384-9618-f39f0560a8ac",
                                "text": "With the hub's opening, ITE College Central has become the first institute of higher learning to offer all of National Heritage Board's signature heritage education programmes, which include adopting a heritage trail and creating a heritage appreciation elective module."
                            }
                        ]
                    },
                    {
                        "sense_id": "dc9abce6-40cc-35b6-8499-f92748ca225d",
