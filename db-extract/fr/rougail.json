                "senses": [
                    {
                        "sense_id": "da561b90-5c8d-3e1d-b2a4-c0a9cfd08be1",
                        "entry_id": "9df033ab-6b41-3ad0-83b9-fcb7ad32b921",
                        "glosses": [
                            "Condiment très épicé, utilisé à la Réunion, à Maurice ou à Madagascar qui se compose traditionnellement de tomates coupées en petits dés, de petits morceaux de légumes, de gingembre pilé, d'oignons émincés et de piments."
                        ],
                        "tags": [
                            "La Réunion",
                            "Île Maurice",
                            "Madagascar"
                        ],
                        "examples": [
                            {
                                "example_id": "376cc323-9ef7-4b52-ad33-f73b20ca29be",
                                "sense_id": "da561b90-5c8d-3e1d-b2a4-c0a9cfd08be1",
                                "text": "Le cours ordinaire du repas est parfois dévié et nous transporte à Nouméa : parce que c'est dans l'humeur et dans l'air, peut-être parce que ma mère a mis sur la table du curry ou des boulettes de poulet au rougail, qu'elle obtenait en écrasant au pilon, dans un petit mortier de bois, de l'oignon, du gingembre et du piment rouge."
                            }
                        ]
                    },
                    {
                        "sense_id": "9a02a66b-d16b-39e5-bbf4-5f96573a0929",
                        "entry_id": "9df033ab-6b41-3ad0-83b9-fcb7ad32b921",
                        "glosses": [
                            "Plat traditionnel réunionnais, mauricien ou malgache utilisant ce condiment et se rapprochant du cari."
                        ],
                        "tags": [
                            "ellipsis"
                        ],
                        "examples": [
                            {
                                "example_id": "8d68fa50-397f-4e98-878f-b8fb6230bfbf",
                                "sense_id": "9a02a66b-d16b-39e5-bbf4-5f96573a0929",
                                "text": "Un cari traditionnel se compose de plusieurs plats : un cari de viande ou de poisson servi accompagné d'une variété de rougails, de brèdes, de riz blanc et d'un choix d’achards et de piments."
                            },
                            {
                                "example_id": "dad3f539-d470-4049-81de-7d05feb675fd",
                                "sense_id": "9a02a66b-d16b-39e5-bbf4-5f96573a0929",
                                "text": "Moi qui espérais aller déjeuner en ville plutôt que de manger le reste de rougail qui traîne au frigo et dont je ne sais plus quelle sorte de rougail ça peut être parce que j'ai jeté le couvercle et que Céline a emporté mes ordures en même temps que mes vêtements."
                            }
                        ]
                    }
