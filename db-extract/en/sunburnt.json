    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "b2bc7b63-5c50-3fb8-86bb-f725f95656d7",
                "word": "sunburnt",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "f4b0f369-545e-48ac-b14a-dd07b5bb5914",
                        "entry_id": "b2bc7b63-5c50-3fb8-86bb-f725f95656d7",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more sunburnt"
                    },
                    {
                        "form_id": "4f476015-32ac-410f-a5c5-c39791603b24",
                        "entry_id": "b2bc7b63-5c50-3fb8-86bb-f725f95656d7",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most sunburnt"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "291c32f4-1862-3d6f-8175-d997388c0d2a",
                        "entry_id": "b2bc7b63-5c50-3fb8-86bb-f725f95656d7",
                        "glosses": [
                            "Having a sunburn or dark tan; having been burned by the sun's rays."
                        ],
                        "tags": [
                            "of human skin"
                        ],
                        "examples": [
                            {
                                "example_id": "8fd90ea9-9dcc-48ab-8306-1132d407f96a",
                                "sense_id": "291c32f4-1862-3d6f-8175-d997388c0d2a",
                                "text": "You sunburnt sicklemen, of August weary, / Come hither from the furrow and be merry:"
                            },
                            {
                                "example_id": "c046ed65-edcc-4c58-96a7-5bbffca0c000",
                                "sense_id": "291c32f4-1862-3d6f-8175-d997388c0d2a",
                                "text": "[…] I must beg leave to say for my self, that I am as fair as most of my Sex and Country, and very little sun-burnt by my Travels."
                            },
                            {
                                "example_id": "21f16c42-4356-4023-a5b1-066b139e23b8",
                                "sense_id": "291c32f4-1862-3d6f-8175-d997388c0d2a",
                                "text": "He looked and smelt like Autumn’s very brother, his face being sunburnt to wheat-colour, his eyes blue as corn-flowers, his sleeves and leggings dyed with fruit-stains […]"
                            },
                            {
                                "example_id": "62bac73a-6bf1-41ff-8bdb-616c804960b0",
                                "sense_id": "291c32f4-1862-3d6f-8175-d997388c0d2a",
                                "text": "His face was sunburned bright red, and the skin of his ears was peeling."
                            }
                        ]
                    },
                    {
                        "sense_id": "4ae9569e-934b-3db3-9737-43c325f231e2",
                        "entry_id": "b2bc7b63-5c50-3fb8-86bb-f725f95656d7",
                        "glosses": [
                            "Dried out by the sun's rays."
                        ],
                        "tags": [
                            "of plants and other objects"
                        ],
                        "examples": [
                            {
                                "example_id": "6dcdb672-e809-465b-bac9-5d8560fce146",
                                "sense_id": "4ae9569e-934b-3db3-9737-43c325f231e2",
                                "text": "1753, Arthur Murphy, The Gray’s-Inn Journal, No. 53, 20 October, 1753, London: P. Vaillant, 1756, Volume 2, p. 191,\nThe barren Heath, and the Sun-burnt craggy Soil appear with all those Softenings to the Eye, which Distance throws upon a Landscape;"
                            },
                            {
                                "example_id": "7b701cef-c197-4f60-98f3-a2d5b5f5f2e9",
                                "sense_id": "4ae9569e-934b-3db3-9737-43c325f231e2",
                                "text": "the well-remembered dusty road and sun-burnt fields"
                            },
                            {
                                "example_id": "0da79135-f7af-44ba-b683-c2de3466167f",
                                "sense_id": "4ae9569e-934b-3db3-9737-43c325f231e2",
                                "text": "The […] fortress of the Incas stood on a lofty eminence, the steep sides of which […] were cut into terraces, defended by strong walls of stone and sunburnt brick."
                            },
                            {
                                "example_id": "e006f963-1e64-490f-9d0c-a8282b429867",
                                "sense_id": "4ae9569e-934b-3db3-9737-43c325f231e2",
                                "text": "[O]ut on to the bare hillside’s sunburnt grass"
                            }
                        ]
                    },
                    {
                        "sense_id": "ed25de51-aa00-3261-b5b3-1fac6d0d79a7",
                        "entry_id": "b2bc7b63-5c50-3fb8-86bb-f725f95656d7",
                        "glosses": [
                            "Subject to the strong heat and/or light of the sun."
                        ],
                        "tags": [
                            "of places or objects"
                        ],
                        "examples": [
                            {
                                "example_id": "f1792a35-f1bb-47d7-ac26-a9c0cf74a805",
                                "sense_id": "ed25de51-aa00-3261-b5b3-1fac6d0d79a7",
                                "text": "So my dear Charles, you are at length […] arrived in our little sun-burnt island?"
                            },
                            {
                                "example_id": "2d0fa498-5d82-40a8-8626-b0f0cc2e4fb8",
                                "sense_id": "ed25de51-aa00-3261-b5b3-1fac6d0d79a7",
                                "text": "[…] when distances are obscured by mist […] the foreground assumes all its loveliest hues, the grass and foliage revive into their perfect green, and every sunburnt rock glows into an agate."
                            },
                            {
                                "example_id": "92e03fca-78ad-441c-bf46-c1602099dea9",
                                "sense_id": "ed25de51-aa00-3261-b5b3-1fac6d0d79a7",
                                "text": "Most of it [the island of Mauritius] was high […] so that gusts of fresh winds often blew exuberantly off the sea, and the British could build their villas far above the sunburnt coast."
                            }
                        ]
                    },
                    {
                        "sense_id": "93fb7cdf-6e9a-32ea-85af-77832f60a716",
                        "entry_id": "b2bc7b63-5c50-3fb8-86bb-f725f95656d7",
                        "glosses": [
                            "Resembling a sunburn in color."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e390b7e-fd97-4a05-87a6-5879c00839c1",
                                "sense_id": "93fb7cdf-6e9a-32ea-85af-77832f60a716",
                                "text": "The van was painted a sunburnt brown."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f417245c-a691-4482-ab1e-b52707b3c861",
                        "source_entry_id": "b2bc7b63-5c50-3fb8-86bb-f725f95656d7",
                        "source_sense_description": "having a sunburn; having been burned by the sun's rays",
                        "target_lang_word": "sonnenverbrannt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sonnenverbrannt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "089aab34-afb6-3d37-b532-d0398b220e18",
                                        "entry_id": "419bce07-9fe0-3ff2-a100-943b5bb813b5",
                                        "glosses": [
                                            "durch die Einwirkung von Sonnenstrahlen verbrannt/verdorrt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e77f490c-1c00-4734-9555-a11c55e7adcf",
                                                "sense_id": "089aab34-afb6-3d37-b532-d0398b220e18",
                                                "text": "„Die Bäume an der Straße duften nach sonnenverbranntem Eukalyptus.“"
                                            },
                                            {
                                                "example_id": "1bfd060b-36cd-43a9-889a-7e31e3ab9203",
                                                "sense_id": "089aab34-afb6-3d37-b532-d0398b220e18",
                                                "text": "„Der Schlafsack wurde zurückgeschlagen und gab seinen Inhalt frei - einen bärtigen, sonnenverbrannten Mann.“"
                                            },
                                            {
                                                "example_id": "2624875e-1881-436e-b7c0-54d28777b745",
                                                "sense_id": "089aab34-afb6-3d37-b532-d0398b220e18",
                                                "text": "„Lottie Mae drehte sich langsam zu dem Mann um, der sie angesprochen hatte. Er war weiß und sonnenverbrannt und hatte schwarze Bartstoppeln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
