                                        "entry_id": "f8ae35db-e436-3491-800d-cf6a8a0efc5d",
                                        "glosses": [
                                            "Fil de suture résorbable fabriqué à partir d'intestins d'animaux. En France son emploi est interdit en chirurgie depuis 2001 à cause de cette origine animale."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b229d72-ed26-4bf8-8546-3df36aeae831",
                                                "sense_id": "4dbca942-6fb9-3fbd-ac17-c29176535b1c",
                                                "text": "Plusieurs chirurgiens n’ont pas ajouté foi au fait qu’une substance morte comme le catgut puisse être absorbée."
                                            },
                                            {
                                                "example_id": "78d14b94-de88-4070-bf6d-cc7a8e49eb24",
                                                "sense_id": "4dbca942-6fb9-3fbd-ac17-c29176535b1c",
                                                "text": "Mais la main de l’aide tremblait en approchant le catgut."
                                            }
                                        ]
                                    }
                                ]
                            }
