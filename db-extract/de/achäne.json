                                "target_senses": [
                                    {
                                        "sense_id": "ac146059-d267-3d1e-8f1a-2c8108965646",
                                        "entry_id": "d64602b3-d1a2-37d0-9146-7692af843fcd",
                                        "glosses": [
                                            "A small, dry, indehiscent fruit, containing a single seed, as in the buttercup."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb5913e0-ab27-4094-bcac-9ff135cdacad",
                                                "sense_id": "ac146059-d267-3d1e-8f1a-2c8108965646",
                                                "text": "The mulberry puts forth its messy clusters of achenes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8692451c-ed71-45e5-9609-3af0b1f9c9dc",
                        "source_entry_id": "43279118-c294-3391-83f3-4dfcddc2a93a",
                        "source_sense_id": "df07a498-4ee6-3139-83a6-7cc285f3f0f2",
                        "source_sense_description": "Sonderform der einsamigen Frucht der Korbblütler",
                        "target_lang_word": "akène",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "akène",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d4df50f8-055f-3124-bd7a-cacdec295508",
                                        "entry_id": "b1ac1af7-4811-3da9-8899-fe506b983119",
                                        "glosses": [
                                            "Fruit sec et indéhiscent ne contenant qu’une graine dont le péricarpe, plus ou moins sclérifié, n’est pas soudé à la graine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3fcd391-c8e6-4041-8475-e4a47d1b8845",
                                                "sense_id": "d4df50f8-055f-3124-bd7a-cacdec295508",
                                                "text": "Le fruit du chêne, le gland, est un akène."
                                            },
                                            {
                                                "example_id": "aa2acdb6-656f-48a7-a2ad-9b5b5e358f46",
                                                "sense_id": "d4df50f8-055f-3124-bd7a-cacdec295508",
                                                "text": "L’artichaut et le pissenlit ont des akènes plumeux."
                                            },
                                            {
                                                "example_id": "927a4f36-b974-48c9-8205-3251713d5488",
                                                "sense_id": "d4df50f8-055f-3124-bd7a-cacdec295508",
                                                "text": "Un cas spécial d’inconsistance, d’évanescence physique. Elle s’envolerait si on lui soufflait dessus, comme les akènes d’un pissenlit."
                                            },
                                            {
                                                "example_id": "62b15812-70db-403c-bb88-1ce676e787c8",
                                                "sense_id": "d4df50f8-055f-3124-bd7a-cacdec295508",
                                                "text": "[La chair interne de la figue], constituée de petits grains – autant de microfruits, appelés « akènes » en botanique – varie, comme le vin, du rouge au blanc, du rosé au jaune."
                                            },
                                            {
                                                "example_id": "2fae718a-efa9-4804-a4d2-cf2f373872af",
                                                "sense_id": "d4df50f8-055f-3124-bd7a-cacdec295508",
                                                "text": "Chaque méricarpe ne renferme qu’une seule graine et correspond donc à un fruit sec à une seule graine soudée à la paroi du fruit, un akène. On peut donc assimiler, d’un point de vue fonctionnel, chacun des méricarpes à un fruit-graine. D’ailleurs quand vous achetez un sachet de graines de carottes cultivées, en fait ce sont des akènes donc des fruits que vous semez."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fa7b0e15-2f74-4845-b364-8fb0f0fdf696",
                        "source_entry_id": "43279118-c294-3391-83f3-4dfcddc2a93a",
                        "source_sense_id": "df07a498-4ee6-3139-83a6-7cc285f3f0f2",
