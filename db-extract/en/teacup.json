                                "target_senses": [
                                    {
                                        "sense_id": "038a0297-7ad2-309a-8923-44e18c4060f2",
                                        "entry_id": "a5332191-fb31-3005-a807-295a1888fd07",
                                        "glosses": [
                                            "eine Tasse speziell für Tee"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92b7fce7-690d-4f9f-a1b3-8c969a211d54",
                                                "sense_id": "038a0297-7ad2-309a-8923-44e18c4060f2",
                                                "text": "Teetassen haben gewöhnlich eine etwas weitere Form als Kaffeetassen."
                                            },
                                            {
                                                "example_id": "157587f7-ad70-43f1-8d87-cdd927fa4f3f",
                                                "sense_id": "038a0297-7ad2-309a-8923-44e18c4060f2",
                                                "text": "„Schlehenblüte ergriff, gewissermaßen als Strafmaßnahme, eine Teetasse, füllte sie bis zum Überlaufen mit Wein und reichte sie ihm.“"
                                            },
                                            {
                                                "example_id": "d9c198ab-ff94-4d4f-86b5-83373dd2ce9d",
                                                "sense_id": "038a0297-7ad2-309a-8923-44e18c4060f2",
                                                "text": "„Als Anna die Teetasse auf den Tisch zurückstellen wollte, klirrte das Porzellan.“"
                                            },
                                            {
                                                "example_id": "ed75d27d-6cd6-44a5-8671-da32aa6f4f94",
                                                "sense_id": "038a0297-7ad2-309a-8923-44e18c4060f2",
                                                "text": "„Im Salonwagen klirrten die Teetassen im Rhythmus der Räder.“"
                                            },
                                            {
                                                "example_id": "a4e5fb1d-8c7f-4212-a9e2-f5714e3c33be",
                                                "sense_id": "038a0297-7ad2-309a-8923-44e18c4060f2",
                                                "text": "„Vilborg stellte die Teetasse ab und lachte freudlos.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
