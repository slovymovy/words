                                                "example_id": "91d03fbd-560f-4d26-96f9-b44264b5bb11",
                                                "sense_id": "0a5c3b58-3c89-3255-9820-6be309b90e7f",
                                                "text": "hostile intentions"
                                            },
                                            {
                                                "example_id": "260202aa-fef0-4d9b-9140-a12d8ac9de16",
                                                "sense_id": "0a5c3b58-3c89-3255-9820-6be309b90e7f",
                                                "text": "a hostile country"
                                            },
                                            {
                                                "example_id": "cb2e7d44-f438-4b4e-b6a9-d69218141329",
                                                "sense_id": "0a5c3b58-3c89-3255-9820-6be309b90e7f",
                                                "text": "hostile to a sudden change"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd65caa9-73bd-3be2-bd4d-f5dffb0ec5cf",
                                        "entry_id": "737a4273-19e9-3fd7-b0b2-6b688d748376",
