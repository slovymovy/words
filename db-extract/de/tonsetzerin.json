                "senses": [
                    {
                        "sense_id": "ea92ab8d-4d4d-3742-8b11-b42451fd6f7e",
                        "entry_id": "72ecfc8b-4c8e-3d21-bc03-c1b5e0d308cc",
                        "glosses": [
                            "Künstlerin, die musikalische Werke schafft"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "bf7a2bcd-f1a8-419d-9c87-c13db3d8fa42",
                                "sense_id": "ea92ab8d-4d4d-3742-8b11-b42451fd6f7e",
                                "text": "„Weltläufig, wie die produktive Tonsetzerin ist, füllt sie damit nicht nur die Frauenkirche, sozusagen bis unter die Kuppel, mit der großen Chor- und Orchesterpranke aus.“"
                            },
                            {
                                "example_id": "21696bc7-645d-46fd-905c-319100e873b3",
                                "sense_id": "ea92ab8d-4d4d-3742-8b11-b42451fd6f7e",
                                "text": "„Die Kunst der Tonsetzerin Löwenmark zeigt sich darin, dass sie weiß, was ihre Musik vertragen kann und sie nicht überlädt.“"
                            },
                            {
                                "example_id": "0e24381e-8a88-4e32-986e-c063f8e2c853",
                                "sense_id": "ea92ab8d-4d4d-3742-8b11-b42451fd6f7e",
                                "text": "„Der russischen Komponistin, der bedeutendsten Tonsetzerin weltweit, die unweit von Hamburg lebt, ist ein Schwerpunkt des Musikfests gewidmet.“"
                            },
                            {
                                "example_id": "b0aea510-12d5-4638-a093-eb8f450dff3c",
                                "sense_id": "ea92ab8d-4d4d-3742-8b11-b42451fd6f7e",
                                "text": "„Das Programm enthält Auftragswerke der türkischen Tonsetzerin Zeynep Gedizlioglu und ihres deutschen Kollegen Helmut Oehring sowie ein 2006 entstandenes Stück des Armeniers Vache Sharafyan.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
