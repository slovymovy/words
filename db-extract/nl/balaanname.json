                        "examples": [
                            {
                                "example_id": "fbeed244-260f-4daf-8b26-ee57ea2c34ab",
                                "sense_id": "0e0fcc9f-deaa-37a3-a34a-d05505fe748e",
                                "text": "De sculptuur beeldt een balaanname van Bergkamp uit in een wedstrijd tegen Newcastle United in 2003. Hangend in de lucht brengt hij de bal onder controle met de punt van zijn voet. Het beeld wordt aan het begin van volgend seizoen onthuld."
                            },
                            {
                                "example_id": "58192838-e856-4100-9fdd-f1f09e484aac",
                                "sense_id": "0e0fcc9f-deaa-37a3-a34a-d05505fe748e",
                                "text": "\"We deden onszelf alleen tekort door slechts één doelpunt te maken. Op de beslissende momenten was óf de eindpass óf de balaanname niet goed genoeg om minimaal een tweede treffer te maken.\""
                            }
