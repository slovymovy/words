                                "target_senses": [
                                    {
                                        "sense_id": "96fde2f7-4a02-3725-a2ab-41420617f192",
                                        "entry_id": "24436666-a2e7-3d92-828c-292b09d244d9",
                                        "glosses": [
                                            "Any of several perennial grasses, of genus Miscanthus, native to subtropical and tropical regions of Africa and southern Asia, which is cultivated as an ornamental plant and is being used as a source of biomass for the production of biofuel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55c056c4-3690-42d2-b062-487047f11722",
                                                "sense_id": "96fde2f7-4a02-3725-a2ab-41420617f192",
                                                "text": "On the four sides of the box are autumnal plants — asters, patrinias, crawfudias, miscanthuses, eupatoriiuns, platycodons, and chrysanthemums, among which butterflies hover."
                                            },
                                            {
                                                "example_id": "a8901ddb-6c96-42ed-ac6f-f6f2af9773cb",
                                                "sense_id": "96fde2f7-4a02-3725-a2ab-41420617f192",
                                                "text": "These miscanthuses are magnificent plants, great green mounds getting taller and taller through the summer and fall,[…]."
                                            },
                                            {
                                                "example_id": "219e5daa-7038-41f7-bac6-4c40719da388",
                                                "sense_id": "96fde2f7-4a02-3725-a2ab-41420617f192",
                                                "text": "Two species, switchgrass (Panicum virgatum L.) and giant miscanthus (Miscanthus × giganteus), are of interest as dedicated energy crops as both have great biomass production potential."
                                            }
                                        ]
                                    }
