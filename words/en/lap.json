{
    "word_family": [
        "overlap",
        "laptop",
        "unlap",
        "earflap",
        "mudflap",
        "lapper"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "041e4320-b6f4-34ca-a60c-b5c6e814d59a",
                    "sense_definition": "The upper part of the legs of a person who is sitting down.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "body_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The little boy sat on his mother's <w>lap</w> while she read a story.",
                            "target_lang_translations": {
                                "ru": "Маленький мальчик сидел у мамы на <w>коленях</w>, пока она читала сказку.",
                                "zh": "妈妈读故事时，小男孩坐在她<w>腿上</w>。"
                            }
                        },
                        {
                            "text": "She placed her napkin on her <w>lap</w> before starting to eat dinner.",
                            "target_lang_translations": {
                                "ru": "Она положила салфетку себе на <w>колени</w> перед тем, как начать ужинать.",
                                "zh": "开始吃晚饭前，她把餐巾放在自己<w>膝上</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "sit on someone's lap",
                        "in someone's lap"
                    ],
                    "target_lang_definitions": {
                        "ru": "Верхняя часть ног сидящего человека.",
                        "zh": "坐着的人双腿上方的部位。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "колени",
                                "target_lang_sense_clarification": "часть тела"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "腿上",
                                "target_lang_sense_clarification": "坐着时大腿形成的部位"
                            },
                            {
                                "target_lang_word": "膝上",
                                "target_lang_sense_clarification": "较书面，多指坐着时双腿前部的位置"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e731a88c-cd3f-3a34-ad48-d8083381d70e",
                    "sense_definition": "One complete trip around a race track or one full length of a swimming pool.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sports_circuit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The runner sprinted hard to finish the final <w>lap</w> of the race.",
                            "target_lang_translations": {
                                "ru": "Бегун изо всех сил рванул, чтобы завершить последний <w>круг</w> гонки.",
                                "zh": "那名跑步选手拼尽全力冲刺，完成比赛的最后一<w>圈</w>。"
                            }
                        },
                        {
                            "text": "I try to swim twenty <w>laps</w> every morning to stay healthy.",
                            "target_lang_translations": {
                                "ru": "Я стараюсь проплывать двадцать <w>кругов</w> каждое утро, чтобы поддерживать здоровье.",
                                "zh": "为了保持健康，我每天早上都尽量游二十<w>趟</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "circuit",
                        "round",
                        "loop"
                    ],
                    "common_phrases": [
                        "victory lap",
                        "final lap",
                        "lap of honor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Один полный круг по гоночной трассе или одна полная длина бассейна.",
                        "zh": "绕跑道完整跑一圈，或在游泳池中完整游过一段的距离。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "круг",
                                "target_lang_sense_clarification": "этап гонки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "圈",
                                "target_lang_sense_clarification": "赛跑、赛车等的一整圈"
                            },
                            {
                                "target_lang_word": "趟",
                                "target_lang_sense_clarification": "游泳时一个来回或一段池长"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "148c9d6e-28ec-3ce9-9b2c-43f2dab6e9ce",
                    "sense_definition": "A part of a material or object that covers or lies over the edge of another part.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "overlap_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The carpenter checked the <w>lap</w> of the wooden boards to ensure a tight fit.",
                            "target_lang_translations": {
                                "ru": "Плотник проверил <w>нахлёст</w> деревянных досок, чтобы убедиться в плотности подгонки.",
                                "zh": "木匠检查了木板之间的<w>搭接</w>，以确保接合严密。"
                            }
                        },
                        {
                            "text": "There was a small <w>lap</w> where the two sheets of metal were joined together.",
                            "target_lang_translations": {
                                "ru": "В месте соединения двух листов металла был небольшой <w>нахлёст</w>.",
                                "zh": "两张金属板连接的地方有一小段<w>重叠部分</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "overlap"
                    ],
                    "target_lang_definitions": {
                        "ru": "Часть материала или предмета, которая перекрывает край другой части.",
                        "zh": "材料或物体的一部分盖在另一部分边缘上的重叠部分。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нахлёст",
                                "target_lang_sense_clarification": "перекрытие"
                            },
                            {
                                "target_lang_word": "перекрытие",
                                "target_lang_sense_clarification": "место соединения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "搭接",
                                "target_lang_sense_clarification": "材料彼此压住、盖住的部分"
                            },
                            {
                                "target_lang_word": "重叠部分",
                                "target_lang_sense_clarification": "两部分相互覆盖的地方"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b6f8c081-47c8-34ce-ae49-625997663b25",
                    "sense_definition": "To drink a liquid by lifting it up with the tongue, usually done by animals.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "liquid_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The thirsty dog began to <w>lap</w> up the water from the bowl.",
                            "target_lang_translations": {
                                "ru": "Мучимая жаждой собака начала <w>лакать</w> воду из миски.",
                                "zh": "口渴的狗开始<w>舔饮</w>碗里的水。"
                            }
                        },
                        {
                            "text": "We watched the kittens <w>lap</w> the milk from the saucer.",
                            "target_lang_translations": {
                                "ru": "Мы наблюдали, как котята <w>лакают</w> молоко из блюдца.",
                                "zh": "我们看着小猫从碟子里<w>舔饮</w>牛奶。"
                            }
                        }
                    ],
                    "synonyms": [
                        "lick",
                        "drink"
                    ],
                    "common_phrases": [
                        "lap up"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пить жидкость, поднимая её языком (обычно о животных).",
                        "zh": "用舌头把液体卷起来喝，通常用于动物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лакать",
                                "target_lang_sense_clarification": "пить языком"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "舔饮",
                                "target_lang_sense_clarification": "指动物用舌头把液体卷起来喝"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fde6e585-a651-3e11-bfcd-ecc28b2e0194",
                    "sense_definition": "To hit gently against a surface with a soft splashing sound, usually describing water.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "liquid_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was relaxing to hear the waves <w>lap</w> against the side of the boat.",
                            "target_lang_translations": {
                                "ru": "Было приятно слушать, как волны <w>плещутся</w> о борт лодки.",
                                "zh": "听着海浪<w>拍打</w>船舷，让人感到很放松。"
                            }
                        },
                        {
                            "text": "The lake water started to <w>lap</w> at the rocks near the shore.",
                            "target_lang_translations": {
                                "ru": "Озерная вода начала <w>плескаться</w> о камни у берега.",
                                "zh": "湖水开始<w>拍打</w>岸边的岩石。"
                            }
                        }
                    ],
                    "synonyms": [
                        "splash",
                        "wash",
                        "ripple"
                    ],
                    "common_phrases": [
                        "lap against",
                        "lap at"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мягко ударяться о поверхность с тихим плеском (обычно о воде).",
                        "zh": "轻柔地带着水声拍击某个表面，通常形容水。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плескаться",
                                "target_lang_sense_clarification": "о воде"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拍打",
                                "target_lang_sense_clarification": "指水轻轻拍击某个表面"
                            },
                            {
                                "target_lang_word": "轻拍",
                                "target_lang_sense_clarification": "书面语，指水轻轻冲击岸边或物体"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0f362437-9fae-30d2-968d-fb18d46d9690",
                    "sense_definition": "To pass another competitor in a race because you are one full circuit ahead of them.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sports_circuit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The leading driver was so fast that he managed to <w>lap</w> the last car.",
                            "target_lang_translations": {
                                "ru": "Лидирующий гонщик был так быстр, что сумел <w>обогнать на круг</w> последнюю машину.",
                                "zh": "领先的车手速度快得惊人，竟然把最后那辆车<w>超了一圈</w>。"
                            }
                        },
                        {
                            "text": "If you run too slowly, the faster runners might <w>lap</w> you before the end.",
                            "target_lang_translations": {
                                "ru": "Если ты побежишь слишком медленно, более быстрые бегуны могут <w>обогнать</w> тебя <w>на круг</w> до финиша.",
                                "zh": "如果你跑得太慢，跑得更快的人可能会在终点前把你<w>超一圈</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "overtake",
                        "pass"
                    ],
                    "common_phrases": [
                        "get lapped"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обогнать другого участника соревнования, опередив его на полный круг.",
                        "zh": "在比赛中因领先整整一圈而超过另一名选手。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обогнать на круг",
                                "target_lang_sense_clarification": "в гонках"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "超一圈",
                                "target_lang_sense_clarification": "比赛中领先对手整整一圈"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b07194a4-3fea-3c8b-893e-edc6ca9e53ab",
                    "sense_definition": "To fold or wrap something around something else, or to lie partly over something.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "overlap_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to <w>lap</w> the warm blanket around the shivering child.",
                            "target_lang_translations": {
                                "ru": "Она решила <w>закутать</w> дрожащего ребенка в теплое одеяло.",
                                "zh": "她决定用温暖的毯子<w>裹住</w>那个冻得发抖的孩子。"
                            }
                        },
                        {
                            "text": "You must <w>lap</w> the roof tiles correctly so that the rain runs off.",
                            "target_lang_translations": {
                                "ru": "Нужно правильно <w>класть внахлёст</w> черепицу, чтобы стекал дождь.",
                                "zh": "你必须把屋顶瓦片正确地<w>搭接</w>铺放，这样雨水才能流下去。"
                            }
                        }
                    ],
                    "synonyms": [
                        "wrap",
                        "fold",
                        "overlap",
                        "enfold"
                    ],
                    "antonyms": [
                        "unlap"
                    ],
                    "common_phrases": [
                        "lap over",
                        "lap around"
                    ],
                    "target_lang_definitions": {
                        "ru": "Складывать или оборачивать что-то вокруг чего-то, или лежать, частично перекрывая.",
                        "zh": "把某物包裹在别的东西周围，或使其一部分覆盖在另一部分上。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "закутывать",
                                "target_lang_sense_clarification": "оборачивать"
                            },
                            {
                                "target_lang_word": "класть внахлёст",
                                "target_lang_sense_clarification": "частично перекрывать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "裹住",
                                "target_lang_sense_clarification": "把某物裹在另一样东西周围"
                            },
                            {
                                "target_lang_word": "搭接",
                                "target_lang_sense_clarification": "使一部分压住另一部分"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}