                "senses": [
                    {
                        "sense_id": "eb3cea0e-29a6-3be9-96b4-451d9fb6307c",
                        "entry_id": "f0ee7c66-5aef-325a-9eab-09ed916d0499",
                        "glosses": [
                            "Effet d’échantillonnage où des composantes situées au-delà de la moitié de la fréquence d’échantillonnage deviennent indiscernables de composantes plus basses et sont perçues comme telles dans le signal discret."
                        ],
                        "tags": [
                            "Traitement du signal"
                        ],
                        "examples": [
                            {
                                "example_id": "b214f09d-ad0a-47be-b76a-de9c34cad85e",
                                "sense_id": "eb3cea0e-29a6-3be9-96b4-451d9fb6307c",
                                "text": "L’aliasing et les erreurs d’approximation sont étudiés lorsque cette condition n’est pas satisfaite."
                            }
                        ]
                    },
                    {
                        "sense_id": "c293c101-d2d1-367e-b30e-9d08fcd5ebc6",
                        "entry_id": "f0ee7c66-5aef-325a-9eab-09ed916d0499",
                        "glosses": [
                            "Altération des contours et des motifs fins d’une image, provoquée par un échantillonnage spatial insuffisant, qui transforme des détails trop serrés en structures plus grossières ou à contours irréguliers"
                        ],
                        "tags": [
                            "Traitement d’image",
                            "Jeux vidéo"
                        ],
                        "examples": [
                            {
                                "example_id": "84d92a4a-9b4f-45d4-afa2-b49176d7d013",
                                "sense_id": "c293c101-d2d1-367e-b30e-9d08fcd5ebc6",
                                "text": "Un des problèmes majeurs de la technique est que les vitesses circulatoires doivent être a priori connues pour éviter les phénomènes « d’aliasing » bien connus par les doppleristes."
                            }
                        ]
                    }
