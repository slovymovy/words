                ],
                "senses": [
                    {
                        "sense_id": "8824d3d6-94ea-36e4-aa85-47dcfaf00595",
                        "entry_id": "c2e1e65b-d664-3a1e-9379-e226bfb602f5",
                        "glosses": [
                            "Sacrebleu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1402ecb-bbfc-4bca-88f9-6354aa3f40fe",
                                "sense_id": "8824d3d6-94ea-36e4-aa85-47dcfaf00595",
                                "text": "Par la sangbleu, messieurs, je ne croyais pas être\nSi plaisant que je suis."
                            },
                            {
                                "example_id": "6508a5b5-2eb4-4800-be49-f71d7d9c8e18",
                                "sense_id": "8824d3d6-94ea-36e4-aa85-47dcfaf00595",
                                "text": "…sangbleu ! que vous m’avez fait mal !"
                            },
                            {
                                "example_id": "85a57bcc-faee-4dc3-bca6-f5950a05bb46",
                                "sense_id": "8824d3d6-94ea-36e4-aa85-47dcfaf00595",
                                "text": "Philippe-Auguste, en 1181, avait condamné les nobles de son domaine qui prononceraient têtebleu, ventrebleu, corbleu, sangbleu, à payer une amende, et les roturiers à être noyés."
                            },
                            {
                                "example_id": "e9360a0a-a1f3-41f0-a8c0-ca42b484cccf",
                                "sense_id": "8824d3d6-94ea-36e4-aa85-47dcfaf00595",
                                "text": "— Cette fois, ils m’ont tout pris. Je suis bon à mettre en terre. Il ne me reste que ma peau… Oui, mais aussi, sangbleu, il reste ce qu’il y a dedans."
                            }
                        ]
                    }
                ],
