{
    "word_family": [
        "break"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d6a291bc-6daf-3e5e-a009-47251b414e62",
                    "sense_definition": "Having separated from a larger group or organization.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "separation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>breakaway</w> group formed their own political party after the election.",
                            "target_lang_translations": {
                                "zh": "选举后，那个<w>分裂</w>团体组建了自己的政党。"
                            }
                        },
                        {
                            "text": "Several members left to join a <w>breakaway</w> faction of the union.",
                            "target_lang_translations": {
                                "zh": "几名成员离开并加入了工会的一个<w>分裂</w>派系。"
                            }
                        }
                    ],
                    "synonyms": [
                        "splinter",
                        "secessionist"
                    ],
                    "common_phrases": [
                        "breakaway group",
                        "breakaway party"
                    ],
                    "target_lang_definitions": {
                        "zh": "指从较大的团体或组织中分离出来的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "分裂的",
                                "target_lang_sense_clarification": "形容从原组织中脱离出来的团体"
                            },
                            {
                                "target_lang_word": "脱离的",
                                "target_lang_sense_clarification": "形容与主流或原组织分开的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e987b30f-8122-3444-aa4e-a924c8244c36",
                    "sense_definition": "Experiencing sudden and rapid success or popularity.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "success",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The singer had a <w>breakaway</w> hit that topped the charts worldwide.",
                            "target_lang_translations": {
                                "zh": "这位歌手凭借一首<w>突破性</w>的热门歌曲登上了全球排行榜榜首。"
                            }
                        },
                        {
                            "text": "The film was a <w>breakaway</w> success during its first week in theaters.",
                            "target_lang_translations": {
                                "zh": "这部电影在上映的第一周就取得了<w>突破性</w>的成功。"
                            }
                        }
                    ],
                    "synonyms": [
                        "breakout"
                    ],
                    "common_phrases": [
                        "breakaway hit",
                        "breakaway success"
                    ],
                    "target_lang_definitions": {
                        "zh": "指突然获得巨大成功或极高人气的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "突破性的",
                                "target_lang_sense_clarification": "形容在短时间内取得巨大成功"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "812b1cb4-0798-3680-9c7d-8fda8303ff69",
                    "sense_definition": "Designed to break easily without causing damage to the surrounding structure.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "design",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The stunt actor crashed through a <w>breakaway</w> window during the scene.",
                            "target_lang_translations": {
                                "zh": "特技演员在拍摄过程中撞碎了一扇<w>易碎</w>窗户。"
                            }
                        },
                        {
                            "text": "They used <w>breakaway</w> furniture to ensure the actors remained safe during the fight.",
                            "target_lang_translations": {
                                "zh": "他们使用了<w>易碎</w>家具，以确保演员在打斗戏中保持安全。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "breakaway wall",
                        "breakaway door"
                    ],
                    "target_lang_definitions": {
                        "zh": "设计成容易破碎且不会对周围结构造成伤害的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "易碎的",
                                "target_lang_sense_clarification": "特指影视拍摄中使用的道具，易于破碎以保证安全"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d49846c6-e685-3c13-96ea-72b9a6ca7d66",
                    "sense_definition": "Relating to a situation where a player moves toward the goal without defenders.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The striker scored a <w>breakaway</w> goal in the final minute of the match.",
                            "target_lang_translations": {
                                "zh": "前锋在比赛最后一分钟打入了一粒<w>单刀</w>球。"
                            }
                        },
                        {
                            "text": "He missed a crucial <w>breakaway</w> opportunity when the goalie blocked his shot.",
                            "target_lang_translations": {
                                "zh": "当守门员挡出他的射门时，他错失了一个关键的<w>单刀</w>机会。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "breakaway goal"
                    ],
                    "target_lang_definitions": {
                        "zh": "指在体育比赛中，球员在没有防守者的情况下向球门推进的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "单刀的",
                                "target_lang_sense_clarification": "体育术语，指球员带球直面守门员"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "692a7689-8d0e-397d-b1a8-1956306356c6",
                    "sense_definition": "A sports play where a player attacks the opponent's goal with no defenders in the way.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The forward went on a <w>breakaway</w> and scored easily.",
                            "target_lang_translations": {
                                "zh": "前锋发动了一次<w>单刀</w>进攻并轻松得分。"
                            }
                        },
                        {
                            "text": "The goalie made a great save during the <w>breakaway</w>.",
                            "target_lang_translations": {
                                "zh": "守门员在这次<w>单刀</w>中做出了一次精彩扑救。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "on a breakaway"
                    ],
                    "target_lang_definitions": {
                        "zh": "体育比赛中，球员在无人防守的情况下向对方球门进攻的战术"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "单刀",
                                "target_lang_sense_clarification": "指球员带球突破防线直面守门员的进攻机会"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a24325ef-203b-3563-8217-9a03a6ea9633",
                    "sense_definition": "The act of separating or moving away from a larger group or system.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "separation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The political party faced a <w>breakaway</w> of its most radical members.",
                            "target_lang_translations": {
                                "zh": "该政党面临着最激进成员的<w>分裂</w>。"
                            }
                        },
                        {
                            "text": "This decision represents a clear <w>breakaway</w> from traditional policies.",
                            "target_lang_translations": {
                                "zh": "这一决定代表了对传统政策的彻底<w>脱离</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "secession",
                        "separation"
                    ],
                    "common_phrases": [
                        "a clear breakaway"
                    ],
                    "target_lang_definitions": {
                        "zh": "从较大的团体或系统中分离或移出的行为"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "分裂",
                                "target_lang_sense_clarification": "指组织内部成员脱离原集体"
                            },
                            {
                                "target_lang_word": "脱离",
                                "target_lang_sense_clarification": "指与原有政策或体系的断开"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9f2fd6da-1107-3b2a-9ab4-ea76a8145c05",
                    "sense_definition": "A small group of cyclists that has moved ahead of the main pack.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>breakaway</w> managed to stay ahead of the peloton for most of the race.",
                            "target_lang_translations": {
                                "zh": "这支<w>突围小队</w>在比赛的大部分时间里都保持在主车群前方。"
                            }
                        },
                        {
                            "text": "The leaders of the <w>breakaway</w> were caught by the main group near the finish line.",
                            "target_lang_translations": {
                                "zh": "<w>突围小队</w>的领跑者在终点线附近被大部队追上了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "five-man breakaway"
                    ],
                    "target_lang_definitions": {
                        "zh": "自行车赛中，从大部队中领先冲出的一小群选手"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "突围小队",
                                "target_lang_sense_clarification": "自行车赛中领先于主车群的选手群体"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3b792a16-f6f4-3711-98dc-baec5711b6b2",
                    "sense_definition": "An object used in a performance that is designed to be easily broken.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "design",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The prop master prepared a <w>breakaway</w> for the fight scene.",
                            "target_lang_translations": {
                                "zh": "道具师为打斗戏准备了一个<w>易碎道具</w>。"
                            }
                        },
                        {
                            "text": "The actor smashed the <w>breakaway</w> over the table during the stunt.",
                            "target_lang_translations": {
                                "zh": "演员在特技表演中将那个<w>易碎道具</w>砸在了桌子上。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "表演中使用的、设计成容易破碎的道具"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "易碎道具",
                                "target_lang_sense_clarification": "影视拍摄中专门制作的易碎物品"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}