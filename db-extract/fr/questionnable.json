                "forms": [
                    {
                        "form_id": "b683654e-20bc-4ab9-9955-663fdf6e4a43",
                        "entry_id": "1e3125e7-a20d-350d-bd5c-37dbffc2b9ab",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "questionnables"
                    },
                    {
                        "form_id": "d2bbd382-d351-4d09-9031-5c493e2376b5",
                        "entry_id": "1e3125e7-a20d-350d-bd5c-37dbffc2b9ab",
                        "tags": [],
                        "form": "questionable"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a2688008-a071-39e7-848b-a463b514efad",
                        "entry_id": "1e3125e7-a20d-350d-bd5c-37dbffc2b9ab",
                        "glosses": [
                            "Susceptible d’être questionné, d’être mis en question."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f43c7ac-4e44-4b85-be3a-1e86bec0665e",
                                "sense_id": "a2688008-a071-39e7-848b-a463b514efad",
                                "text": "Nous estimons, nous, que ce parti pouvait trouver dans l’interpellation obtenue matière à tout autre chose qu’à des plaisanteries dont le goût est au moins questionnable."
                            },
                            {
                                "example_id": "d08e215a-303a-4b58-8981-2dfdb5c6b08d",
                                "sense_id": "a2688008-a071-39e7-848b-a463b514efad",
                                "text": "Je dis que le drame de La Défense de l’infini, l’histoire de son écriture et de sa quasi-destruction, sont questionnables aujourd’hui pour la première fois."
                            },
                            {
                                "example_id": "2eba4ce1-560a-4328-b764-a1f775a17cb2",
                                "sense_id": "a2688008-a071-39e7-848b-a463b514efad",
                                "text": "Le gouvernement Legault, lui, continue étrangement d’appuyer ce projet écologiquement irresponsable, économiquement questionnable."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b7c7cfbe-a7ea-4c4f-a32c-c83f672c0297",
                        "source_entry_id": "1e3125e7-a20d-350d-bd5c-37dbffc2b9ab",
                        "source_sense_id": "a2688008-a071-39e7-848b-a463b514efad",
                        "target_lang_word": "fragwürdig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fragwürdig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0c1409a0-7a07-36b0-88ac-6c6c0ba8c76a",
                                        "entry_id": "d8949bbd-0eb7-318e-8533-f84568d72272",
                                        "glosses": [
                                            "zu einer Frage einladend, zu einer Frage herausfordernd"
                                        ],
                                        "tags": [
                                            "ursprünglich"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa110b67-bdb3-4ebc-a170-aa917e0c11b6",
                                                "sense_id": "0c1409a0-7a07-36b0-88ac-6c6c0ba8c76a",
                                                "text": "Taxifahrer kennen sich in ihrer Stadt sehr gut aus und sind deswegen sehr fragwürdige Auskunftspersonen, wenn man eine bestimmte Straße sucht."
                                            },
                                            {
                                                "example_id": "05639424-c54d-40cf-ac36-0b17234a60a1",
                                                "sense_id": "0c1409a0-7a07-36b0-88ac-6c6c0ba8c76a",
                                                "text": "„Die erste fragwürdige Person, auf die man achtet, weil so viel von ihr abhängt, ist in Paris, so oft man miethet, der Portier; hat aber der Portier eine Tochter und ist man selbst nicht viel mehr als zwanzig Jahre alt, so ist diese Tochter noch bei weitem fragwürdiger und wird vor Allem ihr die Aufmerksamkeit des Miethsmannes zugewendet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8a589f98-a2b4-3cab-844d-d7d8905e7105",
                                        "entry_id": "d8949bbd-0eb7-318e-8533-f84568d72272",
                                        "glosses": [
                                            "zu Skepsis und Argwohn Anlass gebend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04ad3ffc-b122-4a79-bec7-43e46d68dacb",
                                                "sense_id": "8a589f98-a2b4-3cab-844d-d7d8905e7105",
                                                "text": "Diese Einladung kommt mir mehr als fragwürdig vor."
                                            },
                                            {
                                                "example_id": "887fbf21-f996-40a8-86a5-475cfaaa154d",
                                                "sense_id": "8a589f98-a2b4-3cab-844d-d7d8905e7105",
                                                "text": "Heiner ist ein Mann von fragwürdigem Charakter. Man hat immer den Eindruck, er habe etwas zu verbergen."
                                            },
                                            {
                                                "example_id": "5d92a22e-c9f5-4f20-bd48-d56836daf5bc",
                                                "sense_id": "8a589f98-a2b4-3cab-844d-d7d8905e7105",
                                                "text": "Dies ist ein Pullover von höchst fragwürdiger Qualität."
                                            },
                                            {
                                                "example_id": "afc10cbb-afe9-4a67-a993-c825f8e652df",
                                                "sense_id": "8a589f98-a2b4-3cab-844d-d7d8905e7105",
                                                "text": "Herr Meier ist ein Mitarbeiter mit äußerst fragwürdigen Qualitäten. So richtig versteht niemand, warum er eingestellt wurde."
                                            },
                                            {
                                                "example_id": "efe2eff6-8d19-4146-907f-806de54674d6",
                                                "sense_id": "8a589f98-a2b4-3cab-844d-d7d8905e7105",
                                                "text": "Es ist ziemlich fragwürdig, welchen Wert diese Untersuchung haben soll."
                                            },
                                            {
                                                "example_id": "fa43749c-cd12-42de-a45a-60d95779eacd",
                                                "sense_id": "8a589f98-a2b4-3cab-844d-d7d8905e7105",
                                                "text": "Deine Tätigkeit hier ist von fragwürdigem Nutzen."
                                            },
                                            {
                                                "example_id": "fff00faf-19a8-489e-9914-bd25c5d81a85",
                                                "sense_id": "8a589f98-a2b4-3cab-844d-d7d8905e7105",
                                                "text": "„Die Schwäche des E-Autos liegt darin, dass es so viel mehr mineralische Rohstoffe benötigt als die Verbrenner, darunter etliche kritische Materialien, die oft unter fragwürdigen Bedingungen abgebaut werden.“"
                                            },
                                            {
                                                "example_id": "b0edeaab-f457-4613-8fcb-b37cca8228ec",
                                                "sense_id": "8a589f98-a2b4-3cab-844d-d7d8905e7105",
                                                "text": "„Demnach dürfen Versicherer einen Vermittler nicht derart vergüten oder Verkaufsziele definieren, dass ein Fehlanreiz entsteht, dem Kunden ein unpassendes Produkt anzudrehen — Incentives und umsatzorientierte Geschäftspläne erscheinen vor diesem Hintergrund als fragwürdig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "41c29d61-8207-4a96-b0d3-86fdf4674b63",
                        "source_entry_id": "1e3125e7-a20d-350d-bd5c-37dbffc2b9ab",
                        "source_sense_id": "a2688008-a071-39e7-848b-a463b514efad",
                        "target_lang_word": "questionable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "questionable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e9f87a51-14f5-39ea-9057-023f1ec04fc0",
                                        "entry_id": "dc1fd5c5-c005-3f69-bbb0-61222da4f815",
                                        "glosses": [
                                            "Problematic; open to doubt or challenge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9dac9168-7862-4b81-a964-83a1d78334a2",
                                                "sense_id": "e9f87a51-14f5-39ea-9057-023f1ec04fc0",
                                                "text": "It is questionable if the universe is open or closed."
                                            },
                                            {
                                                "example_id": "dced1b90-db3e-41e4-bf27-5abd56a37bfa",
                                                "sense_id": "e9f87a51-14f5-39ea-9057-023f1ec04fc0",
                                                "text": "A crude, cold rain was falling heavily; the spring-time presented itself as a questionable improvement."
                                            },
                                            {
                                                "example_id": "6afb1f4c-8d4f-4754-884e-a7af8ce48e2c",
                                                "sense_id": "e9f87a51-14f5-39ea-9057-023f1ec04fc0",
                                                "text": "MAHA went viral across social media and led to an explosion of questionable claims regarding health and wellness."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3076bd9-d563-3ac2-971c-2f0adef92114",
                                        "entry_id": "dc1fd5c5-c005-3f69-bbb0-61222da4f815",
                                        "glosses": [
                                            "Of dubious respectability or morality."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a53b39d6-41c9-4bfd-af2a-bf13fa82d4f7",
                                                "sense_id": "a3076bd9-d563-3ac2-971c-2f0adef92114",
                                                "text": "Tiffiny’s behavior is highly questionable."
                                            },
                                            {
                                                "example_id": "6d54b26c-a933-495e-bf3a-9dec5acc6670",
                                                "sense_id": "a3076bd9-d563-3ac2-971c-2f0adef92114",
                                                "text": "[…] he had a love of money—a sort of acquisitiveness, that led him into questionable dealings."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f76d6744-e1b8-382d-8e9d-bd547d304fe5",
                                        "entry_id": "dc1fd5c5-c005-3f69-bbb0-61222da4f815",
                                        "glosses": [
                                            "Inviting questions; inviting inquiry."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f92ee68-98b3-419c-a9a3-d2dd6e67ca39",
                                                "sense_id": "f76d6744-e1b8-382d-8e9d-bd547d304fe5",
                                                "text": "Thou com'ſt in ſuch a queſtionable ſhape / That I will ſpeake to thee."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
