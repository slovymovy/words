                            {
                                "example_id": "fd3d84c3-303d-48fe-9617-ef06b13fea9d",
                                "sense_id": "bad5c9e1-c163-3ed5-910c-1a3db2155eb1",
                                "text": "„Die Sitze im Staatsrat hielt er ihm dabei als Lockmittel vor die Nase.“"
                            },
