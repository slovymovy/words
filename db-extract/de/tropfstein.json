                    {
                        "sense_id": "37c3980c-23a1-3333-b6fe-bb205013cb3f",
                        "entry_id": "eba21337-07f3-3043-b3cd-c951c95dd3d8",
                        "glosses": [
                            "durch tropfendes Wasser entstandene Steine"
                        ],
                        "tags": [
                            "Gestein"
                        ],
                        "examples": [
                            {
                                "example_id": "29b8f35b-909f-48bf-bb80-1e907bb30f17",
                                "sense_id": "37c3980c-23a1-3333-b6fe-bb205013cb3f",
                                "text": "Die Tropfsteine in der Tropfsteinhöhle sind einzigartig."
                            },
                            {
                                "example_id": "a5ea00f7-7702-4ce8-b124-3f48c8a0ff60",
                                "sense_id": "37c3980c-23a1-3333-b6fe-bb205013cb3f",
                                "text": "„Wenn Sickerwasser mit gelöstem Calciumhydrogencarbonat von der Decke einer solchen Höhle tropft, entstehen allmählich Tropfsteine:“ […]."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
