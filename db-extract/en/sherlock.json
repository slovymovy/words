                                "example_id": "b677fe09-b18d-4831-9c7e-2227d798f1d7",
                                "sense_id": "c05b6820-d002-3c13-b584-b2b53d84f65e",
                                "text": "Sherlock Holmes was a master of deduction.",
                                "translation": "« Sherlock Holmes était un maître de la déduction. »"
                            }
