                        "sense_id": "0414ad5d-b530-325b-bbb6-c2b4f5213ec6",
                        "entry_id": "501ee68b-3d39-3a0c-b41f-573d7d8e06ee",
                        "glosses": [
                            "One of the two halves of bilaterally symmetrical animals; one of any opposite symmetrical or homotypic parts in animals and plants."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "906f978a-0380-4c47-a2ac-6ac7ef61f968",
                        "source_entry_id": "501ee68b-3d39-3a0c-b41f-573d7d8e06ee",
                        "source_sense_id": "0414ad5d-b530-325b-bbb6-c2b4f5213ec6",
                        "source_sense_description": "one of the two halves of bilaterally symmetrical organisms",
                        "target_lang_word": "Antimer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Antimer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a965edb6-5514-3f4d-8e85-e02d27898a9a",
                                        "entry_id": "fbf5a6ed-43d4-3872-9fb6-ab8ead35b377",
                                        "glosses": [
                                            "Gegenstück"
                                        ],
                                        "tags": [
                                            "jargon",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d63a8bd-eaea-4577-90d4-25a1f60f9a49",
                                                "sense_id": "a965edb6-5514-3f4d-8e85-e02d27898a9a",
                                                "text": "„Das Os coxae wiederum ist mit dem passenden Gegenstück (Antimer) - unter Zwischenschaltung des starren Synsacrums - zu einer festen Einheit verbunden, die als Os innominatum bezeichnet wird.“"
                                            },
                                            {
                                                "example_id": "f36132a4-4839-49ea-8088-ec88f5459e5e",
                                                "sense_id": "a965edb6-5514-3f4d-8e85-e02d27898a9a",
                                                "text": "„Für sich betrachtet weist jedes Antimer einen bilateralsymmetrischen Bau auf, dessen Medianebene mit der zu demselben Antimer gehörigen radialen Hauptebene identisch ist.“"
                                            },
                                            {
                                                "example_id": "82aa50b7-4136-4300-a066-5ac8ed6ee1e6",
                                                "sense_id": "a965edb6-5514-3f4d-8e85-e02d27898a9a",
                                                "text": "„Es ist nun ein Postulat, wenigstens beim Embryo ein Antimer des Mundes, ein Gegenstück desselben auf der rechten Seite nachzuweisen, und dasselbe sehe ich in der kolbenförmigen Drüse, welche, wie der Mund, unter dem ersten Myotome angelegt wird […]“"
                                            },
                                            {
                                                "example_id": "17ae1bfc-248a-44b6-b849-63f7ceda88ea",
                                                "sense_id": "a965edb6-5514-3f4d-8e85-e02d27898a9a",
                                                "text": "„Man vermag durch dieselbe Schnittflächen zu legen, welche den Körper in symmetrische unter sich congruente Theilstücke, Antimeren, zerlegen.“"
                                            },
                                            {
                                                "example_id": "40f5c55d-7914-40ff-b6d5-8ce45da65c17",
                                                "sense_id": "a965edb6-5514-3f4d-8e85-e02d27898a9a",
                                                "text": "„Die Formindividuen dritter Ordnung oder Antimeren sind allgemein um so vollkommener, je größer die Anzahl der konstituierenden Organe, je differenter deren histologische Zusammensetzung, und folglich auch ihre physiologische Funktion ist, je abhängiger mithin die Organe voneinander und vom ganzen Antimer sind, und je mehr das ganze Antimer zentralisiert und von dem etwa übergeordneten Metamer unabhängig ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
