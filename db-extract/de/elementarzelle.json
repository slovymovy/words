                                    },
                                    {
                                        "sense_id": "7eea8733-3cd2-3821-9a5a-9cc07ca970ae",
                                        "entry_id": "f158db15-4d43-3d12-8f98-88e0a4e4a791",
                                        "glosses": [
                                            "Moyenne."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46b88dd2-2353-45a1-943b-eacf7cca9f37",
                                                "sense_id": "7eea8733-3cd2-3821-9a5a-9cc07ca970ae",
                                                "text": "Avoir la maille au Bac."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba774f00-1587-3048-97eb-311573158b72",
                                        "entry_id": "f158db15-4d43-3d12-8f98-88e0a4e4a791",
                                        "glosses": [
                                            "Encore."
                                        ],
                                        "tags": [
                                            "Hautes-Alpes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa3a31d3-c67a-4515-a5da-2bf48c6ffd59",
                                                "sense_id": "ba774f00-1587-3048-97eb-311573158b72",
                                                "text": "Il va maille falloir retourner travailler."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3958744-5962-30c7-9ba1-01f12f79a325",
