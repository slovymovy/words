                    {
                        "form_id": "d12bff8c-7098-457d-9342-41219dec0377",
                        "entry_id": "e646c032-1099-3e8c-8f33-17e15bcdb362",
                        "tags": [
                            "diminutive",
                            "plural"
                        ],
                        "form": "zaklampjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5c1a2dd1-22e5-32ea-9888-bd8375d5ebca",
                        "entry_id": "e646c032-1099-3e8c-8f33-17e15bcdb362",
                        "glosses": [
                            "kleine, draagbare lamp die op batterijen werkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "071589d6-e22d-4a0d-a47a-41f3732bcb29",
                                "sense_id": "5c1a2dd1-22e5-32ea-9888-bd8375d5ebca",
                                "text": "Ik zag twee felle zaklampen op een aantal tenten schijnen waar de laatste uren flink wat lawaai vandaan was gekomen."
                            },
                            {
                                "example_id": "99dc097d-8181-413c-a084-18bcc645c381",
                                "sense_id": "5c1a2dd1-22e5-32ea-9888-bd8375d5ebca",
                                "text": "Harald lag onder de deken met een zaklamp en las met bonkend hart. 'De loopgravenstrijd is de bloedigste, wildste en wreedste van alle veldslagen. Er stonden mannen in op die de situatie meester waren, onbekende, onverschrokken krijgers."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d108cd66-bc03-4be9-beae-6e958aeb95df",
                        "source_entry_id": "e646c032-1099-3e8c-8f33-17e15bcdb362",
                        "source_sense_id": "5c1a2dd1-22e5-32ea-9888-bd8375d5ebca",
                        "source_sense_description": "lamp op zakformaat",
                        "target_lang_word": "Taschenlampe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Taschenlampe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e8f3220b-4e9b-322d-a6dc-6ee45b1c55d0",
                                        "entry_id": "7d26f75f-92e2-3680-9915-151281131345",
                                        "glosses": [
                                            "handliche, tragbare Lichtquelle, die meist mit Batterien oder einem Dynamo betrieben wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "604b345e-243a-4792-848f-c6ce98654469",
                                                "sense_id": "e8f3220b-4e9b-322d-a6dc-6ee45b1c55d0",
                                                "text": "Ihr solltet eine Taschenlampe mitnehmen, draußen ist es sehr dunkel."
                                            },
                                            {
                                                "example_id": "c3ae13d4-e07c-41f7-8b96-f327c9900aa7",
                                                "sense_id": "e8f3220b-4e9b-322d-a6dc-6ee45b1c55d0",
                                                "text": "„Hinten über den Hof knackte und rumorte es, gelegentlich blitzte eine Taschenlampe auf, husch ging einer mit einer Blendlaterne in den Keller.“"
                                            },
                                            {
                                                "example_id": "49e6d637-3dd3-497f-a0b1-f2dbe83d7ae6",
                                                "sense_id": "e8f3220b-4e9b-322d-a6dc-6ee45b1c55d0",
                                                "text": "„Die Taschenlampe mußten wir aus der Küche holen.“"
                                            },
                                            {
                                                "example_id": "03bacbff-4019-4004-b7fc-a37804629699",
                                                "sense_id": "e8f3220b-4e9b-322d-a6dc-6ee45b1c55d0",
                                                "text": "„Jonathan fuchtelte mit seiner Taschenlampe herum und trieb zum Aufbruch.“"
                                            },
                                            {
                                                "example_id": "dcb49a03-47b1-46e4-a2df-713552ef3944",
                                                "sense_id": "e8f3220b-4e9b-322d-a6dc-6ee45b1c55d0",
                                                "text": "„Im Schein der Taschenlampen blitzten Gasmasken, Kleidungs- und Ausrüstungsstücke auf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a2b16fbf-b633-4950-9a97-42099d06d0f0",
                        "source_entry_id": "e646c032-1099-3e8c-8f33-17e15bcdb362",
                        "source_sense_id": "5c1a2dd1-22e5-32ea-9888-bd8375d5ebca",
                        "source_sense_description": "lamp op zakformaat",
                        "target_lang_word": "lampe de poche",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lampe de poche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8cc386e1-1087-30ce-bef7-d6344b79cfd6",
                                        "entry_id": "42ac3ec8-7cfc-3be7-980d-4a4115a93d0f",
                                        "glosses": [
                                            "Lampe électrique portable fonctionnant avec des accumulateurs ou des piles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba8e2e0d-162f-46ac-9343-a33e7ed5b956",
                                                "sense_id": "8cc386e1-1087-30ce-bef7-d6344b79cfd6",
                                                "text": "Elle s’amuse à traquer les geckos avec sa lampe de poche."
                                            },
                                            {
                                                "example_id": "1f0b25db-e36b-4208-8776-7813e6aa6461",
                                                "sense_id": "8cc386e1-1087-30ce-bef7-d6344b79cfd6",
                                                "text": "L'un d'eux lui expliqua à mi-voix que la ronde nocturne et la lampe de poche permettaient juste le zieutage des craquettes et des zigounettes de celles et ceux qui sortaient de leurs cases pour pisser la nuit dans la nature."
                                            },
                                            {
                                                "example_id": "e4efc068-8c01-43ba-8fd0-e6156433a213",
                                                "sense_id": "8cc386e1-1087-30ce-bef7-d6344b79cfd6",
                                                "text": "Il se dirigea vers la maison de poupées, alluma sa lampe de poche et vit un coffre miniature dans un coin du salon, à côté des minichaises."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
