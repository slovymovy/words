                "senses": [
                    {
                        "sense_id": "59800a19-45a2-3b20-9371-926ed0f464a9",
                        "entry_id": "890f5037-51ac-345f-a6ad-4f22bff20339",
                        "glosses": [
                            "Personne extrêmement riche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "169a4d9b-10af-44fc-b31c-1ab2d07664c7",
                                "sense_id": "59800a19-45a2-3b20-9371-926ed0f464a9",
                                "text": "Le public du collège de Rumilly n’était pas constitué par les ultrariches mais plutôt par des gens conservateurs, d’ancienne bourgeoisie (beaucoup de parents étaient militaires ou diplomates), pas des catholiques intégristes cependant – la plupart du temps, l’enfant avait été mis en pension à la suite d’un divorce qui tournait mal."
                            },
                            {
                                "example_id": "bdc3c2a1-61d2-4908-a535-bd521c605bef",
                                "sense_id": "59800a19-45a2-3b20-9371-926ed0f464a9",
                                "text": "Il parle d’un ultrariche, l’investisseur Warren Buffet, qui a avoué avoir honte de ne devoir payer que 17,4 % d'impôt sur les profits colossaux de sa fortune, alors que sa secrétaire en paie 35,8 % sur son salaire de 60 000 dollars annuels."
                            },
                            {
                                "example_id": "3c10071e-4f67-4cf6-ae47-2fd591d0cdd9",
                                "sense_id": "59800a19-45a2-3b20-9371-926ed0f464a9",
                                "text": "Ce n’est pas un impôt sur les riches, c’est un impôt sur les ultrariches."
                            },
                            {
                                "example_id": "109cc568-aa1b-4a64-b56c-2c37c85ad81b",
                                "sense_id": "59800a19-45a2-3b20-9371-926ed0f464a9",
                                "text": "C’est l’un des nouveaux endroits à la mode accueillant une petite élite : nouveaux riches, ultrariches, stars ou pseudo-stars du show-biz et de la mode."
                            }
                        ]
                    }
