                "senses": [
                    {
                        "sense_id": "0069b1cc-3f73-34cd-875a-1b184cec6730",
                        "entry_id": "3d4a60ef-a991-35eb-ae27-d2ad6bb813d4",
                        "glosses": [
                            "iemand die een (financiële) bijdrage levert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40754dd3-4de6-42d6-af77-bfa9cc1a6c35",
                                "sense_id": "0069b1cc-3f73-34cd-875a-1b184cec6730",
                                "text": "Ondanks de enorme bezoekersaantallen kon het museum toch niet zonder de donaties van de gulle donateurs"
                            },
                            {
                                "example_id": "f480291a-57fc-4ceb-87a9-566ac34c3294",
                                "sense_id": "0069b1cc-3f73-34cd-875a-1b184cec6730",
                                "text": "Binnen een uur had ik de Gofundme-website opgezet en vroeg ik mijn vrienden thuis via Facebook om wat geld te doneren. 1 dollar voor elke kilometer die ik liep leek me een mooi streven, in de hoop zo 4.286 dollar op te halen. Ook beloofde ik voor elke donateur een persoonlijk schilderij te maken."
                            },
                            {
                                "example_id": "065cb65d-a5dc-490f-8fd2-6d795592530a",
                                "sense_id": "0069b1cc-3f73-34cd-875a-1b184cec6730",
                                "text": "Het werd een feestelijke bijeenkomst, waarbij inwoners van Pieterburen, donateurs en oud-medewerkers waren uitgenodigd, meldt RTV Noord."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "54e7ee77-63df-4791-933c-713073357335",
                        "source_entry_id": "3d4a60ef-a991-35eb-ae27-d2ad6bb813d4",
                        "source_sense_id": "0069b1cc-3f73-34cd-875a-1b184cec6730",
