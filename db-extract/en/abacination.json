                        "entry_id": "b647a7f7-4511-3e01-8a48-b5a066c3fe98",
                        "glosses": [
                            "The act of abacinating, of blinding with the light from hot metal"
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "851b980c-28d7-4b2d-b7f8-33a3bf52b378",
                                "sense_id": "9ab61149-ab0e-3337-b312-89c257cecf29",
                                "text": "That blind general lost his sight by the process of abacination."
                            },
                            {
                                "example_id": "2c85ee6b-63cc-4db1-ba39-47f51213aa9e",
                                "sense_id": "9ab61149-ab0e-3337-b312-89c257cecf29",
                                "text": "Her warmth and radiance had blinded him, a self-inflicted abacination."
                            },
                            {
                                "example_id": "298f6e8b-edd5-477c-aed7-808fabbf0ba3",
                                "sense_id": "9ab61149-ab0e-3337-b312-89c257cecf29",
                                "text": "I, who had seen so many brandings and abacinations, and had even used the iron myself (among the billion things I recall perfectly is the flesh of Morwenna's cheeks blistering), could scarcely force myself to go and look at him."
                            }
                        ]
                    }
                ],
