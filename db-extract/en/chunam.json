                "senses": [
                    {
                        "sense_id": "5b2a459f-61bd-3144-8252-ee2a43f63667",
                        "entry_id": "ceabb7b8-fcce-32d3-9df5-32f8504c27d8",
                        "glosses": [
                            "A type of plaster made from lime and sand, used for indoor finishing and slope protection."
                        ],
                        "tags": [
                            "Hong-Kong",
                            "India",
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "f957133d-98bc-4b90-b400-8697cff3bfb8",
                                "sense_id": "5b2a459f-61bd-3144-8252-ee2a43f63667",
                                "text": "The one Mr Cleveland and I inhabited was, as I have already observed, constructed of mud instead of chunam."
                            },
                            {
                                "example_id": "c3d7c92a-1dc2-461e-80af-f2a4b38999be",
                                "sense_id": "5b2a459f-61bd-3144-8252-ee2a43f63667",
                                "text": "In all the operations of chunam work, jaggery water, i. e. a solution of molasses or coarse sugar, is invariably added by the builders, and its use appears to have prevailed from the remotest ages."
                            },
                            {
                                "example_id": "afd2ff0b-b355-455e-8d33-88ccd48fadbd",
                                "sense_id": "5b2a459f-61bd-3144-8252-ee2a43f63667",
                                "text": "The floor of the room was of polished chunam, white as curds."
                            },
                            {
                                "example_id": "77d0ec1a-a69e-4a4b-9248-64b13dd052fa",
                                "sense_id": "5b2a459f-61bd-3144-8252-ee2a43f63667",
                                "text": "Look at the flies. Look at the chunam coming off the walls."
                            },
                            {
                                "example_id": "4380c4f1-ab99-48d6-a5f9-ff9cd9f5fba5",
                                "sense_id": "5b2a459f-61bd-3144-8252-ee2a43f63667",
                                "text": "If the slope has to be covered by shotcrete or chunam, tree rings of sufficient size should be provided to allow adequate supply of air and water to reach the tree roots."
                            }
                        ]
                    }
                ],
