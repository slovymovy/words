                    "target_lang_definitions": {
                        "ru": "О звуке: короткий, резкий, напоминающий ломание чего-то твёрдого или хриплый.",
                        "de": "Bezogen auf ein Geräusch: kurz, scharf, wie das Brechen eines harten Gegenstandes."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сухой",
                                "target_lang_sense_clarification": "резкий, отрывистый"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "trocken",
                                "target_lang_sense_clarification": "kurz, scharf (Geräusch)"
                            },
                            {
                                "target_lang_word": "dumpf",
                                "target_lang_sense_clarification": "gedämpft klingend"
