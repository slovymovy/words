                "senses": [
                    {
                        "sense_id": "e8f5fa4d-eacb-37d5-8ddc-86d3194bf54b",
                        "entry_id": "84c69497-04bf-3c24-af7d-dd9e9bb6b5eb",
                        "glosses": [
                            "Décatholiciser, affranchir un individu ou une nation de l’influence du pape."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f2c8a18-e3fc-4de2-93eb-01c5edf30586",
                                "sense_id": "e8f5fa4d-eacb-37d5-8ddc-86d3194bf54b",
                                "text": "Imbu, comme beaucoup d’autres plus illustres gentilshommes, des idées philosophiques qui avaient préparé la Révolution, il accueillit avec enthousiasme les premières manifestations du parti français qui voulait « dépapiser » Avignon."
                            }
                        ]
                    },
                    {
                        "sense_id": "b2912538-4122-3bea-a874-f18913ae1df3",
                        "entry_id": "84c69497-04bf-3c24-af7d-dd9e9bb6b5eb",
                        "glosses": [
                            "Enlever la qualité de pape à quelqu’un."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e620c2f3-8a34-48fa-8223-133485af5a43",
                                "sense_id": "b2912538-4122-3bea-a874-f18913ae1df3",
                                "text": "… luy répéta : « Demain ! » et le renvoya par ung geste, auquel le pape Iehan luy-mesmes auroyt obéi, d’autant qu’il estoyt comme ung limasson sans cocque, veu que le Concile venoyt de le dépapiser."
                            }
                        ]
                    }
