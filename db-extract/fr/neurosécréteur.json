                "senses": [
                    {
                        "sense_id": "b426467d-a25c-311b-a65c-2178dc89625d",
                        "entry_id": "fec96782-2ad7-34e9-bc0a-47c3b1c7e739",
                        "glosses": [
                            "Qui est l’agent d’une sécrétion hormonale au niveau des cellules nerveuses."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8faddd60-5dde-48f0-a2d8-7c9ad7bacf93",
                                "sense_id": "b426467d-a25c-311b-a65c-2178dc89625d",
                                "text": "Les immunsérums dirigés contre la neuroparsine et la Lom OMP, deux neurohormones de Locusta produites par deux types distincts de cellules protocérébrales médianes, sont capables d’immunocolorer les deux mêmes types de cellules neurosécrétrices protocérébrales médianes dans des complexes cerveau-apparentée immunologiquement à la Lom OMP."
                            },
                            {
                                "example_id": "fa393a53-6c1b-47e4-bf63-36cecf6c7f7d",
                                "sense_id": "b426467d-a25c-311b-a65c-2178dc89625d",
                                "text": "Ceci est lié au fait que l’hypothalamus possède une fonction neurosécrétrice (neurologique proprement dite et de sécrétion hormonale)."
                            },
                            {
                                "example_id": "223884bf-58c0-4b2e-bacd-05d481b7553c",
                                "sense_id": "b426467d-a25c-311b-a65c-2178dc89625d",
                                "text": "Par l’intermédiaire des nerfs mammaires, cette information va rejoindre la moelle épinière, l’hypothalamus et les neurones neurosécréteurs ocytocinergiques."
                            }
                        ]
                    }
