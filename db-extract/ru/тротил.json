                    {
                        "translation_id": "f9ca7424-c8b1-45ac-962c-ed4e829547dc",
                        "source_entry_id": "da0b273c-d24a-3563-818a-7408239312fd",
                        "source_sense_id": "99d0f46f-33bf-369a-bc22-db9cc97024a0",
