{
    "word_family": [
        "height",
        "high"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9caceb94-4589-314e-9538-da2494042194",
                    "sense_definition": "To increase the intensity, strength, or amount of something.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "increase",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden noise served to <w>heighten</w> awareness among the security guards.",
                            "target_lang_translations": {
                                "ru": "Внезапный шум послужил тому, чтобы <w>повысить</w> бдительность охранников."
                            }
                        },
                        {
                            "text": "Adding fresh herbs can <w>heighten</w> flavor in almost any savory dish.",
                            "target_lang_translations": {
                                "ru": "Добавление свежей зелени может <w>усилить</w> вкус практически любого несладкого блюда."
                            }
                        },
                        {
                            "text": "The recent news reports only serve to <w>heighten</w> tension between the two countries.",
                            "target_lang_translations": {
                                "ru": "Последние сообщения в новостях лишь способствуют тому, чтобы <w>усилить</w> напряженность между двумя странами."
                            }
                        }
                    ],
                    "synonyms": [
                        "intensify",
                        "enhance",
                        "augment",
                        "increase"
                    ],
                    "antonyms": [
                        "lessen"
                    ],
                    "common_phrases": [
                        "heighten awareness",
                        "heighten tension",
                        "heighten flavor",
                        "heighten the impact"
                    ],
                    "target_lang_definitions": {
                        "ru": "Увеличивать интенсивность, силу или количество чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "усиливать",
                                "target_lang_sense_clarification": "делать более интенсивным"
                            },
                            {
                                "target_lang_word": "повышать",
                                "target_lang_sense_clarification": "увеличивать уровень или степень"
                            },
                            {
                                "target_lang_word": "усугублять",
                                "target_lang_sense_clarification": "делать более серьезным или тяжелым (о напряжении, проблемах)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "358cad04-ea45-3f27-b02a-f9863e5c2a78",
                    "sense_definition": "To make something physically higher or to elevate it.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "elevation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The engineers decided to <w>heighten</w> the sea wall to protect the town from flooding.",
                            "target_lang_translations": {
                                "ru": "Инженеры решили <w>повысить</w> уровень морской дамбы, чтобы защитить город от наводнения."
                            }
                        },
                        {
                            "text": "They plan to <w>heighten</w> the structure by adding two more floors to the building.",
                            "target_lang_translations": {
                                "ru": "Они планируют <w>увеличить высоту</w> строения, добавив к зданию еще два этажа."
                            }
                        }
                    ],
                    "synonyms": [
                        "raise",
                        "elevate"
                    ],
                    "common_phrases": [
                        "heighten the wall",
                        "heighten the roof"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать что-либо физически выше или поднимать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "повышать",
                                "target_lang_sense_clarification": "делать выше"
                            },
                            {
                                "target_lang_word": "увеличивать высоту",
                                "target_lang_sense_clarification": "физически наращивать"
                            },
                            {
                                "target_lang_word": "поднимать",
                                "target_lang_sense_clarification": "делать более высоким"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}