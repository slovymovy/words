                    {
                        "translation_id": "9f1f523f-8f60-416c-83c3-cb7f88e85270",
                        "source_entry_id": "21411539-0127-3536-adfc-1a8d28f66622",
                        "source_sense_id": "77c785e7-22cb-31d4-b9e3-c85a46ce3129",
