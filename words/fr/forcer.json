                    ]
                },
                {
                    "sense_id": "b9eea26a-729c-34cb-bbee-9cbe92d5b4a2",
                    "sense_definition": "Déployer au maximum tous les moyens de propulsion d'un navire.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "navigation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le capitaine ordonna de <w>forcer</w> de voiles pour échapper au navire ennemi."
