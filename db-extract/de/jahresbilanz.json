                "senses": [
                    {
                        "sense_id": "015d56c1-7864-3c2f-bee9-bbdd94812ce0",
                        "entry_id": "0901e489-2595-3475-aabd-1539675c329d",
                        "glosses": [
                            "Gesamtheit des jährlich von einem Unternehmen zu erstellenden Rechenwerks, bestehend aus Bilanz, Gewinn- und Verlustrechnung und Anhang beziehungsweise sonstiger Erläuterungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93d75b3e-b448-491c-9221-c4cd16c53e10",
                                "sense_id": "015d56c1-7864-3c2f-bee9-bbdd94812ce0",
                                "text": "„Deutschlands einzige Energiebörse EEX startet den Handel mit grünem Strom. Handelsbeginn solle am 6. Juni sein, sagte Börsen-Chef Peter Reiz am Mittwoch bei der Vorstellung der Jahresbilanz 2012 in Leipzig.“"
                            },
                            {
                                "example_id": "53713cc0-2512-452d-8234-198984bfc61d",
                                "sense_id": "015d56c1-7864-3c2f-bee9-bbdd94812ce0",
                                "text": "„Ausgangsbasis für die Aufstellung dieser Sonderbilanzen ist die Jahresbilanz, sei es, dass die gesetzlichen Vorschriften hierauf verweisen, sei es, dass die Sonderbilanzen aus den Jahresbilanzen […] abgeleitet werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
