                "senses": [
                    {
                        "sense_id": "dfab39e5-6b3e-309f-862c-c85436782ae0",
                        "entry_id": "6904bb1a-cfec-3779-a865-c10f984a8400",
                        "glosses": [
                            "Donner trop de médicaments à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89bc67f8-de92-4a56-83ce-0ab30af07490",
                                "sense_id": "dfab39e5-6b3e-309f-862c-c85436782ae0",
                                "text": "Heureusement pour eux que le directeur de la santé Tournatoire ne croyait pas à la pharmacopée et, au lieu de droguer, de poutringuer ses malades comme Bézuquet, leur ordonnait « une bonne petite soupe à l’ail »."
                            },
                            {
                                "example_id": "e57f70db-a1cd-4b8f-8609-f9e5d57804b1",
                                "sense_id": "dfab39e5-6b3e-309f-862c-c85436782ae0",
                                "text": "Depuis que les vignes vont mieux, nos paysans se sont remis à se droguer, à se poutringuer."
                            }
                        ]
                    }
