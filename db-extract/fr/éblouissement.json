                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf353e7c-0a1f-4f46-bcfa-f1a308d0e7b2",
                                                "sense_id": "b0254f29-ee84-395f-873f-78c7f5841b93",
                                                "text": "Durch die Blendung seiner Kunden gelang es ihm/ihr große Profite zu machen."
