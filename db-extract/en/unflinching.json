        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "ce5506c6-374a-328a-9395-0d7beec1c687",
                "word": "unflinching",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ad09402a-4beb-31cb-9766-27389e224b11",
                        "entry_id": "ce5506c6-374a-328a-9395-0d7beec1c687",
                        "glosses": [
                            "Without flinching; staying committed despite any difficulty; steadfast."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "61b1d19a-12bb-498e-a926-ccfd3a74feae",
                                "sense_id": "ad09402a-4beb-31cb-9766-27389e224b11",
                                "text": "Can an honest, upright and Christian man, go into these conflicts, and with unflinching firmness stand up for all that is good, and oppose all that is evil, in whatever party it may be found, without a measure of moral courage such as few can command?"
                            },
                            {
                                "example_id": "35965f7c-583f-4141-a755-25eb034a944e",
                                "sense_id": "ad09402a-4beb-31cb-9766-27389e224b11",
                                "text": "[…] I abandoned myself implicitly to the guidance of my wife, and entered with an unflinching heart into the intricacies of her studies."
                            },
                            {
                                "example_id": "ac28755a-4ce2-4e97-8487-6f0e2848b1c0",
                                "sense_id": "ad09402a-4beb-31cb-9766-27389e224b11",
                                "text": "If only she would wake and close her mouth, mentally prayed the outwardly unflinching girl. Later the doctor came, and sheltered by his presence the sick woman's husband stood in the doorway."
                            },
                            {
                                "example_id": "c8ae88c4-3271-485f-8c65-a8d64431d613",
                                "sense_id": "ad09402a-4beb-31cb-9766-27389e224b11",
                                "text": "For all the glories of the Ferguson end-game, Manchester City’s rise and Arsenal’s unflinching desire to finish in the top four and occasionally win the FA Cup, this is now Chelsea’s mini-era."
                            }
                        ]
                    }
                ],
