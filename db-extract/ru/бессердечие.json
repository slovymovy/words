                        "glosses": [
                            "свойство по значению прилагательного бессердечный; бездушие"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb9f7f32-f6f2-47ff-9104-cb7e2bb6cd95",
                                "sense_id": "05c822b7-69a4-312f-aa10-dbc5c326799b",
                                "text": "Самих швейцарцев Фёдор Михайлович и всегда недолюбливал, но чёрствость и бессердечие, выказанные многими из них в минуты нашего тяжкого горя, ещё увеличили эту неприязнь."
                            }
                        ]
                    }
