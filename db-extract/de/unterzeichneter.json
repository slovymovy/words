                                    {
                                        "sense_id": "c8917225-4208-3780-9c11-6f31651f3f0c",
                                        "entry_id": "3f4887b6-b9ef-3fae-9dac-69ddece95826",
                                        "glosses": [
                                            "A person, mentioned in a document, whose name and signature appears at the end."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3cc334e0-2dc9-4da0-8e91-70272090d047",
                                                "sense_id": "c8917225-4208-3780-9c11-6f31651f3f0c",
                                                "text": "We, the undersigned wagon-masters, assistants, teamsters and all other employees of the firm of Russell, Majors & Waddell, do hereby sign that we will not swear, drink whisky, play cards or be cruel to dumb beasts in any way, shape or form."
                                            }
