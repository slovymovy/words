                },
                {
                    "sense_id": "4fd52995-a2e2-3b91-8da9-272dd507c8bb",
                    "sense_definition": "The hemp plant itself, specifically Cannabis sativa, from which the drug is derived.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cannabis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer was granted a license to grow <w>marijuana</w> for industrial hemp production.",
                            "target_lang_translations": {
                                "ru": "Фермеру была выдана лицензия на выращивание <w>марихуаны</w> для промышленного производства конопли."
                            }
                        },
                        {
                            "text": "Botanists study the different strains of the <w>marijuana</w> plant to understand their chemical properties.",
                            "target_lang_translations": {
                                "ru": "Ботаники изучают различные сорта растения <w>марихуаны</w>, чтобы понять их химические свойства."
                            }
                        },
                        {
                            "text": "In some climates, the <w>marijuana</w> plant can grow several feet tall in a single season.",
                            "target_lang_translations": {
                                "ru": "В некоторых климатических условиях растение <w>марихуаны</w> может вырасти на несколько футов в высоту за один сезон."
                            }
                        }
                    ],
                    "synonyms": [
