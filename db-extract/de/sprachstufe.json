                ],
                "senses": [
                    {
                        "sense_id": "924e6418-2469-39ed-a557-db219cffda58",
                        "entry_id": "7090ff3c-6015-3f15-b9f1-67c718a49218",
                        "glosses": [
                            "zeitlicher Abschnitt in der Entwicklung einer Sprache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dceee7b2-3d76-4e36-a46d-36427732007d",
                                "sense_id": "924e6418-2469-39ed-a557-db219cffda58",
                                "text": "„Hier standen auf der einen Seite die ‚gelehrten‘ oder pejorativ als ‚gelahrt‘ bezeichneten Wörterbücher, prototypisch hierfür das Deutsche Wörterbuch mit seinen ausführlichen etymologischen und sprachvergleichenden Angaben zu vielen anderen Sprachen und Sprachstufen außer zur Sprache der Gegenwart des 19. und 20. Jahrhunderts…“"
                            },
                            {
                                "example_id": "bc1bd409-fd21-493d-873f-fffb74ca7435",
                                "sense_id": "924e6418-2469-39ed-a557-db219cffda58",
                                "text": "„Man kann natürlich auch sprachliche Formen an sich als Fossilisierungen früherer Sprachstufen ansehen.“"
                            },
                            {
                                "example_id": "b60cb27f-57fc-49d3-a24a-34e503313c58",
                                "sense_id": "924e6418-2469-39ed-a557-db219cffda58",
                                "text": "„Die Sprachstufe, die wir Altnordisch oder Altisländisch nennen, wird bis zur Reformation um die Mitte des 16. Jahrhunderts gerechnet und umfasst damit rund 650 Jahre.“"
                            },
                            {
                                "example_id": "574105f2-8e9e-40b4-8158-05340a4b76be",
                                "sense_id": "924e6418-2469-39ed-a557-db219cffda58",
                                "text": "„Dabei sind die jeweiligen Sprachbezeichnungen als Ober- und Sammelbegriffe für verschiedene genetisch verwandte Quellsprachen, ihre Dialekte, Varietäten und historischen Sprachstufen zu verstehen.“"
                            },
                            {
                                "example_id": "b8e678ab-0b90-469a-8c4a-7389778a8399",
                                "sense_id": "924e6418-2469-39ed-a557-db219cffda58",
                                "text": "„Man sollte versuchen, diesen Status mit Bezug auf ältere Sprachstufen zu evaluieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4bcb80a7-d98d-30e0-ac0c-4e0b06baa7d7",
                        "entry_id": "7090ff3c-6015-3f15-b9f1-67c718a49218",
                        "glosses": [
                            "der Grad, der Beherrschung einer (Fremd-)Sprache"
                        ],
                        "tags": [
                            "Pädagogik"
                        ],
                        "examples": [
                            {
                                "example_id": "39466f06-9a85-40dd-aac6-4fda8988a339",
                                "sense_id": "4bcb80a7-d98d-30e0-ac0c-4e0b06baa7d7",
                                "text": "„Um von einer Sprachstufe zu einer anderen zu wechseln, braucht man 40 Unterrichtsstunden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
