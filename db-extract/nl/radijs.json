                        "target_lang_word": "radis",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "radis",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "25762339-9beb-35ce-a2aa-60c40c7a5840",
                                        "entry_id": "02c26dd2-15f7-32bb-94d6-65f4bbe7a341",
                                        "glosses": [
                                            "Légume potager du genre Raphanus (famille des Brassicaceae), dont la racine est comestible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a8f6de2-2016-4d19-a45f-fcca96d26425",
                                                "sense_id": "25762339-9beb-35ce-a2aa-60c40c7a5840",
                                                "text": "Lerat, devenue cérémonieuse, ne voulut pas de radis ; ça donnait la pituite."
                                            },
                                            {
                                                "example_id": "2fc86f58-2196-4f3d-931f-617b5dcc726d",
                                                "sense_id": "25762339-9beb-35ce-a2aa-60c40c7a5840",
                                                "text": "Rien ne vaut le bon jus de radis!"
                                            },
                                            {
                                                "example_id": "3eb62b10-782e-4f3c-a2a4-8b87a2bdf2e9",
                                                "sense_id": "25762339-9beb-35ce-a2aa-60c40c7a5840",
                                                "text": "Allez, Bon Dieu, foutez le camp!! Y en a un qu'a chié sur les radis!.. Ouste! Dehors!"
                                            },
                                            {
                                                "example_id": "a4b3904b-2387-4971-9486-657c7e344d8f",
                                                "sense_id": "25762339-9beb-35ce-a2aa-60c40c7a5840",
                                                "text": "Radis rose, radis noir (→ voir raifort), radis rave, radis rond."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "759909c4-4941-39f7-86d2-7bb12129d439",
                                        "entry_id": "02c26dd2-15f7-32bb-94d6-65f4bbe7a341",
                                        "glosses": [
                                            "dans des tournures négatives Sou, argent. → voir rond"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c6710bd-8867-4841-8278-28214c9df3e5",
                                                "sense_id": "759909c4-4941-39f7-86d2-7bb12129d439",
                                                "text": "– Je vais me coucher. – Où ça ? – Dans les carrières de Montmartre. Pas un radis pour payer le garni…"
                                            },
                                            {
                                                "example_id": "35d9aed1-4287-408a-8c85-b2fdad4c1a34",
                                                "sense_id": "759909c4-4941-39f7-86d2-7bb12129d439",
                                                "text": "D’autres lourdauds, Allemands, ou Suisses, ou Anglais, qui ont l’entendement aux mains et comprennent à Noël ce qu’on leur dit à la Toussaint, eussent cru qu’on raillait ; et je n’aurais pas donné un radis de la peau du pauvre Pluviaut."
                                            },
                                            {
                                                "example_id": "c59a5a47-63d6-44cf-9ef3-96d31734f7fb",
                                                "sense_id": "759909c4-4941-39f7-86d2-7bb12129d439",
                                                "text": "Je n’ai plus un radis sur moi !"
                                            },
                                            {
                                                "example_id": "116fb666-8e3a-4753-96a3-01d7d8d422b2",
                                                "sense_id": "759909c4-4941-39f7-86d2-7bb12129d439",
                                                "text": "Franchement, ça ne vaut pas un radis !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
