                                        "sense_id": "2684e89b-4e08-3f5b-b1e4-6eefe50da527",
                                        "entry_id": "3fc0c3ba-94c8-3652-af8f-b902a2b890c8",
                                        "glosses": [
                                            "Vertébré (terrestre, aérien ou marin) dont le squelette comporte deux paires de membres (y compris vestigiaux) munis de doigts, apparents ou atrophiés, témoignant dans l’évolution d’une adaptation primitive à la marche, tels que les amphibiens, les reptiles (dont les serpents), les mammifères et les oiseaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb5c921e-54f9-4507-be7a-984e5e6f82e2",
                                                "sense_id": "2684e89b-4e08-3f5b-b1e4-6eefe50da527",
                                                "text": "Aux côtés des nombreux restes de poissons littoraux, les tétrapodes sont représentés par des chéloniens, crocodiliens, ophidiens, plésiosaures, ptérosaures et dinosaures."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8dc1202c-2ba9-36e9-a711-ecc96c0a7ac4",
                                        "entry_id": "3fc0c3ba-94c8-3652-af8f-b902a2b890c8",
                                        "glosses": [
                                            "Élément de brise-lames, bloc de béton armé fait de quatre cônes tronqués assemblés par leurs bases."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11c8d1aa-2afc-4979-ba45-10f7b950d785",
                                                "sense_id": "8dc1202c-2ba9-36e9-a711-ecc96c0a7ac4",
                                                "text": "Catastrophe que tente de conjurer une armée de Chinois préposés à l’endiguement du delta par des tétrapodes de béton censés suppléer les 150 millions de tonnes de limon annuellement perdues."
                                            }
                                        ]
                                    }
                                ]
                            }
