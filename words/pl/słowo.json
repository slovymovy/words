                },
                {
                    "sense_id": "c10af1a5-5c0a-3e30-83e2-2eeeaff7b871",
                    "sense_definition": "Tekst utworu literackiego, naukowego lub słowa piosenki.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "text",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kto napisał <w>słowa</w> do tego popularnego hymnu?",
                            "target_lang_translations": {
                                "ru": "Кто написал <w>слова</w> к этому популярному гимну?"
                            }
                        },
                        {
                            "text": "Te <w>słowa</w> piosenki są bardzo wzruszające i dają do myślenia.",
                            "target_lang_translations": {
                                "ru": "Эти <w>слова</w> песни очень трогательные и заставляют задуматься."
                            }
                        }
