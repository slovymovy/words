                                        "glosses": [
                                            "In a capricious manner; without caution or concern."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b58aaf3-b75b-4ca4-ab43-5ac2acc3abd8",
                                                "sense_id": "9def603e-854f-37af-b9e2-a51dd3223214",
                                                "text": "\"Where are we going?\" she asked, jibbing capriciously in the descent."
