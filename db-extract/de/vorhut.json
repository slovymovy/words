                ],
                "senses": [
                    {
                        "sense_id": "618a0bd1-cc65-3bb7-88cd-6487c99442bc",
                        "entry_id": "55dd7bf5-09ce-383f-9cd0-3959b0248dc1",
                        "glosses": [
                            "Avant-garde, unité assurant des fonctions de reconnaissance et de protection en avant du gros de la troupe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71a928c1-4375-427a-9204-f5ea38888627",
                                "sense_id": "618a0bd1-cc65-3bb7-88cd-6487c99442bc",
                                "text": "Die Vorhut und Nachhut sollen dem Schutz des Gros dienen.",
                                "translation": "L’avant-garde et l’arrière-garde doivent assurer la protection du gros de la troupe."
                            }
                        ]
                    },
                    {
                        "sense_id": "2c583b82-567f-31aa-997c-a0819d3f1846",
                        "entry_id": "55dd7bf5-09ce-383f-9cd0-3959b0248dc1",
                        "glosses": [
                            "Avant-garde, la tête d’une tendance, d’un mouvement artistique, social ou politique, ou de toute forme de progrès et d’innovation."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "70c0dc20-9b91-43b2-ac7c-f90f0c506a3e",
                                "sense_id": "2c583b82-567f-31aa-997c-a0819d3f1846",
                                "text": "Er und sein Gefolge betrachten sich als die Vorhut einer neuen künstlerischen Bewegung.",
                                "translation": "Lui et sa suite se considèrent comme l’avant-garde d’un nouveau mouvement artistique."
                            }
                        ]
                    }
                ],
