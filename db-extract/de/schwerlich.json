        "de-extract.jsonl": [
            {
                "entry_id": "4cb1d129-631e-3a94-af43-34c90c75a036",
                "word": "schwerlich",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "af0b909c-171f-306b-a97b-87f0a328a74a",
                        "entry_id": "4cb1d129-631e-3a94-af43-34c90c75a036",
                        "glosses": [
                            "nur mit größerer (mentaler) Anstrengung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f79b66f-60e1-40cf-8942-691583164ff5",
                                "sense_id": "af0b909c-171f-306b-a97b-87f0a328a74a",
                                "text": "Es ist schwerlich vorstellbar, dass er diesen Unfall überstanden hat."
                            },
                            {
                                "example_id": "b2896725-144b-4cde-ae43-b10d25e486a2",
                                "sense_id": "af0b909c-171f-306b-a97b-87f0a328a74a",
                                "text": "Das wirst du schwerlich schaffen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9555176e-1206-45e7-b0e4-c1b2a58384c6",
                        "source_entry_id": "4cb1d129-631e-3a94-af43-34c90c75a036",
                        "source_sense_id": "af0b909c-171f-306b-a97b-87f0a328a74a",
                        "source_sense_description": "nur mit größerer (mentaler) Anstrengung",
                        "target_lang_word": "difficilement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "difficilement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6799a88e-b1d0-3fd3-9fc9-39f5345e3dd1",
                                        "entry_id": "79d18f05-a494-3232-b7c0-5d7cc06d6aca",
                                        "glosses": [
                                            "Avec difficulté, avec peine. D’une manière difficile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f93cbcc2-38d0-4d1e-9cb9-7a0fd7933c7f",
                                                "sense_id": "6799a88e-b1d0-3fd3-9fc9-39f5345e3dd1",
                                                "text": "Tout va bien ; c’est moi qui vous le dis, moi qui espère si difficilement."
                                            },
                                            {
                                                "example_id": "08910927-cf8c-4b80-9563-87c20b3b3cd1",
                                                "sense_id": "6799a88e-b1d0-3fd3-9fc9-39f5345e3dd1",
                                                "text": "Saint-Savinien se parcourt à pied, ses rues étroites et tortueuses étant difficilement compatibles avec la voiture."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "773037eb-e599-3f52-a00a-54df34b8303d",
                                        "entry_id": "79d18f05-a494-3232-b7c0-5d7cc06d6aca",
                                        "glosses": [
                                            "Presque pas. Guère."
                                        ],
                                        "tags": [
                                            "pouvoir difficilement ; difficilement …-able"
                                        ],
                                        "note": "Signifie plutôt l’impossibilité que la possibilité",
                                        "examples": [
                                            {
                                                "example_id": "d233caf6-20a0-4ea5-a021-b01724ea35ea",
                                                "sense_id": "773037eb-e599-3f52-a00a-54df34b8303d",
                                                "text": "Quand le pouvoir royal, appuyé sur l’aristocratie, gouvernait paisiblement les peuples de l’Europe, la société, au milieu de ses misères, jouissait de plusieurs genres de bonheur, qu’on peut difficilement conce­voir et apprécier de nos jours."
                                            },
                                            {
                                                "example_id": "020cb45c-e2c7-4220-8820-b032472f2fe6",
                                                "sense_id": "773037eb-e599-3f52-a00a-54df34b8303d",
                                                "text": "Mais ceci plaît à maint écrivain, qui s’efforce à dessein d’écrire d’une façon difficilement compréhensible et obscure, […]"
                                            },
                                            {
                                                "example_id": "6b502ffd-828e-4812-ace7-8e7e1cb10859",
                                                "sense_id": "773037eb-e599-3f52-a00a-54df34b8303d",
                                                "text": "On peut difficilement dire quoi que ce soit de sensé quand on la méprise."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1ba91c85-7f11-4c93-9c47-bf8787c9c54a",
                        "source_entry_id": "4cb1d129-631e-3a94-af43-34c90c75a036",
                        "source_sense_id": "af0b909c-171f-306b-a97b-87f0a328a74a",
                        "source_sense_description": "nur mit größerer (mentaler) Anstrengung",
                        "target_lang_word": "à peine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "à peine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f335946d-0e93-3b33-86cb-336b14eb7530",
                                        "entry_id": "03d0768d-6292-3b5c-99aa-b732174c7158",
                                        "glosses": [
                                            "Par une faible marge ; de peu ; seulement ; rien que."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0dcc0a2e-b346-4881-a688-4bee43b9857e",
                                                "sense_id": "f335946d-0e93-3b33-86cb-336b14eb7530",
                                                "text": "Cette torture par laquelle vous venez de passer, vous me l'avez fait subir, il y a une heure à peine : il était juste que vous fissiez connaissance avec elle."
                                            },
                                            {
                                                "example_id": "b6f7ab06-9c8f-47f4-859e-ad14dbe70de2",
                                                "sense_id": "f335946d-0e93-3b33-86cb-336b14eb7530",
                                                "text": "Le sucre était connu des anciens qui ne l'employaient qu'en très-petite quantité et comme médicament ; il y a 200 ans à peine, il se vendait seulement chez les pharmaciens, à un prix très-élevé."
                                            },
                                            {
                                                "example_id": "be5fbb8b-69e6-47d4-abc6-58d6f5b2e367",
                                                "sense_id": "f335946d-0e93-3b33-86cb-336b14eb7530",
                                                "text": "Wan-nien-sseu est un très vieux temple bouddhique, qui s'élève à quelques lis à peine des murailles de la ville, la courbe élégante de ses toits vernissés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cdce2265-9807-3cc3-94dd-6159820f297d",
                                        "entry_id": "03d0768d-6292-3b5c-99aa-b732174c7158",
                                        "glosses": [
                                            "À l’instant, avec peu de temps qui s’est écoulé, depuis que la chose dont on parle est arrivée."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e591e82-c0c3-424b-84d5-48cc65c11e31",
                                                "sense_id": "cdce2265-9807-3cc3-94dd-6159820f297d",
                                                "text": "Il fait doux, il fait clair. L’hiver commence à peine et je ne sais quoi de printanier flotte dans l’air subtil."
                                            },
                                            {
                                                "example_id": "94dfaf4d-bb0f-4036-9873-bc44b5824e16",
                                                "sense_id": "cdce2265-9807-3cc3-94dd-6159820f297d",
                                                "text": "À peine désécroué de son château-prison de Wilhelmshoe, le vieux criminel de Décembre organisait des réceptions et des raouts à Chislehurst, village des environs de Londres, où il avait pris une villa que j’ai visitée pendant mon dernier exil, le jour où on en a vendu le mobilier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ccde48c-27f5-3eec-aecd-34e18b3cf775",
                                        "entry_id": "03d0768d-6292-3b5c-99aa-b732174c7158",
                                        "glosses": [
                                            "Tout juste."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee623e9e-ab12-4d86-9ac9-bde5bff765d8",
                                                "sense_id": "8ccde48c-27f5-3eec-aecd-34e18b3cf775",
                                                "text": "Il s’habilla bien vite et se rendit chez M. Walter, quoiqu’il fût à peine huit heures du matin."
                                            },
                                            {
                                                "example_id": "417e54b0-a847-4612-a1e6-01f9960f445b",
                                                "sense_id": "8ccde48c-27f5-3eec-aecd-34e18b3cf775",
                                                "text": "En temps normal, les régiments zoulous, les iButho, étaient constitués par classes d’âge. Mais compte tenu de son inexpérience, Abraham eut droit à un traitement particulier. Il fut versé dans une unité de très jeunes gens, se retrouvant en compagnie de garçons d’à peine treize ans qui n’avaient jamais combattu – des amabutu – voire de simples izinDibi, des porteurs d’eau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d63e928c-3617-30fd-a40e-736034c525e8",
                                        "entry_id": "03d0768d-6292-3b5c-99aa-b732174c7158",
                                        "glosses": [
                                            "Difficilement, presque pas."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e280e35-4e48-4061-9a00-fc60f1a8a4c6",
                                                "sense_id": "d63e928c-3617-30fd-a40e-736034c525e8",
                                                "text": "Les cheminées et les toits de chaume, à droite et à gauche de la route, dépassaient à peine les montagnes de neige, […]."
                                            },
                                            {
                                                "example_id": "1cb0e83a-98c7-4f77-b5ab-d7ae6437128d",
                                                "sense_id": "d63e928c-3617-30fd-a40e-736034c525e8",
                                                "text": "Quand une pompe paraît à l’horizon, sa silhouette de télégraphe Chappe bat la mesure pour rien. Son teuf-teuf paisible se semble faire aucun bruit, mais s’amalgamer au silence de l’univers, qu’il ponctue à peine."
                                            },
                                            {
                                                "example_id": "39cfe1ff-671b-4e9c-8476-9d8bb985f81d",
                                                "sense_id": "d63e928c-3617-30fd-a40e-736034c525e8",
                                                "text": "Bien protégé derrière le pare-brise, le déplacement d'air provoqué par la rotation de l'hélice m'effleurait à peine les joues."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae3423f7-8c11-3e00-963c-d2b02fcd5304",
                                        "entry_id": "03d0768d-6292-3b5c-99aa-b732174c7158",
                                        "glosses": [
                                            "Dans une forte mesure ; énormément."
                                        ],
                                        "tags": [
                                            "euphemism",
                                            "ironic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d61f3faf-060b-4d50-bb60-7a1d92abf302",
                                                "sense_id": "ae3423f7-8c11-3e00-963c-d2b02fcd5304",
                                                "text": "Il l’a à peine enflé en lui refourguant sa camelote ; je ne sais pas comment cet idiot s’y prend pour se faire avoir à chaque fois."
                                            },
                                            {
                                                "example_id": "b8354432-6094-4e53-8dc8-4b3a6b44e5dd",
                                                "sense_id": "ae3423f7-8c11-3e00-963c-d2b02fcd5304",
                                                "text": "Avec 5 litres d’écart, ça a à peine débordé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8fc812ff-c84d-3b08-adc2-e182eec75ea0",
                                        "entry_id": "03d0768d-6292-3b5c-99aa-b732174c7158",
                                        "glosses": [
                                            "De façon flagrante, visible, ouvertement."
                                        ],
                                        "tags": [
                                            "ironic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "796e0a09-e560-43a4-b927-b79d690161f9",
                                                "sense_id": "8fc812ff-c84d-3b08-adc2-e182eec75ea0",
                                                "text": "— Pour réussir à te débarrasser de ton tacot t’as dû bien l’endormir le client, non ?\n— Non, à peine."
                                            },
                                            {
                                                "example_id": "5a6962f1-599a-4161-a647-57de15f9e606",
                                                "sense_id": "8fc812ff-c84d-3b08-adc2-e182eec75ea0",
                                                "text": "— Dis-moi, tu ne serais pas en train de te foutre de ma gueule, par hasard ?\n — À peine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
