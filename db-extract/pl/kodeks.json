                    },
                    {
                        "translation_id": "cfd431a9-8a2f-42aa-92ea-845d8e2420e9",
                        "source_entry_id": "e7af9b27-fd75-3dac-b164-bbfcce49a7f4",
                        "source_sense_id": "ef8e5828-015d-3b15-a250-6afca72fd11a",
                        "target_lang_word": "Gesetzbuch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gesetzbuch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dbf616aa-4cf9-333e-baa9-312320c1125b",
                                        "entry_id": "f7ee0004-c1de-3179-92df-e6c8858adb47",
                                        "glosses": [
                                            "Buch, das die Gesetze eines Landes enthält (meist beschränkt auf einen bestimmten Rechtsbereich)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8007a62a-581d-4500-b1aa-1b4f0f656a0f",
                                                "sense_id": "dbf616aa-4cf9-333e-baa9-312320c1125b",
                                                "text": "Für das Funktionieren ihres Rechtssystems stützen sich viele Länder auf Gesetzbücher."
                                            },
                                            {
                                                "example_id": "d4ebe623-0665-4963-b285-67b2f525c1f8",
                                                "sense_id": "dbf616aa-4cf9-333e-baa9-312320c1125b",
                                                "text": "„Für diejenigen, die der Meinung sind, in Deutschland würde zu viel vorgeschrieben, habe ich mir einmal die Mühe gemacht, in die Gesetzbücher anderer Länder zu schauen.“"
                                            },
                                            {
                                                "example_id": "c8defcd1-938a-4aa4-a254-34a3e2792ca0",
                                                "sense_id": "dbf616aa-4cf9-333e-baa9-312320c1125b",
                                                "text": "„Er dachte an seine gesetzgeberische Arbeit, dachte daran, wie eifrig er die einzelnen Artikel der römischen und französischen Gesetzbücher ins Russische übertragen hatte, und er begann sich zu schämen.“"
                                            },
                                            {
                                                "example_id": "6265539e-f3d7-4ad4-be7a-6ea1d5e5892a",
                                                "sense_id": "dbf616aa-4cf9-333e-baa9-312320c1125b",
                                                "text": "„Schwarzenberg stand im Dienst des Bischofs von Bamberg, einem der Feinde des Götz von Berlichingen, der das alte Fehderecht sicher nicht durch ein neues Gesetzbuch eingeschränkt sehen wollte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
