{
    "word_family": [
        "évoquer",
        "évocateur",
        "évocatoire"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4afe3cf9-4986-3082-bd57-d0c9299ce412",
                    "sense_definition": "Action de rappeler à la mémoire ou de se représenter mentalement une chose passée ou absente.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mémoire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La simple <w>évocation</w> de ces vacances d'enfance nous a tous fait sourire."
                        },
                        {
                            "text": "Ce roman propose une brillante <w>évocation</w> de la vie parisienne au dix-neuvième siècle."
                        }
                    ],
                    "synonyms": [
                        "rappel",
                        "remémoration",
                        "souvenir"
                    ],
                    "antonyms": [
                        "oubli"
                    ],
                    "common_phrases": [
                        "simple évocation",
                        "évocation du passé"
                    ]
                },
                {
                    "sense_id": "e03ea2d0-c578-3848-9dd4-4e75a279b381",
                    "sense_definition": "Action magique ou rituelle d'appeler ou de faire apparaître des esprits, des âmes ou des divinités.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "occulte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le rituel prévoyait l'<w>évocation</w> des esprits ancestraux pendant la nuit de la pleine lune."
                        },
                        {
                            "text": "Dans ce conte mystérieux, l'<w>évocation</w> des âmes disparues provoque de nombreux désordres."
                        }
                    ],
                    "synonyms": [
                        "invocation",
                        "conjuration"
                    ],
                    "common_phrases": [
                        "évocation des esprits",
                        "évocation des morts"
                    ]
                },
                {
                    "sense_id": "4b7538d4-c770-3e4a-bc34-f65fc364702b",
                    "sense_definition": "Procédure par laquelle une juridiction supérieure se saisit d'un litige ou d'une affaire instruite par une juridiction inférieure.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "droit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'avocat a déposé une demande en <w>évocation</w> pour faire réexaminer l'affaire par une juridiction d'appel."
                        },
                        {
                            "text": "Le tribunal a décidé l'<w>évocation</w> de la cause afin de statuer sur le fond du litige."
                        }
                    ],
                    "common_phrases": [
                        "demande en évocation",
                        "droit d'évocation"
                    ]
                }
            ]
        }
    ]
}