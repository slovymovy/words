                "senses": [
                    {
                        "sense_id": "d8e7dc8c-8489-3cb9-9590-5b9bd968f016",
                        "entry_id": "c6402a1f-ab98-3e37-b97a-5842d10150aa",
                        "glosses": [
                            "algemeen directeur van een bedrijf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3f01b4b-75d2-401f-8afb-a1e98c23ebd3",
                                "sense_id": "d8e7dc8c-8489-3cb9-9590-5b9bd968f016",
                                "text": "Hij begon ooit als verkoopmedewerker, maar is nu al jaren de CEO van deze oliefabrikant."
                            },
                            {
                                "example_id": "b1f6bbfb-48ea-4ac0-9073-0ea34fd8860f",
                                "sense_id": "d8e7dc8c-8489-3cb9-9590-5b9bd968f016",
                                "text": "Over het belang van verantwoord ondernemen denken zes CEO’s van grote Nederlandse bedrijven heel verschillend, bleek in de herstart van het legendarische discussieprogramma."
                            },
                            {
                                "example_id": "42de1e50-bdc8-4b59-a54e-7302ba9626e3",
                                "sense_id": "d8e7dc8c-8489-3cb9-9590-5b9bd968f016",
                                "text": "Een goede CEO pakt problemen aan en lost ze op."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ff55e36a-2500-4bb9-9c61-51b8df42fc45",
                        "source_entry_id": "c6402a1f-ab98-3e37-b97a-5842d10150aa",
                        "source_sense_id": "d8e7dc8c-8489-3cb9-9590-5b9bd968f016",
                        "source_sense_description": "(initiaalwoord) algemeen directeur van een bedrijf",
                        "target_lang_word": "CEO",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "CEO",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "194136cb-355b-31d2-bc00-676fce39ef5b",
                                        "entry_id": "204bb58e-f3ce-3298-b2cb-6b4f8615ddd3",
                                        "glosses": [
                                            "Initialism of chief executive officer."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "countable",
                                            "initialism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8cdd8d10-afdd-4a44-bbdf-d199a4ce7a1d",
                                                "sense_id": "194136cb-355b-31d2-bc00-676fce39ef5b",
                                                "text": "CEOs who once made 50 times the average worker’s salary made more than 500 times as much in 2001."
                                            },
                                            {
                                                "example_id": "95de7ea1-9bf7-4d5d-b018-30b6aee3116c",
                                                "sense_id": "194136cb-355b-31d2-bc00-676fce39ef5b",
                                                "text": "Stack ranking had come into fashion after GE CEO Jack Welch used a similar system, called rank-and-yank, to turn around that company in the 1980s and 1990s."
                                            },
                                            {
                                                "example_id": "ad1e577b-10b2-4375-9c10-7978b7b54072",
                                                "sense_id": "194136cb-355b-31d2-bc00-676fce39ef5b",
                                                "text": "Swisher then looked back at a number of tech CEOs booked for the conference in the past — from Steve Jobs to Elon Musk — and relayed that “we never promised anything or gave them any heads up. We’re journalists FFS.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57493f22-ffb4-3901-a2af-80762516e146",
                                        "entry_id": "204bb58e-f3ce-3298-b2cb-6b4f8615ddd3",
                                        "glosses": [
                                            "Initialism of civil enforcement officer."
                                        ],
                                        "tags": [
