                "senses": [
                    {
                        "sense_id": "9e0b4abe-9644-301a-a209-7db8eccc1793",
                        "entry_id": "bc87c547-a671-3225-a848-13c0171afa4e",
                        "glosses": [
                            "Consecrated by a vow or promise; consequent on a vow; devoted; promised."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18739f8d-56f7-40b3-8813-51a72298191b",
                                "sense_id": "9e0b4abe-9644-301a-a209-7db8eccc1793",
                                "text": "And votary Reſolution is made Equipollent to Cuſtome"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "8e0a7ccb-af84-3b33-a45c-14f95c80c370",
                "word": "votary",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "279a9ecd-054f-4192-a90d-d0a46379b27c",
                        "entry_id": "8e0a7ccb-af84-3b33-a45c-14f95c80c370",
                        "tags": [
                            "plural"
                        ],
                        "form": "votaries"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "125c0c21-4e04-31f8-a555-23fc7e083aa1",
                        "entry_id": "8e0a7ccb-af84-3b33-a45c-14f95c80c370",
                        "glosses": [
                            "A person, such as a monk or nun, who lives a religious life according to vows they have made."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "9b96aa6e-5288-34bd-88d8-f69983609b58",
                        "entry_id": "8e0a7ccb-af84-3b33-a45c-14f95c80c370",
                        "glosses": [
                            "A devotee of a particular religion or cult."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "212d15ca-6c2f-3f87-8a0b-909fb016d2dd",
                        "entry_id": "8e0a7ccb-af84-3b33-a45c-14f95c80c370",
                        "glosses": [
                            "A devout or zealous worshipper."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "50087484-9485-3260-9f3d-a68311beb501",
                        "entry_id": "8e0a7ccb-af84-3b33-a45c-14f95c80c370",
                        "glosses": [
                            "Someone who is devoted to a particular pursuit etc."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "1c0f19a8-e6ef-4be8-ab59-b9e12efa71be",
                                "sense_id": "50087484-9485-3260-9f3d-a68311beb501",
                                "text": "But it is not ſimply of the progreſs of luxury that we have to complain: did its votaries keep in their own ſphere of thoughtleſs diſſipation, we might deſpiſe them without emotion; but the frivolous purſuits of pleaſure are mingled with the moſt important concerns of the ſtate;"
                            },
                            {
                                "example_id": "c3eb6c91-abb9-4f0e-aea4-d22e34afb9c6",
                                "sense_id": "50087484-9485-3260-9f3d-a68311beb501",
                                "text": "The room was commonly emptied after that, or only left in possession of a very few and persevering votaries of pleasure."
                            },
                            {
                                "example_id": "0bb741ee-be52-4579-a807-cac72262a8a0",
                                "sense_id": "50087484-9485-3260-9f3d-a68311beb501",
                                "text": "He is such a votary of the modern that he was inevitably interested in the girl of the future and had matched one reform with another, being ready to marry without a penny, as the clearest way of expressing his appreciation, this favourable specimen of the type."
                            },
                            {
                                "example_id": "34c72758-1507-4c11-b142-733e51938307",
                                "sense_id": "50087484-9485-3260-9f3d-a68311beb501",
                                "text": "The indulgence of illicit pleasures, says Dr. S. Pancoast, sooner or later is sure to entail the most loathsome diseases on their votaries."
                            },
                            {
                                "example_id": "60b4ada7-e597-4201-a470-78c2921fb1c5",
                                "sense_id": "50087484-9485-3260-9f3d-a68311beb501",
                                "text": "Gerty was dressed simply but with the instinctive taste of a votary of Dame Fashion for she felt that there was just a might that he might be out."
                            }
                        ]
                    },
                    {
                        "sense_id": "df46768c-5425-3365-9e14-652c1a5e499b",
                        "entry_id": "8e0a7ccb-af84-3b33-a45c-14f95c80c370",
                        "glosses": [
                            "A loyal supporter or devoted admirer of a person or institution."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
