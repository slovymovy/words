                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d80706a8-9c58-42a7-9520-537815ba5873",
                                "sense_id": "996cdc54-a4e0-3ad9-aed8-1201374b583a",
                                "text": "„Chelidonin ist ein Mitosegift und Tumorhemmstoff (Cytostatika) und wirkt außerdem gegen grampositive Bakterien.“"
                            },
                            {
                                "example_id": "3eda4735-11ff-40c7-b92e-842a2ad78be7",
                                "sense_id": "996cdc54-a4e0-3ad9-aed8-1201374b583a",
                                "text": "„Vinblastin wirkt als Mitosegift.“"
                            },
                            {
                                "example_id": "bb0933c7-cf18-49ad-871a-5fe99adb3a3e",
                                "sense_id": "996cdc54-a4e0-3ad9-aed8-1201374b583a",
                                "text": "„Bösartige Tumoren haben extrem hohe Mitoseraten, daher reagieren ihre Zellen besonders empfindlich auf Mitosegifte.“"
                            },
                            {
                                "example_id": "16e1e221-165d-4048-becc-31d4ae04c204",
                                "sense_id": "996cdc54-a4e0-3ad9-aed8-1201374b583a",
                                "text": "„Durch Mitosegifte kann eine Polyploidie künstlich herbeigeführt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
