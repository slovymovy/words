                        "glosses": [
                            "Nature intrinsèque de ce qui est longitudinal."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "73670391-b80e-4892-ae2b-b28450c6e8e4",
                                "sense_id": "24e62529-d878-3198-ae84-2e6b57bd92dd",
                                "text": "Ce «retour» permet à la direction transversale de se confondre avec la longitudinale, et à chaque soi d'oublier son moi (sa transversalité) pour se fondre dans le soi véritable (la longitudinalité)."
                            },
                            {
                                "example_id": "92d0a1e7-a7d9-4cf4-aad1-c89b4d5c5c3f",
                                "sense_id": "24e62529-d878-3198-ae84-2e6b57bd92dd",
                                "text": "La longitudinalité de l'hypertexte est amenée par le défilement vertical d'un ensemble de pages proposant de l'information sur un sujet."
                            },
                            {
                                "example_id": "58032c13-891b-43d9-b328-81055122d2a1",
                                "sense_id": "24e62529-d878-3198-ae84-2e6b57bd92dd",
                                "text": "La nouveauté n'implique donc pas une rupture dans la continuité historique; en effet, l'église gothique est encore basée sur les thèmes fondamentaux de longitudinalité et de centralisation."
                            }
                        ]
                    }
