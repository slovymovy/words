                    },
                    {
                        "translation_id": "0d1a6b53-f0b9-4d06-a467-f30be6e1cd6e",
                        "source_entry_id": "db560102-e565-3822-9b35-85bbbcc2e372",
                        "source_sense_id": "6d7cf6bf-69f2-39d0-849f-311c9c380a36",
                        "target_lang_word": "banter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "banter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1be884fe-d4f3-3061-83d9-1e58eb75804a",
                                        "entry_id": "c1ee9b79-2f39-32a5-9cea-99184568c2c2",
                                        "glosses": [
                                            "Sharp, good-humoured, playful, typically spontaneous conversation."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f7b2e03-e204-4220-ab07-290ed72a370c",
                                                "sense_id": "1be884fe-d4f3-3061-83d9-1e58eb75804a",
                                                "text": "I was elected to the Executive Committee of the Vegetarian Society, and made it a point to attend every one of its meetings, but I always felt tongue-tied. Dr. Oldfield once said to me, 'You talk to me quite all right, but why is it that you never open your lips at a committee meeting? You are a drone.' I appreciated the banter. The bees are ever busy, the drone is a thorough idler."
                                            },
                                            {
                                                "example_id": "82f52597-f03b-4a01-9944-f597b9ee8c50",
                                                "sense_id": "1be884fe-d4f3-3061-83d9-1e58eb75804a",
                                                "text": "This bullying continuum illustrates the progressive escalation from harmless banter to bullying and criminal behaviours."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7c21b5e-8672-3758-8869-56e8479fd5a4",
                                        "entry_id": "c1ee9b79-2f39-32a5-9cea-99184568c2c2",
                                        "glosses": [
                                            "Good-humoured bits of monologue and/or conversational prompts used in any of a wide range of occupations that must frequently interact with the public (for example, store clerks, salespersons, nurses)."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "banter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "94f4a6e1-1cea-349d-bdd8-bdbd9ddac0be",
                                        "entry_id": "46bbd187-86cf-3ea0-aa7b-8b9ba9e8bc8d",
                                        "glosses": [
                                            "To engage in banter or playful conversation."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e874bada-b5b0-3d95-b132-b0617795d8fa",
                                        "entry_id": "46bbd187-86cf-3ea0-aa7b-8b9ba9e8bc8d",
                                        "glosses": [
                                            "To play or do something amusing."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "046ca871-a074-385d-9315-0a94bbe00812",
                                        "entry_id": "46bbd187-86cf-3ea0-aa7b-8b9ba9e8bc8d",
                                        "glosses": [
                                            "To tease (someone) mildly."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85b0c477-3c75-4119-a6c2-07216056d83d",
                                                "sense_id": "046ca871-a074-385d-9315-0a94bbe00812",
                                                "text": "Here comes the muſty trader, running over vvith remonſtrances. I muſt banter the cit."
                                            },
                                            {
                                                "example_id": "6c1390a8-c6ec-4ed4-b3e5-acd16b7873db",
                                                "sense_id": "046ca871-a074-385d-9315-0a94bbe00812",
                                                "text": "Hag-ridden by my own fancy all night, and then bantered on my haggard looks the next day."
                                            },
                                            {
                                                "example_id": "51337748-c657-4f9c-8f88-fc121fd2b36f",
                                                "sense_id": "046ca871-a074-385d-9315-0a94bbe00812",
                                                "text": "Mr. Sweeting was bantered about his stature, he was a little man, a mere boy in height and breadth compared with the athletic Malone, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c00d3597-8278-3c15-a6c8-9c18b4b6f72e",
                                        "entry_id": "46bbd187-86cf-3ea0-aa7b-8b9ba9e8bc8d",
                                        "glosses": [
                                            "To joke about; to ridicule (a trait, habit, etc.)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84986bbc-b19f-42e7-ab17-3bb6914930ca",
                                                "sense_id": "c00d3597-8278-3c15-a6c8-9c18b4b6f72e",
                                                "text": "June 1804, William Pitt, 1st Earl of Chatham\nIf they banter your regularity, order, and love of study, banter in return their neglect of them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1affc99c-1337-358c-a02a-aeaf3a67fc2a",
                                        "entry_id": "46bbd187-86cf-3ea0-aa7b-8b9ba9e8bc8d",
                                        "glosses": [
                                            "To delude or trick; to play a prank upon."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c83445c8-8a3c-440c-af87-8ec9eb269bdb",
                                                "sense_id": "1affc99c-1337-358c-a02a-aeaf3a67fc2a",
                                                "text": "[W]e diverted ourſelves vvith bantering ſeveral other poor Scholars, vvith hopes of being at leaſt his Lordſhip's Chaplains and putting on a Scarf; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0321c664-c6c4-3737-81ba-e0bb817e5da9",
                                        "entry_id": "46bbd187-86cf-3ea0-aa7b-8b9ba9e8bc8d",
                                        "glosses": [
                                            "To challenge to a match."
                                        ],
                                        "tags": [
                                            "Southern",
                                            "US",
                                            "Western",
                                            "colloquial",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7c913258-8e6b-348c-b09e-d945a6f75dae",
                                        "entry_id": "46bbd187-86cf-3ea0-aa7b-8b9ba9e8bc8d",
                                        "glosses": [
                                            "To haggle; cheapen the price."
                                        ],
                                        "tags": [
                                            "UK",
                                            "dialectal"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1d177185-ae43-4854-8b0e-23dc549f9483",
                        "source_entry_id": "db560102-e565-3822-9b35-85bbbcc2e372",
                        "source_sense_id": "6d7cf6bf-69f2-39d0-849f-311c9c380a36",
                        "target_lang_word": "folly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "folly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b002d450-f5c1-356b-9828-a35a0c67aa0d",
                                        "entry_id": "97e799f0-4912-3533-91ef-d2dc69bbf8e9",
                                        "glosses": [
                                            "Foolishness that results from a lack of foresight or lack of practicality."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a356419-8fd1-4ac8-9881-1efe5704f706",
                                                "sense_id": "b002d450-f5c1-356b-9828-a35a0c67aa0d",
                                                "text": "It would be folly to walk all that way, knowing the shops are probably shut by now."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3760c16b-c0d6-3692-a96f-22d8b96715be",
                                        "entry_id": "97e799f0-4912-3533-91ef-d2dc69bbf8e9",
                                        "glosses": [
                                            "Thoughtless action resulting in tragic consequence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58ca86af-cdcd-47cd-b0c2-d504c4aed1a6",
                                                "sense_id": "3760c16b-c0d6-3692-a96f-22d8b96715be",
                                                "text": "The purchase of Alaska from Russia was termed Seward's folly."
                                            },
                                            {
                                                "example_id": "3fc670c1-8def-46af-b131-c6e6649c1a88",
                                                "sense_id": "3760c16b-c0d6-3692-a96f-22d8b96715be",
                                                "text": "Thames Water has become the latest object lesson in the predictable and predicted folly of privatised monopolies, aided by a regulator that’s an even bigger wet wipe than the fatbergs bunging up the sewers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fadcf703-bf50-302a-960f-ba3fb7d12f98",
                                        "entry_id": "97e799f0-4912-3533-91ef-d2dc69bbf8e9",
                                        "glosses": [
                                            "A fanciful building built for purely ornamental reasons."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af4a1053-f24b-4f4f-a40b-6533173f3553",
                                                "sense_id": "fadcf703-bf50-302a-960f-ba3fb7d12f98",
                                                "text": "A luncheonette in the shape of a coffee cup is particularly conspicuous, as is intended of an architectural duck or folly."
                                            },
                                            {
                                                "example_id": "2f9bba73-4691-4657-9cb0-55eaf44ba88b",
                                                "sense_id": "fadcf703-bf50-302a-960f-ba3fb7d12f98",
                                                "text": "“The Villa Straylight,” said a jeweled thing on the pedestal, in a voice like music, “is a body grown in upon itself, a Gothic folly. […]”"
                                            },
                                            {
                                                "example_id": "9d596ead-af70-4755-9c05-f38c75102afe",
                                                "sense_id": "fadcf703-bf50-302a-960f-ba3fb7d12f98",
                                                "text": "It has been a long time since new follies were springing up across the great estates of Britain. But the owners of Doddington Hall, in Lincolnshire, have brought the folly into the 21st century, by building a 30ft pyramid in the grounds of the Elizabethan manor."
                                            },
                                            {
                                                "example_id": "477d50e2-1a42-4672-82a5-a44cb22ec3bc",
                                                "sense_id": "fadcf703-bf50-302a-960f-ba3fb7d12f98",
                                                "text": "A great deal of eccentricity was expressed through the trend for ruin follies. But it wasn’t only the madness of paranoid earls and fashionable landowners that was encoded in them."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "folly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "165cddf4-6931-3295-b592-ac3ceee80a9e",
                                        "entry_id": "68944239-5d58-3481-be59-2783a20328f5",
                                        "glosses": [
                                            "To follow."
                                        ],
                                        "tags": [
                                            "dialectal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a7a1126-653c-40fd-a23e-9cf2cb55ccce",
                                                "sense_id": "165cddf4-6931-3295-b592-ac3ceee80a9e",
                                                "text": "\"You got any money?\" he said to me. ¶ \"Hell no, maybe enough for a pint of whisky till I get to Denver. What about you?\" ¶ \"I know where I can get some.\" ¶ \"Where?\" \"Anywhere. You can always folly a man down an alley, can't you?\""
                                            },
                                            {
                                                "example_id": "cd019caf-2837-47a0-8dac-424c76ec5e90",
                                                "sense_id": "165cddf4-6931-3295-b592-ac3ceee80a9e",
                                                "text": "\"Anybody got the makin's?\" he said. \"That's one hell of a thick bunch of canvas, but I follied the seam.\""
                                            },
                                            {
                                                "example_id": "b056c5fd-f354-445c-8596-4061045acccf",
                                                "sense_id": "165cddf4-6931-3295-b592-ac3ceee80a9e",
                                                "text": "Howandever, at the selfsame time, there was a gang of fellas from the valley of kings follying the very same pointy star. And didn't that pointy star point them king-fellas in the direction of Mary's cowstable."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "folly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ce357eb4-600e-3346-b172-f2ced219dd24",
                                        "entry_id": "7b353de9-a524-3e74-b306-24049cf80aba",
                                        "glosses": [
                                            "A clump of trees, particularly one on the crest of a hill (or sometimes on a stretch of open ground)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16d61ac2-59f2-4f48-939c-c2de872d7d5f",
                                                "sense_id": "ce357eb4-600e-3346-b172-f2ced219dd24",
                                                "text": "'Every hill seems to have a Folly' [...] 'I mean a clump of trees on the top.'"
                                            },
                                            {
                                                "example_id": "8e5e65e3-7a06-4c06-8df2-74d9ed1a61a4",
                                                "sense_id": "ce357eb4-600e-3346-b172-f2ced219dd24",
                                                "text": "Folly Beach, the next island to the south (batik 3.7), bears the name given it by mariners, who looked for the island's tree-crested dune ridge, a volley or folly of trees, as a navigation guide [...] Probably a lot of East Coast islands bore the temporary name of Folly Beach."
                                            },
                                            {
                                                "example_id": "8a1b5e6b-040d-4132-ad43-17fdf6ccd80a",
                                                "sense_id": "ce357eb4-600e-3346-b172-f2ced219dd24",
                                                "text": "During the 1920s and 1930s, Folly Farms (above) [referencing a photograph of a farmhouse surrounded by large trees] was owned by Mrs. Samuel Pennington Rotan of Pennsylvania, who was involved in the effort to improve medical care for the indigent people around Ways Station. … Folly Farms was originally known as Myrtle Grove …"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "79e391c5-9594-475e-b4ef-f990b05117c7",
