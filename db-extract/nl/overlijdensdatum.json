                "senses": [
                    {
                        "sense_id": "7e30a579-74da-36d1-9c77-4cd5899999cd",
                        "entry_id": "f81399d3-2e8f-324a-8cc1-3152be35cc1e",
                        "glosses": [
                            "datum waarop iemand is overleden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1ced89c-b023-4441-8e41-58db922e2d37",
                                "sense_id": "7e30a579-74da-36d1-9c77-4cd5899999cd",
                                "text": "\"Ik wens begraven te worden naast mijn vrouw, als het mag, en dat een marmeren steen zes voet lang en vier voetbreed, duidelijk met slechts een kleine lijst rond de bovenrand en deze inscriptie: Benjamin en Deborah Franklin en onze geboorte- en overlijdensdatum."
                            },
                            {
                                "example_id": "329856e4-69f6-4a0e-8aca-0225d99fdf15",
                                "sense_id": "7e30a579-74da-36d1-9c77-4cd5899999cd",
                                "text": "Carla Mans vond de afgelopen jaren de foto's van 220 gesneuvelde militairen die in Margraten begraven liggen. Als ze weet waar een soldaat woonde zoekt ze in de lokale Amerikaanse kranten naar informatie. \"Soms vind je rond de overlijdensdatum een artikel met een foto erbij. Maar vaak ontbreekt de foto ook. Dan moeten we verder zoeken.\""
                            }
                        ]
                    }
