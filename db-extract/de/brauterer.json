                "senses": [
                    {
                        "sense_id": "69534002-6b16-3e2e-9c5e-3c67037d3e72",
                        "entry_id": "aa3dd38a-6db0-3298-98d0-7e5f57eb4edc",
                        "glosses": [
                            "zukünftiger männlicher Ehepartner"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b21dd016-763a-416c-882f-6378d0582ca1",
                                "sense_id": "69534002-6b16-3e2e-9c5e-3c67037d3e72",
                                "text": "„Gleichzeitig is die Braut, die vergebens auf ihren Brauterer gewartet hat, in allen Wirthshäusern und Kaffeehütteln herumgerennt, und hat voll Verzweiflung g' schrieen: […]“"
                            },
                            {
                                "example_id": "f1a39b76-caf6-4281-a2ae-6d36311018a8",
                                "sense_id": "69534002-6b16-3e2e-9c5e-3c67037d3e72",
                                "text": "„Himmeltausend, seh ich recht, dort in der Allee ist meine Frau mit der Schwägerin, und zwei Herrn bei ihnen, sie wenden sich hieher, wann die mich als Brauterer sehn.“"
                            },
                            {
                                "example_id": "3e6fd8ad-f63e-4e5b-b073-1dd5979d1e43",
                                "sense_id": "69534002-6b16-3e2e-9c5e-3c67037d3e72",
                                "text": "„Alle Hälse streckten sich und verfolgten den langen Brautzug, mit all' den Gästen in Prunkgewändern von rauschender Seide. ‚Schade, daß der Brauterer kleiner ist wie sie‘, bedauerte Magdalen.“"
                            },
                            {
                                "example_id": "5b8e632a-699c-48c7-85ff-e14e3c658616",
                                "sense_id": "69534002-6b16-3e2e-9c5e-3c67037d3e72",
                                "text": "„No, wiar i Ihna sag', just wollt die Braut mit'n Brauterer in' Fiaker steigen, und zu der Trauung in d' Kirchen fahr'n, da reißt auf amal a Weibsbild mit todtenbleichen G'sicht und fliegende Haarzöpf 'n Wagenschlag auf, und schreit inwendi eini: […]“"
                            },
                            {
                                "example_id": "40cb1fa7-5893-43be-81cf-363148f523b7",
                                "sense_id": "69534002-6b16-3e2e-9c5e-3c67037d3e72",
                                "text": "„Der Brauterer möcht schon immer gern wissen, ob sie nit bald ‚n e i n‘ sagen wird, […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
