                    "semantic_group_id": "zeitpunkt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wenn du jetzt nicht gleich losgehst, kommst du zu <w>spät</w> zum Unterricht."
                        },
                        {
                            "text": "Entschuldigung für die Störung, aber mein Zug hatte Verspätung und ich bin leider etwas zu <w>spät</w>."
                        }
                    ],
                    "synonyms": [
