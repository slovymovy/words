                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "6a6f0f39-42c1-40e3-888a-db1c31210bd4",
                        "entry_id": "369ba900-2df0-36d3-a31a-480e3ffdf2df",
                        "tags": [
