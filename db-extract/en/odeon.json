                        "translation_id": "0cdf0492-c513-4c94-9f46-87e098c58ead",
                        "source_entry_id": "9a6a91a7-a503-3e76-b043-76dfe3a01178",
                        "source_sense_description": "ancient Greek or Roman building",
                        "target_lang_word": "odéon",
