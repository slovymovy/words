                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f8785be-ce4e-4797-83a6-e5f7f58463e3",
                                "sense_id": "35c924b8-3290-3bc3-b5ea-d558dff3aaf4",
                                "text": "The extreme pains taken to reconcile the unfortunate beings to their lot; the assiduity of the clergy to make up, by the assurance of divine mercy, the inexorable fate which awaited them; proved that these awful slaughters were onerous to the colonial conscience, and vindicable only as the last resort of the last necessity."
                            },
                            {
                                "example_id": "9d03e1d2-c168-4861-8c57-083d9a9712f9",
                                "sense_id": "35c924b8-3290-3bc3-b5ea-d558dff3aaf4",
                                "text": "The elimination of the indefensible, the setting aside of the legendary, the transference of the supposedly miraculous to the order of natural powers and processes so far as vindicable ground for such critical treatment is discovered, is the only way to answer the first of all questions concerning the Bible: How much of this is credible history?"
                            }
                        ]
                    }
