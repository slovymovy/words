            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d5a7f6f8-189d-356e-8e6b-eaea7e8b4a02",
                    "sense_definition": "placówka służby zdrowia, w której lekarze przyjmują chorych i wykonują podstawowe badania",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "placówka medyczna",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Muszę jutro rano pójść do <w>przychodni</w>, żeby zapisać się na wizytę u lekarza.",
                            "target_lang_translations": {
                                "ru": "Мне нужно завтра утром пойти в <w>поликлинику</w>, чтобы записаться на приём к врачу."
                            }
                        },
                        {
                            "text": "Nasza lokalna <w>przychodnia</w> oferuje bezpłatne badania krwi dla wszystkich pacjentów.",
                            "target_lang_translations": {
                                "ru": "Наша местная <w>поликлиника</w> предлагает бесплатные анализы крови для всех пациентов."
                            }
                        }
                    ],
                    "synonyms": [
                        "ośrodek zdrowia"
                    ],
                    "common_phrases": [
                        "przychodnia rejonowa",
                        "przychodnia lekarska",
                        "iść do przychodni"
                    ],
                    "target_lang_definitions": {
                        "ru": "Медицинское учреждение, где врачи принимают больных и проводят базовые обследования; амбулатория."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поликлиника",
                                "target_lang_sense_clarification": "медицинское учреждение для амбулаторного лечения"
                            },
                            {
                                "target_lang_word": "амбулатория",
                                "target_lang_sense_clarification": "небольшое лечебное учреждение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8c66f937-41ce-33bc-a6e2-642f55f781ec",
                    "sense_definition": "dopełniacz oraz biernik liczby pojedynczej od słowa <w>przychodzień</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gospodarz przywitał nieznajomego <w>przychodnia</w> z należytą gościnnością i zaproponował mu ciepły posiłek.",
                            "target_lang_translations": {
                                "ru": "Хозяин встретил незнакомого <w>странника</w> с подобающим гостеприимством и предложил ему горячую еду."
                            }
                        },
                        {
                            "text": "Nikt z mieszkańców wioski nie rozpoznał owego tajemniczego <w>przychodnia</w>.",
                            "target_lang_translations": {
                                "ru": "Никто из жителей деревни не узнал того таинственного <w>пришельца</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "forma fleksyjna rzeczownika przychodzień"
                        }
                    ],
                    "target_lang_definitions": {
