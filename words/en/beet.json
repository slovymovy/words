{
    "word_family": [
        "beetroot"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "07b37534-34d5-3e01-a3b5-69d22ee7ffd7",
                    "sense_definition": "A swollen root of the beet plant eaten as a culinary vegetable.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "culinary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She added sliced roasted <w>beet</w> to the fresh garden salad.",
                            "target_lang_translations": {
                                "de": "Sie gab geschnittene geröstete <w>Rote Bete</w> zum frischen Gartensalat."
                            }
                        },
                        {
                            "text": "My hands were stained deep red after peeling the boiled <w>beets</w>.",
                            "target_lang_translations": {
                                "de": "Meine Hände waren dunkelrot verfärbt, nachdem ich die gekochten <w>Roten Beten</w> geschält hatte."
                            }
                        }
                    ],
                    "synonyms": [
                        "beetroot"
                    ],
                    "common_phrases": [
                        "roasted beet",
                        "pickled beets",
                        "fresh beet"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine knollenartige Wurzel der Bete-Pflanze, die als Speisegemüse gegessen wird (meist die Rote Bete)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Rote Bete",
                                "target_lang_sense_clarification": "als Speisegemüse (deutschlandweit üblich)"
                            },
                            {
                                "target_lang_word": "Rote Rübe",
                                "target_lang_sense_clarification": "als Speisegemüse (vor allem süddeutsch, österreichisch)"
                            },
                            {
                                "target_lang_word": "Bete",
                                "target_lang_sense_clarification": "allgemeine Bezeichnung für Speiserüben dieser Art"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bcc30ef6-a5c8-3988-8677-f871673597b1",
                    "sense_definition": "Beta vulgaris, a plant with a swollen root that is cultivated for food or for sugar production.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "culinary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Farmers in this cool northern region often cultivate the <w>beet</w> as an important cash crop.",
                            "target_lang_translations": {
                                "de": "Landwirte in dieser kühlen nördlichen Region bauen die <w>Rübe</w> oft als wichtige Markt- und Nutzpflanze an."
                            }
                        },
                        {
                            "text": "The common <w>beet</w> is a hardy biennial plant that thrives in fertile soil.",
                            "target_lang_translations": {
                                "de": "Die Gemeine <w>Rübe</w> ist eine robuste, zweijährige Pflanze, die auf fruchtbarem Boden gedeiht."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sugar beet"
                    ],
                    "target_lang_definitions": {
                        "de": "Beta vulgaris, eine zweijährige Pflanze mit dicker Wurzel, die als Nahrungsmittel oder zur Zuckergewinnung angebaut wird."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Rübe",
                                "target_lang_sense_clarification": "botanisch bzw. landwirtschaftlich (Beta vulgaris)"
                            },
                            {
                                "target_lang_word": "Bete",
                                "target_lang_sense_clarification": "botanische Art"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "14ad9b11-a4c5-3b06-833d-a20f4c6126b1",
                    "sense_definition": "To mend, repair, or improve something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "remedy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He hoped to <w>beet</w> his torn coat before winter set in.",
                            "target_lang_translations": {
                                "de": "Er hoffte, seinen zerrissenen Mantel <w>auszubessern</w>, bevor der Winter einbrach."
                            }
                        },
                        {
                            "text": "There was little the doctor could do to <w>beet</w> such serious injuries.",
                            "target_lang_translations": {
                                "de": "Der Arzt konnte wenig tun, um solch schwere Verletzungen zu <w>heilen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "mend",
                        "repair",
                        "improve"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in archaic or dialectal contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Etwas ausbessern, reparieren oder heilen (archaisch oder dialektal)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "ausbessern",
                                "target_lang_sense_clarification": "Kleidung, Gegenstände flicken"
                            },
                            {
                                "target_lang_word": "heilen",
                                "target_lang_sense_clarification": "Wunden, Verletzungen kurieren"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0aec1a84-067e-3b7d-8597-82658df21376",
                    "sense_definition": "To kindle or replenish a fire.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She gathered dry kindling in order to <w>beet</w> the dying hearth.",
                            "target_lang_translations": {
                                "de": "Sie sammelte trockenes Reisig, um die erlöschende Feuerstelle wieder <w>anzufachen</w>."
                            }
                        },
                        {
                            "text": "They had to <w>beet</w> the fire constantly through the stormy night.",
                            "target_lang_translations": {
                                "de": "Sie mussten das Feuer während der stürmischen Nacht ständig <w>schüren</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "kindle"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Historical or dialectal usage."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein Feuer schüren, anfachen oder mit Brennstoff versorgen (archaisch)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "schüren",
                                "target_lang_sense_clarification": "ein Feuer anfachen oder nähren"
                            },
                            {
                                "target_lang_word": "anfachen",
                                "target_lang_sense_clarification": "ein Feuer entfachen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d6b0ceb0-b0a6-3735-859a-475cebe3f977",
                    "sense_definition": "To rouse, stimulate, or stir up.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The speech was intended to <w>beet</w> courage in their weary hearts.",
                            "target_lang_translations": {
                                "de": "Die Rede sollte Mut in ihren müden Herzen <w>wecken</w>."
                            }
                        },
                        {
                            "text": "Nothing could <w>beet</w> his enthusiasm after such a bitter defeat.",
                            "target_lang_translations": {
                                "de": "Nichts konnte nach einer so bitteren Niederlage seine Begeisterung wieder <w>anfachen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "rouse",
                        "stimulate"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Archaic or regional usage."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Aufwecken, anregen oder Gefühle anstacheln (archaisch)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "wecken",
                                "target_lang_sense_clarification": "Mut oder Gefühle wachrufen"
                            },
                            {
                                "target_lang_word": "anfachen",
                                "target_lang_sense_clarification": "Begeisterung oder Mut schüren"
                            }
                        ]
                    }
                }
            ]
        },
        {
