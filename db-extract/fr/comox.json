                "senses": [
                    {
                        "sense_id": "e456020e-7c21-3a9a-b853-a57cfb8b8e85",
                        "entry_id": "c3b9cfc6-51f2-3b00-b0ac-c9178907a536",
                        "glosses": [
                            "Ville de Colombie-Britannique au Canada, située sur la côte orientale de l’île de Vancouver, dans le district régional de Comox-Strathcona."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "debfb993-5198-41be-aba5-f35fc64fb70e",
                                "sense_id": "e456020e-7c21-3a9a-b853-a57cfb8b8e85",
                                "text": "Des habitants de Comox, sur l’île de Vancouver, mettent en garde les résidents contre une plante toxique et envahissante qui se propage à partir d'un terrain de golf local. Le daphné lauréole a également été repéré dans d'autres régions de la Colombie-Britannique, dont le Grand Vancouver et les îles Gulf."
                            }
                        ]
                    },
                    {
                        "sense_id": "fd79b336-5630-3773-aae7-67f3aa69c761",
                        "entry_id": "c3b9cfc6-51f2-3b00-b0ac-c9178907a536",
                        "glosses": [
                            "Variante orthographique de K’ómoks ; un peuple autochtone salish de Colombie-Britannique, sur l’île de Vancouver."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d543698-f414-4a2e-a843-1c16b591e029",
                                "sense_id": "fd79b336-5630-3773-aae7-67f3aa69c761",
                                "text": "La contribution des Premières nations sur le projet de Stratégie de rétablissement a été réalisée par le biais d'une session d'échanges d'information avec la Hamatla Treaty Society, qui représente les bandes locales près du ruisseau Morrison, y compris les Comox, Campbell River, Cape Mudge et la Première nation Kwiakah."
                            }
                        ]
                    }
