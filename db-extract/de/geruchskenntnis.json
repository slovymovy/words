                "senses": [
                    {
                        "sense_id": "e1ca52bb-4849-3f59-afe8-2267f9c9eb46",
                        "entry_id": "d77dec69-8577-3891-8d9d-81fe5f6660e6",
                        "glosses": [
                            "das Wissen über einen bestimmten Geruch und dessen Zuordnung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da3deb34-75b8-4332-93d8-51581b8cfea7",
                                "sense_id": "e1ca52bb-4849-3f59-afe8-2267f9c9eb46",
                                "text": "„Dass die Raupe des Weidenbohrers oder vielmehr ihre Geruchskenntnis heute nützlich sein würde, konnte ja keiner ahnen.“"
                            },
                            {
                                "example_id": "4369d545-8219-450c-9127-ed0b49b712ca",
                                "sense_id": "e1ca52bb-4849-3f59-afe8-2267f9c9eb46",
                                "text": "„Mit einem Duft-Test kann man seine Geruchskenntnisse unter Beweis stellen.“"
                            },
                            {
                                "example_id": "a38c25d8-1f67-4bcf-80bf-322fe7503f5d",
                                "sense_id": "e1ca52bb-4849-3f59-afe8-2267f9c9eb46",
                                "text": "„Genießen Sie die Übung und erkennen Sie, wie reichhaltig Ihre Geruchskenntnisse sind.“"
                            },
                            {
                                "example_id": "194c7d10-16ea-4a78-9b60-4358ecb4f7ef",
                                "sense_id": "e1ca52bb-4849-3f59-afe8-2267f9c9eb46",
                                "text": "„Beim Wahrnehmen der Sinne werden Geschmack, Geruchskenntnisse, Tastsinn usw. geschult.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
