                        "cross_references": []
                    },
                    {
                        "translation_id": "4423c0aa-425d-4778-b9b3-e8690418999a",
                        "source_entry_id": "55da71a0-24dc-34c8-841d-ae214d3e6eb3",
                        "source_sense_id": "2a391751-fed4-306b-8c3e-3198a6a87199",
                        "source_sense_description": "Ein- und Ausgangstür eines Hauses",
                        "target_lang_word": "voordeur",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "voordeur",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "98737b7f-ef08-3d31-8917-f8ed1f058b68",
                                        "entry_id": "cf2bdeb8-b124-301c-baeb-613fb4ce3caf",
                                        "glosses": [
                                            "de hoofddeur aan de voorzijde van een gebouw of woning"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef8b1087-7b18-46ad-ae53-f099eb53eb15",
                                                "sense_id": "98737b7f-ef08-3d31-8917-f8ed1f058b68",
                                                "text": "Als je wilt dat iemand de voordeur voor je openmaakt moet je eerst aanbellen."
                                            },
                                            {
                                                "example_id": "11677770-2e1b-441a-9c93-82be59704987",
                                                "sense_id": "98737b7f-ef08-3d31-8917-f8ed1f058b68",
                                                "text": "Ik hoorde de sleutel in het slot van de voordeur."
                                            },
                                            {
                                                "example_id": "d6b35185-dd12-4043-a16a-8a5dc1d95ef9",
                                                "sense_id": "98737b7f-ef08-3d31-8917-f8ed1f058b68",
                                                "text": "Maar heb jij je nooit afgevraagd waar jij mee bezig bent? Hoe nuttig het is om vijf, zes keer per jaar dezelfde persoon van straat te moeten plukken? Om dezelfde voordeur steeds weer te moeten openbreken? Jij voelt je de redder van de mensheid."
                                            },
                                            {
                                                "example_id": "f4db52aa-6555-45cb-90cb-55d27010a290",
                                                "sense_id": "98737b7f-ef08-3d31-8917-f8ed1f058b68",
                                                "text": "Het zijn schoenen die je niet kapot kunt krijgen, schoenen die nog trouw bij de voordeur staan te wachten als je enkels het allang niet meer doen van de artritis."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
