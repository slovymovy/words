                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9a19d3a9-2c1c-3828-8ea9-f8b8f2d6e546",
                                        "entry_id": "feadd80d-cc15-32c8-9d1b-8ed5d3ee63a9",
                                        "glosses": [
                                            "An inclination to steal."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b295e9a-4c51-4c24-88cb-ce3817c83806",
                                                "sense_id": "9a19d3a9-2c1c-3828-8ea9-f8b8f2d6e546",
                                                "text": "You'd better lock up your belongings before handing your keys to a valet; some of them have sticky fingers."
                                            },
                                            {
                                                "example_id": "1d4806ae-94db-4b4a-a107-029de4097ef2",
                                                "sense_id": "9a19d3a9-2c1c-3828-8ea9-f8b8f2d6e546",
                                                "text": "‘She was great,’ Bennie said. ‘I was crazy about her. But it turned out she had sticky fingers.’ He glanced at Alex. ‘She stole things.’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "136e2f9e-bff5-311d-85d0-1520634dea03",
                                        "entry_id": "feadd80d-cc15-32c8-9d1b-8ed5d3ee63a9",
                                        "glosses": [
                                            "Petty thieves."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b771cdee-411b-4c61-b245-4f2ec684d18d",
                                                "sense_id": "136e2f9e-bff5-311d-85d0-1520634dea03",
                                                "text": "There are too many sticky fingers around for me to leave my purse unattended."
                                            }
                                        ]
                                    }
                                ]
                            },
