                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "921c4017-5a9f-4312-92b2-5b9c123e74f4",
                        "source_entry_id": "5ee40731-7321-3d06-be91-2d9ed43ac494",
                        "source_sense_id": "1c878f6e-abef-3c09-988e-5b72340df3c2",
                        "target_lang_word": "Archaismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Archaismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "67acd9db-e2db-3dda-817e-7acd0fe68a95",
                                        "entry_id": "1f1cfa51-4ba4-38d0-ab24-4e6fb1a99be8",
                                        "glosses": [
                                            "ein sprachlicher Ausdruck, der allmählich außer Gebrauch gerät"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "368cadda-576c-4168-ac38-fd115f42af21",
                                                "sense_id": "67acd9db-e2db-3dda-817e-7acd0fe68a95",
                                                "text": "„In der Gefahr, dieser Regel zu widerstreben, stehen vor allem zwei Wortgruppen: die ‚Neologismen‘ (Neuwörter) und die Archaismen (veraltete Wörter).“"
                                            },
                                            {
                                                "example_id": "3e141f42-7034-4af9-9db3-4fcc103330bc",
                                                "sense_id": "67acd9db-e2db-3dda-817e-7acd0fe68a95",
                                                "text": "„Wörter aus vergangenen Zeiten, Archaismen, können in der Gegenwartssprache stilistische Funktionen erfüllen - sie können der Charakteristik der Sprecher oder der ironischen Darstellung dienen.“"
                                            },
                                            {
                                                "example_id": "57a84342-f8da-44ed-b82c-81eec33f05c4",
                                                "sense_id": "67acd9db-e2db-3dda-817e-7acd0fe68a95",
                                                "text": "„Das Verhältnis von Sprachzustand und Sprachwandel zeigt sich zu jedem Zeitpunkt unter anderem in dem Zusammenwirken von allgemeingültigen Mitteln, Neuerungen und Archaismen.“"
                                            },
                                            {
                                                "example_id": "569d07f9-d122-4a8a-b231-069a170cc601",
                                                "sense_id": "67acd9db-e2db-3dda-817e-7acd0fe68a95",
                                                "text": "„Bedauerlicherweise fehlt eine umfassende Bestandsaufnahme des färöischen Verbalsystems und seiner morphologischen Formen, einschließlich der Varietäten in den Dialekten und der Archaismen, wie sie bei traditionellen färöischen Texten bisweilen in Erscheinung treten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5816c4d6-dfac-3e2a-95e9-e2facb63398d",
                                        "entry_id": "1f1cfa51-4ba4-38d0-ab24-4e6fb1a99be8",
                                        "glosses": [
                                            "eine auf die Entwicklung bezogene Sichtweise, die seelische Phänomene als möglicher Ausdruck eines bestimmten Entwicklungs- oder Reifungsstadiums ansieht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dfade3c2-5c79-45af-bbfa-294c55fa8110",
                                                "sense_id": "5816c4d6-dfac-3e2a-95e9-e2facb63398d",
                                                "text": "„Mit Archaismus bezeichne ich den altertümlichen Charakter psychischer Inhalte und Funktionen.“"
                                            },
                                            {
                                                "example_id": "64de205d-b7b3-4838-9b22-adeb3b201d1d",
                                                "sense_id": "5816c4d6-dfac-3e2a-95e9-e2facb63398d",
                                                "text": "„Das ist aber vermutlich nur für uns Heutige so, die Kelten werden sich über diese Archaismen keine Gedanken gemacht haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
