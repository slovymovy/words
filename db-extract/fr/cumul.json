                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1336442-a1f0-4136-8a12-d8ed30d541f4",
                                "sense_id": "ef3a3a86-8302-3b99-b650-4930d518a4f0",
                                "text": "Le cumul des peines."
                            },
                            {
                                "example_id": "419d8f3d-56ac-4d2b-b2ae-4688bd68a866",
                                "sense_id": "ef3a3a86-8302-3b99-b650-4930d518a4f0",
                                "text": "Le cumul de la réserve et de la quotité disponible est permis, c'est-à-dire la qualité d'héritier à réserve et celle de légataire peuvent être réunies."
                            }
                        ]
                    },
                    {
                        "sense_id": "f80bc0ff-574a-316d-bb5f-ad5d3e42ec72",
                        "entry_id": "fa1d12fb-dc5b-39dd-836d-38b91c69f8ca",
                        "glosses": [
                            "Dans la langue générale, jouissance simultanée de plusieurs emplois ou de plusieurs traitements."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9bcac058-8285-4a7b-b718-d1a07a78a6dc",
                                "sense_id": "f80bc0ff-574a-316d-bb5f-ad5d3e42ec72",
                                "text": "Loi sur le cumul des places."
                            },
                            {
                                "example_id": "f3e849f7-ef7f-4d68-880d-82d8583d17d3",
                                "sense_id": "f80bc0ff-574a-316d-bb5f-ad5d3e42ec72",
                                "text": "Le cumul de deux chaires n'est pas interdit. Le cumul des mandats est mal vu."
                            },
                            {
                                "example_id": "5d4a88ec-860d-4121-8267-f0f9a1e98495",
                                "sense_id": "f80bc0ff-574a-316d-bb5f-ad5d3e42ec72",
                                "text": "Le cumul des effectifs ne pose pas de problème."
                            }
                        ]
                    }
