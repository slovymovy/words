                    {
                        "sense_id": "4cdb4241-7a5c-3034-8509-16647779686f",
                        "entry_id": "30afa5d9-fc8a-3df5-9322-90c9e2dc760f",
                        "glosses": [
                            "voltooid deelwoord van bestuderen"
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "fe907bd6-6fc6-4431-9010-5eaebb4ac253",
                                "sense_id": "4cdb4241-7a5c-3034-8509-16647779686f",
                                "text": "Het staat buiten kijf dat de aandacht voor de Griekse sport- en lichaamscultuur weer groeide toen, na de val van Constantinopel, het Griekse literaire erfgoed weer actief bestudeerd werd."
                            },
                            {
                                "example_id": "93804efc-4916-4b9e-89dc-324b34090e2b",
                                "sense_id": "4cdb4241-7a5c-3034-8509-16647779686f",
                                "text": "Tien maanden lang heeft het gevoelige instrumentarium de sterrenhemel bestudeerd op infrarode golflengten die op aarde niet waarneembaar zijn: de aardse dampkring houdt langgolvige infraroodstraling geheel tegen."
                            },
                            {
                                "example_id": "2193ac97-bd94-42c7-95ab-3ec3270ef9d8",
                                "sense_id": "4cdb4241-7a5c-3034-8509-16647779686f",
                                "text": "De Leidse radioastronoom George Miley heeft onlangs tientallen van deze stelsels bestudeerd op een golflengte van zes centimeter met de Very Large Array (mm) in New Mexico."
                            }
                        ]
                    }
