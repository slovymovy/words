                "senses": [
                    {
                        "sense_id": "7c9540a0-a642-3d3f-aea6-fc244167beae",
                        "entry_id": "542bd6c2-67de-38f4-9bcf-f39bf4f94acf",
                        "glosses": [
                            "nadworny lub wędrowny śpiewak w starożytnej Grecji, sławiący czyny bohaterów i bogów"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59c6979f-7999-4e4f-98ea-a2945a5fbd7c",
                                "sense_id": "7c9540a0-a642-3d3f-aea6-fc244167beae",
                                "text": "Aojdowie opiewali czyny bogów i herosów, akompaniując sobie na kitarze lub formindze."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5a7ffd5b-fa44-4cfa-bc12-15df94b78eff",
                        "source_entry_id": "542bd6c2-67de-38f4-9bcf-f39bf4f94acf",
                        "source_sense_id": "7c9540a0-a642-3d3f-aea6-fc244167beae",
                        "target_lang_word": "aède",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aède",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3e474d0c-b404-38d2-bf9b-99693acfae5f",
                                        "entry_id": "c8601b0c-af0c-31fb-a366-65fb8385e93d",
                                        "glosses": [
                                            "Poète de la Grèce antique qui chantait ses œuvres."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c4e54c3-4ac2-4547-befb-1ae827ef1bab",
                                                "sense_id": "3e474d0c-b404-38d2-bf9b-99693acfae5f",
                                                "text": "Au chant IX de l’Odyssée, Ulysse, fondant en larmes, avoue son nom. L’aède repose sa cithare et se tait. Désormais Ulysse prend la parole, parle à la première personne et raconte la suite de ses aventures […]"
                                            },
                                            {
                                                "example_id": "edb1a166-1689-4cd4-ae71-e28059c74452",
                                                "sense_id": "3e474d0c-b404-38d2-bf9b-99693acfae5f",
                                                "text": "Homère envisage donc ici une situation où le discours de l’aède était soumis à un « contrôle » social."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "19c152d1-876f-37ab-bf48-39b02bece0e0",
                                        "entry_id": "c8601b0c-af0c-31fb-a366-65fb8385e93d",
                                        "glosses": [
                                            "Poète."
                                        ],
                                        "tags": [
                                            "ironic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88c6d9ba-79be-4a84-99d0-838c21c70624",
                                                "sense_id": "19c152d1-876f-37ab-bf48-39b02bece0e0",
                                                "text": "N'importe quel clampin de bistrot, d’aède de comptoir a plus de talent et de sensibilité que ces bavasseurs glumeux, ces bouffons de l'art officiel, castrats du sérail de la bien-pensance, créatures de la gauche culturellement proprette."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ce88661-5829-38b9-9f9c-1a68b303f6ca",
                                        "entry_id": "c8601b0c-af0c-31fb-a366-65fb8385e93d",
                                        "glosses": [
                                            "Moustique du genre Aedes ^([1])."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
