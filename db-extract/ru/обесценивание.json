                    {
                        "translation_id": "54394884-7bda-4060-81e2-37d2c08ac3ee",
                        "source_entry_id": "d10f97ef-8080-34ea-9086-befc0ff44c16",
                        "target_lang_word": "Abwertung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abwertung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "176837b2-4c40-3768-ac9a-29e04ac8187e",
                                        "entry_id": "f0372139-490e-3e27-8e6a-30d7068aed81",
                                        "glosses": [
                                            "Verringerung des Wertes einer Währung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "510a7eef-c497-4add-ac27-e5236e4deab8",
                                                "sense_id": "176837b2-4c40-3768-ac9a-29e04ac8187e",
                                                "text": "Die folgende Abwertung bewirkte, daß die Währungen in der ganzen Region mit nach unten gezogen wurden."
                                            },
                                            {
                                                "example_id": "b5eba18b-0d2c-4137-8c3a-445a7ccb74af",
                                                "sense_id": "176837b2-4c40-3768-ac9a-29e04ac8187e",
                                                "text": "„Die ING Groep hat ihre Kursprognose zum zweiten Mal innerhalb weniger Tage gesenkt und geht von einem künftigen Kurs von 7 Yuan für den Dollar aus da die Zentralbank den Marktkräften erlaube, die Geschwindigkeit der Abwertung zu bestimmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1867910b-16ef-3379-8630-26b678afaf2f",
                                        "entry_id": "f0372139-490e-3e27-8e6a-30d7068aed81",
                                        "glosses": [
                                            "Absprechung von Wert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f43ef25b-1964-4259-8454-189ba9324fa8",
                                                "sense_id": "1867910b-16ef-3379-8630-26b678afaf2f",
                                                "text": "Glaubt man, solche gefunden zu haben, dann greifen die feinen Mechanismen von Ausgrenzung, Abwertung, Diffamierung wie eh und je, wenn auch heute wohl nicht mehr so stark mit existenzgefährdenden Folgen wie in der Adenauerzeit."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4141872d-14c3-4da6-a003-948f4043b8ba",
                        "source_entry_id": "d10f97ef-8080-34ea-9086-befc0ff44c16",
                        "target_lang_word": "Entwertung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Entwertung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c02bfdef-2aaf-38ef-9795-2390a2754f13",
                                        "entry_id": "1c75de72-f9c3-3087-bba4-ac0ce96e74df",
                                        "glosses": [
                                            "das Ungültigmachen, das Abstempeln (z. B. von Eintrittskarten, Fahrkarten, Briefmarken), um eine nochmalige Verwendung zu verhindern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c01e60c-57a4-48c5-a4b3-b3d3f9e254b5",
                                                "sense_id": "c02bfdef-2aaf-38ef-9795-2390a2754f13",
                                                "text": "„Wegen doppelter Entwertung wurde sie als Schwarzfahrerin angezeigt und sollte ein erhöhtes Beförderungsentgelt zahlen.“"
                                            },
                                            {
                                                "example_id": "e7f1a0db-67ae-4eda-8da6-3fb1818668c1",
                                                "sense_id": "c02bfdef-2aaf-38ef-9795-2390a2754f13",
                                                "text": "„Am 1. November 1849 gab es natürlich noch keine Stempel, die speziell zur Entwertung von Briefmarken gedient hätten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0efe5bd3-9e4e-36b2-9ee3-04eceb610d21",
                                        "entry_id": "1c75de72-f9c3-3087-bba4-ac0ce96e74df",
                                        "glosses": [
                                            "das Herabsetzen im Wert, der Verlust an Wert (insbesondere von Geld)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c397efaf-daf7-4ee3-85d6-a3b5057756fb",
                                                "sense_id": "0efe5bd3-9e4e-36b2-9ee3-04eceb610d21",
                                                "text": "„Schau nur, Leo wird nach Paris ziehen; bei der Entwertung der Krone könnten wir euch unmöglich mit Francs unterstützen und ihr würdet vielleicht ins Elend kommen, ohne daß Papa helfen kann.“"
                                            },
                                            {
                                                "example_id": "7c1e3156-03f0-44bb-a040-f5fc6597edfe",
                                                "sense_id": "0efe5bd3-9e4e-36b2-9ee3-04eceb610d21",
                                                "text": "„Wir erleben seit kurzem eine rasante Entwertung des Europa-Begriffs.“"
                                            },
                                            {
                                                "example_id": "0bd94adc-d25b-4558-9448-5db5492a8909",
                                                "sense_id": "0efe5bd3-9e4e-36b2-9ee3-04eceb610d21",
                                                "text": "„Im Sommer 1923 indes zerstörte die immer raschere Entwertung der Mark die Wirtschaft, es drohten Lebensmittelknappheit und Massenelend, und das Reich stand kurz vor der Auflösung.“"
                                            },
                                            {
                                                "example_id": "2e0a2c14-b431-40e5-af7c-95bc1ea6da08",
                                                "sense_id": "0efe5bd3-9e4e-36b2-9ee3-04eceb610d21",
                                                "text": "„Die Jugendlichen befürchteten kaum Beschäftigungsrisiken, erwarteten vielmehr ein Ansteigen der fachpraktischen und berufstheoretischen Qualifikationsanforderungen und hofften, daß technische Innovationen nicht zu einer Entwertung der Facharbeit führen würden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "be2f153d-ad12-49fc-9736-5ba628fcd790",
                        "source_entry_id": "d10f97ef-8080-34ea-9086-befc0ff44c16",
                        "target_lang_word": "dépréciation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dépréciation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2b52974c-0abd-3df8-97c2-4153edf54888",
                                        "entry_id": "df523250-2666-3a0f-8ed5-91d28d9b1358",
                                        "glosses": [
                                            "Action de déprécier ou état d’une chose dépréciée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e0bed43-f5cd-416f-9d5a-6e62577cdbad",
                                                "sense_id": "2b52974c-0abd-3df8-97c2-4153edf54888",
                                                "text": "Parmi les gouvernants d’aujourd'hui […], les uns pensent que la difficulté financières peuvent se résoudre très simplement par l’artifice de la dépréciation monétaire, par la dévalorisation des milliards, c’est à dire pour parler français, par le recours aux assignats, par une faillite plus ou moins habilement dissimulée."
                                            },
                                            {
                                                "example_id": "c5b10cc7-5c68-4d9f-a4d4-78ac0d263295",
                                                "sense_id": "2b52974c-0abd-3df8-97c2-4153edf54888",
                                                "text": "A mesure qu’augmentait les émissions de papier-monnaie, s’accentuait la dépréciation du mark, et de plus en plus les particuliers s’efforçaient, quand ils recevaient de billets, de les échanger aussitôt contre des marchandises."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66a826c8-16f6-3e01-a552-a1240c140347",
                                        "entry_id": "df523250-2666-3a0f-8ed5-91d28d9b1358",
                                        "glosses": [
                                            "Baisse de la valeur d’une monnaie par rapport aux autres devises sur le marché des changes."
                                        ],
                                        "tags": [
                                            "Économie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e66dd131-543f-49b0-85bf-bdc4ca82b8a5",
                                                "sense_id": "66a826c8-16f6-3e01-a552-a1240c140347",
                                                "text": "La dépréciation d’une monnaie peut être due à une augmentation du nombre de ses unités monétaires en circulation."
                                            },
                                            {
                                                "example_id": "71aad669-0de0-428d-ba0a-7323d07aa83b",
                                                "sense_id": "66a826c8-16f6-3e01-a552-a1240c140347",
                                                "text": "Cela a entraîné dans la foulée la dépréciation des monnaies de plusieurs ex-Républiques soviétiques, par exemple la Géorgie."
                                            }
                                        ]
                                    },
                                    {
