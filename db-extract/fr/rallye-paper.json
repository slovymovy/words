                        "cross_references": [
                            {
                                "target_word": "Schnitzeljagd",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a8d897fd-3bac-3001-aa8c-5a7320b5663c",
                                        "entry_id": "ef36cc28-45e6-3850-bcfa-fed2ee6f728d",
                                        "glosses": [
                                            "Spiel, bei dem die Mitspieler Hinweisen folgen oder Aufgaben lösen müssen, um eine Belohnung am Zielort zu finden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "261c9a34-a5eb-4282-a1c9-cac57c77178c",
                                                "sense_id": "a8d897fd-3bac-3001-aa8c-5a7320b5663c",
                                                "text": "„Ganz im Sinne einer klassischen Schnitzeljagd können die Teilnehmer durch das Auffinden von zehn Orten und der Beantwortung von Bonusfragen zum Thema Energie und Wien Punkte sammeln.“"
                                            },
                                            {
                                                "example_id": "f0de9c79-7f07-4a53-abce-1a138dbbe5bc",
                                                "sense_id": "a8d897fd-3bac-3001-aa8c-5a7320b5663c",
                                                "text": "„Am Muttertag schickten wir Mama noch vorm Frühstück auf Schnitzeljagd.“"
                                            }
                                        ],
