    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "59fb2472-9f75-310c-bfd2-8afd61309c36",
                "word": "chokehold",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "f608573b-6c53-4b66-9c80-6c53ffb4af7b",
                        "entry_id": "59fb2472-9f75-310c-bfd2-8afd61309c36",
                        "tags": [
                            "plural"
                        ],
                        "form": "chokeholds"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c6a3b0df-3bd1-39df-a3c4-66e235f488f3",
                        "entry_id": "59fb2472-9f75-310c-bfd2-8afd61309c36",
                        "glosses": [
                            "A grappling hold around a person's neck, especially one in which the neck is grasped tightly from behind with an arm, cutting off the flow of blood to the brain and restricting breathing."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02652496-da20-4b31-af41-63127d54cd87",
                                "sense_id": "c6a3b0df-3bd1-39df-a3c4-66e235f488f3",
                                "text": "He put his opponent in a chokehold."
                            },
                            {
                                "example_id": "d170881d-9d0c-4016-97dc-16ea1092dd6c",
                                "sense_id": "c6a3b0df-3bd1-39df-a3c4-66e235f488f3",
                                "text": "Within five to ten seconds, one officer began to apply a choke hold by pressing his forearm into [Adolph] Lyons' throat. As Lyons was struggling for air, the officer handcuffed him and continued to apply the choke hold until Lyons blacked out. He was almost choked to death. […] Between 1975 and 1982, sixteen people died from the LAPD [Los Angeles Police Department]'s use of choke holds."
                            },
                            {
                                "example_id": "f3928aeb-e673-43f3-9f0e-25f05aab9e14",
                                "sense_id": "c6a3b0df-3bd1-39df-a3c4-66e235f488f3",
                                "text": "In competition, judo matches typically have a standing phase (opponents attempt to throw each other) and a ground phase (once an opponent is on the ground, then both opponents can use a hold down, literally holding an opponent down for 15 to 25 seconds, or using a choke hold or similar controlling technique to force an opponent to submit)."
                            }
                        ]
                    },
                    {
                        "sense_id": "250ffcb5-58ae-3191-8599-3f9f1a4fbc97",
                        "entry_id": "59fb2472-9f75-310c-bfd2-8afd61309c36",
                        "glosses": [
                            "A powerful and restrictive control or influence over something."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "331d36d4-6e28-4240-b945-1da519eb51ae",
                                "sense_id": "250ffcb5-58ae-3191-8599-3f9f1a4fbc97",
                                "text": "One country has a chokehold on another country's economy."
                            },
                            {
                                "example_id": "fcf54867-c5a5-4f2c-91ed-06bc0f26f6c7",
                                "sense_id": "250ffcb5-58ae-3191-8599-3f9f1a4fbc97",
                                "text": "With the music industry releasing their chokehold on these television talent shows, it too is looking to other sources like social media – [Rob] Wade calls TikTok \"one giant talent show\" – to find new talent rather than primetime TV."
                            },
                            {
                                "example_id": "2b22180a-2d40-4c8d-a3e0-ffdb061e1bd5",
                                "sense_id": "250ffcb5-58ae-3191-8599-3f9f1a4fbc97",
                                "text": "Fellow fashionistas know the hype of GAP athleisure wear. The nostalgic look mixed with its soft design have the girlies in a chokehold!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "17f1da6e-182d-48da-a99c-e055840746c2",
                        "source_entry_id": "59fb2472-9f75-310c-bfd2-8afd61309c36",
