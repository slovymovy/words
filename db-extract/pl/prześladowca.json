                                        "sense_id": "072f32ff-9804-3382-b5e5-a9d7965bce28",
                                        "entry_id": "7974854a-5045-3ae9-927b-b14fba7bec0d",
                                        "glosses": [
                                            "Celui qui poursuit quelqu'un ou quelque chose, pour le rattraper, le saisir, l'appréhender, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11f2fc8b-4953-4710-b551-028666bd5f8a",
                                                "sense_id": "072f32ff-9804-3382-b5e5-a9d7965bce28",
                                                "text": "Suant et soufflant, pantalons et tuniques déchirés, mains écorchées, ses deux poursuivants arrivèrent enfin au hameau."
                                            },
                                            {
                                                "example_id": "8923778b-9d06-47f2-a1cd-88130825d8f9",
                                                "sense_id": "072f32ff-9804-3382-b5e5-a9d7965bce28",
                                                "text": "Je n'avais même plus peur de mon poursuivant : quoique je fusse à peu près sûr de ne pas l'avoir envoyé ad patres, il était peu probable qu'il se portât comme un charme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4b431e6-bb39-3e51-945a-851f13345d0a",
                                        "entry_id": "7974854a-5045-3ae9-927b-b14fba7bec0d",
                                        "glosses": [
                                            "Celui qui poursuit quelqu'un ou quelque chose, pour le rattraper, le saisir, l'appréhender, etc.",
                                            "Celui qui recherche avec ardeur quelque chose, qui brigue, qui manœuvre pour l’obtenir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "756ca285-1f5d-40fa-b933-45b74b005257",
                                                "sense_id": "b4b431e6-bb39-3e51-945a-851f13345d0a",
                                                "text": "Ils sont deux ou trois poursuivants qui demandent cette charge, cet emploi."
                                            },
                                            {
                                                "example_id": "796c2e9d-e44b-47cf-894e-1556d4346191",
                                                "sense_id": "b4b431e6-bb39-3e51-945a-851f13345d0a",
                                                "text": "Poursuivant d’armes,gentilhomme qui faisait un stage avant d’avoir une charge de héraut d’armes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4243cd17-2901-3e9a-b09a-50a614d3d21c",
                                        "entry_id": "7974854a-5045-3ae9-927b-b14fba7bec0d",
                                        "glosses": [
                                            "Celui qui poursuit quelqu'un ou quelque chose, pour le rattraper, le saisir, l'appréhender, etc.",
                                            "Celui qui recherche la main, les faveurs d’une femme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "547c6a1d-6979-4028-870a-1a2de71deda4",
                                                "sense_id": "4243cd17-2901-3e9a-b09a-50a614d3d21c",
                                                "text": "Cette veuve avait beaucoup de poursuivants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "625d40f7-2364-34d6-ae1d-ee7a4a0e6287",
                                        "entry_id": "7974854a-5045-3ae9-927b-b14fba7bec0d",
                                        "glosses": [
                                            "Personne qui poursuit en justice."
                                        ],
                                        "tags": [
                                            "Justice"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a062606b-8ac2-4eb3-8eb8-7370a2cd6cc6",
                                                "sense_id": "625d40f7-2364-34d6-ae1d-ee7a4a0e6287",
                                                "text": "Le poursuivant la vente sur folle enchère."
                                            },
                                            {
                                                "example_id": "8624bd71-8040-4c47-9083-acea6783aea9",
                                                "sense_id": "625d40f7-2364-34d6-ae1d-ee7a4a0e6287",
                                                "text": "À défaut par le poursuivant d’agir utilement le second saisissant peut se faire subroger dans la poursuite."
                                            }
                                        ]
                                    }
                                ]
                            }
