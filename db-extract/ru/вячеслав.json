                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Václav",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "2f52932f-fec7-325c-ab1b-91a66581ddc9",
                                        "entry_id": "232c918d-d8c2-3836-9059-7f274916a790",
                                        "glosses": [
                                            "české mužské křestní jméno"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35ada172-344e-42dc-927f-08819a0e03c1",
                                                "sense_id": "2f52932f-fec7-325c-ab1b-91a66581ddc9",
                                                "text": "Svatý Václave, vévodo české země, kníže náš, pros za nás Boha, svatého Ducha! Kriste, eleison. Ty jsi dědic české země, rozpomeň se na své plémě, nedej zahynouti nám ni budoucím, svatý Václave! Kriste, eleison"
                                            },
                                            {
                                                "example_id": "225f3dcf-14c7-4018-a106-308fcf0bb552",
                                                "sense_id": "2f52932f-fec7-325c-ab1b-91a66581ddc9",
                                                "text": "Nositelů jména Václav v současnosti spíše ubývá. Historickou shodou okolností (ale jistě i statisticko-demografickými faktory) se přihodilo, že první dva prezidenti novodobé České republiky, tak rozdílní v povaze a činech, oba shodně nesli jméno Václav."
                                            }
                                        ]
                                    }
                                ]
                            }
