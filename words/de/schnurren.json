    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6ff9af11-b805-391d-8ccc-0b2ef196320c",
                    "sense_definition": "einen leisen, vibrierenden Laut von sich geben, meist als Ausdruck des Wohlbehagens bei Katzen",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "lautaeusserung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wenn man die Katze am Kopf streichelt, fängt sie sofort an laut zu <w>schnurren</w>."
                        },
                        {
                            "text": "Der Kater lag eingerollt auf dem Sofa und <w>schnurrte</w> zufrieden vor sich hin."
                        }
                    ],
                    "common_phrases": [
                        "zufrieden schnurren",
                        "leise schnurren"
                    ]
                },
                {
                    "sense_id": "511a1502-9a3b-3daf-b6dd-993de6ad2756",
                    "sense_definition": "ein gleichmäßiges, leises und monotones Geräusch erzeugen, das ein reibungsloses Funktionieren anzeigt",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mechanisches_geraeusch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Motor des frisch gewarteten Wagens <w>schnurrt</w> wie ein Kätzchen."
                        },
                        {
                            "text": "Nachdem die Kette gründlich gereinigt wurde, <w>schnurrte</w> das Fahrrad wieder absolut lautlos."
                        }
                    ],
                    "synonyms": [
                        "surren",
                        "summen"
                    ],
                    "common_phrases": [
                        "wie ein Kätzchen schnurren"
                    ]
                },
                {
                    "sense_id": "1d27f24b-51c0-36c2-a1ff-89c9e6440074",
                    "sense_definition": "anhaltend über Belangloses reden oder schwatzen",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sprechen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die beiden Nachbarn standen am Gartenzaun und <w>schnurrten</w> eine halbe Stunde über das Wetter."
                        },
                        {
                            "text": "Hör endlich auf so viel zu <w>schnurren</w> und fang mit der Arbeit an!"
                        }
                    ],
                    "synonyms": [
                        "schwatzen",
                        "plaudern",
                        "quatschen"
                    ],
                    "antonyms": [
                        "schweigen"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "alemannisch"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5415961d-33fc-32e9-b72c-5912e232d535",
                    "sense_definition": "das leise, summende oder vibrierende Geräusch einer Katze oder Maschine",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "geraeusch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das beruhigende <w>Schnurren</w> der Katze half dem kranken Kind beim Einschlafen."
                        },
                        {
                            "text": "Aus der Werkstatt war nur das sanfte <w>Schnurren</w> der Nähmaschine zu hören."
                        }
                    ],
                    "synonyms": [
                        "Surren",
                        "Summen"
                    ],
                    "common_phrases": [
                        "beruhigendes Schnurren",
                        "das Schnurren der Katze"
                    ]
                }
            ]
        }
    ]
