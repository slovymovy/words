                "senses": [
                    {
                        "sense_id": "6e3ef194-69d7-3497-bfeb-c9e6e642fb07",
                        "entry_id": "a93de170-ad5d-3191-aa98-c7c995be00ee",
                        "glosses": [
                            "Empêcher de grincer."
                        ],
                        "tags": [
                            "Extrêmement rare"
                        ],
                        "examples": [
                            {
                                "example_id": "9db95916-15a2-4f73-8e13-5b8855abca3e",
                                "sense_id": "6e3ef194-69d7-3497-bfeb-c9e6e642fb07",
                                "text": "(...) la pointe feutre qui dégrince, détache, décoince."
                            }
                        ]
                    },
                    {
                        "sense_id": "5de96233-f23c-3dfa-bd33-17792647322c",
                        "entry_id": "a93de170-ad5d-3191-aa98-c7c995be00ee",
                        "glosses": [
                            "Desserrer (les dents), débloquer, etc."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "f4005f83-2070-4c77-8956-be4705509fb5",
                                "sense_id": "5de96233-f23c-3dfa-bd33-17792647322c",
                                "text": "Sollicité de répondre par le président, Foucault baissa la tête, enfonça autant que possible son visage sur sa poitrine, ne « dégrinça pas les dents » – comme on dit en Poitou – et singea ce « rire silencieux » qui, comme il n’avait justement pas envie de rire, se forma en sorte de grimace diabolique, à demi cachée."
                            },
                            {
                                "example_id": "b8d096ad-4d2d-4e13-bfbe-aa08fef7f709",
                                "sense_id": "5de96233-f23c-3dfa-bd33-17792647322c",
                                "text": "Rassure-toi, les cinq saisons sont vues, gringo. Je me refais le tout, parce que ça fait du bien au dedans de la tête et que ça dégrince la boîte à sourire."
                            }
                        ]
                    }
                ],
