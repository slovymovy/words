                                        "glosses": [
                                            "ou Qui survient à un moment avancé."
                                        ],
                                        "tags": [
                                            "poetic",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "120c5b91-e9ed-41dd-b9a4-13e7cf4c5c33",
                                                "sense_id": "2a1290e0-1a2e-3fc7-9f86-cca43e934cde",
                                                "text": "le gentil Auberon, par les tardes soirées,\nmène danser au bois les filles de Nérée."
                                            }
