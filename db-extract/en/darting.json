                                "sense_id": "bc8268f8-d25a-35fc-a01d-71f980770ccd",
                                "text": "Its flight is fairly swift, and at times very darting or jerky."
                            },
                            {
                                "example_id": "557fc496-c0e1-432d-9824-95dfa84592f2",
                                "sense_id": "bc8268f8-d25a-35fc-a01d-71f980770ccd",
                                "text": "Violent darting pains in the head preventing sleep."
                            },
                            {
                                "example_id": "5e38768f-e58d-42ab-aeb3-09844fb1c93a",
                                "sense_id": "bc8268f8-d25a-35fc-a01d-71f980770ccd",
                                "text": "Stella was very quick, very darting."
                            }
                        ]
                    }
