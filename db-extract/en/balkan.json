                    {
                        "translation_id": "6dacfe92-0630-472d-ae69-58877ab51fe2",
                        "source_entry_id": "2f28f61a-23f8-3bb5-9065-519a5cc54fa2",
                        "source_sense_description": "of or relating to the Balkan Peninsula",
                        "target_lang_word": "balkanique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "balkanique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a7b8b385-1571-3f86-8cbb-9ed663fea272",
                                        "entry_id": "7ec07f0b-35af-30f1-adac-0fb4ee0e65e0",
                                        "glosses": [
                                            "Relatif aux Balkans, à ses peuples."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ceb99259-619a-4573-bf3b-9a4db58f3b72",
                                                "sense_id": "a7b8b385-1571-3f86-8cbb-9ed663fea272",
                                                "text": "Les guerres balkaniques sont des conflits qui ont divisé les Balkans dans les années 1912 et 1913."
                                            },
                                            {
                                                "example_id": "fd04dd81-274f-432a-b16d-35b1d4b9e582",
                                                "sense_id": "a7b8b385-1571-3f86-8cbb-9ed663fea272",
                                                "text": "La Ligue balkanique est une alliance qui unit la Serbie, le Monténégro, la Grèce et la Bulgarie contre l'Empire ottoman pendant les guerres balkaniques."
                                            },
                                            {
                                                "example_id": "322aeac6-486e-4d61-9413-1570704db8ab",
                                                "sense_id": "a7b8b385-1571-3f86-8cbb-9ed663fea272",
                                                "text": "Dans les salles cinématographiques de Mars, après les massacres de Kitnicheff, les scènes de la guerre balkanique récoltaient le plus d'applaudissements. Tout le monde s'efforçait de découvrir la signification de ces charivaris effarants."
                                            },
                                            {
                                                "example_id": "dda73c03-6869-4b52-b5c6-c82010671757",
                                                "sense_id": "a7b8b385-1571-3f86-8cbb-9ed663fea272",
                                                "text": "Quelques délégués se succèdent à la tribune. Ce sont les plus tragiques: ceux qui représentent les prolétariats les plus ensanglantés par la lutte révolutionnaire et par la persécution: l'italien, le balkanique, et enfin le chinois."
                                            },
                                            {
                                                "example_id": "8e6503af-c9fa-4b68-9d52-eb6ae57f3302",
                                                "sense_id": "a7b8b385-1571-3f86-8cbb-9ed663fea272",
                                                "text": "Les pays danubiens et balkaniques souffrent, de plus en plus, des plaies de l'opération versaillaise, qui mutila les uns pour greffer les autres."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
