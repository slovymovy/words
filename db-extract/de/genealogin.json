                "senses": [
                    {
                        "sense_id": "ce266c20-4d86-3349-a0d2-401a065f5d89",
                        "entry_id": "c2a6bbf1-3ef5-325e-9dcb-2e9cc52e279d",
                        "glosses": [
                            "Wissenschaftlerin, die sich mit der Genealogie beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8083eb72-7b68-48b8-9f94-6fc1a69e9682",
                                "sense_id": "ce266c20-4d86-3349-a0d2-401a065f5d89",
                                "text": "„Die Genealogin hatte bereits im vergangenen Jahr enthüllt, dass der dunkelhäutige Senator aus Illinois irische Wurzeln hat – wie fast 34 Millionen US-Bürger, darunter die früheren US-Präsidenten John F. Kennedy und Ronald Reagan.“"
                            },
                            {
                                "example_id": "2eab4677-34ac-4779-ab16-84b4d76cfb34",
                                "sense_id": "ce266c20-4d86-3349-a0d2-401a065f5d89",
                                "text": "„Weil Paula und Jeff Schwierigkeiten hatten, ein Kind zu bekommen, hatten sie sich in Utah an ein Labor für künstliche Befruchtung gewandt. Dabei musste es eine Verwechslung gegeben haben. […] Um Klarheit zu schaffen, bittet die Mutter die Genealogin Cece Moore um Hilfe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
