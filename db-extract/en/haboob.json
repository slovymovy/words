                                    {
                                        "sense_id": "7dda2693-675b-3fe2-9f74-c83e9e8d3a5b",
                                        "entry_id": "80691b89-e79e-386e-90ab-9a9290900690",
                                        "glosses": [
                                            "Vent accompagné de tempêtes de sable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aff8e1a0-41cf-4a5c-a0e3-a2f0e06200fa",
                                                "sense_id": "7dda2693-675b-3fe2-9f74-c83e9e8d3a5b",
                                                "text": "Tout se passait parfaitement lorsque vers la fin de la journée, un vent de sable se leva. Il se transforma rapidement en un haboob impressionnant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
