                        "examples": []
                    },
                    {
                        "sense_id": "44ac4ece-03c1-375c-855f-5b06132b130a",
                        "entry_id": "b45a2948-70f1-33ec-b43a-19752eb85bda",
                        "glosses": [
                            "public square in Ukraine; maidan"
                        ],
                        "tags": [
                            "Ukraine"
                        ],
                        "examples": [
                            {
                                "example_id": "e76c0d2a-e8a3-4a2f-bc36-da1274cd314e",
                                "sense_id": "44ac4ece-03c1-375c-855f-5b06132b130a",
                                "text": "Майда́н Незале́жности",
                                "translation": "Maidan Nezalezhnosti/Independence Square (square in Kiev, Ukraine)",
                                "english": "Maidan Nezalezhnosti/Independence Square (square in Kiev, Ukraine)"
                            },
                            {
                                "example_id": "06942394-c2dc-4b58-a329-e33c568d39f4",
                                "sense_id": "44ac4ece-03c1-375c-855f-5b06132b130a",
                                "text": "И начнётся сму́та здесь, по сравне́нию с кото́рой майда́н пока́жется ра́йским са́дом.",
                                "translation": "And here troubles will begin that will make the Maidan look like a garden of Eden.",
                                "english": "And here troubles will begin that will make the Maidan look like a garden of Eden."
                            }
                        ]
                    },
                    {
                        "sense_id": "aac4a0ab-b928-369b-a73b-079062cea6d5",
                        "entry_id": "b45a2948-70f1-33ec-b43a-19752eb85bda",
                        "glosses": [
                            "a revolution, a rebellion, similar to the Ukrainian maidan movement."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "d44cb54a-f47e-4f4a-992c-a6c9446d7eea",
                                "sense_id": "aac4a0ab-b928-369b-a73b-079062cea6d5",
                                "text": "Улетают лепесточки вдаль на твой майдан\nПо Днепру цветёт герань (Цветёт герань)",
                                "translation": "Petals flying away into your Maidan—\ngeranium blooms along the Dnieper (Geranium blooms)",
                                "english": "Petals flying away into your Maidan—\ngeranium blooms along the Dnieper (Geranium blooms)"
                            }
                        ]
                    }
                ],
