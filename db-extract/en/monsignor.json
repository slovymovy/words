                "senses": [
                    {
                        "sense_id": "180720d5-4bb1-32eb-b4df-c1861088d9aa",
                        "entry_id": "203afd0b-4097-3acc-a58e-d1e106da01b4",
                        "glosses": [
                            "Alternative letter-case form of monsignor."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "7d6d860d-3965-401f-bc71-b9a80e93615b",
                                "sense_id": "180720d5-4bb1-32eb-b4df-c1861088d9aa",
                                "text": "Brother Matteo is a Capuchin, of course, so he eats pretty frugally: bread and water, vegetables and fruit, no meat, no cheese. And poor old Father Bechetti lost his appetite when he lost his teeth. So it’s really the three Monsignors who do the feasting."
                            },
                            {
                                "example_id": "516f2338-6f4f-4a41-b244-17f2635e1d6f",
                                "sense_id": "180720d5-4bb1-32eb-b4df-c1861088d9aa",
                                "text": "Unlike other previous Prelates, who were swiftly anointed bishops, Francis did not follow suit. Ocáriz remained a Monsignor. In the eyes of many observers, it was a demotion of Opus Dei."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "d862f971-42f3-3c2b-818a-95ae91e9d206",
                "word": "monsignor",
