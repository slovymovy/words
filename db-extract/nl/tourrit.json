                    {
                        "sense_id": "34061c88-aa0d-3927-9d64-327ab749311f",
                        "entry_id": "55965f7d-6fe7-3464-bf64-4c2a31534a36",
                        "glosses": [
                            "een etappe van de Tour de France"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d451536-b270-4799-9b91-e731a2a9087b",
                                "sense_id": "34061c88-aa0d-3927-9d64-327ab749311f",
                                "text": "Calmejane, afgelopen zomer winnaar van de Tourrit naar Rousses, ontsnapte in de slotfase uit een eerste groep en kreeg Jungels en Narvaez mee, van wie de Luxemburger Jungels enkele pogingen deed alleen weg te rijden. Calmejane bleef in zijn spoor en was de beste op de Côte de Livron."
                            },
                            {
                                "example_id": "72dd1b4f-1aab-4422-86f0-509a2169f601",
                                "sense_id": "34061c88-aa0d-3927-9d64-327ab749311f",
                                "text": "De joker: Romain Bardet: Mag hoop koesteren als hij vanmiddag over de benen beschikt waarmee hij afgelopen zomer de Tourrit naar Peyragudes won, maar moet het hoogstwaarschijnlijk in de sprint bergop op de Muur van Hoei afleggen."
                            }
                        ]
                    }
