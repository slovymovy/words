                                        "glosses": [
                                            "The Malay language, an Austronesian language spoken by most Malay people and by others where it is an official language, excluding the national standard known as Indonesian."
                                        ],
                                        "tags": [
                                            "strict-sense"
                                        ],
                                        "examples": [
