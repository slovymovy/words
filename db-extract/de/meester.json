                ],
                "senses": [
                    {
                        "sense_id": "ee09b90d-70fd-39cd-8735-2cf680c2a0b5",
                        "entry_id": "ca93205d-a7bc-367d-822e-f293fa372043",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3642c90-1a75-4372-a3ac-c5381eed927d",
                                "sense_id": "ee09b90d-70fd-39cd-8735-2cf680c2a0b5",
                                "text": "Frau Meester ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "677c4429-9a50-4438-b586-e0f07d2fee7c",
                                "sense_id": "ee09b90d-70fd-39cd-8735-2cf680c2a0b5",
                                "text": "Herr Meester wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "10311b48-1459-451c-a616-f5744cfb10a7",
                                "sense_id": "ee09b90d-70fd-39cd-8735-2cf680c2a0b5",
                                "text": "Die Meesters fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "f7854b30-2bf7-4899-bdbe-2dd024a25038",
                                "sense_id": "ee09b90d-70fd-39cd-8735-2cf680c2a0b5",
                                "text": "Der Meester trägt nie die Schals, die die Meester ihm strickt."
                            },
                            {
                                "example_id": "74e9c4c3-e4e7-4f75-8815-6c016b07b97b",
                                "sense_id": "ee09b90d-70fd-39cd-8735-2cf680c2a0b5",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Meester kommt, geht der Herr Meester.“"
                            },
                            {
                                "example_id": "48aef8a9-e7e7-4cff-a5f7-0988c22de588",
                                "sense_id": "ee09b90d-70fd-39cd-8735-2cf680c2a0b5",
                                "text": "Meester kommt und geht."
                            },
                            {
                                "example_id": "184f60f2-2d79-4061-b433-685ded3773bb",
                                "sense_id": "ee09b90d-70fd-39cd-8735-2cf680c2a0b5",
                                "text": "Meesters kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
