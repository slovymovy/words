                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ba4bfc8-49d1-4778-a242-144617b0ba78",
                                                "sense_id": "a5a27ad9-3d7e-3bb2-b48a-5817628077f4",
                                                "text": "The moment subcategories of the overall population are denied rights, the rights of all are threatened."
                                            },
