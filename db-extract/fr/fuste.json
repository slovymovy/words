                    },
                    {
                        "translation_id": "266a70de-1837-452a-b298-e94d628ded77",
                        "source_entry_id": "37717674-e275-3168-9728-4d9ff8a57495",
                        "source_sense_id": "47014925-bdf0-3caf-8291-5a52ae75b6c7",
                        "target_lang_word": "Blockhaus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Blockhaus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7de55179-fb7e-33c6-8319-300b5afdc2e8",
                                        "entry_id": "08ea894e-7e6d-312c-be67-661276c920e4",
                                        "glosses": [
                                            "ein Gebäude aus fast unbehauenen Baumstämmen oder Balken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a783f045-0663-47f3-ab2a-85b3e558426d",
                                                "sense_id": "7de55179-fb7e-33c6-8319-300b5afdc2e8",
                                                "text": "Blockhäuser sind umweltfreundlich und haben ein gutes Raumklima."
                                            },
                                            {
                                                "example_id": "8a1eddce-a555-40eb-bfa6-9264cd10aa04",
                                                "sense_id": "7de55179-fb7e-33c6-8319-300b5afdc2e8",
                                                "text": "„Hallows und Adams standen sich in der Mitte des Blockhauses gegenüber.“"
                                            },
                                            {
                                                "example_id": "715ea18c-5877-40b2-b746-e1c2ad228952",
                                                "sense_id": "7de55179-fb7e-33c6-8319-300b5afdc2e8",
                                                "text": "„Auf den weit verstreuten Lichtungen stehen kleine Höfe mit Blockhäusern.“"
                                            },
                                            {
                                                "example_id": "bad5a8bb-e914-4866-8d6e-46c518c7cf62",
                                                "sense_id": "7de55179-fb7e-33c6-8319-300b5afdc2e8",
                                                "text": "„Unsere Backbordkanonen wurden an Land gebracht und in einem Blockhaus untergestellt, während die Steuerbordkanonen auf ihren Lafetten stehen blieben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e23d4229-184d-4849-a9ff-3871771f4f03",
                        "source_entry_id": "37717674-e275-3168-9728-4d9ff8a57495",
                        "source_sense_id": "47014925-bdf0-3caf-8291-5a52ae75b6c7",
                        "target_lang_word": "Blockhütte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Blockhütte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dc251fc8-5a80-373d-a598-b970dcd94a83",
                                        "entry_id": "206bebae-da52-3cf7-8080-244a2e50cb9d",
                                        "glosses": [
                                            "ein aus runden Holzstämmen gebautes einfaches Haus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b447e3b7-2247-4b61-96bb-20bf7489d02e",
                                                "sense_id": "dc251fc8-5a80-373d-a598-b970dcd94a83",
                                                "text": "Der Fallensteller lebte in einer Blockhütte am Fluss."
                                            },
                                            {
                                                "example_id": "7f0bf2ef-9078-46d1-9fd1-bbdd60da099a",
                                                "sense_id": "dc251fc8-5a80-373d-a598-b970dcd94a83",
                                                "text": "„Die Frauen hatten sich mit den Kindern in die Blockhütten verkrochen.“"
                                            },
                                            {
                                                "example_id": "26f04cb0-88b3-4684-861a-dcea2462e9da",
                                                "sense_id": "dc251fc8-5a80-373d-a598-b970dcd94a83",
                                                "text": "„Eine Besonderheit der Region waren die mit Gras bewachsenen Dächer der ungestrichenen, fast schwarzen Blockhütten.“"
                                            },
                                            {
                                                "example_id": "f2ca9f10-e386-4c5e-8211-bafa66a0eb4c",
                                                "sense_id": "dc251fc8-5a80-373d-a598-b970dcd94a83",
                                                "text": "„Das Haus selbst war eine der im Westen von Amerika gebräuchlichen Blockhütten, aus rohen, unbehauenen Stämmen aufgeführt, deren Dach – grobgespaltene, kurze Bretter – durch schwere Stangen, sogenannte weight-poles, festgehalten wurde.“"
                                            },
                                            {
                                                "example_id": "1a80b6f8-4a2c-4fa9-b92c-8d8ecf01c96f",
                                                "sense_id": "dc251fc8-5a80-373d-a598-b970dcd94a83",
                                                "text": "„In Walden beschreibt Henry D. Thoreau sein Leben in einer Blockhütte, die er sich 1845 in den Wäldern von Concord (Massachusetts) am See Walden Pond auf einem Grundstück seines Freundes Ralph Waldo Emerson baute, um dort für mehr als zwei Jahre der industrialisierten Massengesellschaft der jungen USA den Rücken zu kehren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
