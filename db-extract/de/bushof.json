                        "source_sense_description": "Verkehrsanlage mit Bussteigen zur zentralen Verknüpfung mehrerer Buslinien",
                        "target_lang_word": "gare routière",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gare routière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5f1393e8-0a31-3142-b861-ffd6aade560d",
                                        "entry_id": "93d21070-df22-3e98-b115-9f43a3897343",
                                        "glosses": [
                                            "Lieu consacré, dans une ville, au stationnement des autocars effectuant des liaisons avec des localités éloignées, à leur départ et à leur arrivée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07e5413e-a162-430d-bfea-b8ed954de420",
                                                "sense_id": "5f1393e8-0a31-3142-b861-ffd6aade560d",
                                                "text": "Une gare routière est un aménagement équipé d’un bâtiment destiné à l’accueil des voyageurs."
                                            },
                                            {
                                                "example_id": "2a41566a-55f7-417b-b130-933bfec9e54d",
                                                "sense_id": "5f1393e8-0a31-3142-b861-ffd6aade560d",
                                                "text": "« une gare routière est un aménagement situé hors voirie et équipé d’un bâtiment d’accueil ouvert au public »"
                                            },
                                            {
                                                "example_id": "9b3ae8e1-c6b1-4ae0-b767-4572ae58a3f8",
                                                "sense_id": "5f1393e8-0a31-3142-b861-ffd6aade560d",
                                                "text": "Ainsi, en 2022, 71 % des voyageurs SLO ont été pris en charge ou déposés dans l’une des 76 gares routières (représentant 27 % des aménagements de transport routier de voyageurs), c’est-à-dire un aménagement équipé d’un bâtiment voyageurs"
                                            },
                                            {
                                                "example_id": "4c01345a-5185-46d4-bbe0-c383eb4ec991",
                                                "sense_id": "5f1393e8-0a31-3142-b861-ffd6aade560d",
                                                "text": "Six jours plus tard, un suspect est interpellé par les douanes à Marseille, à la gare routière Saint-Charles, alors qu'il se trouvait dans un autocar en provenance d'Amsterdam via Bruxelles."
                                            }
                                        ]
                                    }
