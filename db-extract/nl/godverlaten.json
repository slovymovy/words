        "nl-extract.jsonl": [
            {
                "entry_id": "8d6d64cb-ce46-3d6e-8014-e91d330eef3b",
                "word": "godverlaten",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "1bd05790-f097-492e-968b-58ea2f590821",
                        "entry_id": "8d6d64cb-ce46-3d6e-8014-e91d330eef3b",
                        "tags": [
                            "partitive",
                            "positive"
                        ],
                        "form": "godverlatens"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9c96c3d9-56d6-3372-ae9f-0b21b6db6744",
                        "entry_id": "8d6d64cb-ce46-3d6e-8014-e91d330eef3b",
                        "glosses": [
                            "heel erg vervelend, letterlijk: zelfs niet meer op de steun van god kunnen rekenen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33781a8b-5b00-4afe-83bf-1557f17bcf55",
                                "sense_id": "9c96c3d9-56d6-3372-ae9f-0b21b6db6744",
                                "text": "Erwin Kompanje, medisch filosoof en klinisch ethicus van het Erasmus Universitair Medisch Centrum, schrijft in zijn blog erwinkompanje.wordpress.com órgaandonatie is niet zo vanzelfsprekend als de mensen \"die het spel niet spelen\"(lees politici) veelal denken'. Hij noemt het leed van de betrokken families 'godverlaten intens'."
                            },
                            {
                                "example_id": "968f41d9-9bad-4b38-bf74-0882781916cd",
                                "sense_id": "9c96c3d9-56d6-3372-ae9f-0b21b6db6744",
                                "text": "Vanavond werd ik verplicht om naast graaf Bryston plaats te nemen, een pretentieuze blaaskaak die zeer weinig aan het hof is geweest. Hij is de bestuurder van een of ander godverlaten moerasland in het noorden en verkeert blijkbaar in de veronderstelling dat hij, vanwege de loyaliteit van zijn voorouders aan het koningshuis, over de koninklijke familie mag zeggen wat hij wil."
                            }
                        ]
                    },
                    {
                        "sense_id": "e839c3a3-87be-3433-ba6b-a2ae66b158eb",
                        "entry_id": "8d6d64cb-ce46-3d6e-8014-e91d330eef3b",
                        "glosses": [
                            "heel erg eenzaam en verlaten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "799c8960-19a4-4675-bc0c-5fa59ac00eb9",
                                "sense_id": "e839c3a3-87be-3433-ba6b-a2ae66b158eb",
                                "text": "Het is extra treurig dat het liefdeskoppel J. en R. uit A. midden in de nacht over een godverlaten brug liep: ook al zou je willen, 'aanstoot geven'is dan heel moeilijk. Het bendeclubje moet echt gezocht hebben voordat ze hun doelwit vonden. Een verwoede speurtocht naar verdwaalde homo's in de nacht."
                            },
                            {
                                "example_id": "8bf796b8-48df-41da-bc27-7cadde5516f7",
                                "sense_id": "e839c3a3-87be-3433-ba6b-a2ae66b158eb",
                                "text": "Ook in beeld weten de makers de sfeer van beklemming en afzondering mooi invoelbaar te maken. Blauwgrijs en uitgebeend oogt het eiland, een godverlaten plek aan het einde van de wereld."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "371376e5-57c5-4199-af72-79fc485b0a52",
                        "source_entry_id": "8d6d64cb-ce46-3d6e-8014-e91d330eef3b",
                        "source_sense_id": "9c96c3d9-56d6-3372-ae9f-0b21b6db6744",
                        "source_sense_description": "heel vreselijk",
                        "target_lang_word": "godforsaken",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "godforsaken",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d592f8b7-bc23-3270-be9b-228b06008549",
                                        "entry_id": "0f440d49-a21e-354f-a585-f4a6210855df",
                                        "glosses": [
                                            "Abandoned by a deity or god."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "de937397-761d-330c-85a0-d31c979ab72d",
                                        "entry_id": "0f440d49-a21e-354f-a585-f4a6210855df",
                                        "glosses": [
                                            "Desolate, boring and depressing."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ddee76d9-439d-4b33-9979-7b8c7d2edd03",
                                                "sense_id": "de937397-761d-330c-85a0-d31c979ab72d",
                                                "text": "I wanted nothing more than to get out of that godforsaken place without delay."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "00d4cab8-9054-49cb-9d86-2a585f479b4d",
                        "source_entry_id": "8d6d64cb-ce46-3d6e-8014-e91d330eef3b",
                        "source_sense_id": "9c96c3d9-56d6-3372-ae9f-0b21b6db6744",
                        "source_sense_description": "heel vreselijk",
                        "target_lang_word": "terrible",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "terrible",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b9813bd4-1aee-30fa-9cea-538f56912a73",
                                        "entry_id": "5a9f6e30-eeb4-3475-83e2-58ea091cade0",
                                        "glosses": [
                                            "Dreadful; causing terror, alarm and fear; awesome"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e9ddfbd-936d-4f9f-97bd-8a92962cf824",
                                                "sense_id": "b9813bd4-1aee-30fa-9cea-538f56912a73",
                                                "text": "The witch laid a terrible curse on him."
                                            },
                                            {
                                                "example_id": "dd5e5b80-a22e-499d-bd81-4c298afa98eb",
                                                "sense_id": "b9813bd4-1aee-30fa-9cea-538f56912a73",
                                                "text": "People who have not been in Narnia sometimes think that a thing cannot be good and terrible at the same time. If the children had ever thought so, they were cured of it now. For when they tried to look at Aslan's face they just caught a glimpse of the golden mane and the great, royal, solemn, overwhelming eyes; and then they found they couldn't look at him and went all trembly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf27e04d-891d-32b2-b137-bab7ac256abd",
                                        "entry_id": "5a9f6e30-eeb4-3475-83e2-58ea091cade0",
                                        "glosses": [
                                            "Formidable, powerful."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b2b55f5-8bd3-4fa0-9da9-d0eebd9f4a50",
                                                "sense_id": "bf27e04d-891d-32b2-b137-bab7ac256abd",
                                                "text": "[…]and there was even a party of the younger men who pretended to admire him, calling him a \"true sea-dog,\" and \"real old salt,\" and such-like names, and saying there was the sort of man that made England terrible at sea."
                                            },
                                            {
                                                "example_id": "17834657-fa09-480c-8be9-cab9a617a723",
                                                "sense_id": "bf27e04d-891d-32b2-b137-bab7ac256abd",
                                                "text": "\"He is the right sort of man for a labourer, but he is a terrible eater, to be sure,\" thought the farmer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2baff8e4-0a8a-371a-86d8-647d58b4daa8",
                                        "entry_id": "5a9f6e30-eeb4-3475-83e2-58ea091cade0",
                                        "glosses": [
                                            "Intense; extreme in degree or extent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff55d821-50f8-42b4-bc6a-699e3492d0b2",
                                                "sense_id": "2baff8e4-0a8a-371a-86d8-647d58b4daa8",
                                                "text": "He paid a terrible price for his life of drinking."
                                            },
                                            {
                                                "example_id": "3a4d8fb1-3d7b-4c0b-9cc7-d9bcdb581aa6",
                                                "sense_id": "2baff8e4-0a8a-371a-86d8-647d58b4daa8",
                                                "text": "‘Then the father has a great fight with his terrible conscience,’ said Munday with granite seriousness. ‘Should he make a row with the police […]? Or should he say nothing about it and condone brutality for fear of appearing in the newspapers?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e20683c-cbd8-37c1-8f7a-15fbd8f9ed4d",
                                        "entry_id": "5a9f6e30-eeb4-3475-83e2-58ea091cade0",
                                        "glosses": [
                                            "Unpleasant; disagreeable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6248057e-f052-4491-98da-8c5efeb0d1be",
                                                "sense_id": "8e20683c-cbd8-37c1-8f7a-15fbd8f9ed4d",
                                                "text": "The food was terrible, but it was free."
                                            },
                                            {
                                                "example_id": "080f9aec-06ba-4372-804d-0f3816816cfb",
                                                "sense_id": "8e20683c-cbd8-37c1-8f7a-15fbd8f9ed4d",
                                                "text": "To Edward […] he was terrible, nerve-inflaming, poisonously asphyxiating. He sat rocking himself in the late Mr. Churchill's swing chair, smoking and twaddling."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a5810f2-1ab0-3380-9e70-c6d2bd3199ae",
                                        "entry_id": "5a9f6e30-eeb4-3475-83e2-58ea091cade0",
                                        "glosses": [
                                            "Very bad; lousy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09d3b65c-f6b3-44f7-b56a-fe104be72849",
                                                "sense_id": "6a5810f2-1ab0-3380-9e70-c6d2bd3199ae",
                                                "text": "Whatever he thinks, he is a terrible driver."
                                            },
                                            {
                                                "example_id": "7e99991c-0d09-4f7b-b731-48ac8ef07222",
                                                "sense_id": "6a5810f2-1ab0-3380-9e70-c6d2bd3199ae",
                                                "text": "The openly ridiculous plot has The Pirate Captain (Hugh Grant) scheming to win the Pirate Of The Year competition, even though he’s a terrible pirate, far outclassed by rivals voiced by Jeremy Piven and Salma Hayek."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "terrible",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c9852e29-d53a-376e-82ca-78abb0e20d42",
                                        "entry_id": "fd9960b8-cf1b-33b4-839f-646da80d5f2c",
                                        "glosses": [
                                            "In a terrible way; to a terrible extent; terribly; awfully."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "dialectal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25c1de11-fdab-49e6-aab6-e8a56592cb5b",
                                                "sense_id": "c9852e29-d53a-376e-82ca-78abb0e20d42",
                                                "text": "‘Oh, terrible bad, sir, terrible deep the snow is,’ said the hedgehog."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4bbdbc67-9b73-421c-be6e-1ca275a58295",
                        "source_entry_id": "8d6d64cb-ce46-3d6e-8014-e91d330eef3b",
                        "source_sense_id": "9c96c3d9-56d6-3372-ae9f-0b21b6db6744",
                        "source_sense_description": "heel vreselijk",
                        "target_lang_word": "miserable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "miserable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4bcd85be-ea9e-3f0a-b92e-05b1db0ea516",
                                        "entry_id": "0df968f0-5a77-3a1a-a9b7-de8392a183d5",
                                        "glosses": [
                                            "In a state of misery: very sad, ill, or poor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53990d29-ae71-4eda-b209-6194bb8d985e",
                                                "sense_id": "4bcd85be-ea9e-3f0a-b92e-05b1db0ea516",
                                                "text": "Thanks to that penny he had just spent so recklessly [on a newspaper] he would pass a happy hour, taken, for once, out of his anxious, despondent, miserable self. It irritated him shrewdly to know that these moments of respite from carking care would not be shared with his poor wife, with careworn, troubled Ellen."
                                            },
                                            {
                                                "example_id": "a9986369-7811-4522-967c-e905eeab265c",
                                                "sense_id": "4bcd85be-ea9e-3f0a-b92e-05b1db0ea516",
                                                "text": "With some of it on the south and more of it on the north of the great main thoroughfare that connects Aldgate and the East India Docks, St. Bede's at this period of its history was perhaps the poorest and most miserable parish in the East End of London."
                                            },
                                            {
                                                "example_id": "a5a60591-aff7-4ec9-86a6-9c6a25c7e8a4",
                                                "sense_id": "4bcd85be-ea9e-3f0a-b92e-05b1db0ea516",
                                                "text": "The secret of being miserable is to have leisure to bother about whether you are happy or not. The cure for it is occupation, because occupation means pre-occupation"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5fd0d5eb-939f-3f1d-80e4-263e648ff757",
                                        "entry_id": "0df968f0-5a77-3a1a-a9b7-de8392a183d5",
                                        "glosses": [
                                            "Very bad (at something); unskilled, incompetent; hopeless."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d53c8f0-1cb8-40e8-a17d-b9395087e774",
                                                "sense_id": "5fd0d5eb-939f-3f1d-80e4-263e648ff757",
                                                "text": "He's good at some sports, like tennis, but he's just miserable at football."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "130f47aa-061a-31c7-a8d0-3a7303b900c8",
                                        "entry_id": "0df968f0-5a77-3a1a-a9b7-de8392a183d5",
                                        "glosses": [
                                            "Of the weather, extremely unpleasant due to being cold, wet, overcast, etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dbe2164c-5630-36b6-803c-61a08a1eb548",
                                        "entry_id": "0df968f0-5a77-3a1a-a9b7-de8392a183d5",
                                        "glosses": [
                                            "Wretched; worthless; mean; contemptible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bdd4424c-6ee2-417d-8b8d-3759dfaf197c",
                                                "sense_id": "dbe2164c-5630-36b6-803c-61a08a1eb548",
                                                "text": "a miserable sinner"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ce7245d-b858-366d-8dd6-c0822b2ee0b0",
                                        "entry_id": "0df968f0-5a77-3a1a-a9b7-de8392a183d5",
                                        "glosses": [
                                            "Causing unhappiness or misery."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3170302b-5b3e-4a4e-a652-031ecc8f19f8",
                                                "sense_id": "0ce7245d-b858-366d-8dd6-c0822b2ee0b0",
                                                "text": "For what's more miserable than discontent?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bfa0f050-02ab-3872-8fc5-83f15640ffcd",
                                        "entry_id": "0df968f0-5a77-3a1a-a9b7-de8392a183d5",
                                        "glosses": [
                                            "Avaricious; niggardly; miserly."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81b4725e-aa69-4d3a-8e9a-2db6d7ce4951",
                                                "sense_id": "bfa0f050-02ab-3872-8fc5-83f15640ffcd",
                                                "text": "the liberal-hearted man is by the opinion of the prodigal miserable, and by the judgment of the miserable lavish"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "miserable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "66f1d275-7b43-3fdf-9886-5174cac2f6f0",
                                        "entry_id": "6793997e-a9f1-3c2c-bd91-779650114fe1",
                                        "glosses": [
                                            "A miserable person; a wretch."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d9d5587-82a6-4518-adfc-4811586848c7",
                                                "sense_id": "66f1d275-7b43-3fdf-9886-5174cac2f6f0",
                                                "text": "Dona Carmen repaired to the balcony to chat and jest with, and at, these miserables, who stopped before the door to rest in their progress. All pretended poverty while literally groaning under the weight of their riches."
                                            },
                                            {
                                                "example_id": "c1ae1dfa-3cc0-412b-8f98-0b53f1a8b812",
                                                "sense_id": "66f1d275-7b43-3fdf-9886-5174cac2f6f0",
                                                "text": "The charge that those who played Jesus in these representations were treated badly by the plays' Jews and Romans left one commissioner cold: in his view, these miserables were beaten much less severely by the players than they were by their actual lords or curacas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "875bd803-04fd-3d30-83c4-dfa1f5dc1bf8",
                                        "entry_id": "6793997e-a9f1-3c2c-bd91-779650114fe1",
                                        "glosses": [
                                            "A state of misery or melancholy."
                                        ],
                                        "tags": [
                                            "in-plural",
                                            "informal",
                                            "with-definite-article"
                                        ],
                                        "examples": [
