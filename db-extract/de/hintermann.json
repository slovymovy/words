                "senses": [
                    {
                        "sense_id": "d1dee62f-7088-34af-b0f9-cf010fae99fc",
                        "entry_id": "6a902ced-8b53-33c0-ae71-b28a2fe15dea",
                        "glosses": [
                            "Person, die sich räumlich hinter jemand anderem befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd1926f0-337e-4920-9360-222a7f176c1a",
                                "sense_id": "d1dee62f-7088-34af-b0f9-cf010fae99fc",
                                "text": "Der Hintermann, der hinter dem Mittelfeldspieler steht, sollte auch überwunden werden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c9e626d0-24a6-3f65-9308-8afcb3d9c990",
                        "entry_id": "6a902ced-8b53-33c0-ae71-b28a2fe15dea",
                        "glosses": [
                            "Person, die heimlich an etwas beteiligt ist, deren Aktivität aber nicht bekannt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "167c4f8e-8649-47a7-b90b-de5739c8f1bf",
                                "sense_id": "c9e626d0-24a6-3f65-9308-8afcb3d9c990",
                                "text": "Einer der Hintermänner ist Peter Mustermann, dessen Aufgabe es war, die gegnerische Mannschaft zu beobachten."
                            },
                            {
                                "example_id": "968b9278-1edc-4fd4-a686-05301e705444",
                                "sense_id": "c9e626d0-24a6-3f65-9308-8afcb3d9c990",
                                "text": "Bei der Verbrechensbekämpfung besteht oft das große Problem, an die Hintermänner heranzukommen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ed66a857-ef1c-49af-9903-f2aa54f5ffa4",
