                    {
                        "sense_id": "708dd662-f514-34dc-96ea-364d787bdc66",
                        "entry_id": "ba50d498-c06a-350e-b0a7-45e3783fd4cf",
                        "glosses": [
                            "Qui a une seule superpuissance. En particulier, dominé par les États-Unis après la dissolution de l’URSS en 1991."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec562d9c-e417-45fc-9df8-456e8954a1d2",
                                "sense_id": "708dd662-f514-34dc-96ea-364d787bdc66",
                                "text": "Le paysage dévasté de l’Afghanistan formait le cimetière du communisme soviétique, le tremplin d’un monde unipolaire dominé par les Etats-Unis."
                            },
                            {
                                "example_id": "57cfe206-e9b4-4619-8c61-e218d8678d92",
                                "sense_id": "708dd662-f514-34dc-96ea-364d787bdc66",
                                "text": "Ces phénomènes sont amplifiés par le passage d’un monde unipolaire dirigé par les États-Unis à un système multipolaire d’où émergent plusieurs superpuissances."
                            }
                        ]
                    }
