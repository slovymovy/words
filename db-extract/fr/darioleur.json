                        "glosses": [
                            "Pâtissier qui fait la petite pâtisserie, dite dariole."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce98d669-5478-46ae-baf9-c519e217fa0f",
                                "sense_id": "ab787ae1-23b5-3037-b9b1-49e9bc56e95e",
                                "text": "Les pâtissiers darioleurs sont au nombre de 128 dans Paris ; mais leur fabrication est en général irrégulière. Les uns ne travaillent qu’une partie de l’année ; il y a même des darioleurs en chambre."
                            }
                        ]
