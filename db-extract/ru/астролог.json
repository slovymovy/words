                    },
                    {
                        "translation_id": "16404706-aa11-41e6-9503-927ae13efae9",
                        "source_entry_id": "4cf65437-218f-3fbd-8e5e-31e155859423",
                        "source_sense_id": "afd7048d-9492-39a4-914f-7c9bce1509a2",
                        "target_lang_word": "astrolog",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "astrolog",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "3dd242b7-239e-3dbc-bdcf-587e8854b4cc",
                                        "entry_id": "e2ad8e98-2a6a-38f2-8f64-9dd380b43e9a",
                                        "glosses": [
                                            "człowiek zajmujący się astrologią, przepowiadający przyszłość z położenia ciał niebieskich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92ba65c5-4700-457e-91a5-37af7d15c4f5",
                                                "sense_id": "3dd242b7-239e-3dbc-bdcf-587e8854b4cc",
                                                "text": "Astrolog przepowiada przyszłość z położenia planet, Słońca i Księżyca na tle zodiaku."
                                            },
                                            {
                                                "example_id": "9b0aff34-eed2-449e-8db3-09f980439c32",
                                                "sense_id": "3dd242b7-239e-3dbc-bdcf-587e8854b4cc",
                                                "text": "Jutro pójdę do astrologa."
                                            },
                                            {
                                                "example_id": "f0b1e5cf-6384-4785-ada0-2e0cb0ef6ab9",
                                                "sense_id": "3dd242b7-239e-3dbc-bdcf-587e8854b4cc",
                                                "text": "Pan Adam zna się na sprawach pozaziemskich, ponieważ jest astrologiem i numerologiem."
                                            },
                                            {
                                                "example_id": "412734e1-b283-40ac-9b4d-da52b7b4852a",
                                                "sense_id": "3dd242b7-239e-3dbc-bdcf-587e8854b4cc",
                                                "text": "Rysiek jest astrologiem z zawodu i z zamiłowania."
                                            },
                                            {
                                                "example_id": "9ebf7405-b616-4b99-8c8b-24a85b7fdeb2",
                                                "sense_id": "3dd242b7-239e-3dbc-bdcf-587e8854b4cc",
                                                "text": "Astrolodzy odczytują i interpretują losy człowieka lub społeczeństwa na podstawie położenia ciał niebieskich."
                                            },
                                            {
                                                "example_id": "60a9bb62-93d3-4765-82b9-fc6e926e7e27",
                                                "sense_id": "3dd242b7-239e-3dbc-bdcf-587e8854b4cc",
                                                "text": "[…] dzięki wykonywaniu wielu dokładnych obserwacji ciał niebieskich astrologowie starożytni i średniowieczni przyczynili się do rozwoju astronomii"
                                            },
                                            {
                                                "example_id": "b496a5d4-1505-4b63-9c22-90daddeb66a2",
                                                "sense_id": "3dd242b7-239e-3dbc-bdcf-587e8854b4cc",
                                                "text": "Nikt nie wie, ilu jest obecnie w Polsce praktykujących astrologów, tarocistów, chiromantów, wróżek i jasnowidzów"
                                            },
                                            {
                                                "example_id": "54e99f2e-36c6-4228-9f64-21181cfe8125",
                                                "sense_id": "3dd242b7-239e-3dbc-bdcf-587e8854b4cc",
                                                "text": "Jak to jest być astronomką. Śmieją się, kiedy ktoś myli je z astrologami i prosi, żeby postawiły horoskop"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5d59858e-2705-487b-a52b-7dd3e8f10eca",
                        "source_entry_id": "4cf65437-218f-3fbd-8e5e-31e155859423",
                        "source_sense_id": "afd7048d-9492-39a4-914f-7c9bce1509a2",
                        "target_lang_word": "astrologue",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "astrologue",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5ac95b03-c8ae-3292-8640-47fcc991a989",
                                        "entry_id": "3c914d73-a2c6-3944-8d6b-4233ea3da635",
                                        "glosses": [
                                            "Celui ou celle qui étudie l’astrologie ; celui ou celle qui en est spécialiste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0cd5658c-fdb8-4322-80b4-f9a42fa19e97",
                                                "sense_id": "5ac95b03-c8ae-3292-8640-47fcc991a989",
                                                "text": "Sang-diou ! baronne, dites à cette fille que je ferai sa fortune quand je serai roi de France, comme me le prédisent les astrologues."
                                            },
                                            {
                                                "example_id": "46546f1c-ac60-46db-a349-71985efb3c9d",
                                                "sense_id": "5ac95b03-c8ae-3292-8640-47fcc991a989",
                                                "text": "J’accepte, curieux de faire la connaissance de cet étrange visiteur, et ne tarde pas à apprendre qu’il a été, pendant de longues années, l’astronome-astrologue et l’alchimiste attitré de Mouley El-Hassan."
                                            },
                                            {
                                                "example_id": "0f396bd6-c235-4f86-b5d8-a36551283ccf",
                                                "sense_id": "5ac95b03-c8ae-3292-8640-47fcc991a989",
                                                "text": "Cette crise est arrivée au moment même où le monde se sentait de nouveau prospère et confiant, sans avoir été présagée par ces comètes en forme de flamme ou d’épée que savaient voir les astrologues."
                                            },
                                            {
                                                "example_id": "5483010b-0bf0-4d8b-a8e6-35de6ca49f21",
                                                "sense_id": "5ac95b03-c8ae-3292-8640-47fcc991a989",
                                                "text": "Certains chroniqueurs prétendent même qu’il aurait étendu cette mesure à tous les juifs de son royaume, à l’instigation de l’empereur d’Orient, Héraclius, qui lui aurait fait savoir qu’aux dires de ses astrologues l’empire chrétien était menacé par un peuple circoncis."
                                            },
                                            {
                                                "example_id": "5d8d9304-2cf5-4e6f-8490-38e74813fa70",
                                                "sense_id": "5ac95b03-c8ae-3292-8640-47fcc991a989",
                                                "text": "Les astrologues l’ont proclamé depuis l’aube des temps, et ils n’ont pas menti : quatre villes sont nées sous le signe de la révolte, Samarcande, La Mecque, Damas et Palerme ! Jamais elles n’ont été soumises à leurs gouvernants, si ce n’est par la force, jamais elles ne suivent le droit chemin, s’il n’est tracé par le glaive."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "40f6f3cb-06ee-41a9-8f91-a4c49d129e0d",
