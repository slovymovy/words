                    {
                        "sense_id": "cf7bfd35-f907-3d86-b791-81b44f6d9856",
                        "entry_id": "f9b47326-ddd6-3f40-863d-56dd7a19c094",
                        "glosses": [
                            "A vulture, Gyps fulvus; the griffin."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "0774884d-ae8f-4069-bfbe-b4fb5d992da5",
                                "sense_id": "cf7bfd35-f907-3d86-b791-81b44f6d9856",
                                "text": "One grype-ſchill, with a covering, gilt, […]"
                            },
                            {
                                "example_id": "902420e7-2b40-4432-a8de-2f7b55d01d4d",
                                "sense_id": "cf7bfd35-f907-3d86-b791-81b44f6d9856",
                                "text": "His faders deed bodye..he devyded to an hondred grypes lest he sholde ryde from dethe to lyfe."
                            },
                            {
                                "example_id": "8b952acd-596e-48ae-8321-daa1e89296c1",
                                "sense_id": "cf7bfd35-f907-3d86-b791-81b44f6d9856",
                                "text": "O my child, grypes make their nests of gold though their coates are feathers; […]"
                            },
                            {
                                "example_id": "e06c4519-b885-406c-a5ff-d6a532118542",
                                "sense_id": "cf7bfd35-f907-3d86-b791-81b44f6d9856",
                                "text": "Like a white Hinde vnder the grypes ſharpe clawes, […]"
                            },
                            {
                                "example_id": "79e399e3-d5d2-407d-8a8c-1539df21ba14",
                                "sense_id": "cf7bfd35-f907-3d86-b791-81b44f6d9856",
                                "text": "The vncleane eate not: to witte, the eagle, and the grype, and the oſprey, the ringtaile, and the vulture and kite according to their kinde: […]"
                            },
                            {
                                "example_id": "bd4f4104-dd2a-4acf-91ba-ff53c77042ad",
                                "sense_id": "cf7bfd35-f907-3d86-b791-81b44f6d9856",
                                "text": "I dreamed a grype and a grimlie beast / Had carryed my crowne away, / My gorgett and my kirtle of golde, / And all my faire heade-geere."
                            }
                        ]
                    }
                ],
