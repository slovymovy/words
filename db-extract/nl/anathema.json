                    {
                        "translation_id": "5eab4cce-3839-458d-b66a-d3bf9c615bbb",
                        "source_entry_id": "e6bf0649-3965-39eb-8116-3e328891701e",
                        "source_sense_id": "e2842c79-b5d4-307c-aec9-19f69238d064",
                        "target_lang_word": "anathema",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anathema",
