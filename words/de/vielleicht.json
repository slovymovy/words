                    "sense_id": "eccaeccb-9bbd-3763-99a4-12d70f25b412",
                    "sense_definition": "drückt eine Vermutung oder Möglichkeit aus; nicht mit Gewissheit",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "Möglichkeit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Vielleicht</w> scheint morgen endlich wieder die Sonne.",
                            "target_lang_translations": {
                                "en": "<w>Maybe</w> the sun will finally shine again tomorrow.",
                                "ru": "<w>Может быть</w>, завтра наконец снова выглянет солнце.",
                                "nl": "<w>Misschien</w> schijnt morgen eindelijk weer de zon.",
                                "pl": "<w>Może</w> jutro w końcu znowu zaświeci słońce.",
                                "fr": "<w>Peut-être</w> que le soleil brillera enfin à nouveau demain.",
                                "it": "<w>Forse</w> domani splenderà finalmente di nuovo il sole.",
                                "cs": "<w>Možná</w> bude zítra konečně zase svítit slunce.",
                                "tr": "<w>Belki</w> yarın nihayet yine güneş açar.",
                                "es": "<w>Quizás</w> mañana por fin vuelva a brillar el sol.",
                                "zh": "<w>也许</w>明天太阳终于会再次升起。"
                            }
                        },
                        {
                            "text": "Wir können uns <w>vielleicht</w> später im Café treffen.",
                            "target_lang_translations": {
                                "en": "We could <w>perhaps</w> meet at the café later.",
                                "ru": "Мы можем, <w>возможно</w>, встретиться позже в кафе.",
                                "nl": "We kunnen elkaar <w>misschien</w> later in het café ontmoeten.",
                                "pl": "Możemy spotkać się <w>może</w> później w kawiarni.",
                                "fr": "Nous pourrions <w>peut-être</w> nous retrouver plus tard au café.",
                                "it": "Possiamo <w>magari</w> vederci più tardi al bar.",
                                "cs": "Můžeme se <w>možná</w> sejít později v kavárně.",
                                "tr": "<w>Belki</w> daha sonra kafede buluşabiliriz.",
                                "es": "Podemos encontrarnos <w>tal vez</w> más tarde en la cafetería.",
                                "zh": "我们稍后<w>或许</w>可以在咖啡馆碰面。"
                            }
                        }
                    ],
