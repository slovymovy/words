{
    "word_family": [
        "habitual",
        "habituate",
        "habituation"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c9dee879-412a-331e-b4bd-39c237a41bc7",
                    "sense_definition": "An action performed on a regular basis.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "behavior_custom",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It has become a <w>habit</w> of mine to have a cup of coffee after dinner.",
                            "target_lang_translations": {
                                "ru": "У меня вошло в <w>привычку</w> выпивать чашку кофе после ужина.",
                                "tr": "Akşam yemeğinden sonra bir fincan kahve içmek benim için bir <w>alışkanlık</w> haline geldi.",
                                "zh": "晚饭后喝杯咖啡已经成了我的<w>习惯</w>。"
                            }
                        },
                        {
                            "text": "She has a bad <w>habit</w> of interrupting people when they speak.",
                            "target_lang_translations": {
                                "ru": "У нее есть дурная <w>привычка</w> перебивать людей, когда они говорят.",
                                "tr": "İnsanlar konuşurken laflarını kesmek gibi kötü bir <w>huyu</w> var.",
                                "zh": "她有个打断别人说话的坏<w>习惯</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "routine",
                        "practice"
                    ],
                    "common_phrases": [
                        "bad habit",
                        "good habit",
                        "make a habit",
                        "habit of"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие, выполняемое на регулярной основе.",
                        "tr": "Düzenli olarak yapılan eylem veya davranış.",
                        "zh": "指定期进行的某种行为或习惯。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "привычка",
                                "target_lang_sense_clarification": "обыденное действие"
                            },
                            {
                                "target_lang_word": "обыкновение",
                                "target_lang_sense_clarification": "установившийся порядок, манера"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "alışkanlık",
                                "target_lang_sense_clarification": "düzenli yapılan davranış"
                            },
                            {
                                "target_lang_word": "huy",
                                "target_lang_sense_clarification": "kişisel alışkanlık"
                            },
                            {
                                "target_lang_word": "adet",
                                "target_lang_sense_clarification": "gelenekselleşmiş davranış"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "习惯",
                                "target_lang_sense_clarification": "长期养成的行为方式"
                            },
                            {
                                "target_lang_word": "习性",
                                "target_lang_sense_clarification": "长期养成的生活习惯"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7b5c4ade-7396-36f2-88b0-83caa970ef8f",
                    "sense_definition": "An action performed repeatedly and automatically, usually without awareness.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "behavior_custom",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "By force of <w>habit</w>, he dressed for work even though it was a holiday.",
                            "target_lang_translations": {
                                "ru": "В силу <w>привычки</w> он оделся на работу, хотя был выходной.",
                                "tr": "<w>Alışkanlık</w> gereği, tatil günü olmasına rağmen işe gitmek üzere giyindi.",
                                "zh": "出于<w>习惯</w>，尽管是假日，他还是穿好了上班的衣服。"
                            }
                        },
                        {
                            "text": "I checked my phone out of <w>habit</w> as soon as I woke up.",
                            "target_lang_translations": {
                                "ru": "Я проверил телефон по <w>привычке</w>, как только проснулся.",
                                "tr": "Uyanır uyanmaz <w>alışkanlıktan</w> telefonumu kontrol ettim.",
                                "zh": "我一醒来就出于<w>习惯</w>看了看手机。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "force of habit",
                        "out of habit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие, выполняемое многократно и автоматически, обычно неосознанно.",
                        "tr": "Genellikle farkında olunmadan, sürekli ve otomatik olarak tekrarlanan eylem.",
                        "zh": "指反复且自动进行的行为，通常在无意识状态下发生。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "привычка",
                                "target_lang_sense_clarification": "автоматизм, рефлекс"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "alışkanlık",
                                "target_lang_sense_clarification": "otomatik refleks veya davranış"
                            },
                            {
                                "target_lang_word": "itiyat",
                                "target_lang_sense_clarification": "sürekli yapılan alışkanlık"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "习惯",
                                "target_lang_sense_clarification": "自动化的行为反应"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "41d50de8-d449-3981-bbb9-5cf518117669",
                    "sense_definition": "An addiction.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "behavior_custom",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has a ten-cigar <w>habit</w> that is affecting his health.",
                            "target_lang_translations": {
                                "ru": "У него пагубная <w>привычка</w> выкуривать десять сигар, что сказывается на его здоровье.",
                                "tr": "Günde on puro içme <w>bağımlılığı</w> var ve bu sağlığını olumsuz etkiliyor.",
                                "zh": "他有每天抽十支雪茄的<w>恶习</w>，这正在影响他的健康。"
                            }
                        },
                        {
                            "text": "It took him years to finally kick the <w>habit</w>.",
                            "target_lang_translations": {
                                "ru": "Ему потребовались годы, чтобы наконец бросить эту <w>привычку</w>.",
                                "tr": "Bu <w>alışkanlığı</w> sonunda bırakması yıllarını aldı.",
                                "zh": "他花了多年时间才最终戒掉了这个<w>恶习</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "kick the habit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Зависимость, пагубное пристрастие.",
                        "tr": "Bağımlılık, kötü alışkanlık.",
                        "zh": "指某种成瘾或不良嗜好。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зависимость",
                                "target_lang_sense_clarification": "болезненное пристрастие"
                            },
                            {
                                "target_lang_word": "привычка",
                                "target_lang_sense_clarification": "в контексте вредных привычек"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "bağımlılık",
                                "target_lang_sense_clarification": "kötü veya zararlı alışkanlık"
                            },
                            {
                                "target_lang_word": "alışkanlık",
                                "target_lang_sense_clarification": "kötü huy, düşkünlük"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "恶习",
                                "target_lang_sense_clarification": "坏习惯"
                            },
                            {
                                "target_lang_word": "瘾",
                                "target_lang_sense_clarification": "成瘾性行为"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0cd85d95-12d9-3a7d-8846-c99bf3e746ce",
                    "sense_definition": "A long piece of clothing worn by monks and nuns.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is interesting how Catholic and Buddhist monks both wear <w>habits</w>.",
                            "target_lang_translations": {
                                "ru": "Интересно, что и католические, и буддийские монахи носят <w>рясы</w>.",
                                "tr": "Hem Katolik hem de Budist rahiplerin <w>cübbe</w> giymesi ilgi çekici.",
                                "zh": "有趣的是，天主教修士和佛教僧侣都穿着<w>僧袍</w>。"
                            }
                        },
                        {
                            "text": "The nun wore a traditional grey <w>habit</w>.",
                            "target_lang_translations": {
                                "ru": "Монахиня была одета в традиционную серую <w>рясу</w>.",
                                "tr": "Rahibe geleneksel gri bir <w>cübbe</w> giymişti.",
                                "zh": "那位修女穿着一件传统的灰色<w>修女服</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "monk's habit",
                        "nun's habit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Длинная одежда, которую носят монахи и монахини.",
                        "tr": "Rahipler ve rahibeler tarafından giyilen uzun dini cübbe veya giysi.",
                        "zh": "僧侣或修女穿的长袍。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ряса",
                                "target_lang_sense_clarification": "одежда духовенства"
                            },
                            {
                                "target_lang_word": "одеяние",
                                "target_lang_sense_clarification": "монашеская одежда"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "cübbe",
                                "target_lang_sense_clarification": "din adamı giysisi"
                            },
                            {
                                "target_lang_word": "rahip elbisesi",
                                "target_lang_sense_clarification": "rahip veya rahibe giysisi"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "僧袍",
                                "target_lang_sense_clarification": "僧侣穿的衣服"
                            },
                            {
                                "target_lang_word": "修女服",
                                "target_lang_sense_clarification": "修女穿的制服"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "741f38d5-b904-355b-8f9c-250089814835",
                    "sense_definition": "A piece of clothing worn for a specific activity, such as horse riding.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new riding <w>habits</w> of the team looked smashing.",
                            "target_lang_translations": {
                                "ru": "Новые <w>костюмы для верховой езды</w> команды выглядели потрясающе.",
                                "tr": "Takımın yeni <w>binici kıyafetleri</w> harika görünüyordu.",
                                "zh": "团队新买的<w>骑装</w>看起来棒极了。"
                            }
                        },
                        {
                            "text": "She put on her riding <w>habit</w> before heading to the stables.",
                            "target_lang_translations": {
                                "ru": "Она надела свою <w>амазонку</w> перед тем, как отправиться в конюшню.",
                                "tr": "Ahlara gitmeden önce <w>binici kıyafetini</w> giydi.",
                                "zh": "她在去马厩前穿上了她的<w>骑装</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "riding habit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Одежда для определенного занятия, например, для верховой езды.",
                        "tr": "Binicilik gibi belirli bir etkinlik için giyilen özel giysi.",
                        "zh": "为特定活动（如骑马）所穿的服装。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "амазонка",
                                "target_lang_sense_clarification": "женский костюм для верховой езды"
                            },
                            {
                                "target_lang_word": "костюм",
                                "target_lang_sense_clarification": "специальная одежда"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "binici kıyafeti",
                                "target_lang_sense_clarification": "binicilik için özel giysi"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "骑装",
                                "target_lang_sense_clarification": "骑马时穿的服装"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "49440b5d-e802-3207-8855-b9092f30d0b3",
                    "sense_definition": "Form of growth or general appearance and structure of a plant or crystal.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This species of pine has a shrubby <w>habit</w>.",
                            "target_lang_translations": {
                                "ru": "У этого вида сосны кустарниковый <w>габитус</w>.",
                                "tr": "Bu çam türü çalımsı bir <w>büyüme biçimine</w> sahiptir.",
                                "zh": "这种松树具有灌木状的生长<w>习性</w>。"
                            }
                        },
                        {
                            "text": "The crystal displays a cubic <w>habit</w>.",
                            "target_lang_translations": {
                                "ru": "Кристалл имеет кубический <w>габитус</w>.",
                                "tr": "Kristal kübik bir <w>habitus</w> sergiler.",
                                "zh": "这种晶体呈现出立方体的<w>晶形</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Характер роста или общий вид и структура растения или кристалла.",
                        "tr": "Bir bitkinin veya kristalin büyüme biçimi, genel görünüşü ve yapısı.",
                        "zh": "植物的生长形态或晶体的结构外观。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "габитус",
                                "target_lang_sense_clarification": "научный термин"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "habitus",
                                "target_lang_sense_clarification": "biyoloji ve mineralojide genel görünüş"
                            },
                            {
                                "target_lang_word": "büyüme biçimi",
                                "target_lang_sense_clarification": "bitki veya kristal yapısı"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "习性",
                                "target_lang_sense_clarification": "生物生长形态"
                            },
                            {
                                "target_lang_word": "晶形",
                                "target_lang_sense_clarification": "矿物学中的晶体外观"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0ae4aa7d-a60f-3630-9111-434f0496e583",
                    "sense_definition": "Outward appearance; attire; dress.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was dressed in the <w>habit</w> of a gentleman.",
                            "target_lang_translations": {
                                "ru": "Он был одет в <w>одеяние</w> джентльмена.",
                                "tr": "Bir centilmenin <w>kılık kıyafetine</w> bürünmüştü.",
                                "zh": "他穿着绅士的<w>装束</w>。"
                            }
                        },
                        {
                            "text": "Costly thy <w>habit</w> as thy purse can buy.",
                            "target_lang_translations": {
                                "ru": "Богато <w>платье</w>, насколько позволяет кошелек.",
                                "tr": "<w>Kıyafetin</w> cüzdanının elverdiği kadar pahalı olsun.",
                                "zh": "你的<w>服饰</w>应如你的钱包所能负担的那样昂贵。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "refers to dress or attire"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Внешний вид; наряд; одеяние.",
                        "tr": "Dış görünüş; kılık kıyafet, giysi (eskimiş kullanım).",
                        "zh": "外表、装束或服饰（古语）。"
                    },
                    "translations": {
                        "ru": [
