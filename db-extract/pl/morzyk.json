                    {
                        "translation_id": "fb9aca49-b07e-4406-8807-66a6ccfe75a8",
                        "source_entry_id": "0e054dcf-8670-3010-aaac-848851b0a4c5",
                        "source_sense_id": "5d5e1257-88d2-3faa-9ecb-77dc972ecf96",
