{
    "word_family": [
        "diffuse",
        "diffusion",
        "diffusible",
        "diffusivity"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "dc08e517-75c1-37f6-908b-1677e3ff97ce",
                    "sense_definition": "Spread out over a large area or among a large number of people.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "spread",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>diffused</w> light made the room feel very soft and comfortable.",
                            "target_lang_translations": {
                                "ru": "<w>Рассеянный</w> свет делал комнату очень мягкой и уютной."
                            }
                        },
                        {
                            "text": "There is a <w>diffused</w> sense of anxiety throughout the entire community.",
                            "target_lang_translations": {
                                "ru": "Во всем обществе <w>распространено</w> чувство тревоги."
                            }
                        }
                    ],
                    "synonyms": [
                        "scattered",
                        "dispersed",
                        "spread"
                    ],
                    "antonyms": [
                        "concentrated",
                        "focused"
                    ],
                    "common_phrases": [
                        "diffused light"
                    ],
                    "target_lang_definitions": {
                        "ru": "Распространенный по большой площади или среди большого количества людей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рассеянный",
                                "target_lang_sense_clarification": "о свете или внимании"
                            },
                            {
                                "target_lang_word": "распространенный",
                                "target_lang_sense_clarification": "о чувствах или идеях"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b6eb9bc9-daf1-3484-8f60-aeb0d3f657e7",
                    "sense_definition": "Simple past and past participle of <w>diffuse</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "spread",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The perfume <w>diffused</w> through the air as soon as she opened the bottle.",
                            "target_lang_translations": {
                                "ru": "Духи <w>распространились</w> в воздухе, как только она открыла флакон."
                            }
                        },
                        {
                            "text": "The news had already <w>diffused</w> across the city by the next morning.",
                            "target_lang_translations": {
                                "ru": "К следующему утру новость уже <w>распространилась</w> по всему городу."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Past tense and past participle form of the verb diffuse."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола «распространять» или «рассеивать»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "распространился",
                                "target_lang_sense_clarification": "о запахе, новостях или явлении"
                            },
                            {
                                "target_lang_word": "рассеялся",
                                "target_lang_sense_clarification": "о свете, дыме или тумане"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}