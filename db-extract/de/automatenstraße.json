                        "glosses": [
                            "Kette von nebeneinanderliegenden Geräten (Automaten, Warenautomaten, Münzautomaten), aus denen man gegen Geld Ware (zum Verzehr) entnehmen kann"
                        ],
                        "tags": [],
                        "examples": [
