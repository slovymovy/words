                        "sense_id": "34ee6dea-1b8f-3547-9b30-4864263cd1f2",
                        "entry_id": "19b155b2-0309-3746-8924-cb28f1eed54a",
                        "glosses": [
                            "in der Art und Weise eines Normaltyps; einem bekannten Muster folgend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "efff2f62-70a7-4c6d-804d-3ddfce3df299",
                                "sense_id": "34ee6dea-1b8f-3547-9b30-4864263cd1f2",
                                "text": "Typischerweise kommt es bei Hämorrhoidalbeschwerden zu Juckreiz und Brennen im Analbereich."
                            },
                            {
                                "example_id": "d5c96d45-f28f-47c2-a462-3290a4f0cdfe",
                                "sense_id": "34ee6dea-1b8f-3547-9b30-4864263cd1f2",
                                "text": "Sie konnte es typischerweise wieder nicht lassen, vom Einkaufen mit einem neuen Paar Schuhe nach Hause zu kommen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
