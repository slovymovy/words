                                    {
                                        "sense_id": "56c8e173-70d7-3829-b331-4b0e7855342f",
                                        "entry_id": "1653432e-d96c-390e-a084-378d04065344",
                                        "glosses": [
                                            "Four times as great; quadruple."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4ac6fb80-46d8-32ab-a336-e1beead01e92",
                                        "entry_id": "1653432e-d96c-390e-a084-378d04065344",
                                        "glosses": [
                                            "Comprised of four individual members."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9dddb1e7-fd41-4b98-8716-887b79276d07",
                                                "sense_id": "4ac6fb80-46d8-32ab-a336-e1beead01e92",
                                                "text": "Most pupils have a fourfold object in studying a language; they wish to be able to read and write, to speak and to understand it."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fourfold",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3e62b434-7a14-3389-a3dc-1a1566d7695e",
                                        "entry_id": "89a9db4d-74be-3fac-a4cf-9df024fd675d",
                                        "glosses": [
                                            "By a factor of four."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da334c8e-e6f1-46e4-8ad4-14661c57f22a",
                                                "sense_id": "3e62b434-7a14-3389-a3dc-1a1566d7695e",
                                                "text": "And he shall restore the Lambe fourefold, because he did this thing, and because he had no pittie."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fourfold",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fc7d4600-aec9-3922-a603-4f3f77fda529",
                                        "entry_id": "2e386695-d032-3ce5-b65d-047598d1c33b",
                                        "glosses": [
                                            "To increase to four times as much; to multiply by four."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "fourfold",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c4a667c9-1abf-3d70-91ce-0bcece795e2b",
                                        "entry_id": "a68c3948-1000-3103-af5b-8bc900542125",
                                        "glosses": [
                                            "An algebraic variety of degree 4."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "179f81bf-11ea-4d02-a2a1-5f081427348d",
                                                "sense_id": "c4a667c9-1abf-3d70-91ce-0bcece795e2b",
                                                "text": "Our main application is to the classification of Poisson brackets on Fano fourfolds."
                                            }
