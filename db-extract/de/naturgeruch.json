                ],
                "senses": [
                    {
                        "sense_id": "a0709659-4351-3ccb-b808-0fbe29a6e692",
                        "entry_id": "62e29ea7-8250-3cc1-9c96-b604fa86f974",
                        "glosses": [
                            "geruchliche Wahrnehmung der belebten und unbelebten Natur"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4cf13d4-2b84-4b48-9657-737191f404a3",
                                "sense_id": "a0709659-4351-3ccb-b808-0fbe29a6e692",
                                "text": "„Wir bereuten, dass wir das Makroobjektiv zu Hause gelassen hatten und zogen tief den intensiven Naturgeruch in die Nase, der je nach vorherrschender Blumenart variierte.“"
                            },
                            {
                                "example_id": "79c56442-5628-4380-80f4-6628b2e33d66",
                                "sense_id": "a0709659-4351-3ccb-b808-0fbe29a6e692",
                                "text": "„Der schrille Ruf des Adlers wird eins mit trompetenden Elefanten und dem betörenden Naturgeruch der Wildnis.“"
                            },
                            {
                                "example_id": "cbbb0d2b-417e-4c0f-93ee-37c8f40656d2",
                                "sense_id": "a0709659-4351-3ccb-b808-0fbe29a6e692",
                                "text": "„An zweiter Stelle der positiven Naturgerüche stehen Blumen und Blüten.“"
                            },
                            {
                                "example_id": "94a065d3-ad90-4e07-9f43-af885bced7f4",
                                "sense_id": "a0709659-4351-3ccb-b808-0fbe29a6e692",
                                "text": "„Nun sind Düfte bekanntlich Geschmacksache, und nicht jeder mag den frisch herben Naturgeruch einer bestimmten Fußpflegecreme.“"
                            },
                            {
                                "example_id": "be3600a1-c9cd-4d1c-8103-d05f76f5f2ea",
                                "sense_id": "a0709659-4351-3ccb-b808-0fbe29a6e692",
                                "text": "Diese einzelnen Eindrücke wurden dann in die folgenden Geruchskomplexe klassifiziert: Auto- und Abgasgerüche, Naturgerüche, Frische, Kosmetik- und Hygienegerüche, Abfall- und Müllgerüche, Essens- und Gastronomiegerüche."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
