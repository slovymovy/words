                ],
                "senses": [
                    {
                        "sense_id": "585f1903-76e6-3ec0-861c-5c99536c693a",
                        "entry_id": "07e3cd66-cb7c-3f69-b6c7-989836c65414",
                        "glosses": [
                            "Person mit einem unansehnlichen Gesicht"
                        ],
                        "tags": [
                            "colloquial",
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "3d38b092-654a-40d5-9c1e-f0f7a7b6832d",
                                "sense_id": "585f1903-76e6-3ec0-861c-5c99536c693a",
                                "text": "„Am liebsten möchte man ihm jetzt sofort eine SMS schreiben mit dem Wortlaut: ‚Leg dich ins Bett, du Sackgesicht!‘ Aber das tut man schon deshalb nicht, weil man die Nummer des Herrn nicht besitzt.“"
                            },
                            {
                                "example_id": "277b382c-4a60-4352-bdee-c0a8adff4227",
                                "sense_id": "585f1903-76e6-3ec0-861c-5c99536c693a",
                                "text": "„Wir sind uns nicht sicher, wer in dieser Situation das größere Sackgesicht ist.“"
                            },
                            {
                                "example_id": "81c3bc61-48c6-4f0a-8a13-d75ec495eeb1",
                                "sense_id": "585f1903-76e6-3ec0-861c-5c99536c693a",
                                "text": "„Martys Vater George McFly ist der vertrottelte, biedere Nerd, der von einem Sackgesicht namens Biff herumgeschubst wird, 1985 wie 1955.“"
                            },
                            {
                                "example_id": "6022bc45-00ef-4cc4-8337-13124123e090",
                                "sense_id": "585f1903-76e6-3ec0-861c-5c99536c693a",
                                "text": "„»Sackgesicht«, hörte ich. Ich drehte mich um. Vor mir standen zwei Typen mit Bomberjacken und Springerstiefeln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
