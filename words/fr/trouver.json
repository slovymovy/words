            "senses": [
                {
                    "sense_id": "7b9bfad3-d765-3ac2-a586-61a2760de3e3",
                    "sense_definition": "Découvrir ou récupérer la personne ou la chose que l'on cherche.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "recherche",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai enfin réussi à <w>trouver</w> mes clés sous le canapé du salon."
                        },
                        {
                            "text": "Elle espère <w>trouver</w> un travail intéressant dès la fin de ses études."
                        }
                    ],
                    "synonyms": [
                        "découvrir",
                        "dénicher",
                        "dégoter"
                    ],
                    "antonyms": [
                        "perdre",
                        "égarer"
                    ],
                    "common_phrases": [
