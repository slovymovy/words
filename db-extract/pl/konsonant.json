                "translations": [
                    {
                        "translation_id": "086fa8bc-075e-4418-87f6-b3e0b7c202b5",
                        "source_entry_id": "aac0387d-89cc-35e1-8146-2a0cc8a81f15",
                        "source_sense_id": "25df9da1-3b13-3d2a-8032-b644981503d1",
                        "source_sense_description": "Linguistik: Konsonant, Mitlaut",
                        "target_lang_word": "Konsonant",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Konsonant",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "769c90a3-2e35-364d-bdca-13f3372fab65",
                                        "entry_id": "411a5ab1-3b09-3c9f-bcd8-f092d9623efb",
                                        "glosses": [
                                            "Laut der Sprache, der stärker moduliert ist als ein Vokal (mehr Geräusch als Ton); Laut, bei dessen Produktion die Artikulationsorgane einen Verschluss oder eine Verengung bilden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9bd7c2ab-79b0-4715-99cd-c2d90d01810a",
                                                "sense_id": "769c90a3-2e35-364d-bdca-13f3372fab65",
                                                "text": "Es gibt viel mehr Konsonanten als Vokale."
                                            },
                                            {
                                                "example_id": "1497e6c4-af2d-44d8-b863-8ee9afbef412",
                                                "sense_id": "769c90a3-2e35-364d-bdca-13f3372fab65",
                                                "text": "„Hinter diesem vielversprechenden Titel verbirgt sich allerdings weniger eine tiefgehende linguistische Analyse der Silbe in slawischen Sprachen, als vielmehr eine Analyse etymologischer Wörterbücher des Tschechischen und Slowakischen hinsichtlich der Häufigkeit von silbenbildenden Konsonanten in den westslawischen Sprachen.“"
                                            },
                                            {
                                                "example_id": "da9a084a-7092-401a-b1a1-f184210e27de",
                                                "sense_id": "769c90a3-2e35-364d-bdca-13f3372fab65",
                                                "text": "„Für manche Schauspieler scheint die deutsche Sprache ausschließlich aus Konsonanten zu bestehen.“"
                                            },
                                            {
                                                "example_id": "1d98fd06-31eb-4459-8abb-0c93ae57af91",
                                                "sense_id": "769c90a3-2e35-364d-bdca-13f3372fab65",
                                                "text": "„Nach Irwins (1947) Untersuchungen ist die Häufigkeit des Auftretens für Vokale in den ersten 30 Monaten größer als für Konsonanten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f82cdf30-1ee3-3593-b537-1ebf1a394e53",
                                        "entry_id": "411a5ab1-3b09-3c9f-bcd8-f092d9623efb",
                                        "glosses": [
                                            "Buchstabe, der für einen Konsonantlaut steht"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
