                    {
                        "form_id": "126f4736-5f22-4f25-b0f0-b0e5418e35e4",
                        "entry_id": "091bfc90-a69e-3c91-a9bb-5a09f7dc3a07",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Klumpfüße"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5faad552-4920-38f3-b722-3890f6cdaffa",
                        "entry_id": "091bfc90-a69e-3c91-a9bb-5a09f7dc3a07",
                        "glosses": [
                            "eine Fehlbildung des Fußes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9dc31c82-4b7e-4df7-a406-f351112efe84",
                                "sense_id": "5faad552-4920-38f3-b722-3890f6cdaffa",
                                "text": "„Hippolyte, der Hausknecht des Gasthofs, übernahm vom Kutscher die Zügel der Pferde und führte sie hinkend mit seinem Klumpfuß unter den Torbogen des „Goldenen Löwen“, wo sich viele Bauern ansammelten, um die Wagen zu betrachten.“"
                            },
                            {
                                "example_id": "63d2ff8d-b500-401f-9687-46088614a7bc",
                                "sense_id": "5faad552-4920-38f3-b722-3890f6cdaffa",
                                "text": "„Offenbar gibt es da, wie den bekannten Druckfehlerteufel, einen speziellen »Denkfehlerteufel«, über dessen Klumpfuß wir alle hin und wieder einmal stolpern.“"
                            },
                            {
                                "example_id": "f477ef26-8323-4ffe-ba50-27d026ce7ca1",
                                "sense_id": "5faad552-4920-38f3-b722-3890f6cdaffa",
                                "text": "„Selbst Byron mit seinem Klumpfußhätte nicht mehr Methoden sich zu strafen ersinnen können als der romantische Idiot, der ich geworden war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "69b09db9-026e-3ad8-8966-252dc96ec9f9",
                        "entry_id": "091bfc90-a69e-3c91-a9bb-5a09f7dc3a07",
                        "glosses": [
                            "Pilz aus der Untergattung der Schleimköpfe (Phlegmacium), der früher zu der ehemaligen Untergattung der Klumpfüße (Bulbopodium) gehörte"
                        ],
                        "tags": [
                            "Mykologie"
                        ],
                        "examples": [
                            {
                                "example_id": "dd3a1b95-1464-42e1-aca0-ab0dd195ed3a",
                                "sense_id": "69b09db9-026e-3ad8-8966-252dc96ec9f9",
                                "text": "Wichtigste makroskopische Merkmale sind bei den Schleimköpfen der trockene Stiel und die meist schleimige Hutoberfläche; die Klumpfüße besitzen am unteren Stielende zudem meist eine stark ausgeprägte, oftmals deutlich gerandete Knolle."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2a969cd4-6f6e-437e-a87d-5d4f362bd516",
                        "source_entry_id": "091bfc90-a69e-3c91-a9bb-5a09f7dc3a07",
                        "source_sense_id": "5faad552-4920-38f3-b722-3890f6cdaffa",
                        "source_sense_description": "Medizin: eine Fehlbildung des Fußes",
                        "target_lang_word": "clubfoot",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clubfoot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "df1d1a1a-50e0-397e-ba92-87e5ed433e69",
                                        "entry_id": "a41e37ba-f5d4-3efc-9e98-1a3b5b12bd4f",
                                        "glosses": [
                                            "A congenital deformity of the foot in which the ankle, heel and toes are twisted."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50955e3f-0a7c-4e5f-80f8-0b89ed22eb2e",
                                                "sense_id": "df1d1a1a-50e0-397e-ba92-87e5ed433e69",
                                                "text": "At his lower extremities, he exhibited the deformity which is popularly known as \"a club-foot.\" But he carried his lameness, as he carried his years, gayly."
                                            },
                                            {
                                                "example_id": "19de2211-363b-401b-b86d-b2a6c8dbdd06",
                                                "sense_id": "df1d1a1a-50e0-397e-ba92-87e5ed433e69",
                                                "text": "He stood still as much as he could, with his club-foot behind the other, so that it should not attract notice."
                                            },
                                            {
                                                "example_id": "ba012ca5-98c0-42e4-986f-1808645c5938",
                                                "sense_id": "df1d1a1a-50e0-397e-ba92-87e5ed433e69",
                                                "text": "The cure developed by Dr. Ponseti in the 1950s relies on physical manipulation. In each step of the treatment, a child’s clubfoot is stretched and turned slightly outward, and a hip-to-foot plaster cast, like the ones shown in the photograph, is then applied."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cc5f1f15-1ba4-4c39-b430-29c7a257c1c0",
                        "source_entry_id": "091bfc90-a69e-3c91-a9bb-5a09f7dc3a07",
                        "source_sense_id": "5faad552-4920-38f3-b722-3890f6cdaffa",
                        "source_sense_description": "Medizin: eine Fehlbildung des Fußes",
                        "target_lang_word": "talipes varus",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "53ae7d83-6950-444e-8282-dc4afe5847dc",
                        "source_entry_id": "091bfc90-a69e-3c91-a9bb-5a09f7dc3a07",
                        "source_sense_id": "5faad552-4920-38f3-b722-3890f6cdaffa",
                        "source_sense_description": "Medizin: eine Fehlbildung des Fußes",
                        "target_lang_word": "pied-bot",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pied-bot",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7eb9b208-f154-3677-b04a-f2b32a77a56c",
                                        "entry_id": "a5c659a0-e87c-3533-8c4c-8820e10dfead",
                                        "glosses": [
                                            "Personne ou animal ayant le pied bot."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f02a43a-7a43-4aa5-b2e6-3e26285243ca",
                                                "sense_id": "7eb9b208-f154-3677-b04a-f2b32a77a56c",
                                                "text": "De tous les pays circonvoisins, des campagnes et des villes, malades et infirmes, paralytiques, culs-de-jatte et pieds-bots accouraient dans des carrioles, dans des calèches, sur des ânes, sur leurs moignons calleux."
                                            },
                                            {
                                                "example_id": "d6b40c29-0aa6-4b27-abd0-2bc8507c5def",
                                                "sense_id": "7eb9b208-f154-3677-b04a-f2b32a77a56c",
                                                "text": "[…], et M. Lefèvre voulait toujours faire sa partie dans ces danses joyeuses et animées qui amusaient plus les danseuses que le public. Par malheur, M. Lefèvre était pied-bot, et sa présence dans la ronde retardait l'élan des jeunes filles, glaçait leur joie, et le plus souvent dérangeait la ronde."
                                            },
                                            {
                                                "example_id": "18d8a949-0cb4-4ff9-a3fb-c958cc46f624",
                                                "sense_id": "7eb9b208-f154-3677-b04a-f2b32a77a56c",
                                                "text": "– Tâche, pour aujourd’hui, de trouver mieux que d’essayer de m’apitoyer sur les déboires de ceux qui, étant pied-bot, choisissent le métier de coureur cycliste."
                                            },
                                            {
                                                "example_id": "5adba7e2-6ce6-45e8-a2a2-d5b0c684c6ed",
                                                "sense_id": "7eb9b208-f154-3677-b04a-f2b32a77a56c",
                                                "text": "Monsieur Charmeil était pied-bot. On lui prêtait mille aventures. À cinq heures moins dix il passait juste devant le bec de gaz. Sa réputation le précédait en faisant sonner les talons comme une escouade de licteurs, réunis autour d'un drapeau comme un piquet d'honneur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9fc0ae2d-13a7-4a99-bce0-24d1832af6d3",
                        "source_entry_id": "091bfc90-a69e-3c91-a9bb-5a09f7dc3a07",
                        "source_sense_id": "5faad552-4920-38f3-b722-3890f6cdaffa",
