                            {
                                "example_id": "6a05e500-a1b8-4f2b-9c5b-c2c06504d393",
                                "sense_id": "6f09ef65-49a8-3635-a2cf-74ad21493da0",
                                "text": "Яблоневый сад, весь в солнечных пятнах, спускался по склону холма."
                            },
                            {
                                "example_id": "b8ed2222-18bb-4346-9ec1-950db3aff7e7",
                                "sense_id": "6f09ef65-49a8-3635-a2cf-74ad21493da0",
                                "text": "Она стала трясти яблоневые ветки, и её обсыпало лепестками."
                            }
                        ]
                    },
