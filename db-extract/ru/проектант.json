                        "glosses": [
                            "специалист по разработке концепции и общему проектированию сложных изделий (самолёты, ракеты, космические корабли и другие нестандартные конструкции и системы с мультидисциплинарной оптимизацией), являющийся носителем концепции всего изделия или комплекса"
                        ],
                        "tags": [],
