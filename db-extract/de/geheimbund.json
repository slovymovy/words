                "senses": [
                    {
                        "sense_id": "85d744df-0b14-34a9-92c0-44c2973b73e2",
                        "entry_id": "b7845734-8160-3d70-b2ff-1011f6334dbd",
                        "glosses": [
                            "Organisation oder auch Vereinigung mit einem konspirativen Hintergrund"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9f7dfab-4a48-4f22-be0a-ec17b9c3fa8b",
                                "sense_id": "85d744df-0b14-34a9-92c0-44c2973b73e2",
                                "text": "Mein Bruder gehört einem Geheimbund an."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "33ba8b2d-0ed1-4618-8a2a-2fec834adb82",
                        "source_entry_id": "b7845734-8160-3d70-b2ff-1011f6334dbd",
                        "source_sense_id": "85d744df-0b14-34a9-92c0-44c2973b73e2",
                        "source_sense_description": "Organisation oder auch Vereinigung mit einem konspirativen Hintergrund",
                        "target_lang_word": "secret society",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "secret society",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0091dbaa-6eeb-307c-864d-a03638a514ca",
                                        "entry_id": "5b486631-0fc0-3292-925e-22b0ce164ac2",
                                        "glosses": [
                                            "A club, fraternal organization, or other association which admits only selected individuals as members, whose meetings and practices are often ritualistic and not public, and which often has the purpose of furthering the social or economic opportunities of its members."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2cf29e0-b34a-4ff9-9f34-36358846cbde",
                                                "sense_id": "0091dbaa-6eeb-307c-864d-a03638a514ca",
                                                "text": "Originally a secret society, B'nai B'rith came into the open in 1920 with publication of its ritual."
                                            },
                                            {
                                                "example_id": "dd411818-a2c2-4223-a488-37d9d7b079c0",
                                                "sense_id": "0091dbaa-6eeb-307c-864d-a03638a514ca",
                                                "text": "In the opening scenes of \"The Good Shepherd,\" the hero (played by Matt Damon) is initiated into Skull and Bones, Yale's iconic secret society, by lowering himself naked into a coffin to confess his deepest secrets."
                                            },
                                            {
                                                "example_id": "ca828ec9-107f-4d9e-91f2-f3de43b935c2",
                                                "sense_id": "0091dbaa-6eeb-307c-864d-a03638a514ca",
                                                "text": "Ben had much fun out of it, assuring the other boys that those were the signs and password of a secret society to which he and Sam belonged."
                                            },
                                            {
                                                "example_id": "739dd29c-4aed-4a5c-964c-bfa123f4ab76",
                                                "sense_id": "0091dbaa-6eeb-307c-864d-a03638a514ca",
                                                "text": "But these Brothers of Pity were a secret society, known to no man except their spiritual head, who chose them in turn, and not knowing even each other."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2048b43-861b-3ef0-889f-bfa7992773e9",
                                        "entry_id": "5b486631-0fc0-3292-925e-22b0ce164ac2",
                                        "glosses": [
                                            "A criminal gang."
                                        ],
                                        "tags": [
                                            "Singapore"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b4d9bfd-c0a1-43d7-96d6-0e054c7b1a94",
                                                "sense_id": "c2048b43-861b-3ef0-889f-bfa7992773e9",
                                                "text": "[…] obedience and loyalty were also 'important bywords' to the Ghee Hin, Ghee Hok and Ho Seng secret societies […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "87ee076c-9357-4445-8f95-c062a1382468",
                        "source_entry_id": "b7845734-8160-3d70-b2ff-1011f6334dbd",
                        "source_sense_id": "85d744df-0b14-34a9-92c0-44c2973b73e2",
                        "source_sense_description": "Organisation oder auch Vereinigung mit einem konspirativen Hintergrund",
                        "target_lang_word": "société secrète",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "société secrète",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4cf24195-2e51-3458-8e5b-a2deed2ce17b",
                                        "entry_id": "bb7f586a-1d1c-39ad-8fcf-604191e5831b",
                                        "glosses": [
                                            "Organisation sociale qui demande que ses membres gardent une partie de ses activités et de ses motivations loin des regards de personnes qui lui sont étrangères."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "684605e7-3e40-46f2-9eca-2629ab249599",
                                                "sense_id": "4cf24195-2e51-3458-8e5b-a2deed2ce17b",
                                                "text": "Il resituait l’idéologie de cette société secrète dans la mouvance plus générale du panslavisme et distinguait, dans la Confrérie, un mouvement prorusse et un mouvement pro-ukrainien."
                                            },
                                            {
                                                "example_id": "30ff39bf-a45e-4037-8024-1ca0c581e005",
                                                "sense_id": "4cf24195-2e51-3458-8e5b-a2deed2ce17b",
                                                "text": "L’affaire se présente dans des conditions d’autant plus favorables que la Société secrète du Lotus Bleu pousse à la suppression de la natte, emblème de l’asservissement des Chinois aux Tartares Mandchous."
                                            },
                                            {
                                                "example_id": "e787f154-de04-440e-ab9f-e54bd60d382c",
                                                "sense_id": "4cf24195-2e51-3458-8e5b-a2deed2ce17b",
                                                "text": "– On dirait qu’une société secrète les subtilise les uns après les autres, – opina Bert."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "220a3f4c-ee34-4543-951a-dc466021d3e1",
                        "source_entry_id": "b7845734-8160-3d70-b2ff-1011f6334dbd",
                        "source_sense_id": "85d744df-0b14-34a9-92c0-44c2973b73e2",
