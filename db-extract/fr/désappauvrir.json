                "senses": [
                    {
                        "sense_id": "b89874e3-0b24-3dcf-8bcd-8e66eaae551d",
                        "entry_id": "82f943a0-e44d-3275-bad5-53e967d174cd",
                        "glosses": [
                            "Sortir de la pauvreté."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "678f3308-9c1f-4dfa-b59f-83708f50c6cb",
                                "sense_id": "b89874e3-0b24-3dcf-8bcd-8e66eaae551d",
                                "text": "Pas besoin de désenrichir les riches, mais on peut désappauvrir les pauvres."
                            },
                            {
                                "example_id": "8ac105f0-6d59-4fdc-9486-5830f3446192",
                                "sense_id": "b89874e3-0b24-3dcf-8bcd-8e66eaae551d",
                                "text": "Les milliards d'Euros prêts à être engloutis dans le rachat de Capgemini, ne seraient-ils pas mieux utilisés à désappauvrir l'Inde et son bas peuple miséreux ?"
                            },
                            {
                                "example_id": "2afe47ba-48db-4ebc-961b-913fe5d4433e",
                                "sense_id": "b89874e3-0b24-3dcf-8bcd-8e66eaae551d",
                                "text": "LA MONDIALISATION SERAIT-ELLE LA RÉUSSITE POUR DÉSAPPAUVRIR CE CONTINENT QUI SEMBLE NATURELLEMENT PAUVRE?"
                            }
                        ]
                    }
