{
    "word_family": [
        "krijt",
        "streep",
        "krijten",
        "strepen",
        "krijtlijn"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8af6bf6f-b178-3435-922f-2f7b6ddcb200",
                    "sense_definition": "een textielpatroon bestaande uit dunne, parallel lopende lijnen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "textielpatroon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De advocaat droeg een donkerblauw pak met een subtiele <w>krijtstreep</w>.",
                            "target_lang_translations": {
                                "en": "The lawyer wore a dark blue suit with a subtle <w>pinstripe</w>."
                            }
                        },
                        {
                            "text": "Dit klassieke pak met <w>krijtstreep</w> is zeer geschikt voor formele zakelijke bijeenkomsten.",
                            "target_lang_translations": {
                                "en": "This classic <w>pinstripe</w> suit is very suitable for formal business meetings."
                            }
                        }
                    ],
                    "synonyms": [
                        "pinstripe"
                    ],
                    "common_phrases": [
                        "pak met krijtstreep",
                        "klassieke krijtstreep"
                    ],
                    "target_lang_definitions": {
                        "en": "a textile pattern consisting of thin, parallel lines"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pinstripe",
                                "target_lang_sense_clarification": "a very thin stripe on fabric"
                            },
                            {
                                "target_lang_word": "chalk stripe",
                                "target_lang_sense_clarification": "a slightly wider, softer stripe on fabric resembling a chalk line"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9569e926-7cbc-3fbd-9b01-ffabcea84550",
                    "sense_definition": "een lijn die getrokken is met een krijtje",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "markering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De politie zette een witte <w>krijtstreep</w> om het lichaam op de plaats van het delict.",
                            "target_lang_translations": {
                                "en": "The police drew a white <w>chalk line</w> around the body at the crime scene."
                            }
                        },
                        {
                            "text": "Hij zette voor iedere honderd getelde gevangenen een <w>krijtstreep</w> op de houten poort.",
                            "target_lang_translations": {
                                "en": "He made a <w>chalk mark</w> on the wooden gate for every hundred prisoners counted."
                            }
                        }
                    ],
                    "synonyms": [
                        "krijtlijn"
                    ],
                    "common_phrases": [
                        "witte krijtstreep",
                        "krijtstreep zetten"
                    ],
                    "target_lang_definitions": {
                        "en": "a line drawn with a piece of chalk"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "chalk line",
                                "target_lang_sense_clarification": "a line made on a surface with chalk"
                            },
                            {
                                "target_lang_word": "chalk mark",
                                "target_lang_sense_clarification": "a mark or stroke made with chalk"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}