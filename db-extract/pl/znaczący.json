                        "sense_id": "2c6c58f8-b4a9-3ad0-ac31-3608b3597886",
                        "entry_id": "ae08f976-d6c1-3511-a6b2-f41b13d00864",
                        "glosses": [
                            "wymowny, świadczący o czymś, mający ukryte znaczenie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7dc9da1-f835-4de9-be95-e0af4b1e4c3e",
                                "sense_id": "2c6c58f8-b4a9-3ad0-ac31-3608b3597886",
                                "text": "Po chwili na milicyjnej twarzy pojawił się znaczący uśmiech, a zaraz potem dłoń powędrowała w górę i ustawiła na blacie pełną butelkę grodziskiego"
                            }
