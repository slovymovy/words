                    {
                        "sense_id": "375a9cb1-195a-3508-848f-b4bda627e9d6",
                        "entry_id": "9e19abb2-1b81-382d-b34f-b2dc70985b11",
                        "glosses": [
                            "Membre d’un peuple de la Sicile, que les poëtes anciens nous ont représenté comme anthropophage."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "85c5c391-278a-4e8c-9c1b-1ea471d29581",
                                "sense_id": "375a9cb1-195a-3508-848f-b4bda627e9d6",
                                "text": "Cette étoile aux rayons bénins est une chandelle ou une lampe placée derrière une vitre ; ce qui suppose une chambre bien close et bien chaude faisant partie d’une maison habitée par des êtres humains et civilisés plutôt que par des Lestrygons sauvages."
                            }
                        ]
                    },
                    {
                        "sense_id": "416dd7ef-ac7b-35be-a953-fc98ad55bb13",
                        "entry_id": "9e19abb2-1b81-382d-b34f-b2dc70985b11",
                        "glosses": [
                            "Barbare."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c62d2b53-b70e-4b4c-9617-f90cd3a0c822",
                                "sense_id": "416dd7ef-ac7b-35be-a953-fc98ad55bb13",
                                "text": "Crocodile trompeur, de qui le cœur félon\nEst pire qu'un satrape ou bien qu'un Lestrygon."
                            }
                        ]
                    }
                ],
