            {
                "entry_id": "2d59a87d-4a6b-354a-ab3e-060db27fe175",
                "word": "kitsch",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ff52cb36-74ea-390b-a343-87bff696d0a5",
                        "entry_id": "2d59a87d-4a6b-354a-ab3e-060db27fe175",
                        "glosses": [
                            "schijnkunst die niet aanslaat met veel versieringen en/of de verkeerde materialen waarvan de meeste mensen denken dat het wansmaak is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d0a1063-0e7f-416a-afa7-883a28518ffd",
                                "sense_id": "ff52cb36-74ea-390b-a343-87bff696d0a5",
                                "text": "Wat een kitsch is dat, zeg!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "98369727-bc70-4b4c-9e57-8e6afb0352f0",
                        "source_entry_id": "2d59a87d-4a6b-354a-ab3e-060db27fe175",
                        "source_sense_id": "ff52cb36-74ea-390b-a343-87bff696d0a5",
                        "source_sense_description": "schijnkunst die niet aanslaat met veel versieringen en/of de verkeerde materialen waarvan de meeste mensen denken dat het wansmaak is",
                        "target_lang_word": "Kitsch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kitsch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "55840da6-1104-3085-8203-e9e9581a177c",
                                        "entry_id": "18dce870-9e08-3678-b20f-8430904c92ca",
                                        "glosses": [
                                            "Objekt der Kunst, Musik oder Literatur, welches als klischeehaft und geschmacklos angesehen wird und keinen künstlerischen Wert hat"
                                        ],
                                        "tags": [
                                            "meist abwertend"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e1fcf1e-807f-4016-9149-d8a2e485a148",
                                                "sense_id": "55840da6-1104-3085-8203-e9e9581a177c",
                                                "text": "Bei dem Film hat der Regisseur keine Angst vor großer Emotion und vor einem Pathos, das vom Absturz in den bodenlosen Kitsch nur eine Handbreit entfernt ist."
                                            },
                                            {
                                                "example_id": "28dbda91-d4a8-4811-ab83-b39b9b45928e",
                                                "sense_id": "55840da6-1104-3085-8203-e9e9581a177c",
                                                "text": "„Der Begriff scheint Ende des vergangenen Jahrhunderts erstmals im Münchener Kunsthandel aufgetaucht und schon von Anfang an pejorativ im Gegensatz zur echten Kunst verwandt worden zu sein. Kitsch als Antipode der Kunst, als mißratener Nachkömmling, der aber dennoch glänzend zu verkaufen war. Kitsch transportiert Gefühle, er ist deshalb nicht formaläst[h]etisch zu beschreiben, sondern bestimmt sich vom Betrachter bzw. Benutzer her.“"
                                            },
                                            {
                                                "example_id": "eb47bb45-b60c-4eea-8191-59da81fef1fb",
                                                "sense_id": "55840da6-1104-3085-8203-e9e9581a177c",
                                                "text": "„Er wollte seinen Lesern einen Traum geben, in den sie sich flüchten konnten, was im Grunde schon wieder zu aufrichtig ist, um als Kitsch abgestempelt zu werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "47d0ec3c-d2f9-45ed-964c-edf62ebcbd4b",
                        "source_entry_id": "2d59a87d-4a6b-354a-ab3e-060db27fe175",
                        "source_sense_id": "ff52cb36-74ea-390b-a343-87bff696d0a5",
                        "source_sense_description": "schijnkunst die niet aanslaat met veel versieringen en/of de verkeerde materialen waarvan de meeste mensen denken dat het wansmaak is",
                        "target_lang_word": "kitsch",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kitsch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6cc0b34c-30fa-3d87-b1a7-236be9c042bb",
                                        "entry_id": "0597c785-09d6-3c4d-9456-9a34a6e9965c",
                                        "glosses": [
                                            "Art, decorative objects, and other forms of representation of questionable artistic or aesthetic value; a representation that is excessively sentimental, overdone, or vulgar."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ccbada1a-44bb-423a-83d5-1712a2d4b96e",
                                                "sense_id": "6cc0b34c-30fa-3d87-b1a7-236be9c042bb",
                                                "text": "Because it can be turned out mechanically, kitsch has become an integral part of our productive system in a way in which true culture could never be, except accidentally."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "kitsch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "31426957-2337-368e-923c-86116c988b29",
                                        "entry_id": "abd699ba-031c-35e1-867f-9f08a5953fdb",
                                        "glosses": [
                                            "Of art and decor: of questionable aesthetic value; excessively sentimental, overdone or vulgar."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d58a520c-3c5e-494e-b358-931fa4db4da5",
                                                "sense_id": "31426957-2337-368e-923c-86116c988b29",
                                                "text": "[…] a picture of lemur-eyed children of the sort one sees in the kitscher sort of Italian restaurant […]"
                                            },
                                            {
                                                "example_id": "60ea3aed-80d2-46f7-b486-bfe7a7ea4479",
                                                "sense_id": "31426957-2337-368e-923c-86116c988b29",
                                                "text": "Abe Lincoln, Paul Bunyan and kitsch souvenir coconut heads come across as icons of masculinity."
                                            },
                                            {
                                                "example_id": "9563318e-2e87-46d5-8a52-eaceb5d410d8",
                                                "sense_id": "31426957-2337-368e-923c-86116c988b29",
                                                "text": "I recognized her at once even though she wasn't wearing the tweed hunting outfit and the kitsch headwear."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8ecea68d-bdd7-4eb7-a212-5a16c302e450",
                        "source_entry_id": "2d59a87d-4a6b-354a-ab3e-060db27fe175",
                        "source_sense_id": "ff52cb36-74ea-390b-a343-87bff696d0a5",
                        "source_sense_description": "schijnkunst die niet aanslaat met veel versieringen en/of de verkeerde materialen waarvan de meeste mensen denken dat het wansmaak is",
                        "target_lang_word": "kitsch",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kitsch",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "121639d5-b17a-3053-a45b-6533f8b487e3",
                                        "entry_id": "aadbe94e-5c7e-3038-ad86-33dd4b180d80",
                                        "glosses": [
                                            "De mauvais goût, surchargé."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b114933-24b4-4cc2-be61-7181eedcf695",
                                                "sense_id": "121639d5-b17a-3053-a45b-6533f8b487e3",
                                                "text": "Après avoir loué les subtils détournements de Duchamp et Warhol opérés dans The Early (1979), The New (1980) ou Banality (1988), la plupart des critiques ont fait chorus pour dénoncer l'œuvre kitsch, publicitairement et prostitutionnellement middle class, l'idéal puritain ou « téflon » du corps slick, de la peau sans pore, de la sexualité sans sécrétion de Made in Heaven."
                                            },
                                            {
                                                "example_id": "184ec9d5-e1a1-4b58-ad2b-a3c6627ae6a0",
                                                "sense_id": "121639d5-b17a-3053-a45b-6533f8b487e3",
                                                "text": "C'est une installation bien kitsch désormais : il y a une fontaine, un alignement de jets d'eau qui pulsent autour d'un petit bassin en béton. Deux bancs et une plate-bande de fleurs complètent le tableau."
                                            },
                                            {
                                                "example_id": "2be07b4f-9bf2-41ae-b275-e2918e759306",
                                                "sense_id": "121639d5-b17a-3053-a45b-6533f8b487e3",
                                                "text": "Le soir, des DJettes s’installent aux platines à l’arrière d’une caravane ramenée on ne sait comment jusqu’ici, dans son décor kitsch pétillant et coloré : un baby-foot, des strings qui sèchent au-dessus du comptoir."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "kitsch",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8ce3475f-7ec2-384b-b54a-3f888cd32b12",
                                        "entry_id": "c9bb98df-5d5e-368f-a6bf-b993e46d9443",
                                        "glosses": [
                                            "Mauvais goût, toc, imitation surchargée."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f571c0e-3a70-430d-a83a-cef4c34a8b8b",
                                                "sense_id": "8ce3475f-7ec2-384b-b54a-3f888cd32b12",
                                                "text": "La première phase du kitsch est amenée, au milieu du XIXe siècle, par l'industrialisation et l'urbanisation."
                                            },
                                            {
                                                "example_id": "200f874e-9d44-48a5-82c6-48284f91ccb6",
                                                "sense_id": "8ce3475f-7ec2-384b-b54a-3f888cd32b12",
                                                "text": "Je regarde sa tête de croupier de Las Vegas, son kitsch de bateleur de foire botoxé, moumouté et traînant, d’une télévision l’autre, cette lippe perpétuellement entrouverte …."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
