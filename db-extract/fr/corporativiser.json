                "senses": [
                    {
                        "sense_id": "3ccb07d2-fc1e-32fe-b97e-00150f84f001",
                        "entry_id": "f422e752-fbe0-35b9-8989-9dd1c42b50fc",
                        "glosses": [
                            "Donner un caractère corporatif à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54a191f6-18df-4836-bece-3133132ca078",
                                "sense_id": "3ccb07d2-fc1e-32fe-b97e-00150f84f001",
                                "text": "En conséquence, s’il est vrai qu’on ne résout pas un problème en l’ignorant, ce serait dénaturer la mission des pouvoirs démocratiques que de « corporativiser » l’action des Ministères Economiques."
                            },
                            {
                                "example_id": "f2133838-1d43-4249-8c0d-61ea723a8666",
                                "sense_id": "3ccb07d2-fc1e-32fe-b97e-00150f84f001",
                                "text": "Le gouvernement entreprit de corporativiser cet acteur social rural que l’on supposait dès lors capable de générer des processus sociaux suffisamment graves pour donner des maux de tête à la bureaucratie."
                            }
                        ]
                    }
