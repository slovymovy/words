                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ffccec45-ae81-4f62-8af3-453737386310",
                                "sense_id": "bdcf4b2b-09c2-33c6-8785-2eeee02193db",
                                "text": "Najważniejszym eksporterem przypraw są Indie sprzedające głównie pieprz, kardamon, paprykę chili, kurkumę"
                            }
