                "senses": [
                    {
                        "sense_id": "4d03384e-af21-3eb6-86d1-2b41f45415b5",
                        "entry_id": "0b684f5d-8302-30b0-9cc7-cef4e66322d6",
                        "glosses": [
                            "выжатый из семян клещевины"
                        ],
                        "tags": [
                            "только в выражении касторовое масло"
                        ],
                        "examples": [
                            {
                                "example_id": "eca27898-b695-4bcf-bc22-83e211d16c4a",
                                "sense_id": "4d03384e-af21-3eb6-86d1-2b41f45415b5",
                                "text": "Смазанное касторовым маслом приобретало большую эластичность и не боялось воды."
                            }
                        ]
                    },
                    {
                        "sense_id": "36f7222e-46af-3cec-8e1a-51bc8f377534",
                        "entry_id": "0b684f5d-8302-30b0-9cc7-cef4e66322d6",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительным кастор"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "279bed81-8a0a-43b7-89bc-7281c6876fe6",
                                "sense_id": "36f7222e-46af-3cec-8e1a-51bc8f377534",
                                "text": "Касторовое сукно."
                            }
                        ]
                    },
                    {
                        "sense_id": "1b3d31ea-fdc7-3b5c-99c9-53d351b308a6",
                        "entry_id": "0b684f5d-8302-30b0-9cc7-cef4e66322d6",
                        "glosses": [
                            "сшитый из кастора, шерстяной ткани на основе бобрового меха"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "441eb6c1-d01a-4e9c-b879-1db7557a1b79",
                                "sense_id": "1b3d31ea-fdc7-3b5c-99c9-53d351b308a6",
                                "text": "Касторовое пальто."
                            },
                            {
                                "example_id": "23e747e6-eba3-4d2a-bbec-450a7051ab13",
                                "sense_id": "1b3d31ea-fdc7-3b5c-99c9-53d351b308a6",
                                "text": "Ипполит Матвеевич снял с головы пятнистую касторовую шляпу, расчесал усы, из которых, при прикосновении гребешка, вылетела дружная стайка электрических искр, и, решительно откашлявшись, рассказал Остапу Бендеру, первому встреченному им проходимцу, все, что ему было известно о брильянтах со слог, умирающей тещи."
                            }
                        ]
                    },
                    {
                        "sense_id": "ddda8169-1c19-3520-a1df-f16fa7d4af76",
                        "entry_id": "0b684f5d-8302-30b0-9cc7-cef4e66322d6",
                        "glosses": [
                            "сделанный из бобрового меха или его имитации"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37060859-0148-4568-9922-2bbf9ba47f46",
                                "sense_id": "ddda8169-1c19-3520-a1df-f16fa7d4af76",
                                "text": "Касторовые перчатки. Касторовая шляпа."
                            }
                        ]
                    }
                ],
