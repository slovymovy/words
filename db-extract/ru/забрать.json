                ],
                "senses": [
                    {
                        "sense_id": "886c2a3e-52be-3ddc-918d-98b7368563cb",
                        "entry_id": "1391dace-2319-3942-b901-80043b02eee0",
                        "glosses": [
                            "to take away, to seize, to collect; to capture, to take possession"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9316c126-8482-41b2-ad2f-13a5d0f93139",
                                "sense_id": "886c2a3e-52be-3ddc-918d-98b7368563cb",
                                "text": "забра́ть себе́ в го́лову",
                                "translation": "to take it into one's head",
                                "english": "to take it into one's head"
                            }
                        ]
                    },
                    {
                        "sense_id": "095f7d3d-04b7-3195-878f-f54c14995c6d",
                        "entry_id": "1391dace-2319-3942-b901-80043b02eee0",
                        "glosses": [
                            "to collect, to pick up"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97a4ea26-4ea2-45de-aa88-11b7da4acf5b",
                                "sense_id": "095f7d3d-04b7-3195-878f-f54c14995c6d",
                                "text": "забра́ть това́р",
                                "translation": "to pick up the goods",
                                "english": "to pick up the goods"
                            }
                        ]
                    },
                    {
                        "sense_id": "85e6fa32-256e-3bd7-a903-d969eefdefd0",
                        "entry_id": "1391dace-2319-3942-b901-80043b02eee0",
                        "glosses": [
                            "to arrest"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aced35ee-ded9-4de0-aa82-e4167d7b25ac",
                                "sense_id": "85e6fa32-256e-3bd7-a903-d969eefdefd0",
                                "text": "За людьми́ приезжа́ли на чёрных маши́нах, так называ́емых «воро́нках», по ноча́м и забира́ли це́лыми се́мьями.",
                                "translation": "They came for people in black cars, the so-called \"voronkas\" (\"paddy wagons\") in the night and arrested entire families.",
                                "english": "They came for people in black cars, the so-called \"voronkas\" (\"paddy wagons\") in the night and arrested entire families."
                            }
                        ]
                    },
                    {
                        "sense_id": "fd0e1bc9-067f-38e2-a251-bbd57650a9a5",
                        "entry_id": "1391dace-2319-3942-b901-80043b02eee0",
                        "glosses": [
                            "to pick up (to collect a passenger)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cecd4a4d-c71b-43ce-90c3-f2d9a0e9d1db",
                                "sense_id": "fd0e1bc9-067f-38e2-a251-bbd57650a9a5",
                                "text": "Я забира́ю сы́на по́сле рабо́ты.",
                                "translation": "I pick up (my) son after work.",
                                "english": "I pick up (my) son after work."
                            }
                        ]
                    },
                    {
                        "sense_id": "c7e913aa-ea23-3e28-bfd3-2942917c1379",
                        "entry_id": "1391dace-2319-3942-b901-80043b02eee0",
                        "glosses": [
                            "to bear, to turn off, to turn aside"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "020ac671-e129-4791-bbae-e30e6919af2f",
                                "sense_id": "c7e913aa-ea23-3e28-bfd3-2942917c1379",
                                "text": "забра́ть впра́во",
                                "translation": "to bear (to the) right",
                                "english": "to bear (to the) right"
                            }
                        ]
                    }
                ],
