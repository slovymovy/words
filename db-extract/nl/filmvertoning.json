                "senses": [
                    {
                        "sense_id": "bd294943-bdb5-3414-b642-826d1f1959bc",
                        "entry_id": "d52a9ca8-8bd3-3af5-8401-e8ce9356e362",
                        "glosses": [
                            "de keer dat men een film draait voor publiek"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8930988a-1d49-42c0-80b6-3b4e927b058a",
                                "sense_id": "bd294943-bdb5-3414-b642-826d1f1959bc",
                                "text": "De filmvertoning was bedoeld om politici ervan te overtuigen hoe reëel het gevaar van een kaping is. Wat de politiek daarmee doet, moet vandaag duidelijk worden. Voor kapitein Kooij is het verhaal in ieder geval levensecht."
                            },
                            {
                                "example_id": "66e31760-705a-49db-88f6-2c6fa95e89ed",
                                "sense_id": "bd294943-bdb5-3414-b642-826d1f1959bc",
                                "text": "Na een speciale filmvertoning, exclusief voor vrouwen, werden tasjes uitgedeeld met daarin onder andere schoonmaaksponzen en een plastic raamtrekker. Er zat ook een zak nacho-chips, noedels en een aantal reclamefolders voor afslankpillen in de tas."
                            }
                        ]
                    }
