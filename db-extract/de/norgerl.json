                ],
                "senses": [
                    {
                        "sense_id": "472132a6-140d-3fe3-896c-fb0efe2a5497",
                        "entry_id": "2920996e-8306-3047-99f7-ba0adf790064",
                        "glosses": [
                            "der allerletzte Rest einer Flüssigkeit (meist Getränk) in einem Behältnis wie einem Glas, Becher, Tasse, Flasche"
                        ],
                        "tags": [
                            "Bavarian",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "467563fa-f31e-48db-a681-f304c11468a8",
                                "sense_id": "472132a6-140d-3fe3-896c-fb0efe2a5497",
                                "text": "\"Tatsächlich liegt es aber wohl einfach am Geschmack: Das \"Norgerl\" steht meist so lange, dass es schal und abgestanden schmeckt - und gerne übrig gelassen wird.\""
                            },
                            {
                                "example_id": "c9b40a99-f7d3-411d-a55d-b9c355f1dfc6",
                                "sense_id": "472132a6-140d-3fe3-896c-fb0efe2a5497",
                                "text": "\"Die konnten sich so manches Stamperl, manches Kartenspiel und manche Zigarre leisten, während andere froh um den Schnupftabak und Norgerl im Bierglas sein konnten.\""
                            },
                            {
                                "example_id": "86f52a70-a76c-4c52-a583-767dbdcc183d",
                                "sense_id": "472132a6-140d-3fe3-896c-fb0efe2a5497",
                                "text": "\"Wenn Sie ihr Leben verleihen wollen, dann nach dem Essen ruhig die fettigen Finger an ihr abwischen. Gerne auch das Norgerl drüber schütten, die letzten zwei Schlücke der eh schon warmen Maß.\""
                            },
                            {
                                "example_id": "93088992-840e-4e82-b5f8-06d1aeb25199",
                                "sense_id": "472132a6-140d-3fe3-896c-fb0efe2a5497",
                                "text": "\"Jörg Gabes: „Toll ist, dass es immer frisch ist. Aber wennst da mit einem normalen Zug ansetzt, dann ist das Norgerl ja gleich wieder weg.“\""
                            },
                            {
                                "example_id": "26ac6d6b-3e4f-4c6b-8196-692dd6186eec",
                                "sense_id": "472132a6-140d-3fe3-896c-fb0efe2a5497",
                                "text": "\"Aber nicht nur einfach warm wie ein abgestandenes Norgerl auf der Wiesn, sondern - ich wage es kaum auszusprechen - er trinkt sein Bier aus der Mikrowelle.\""
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
