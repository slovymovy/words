                "senses": [
                    {
                        "sense_id": "806f134f-2082-371c-9e68-40ad9932cbe7",
                        "entry_id": "52aa5436-0b77-3f19-a6ae-d7f3270a9213",
                        "glosses": [
                            "een strik in de vorm van een vlinder die je om je hals kunt dragen als versiering"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e4ed2b6-3f8c-4c58-a7aa-7a34d4ffd342",
                                "sense_id": "806f134f-2082-371c-9e68-40ad9932cbe7",
                                "text": "Coralie was jarenlang de styliste van Stromae. Zíj was het die zijn dandy-achtige stijl van hoedjes, overhemden en vlinderstrik bedacht. Samen begonnen ze modelabel Mosaert, waar hij de komende tijd nu al zijn tijd in zal stoppen."
                            },
                            {
                                "example_id": "413d4f03-8652-4a19-b8a0-3eb80e75e0f7",
                                "sense_id": "806f134f-2082-371c-9e68-40ad9932cbe7",
                                "text": "Op de eerste foto is te zien dat Carina en Mario in een groene, oude auto aankwamen bij het gemeentehuis. De auto was versierd met roze hartjes. De bruid draagt een witte jurk met spaghettibandjes. Om haar taille draagt ze een brede, zilveren riem. Haar haar is voor de helft opgestoken en is versierd met witte bloemetjes. De voetballer draagt een driedelig donkerblauw pak met een vlinderstrikje."
                            },
                            {
                                "example_id": "e18abc0e-ffe4-4538-a06a-618f54914e9d",
                                "sense_id": "806f134f-2082-371c-9e68-40ad9932cbe7",
                                "text": "Opvallend is de populairiteit van vlinderstrikjes dit jaar. Niet alleen de man des huizes, maar ook de vrouw én kinderen stijlen de kerstlook af met deze accessoire."
                            }
                        ]
                    }
