                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "a5e20463-8d05-43e9-ad3d-58a6cf30d0ae",
                        "entry_id": "3ccf37ab-8a40-3d33-9242-cba1c3206196",
                        "tags": [
                            "plural"
                        ],
                        "form": "cockatrices"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "11851578-9f9f-36b9-ae91-7629934605a6",
                        "entry_id": "3ccf37ab-8a40-3d33-9242-cba1c3206196",
                        "glosses": [
                            "A legendary creature about the size and shape of a dragon or wyvern, but in appearance resembling a giant rooster, with some lizard-like characteristics."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f46dfd5-8697-4121-98fe-7676d7f85cdd",
                                "sense_id": "11851578-9f9f-36b9-ae91-7629934605a6",
                                "text": "“Peace reigns in happy Luxor. The lion lies down with the lamb, and the child, if it will, may harmlessly put its hand into the cockatrice’s den.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "c0d29d4c-5493-3875-bf2f-86e1235e3093",
                        "entry_id": "3ccf37ab-8a40-3d33-9242-cba1c3206196",
                        "glosses": [
                            "A mistress, a harlot."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "9a3fa012-369e-3bc4-b6d3-e86bda784c7e",
                        "entry_id": "3ccf37ab-8a40-3d33-9242-cba1c3206196",
                        "glosses": [
                            "A snake or serpent that appears to be hatched from a rooster, or cock's, egg."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41435df4-6db6-40ed-9a93-ed0bba7f959c",
                                "sense_id": "9a3fa012-369e-3bc4-b6d3-e86bda784c7e",
                                "text": "For, behold, I will send serpents, cockatrices, among you, which will not be charmed, and they shall bite you, saith the Lord."
                            }
                        ]
                    },
                    {
                        "sense_id": "3e4d7b34-da0d-3e08-9297-6028dd4b3553",
                        "entry_id": "3ccf37ab-8a40-3d33-9242-cba1c3206196",
                        "glosses": [
                            "The cobra."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "a76c2ed9-33c9-3684-a275-120547dfae82",
                        "entry_id": "3ccf37ab-8a40-3d33-9242-cba1c3206196",
                        "glosses": [
                            "Any venomous or deadly thing."
                        ],
                        "tags": [
                            "figuratively",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "7a2bda5e-f1be-44d4-abb1-2732dcef78ab",
                                "sense_id": "a76c2ed9-33c9-3684-a275-120547dfae82",
                                "text": "this little cockatrice of a king"
                            }
                        ]
                    }
                ],
