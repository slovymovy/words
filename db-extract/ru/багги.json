                                    },
                                    {
                                        "sense_id": "4a7f2eb4-631d-3af6-bac1-c29f84617075",
                                        "entry_id": "4490949b-ac8e-3f7b-9558-77afd78aa46e",
                                        "glosses": [
                                            "Crazy; bughouse."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1668505a-005d-4a60-aa60-9e640c061faf",
                                                "sense_id": "4a7f2eb4-631d-3af6-bac1-c29f84617075",
                                                "text": "You have to help me get out of here. They want to keep me longer, but I can't stay. This place is driving me buggy."
                                            }
                                        ]
                                    }
                                ]
