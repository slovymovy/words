                "senses": [
                    {
                        "sense_id": "cfc9469c-d150-3384-84c2-0beae273dae6",
                        "entry_id": "25473cb5-88c6-31bb-82de-297e47c38b49",
                        "glosses": [
                            "ruhiger, wohlwirkender Zustand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45e5d660-5635-48ff-b308-9ba1be8a9a12",
                                "sense_id": "cfc9469c-d150-3384-84c2-0beae273dae6",
                                "text": "Der Frühnebel gibt dem Ort eine märchenhafte Beschaulichkeit."
                            },
                            {
                                "example_id": "31f6b3b3-c16f-4750-9928-80e0d076368b",
                                "sense_id": "cfc9469c-d150-3384-84c2-0beae273dae6",
                                "text": "„Der idyllischen Beschaulichkeit entsprach es auch, daß die Bauten auf den ersten Blick geringere Spuren der Zerstörung aufwiesen als die Straßenhäuser in der Stadt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b7cdd8d6-d4de-4152-96be-0e79d242a11b",
                        "source_entry_id": "25473cb5-88c6-31bb-82de-297e47c38b49",
                        "source_sense_id": "cfc9469c-d150-3384-84c2-0beae273dae6",
                        "source_sense_description": "ruhiger, wohlwirkender Zustand",
                        "target_lang_word": "tranquillity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tranquillity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bb7cb6ba-ab8b-395a-a97a-43985071e5b1",
                                        "entry_id": "a12c1cc1-4c52-3973-ae0c-21a22cc191ee",
                                        "glosses": [
                                            "The state of being tranquil; peacefulness, the absence of disturbance or stress; serenity; calm."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb01d6cd-ef5d-46e8-b054-e3c40aad055f",
                                                "sense_id": "bb7cb6ba-ab8b-395a-a97a-43985071e5b1",
                                                "text": "Until the main road from Hatfield to Hertford was diverted a few years ago, heavy lorries trundling through the village sometimes knocked chunks off corner buildings, but now the village has regained much of its former tranquillity."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a4ef4583-66ff-4982-95d4-1d7478808c78",
                        "source_entry_id": "25473cb5-88c6-31bb-82de-297e47c38b49",
                        "source_sense_id": "cfc9469c-d150-3384-84c2-0beae273dae6",
                        "source_sense_description": "ruhiger, wohlwirkender Zustand",
                        "target_lang_word": "tranquillité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tranquillité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "df645f11-b5b9-3691-8e42-d0b20d3e6813",
                                        "entry_id": "220deb75-9e14-3a2d-b69b-39778ef0e3c6",
                                        "glosses": [
                                            "État de ce qui est tranquille, sans agitation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd33aa52-a903-4edc-989d-c0e5f895f128",
                                                "sense_id": "df645f11-b5b9-3691-8e42-d0b20d3e6813",
                                                "text": "La charrette s'arrêtait au bord de la gaure. C'était un petit bras de la Garonne, fermé d'un bout, comblé par la vase au temps de la sécheresse estivale, et communiquant, de l'autre, avec le fleuve dont les derniers remous, largement étalés, venaient mourir là, dans la tranquillité de l'eau morte."
                                            },
                                            {
                                                "example_id": "da2085d8-818c-46c5-a51d-091d13fb5bda",
                                                "sense_id": "df645f11-b5b9-3691-8e42-d0b20d3e6813",
                                                "text": "L’administration romaine était extrêmement dure pour tout homme qui lui semblait susceptible de troubler la tranquillité publique […]."
                                            },
                                            {
                                                "example_id": "c46f5b66-8879-4e6b-a03b-33296aa2468e",
                                                "sense_id": "df645f11-b5b9-3691-8e42-d0b20d3e6813",
                                                "text": "Ce n’était pas le paradis, mais une demi-tranquillité avec un travail au grand air dont son mal de poitrine s’accommodait mieux que de la poussière du fournil."
                                            },
                                            {
                                                "example_id": "bd9e79a4-47d8-4998-bed1-7096386f7079",
                                                "sense_id": "df645f11-b5b9-3691-8e42-d0b20d3e6813",
                                                "text": "Les bailleurs doivent la tranquillité aux locataires."
                                            },
                                            {
                                                "example_id": "1221bb0e-bc43-4e80-8498-016d99c9020e",
                                                "sense_id": "df645f11-b5b9-3691-8e42-d0b20d3e6813",
                                                "text": "Léon ayant regagné l'Alsace pour quelque temps, ils jouissaient tous deux d'une parfaite tranquillité. Ils lantiponnaient sur tout et sur rien."
                                            },
                                            {
                                                "example_id": "262ebd80-61d8-4de3-8150-5885388ec75a",
                                                "sense_id": "df645f11-b5b9-3691-8e42-d0b20d3e6813",
                                                "text": "— Le fils d’Alcide le flotteur a seulement désiré sa liberté, son temps rien qu’à lui pour étudier, sa tranquillité d’aller et de venir, comme bon lui semble, où il veut, […]."
                                            },
                                            {
                                                "example_id": "fe642a8d-760c-4c0c-880a-8410cabce05b",
                                                "sense_id": "df645f11-b5b9-3691-8e42-d0b20d3e6813",
                                                "text": "Il dort avec tranquillité. — Rien ne trouble la tranquillité de son sommeil."
                                            },
                                            {
                                                "example_id": "c2cf1262-40d3-4d82-9468-660ee4024887",
                                                "sense_id": "df645f11-b5b9-3691-8e42-d0b20d3e6813",
                                                "text": "Passer la vie dans une grande tranquillité. — La tranquillité de l’esprit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
