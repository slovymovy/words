                                        "entry_id": "08546123-f30c-3ed4-97bf-9bf4187897a5",
                                        "glosses": [
                                            "A person who operates a radio transmitter on a ship or in an outpost, military unit, etc., in order to communicate over long distances."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "459d3cf3-8c29-4a35-af66-2fa9cb649579",
                                                "sense_id": "11451166-d5a2-3c11-9610-2243a18c0404",
                                                "text": "He found the new wireless operator a charming fellow, possessed of talents far superior to those of the young men who ordinarily pound the brass at sea."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd3b5d51-c265-3c31-9bbb-03a8e6e9d2b2",
                                        "entry_id": "08546123-f30c-3ed4-97bf-9bf4187897a5",
                                        "glosses": [
                                            "A commercial firm which provides mobile communications services."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe6e34f1-52cf-44dc-8a45-6f79b98b9790",
                                                "sense_id": "fd3b5d51-c265-3c31-9bbb-03a8e6e9d2b2",
                                                "text": "France Telecom is the second largest wireless operator and Internet access provider in Europe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
