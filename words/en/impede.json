    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "36d4eb9a-ac67-3ce0-8f96-562bc14c75a7",
                    "sense_definition": "To delay or prevent someone or something by obstructing them; to hinder.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "obstruct",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy snow will likely <w>impede</w> our progress as we try to reach the summit.",
                            "target_lang_translations": {
                                "ru": "Сильный снегопад, скорее всего, <w>затруднит</w> наше продвижение к вершине."
                            }
                        },
                        {
                            "text": "New regulations might <w>impede</w> economic growth if they are too restrictive for small businesses.",
                            "target_lang_translations": {
                                "ru": "Новые правила могут <w>препятствовать</w> экономическому росту, если они будут слишком ограничительными для малого бизнеса."
                            }
                        },
                        {
                            "text": "Frequent interruptions can <w>impede</w> the team's ability to finish the report on time.",
                            "target_lang_translations": {
                                "ru": "Частые отвлечения могут <w>помешать</w> команде закончить отчёт вовремя."
                            }
                        }
                    ],
                    "synonyms": [
                        "hinder"
                    ],
                    "antonyms": [
                        "assist",
                        "help",
                        "expedite"
                    ],
                    "common_phrases": [
                        "impede progress",
                        "impede development",
                        "impede recovery"
                    ],
                    "target_lang_definitions": {
                        "ru": "Задерживать или предотвращать чьи-либо действия или развитие чего-либо путем создания препятствий; мешать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "препятствовать",
                                "target_lang_sense_clarification": "создавать преграды для процесса или действия"
                            },
                            {
                                "target_lang_word": "затруднять",
                                "target_lang_sense_clarification": "делать процесс более сложным или медленным"
                            },
                            {
                                "target_lang_word": "мешать",
                                "target_lang_sense_clarification": "создавать помехи"
                            },
                            {
                                "target_lang_word": "тормозить",
                                "target_lang_sense_clarification": "замедлять развитие или прогресс"
                            }
                        ]
