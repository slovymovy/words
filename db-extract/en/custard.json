                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "crème anglaise",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3c8faf77-6272-32a1-9018-4eb72280bd1a",
                                        "entry_id": "9298775d-9063-30a4-898e-7c9dd76abaf1",
                                        "glosses": [
                                            "Crème liquide composée de lait, de jaunes d’œuf, de sucre et parfumée à la vanille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79eaf702-dc44-4edc-a892-14be725a0c1b",
                                                "sense_id": "3c8faf77-6272-32a1-9018-4eb72280bd1a",
                                                "text": "Dans la pratique il est difficile de préciser les points de coagulation d’un mélange aussi complexe que la crème anglaise, par exemple."
                                            },
                                            {
                                                "example_id": "98aed8d6-da40-4998-a85a-78144972046d",
                                                "sense_id": "3c8faf77-6272-32a1-9018-4eb72280bd1a",
                                                "text": "Si vous préparez la crème anglaise la veille, elle n’en sera que plus parfumée et plus savoureuse."
                                            },
                                            {
                                                "example_id": "758706d8-a405-438f-9a18-9a6b88bc2e9f",
                                                "sense_id": "3c8faf77-6272-32a1-9018-4eb72280bd1a",
                                                "text": "Une crème anglaise termine le repas avec des mince pies un peu ratés."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "03d4f5e6-f2ef-4b37-9de4-19a0cbc22525",
                        "source_entry_id": "ba7051dd-a3c8-39b2-b05d-910d6e6ac372",
                        "source_sense_description": "sauce",
                        "target_lang_word": "crème pâtissière",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
