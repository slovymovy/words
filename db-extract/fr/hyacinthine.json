                                "target_senses": [
                                    {
                                        "sense_id": "40331261-2c72-3ef7-948f-b567888dfb1d",
                                        "entry_id": "56ea80cb-7f2d-32db-bb19-029ec43e61bd",
                                        "glosses": [
                                            "Of the colour of a hyacinth (either the gem or the flower); reddish-gold (chiefly with reference to hair)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "215a0b3c-d9a9-444f-a5e6-9a4f33c0efd5",
                                                "sense_id": "40331261-2c72-3ef7-948f-b567888dfb1d",
                                                "text": "His fair large front and eye sublime declared / Absolute rule; and hyacinthine locks / Round from his parted forelock manly hung / Clustering, but not beneath his shoulders broad:"
                                            },
                                            {
                                                "example_id": "598bc8f8-1c76-425e-a5b5-9c4d38b9b9d2",
                                                "sense_id": "40331261-2c72-3ef7-948f-b567888dfb1d",
                                                "text": "[…] the nicest young man that ever was, — daintily gloved, patently booted, oilily curled, snowily wristbanded, with a lovely cambric (prima facie) handkerchief bound about his hyacinthine locks and polished hat."
                                            },
                                            {
                                                "example_id": "b0b9d9e1-6526-4513-932e-8d5e3f6d4591",
                                                "sense_id": "40331261-2c72-3ef7-948f-b567888dfb1d",
                                                "text": "The beautiful boy has flowing or richly textured hyacinthine hair, the only luxuriance in this chastity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a82472a-1306-3ece-b4f5-c582504cd25c",
                                        "entry_id": "56ea80cb-7f2d-32db-bb19-029ec43e61bd",
                                        "glosses": [
                                            "Curling like the petals of the hyacinth."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3f198216-3f96-3e19-89aa-e79682602f52",
