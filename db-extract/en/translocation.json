                                "sense_id": "529d7ffb-36f3-302b-8adf-e40145986e70",
                                "text": "There happen'd certain translocations at the deluge."
                            },
                            {
                                "example_id": "2381805a-6313-466d-8f5b-05909c72efc1",
                                "sense_id": "529d7ffb-36f3-302b-8adf-e40145986e70",
                                "text": "By taking users to places where they would or could not really go, the technology offered empathy or awe via translocation."
                            }
                        ]
                    },
