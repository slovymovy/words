                        ],
                        "form": "ornithologues"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6416f18a-d51a-321c-9736-c5fdd2efbf3d",
                        "entry_id": "8dec15ce-ac99-39cb-9c9b-39c268a3e98a",
                        "glosses": [
                            "Celui, celle qui s’occupe d’ornithologie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "218b08eb-c1c2-4a88-a3e3-de48959a2a06",
                                "sense_id": "6416f18a-d51a-321c-9736-c5fdd2efbf3d",
                                "text": "En Nouvelle-Zélande, le vote pour l’Oiseau de l'année, toujours controversé, a commencé avec la colère d’ornithologues amateurs, furieux de voir le kakapo exclu."
                            },
                            {
                                "example_id": "c2382fc3-d27f-45dd-b848-52de2f7cd431",
                                "sense_id": "6416f18a-d51a-321c-9736-c5fdd2efbf3d",
                                "text": "Certaines espèces s’en sortent mieux que d’autres, note l’ornithologue Alexandre Millon, maître de conférences à Aix-Marseille université."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b1d8c0d3-23ec-4987-88f6-bfed4c1f29cd",
                        "source_entry_id": "8dec15ce-ac99-39cb-9c9b-39c268a3e98a",
                        "source_sense_id": "6416f18a-d51a-321c-9736-c5fdd2efbf3d",
                        "target_lang_word": "Ornithologe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ornithologe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "96301f58-b806-3542-ac4e-14215aada86c",
                                        "entry_id": "85aa613c-d1ca-3f1b-907b-fb9193fd06b0",
                                        "glosses": [
                                            "Person, die sich mit der Ornithologie befasst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c8360d0-1b53-43a8-bb1f-7df9a22da816",
                                                "sense_id": "96301f58-b806-3542-ac4e-14215aada86c",
                                                "text": "Ornithologen haben im brasilianischen Regenwald zwei neue Vogelarten entdeckt."
                                            },
                                            {
                                                "example_id": "23e34744-419c-471c-b4d0-b27828e6c9d6",
                                                "sense_id": "96301f58-b806-3542-ac4e-14215aada86c",
                                                "text": "Zum Handwerkszeug des Ornithologen gehört unbedingt ein Fernglas."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "957dc741-4e9f-4437-a3d2-b24b83d3b0c8",
                        "source_entry_id": "8dec15ce-ac99-39cb-9c9b-39c268a3e98a",
                        "source_sense_id": "6416f18a-d51a-321c-9736-c5fdd2efbf3d",
