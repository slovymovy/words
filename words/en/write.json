            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f7d73128-1149-347f-b61e-8fad262723f9",
                    "sense_definition": "To form letters, words, or symbols on a surface in order to communicate.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "communication_creation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pupil <w>wrote</w> his name clearly on the paper.",
                            "target_lang_translations": {
                                "ru": "Ученик четко <w>написал</w> свое имя на бумаге.",
                                "pl": "Uczeń wyraźnie <w>napisał</w> swoje nazwisko na papierze."
                            }
                        },
                        {
                            "text": "Please <w>write</w> your address in the space provided.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>напишите</w> свой адрес в отведенном месте.",
                                "pl": "Proszę <w>wpisać</w> swój adres w wyznaczonym miejscu."
                            }
                        }
                    ],
                    "synonyms": [
                        "scrawl",
                        "scribble",
                        "note down"
                    ],
                    "common_phrases": [
                        "write down",
                        "write in pencil",
                        "write by hand"
                    ],
                    "target_lang_definitions": {
                        "ru": "Наносить буквы, слова или символы на поверхность для передачи информации.",
                        "pl": "Tworzyć litery, słowa lub symbole na powierzchni w celu komunikacji."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "писать",
                                "target_lang_sense_clarification": "процесс нанесения текста"
