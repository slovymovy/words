                        "examples": [
                            {
                                "example_id": "1acc271c-f4f2-412d-a35f-3381f884b643",
                                "sense_id": "44d68259-6451-37c6-956f-2e154d950180",
                                "text": "De 136 zelfstandige kantoren van de Rabobank hebben elk een eigen bankvergunning van toezichthouder De Nederlandsche Bank. Maar het toezicht wordt van oudsher uitgevoerd door het hoofdkantoor in Utrecht. De Rabobank wil niet bekend maken welke zelfstandige banken op dit moment onder curatele staan."
                            },
                            {
                                "example_id": "9fc863b7-49b0-4aee-bbd8-a1e1dff74782",
                                "sense_id": "44d68259-6451-37c6-956f-2e154d950180",
                                "text": "Oud-DNB-president Nout Wellink heeft eerder bij een hoorzitting in de Tweede Kamer gezegd dat er andere voorwaarden aan de bankvergunning van DSB verbonden hadden moeten worden. Tegenwoordig is De Nederlandsche Bank wettelijk beschermd tegen claims, maar die wet was nog niet in werking bij de val van DSB. De toezichthouder is niet aansprakelijk, behalve in gevallen van opzet en grove schuld."
                            }
                        ]
                    }
