                "senses": [
                    {
                        "sense_id": "6aa6a840-efbf-364d-9ab0-c4aae4c70a7b",
                        "entry_id": "45b50959-0333-394d-abc0-f4d901c23427",
                        "glosses": [
                            "Descriptivist."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "662fe235-7f67-4479-be20-90d6c647e6f4",
                                "sense_id": "6aa6a840-efbf-364d-9ab0-c4aae4c70a7b",
                                "text": "In effect, they say \"a plague on both your houses\" to the two sides in the prescriptionist-descriptionist debate."
                            }
                        ]
                    },
                    {
                        "sense_id": "4dfee930-5e84-3862-a798-ec25db47bb58",
                        "entry_id": "45b50959-0333-394d-abc0-f4d901c23427",
                        "glosses": [
                            "Regarding utterances as primarily descriptive rather than as rigidly specifying a particular thing or kind of thing."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "ab6c6548-0e4c-42cb-9366-88ddc02fecc3",
                                "sense_id": "4dfee930-5e84-3862-a798-ec25db47bb58",
                                "text": "The problem with the descriptionist account of date-times is that it gives the wrong truth conditions to sentences like that in CAESAR."
                            }
                        ]
                    },
                    {
                        "sense_id": "4340570e-4c4e-32e1-9bfc-2109b76a39e7",
                        "entry_id": "45b50959-0333-394d-abc0-f4d901c23427",
                        "glosses": [
                            "Of or relating to descriptionism (theory of truth)."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "13083943-cc2c-3e58-9965-2f997f2f0c8e",
                "word": "descriptionist",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "eccc90f5-8706-477a-a84b-1dfd4aa443c8",
                        "entry_id": "13083943-cc2c-3e58-9965-2f997f2f0c8e",
                        "tags": [
                            "plural"
                        ],
                        "form": "descriptionists"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4c3e8901-23b5-3e3c-a691-ae1f3006c114",
                        "entry_id": "13083943-cc2c-3e58-9965-2f997f2f0c8e",
                        "glosses": [
                            "Synonym of descriptivist."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2cdcbbaf-09bd-4cbf-8121-e045e0f4d850",
                                "sense_id": "4c3e8901-23b5-3e3c-a691-ae1f3006c114",
                                "text": "The author of the Waverley novels is another fine example; but he clearly takes his highest rank as a descriptionist—the painter of effects and appearances rather than of facts and of causes."
                            },
                            {
                                "example_id": "57809a4e-e159-454a-bb4a-f5bcc8ee4912",
                                "sense_id": "4c3e8901-23b5-3e3c-a691-ae1f3006c114",
                                "text": "Although he is a descriptionist, he is often more effective than Roberts or Lampman."
                            },
                            {
                                "example_id": "2eba3f53-e46a-4a50-884f-4a90a5facc45",
                                "sense_id": "4c3e8901-23b5-3e3c-a691-ae1f3006c114",
                                "text": "He was, on the other hand, the very opposite of a descriptionist in his physics, especially later in his career."
                            },
                            {
                                "example_id": "7f305dc5-1d4f-4547-a4ee-dfd33afd5136",
                                "sense_id": "4c3e8901-23b5-3e3c-a691-ae1f3006c114",
                                "text": "“Oh,” said one of my lunch companions, “you’re a descriptionist rather than a prescriptionist.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "7452fad8-d1e4-3ffb-8ffe-92e068fd2b2b",
                        "entry_id": "13083943-cc2c-3e58-9965-2f997f2f0c8e",
                        "glosses": [
                            "One who subscribes to descriptionism."
                        ],
