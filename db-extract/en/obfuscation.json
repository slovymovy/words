                                        "sense_id": "069a1907-a88d-325d-aec7-efb5d4fb1cf4",
                                        "entry_id": "e43e724c-018b-3ac7-84cf-100a51223262",
                                        "glosses": [
                                            "das Bedecken (besonders von Körperteilen der Frau) mit transparentem oder dichtem Gewebe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "512509f6-7215-46f7-9d7d-2ec1e6e4932f",
                                                "sense_id": "069a1907-a88d-325d-aec7-efb5d4fb1cf4",
                                                "text": "„Seit Jahrzehnten gibt es in muslimischen Ländern einen Trend oder gar einen Zwang zur Verschleierung, parallel dazu sind die sexuelle Belästigung auf den Strassen und die körperliche Gewalt gegen Frauen gestiegen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0eba97e2-097b-35a5-8865-68b1cfe9ed5b",
                                        "entry_id": "e43e724c-018b-3ac7-84cf-100a51223262",
                                        "glosses": [
                                            "das Gewebe selbst, das hierfür verwendet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04078145-592d-484c-856f-06a3f34c2182",
                                                "sense_id": "0eba97e2-097b-35a5-8865-68b1cfe9ed5b",
                                                "text": "„Die bayerische Regierung will durchsetzen, dass Frauen in bestimmten Fällen vor Gericht ihre Verschleierung ablegen müssen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "7eef9ee8-69ac-307a-933f-5ae39a99dee4",
                                        "entry_id": "e43e724c-018b-3ac7-84cf-100a51223262",
                                        "glosses": [
                                            "bewusste Täuschung/Irreführung, um einen wahren Sachverhalt zu verbergen"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bfb4fef0-157e-47d8-9023-4cd0e4443711",
                                                "sense_id": "7eef9ee8-69ac-307a-933f-5ae39a99dee4",
                                                "text": "„Bereits am Wochenende hatte die israelische Regierung vor einer Verschleierung polnischer Verbrechen an Juden im Zweiten Weltkrieg gewarnt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
