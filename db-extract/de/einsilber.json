                ],
                "senses": [
                    {
                        "sense_id": "dba99a94-9cea-398f-9474-ef9ac9f5e6de",
                        "entry_id": "a4f4482a-c801-3761-86c3-0bc28093c1ff",
                        "glosses": [
                            "Wort, das aus nur einer Silbe besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4152c566-2d11-4584-9039-adb4f21b8f9f",
                                "sense_id": "dba99a94-9cea-398f-9474-ef9ac9f5e6de",
                                "text": "„Die kompliziertesten Einsilber ohne interne morphologische Grenze sind Formen wie Strumpf, Pflicht, ernst, Herbst mit drei Konsonanten im Anfangsrand und drei oder vier Konsonanten im Endrand.“"
                            },
                            {
                                "example_id": "eb769253-910e-442c-96a8-0c565bff624a",
                                "sense_id": "dba99a94-9cea-398f-9474-ef9ac9f5e6de",
                                "text": "„Hat ein Einsilber nur ein Graphem im Endrand, so wird der Vokal lang gelesen…“"
                            },
                            {
                                "example_id": "57a1e4af-97ce-4ed2-8ce7-e11735aca6e0",
                                "sense_id": "dba99a94-9cea-398f-9474-ef9ac9f5e6de",
                                "text": "„So beantwortet Abbildung 1 die Frage, mit wieviel Prozent die Einsilber, Zweisilber, Dreisilber undsoweiter in Werken von Goethe, Rilke, Cäsar und Sallust vorkommen.“"
                            },
                            {
                                "example_id": "977a15c1-d5b4-413c-b2ea-103a28e1de5d",
                                "sense_id": "dba99a94-9cea-398f-9474-ef9ac9f5e6de",
                                "text": "„Janet fuhr im Bett hoch, und ihre Worte, lauter Einsilber, kamen ihm wie Streichhölzer vor, die in einer explosiven Umgebung aufflammen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
