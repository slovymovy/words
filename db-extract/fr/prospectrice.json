                "senses": [
                    {
                        "sense_id": "c5d2cb92-e072-32e1-a56c-eededb6758b2",
                        "entry_id": "e3cdc5bd-cd0f-3ea4-990e-a407af9c7e92",
                        "glosses": [
                            "Celle qui recherche dans une région déterminée les richesses du sol ou du sous-sol dans le but de les exploiter."
                        ],
                        "tags": [
                            "generically"
                        ],
                        "examples": [
                            {
                                "example_id": "5864cb8a-ab59-4bb6-86ff-c8c2ae6474a1",
                                "sense_id": "c5d2cb92-e072-32e1-a56c-eededb6758b2",
                                "text": "Une prospectrice sous-marine, Miss Patricia Giddy […] travaillait sur les rocs aurifères du Pays de Galles, et l’idée la frappa que ces bancs de roches pouvaient bien reparaître plus loin sous les flots. […]. Grâce à l’heureuse combinaison du raisonnement et de l’intuition particulière à son sexe, elle trouva de l’or à sa première descente, […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "0f7ed745-41a2-3287-b5d4-06a8702fcdef",
                        "entry_id": "e3cdc5bd-cd0f-3ea4-990e-a407af9c7e92",
                        "glosses": [
                            "Celle qui est chargée par une entreprise de rechercher de nouveaux clients."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "a4714d06-6d17-4648-a332-d9a580a9a7de",
                                "sense_id": "0f7ed745-41a2-3287-b5d4-06a8702fcdef",
                                "text": "Prospecteur/prospectrice terrain-secteur photovoltaïque."
                            }
                        ]
                    },
                    {
                        "sense_id": "afbafad4-e0f3-34a9-844a-52ae18d50701",
                        "entry_id": "e3cdc5bd-cd0f-3ea4-990e-a407af9c7e92",
                        "glosses": [
                            "Celle qui recherche et participe avant les autres à des événements nouveaux."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "52903bcc-1b41-4f5f-a916-60fb48d85cae",
                                "sense_id": "afbafad4-e0f3-34a9-844a-52ae18d50701",
                                "text": "Zizi et Marie-Hélène avaient tout vu – pièces, films ballets, expositions de tableaux, collections de haute couture, – avant le grand public. Même Valérie était à la traîne par rapport à ces prospectrices de l’art parisien."
                            }
                        ]
                    }
