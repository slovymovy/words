                "senses": [
                    {
                        "sense_id": "b645fc99-2bc1-35d8-8284-26250521cc78",
                        "entry_id": "c5a24c93-fa38-3dd5-8c8a-460583760f74",
                        "glosses": [
                            "glorieuze verhevenheid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79bf37e4-37ce-4546-8b86-8144ed35cfdd",
                                "sense_id": "b645fc99-2bc1-35d8-8284-26250521cc78",
                                "text": "En daar zetelt hij in majesteit."
                            }
                        ]
                    },
                    {
                        "sense_id": "a99b5293-15d7-3843-aa57-873de288db5b",
                        "entry_id": "c5a24c93-fa38-3dd5-8c8a-460583760f74",
                        "glosses": [
                            "een vorst of vorstin waaraan als titel [1] wordt toegedicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d3b7e94-93d4-4db8-94ad-6c64706c35db",
                                "sense_id": "a99b5293-15d7-3843-aa57-873de288db5b",
                                "text": "Beide majesteiten namen plaats op hun zetels en daarmee begon de plechtigheid."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7a57e5a1-e40b-49a7-a9b3-4725a69b1d70",
                        "source_entry_id": "c5a24c93-fa38-3dd5-8c8a-460583760f74",
                        "source_sense_id": "b645fc99-2bc1-35d8-8284-26250521cc78",
                        "target_lang_word": "Majestät",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Majestät",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "23d721d4-658f-33d0-9511-ff295cff45a4",
                                        "entry_id": "9a106aa1-8c0c-3cab-bc83-a80b85b16233",
                                        "glosses": [
                                            "Titel von Kaisern und Königen (in der Anrede auch mit vorangehendem Pronomen verwendet)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17e85e16-ddfe-4890-8db2-940158cc1ec6",
                                                "sense_id": "23d721d4-658f-33d0-9511-ff295cff45a4",
                                                "text": "„Die Majestäten scheinen die angespannte Lage zwischen den beiden führenden deutschen Mächten vergessen zu wollen.“"
                                            },
                                            {
                                                "example_id": "f7d06355-3b39-47e1-8514-bbd466f21766",
                                                "sense_id": "23d721d4-658f-33d0-9511-ff295cff45a4",
                                                "text": "„Die darauffolgende Audienz bei Ihrer Majestät war ein weiteres wichtiges Ereignis.“"
                                            },
                                            {
                                                "example_id": "b7e6352e-11f3-4c2c-855d-ae72bc6e3f4f",
                                                "sense_id": "23d721d4-658f-33d0-9511-ff295cff45a4",
                                                "text": "„Mit sechzig war er von Ihrer Majestät der Königin von England huldvoll zum Ritter geschlagen worden.“."
                                            },
                                            {
                                                "example_id": "f288c591-7ab9-462b-bc4d-224e28a3ee24",
                                                "sense_id": "23d721d4-658f-33d0-9511-ff295cff45a4",
                                                "text": "„Aber hier mußte sie von einem zufällig die Freitreppe herabkommenden Kammerherrn in Erfahrung bringen, daß Seine Majestät Potsdam bereits wieder verlassen und sich zur Begrüßung Ihrer Majestät der Königin, die tags darauf aus Bad Pyrmont zurückzukehren gedenke, nach Paretz begeben habe, wo man, frei vom Zwange des Hofes, eine Woche lang in glücklicher Zurückgezogenheit zu verleben gedenke.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0a99b145-ea01-3efc-b129-09d2d5de5e6d",
                                        "entry_id": "9a106aa1-8c0c-3cab-bc83-a80b85b16233",
                                        "glosses": [
                                            "eine Eigenschaft wie Herrlichkeit, Erhabenheit oder Größe, die von etwas oder jemanden ausgeht"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51f53a63-3e6f-49d1-8126-ecc239eb69e3",
                                                "sense_id": "0a99b145-ea01-3efc-b129-09d2d5de5e6d",
                                                "text": "„Die Welt, über die man regiert, mag noch so klein sein: Die Majestät ist nichts anderes als die Vornehmheit des Verhaltens in den unbedeutendsten Angelegenheiten.“ – Marcel Jouhandeau"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
