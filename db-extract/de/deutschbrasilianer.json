                "senses": [
                    {
                        "sense_id": "da8cdcc1-c4ac-364d-9ada-2b8fbedf52b2",
                        "entry_id": "2ecce1b3-b30a-3826-8988-c4d8f8cf95c3",
                        "glosses": [
                            "Brasilianer deutscher Abstammung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29155c97-5aeb-47b0-b5ce-11ef34e48287",
                                "sense_id": "da8cdcc1-c4ac-364d-9ada-2b8fbedf52b2",
                                "text": "„Nun, nach neun Jahren Kohlenpott habe er [Dedé] beim BVB längst seinen Frieden gefunden. Inzwischen schlägt in seiner Brust „das Herz eines Deutschbrasilianers“.“"
                            },
                            {
                                "example_id": "6cfa28ad-dd90-4a3c-bb3d-77fb580498f4",
                                "sense_id": "da8cdcc1-c4ac-364d-9ada-2b8fbedf52b2",
                                "text": "„Die Welt in Rezessions-Angst. Doch einen juckt das gar nicht – Eike Fuhrken Batista (54). Der Deutsch-Brasilianer hat nur ein Ziel: Er will reichster Mann der Welt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
