                "senses": [
                    {
                        "sense_id": "dbb66085-9e4d-391f-a9c4-3711bdfa2612",
                        "entry_id": "b80c2dbb-00fb-3187-986c-814890f8c566",
                        "glosses": [
                            "Schriftstück, in dem bestimmte Positionen festgehalten werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "658926f8-b8a0-4b84-894b-67850ba28c92",
                                "sense_id": "dbb66085-9e4d-391f-a9c4-3711bdfa2612",
                                "text": "„Die konservativen Nachrichtenoffiziere, die ihre ganze Laufbahn damit zugebracht hatten, die Geheimnisse der Nation zu schützen, verbrachten jetzt im Ruhestand ihre Tage damit, mit Journalisten zu Mittag zu essen, befreundeten Denkfabriken sachverständige Berichte über Geheimdienstangelegenheiten zu liefern oder Positionspapiere für politische Kandidaten zu schreiben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9d0f95f3-d0cc-43cd-89f3-04c16c61c60a",
                        "source_entry_id": "b80c2dbb-00fb-3187-986c-814890f8c566",
                        "source_sense_id": "dbb66085-9e4d-391f-a9c4-3711bdfa2612",
                        "source_sense_description": "Schriftstück über Positionen",
                        "target_lang_word": "position paper",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "position paper",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5afe873c-de8e-3b5c-b7a2-b64c760f132d",
                                        "entry_id": "f0f18642-d15d-3835-9524-f066b189422a",
                                        "glosses": [
                                            "An essay or report which expresses a position, conclusion, or recommendation concerning a contested issue or undecided question and which usually contains arguments or reasons in support of this position."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9f98f76-3968-421d-9db5-442a7e1a90c3",
                                                "sense_id": "5afe873c-de8e-3b5c-b7a2-b64c760f132d",
                                                "text": "He headed the China-watching Consulate General, and in 1963 drafted a position paper for President Kennedy that recommended rapprochement with China."
                                            },
                                            {
                                                "example_id": "bee13fe8-4801-4d72-9a94-3ae77c7390ce",
                                                "sense_id": "5afe873c-de8e-3b5c-b7a2-b64c760f132d",
                                                "text": "The first chapter is a position paper on explanation in the social sciences, a plea for \"mechanisms\" as opposed to law-like principles."
                                            },
                                            {
                                                "example_id": "08cb9e3e-367c-4f60-abd0-bfa31c1b0de3",
                                                "sense_id": "5afe873c-de8e-3b5c-b7a2-b64c760f132d",
                                                "text": "They oversee groups that are churning out position papers on counterterrorism, cybersecurity, democracy and human rights, and global development."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
