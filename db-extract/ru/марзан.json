                                        "entry_id": "afabeb0d-6126-3b4b-8ca9-4c200c429b4d",
                                        "glosses": [
                                            "To strike; to beat."
                                        ],
                                        "tags": [
                                            "UK",
                                            "regional",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "657c91bf-1cac-44b1-a3ac-60b4e8cc4ff3",
                                                "sense_id": "5c852dd3-9177-3556-ba36-24038252b729",
                                                "text": "There is his poor little cap hanging up on the door; and there on the table is the knife he chipped a piece out of through not minding the mark on the knife machine, and I clumped his head for him, poor lamb!"
                                            }
                                        ]
