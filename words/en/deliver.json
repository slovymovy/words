{
    "word_family": [
        "delivery",
        "deliverance",
        "deliverer",
        "deliverable",
        "redeliver",
        "undelivered"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6dac9e9e-63c7-32b0-bf49-644359b9a786",
                    "sense_definition": "To bring or transport something, such as mail, packages, or goods, to a specific destination.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The postman will <w>deliver</w> the mail early tomorrow morning.",
                            "target_lang_translations": {
                                "ru": "Почтальон <w>доставит</w> почту завтра рано утром.",
                                "tr": "Postacı yarın sabah erken saatte postayı <w>teslim edecek</w>.",
                                "zh": "邮递员明天一大早就会<w>投递</w>邮件。"
                            }
                        },
                        {
                            "text": "We can <w>deliver</w> the furniture to your house by Friday.",
                            "target_lang_translations": {
                                "ru": "Мы можем <w>доставить</w> мебель к вам домой к пятнице.",
                                "tr": "Mobilyaları Cuma gününe kadar evinize <w>teslim edebiliriz</w>.",
                                "zh": "我们可以在周五前把家具<w>送货</w>到您家。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "deliver a package",
                        "deliver the mail",
                        "deliver goods"
                    ],
                    "target_lang_definitions": {
                        "ru": "Привозить или транспортировать что-либо (почту, посылки, товары) в определенное место назначения.",
                        "tr": "Posta, paket veya mal gibi bir şeyi belirli bir adrese teslim etmek veya götürmek.",
                        "zh": "将邮件、包裹或货物等物品运送到特定目的地。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "доставлять",
                                "target_lang_sense_clarification": "общий термин для перевозки грузов или почты"
                            },
                            {
                                "target_lang_word": "разносить",
                                "target_lang_sense_clarification": "обычно о почте или газетах, доставляемых по адресам"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "teslim etmek",
                                "target_lang_sense_clarification": "paket, posta veya sipariş teslimatı"
                            },
                            {
                                "target_lang_word": "getirmek",
                                "target_lang_sense_clarification": "adrese ulaştırmak"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "递送",
                                "target_lang_sense_clarification": "指将物品送达某处"
                            },
                            {
                                "target_lang_word": "投递",
                                "target_lang_sense_clarification": "常用于邮件或报纸的派送"
                            },
                            {
                                "target_lang_word": "送货",
                                "target_lang_sense_clarification": "指商业上的货物配送"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e26005a8-fc2b-30ae-b6a7-d98bb0b3c48b",
                    "sense_definition": "To produce or provide what is expected, promised, or required, often used in business or sports contexts.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team worked hard to <w>deliver</w> the project on time.",
                            "target_lang_translations": {
                                "ru": "Команда усердно работала, чтобы <w>сдать</w> проект вовремя.",
                                "tr": "Takım projeyi zamanında <w>teslim etmek</w> için çok çalıştı.",
                                "zh": "团队努力工作，按时<w>交付</w>了项目。"
                            }
                        },
                        {
                            "text": "He promised to help us, and he really <w>delivered</w>.",
                            "target_lang_translations": {
                                "ru": "Он обещал помочь нам, и действительно <w>сдержал слово</w>.",
                                "tr": "Bize yardım edeceğine söz verdi ve gerçekten sözünü <w>yerine getirdi</w>.",
                                "zh": "他答应帮助我们，而且确实<w>履行</w>了诺言。"
                            }
                        }
                    ],
                    "synonyms": [
                        "come through",
                        "come up with the goods",
                        "fulfill",
                        "carry out."
                    ],
                    "common_phrases": [
                        "deliver on a promise",
                        "deliver results",
                        "deliver value"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выполнять обещанное, предоставлять ожидаемый результат или оправдывать ожидания (часто в бизнесе).",
                        "tr": "Beklenen, vaat edilen veya gereken şeyi yerine getirmek, sağlamak veya başarmak.",
                        "zh": "履行承诺、提供预期的结果或达到要求的标准。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выполнять",
                                "target_lang_sense_clarification": "обещание, обязательство или работу"
                            },
                            {
                                "target_lang_word": "предоставлять",
                                "target_lang_sense_clarification": "результат, услугу или товар"
                            },
                            {
                                "target_lang_word": "добиваться успеха",
                                "target_lang_sense_clarification": "справляться с задачей, выдавать результат"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yerine getirmek",
                                "target_lang_sense_clarification": "sözü, görevi veya beklentiyi sağlamak"
                            },
                            {
                                "target_lang_word": "sağlamak",
                                "target_lang_sense_clarification": "sonuç veya performans sunmak"
                            },
                            {
                                "target_lang_word": "başarmak",
                                "target_lang_sense_clarification": "bekleneni ortaya koymak"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "交付",
                                "target_lang_sense_clarification": "指完成并提交工作成果"
                            },
                            {
                                "target_lang_word": "实现",
                                "target_lang_sense_clarification": "指达成目标或承诺"
                            },
                            {
                                "target_lang_word": "履行",
                                "target_lang_sense_clarification": "指执行诺言或义务"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2fa5613a-04d1-3cfe-9ec0-1c9553d6741a",
                    "sense_definition": "To speak or present something formally, such as a speech, judgment, or message.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The president will <w>deliver</w> a speech to the nation tonight.",
                            "target_lang_translations": {
                                "ru": "Сегодня вечером президент <w>произнесет</w> речь перед нацией.",
                                "tr": "Başkan bu gece ulusa bir konuşma <w>yapacak</w>.",
                                "zh": "总统今晚将向全国<w>发表</w>讲话。"
                            }
                        },
                        {
                            "text": "The jury is expected to <w>deliver</w> a verdict by this afternoon.",
                            "target_lang_translations": {
                                "ru": "Ожидается, что присяжные <w>вынесут</w> вердикт к полудню.",
                                "tr": "Jürinin bugün öğleden sonraya kadar bir karar <w>açıklaması</w> bekleniyor.",
                                "zh": "预计陪审团将在今天下午<w>宣判</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "utter"
                    ],
                    "common_phrases": [
                        "deliver a speech",
                        "deliver a verdict",
                        "deliver a message"
                    ],
                    "target_lang_definitions": {
                        "ru": "Произносить речь или официально объявлять решение (вердикт).",
                        "tr": "Konuşma yapma, karar açıklama veya mesaj verme gibi durumları resmi olarak sunmak.",
                        "zh": "正式地发表讲话、宣布判决或传达信息。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "произносить",
                                "target_lang_sense_clarification": "речь, обращение"
                            },
                            {
                                "target_lang_word": "выносить",
                                "target_lang_sense_clarification": "приговор, вердикт, решение"
                            },
                            {
                                "target_lang_word": "выступать",
                                "target_lang_sense_clarification": "с речью или сообщением"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yapmak",
                                "target_lang_sense_clarification": "konuşma yapmak"
                            },
                            {
                                "target_lang_word": "açıklamak",
                                "target_lang_sense_clarification": "karar veya hüküm bildirmek"
                            },
                            {
                                "target_lang_word": "vermek",
                                "target_lang_sense_clarification": "mesaj veya söylev sunmak"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "发表",
                                "target_lang_sense_clarification": "用于演讲或演说"
                            },
                            {
                                "target_lang_word": "宣判",
                                "target_lang_sense_clarification": "用于法律判决"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f7d1ba06-1ca0-36d0-9b48-2b2aecafbd51",
                    "sense_definition": "To assist a woman in giving birth to a baby, or to give birth.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "birth_context",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor <w>delivered</w> the baby safely in the hospital.",
                            "target_lang_translations": {
                                "ru": "Врач благополучно <w>принял</w> роды в больнице.",
                                "tr": "Doktor, hastanede bebeği güvenle <w>doğurttu</w>.",
                                "zh": "医生在医院里安全地为她<w>接生</w>了孩子。"
                            }
                        },
                        {
                            "text": "She <w>delivered</w> a healthy baby boy yesterday.",
                            "target_lang_translations": {
                                "ru": "Вчера она <w>родила</w> здорового мальчика.",
                                "tr": "Dün sağlıklı bir erkek çocuk <w>dünyaya getirdi</w>.",
                                "zh": "她昨天<w>分娩</w>生下了一个健康的男婴。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "deliver a baby"
                    ],
                    "target_lang_definitions": {
                        "ru": "Принимать роды (о медицинском персонале) или рожать ребенка.",
                        "tr": "Bir kadının doğum yapmasına yardımcı olmak veya doğum yapmak.",
                        "zh": "协助产妇分娩，或指产妇生下孩子。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "принимать роды",
                                "target_lang_sense_clarification": "действие врача или акушерки"
                            },
                            {
                                "target_lang_word": "родить",
                                "target_lang_sense_clarification": "действие матери"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "doğurtmak",
                                "target_lang_sense_clarification": "doktor veya ebe için doğuma yardımcı olmak"
                            },
                            {
                                "target_lang_word": "dünyaya getirmek",
                                "target_lang_sense_clarification": "anne için doğum yapmak"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "接生",
                                "target_lang_sense_clarification": "指医护人员协助分娩"
                            },
                            {
                                "target_lang_word": "分娩",
                                "target_lang_sense_clarification": "指产妇生下孩子"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2809e180-cdab-3948-9738-272a6c7b56d3",
                    "sense_definition": "To set someone free from danger, confinement, or evil.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers fought to <w>deliver</w> the hostages from captivity.",
                            "target_lang_translations": {
                                "ru": "Солдаты сражались, чтобы <w>освободить</w> заложников из плена.",
                                "tr": "Askerler rehineleri esaretten <w>kurtarmak</w> için savaştı.",
                                "zh": "士兵们奋力战斗，将人质从囚禁中<w>解救</w>出来。"
                            }
                        },
                        {
                            "text": "They prayed to be <w>delivered</w> from their enemies.",
                            "target_lang_translations": {
                                "ru": "Они молились, чтобы быть <w>избавленными</w> от врагов.",
                                "tr": "Düşmanlarından <w>kurtarılmak</w> için dua ettiler.",
                                "zh": "他们祈祷能从敌人手中被<w>拯救</w>出来。"
                            }
                        }
                    ],
                    "synonyms": [
                        "free",
                        "liberate",
                        "release",
                        "loose",
                        "rid"
                    ],
                    "common_phrases": [
                        "deliver from evil"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "often used in religious or literary contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Спасать или освобождать кого-либо от опасности, зла или плена (часто в высоком или религиозном стиле).",
                        "tr": "Birini tehlikeden, esaretten veya kötülükten kurtarmak, özgür kılmak.",
                        "zh": "将某人从危险、束缚或邪恶中解救出来。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "избавлять",
                                "target_lang_sense_clarification": "от зла, греха или опасности"
                            },
                            {
                                "target_lang_word": "освобождать",
                                "target_lang_sense_clarification": "из плена или заточения"
                            },
                            {
                                "target_lang_word": "спасать",
                                "target_lang_sense_clarification": "общий смысл спасения"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kurtarmak",
                                "target_lang_sense_clarification": "tehlikeden veya esaretten özgür kılmak"
                            },
                            {
                                "target_lang_word": "azat etmek",
                                "target_lang_sense_clarification": "esaretten salıvermek"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "解救",
                                "target_lang_sense_clarification": "从困境或危险中救出"
                            },
                            {
                                "target_lang_word": "拯救",
                                "target_lang_sense_clarification": "从苦难或邪恶中救赎"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f01f3486-3ce1-3e8e-aa14-8dfd085b004b",
                    "sense_definition": "To give a blow or launch an attack; to throw or send something physically with force.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The boxer <w>delivered</w> a powerful punch to his opponent.",
                            "target_lang_translations": {
                                "ru": "Боксер <w>нанес</w> мощный удар своему противнику.",
                                "tr": "Boksör rakibine güçlü bir yumruk <w>indirdi</w>.",
                                "zh": "拳击手向对手<w>给予</w>了沉重的一击。"
                            }
                        },
                        {
                            "text": "He <w>delivered</w> the ball perfectly into the strike zone.",
                            "target_lang_translations": {
                                "ru": "Он идеально <w>послал</w> мяч в страйк-зону.",
                                "tr": "Topu mükemmel bir şekilde grev bölgesine <w>fırlattı</w>.",
                                "zh": "他完美地将球<w>投出</w>到了好球区。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "deliver a blow",
                        "deliver a punch"
                    ],
                    "target_lang_definitions": {
                        "ru": "Наносить физический удар или с силой бросать/посылать объект.",
                        "tr": "Darbe indirmek, saldırmak veya kuvvetle fiziksel bir şey fırlatmak/göndermek.",
                        "zh": "施加打击、发动攻击，或用力投掷、发送某物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наносить",
                                "target_lang_sense_clarification": "удар (рукой, оружием)"
                            },
                            {
                                "target_lang_word": "посылать",
                                "target_lang_sense_clarification": "мяч или снаряд в цель"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "indirmek",
                                "target_lang_sense_clarification": "darbe veya yumruk vurmak"
                            },
                            {
                                "target_lang_word": "savurmak",
                                "target_lang_sense_clarification": "güçlü bir şekilde vurmak veya fırlatmak"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "给予",
                                "target_lang_sense_clarification": "用于打击或重击"
                            },
                            {
                                "target_lang_word": "投出",
                                "target_lang_sense_clarification": "用于球类运动"
                            }
                        ]
                    }
                }
            ]
        },
        {
