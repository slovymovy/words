                        "entry_id": "9372dfa0-8d47-3849-85c7-b1488f9e7518",
                        "glosses": [
                            "Unthinking, not carefully considered, (nearly) automatic, spontaneous, easily predictable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9d89f8a-c2f1-4d0b-98fd-37e886111521",
                                "sense_id": "86404abd-9457-37d0-921a-303742332eca",
                                "text": "He gave a knee-jerk response."
                            },
                            {
                                "example_id": "76394bb9-d847-4349-a879-b51846595f26",
                                "sense_id": "86404abd-9457-37d0-921a-303742332eca",
                                "text": "There were knee-jerk demands from trade unions for immediate withdrawal of all HSTs; these were wrong-headed."
                            },
                            {
                                "example_id": "a963b4be-9208-4503-a3e2-ad4400c68e28",
                                "sense_id": "86404abd-9457-37d0-921a-303742332eca",
                                "text": "The knee-jerk reaction is further evidence of just how panicked investors are about the stability of the global financial system after the collapse of Silicon Valley Bank last week."
                            }
                        ]
                    }
                ],
                "translations": [
