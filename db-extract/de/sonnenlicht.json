                                        "glosses": [
                                            "de zichtbare elektromagnetische straling van de ster waarrond onze aarde draait"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad973495-fe64-4eba-a5b1-148a9089eb1c",
                                                "sense_id": "06913118-09ac-306f-a8ae-2cf43367e3e1",
                                                "text": "De vlaggen van de VOC-schepen hadden de neiging in het felle zonlicht van de tropen te verbleken."
                                            },
                                            {
                                                "example_id": "787de8ca-31c6-48c8-89d9-97aed51f2021",
                                                "sense_id": "06913118-09ac-306f-a8ae-2cf43367e3e1",
                                                "text": "De mannen dragen allemaal een rode sjerp over hun brede borstkas, en de kleur weerkaatst het winterse zonlicht als een serpentine van bloed."
                                            },
                                            {
                                                "example_id": "43a7af04-c994-4cbf-b737-df98628745d8",
                                                "sense_id": "06913118-09ac-306f-a8ae-2cf43367e3e1",
                                                "text": "Terwijl ze in de met zonlicht gevlekte schaduw staat, trekt het geluid van splinterend hout haar aandacht."
                                            }
                                        ]
