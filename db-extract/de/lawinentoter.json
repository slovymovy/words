                ],
                "senses": [
                    {
                        "sense_id": "a744141a-081f-3ceb-b1d0-a42344c16792",
                        "entry_id": "c82a64a3-0ec1-3977-8337-6b817031b079",
                        "glosses": [
                            "Person, die durch einen Lawinenabgang zu Tode gekommen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64ead63b-b33a-4934-b021-a63f6a87f840",
                                "sense_id": "a744141a-081f-3ceb-b1d0-a42344c16792",
                                "text": "„Je nach Schätzung gibt es in Österreich 350.000 bis 650.000 aktive Skitourengeher. Trotzdem ist die Zahl der Lawinentoten über Jahrzehnte hinweg konstant.“"
                            },
                            {
                                "example_id": "0e0b2e3a-2bc5-4d50-9b27-b336762db165",
                                "sense_id": "a744141a-081f-3ceb-b1d0-a42344c16792",
                                "text": "„Dieser Winter hat mit ungewöhnlich vielen Lawinentoten begonnen.“"
                            },
                            {
                                "example_id": "152f582b-0b09-484b-b159-6406db88f5d8",
                                "sense_id": "a744141a-081f-3ceb-b1d0-a42344c16792",
                                "text": "„Nach mehreren Lawinentoten in Österreich warnt der Alpenverein Feldkirchen vor Leichtsinn.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
