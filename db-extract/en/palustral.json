                        "source_entry_id": "974c3ace-665a-31ff-9bcc-e8573cafe3d0",
                        "source_sense_description": "Pertaining to or living in marshes; marshy",
                        "target_lang_word": "болотный",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "болотный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "996f3dd5-7235-3c26-8b59-b7ace2ffeb64",
                                        "entry_id": "7725eedc-ee9c-35ab-8684-53079b7c27bc",
                                        "glosses": [
                                            "связанный, соотносящийся по значению с существительным болото"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae712260-5464-4825-9acc-d81ab5c0292b",
                                                "sense_id": "996f3dd5-7235-3c26-8b59-b7ace2ffeb64",
                                                "text": "С равнины тянуло горьким миндальным запахом болотных цветов."
                                            },
                                            {
                                                "example_id": "d8ce0977-7eeb-4bd8-b35d-d991c9d0d7f8",
                                                "sense_id": "996f3dd5-7235-3c26-8b59-b7ace2ffeb64",
                                                "text": "Кричали болотные птицы, ухал филин, бурчала под ногами жидкая земля, выпуская пузыри."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "346def61-7558-3f45-837a-65e879907a99",
                                        "entry_id": "7725eedc-ee9c-35ab-8684-53079b7c27bc",
                                        "glosses": [
                                            "свойственный болоту, характерный для него"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e684bd5-b462-4bc8-b188-deeb626c9418",
                                                "sense_id": "346def61-7558-3f45-837a-65e879907a99",
                                                "text": "Ему словно в нос ударило .. болотной сыростью .."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f8c297f-cbe9-341f-beed-7b68926dd0bb",
                                        "entry_id": "7725eedc-ee9c-35ab-8684-53079b7c27bc",
                                        "glosses": [
                                            "цветом напоминающий воду в болоте или траву, растущую на болоте; тёмно-зелёный с желтоватым оттенком"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11154828-df27-47d9-93f4-2a06b6b00e64",
                                                "sense_id": "9f8c297f-cbe9-341f-beed-7b68926dd0bb",
                                                "text": "— Нет, у меня не совсем зелёные, у меня такие… зеленовато-коричневые. Болотного цвета ― вот! А у неё были зелёные."
                                            }
                                        ]
                                    }
