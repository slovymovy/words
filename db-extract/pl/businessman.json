                                "target_senses": [
                                    {
                                        "sense_id": "7d971495-c995-30f2-8bfd-4d1f8f5b0e33",
                                        "entry_id": "daffd524-b792-3b51-9979-68af0621e6dd",
                                        "glosses": [
                                            "A man in business, one who works at a commercial institution."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40223a77-90aa-45f1-ae90-fb577236aede",
                                                "sense_id": "7d971495-c995-30f2-8bfd-4d1f8f5b0e33",
                                                "text": "I'm not a businessman, I'm a business, man"
                                            },
                                            {
                                                "example_id": "dd71e9e8-cc96-4878-aef4-6cb1360fbf22",
                                                "sense_id": "7d971495-c995-30f2-8bfd-4d1f8f5b0e33",
                                                "text": "BERTIE Ahern's explanation that he received an envelope stuffed with £8,000 in cash following a whip-around by a group of Manchester-based businessmen was branded untrue by the Mahon Tribunal."
                                            },
                                            {
                                                "example_id": "d9d569cb-1f71-4a8b-bb4b-36b680800643",
                                                "sense_id": "7d971495-c995-30f2-8bfd-4d1f8f5b0e33",
                                                "text": "Needless to say the obituaries for Hefner, even if they acknowledge the seaminess, have been full of encomia for his great deeds: Hef the vanquisher of puritanism, Hef the political progressive, Hef the great businessman and all the rest."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "90d56829-319c-406f-8066-d14325bf933f",
                        "source_entry_id": "35a38a44-8a6d-3068-9344-6596dcf0dad8",
                        "source_sense_id": "78b61b6d-8df4-3ea3-9c88-bb9f024c3d87",
                        "target_lang_word": "businessman",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "businessman",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8e8c8b6f-d79b-3968-8454-032b0f481fef",
                                        "entry_id": "0ed99205-1995-3622-ac47-53d637b4dfd9",
                                        "glosses": [
                                            "Homme d’affaires."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8161b8ea-2b01-456d-b13a-3ea53f7d304f",
                                                "sense_id": "8e8c8b6f-d79b-3968-8454-032b0f481fef",
                                                "text": "Langlois était médusé. Quelle galanterie, chez ces businessmans du Nouveau Monde !"
                                            },
                                            {
                                                "example_id": "47c01789-048c-451a-9056-1016f76bc7b3",
                                                "sense_id": "8e8c8b6f-d79b-3968-8454-032b0f481fef",
                                                "text": "— Tout ce beau discours pour finalement faire sa petite pub, les businessmen n'ont pas de cœur.\nMalgré une profonde mélancolie envers la ludographie de l'auteur, Jean ne put s'empêcher de se le dire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
