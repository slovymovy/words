                "senses": [
                    {
                        "sense_id": "4a440b7c-4a05-3580-9b00-27f0ad44b4ff",
                        "entry_id": "5e32ecd4-7c53-3560-87b8-2460179522bb",
                        "glosses": [
                            "S’encanailler à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "636aa6fd-d3e6-450e-925c-f481907be52e",
                                "sense_id": "4a440b7c-4a05-3580-9b00-27f0ad44b4ff",
                                "text": "Quel délice en rentrant chez moi de remplacer l’habit noir par ma vareuse, d’allumer une cigarette et de me rencanailler !"
                            },
                            {
                                "example_id": "efb6c25f-ee27-4d1c-83cd-30b716795479",
                                "sense_id": "4a440b7c-4a05-3580-9b00-27f0ad44b4ff",
                                "text": "Elle a besoin parfois de se rencanailler !"
                            },
                            {
                                "example_id": "1316d338-3045-4708-a3e7-3040ad1ba0f3",
                                "sense_id": "4a440b7c-4a05-3580-9b00-27f0ad44b4ff",
                                "text": "Il faudrait pour cela que j’allasse me rencanailler du côté des soirées de chez Mollat, mais il y a tant de conneries qu’on édite…"
                            }
                        ]
                    }
