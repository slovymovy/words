                "senses": [
                    {
                        "sense_id": "733dffd2-5479-365e-b09b-792bfbaf0448",
                        "entry_id": "4485bd5d-7ec8-3806-875a-a511d0257776",
                        "glosses": [
                            "Reaktion auf eine Beschuldigung in Form einer Beschuldigung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "779dfcbc-a415-4d09-bd82-4cf741ebc190",
                                "sense_id": "733dffd2-5479-365e-b09b-792bfbaf0448",
                                "text": "„Verwoerd zeigte schon zu dieser Zeit einen seiner kennzeichnenden Charakterzüge, nämlich dass er zu Selbstkritik völlig unfähig war und, wenn er mit Kritik konfrontiert wurde, sofort mit Gegenbeschuldigungen antwortete.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dfd8cd19-034c-49c8-b5c8-c1a3652d692e",
                        "source_entry_id": "4485bd5d-7ec8-3806-875a-a511d0257776",
                        "source_sense_id": "733dffd2-5479-365e-b09b-792bfbaf0448",
                        "source_sense_description": "Beschuldigung als Antwort auf eine Beschuldigung",
                        "target_lang_word": "counteraccusation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "counteraccusation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fbea4d42-1a61-3099-a084-f214e9411a1f",
                                        "entry_id": "4207f70f-92f2-3224-af8b-caa95149000d",
                                        "glosses": [
                                            "An accusation made in reply to another accusation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bca0bd79-559a-4104-acb4-4ae87489b101",
                                                "sense_id": "fbea4d42-1a61-3099-a084-f214e9411a1f",
                                                "text": "He smoked three cigarettes, dissolving his anxiety in rationalizations and counteraccusations and a fresh resolve to stay in Lithuania until he could pay his sister the $20,500 that he owed her."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "048076b8-6ab3-4a77-8c5c-68be3cb0fd0b",
                        "source_entry_id": "4485bd5d-7ec8-3806-875a-a511d0257776",
                        "source_sense_id": "733dffd2-5479-365e-b09b-792bfbaf0448",
