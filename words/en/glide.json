{
    "word_family": [
        "glider",
        "glidingly"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0075f6c0-21ab-3564-9e61-fd556b9d421d",
                    "sense_definition": "To move softly, smoothly, or effortlessly.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The swan <w>glides</w> across the calm lake water.",
                            "target_lang_translations": {
                                "zh": "天鹅在平静的湖面上<w>滑行</w>。",
                                "ru": "Лебедь <w>скользит</w> по спокойной глади озера.",
                                "nl": "De zwaan <w>glijdt</w> over het kalme water van het meer.",
                                "cs": "Labuť <w>pluje</w> po klidné hladině jezera."
                            }
                        },
                        {
                            "text": "The dancer <w>glides</w> across the stage with grace.",
                            "target_lang_translations": {
                                "zh": "舞者优雅地在舞台上<w>滑行</w>。",
                                "ru": "Танцор грациозно <w>скользит</w> по сцене.",
                                "nl": "De danser <w>glijdt</w> gracieus over het toneel.",
                                "cs": "Tanečník ladně <w>klouže</w> po jevišti."
                            }
                        }
                    ],
                    "synonyms": [
                        "slide"
                    ],
                    "common_phrases": [
                        "glide across"
                    ],
                    "target_lang_definitions": {
                        "zh": "指平稳、轻柔或毫不费力地移动。",
                        "ru": "Плавно, мягко или без усилий перемещаться.",
                        "nl": "Zich zacht, soepel of moeiteloos voortbewegen.",
                        "cs": "Pohybovat se měkce, hladce nebo bez námahy."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "滑行",
                                "target_lang_sense_clarification": "指平稳地移动。"
                            },
                            {
                                "target_lang_word": "溜",
                                "target_lang_sense_clarification": "指轻快地移动。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "скользить",
                                "target_lang_sense_clarification": "плавное движение по поверхности"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "glijden",
                                "target_lang_sense_clarification": "zich met weinig wrijving voortbewegen"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "klouzat",
                                "target_lang_sense_clarification": "hladký, plynulý pohyb"
                            },
                            {
                                "target_lang_word": "plout",
                                "target_lang_sense_clarification": "přenesený význam pro ladný pohyb"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9c9d5b32-1d76-3a08-925b-d345a36e7039",
                    "sense_definition": "To fly without using an engine, as of an aircraft or bird.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The eagle <w>glides</w> on the warm air currents.",
                            "target_lang_translations": {
                                "zh": "老鹰在暖气流上<w>滑翔</w>。",
                                "ru": "Орел <w>планирует</w> на теплых воздушных потоках.",
                                "nl": "De adelaar <w>zweeft</w> op de warme luchtstromen.",
                                "cs": "Orel <w>plachtí</w> na teplých vzdušných proudech."
                            }
                        },
                        {
                            "text": "The pilot <w>glides</w> the plane down to the runway.",
                            "target_lang_translations": {
                                "zh": "飞行员让飞机<w>滑翔</w>降落在跑道上。",
                                "ru": "Пилот <w>планирует</w> на самолете к взлетно-посадочной полосе.",
                                "nl": "De piloot <w>laat</w> het vliegtuig naar de landingsbaan <w>zweven</w>.",
                                "cs": "Pilot <w>doplachtil</w> s letadlem na přistávací dráhu."
                            }
                        }
                    ],
                    "synonyms": [
                        "coast"
                    ],
                    "common_phrases": [
                        "glide on"
                    ],
                    "target_lang_definitions": {
                        "zh": "指飞行器或鸟类不使用动力而飞行。",
                        "ru": "Лететь без использования двигателя (о птицах или летательных аппаратах).",
                        "nl": "Vliegen zonder gebruik van een motor, zoals bij een vliegtuig of vogel.",
                        "cs": "Létat bez použití motoru, jako u letadla nebo ptáka."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "滑翔",
                                "target_lang_sense_clarification": "指不依靠动力在空中滑行。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "планировать",
                                "target_lang_sense_clarification": "постепенное снижение в полете без двигателя"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "zweven",
                                "target_lang_sense_clarification": "vliegen zonder energie te gebruiken"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "plachtit",
                                "target_lang_sense_clarification": "let bez pohonu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f357a393-8dc0-309d-a7d6-d78f2282d84c",
                    "sense_definition": "To cause something to move in a smooth, effortless way.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>glides</w> the heavy door shut quietly.",
                            "target_lang_translations": {
                                "zh": "他轻轻地<w>推动</w>沉重的大门，把它关上。",
                                "ru": "Он тихо <w>задвигает</w> тяжелую дверь.",
                                "nl": "Hij <w>laat</w> de zware deur geruisloos <w>dichtglijden</w>.",
                                "cs": "Tiše <w>nechal sklouznout</w> těžké dveře do zavřené polohy."
                            }
                        },
                        {
                            "text": "She <w>glides</w> the brush over the canvas.",
                            "target_lang_translations": {
                                "zh": "她让画笔在画布上平稳地<w>滑过</w>。",
                                "ru": "Она плавно <w>ведет</w> кистью по холсту.",
                                "nl": "Ze <w>laat</w> de kwast soepel over het doek <w>glijden</w>.",
                                "cs": "Hladce <w>vede</w> štětec po plátně."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "使某物平稳、轻松地移动。",
                        "ru": "Заставлять что-либо двигаться плавно и без усилий.",
                        "nl": "Iets op een soepele, moeiteloze manier laten bewegen.",
                        "cs": "Způsobit, aby se něco pohybovalo hladce a bez námahy."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "推动",
                                "target_lang_sense_clarification": "指平稳地移动某物。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "плавно двигать",
                                "target_lang_sense_clarification": "перемещение объекта без рывков"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "laten glijden",
                                "target_lang_sense_clarification": "iets soepel verplaatsen"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "nechat klouzat",
                                "target_lang_sense_clarification": "hladký posun předmětu"
                            },
                            {
                                "target_lang_word": "posouvat",
                                "target_lang_sense_clarification": "plynulý pohyb předmětu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d9389a0b-a587-351c-b292-7a646b56b138",
                    "sense_definition": "To transition smoothly between notes or sounds with the voice.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The singer <w>glides</w> between the two notes perfectly.",
                            "target_lang_translations": {
                                "zh": "歌手在两个音符之间完美地<w>滑音</w>过渡。",
                                "ru": "Певец идеально <w>переходит</w> между двумя нотами.",
                                "nl": "De zanger <w>glijdt</w> perfect tussen de twee noten door.",
                                "cs": "Zpěvák dokonale <w>přechází</w> mezi dvěma tóny."
                            }
                        },
                        {
                            "text": "She <w>glides</w> her voice up to the high register.",
                            "target_lang_translations": {
                                "zh": "她让声音平滑地<w>滑</w>向高音区。",
                                "ru": "Она плавно <w>переводит</w> голос в высокий регистр.",
                                "nl": "Ze <w>glijdt</w> met haar stem naar het hoge register.",
                                "cs": "Hladce <w>převedla</w> svůj hlas do vysokého registru."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指声音在音高之间平滑过渡。",
                        "ru": "Плавный переход голосом между нотами или звуками.",
                        "nl": "Het soepel overgaan tussen noten of klanken met de stem.",
                        "cs": "Plynulý přechod mezi tóny nebo zvuky hlasem."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "滑音",
                                "target_lang_sense_clarification": "指音高间的平滑过渡。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "глиссандо",
                                "target_lang_sense_clarification": "музыкальный термин для плавного перехода"
                            },
                            {
                                "target_lang_word": "плавный переход",
                                "target_lang_sense_clarification": "общее описание вокального приема"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "glijden",
                                "target_lang_sense_clarification": "muzikale overgang tussen tonen"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "glissando",
                                "target_lang_sense_clarification": "hudební termín pro plynulý přechod"
                            },
                            {
                                "target_lang_word": "přecházet",
                                "target_lang_sense_clarification": "plynulý hlasový přechod"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a5378e95-792a-3877-8dac-d361d09fd7ed",
                    "sense_definition": "The act of moving in a smooth, effortless way.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>glide</w> of the skater was beautiful to watch.",
                            "target_lang_translations": {
                                "zh": "滑冰者那优美的<w>滑行</w>动作令人赏心悦目。",
                                "ru": "За <w>скольжением</w> фигуриста было приятно наблюдать.",
                                "nl": "De <w>glijbeweging</w> van de schaatser was prachtig om te zien.",
                                "cs": "Na <w>skluz</w> bruslaře byla radost pohledět."
                            }
                        },
                        {
                            "text": "The smooth <w>glide</w> across the ice felt amazing.",
                            "target_lang_translations": {
                                "zh": "在冰面上平稳地<w>滑行</w>感觉棒极了。",
                                "ru": "Плавное <w>скольжение</w> по льду было восхитительным.",
                                "nl": "Het soepele <w>glijden</w> over het ijs voelde geweldig.",
                                "cs": "Ten hladký <w>skluz</w> po ledu byl úžasný."
                            }
                        }
                    ],
                    "synonyms": [
                        "slide"
                    ],
                    "common_phrases": [
                        "smooth glide"
                    ],
                    "target_lang_definitions": {
                        "zh": "平稳、轻松移动的动作。",
                        "ru": "Процесс плавного и легкого движения.",
                        "nl": "De handeling van het soepel en moeiteloos bewegen.",
                        "cs": "Akt hladkého a nenamáhavého pohybu."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "滑行",
                                "target_lang_sense_clarification": "指平稳移动的动作。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "скольжение",
                                "target_lang_sense_clarification": "процесс плавного перемещения"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "glijbeweging",
                                "target_lang_sense_clarification": "de actie van het glijden"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "skluz",
                                "target_lang_sense_clarification": "pohyb klouzáním"
                            },
                            {
                                "target_lang_word": "klouzání",
                                "target_lang_sense_clarification": "proces pohybu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "33f52b65-1065-3263-8890-8390d31a4ece",
                    "sense_definition": "A transitional sound, especially a semivowel.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sound in the middle is a <w>glide</w>.",
                            "target_lang_translations": {
                                "zh": "中间的那个音是一个<w>滑音</w>。",
                                "ru": "Звук посередине — это <w>скользящий звук</w>.",
                                "nl": "De klank in het midden is een <w>glijklank</w>.",
                                "cs": "Ten zvuk uprostřed je <w>polosamohláska</w>."
                            }
                        },
                        {
                            "text": "Phonetically, this <w>glide</w> connects the two vowels.",
                            "target_lang_translations": {
                                "zh": "在语音学上，这个<w>滑音</w>连接了两个元音。",
                                "ru": "Фонетически этот <w>переходный звук</w> соединяет два гласных.",
                                "nl": "Fonetisch gezien verbindt deze <w>glijklank</w> de twee klinkers.",
                                "cs": "Foneticky tento <w>přechodový zvuk</w> spojuje dvě samohlásky."
                            }
                        }
                    ],
                    "synonyms": [
                        "semivowel",
                        "semiconsonant"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种过渡音，尤指半元音。",
                        "ru": "Переходный звук, особенно полугласный.",
                        "nl": "Een overgangsklank, in het bijzonder een halfklinker.",
                        "cs": "Přechodový zvuk, zejména polosamohláska."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "滑音",
                                "target_lang_sense_clarification": "语音学中的过渡音。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "скользящий звук",
                                "target_lang_sense_clarification": "лингвистический термин"
                            },
                            {
                                "target_lang_word": "полугласный",
                                "target_lang_sense_clarification": "фонетическая классификация"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "glijklank",
                                "target_lang_sense_clarification": "taalkundige term voor een overgangsklank"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "polosamohláska",
                                "target_lang_sense_clarification": "lingvistický termín"
                            },
                            {
                                "target_lang_word": "přechodový zvuk",
                                "target_lang_sense_clarification": "fonetický popis"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a2480a9b-c762-3eba-92b5-dd89d6d1280a",
                    "sense_definition": "The joining of two sounds without a break.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>glide</w> between the words makes them sound like one.",
                            "target_lang_translations": {
                                "zh": "词与词之间的<w>连读</w>使它们听起来像是一个词。",
                                "ru": "Плавное <w>слияние</w> между словами делает их звучащими как одно целое.",
                                "nl": "De <w>vloeiende overgang</w> tussen de woorden zorgt ervoor dat ze als één klinken.",
                                "cs": "Díky <w>plynulému přechodu</w> mezi slovy znějí jako jedno."
                            }
                        },
                        {
                            "text": "A natural <w>glide</w> is essential for fluent speech.",
                            "target_lang_translations": {
                                "zh": "自然的<w>连读</w>对于流利的口语至关重要。",
                                "ru": "Естественное <w>слияние</w> звуков необходимо для беглой речи.",
                                "nl": "Een natuurlijke <w>vloeiende overgang</w> is essentieel voor vloeiend spreken.",
                                "cs": "Přirozená <w>vázaná výslovnost</w> je pro plynulou řeč nezbytná."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "两个声音之间不间断的连接。",
                        "ru": "Соединение двух звуков без паузы.",
                        "nl": "Het verbinden van twee klanken zonder onderbreking.",
                        "cs": "Spojení dvou zvuků bez přerušení."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "连读",
                                "target_lang_sense_clarification": "指声音间的平滑连接。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "слитное произношение",
                                "target_lang_sense_clarification": "отсутствие паузы между звуками"
                            },
                            {
                                "target_lang_word": "связная речь",
                                "target_lang_sense_clarification": "плавность потока речи"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "vloeiende overgang",
                                "target_lang_sense_clarification": "het naadloos verbinden van klanken"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "vázaná výslovnost",
                                "target_lang_sense_clarification": "plynulé spojení zvuků"
                            },
                            {
                                "target_lang_word": "plynulý přechod",
                                "target_lang_sense_clarification": "spojení bez pauzy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "778d7cd2-b160-386a-b020-79fe1b726c70",
                    "sense_definition": "A smooth and sliding step in dancing the waltz.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dancer performed a graceful <w>glide</w> across the floor.",
                            "target_lang_translations": {
                                "zh": "舞者在地板上完成了一个优雅的<w>滑步</w>。",
                                "ru": "Танцор выполнил изящный <w>скользящий шаг</w> по полу.",
                                "nl": "De danser voerde een sierlijke <w>glijpas</w> over de vloer uit.",
                                "cs": "Tanečník předvedl ladný <w>klouzavý krok</w> po parketu."
                            }
                        },
                        {
                            "text": "Mastering the <w>glide</w> is important for the waltz.",
                            "target_lang_translations": {
                                "zh": "掌握<w>滑步</w>对于跳华尔兹很重要。",
                                "ru": "Освоение <w>скользящего шага</w> важно для вальса.",
                                "nl": "Het beheersen van de <w>glijpas</w> is belangrijk voor de wals.",
                                "cs": "Zvládnutí <w>klouzavého kroku</w> je pro valčík důležité."
                            }
                        }
                    ],
                    "synonyms": [
                        "slide"
                    ],
                    "target_lang_definitions": {
                        "zh": "华尔兹舞中一种平滑的滑动舞步。",
                        "ru": "Плавный скользящий шаг в вальсе.",
                        "nl": "Een soepele, glijdende stap in de wals.",
                        "cs": "Hladký a klouzavý krok v tanci valčík."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "滑步",
                                "target_lang_sense_clarification": "舞蹈中的滑动步法。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "скользящий шаг",
                                "target_lang_sense_clarification": "танцевальное движение"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "glijpas",
                                "target_lang_sense_clarification": "dansstap in de wals"
