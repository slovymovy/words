                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cb345bd4-7936-3745-8e6e-77505872e6f9",
                                        "entry_id": "42bd134b-8b2e-365e-a504-cdd94acf304f",
                                        "glosses": [
                                            "To beg on All Soul's Day."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "087bec81-8911-48a8-87e5-6c872f238973",
                                                "sense_id": "cb345bd4-7936-3745-8e6e-77505872e6f9",
                                                "text": "All Souls' Day was celebrated by souling, a custom going back to pre-Reformation days: soul cakers and mummers toured the village begging for a soul cake — a plain, round, flat cake seasoned with spices."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "soul",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2baf539a-e7f0-36c6-9afa-14b7d08703a9",
                                        "entry_id": "99686f3a-1ef8-39e1-a51b-772d575c5328",
                                        "glosses": [
                                            "To feed or nourish."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c557a94f-ab0a-41c3-880e-6a8a062f24f0",
                                                "sense_id": "2baf539a-e7f0-36c6-9afa-14b7d08703a9",
                                                "text": "During my Stay here, I was going to take Pot-Luck with Colonel Ingram, and accidentally meeting him in the Way, I told him I deſigned to ſoul a Plate with him, [...]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
