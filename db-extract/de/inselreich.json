                                "sense_id": "39bbcf35-72bb-3ea4-a765-2678ca63c9fb",
                                "text": "„Das Inselreich besteht aus zehn bewohnten und fünf kleinen Inseln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "972055db-d6bc-3743-8e1a-2a9fe79e6aa6",
