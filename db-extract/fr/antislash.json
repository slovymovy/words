                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "0ede85a2-68ec-4d06-92a1-5f6c5668c323",
                        "entry_id": "84865b54-c025-356e-aae4-1353a3f8754c",
