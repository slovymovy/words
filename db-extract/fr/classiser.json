                "senses": [
                    {
                        "sense_id": "1509c3db-f390-3d05-8902-8d8e8132d4f1",
                        "entry_id": "66abc8a9-ce0a-3914-b8f7-379c3f8227a1",
                        "glosses": [
                            "Donner un caractère classe à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a690abe-a99c-4a8d-946a-3a259594e4ae",
                                "sense_id": "1509c3db-f390-3d05-8902-8d8e8132d4f1",
                                "text": "Elles sont parfaites à associer avec une petite robe ou « classiser » un look rock !"
                            },
                            {
                                "example_id": "3f56d4e9-44a3-4b29-809d-c4c3149d147d",
                                "sense_id": "1509c3db-f390-3d05-8902-8d8e8132d4f1",
                                "text": "De telles chaussures ont l'art de \"classiser\" une tenue, c'est pourquoi j'ai certainement voulu les casser avec un jean et cette chemise!"
                            },
                            {
                                "example_id": "ef41b4e4-5e46-476c-80ff-85188c547da6",
                                "sense_id": "1509c3db-f390-3d05-8902-8d8e8132d4f1",
                                "text": "Je souhaiterais avoir votre opinion pour savoir comment classiser une tenue avec ces bottes"
                            },
                            {
                                "example_id": "341c676d-eff8-40b4-9722-81a3a686f7ab",
                                "sense_id": "1509c3db-f390-3d05-8902-8d8e8132d4f1",
                                "text": "Bon compromis entre la cape et le trench, il permet de \"classiser\" n’importe quel jean."
                            }
                        ]
                    }
