                        "glosses": [
                            "Gericht, das zu Weihnachten eingenommen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3304949e-d4d9-41a7-b3a9-a57b539f063d",
                                "sense_id": "2520c32b-4c38-39fe-b385-cb419d600038",
                                "text": "„So ein holländisches Weihnachtsessen muss mindestens sechs Gänge haben und vor allem aus den allerkompliziertesten Gerichten bestehen, am liebsten aus der hohen französischen Küche.“"
                            }
                        ],
