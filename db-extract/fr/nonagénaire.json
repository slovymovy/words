                    }
                ],
                "senses": [
                    {
                        "sense_id": "b5583f59-eb9d-3a9c-ad9c-293ab9ad2494",
                        "entry_id": "b57b4862-475b-3c4d-b284-11fb8b83b487",
                        "glosses": [
                            "Qui est âgé de 90 ans ou environ."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "584397a0-55c9-4591-a67d-f8a1e9ac194c",
                                "sense_id": "b5583f59-eb9d-3a9c-ad9c-293ab9ad2494",
                                "text": "Un homme, une femme nonagénaire."
                            },
                            {
                                "example_id": "e60e76bf-dd7d-47e3-927b-1ad67108ceb0",
                                "sense_id": "b5583f59-eb9d-3a9c-ad9c-293ab9ad2494",
                                "text": "Bartholoméo Belvidéro, père de don Juan, était un vieillard nonagénaire qui avait passé la majeure partie de sa vie dans les combinaisons du commerce."
                            },
                            {
                                "example_id": "7f1862cf-109e-46dc-a362-bf0468d7fabf",
                                "sense_id": "b5583f59-eb9d-3a9c-ad9c-293ab9ad2494",
                                "text": "Les visiteurs jetaient sur Lecœur un regard curieux, en songeant à la nature des relations qui s’étaient établies entre ce garçon de vingt ans et la veuve nonagénaire qui devait être sa victime."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "470e355d-f714-4ec5-b5ed-b2c8085b02c3",
                        "source_entry_id": "b57b4862-475b-3c4d-b284-11fb8b83b487",
                        "source_sense_id": "b5583f59-eb9d-3a9c-ad9c-293ab9ad2494",
                        "target_lang_word": "nonagenarian",
