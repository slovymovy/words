{
    "word_family": [
        "sloshy"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "79885389-91f7-3fee-86b4-374808ec1e66",
                    "sense_definition": "A quantity of liquid that is larger than a splash.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "liquid_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We added a <w>slosh</w> of white wine to the sauce.",
                            "target_lang_translations": {
                                "cs": "Přidali jsme do omáčky <w>pořádnou dávku</w> bílého vína."
                            }
                        },
                        {
                            "text": "He poured a generous <w>slosh</w> of milk into his morning coffee.",
                            "target_lang_translations": {
                                "cs": "Nalil si do ranní kávy <w>pořádnou dávku</w> mléka."
                            }
                        }
                    ],
                    "common_phrases": [
                        "a slosh of"
                    ],
                    "target_lang_definitions": {
                        "cs": "Množství tekutiny větší než cákance nebo malé šplíchnutí."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "pořádná dávka",
                                "target_lang_sense_clarification": "množství tekutiny, ne úplně malé"
                            },
                            {
                                "target_lang_word": "trocha",
                                "target_lang_sense_clarification": "neurčité menší množství tekutiny, např. při vaření"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "98f9303c-b8fc-3ce8-8967-4849eb242f64",
                    "sense_definition": "A mixture of melting snow and mud.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "liquid_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Shoes and socks, soaked and frozen in the mud and icy <w>slosh</w>, did little to protect their feet.",
                            "target_lang_translations": {
                                "cs": "Boty a ponožky, promočené a zmrzlé v blátě a ledové <w>břečce</w>, jejich chodidla téměř nechránily."
                            }
                        },
                        {
                            "text": "The winter streets were covered in a thick, grey <w>slosh</w>.",
                            "target_lang_translations": {
                                "cs": "Zimní ulice pokrývala hustá šedá <w>břečka</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Směs tajícího sněhu a bláta."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "břečka",
                                "target_lang_sense_clarification": "rozbředlá směs sněhu a bláta na zemi"
                            },
                            {
                                "target_lang_word": "rozbředlý sníh",
                                "target_lang_sense_clarification": "tající špinavý sníh smíchaný s vodou a blátem"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cec51a68-61e5-30e5-9500-83f3d1028f90",
                    "sense_definition": "The sound or motion of liquid moving around inside a container.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "liquid_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I could hear the <w>slosh</w> of water inside the half-empty bucket.",
                            "target_lang_translations": {
                                "cs": "Slyšel jsem <w>šplouchání</w> vody uvnitř poloprázdného kbelíku."
                            }
                        },
                        {
                            "text": "The rhythmic <w>slosh</w> of the waves against the boat was very relaxing.",
                            "target_lang_translations": {
                                "cs": "Rytmické <w>šplouchání</w> vln o loď bylo velmi uklidňující."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Zvuk nebo pohyb kapaliny, která se přelévá uvnitř nádoby."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "šplouchání",
                                "target_lang_sense_clarification": "zvuk nebo pohyb kapaliny přelévající se v nádobě"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "158caacc-be5f-375d-b740-61d297ba384c",
                    "sense_definition": "Low-quality or inferior alcoholic drink.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "liquid_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "These bottles were once known for being nothing more than cheap <w>slosh</w>.",
                            "target_lang_translations": {
                                "cs": "Tyhle lahve kdysi platily jen za levný <w>patok</w>."
                            }
                        },
                        {
                            "text": "He refused to drink the <w>slosh</w> they were serving at the party.",
                            "target_lang_translations": {
                                "cs": "Odmítl pít ten <w>mizerný chlast</w>, který na večírku podávali."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal term for bad alcohol."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Nekvalitní nebo podřadný alkoholický nápoj."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "patok",
                                "target_lang_sense_clarification": "nekvalitní levný alkohol"
                            },
                            {
                                "target_lang_word": "mizerný chlast",
                                "target_lang_sense_clarification": "hovorově o špatném alkoholu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f14ec5c2-fc1b-3181-8da7-9b12958bea99",
                    "sense_definition": "A variation of the game of billiards.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "no",
                    "name_type": "game_or_sport_name",
                    "examples": [
                        {
                            "text": "They retired to the billiard-room for a game of <w>slosh</w>.",
                            "target_lang_translations": {
                                "cs": "Odebrali se do kulečníkového salonu zahrát si <w>slosh</w>."
                            }
                        },
                        {
                            "text": "Few people today know the rules of the old game called <w>slosh</w>.",
                            "target_lang_translations": {
                                "cs": "Dnes už málokdo zná pravidla staré hry zvané <w>slosh</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Refers to an older, less common game."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Varianta kulečníkové hry."
                    },
                    "translations": {
                        "cs": []
                    }
                },
                {
                    "sense_id": "7ae47cea-7022-3504-84fd-c7489a22b19a",
                    "sense_definition": "The backslash character (\\).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In some technical contexts, the backslash is referred to as a <w>slosh</w>.",
                            "target_lang_translations": {
                                "cs": "V některých technických kontextech se zpětnému lomítku říká <w>slosh</w>."
                            }
                        },
                        {
                            "text": "Type a <w>slosh</w> before the file path.",
                            "target_lang_translations": {
                                "cs": "Napiš před cestu k souboru <w>zpětné lomítko</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Used in technical jargon."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Znak zpětné lomítko (\\\\)."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "zpětné lomítko",
                                "target_lang_sense_clarification": "v technickém slangu název znaku \\\\"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d9af1916-f572-3e4a-8100-b3e2727c39f2",
                    "sense_definition": "To move liquid around noisily inside a container.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "liquid_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The water in his bottle <w>sloshed</w> back and forth as he ran.",
                            "target_lang_translations": {
                                "cs": "Voda v jeho láhvi při běhu sem a tam <w>šplouchala</w>."
                            }
                        },
                        {
                            "text": "I could hear the soup <w>sloshing</w> in the pot.",
                            "target_lang_translations": {
                                "cs": "Slyšel jsem, jak polévka v hrnci <w>šplouchá</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Pohybovat kapalinou hlučně sem a tam uvnitř nádoby."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "šplouchat",
                                "target_lang_sense_clarification": "o kapalině v nádobě: hlučně se přelévat sem a tam"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "47fd088e-2e49-3f42-a49a-d1d6d0af09a5",
                    "sense_definition": "To cause liquid to move or spill by shaking or pouring.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "liquid_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The boy <w>sloshed</w> water over the edge of the bath.",
                            "target_lang_translations": {
                                "cs": "Chlapec <w>vyšplíchl</w> vodu přes okraj vany."
                            }
                        },
                        {
                            "text": "Be careful not to <w>slosh</w> the paint while carrying the bucket.",
                            "target_lang_translations": {
                                "cs": "Dávej pozor, abys při nesení kbelíku barvu <w>nerozlil</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Způsobit, že se kapalina pohybuje nebo vylije, například třesením nebo při nalévání."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "vyšplíchnout",
                                "target_lang_sense_clarification": "způsobit pohyb nebo vycáknutí kapaliny"
                            },
                            {
                                "target_lang_word": "rozlít",
                                "target_lang_sense_clarification": "nechtěně vylít při pohybu nebo třesení"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1addd2d8-1cd4-39d1-bf9d-c57ff75020aa",
                    "sense_definition": "To pour liquid in a messy or careless way.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "liquid_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>sloshed</w> some coffee into a cup and went back to her desk.",
                            "target_lang_translations": {
                                "cs": "Nedbale <w>nalila</w> trochu kávy do hrnku a vrátila se ke stolu."
                            }
                        },
                        {
                            "text": "He <w>sloshed</w> too much sauce onto his plate.",
                            "target_lang_translations": {
                                "cs": "Na talíř si <w>chrstl</w> příliš mnoho omáčky."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Nalévat tekutinu nepořádně nebo nedbale."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "chrstnout",
                                "target_lang_sense_clarification": "nalít kapalinu nedbale nebo ledabyle"
                            },
                            {
                                "target_lang_word": "nalít",
                                "target_lang_sense_clarification": "nedbale nalít"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "92cc27fe-0950-39e1-8fca-15d53e10dbb8",
                    "sense_definition": "To walk through water or mud in a noisy, splashing manner.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "liquid_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The streets were flooded, but they still managed to <w>slosh</w> their way to school.",
                            "target_lang_translations": {
                                "cs": "Ulice byly zatopené, ale i tak se dokázali <w>pročvachtat</w> do školy."
                            }
                        },
                        {
                            "text": "We had to <w>slosh</w> through the deep puddles after the storm.",
                            "target_lang_translations": {
                                "cs": "Po bouřce jsme se museli <w>brodit</w> hlubokými kalužemi."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Jít vodou nebo blátem hlučným, čvachtavým způsobem."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "čvachtat",
                                "target_lang_sense_clarification": "jít hlučně vodou nebo blátem"
                            },
                            {
                                "target_lang_word": "brodit se",
                                "target_lang_sense_clarification": "procházet vodou nebo blátem"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b41bdef8-58b2-3b71-8694-4a7d71b582ff",
                    "sense_definition": "To make a splashing sound due to being wet.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "liquid_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His boots were so completely soaked that they <w>sloshed</w> when he walked.",
                            "target_lang_translations": {
                                "cs": "Měl boty tak promočené, že při chůzi <w>čvachtaly</w>."
                            }
                        },
                        {
                            "text": "Every step I took <w>sloshed</w> because my shoes were full of water.",
                            "target_lang_translations": {
                                "cs": "Každý můj krok <w>čvachtal</w>, protože jsem měl boty plné vody."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Vydávat šplouchavý nebo čvachtavý zvuk kvůli promočení."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "čvachtat",
                                "target_lang_sense_clarification": "vydávat čvachtavý zvuk, protože je něco mokré"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d0ae0df8-ec10-31e6-a8ab-e54b48c77d6d",
                    "sense_definition": "To hit or punch someone.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He had to restrain himself from wanting to <w>slosh</w> the man who insulted him.",
                            "target_lang_translations": {
                                "cs": "Musel se ovládnout, aby toho muže, který ho urazil, <w>nepraštit</w>."
                            }
                        },
                        {
                            "text": "It is never acceptable to <w>slosh</w> someone, regardless of the provocation.",
                            "target_lang_translations": {
                                "cs": "Nikdy není přijatelné někoho <w>udeřit</w>, bez ohledu na provokaci."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Informal and aggressive."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Udeřit nebo praštit někoho."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "praštit",
                                "target_lang_sense_clarification": "hovorově někoho udeřit"
                            },
                            {
                                "target_lang_word": "udeřit",
                                "target_lang_sense_clarification": "někoho uhodit pěstí nebo rukou"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}