{
    "word_family": [
        "delicate",
        "delicately",
        "delicateness",
        "delicious",
        "deliciousness"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3f9d3322-4de4-3fbc-9c04-45297155f74c",
                    "sense_definition": "A rare, expensive, or particularly choice food item that is considered a special treat.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "delicacy_food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Smoked eel is considered a local <w>delicacy</w> in this coastal town.",
                            "target_lang_translations": {
                                "ru": "В этом приморском городке копчёный угорь считается местным <w>деликатесом</w>."
                            }
                        },
                        {
                            "text": "The market stall sells traditional culinary <w>delicacies</w> from all over the region.",
                            "target_lang_translations": {
                                "ru": "В этой рыночной палатке продаются традиционные кулинарные <w>деликатесы</w> со всего региона."
                            }
                        }
                    ],
                    "synonyms": [
                        "treat",
                        "tidbit",
                        "dainties"
                    ],
                    "common_phrases": [
                        "local delicacy",
                        "rare delicacy",
                        "culinary delicacy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Редкое, дорогое или изысканное блюдо, считающееся особым угощением."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "деликатес",
                                "target_lang_sense_clarification": "редкое или изысканное блюдо"
                            },
                            {
                                "target_lang_word": "лакомство",
                                "target_lang_sense_clarification": "вкусная еда или угощение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "243067d6-ae35-3214-b68e-affde4d1968d",
                    "sense_definition": "Tact, sensitivity, or discretion in dealing with people or difficult situations.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "delicacy_behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The diplomat handled the tense negotiations with extraordinary <w>delicacy</w>.",
                            "target_lang_translations": {
                                "ru": "Дипломат провёл эти напряжённые переговоры с исключительной <w>деликатностью</w>."
                            }
                        },
                        {
                            "text": "She raised the awkward topic with great <w>delicacy</w> so as not to offend anyone.",
                            "target_lang_translations": {
                                "ru": "Она подняла эту неловкую тему с большой <w>деликатностью</w>, чтобы никого не обидеть."
                            }
                        }
                    ],
                    "synonyms": [
                        "tact",
                        "diplomacy",
                        "sensitivity",
                        "discretion"
                    ],
                    "antonyms": [
                        "tactlessness",
                        "clumsiness"
                    ],
                    "common_phrases": [
                        "great delicacy",
                        "handle with delicacy",
                        "treat with delicacy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Такт, чуткость или осмотрительность в общении с людьми или в сложных ситуациях."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "деликатность",
                                "target_lang_sense_clarification": "тактичность и вежливость в поведении"
                            },
                            {
                                "target_lang_word": "такт",
                                "target_lang_sense_clarification": "чувство меры и чуткость в общении"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8c4ab8e7-737e-3303-ad5d-0b3a25d7dc85",
                    "sense_definition": "Fineness, exquisite beauty, or elegance of structure, texture, or appearance.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "delicacy_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Visitors admired the intricate <w>delicacy</w> of the handmade lace veil.",
                            "target_lang_translations": {
                                "ru": "Посетители восхищались сложным <w>изяществом</w> кружевной фаты ручной работы."
                            }
                        },
                        {
                            "text": "The artist captured the unusual <w>delicacy</w> of the butterfly wings in her painting.",
                            "target_lang_translations": {
                                "ru": "Художница запечатлела на картине необычайную <w>тонкость</w> крыльев бабочки."
                            }
                        }
                    ],
                    "synonyms": [
                        "fineness",
                        "elegance",
                        "dainty",
                        "subtlety"
                    ],
                    "antonyms": [
                        "coarseness",
                        "roughness"
                    ],
                    "common_phrases": [
                        "exquisite delicacy",
                        "intricate delicacy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тонкость, изящество или изысканная красота структуры, текстуры или внешнего вида."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "утончённость",
                                "target_lang_sense_clarification": "изящество формы или отделки"
                            },
                            {
                                "target_lang_word": "изящество",
                                "target_lang_sense_clarification": "грациозность и тонкая красота"
                            },
                            {
                                "target_lang_word": "тонкость",
                                "target_lang_sense_clarification": "мелкая детализация или искусность исполнения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "06d47868-1bc7-3004-aa04-d474ace4ff9b",
                    "sense_definition": "The general quality or state of being delicate, fragile, or easily damaged.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "delicacy_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Because of the <w>delicacy</w> of the ancient glass vase, it had to be packed very carefully.",
                            "target_lang_translations": {
                                "ru": "Из-за <w>хрупкости</w> старинной стеклянной вазы её пришлось упаковывать очень осторожно."
                            }
                        },
                        {
                            "text": "The extreme <w>delicacy</w> of the instrument requires that it be kept away from vibrations.",
                            "target_lang_translations": {
                                "ru": "Крайняя <w>хрупкость</w> прибора требует беречь его от любых вибраций."
                            }
                        }
                    ],
                    "synonyms": [
                        "fragility",
                        "frailty"
                    ],
                    "antonyms": [
                        "robustness",
                        "sturdiness"
                    ],
                    "common_phrases": [
                        "extreme delicacy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Свойство или состояние хрупкости, ломкости или уязвимости к повреждениям."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хрупкость",
                                "target_lang_sense_clarification": "легкость повреждения предметов или механизмов"
                            },
                            {
                                "target_lang_word": "ломкость",
                                "target_lang_sense_clarification": "свойство легко ломаться"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4e6ef3ca-3325-3970-8699-21a6362ef6d1",
                    "sense_definition": "Weakness or frailty of physical constitution or health.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "delicacy_health",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His constitutional <w>delicacy</w> prevented him from participating in strenuous athletics during his youth.",
                            "target_lang_translations": {
                                "ru": "Врождённая <w>хрупкость</w> здоровья не позволяла ему в молодости заниматься тяжёлыми видами спорта."
                            }
                        },
                        {
                            "text": "She suffered from persistent physical <w>delicacy</w> throughout most of her childhood.",
                            "target_lang_translations": {
                                "ru": "Большую часть детства она страдала от постоянной физической <w>слабости</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "frailty",
                        "feebleness",
                        "infirmity"
                    ],
                    "antonyms": [
                        "vigor",
                        "robustness",
                        "strength"
                    ],
                    "common_phrases": [
                        "constitutional delicacy",
                        "physical delicacy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Слабость или хрупкость физического телосложения либо здоровья."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хрупкость",
                                "target_lang_sense_clarification": "о физическом здоровье или телосложении"
                            },
                            {
                                "target_lang_word": "слабость",
                                "target_lang_sense_clarification": "болезненность или хилость"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a5b31143-52d6-363e-8f79-90f318caf4d0",
                    "sense_definition": "Subtle refinement in perception, taste, or critical discrimination.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "delicacy_behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The critic evaluated the vintage wine with remarkable <w>delicacy</w> of palate.",
                            "target_lang_translations": {
                                "ru": "Критик оценил выдержанное вино с поразительной <w>тонкостью</w> вкуса."
                            }
                        },
                        {
                            "text": "Her literary reviews revealed an exceptional <w>delicacy</w> of aesthetic feeling.",
                            "target_lang_translations": {
                                "ru": "Её литературные обзоры свидетельствовали об исключительной <w>утончённости</w> эстетического чувства."
                            }
                        }
                    ],
                    "synonyms": [
                        "refinement",
                        "discernment",
                        "discrimination"
                    ],
                    "common_phrases": [
                        "delicacy of taste",
                        "delicacy of feeling"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тонкая восприимчивость, изысканный вкус или способность к тонкому различению."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "утончённость",
                                "target_lang_sense_clarification": "о вкусе или восприятии"
                            },
                            {
                                "target_lang_word": "изысканность",
                                "target_lang_sense_clarification": "высокий уровень эстетического вкуса"
                            },
                            {
                                "target_lang_word": "тонкость",
                                "target_lang_sense_clarification": "чуткость восприятия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}