                "senses": [
                    {
                        "sense_id": "23027d37-04e1-3a05-8abc-b63aba576c57",
                        "entry_id": "1b3ea628-182e-3b26-97c3-75542062475a",
                        "glosses": [
                            "Leuchte, in der Neon zur Lichterzeugung verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da80b8f9-bb2b-46ce-a1dd-0e739f75463a",
                                "sense_id": "23027d37-04e1-3a05-8abc-b63aba576c57",
                                "text": "„Der Wartesaal lag zu dieser späten Stunde verlassen da, und die Neonleuchten an der Decke tauchten ihn in ein zu grelles Licht.“"
                            },
                            {
                                "example_id": "5feb8c96-abc6-4a59-9097-0dacfaa078b4",
                                "sense_id": "23027d37-04e1-3a05-8abc-b63aba576c57",
                                "text": "„Wir gehen über weißen Kachelboden, der matt das Licht der Neonleuchten reflektiert, und nehmen an einem Ecktisch am anderen Ende des Raumes Platz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
