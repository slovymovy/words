                "senses": [
                    {
                        "sense_id": "4b490dbc-d338-3784-b4e2-dd47fe3c7b96",
                        "entry_id": "993cfa73-7ac7-3294-b6f9-c17d7b7265be",
                        "glosses": [
                            "Effacer en appliquant du correcteur liquide (blanco)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77bf7a37-3f2e-41a8-b291-ee984a02b6ab",
                                "sense_id": "4b490dbc-d338-3784-b4e2-dd47fe3c7b96",
                                "text": "Blanche avait du fil à retordre, elle venait d’inverser deux postulats et se mettait à blancoter à tort et à travers pour rectifier à chaud."
                            },
                            {
                                "example_id": "51a88edf-7c0d-4a0c-82d9-5543ec10f532",
                                "sense_id": "4b490dbc-d338-3784-b4e2-dd47fe3c7b96",
                                "text": "Toutes ces réflexions accompagnant mon recopiage appliqué du DM de maths, je loupe une ligne. Excédée, je blancote à tout-va et fais de ma copie un torchon."
                            },
                            {
                                "example_id": "ac945fc5-0a04-40bd-9aae-48eafffb9e59",
                                "sense_id": "4b490dbc-d338-3784-b4e2-dd47fe3c7b96",
                                "text": "« Blancoter » quelques bulles et encadrés et demander aux élèves de placer le texte de la fable les amènera à se poser la question de la traduction intersémiotique."
                            }
                        ]
                    }
