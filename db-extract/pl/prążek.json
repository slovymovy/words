                        "form": "prążki"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6a059a96-ce35-3259-9064-09b0b8dd244a",
                        "entry_id": "958e16c0-15e5-3104-ac3c-b202c2234a82",
                        "glosses": [
                            "długi, wąski pasek, prosty lub wygięty; cienka pręga, linia wyróżniająca się na jakim tle"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12cfdbab-f9a5-4f09-a7f5-3ab2880dbd5f",
                                "sense_id": "6a059a96-ce35-3259-9064-09b0b8dd244a",
                                "text": "Do typowych organelli pinealocytów należą np. prążki synaptyczne"
                            },
                            {
                                "example_id": "ff31e486-37a6-4702-b9e0-7d653b5c5685",
                                "sense_id": "6a059a96-ce35-3259-9064-09b0b8dd244a",
                                "text": "J. Fraunhofer, kierując swój spektrometr w stronę Słońca (r. 1814), stwierdził, że na tle całego widma ciągłego rozszczepionego światła, od fioletu do czerwieni, występuje kilkaset ciemnych prążków"
                            },
                            {
                                "example_id": "47218f13-af66-420b-83ff-66566ffb447c",
                                "sense_id": "6a059a96-ce35-3259-9064-09b0b8dd244a",
                                "text": "Spodnie męskie miały szerokie pasy, o przewadze czerwieni, w spódnicach dominowała czerwień, zapaski miały wąskie białe i czerwone prążki"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b21f78dc-73f2-4e46-84c8-9fb7ce83cda4",
                        "source_entry_id": "958e16c0-15e5-3104-ac3c-b202c2234a82",
                        "source_sense_id": "6a059a96-ce35-3259-9064-09b0b8dd244a",
                        "target_lang_word": "stripe",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stripe",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5baaabd9-78af-311a-9635-f25f41d70b45",
                                        "entry_id": "79327805-1571-39c7-b3fd-885f32f23b3f",
                                        "glosses": [
                                            "A long region of a single colour in a repeating pattern of similar regions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e324a5ad-aef2-4511-9fd7-d0e2901fa93b",
                                                "sense_id": "5baaabd9-78af-311a-9635-f25f41d70b45",
                                                "text": "zebra stripes"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9edab044-1a0d-3fd9-9c3b-36e2177ed31f",
                                        "entry_id": "79327805-1571-39c7-b3fd-885f32f23b3f",
                                        "glosses": [
                                            "A long, relatively straight region against a different coloured background."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ceefd4a-fd64-4880-8c8a-a4406fa98479",
                                                "sense_id": "9edab044-1a0d-3fd9-9c3b-36e2177ed31f",
                                                "text": "8 Sep 2019, Peter Conrad in The Guardian, Sontag: Her Life by Benjamin Moser review – heavyweight study of a critical colossus\nAt first, what mattered was the sparky contents of Sontag’s head; by the end she was best known for the way she wore her hair – that saturnine battle helmet of dyed black, with a single stripe left white at the temple like a Frankensteinian lightning bolt of intellect."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e06e0134-6350-35d2-b9e1-3654b33daff6",
                                        "entry_id": "79327805-1571-39c7-b3fd-885f32f23b3f",
                                        "glosses": [
                                            "The badge worn by certain officers in the military or other forces."
                                        ],
                                        "tags": [
                                            "in-plural"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7152b8ab-c4f5-3e57-a65d-4b2c6486bb7a",
                                        "entry_id": "79327805-1571-39c7-b3fd-885f32f23b3f",
                                        "glosses": [
                                            "Distinguishing characteristic; sign; likeness; sort."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b414a2bb-93d2-4303-a81c-7545163576c4",
                                                "sense_id": "7152b8ab-c4f5-3e57-a65d-4b2c6486bb7a",
                                                "text": "persons of the same political stripe"
                                            },
                                            {
                                                "example_id": "c290ef05-0a26-47af-8276-af3b8ce539f6",
                                                "sense_id": "7152b8ab-c4f5-3e57-a65d-4b2c6486bb7a",
                                                "text": "20 May 2018, Hadley Freeman in The Guardian, Is Meghan Markle the American the royals have needed all along?\nEveryone I spoke to had waved flags at Prince William and Kate Middleton’s wedding, had camped out for Diana’s funeral and, in some cases, her ill-fated wedding. (No one mentioned going to Prince Andrew and Sarah Ferguson’s now all-but forgotten wedding, and yet the awkward truth is that Harry and Meghan’s marriage is no more significant than that one was, in terms of lineage.) Not being a royalist of any stripe, I’d not been to any of those."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "341a108c-d07c-33b5-990f-999649c68499",
                                        "entry_id": "79327805-1571-39c7-b3fd-885f32f23b3f",
                                        "glosses": [
                                            "A long, narrow mark left by striking someone with a whip or stick; a blow or lash with a whip, stick, or scourge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0038c024-b26f-4f16-b367-07c9b79e80b8",
                                                "sense_id": "341a108c-d07c-33b5-990f-999649c68499",
                                                "text": "Thou most lying slave,\nWhom stripes may move, not kindness!"
                                            },
                                            {
                                                "example_id": "3ac5cc74-9fb3-496d-8db8-36d230858f9a",
                                                "sense_id": "341a108c-d07c-33b5-990f-999649c68499",
                                                "text": "Forty stripes he [the judge] may give him [the wicked man], and not exceed:"
                                            },
                                            {
                                                "example_id": "632a8764-1805-4c26-8837-4a40f33e540b",
                                                "sense_id": "341a108c-d07c-33b5-990f-999649c68499",
                                                "text": "1735, James Thomson, The Four Seasons, and Other Poems, London: J. Millan and A. Millar, “Winter,” lines 353-354, p. 21,\n[Tyrants] at pleasure mark’d him with inglorious stripes;"
                                            },
                                            {
                                                "example_id": "56833a84-acfe-4217-9156-3acc5f073b55",
                                                "sense_id": "341a108c-d07c-33b5-990f-999649c68499",
                                                "text": "Stones to eat and bitter water for their thirst, and stripes for tender nurture."
                                            },
                                            {
                                                "example_id": "c5f3591a-0dfc-49a3-bdd2-a5f4ffdebce7",
                                                "sense_id": "341a108c-d07c-33b5-990f-999649c68499",
                                                "text": "A certain Abbé Chuppe d'Auteroche [...] asserted that in Russia, the vapor baths, stripes were administered to the frequenters as a stimulus to the venereal appetite."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83c13417-2f73-38f1-9de5-e8296097d587",
                                        "entry_id": "79327805-1571-39c7-b3fd-885f32f23b3f",
                                        "glosses": [
                                            "A slash cut into the flesh as a punishment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a9ff230-13cb-4eec-bf80-817056cb4fa6",
                                                "sense_id": "83c13417-2f73-38f1-9de5-e8296097d587",
                                                "text": "But if there were any one who tried and could not make her laugh, he would have three red stripes cut out of his back and salt rubbed into them and, sad to relate, there were many sore backs in that kingdom."
                                            },
                                            {
                                                "example_id": "1610fbd5-e6ae-44b4-b82f-0d56a41f14ab",
                                                "sense_id": "83c13417-2f73-38f1-9de5-e8296097d587",
                                                "text": "[At the Saturnalia] not even a word of reproof would be administered to him [a slave] for conduct which at any other season might have been punished with stripes, imprisonment, or death."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79ad0fd5-066c-38ee-974f-20be43be3a00",
                                        "entry_id": "79327805-1571-39c7-b3fd-885f32f23b3f",
                                        "glosses": [
                                            "A pattern produced by arranging the warp threads in sets of alternating colours, or in sets presenting some other contrast of appearance."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3596f97f-5f41-3348-9afc-53728ec32e82",
                                        "entry_id": "79327805-1571-39c7-b3fd-885f32f23b3f",
                                        "glosses": [
                                            "Any of the balls marked with stripes in the game of pool, which one player aims to pot, the other player taking the spots."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "965cb140-d2e8-3349-8e2f-f958b3ae1199",
                                        "entry_id": "79327805-1571-39c7-b3fd-885f32f23b3f",
                                        "glosses": [
                                            "A portion of data distributed across several separate physical disks for the sake of redundancy."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f06df3e3-3d4a-3d20-9153-d1b7bcd1e1ce",
