                "senses": [
                    {
                        "sense_id": "7c0e1764-512a-3b4a-be4a-b4f9d9d1ce9f",
                        "entry_id": "0d98295e-4f10-31ac-8f07-70b25067ef63",
                        "glosses": [
                            "organische Verbindung mit zwei Alkoxygruppen, die durch ein Kohlenstoffatom miteinander verbunden sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d69df55-1881-475f-b850-77b253f41874",
                                "sense_id": "7c0e1764-512a-3b4a-be4a-b4f9d9d1ce9f",
                                "text": "„Mit Aldehyden oder Ketonen werden Acetale (z. B. mit Benzaldehyd Benzylidenverbindungen) bzw. Ketale (z. B. mit Aceton Isopropylidenverbindungen) gebildet.“"
                            },
                            {
                                "example_id": "2895916f-8b1a-4b11-b9c7-8a34124bc18a",
                                "sense_id": "7c0e1764-512a-3b4a-be4a-b4f9d9d1ce9f",
                                "text": "„Thioacetale sind Derivate der Acetale, bei denen ein Sauerstoffatom durch ein Schwefelatom ersetzt wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
