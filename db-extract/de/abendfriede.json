                                "example_id": "2f7c5bba-a5db-469f-8932-d0bd87a67aa8",
                                "sense_id": "e24b7eff-aa79-3bb6-bce9-ea3afffe7fb4",
                                "text": "„Noch ist es nicht so weit, ist es noch hell, als wir um neun Uhr abends ankommen, den Zaun entlang zum Eingang spazieren, aber irgendwie ... diese Stimmung ... Abendfriede? Ja, das ist das treffende Wort …“"
                            },
                            {
                                "example_id": "f69bafd5-1725-4cf1-b398-47c0e28c4784",
                                "sense_id": "e24b7eff-aa79-3bb6-bce9-ea3afffe7fb4",
                                "text": "„Auf der kahlen Ebene standen im Abendfrieden sämtliche Diemen ringsum wie Vulkane in Flammen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
