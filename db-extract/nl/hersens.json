                        "entry_id": "2b0c90be-c6c6-3295-801c-4881eea239a0",
                        "glosses": [
                            "waarnemend, aansturend, controlerend en informatieverwerkend orgaan in dieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "adb353ce-8a86-47de-afb5-4d549998561b",
                                "sense_id": "f858e07b-90e0-3260-b6c1-b84b9a2cb33b",
                                "text": "Olifanten en walvissen hebben grotere hersens dan mensen, maar mensen zijn intelligenter."
                            }
                        ]
                    },
                    {
                        "sense_id": "620eb3cd-0ef2-38b4-9c97-d248a6c38052",
                        "entry_id": "2b0c90be-c6c6-3295-801c-4881eea239a0",
                        "glosses": [
