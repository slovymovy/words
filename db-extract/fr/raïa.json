                    {
                        "sense_id": "bc99caff-6522-36fc-b0d3-19f28390fd6c",
                        "entry_id": "2f919116-4548-368c-80db-dd755fede238",
                        "glosses": [
                            "Sujet de l'empire ottoman soumis à la capitation, tels que chrétien, juif, etc"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a0c8dbf-a65d-402c-ab9f-d219f81d7adc",
                                "sense_id": "bc99caff-6522-36fc-b0d3-19f28390fd6c",
                                "text": "Sadîk Celebi avait porté à la connaissance de la Porte l'essor économique de l'eyalet et la possibilité pour les raïas d'acquitter chaque année plus de 25 charges d'aspres."
                            },
                            {
                                "example_id": "0adaa867-9f8e-458a-9c93-598aa5f79011",
                                "sense_id": "bc99caff-6522-36fc-b0d3-19f28390fd6c",
                                "text": "Puis il indiqua quels étaient les besoins les plus pressants et ce que seraient les travaux préparatoires que l’on attendait à cette occasion des musulmans de la ville et ce que l’on exigerait des chrétiens, de la raïa."
                            }
                        ]
                    }
                ],
                "translations": [
