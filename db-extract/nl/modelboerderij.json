                        "examples": [
                            {
                                "example_id": "da68dffa-e6eb-40d6-85f6-81dbf3ca02c4",
                                "sense_id": "476e28fe-0a83-3fe9-a395-f681c056f983",
                                "text": "Al even gevoelig ligt het fotograferen van de talrijke beelden en mozaïeken met de beeltenissen van Kim 1, 2 en 3. Van opzij fotograferen is verboden, de heren moeten altijd precies in het midden in beeld staan, afsnijden is verboden. De foto-galerijen met beelden van de bezoeken van de Kims aan fabrieken, instellingen en modelboerderijen fungeren als altaren. Zelfs de stoelen en krukjes waar zij tijdens hun bezoeken op hebben gezeten, en de asbakken waarin zij hun sigaretten doofden, worden daar in vitrines geplaatst."
                            },
                            {
                                "example_id": "bc62990c-3311-4dd7-b1ac-083013056a40",
                                "sense_id": "476e28fe-0a83-3fe9-a395-f681c056f983",
                                "text": "De Chinese sector moet zich niet zozeer op kwantiteit, maar op kwaliteit richten, vinden de Nederlanders. Het SDDDC gaat onder meer een modelboederij bouwen en bezoekjes aan Nederland organiseren."
                            }
                        ]
                    }
