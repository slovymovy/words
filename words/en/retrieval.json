                {
                    "sense_id": "f12cd9c3-0b91-3368-bba5-83d3f6e386a1",
                    "sense_definition": "The operation of accessing data, either from memory or from a storage device.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "information_access",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The system allows for the rapid <w>retrieval</w> of information from the database.",
                            "target_lang_translations": {
                                "ru": "Система обеспечивает быстрый <w>поиск</w> информации в базе данных."
                            }
                        },
                        {
                            "text": "The technician is working on a faster data <w>retrieval</w> method for the new server.",
                            "target_lang_translations": {
                                "ru": "Техник работает над более быстрым методом <w>извлечения</w> данных для нового сервера."
                            }
                        }
                    ],
                    "synonyms": [
                        "recovery",
                        "access"
                    ],
                    "antonyms": [
                        "storage"
                    ],
                    "common_phrases": [
