{
    "word_family": [
        "plume",
        "plumy",
        "plumeless",
        "plumaged"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fc98abd6-6a54-36cb-989e-f8bd69f6e845",
                    "sense_definition": "The entire layer of feathers that covers a bird's body.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bird_anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The male peacock is famous for its incredibly colorful and iridescent <w>plumage</w> used to attract mates.",
                            "target_lang_translations": {
                                "ru": "Самец павлина знаменит своим невероятно красочным и переливающимся <w>оперением</w>, которое он использует для привлечения самок."
                            }
                        },
                        {
                            "text": "During the winter months, many birds develop a thicker <w>plumage</w> to protect themselves from the freezing temperatures.",
                            "target_lang_translations": {
                                "ru": "В зимние месяцы у многих птиц вырастает более густое <w>оперение</w>, чтобы защититься от морозов."
                            }
                        }
                    ],
                    "synonyms": [
                        "pennage"
                    ],
                    "common_phrases": [
                        "bright plumage",
                        "colorful plumage",
                        "winter plumage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Весь слой перьев, покрывающий тело птицы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оперение",
                                "target_lang_sense_clarification": "перьевой покров птиц"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "510b4cbc-d2b6-3147-bfc6-8aec7a4ec0f3",
                    "sense_definition": "Elaborate or fancy clothing; finery.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The guests arrived at the gala in their finest <w>plumage</w>, wearing silk gowns and tailored tuxedos.",
                            "target_lang_translations": {
                                "ru": "Гости прибыли на гала-вечер в своих лучших <w>нарядах</w>: в шелковых платьях и сшитых на заказ смокингах."
                            }
                        },
                        {
                            "text": "She decided to show off her <w>plumage</w> at the party by wearing a dress covered in sequins.",
                            "target_lang_translations": {
                                "ru": "Она решила блеснуть своим <w>нарядом</w> на вечеринке, надев платье, расшитое пайетками."
                            }
                        }
                    ],
                    "common_phrases": [
                        "finest plumage"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used metaphorically to describe human dress"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Изысканная или нарядная одежда; богатое убранство."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наряд",
                                "target_lang_sense_clarification": "красивая, праздничная одежда"
                            },
                            {
                                "target_lang_word": "убранство",
                                "target_lang_sense_clarification": "внешний вид, одежда (в переносном смысле)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}