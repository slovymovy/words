                    {
                        "translation_id": "6ce7c533-434d-4cca-a2fe-7c7d80ea0c08",
                        "source_entry_id": "6f38492a-bad0-349a-8a4b-455fdb47f9a5",
                        "source_sense_id": "5481dab7-566c-3b0a-9489-574fa0e4b848",
                        "target_lang_word": "cebador",
