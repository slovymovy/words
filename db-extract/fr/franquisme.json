                ],
                "senses": [
                    {
                        "sense_id": "251c0433-ba6c-3625-bb32-16b8b11ac98b",
                        "entry_id": "15f62ff1-79c0-3989-8f1b-d791427a8772",
                        "glosses": [
                            "Dictature militaire dirigée en Espagne par le général Francisco Franco, doctrine qui lui est associée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96117dcf-0b08-4c01-be5f-3496b6c1d1dc",
                                "sense_id": "251c0433-ba6c-3625-bb32-16b8b11ac98b",
                                "text": "Créée le 31 juillet 1959 par des étudiants nationalistes d’inspiration marxiste-léniniste qui accusaient le PNV de centre-droit et son gouvernement en exil « d’immobilisme » face au franquisme, l’ETA avait revendiqué son premier attentat le 7 juin 1968, en tuant un policier de Saint-Sébastien."
                            },
                            {
                                "example_id": "8fa809ea-cbeb-4aea-80e6-90fb3fdfd1ed",
                                "sense_id": "251c0433-ba6c-3625-bb32-16b8b11ac98b",
                                "text": "En Espagne certains pointent l’impunité autour des crimes du franquisme et aux États-Unis on dénonce la brutalité policière ou encore la peine de mort."
                            },
                            {
                                "example_id": "9addf5ea-563d-480c-8e73-99e26e6a84e1",
                                "sense_id": "251c0433-ba6c-3625-bb32-16b8b11ac98b",
                                "text": "Dans ce dossier, le traditionnel silence qui entoure les crimes du franquisme en Espagne n’a pas pu, cette fois, étouffer la clameur des victimes d’une tragédie qui brise encore des vies trente-cinq ans après la mort de Franco."
                            },
                            {
                                "example_id": "8f62f748-b6bf-438b-9f7c-57496b817cdf",
                                "sense_id": "251c0433-ba6c-3625-bb32-16b8b11ac98b",
                                "text": "Le célèbre juge d’instruction espagnol Baltasar Garzon sera jugé pour avoir voulu fouiller l’encombrant passé du franquisme."
                            }
                        ]
                    }
                ],
