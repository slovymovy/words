{
    "word_family": [
        "glutton",
        "gluttony"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "fd5e1bda-0a9f-3665-aa30-cf69a443eb62",
                    "sense_definition": "Given to excessive eating; prone to overeating.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "eating_habits",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>gluttonous</w> guest finished the entire cake before anyone else could have a slice.",
                            "target_lang_translations": {
                                "zh": "那位<w>贪吃</w>的客人还没等别人切上一块，就把整个蛋糕吃光了。"
                            }
                        },
                        {
                            "text": "He was known for his <w>gluttonous</w> appetite at every holiday dinner.",
                            "target_lang_translations": {
                                "zh": "他在每次节日聚餐时都以<w>暴饮暴食</w>而闻名。"
                            }
                        }
                    ],
                    "synonyms": [
                        "gluttonish"
                    ],
                    "common_phrases": [
                        "gluttonous appetite"
                    ],
                    "target_lang_definitions": {
                        "zh": "指饮食过量，贪吃。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "贪吃",
                                "target_lang_sense_clarification": "形容人贪图食物，吃得过多。"
                            },
                            {
                                "target_lang_word": "暴饮暴食",
                                "target_lang_sense_clarification": "形容饮食无节制，一次性吃得太多。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "422ae444-3890-3520-a4de-b18cc536656e",
                    "sense_definition": "Having an excessive desire for something, especially wealth or power; greedy.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "greed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>gluttonous</w> corporation sought to acquire every small business in the region.",
                            "target_lang_translations": {
                                "zh": "这家<w>贪婪</w>的公司试图收购该地区所有的中小企业。"
                            }
                        },
                        {
                            "text": "His <w>gluttonous</w> desire for fame led him to make many poor decisions.",
                            "target_lang_translations": {
                                "zh": "他对名声的<w>贪得无厌</w>导致他做出了许多错误的决定。"
                            }
                        }
                    ],
                    "synonyms": [
                        "gluttonly"
                    ],
                    "common_phrases": [
                        "gluttonous desire"
                    ],
                    "target_lang_definitions": {
                        "zh": "指对某事物（如财富或权力）有过度且贪婪的欲望。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "贪婪",
                                "target_lang_sense_clarification": "形容对物质或权力有无止境的欲望。"
                            },
                            {
                                "target_lang_word": "贪得无厌",
                                "target_lang_sense_clarification": "形容贪心极大，永远无法满足。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}