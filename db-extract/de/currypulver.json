                "senses": [
                    {
                        "sense_id": "0f0402ec-8658-3d98-8a77-dd4186eba4ff",
                        "entry_id": "bdd6de50-9579-38c1-9ec7-5c644a47f82c",
                        "glosses": [
                            "pikante, ockergelbe Gewürzmischung (die Farbe entsteht vor allem durch das Gewürz Kurkuma)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b5544b8-250b-4ffb-a1b3-e6630a86aec2",
                                "sense_id": "0f0402ec-8658-3d98-8a77-dd4186eba4ff",
                                "text": "„Mehr als ein Viertel der 37 Proben aus konventionellem Anbau wurden von Greenpeace als ‚nicht empfehlenswert‘ eingestuft. Besonders stark von Pestiziden seien Paprika- und Currypulver sowie getrocknete Petersilie belastet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ae8f56a8-e7fc-4ac3-b048-a875cd00b7a6",
                        "source_entry_id": "bdd6de50-9579-38c1-9ec7-5c644a47f82c",
                        "source_sense_id": "0f0402ec-8658-3d98-8a77-dd4186eba4ff",
                        "source_sense_description": "Gastronomie: pikante, ockergelbe Gewürzmischung (die Farbe entsteht vor allem durch das Gewürz Kurkuma)",
                        "target_lang_word": "curry powder",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "curry powder",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9d67df12-cdf1-380a-85a4-eb7120014d0e",
                                        "entry_id": "1a1699ec-75bb-383a-a414-14cfa6ec7794",
                                        "glosses": [
                                            "A mixture of spices, usually including turmeric, commonly used in Asian-style cooking."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b1e444e7-729a-43d9-bd48-994d517eb470",
                        "source_entry_id": "bdd6de50-9579-38c1-9ec7-5c644a47f82c",
                        "source_sense_id": "0f0402ec-8658-3d98-8a77-dd4186eba4ff",
                        "source_sense_description": "Gastronomie: pikante, ockergelbe Gewürzmischung (die Farbe entsteht vor allem durch das Gewürz Kurkuma)",
                        "target_lang_word": "curry",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "curry",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4eeb4e92-9c9f-38c7-9db0-e141f23c769b",
                                        "entry_id": "f999f263-780d-3294-8675-04cad7681703",
                                        "glosses": [
                                            "Cari, mélange d’épices réduites en poudre, très répandu dans la cuisine indienne, comprenant notamment du curcuma qui donne la couleur orangée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "158aefee-5297-4819-ad4f-98830287ad6f",
                                                "sense_id": "4eeb4e92-9c9f-38c7-9db0-e141f23c769b",
                                                "text": "En Charente-Maritime, deux spécialités locales subliment ce coquillage : la mouclade, avec une sauce au vin blanc, du pineau, du persil, de l’ail et, selon les recettes, du curry et du jaune d’œuf ; et l’éclade - ou églade -, où les moules sont disposées en spirale sur une planche en bois avant d’être recouvertes d’aiguilles de pin auxquelles on met le feu, ce qui donne un goût fumé à ce plat typique de l’île d’Oléron et des alentours de Royan."
                                            },
                                            {
                                                "example_id": "7d80e552-b3ee-4d83-bc88-364859dcb070",
                                                "sense_id": "4eeb4e92-9c9f-38c7-9db0-e141f23c769b",
                                                "text": "La légende veut qu’un pharmacien, nommé Gosse, ait récupéré des épices de cette manière et les ait mélangées pour faire son curry à lui, le Kari Gosse"
                                            },
                                            {
                                                "example_id": "ee3d2d97-af0c-445f-b8e1-5b9908afeb7c",
                                                "sense_id": "4eeb4e92-9c9f-38c7-9db0-e141f23c769b",
                                                "text": "Enfin, ajouter le potimarron en morceaux avec une cuiller à café de curry et servir aussitôt avec du riz."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c65753b-5147-3b4c-96dc-c43cbdceb80a",
                                        "entry_id": "f999f263-780d-3294-8675-04cad7681703",
                                        "glosses": [
                                            "Plat assaisonné de cette épice."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f8f53ad-182f-4177-8e13-8b7bb4bd6b74",
                                                "sense_id": "2c65753b-5147-3b4c-96dc-c43cbdceb80a",
                                                "text": "Cela calait l'estomac aux petites heures du matin et la vigueur des currys absorbés contribuait agréablement à remettre d'aplomb un individu dont les gins tonics de la veille avaient compromis l'équilibre d'un organisme fatigué."
                                            },
                                            {
                                                "example_id": "92891fec-53ca-4feb-b4f9-d5469f4998fa",
                                                "sense_id": "2c65753b-5147-3b4c-96dc-c43cbdceb80a",
                                                "text": "D’autres [fruits] sont trop acides comme le fruit de Garcinia cambogia Desr., et servent, coupés en tranche et séchés, pour faire des currys de poissons."
                                            },
                                            {
                                                "example_id": "22efa5bc-9415-4a35-99be-06fd8d6258b5",
                                                "sense_id": "2c65753b-5147-3b4c-96dc-c43cbdceb80a",
                                                "text": "Une de mes collègues me disait en plaisantant il y a quelques mois lors d’une conférence en Angleterre que le plat national britannique était le curry... ici au Népal le plat national est sans doute la pizza."
                                            },
                                            {
                                                "example_id": "2df29f8c-a1bb-4312-a063-e8e4d2653feb",
                                                "sense_id": "2c65753b-5147-3b4c-96dc-c43cbdceb80a",
                                                "text": "Mais c’est oublier que la cuisine populaire est tout sauf figée quand elle intègre le couscous et les nems, le burger et le curry."
                                            },
                                            {
                                                "example_id": "d68b94ed-f5be-4f88-a85d-4165696e5a1c",
                                                "sense_id": "2c65753b-5147-3b4c-96dc-c43cbdceb80a",
                                                "text": "Selon la région, les parathas peuvent être fourrés, épicés, pliés plutôt que roulés, frits plutôt que rôtis. Ils accompagnent souvent un curry ou un kurma."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9df6bdfe-0e43-34ae-ab04-2d903e7cb009",
                                        "entry_id": "f999f263-780d-3294-8675-04cad7681703",
                                        "glosses": [
                                            "Curcuma."
                                        ],
                                        "tags": [
                                            "Nouvelle-Calédonie"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
