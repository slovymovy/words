                },
                {
                    "sense_id": "00f6ad48-6d9c-309f-9b73-4fbe0828917c",
                    "sense_definition": "Overly sparing, cautious, or parsimonious.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "insufficiency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was advised to be less <w>scant</w> of his praise when reviewing the team's hard work.",
                            "target_lang_translations": {
                                "ru": "Ему посоветовали быть менее <w>скупым</w> на похвалу при оценке упорного труда команды."
                            }
