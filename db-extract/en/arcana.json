    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "7c7f83c8-99b1-38e8-a86f-4bd6dfceffad",
                "word": "arcana",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "546ce314-6797-3a63-af72-e4a39bad2724",
                        "entry_id": "7c7f83c8-99b1-38e8-a86f-4bd6dfceffad",
                        "glosses": [
                            "Specialized knowledge that is mysterious to the uninitiated."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "3136606e-1c10-4f16-ad1f-3bd36080bcc3",
                                "sense_id": "546ce314-6797-3a63-af72-e4a39bad2724",
                                "text": "Thou deign'st no answer,—or I fain would ask\nIf since thy bright creation, thou hast seen\nOught like a Newton, whose admitted eye\nThe arcana of the universe explored\nLight's subtle ray its mechanism disclosed,\nThe impetuous comet his mysterious lore\nUnfolded,"
                            },
                            {
                                "example_id": "bdb98e23-6d9f-4bc0-ab66-909ffbfc0f29",
                                "sense_id": "546ce314-6797-3a63-af72-e4a39bad2724",
                                "text": "The witch, repository of hieratic lore and folk legends and occult arcana, became the distributor of philtres and unguents, electuaries and pastilles, herbs and charms and incantations - directed toward sexual pleasures and amatory satisfactions."
                            },
                            {
                                "example_id": "e1493326-9eed-4190-aa24-a75660a4cde8",
                                "sense_id": "546ce314-6797-3a63-af72-e4a39bad2724",
                                "text": "This is not, however, a mere salmagundi of alphabetical arcana."
                            }
                        ]
                    }
                ],
