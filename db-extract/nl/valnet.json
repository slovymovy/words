                                        "sense_id": "805e998a-2f78-3876-93a5-2f6eea7b6cd6",
                                        "entry_id": "e9ef1703-7c28-3996-bad3-e6251385b7d4",
                                        "glosses": [
                                            "A large net placed horizontally beneath performing aerialists such as trapeze artists or tightrope walkers, intended to catch a performer who falls and to protect him or her from harm."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "341ac8f9-eb75-35d7-8a8c-b2ab519d1081",
                                        "entry_id": "e9ef1703-7c28-3996-bad3-e6251385b7d4",
                                        "glosses": [
                                            "Anything, such as a governmental program, that provides security against extreme disadvantage or misfortune."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f87dfe8f-c939-4f78-b8f4-4d828ac46312",
                                                "sense_id": "341ac8f9-eb75-35d7-8a8c-b2ab519d1081",
                                                "text": "Chelsea manager Thomas Tuchel revealed he was in \"angry mode\" after the surprise home loss to Arsenal suddenly put pressure on their top-four hopes in the Premier League - although the Champions League final against Manchester City could yet prove the most glittering safety net."
                                            },
                                            {
                                                "example_id": "c2a87c05-f688-4eb0-8bc5-24ebdac13a8d",
                                                "sense_id": "341ac8f9-eb75-35d7-8a8c-b2ab519d1081",
                                                "text": "The TSSA said that access to the furlough scheme should be reinstated for the cross-Channel operator to protect jobs, while the RMT said a financial 'safety net' was needed to prevent Eurostar \"tipping over\". It follows similar but unheeded calls made at the very start of the pandemic, when international travel fell by more than 95% and Eurostar was forced to scale back its operation to just one service between London and Paris each day."
                                            }
                                        ]
