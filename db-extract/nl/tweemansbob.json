                        "examples": [
                            {
                                "example_id": "b72dd738-b0d4-4e2f-b9eb-31a285f3dfe4",
                                "sense_id": "1729ed3d-f49d-3231-be99-164ed60a6c2e",
                                "text": "Sleper moet zich nog wel kwalificeren. Ze zal, omdat ze niet aan de tweezitter bij de vrouwen meedoet, op 16 januari (internationale deadline) bij de beste zes landen moeten horen die geen afvaardiging in de tweemansbob hebben."
                            },
                            {
                                "example_id": "8522fddc-b4e3-4208-8f0a-eb93876af257",
                                "sense_id": "1729ed3d-f49d-3231-be99-164ed60a6c2e",
                                "text": "Francesco Friedrich en Thorsten Margis hebben hun olympische titel in de tweemansbob met succes verdedigd. De Duitsers waren op de baan in Yanqing een klasse apart. De duo's Johannes Lochner/Florian Bauer en Christoph Hafer/Matthias Sommer maakten het Duitse feestje compleet met respectievelijk zilver en brons."
                            }
                        ]
                    }
