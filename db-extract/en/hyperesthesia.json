                        "sense_id": "98a57057-b01c-3266-a96a-c7cdadc22e4e",
                        "entry_id": "e9c5eb47-8c8d-3e92-816d-6554ec9805c4",
                        "glosses": [
                            "Unusual or pathological sensitivity of the skin or of a particular sense."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "39a875d6-3a2c-4902-8cc4-a101af1ab178",
                                "sense_id": "98a57057-b01c-3266-a96a-c7cdadc22e4e",
                                "text": "\"There are zones of marked hyper-æsthesia on his limbs. His visual field and pupillary reaction is normal.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8fbcc3ce-16d8-40c2-bf23-67de8e2fe0f2",
                        "source_entry_id": "e9c5eb47-8c8d-3e92-816d-6554ec9805c4",
                        "source_sense_id": "98a57057-b01c-3266-a96a-c7cdadc22e4e",
                        "source_sense_description": "unusual sensitivity",
                        "target_lang_word": "hyperesthésie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hyperesthésie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9696fa7e-7b1a-3d64-a762-f29cc3566258",
                                        "entry_id": "a8842660-01b7-3a13-bc5e-c0cc2d6d8c02",
                                        "glosses": [
                                            "Exagération physiologique ou pathologique de l’acuité et de la sensibilité des divers sens."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a214b419-2db5-41cc-893e-51d21413bf2d",
                                                "sense_id": "9696fa7e-7b1a-3d64-a762-f29cc3566258",
                                                "text": "La vie de Balzac ? Un permanent foyer de création, un perpétuel, un universel désir, une lutte effroyable. La fièvre, l'exaltation, l’hyperesthésie constituaient l'état normal de son individu."
                                            },
                                            {
                                                "example_id": "eb1881f7-5d9d-4781-b67e-1c658ce60487",
                                                "sense_id": "9696fa7e-7b1a-3d64-a762-f29cc3566258",
                                                "text": "Quand mes lèvres la touchèrent, les mains de ma grand’mère s’agitèrent, elle fut parcourue tout entière d’un long frisson, soit réflexe, soit que certaines tendresses aient leur hyperesthésie qui reconnaît à travers le voile de l’inconscience ce qu’elles n’ont presque pas besoin des sens pour chérir."
                                            },
                                            {
                                                "example_id": "7cb89c43-7ecf-4b92-a191-bfc5796af3d6",
                                                "sense_id": "9696fa7e-7b1a-3d64-a762-f29cc3566258",
                                                "text": "Alors que l’hyperesthésie préparanoïaque est essentiellement défensive, la paranoïa maladie est à la fois pensée et agie."
                                            },
                                            {
                                                "example_id": "f3b49d94-c704-4f3d-bac0-3cb7a102ffdd",
                                                "sense_id": "9696fa7e-7b1a-3d64-a762-f29cc3566258",
                                                "text": "Ma frigidité s’était transformée en son contraire, une hyperesthésie formidable. Je ressentais tout à la puissance n : […]"
                                            },
                                            {
                                                "example_id": "d7b69efd-3c19-4509-b264-8ae0d708d04d",
                                                "sense_id": "9696fa7e-7b1a-3d64-a762-f29cc3566258",
                                                "text": "Grâce à son « hyperesthésie » et son intelligence, le narrateur se glisse partout et capte les conversations, les mimiques, les attitudes les plus discrètes dans les milieux les plus variés."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
