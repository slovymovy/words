                            {
                                "example_id": "b0e5de4e-cdf7-4a3f-9651-a018c6a8d6d0",
                                "sense_id": "0b0aa06d-001d-3980-b2b1-79cffdf254ab",
                                "text": "In Georgië ontwikkelt zich een demografische ramp als gevolg van emigratie en dalende geboortecijfers."
