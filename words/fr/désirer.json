                    "frequency": "Middle",
                    "semantic_group_id": "attirance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dès leur première rencontre, il s'est mis à la <w>désirer</w> passionnément."
                        },
                        {
                            "text": "Ils se regardaient avec intensité et se <w>désiraient</w> en silence."
                        }
                    ],
                    "common_phrases": [
