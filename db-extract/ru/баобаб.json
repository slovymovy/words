                                    {
                                        "sense_id": "d3604adc-2aeb-3285-b6b7-7fad9f76aeba",
                                        "entry_id": "7ff50242-6e37-3f94-8e11-2b619822da28",
                                        "glosses": [
                                            "ein Baum der afrikanischen Savanne sowie trockener Gebiete Madagaskars und Australiens (Gattung Adansonia)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf925a76-b78c-493b-947b-0edebeff936b",
                                                "sense_id": "d3604adc-2aeb-3285-b6b7-7fad9f76aeba",
                                                "text": "Der Affenbrotbaum ist der Nationalbaum der Republik Kongo."
                                            },
                                            {
                                                "example_id": "1bb7a115-a96d-4158-996d-69fb3d791dca",
                                                "sense_id": "d3604adc-2aeb-3285-b6b7-7fad9f76aeba",
                                                "text": "„Goso liebte die Kinder sehr und wurde von ihnen wieder geliebt. Er versammelte täglich eine Schar von Kindern um sich unter einem Affenbrotbaum und erzählte ihnen viele schöne Geschichten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
