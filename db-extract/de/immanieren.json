                "senses": [
                    {
                        "sense_id": "4a8cfa9f-4724-3550-9ce7-8dc0660c52fe",
                        "entry_id": "d87e8114-9014-3fd4-ad0f-0f450675c544",
                        "glosses": [
                            "in etwas enthalten sein, zum Beispiel einem Gedanken innewohnen"
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "30430f97-6d62-48fa-8d03-400e80bedba7",
                                "sense_id": "4a8cfa9f-4724-3550-9ce7-8dc0660c52fe",
                                "text": "„Gott muss sich immanieren, muss sich der Welt zeigen, um nicht als archimedischer Punkt missverstanden zu werden […].“"
                            },
                            {
                                "example_id": "957dda70-47a9-4f65-a809-b415a1de5cb5",
                                "sense_id": "4a8cfa9f-4724-3550-9ce7-8dc0660c52fe",
                                "text": "„Darum muss der Absolute der Welt immanieren, unvermischt und ungetrennt, weil er sich ja in die Schöpfung manifestiert hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
