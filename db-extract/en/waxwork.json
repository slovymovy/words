                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "ad00d1da-d569-4464-8954-d7650ce3e6c0",
                        "entry_id": "e1ab612d-84b5-3154-a28a-13fc4b9da9be",
                        "tags": [
                            "plural"
                        ],
                        "form": "waxworks"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ebceec79-d879-3ee1-9cab-5a7dd65e94e2",
                        "entry_id": "e1ab612d-84b5-3154-a28a-13fc4b9da9be",
                        "glosses": [
                            "A figure made of wax, especially an effigy of a famous person."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "edcf96a8-f8b2-44b7-858b-3019720bfa50",
                                "sense_id": "ebceec79-d879-3ee1-9cab-5a7dd65e94e2",
                                "text": "The amateur tenor, whose vocal villainies / All desire to shirk, / Shall during off-hours, / Exhibit his powers / To Madame Tussaud's waxwork."
                            }
                        ]
                    },
                    {
                        "sense_id": "31407a54-fe8c-35b0-ae9d-7d4046427bfd",
                        "entry_id": "e1ab612d-84b5-3154-a28a-13fc4b9da9be",
                        "glosses": [
                            "The art of producing such figures."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "e1a66f90-a2bf-498b-a033-9f69f94ca066",
                                "sense_id": "31407a54-fe8c-35b0-ae9d-7d4046427bfd",
                                "text": "Waxwork is a fine art, but it differs from all other fine arts in that its main purpose is one that is expressly rejected by all those other arts."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9a7546e5-e96a-4ffe-bb55-723a69df1350",
                        "source_entry_id": "e1ab612d-84b5-3154-a28a-13fc4b9da9be",
                        "source_sense_description": "a wax figure, an effigy of a famous person",
                        "target_lang_word": "personnage en cire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "8bc07de6-7e4a-4866-90c8-881f396b21fe",
                        "source_entry_id": "e1ab612d-84b5-3154-a28a-13fc4b9da9be",
                        "source_sense_description": "a wax figure, an effigy of a famous person",
                        "target_lang_word": "Wachsfigur",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wachsfigur",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "95d442d7-5bf5-3370-96c1-6244d7de7beb",
                                        "entry_id": "d3990279-8bc5-32d9-bede-f1f32b8dd134",
                                        "glosses": [
                                            "Nachbildung einer (prominenten) Person in Wachs"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "adcd22a0-280e-4c85-8bbf-41da812caf5b",
                                                "sense_id": "95d442d7-5bf5-3370-96c1-6244d7de7beb",
                                                "text": "„Und ein bisschen weiter steht Arnold selbst, der Gouverneur, als Wachsfigur.“"
                                            },
                                            {
                                                "example_id": "5e4ed6eb-d426-4656-8264-664180fac110",
                                                "sense_id": "95d442d7-5bf5-3370-96c1-6244d7de7beb",
                                                "text": "„Die Polizei des Altertums ist durch die Wachsfiguren eines Caesaren und zweier Liktoren und durch einige Fascesbündel dargestellt, was herzlich albern ist, wenn es nicht eine Huldigung für die modernen Faschisten bedeuten soll.“"
                                            },
                                            {
                                                "example_id": "813a2c7d-eb24-4a83-b61e-7df2a4b4f0aa",
                                                "sense_id": "95d442d7-5bf5-3370-96c1-6244d7de7beb",
                                                "text": "„Stattdessen musste er auf dem Sofa im Schatten einer Wachsfigur nächtigen.“"
                                            },
                                            {
                                                "example_id": "91c0de09-809f-4b70-8ff8-dcace02dfecf",
                                                "sense_id": "95d442d7-5bf5-3370-96c1-6244d7de7beb",
                                                "text": "„Seine weiblichen Wachsfiguren waren ein endloses Konzentrat der Unreife und Treulosigkeit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "30a2e8ff-efb6-4513-b3bb-954516f6c34e",
                        "source_entry_id": "e1ab612d-84b5-3154-a28a-13fc4b9da9be",
                        "source_sense_description": "a wax figure, an effigy of a famous person",
                        "target_lang_word": "воскова́я фигу́ра",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "d7554c70-07de-4e7f-86ed-2504587c279d",
                        "source_entry_id": "e1ab612d-84b5-3154-a28a-13fc4b9da9be",
                        "source_sense_description": "a wax figure, an effigy of a famous person",
                        "target_lang_word": "муля́ж",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "муля́ж",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "131e69f3-19bb-3ea9-b947-9905f18a014e",
                                        "entry_id": "50eacea1-038e-3661-8b4d-ba8d29c3685d",
                                        "glosses": [
                                            "модель; слепок предмета в натуральную величину (из папье-маше, гипса, воска, парафина, пластика и т. п.), точно передающий его форму, строение поверхности, окраску; используется для театральных и кинопостановок, в учебных целях, для осуществления мошенничества и т. п."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed99f7b8-210e-4fb2-abe0-6a11e84ee8d2",
                                                "sense_id": "131e69f3-19bb-3ea9-b947-9905f18a014e",
                                                "text": "Рядовой Тепурджиди перед лицом своих товарищей опасливо выкручивает взрыватель из муляжа противотанковой мины."
                                            },
                                            {
                                                "example_id": "7a5a09ff-a9ae-478d-a56c-d2e326fe92cb",
                                                "sense_id": "131e69f3-19bb-3ea9-b947-9905f18a014e",
                                                "text": "Есть в Москве место, куда рано или поздно обязательно должен заглянуть каждый питающийся москвич. Сделать это нетрудно: надо постучаться в дверь, заплатить три тысячи целковых за входной билет и переступить порог. В этом месте вас ждёт неслыханная, огромная, разнообразная и всесторонняя еда. У этой еды единственный недостаток — она несъедобная. Потому что это место — московский Музей общественного питания. Муляжи, бутафория, портреты и фотографии всего того, что за XX век скушали москвичи, — от царских фазанов до общепитовских котлет."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32d863d2-dfa5-3be2-ad79-438ea6d30837",
                                        "entry_id": "50eacea1-038e-3661-8b4d-ba8d29c3685d",
                                        "glosses": [
                                            "спец. то же, что анатомический муляж"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79335182-b40e-4d42-aede-20af91cf6ecf",
                                                "sense_id": "32d863d2-dfa5-3be2-ad79-438ea6d30837",
                                                "text": "Прежде здесь находился медицинский институт — ещё висели на сте́нах муляжи с мёртвыми, страшными лицами, наполовину содранными, чтобы показать, как расположены нервы."
                                            },
                                            {
                                                "example_id": "d1f7ef16-291e-4fed-96a1-7b8673a9729c",
                                                "sense_id": "32d863d2-dfa5-3be2-ad79-438ea6d30837",
                                                "text": "А этот случайный и, должно быть, словоохотливый собеседник уже доказывал ему, почему даже вот так красочно и как будто неплохо исполненный муляж сердца всё-таки не даёт полного представления о настоящем сердце, такого представления, какое должно быть у врача."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
