                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "957d59e2-8c8d-4330-b27a-9fb219313708",
                                "sense_id": "a9660193-c594-3759-9836-13bf14e18cb8",
                                "text": "De ziekte van Alzheimer is mogelijk af te remmen door de verminderde aanmaak van serotonine tegen te gaan bij patiënten."
                            },
                            {
                                "example_id": "5efc5371-ec3a-4be2-955b-86fa039fd802",
                                "sense_id": "a9660193-c594-3759-9836-13bf14e18cb8",
                                "text": "Er ontstaat een soort gelukscocktail zodra je de hele dag loopt. Een mix van endorfine, serotonine, dopamine, oxytocine en testosteron."
                            }
                        ]
                    }
                ],
                "translations": [
