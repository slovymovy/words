                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1714896c-089c-4efa-801f-beb4859d129f",
                                "sense_id": "aa11cbe3-0269-3e93-a504-47055b38f31c",
                                "text": "Für Raucher besteht ein erhöhtes Krebsrisiko."
                            },
                            {
                                "example_id": "938c9fce-6828-4316-a798-6024fb047365",
                                "sense_id": "aa11cbe3-0269-3e93-a504-47055b38f31c",
                                "text": "„Alkohol wirkt als Zellgift und schädigt die Erbsubstanz der Schleimhäute, der Speiseröhre und der Leber. Dies erhöht das Krebsrisiko.“"
                            }
                        ],
