                "senses": [
                    {
                        "sense_id": "9aa9193a-0835-353e-8095-e8fa7eb9e35d",
                        "entry_id": "cd3ba3e6-39f5-33c9-8500-9fbab0c87ed0",
                        "glosses": [
                            "Änderung des Plans"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf23ad6d-492c-4ac7-afdd-72c0a1e55d4c",
                                "sense_id": "9aa9193a-0835-353e-8095-e8fa7eb9e35d",
                                "text": "Wegen der Planänderung mussten wir eine Stunde früher aufstehen."
                            },
                            {
                                "example_id": "d0ca795a-2c7c-4da6-ae5e-ee8f165681b2",
                                "sense_id": "9aa9193a-0835-353e-8095-e8fa7eb9e35d",
                                "text": "„\"Ich hatte das Team darum gebeten, weil ich mich dann mehr fokussieren kann\", begründete Rosberg die kurzfristige Planänderung bei den Silberpfeilen. “"
                            },
                            {
                                "example_id": "ba3cf2fb-c648-4798-8c6d-eb22abd8438f",
                                "sense_id": "9aa9193a-0835-353e-8095-e8fa7eb9e35d",
                                "text": "„Als Ben und ich nach unserer abendlichen Runde durch ein nachtstilles Islington die Tür zu seinem Elternhaus aufschlossen, empfing uns Naomie schon im Flur mit der Nachricht, dass es leider eine klitzekleine Planänderung gebe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
