                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ba649722-0d34-4c2b-b010-723c6b935316",
                        "entry_id": "22a6e62b-9b8e-37d5-8316-6020d7fa0d7c",
                        "tags": [
                            "plural"
                        ],
                        "form": "opalescences"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5893af3d-9023-332d-9bf2-613083c7e78d",
                        "entry_id": "22a6e62b-9b8e-37d5-8316-6020d7fa0d7c",
                        "glosses": [
                            "Propriété optique d’un matériau transparent ou translucide qui lui donne un aspect ou une teinte laiteuse, avec des reflets irisés rappelant ceux de l’opale."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "55459708-6332-4014-bd12-24e6afa690ab",
                                "sense_id": "5893af3d-9023-332d-9bf2-613083c7e78d",
                                "text": "En outre, l’intensité de l’opalescence augmente dans le même sens que l’écart des indices."
                            }
                        ]
                    },
                    {
                        "sense_id": "f5020d13-969a-3b4d-9b29-2d47ce7923b9",
                        "entry_id": "22a6e62b-9b8e-37d5-8316-6020d7fa0d7c",
                        "glosses": [
                            "Matériau reflétant la lumière."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "9fa4cac0-a5ed-4620-bff1-fb6406791b7d",
                                "sense_id": "f5020d13-969a-3b4d-9b29-2d47ce7923b9",
                                "text": "Voilà la raison de l’opalescence : les gouttes de graisse du lait dévient ou renvoient la lumière, qui se trouve éparpillée en toutes directions."
                            }
                        ]
                    }
                ],
