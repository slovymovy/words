            "pos": "noun",
            "senses": [
                {
                    "sense_id": "04349a74-cc64-3bb4-8305-902f0f87cb22",
                    "sense_definition": "Acte juridique par lequel une personne exprime ses dernières volontés et dispose de ses biens après son décès.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "droit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avant de partir en voyage, il a décidé de faire son <w>testament</w> chez un notaire."
                        },
                        {
                            "text": "Toute la famille s'est réunie pour assister à la lecture officielle du <w>testament</w>."
                        }
                    ],
                    "synonyms": [
                        "dernières volontés"
                    ],
                    "common_phrases": [
                        "faire son testament",
                        "rédiger un testament",
                        "testament olographe"
                    ]
                },
                {
                    "sense_id": "7180f3cc-5827-3631-9dae-6ea15ca563a8",
                    "sense_definition": "Chacune des deux grandes divisions des Écritures sacrées dans la religion chrétienne.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'Ancien <w>Testament</w> rassemble les textes sacrés rédigés avant la venue du Christ."
                        },
                        {
                            "text": "Ce chercheur étudie les quatre évangiles conservés dans le Nouveau <w>Testament</w>."
                        }
                    ],
                    "common_phrases": [
                        "Ancien Testament",
                        "Nouveau Testament"
                    ]
                },
                {
                    "sense_id": "3fd70b41-1009-30c7-b623-dc786b1d8826",
                    "sense_definition": "Recommandations morales, spirituelles ou intellectuelles qu'une personne transmet à ses proches ou à la postérité.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "figuré",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le philosophe a consigné toute sa sagesse dans un véritable <w>testament</w> spirituel."
                        },
                        {
                            "text": "Publié après sa mort, ce discours constitue le testament politique du dirigeant."
                        }
                    ],
                    "synonyms": [
                        "legs"
                    ],
                    "common_phrases": [
                        "testament politique",
                        "testament spirituel"
                    ]
                }
            ]
