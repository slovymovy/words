                                        "entry_id": "fb63f0a5-9625-3b94-873b-38946c926e71",
                                        "glosses": [
                                            "Série de satellites lancés par l’URSS au tout début de la conquête de l’espace et qui fit entrer l’Homme dans l’ère spatiale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d0e1282-08f6-42c8-89f8-e94ecad9bff5",
                                                "sense_id": "f4cf6c03-a921-30ac-9bc9-b30da899f262",
                                                "text": "Spoutnik 1 a été le premier satellite artificiel de la Terre, mis sur orbite le 4 octobre 1957, par la fusée R-7."
                                            },
                                            {
                                                "example_id": "761fd83d-4c91-49e7-8c48-fa159bac69ee",
                                                "sense_id": "f4cf6c03-a921-30ac-9bc9-b30da899f262",
                                                "text": "Ce nouveau départ dans la vie fut préparé avec autant de soin que le placement d’un spoutnik sur son orbite, et j’allais bientôt découvrir que j’entrais, en effet, dans un autre univers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e64f38d-4521-3dae-a352-efaf3d28183f",
                                        "entry_id": "fb63f0a5-9625-3b94-873b-38946c926e71",
                                        "glosses": [
                                            "Chose inattendue."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82173aa6-4623-4280-ac38-d378b9de0cf8",
                                                "sense_id": "1e64f38d-4521-3dae-a352-efaf3d28183f",
                                                "text": "Après un changement de couleur 1/1, le contre de l’ouvreur est un spoutnik indiquant une bonne main avec trois cartes dans la majeure de réponse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98b692ec-17ee-3389-ac48-e6d86ee45fe9",
                                        "entry_id": "fb63f0a5-9625-3b94-873b-38946c926e71",
                                        "glosses": [
                                            "Virophage spoutnik."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
