    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "25bfca01-d271-3480-b39e-0ca65ef4d36f",
                "word": "wainscot",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "890a89bb-475a-47e9-ae3a-c5ac1c452416",
                        "entry_id": "25bfca01-d271-3480-b39e-0ca65ef4d36f",
                        "tags": [
                            "plural"
                        ],
                        "form": "wainscots"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "08d27772-c594-3ccb-a0ab-ddde5141bd00",
                        "entry_id": "25bfca01-d271-3480-b39e-0ca65ef4d36f",
                        "glosses": [
                            "An area of wooden (especially oaken) panelling on the lower part of a room’s walls."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "903f209d-246a-42f4-a6f1-e0d3ad365303",
                                "sense_id": "08d27772-c594-3ccb-a0ab-ddde5141bd00",
                                "text": "[…] this fellow will but join you together as they join wainscot; then one of you will prove a shrunk panel, and like green timber, warp, warp."
                            },
                            {
                                "example_id": "60b86e93-7ea3-42bd-9b21-12012d48a9f4",
                                "sense_id": "08d27772-c594-3ccb-a0ab-ddde5141bd00",
                                "text": "Entering that gable-ended Spouter-Inn, you found yourself in a wide, low, straggling entry with old-fashioned wainscots, reminding one of the bulwarks of some condemned old craft."
                            }
                        ]
                    },
                    {
                        "sense_id": "55300adb-0eea-3864-9960-85fa45d86ada",
                        "entry_id": "25bfca01-d271-3480-b39e-0ca65ef4d36f",
                        "glosses": [
                            "Any of various noctuid moths."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7956e74b-2bad-491c-a331-7f76e32565fd",
                        "source_entry_id": "25bfca01-d271-3480-b39e-0ca65ef4d36f",
                        "source_sense_description": "an area of wooden panelling on the lower part of a room's walls",
                        "target_lang_word": "lambrisering",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lambrisering",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "cd126dd4-a69a-3a68-8cd6-0223ff500504",
                                        "entry_id": "d7b14b75-e511-3bb2-8b5e-c1f375611f67",
                                        "glosses": [
                                            "houten bekleding van de onderkant van de wand, tegenwoordig meestal tot rugleuninghoogte of lager"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8608aa44-063d-4293-9977-1ab061f3cf24",
                                                "sense_id": "cd126dd4-a69a-3a68-8cd6-0223ff500504",
                                                "text": "Van oud hout, „van de boer, de kringloop en de straat”, maakte Oosterhoff schuifdeuren en lambrisering. Door alle kamers legde Linzel Perzische tapijten. „In de tussenkamer kun je de vloer niet meer zien.” De muren stuukte ze zelf „expres een beetje rommelig” en werden rokerig geschilderd."
                                            },
                                            {
                                                "example_id": "193d0957-4e9a-4eb3-8a31-ad861713c82f",
                                                "sense_id": "cd126dd4-a69a-3a68-8cd6-0223ff500504",
                                                "text": "Terwijl ik goedkeurend met mijn vinger langs de vergulde lambrisering streek, de dikte voelde van de stof van de zware, oker overgordijnen en de stoel wegschoof om de openslaande deuren te openen naar het terras, dat uitzicht bood op de rozentuin, of wat daarvan over was, en de vijver met de defecte fontein, bedacht ik dat ik nog tijd genoeg zou hebben om deze kamer en detail te beschrijven."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0f5a584b-a618-4a2e-8369-20774a81d548",
                        "source_entry_id": "25bfca01-d271-3480-b39e-0ca65ef4d36f",
                        "source_sense_description": "an area of wooden panelling on the lower part of a room's walls",
                        "target_lang_word": "пане́ль",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "пане́ль",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "e698643d-4acc-3b75-8e3d-56b304151976",
                                        "entry_id": "7de08c21-95c8-35ce-945b-75244f3a0050",
                                        "glosses": [
                                            "строит. крупная плоская строительная деталь"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df08c690-efb0-497e-a9bb-759a241fb1f5",
                                                "sense_id": "e698643d-4acc-3b75-8e3d-56b304151976",
                                                "text": "Один фасад дома отделан виниловым сайдингом, другие ― вентилируемыми навесными панелями сибирского завода «Краспан»."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d768b764-bfb7-3ac8-b53e-c4e83a5faebc",
                                        "entry_id": "7de08c21-95c8-35ce-945b-75244f3a0050",
                                        "glosses": [
                                            "устар. то же, что тротуар; часть дороги, предназначенная пешеходам"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68bc2ae1-98b3-467f-9783-69d2b2fdddd9",
                                                "sense_id": "d768b764-bfb7-3ac8-b53e-c4e83a5faebc",
                                                "text": "Много столпилось людей на панели. // Люди в тревоге под крышу смотрели: // Там из окошка сквозь огненный дым // Руки ребёнок протягивал к ним."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3033cce2-f4d1-3c6c-bb2b-721788cd177b",
                                        "entry_id": "7de08c21-95c8-35ce-945b-75244f3a0050",
                                        "glosses": [
                                            "техн. то же, что пульт; поверхность прибора, аппарата, на которой монтируются приборы контроля и управления || комп. компьютерная имитация этого пульта"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c67044f-9efa-4ddf-808c-a06ed6546e47",
                                                "sense_id": "3033cce2-f4d1-3c6c-bb2b-721788cd177b",
                                                "text": "Передняя панель выглядит вполне стильно; большие круглые дефлекторы напоминают о чем-то реактивном."
                                            },
                                            {
                                                "example_id": "6667e7f9-301d-48e1-8a27-253714bc1f93",
                                                "sense_id": "3033cce2-f4d1-3c6c-bb2b-721788cd177b",
                                                "text": "Панель задач."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7864c897-24aa-3f65-802f-682acbc25608",
                                        "entry_id": "7de08c21-95c8-35ce-945b-75244f3a0050",
                                        "glosses": [
                                            "комп. то же, что матрица; отображающая часть плоского (ЖК- или плазменного) монитора, телевизора"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1913f093-a82c-4670-bc89-bc755949d88b",
                                                "sense_id": "7864c897-24aa-3f65-802f-682acbc25608",
                                                "text": "Уровень «чёрного» несколько великоват ― фильмы «ночного» жанра не так темны, как на плазменной панели."
                                            }
                                        ]
                                    }
                                ]
                            },
