                                "example_id": "6c06059d-8419-4d0f-97f3-db3335a2437a",
                                "sense_id": "dfd2731e-6cc5-3aab-b49d-c06329d35136",
                                "text": "„Da begab es sich, daß Sie an einem heiteren Aprilmorgen die Ortschaft Kretz durchfuhren und Ihr Sonnengefährt vor dem noch unverputzten Einfamilienhäuschen der Schlottaus parkierten.“"
                            },
                            {
                                "example_id": "98321313-1738-4d8f-96ff-9d6779c9cb82",
                                "sense_id": "dfd2731e-6cc5-3aab-b49d-c06329d35136",
                                "text": "An einem Aprilmorgen klingelte anstatt des Weckers das Mobiltelefon."
                            }
