                                    },
                                    {
                                        "sense_id": "77793875-affd-3219-802f-3efde1eeea06",
                                        "entry_id": "11e62d0d-7d94-3fee-8fca-d44bda278802",
                                        "glosses": [
                                            "Ausgleich einer verminderten Leistung eines Organs durch gesteigerte Tätigkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f358386f-c480-447d-9c6e-cc34e4af5b9b",
                                                "sense_id": "77793875-affd-3219-802f-3efde1eeea06",
                                                "text": "„Diesen Inselbegabungen geht in der Regel eine Schädigung der linken Gehirnhälfte voraus, die Extremleistung ist das Ergebnis einer Kompensation der rechten Gehirnhälfte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "7c34f600-a386-3329-aa17-7267faf7e573",
                                        "entry_id": "11e62d0d-7d94-3fee-8fca-d44bda278802",
                                        "glosses": [
                                            "ein gewisser Vorteil für einen Spieler, den er erhält, weil er einen anderweitigen Nachteil in Kauf genommen hat"
                                        ],
                                        "tags": [
                                            "Schach"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a54081e1-1ac5-4416-8385-f913c1ba3faf",
                                                "sense_id": "7c34f600-a386-3329-aa17-7267faf7e573",
                                                "text": "Schwarz opferte in der Eröffnung einen Bauern, erhielt dafür aber einen starken Königsangriff und hatte damit mehr als ausreichende Kompensation."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
