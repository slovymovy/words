    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d232f537-972a-37fa-a941-8b40cc18bbbd",
                    "sense_definition": "Qui n'a subi aucun dommage corporel, matériel ou moral lors d'un accident ou d'un événement dangereux.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "securite_integrite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Par miracle, le conducteur est sorti <w>indemne</w> de cet accident de voiture particulièrement violent."
                        },
                        {
                            "text": "Malgré la force de la tempête, notre vieille maison de campagne est restée totalement <w>indemne</w>."
                        }
                    ],
                    "synonyms": [
                        "sain et sauf",
                        "en un seul morceau"
                    ],
                    "common_phrases": [
                        "sortir indemne"
                    ]
                },
                {
                    "sense_id": "5159e943-61a4-382c-b75d-beca708aa0cd",
                    "sense_definition": "Qui n'a éprouvé aucune perte financière dans une affaire ou qui se trouve entièrement dédommagé.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "finances_droit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Grâce à cette clause de garantie, l'investisseur est sorti <w>indemne</w> de la faillite de l'entreprise."
                        },
                        {
                            "text": "Le contrat d'assurance stipule clairement que l'associé doit être rendu <w>indemne</w> de toute charge."
                        }
                    ],
                    "common_phrases": [
                        "rendre indemne"
                    ]
                }
            ]
        }
    ]
