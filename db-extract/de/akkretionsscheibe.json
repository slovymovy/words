                ],
                "senses": [
                    {
                        "sense_id": "3a9c01f4-c8d9-342a-bf69-4cdcb89da91b",
                        "entry_id": "9f02fce4-9b4b-3aaa-90f2-bc73322fb2b4",
                        "glosses": [
                            "eine um ein zentrales Objekt rotierende Scheibe, die Materie in Richtung des Zentrums transportiert (akkretiert)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f3efc3b-9017-4f9c-8c0b-1dbe3edce60b",
                                "sense_id": "3a9c01f4-c8d9-342a-bf69-4cdcb89da91b",
                                "text": "„Typische Systeme dieser Art sind Röntgendoppelsterne aus einem Stern, der gerade zu einem Roten Riesen expandiert, und einem Neutronenstern, wobei Material zum Neutronenstern strömt, eine Akkretionsscheibe um ihn herum bildet und schließlich auf seine Oberfläche stürzt.“"
                            },
                            {
                                "example_id": "5b0d519a-5fcd-4383-aa88-271f44e9da97",
                                "sense_id": "3a9c01f4-c8d9-342a-bf69-4cdcb89da91b",
                                "text": "„Das umgebende Gas läuft in einer Akkretionsscheibe um das Schwarze Loch und heizt sich beim Einfall sehr stark auf, Gasjets werden dann senkrecht zur Scheibenebene ausgestoßen und erzeugen die Gammablitze.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
