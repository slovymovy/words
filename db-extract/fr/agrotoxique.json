                                            {
                                                "example_id": "d5997e81-1f29-40d9-a3df-6207be1678c5",
                                                "sense_id": "64fd88c9-0552-3870-af0a-c3190e97f3c5",
                                                "text": "“Twelve pesticides commonly applied to citrus groves are slated for study in the project’s plots,” reports Tom S. Bellows, UC Riverside assistant entomologist. They include four acaricides (Morestan, Kelthane, Pictran, Vendex), four thripsicides (Cygon, Carzol, Orthene, Sabadilla), and four scalicides (Parathion, Supracide, Lorsban, Sevin)."
                                            },
                                            {
                                                "example_id": "efcc1f6d-9473-410c-bd27-81ac7c290b6c",
                                                "sense_id": "64fd88c9-0552-3870-af0a-c3190e97f3c5",
                                                "text": "Too much pesticide was applied and then washed from the fields by rains and surface runoff."
                                            },
                                            {
                                                "example_id": "7fbe3985-1fdc-41df-bfad-16977339210f",
                                                "sense_id": "64fd88c9-0552-3870-af0a-c3190e97f3c5",
                                                "text": "Pesticide and fertilizer use has been recorded since ancient times, […]"
                                            },
                                            {
                                                "example_id": "013f3062-7ca6-4a8d-898e-c067ee471f81",
                                                "sense_id": "64fd88c9-0552-3870-af0a-c3190e97f3c5",
                                                "text": "Diluted neem oil can be effective as a pesticide and can control various fungal diseases, such as powdery mildew, on animals and plants."
                                            }
                                        ]
