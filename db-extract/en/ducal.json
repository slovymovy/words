                    {
                        "sense_id": "475188e8-761f-3da9-ac50-851e4b6a3451",
                        "entry_id": "cdf62c48-ac13-30cc-b9d7-ba4c4342e2a2",
                        "glosses": [
                            "Of or pertaining to a duke, a duchess, or the duchy or dukedom they hold."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7cb67b02-365c-4458-995e-46db5f70509f",
                                "sense_id": "475188e8-761f-3da9-ac50-851e4b6a3451",
                                "text": "Ahead of the king’s coming, the Duke of Norfolk will arrive to guarantee order [...] and he will not come with an army, but only his ducal train."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f575e6f5-24e8-49b5-9b40-086eb270604e",
                        "source_entry_id": "cdf62c48-ac13-30cc-b9d7-ba4c4342e2a2",
                        "source_sense_id": "475188e8-761f-3da9-ac50-851e4b6a3451",
                        "source_sense_description": "relating to a duke or duchess",
                        "target_lang_word": "hertogelijk",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hertogelijk",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "a3061670-baca-3580-ac86-3322927f3ffa",
                                        "entry_id": "94f40bc4-5c4c-3d6b-bfdb-08654388b968",
                                        "glosses": [
                                            "van de hertog"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d6da631-01a8-47f2-9233-6cb77d2cdd96",
                                                "sense_id": "a3061670-baca-3580-ac86-3322927f3ffa",
                                                "text": "De vader had het geluk in 1516 Bona Sforza uit het beroemde Milanese hertogelijk geslacht te huwen; zij introduceerde bloemen, muziek, schilderkunst, en goede tafelmanieren en had een scherpe intuïtie voor wat betreft de verdediging van koninklijke prerogatieven."
                                            },
                                            {
                                                "example_id": "9835912b-a04b-4daf-ac61-a4d9ea08a283",
                                                "sense_id": "a3061670-baca-3580-ac86-3322927f3ffa",
                                                "text": "De jonge vrouw laat telkens met zichtbare weerzin de spijzen wegnemen, die haar op het hertogelijk zilveren servies worden voorgediend, haar echtgenoot eet even weinig als zij, doch drinkt bijna voortdurend uit de gouden beker, die de achter hem staande majordomus telkens vult en nauwgezet aan de eigen lippen brengt, voor hij hem zijn meester toereikt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7a10f2e0-dbe2-4913-9031-ff76309dff17",
                        "source_entry_id": "cdf62c48-ac13-30cc-b9d7-ba4c4342e2a2",
                        "source_sense_id": "475188e8-761f-3da9-ac50-851e4b6a3451",
                        "source_sense_description": "relating to a duke or duchess",
                        "target_lang_word": "ducal",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
