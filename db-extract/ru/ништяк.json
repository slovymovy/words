                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2e5a80e-a65f-401f-8623-b58d0577132f",
                                                "sense_id": "f3ee97b9-a6a3-3b4c-b8d9-a176fbac3f99",
                                                "text": "I promise to give it back. – OK."
                                            },
                                            {
                                                "example_id": "bef40efa-1661-4ade-bf58-4656a29a1f5a",
                                                "sense_id": "f3ee97b9-a6a3-3b4c-b8d9-a176fbac3f99",
                                                "text": "Let's meet again this afternoon. – OK."
                                            },
                                            {
                                                "example_id": "1541bd29-b7a5-454d-b94a-95480b94ed5a",
                                                "sense_id": "f3ee97b9-a6a3-3b4c-b8d9-a176fbac3f99",
                                                "text": "Shut up! – OK, OK."
                                            },
                                            {
                                                "example_id": "1d25d0bb-4fa7-4a19-b29f-82333b25cc1a",
                                                "sense_id": "f3ee97b9-a6a3-3b4c-b8d9-a176fbac3f99",
                                                "text": "OK! I get it! Stop nagging me!"
                                            },
                                            {
                                                "example_id": "4fbd4cd9-43f6-411b-86e3-8f2e4d38c096",
                                                "sense_id": "f3ee97b9-a6a3-3b4c-b8d9-a176fbac3f99",
                                                "text": "Come by this afternoon. — Okay."
                                            }
                                        ]
                                    },
