                "senses": [
                    {
                        "sense_id": "08fbf98a-2994-3831-9806-177ab64ebb42",
                        "entry_id": "ce578d7b-043b-3878-bfc0-7feb81d7df98",
                        "glosses": [
                            "Prunus, genre d'arbres de la famille des rosacées."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "11bab2bd-b46d-3ee8-a92e-179236de9e9c",
                        "entry_id": "ce578d7b-043b-3878-bfc0-7feb81d7df98",
                        "glosses": [
                            "Prunus domestica, arbre fruitier qui produit les prunes."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "80662cf0-9db3-4ab1-bb4b-cf76c1db0526",
                                "sense_id": "11bab2bd-b46d-3ee8-a92e-179236de9e9c",
                                "text": "Quelques arbres, des amandiers, des pruniers et des abricotiers montraient leurs têtes grêles çà et là, dans cet enclos."
                            },
                            {
                                "example_id": "c164c98c-0ab4-4360-9844-c21f96799def",
                                "sense_id": "11bab2bd-b46d-3ee8-a92e-179236de9e9c",
                                "text": "Un escabeau s’appuie contre le prunier d’ente."
                            },
                            {
                                "example_id": "0cf0f5c6-5b67-4b0c-a475-6c5afe469b90",
                                "sense_id": "11bab2bd-b46d-3ee8-a92e-179236de9e9c",
                                "text": "Les vieux, quand ils créaient un verger, plantaient alternativement un pommier et un prunier."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a5f9721e-ca4e-44ca-a0d2-2c522b4c7438",
                        "source_entry_id": "ce578d7b-043b-3878-bfc0-7feb81d7df98",
                        "target_lang_word": "Pflaumenbaum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pflaumenbaum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "22d02bb9-d1a0-3069-a00a-a2bdbba6c2f5",
                                        "entry_id": "a32ec464-3218-329b-806a-33df12c297e4",
                                        "glosses": [
                                            "ein Obstbaum, der im Herbst blaue oder rötliche Früchte, genauer: Steinfrüchte, trägt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5cdbfa42-c751-4f6b-b2ea-9673a5d4e447",
                                                "sense_id": "22d02bb9-d1a0-3069-a00a-a2bdbba6c2f5",
                                                "text": "Das Holz des Pflaumenbaumes ist hart, dicht (spez. Gewicht etwa 0,79) und spröde. Es ist sehr schwer zu trocknen, schwindet stark und reißt sehr leicht."
                                            },
                                            {
                                                "example_id": "18dbe36e-86b7-47d0-b15c-66db9fc655ee",
                                                "sense_id": "22d02bb9-d1a0-3069-a00a-a2bdbba6c2f5",
                                                "text": "Sich Zeit lassen zum Wachsen und Reifen, ist eine Tugend, die mich mein Pflaumenbaum gelehrt hat, der Jahre lang keine Früchte trug. Ein Plädoyer für Geduld, so Hildegard König von der katholischen Kirche."
                                            },
                                            {
                                                "example_id": "9abadaaa-5202-48f0-8a01-c24b4dd041f3",
                                                "sense_id": "22d02bb9-d1a0-3069-a00a-a2bdbba6c2f5",
                                                "text": "Apfel- und Birnbäume, Kirsch- und Pflaumenbäume alter Sorten wachsen hier [im Garten des fränkischen Lustschlosses Fantaisie], die Stämme noch dünn wie die Pfähle von Verkehrsschildern."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
