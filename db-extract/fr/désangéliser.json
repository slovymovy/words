                                "example_id": "86be39aa-12a5-4396-afde-dc622851c265",
                                "sense_id": "c6167226-f4cc-36a8-ac53-070583a59482",
                                "text": "Remettre l’église au milieu du village, en quelque sorte, mais aussi en finir avec une image convenue de Nodier, désangéliser le «bon Nodier » !"
                            },
                            {
                                "example_id": "6259c101-9056-4a07-a68d-9a9903d3c0f5",
                                "sense_id": "c6167226-f4cc-36a8-ac53-070583a59482",
                                "text": "Je ne veux pas critiquer l'impérialisme russe plus qu'un autre, je veux le désangéliser..."
                            },
                            {
                                "example_id": "c49c2836-384a-499d-8b94-64da9b1e0dc6",
                                "sense_id": "c6167226-f4cc-36a8-ac53-070583a59482",
                                "text": "Est-ce que vous acceptez de \"désangéliser\" ce qui n'est pas prostitutionnel et de \"dédiaboliser\" ce qu'il est?"
                            }
                        ]
                    }
