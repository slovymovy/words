                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20e29e6c-e686-455f-8f6e-5896ad0c8077",
                                                "sense_id": "a08e0fa7-917d-3a00-b25f-6c3e24c5c4fd",
                                                "text": "Mi amigo le tiene miedo a los ratones."
                                            }
                                        ],
