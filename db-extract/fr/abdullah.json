                        ],
                        "examples": [
                            {
                                "example_id": "55ae3d7e-6157-4bb6-82d0-f8fc5b7f01e1",
                                "sense_id": "31b161bf-f108-3ed5-9f3f-cd01e710aad1",
                                "text": "Bellegarde tirait de la poche veston un étui en argent, dont il allait extirper une savoureuse abdullah, lorsqu'il se vit tout à coup environné par une bande de camelots qui criaient la troisième édition d'un journal du soir."
                            },
                            {
                                "example_id": "8ab1dfb8-5232-434c-a5ec-36fcb4a0d26a",
                                "sense_id": "31b161bf-f108-3ed5-9f3f-cd01e710aad1",
                                "text": "Une jeune soubrette, […], emplit les verres, déposa sur le guéridon deux cendriers, une boite vierge d'abdullahs et se retira discrètement."
                            }
                        ]
                    }
                ],
