                    {
                        "translation_id": "a7468b4a-fa42-4626-ad45-2f348a45e96f",
                        "source_entry_id": "cae9e769-0a85-35d2-aeda-27bba470bbf5",
                        "source_sense_id": "b0c886d3-4ef7-3e5f-8f4f-533dc90e48df",
                        "target_lang_word": "dalmatien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dalmatien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2bd5ca3c-05b3-3696-8496-950dcfc28d44",
                                        "entry_id": "fe8feddc-1cd2-349a-9aed-db097f1e2ea6",
                                        "glosses": [
                                            "Race de chien de chasse et d’agrément, originaire de Croatie, de taille moyenne, au poil court et brillant, à robe blanche avec tâches rondes noires ou marron."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfcae97b-0177-4c72-8fec-5fbfd9ba396d",
                                                "sense_id": "2bd5ca3c-05b3-3696-8496-950dcfc28d44",
                                                "text": "Après la mode des labradors et dalmatiens, une nouvelle tendance a suivi : celle des « molosses », American Staffordshire terrier, malinois et autres dogues."
                                            },
                                            {
                                                "example_id": "c3b91a27-14bb-4257-8046-fe17781b2d32",
                                                "sense_id": "2bd5ca3c-05b3-3696-8496-950dcfc28d44",
                                                "text": "Ces chiens ont été rendus très populaires par un dessin animé de Walt Disney dont ils étaient les héros, intitulé « Les 101 Dalmatiens »."
                                            },
                                            {
                                                "example_id": "6861b38e-642e-4e8c-8256-f5c27a253427",
                                                "sense_id": "2bd5ca3c-05b3-3696-8496-950dcfc28d44",
                                                "text": "Lorsqu’une robe blanche comporte des taches circulaires noires ou brunes bien délimitées comme chez le dalmatien, on dit que l’on a une robe « tigrée »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6ea1e307-b96d-4725-8a30-105c8ec50ea9",
                        "source_entry_id": "cae9e769-0a85-35d2-aeda-27bba470bbf5",
                        "source_sense_id": "b0c886d3-4ef7-3e5f-8f4f-533dc90e48df",
                        "target_lang_word": "Dalmatiner",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dalmatiner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5a2ac0c7-a727-3cde-b68d-791103ed9eaa",
                                        "entry_id": "8feb40e1-1d1b-3da3-b124-dd4b537206cb",
                                        "glosses": [
                                            "Einwohner Dalmatiens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5021ccd-6a1d-4e6a-8d88-682c9c148bc0",
                                                "sense_id": "5a2ac0c7-a727-3cde-b68d-791103ed9eaa",
                                                "text": "Die Dalmatiner sind sehr mit dem Meer verbunden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "196be622-c348-3896-81ee-ddff7fa897f3",
                                        "entry_id": "8feb40e1-1d1b-3da3-b124-dd4b537206cb",
                                        "glosses": [
                                            "aus Kroatien stammende mittelgroße Hunderasse mit auffälligen braunen oder schwarzen Tupfen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7b0988b-8bf0-4c43-891c-c9e52486051e",
                                                "sense_id": "196be622-c348-3896-81ee-ddff7fa897f3",
                                                "text": "Dalmatiner brauchen sehr viel Bewegung."
                                            },
                                            {
                                                "example_id": "660da60c-da7d-482a-83d3-922b8a14a317",
                                                "sense_id": "196be622-c348-3896-81ee-ddff7fa897f3",
                                                "text": "„Panisch leckte der Dalmatiner die Hand meines Vaters, ständig wischte die rosa Hundezunge über seine Haut und strich die dunklen Härchen glatt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "02578ba1-932c-4156-962d-582d13bdc45a",
                        "source_entry_id": "cae9e769-0a85-35d2-aeda-27bba470bbf5",
                        "source_sense_id": "b0c886d3-4ef7-3e5f-8f4f-533dc90e48df",
                        "target_lang_word": "далматин",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "далматин",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "6d458e04-c055-3577-92d2-0bc21495922a",
                                        "entry_id": "b51543b8-8baf-300d-8609-dec4b9cf2d67",
                                        "glosses": [
                                            "служебная и декоративная порода собак с белой шерстью, покрытой тёмными пятнами; собака этой породы"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0edb653f-388e-4712-801e-7915fda94a5c",
                                                "sense_id": "6d458e04-c055-3577-92d2-0bc21495922a",
                                                "text": "Если вы назовёте людей, одевающихся здесь, бедными, то не только оскорбите их, но и жестоко ошибётесь. Одна подъезжает на собственном \"Пежо\", вторая с ног до головы одета в кожу, третья привязывает к дереву у входа в магазинчик пятнистого далматина."
                                            },
                                            {
                                                "example_id": "2bf489da-9af8-4d82-b562-50225a0abd6e",
                                                "sense_id": "6d458e04-c055-3577-92d2-0bc21495922a",
                                                "text": "А что касается счастья, то для меня оно (как для писателя) — это жить с семьёй в доме на берегу озера, да чтобы дом этот был окружён соснами, и чтобы был луг, по которому мог бы бегать мой далматин."
                                            },
                                            {
                                                "example_id": "bdd7a2ad-416e-4ca6-bc7f-86d01dc27d6a",
                                                "sense_id": "6d458e04-c055-3577-92d2-0bc21495922a",
                                                "text": ".. Наташа просто обожает свою собаку — красавца далматина по кличке Тибул."
                                            },
                                            {
                                                "example_id": "2c1d6041-743d-487a-97cc-e55ab53bf0b0",
                                                "sense_id": "6d458e04-c055-3577-92d2-0bc21495922a",
                                                "text": "Вечерами я уходил в небольшой лесок неподалёку от дома, спускал с поводка своего далматина и, пока сэр Мартин наслаждался красотами вытертой и пожухлой лужайки, я лежал на спине, смотрел в небо и пытался понять, отчего мне так хорошо там, где хорошо мне быть не должно."
                                            },
                                            {
                                                "example_id": "ad45fc44-8b72-47ff-9942-1ff63bf1c010",
                                                "sense_id": "6d458e04-c055-3577-92d2-0bc21495922a",
                                                "text": "Одни из самых простых в уходе собак — шарпей, доберман, мастиф, бультерьер, питбультерьер, дог, мопс, левретка, далматин и прочие гладкошёрстные собаки."
                                            },
                                            {
                                                "example_id": "bae77d3b-8277-4f93-8abe-fdeda74e23cc",
                                                "sense_id": "6d458e04-c055-3577-92d2-0bc21495922a",
                                                "text": "Собаки оставались обитателями улиц ещё несколько лет. То были стаи породистых псов — долговязые борзые, грузные .. мастифы, игривые далматины, истеричные легавые .."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
