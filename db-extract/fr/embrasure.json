        "fr-extract.jsonl": [
            {
                "entry_id": "29ca5107-b49f-3805-bfcd-92de03ba611a",
                "word": "embrasure",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6e8c8625-0ae4-468a-8a22-0cf202068841",
                        "entry_id": "29ca5107-b49f-3805-bfcd-92de03ba611a",
                        "tags": [
                            "plural"
                        ],
                        "form": "embrasures"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7069c93d-5de3-3f99-bdc1-9f06603b8de6",
                        "entry_id": "29ca5107-b49f-3805-bfcd-92de03ba611a",
                        "glosses": [
                            "Ouverture pratiquée dans l’épaisseur des murs d’une maison, d’un appartement, pour y placer une porte, une fenêtre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33fa77d0-d255-47e2-be09-3f97beb14b1f",
                                "sense_id": "7069c93d-5de3-3f99-bdc1-9f06603b8de6",
                                "text": "Cette fenêtre était barricadée par une barre de fer dont les deux bouts entraient dans des trous pratiqués aux deux coins de l’embrasure."
                            },
                            {
                                "example_id": "4cd4cf81-659b-4a19-90f6-d0e00371ab83",
                                "sense_id": "7069c93d-5de3-3f99-bdc1-9f06603b8de6",
                                "text": "Pendant que Sophie était assise auprès de madame Necker, son tuteur causait debout avec le comte de Morvelle, dans l’embrasure d’une croisée."
                            },
                            {
                                "example_id": "00f63928-0e86-4ce8-8287-4aa0c3c40f6f",
                                "sense_id": "7069c93d-5de3-3f99-bdc1-9f06603b8de6",
                                "text": "Eh ! bien, mon petit ange, dit le père à sa fille dans l’embrasure d’une fenêtre, avoue que papa pense à tout."
                            },
                            {
                                "example_id": "4ccdb7e6-efa2-4277-90a9-f47759be6350",
                                "sense_id": "7069c93d-5de3-3f99-bdc1-9f06603b8de6",
                                "text": "Environ dix-huit mois après les événements qui remplissent la première partie de ce récit, madame de Boussac et son amie, madame de Charmois, assises dans la profonde embrasure d’une fenêtre, admiraient d’un air plus ennuyé que ravi le site admirable déployé sous leurs yeux."
                            },
                            {
                                "example_id": "ffe3c62a-798a-4765-8e82-fa165b4eba5c",
                                "sense_id": "7069c93d-5de3-3f99-bdc1-9f06603b8de6",
                                "text": "Le vent fait battre sa porte disjointe, l’herbe encombre le seuil ; il y a des nids aux angles de l’autel et dans l’embrasure des hautes croisées dont les vitraux coloriés ont disparu depuis longtemps."
                            },
                            {
                                "example_id": "0165194f-a362-4689-9cc5-cf1e64170180",
                                "sense_id": "7069c93d-5de3-3f99-bdc1-9f06603b8de6",
                                "text": "— Pourquoi n’as-tu pas d’amis ? Pourquoi refuses-tu les invitations ou demeures-tu dans les embrasures et ne danses-tu pas ?"
                            },
                            {
                                "example_id": "de4f00f8-4301-4e18-82b9-90cb38b87f8a",
                                "sense_id": "7069c93d-5de3-3f99-bdc1-9f06603b8de6",
                                "text": "La porte s'est à peine entrebâillée et, dans l'embrasure un homme est apparu, torse nu."
                            }
                        ]
                    },
                    {
                        "sense_id": "08952e4e-8ada-3cd0-87a7-1e136fb22532",
                        "entry_id": "29ca5107-b49f-3805-bfcd-92de03ba611a",
                        "glosses": [
                            "Biais qu’on donne à l’épaisseur des murs à l’endroit des fenêtres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5752798-0cba-472a-af7b-17f3156d4aa0",
                                "sense_id": "08952e4e-8ada-3cd0-87a7-1e136fb22532",
                                "text": "Les côtés de cette fenêtre n’ont pas assez d’embrasure."
                            }
                        ]
                    },
                    {
                        "sense_id": "9d6cc5f4-e3bd-3b49-9904-f4a672356f57",
                        "entry_id": "29ca5107-b49f-3805-bfcd-92de03ba611a",
                        "glosses": [
                            "Vide laissé dans l'épaisseur de mur par la baie à l'extérieur mais aussi à l’intérieur, utilisé à la place de l'ébrasement ou de l'abat-jour de fenêtre en mur épais évasé vers l'intérieur."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "ce53dd4f-3216-329c-9506-db8dde2db71a",
                        "entry_id": "29ca5107-b49f-3805-bfcd-92de03ba611a",
                        "glosses": [
                            "Vide laissé dans l'épaisseur de mur par la baie à l'extérieur mais aussi à l’intérieur, utilisé à la place de l'ébrasement ou de l'abat-jour de fenêtre en mur épais évasé vers l'intérieur.",
                            "Dans un fourneau, passage laissé vide dans l'épaisseur pour permettre l'entrée de l'air ou le passage de métal en fusion."
                        ],
                        "tags": [
                            "broadly",
                            "especially"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "762720ff-ca60-36a8-ac3e-c31555ff0231",
                        "entry_id": "29ca5107-b49f-3805-bfcd-92de03ba611a",
                        "glosses": [
                            "Ouverture pratiquée dans un parapet de bastion pour pointer et tirer du canon, entre deux merlons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a93febd-ebdc-41a9-b2ae-99cba360d03f",
                                "sense_id": "762720ff-ca60-36a8-ac3e-c31555ff0231",
                                "text": "Ce n’était qu’un balcon isolé, garanti comme à l’ordinaire par un parapet, avec des embrasures près desquelles quelques archers pouvaient se placer pour défendre la tourelle."
                            },
                            {
                                "example_id": "d6903425-959f-40cc-88b2-b4b2c6e4110f",
                                "sense_id": "762720ff-ca60-36a8-ac3e-c31555ff0231",
                                "text": "Comme elle est calme et majestueuse la citadelle blanche, sur l'Oder, tandis que de toutes les embrasures les canons aboient contre la ville et le camp."
                            },
                            {
                                "example_id": "21eec0d1-674c-4bd0-983d-e69d0398527d",
                                "sense_id": "762720ff-ca60-36a8-ac3e-c31555ff0231",
                                "text": "Pendant ce temps, le pauvre homme, pressé contre sa vache, regardait avec effarement les embrasures des canons."
                            },
                            {
                                "example_id": "1f1ea6b1-1fb7-46c2-8a54-7388859a3f38",
                                "sense_id": "762720ff-ca60-36a8-ac3e-c31555ff0231",
                                "text": "Par les embrasures ouvertes au ras du pavé, des canons aux armes des anciens podestats de la ville béaient sur un gouffre immobile de vapeurs blanches d’où montait le souffle glacial du brouillard."
                            }
                        ]
                    },
                    {
                        "sense_id": "57e9513f-aa69-3e49-a89d-ef4b1bc512a4",
                        "entry_id": "29ca5107-b49f-3805-bfcd-92de03ba611a",
                        "glosses": [
                            "Dans une roue en bois, chaque pièce de bois allant de l'axe de la roue à la jante."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "e5881467-b988-3686-954f-96a7a0c0b04e",
                        "entry_id": "29ca5107-b49f-3805-bfcd-92de03ba611a",
                        "glosses": [
                            "Petit espace se situant entre les dents."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4df607d1-cf1c-4bcd-b268-60c2a10e1a72",
                        "source_entry_id": "29ca5107-b49f-3805-bfcd-92de03ba611a",
                        "target_lang_word": "embrasure",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "embrasure",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e1104ac6-ee54-3c0d-814d-d19ed3d5a249",
                                        "entry_id": "a0a26e7f-2514-3671-973a-eaff4ff42670",
                                        "glosses": [
                                            "Any of the indentations between the merlons of a battlement; an opening in a wall or parapet through which ordnance can be fired."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb1999c0-7518-49f7-a9e7-8573ef4eea1d",
                                                "sense_id": "e1104ac6-ee54-3c0d-814d-d19ed3d5a249",
                                                "text": "Near-synonym: crenel (sometimes hyponymous technically)"
                                            },
                                            {
                                                "example_id": "bf9daf67-8795-481b-81d1-d96c2ab48350",
                                                "sense_id": "e1104ac6-ee54-3c0d-814d-d19ed3d5a249",
                                                "text": "But there were less casualties than might have been expected, and the barricade rose steadily, a wall of concrete two feet thick, with embrasures for two machine-guns and a small field gun."
                                            },
                                            {
                                                "example_id": "f8380b13-143e-463f-a530-a9147822815a",
                                                "sense_id": "e1104ac6-ee54-3c0d-814d-d19ed3d5a249",
                                                "text": "The walls are slitted with embrasures through which bowmen could fire, indicating that the belfry also served as a stronghold during border skirmishes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "884507ac-1a2d-3976-8eb1-ad7a8486cc3e",
                                        "entry_id": "a0a26e7f-2514-3671-973a-eaff4ff42670",
                                        "glosses": [
                                            "Any small protected space."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f717eb4b-7f83-44a4-8e15-0bb0ce676057",
                                                "sense_id": "884507ac-1a2d-3976-8eb1-ad7a8486cc3e",
                                                "text": "She had a special seat there, a little embrasure between two upright slabs of sandstone, which was sheltered and private."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9230d8f9-b333-34dd-9432-123bb1eba466",
                                        "entry_id": "a0a26e7f-2514-3671-973a-eaff4ff42670",
                                        "glosses": [
                                            "The slanting indentation in a wall for a door or window, such that the space is larger on the inside than the outside."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88b8f274-252d-4b3a-ba45-a27cafa9ecd9",
                                                "sense_id": "9230d8f9-b333-34dd-9432-123bb1eba466",
                                                "text": "Now he stands in a window embrasure, Liz's prayer book in hand."
                                            },
                                            {
                                                "example_id": "8e009368-2c3f-41f7-8ac0-f4f8994e9160",
                                                "sense_id": "9230d8f9-b333-34dd-9432-123bb1eba466",
                                                "text": "When the fit had spent itself he walked weakly to the window and, lifting the sash, sat in a corner of the embrasure and leaned his elbow upon the sill."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5812fc8-361e-31d6-93a8-9ee9614200ce",
                                        "entry_id": "a0a26e7f-2514-3671-973a-eaff4ff42670",
                                        "glosses": [
                                            "An embrace."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b45bce6-4aa3-453e-8452-d5c9022aa28a",
                                                "sense_id": "c5812fc8-361e-31d6-93a8-9ee9614200ce",
                                                "text": "And suddenly; where injury of chance / Puts back leave-taking, justles roughly by / All time of pause, rudely beguiles our lips / Of all rejoindure, forcibly prevents / Our lock'd embrasures, strangles our dear vows / Even in the birth of our own labouring breath:"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
