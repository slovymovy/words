                "senses": [
                    {
                        "sense_id": "edbda0c9-70eb-3dba-8f2e-f03f33f30845",
                        "entry_id": "da4ac1c7-8730-3ee6-a326-a771f5e02517",
                        "glosses": [
                            "die Schale einer Banane"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fcd06c7d-3a9a-487e-a7de-8a25fb2c501a",
                                "sense_id": "edbda0c9-70eb-3dba-8f2e-f03f33f30845",
                                "text": "Bananenschalen sollten im Biomüll entsorgt werden."
                            },
                            {
                                "example_id": "d874e9ae-7299-40ad-9394-02f98eb3c81d",
                                "sense_id": "edbda0c9-70eb-3dba-8f2e-f03f33f30845",
                                "text": "„Es ist im Prinzip dasselbe Vergnügen, nur unendlich potenziert, wie wenn man jemanden auf einer Bananenschale ausrutschen sieht.“"
                            },
                            {
                                "example_id": "634066d6-d3a1-4fcd-a6ef-cb062d64e32f",
                                "sense_id": "edbda0c9-70eb-3dba-8f2e-f03f33f30845",
                                "text": "„Florine ließ eine Bananenschale fallen, die auf den Rand der Waschwanne und von dort auf den Boden klatschte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b6b915d7-3618-47ef-8eb8-0aef08f05574",
                        "source_entry_id": "da4ac1c7-8730-3ee6-a326-a771f5e02517",
                        "source_sense_id": "edbda0c9-70eb-3dba-8f2e-f03f33f30845",
                        "source_sense_description": "die Schale einer Banane",
                        "target_lang_word": "banana peel",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "banana peel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8b3c6ddb-7584-3dfc-8b1b-0f2933f0bac0",
                                        "entry_id": "b1252d00-8404-3485-83d2-bd6c3929a218",
                                        "glosses": [
                                            "The several outermost layers of a banana, especially once removed from the rest of the banana, which may be slippery if stepped on."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "Philippines",
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6bdc0555-cd47-312e-a3aa-090725637332",
                                        "entry_id": "b1252d00-8404-3485-83d2-bd6c3929a218",
                                        "glosses": [
                                            "A cause of difficulty, or potential embarrassment."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15077fc6-f467-430c-b215-646afa76c7c7",
                                                "sense_id": "6bdc0555-cd47-312e-a3aa-090725637332",
                                                "text": "Furthermore, he is completely surrounded by banana peels. Canada's economy is slowing down, though less so far than extreme pessimists feared. Newly released figures show that our merchandise trade surplus in 1989 fell by more than half to its lowest level in 10 years. And, ever since it peaked on Jan. 12, the dollars yo-yo motion has juddered erratically, signalling confusion to the money markets of the world where the mismanagement of a national economy is judged with a harsh and unforgiving coldness. The freshest banana peel under Mr. Wilson's foot is the report that inflation in January jumped from December's 5.1 per cent to 5.5 per cent -- right on the heels of Thursday's rise of more then half a percentage point in the Bank of Canada rate."
                                            },
                                            {
                                                "example_id": "4557efa2-c32f-4aa3-b0c8-8a2069b5e810",
                                                "sense_id": "6bdc0555-cd47-312e-a3aa-090725637332",
                                                "text": "We had the first black president, trying to bring home a victory on healthcare. I didn’t want to be a banana peel for him."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e229a419-ecaa-4425-a88f-2b81def15afa",
                        "source_entry_id": "da4ac1c7-8730-3ee6-a326-a771f5e02517",
                        "source_sense_id": "edbda0c9-70eb-3dba-8f2e-f03f33f30845",
                        "source_sense_description": "die Schale einer Banane",
                        "target_lang_word": "peau de banane",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "peau de banane",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fe503d01-b268-3525-a193-f0cc4289357d",
                                        "entry_id": "98665952-fa12-350e-9413-7203469aab1a",
                                        "glosses": [
                                            "Partie externe de la banane (exocarpe, jaune et mince, soudé au mésocarpe, blanc et mou) que l’on ôte pour manger la partie comestible du fruit (endocarpe)."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99208542-c42d-4b33-acfc-932583229da9",
                                                "sense_id": "fe503d01-b268-3525-a193-f0cc4289357d",
                                                "text": "Pour nettoyer vos plantes en pots, servez-vous de l’intérieur d'une peau de banane, la poussière n’y résistera pas et les feuilles gagneront en brillance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3cbeef3-ff14-34ab-834c-0778dd26cd13",
                                        "entry_id": "98665952-fa12-350e-9413-7203469aab1a",
                                        "glosses": [
                                            "Piège ou obstacle sournoisement posé pour faire tomber (métaphoriquement) un rival ou un ennemi."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2d0d96e-e86b-434f-80de-af6341a031ff",
                                                "sense_id": "e3cbeef3-ff14-34ab-834c-0778dd26cd13",
                                                "text": "Depuis 1920, « glisser sur une peau de banane » — on dit aussi « mettre une peau de banane sous les pieds, les pas de quelqu'un » — est une allusion au caractère glissant de cette peau . Il s'agit d'un procédé déloyal destiné à faire tomber quelqu'un."
                                            },
                                            {
                                                "example_id": "5719b9b6-c2fe-49fc-bbcd-485e8793df13",
                                                "sense_id": "e3cbeef3-ff14-34ab-834c-0778dd26cd13",
                                                "text": "Depuis le début de cette campagne, le chef libéral Jean Charest zigzague entre les peaux de banane laissées sur le chemin par ses adversaires, ou encore par ses promesses non tenues du passé."
                                            },
                                            {
                                                "example_id": "5ce28962-0fae-4767-9e33-897f23337ef6",
                                                "sense_id": "e3cbeef3-ff14-34ab-834c-0778dd26cd13",
                                                "text": "La campagne est déjà suffisamment compliquée. Il faut arrêter ce jeu des petites phrases, arrêter de se lancer des peaux de banane."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b30c2f34-aa2f-4953-98c6-cfe925b862f3",
                        "source_entry_id": "da4ac1c7-8730-3ee6-a326-a771f5e02517",
