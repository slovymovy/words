                        "glosses": [
                            "Sportive pratiquant la boxe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97c9482a-e9ab-4a6f-854c-4c9245a40c23",
                                "sense_id": "1add6aad-bb17-3f9f-bd22-1687e1e90427",
                                "text": "Elle descend du lit et remue mollement d’une jambe sur l’autre comme une boxeuse qui s’échauffe."
                            },
                            {
                                "example_id": "0064b227-afa9-4951-92ab-4c231e2adef6",
                                "sense_id": "1add6aad-bb17-3f9f-bd22-1687e1e90427",
                                "text": "La boxeuse algérienne Imane Khelif a remporté la médaille d’or des -66 kg, ce vendredi 9 août, en prenant le meilleur sur la Chinoise Yang Liu à l’issue d’une finale maîtrisée."
                            },
                            {
                                "example_id": "30190060-63f7-46ed-b1f1-c60f5b9fdf8f",
                                "sense_id": "1add6aad-bb17-3f9f-bd22-1687e1e90427",
                                "text": "La boxeuse Marie-Eve Dicaire ne s’en cache pas."
                            }
                        ]
                    }
                ],
