                "senses": [
                    {
                        "sense_id": "525936f3-156a-3f61-83fc-e2a40526777f",
                        "entry_id": "177c75cd-95d0-3449-a4ab-7deea10cfce6",
                        "glosses": [
                            "Donner un caractère insécable à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0be3f03a-1aa5-4acd-8b53-c8a879a5aae8",
                                "sense_id": "525936f3-156a-3f61-83fc-e2a40526777f",
                                "text": "Ces espaces n'ont rien d'insécable. Et tu ne pourras les insécabiliser après, vu qu'il sera impossible de les différencier..."
                            },
                            {
                                "example_id": "501c302b-9574-4273-9996-4d8c7fdadc3d",
                                "sense_id": "525936f3-156a-3f61-83fc-e2a40526777f",
                                "text": "Dans XPress jusqu'à 7, pour la fine il faut utiliser le blanc variable réglé préalablement dans les préférences à 25 ou 30%, et ajouter \"Pomme\" pour \"l’insécabiliser\"... donc la fine insécable s’obtient avec Pomme+Alt+Shift+Espace."
                            },
                            {
                                "example_id": "2ca361e5-d36f-4920-a32b-4afa9a704d8d",
                                "sense_id": "525936f3-156a-3f61-83fc-e2a40526777f",
                                "text": "Question bête venant de ça : le logiciel n'insécabilise-t-il pas tout seul les espaces devant les ?!;: ?"
                            }
                        ]
                    }
