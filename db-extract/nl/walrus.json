                                                "example_id": "ac1afb75-a3a2-4316-8c95-77e3f504a8d6",
                                                "sense_id": "f4c817f8-401f-3e86-a050-2eba0e31b6a4",
                                                "text": "Zawartość alkoholu etylowego w morsie powinna wynieść od 16 do 20%."
                                            }
                                        ],
                                        "sense_index_json": "\"3.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0db607e5-c2b1-4c16-9d56-7cf3cec09dcb",
                        "source_entry_id": "b18dc094-e749-3e04-bfae-602588011db0",
                        "source_sense_id": "38e8ada0-ffd0-3cf4-acba-95dacfe922d4",
                        "source_sense_description": "bepaald soort zoogdier, Odobenus rosmarus",
                        "target_lang_word": "морж",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "морж",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "5cc9a246-74d5-39fc-bd74-28882cd66dfe",
                                        "entry_id": "abfdf14c-8e0a-39b0-803a-48bf95638f9b",
                                        "glosses": [
                                            "зоол. морское ластоногое млекопитающее с короткой грубой жёлтой шерстью, длинными клыками и длинными усами (Odobenus rosmarus)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eea3c4ab-0740-493a-969a-3911a75cd4dd",
                                                "sense_id": "5cc9a246-74d5-39fc-bd74-28882cd66dfe",
                                                "text": "Усы, ещё мокрые, потемнели и висели вниз двумя густыми сосульками, точно у моржа."
                                            },
                                            {
                                                "example_id": "f8a6bbb4-bd2a-4b52-af1b-a6d61b94a8a6",
                                                "sense_id": "5cc9a246-74d5-39fc-bd74-28882cd66dfe",
                                                "text": "Ноги у моржей и тюленей называются ластами — не то лапы, не то плавники. … Морж — лев северных морей, он сильный и храбрый зверь."
                                            },
                                            {
                                                "example_id": "93d360f0-b6d6-41fe-b2aa-61cefe6ee8cb",
                                                "sense_id": "5cc9a246-74d5-39fc-bd74-28882cd66dfe",
                                                "text": "Два ослепительно белых клыка, длиной не менее тридцати сантиметров, спускались из верхней челюсти, как у моржа."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b402fb2-dc01-3685-aca8-58e736d9c053",
                                        "entry_id": "abfdf14c-8e0a-39b0-803a-48bf95638f9b",
                                        "glosses": [
                                            "тот, кто занимается моржеванием, купанием в ледяной воде"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "687fb1fb-f624-46c6-b010-beb7180d14a5",
                                                "sense_id": "3b402fb2-dc01-3685-aca8-58e736d9c053",
                                                "text": "Ростовцев его успокоил, уверив, что он закалённый, одно время был моржом."
                                            },
                                            {
                                                "example_id": "c6165d22-4ac7-4fde-b63c-9e6e9abbbde4",
                                                "sense_id": "3b402fb2-dc01-3685-aca8-58e736d9c053",
                                                "text": "Широкие массы телезрителей знали его как завзятого моржа и приверженца талой воды, будто бы предупреждающей в силу особой структуры развитие многих иммунных болезней."
                                            },
                                            {
                                                "example_id": "ba4428c3-ccad-432e-be25-45214f343d2e",
                                                "sense_id": "3b402fb2-dc01-3685-aca8-58e736d9c053",
                                                "text": "На меня он тоже изредка обрушивал короткое, но страшной силы внимание, оглушал — так «моржи» зимой выливают себе на голову ведро ледяной воды."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "69f78db2-baaa-461b-a74e-bc7b4ed3f01d",
                        "source_entry_id": "b18dc094-e749-3e04-bfae-602588011db0",
                        "source_sense_id": "38e8ada0-ffd0-3cf4-acba-95dacfe922d4",
