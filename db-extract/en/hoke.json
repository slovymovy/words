                ],
                "senses": [
                    {
                        "sense_id": "8ff60565-8ac4-3964-a3c2-a398fbb56444",
                        "entry_id": "1f34700d-5bb3-326e-ad81-f48929a155f7",
                        "glosses": [
                            "To scrounge, to grub."
                        ],
                        "tags": [
                            "Ireland"
                        ],
                        "examples": [
                            {
                                "example_id": "17116b98-11c5-4b07-a628-730810224077",
                                "sense_id": "8ff60565-8ac4-3964-a3c2-a398fbb56444",
                                "text": "When I hoked there, I would find / An acorn and a rusted bolt"
                            },
                            {
                                "example_id": "fc19a72a-1c8d-4170-ac0a-db14e8d49443",
                                "sense_id": "8ff60565-8ac4-3964-a3c2-a398fbb56444",
                                "text": "‘[B]ut the raven winging\ndarkly over the doomed will have news,\ntidings for the eagle of how he hoked and ate,\nhow he and the wolf made short work of the dead.’"
                            },
                            {
                                "example_id": "ba61ba84-9ce6-4e6f-976e-a68753e84868",
                                "sense_id": "8ff60565-8ac4-3964-a3c2-a398fbb56444",
                                "text": "We met when I was hoking about in the rocks – just the sort of thing a virtual only child does to put in the day."
                            }
                        ]
                    }
                ],
