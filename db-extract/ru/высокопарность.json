                "senses": [
                    {
                        "sense_id": "e975ec0b-7e68-3888-91d9-d6493a0ac058",
                        "entry_id": "9cdf6277-f46f-3bb9-9f21-c4661c033c0c",
                        "glosses": [
                            "свойство по значению прилагательного высокопарный; нарочитая изысканность, напыщенность (о слоге, речи и т. п.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e8972e9-09d4-401a-a720-8445d8ed60b1",
                                "sense_id": "e975ec0b-7e68-3888-91d9-d6493a0ac058",
                                "text": "Он после долгих отнекиваний начал говорить какой-то нелепый вздор о своих чувствах к Лопухову и к Вере Павловне, что он очень любит и уважает их; но из всего этого следовало, что они к нему невнимательны, о чём, — что хуже всего, — не было, впрочем, никакого намёка в его высокопарности."
                            }
                        ]
                    }
