{
    "word_family": [
        "negligence",
        "negligently",
        "negligible"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7eab3435-86f4-3a44-8fdd-049daa6b13b4",
                    "sense_definition": "Failing to take proper care in doing something; careless or inattentive.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "carelessness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The school was sued after a teacher's <w>negligent</w> behavior led to a student getting injured.",
                            "target_lang_translations": {
                                "ru": "На школу подали в суд после того, как <w>халатное</w> поведение учителя привело к травме ученика."
                            }
                        },
                        {
                            "text": "The driver was found <w>negligent</w> in causing the accident because he was texting while driving.",
                            "target_lang_translations": {
                                "ru": "Водитель был признан <w>виновным в халатности</w>, повлекшей за собой аварию, так как он писал сообщения за рулем."
                            }
                        }
                    ],
                    "synonyms": [
                        "careless",
                        "inattentive",
                        "neglectful",
                        "remiss"
                    ],
                    "antonyms": [
                        "careful",
                        "attentive",
                        "diligent"
                    ],
                    "common_phrases": [
                        "negligent behavior",
                        "grossly negligent"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не проявляющий должной заботы или внимания при выполнении чего-либо; небрежный или невнимательный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "небрежный",
                                "target_lang_sense_clarification": "не проявляющий должного внимания и аккуратности"
                            },
                            {
                                "target_lang_word": "халатный",
                                "target_lang_sense_clarification": "недобросовестный в выполнении обязанностей"
                            },
                            {
                                "target_lang_word": "невнимательный",
                                "target_lang_sense_clarification": "допускающий ошибки из-за отсутствия концентрации"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5518a4c8-1eb3-3c51-a650-44183acef684",
                    "sense_definition": "Guilty of or characterized by neglect, especially in a legal context; culpable due to negligence.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "carelessness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The prosecution had to prove the company was <w>negligent</w> in maintaining their safety equipment.",
                            "target_lang_translations": {
                                "ru": "Обвинению нужно было доказать, что компания проявила <w>халатность</w> при обслуживании оборудования безопасности."
                            }
                        },
                        {
                            "text": "If the landlord is found <w>negligent</w>, they will have to pay for all the damages.",
                            "target_lang_translations": {
                                "ru": "Если арендодатель будет признан <w>виновным в небрежности</w>, ему придется оплатить весь ущерб."
                            }
                        }
                    ],
                    "synonyms": [
                        "culpable",
                        "liable"
                    ],
                    "antonyms": [
                        "blameless"
                    ],
                    "common_phrases": [
                        "found negligent",
                        "prove someone negligent"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Often used in legal contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Виновный в халатности или характеризующийся ею, особенно в юридическом контексте."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "халатный",
                                "target_lang_sense_clarification": "допустивший преступное легкомыслие или небрежность в работе"
                            },
                            {
                                "target_lang_word": "виновный в халатности",
                                "target_lang_sense_clarification": "юридически признанный совершившим упущение"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}