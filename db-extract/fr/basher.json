                "senses": [
                    {
                        "sense_id": "cfb8fa76-c6d6-34fc-85ce-281bfd447487",
                        "entry_id": "13187143-68df-3d97-ac03-ee55e435c2df",
                        "glosses": [
                            "Frapper, tabasser."
                        ],
                        "tags": [
                            "Anglicism",
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "466d5e8c-b833-4290-9ae1-22499ba119e1",
                                "sense_id": "cfb8fa76-c6d6-34fc-85ce-281bfd447487",
                                "text": "Pour pouvoir basher les méchants comme il faut, Enoch ne dispose tout au long du jeu que de trois armes […]."
                            },
                            {
                                "example_id": "052c669b-9ba7-4313-8e4e-4ab1ddef2d1e",
                                "sense_id": "cfb8fa76-c6d6-34fc-85ce-281bfd447487",
                                "text": "Les heureux possesseurs de produit Apple devront garder un vieux modèle sous le coude pour continuer de basher du Baal."
                            },
                            {
                                "example_id": "0181a99b-057c-4b4a-ab91-d4bf283acd5c",
                                "sense_id": "cfb8fa76-c6d6-34fc-85ce-281bfd447487",
                                "text": "Allez on va basher du monstre là, hop hop hop."
                            }
                        ]
                    },
                    {
                        "sense_id": "ac0d8882-ca76-3446-a5ae-ff3f56d4b596",
                        "entry_id": "13187143-68df-3d97-ac03-ee55e435c2df",
                        "glosses": [
                            "Critiquer vertement."
                        ],
                        "tags": [
                            "Anglicism",
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "276eccce-f3c6-4916-952a-e2ed38ed01ac",
                                "sense_id": "ac0d8882-ca76-3446-a5ae-ff3f56d4b596",
                                "text": "Ella se fait littéralement basher par ses coéquipiers, la traitant de «petite princesse», de débile (j’exagère, mais c’est ça) et de paresseuse."
                            },
                            {
                                "example_id": "5719d01f-406e-4f66-a8a4-225daa2841b6",
                                "sense_id": "ac0d8882-ca76-3446-a5ae-ff3f56d4b596",
                                "text": "Tristane Banon : et si on arrêtait de la basher ?"
                            },
                            {
                                "example_id": "83b16e33-b806-49e4-87d4-41777f960d4e",
                                "sense_id": "ac0d8882-ca76-3446-a5ae-ff3f56d4b596",
                                "text": "Au fait, quand j’ai parlé de basher Gaby Heinze, je voulais pas dire l’insulter, sinon, je vais devoir modérer vos commentaires…"
                            }
                        ]
                    }
