                "senses": [
                    {
                        "sense_id": "1f7a756d-7732-35c3-b655-4f8d8c055d83",
                        "entry_id": "5556f800-036c-34d2-9296-f94dd991a54f",
                        "glosses": [
                            "Politique sur l'échelle mondiale."
                        ],
                        "tags": [
                            "Relations internationales"
                        ],
                        "examples": [
                            {
                                "example_id": "9a14bda3-05d7-41c2-8d39-0baf6b92ad70",
                                "sense_id": "1f7a756d-7732-35c3-b655-4f8d8c055d83",
                                "text": "Auch Weltpolitik beginnt mit Smalltalk: Wie geht’s der Frau? Was macht der Hund? Solche Sachen.",
                                "translation": "Même la politique mondiale commence par des banalités : comment va la femme ? Qu'est-ce qui fait le chien ? Ce genre de choses."
                            },
                            {
                                "example_id": "557002d9-987b-41ec-9d5c-69d6c2f62553",
                                "sense_id": "1f7a756d-7732-35c3-b655-4f8d8c055d83",
                                "text": "Die große Weltpolitik sei eigentlich nicht sein Feld, er kümmere sich um das Kommunale (...), sagt Grubliauskas.",
                                "translation": "La grande politique mondiale n’est pas vraiment son domaine, il s’occupe des affaires locales (...) dit Grubliauskas."
                            }
                        ]
                    },
                    {
                        "sense_id": "947bccbd-f1d2-3f86-9910-28fcb779568d",
                        "entry_id": "5556f800-036c-34d2-9296-f94dd991a54f",
                        "glosses": [
                            "Politique internationale, doctrine et action d'un État ou d'une organisation pour exercer une influence dans les relations internationales."
                        ],
                        "tags": [
                            "Relations internationales"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "a9f3861e-cea9-3fbb-a16e-bb2549795980",
                        "entry_id": "5556f800-036c-34d2-9296-f94dd991a54f",
                        "glosses": [
                            "Weltpolitik, doctrine diplomatique de l'Allemagne adoptée à la fin du XIXᵉ siècle sous l'impulsion de Guillaume II."
                        ],
                        "tags": [
                            "Relations internationales"
