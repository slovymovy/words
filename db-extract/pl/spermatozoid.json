                                        "glosses": [
                                            "cellula germinale maschile degli animali con il compito di raggiungere il gamete femminile (ovulo) per fecondarlo, durante la riproduzione sessuale anfigonica."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
