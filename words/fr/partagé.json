                    "frequency": "High",
                    "semantic_group_id": "reciprocite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous avons éprouvé un réel plaisir <w>partagé</w> lors de cette agréable réunion de famille."
                        },
                        {
                            "text": "Les deux collaborateurs ont exprimé un respect <w>partagé</w> après des mois de travail intense."
                        }
                    ],
                    "common_phrases": [
                        "sentiment partagé",
                        "plaisir partagé"
                    ]
                },
                {
                    "sense_id": "ffb4fafb-eb70-37c1-9d47-42e8f7909a9c",
                    "sense_definition": "Qui hésite entre plusieurs opinions, qui ne penche ni dans un sens ni dans un autre.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "hesitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Devant cette proposition inattendue, je reste encore très <w>partagé</w> quant à la suite à donner."
                        },
                        {
                            "text": "Les experts ont exprimé des avis <w>partagés</w> sur les conséquences économiques de cette nouvelle mesure."
                        }
                    ],
                    "synonyms": [
                        "divisé"
                    ],
                    "common_phrases": [
