                "senses": [
                    {
                        "sense_id": "8c530fca-f089-3adb-9a3d-bd610b123847",
                        "entry_id": "3d7bb6b0-632e-32ce-80d2-ffcd249fa3eb",
                        "glosses": [
                            "geladener Gast, der über ein bestimmtes Thema eine Rede halten soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c17397b-6302-42ae-a214-b565b08ebeae",
                                "sense_id": "8c530fca-f089-3adb-9a3d-bd610b123847",
                                "text": "Der Gastredner erhielt viel Applaus."
                            },
                            {
                                "example_id": "c4fe75e9-1561-42c7-b2aa-0ae32c82e8c5",
                                "sense_id": "8c530fca-f089-3adb-9a3d-bd610b123847",
                                "text": "„Vor allem aber macht der angeblich noch rechtlose, jeder gesetzlichen Untermauerung entbehrende Eingriff des Landtags, der bisher im Finanzpräsidium in der Sophienstraße tagt, den Plan zunichte, das Maximilianeum als Heim für ausländische Studenten, Gastredner und Tagungsteilnehmer auszubauen.“"
                            },
                            {
                                "example_id": "1920da51-bba7-45ed-8667-87f86ada220e",
                                "sense_id": "8c530fca-f089-3adb-9a3d-bd610b123847",
                                "text": "„Ein erneutes überzeugendes Bekenntnis zur Idee des proletarischen Internationalismus und der Solidarität mit den gegen den Imperialismus kämpfenden Völkern legten die Delegierten des Parteitages durch ihren Empfang der ausländischen Gastredner in der Nachmittagssitzung ab.“"
                            },
                            {
                                "example_id": "3489afe4-7812-4f34-afef-3e78ef03c5d1",
                                "sense_id": "8c530fca-f089-3adb-9a3d-bd610b123847",
                                "text": "„Der als Gastredner aus Bonn herbeigeholte Bundestagsabgeordnete Hans-Heinrich Schmidt berichtete von einer Meinungsumfrage unter Jugendlichen zwischen 18 und 21 Jahren.“"
                            },
                            {
                                "example_id": "3e9e2d6f-4ca9-4a6b-b594-83b50757f82a",
                                "sense_id": "8c530fca-f089-3adb-9a3d-bd610b123847",
                                "text": "„Der Gastredner des Abends, Herr von Dewall von der Frankfurter Zeitung, stellte es als den Wunsch der Deutschen hin, daß sie nicht mehr als eine kleinere Macht angesehen wären.“"
                            },
                            {
                                "example_id": "2a426366-c4c5-4487-beb0-81d9a599a259",
                                "sense_id": "8c530fca-f089-3adb-9a3d-bd610b123847",
                                "text": "„Da war die Konferenz über Englands Verbleib in der Europäischen Gemeinschaft, abgehalten vor dem Referendum und verziert durch den Gastredner Helmut Schmidt.“"
                            },
                            {
                                "example_id": "24d95732-0bf3-44e8-ad7d-d7d3d68362d8",
                                "sense_id": "8c530fca-f089-3adb-9a3d-bd610b123847",
                                "text": "„Mich wunderte der Auftrittt auch deshalb, weil der Gastredner mir bei einem Besuch im Elysee, nur wenige Monate zuvor, gesagt hatte: An meiner Stelle würde er die Zweifel verstehen, die einen Deutschen umtrieben, aber er sei nun einmal Präsident der Französischen Republik.“"
                            },
                            {
                                "example_id": "2dbf9be0-6d58-4c52-adc5-f1432834c96c",
                                "sense_id": "8c530fca-f089-3adb-9a3d-bd610b123847",
                                "text": "„Überdies wird am Donnerstagvormittag das Pacific Aviation Museum eröffnet; zu den Gastrednern gehören der Apollo-Astronaut Walter Schirra und der legendäre Testpilot Chuck Yeager, der 1947 als Erster die Schallmauer durchbrochen hatte.“"
                            },
                            {
                                "example_id": "0c42a38e-ae95-4d54-a333-c965362a4b25",
                                "sense_id": "8c530fca-f089-3adb-9a3d-bd610b123847",
                                "text": "„Im Archiv finden sich Bilder von Müller mit Schürfwunden im Gesicht, er hat dazu ein paar lustige Bemerkungen gemacht, und bei einer Pressekonferenz saß Holger Badstuber neben ihm und sagte, das Referat des von Herrn Bierhoff eingeladenen Gastredners Reinhold Messner sei schon ein bisschen nachvollziehbar gewesen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
