                },
                {
                    "sense_id": "836db2ee-5bfe-3e73-a915-200812d90c43",
                    "sense_definition": "Передвижение войск или флота для выполнения боевой задачи, а также военная операция.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Генерал отдал приказ готовить армию к дальнему <w>походу</w>.",
                            "target_lang_translations": {
                                "en": "The general gave the order to prepare the army for a long <w>march</w>.",
                                "de": "Der General gab den Befehl, die Armee auf einen weiten <w>Marsch</w> vorzubereiten."
                            }
                        },
                        {
                            "text": "Этот знаменитый военный <w>поход</w> вошёл во все учебники истории.",
                            "target_lang_translations": {
                                "en": "This famous military <w>campaign</w> has gone down in all history textbooks.",
                                "de": "Dieser berühmte militärische <w>Feldzug</w> ging in alle Geschichtsbücher ein."
                            }
                        }
                    ],
                    "synonyms": [
                        "марш",
                        "кампания"
                    ],
                    "antonyms": [
                        "мир"
                    ],
                    "common_phrases": [
