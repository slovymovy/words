                "senses": [
                    {
                        "sense_id": "9bd13e24-4678-3d20-8c5f-e3c3b784349b",
                        "entry_id": "c3f1d2f0-8e1e-3dff-95e6-723916c2f875",
                        "glosses": [
                            "Qui suffoque ; qui provoque la suffocation ; qui gêne ou fait perdre la respiration."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd8937b7-aa86-4dcf-8a5a-96fc02b2699a",
                                "sense_id": "9bd13e24-4678-3d20-8c5f-e3c3b784349b",
                                "text": "Fumée suffocante. — Atmosphère, chaleur suffocante."
                            },
                            {
                                "example_id": "ac41020f-f5c2-416e-b607-6d532e2e5a96",
                                "sense_id": "9bd13e24-4678-3d20-8c5f-e3c3b784349b",
                                "text": "C’était bien autrement effrayant que les récits des romanciers et les scènes des drames allemands, c’était d’une vérité suffocante."
                            },
                            {
                                "example_id": "a81a6c45-0240-4d30-a6de-7fae711ac945",
                                "sense_id": "9bd13e24-4678-3d20-8c5f-e3c3b784349b",
                                "text": "Le phosgène, aussi nommé dichlorure de méthanoyle, oxychlorure de carbone ou dichlorure de carbonyle, est un gaz très toxique à température ambiante,qui appartient parmi les armes chimiques et gaz de combat à la classe des agents suffocants (comme le dichlore, le sulfure d'hydrogène ou le dibrome)."
                            }
                        ]
                    }
                ],
