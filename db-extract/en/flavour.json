        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "4b532781-ac5c-38f2-bb9c-7e78860b89aa",
                "word": "flavour",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "363565ec-fde6-4667-acd6-513704be4dd3",
                        "entry_id": "4b532781-ac5c-38f2-bb9c-7e78860b89aa",
                        "tags": [
                            "plural"
                        ],
                        "form": "flavours"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "391b2151-e94c-3c5a-9bd6-7d3c12095d39",
                        "entry_id": "4b532781-ac5c-38f2-bb9c-7e78860b89aa",
                        "glosses": [
                            "British standard spelling of flavor."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "89a998c2-51cb-4ac8-a0a9-ca8fa9625c3e",
                                "sense_id": "391b2151-e94c-3c5a-9bd6-7d3c12095d39",
                                "text": "The flavour of this apple pie is delicious."
                            },
                            {
                                "example_id": "ae1776e3-d255-4316-b3d3-cba5ce64f4e9",
                                "sense_id": "391b2151-e94c-3c5a-9bd6-7d3c12095d39",
                                "text": "Flavour was added to the pudding."
                            },
                            {
                                "example_id": "71aa7a5c-d984-4fa3-9a9c-77369bd18681",
                                "sense_id": "391b2151-e94c-3c5a-9bd6-7d3c12095d39",
                                "text": "What flavour of bubble gum do you enjoy?"
                            },
                            {
                                "example_id": "bc6969ac-5b3a-4666-be0e-7859326645e2",
                                "sense_id": "391b2151-e94c-3c5a-9bd6-7d3c12095d39",
                                "text": "The flavour of an experience."
                            },
                            {
                                "example_id": "1fa2fbc9-b6fd-4133-9c59-99dd0409504a",
                                "sense_id": "391b2151-e94c-3c5a-9bd6-7d3c12095d39",
                                "text": "Debian is one flavour of the Linux operating system."
                            },
                            {
                                "example_id": "12562c00-f9c5-4dc7-b551-b76bf79a196c",
                                "sense_id": "391b2151-e94c-3c5a-9bd6-7d3c12095d39",
                                "text": "Ciaotou Sugar Factory\n(橋頭糖廠, Qiáotóu Tángchǎng) Ciaotou consists of a defunct factory (which you can walk into, and explore the old mechanisms and vats) and an old village that retains most of its early-20th-century flavour."
                            },
                            {
                                "example_id": "a04b98f4-dbe9-44eb-8b27-cd08d10bab6d",
                                "sense_id": "391b2151-e94c-3c5a-9bd6-7d3c12095d39",
                                "text": "The journey is worth an article in itself, but all I can give is a flavour of a railway which traverses a bleak but dramatic coastline that's regularly battered by the elements - especially around Parton, where the line is constantly threatened by the sea."
                            }
                        ]
                    }
                ],
