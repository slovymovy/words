                                                "example_id": "19f2046e-9cec-46ac-bcf5-9302fcf77b8b",
                                                "sense_id": "9910287a-deaf-3716-8b57-778f208f13f4",
                                                "text": "Pour quatre-vingts pour cent des Français, c’était à cause de Bazaine qu’on avait perdu la guerre."
                                            },
                                            {
                                                "example_id": "b5869a8d-93a5-4942-9a45-ee1f941b7d73",
                                                "sense_id": "9910287a-deaf-3716-8b57-778f208f13f4",
                                                "text": "C’est une sculpture en ronde-bosse, un mètre soixante-seize de haut, un quatre-vingt-quinze de large, quatre-vingts centimètres de profondeur."
                                            },
                                            {
                                                "example_id": "f83f628a-90ba-4cb5-9749-0a49517c7145",
                                                "sense_id": "9910287a-deaf-3716-8b57-778f208f13f4",
