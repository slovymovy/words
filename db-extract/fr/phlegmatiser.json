                        "examples": [
                            {
                                "example_id": "f017375a-01b7-4e5a-b0f6-47d5b86b353b",
                                "sense_id": "e36256fb-00c3-3dc5-ba02-96d908f9af5d",
                                "text": "Dans son contraste parfait avec le Français et l'Anglais, le Batave nous semble en quelque sorte, un Allemand fortement phlegmatisé."
                            },
                            {
                                "example_id": "c19e0910-cb81-4ae7-bcb9-c092b734305a",
                                "sense_id": "e36256fb-00c3-3dc5-ba02-96d908f9af5d",
                                "text": "Les parties qui sont hors du trajet circulatoire, telles que les cheveux, les poils, les ongles, ont aussi leur manière de se phlegmatiser."
                            },
                            {
                                "example_id": "e392bb1f-39ad-4885-8450-872bacc283fb",
                                "sense_id": "e36256fb-00c3-3dc5-ba02-96d908f9af5d",
                                "text": "Classe de transport A correspondant à peu près à une hauteur de chute inférieure â 15 cm; exemple: nitroglycérine, PETN non phlegmatisé."
                            }
                        ]
                    }
