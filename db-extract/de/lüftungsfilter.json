                "senses": [
                    {
                        "sense_id": "15685dc8-431e-32e0-a814-d8e940623810",
                        "entry_id": "494efa21-d5da-3312-ab98-36ebdaaf6749",
                        "glosses": [
                            "Filter, der unerwünschte Bestandteile aus der ihn durchströmenden Luft entfernt/zurückhält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad83bb8f-a540-464b-ac91-d6582a92ab93",
                                "sense_id": "15685dc8-431e-32e0-a814-d8e940623810",
                                "text": "„Vielfach wird lediglich der Lüftungsfilter gewechselt, der Rest bleibt dreckig.“"
                            },
                            {
                                "example_id": "b9566d77-8927-4c9e-9ccc-27d39b627d61",
                                "sense_id": "15685dc8-431e-32e0-a814-d8e940623810",
                                "text": "„Durch Lüftungsfilter können Schadstoffe aus der Luft gezielt beseitigt werden.“"
                            },
                            {
                                "example_id": "ae26e5db-38ab-4590-8472-0c0ce080a38d",
                                "sense_id": "15685dc8-431e-32e0-a814-d8e940623810",
                                "text": "„Hilfreich ist auch ein Fensterschutz, ebenso ein Lüftungsfilter im Auto.“"
                            },
                            {
                                "example_id": "53ae3efb-9e8c-4ece-94e2-1803743c2840",
                                "sense_id": "15685dc8-431e-32e0-a814-d8e940623810",
                                "text": "„Lüftungsfilter reinigen die Luft für große öffentiche [sic!] Gebäude, wenn die zur Lüftung verwendete Straßenluft nicht einwandfrei ist.“"
                            },
                            {
                                "example_id": "af64eaf5-1a6e-4b01-aff1-0452548b7ea6",
                                "sense_id": "15685dc8-431e-32e0-a814-d8e940623810",
                                "text": "„Mittel hiergegen sind Desinfektion und Insektenbekämpfung in Gebäuden, Lüftungsfilter mit Desinfektionsmitteln, ultraviolette Bestrahlung und allgemein die Beachtung der Hygiene im Umgang mit den Tieren und den Gebäuden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
