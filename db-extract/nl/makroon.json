                                "target_senses": [
                                    {
                                        "sense_id": "957ee1b9-6af8-399b-83c3-e03e6e7291e3",
                                        "entry_id": "0d94a01d-8f1a-36c8-9ea2-be5c0e08dbdc",
                                        "glosses": [
                                            "A soft biscuit or cookie prepared with almond or coconut dough."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f0da409-cca3-47ee-bb88-7dfd9ff4b972",
                                                "sense_id": "957ee1b9-6af8-399b-83c3-e03e6e7291e3",
                                                "text": "I will take charge of the cake department, including, if I remember rightly, plum and plain, rout cakes, and macaroons, finger biscuits, and cracknels."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32d34a77-380e-39bb-a1e3-0bd174bad839",
