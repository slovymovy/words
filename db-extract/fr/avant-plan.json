                    {
                        "sense_id": "1d7152d0-937a-3ec2-b25a-dd24ea79b462",
                        "entry_id": "11326adb-4fd3-3ba8-9635-14428f763ca6",
                        "glosses": [
                            "En termes de composition, ce qui est au premier plan de la scène principale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7827a694-8965-420c-b87e-95c630ab4bc0",
                                "sense_id": "1d7152d0-937a-3ec2-b25a-dd24ea79b462",
                                "text": "Le rocher à l’avant-plan est visible dans sa totalité mais sa présence insolite transmet son énigme à ce qu’il dissimule."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d21ab14a-4701-4cc0-90fc-cf35ce245a42",
                        "source_entry_id": "11326adb-4fd3-3ba8-9635-14428f763ca6",
                        "source_sense_id": "1d7152d0-937a-3ec2-b25a-dd24ea79b462",
                        "source_sense_description": "Ce qui est au premier plan de la scène principale",
                        "target_lang_word": "Vordergrund",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vordergrund",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9275b1af-58d0-3a28-b5ec-a4a3630938b0",
                                        "entry_id": "b91e965e-6960-3507-94b4-7be19f3e9269",
                                        "glosses": [
                                            "der Teil (des Bildes), der dem Betrachter am nächsten ist"
                                        ],
                                        "tags": [
                                            "Malerei",
                                            "Fotografie",
                                            "Blickfeld"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "509ac3e8-c5a3-4348-aa56-cb789f619fd1",
                                                "sense_id": "9275b1af-58d0-3a28-b5ec-a4a3630938b0",
                                                "text": "Im Vordergrund sieht der Betrachter einen Tisch mit einer Blumenvase."
                                            },
                                            {
                                                "example_id": "3a6408d9-1d37-455c-a9c6-f0ae344e727a",
                                                "sense_id": "9275b1af-58d0-3a28-b5ec-a4a3630938b0",
                                                "text": "„Am Rand des Tisches im Vordergrund liegen zwei Stücke Fleisch, eine große Lammkeule und ein kleines Kotelett.“"
                                            },
                                            {
                                                "example_id": "aa728820-8926-4a9b-b55b-779d51d0ec53",
                                                "sense_id": "9275b1af-58d0-3a28-b5ec-a4a3630938b0",
                                                "text": "„Er zeigte auf die Zeitschriftenauslage im Vordergrund des Ladens.“"
                                            },
                                            {
                                                "example_id": "74d82464-445b-486f-b8b0-445120dfdb0d",
                                                "sense_id": "9275b1af-58d0-3a28-b5ec-a4a3630938b0",
                                                "text": "„Wie die Chronik bei der Abbildung Kölns den unfertigen Dom zeigt mit einem Baukran, der aus der offenen Kirchenhalle ragt, so fallen bei der Darstellung Münchens die im Vordergrund am Ufer der Isar gestapelten Stämme auf und die vielen Flöße auf dem Fluss.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "42f72b9e-3506-3784-993e-0eaa2b884308",
                                        "entry_id": "b91e965e-6960-3507-94b4-7be19f3e9269",
                                        "glosses": [
                                            "größere Aufmerksamkeit, Beachtung oder Bedeutung (als andere)"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "158630ae-97d0-46a3-a977-6a6e2305b222",
                                                "sense_id": "42f72b9e-3506-3784-993e-0eaa2b884308",
                                                "text": "Bei uns steht die Sicherheit im Vordergrund, erst danach kommt der Komfort."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "df6c56e5-2773-4ad7-b635-8bab889e5956",
                        "source_entry_id": "11326adb-4fd3-3ba8-9635-14428f763ca6",
