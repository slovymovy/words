                    {
                        "translation_id": "da70330c-c16e-4144-822f-4f088306fc88",
                        "source_entry_id": "a21c20d9-60fa-322b-bd2e-deae1082d37f",
                        "source_sense_id": "17e123ed-a524-3387-b27a-2f6cfefcde55",
                        "target_lang_word": "bui",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bui",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "d316d825-37c7-3d46-b026-f81749a59777",
                                        "entry_id": "ea9aed47-af14-31cf-af1c-8a619797d636",
                                        "glosses": [
                                            "een kortstondige periode van neerslag"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9acf50a2-8bd1-4e48-a45f-6c106393f4f2",
                                                "sense_id": "d316d825-37c7-3d46-b026-f81749a59777",
                                                "text": "De plotselinge bui zorgde voor veel ongelukken op de weg."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ed311d9-9f7c-38a2-9a8c-beefc1807175",
                                        "entry_id": "ea9aed47-af14-31cf-af1c-8a619797d636",
                                        "glosses": [
                                            "een voorbijgaande stemming"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f6fbdac-e9a2-4bd0-b231-52bd8cc49062",
                                                "sense_id": "2ed311d9-9f7c-38a2-9a8c-beefc1807175",
                                                "text": "Hij was in een slechte bui toen hij om drie uur 's nachts gebeld werd."
                                            },
                                            {
                                                "example_id": "39afd34a-5be5-4cde-bbb5-b49b42a525cc",
                                                "sense_id": "2ed311d9-9f7c-38a2-9a8c-beefc1807175",
                                                "text": "Zijn buien van ongeduld waren verontrustend. Het gebrek aan ondernemingslust van de troepen werkte hem op de zenuwen."
                                            },
                                            {
                                                "example_id": "c25909cd-b021-425d-a1aa-f532ae8b3133",
                                                "sense_id": "2ed311d9-9f7c-38a2-9a8c-beefc1807175",
                                                "text": "Het daaropvolgende uur luisterden ze naar de regen, die afwisselend op de ramen tikte en kletterde. God had ook Zijn buien."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "958b4e79-6dea-4bc5-aff3-843820172a9c",
                        "source_entry_id": "a21c20d9-60fa-322b-bd2e-deae1082d37f",
                        "source_sense_id": "17e123ed-a524-3387-b27a-2f6cfefcde55",
                        "target_lang_word": "onweer",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "onweer",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "c2d66abe-3ab8-34bb-9d57-9d30557857ce",
                                        "entry_id": "64bd34bc-f57b-3ed4-aa5e-431f49c9b7b1",
                                        "glosses": [
                                            "meteorologisch verschijnsel waarbij regen gepaard gaat met donder en bliksem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a163d597-9f51-4058-890c-6d57ba49b6d7",
                                                "sense_id": "c2d66abe-3ab8-34bb-9d57-9d30557857ce",
                                                "text": "Het onweer hangt hier nu al een uur, en het blijft maar bliksemen."
                                            },
                                            {
                                                "example_id": "bdaac54f-93bb-456f-b70c-294123747abf",
                                                "sense_id": "c2d66abe-3ab8-34bb-9d57-9d30557857ce",
                                                "text": "De hele dag was het vriendelijk en rustig weer geweest, maar nu kwam er vanaf de andere kant van de berg een zwaar onweer op me af dat om de paar seconden fel oplichtte."
                                            },
                                            {
                                                "example_id": "c42c8641-58f1-49b6-b0a0-41f8c75cff13",
                                                "sense_id": "c2d66abe-3ab8-34bb-9d57-9d30557857ce",
                                                "text": "\"Wij stonden voor het raam naar het onweer te kijken en we zien de boom heen en weer gaan\", zegt ze tegen Omroep Brabant. Opeens kwam de lindeboom haar kant op. \"Het leek wel slowmotion. We zijn snel naar de achterkant van het huis gelopen, want je weet niet hoe ver hij komt als hij op het huis valt. Het was heel heftig.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "onweer",
                                "target_lang_code": "nl",
                                "target_senses": [
