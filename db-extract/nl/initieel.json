                            {
                                "example_id": "b5c5a9f4-3170-4520-b925-5a01a12e375b",
                                "sense_id": "6f294981-2cd6-3ec2-b6ae-8973a1ff2534",
                                "text": "Of een niet-lineaire verfijning inderdaad de best mogelijke parameterwaarden oplevert hangt sterk af van de initiële waarden."
