                "senses": [
                    {
                        "sense_id": "3d8de6cf-183a-3b9f-b86f-55e98194c75f",
                        "entry_id": "44e06ad9-adbd-3a29-bbc2-a9768466b991",
                        "glosses": [
                            "Einheit der Kriminalpolizei, die sich mit der Aufklärung von Mordfällen befasst"
                        ],
                        "tags": [
                            "historisch besonders",
                            "DDR"
                        ],
                        "examples": [
                            {
                                "example_id": "fe2aebd2-08bb-427d-a1b2-8587f2b89cb1",
                                "sense_id": "3d8de6cf-183a-3b9f-b86f-55e98194c75f",
                                "text": "„Die Morduntersuchungskommission Potsdam sieht einen Zusammenhang zu dem Mord an einer Deutschen am 13. März zwischen Neuendorf und Borkheide und dem Doppelmord an einer sowjetischen Offiziersfrau und ihrem Säugling am 22. März bei Beelitz.“"
                            },
                            {
                                "example_id": "4fbc3b8f-a2b0-44aa-a68e-df8e7606aa21",
                                "sense_id": "3d8de6cf-183a-3b9f-b86f-55e98194c75f",
                                "text": "„Der Bund deutscher Kriminalbeamter (BDK) in Thüringen hatte nach der Aufklärung des Mordes an Stephanie D. aus dem Jahr 1991 im März dieses Jahres, die Bildung einer permanenten Morduntersuchungskommission (MUK) für Thüringen gefordert.“"
                            },
                            {
                                "example_id": "f7fc384e-9c5d-426b-8f28-8bcc0e193e84",
                                "sense_id": "3d8de6cf-183a-3b9f-b86f-55e98194c75f",
                                "text": "„Wahrscheinlich ebnete er ihm auch den Karriereweg, er wurde Leiter der Morduntersuchungskommission.“"
                            },
                            {
                                "example_id": "f90d83c9-162e-43a3-95e4-38168e6ee73f",
                                "sense_id": "3d8de6cf-183a-3b9f-b86f-55e98194c75f",
                                "text": "„Die Morduntersuchungskommission der Polizeidirektion Dresden hat die weiteren Ermittlungen, insbesondere zu den Hintergründen und den konkreten Abläufen der Tat, übernommen.“"
                            },
                            {
                                "example_id": "4096f853-0020-43df-aa9c-d4d40c003bf1",
                                "sense_id": "3d8de6cf-183a-3b9f-b86f-55e98194c75f",
                                "text": "„Wurde eine Leiche gefunden, so wurden die Arbeiten eingestellt und Mitarbeiter der Morduntersuchungskommission der Kriminalpolizei sowie des MfS führten zunächst eine kriminaltechnische Untersuchung durch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
