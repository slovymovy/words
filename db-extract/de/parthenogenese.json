                        "examples": [
                            {
                                "example_id": "7e5a3b09-68d0-49e4-9d4b-10af08af5af6",
                                "sense_id": "400e2e35-4016-3a48-a994-0c480a9cf82e",
                                "text": "Der Gott Hephaistos soll von seiner Mutter Hera in Parthenogenese gezeugt worden sein."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0efb9784-3939-340b-acdc-f1981d47e210",
                        "entry_id": "97f5dce6-f74d-349d-a274-de559924a361",
                        "glosses": [
                            "Form der eingeschlechtlichen Fortpflanzung bei einigen Tieren und Pflanzen"
