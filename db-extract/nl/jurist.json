                        "target_lang_word": "jurist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jurist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b106f960-80d8-30d3-a10c-9258b5c430f7",
                                        "entry_id": "c6bc8627-fc4f-3528-adad-798d87a39a8e",
                                        "glosses": [
                                            "An expert of law or someone who researches jurisprudence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46b7826d-f79c-44ac-87ba-2b3058ee35d4",
                                                "sense_id": "b106f960-80d8-30d3-a10c-9258b5c430f7",
                                                "text": "The young lawyer hoped to become a renowned jurist one day."
                                            },
                                            {
                                                "example_id": "11de9cfa-c7ce-457b-8a3c-7bafac7d09d4",
                                                "sense_id": "b106f960-80d8-30d3-a10c-9258b5c430f7",
                                                "text": "The distinguished jurist wrote extensively on constitutional law."
                                            },
                                            {
                                                "example_id": "bce982a4-903a-4fa8-b059-a7a6aad59008",
                                                "sense_id": "b106f960-80d8-30d3-a10c-9258b5c430f7",
                                                "text": "As a jurist, she was respected for her impartiality."
                                            },
                                            {
                                                "example_id": "998325b4-bdae-40b1-9848-a4769f1a3f1a",
                                                "sense_id": "b106f960-80d8-30d3-a10c-9258b5c430f7",
                                                "text": "distinguished jurist"
                                            },
                                            {
                                                "example_id": "e67a7b0a-2941-4e78-8803-593b663e788d",
                                                "sense_id": "b106f960-80d8-30d3-a10c-9258b5c430f7",
                                                "text": "eminent jurist"
                                            },
                                            {
                                                "example_id": "0ae57b60-b08c-449b-8e89-064b8e1144b5",
                                                "sense_id": "b106f960-80d8-30d3-a10c-9258b5c430f7",
                                                "text": "constitutional jurist"
                                            },
                                            {
                                                "example_id": "438c91ec-e926-4cdb-ace0-95036692d678",
                                                "sense_id": "b106f960-80d8-30d3-a10c-9258b5c430f7",
                                                "text": "comparative-law jurist"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1a1fb06-2c82-30b0-94d7-11927fe1494f",
                                        "entry_id": "c6bc8627-fc4f-3528-adad-798d87a39a8e",
                                        "glosses": [
                                            "A judge."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "09962fd5-f7bc-4911-bbc2-94f34c510ac0",
                        "source_entry_id": "76275dc3-8d2b-3c2a-ae94-36d70138d27f",
                        "source_sense_id": "b193801f-fba7-3f3c-8d1b-7ba3f29cc9ca",
                        "source_sense_description": "een deskundige op het gebied van rechtsleer",
                        "target_lang_word": "juriste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "juriste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bec45691-a840-3777-898d-a71eb8fa6e81",
                                        "entry_id": "97be214a-898f-33b6-a560-8ae2ac04bc79",
                                        "glosses": [
                                            "Spécialiste du droit, jurisconsulte."
                                        ],
                                        "tags": [
                                            "Métier"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49254bbb-803f-4b8b-8f83-ef80b5d3d5a9",
                                                "sense_id": "bec45691-a840-3777-898d-a71eb8fa6e81",
                                                "text": "Voilà les fameux claims dont Bouygues s’est fait une spécialité. L’entreprise est connue pour la hardiesse de ses ingénieurs, l’excellence de ses ouvriers et le culot de ses juristes."
                                            },
                                            {
                                                "example_id": "4bea08a7-fce5-4cf1-8107-e3809f17dbf4",
                                                "sense_id": "bec45691-a840-3777-898d-a71eb8fa6e81",
                                                "text": "Guides et formations sont aujourd’hui bien présents dans ce domaine même s’il sera toujours compliqué d’expliquer à un juriste ce que peut être un algorithme."
                                            },
                                            {
                                                "example_id": "a4a85734-de31-4006-92c9-7af20fc23fbc",
                                                "sense_id": "bec45691-a840-3777-898d-a71eb8fa6e81",
                                                "text": "Et d’expliquer les mécanismes : « des responsables d’achat organisent cette corruption via des appels d’offres pipés, des hausses artificielles de prix, des faveurs pour la promotion de produits et d’autres irrégularités au service qualité et au contrôle financier, notamment sur la compliance », raconte le juriste."
                                            },
                                            {
                                                "example_id": "efd02b42-93c6-459e-857b-fb24f56aeee5",
                                                "sense_id": "bec45691-a840-3777-898d-a71eb8fa6e81",
                                                "text": "En somme, l’idée est d’automatiser ces tâches, et de permettre aux juristes et aux opérationnels de se recentrer sur des missions à plus haute valeur ajoutée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
