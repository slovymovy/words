{
    "word_family": [
        "loper"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fcc5929a-67d7-3163-b6d0-4d04c24f26af",
                    "sense_definition": "To run or move with an easy, steady pace and long strides.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dog began to <w>lope</w> across the open field toward its owner.",
                            "target_lang_translations": {
                                "zh": "那只狗开始跨着大步在开阔的田野上朝主人<w>大步跑</w>去。"
                            }
                        },
                        {
                            "text": "He <w>loped</w> along the quiet trail without breaking into a full sprint.",
                            "target_lang_translations": {
                                "zh": "他沿着安静的小径<w>大步慢跑</w>，并未全力冲刺。"
                            }
                        }
                    ],
                    "synonyms": [
                        "canter",
                        "stride"
                    ],
                    "common_phrases": [
                        "lope along",
                        "lope away"
                    ],
                    "target_lang_definitions": {
                        "zh": "大步轻松自如地跑或奔跑，步伐稳健舒展"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "大步慢跑",
                                "target_lang_sense_clarification": "步伐大且轻松"
                            },
                            {
                                "target_lang_word": "大步奔跑",
                                "target_lang_sense_clarification": "步伐舒展地跑"
                            },
                            {
                                "target_lang_word": "跨着大步跑",
                                "target_lang_sense_clarification": "稳步大跨步移动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a7bbe38c-f648-3b9c-92eb-81a0053db059",
                    "sense_definition": "To jump or leap.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "jumping",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rider tried to make the tired horse <w>lope</w> across the wide ditch.",
                            "target_lang_translations": {
                                "zh": "骑手试图让那匹疲倦的马<w>跃</w>过宽宽的沟渠。"
                            }
                        },
                        {
                            "text": "The deer seemed to <w>lope</w> clear over the fallen tree branch.",
                            "target_lang_translations": {
                                "zh": "那只鹿似乎轻盈地<w>跳跃</w>穿过了倒下的树枝。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bound",
                        "jump",
                        "leap"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "sense is archaic or obsolete"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（古旧）跳跃，跃过"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "跃",
                                "target_lang_sense_clarification": "跳跃"
                            },
                            {
                                "target_lang_word": "跳跃",
                                "target_lang_sense_clarification": "跃过障碍"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "96e6926b-0005-31d5-8293-417f7143267e",
                    "sense_definition": "An easy, steady running pace characterized by long, bounding strides.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wolf settled into an easy <w>lope</w> that carried it effortlessly across the snow.",
                            "target_lang_translations": {
                                "zh": "那匹狼换成了轻松的<w>大步跑</w>姿态，毫不费力地在雪地上穿行。"
                            }
                        },
                        {
                            "text": "The runner broke into a long <w>lope</w> as she reached the flat section of the trail.",
                            "target_lang_translations": {
                                "zh": "跑者到达小径平坦路段时，开始迈开长步换成<w>大步跑</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "canter",
                        "gait",
                        "stride"
                    ],
                    "common_phrases": [
                        "easy lope",
                        "long lope"
                    ],
                    "target_lang_definitions": {
                        "zh": "轻松稳健的大步跑姿或步伐"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "大步跑",
                                "target_lang_sense_clarification": "步幅大的跑姿"
                            },
                            {
                                "target_lang_word": "轻松的大步跑步态",
                                "target_lang_sense_clarification": "稳健舒展的步态"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}