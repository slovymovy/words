                "senses": [
                    {
                        "sense_id": "2d47573d-db8b-3890-a216-2ac6e49efeef",
                        "entry_id": "1e13dc80-d714-3c05-b658-31e9ec9e149d",
                        "glosses": [
                            "Weigerung von Arbeitnehmern, ihre Arbeit zu verrichten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c556280d-4b4a-46d1-9f81-51ae30d56e7c",
                                "sense_id": "2d47573d-db8b-3890-a216-2ac6e49efeef",
                                "text": "„Zwar hatte es auch in anderen Industriestädten Arbeitsniederlegungen gegeben, die größten in Nürnberg, wo sogar fast jeder sechste Einwohner für Frieden und gegen die Fortsetzung des Krieges protestierte.“"
                            },
                            {
                                "example_id": "9e787c34-1ca4-466b-bb91-eef707d1d0b1",
                                "sense_id": "2d47573d-db8b-3890-a216-2ac6e49efeef",
                                "text": "„Laut der Gewerkschaft ver.di sind zu den Arbeitsniederlegungen Beschäftigte von der Stadtreinigung, der Hafenverwaltung Hamburg Port Authority (HPA) sowie den Theatern und Bühnen aufgefordert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c8727645-eaad-4e48-8592-5923a952d6aa",
                        "source_entry_id": "1e13dc80-d714-3c05-b658-31e9ec9e149d",
                        "source_sense_id": "2d47573d-db8b-3890-a216-2ac6e49efeef",
                        "source_sense_description": "Weigerung von Arbeitnehmern, ihre Arbeit zu verrichten",
