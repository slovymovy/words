                    {
                        "sense_id": "61fe8fe1-23c5-3380-9b33-c0c02f4645a8",
                        "entry_id": "6ef51047-868d-33fb-9916-5c11d3d89189",
                        "glosses": [
                            "non-starter, flop (idea or project that is considered a failure right after, or even before, being launched)"
                        ],
                        "tags": [
                            "figuratively",
                            "informal",
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "7b86056a-2647-4902-8450-29ce8105317c",
                                "sense_id": "61fe8fe1-23c5-3380-9b33-c0c02f4645a8",
                                "text": "Schon in der Heimat war der Film ein echter Rohrkrepierer: Trotz massiver (und teurer) Marketingkampagne spielte The Great Wall am Startwochenende bei einem Budget von 150 Millionen Dollar lediglich 67 Millionen ein.",
                                "translation": "Even at home, the movie was a true flop: Despite a massive (and expensive) marketing campaign, The Great Wall only made 67 million dollars at the box office on its opening weekend, with a budget of 150 million.",
                                "english": "Even at home, the movie was a true flop: Despite a massive (and expensive) marketing campaign, The Great Wall only made 67 million dollars at the box office on its opening weekend, with a budget of 150 million."
                            },
                            {
                                "example_id": "aabbf73f-7d54-4376-b840-f9d74a0be21f",
                                "sense_id": "61fe8fe1-23c5-3380-9b33-c0c02f4645a8",
                                "text": "Der nächste Punkt beim Enträtseln des Schulz-Phänomens betrifft die verblüffende Tatsache, dass sich in diesem Wahlkampf als Kracher erweist, was im letzten noch ein Rohrkrepierer war, das Thema soziale Gerechtigkeit.",
                                "translation": "The next step for unraveling the mystery of Schulz phenomenon is about the surprising fact that there's something that is playing really well in this election campaign, despite being a total non-starter in the last one, that being the topic of social justice.",
                                "english": "The next step for unraveling the mystery of Schulz phenomenon is about the surprising fact that there's something that is playing really well in this election campaign, despite being a total non-starter in the last one, that being the topic of social justice."
                            }
                        ]
                    }
