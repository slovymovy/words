{
    "word_family": [
        "codfish",
        "codling",
        "codpiece"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0b9b0475-b555-35b3-82bb-8bf300c91cfd",
                    "sense_definition": "A large marine fish with a barbel on the chin, important as a food source; also the meat of this fish.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "fish_senses",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We ordered battered <w>cod</w> and chips at the seaside restaurant.",
                            "target_lang_translations": {
                                "ru": "Мы заказали <w>треску</w> в кляре с картошкой фри в прибрежном ресторане.",
                                "zh": "我们在海边的餐厅点了炸<w>鳕鱼</w>和薯条。"
                            }
                        },
                        {
                            "text": "The fishermen caught a large net full of <w>cod</w>.",
                            "target_lang_translations": {
                                "ru": "Рыбаки вытащили большую сеть, полную <w>трески</w>.",
                                "zh": "渔民们捕获了一大网<w>鳕鱼</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "codfish"
                    ],
                    "common_phrases": [
                        "cod and chips",
                        "Atlantic cod",
                        "cod fillet"
                    ],
                    "target_lang_definitions": {
                        "ru": "Крупная морская рыба с усиком на подбородке, важный источник пищи; также мясо этой рыбы.",
                        "zh": "一种下巴有须的海洋鱼类，是重要的食物来源；也指这种鱼的肉。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "треска",
                                "target_lang_sense_clarification": "рыба"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "鳕鱼",
                                "target_lang_sense_clarification": "鱼类名称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7db4fa89-e72f-3ead-9838-085d2900b925",
                    "sense_definition": "A payment method where goods are paid for at the time of delivery (Cash On Delivery).",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "acronym_senses",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The package was sent <w>COD</w>, so I had to pay the driver when he arrived.",
                            "target_lang_translations": {
                                "ru": "Посылка была отправлена <w>наложенным платежом</w>, поэтому мне пришлось заплатить водителю, когда он приехал.",
                                "zh": "包裹是<w>货到付款</w>的，所以我必须在司机到达时付款。"
                            }
                        },
                        {
                            "text": "Many customers prefer to order <w>COD</w> to avoid using credit cards online.",
                            "target_lang_translations": {
                                "ru": "Многие клиенты предпочитают заказывать <w>наложенным платежом</w>, чтобы не использовать кредитные карты в интернете.",
                                "zh": "许多顾客更喜欢选择<w>货到付款</w>，以避免在网上使用信用卡。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "sent COD",
                        "order COD"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "acronym"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Способ оплаты, при котором товары оплачиваются в момент доставки (наложенный платёж).",
                        "zh": "一种在交付时支付货款的付款方式（货到付款）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наложенный платёж",
                                "target_lang_sense_clarification": "способ оплаты"
                            },
                            {
                                "target_lang_word": "оплата при доставке",
                                "target_lang_sense_clarification": "способ оплаты"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "货到付款",
                                "target_lang_sense_clarification": "支付方式"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "276b3276-f9d4-309d-a8b3-48d3c8e27710",
                    "sense_definition": "The medical reason for a person's death (Cause Of Death).",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "acronym_senses",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The coroner recorded the <w>COD</w> as accidental drowning.",
                            "target_lang_translations": {
                                "ru": "Коронер записал <w>причину смерти</w> как случайное утопление.",
                                "zh": "验尸官将<w>死亡原因</w>记录为意外溺水。"
                            }
                        },
                        {
                            "text": "Police are waiting for the autopsy to determine the <w>COD</w>.",
                            "target_lang_translations": {
                                "ru": "Полиция ждет результатов вскрытия, чтобы установить <w>причину смерти</w>.",
                                "zh": "警方正在等待尸检结果以确定<w>死亡原因</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "acronym"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Медицинская причина смерти человека.",
                        "zh": "一个人死亡的医学原因。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "причина смерти",
                                "target_lang_sense_clarification": "медицинский термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "死亡原因",
                                "target_lang_sense_clarification": "医学术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d3f16de7-66b5-3816-a42e-889fc6b75fe7",
                    "sense_definition": "A stupid or foolish person; often used in phrases implying someone has made a fool of themselves.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "slang_senses",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He made a right <w>cod</w> of himself by forgetting his lines on stage.",
                            "target_lang_translations": {
                                "ru": "Он выставил себя полным <w>дураком</w>, забыв слова на сцене.",
                                "zh": "他在舞台上忘词，把自己变成了一个彻头彻尾的<w>傻瓜</w>。"
                            }
                        },
                        {
                            "text": "Don't be such a <w>cod</w>; nobody believes that story.",
                            "target_lang_translations": {
                                "ru": "Не будь таким <w>дураком</w>, никто не верит в эту историю.",
                                "zh": "别当<w>傻瓜</w>了，没人会相信那个故事。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "make a cod of"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "British and Irish"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Глупый или неразумный человек; часто используется во фразах, подразумевающих, что кто-то выставил себя дураком.",
                        "zh": "愚蠢或笨拙的人；常用于暗示某人出丑的短语中。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дурак",
                                "target_lang_sense_clarification": "разговорное"
                            },
                            {
                                "target_lang_word": "шут",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "傻瓜",
                                "target_lang_sense_clarification": "口语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "93597b40-1b73-3e96-95e1-3105c2e6eb3a",
                    "sense_definition": "To joke with, tease, or deceive someone playfully.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "slang_senses",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I was only <w>codding</w> you; I didn't really lose your keys.",
                            "target_lang_translations": {
                                "ru": "Я просто <w>разыгрывал</w> тебя, я на самом деле не терял твои ключи.",
                                "zh": "我只是在<w>戏弄</w>你，我并没有真的弄丢你的钥匙。"
                            }
                        },
                        {
                            "text": "He loves to <w>cod</w> his friends with silly pranks.",
                            "target_lang_translations": {
                                "ru": "Он любит <w>дурачить</w> своих друзей глупыми розыгрышами.",
                                "zh": "他喜欢用愚蠢的恶作剧来<w>捉弄</w>朋友。"
                            }
                        }
                    ],
                    "synonyms": [
                        "kid",
                        "tease",
                        "trick"
                    ],
                    "common_phrases": [
                        "only codding",
                        "codding me"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "British and Irish"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Шутить, дразнить или игриво обманывать кого-то.",
                        "zh": "开玩笑、戏弄或以游戏心态欺骗某人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разыгрывать",
                                "target_lang_sense_clarification": "шутить"
                            },
                            {
                                "target_lang_word": "дурачить",
                                "target_lang_sense_clarification": "обманывать в шутку"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "戏弄",
                                "target_lang_sense_clarification": "开玩笑"
                            },
                            {
                                "target_lang_word": "捉弄",
                                "target_lang_sense_clarification": "戏耍"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b8c67827-fae3-34c8-a00f-aaae92fbd6ae",
                    "sense_definition": "Fake, imitation, or not genuine; often used to describe something that pretends to be serious or artistic.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "slang_senses",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The movie was criticized for its <w>cod</w> philosophy and weak plot.",
                            "target_lang_translations": {
                                "ru": "Фильм критиковали за его <w>фальшивую</w> философию и слабый сюжет.",
                                "zh": "这部电影因其<w>虚假的</w>哲学和薄弱的剧情而受到批评。"
                            }
                        },
                        {
                            "text": "He adopted a <w>cod</w> American accent that sounded very unconvincing.",
                            "target_lang_translations": {
                                "ru": "Он перенял <w>фальшивый</w> американский акцент, который звучал очень неубедительно.",
                                "zh": "他模仿了一种听起来非常不自然的<w>虚假的</w>美国口音。"
                            }
                        }
                    ],
                    "synonyms": [
                        "faux",
                        "mock",
                        "fake"
                    ],
                    "common_phrases": [
                        "cod psychology",
                        "cod Latin"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "British"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фальшивый, имитационный или ненастоящий; часто используется для описания чего-то, что претендует на серьезность или художественность.",
                        "zh": "虚假的、模仿的或非真实的；常用于描述那些假装严肃或具有艺术性的事物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фальшивый",
                                "target_lang_sense_clarification": "ненастоящий"
                            },
                            {
                                "target_lang_word": "поддельный",
                                "target_lang_sense_clarification": "имитация"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "虚假的",
                                "target_lang_sense_clarification": "非真实的"
                            },
                            {
                                "target_lang_word": "伪造的",
                                "target_lang_sense_clarification": "模仿的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "bbf1f0d0-0886-385f-8330-882c9168815b",
                    "sense_definition": "Abbreviation for Call of Duty, a popular series of video games.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "game_or_sport_name",
                    "examples": [
                        {
                            "text": "My brother spends all his weekends playing <w>COD</w> online.",
                            "target_lang_translations": {
                                "ru": "Мой брат проводит все выходные, играя в <w>Call of Duty</w> онлайн.",
                                "zh": "我哥哥整个周末都在网上玩《<w>使命召唤</w>》。"
                            }
                        },
                        {
                            "text": "The new <w>COD</w> game has amazing graphics.",
                            "target_lang_translations": {
                                "ru": "У новой игры <w>Call of Duty</w> потрясающая графика.",
                                "zh": "新出的《<w>使命召唤</w>》游戏画面非常惊艳。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "play COD"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "acronym"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Аббревиатура от Call of Duty, популярной серии видеоигр.",
                        "zh": "《使命召唤》的缩写，这是一个流行的电子游戏系列。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Call of Duty",
                                "target_lang_sense_clarification": "видеоигра"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "使命召唤",
                                "target_lang_sense_clarification": "电子游戏名称"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}