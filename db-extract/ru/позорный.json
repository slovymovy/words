                        "examples": [
                            {
                                "example_id": "df45c92b-a50e-4e09-b868-bf86d91a6e1b",
                                "sense_id": "f6f0d04e-0e80-38d9-a86d-0f5fcef63264",
                                "text": "позо́рный столб",
                                "translation": "pillory",
                                "english": "pillory"
                            },
                            {
                                "example_id": "0377dda9-330a-46bc-9f5f-191b646968c3",
                                "sense_id": "f6f0d04e-0e80-38d9-a86d-0f5fcef63264",
                                "text": "поста́вить к позо́рному столбу́",
                                "translation": "to put in the pillory; to pillory",
                                "english": "to put in the pillory; to pillory"
                            },
                            {
                                "example_id": "55fb9951-2901-4d6e-aec8-95ac00e15d3d",
                                "sense_id": "f6f0d04e-0e80-38d9-a86d-0f5fcef63264",
                                "text": "Этой позорной политике натравливания нет и не должно быть возврата.",
                                "translation": "There can be and there must be no return to this disgraceful policy of instigation.",
                                "english": "There can be and there must be no return to this disgraceful policy of instigation."
                            }
                        ]
