                        "entry_id": "826b964f-4fbe-386b-bbd6-7fc07c84a0d0",
                        "glosses": [
                            "The interior of a country."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "e08ea245-eab4-4296-b13f-8f1b9124e101",
                                "sense_id": "f53ac5b9-ce2d-3a87-ac24-37de9670e034",
                                "text": "Near-synonyms: backcountry, hinterland"
                            },
                            {
                                "example_id": "23d710ea-16b9-49f2-a748-545f04fd84df",
                                "sense_id": "f53ac5b9-ce2d-3a87-ac24-37de9670e034",
                                "text": "To further this end, the speculators also distributed subshares to other prominent Georgians, particularly those whose actions might carry weight in the upcountry."
                            }
                        ]
                    },
                    {
                        "sense_id": "311658f9-f9af-315b-b855-ab007c6abd39",
                        "entry_id": "826b964f-4fbe-386b-bbd6-7fc07c84a0d0",
                        "glosses": [
                            "The part of the country that is at high elevation."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "ac3101b5-a4e2-474f-be74-e81614f6884d",
                                "sense_id": "311658f9-f9af-315b-b855-ab007c6abd39",
                                "text": "Near-synonyms: high country, highlands, upland; plateau, tableland, mesa"
                            },
                            {
                                "example_id": "7b1d5ce3-ad6e-4a52-b3db-52df0a12f61b",
                                "sense_id": "311658f9-f9af-315b-b855-ab007c6abd39",
                                "text": "Within the focus on the colonial South, there are works that detail regional differences in social organization between the backcountry (frontier), upcountry (Appalachia, Piedmont), and lowcountry (plantation)."
                            }
                        ]
                    }
