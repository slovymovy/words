                    ],
                    "synonyms": [
                        "rétablissement"
                    ],
                    "common_phrases": [
                        "travail de reconstruction",
                        "reconstruction personnelle"
                    ]
                },
                {
                    "sense_id": "385d0d0d-d364-35e1-8678-521ca6d53b09",
                    "sense_definition": "Opération chirurgicale destinée à réparer ou reformer une partie du corps altérée par un accident ou une maladie.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La patiente a choisi de programmer sa <w>reconstruction</w> mammaire quelques mois après l'intervention."
