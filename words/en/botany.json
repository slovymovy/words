{
    "word_family": [
        "botanical",
        "botanist",
        "botanize"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9982f70e-e3ec-3843-b5cb-06ce448f8616",
                    "sense_definition": "A branch of biology concerned with the scientific study of plants.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "study_of_plants",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to pursue a degree in <w>botany</w> because she loves nature.",
                            "target_lang_translations": {
                                "zh": "她决定攻读<w>植物学</w>学位，因为她热爱大自然。"
                            }
                        },
                        {
                            "text": "Modern <w>botany</w> involves complex genetic research on various plant species.",
                            "target_lang_translations": {
                                "zh": "现代<w>植物学</w>涉及对各种植物物种的复杂基因研究。"
                            }
                        }
                    ],
                    "synonyms": [
                        "plant science",
                        "phytology"
                    ],
                    "common_phrases": [
                        "study of botany"
                    ],
                    "target_lang_definitions": {
                        "zh": "生物学的一个分支，专门研究植物的科学。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "植物学",
                                "target_lang_sense_clarification": "研究植物的科学学科"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fadb602b-bca5-3e3d-a392-7dc16c113816",
                    "sense_definition": "The plant life of a geographical area; flora.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "study_of_plants",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>botany</w> of the island is incredibly diverse due to its unique climate.",
                            "target_lang_translations": {
                                "zh": "由于独特的气候，这座岛屿的<w>植物群</w>极其多样。"
                            }
                        },
                        {
                            "text": "Researchers documented the local <w>botany</w> during their expedition through the rainforest.",
                            "target_lang_translations": {
                                "zh": "研究人员在穿越雨林的探险过程中记录了当地的<w>植被</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "flora",
                        "vegetation"
                    ],
                    "common_phrases": [
                        "local botany"
                    ],
                    "target_lang_definitions": {
                        "zh": "某一地理区域的植物生命；植物群。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "植物群",
                                "target_lang_sense_clarification": "指特定区域内的植物种类"
                            },
                            {
                                "target_lang_word": "植被",
                                "target_lang_sense_clarification": "指覆盖在某地表面的植物总称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9d3a5445-f924-34eb-a398-754c41b208e6",
                    "sense_definition": "The properties and life phenomena exhibited by a plant, plant type, or plant group.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "study_of_plants",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>botany</w> of this rare orchid is quite unusual compared to other species.",
                            "target_lang_translations": {
                                "zh": "与其他物种相比，这种稀有兰花的<w>植物特性</w>非常独特。"
                            }
                        },
                        {
                            "text": "Understanding the <w>botany</w> of desert succulents helps in their cultivation.",
                            "target_lang_translations": {
                                "zh": "了解沙漠多肉植物的<w>植物特性</w>有助于它们的栽培。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "植物、植物类型或植物群所表现出的特性和生命现象。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "植物特性",
                                "target_lang_sense_clarification": "指植物的生物学特征或习性"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1d9144e4-3d3b-3d8d-9029-25586d07da1f",
                    "sense_definition": "A botanical treatise or study, especially of a particular system of botany or that of a particular place.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "study_of_plants",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The library holds an ancient <w>botany</w> detailing medicinal herbs from the seventeenth century.",
                            "target_lang_translations": {
                                "zh": "图书馆里收藏了一本十七世纪详细记载药用草本植物的古老<w>植物志</w>。"
                            }
                        },
                        {
                            "text": "He published a comprehensive <w>botany</w> covering the alpine regions of the country.",
                            "target_lang_translations": {
                                "zh": "他出版了一部涵盖该国高山地区的综合性<w>植物志</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "treatise"
                    ],
                    "target_lang_definitions": {
                        "zh": "关于植物的论著或研究，特别是关于某种植物系统或特定地区的植物研究。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "植物志",
                                "target_lang_sense_clarification": "记录特定地区植物的专著"
                            },
                            {
                                "target_lang_word": "植物学著作",
                                "target_lang_sense_clarification": "关于植物学的学术研究书籍"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}