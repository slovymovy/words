                        "examples": [
                            {
                                "example_id": "a9dbaa1c-9cea-4c8c-bda3-b72ad91e08e5",
                                "sense_id": "d9102c77-7479-3663-9bb4-33291e638281",
                                "text": "Fancy Archie Holden, after having all the Rocky Mountains for his workshop, coming back and settling down into one of these bandboxy little towns!"
                            },
                            {
                                "example_id": "480e5fc5-26ab-4b14-b75f-b888f122b636",
                                "sense_id": "d9102c77-7479-3663-9bb4-33291e638281",
                                "text": "The alforjas, or saddle-bags, of the guide were strengthened by a stock of cold provisions, the leathern bota hanging beside it was filled with ripe Granada wine; and now behold me ambling over the Vega, accoutred in a gay Andalusian jacket, a sash woven by Mateo Ximenes, and one of those bandboxy sombreros, which I at first thought so ungainly, but now consider quite picturesque and elegant."
                            }
                        ]
                    }
