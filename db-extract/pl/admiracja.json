                "senses": [
                    {
                        "sense_id": "488d0404-5d81-3190-bd1a-01053a06d5f9",
                        "entry_id": "b0b3fff4-7d54-3206-a75e-a8eb2bb10517",
                        "glosses": [
                            "przejaw podziwu i uwielbienia dla kogoś lub czegoś"
                        ],
                        "tags": [
                            "dated",
                            "literary"
                        ],
