                    {
                        "translation_id": "2b592aa9-b622-46ce-b772-cd6993915604",
                        "source_entry_id": "6c6a4e20-ad80-3c22-802d-b4916b072854",
                        "source_sense_id": "f8fd758e-6087-37de-94eb-b70b1b6841ab",
                        "target_lang_word": "subsidence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "subsidence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "35c14459-bc5b-3991-b77f-eb0f042bc113",
                                        "entry_id": "98c0c278-2934-3fa0-b5e3-0b5903deec06",
                                        "glosses": [
                                            "The process of becoming less active or severe."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2882f51f-9413-4bd4-be0a-4e83d62cf308",
                                                "sense_id": "35c14459-bc5b-3991-b77f-eb0f042bc113",
                                                "text": "The subdual or subsidence of the more violent passions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6b4cfaa-d16f-3db8-89da-9d8c2be33fee",
                                        "entry_id": "98c0c278-2934-3fa0-b5e3-0b5903deec06",
                                        "glosses": [
                                            "A sinking of something to a lower level, especially of part of the surface of the Earth due to underground excavation, seismic activity or underground or ground water depletion, or the rocks in a geological basin, due to continued deposition from above."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e292933e-0abd-4524-98dc-49b7da0d2c09",
                                                "sense_id": "d6b4cfaa-d16f-3db8-89da-9d8c2be33fee",
                                                "text": "In the early hours of April 28, 1953, it was completely blocked by a subsidence, which caused the death of five persons, when a pair of semi-detached houses collapsed into the cavity."
                                            },
                                            {
                                                "example_id": "3914898a-64d2-4a37-aa5d-9bd090c382d6",
                                                "sense_id": "d6b4cfaa-d16f-3db8-89da-9d8c2be33fee",
                                                "text": "Everyone knows that a main line running through a coalfield is prone to speed restrictions because of land subsidence. […] The rate of subsidence may vary from less than an inch a month in the case of a deep seam of coal, to as rapid a decline as 16in a month above a shallow seam. The effect of subsidence on permanent way and civil engineering structures needs no emphasis."
                                            },
                                            {
                                                "example_id": "8e5b0720-9ab2-478f-9e6a-94376b890f47",
                                                "sense_id": "d6b4cfaa-d16f-3db8-89da-9d8c2be33fee",
                                                "text": "Subsidence was first noted in the late nineteenth century. An increasing thirst for groundwater, which creates subterranean pockets that are then compressed by the land above, and upriver damming of the Mississippi, which prevents the replenishment of sediments, have undermined the city to the point that it is now thought to be subsiding by up to 12 millimetres per year."
                                            },
                                            {
                                                "example_id": "91b42e88-bc35-488b-a51a-0946b0d9012f",
                                                "sense_id": "d6b4cfaa-d16f-3db8-89da-9d8c2be33fee",
                                                "text": "Iran’s president has claimed Iran has no choice but to move its capital from Tehran to the south of the country due to the city’s over-expansion, the lack of adequate water supplies and the growing threat of subsidence."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
