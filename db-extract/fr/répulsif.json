                    {
                        "translation_id": "9c24c015-54d8-4013-be34-a139508f1153",
                        "source_entry_id": "90239fbe-dc96-3b83-acbe-e21980ef56dd",
                        "source_sense_id": "6bf24d99-f8b3-386e-ae90-474201ef6d98",
                        "target_lang_word": "repellent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
