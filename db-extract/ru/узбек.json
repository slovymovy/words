                        "cross_references": [
                            {
                                "target_word": "Ouzbek",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1cb7d4e5-e4bc-3d86-a490-3299aed2f807",
                                        "entry_id": "15f2cef8-ca5c-3a18-971d-4ef9597931de",
                                        "glosses": [
                                            "Personne de l’ethnie ouzbek (Asie centrale)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "005d3409-5c45-32d6-bc9d-da9844d100d2",
                                        "entry_id": "15f2cef8-ca5c-3a18-971d-4ef9597931de",
                                        "glosses": [
                                            "Habitant de l’Ouzbékistan, personne possédant la nationalité ouzbek."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0620a0f1-afaf-460e-bb54-9c39c5791fd5",
                                                "sense_id": "005d3409-5c45-32d6-bc9d-da9844d100d2",
                                                "text": "La patrie soviétique, qui brillait follement à l’horizon de nos attentes, il l’avait admirée pour ce qu’il croyait être une généreuse politique des minorités, et je savais qu’Ar Falz enviait les Ouzbeks d’avoir eu la chance dont les Bretons avaient été privés."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "47d7ffde-62cb-4edb-be31-2b3b014ebad1",
                        "source_entry_id": "e3679ca2-0e1a-3f82-9333-1f37c0604af6",
                        "source_sense_id": "bac3f379-b198-38e7-8af0-6c957795f1ec",
                        "target_lang_word": "Uzbek",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Uzbek",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a05e220b-e657-33a4-aa32-e23e7355386d",
                                        "entry_id": "fb41d837-5045-3641-b866-78223280d2cc",
                                        "glosses": [
                                            "Variante de Ouzbek."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "339843f9-dbf8-4624-bbed-7ae84e6e2353",
                                                "sense_id": "a05e220b-e657-33a4-aa32-e23e7355386d",
                                                "text": "Et puisqu’il n’était pas envisageable de sacrifier de \"vrais\" Russes, il hésita alors entre quelques ethnies excentrées et minoritaires mises à sa disposition : Ukrainiens, Roumains, Sibériens, Géorgiens, Mongols, Turcs, Azéris, Kazakhs, Tadjiks, Uzbeks, Biélorusses, Arméniens..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
