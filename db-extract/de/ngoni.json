                "senses": [
                    {
                        "sense_id": "db3cd527-c6bb-3a49-9de1-1d3127fe3c72",
                        "entry_id": "0723419c-2e74-32e6-a8f1-67a1038e4a7f",
                        "glosses": [
                            "eine in Tansania und Mosambik gesprochene Bantusprache, die dem Zulu ähnlich ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76400ec5-b151-46e8-b147-561d0f52f882",
                                "sense_id": "db3cd527-c6bb-3a49-9de1-1d3127fe3c72",
                                "text": "„Die enge Verbindung des Ngoni mit dem Zulu legt es nahe, die Beziehung der beiden Suffixe zueinander enger zu fassen.“"
                            },
                            {
                                "example_id": "b37b4fb0-741f-49c0-9580-063b07f28bec",
                                "sense_id": "db3cd527-c6bb-3a49-9de1-1d3127fe3c72",
                                "text": "„Die erste Verständigung erfolgte folgendermaßen: Missionar Nauhaus sprach in Zulu (südafrikanische Sprache) zu einem der Ngoni verstand. (Ngoni ist dem Zulu verwandt und wird im Süden Tansanias östlich vom Nyassa gesprochen).“"
                            },
                            {
                                "example_id": "4af94bc6-69ff-46a9-9d57-61b902b222fe",
                                "sense_id": "db3cd527-c6bb-3a49-9de1-1d3127fe3c72",
                                "text": "„In grösserem Ausmass als in uns vertrauten Sprachen kennt das Ngoni terminologische Unterscheidungsmöglichkeiten im agrarischen Bereich, etwa nach Feldtypen oder Pflanzenteilen.“"
                            },
                            {
                                "example_id": "31e4e952-10cf-400a-a989-96bdf5001682",
                                "sense_id": "db3cd527-c6bb-3a49-9de1-1d3127fe3c72",
                                "text": "„Bei einer Behandlung Ostafrikas würde sich z.B. die Stellung des dort gesprochenen Ngoni als problematisch erweisen, bis weitergehende Untersuchungen die Verwandtschaft mit dem Zulu Südafrikas nachweisen würden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
