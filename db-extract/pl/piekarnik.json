                    {
                        "translation_id": "ec0b3daa-f834-488d-a30f-ebe125a9bc7e",
                        "source_entry_id": "72de8724-c35a-315a-af02-9dcd915126b8",
                        "source_sense_id": "94d6f6e5-d6ee-3b58-9ba4-e8b82df49ad5",
                        "target_lang_word": "Backofen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Backofen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "952fca0e-dddc-3152-a078-c77873cd364a",
                                        "entry_id": "b905b432-0e2d-3198-b7fb-7f40ef9808dc",
                                        "glosses": [
                                            "großes Haushaltsgerät, in dem starke Hitze erzeugt wird, um Essen zu erhitzen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81c800d0-16db-41ba-a5d3-f733fe559d36",
                                                "sense_id": "952fca0e-dddc-3152-a078-c77873cd364a",
                                                "text": "Der Braten muss jetzt zehn Minuten im Backofen bleiben."
                                            },
                                            {
                                                "example_id": "026a641b-b681-4322-9627-ac0780d56f32",
                                                "sense_id": "952fca0e-dddc-3152-a078-c77873cd364a",
                                                "text": "„Auf dieser Wiese ging es [das Mädchen] fort und kam zu einem Backofen, der war voller Brot; das Brot aber rief: ‚Ach, zieh mich raus, zieh mich raus, sonst verbrenn ich. Ich bin schon längst ausgebacken.‘ “"
                                            },
                                            {
                                                "example_id": "426f04de-ad14-424b-ab33-3ee2c0201469",
                                                "sense_id": "952fca0e-dddc-3152-a078-c77873cd364a",
                                                "text": "„Anschliessend gehts in den auf 100 Grad vorgeheizten Backofen.“"
                                            },
                                            {
                                                "example_id": "8da9ab96-5294-4af9-845e-2e8fcdebd1f7",
                                                "sense_id": "952fca0e-dddc-3152-a078-c77873cd364a",
                                                "text": "„Alles war für das Festessen vorbereitet, das Tier getötet, ausgenommen und bratfertig, als wir feststellten, dass der Backofen zu klein war für den imposanten Fisch.“"
                                            },
                                            {
                                                "example_id": "32ab7de7-241f-4c3d-b952-590812ad534f",
                                                "sense_id": "952fca0e-dddc-3152-a078-c77873cd364a",
                                                "text": "„Im Haus standen Öfen, und so konnten sie in allen verfügbaren Backöfen Brot backen, was dringend nötig war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
