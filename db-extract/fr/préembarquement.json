                "senses": [
                    {
                        "sense_id": "85029761-784f-3087-b3b5-cd7a49dc9d8a",
                        "entry_id": "5c1d822a-402f-323b-843b-799dc1795444",
                        "glosses": [
                            "Étape précédant l’embarquement dans un véhicule de transport, tel un avion, un navire ou un bus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53a65789-004d-409a-9cd5-6a2ed4e03c8e",
                                "sense_id": "85029761-784f-3087-b3b5-cd7a49dc9d8a",
                                "text": "C'est l'officier d'immigration au poste-frontière ou au poste de contrôle préembarquement qui décide de l'admission du voyageur sur le territoire américain."
                            },
                            {
                                "example_id": "9b0f28f2-ac33-47e7-9190-7fd34a2b1fc2",
                                "sense_id": "85029761-784f-3087-b3b5-cd7a49dc9d8a",
                                "text": "Le Réseau de transport de la Capitale (RTC) a mis en place de nouvelles zones de préembarquement, où les gens paient à l'extérieur avant d'accéder aux véhicules. Les passagers peuvent aussi entrer par toutes les portes de l'autobus."
                            },
                            {
                                "example_id": "729d0fa1-5757-4d7d-bafb-14f561f724ec",
                                "sense_id": "85029761-784f-3087-b3b5-cd7a49dc9d8a",
                                "text": "Une zone de contrôle britannique à compétence strictement limitée aux questions d'immigration sera créée dans la zone enclose sur le terminal de la compagnie Norfolklines, sur l'accès aux parkings de préembarquement."
                            },
                            {
                                "example_id": "cacac0eb-c08c-4de9-bda6-400d3c326e84",
                                "sense_id": "85029761-784f-3087-b3b5-cd7a49dc9d8a",
                                "text": "Il y a bien un endroit dans les aéroports où il y a des chaises roulantes, mais il est impossible de les réserver à l'avance. S'il n'y en a pas, il faut se débrouiller. Et les formalités de préembarquement sont très compliquées."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6f693b29-3ee2-4d9c-b839-9ad1555a0265",
                        "source_entry_id": "5c1d822a-402f-323b-843b-799dc1795444",
                        "source_sense_id": "85029761-784f-3087-b3b5-cd7a49dc9d8a",
                        "target_lang_word": "Reisevorbereitung",
