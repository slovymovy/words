                        "sense_id": "17ab137e-a295-3039-8f79-ad636eea2c31",
                        "entry_id": "2c32d460-6a96-361f-aa2f-8fc2321d2ffb",
                        "glosses": [
                            "de verzameling van alle dieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18feccd2-08c6-44a3-b6ab-b4d977fe07fa",
                                "sense_id": "17ab137e-a295-3039-8f79-ad636eea2c31",
                                "text": "De dood en de stilte. Die waren overal aanwezig, fysiek bijna; in de bomen en de struiken, de planten, het wriemelende dierenleven, op de bosgrond en op de bijna onzichtbare paadjes waar je onverhoeds op stuitte en waar je je vervolgens verre van hield."
                            },
                            {
                                "example_id": "5c0e3a3e-4852-433e-86ea-2d1e7488b248",
                                "sense_id": "17ab137e-a295-3039-8f79-ad636eea2c31",
                                "text": "Dat dierenleven houdt zich niet aan het programma aan boord. Zo gebeurde het regelmatig dat diners en lezingen werden onderbroken door de onverbiddelijke lokroep van de intercom: \"Drie Noorse vinvissen aan bakboord! Drie Noorse vinvissen aan bakboord!\", waarop tientallen telelenzen en verrekijkers zich naar het buitendek van het schip haastten."
                            }
                        ]
                    },
