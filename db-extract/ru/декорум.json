                ],
                "senses": [
                    {
                        "sense_id": "7f3866af-c080-355b-8ade-48389a1d29b5",
                        "entry_id": "d124fd19-cac1-381a-a886-77d85cb94b95",
                        "glosses": [
                            "книжн. внешнее, показное приличие"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01485fdc-bd8d-42e9-b288-31e87466293d",
                                "sense_id": "7f3866af-c080-355b-8ade-48389a1d29b5",
                                "text": "Честно говоря, уважения к редактору мы не испытывали, но тщательно соблюдали весь декорум."
                            }
                        ]
                    },
                    {
                        "sense_id": "746e9034-ece2-3e2f-bd37-95f889316a5d",
                        "entry_id": "d124fd19-cac1-381a-a886-77d85cb94b95",
                        "glosses": [
                            "книжн. обстановка, подобающая чьему-либо положению или чьей-либо должности"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "206ee2be-2504-4789-a3f5-0751987dd55a",
                                "sense_id": "746e9034-ece2-3e2f-bd37-95f889316a5d",
                                "text": "Лицемерие, это — приглашение к приличию, к декоруму, к красивой внешней обстановке, и что всего важнее, лицемерие — это узда."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8a5042bd-5108-471d-af5c-6d27ae645339",
                        "source_entry_id": "d124fd19-cac1-381a-a886-77d85cb94b95",
                        "target_lang_word": "Dekorum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dekorum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1ab521f5-a97f-3c49-9a54-adcf0556e0ea",
                                        "entry_id": "03df0394-f361-33d4-8b89-b184055dd5ba",
                                        "glosses": [
                                            "äußerer Schein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6bde250-65bd-476a-a2d7-8b72880e8f38",
                                                "sense_id": "1ab521f5-a97f-3c49-9a54-adcf0556e0ea",
                                                "text": "„Wenn es auch kein großer Einkauf war, man muß das Dekorum wahren.“"
                                            },
                                            {
                                                "example_id": "0cccf751-a0f3-4841-91d8-c266d567be19",
                                                "sense_id": "1ab521f5-a97f-3c49-9a54-adcf0556e0ea",
                                                "text": "„Das ist bereits die Klasse für den wohlhabenderen Mittelstand, den Arbeitgeber, den Geschäftsmann, den besseren Ladenbesitzer und, natürlich, den tapferen Unglücksraben, den höheren Beamten, der, ebenso wie der kleine, im Tode mehr ausgeben muß, als er im Leben verdient hat, um das Dekorum zu wahren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
