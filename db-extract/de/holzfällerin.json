                        "glosses": [
                            "weibliche Person, deren Beruf das Fällen von Bäumen und die Vorbereitung zum Abtransport ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc92fd0d-1043-44ad-9976-cdca41cf00d8",
                                "sense_id": "fafa8bd4-2861-326d-aa32-3585df02f62d",
                                "text": "Judith ist als selbstständige Holzfällerin tätig und arbeitet zusammen mit ihren Kaltblütern, die die gefällten Bäume aus dem Wald ziehen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
