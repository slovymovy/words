                                        "glosses": [
                                            "Que ocurre o se da en abundancia (gran cantidad)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "925029e3-5274-4d38-9fe3-5a7ba9048def",
                                                "sense_id": "1ad88cd0-3b31-355b-b819-ba67b69729b5",
                                                "text": "En primer lugar recogemos la Real Provisión para la reducción de moneda introducida de Francia de 1709 que intenta abordar la problemática de la abundante circulación de moneda francesa."
                                            }
