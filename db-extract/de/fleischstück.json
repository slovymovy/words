                "senses": [
                    {
                        "sense_id": "c7fe572d-bc0c-3fef-8116-b3ce1c898171",
                        "entry_id": "c5c409e4-94fd-3d2c-9c5a-02230b06d749",
                        "glosses": [
                            "Stück Fleisch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "773662db-a874-443e-a722-fa8bf0b1a839",
                                "sense_id": "c7fe572d-bc0c-3fef-8116-b3ce1c898171",
                                "text": "„Als ich näher trete, bieten sie auch mir etwas zum Kosten an, ein Mann hält mir mit den Fingern ein Fleischstück unter die Nase und sagt etwas und lacht, und die andern lachen und nicken mir aufmunternd zu.“"
                            },
                            {
                                "example_id": "0a4e37bd-403c-48e6-bd90-1e57bb7bbf6f",
                                "sense_id": "c7fe572d-bc0c-3fef-8116-b3ce1c898171",
                                "text": "„Ihre Mutter hatte aber jetzt vollauf zu tun, um verschiedene Fleischstücke herbeizuholen, die sie noch vor zwölf Uhr zubereiten wollte.“"
                            },
                            {
                                "example_id": "23037756-2734-43dc-80c1-998009e8f478",
                                "sense_id": "c7fe572d-bc0c-3fef-8116-b3ce1c898171",
                                "text": "„Dann aber begann der Tanz der Käseräder, die von einem Haus ins andere rollten, und der Fleischstücke, die aus geheimen Schlächtereien in die Restaurants geschafft wurden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
