                "forms": [],
                "senses": [
                    {
                        "sense_id": "d31e7605-952b-3ec2-846b-93fe7df341bf",
                        "entry_id": "a0ef7348-58a2-3712-9a30-1788d9d64e3e",
                        "glosses": [
                            "in hogere mate"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c0c4168-a40a-459f-9ae6-db9f40f79f86",
                                "sense_id": "d31e7605-952b-3ec2-846b-93fe7df341bf",
                                "text": "Hij heeft mij voornamelijk opgelicht."
                            }
                        ]
                    },
                    {
                        "sense_id": "44275111-3a7a-34ce-ab03-b91e65e2d659",
                        "entry_id": "a0ef7348-58a2-3712-9a30-1788d9d64e3e",
                        "glosses": [
                            "voor het grootste deel; in de meerderheid van de gevallen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b91696ca-ad09-459a-a627-162335d7f2f7",
                                "sense_id": "44275111-3a7a-34ce-ab03-b91e65e2d659",
                                "text": "In de zomer liep hij voornamelijk van hut naar hut in de bergen, vooral in de Alpen maar ook steeds vaker hier in Amerika waar de natuur nog echt wild was."
                            },
                            {
                                "example_id": "9c1290c7-c42b-452d-9192-844ea39d4d87",
                                "sense_id": "44275111-3a7a-34ce-ab03-b91e65e2d659",
                                "text": "Sinds 5 oktober is voor heel het land weer een ophok- en afschermplicht van kracht voor houders van pluimvee en andere vogelsoorten. De maatregel werd afgekondigd vanwege een toename van het aantal besmettingen in september en uit angst voor meer besmettingen bij voornamelijk wilde vogels. De plicht om vogels binnen te laten geldt niet alleen voor bedrijven, maar ook voor hobbyhouders."
                            },
                            {
                                "example_id": "da71bcc7-d719-4ef4-8055-07bd08819f76",
                                "sense_id": "44275111-3a7a-34ce-ab03-b91e65e2d659",
                                "text": "Er vloeiden natuurlijk tranen, voornamelijk op mijn ingezakte kussen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ef78a56a-8878-42b7-a1d7-3b794bc2c8a1",
                        "source_entry_id": "a0ef7348-58a2-3712-9a30-1788d9d64e3e",
