    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b8f06a28-099b-3f1d-8999-a3b6d577df92",
                    "sense_definition": "Abusing vocally; expressing contempt or ridicule.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mockery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bully made <w>taunting</w> remarks about the student's new clothes.",
                            "target_lang_translations": {
                                "nl": "De pester maakte <w>spottende</w> opmerkingen over de nieuwe kleren van de leerling.",
                                "ru": "Хулиган отпускал <w>насмешливые</w> замечания по поводу новой одежды ученика."
                            }
                        },
                        {
                            "text": "She ignored the <w>taunting</w> laughter coming from the group of teenagers.",
                            "target_lang_translations": {
                                "nl": "Ze negeerde het <w>tergende</w> gelach dat uit de groep tieners kwam.",
                                "ru": "Она проигнорировала <w>издевательский</w> смех, доносившийся от группы подростков."
                            }
                        }
                    ],
                    "synonyms": [
                        "derisive",
                        "gibelike",
                        "jeering",
                        "mocking"
                    ],
                    "common_phrases": [
                        "taunting remarks",
                        "taunting laughter"
                    ],
                    "target_lang_definitions": {
                        "nl": "Beledigend of spottend; uitdrukking gevend aan minachting of spot.",
                        "ru": "Оскорбительный или насмешливый; выражающий презрение или издевку."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "spottend",
                                "target_lang_sense_clarification": "met de bedoeling iemand belachelijk te maken"
                            },
                            {
                                "target_lang_word": "tergend",
                                "target_lang_sense_clarification": "met de bedoeling iemand te irriteren of uit te lokken"
                            },
                            {
                                "target_lang_word": "hoonachtig",
                                "target_lang_sense_clarification": "vol minachting en spot"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "насмешливый",
                                "target_lang_sense_clarification": "выражающий насмешку или иронию"
                            },
                            {
                                "target_lang_word": "издевательский",
                                "target_lang_sense_clarification": "содержащий в себе издевку, грубую насмешку"
                            },
                            {
                                "target_lang_word": "дразнящий",
                                "target_lang_sense_clarification": "направленный на то, чтобы вывести из себя или спровоцировать"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "29570313-054d-3ab9-bb25-10f82c53f14d",
                    "sense_definition": "The act of one who taunts.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mockery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He grew tired of the constant <w>taunting</w> from his coworkers.",
                            "target_lang_translations": {
                                "nl": "Hij werd moe van de constante <w>pesterijen</w> van zijn collega's.",
                                "ru": "Он устал от постоянных <w>насмешек</w> со стороны коллег."
                            }
                        },
                        {
                            "text": "The child cried after enduring the cruel <w>taunting</w> of the older boys.",
                            "target_lang_translations": {
                                "nl": "Het kind huilde nadat het de wrede <w>spotternij</w> van de oudere jongens had ondergaan.",
                                "ru": "Ребенок заплакал, вытерпев жестокие <w>издевательства</w> старших мальчиков."
                            }
                        }
                    ],
                    "synonyms": [
                        "taunt",
                        "twit"
                    ],
                    "common_phrases": [
                        "constant tauntings",
                        "cruel tauntings"
                    ],
                    "target_lang_definitions": {
                        "nl": "De handeling van iemand die bespot of uitlacht.",
                        "ru": "Действие того, кто насмехается или издевается над кем-либо."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "pesterijen",
