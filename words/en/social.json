                },
                {
                    "sense_id": "26f22158-5372-338d-99cd-1fcd9154e955",
                    "sense_definition": "A gathering of people for recreational purposes, often organized by a club or group.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "event",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They organized a <w>social</w> at the dance club to help members get to know each other.",
                            "target_lang_translations": {
                                "ru": "Они организовали <w>вечери́нку</w> в танцевальном клубе, чтобы помочь участникам познакомиться друг с другом.",
                                "zh": "他们在舞蹈俱乐部组织了一场<w>社交聚会</w>，以帮助成员们互相认识。"
                            }
                        },
                        {
                            "text": "The church is holding an ice cream <w>social</w> this Sunday afternoon.",
                            "target_lang_translations": {
                                "ru": "Церковь проводит <w>встре́чу</w> с мороженым в это воскресенье днем.",
                                "zh": "教堂本周日下午将举办一场冰淇淋<w>联谊会</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "gathering",
                        "mixer",
                        "party"
                    ],
                    "common_phrases": [
                        "church social",
                        "ice cream social"
                    ],
                    "target_lang_definitions": {
