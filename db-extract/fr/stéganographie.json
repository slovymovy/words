                                                "sense_id": "99770440-0f17-361a-b438-c8dabaef557c",
                                                "text": "„Eine Methode, die bis heute erfolgreich angewandt wird, ist die Steganographie. Dabei wird die Geheimnachricht in einer harmlosen Nachricht versteckt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
