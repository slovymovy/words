{
    "word_family": [
        "sink",
        "sinking"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7035e8d7-d033-345f-b6cc-a5ec878b6bee",
                    "sense_definition": "Located below the level of the surrounding area or submerged under water.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "submerged",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>sunken</w> ship lay at a depth of 100 feet.",
                            "target_lang_translations": {
                                "tr": "<w>Batık</w> gemi 100 fit derinlikte yatıyordu."
                            }
                        },
                        {
                            "text": "Divers explored the <w>sunken</w> treasure near the reef.",
                            "target_lang_translations": {
                                "tr": "Dalgıçlar resifin yakınındaki <w>batık</w> hazineyi araştırdı."
                            }
                        }
                    ],
                    "synonyms": [
                        "submerged",
                        "underwater"
                    ],
                    "antonyms": [
                        "raised"
                    ],
                    "common_phrases": [
                        "sunken ship",
                        "sunken treasure"
                    ],
                    "target_lang_definitions": {
                        "tr": "Çevreleyen alanın seviyesinin altında bulunan veya su altına batmış olan."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "batık",
                                "target_lang_sense_clarification": "su altına gömülmüş gemi, hazine vb."
                            },
                            {
                                "target_lang_word": "çökük",
                                "target_lang_sense_clarification": "zemin seviyesinden aşağıda olan"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e1ab1dae-824a-3f01-9878-197be8aaab84",
                    "sense_definition": "Appearing hollow or depressed, often due to illness, age, or exhaustion.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "hollow",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She looked thin with <w>sunken</w> cheeks and tired eyes.",
                            "target_lang_translations": {
                                "tr": "<w>Çökük</w> yanakları ve yorgun gözleriyle zayıf görünüyordu."
                            }
                        },
                        {
                            "text": "His <w>sunken</w> eyes showed how much he had suffered.",
                            "target_lang_translations": {
                                "tr": "<w>Çukura kaçmış</w> gözleri ne kadar acı çektiğini gösteriyordu."
                            }
                        }
                    ],
                    "synonyms": [
                        "hollow",
                        "gaunt"
                    ],
                    "antonyms": [
                        "full"
                    ],
                    "common_phrases": [
                        "sunken cheeks",
                        "sunken eyes"
                    ],
                    "target_lang_definitions": {
                        "tr": "Hastalık, yaşlılık veya yorgunluk nedeniyle içeri doğru çökmüş veya oyuk görünen (göz, yanak vb.)."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "çökük",
                                "target_lang_sense_clarification": "yanak veya göz için içeri çökmüş"
                            },
                            {
                                "target_lang_word": "çukura kaçmış",
                                "target_lang_sense_clarification": "gözler için"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fda1c186-dfc1-3021-bec6-96400bbb314c",
                    "sense_definition": "The past participle of <w>sink</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The boat has <w>sunken</w> to the bottom of the lake.",
                            "target_lang_translations": {
                                "tr": "Tekne gölün dibine <w>battı</w>."
                            }
                        },
                        {
                            "text": "The heavy stone has <w>sunken</w> into the soft mud.",
                            "target_lang_translations": {
                                "tr": "Ağır taş yumuşak çamurun içine <w>battı</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Grammatical form of the verb sink."
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "'sink' (batmak) fiilinin geçmiş zaman ortacı (past participle) hali."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "batmış",
                                "target_lang_sense_clarification": "suya veya çamura batmış"
                            },
                            {
                                "target_lang_word": "batık",
                                "target_lang_sense_clarification": "batmış durumda olan"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}