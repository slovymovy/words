                        "examples": [
                            {
                                "example_id": "6c8eccf0-5a2f-4da9-9b0a-feb2369042f4",
                                "sense_id": "18cef7f2-4981-3131-b477-7036137e4c98",
                                "text": "ein Machtwort sprechen",
                                "translation": "to exercise one's authority",
                                "english": "to exercise one's authority"
                            },
                            {
                                "example_id": "b41e14a5-51a5-4188-a490-06af101132e6",
                                "sense_id": "18cef7f2-4981-3131-b477-7036137e4c98",
                                "text": "Dann wurde Helmut Schmidt eingeblendet: „[Herbert von] Karajan war natürlich kein Nazi. Ein Mitläufer war er.“ Mit dem Machtwort des Altkanzlers war das Thema schon wieder vom Tisch."
                            },
                            {
                                "example_id": "52c300fa-2f47-4c36-9a3b-7d7672186b9a",
                                "sense_id": "18cef7f2-4981-3131-b477-7036137e4c98",
                                "text": "Der Kanzler hat ein Machtwort gesprochen. Endlich greift Scholz durch. Warum denn nicht früher? So sehen es manche."
                            }
                        ]
                    }
                ],
