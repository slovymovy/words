                            }
                        },
                        {
                            "text": "Het <w>eer</w> van de oude beelden was door de tijd groen uitgeslagen.",
                            "target_lang_translations": {
                                "en": "The <w>bronze</w> of the old statues had turned green over time."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "verouderd woord voor metaal"
                        }
                    ],
                    "target_lang_definitions": {
