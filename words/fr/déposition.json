    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "24519db0-3b20-3e41-b026-269ca2c5cbc8",
                    "sense_definition": "Déclaration faite en justice par un témoin sur ce qu'il a vu ou entendu.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "justice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le témoin s'est présenté à la police pour faire sa <w>déposition</w>."
                        },
                        {
                            "text": "L'avocat a soigneusement relu chaque <w>déposition</w> avant le début du procès."
                        }
                    ],
                    "synonyms": [
                        "témoignage"
                    ],
                    "common_phrases": [
                        "faire une déposition",
                        "recueillir une déposition",
                        "déposition d'un témoin"
                    ]
                },
                {
                    "sense_id": "da500f87-2440-3aca-829f-697880a437cf",
                    "sense_definition": "Action de destituer quelqu'un de sa charge, de ses fonctions ou d'une haute dignité.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "politique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La <w>déposition</w> du souverain a provoqué de violentes émeutes dans toute la capitale."
                        },
                        {
                            "text": "Après la <w>déposition</w> du ministre, un gouvernement provisoire a rapidement été formé."
                        }
                    ],
                    "common_phrases": [
                        "déposition d'un souverain",
                        "déposition du roi"
                    ]
                },
                {
                    "sense_id": "a13456b8-2caa-3823-a9de-80f8132fd24d",
                    "sense_definition": "Action de déposer officiellement un texte, une motion ou une proposition afin d'ouvrir un débat.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "politique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La <w>déposition</w> de la motion de censure a immédiatement suspendu la séance plénière."
                        },
                        {
                            "text": "Les députés attendent la <w>déposition</w> des textes d'orientation avant d'engager le vote."
                        }
                    ],
                    "common_phrases": [
                        "déposition d'une motion",
                        "déposition de textes"
                    ]
                },
                {
                    "sense_id": "b1f8edfa-eaed-3e6f-bbe9-f01ba6771fea",
                    "sense_definition": "Descente du corps de Jésus-Christ de la croix, particulièrement comme sujet dans l'art chrétien.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "religion_art",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce musée conserve une célèbre peinture représentant la <w>déposition</w> de croix."
                        },
                        {
                            "text": "Le peintre flamand a magistralement illustré la <w>déposition</w> du Christ sur ce retable."
                        }
                    ],
                    "common_phrases": [
                        "déposition de croix"
                    ]
                },
                {
                    "sense_id": "cef4d1d1-df9b-390d-8764-9e4c134e8a47",
                    "sense_definition": "Changement d'état au cours duquel un gaz ou une vapeur passe directement à l'état solide.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En laboratoire, la <w>déposition</w> de cette vapeur permet de former une fine couche cristalline."
                        },
                        {
                            "text": "La formation du givre est un cas typique de <w>déposition</w> sans passage par l'état liquide."
                        }
                    ],
                    "synonyms": [
                        "condensation solide",
                        "désublimation",
                        "sublimation inverse",
                        "sublimation régressive"
                    ],
                    "antonyms": [
                        "sublimation"
                    ]
                },
                {
                    "sense_id": "b62bba00-78ea-3688-b325-c604d676be0d",
                    "sense_definition": "Processus physique ou chimique menant à l'accumulation d'un dépôt de particules issues d'un fluide.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La vitesse de <w>déposition</w> des sédiments varie grandement selon le débit du fleuve."
                        },
                        {
                            "text": "Ce procédé industriel contrôle la <w>déposition</w> de particules métalliques sur la surface traitée."
                        }
                    ],
                    "common_phrases": [
                        "déposition de particules"
                    ]
                }
            ]
        }
    ]
}