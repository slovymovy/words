                ],
                "senses": [
                    {
                        "sense_id": "1908b4ae-542c-3487-bd4b-2a5ae63ad877",
                        "entry_id": "e1610b3a-b7b2-30b3-95fe-3d8693d54ca3",
                        "glosses": [
                            "Gegend, in der Funksignale nicht empfangen werden können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6ef6df8-bb43-426e-a9d4-75d2dad1136e",
                                "sense_id": "1908b4ae-542c-3487-bd4b-2a5ae63ad877",
                                "text": "In einem Funkloch ist kein Handyempfang möglich."
                            },
                            {
                                "example_id": "ab15d21e-c14e-4dc9-a3ec-695b2f01f7a2",
                                "sense_id": "1908b4ae-542c-3487-bd4b-2a5ae63ad877",
                                "text": "„Viele, die mit Auto oder mit der Bahn in Bayern unterwegs sind, kennen das: Plötzlich ist das Handynetz weg – Funkloch.“"
                            },
                            {
                                "example_id": "14203782-b188-4e9a-aced-f3b7e3f15926",
                                "sense_id": "1908b4ae-542c-3487-bd4b-2a5ae63ad877",
                                "text": "„Der Ort, wo die Berggänger wegen eines Sturms feststeckten, befindet sich in einem Funkloch. Die Alpinisten konnten somit keine Hilfe anfordern.“"
                            },
                            {
                                "example_id": "ab59425b-a91c-42fa-9787-78b7cdd7b73e",
                                "sense_id": "1908b4ae-542c-3487-bd4b-2a5ae63ad877",
                                "text": "„Die Zone ist ein staatlich verordnetes Funkloch von der Größe Nordrhein-Westfalens.“"
                            },
                            {
                                "example_id": "92a31695-fb36-4984-a340-1564a76f1fae",
                                "sense_id": "1908b4ae-542c-3487-bd4b-2a5ae63ad877",
                                "text": "„Rinnen in der Nordeifel steckt in einem Funkloch: Die Dorfbewohner müssen manchmal sogar auf den Friedhof gehen, um telefonieren zu können.“"
                            },
                            {
                                "example_id": "a7db5d9d-3fc4-46c4-8f83-d6057c0f2742",
                                "sense_id": "1908b4ae-542c-3487-bd4b-2a5ae63ad877",
                                "text": "„Computer-Experte Marko Bagic rät LTE-Kunden, bereits bei Erhalt des Routers und des LTE-Sticks zu testen, ob sie eventuell in einem Funkloch stecken.“"
                            },
                            {
                                "example_id": "04171241-4819-4563-97a0-4964e7392d0a",
                                "sense_id": "1908b4ae-542c-3487-bd4b-2a5ae63ad877",
                                "text": "„Bei der Funklochmeldestelle im Saarland sind bislang rund 2700 Meldungen über mögliche Funklöcher eingegangen.“"
                            },
                            {
                                "example_id": "b7720399-5479-453f-bb49-858eee27daea",
                                "sense_id": "1908b4ae-542c-3487-bd4b-2a5ae63ad877",
                                "text": "„Warum gibt es Funklöcher? […] 'Man müsste sehr dicht Antennen über das Land verteilen, um Funklöcher vollständig zu vermeiden', sagt Nachrichtenübertragungstechnik-Professor Stephan Pachnicke von der Uni Kiel. 'Es ist natürlich dann erstmal die Frage, wie viele Leute von einem Funkloch betroffen sind und ob es sich ökonomisch lohnt, dort einen Funkmast aufzubauen'.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
