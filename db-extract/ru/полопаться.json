                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8adcc7d0-7759-4cf7-a2bf-661c1bcc310a",
                                "sense_id": "e44b1bdc-aae2-38d7-8ba0-3e8e636db14c",
                                "text": "Ещё подали пирог с луком и пареную репу с квасом. «И как это господа не полопаются от такой еды!» — думал он."
                            },
                            {
                                "example_id": "5959135c-b599-4a4e-b23c-cb4bd03b8089",
                                "sense_id": "e44b1bdc-aae2-38d7-8ba0-3e8e636db14c",
                                "text": "Ночью была гроза, молнии разрывались рядом, всё вокруг трещало, на веранде полопались стёкла и заливало ливнем."
                            }
                        ]
                    }
