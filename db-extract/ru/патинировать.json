                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "patiner",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5b54f5b9-8e9b-3b83-874d-a917a851f309",
                                        "entry_id": "76cb1348-4c38-3862-a820-0dcc2fd819eb",
                                        "glosses": [
                                            "Glisser sur la glace, sur un sol uni, avec des patins."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab0e21fa-c613-4f05-8b9e-cb53e0cb57b0",
                                                "sense_id": "5b54f5b9-8e9b-3b83-874d-a917a851f309",
                                                "text": "On patinait autour de lui. Des enfants, le col entouré de cache-nez écarlates, blancs, verts, bleus, glissaient et tournoyaient."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94b1aba9-595e-3450-a228-4d2af802d923",
                                        "entry_id": "76cb1348-4c38-3862-a820-0dcc2fd819eb",
                                        "glosses": [
                                            "Glisser sur le sol sans que les roues tournent ; ou ne pas avancer, alors que les roues tournent, en parlant d’un véhicule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5f48104-4863-485f-aa17-f3b8af641b0e",
                                                "sense_id": "94b1aba9-595e-3450-a228-4d2af802d923",
                                                "text": "Le train s’ébranle en ce moment, les roues de la locomotive patinent sur le rail, puis la vitesse s’accélère…"
                                            },
                                            {
                                                "example_id": "639543f7-1eb9-402d-9a29-28cb0d74d963",
                                                "sense_id": "94b1aba9-595e-3450-a228-4d2af802d923",
                                                "text": "Nadia conduit lentement, tant par crainte d'enliser sa Fiat, qui patine dans les roulières, qu'en raison de la nervosité qu'elle ressent à la perspective de cette rencontre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cca51a0a-d617-38bd-beb6-761ffc77740b",
                                        "entry_id": "76cb1348-4c38-3862-a820-0dcc2fd819eb",
                                        "glosses": [
                                            "Faire du patin (à roulettes)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e74647cd-ca0b-3d4b-9292-f595a2ee4a12",
                                        "entry_id": "76cb1348-4c38-3862-a820-0dcc2fd819eb",
                                        "glosses": [
                                            "Glisser l’un par rapport à l’autre en parlant de pièces de friction."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dac7cd42-30a9-44d1-b895-4f602411a963",
                                                "sense_id": "e74647cd-ca0b-3d4b-9292-f595a2ee4a12",
                                                "text": "Lors d’un démarrage en côte, l’on fait toujours patiner l’embrayage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9dc91045-96c5-357a-982e-f992d4f435a3",
                                        "entry_id": "76cb1348-4c38-3862-a820-0dcc2fd819eb",
                                        "glosses": [
                                            "Ne pas progresser."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "981a8f27-b54d-4b3e-800d-ccccadad4f64",
                                                "sense_id": "9dc91045-96c5-357a-982e-f992d4f435a3",
                                                "text": "[Titre] La négociation du Brexit patine : raté momentané ou vraie crise ?"
                                            },
                                            {
                                                "example_id": "a43536d9-0133-4c30-aa2d-3dc9ddd207aa",
                                                "sense_id": "9dc91045-96c5-357a-982e-f992d4f435a3",
                                                "text": "La décarbonation des transports, qui sont responsables de 30 % des émissions françaises de gaz à effet de serre, patine elle aussi."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "patiner",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fd57b7e2-b243-36bf-9c4e-054c3e3536fd",
                                        "entry_id": "3f916eb9-f730-35c3-8f44-55d808e96f64",
                                        "glosses": [
                                            "Enduire un objet d’une substance qui lui donne l’apparence d’une patine naturelle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1b472de-217f-4cad-8bf4-c8b5efcb5a0b",
                                                "sense_id": "fd57b7e2-b243-36bf-9c4e-054c3e3536fd",
                                                "text": "[…]; voici une des rares demeures françaises bâties entièrement de marbre, ce marbre qui, en se patinant, en s’argentant plus que se dorant, s’est vêtu d’une sorte d’éclat doux et tendre, […]."
                                            }
