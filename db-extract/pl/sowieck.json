                                "target_senses": [
                                    {
                                        "sense_id": "0ed0b128-f9f1-3653-bd90-72b5ec3016cd",
                                        "entry_id": "f180c660-8021-30e0-98e9-a02516873493",
                                        "glosses": [
                                            "Stadt in der russischen Oblast Kaliningrad an der Memel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f905768-36b4-4bd1-ac5c-60af8981adad",
                                                "sense_id": "0ed0b128-f9f1-3653-bd90-72b5ec3016cd",
                                                "text": "„Am 9. Juli 1807 wurde zu Tilsit der Frieden zwischen Napoleon und Preußen geschlossen.“"
                                            },
                                            {
                                                "example_id": "0783bd93-4efc-4147-8b59-feeb96f7e27d",
                                                "sense_id": "0ed0b128-f9f1-3653-bd90-72b5ec3016cd",
                                                "text": "„Auf der Weiterfahrt nach Tilsit war die Straße vereist, mehrmals brachen die Wagen ein.“"
                                            },
                                            {
                                                "example_id": "d296300f-a0d6-4ba7-b605-1d2af7630cd2",
                                                "sense_id": "0ed0b128-f9f1-3653-bd90-72b5ec3016cd",
                                                "text": "„Dann nahm sie, wenige Wochen später, zwei Bauernfamilien auf, die aus der nordöstlich gelegenen Gegend um Tilsit vor den näher rückenden Russen geflohen waren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
