                        "glosses": [
                            "aan de ouderdom eigen, door de ouderdom afgetakeld"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f865c78-e1c7-42a0-a769-cfa28dc44d3c",
                                "sense_id": "526b49e1-08ba-3259-9ee6-063dfc936a4a",
                                "text": "De nog lang niet seniele oude baas besloot een wereldreis te gaan maken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "306299dc-5cfe-4611-a118-46f25a14028f",
                        "source_entry_id": "8a74f96d-587d-3e3a-bf6b-6955c1620737",
                        "source_sense_id": "526b49e1-08ba-3259-9ee6-063dfc936a4a",
                        "source_sense_description": "aan de ouderdom eigen, door de ouderdom afgetakeld",
                        "target_lang_word": "senil",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "senil",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6f192dde-a62d-3116-ae06-366a933383fb",
                                        "entry_id": "ceb44b79-03b4-302f-96ce-50a4da511d50",
                                        "glosses": [
                                            "aufgrund des Alters in seinen geistigen Möglichkeiten beschränkt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b4b4a0d-446f-44c3-86e4-970bfbb26eb8",
                                                "sense_id": "6f192dde-a62d-3116-ae06-366a933383fb",
                                                "text": "Herr M. war schon etwas senil und begriff den Ernst der Lage nicht."
                                            },
                                            {
                                                "example_id": "39a1e01d-78fb-4805-ade6-3e7b73773625",
                                                "sense_id": "6f192dde-a62d-3116-ae06-366a933383fb",
                                                "text": "Vielleicht war er seniler, als ich dachte, und konnte sich gar nicht mehr erinnern."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a3c1b369-2633-32d3-ba49-95872f043cae",
                                        "entry_id": "ceb44b79-03b4-302f-96ce-50a4da511d50",
                                        "glosses": [
                                            "das hohe Alter betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e0ccdc6-86e8-40f3-98c6-95efc058d800",
                                                "sense_id": "a3c1b369-2633-32d3-ba49-95872f043cae",
                                                "text": "Sein Vater, der wegen seniler Demenz entmündig wurde, ist im Heim untergebracht."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "9e634bcf-d91d-3114-8f1b-bc6de49bfe15",
                                        "entry_id": "ceb44b79-03b4-302f-96ce-50a4da511d50",
                                        "glosses": [
                                            "altersgeistesschwach"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c523f00-642a-44cc-a341-d089060a733f",
                                                "sense_id": "9e634bcf-d91d-3114-8f1b-bc6de49bfe15",
                                                "text": "Meine Oma ist jetzt echt senil, die babbelt nur noch Sachen von früher."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "22038296-2ee4-40b7-9db3-06c331c94ac3",
                        "source_entry_id": "8a74f96d-587d-3e3a-bf6b-6955c1620737",
                        "source_sense_id": "526b49e1-08ba-3259-9ee6-063dfc936a4a",
                        "source_sense_description": "aan de ouderdom eigen, door de ouderdom afgetakeld",
                        "target_lang_word": "senile",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "senile",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b4657d63-26d2-3ff9-aecc-6335b47230a1",
                                        "entry_id": "06069db5-7993-3978-b2e3-8c33ea6e9358",
                                        "glosses": [
                                            "Of, or relating to old age."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "867ae83c-411e-44ae-a795-b21cb6015d4d",
                                                "sense_id": "b4657d63-26d2-3ff9-aecc-6335b47230a1",
                                                "text": "Similar studies of rats have employed four different intracranial resorbable, slow sustained release systems— […]. Such a slow-release device containing angiogenic factors could be placed on the pia mater covering the cerebral cortex and tested in persons with senile dementia in long term studies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab0142ac-f005-31a5-9943-a9a4aa8c2698",
                                        "entry_id": "06069db5-7993-3978-b2e3-8c33ea6e9358",
                                        "glosses": [
                                            "Exhibiting the deterioration in mind and body often accompanying old age; doddering."
                                        ],
                                        "tags": [
                                            "offensive",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3be3767-48eb-4178-a399-f515863a6477",
                                                "sense_id": "ab0142ac-f005-31a5-9943-a9a4aa8c2698",
                                                "text": "Her mother was senile, but they called it dementia now."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "senile",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6ac4ecb6-f409-3b05-b16a-5316871e6f1f",
                                        "entry_id": "8d81832b-470a-3130-a501-b0cfa302d85d",
                                        "glosses": [
                                            "A person who is senile."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67ff17be-b770-4c1c-86d2-35fbfdb4b62c",
                                                "sense_id": "6ac4ecb6-f409-3b05-b16a-5316871e6f1f",
                                                "text": "Seniles differ markedly in their early adult intelligence level, and in their social, vocational, and educational histories."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "65246454-cdc6-4aff-8c5c-8c91974001b6",
                        "source_entry_id": "8a74f96d-587d-3e3a-bf6b-6955c1620737",
