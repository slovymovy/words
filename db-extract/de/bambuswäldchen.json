                        "examples": [
                            {
                                "example_id": "768f34af-34ce-419e-b232-22cc54e1a49d",
                                "sense_id": "48596fec-4ecc-38d5-b889-a123ecd26155",
                                "text": "„Selbst der Duft des Waldes war ihr Duft, und als ich meinen Rucksack abnahm und mich mitten in dem Bambuswäldchen zwischen Bon und den abgestumpften Leutnant setzte, erinnerte mich sogar die Feuchtigkeit der Erde an sie.“"
                            },
                            {
                                "example_id": "9da7af37-d4ee-4b11-889d-0e80f1fbd2e1",
                                "sense_id": "48596fec-4ecc-38d5-b889-a123ecd26155",
                                "text": "„Inmitten eines hochgewachsenen Bambuswäldchens kamen sie in ein Dorf mit ungefähr hundert hübschen, strohgedeckten Holzhäuschen.“"
                            }
                        ],
