                                "target_senses": [
                                    {
                                        "sense_id": "89c800c4-f4f3-3f0f-a067-8ca7e57eca36",
                                        "entry_id": "ecca7b98-889b-3a31-89e1-a97446667452",
                                        "glosses": [
                                            "Any plant of the family Poaceae, characterized by leaves that arise from nodes in the stem and leaf bases that wrap around the stem, especially those grown as ground cover rather than for grain."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c28fb735-129d-4bea-93b7-957f6a97abca",
                                                "sense_id": "89c800c4-f4f3-3f0f-a067-8ca7e57eca36",
                                                "text": "Thou turnest man to destruction: and sayest, Returne yee children of men. / For a thousand yeeres in thy sight are but as yesterday when it is past: and as a watch in the night. / Thou carriest them away as with a flood, they are as a sleepe: in the morning they are like grasse which groweth vp. / In the morning it flourisheth, and groweth vp: in the euening it is cut downe, and withereth."
                                            },
                                            {
                                                "example_id": "3899129d-97cf-4657-99f1-5021940b8eca",
                                                "sense_id": "89c800c4-f4f3-3f0f-a067-8ca7e57eca36",
                                                "text": "The cicale above in the lime, / And the lizards below in the grass, / Were as silent as ever old Tmolus was, / Listening to my sweet pipings."
                                            },
                                            {
                                                "example_id": "3dad6384-1302-4a0f-92b6-6935389c6552",
                                                "sense_id": "89c800c4-f4f3-3f0f-a067-8ca7e57eca36",
                                                "text": "'Twas early June, the new grass was flourishing everywheres, the posies in the yard—peonies and such—in full bloom, the sun was shining, and the water of the bay was blue, with light green streaks where the shoal showed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "19b90418-ede7-3824-8d17-534227e3639a",
                                        "entry_id": "ecca7b98-889b-3a31-89e1-a97446667452",
                                        "glosses": [
                                            "Various plants not in family Poaceae that resemble grasses."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1b247a10-7080-3ac9-a4da-b882b2cbc1a8",
                                        "entry_id": "ecca7b98-889b-3a31-89e1-a97446667452",
                                        "glosses": [
                                            "A lawn."
