                                                "example_id": "41418222-659d-4ccf-8374-3b10de1d3a52",
                                                "sense_id": "2084d10c-b718-3bc0-aa49-616a0f7523f7",
                                                "text": "Die Veranstalter danken allen Spendern, die diese Aufführung erst ermöglicht haben."
                                            },
                                            {
                                                "example_id": "86944c6b-18fb-46d0-b352-d8f92b6a00d0",
                                                "sense_id": "2084d10c-b718-3bc0-aa49-616a0f7523f7",
                                                "text": "„Bund, Land und EU übernehmen den Löwenanteil, aber auch Klosterkammer, diverse Stiftungen und Spender beteiligen sich an den Kosten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
