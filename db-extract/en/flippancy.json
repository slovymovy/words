                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f337dce1-9a70-3ceb-924d-69aaeb76d447",
                        "entry_id": "a772019d-41b4-3195-9c57-5599284b4b18",
                        "glosses": [
                            "Leichtfertigkeit, Frivolität"
                        ],
                        "tags": [],
