                        "glosses": [
                            "Ajouter de l'espace entre les lettres (d'un mot)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3591055-ff2f-45b2-8136-4307b7178dd4",
                                "sense_id": "9df449d0-4dbe-3fc8-85f3-b56dc99452b1",
                                "text": "Nous avons déjà vu que les espaces servent non seulement à séparer les mots, mais aussi à les interlettrer."
                            },
                            {
                                "example_id": "48864f94-882e-425b-976c-2abf56993519",
                                "sense_id": "9df449d0-4dbe-3fc8-85f3-b56dc99452b1",
                                "text": "Premier principe : « On ne doit pas altérer les lettres », d'où il ressort qu'il vaut mieux les interlettrer que de les serrer."
                            }
                        ]
