                        "glosses": [
                            "Tourner très fort, en parlant des toupies."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb94fbfb-5d46-4ff5-aa8c-347324d4a9fe",
                                "sense_id": "a2341208-6e94-355f-8407-da67b305028b",
                                "text": "Quand ma toupie tombe au milieu du rond, elle « vrône », elle tourne si vertigineusement que si elle touche du flanc l’une des toupies restées prisonnières, elle l’expulse au-dehors et c’est moi qui la mets dans ma poche."
                            }
                        ]
