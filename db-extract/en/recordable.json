                        "glosses": [
                            "That can be recorded; capturable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c310d913-b6e9-41ad-b690-965140827fd3",
                                "sense_id": "41125da3-1846-3251-bc5c-7601e2161680",
                                "text": "Sound and movement are recordable by means of microphones and cameras."
                            },
                            {
                                "example_id": "32a46e48-ba79-43b8-829c-d7ee3652d23f",
                                "sense_id": "41125da3-1846-3251-bc5c-7601e2161680",
                                "text": "User actions are recordable in a macro for playback at a later time."
                            }
                        ]
                    },
                    {
