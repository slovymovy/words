                            {
                                "example_id": "a7b22ffb-ea72-4dad-85aa-a4bb846efa37",
                                "sense_id": "b87b559a-61bf-3f08-b098-6a435b179e8a",
                                "text": "Je sais ce que je dis, nigousse !"
                            },
                            {
                                "example_id": "ce02a3d3-bd37-47f1-b8fd-cf6304d5ab78",
                                "sense_id": "b87b559a-61bf-3f08-b098-6a435b179e8a",
                                "text": "Berthe Pohernec, ça c'était une nature, une gaillarde du Finistère... du granit de la Baie des Trépassés... la Pointe du Raz... née … en pleine lande bretonne parmi les genêts, les fougères... … Les nigousses, ils vivaient en ce temps-là de pommes de terre, de soupe à même la table, avec des curetons féroces qui les tenaient en tutelle."
                            },
                            {
                                "example_id": "2fccc583-5fd1-4cc6-80b2-e55c6d54ff13",
                                "sense_id": "b87b559a-61bf-3f08-b098-6a435b179e8a",
                                "text": "- Gaston L'Arcille ! Moi-même ! d'Asnières ! chu dans un régiment de nigousses ! Fixe ! L'Arcille à l'action ! Voilà ! Trente contre un !..."
                            }
                        ]
