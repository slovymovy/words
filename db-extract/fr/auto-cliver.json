                        "glosses": [
                            "Se cliver par soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7643fe34-778b-4839-b445-fee664619964",
                                "sense_id": "a110f275-6b5f-347f-b9a6-0b454b310113",
                                "text": "C'est au sein de ces plateforme que vont s'auto-cliver et donc s'activer les caspases."
                            },
                            {
                                "example_id": "a4f9c600-8d2e-473d-9726-34df237c9b27",
                                "sense_id": "a110f275-6b5f-347f-b9a6-0b454b310113",
                                "text": "En revanche, celles produites en système eucaryote (S. cerevisiae et T. vaginalis) semblent ne pas s’auto-cliver mais présente les mêmes caractéristiques enzymatiques."
                            },
                            {
                                "example_id": "abd38797-96a7-4905-96e4-456358d7a7cc",
                                "sense_id": "a110f275-6b5f-347f-b9a6-0b454b310113",
                                "text": "La présence de pseudo-nœuds permet ainsi à certains ARN, notamment viraux, de s’auto-cliver sans l’intervention de protéines."
                            }
                        ]
                    }
