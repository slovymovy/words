        "fr-extract.jsonl": [
            {
                "entry_id": "841c3ea7-5213-3a84-9b41-9b05f79f4666",
                "word": "forcing",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "74fde5fe-dafb-42a6-b951-eda16ba39656",
                        "entry_id": "841c3ea7-5213-3a84-9b41-9b05f79f4666",
                        "tags": [
                            "plural"
                        ],
                        "form": "forcings"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "dfcab5aa-40c7-3f6a-84a1-95b8d03b9003",
                        "entry_id": "841c3ea7-5213-3a84-9b41-9b05f79f4666",
                        "glosses": [
                            "Pression, insistance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e447310-8c07-4467-b10c-d9145546beac",
                                "sense_id": "dfcab5aa-40c7-3f6a-84a1-95b8d03b9003",
                                "text": "Faire le forcing auprès de quelqu'un."
                            },
                            {
                                "example_id": "264baf7c-263a-4feb-a4f4-35a175cc6ecf",
                                "sense_id": "dfcab5aa-40c7-3f6a-84a1-95b8d03b9003",
                                "text": "Serait-ce du forcing pour imposer un point de vue ?"
                            },
                            {
                                "example_id": "442f459b-89ef-4f3a-ad65-04825a75390c",
                                "sense_id": "dfcab5aa-40c7-3f6a-84a1-95b8d03b9003",
                                "text": "Dans le domaine de la vente le forcing décrit une pratique peu scrupuleuse qui consiste à faire pression sur une personne pour lui imposer de façon plus ou moins agressive l’achat d’un produit ou d’un service."
                            },
                            {
                                "example_id": "622115ed-a702-4889-99c2-aab8460352d1",
                                "sense_id": "dfcab5aa-40c7-3f6a-84a1-95b8d03b9003",
                                "text": "Le forcing du patron de la SNCF pour empêcher ce scénario est à l’origine de la haine de SUD-Rail."
                            },
                            {
                                "example_id": "a260f0cd-42b6-4b71-a332-0c80a19d4e2c",
                                "sense_id": "dfcab5aa-40c7-3f6a-84a1-95b8d03b9003",
                                "text": "« Les syndicats de l’établissement, raconte Pierre-Olivier S, ont alors fait le forcing auprès du directeur général pour qu’il abandonne la procédure, ce qu’il a accepté »."
                            }
                        ]
                    },
                    {
                        "sense_id": "528478a5-bd68-3394-afe8-6cad379c4ae2",
                        "entry_id": "841c3ea7-5213-3a84-9b41-9b05f79f4666",
                        "glosses": [
                            "Technique de logique mathématique permettant de prouver la cohérence et l’indépendance de certains critères."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "094fd939-8b12-48b1-839c-ebaae3172bcd",
                                "sense_id": "528478a5-bd68-3394-afe8-6cad379c4ae2",
                                "text": "On peut modifier par forcing cardinalité et cofinalité."
                            }
                        ]
                    },
                    {
                        "sense_id": "dd54c1ea-c7d2-34fe-84a8-3e3e20dad988",
                        "entry_id": "841c3ea7-5213-3a84-9b41-9b05f79f4666",
                        "glosses": [
                            "Accélération du rythme, de la cadence."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9a7e7a7-15d2-4068-b5bc-e6c0ee7434a8",
                                "sense_id": "dd54c1ea-c7d2-34fe-84a8-3e3e20dad988",
                                "text": "Faire le forcing."
                            }
                        ]
                    },
                    {
                        "sense_id": "2a52ad5b-7ea7-3643-bad0-457d02a05359",
                        "entry_id": "841c3ea7-5213-3a84-9b41-9b05f79f4666",
                        "glosses": [
                            "Fait d’obliger l'adversaire à jouer un coup qui rend possible une manœuvre avantageuse, souvent une combinaison."
                        ],
                        "tags": [
                            "Jeu de dames"
                        ],
                        "examples": [
                            {
                                "example_id": "e97c94bf-5b3f-470c-9390-4f41c909f68d",
                                "sense_id": "2a52ad5b-7ea7-3643-bad0-457d02a05359",
                                "text": "Le forcing se décompose en deux phases. Cela commence par une attaque ou par une menace, simple ou multiple. L’adversaire est alors tenu de trouver une parade, mais celle-ci livre alors une combinaison."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ae463d6d-a642-42b9-a67b-567249c1772e",
                        "source_entry_id": "841c3ea7-5213-3a84-9b41-9b05f79f4666",
                        "target_lang_word": "pressure",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pressure",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c7d353a7-471b-3c46-8f38-2aa476ef24bc",
                                        "entry_id": "ce9f0050-fd88-3c80-b1b7-8cc5324cf08a",
                                        "glosses": [
                                            "A pressing; a force applied to a surface."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8fab10f-3879-44ff-96be-27dfe263d27f",
                                                "sense_id": "c7d353a7-471b-3c46-8f38-2aa476ef24bc",
                                                "text": "Apply pressure to the wound to stop the bleeding."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07859343-86c6-30a7-98e3-2b0e0b74cbc7",
                                        "entry_id": "ce9f0050-fd88-3c80-b1b7-8cc5324cf08a",
                                        "glosses": [
                                            "A contrasting force or impulse of any kind."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6056f016-16e7-4fce-815f-b14723a90a9f",
                                                "sense_id": "07859343-86c6-30a7-98e3-2b0e0b74cbc7",
                                                "text": "Hostile forces are putting pressure on our people. Take out their supply line to give our troops room to breathe."
                                            },
                                            {
                                                "example_id": "a9ef64e5-8f69-4a36-83f8-37da2bf63db2",
                                                "sense_id": "07859343-86c6-30a7-98e3-2b0e0b74cbc7",
                                                "text": "the pressure of poverty; the pressure of taxes; the pressure of motives on the mind; the pressure of civilization."
                                            },
                                            {
                                                "example_id": "622d11f3-90e0-487a-a632-78063e044960",
                                                "sense_id": "07859343-86c6-30a7-98e3-2b0e0b74cbc7",
                                                "text": "When the pressure of danger was not felt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f812bd4e-854f-3d44-8cc7-dd779857f876",
                                        "entry_id": "ce9f0050-fd88-3c80-b1b7-8cc5324cf08a",
                                        "glosses": [
                                            "Distress."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f466299-0a90-4ed7-879e-dabf607d7ad5",
                                                "sense_id": "f812bd4e-854f-3d44-8cc7-dd779857f876",
                                                "text": "She has felt pressure lately because her boss expects her to get the job done by the first."
                                            },
                                            {
                                                "example_id": "50c56549-8b5b-4b0c-90e4-4ed561d0dbec",
                                                "sense_id": "f812bd4e-854f-3d44-8cc7-dd779857f876",
                                                "text": "My people's pressures are grievous."
                                            },
                                            {
                                                "example_id": "4de15eac-e29e-44fb-b5e9-fbff3c0cfb62",
                                                "sense_id": "f812bd4e-854f-3d44-8cc7-dd779857f876",
                                                "text": "October 31, 1708, Francis Atterbury, a sermon preach'd before the Queen at St. James's\nIn the midst of his great troubles and pressures."
                                            },
                                            {
                                                "example_id": "12e39a6a-66f4-4202-955e-fbaeae84d2a5",
                                                "sense_id": "f812bd4e-854f-3d44-8cc7-dd779857f876",
                                                "text": "Thirty-five years ago, many journeys around London meant having to pass through the centre of the capital. That's no longer the case, which takes real pressure off the city's termini as well as underground routes such as the Circle Line."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d64ce59c-0efd-3c25-b163-86b5a6fbac6f",
                                        "entry_id": "ce9f0050-fd88-3c80-b1b7-8cc5324cf08a",
                                        "glosses": [
                                            "Urgency."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75d1a38a-9321-4149-8d71-2a97069b1177",
                                                "sense_id": "d64ce59c-0efd-3c25-b163-86b5a6fbac6f",
                                                "text": "the pressure of business"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55977157-a531-3ff2-b8e8-3e0505a758b3",
                                        "entry_id": "ce9f0050-fd88-3c80-b1b7-8cc5324cf08a",
                                        "glosses": [
                                            "Impression; stamp; character impressed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72f0581a-af1f-430f-8b4f-aad01ba431d0",
                                                "sense_id": "55977157-a531-3ff2-b8e8-3e0505a758b3",
                                                "text": "All saws of books, all forms, all pressures past."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf541a43-0206-346b-9144-d08adf2c2868",
                                        "entry_id": "ce9f0050-fd88-3c80-b1b7-8cc5324cf08a",
                                        "glosses": [
                                            "The amount of force that is applied over a given area divided by the size of this area; force per unit area."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "pressure",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c3cf2ad5-ea7c-3f5b-9351-6060c4337eb8",
                                        "entry_id": "3108e46e-1ebf-31af-8216-d5047f0745cb",
                                        "glosses": [
                                            "To encourage or heavily exert force or influence."
                                        ],
