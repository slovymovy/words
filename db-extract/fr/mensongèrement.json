                "forms": [],
                "senses": [
                    {
                        "sense_id": "86935203-5bd0-3f51-9d91-ee214fadcff3",
                        "entry_id": "5bc5f627-6e0b-35fc-ab5f-8c20065f6963",
                        "glosses": [
                            "D’une manière mensongère."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e8c467b-978f-4864-8491-0dcd5e515bfc",
                                "sense_id": "86935203-5bd0-3f51-9d91-ee214fadcff3",
                                "text": "Attendu qu'il est établi que, dans le courant du mois d'août 1856, Sonier, berger à Fontenelle, commune d’Antheny, s'étant adressé au prévenu pour le consulter au sujet d'une maladie dont il était atteint, celui-ci lui a dit mensongèrement qu'il était médecin et qu'il avait été breveté par l'Empereur; […]."
                            },
                            {
                                "example_id": "b39e5dbb-aeef-4a41-8a8f-085ba3405a43",
                                "sense_id": "86935203-5bd0-3f51-9d91-ee214fadcff3",
                                "text": "« Que préférez-vous en vous ? » Je déclarai, fort mensongèrement : « Quelqu’un d’autre. »"
                            },
                            {
                                "example_id": "36c9fe2a-1b1b-4316-868d-029e7d54e633",
                                "sense_id": "86935203-5bd0-3f51-9d91-ee214fadcff3",
                                "text": "Bien volontiers, fit-il mensongèrement, se déplaçant à contrecœur."
                            }
                        ]
                    }
                ],
