                "senses": [
                    {
                        "sense_id": "afac103d-355c-353e-a97a-c0a38d5a0460",
                        "entry_id": "4ab4d3c8-e825-380a-ae97-82bab405fba4",
                        "glosses": [
                            "groter, belangrijker, machtiger dan al het andere"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4586aa5-dc14-423e-9410-a6b1852386b5",
                                "sense_id": "afac103d-355c-353e-a97a-c0a38d5a0460",
                                "text": "En zo is het een tweestrijd geworden tussen twee grote rondes. De Giro is een serieus alternatief, en dat is al heel wat na decennia waarin de Tour allesoverheersend en allesverpletterend was."
                            },
                            {
                                "example_id": "ce5e3139-405b-4b28-9a4f-f665f0b0908d",
                                "sense_id": "afac103d-355c-353e-a97a-c0a38d5a0460",
                                "text": "Tot ver in de omtrek hoor je die gasten met hun allesoverheersende gebrul. Ook zij dienen zich toch aan een maximum aantal decibel te houden? Om nog maar te zwijgen over het feit dat ze zich daarmee zeker niet aan de maximum snelheid houden. Waar blijft het handhaven hier? Wanneer stopt de politie eens om de aandacht steeds op auto’s te richten?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3f1677c3-2dc0-46d0-9020-5729183aec85",
                        "source_entry_id": "4ab4d3c8-e825-380a-ae97-82bab405fba4",
                        "source_sense_id": "afac103d-355c-353e-a97a-c0a38d5a0460",
                        "target_lang_word": "all-consuming",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "all-consuming",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ee90d510-f5c9-3eaf-8bcf-27b8b1228dae",
                                        "entry_id": "6406cd95-bb3d-3dbf-899c-91aed81cd625",
                                        "glosses": [
                                            "That consumes everything; that uses everything up."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44b6e1f6-0bc6-4385-a3d0-334a094f8e3b",
                                                "sense_id": "ee90d510-f5c9-3eaf-8bcf-27b8b1228dae",
                                                "text": "Google is the all-consuming superpower on the Internet; soon everything will be owned by them."
                                            },
                                            {
                                                "example_id": "a3e2d3a2-c59d-433b-aa6d-d62c76c2cc7d",
                                                "sense_id": "ee90d510-f5c9-3eaf-8bcf-27b8b1228dae",
                                                "text": "A myth common to several cultures in the galaxy, Reapers were once imagined as space monsters that consumed entire stars. Archaeologists who searched for the sources of such myths found little besides the themes of all-consuming devils that are common to primitive cultures."
                                            },
                                            {
                                                "example_id": "713ecdcf-ad79-4a96-afaf-54e8c86e25aa",
                                                "sense_id": "ee90d510-f5c9-3eaf-8bcf-27b8b1228dae",
                                                "text": "It seems that they existed in some sort of previous incarnation of our universe, and use abstract terms to describe their existence, such as \"feeding on concepts\". They prepared for some sort of ascension, but then the Pattern came, which they describe at first as an all-consuming emptiness, elaborating by saying that anything that passed into it was torn asunder, subjected to a set of principles and order that grinds things down to nothing, in a process of which entropy is just one part."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b92f5e3-07a1-396c-a76b-11cdecf442cb",
                                        "entry_id": "6406cd95-bb3d-3dbf-899c-91aed81cd625",
                                        "glosses": [
                                            "Totally engrossing, using up all of one's time and energy."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ff7506b-28f4-4cec-b167-44f19fae46d3",
                                                "sense_id": "9b92f5e3-07a1-396c-a76b-11cdecf442cb",
                                                "text": "Where the Joker preys on our fears of random, irrational acts of terror, Bane has an all-consuming, dictatorial agenda that’s more stable and permanent, a New World Order that's been planned out with the precision of a military coup."
                                            },
                                            {
                                                "example_id": "2bc8614a-9abd-49b2-a622-c09005095d24",
                                                "sense_id": "9b92f5e3-07a1-396c-a76b-11cdecf442cb",
                                                "text": "Brown revealed that his time as London Transport Commissioner has been all-consuming, describing it as \"full-on\"."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
