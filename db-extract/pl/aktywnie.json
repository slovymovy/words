                    {
                        "translation_id": "bebe7e86-e99e-4061-bf10-e25b5217939d",
                        "source_entry_id": "94d755d3-b81b-3071-844d-afa1f0e93987",
                        "source_sense_id": "bceeacf9-d276-3bd8-a1a4-b907d836e7c5",
                        "target_lang_word": "aktiv",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aktiv",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6f035f6b-bb83-3f90-a215-82016d5655f3",
                                        "entry_id": "dcf768a4-4c69-3d11-981c-7e485bc7ae19",
                                        "glosses": [
                                            "in einer bestimmten Hinsicht tätig, engagiert"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ec799af-1c48-4768-ac24-6f315627ba97",
                                                "sense_id": "6f035f6b-bb83-3f90-a215-82016d5655f3",
                                                "text": "Er ist sehr aktiv, was seine Hobbys betrifft."
                                            },
                                            {
                                                "example_id": "e9bd5032-a63c-4723-8de0-82b63848e970",
                                                "sense_id": "6f035f6b-bb83-3f90-a215-82016d5655f3",
                                                "text": "„Wir haben bei der Veranstaltung in Brüssel klar gesagt, dass die EU in diesem Bereich [der Presse- und Meinungsfreiheit] stärker aktiv werden muss, gerade in den Ländern, die den Beitritt anstreben.“"
                                            },
                                            {
                                                "example_id": "093e7f4f-86d0-4ce4-b10e-d44e7c155ce9",
                                                "sense_id": "6f035f6b-bb83-3f90-a215-82016d5655f3",
                                                "text": "„Der Strahl, damit die aufrechte, stehende Linie ist hier das einfachste Bild des aktiven, tätigen, handelnden Grundelements der Schöpfung.“"
                                            },
                                            {
                                                "example_id": "e1818850-1236-4134-92ae-644764b65cd2",
                                                "sense_id": "6f035f6b-bb83-3f90-a215-82016d5655f3",
                                                "text": "[Corona-Impfung:] „»[…] es muss natürlich auch klar sein, wenn man sich jetzt aktiv gegen eine Impfung entscheidet, entscheidet man sich eigentlich auch aktiv für eine Infektion […]. Das heißt, irgendwann ist man dann halt fällig.«“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8c81d00f-03c0-3fff-b3af-7a38315fff62",
                                        "entry_id": "dcf768a4-4c69-3d11-981c-7e485bc7ae19",
                                        "glosses": [
                                            "radioaktive Strahlen aussendend"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b735df2-58c8-431d-a878-24292d31d6d8",
                                                "sense_id": "8c81d00f-03c0-3fff-b3af-7a38315fff62",
                                                "text": "„In einem radioaktiven Gegenstand gibt es viele aktive Isotope.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "6ae306bf-a22c-3006-8fb2-3dc58c95f574",
                                        "entry_id": "dcf768a4-4c69-3d11-981c-7e485bc7ae19",
                                        "glosses": [
                                            "als Mitglied engagiert beteiligt"
                                        ],
                                        "tags": [
                                            "von Organisationen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02f1cbf4-8c8a-44b6-8ba7-5a7b17b5070b",
                                                "sense_id": "6ae306bf-a22c-3006-8fb2-3dc58c95f574",
                                                "text": "Er ist außerdem ein aktives Mitglied im örtlichen Sportverein."
                                            },
                                            {
                                                "example_id": "440bc4fe-be00-4254-a487-3806e03eb002",
                                                "sense_id": "6ae306bf-a22c-3006-8fb2-3dc58c95f574",
                                                "text": "„Ich bin sehr aktiv in meiner Partei: ich bin dort Schatzmeister, mache Bürgersprechstunden und helfe beim Wahlkampf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "2470a387-e070-3482-ba4c-0c650c02de72",
                                        "entry_id": "dcf768a4-4c69-3d11-981c-7e485bc7ae19",
                                        "glosses": [
                                            "in Betrieb befindlich"
                                        ],
                                        "tags": [
                                            "von Geräten oder Funktionen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "422d9a9d-29ad-4d7f-9ea3-51db9a301874",
                                                "sense_id": "2470a387-e070-3482-ba4c-0c650c02de72",
                                                "text": "„Dr. Bischoff: »Man muss das Gewebe auch konservieren, in der Phase wo die Herz-Lungen-Maschine aktiv ist…«“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "a9c42f9a-4a7c-3536-b0c9-21e07783d687",
                                        "entry_id": "dcf768a4-4c69-3d11-981c-7e485bc7ae19",
                                        "glosses": [
                                            "im Aktiv befindlich (= Konjugationsformen des Verbs)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a9c1812-dd89-40de-a4a8-dd000b40ae91",
                                                "sense_id": "a9c42f9a-4a7c-3536-b0c9-21e07783d687",
                                                "text": "Die aktiven Formen der Verben sind in der Regel häufiger als die passiven."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "a44d74d1-7afe-34e2-acd4-0b87c2fa55d3",
                                        "entry_id": "dcf768a4-4c69-3d11-981c-7e485bc7ae19",
                                        "glosses": [
                                            "vergleiche [4], aktiv genutzt, auf der aktiven Seite der Bestandskonten (zum Beispiel PKW oder Büromöbel)"
                                        ],
                                        "tags": [
                                            "Buchhaltung"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5910f88e-24fd-42dd-ba9d-4f2be41cc579",
                        "source_entry_id": "94d755d3-b81b-3071-844d-afa1f0e93987",
