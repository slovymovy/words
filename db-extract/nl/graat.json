                    {
                        "sense_id": "e7b0ccba-ba42-3e10-844e-0e4e70c2f576",
                        "entry_id": "f545fa23-aaca-3c2e-bdba-d735fd17d4df",
                        "glosses": [
                            "kleine lange scherpe botjes van een ander dier dan een vis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32630a89-ed1c-491d-ad1c-d0790634f287",
                                "sense_id": "e7b0ccba-ba42-3e10-844e-0e4e70c2f576",
                                "text": "Met een lange dolk bracht hij een groot stuk slang naar me toe. Dankbaar pakte ik het aan en nam voorzichtig een hap om te proeven hoe het smaakte. De zwart verkoolde buitenkant omhulde zacht, wit vlees. Het duurde even voordat ik de smaak kon plaatsen. Het leek op een soort combinatie van kip, vis en kauwgom met opvallend veel kleine graatjes. Bij elke hap moest ik drie graatjes uit mijn mond halen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d29520d3-3654-4998-9d0f-36b75abe17cc",
                        "source_entry_id": "f545fa23-aaca-3c2e-bdba-d735fd17d4df",
