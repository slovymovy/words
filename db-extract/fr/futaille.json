        "fr-extract.jsonl": [
            {
                "entry_id": "1dffa302-e772-301d-99ba-e43706ea07a8",
                "word": "futaille",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "bf126146-6a85-49ed-9c0e-e42514d32e2d",
                        "entry_id": "1dffa302-e772-301d-99ba-e43706ea07a8",
                        "tags": [
                            "plural"
                        ],
                        "form": "futailles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9a3a978a-5854-338c-b7d1-7ee4fad7ae98",
                        "entry_id": "1dffa302-e772-301d-99ba-e43706ea07a8",
                        "glosses": [
                            "Récipient de bois qui sert à mettre le vin ou d’autres liqueurs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ef2599f-4fcd-46b4-a005-3285592b5c10",
                                "sense_id": "9a3a978a-5854-338c-b7d1-7ee4fad7ae98",
                                "text": "Une longue planche de sapin posée sur deux bûches servait de banc et les tables étaient des futailles vides."
                            },
                            {
                                "example_id": "dd7851c2-1677-48a1-94d5-bc89d2f6dc20",
                                "sense_id": "9a3a978a-5854-338c-b7d1-7ee4fad7ae98",
                                "text": "Paul montait dans la grange, attrapait des oiseaux, faisait des ricochets sur la mare, ou tapait avec un bâton les grosses futailles qui résonnaient comme des tambours."
                            },
                            {
                                "example_id": "3d774b98-d4cf-48f5-b1b8-0772d25fbfe8",
                                "sense_id": "9a3a978a-5854-338c-b7d1-7ee4fad7ae98",
                                "text": "Allez, faites concurrence à mes futailles, rougissez-vous le gosier !"
                            },
                            {
                                "example_id": "7d5e766e-34a7-48c9-b86b-a75b1d6ff8bd",
                                "sense_id": "9a3a978a-5854-338c-b7d1-7ee4fad7ae98",
                                "text": "Pouvais-je expliquer au bon maître que je ne connaissais pas le vin, que chez nous jamais nous ne buvions de vin, que mon père brassait-lui-même dans une futaille, à la cave, une boisson économique, tantôt écumante et légère, tantôt inerte et doucereuse ?"
                            },
                            {
                                "example_id": "5e14feec-c251-4b13-b69a-890d41ed699a",
                                "sense_id": "9a3a978a-5854-338c-b7d1-7ee4fad7ae98",
                                "text": "On avait sorti les futailles devant les celliers, dans les ruelles; à l'ombre bleue des murets de pierre sèche."
                            },
                            {
                                "example_id": "4b23c41e-1e7d-4617-856a-3f7cc6d84fc2",
                                "sense_id": "9a3a978a-5854-338c-b7d1-7ee4fad7ae98",
                                "text": "Ainsi la production de grande qualité, celle des châteaux, se différenciait-elle de plus en plus de celle des Bordeaux anonymes, vins de marques commerciales entre autres, livrés en futailles par les négociants de la grande ville."
                            }
                        ]
                    },
                    {
                        "sense_id": "bc627ef0-f1ac-3bcc-a6f6-4daf1186845f",
                        "entry_id": "1dffa302-e772-301d-99ba-e43706ea07a8",
                        "glosses": [
                            "Douves démontées d’un tonneau."
                        ],
                        "tags": [
                            "plural"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "d917925e-42fa-3de1-be9a-2b5c471361bd",
                        "entry_id": "1dffa302-e772-301d-99ba-e43706ea07a8",
                        "glosses": [
                            "Ensemble de fûts et tonneaux."
                        ],
                        "tags": [
                            "collective",
                            "singular"
                        ],
                        "examples": [
                            {
                                "example_id": "e1c9504a-76b9-4d34-8ac0-1845ec400742",
                                "sense_id": "d917925e-42fa-3de1-be9a-2b5c471361bd",
                                "text": "S’il était interdite aux chariots de circuler, il n’était pas défendu de boire, les brasseurs eurent tôt fait de trouver la solution du problème. Pour livrer la bière, ils firent rouler les tonneaux dans la rue, depuis la brasserie jusque chez le client. […] le roulement de la futaille et le glouglou du liquide houblonné mettaient en joie la marmaille qui faisait cortège : un air de kermesse circulait partout."
                            }
                        ]
                    },
                    {
                        "sense_id": "b6f07a0b-b68b-3925-9516-4d1f85334004",
                        "entry_id": "1dffa302-e772-301d-99ba-e43706ea07a8",
                        "glosses": [
                            "Enterrer les futailles : Les mettre en partie dans le lest du vaisseau ^([1])."
                        ],
                        "tags": [],
                        "examples": []
                    }
