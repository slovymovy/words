                "senses": [
                    {
                        "sense_id": "04f30f95-c392-3b4b-bf64-b3393371b178",
                        "entry_id": "e3ab9f0f-9aa4-3f23-a625-f3de1c663d97",
                        "glosses": [
                            "Chiffonner, faire des plis, en parlant notamment des manches d’un vêtement."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "322c6e30-d284-4701-a7f4-8ff86b5be10f",
                                "sense_id": "04f30f95-c392-3b4b-bf64-b3393371b178",
                                "text": "J’ai quatre ans, il m’apprend à enfiler mon manteau en retenant les manches de mon pull-over entre mes poings pour qu’elles ne boulichonnent pas en haut des bras. Rien que des images de douceur et de sollicitude."
                            },
                            {
                                "example_id": "74801eee-ec35-42a6-bdf3-dde545a58ebc",
                                "sense_id": "04f30f95-c392-3b4b-bf64-b3393371b178",
                                "text": "Beau look mais boulichonne au premier lavage, le tissu s’étire et se déforme lorsqu’on le porte."
                            }
                        ]
                    }
                ],
