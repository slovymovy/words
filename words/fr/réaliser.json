                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'architecte a enfin réussi à <w>réaliser</w> son projet de musée moderne."
                        },
                        {
                            "text": "Elle a travaillé dur toute l'année pour <w>réaliser</w> son rêve d'enfant."
                        }
                    ],
