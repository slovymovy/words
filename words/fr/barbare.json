                        "les tribus barbares"
                    ]
                },
                {
                    "sense_id": "4b5d4cab-0653-35e9-b8ba-78e55130a296",
                    "sense_definition": "Qui manque d'harmonie, d'élégance ou qui heurte les règles du bon goût et du langage.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "esthétique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'auteur emploie un style <w>barbare</w> qui déroute complètement les lecteurs habituels."
                        },
                        {
                            "text": "Cette composition sonore présente une mélodie <w>barbare</w> qui heurte la sensibilité du public."
