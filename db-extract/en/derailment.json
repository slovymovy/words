                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e51c203e-98cb-330b-9e34-0057f871ef3b",
                                        "entry_id": "82552a66-78c0-3064-986a-a10526bc01a5",
                                        "glosses": [
                                            "Verunglücken eines Schienenfahrzeugs dadurch, dass es aus den Schienen springt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93f4b2e7-3989-471e-9f55-46078e576471",
                                                "sense_id": "e51c203e-98cb-330b-9e34-0057f871ef3b",
                                                "text": "„»Wenige Minuten vor der Entgleisung erhielt der Lokführer einen Anruf auf seinem Diensttelefon«, teilte das Gericht mit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2be9639e-e4c5-318a-b638-bc833046b8f0",
                                        "entry_id": "82552a66-78c0-3064-986a-a10526bc01a5",
                                        "glosses": [
                                            "Verletzung einer sozialen Norm"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6f34186-6e44-4b59-a8ac-80b99d8e52ad",
                                                "sense_id": "2be9639e-e4c5-318a-b638-bc833046b8f0",
                                                "text": "„Dass er es geschafft hat, sich nach derartigen Entgleisungen an der Macht zu halten, sorgte bei vielen Menschen auf dem Kontinent für echtes Entsetzen.“"
                                            },
                                            {
                                                "example_id": "5206cc32-8d8f-4b5c-ad6d-b9380ae6dbcb",
                                                "sense_id": "2be9639e-e4c5-318a-b638-bc833046b8f0",
                                                "text": "„Es ist bei weitem nicht seine [Donald Trumps] erste rassistische Entgleisung – und er ist auch bei weitem nicht der einzige Politiker, der sich solch rassistischer Sprache bedient.“"
                                            },
                                            {
                                                "example_id": "78fdf0e9-8483-4cd3-972e-97cac148091a",
                                                "sense_id": "2be9639e-e4c5-318a-b638-bc833046b8f0",
                                                "text": "„‚[…] Dass der Hohe Repräsentant in Bosnien und Herzegowina, Christian Schmidt, nun in Budapest die Ereignisse in Srebrenica als eine ‚genocide-style situation‘ beschreibt, ist in mildester Interpretation eine schwere rhetorische Entgleisung.‘“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
