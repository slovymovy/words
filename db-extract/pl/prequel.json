                                        "examples": [
                                            {
                                                "example_id": "8b611712-8875-472a-b198-0230888347d2",
                                                "sense_id": "a86275e0-d7de-3e9b-af93-534094ecd18e",
                                                "text": "Il s’agit d’une préquelle qui devrait reposer sur le timing comique de l’acteur Bob Odenkirk."
                                            },
                                            {
                                                "example_id": "504b8e45-7a22-4f9a-bd54-d8edd3eb5d33",
                                                "sense_id": "a86275e0-d7de-3e9b-af93-534094ecd18e",
                                                "text": "Alors, vous êtes plutôt tenté par une suite ou par une préquelle pour District 9 ? Et pourquoi pas les deux ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
