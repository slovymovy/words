                ],
                "senses": [
                    {
                        "sense_id": "0fb3bee4-615a-37f9-9292-98772bcdec6d",
                        "entry_id": "3ffdbd12-abdf-355a-9dd8-77e1ce091ded",
                        "glosses": [
                            "Se hâter ; se grouiller."
                        ],
                        "tags": [
                            "Canada"
                        ],
                        "examples": [
                            {
                                "example_id": "11ab7f78-a812-42a2-af4b-fc04f396cdf9",
                                "sense_id": "0fb3bee4-615a-37f9-9292-98772bcdec6d",
                                "text": "Tiens, pour une fois, ce jour, je suis le premier arrivé. Je dois me déguédiner car, malgré tout, je suis en retard et Mireille risque d’entrer d’une minute à l’autre."
                            },
                            {
                                "example_id": "ac6a7969-1dd6-4828-acb9-35d57f88654c",
                                "sense_id": "0fb3bee4-615a-37f9-9292-98772bcdec6d",
                                "text": "Après notre entretien, j’m’en va déguédiner (me dépêcher) de prévenir tous les services de police des aéroports du Québec et de l’Ontario."
                            }
                        ]
                    }
                ],
