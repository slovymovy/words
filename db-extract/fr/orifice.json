                                "target_senses": [
                                    {
                                        "sense_id": "85484944-ee97-3e81-af48-786700f8f622",
                                        "entry_id": "d8eaac7f-7004-35f6-92e3-d8348bc05ccc",
                                        "glosses": [
                                            "A mouth or aperture, such as of a tube, pipe, etc.; an opening."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c18d233b-0818-4d17-a873-5dd5c401c794",
                                                "sense_id": "85484944-ee97-3e81-af48-786700f8f622",
                                                "text": "the orifice of an artery or vein; the orifice of a wound; the vagina and other orifices"
                                            },
                                            {
                                                "example_id": "6e91a67f-5571-4771-b2c8-b825a4d1b14e",
                                                "sense_id": "85484944-ee97-3e81-af48-786700f8f622",
                                                "text": "For example, cultures that scorn open orifices of all kinds despise uninfibulated female genitals too[…]"
                                            },
                                            {
                                                "example_id": "867049c6-42f2-47fd-b500-ea28f7c7a387",
                                                "sense_id": "85484944-ee97-3e81-af48-786700f8f622",
                                                "text": "As none of the ovicells were observed to be closed by the operculum, presumably because they were empty and the opercula were resting on the primary orifice rim, the ovicell closure type is subcleithral rather than cleithral [51 ], at least in some species of the genus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3640e1e6-a974-38a3-962a-d314196615d4",
                                        "entry_id": "d8eaac7f-7004-35f6-92e3-d8348bc05ccc",
                                        "glosses": [
                                            "A stupid or objectionable person."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6eb40a34-8d07-4f6d-b318-9f15fed1f717",
                                                "sense_id": "3640e1e6-a974-38a3-962a-d314196615d4",
                                                "text": "“Peanuts aren't nuts, you orifice. They're legumes.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
