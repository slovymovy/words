                "senses": [
                    {
                        "sense_id": "fe286d45-2805-3443-bcd3-63682004a2c8",
                        "entry_id": "d8e6bff0-1f82-3da8-807a-2b7d92abcde6",
                        "glosses": [
                            "Verbindung mit Natrium"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4fd9d96-866a-43df-a001-0196830167e9",
                                "sense_id": "fe286d45-2805-3443-bcd3-63682004a2c8",
                                "text": "„Die Einwirkung des Natriums auf das Wasser, unter geeigneten Verhältnissen, liefert eine Natriumverbindung, welche gleichfalls starr ist und Natriumoxid genannt wird.“"
                            },
                            {
                                "example_id": "02c7eaa4-a622-4deb-be83-eca203806776",
                                "sense_id": "fe286d45-2805-3443-bcd3-63682004a2c8",
                                "text": "„Bei der Behandlung der Natriumverbindung der Cellulose mit Schwefelkohlenstoff entsteht ein Cellulosethiokarbonat, das in Wasser leicht löslich ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
