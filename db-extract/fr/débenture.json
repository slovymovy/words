                                "example_id": "8ce3ae77-f7b0-4cb9-ae30-2dabf383add2",
                                "sense_id": "2b599096-b902-3521-98f1-19e0305ab759",
                                "text": "La Caisse détient aussi une autre débenture d’un montant de 15M$ consentie en 2004, dont le taux d’intérêt est d’environ 6,7%."
                            },
                            {
                                "example_id": "a18a983d-47bd-44c6-ad42-7c2235af63dc",
                                "sense_id": "2b599096-b902-3521-98f1-19e0305ab759",
                                "text": "Le Fonds de solidarité FTQ participe également à cette transaction avec un investissement de 30 millions sous forme d’une débenture non garantie."
                            }
                        ]
                    }
