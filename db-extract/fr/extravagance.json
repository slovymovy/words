        "fr-extract.jsonl": [
            {
                "entry_id": "e939b978-da3d-3c3a-8cf1-4eb990be8ea6",
                "word": "extravagance",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a1cab770-0931-4a73-beb2-aef2723c3321",
                        "entry_id": "e939b978-da3d-3c3a-8cf1-4eb990be8ea6",
                        "tags": [
                            "plural"
                        ],
                        "form": "extravagances"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8c4a0228-c674-3870-8707-afc6b84048b1",
                        "entry_id": "e939b978-da3d-3c3a-8cf1-4eb990be8ea6",
                        "glosses": [
                            "Action extravagante, discours extravagant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19c2a59e-6f1c-4fe0-8bb3-21b700cc00f4",
                                "sense_id": "8c4a0228-c674-3870-8707-afc6b84048b1",
                                "text": "Ces écarts d’imagination ne paraissent pas invraisemblables, quand on est témoin des folies, des extravagances que ces belles Liméniennes font faire aux étrangers."
                            },
                            {
                                "example_id": "eb50d9bb-9323-479a-b851-5eaad6099720",
                                "sense_id": "8c4a0228-c674-3870-8707-afc6b84048b1",
                                "text": "Puis, nous conférons. Impossible, nous en tombons tout de suite d’accord, de souscrire à l’extravagance dont on veut nous faire prendre la responsabilité."
                            }
                        ]
                    },
                    {
                        "sense_id": "b721c9ae-6f2c-3381-889d-a5e326c9312e",
                        "entry_id": "e939b978-da3d-3c3a-8cf1-4eb990be8ea6",
                        "glosses": [
                            "Bizarrerie, incohérence, folie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e158674-1bbd-4746-a3a6-46e014be6ebc",
                                "sense_id": "b721c9ae-6f2c-3381-889d-a5e326c9312e",
                                "text": "Un petit chat entra, circonspect et naïf, un ordinaire et irrésistible chaton de quatre à cinq mois. Il se jouait à lui-même une comédie majestueuse, mesurait son pas et portait la queue en cierge, à l’imitation des seigneurs matous. Mais un saut périlleux en avant, que rien n’annonçait, le jeta séant par-dessus tête à nos pieds, où il prit peur de sa propre extravagance, se roula en turban, se mit debout sur ses pattes de derrière, dansa de biais, enfla le dos, se changea en toupie…"
                            },
                            {
                                "example_id": "7ffeca50-786f-4456-8dae-393094ca3d7c",
                                "sense_id": "b721c9ae-6f2c-3381-889d-a5e326c9312e",
                                "text": "Nous avons déjà parlé de la mode excentrique des souliers de cette époque ; les pointes de ceux que portait Maurice de Bracy auraient pu concourir pour le prix de l’extravagance avec les plus bizarres, car elles étaient tournées et entortillées comme les cornes d’un bélier."
                            },
                            {
                                "example_id": "a35ec3da-7095-4090-b879-95278bdcad95",
                                "sense_id": "b721c9ae-6f2c-3381-889d-a5e326c9312e",
                                "text": "À Jules Verne, trop pondéré, je préférais les extravagances de Paul d’Ivoi."
                            },
                            {
                                "example_id": "43e7bff4-58ae-411a-87b3-54995d981146",
                                "sense_id": "b721c9ae-6f2c-3381-889d-a5e326c9312e",
                                "text": "Ils étaient arrivés à ce degré d’intimité où faire l’amour commence à ressembler à une extravagance."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "390337e4-5f48-47d1-b485-5cd8ff2a48f4",
                        "source_entry_id": "e939b978-da3d-3c3a-8cf1-4eb990be8ea6",
                        "target_lang_word": "extravagance",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "extravagance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "66b6180c-7438-357d-8ef0-e14b003c1c4b",
                                        "entry_id": "73ba55aa-e5c6-3a44-ab73-44778ec9de68",
                                        "glosses": [
                                            "Excessive or superfluous expenditure of money."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "eeb9725c-5485-3434-bbbb-7805ee22970d",
                                        "entry_id": "73ba55aa-e5c6-3a44-ab73-44778ec9de68",
                                        "glosses": [
                                            "Prodigality, as of anger, love, expression, imagination, or demands."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5056dfc9-91b6-4998-83e7-6592ac44d674",
                                                "sense_id": "eeb9725c-5485-3434-bbbb-7805ee22970d",
                                                "text": "The visions of romance were over. Catherine was completely awakened. Henry’s address, short as it had been, had more thoroughly opened her eyes to the extravagance of her late fancies than all their several disappointments had done."
                                            },
                                            {
                                                "example_id": "e099f61e-fcbd-453c-b3ef-d95820a56bba",
                                                "sense_id": "eeb9725c-5485-3434-bbbb-7805ee22970d",
                                                "text": "A great bargain also had been the excellent Axminster carpet which covered the floor; as, again, the arm-chair in which Bunting now sat forward, staring into the dull, small fire. In fact, that arm-chair had been an extravagance of Mrs. Bunting. She had wanted her husband to be comfortable after the day's work was done, and she had paid thirty-seven shillings for the chair."
                                            },
                                            {
                                                "example_id": "afbb4dbe-44e0-425b-b091-8194940c17ac",
                                                "sense_id": "eeb9725c-5485-3434-bbbb-7805ee22970d",
                                                "text": "At the same time he will need most carefully to avoid anything resembling extravagance or overstatement. While no socialist heorist has ever been known to discredit himself with his fellows even by the silliest of proposals, the old-fashioned liberal will damn himself by an impracticable suggestion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43f119d7-ef0f-3144-b895-bf31bbbaedae",
                                        "entry_id": "73ba55aa-e5c6-3a44-ab73-44778ec9de68",
                                        "glosses": [
                                            "Something extravagant; something done out of extravagance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0b272a4-3b47-4e9d-bed5-09ba69eb0765",
                                                "sense_id": "43f119d7-ef0f-3144-b895-bf31bbbaedae",
                                                "text": "That luxury car is an extravagance you can't afford."
                                            },
                                            {
                                                "example_id": "24120f39-2eab-4e66-8d1b-38a6bc366309",
                                                "sense_id": "43f119d7-ef0f-3144-b895-bf31bbbaedae",
                                                "text": "There were no limos or extravagances at this point, because we all wanted to make as much money as possible. We played it cheap. No huge catering bills, no wild parties, not even upgraded hotel rooms. Whenever we arrived at an airport Robin would be there to meet us in a rented SUV or big sedan, and we'd head to the gig on our own."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0f7f9bdc-4101-4ef1-a875-e493ee826883",
                        "source_entry_id": "e939b978-da3d-3c3a-8cf1-4eb990be8ea6",
