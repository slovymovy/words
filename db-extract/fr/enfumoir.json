                "senses": [
                    {
                        "sense_id": "f45e9be6-7c0c-3b04-bf96-30597a5ed1ca",
                        "entry_id": "061a5a32-0241-3bac-8d07-5e925074c50d",
                        "glosses": [
                            "Ustensile permettant de projeter un peu de fumée vers une ruche, la fumée ayant un effet calmant sur les abeilles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d698936-1ca6-4ae5-a636-2ca932d12971",
                                "sense_id": "f45e9be6-7c0c-3b04-bf96-30597a5ed1ca",
                                "text": "Avant de refermer l’enfumoir, ajoutez une poignée d’herbe verte pour refroidir la fumée, qui doit être non irritante pour les yeux."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f43bfce1-d05b-424d-adbd-4fdc5277cc2e",
                        "source_entry_id": "061a5a32-0241-3bac-8d07-5e925074c50d",
                        "source_sense_id": "f45e9be6-7c0c-3b04-bf96-30597a5ed1ca",
                        "target_lang_word": "bee smoker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bee smoker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a9c0b5b5-a1ae-3d74-b9ca-a31ceeb46ef7",
                                        "entry_id": "37c9252e-1031-3b52-b894-c253ba89dfaf",
                                        "glosses": [
                                            "A device that releases smoke intended to distract bees."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "930aa72f-2688-41b3-98e6-d9e8ec0f67ef",
                                                "sense_id": "a9c0b5b5-a1ae-3d74-b9ca-a31ceeb46ef7",
                                                "text": "Earlier this month police in Norfolk were called after five hives thought to contain around 60,000 bees and £600 worth of honey were taken. Other known raids this year in Britain have included one in Doncaster in April. Suspicions among beekeepers that the culprits come from their own ranks were underlined by the fact that a bee smoker was left at the scene by someone who presumably knew that it could be used to calm the insects before taking them."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ec99d625-c25b-4509-858f-16e4b6491b28",
                        "source_entry_id": "061a5a32-0241-3bac-8d07-5e925074c50d",
                        "source_sense_id": "f45e9be6-7c0c-3b04-bf96-30597a5ed1ca",
                        "target_lang_word": "smoker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "smoker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4bd9bcfb-b537-307b-b47d-772f2ebb01b3",
                                        "entry_id": "c7826b8f-ba7c-311a-989c-c0bea3a3939b",
                                        "glosses": [
                                            "A person who smokes tobacco habitually."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70f6919b-434d-4e16-85b6-8bdc187cc4b8",
                                                "sense_id": "4bd9bcfb-b537-307b-b47d-772f2ebb01b3",
                                                "text": "Even though I don't smoke, I'm not one of those fanatics you run into. In fact, I love watching cigarette smokers in their sad little sealed-off areas, sucking away, deep lines in their faces, precancerous lesions taking hold, the posture and body language of petty criminals. You know what you do with these people? Give 'em free cigarettes. Let 'em smoke. Offer them a light!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63152939-4b74-3cf4-a25f-c65ff6fac2f5",
                                        "entry_id": "c7826b8f-ba7c-311a-989c-c0bea3a3939b",
                                        "glosses": [
                                            "A smoking car on a train."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3cc39ef-3ab8-48fc-8e8b-173e3fa242b2",
                                                "sense_id": "63152939-4b74-3cf4-a25f-c65ff6fac2f5",
                                                "text": "We had all got into a first-class smoker, and he had already lit the short and charred old briar pipe which seemed to singe the end of his long, aggressive nose."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "768d9eec-b9a9-3823-bc3c-800f6d0dbf50",
                                        "entry_id": "c7826b8f-ba7c-311a-989c-c0bea3a3939b",
                                        "glosses": [
                                            "An informal social gathering for men only, at which smoking tobacco is allowed."
                                        ],
                                        "tags": [
                                            "dated",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a82d2157-0f59-43a0-84f6-75c8669c6bbd",
                                                "sense_id": "768d9eec-b9a9-3823-bc3c-800f6d0dbf50",
                                                "text": "A smoker at which prizes were distributed was held at the Hotel Victory […]"
                                            },
                                            {
                                                "example_id": "90d310a9-2876-4975-8466-b79d5a57e130",
                                                "sense_id": "768d9eec-b9a9-3823-bc3c-800f6d0dbf50",
                                                "text": "One of the most unique athletic programs given in Tacoma for a long time, and which should furnish rare fun for the spectators, is scheduled for the smoker given tonight by company A, Second infantry regiment, N. G. W., at the company drill hall, South Twelfth and A streets."
                                            },
                                            {
                                                "example_id": "d0cce819-24a8-4042-a7b7-36b99deca40b",
                                                "sense_id": "768d9eec-b9a9-3823-bc3c-800f6d0dbf50",
                                                "text": "A morning paper made brief mention of a smoker that was to be given on the following evening by the German minister."
                                            },
                                            {
                                                "example_id": "47cc0817-cbb4-41b6-8426-11f52151eb0c",
                                                "sense_id": "768d9eec-b9a9-3823-bc3c-800f6d0dbf50",
                                                "text": "Yes we're gonna have a wingding / A summer smoker underground"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8ee8a2f-ef60-3a91-a96b-2fff2954dc88",
                                        "entry_id": "c7826b8f-ba7c-311a-989c-c0bea3a3939b",
                                        "glosses": [
                                            "A social event featuring sketches, songs, etc., whether or not smoking is carried out."
                                        ],
                                        "tags": [
                                            "UK",
                                            "dated",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f05030a5-bc77-47d7-8219-f30aa2eb4740",
                                                "sense_id": "e8ee8a2f-ef60-3a91-a96b-2fff2954dc88",
                                                "text": "All grins and tuxes at some charity smoker in a city-centre hotel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9fcb6a09-001a-3e1d-b3cd-05c60eb36e9b",
                                        "entry_id": "c7826b8f-ba7c-311a-989c-c0bea3a3939b",
                                        "glosses": [
