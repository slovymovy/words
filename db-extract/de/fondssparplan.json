                "senses": [
                    {
                        "sense_id": "94399855-a8c3-3744-997c-a10b6d6c81ce",
                        "entry_id": "c812551e-ed8a-3729-a44b-8b8a821bc844",
                        "glosses": [
                            "Sparvertrag, in dessen Rahmen regelmäßig Zahlungen zum Erwerb von Anteilen eines oder mehrerer Investmentfonds verwendet werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2222f79-4ca3-426d-b5b7-ef04b07b96f5",
                                "sense_id": "94399855-a8c3-3744-997c-a10b6d6c81ce",
                                "text": "„Laut der Erste-Bank-Studie besitzen nur sechs Prozent der Frauen (17 Prozent der Männer) Einzelaktien, elf Prozent haben einen Fonds (Männer: 22 Prozent), und 14 Prozent der Frauen (21 Prozent der Männer) legen mit einem Fondssparplan ihr Geld an.“"
                            },
                            {
                                "example_id": "f5ddcbdc-4733-49e2-b9ee-35edecd80ba8",
                                "sense_id": "94399855-a8c3-3744-997c-a10b6d6c81ce",
                                "text": "„Wie lange also muss man einen Fondssparplan bestücken, damit am Ende wirklich die - immer wieder zitierte - gute Aktienrendite abfällt? Die Antwort ist: 30 Jahre sollten es schon sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
