            {
                "entry_id": "4f0ce0a4-68a4-3b2e-8ed0-a86f3fa3de8d",
                "word": "arak",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "224479e6-c85b-45f3-959b-7e5fd71b8440",
                        "entry_id": "4f0ce0a4-68a4-3b2e-8ed0-a86f3fa3de8d",
                        "tags": [
                            "plural"
                        ],
                        "form": "araks"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f15c48ef-e65b-3bb4-8664-7bbc81d8aaca",
                        "entry_id": "4f0ce0a4-68a4-3b2e-8ed0-a86f3fa3de8d",
                        "glosses": [
                            "A clear, unsweetened aniseed-flavoured alcoholic drink, produced and consumed primarily in the Levant."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "d32d0378-b3fd-4413-a1f1-f6e1af61c5e6",
                                "sense_id": "f15c48ef-e65b-3bb4-8664-7bbc81d8aaca",
                                "text": "A rite of the grape harvest in the Christian villages dotting the Lebanon mountain range[…] is the perfectly legal distillation of homemade arak. This smooth, cool, refreshing liquor, tasting of licorice with a soupçon of peppermint, remains the staple drink at Sunday lunch, an eat-till-you-drop extravaganza of small meze dishes."
                            },
                            {
                                "example_id": "a4be088e-8101-4d90-999a-a326fca9a778",
                                "sense_id": "f15c48ef-e65b-3bb4-8664-7bbc81d8aaca",
                                "text": "In Lebanon they have arak, in Turkey raki, and they even make something similar in Saudi Arabia. This is not so surprising as the Arabs were probably the first people to distil alcohol; alcohol is an Arabic word. “Arak” means “sweat” in Arabic, and describes the distillation process rather than what happens when you drink too much."
                            }
                        ]
                    },
                    {
                        "sense_id": "f4e9507f-bed7-3fbd-8c32-207982aeaab3",
                        "entry_id": "4f0ce0a4-68a4-3b2e-8ed0-a86f3fa3de8d",
                        "glosses": [
                            "Alternative spelling of arrack (an alcoholic drink distilled from coconut palm flowers or sugar cane)"
                        ],
                        "tags": [
                            "alt-of",
                            "alternative",
                            "uncountable",
                            "usually"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f6560216-6a96-41a5-8f84-5fdeae92e64d",
                        "source_entry_id": "4f0ce0a4-68a4-3b2e-8ed0-a86f3fa3de8d",
                        "source_sense_description": "a Middle Eastern aniseed-flavoured alcoholic drink",
                        "target_lang_word": "Anisschnaps",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anisschnaps",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8ca077f5-13f5-3a85-aba7-016f89bc1067",
                                        "entry_id": "ee34e7b3-68fa-33e3-bbeb-cec03c965afe",
                                        "glosses": [
                                            "Schnaps, hergestellt unter Verwendung von Anis"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8acb1aa-8c23-4868-9e91-83751044ed9b",
                                                "sense_id": "8ca077f5-13f5-3a85-aba7-016f89bc1067",
                                                "text": "Komm doch mal auf ein Gläschen Anisschnaps vorbei."
                                            },
                                            {
                                                "example_id": "f0d722ff-3b8f-40c1-af19-679fbc5e371c",
                                                "sense_id": "8ca077f5-13f5-3a85-aba7-016f89bc1067",
                                                "text": "„Diese leichte Konversation unterhielt uns bis zum Nachtisch, einer katalanischen Creme mit Zimt; dann tranken wir einen Anisschnaps.“"
                                            },
                                            {
                                                "example_id": "cccc7081-bd6d-41f7-9b18-a3075004230f",
                                                "sense_id": "8ca077f5-13f5-3a85-aba7-016f89bc1067",
                                                "text": "„Seine Geschichten beendete er gerne mit einer Runde Anisschnaps für alle.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3fbf99b0-53c9-4b56-a430-b6deb4d08250",
                        "source_entry_id": "4f0ce0a4-68a4-3b2e-8ed0-a86f3fa3de8d",
