                "senses": [
                    {
                        "sense_id": "26dfdc5e-3ac0-3572-bd2e-a6c4c856a5ee",
                        "entry_id": "e2a8c755-dea8-37ef-a138-f1e31209e03a",
                        "glosses": [
                            "beabsichtigte oder auch unbeabsichtigte Wirkung mit überraschender Auswirkung, die durch Ionisation auftritt; Molekülanregung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3dc91b56-be9d-44bb-9988-992c9b5c406b",
                                "sense_id": "26dfdc5e-3ac0-3572-bd2e-a6c4c856a5ee",
                                "text": "„Treffen Beta-Teilchen auf Materie, treten Ionisationseffekte, Bremsstrahlung, Anregung getroffener Atome und Streuung der Beta-Strahlung selber auf.“"
                            },
                            {
                                "example_id": "d9670c86-54c2-40d9-919b-d0d9536dbbdd",
                                "sense_id": "26dfdc5e-3ac0-3572-bd2e-a6c4c856a5ee",
                                "text": "„ Dabei zeigte sich schon einige Minuten nach Fertigstellung der Präparate ein stets wachsender Ionisationseffekt,der durch mehrere Monate anfangs schnell, später langsam anstieg; wurde das Bleipaket zuvor einer Erhitzung auf über 100° C aus gesetzt, so erfolgte der Anstieg der Ionisationswirkung bedeutend rascher.“"
                            },
                            {
                                "example_id": "6b6f71a0-dd5d-4aea-a14e-4f48be7e8704",
                                "sense_id": "26dfdc5e-3ac0-3572-bd2e-a6c4c856a5ee",
                                "text": "„Bei Flammenüberwachungsschaltungen der eingangs erwähnten Art, die den Ionisationseffekt der Flamme ausnutzen, wird meist eine gegenüber dem Bezugspotential das durch die Brennermasse gebildet ist, negative Spannungsversorgung benötigt.“"
                            },
                            {
                                "example_id": "9d46ba11-1def-4970-ae55-ecd347fce497",
                                "sense_id": "26dfdc5e-3ac0-3572-bd2e-a6c4c856a5ee",
                                "text": "„Die Ionen, die sich im Bereich hoher Feldstärke befinden werden stark beschleunigt und es finden somit weitere Ionisationseffekte statt.“"
                            },
                            {
                                "example_id": "a308dd22-e0d4-4361-8c77-c9f1cf46a538",
                                "sense_id": "26dfdc5e-3ac0-3572-bd2e-a6c4c856a5ee",
                                "text": "„Bei dem Ionisationseffekt findet eine Streuung des Teilchens mit der Ladung Z.e und der Masse m an einem Elektron mit der Ladung e und der Masse me des Mediums statt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
