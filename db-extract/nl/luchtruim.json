                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9f209d8-5549-43d9-ac72-62310648b5fd",
                                "sense_id": "53feb0fd-3bca-3efb-8c34-6f0fe6327673",
                                "text": "Het luchtruim boven grote delen van Europa werd vanwege een aswolk gesloten."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1f845051-b725-4f29-bb70-c44a729d0c06",
