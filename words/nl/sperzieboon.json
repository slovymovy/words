{
    "word_family": [
        "boon",
        "peulvrucht"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "389ce418-29d9-3cb3-bd27-5a25c998049a",
                    "sense_definition": "Een groene peulvrucht van de gewone boon die als groente wordt gegeten.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "groenten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik eet vanavond verse <w>sperziebonen</w> met aardappelen en een stukje vlees.",
                            "target_lang_translations": {
                                "en": "Tonight I am eating fresh <w>green beans</w> with potatoes and a piece of meat."
                            }
                        },
                        {
                            "text": "Je moet de uiteinden van de <w>sperzieboon</w> afhalen voordat je ze gaat koken.",
                            "target_lang_translations": {
                                "en": "You have to remove the ends of the <w>green bean</w> before you start cooking them."
                            }
                        }
                    ],
                    "synonyms": [
                        "slaboon",
                        "prinsessenboon",
                        "herenboon"
                    ],
                    "common_phrases": [
                        "verse sperziebonen",
                        "gekookte sperziebonen"
                    ],
                    "target_lang_definitions": {
                        "en": "A green legume of the common bean plant that is eaten as a vegetable."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "green bean",
                                "target_lang_sense_clarification": "the vegetable itself"
                            },
                            {
                                "target_lang_word": "string bean",
                                "target_lang_sense_clarification": "common name for the vegetable"
                            },
                            {
                                "target_lang_word": "French bean",
                                "target_lang_sense_clarification": "often used for the slender variety"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7b5a59f1-4abf-3bad-b2fd-9882615c4ca5",
                    "sense_definition": "De plantensoort Phaseolus vulgaris die deze specifieke peulvruchten voortbrengt.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "planten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In onze moestuin groeit de <w>sperzieboon</w> dit jaar erg snel door het warme weer.",
                            "target_lang_translations": {
                                "en": "In our vegetable garden, the <w>green bean plant</w> is growing very fast this year due to the warm weather."
                            }
                        },
                        {
                            "text": "De <w>sperzieboon</w> is een klimplant die ondersteuning nodig heeft van stokken.",
                            "target_lang_translations": {
                                "en": "The <w>green bean</w> is a climbing plant that needs support from poles."
                            }
                        }
                    ],
                    "synonyms": [
                        "slaboon"
                    ],
                    "common_phrases": [
                        "sperziebonen kweken"
                    ],
                    "target_lang_definitions": {
                        "en": "The plant species Phaseolus vulgaris that produces these specific legumes."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "green bean plant",
                                "target_lang_sense_clarification": "the botanical plant"
                            },
                            {
                                "target_lang_word": "common bean",
                                "target_lang_sense_clarification": "the species name"
                            }
                        ]
                    }
                }
            ]
        }
    ]
