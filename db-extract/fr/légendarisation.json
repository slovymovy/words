                        "glosses": [
                            "Action de légendariser, donner un caractère légendaire, transformer en légende."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42a05134-97ac-4919-bd69-201a5cdb1ea5",
                                "sense_id": "095e88ea-ec86-3fba-9538-fbfc20f8142c",
                                "text": "L'épopée a pour matière la légendarisation de l'histoire."
                            },
                            {
                                "example_id": "deae28ce-a08b-40d7-a28d-1a0f2342a5b7",
                                "sense_id": "095e88ea-ec86-3fba-9538-fbfc20f8142c",
                                "text": "Même ceux qui nous sont connus parce que très proches de nous dans le temps n'échappent pas au processus de légendarisation qui, souvent, commence avant leur mort."
                            },
                            {
                                "example_id": "6e9a31c5-182e-41ed-99a7-9ba8f3d2e51f",
                                "sense_id": "095e88ea-ec86-3fba-9538-fbfc20f8142c",
                                "text": "Dans le processus de légendarisation d’une rumeur intervient toujours la volonté d’un groupe d’acteurs sociaux attachés à sauver de l’oubli « leur » version de l’événement."
                            }
                        ]
                    }
