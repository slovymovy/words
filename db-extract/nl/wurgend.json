        "nl-extract.jsonl": [
            {
                "entry_id": "f92fe718-02d4-35a4-93f3-d6bfff643958",
                "word": "wurgend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "afd0a789-0440-35b0-98dd-2ca6e605ec5c",
                        "entry_id": "f92fe718-02d4-35a4-93f3-d6bfff643958",
                        "glosses": [
                            "van iets dat het zo erg of angstig is dat doorgaan onmogelijk is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4cf1d3f3-4463-4e9c-bdea-9e86faa3976d",
                                "sense_id": "afd0a789-0440-35b0-98dd-2ca6e605ec5c",
                                "text": "Coupleider kapitein Amadou Haya Sanago zag geen andere uitweg meer, nadat zijn staatsgreep had geleid tot de verovering van half Mali door Toearegrebellen en tot een wurgend economisch embargo van Ecowas. Toch blijft het land voorlopig verdeeld. Toeareg-rebellen maakten gebruik van de onrust van de staatsgreep om het hele noorden onder controle te krijgen."
                            },
                            {
                                "example_id": "dabb8c11-3297-49f0-9e54-709a367c2a48",
                                "sense_id": "afd0a789-0440-35b0-98dd-2ca6e605ec5c",
                                "text": "De huiselijke ellende en wurgende onzekerheid, die samenhangen met huisuitzettingen, is met geen pen te beschrijven."
                            },
                            {
                                "example_id": "0952a68b-c8aa-425a-8ac2-1f9eff85eb1f",
                                "sense_id": "afd0a789-0440-35b0-98dd-2ca6e605ec5c",
                                "text": "Stemmers kunnen zich voorstellen dat mensen meedoen aan de Postcodeloterij omdat ze bang zijn buiten de prijzen te vallen als de winnaars binnen hun postcodegebied vallen. „Ik doe mee omdat ik bang ben dat er eens een prijs valt op mijn postcode en ik geen lot heb. Het is wurgend.”"
                            }
                        ]
                    }
