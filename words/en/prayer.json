{
    "word_family": [
        "pray",
        "prayerful",
        "prayerfully",
        "prayerless"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "70950d14-28c0-3b06-853c-e5b61c8b274d",
                    "sense_definition": "A practice of communicating with one's God, or with some spiritual entity.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "spiritual_communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She found great comfort in silent <w>prayer</w> during the difficult times.",
                            "target_lang_translations": {
                                "ru": "Она находила большое утешение в тихой <w>молитве</w> в трудные времена.",
                                "zh": "在困难时期，她从静默的<w>祈祷</w>中获得了极大的慰藉。"
                            }
                        },
                        {
                            "text": "The community gathered in the hall for a moment of <w>prayer</w>.",
                            "target_lang_translations": {
                                "ru": "Община собралась в зале для краткой <w>молитвы</w>.",
                                "zh": "社区成员聚集在大厅里进行片刻的<w>祈祷</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "orison",
                        "devotion",
                        "communion"
                    ],
                    "common_phrases": [
                        "in prayer",
                        "answer a prayer",
                        "power of prayer",
                        "call to prayer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Практика общения с Богом или духовной сущностью",
                        "zh": "与神或某种精神实体进行交流的修行活动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "молитва",
                                "target_lang_sense_clarification": "действие"
                            },
                            {
                                "target_lang_word": "моление",
                                "target_lang_sense_clarification": "процесс"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "祈祷",
                                "target_lang_sense_clarification": "宗教仪式或个人修行"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3fc0af9d-eca8-3a6d-8a9a-13d198f3b3a9",
                    "sense_definition": "The specific words or methods used for praying.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "spiritual_communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Every night before bed, the child recites a short <w>prayer</w>.",
                            "target_lang_translations": {
                                "ru": "Каждую ночь перед сном ребенок читает короткую <w>молитву</w>.",
                                "zh": "每天晚上睡觉前，孩子都会诵读一段简短的<w>祷文</w>。"
                            }
                        },
                        {
                            "text": "The priest read a <w>prayer</w> from the ancient book.",
                            "target_lang_translations": {
                                "ru": "Священник прочитал <w>молитву</w> из древней книги.",
                                "zh": "牧师从那本古书中读了一段<w>祷文</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "orison",
                        "invocation",
                        "appeal"
                    ],
                    "common_phrases": [
                        "say a prayer",
                        "Lord's Prayer",
                        "morning prayer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкретные слова или методы, используемые для молитвы",
                        "zh": "用于祈祷的具体文字或方式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "молитва",
                                "target_lang_sense_clarification": "текст"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "祷文",
                                "target_lang_sense_clarification": "祈祷时诵读的文字"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b858c09a-7a07-313a-9ace-33a3c3667aa0",
                    "sense_definition": "One who prays.",
                    "learner_level": "B2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "agent_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The devout <w>prayer</w> remained on his knees in the chapel for hours.",
                            "target_lang_translations": {
                                "ru": "Набожный <w>молящийся</w> часами стоял на коленях в часовне.",
                                "zh": "那位虔诚的<w>祈祷者</w>在礼拜堂里跪了几个小时。"
                            }
                        },
                        {
                            "text": "As a faithful <w>prayer</w>, she visited the shrine every morning.",
                            "target_lang_translations": {
                                "ru": "Будучи верной <w>молящейся</w>, она посещала святыню каждое утро.",
                                "zh": "作为一名忠实的<w>祈祷者</w>，她每天早上都会去参拜神龛。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "agent noun derived from pray"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тот, кто молится",
                        "zh": "进行祈祷的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "молящийся",
                                "target_lang_sense_clarification": "человек"
                            },
                            {
                                "target_lang_word": "богомолец",
                                "target_lang_sense_clarification": "устар."
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "祈祷者",
                                "target_lang_sense_clarification": "指代进行祈祷的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "68cbd2be-4a1f-3cdd-9677-8f5577f32be9",
                    "sense_definition": "The remotest hope or chance.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "idiomatic_chance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Without a map, we do not have a <w>prayer</w> of finding the cabin.",
                            "target_lang_translations": {
                                "ru": "Без карты у нас нет ни <w>шанса</w> найти хижину.",
                                "zh": "没有地图，我们根本没有<w>机会</w>找到那个小屋。"
                            }
                        },
                        {
                            "text": "That old car hasn't got a <w>prayer</w> of starting in this freezing weather.",
                            "target_lang_translations": {
                                "ru": "У этой старой машины нет ни <w>шанса</w> завестись в такую морозную погоду.",
                                "zh": "在这种冰冻天气下，那辆旧车根本没有<w>希望</w>发动起来。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "not have a prayer",
                        "without a prayer"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used in negative contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Малейшая надежда или шанс",
                        "zh": "极小的希望或机会。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шанс",
                                "target_lang_sense_clarification": "возможность"
                            },
                            {
                                "target_lang_word": "надежда",
                                "target_lang_sense_clarification": "ожидание"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "机会",
                                "target_lang_sense_clarification": "可能性"
                            },
                            {
                                "target_lang_word": "希望",
                                "target_lang_sense_clarification": "成功的可能性"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3ef073cd-65f5-30d8-a313-f2ce6da2af0a",
                    "sense_definition": "A request; a petition.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "formal_request",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The judge listened carefully to the prisoner's <w>prayer</w> for leniency.",
                            "target_lang_translations": {
                                "ru": "Судья внимательно выслушал <w>мольбу</w> заключенного о снисхождении.",
                                "zh": "法官仔细听取了囚犯关于宽大处理的<w>恳求</w>。"
                            }
                        },
                        {
                            "text": "It is my earnest <w>prayer</w> that you will grant this simple request.",
                            "target_lang_translations": {
                                "ru": "Это моя искренняя <w>мольба</w> о том, чтобы вы выполнили эту простую просьбу.",
                                "zh": "我真诚地<w>恳求</w>您能答应这个简单的请求。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "formal or legal context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Просьба; ходатайство",
                        "zh": "一种请求或恳求。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мольба",
                                "target_lang_sense_clarification": "горячая просьба"
                            },
                            {
                                "target_lang_word": "прошение",
                                "target_lang_sense_clarification": "официальное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "恳求",
                                "target_lang_sense_clarification": "诚恳的请求"
                            },
                            {
                                "target_lang_word": "请愿",
                                "target_lang_sense_clarification": "正式的请求"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}