                            {
                                "example_id": "bcf69aa9-acf7-42af-8f04-ecba7a0916ee",
                                "sense_id": "8c0f1493-489c-33e2-a2ab-a7cf6be766d9",
                                "text": "In Tulsa staat ook een museum gewijd aan Woody Guthrie, de folkzanger door wie Dylan in zijn jonge jaren werd beïnvloed. Dylan noemde het een grote eer dat zijn archief nu in de zelfde stad terechtkomt."
                            },
                            {
                                "example_id": "2eb711f0-2ae1-4bb3-8568-32c4dc5e75cf",
                                "sense_id": "8c0f1493-489c-33e2-a2ab-a7cf6be766d9",
                                "text": "De Amerikaanse folkzanger Pete Seeger is jarenlang onderwerp van onderzoek geweest van de FBI. Seeger had zich aan het begin van de Tweede Wereldoorlog aangemeld voor het leger, maar tot zijn teleurstelling werd hij nooit ingezet op een verantwoordelijke post."
                            }
                        ]
