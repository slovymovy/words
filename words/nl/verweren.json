    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "836a8215-f5c4-3468-b772-69ec967bef71",
                    "sense_definition": "zich verdedigen tegen een aanval of beschuldiging",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "verdediging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>verweerde</w> zich kranig tegen de valse beschuldigingen van zijn collega.",
                            "target_lang_translations": {
                                "en": "He <w>defended</w> himself bravely against his colleague's false accusations."
                            }
                        },
                        {
                            "text": "Het is belangrijk om jezelf te <w>verweren</w> als iemand je onterecht aanvalt.",
                            "target_lang_translations": {
                                "en": "It is important to <w>defend</w> yourself if someone attacks you unfairly."
                            }
                        }
                    ],
                    "synonyms": [
                        "verdedigen"
                    ],
                    "common_phrases": [
                        "zich kranig verweren",
                        "zich heftig verweren"
                    ],
                    "target_lang_definitions": {
                        "en": "to defend oneself against an attack or accusation"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "defend oneself",
                                "target_lang_sense_clarification": "against an attack or accusation"
                            },
                            {
                                "target_lang_word": "fight back",
                                "target_lang_sense_clarification": "to resist an assault or charge"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c77f32e5-51ff-366f-aef7-ee8ac14855d8",
                    "sense_definition": "door invloed van het weer (zoals wind en regen) langzaam worden aangetast of afgebroken",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "erosie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De bovenste laag <w>verweert</w> langzamer dan de laag eronder en dat verklaart de grillige vormen van deze rotspartij.",
                            "target_lang_translations": {
                                "en": "The top layer <w>weathers</w> more slowly than the layer beneath it, which explains the jagged shapes of this rock formation."
                            }
                        },
                        {
                            "text": "Zachte steensoorten zullen sneller <w>verweren</w> door de constante regen en wind.",
                            "target_lang_translations": {
                                "en": "Soft types of stone will <w>weather</w> faster due to the constant rain and wind."
                            }
                        }
                    ],
                    "common_phrases": [
                        "door weer en wind verweren"
                    ],
                    "target_lang_definitions": {
                        "en": "to be slowly eroded or broken down by the influence of weather such as wind and rain"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "weather",
                                "target_lang_sense_clarification": "to wear away due to exposure to the elements"
                            },
                            {
                                "target_lang_word": "erode",
                                "target_lang_sense_clarification": "to gradually wear away"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
