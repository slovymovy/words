                ],
                "senses": [
                    {
                        "sense_id": "e7cf6d50-7a9d-3866-a533-2db09ec3572a",
                        "entry_id": "26746c43-c201-3716-88ca-c7d6a4c423ed",
                        "glosses": [
                            "Test zur Erfassung der Persönlichkeit, bei dem der Proband/Patient beschreiben muss, was er auf bestimmten Tintenklecksbildern sieht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d716a54-7cb7-4070-843c-324445002372",
                                "sense_id": "e7cf6d50-7a9d-3866-a533-2db09ec3572a",
                                "text": "Erst spielen wir Schach, dann machen wir den Rorschachtest."
                            },
                            {
                                "example_id": "569b5381-a8dd-41b6-8fdb-649898c17d9f",
                                "sense_id": "e7cf6d50-7a9d-3866-a533-2db09ec3572a",
                                "text": "„In der jüdischen Katastrophengeschichte des 20. Jahrhunderts wird der Text zum Rorschachtest der Interpretationen, und selbst Übersetzer neigen dazu, seine Schlusspassage nach ihrem jeweiligen Verständnis sprachlich auszuweiten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eb690236-b89e-4de7-8dd3-c4a054b93fa9",
                        "source_entry_id": "26746c43-c201-3716-88ca-c7d6a4c423ed",
                        "source_sense_id": "e7cf6d50-7a9d-3866-a533-2db09ec3572a",
                        "target_lang_word": "Rorschach test",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rorschach test",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "66ca44a7-ac20-3a28-b4bf-4a2fb5a23006",
                                        "entry_id": "f90d1302-2f2a-37f4-9619-c1af5e8ce6b2",
                                        "glosses": [
                                            "A method of psychological evaluation that uses a person's interpretations of inkblots or similar images to discover information concerning his or her personality, emotional functioning, or unconscious mind."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa838f3d-ac22-4724-8c60-e9d26940fa03",
                                                "sense_id": "66ca44a7-ac20-3a28-b4bf-4a2fb5a23006",
                                                "text": "Psychologists have dozens of projective methods to choose from beyond the Rorschach Test, the TAT and figure drawings."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0638784d-280a-3d4d-ab10-e84c2792ef8f",
                                        "entry_id": "f90d1302-2f2a-37f4-9619-c1af5e8ce6b2",
                                        "glosses": [
                                            "Any test of an individual's perception of phenomena."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bce7bd9b-de62-44b4-93f2-4174f8038a55",
                                                "sense_id": "0638784d-280a-3d4d-ab10-e84c2792ef8f",
                                                "text": "She demurely took out a piece of paper with an ink blot on it , a Rorschach test . ... Poe said he had been saved by Desmond FitzGerald , the patron saint of knuckledraggers , who sent him away from headquarters to keep him from getting ..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e04d3fe8-94b2-3798-bdcf-cec5dda39900",
                                        "entry_id": "f90d1302-2f2a-37f4-9619-c1af5e8ce6b2",
                                        "glosses": [
                                            "Something which reveals the intent of the person using it rather than fulfilling its designed purpose."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5a59b3a-5e7c-4124-84c3-561f3f10376b",
                                                "sense_id": "e04d3fe8-94b2-3798-bdcf-cec5dda39900",
                                                "text": "Because Irvine asserts that the earlier case law interpreting section 2280 was incorporated into Probate Code section 15401, but offers inconsistent interpretations of the law, it has become a Rorschach test for the parties."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "65fe712c-d021-44b5-aaf2-de391c4783f7",
                        "source_entry_id": "26746c43-c201-3716-88ca-c7d6a4c423ed",
                        "source_sense_id": "e7cf6d50-7a9d-3866-a533-2db09ec3572a",
                        "target_lang_word": "test de Rorschach",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "test de Rorschach",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4d27935a-35f5-3193-90d7-ee4ae0c15371",
                                        "entry_id": "26477a6a-8576-3521-b7a2-2d06244e59d9",
                                        "glosses": [
                                            "Outil d’évaluation psychologique qui consiste à présenter des dessins symétriques abstraits, ressemblant à des taches, au patient qui les interprète librement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3584cc55-3aa3-4ae6-a8df-d1ae0caf3a4c",
                                                "sense_id": "4d27935a-35f5-3193-90d7-ee4ae0c15371",
                                                "text": "Ce phénomène agit comme la tache d’encre d’un test de Rorschach : il irrite, inquiète ou fait rire, suivant les dispositions de chacun(e)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
