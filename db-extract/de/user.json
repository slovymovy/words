                                "target_senses": [
                                    {
                                        "sense_id": "75bbf3de-7697-32ec-ab25-21d73bf7735a",
                                        "entry_id": "5b2db9e1-df04-3a65-ac83-012897ce6cf2",
                                        "glosses": [
                                            "One who uses or makes use of something, a consumer or client or an express or implied licensee (free user) or a trespasser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "111d802f-80c9-4e28-ad9b-3f375e1aa0d9",
                                                "sense_id": "75bbf3de-7697-32ec-ab25-21d73bf7735a",
                                                "text": "[Rural solar plant] schemes are of little help to industry or other heavy users of electricity. Nor is solar power yet as cheap as the grid. For all that, the rapid arrival of electric light to Indian villages is long overdue. When the national grid suffers its next huge outage, as it did in July 2012 when hundreds of millions were left in the dark, look for specks of light in the villages."
                                            },
                                            {
                                                "example_id": "67d7a4fa-5595-45ec-9846-3eef9a01e0ca",
                                                "sense_id": "75bbf3de-7697-32ec-ab25-21d73bf7735a",
                                                "text": "2019, The Highway Code (United Kingdom) Road Users Requiring Extra Care\nThe most vulnerable road users are pedestrians, cyclists, motorcyclists and horse riders. It is particularly important to be aware of children, older and disabled people, and learner and inexperienced drivers and riders. https://www.gov.uk/guidance/the-highway-code/road-users-requiring-extra-care-204-to-225"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c30f307-a753-373b-9489-ee8380e24a1d",
                                        "entry_id": "5b2db9e1-df04-3a65-ac83-012897ce6cf2",
                                        "glosses": [
                                            "A person who uses drugs, especially illegal drugs."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bb8516e5-a77e-323d-9511-9e503bbac034",
                                        "entry_id": "5b2db9e1-df04-3a65-ac83-012897ce6cf2",
                                        "glosses": [
                                            "A person who uses a computer or a computing network, especially a person who has received a user account."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b9b860c6-fe59-37d6-b00c-2f20a6c5bcde",
