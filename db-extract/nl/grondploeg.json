                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76d1e947-cc58-4813-9504-8b4ad1fe4783",
                                "sense_id": "eb31659b-83f8-3a14-af02-30f108b9e11c",
                                "text": "De ballonvaarders hadden woensdagochtend nog radiocontact met hun grondploeg, maar na 9.00 uur kwamen er geen meldingen binnen. Op dat moment waren er hevige buien in het gebied waar ze waren."
                            },
                            {
                                "example_id": "0f97eabb-25f4-48e9-8714-fdcfec815428",
                                "sense_id": "eb31659b-83f8-3a14-af02-30f108b9e11c",
                                "text": "De Enschedese zegt haar 'goede werk’ voort te zetten. “De gemeente zou veel meer moeten doen aan de aanpak van die rupsen. Er zou een grondploeg moeten komen. Zolang die er niet is, doe ik het op mijn manier. Want uitroeien is de enige optie. Anders is de populatie volgend jaar verdriedubbeld, daar moeten we toch niet aan denken?”"
                            }
                        ]
                    }
