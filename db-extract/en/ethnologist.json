                    {
                        "sense_id": "01ad9c0e-36a0-3be4-9ddf-852df93c2f62",
                        "entry_id": "cf175265-f80c-372c-8275-82b3c5952fb2",
                        "glosses": [
                            "One who practices ethnology."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93a28086-004b-40ea-a302-91356a61ad12",
                                "sense_id": "01ad9c0e-36a0-3be4-9ddf-852df93c2f62",
                                "text": "The learned modern Ethnologists, however, will generally have none of this latter idea. As a rule they delight in representing early peoples as totally destitute of common sense (which is supposed to be a monopoly of us moderns!); and if the Sabbath-arrangement has had any value or use they insist on ascribing this to pure accident, and not to the application of any sane argument or reason."
                            }
                        ]
                    }
