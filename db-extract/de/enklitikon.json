                                "target_senses": [
                                    {
                                        "sense_id": "4db1ddf6-82b6-366f-b3d2-e22440318b39",
                                        "entry_id": "75c1c702-8329-3531-b5f7-c8b17cc40b7f",
                                        "glosses": [
                                            "A clitic that joins with the preceding word phonetically, graphically, or both."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31500b4a-03d6-496b-9ba0-54ac8564784c",
                                                "sense_id": "4db1ddf6-82b6-366f-b3d2-e22440318b39",
                                                "text": "The English possessive 's is an enclitic."
                                            }
                                        ]
                                    }
                                ]
                            },
