                "senses": [
                    {
                        "sense_id": "2d4d9cea-df24-3356-ab86-886c69b2451a",
                        "entry_id": "4d34eb0a-0bf8-3d7c-9c66-d0c8bc77069c",
                        "glosses": [
                            "hauptsächlicher Ursprung eines fließenden Gewässers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9166d976-cfc3-4884-a75b-26f13b52a30b",
                                "sense_id": "2d4d9cea-df24-3356-ab86-886c69b2451a",
                                "text": "„Dreißig Jahre geben Forscher dem Rhein, wie wir ihn heute kennen, noch. Bis dann sollen alle Alpengletscher geschmolzen und die Hauptquelle des Rheins versiegt sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "be1ca147-1989-3a43-9309-57b9c281f29b",
                        "entry_id": "4d34eb0a-0bf8-3d7c-9c66-d0c8bc77069c",
                        "glosses": [
                            "hauptsächlicher Ursprung von etwas Bestimmten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39a7d65d-48ac-4cb2-a00b-641ba2e79cd5",
                                "sense_id": "be1ca147-1989-3a43-9309-57b9c281f29b",
                                "text": "„Diese Liebhaberei wuchs mit mir heran, und noch im Mannesalter war sie mir eine Hauptquelle meiner Freuden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "5673df35-c099-3efc-8227-8729bc3c4958",
                        "entry_id": "4d34eb0a-0bf8-3d7c-9c66-d0c8bc77069c",
                        "glosses": [
                            "wissenschaftlich hauptsächlich auswertbares Primärmaterial"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "c72a923a-886b-3769-9d77-ee068917834c",
                        "entry_id": "4d34eb0a-0bf8-3d7c-9c66-d0c8bc77069c",
                        "glosses": [
                            "zentrale Person, die über direkte Informationen verfügt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05cff987-bb23-40f6-981b-1b8a43f32457",
                                "sense_id": "c72a923a-886b-3769-9d77-ee068917834c",
                                "text": "„Der unter Druck stehende Premier Tony Blair verlangte schließlich am vorigen Mittwoch, die BBC müsse erklären, ob Kelly die Quelle sei. Am Donnerstag nahm sich der Wissenschaftler das Leben. Nach seinem Tod behauptete die BBC dann am Sonntag, Kelly sei die Hauptquelle des Senders gewesen.“"
                            }
                        ],
                        "sense_index_json": "\"4\""
                    }
