                "translations": [
                    {
                        "translation_id": "effd57a0-3f06-4289-8ed3-d358016681aa",
                        "source_entry_id": "59838e50-687b-31fd-a02d-6190f2cf9e3a",
                        "source_sense_id": "5dff98a9-65fa-3ae3-a90e-f45cc690823c",
                        "target_lang_word": "Waffenhändler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Waffenhändler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9e96e43d-a7ba-3db4-bd1d-ec3aeccadd1a",
                                        "entry_id": "4551ce91-159e-3578-aa05-59e9f71c4c50",
                                        "glosses": [
                                            "jemand, der professionell Waffen kauft und verkauft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2de42e71-99dd-4aa7-af0f-b1cdb0828ea7",
                                                "sense_id": "9e96e43d-a7ba-3db4-bd1d-ec3aeccadd1a",
                                                "text": "Waffenhändler haben keinen guten Ruf."
                                            },
                                            {
                                                "example_id": "57a1c74e-1e56-4bd3-82f8-6aa03c803f3f",
                                                "sense_id": "9e96e43d-a7ba-3db4-bd1d-ec3aeccadd1a",
                                                "text": "„Ein begabter Programmierer, der sich über die Jahre zu einem brutalen Drogen- und Waffenhändler entwickelt.“"
                                            },
                                            {
                                                "example_id": "7d006d18-a56a-4711-9093-3c4ef5b5efaa",
                                                "sense_id": "9e96e43d-a7ba-3db4-bd1d-ec3aeccadd1a",
                                                "text": "„In Somalia herrscht Anarchie, und das Land steht nur bei Waffenhändlern auf der Reiseroute.\""
                                            },
                                            {
                                                "example_id": "20fa9e16-1471-4b29-86f1-82b5746e5909",
                                                "sense_id": "9e96e43d-a7ba-3db4-bd1d-ec3aeccadd1a",
                                                "text": "„Nach dem Mittagessen ging ich in den Laden eines Waffenhändlers und kaufte Pistolen, die ich meinem Bruder schenken wollte, denn ich hatte mich bereits entschlossen, von Spa gleich nach Paris zu fahren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d11d1f45-ef29-4474-8ab4-a317c176cc36",
                        "source_entry_id": "59838e50-687b-31fd-a02d-6190f2cf9e3a",
                        "source_sense_id": "5dff98a9-65fa-3ae3-a90e-f45cc690823c",
                        "target_lang_word": "arms dealer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arms dealer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "edd749b9-c3ab-35a7-a1ae-644194cc5207",
                                        "entry_id": "ee2bd2a1-86b9-335b-ab86-481639800bd6",
                                        "glosses": [
                                            "A person involved in the distribution and sale of weapons, especially when it also involves smuggling."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c5c1007a-5f9f-328c-b7c4-a778c3968a4b",
                                        "entry_id": "ee2bd2a1-86b9-335b-ab86-481639800bd6",
                                        "glosses": [
                                            "A media company that licenses its works to various other companies rather than distributing them on its own."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a07d0306-a508-4d8b-94f7-446ce67bd3a8",
                                                "sense_id": "c5c1007a-5f9f-328c-b7c4-a778c3968a4b",
                                                "text": "There’s “tremendous upside,” he says, for an unaffiliated studio, as Disney and others rein in content production in-house. “That’s going to create real opportunities for companies like Sony and Paramount and others to be an arms dealer of content to anyone in the world.”"
                                            },
                                            {
                                                "example_id": "91dc0312-12bc-4357-8e28-c9e39135b9f7",
                                                "sense_id": "c5c1007a-5f9f-328c-b7c4-a778c3968a4b",
                                                "text": "Hence, Viacom’s so-called “arms dealer” strategy, which paid off when it sold domestic rights to Comedy Central’s South Park to WarnerMedia’s HBO Max on Oct. 29 in a deal worth up to $500 million."
                                            },
                                            {
                                                "example_id": "ba8d8e91-a6c2-4601-8062-67a5680dac21",
                                                "sense_id": "c5c1007a-5f9f-328c-b7c4-a778c3968a4b",
                                                "text": "Tom Rothman, Sony Pictures motion picture group chairman, has said many times, both on the record and in the private confines of Louis B. Mayer’s old office on the Sony lot, that he is an arms dealer in the arms race."
                                            },
                                            {
                                                "example_id": "fa79945b-aad7-41bd-9d59-04af15d93d53",
                                                "sense_id": "c5c1007a-5f9f-328c-b7c4-a778c3968a4b",
                                                "text": "Unlike Paramount which has been saddled with debt from launching streaming service Paramount+, Sony remains an arms dealer, and financially nimble studio."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
