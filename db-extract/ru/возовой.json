                "senses": [
                    {
                        "sense_id": "f4241ca9-bc45-3439-87bb-cc7f45d448c2",
                        "entry_id": "5a3f859e-1bc9-3df6-8941-6c42393388f2",
                        "glosses": [
                            "устар. связанный с перевозкой грузов на возах; доставляемый возом"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58b9e038-3d2a-47a2-9f8c-fac29d1a3131",
                                "sense_id": "f4241ca9-bc45-3439-87bb-cc7f45d448c2",
                                "text": "В это время на улице послышался сильный скрип возовой телеги."
                            }
                        ]
                    },
                    {
                        "sense_id": "73590e74-29b6-3332-99d8-2daa3ad2b9f7",
                        "entry_id": "5a3f859e-1bc9-3df6-8941-6c42393388f2",
                        "glosses": [
                            "употребляемый для возки"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa91bdcc-672c-42ab-a349-d461b17790b1",
                                "sense_id": "73590e74-29b6-3332-99d8-2daa3ad2b9f7",
                                "text": "Кибитка между тем быстро катилась, однообразно и мерно постукивая передком об уступы, выбитые копытами возовых лошадей."
                            }
                        ]
                    },
