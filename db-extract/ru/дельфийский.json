                    {
                        "translation_id": "cd81f154-ce64-48fc-848d-9445d4c79822",
                        "source_entry_id": "1ffaffda-3039-30aa-a059-bfc998b2b6cb",
                        "source_sense_id": "41654df1-3e35-3772-845b-90abab799b27",
                        "target_lang_word": "delphique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "delphique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2a382fc6-ae11-3f4c-8c32-46299405f64b",
                                        "entry_id": "a3adbacc-2650-3863-9d78-7227ac08e7d6",
                                        "glosses": [
                                            "Relatif à Delphes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0fefcd4a-8eb7-411b-b2c6-13b3ef0f599c",
                                                "sense_id": "2a382fc6-ae11-3f4c-8c32-46299405f64b",
                                                "text": "La sibylle delphique : La sibylle qui rendait ses oracles à Delphes."
                                            },
                                            {
                                                "example_id": "824fb475-e22e-461e-92ee-31eb659746fa",
                                                "sense_id": "2a382fc6-ae11-3f4c-8c32-46299405f64b",
                                                "text": "Le stade pythique ou delphique de 1000 pieds delphiques était de même valeur que le stade olympique."
                                            },
                                            {
                                                "example_id": "88e628c0-5466-40bd-8677-1682ed5bfdc5",
                                                "sense_id": "2a382fc6-ae11-3f4c-8c32-46299405f64b",
                                                "text": "— Monsieur Le Ménil, si, l’année prochaine, un dauphin vient encore nager autour de votre bateau, je vous prie, jouez pour lui, sur la flûte, l’hymne à Apollon delphique."
                                            },
                                            {
                                                "example_id": "b8730623-3e3e-46c8-a331-c2b2db5a90ad",
                                                "sense_id": "2a382fc6-ae11-3f4c-8c32-46299405f64b",
                                                "text": "Bien qu’il fasse preuve, des fois, de mansuétudes assez mal explicables, sa parole est pour moi oracle delphique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
