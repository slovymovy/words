                "senses": [
                    {
                        "sense_id": "0b4b4339-db48-3df9-93a8-72480f7f6955",
                        "entry_id": "7e337517-8478-3d57-aa49-0e1ecb398cdf",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ded11faf-29b3-454a-b214-b8c97208d7f9",
                                "sense_id": "0b4b4339-db48-3df9-93a8-72480f7f6955",
                                "text": "Maisterls kamen, sahen und siegten."
                            },
                            {
                                "example_id": "b8dae404-7ac9-4404-8fd6-926a2217dc06",
                                "sense_id": "0b4b4339-db48-3df9-93a8-72480f7f6955",
                                "text": "Frau Maisterl ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "989c9355-33d5-48a0-bcc7-b4cf7630b1b1",
                                "sense_id": "0b4b4339-db48-3df9-93a8-72480f7f6955",
                                "text": "Herr Maisterl wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "e7b42a58-5cd5-4aa0-88c4-ff8d2781eadd",
                                "sense_id": "0b4b4339-db48-3df9-93a8-72480f7f6955",
                                "text": "Die Maisterls fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "a8d09f20-48d2-415a-91f1-6fdc8db69b70",
                                "sense_id": "0b4b4339-db48-3df9-93a8-72480f7f6955",
                                "text": "Der Maisterl trägt nie die Schals, die die Maisterl ihm strickt."
                            },
                            {
                                "example_id": "e979fb5c-62c1-44c0-99be-b78271fd23c7",
                                "sense_id": "0b4b4339-db48-3df9-93a8-72480f7f6955",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Maisterl kommt, geht der Herr Maisterl.“"
                            },
                            {
                                "example_id": "a48c45f1-67e4-4648-8518-f447b3b62e35",
                                "sense_id": "0b4b4339-db48-3df9-93a8-72480f7f6955",
                                "text": "Maisterl kommt und geht."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
