                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "607f5f24-f696-45c9-b5a4-fdf61c2494ab",
                                                "sense_id": "5f24400c-8748-39e2-8d29-03fe8e47bdc4",
