                    "sense_id": "0d336a9f-2abd-3dec-9dbb-9ab16b39bdc8",
                    "sense_definition": "Met veel kennis, inzicht en levenservaring; verstandig.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "wisdom",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Een <w>wijs</w> persoon denkt goed na voordat hij een beslissing neemt.",
                            "target_lang_translations": {
                                "en": "A <w>wise</w> person thinks carefully before making a decision.",
                                "ru": "<w>Мудрый</w> человек хорошо думает, прежде чем принять решение.",
                                "fr": "Une personne <w>sage</w> réfléchit bien avant de prendre une décision.",
                                "zh": "一个<w>明智的</w>人在做决定前会深思熟虑。"
                            }
                        },
                        {
                            "text": "Met de jaren werd mijn grootvader steeds <w>wijzer</w> en milder.",
                            "target_lang_translations": {
                                "en": "Over the years, my grandfather became <w>wiser</w> and milder.",
                                "ru": "С годами мой дедушка становился всё <w>мудрее</w> и мягче.",
                                "fr": "Avec les années, mon grand-père devenait de plus en plus <w>sage</w> et doux.",
                                "zh": "随着岁月的流逝，我的祖父变得越来越<w>睿智</w>且温和。"
                            }
                        }
                    ],
                    "antonyms": [
                        "onwijs"
                    ],
                    "common_phrases": [
                        "niet goed wijs",
                        "wijs worden uit",
                        "een wijs man"
                    ],
                    "target_lang_definitions": {
