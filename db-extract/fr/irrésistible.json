        "fr-extract.jsonl": [
            {
                "entry_id": "b2b1c996-8508-3ef4-b43c-3bb98ed52255",
                "word": "irrésistible",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "85a3488d-9ead-43c6-bec2-11cda7ddc300",
                        "entry_id": "b2b1c996-8508-3ef4-b43c-3bb98ed52255",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "irrésistibles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7bee5615-945c-3c07-a558-739798f5b51f",
                        "entry_id": "b2b1c996-8508-3ef4-b43c-3bb98ed52255",
                        "glosses": [
                            "À quoi l’on ne peut résister."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aafe4460-8954-4598-b56e-628727a977f2",
                                "sense_id": "7bee5615-945c-3c07-a558-739798f5b51f",
                                "text": "Toi et moi, nous ne sommes que les instruments aveugles d’une fatalité irrésistible qui nous entraîne comme deux vaisseaux poussés l’un vers l’autre par la tempête, qui se heurtent, se brisent et périssent."
                            },
                            {
                                "example_id": "2b6b8ab8-d1d3-4410-b5e0-d4a52637adfb",
                                "sense_id": "7bee5615-945c-3c07-a558-739798f5b51f",
                                "text": "Si l'on parle, le moindre mot possède une irrésistible puissance."
                            },
                            {
                                "example_id": "34edd340-6ea9-4634-89f5-0df779047b5a",
                                "sense_id": "7bee5615-945c-3c07-a558-739798f5b51f",
                                "text": "Or savez-vous quels sont ses deux instincts naturels, irrésistibles dans l'ordre psychique ? c'est l'amour et la liberté. Ces deux instincts naturels se sont socialement combattus jusqu'à présent ; il a fallu que l'homme immolât ou plutôt subordonnât l'un à l'autre."
                            },
                            {
                                "example_id": "22b20018-8556-4736-b810-c35f529ca58f",
                                "sense_id": "7bee5615-945c-3c07-a558-739798f5b51f",
                                "text": "L'avenir est à ceux qui savent le prédire. Se réformer, c'est se conformer à l'évolution irrésistible et lente des sociétés en marche vers le but inconnu."
                            },
                            {
                                "example_id": "3587a078-98d6-4f26-ad3b-6dba564137ac",
                                "sense_id": "7bee5615-945c-3c07-a558-739798f5b51f",
                                "text": "C’était un chaud lapin, disait-on au village, où il passait pour user envers les femmes d’arguments irrésistibles."
                            },
                            {
                                "example_id": "b2ab30bb-dd73-432d-8dff-56784c3bfec6",
                                "sense_id": "7bee5615-945c-3c07-a558-739798f5b51f",
                                "text": "Henri Fagerolle, jeté brusquement dans une sorte de tourbillon irrésistible, avait entièrement perdu pied. Il se laissait glisser, ballotter, secouer dans les remous d'une existence qui ne lui accordait aucun répit."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ec8f9f9b-f7e6-4c4c-b26b-b9a2f57984f6",
                        "source_entry_id": "b2b1c996-8508-3ef4-b43c-3bb98ed52255",
                        "source_sense_id": "7bee5615-945c-3c07-a558-739798f5b51f",
                        "source_sense_description": "À quoi l’on ne peut résister",
                        "target_lang_word": "unwiderstehlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unwiderstehlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8312a323-5eb1-3978-b9a5-fea00734ce0b",
                                        "entry_id": "b5a39ed9-c895-315e-a2aa-e32a3a45b6ce",
                                        "glosses": [
                                            "so stark, dass sich jemand nicht dagegen wehren kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ebb8eb2-6e36-44da-8597-6ca95ab3ebed",
                                                "sense_id": "8312a323-5eb1-3978-b9a5-fea00734ce0b",
                                                "text": "Ihre Schönheit ist unwiderstehlich."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e9bf8d92-28fa-4ca8-9d9c-1271d0cd9a32",
                        "source_entry_id": "b2b1c996-8508-3ef4-b43c-3bb98ed52255",
                        "source_sense_id": "7bee5615-945c-3c07-a558-739798f5b51f",
                        "source_sense_description": "À quoi l’on ne peut résister",
                        "target_lang_word": "irresistible",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "irresistible",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2e5c2000-7069-3dae-8963-b67142e99ea4",
                                        "entry_id": "ebccb7e4-0c28-3866-a1a4-14ce41b9f99c",
                                        "glosses": [
                                            "Impossible to resist."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f5de83d-f997-4ca3-afbe-dd45e9683841",
                                                "sense_id": "2e5c2000-7069-3dae-8963-b67142e99ea4",
                                                "text": "Where the breakdown of traditional authority set the poor of the earth on the march, where they left the obscurity of their misfortunes and streamed upon the market-place, their furor seemed as irresistible as the motion of the stars, a torrent rushing forward with elemental force and engulfing a whole world."
                                            },
                                            {
                                                "example_id": "f0a0f413-81c4-491c-aaad-f8e11757c1b4",
                                                "sense_id": "2e5c2000-7069-3dae-8963-b67142e99ea4",
                                                "text": "Though his account of written communication over the past 5,000 years necessarily has a powerful forward momentum, his diversions down the fascinating byways of the subject are irresistible ..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "821eaecf-e006-3021-96f3-9b0c7c5aaaed",
                                        "entry_id": "ebccb7e4-0c28-3866-a1a4-14ce41b9f99c",
                                        "glosses": [
                                            "Compellingly attractive."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "95f6c1ae-72b9-4e79-bc46-db7e22f70931",
                        "source_entry_id": "b2b1c996-8508-3ef4-b43c-3bb98ed52255",
                        "source_sense_id": "7bee5615-945c-3c07-a558-739798f5b51f",
                        "source_sense_description": "À quoi l’on ne peut résister",
                        "target_lang_word": "irresistible",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "irresistible",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "31b5f8c1-5583-3fb9-8455-43898ac98961",
                                        "entry_id": "57907e53-0e27-3572-b53e-d8e5f2b7cb9e",
                                        "glosses": [
                                            "Que no se puede resistir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eda263ec-7921-42a7-8a17-af6d839e2d9b",
                                                "sense_id": "31b5f8c1-5583-3fb9-8455-43898ac98961",
                                                "text": "«El combate tenía sobre todos una atracción irresistible, y nos llamaba como llama el abismo al que le mira desde el vértice de elevada cima»."
                                            },
                                            {
                                                "example_id": "1fedee76-f417-48f9-9830-79b4d9cdc1a1",
                                                "sense_id": "31b5f8c1-5583-3fb9-8455-43898ac98961",
                                                "text": "«Sin embargo, un impulso irresistible me hacía continuar el camino, deteniéndome solo un instante para saludar a la cruz que vi delante de la puerta; pero esta se hallaba cerrada, y nadie parecía alrededor; fuertes eran mis deseos de llamar; mas ¿cómo osar llamar en la morada de los muertos?…»."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "29ce1198-86db-363a-a037-1cb320db78b3",
                                        "entry_id": "57907e53-0e27-3572-b53e-d8e5f2b7cb9e",
                                        "glosses": [
                                            "Guapo, encantador, simpático."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb9a3ff8-c37b-4115-bcbc-e76b78c3d5ef",
                                                "sense_id": "29ce1198-86db-363a-a037-1cb320db78b3",
                                                "text": "«—Ahora que te has lavado el cuerpo con agua corriente, y te has cepillado los huesos, estás irresistible»."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
