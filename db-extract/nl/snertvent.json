                                            {
                                                "example_id": "4fb6582a-bfa0-49ec-a8bc-06504dbff5c7",
                                                "sense_id": "ee939c0b-471d-3f3a-bd41-8e11d68ef5e2",
                                                "text": "A bastard orange gel produces predominantly orange light with undertones of blue."
