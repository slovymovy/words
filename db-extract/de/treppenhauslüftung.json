                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20c21a65-c05c-448f-ba65-7fbdf76bd7f1",
                                "sense_id": "e96a17c8-8c70-33f5-a883-3bce30726860",
                                "text": "„Weiterhin werden Einsatzgrenzen und Kosten der Treppenhauslüftung untersucht.“"
                            },
                            {
                                "example_id": "db482d07-c4a2-48d3-a969-7ea34db8dfc8",
                                "sense_id": "e96a17c8-8c70-33f5-a883-3bce30726860",
                                "text": "„Dazu zählen zum Beispiel Ruhestörung, Tierhaltung, Abstellen von Kinderwagen und Fahrrädern im Hausflur und die Treppenhauslüftung.“"
                            },
                            {
                                "example_id": "c9117f44-76e1-422b-836d-75d994c160eb",
                                "sense_id": "e96a17c8-8c70-33f5-a883-3bce30726860",
                                "text": "„Die Beschläge an den Holzfenstern, die Treppenhauslüftung sowie die Oberlichtfenster- und -öffner in den Küchen stammen zum großen Teil von der Firma R. Blume, Berlin.“"
                            },
                            {
                                "example_id": "ffbce4c8-ac87-4ada-98d3-75926a400d60",
                                "sense_id": "e96a17c8-8c70-33f5-a883-3bce30726860",
                                "text": "„Welche technischen Lösungen der Treppenhauslüftung sind vorstellbar und auf dem Markt verfügbar? “"
                            }
                        ],
