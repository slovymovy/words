                                        "sense_id": "ceff11e5-2b5e-3849-84c1-4b7fdd546784",
                                        "entry_id": "032f28ed-a72a-32e7-8ee9-629211faba17",
                                        "glosses": [
                                            "Pâte surtout utilisée pour réaliser des tartes ou quiches."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e3c6005-279a-483a-b294-5da1e2e030d3",
                                                "sense_id": "ceff11e5-2b5e-3849-84c1-4b7fdd546784",
                                                "text": "Faire une pâte brisée avec 1½ tasse de farine, 3 cuillerées à table de beurre, 3 cuillerées à table de saindoux, 1 cuillerée à thé de poudre a pâte, 1 pincée de sel, eau froide."
                                            },
                                            {
                                                "example_id": "16c62971-7985-4e1e-bef0-f6952bf6e5a7",
                                                "sense_id": "ceff11e5-2b5e-3849-84c1-4b7fdd546784",
                                                "text": "Découvrez des fonds de tarte incroyables de légèreté et de saveur qui vous feront oublier les pâtes brisées ou feuilletées."
                                            }
                                        ]
                                    }
                                ]
