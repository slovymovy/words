                        "examples": [
                            {
                                "example_id": "8edcf3b4-5b16-417d-b2f0-d9c94404e08b",
                                "sense_id": "cf7e5e5a-bbdf-3e2a-8f26-eb32cbe6566d",
                                "text": "„Wir schnappen ihn an der Ausfahrt nach Schiphol.“"
                            },
                            {
                                "example_id": "ccec3dc6-dc3f-4fea-b16d-6faa5502fe89",
                                "sense_id": "cf7e5e5a-bbdf-3e2a-8f26-eb32cbe6566d",
                                "text": "„Vandel bat darum, diese Information über einen geheimen Kanal für ihn bereitzuhalten, wenn er am nächsten Morgen in Schiphol landete.“"
                            },
                            {
                                "example_id": "4aa41371-3309-43ce-8229-d6fa1ec9aa5a",
                                "sense_id": "cf7e5e5a-bbdf-3e2a-8f26-eb32cbe6566d",
                                "text": "„Es war warm, der Himmel klar, bis auf die langen, schneeweißen Kondensstreifen der Flugzeuge von und nach Schiphol, die ein Netzwerk über das Blau zogen.“"
                            }
                        ],
