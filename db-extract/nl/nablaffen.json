                        ],
                        "examples": [
                            {
                                "example_id": "055025fc-0766-4b5f-b28b-7f31b4e2cdd4",
                                "sense_id": "11dc7452-edb7-3a6a-849c-de208cae3eea",
                                "text": "Het clubje, onder wie D66-kamerlid Van der Ham, heeft schoon genoeg van de „hijgerigheid en scoringsdrift” in de politiek, van het „geneuzel over technische details”, van het „gefriemel en gepruts”, van het „nablaffen van drie of vier berichtjes uit een krant.”"
                            }
                        ]
                    }
