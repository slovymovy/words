    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "423799f7-36c6-3855-996c-1e6bbd2aec20",
                "word": "vociferous",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "229dc1af-05cf-4066-8cca-722c8a98db93",
                        "entry_id": "423799f7-36c6-3855-996c-1e6bbd2aec20",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more vociferous"
                    },
                    {
                        "form_id": "0c62bb46-68a4-49a1-95bc-3e086947c9b4",
                        "entry_id": "423799f7-36c6-3855-996c-1e6bbd2aec20",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most vociferous"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "44c5e4d2-7220-3d9c-8f5f-9c40ab65c199",
                        "entry_id": "423799f7-36c6-3855-996c-1e6bbd2aec20",
                        "glosses": [
                            "Making or characterized by a noisy outcry; clamorous."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3470a840-57e9-4118-a64b-6e823042f5d8",
                                "sense_id": "44c5e4d2-7220-3d9c-8f5f-9c40ab65c199",
                                "text": "They crowded around him with vociferous welcome, Brown leading in a series of wild cheers."
                            },
                            {
                                "example_id": "7079a0f3-4292-44cd-854f-2b77dcc634cb",
                                "sense_id": "44c5e4d2-7220-3d9c-8f5f-9c40ab65c199",
                                "text": "No sooner had a waiting locomotive backed on to its train, the vociferous 4-6-4 or 4-8-4 re-emerged from under the bridge, and the two red marker lights on the last vehicles passed, than the headlight of the electric engine hauling the following train could be seen under the bridge and the waiting queue of locomotives had moved up one."
                            },
                            {
                                "example_id": "9ce60f5d-f96f-4a21-837a-baba0f3c3330",
                                "sense_id": "44c5e4d2-7220-3d9c-8f5f-9c40ab65c199",
                                "text": "Hearts' threat had not evaporated, though, and Templeton fired a yard over the bar before the home fans and players made vociferous handball claims against Jamie Carragher, which were ignored by referee Florian Meyer."
                            }
                        ]
                    },
                    {
                        "sense_id": "37c0a382-a34f-377e-826a-eba63910dcc2",
                        "entry_id": "423799f7-36c6-3855-996c-1e6bbd2aec20",
                        "glosses": [
                            "Vocally and forcefully opinionated."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70cb980d-96ec-4348-be83-6d7da9eb8537",
                                "sense_id": "37c0a382-a34f-377e-826a-eba63910dcc2",
                                "text": "Lesbians Rising […] is known as one of the most vociferous groups working against social oppression of minority interests on campus."
                            },
                            {
                                "example_id": "687eb84f-d5ca-47ad-8afa-6dc02a1af092",
                                "sense_id": "37c0a382-a34f-377e-826a-eba63910dcc2",
                                "text": "Not even the most vociferous advocates of reform were willing to go to such lengths."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ff0db239-9a33-4c3a-aa07-7c08256ba60d",
