                        "form_id": "1a5e2a71-d6d9-414f-82ef-d152f64e59ef",
                        "entry_id": "0eeb71a9-d1d6-3066-820e-a578617c4b1c",
                        "tags": [
                            "pronominal"
                        ],
                        "form": "s’enrhumer"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "05b66e8f-1472-3a43-be7a-a9bc7acf0983",
                        "entry_id": "0eeb71a9-d1d6-3066-820e-a578617c4b1c",
                        "glosses": [
                            "Affecter du rhume."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e306603c-471b-4ed3-9bee-aa75b613da84",
                                "sense_id": "05b66e8f-1472-3a43-be7a-a9bc7acf0983",
                                "text": "Dernièrement, j'avais eu la maladresse de m’enrhumer en pleine chaleur. Voilà pourtant ce que c'est que de devenir vieux : on ne peut résister à rien."
                            },
                            {
                                "example_id": "b1bab359-2e34-4f17-bc81-6d26bc777da8",
                                "sense_id": "05b66e8f-1472-3a43-be7a-a9bc7acf0983",
                                "text": "Un rhume, en apparence bénin peut, s'il est négligé, dégénérer en bronchite ou en pneumonie ; le plus sage serait d'éviter de courir ce risque en prenant des précautions nécessaires pour que vous ne vous enrhumiez pas."
                            }
                        ]
                    }
                ],
