                                    },
                                    {
                                        "sense_id": "6dfa7865-9836-39ac-ad80-55ac4796b580",
                                        "entry_id": "d6671169-1605-3114-9f5e-e0a6e75a9886",
                                        "glosses": [
                                            "To take part in a magic circle."
