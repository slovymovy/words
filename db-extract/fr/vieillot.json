                                "target_senses": [
                                    {
                                        "sense_id": "a5fdf98f-7b5b-3544-ac2f-37cf84941a98",
                                        "entry_id": "71b2a326-2299-3304-b917-584905440879",
                                        "glosses": [
                                            "van iets dat het past bij oudere mensen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "525d85ab-c251-40c8-a633-84d825bfc716",
                                                "sense_id": "a5fdf98f-7b5b-3544-ac2f-37cf84941a98",
                                                "text": "Boer David verraste me. Ik vond hem zo ouwelijk en bazig afgelopen weken, maar stuntelend met pannen achter een fornuis, zichtbaar opgelaten onder al die vrouwenblikken, snapte ik ineens wat zij in hem zien. En dat huis met zwembad is helemaal niet verkeerd, al staat het dan in Roemenië."
                                            },
                                            {
                                                "example_id": "79845628-f394-4605-a4d5-1cd4350d7d2b",
                                                "sense_id": "a5fdf98f-7b5b-3544-ac2f-37cf84941a98",
                                                "text": "Snoezig zijn ze, hé? De zingende tweeling Mylène en Rosanne Waalewijn. Ze hadden zich gisteren ook behoorlijk uitgesloofd: check de matching nagels. En het gekrulde haar: lekker! Toch geven we ze een bescheiden cijfer: 6,5. De galajurken vallen namelijk nogal tegen. De lengte, de kleur, de mouwen: véél te ouwelijk. Voortaan iets jongs, iets tintelends, girls!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "de5756a0-bf78-4124-b6da-d57891a4dae3",
                        "source_entry_id": "e058778b-70bd-3eea-a8cb-ed59ca1a9f52",
                        "source_sense_description": "démodé",
                        "target_lang_word": "ouderwets",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ouderwets",
