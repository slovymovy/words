                        "entry_id": "145d5fc1-584f-3282-bd9c-835e56c237bb",
                        "glosses": [
                            "Caractère de ce qui est exemplaire en matière de respect de l’environnement, d’écologie ou de développement durable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0e1f101-bb28-44a2-a5ea-e4b27d80f245",
                                "sense_id": "56eb9f97-fbde-3f75-93d0-701b98c7042b",
                                "text": "Cet accompagnement, de la part d’experts, constituait une opportunité pour la commune de La Louvière, d’autant que l’éco-exemplarité figurait dans sa déclaration de politique communale."
                            },
                            {
                                "example_id": "ed9d2766-3507-48f8-9267-4fa8d83cb545",
                                "sense_id": "56eb9f97-fbde-3f75-93d0-701b98c7042b",
                                "text": "Réduire notre production de déchets devient essentiel non seulement chez soi mais aussi sur son lieu de travail. Nous pouvons agir afin d’être éco-exemplaires."
                            }
                        ]
                    }
