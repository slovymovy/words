{
    "word_family": [
        "pitcher",
        "pitchy",
        "pitching",
        "re-pitch"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "11327610-7a25-3ac6-a49e-053d3149152c",
                    "sense_definition": "The area of ground marked out for playing a game such as soccer, cricket, or rugby.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sports_field",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The players ran onto the football <w>pitch</w> to start the match.",
                            "target_lang_translations": {
                                "ru": "Игроки выбежали на футбольное <w>поле</w>, чтобы начать матч.",
                                "pl": "Zawodnicy wybiegli na <w>boisko</w> piłkarskie, aby rozpocząć mecz."
                            }
                        },
                        {
                            "text": "Heavy rain turned the cricket <w>pitch</w> into a muddy swamp.",
                            "target_lang_translations": {
                                "ru": "Проливной дождь превратил <w>площадку</w> для крикета в грязное болото.",
                                "pl": "Ulewny deszcz zamienił <w>pole</w> do krykieta w błotniste bagno."
                            }
                        }
                    ],
                    "common_phrases": [
                        "football pitch",
                        "cricket pitch",
                        "on the pitch"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "British"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Участок земли, размеченный для игры в футбол, крикет или регби.",
                        "pl": "Obszar ziemi wyznaczony do gry w piłkę nożną, krykieta lub rugby."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поле",
                                "target_lang_sense_clarification": "спортивная площадка"
                            },
                            {
                                "target_lang_word": "площадка",
                                "target_lang_sense_clarification": "место для игры"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "boisko",
                                "target_lang_sense_clarification": "do gry w piłkę nożną, rugby itp."
                            },
                            {
                                "target_lang_word": "pole",
                                "target_lang_sense_clarification": "do gry, np. w krykieta"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7c890b25-10b2-3a7f-a84c-854d0a1d9c8f",
                    "sense_definition": "The degree of highness or lowness of a tone or sound.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "sound_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her voice rose to a high <w>pitch</w> of excitement when she heard the news.",
                            "target_lang_translations": {
                                "ru": "Её голос поднялся до высокого <w>тона</w> от волнения, когда она услышала новости.",
                                "pl": "Jej głos wzniósł się na wysoki <w>ton</w> podekscytowania, gdy usłyszała te wieści."
                            }
                        },
                        {
                            "text": "Dogs can hear sounds at a much higher <w>pitch</w> than humans can.",
                            "target_lang_translations": {
                                "ru": "Собаки могут слышать звуки гораздо большей <w>высоты</w>, чем люди.",
                                "pl": "Psy słyszą dźwięki o znacznie wyższej <w>wysokości</w> niż ludzie."
                            }
                        }
                    ],
                    "common_phrases": [
                        "high pitch",
                        "low pitch",
                        "perfect pitch"
                    ],
                    "target_lang_definitions": {
                        "ru": "Степень высоты тона или звука.",
                        "pl": "Stopień wysokości lub niskości tonu bądź dźwięku."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "высота",
                                "target_lang_sense_clarification": "звука или голоса"
                            },
                            {
                                "target_lang_word": "тон",
                                "target_lang_sense_clarification": "звуковой оттенок"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "wysokość dźwięku",
                                "target_lang_sense_clarification": "częstotliwość tonu"
                            },
                            {
                                "target_lang_word": "ton",
                                "target_lang_sense_clarification": "brzmienie lub wysokość głosu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d9f5b1c4-205e-319a-a23a-e08608a2a051",
                    "sense_definition": "A speech or act that attempts to persuade someone to buy or do something.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "persuasion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The salesman made a convincing <w>pitch</w> for the new vacuum cleaner.",
                            "target_lang_translations": {
                                "ru": "Продавец сделал убедительную <w>презентацию</w> нового пылесоса.",
                                "pl": "Sprzedawca przedstawił przekonującą <w>prezentację</w> nowego odkurzacza."
                            }
                        },
                        {
                            "text": "We listened to their sales <w>pitch</w> but decided not to invest in the company.",
                            "target_lang_translations": {
                                "ru": "Мы выслушали их торговое <w>предложение</w>, но решили не инвестировать в компанию.",
                                "pl": "Wysłuchaliśmy ich <w>oferty</w> handlowej, ale zdecydowaliśmy nie inwestować w tę firmę."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sales pitch",
                        "make a pitch"
                    ],
                    "target_lang_definitions": {
                        "ru": "Речь или действие, направленные на то, чтобы убедить кого-то купить что-то или сделать что-то.",
                        "pl": "Przemowa lub działanie mające na celu przekonanie kogoś do zakupu czegoś lub podjęcia jakiegoś działania."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "презентация",
                                "target_lang_sense_clarification": "товара или идеи"
                            },
                            {
                                "target_lang_word": "питч",
                                "target_lang_sense_clarification": "короткая презентация (бизнес-сленг)"
                            },
                            {
                                "target_lang_word": "рекламная речь",
                                "target_lang_sense_clarification": "убеждение покупателя"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "prezentacja",
                                "target_lang_sense_clarification": "oferty lub pomysłu"
                            },
                            {
                                "target_lang_word": "oferta",
                                "target_lang_sense_clarification": "handlowa, mająca przekonać klienta"
                            },
                            {
                                "target_lang_word": "pitch",
                                "target_lang_sense_clarification": "krótka prezentacja biznesowa"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "abb3f8bb-d416-35ee-af49-a95b88ec0dcc",
                    "sense_definition": "The act of throwing the ball towards the batter in baseball.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "baseball_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>pitch</w> was too high, and the batter let it pass.",
                            "target_lang_translations": {
                                "ru": "<w>Подача</w> была слишком высокой, и отбивающий пропустил её.",
                                "pl": "<w>Rzut</w> był zbyt wysoki i pałkarz pozwolił mu minąć."
                            }
                        },
                        {
                            "text": "He threw a fast <w>pitch</w> that struck the player out immediately.",
                            "target_lang_translations": {
                                "ru": "Он сделал быструю <w>подачу</w>, которая тут же вывела игрока из игры.",
                                "pl": "Oddał szybki <w>narzut</w>, który natychmiast wyeliminował gracza."
                            }
                        }
                    ],
                    "synonyms": [
                        "throw",
                        "toss"
                    ],
                    "common_phrases": [
                        "wild pitch",
                        "first pitch"
                    ],
                    "target_lang_definitions": {
                        "ru": "Бросок мяча в сторону отбивающего в бейсболе.",
                        "pl": "Rzut piłką w kierunku pałkarza w baseballu."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подача",
                                "target_lang_sense_clarification": "в бейсболе"
                            },
                            {
                                "target_lang_word": "бросок",
                                "target_lang_sense_clarification": "мяча"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "rzut",
                                "target_lang_sense_clarification": "piłką w baseballu"
                            },
                            {
                                "target_lang_word": "narzut",
                                "target_lang_sense_clarification": "podanie miotacza w baseballu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "31ee9c08-c9cb-3143-bc67-1b5ad5631220",
                    "sense_definition": "A thick, dark, sticky substance obtained from tar or turpentine, used for waterproofing.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sailors used hot <w>pitch</w> to seal the gaps in the wooden hull.",
                            "target_lang_translations": {
                                "ru": "Моряки использовали горячую <w>смолу</w>, чтобы заделать щели в деревянном корпусе.",
                                "pl": "Marynarze użyli gorącej <w>smoły</w>, aby uszczelnić szczeliny w drewnianym kadłubie."
                            }
                        },
                        {
                            "text": "It was dark as <w>pitch</w> inside the cave without a flashlight.",
                            "target_lang_translations": {
                                "ru": "В пещере без фонарика было темно, хоть глаз <w>выколи</w>.",
                                "pl": "W jaskini bez latarki było ciemno jak w <w>dupie</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "dark as pitch"
                    ],
                    "target_lang_definitions": {
                        "ru": "Густое темное липкое вещество, получаемое из дегтя или скипидара, используемое для гидроизоляции.",
                        "pl": "Gęsta, ciemna, lepka substancja otrzymywana ze smoły lub żywicy, używana do uszczelniania."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смола",
                                "target_lang_sense_clarification": "вязкое вещество"
                            },
                            {
                                "target_lang_word": "вар",
                                "target_lang_sense_clarification": "для осмолки судов"
                            },
                            {
                                "target_lang_word": "дёготь",
                                "target_lang_sense_clarification": "продукт перегонки"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "smoła",
                                "target_lang_sense_clarification": "lepka substancja do uszczelniania"
                            },
                            {
                                "target_lang_word": "żywica",
                                "target_lang_sense_clarification": "substancja organiczna"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aa2caa6b-914e-3a75-9e4c-3de9c280c38e",
                    "sense_definition": "A marked place in a campsite where you can put up a tent or park a caravan.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We booked a <w>pitch</w> with electricity for our caravan near the lake.",
                            "target_lang_translations": {
                                "ru": "Мы забронировали <w>место</w> с электричеством для нашего фургона у озера.",
                                "pl": "Zarezerwowaliśmy <w>miejsce kempingowe</w> z prądem dla naszej przyczepy nad jeziorem."
                            }
                        },
                        {
                            "text": "The campsite charges extra for a larger <w>pitch</w> during the summer holidays.",
                            "target_lang_translations": {
                                "ru": "Кемпинг взимает дополнительную плату за более просторное <w>место</w> во время летних каникул.",
                                "pl": "Kemping pobiera dodatkową opłatę za większą <w>parcelę</w> w okresie letnich wakacji."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "British"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обозначенное место в кемпинге, где можно поставить палатку или припарковать фургон.",
                        "pl": "Wyznaczone miejsce na kempingu, na którym można rozbić namiot lub zaparkować przyczepę kempingową."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "место",
                                "target_lang_sense_clarification": "для стоянки в кемпинге"
                            },
                            {
                                "target_lang_word": "стоянка",
                                "target_lang_sense_clarification": "для палатки или фургона"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "miejsce kempingowe",
                                "target_lang_sense_clarification": "pod namiot lub przyczepę"
                            },
                            {
                                "target_lang_word": "parcela",
                                "target_lang_sense_clarification": "na polu namiotowym"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a1bbb668-6bc4-3c20-9140-e6277b378294",
                    "sense_definition": "The steepness of a slope, especially of a roof.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "geometry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The steep <w>pitch</w> of the roof helps the snow slide off easily in winter.",
                            "target_lang_translations": {
                                "ru": "Крутой <w>уклон</w> крыши помогает снегу легко скатываться зимой.",
                                "pl": "Stromy <w>kąt nachylenia</w> dachu ułatwia zsuwanie się śniegu zimą."
                            }
                        },
                        {
                            "text": "Architects must calculate the correct <w>pitch</w> to ensure proper drainage.",
                            "target_lang_translations": {
                                "ru": "Архитекторы должны рассчитать правильный <w>угол наклона</w> для обеспечения надлежащего дренажа.",
                                "pl": "Architekci muszą obliczyć właściwy <w>spadek</w>, aby zapewnić odpowiedni odpływ wody."
                            }
                        }
                    ],
                    "synonyms": [
                        "slant"
                    ],
                    "common_phrases": [
                        "roof pitch"
                    ],
                    "target_lang_definitions": {
                        "ru": "Крутизна склона, особенно крыши.",
                        "pl": "Kąt nachylenia zbocza, a zwłaszcza dachu."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уклон",
                                "target_lang_sense_clarification": "крыши или поверхности"
                            },
                            {
                                "target_lang_word": "скат",
                                "target_lang_sense_clarification": "наклонная поверхность"
                            },
                            {
                                "target_lang_word": "угол наклона",
                                "target_lang_sense_clarification": "геометрический параметр"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "kąt nachylenia",
                                "target_lang_sense_clarification": "dachu lub zbocza"
                            },
                            {
                                "target_lang_word": "spadek",
                                "target_lang_sense_clarification": "nachylenie powierzchni"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bed1b126-763b-3df3-b6ad-dc17ff1f338a",
                    "sense_definition": "To throw something, especially a ball in a game like baseball.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "action_throw",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The player prepared to <w>pitch</w> the ball to the batter.",
                            "target_lang_translations": {
                                "ru": "Игрок приготовился <w>подать</w> мяч отбивающему.",
                                "pl": "Gracz przygotował się, by <w>rzucić</w> piłkę do pałkarza."
                            }
                        },
                        {
                            "text": "He picked up a stone and <w>pitched</w> it into the river.",
                            "target_lang_translations": {
                                "ru": "Он поднял камень и <w>швырнул</w> его в реку.",
                                "pl": "Podniósł kamień i <w>wrzucił</w> go do rzeki."
                            }
                        }
                    ],
                    "synonyms": [
                        "throw",
                        "toss",
                        "hurl",
                        "fling",
                        "chuck",
                        "lob",
                        "cast"
                    ],
                    "common_phrases": [
                        "pitch a ball"
                    ],
                    "target_lang_definitions": {
                        "ru": "Бросать что-либо, особенно мяч в такой игре, как бейсбол.",
                        "pl": "Rzucać coś, szczególnie piłkę w grze takiej jak baseball."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бросать",
                                "target_lang_sense_clarification": "кидать предмет"
                            },
                            {
                                "target_lang_word": "подавать",
                                "target_lang_sense_clarification": "мяч в игре"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "rzucać",
                                "target_lang_sense_clarification": "posyłać piłkę lub przedmiot"
                            },
                            {
                                "target_lang_word": "rzucić",
                                "target_lang_sense_clarification": "dokonany od rzucać"
                            },
                            {
                                "target_lang_word": "narzucać",
                                "target_lang_sense_clarification": "podawać piłkę jako miotacz"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d775de98-b56e-3ab9-90b1-e46d9131387a",
                    "sense_definition": "To put up or set up a tent or camp for a short time.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "action_setup",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to <w>pitch</w> our tent near the riverbank for the night.",
                            "target_lang_translations": {
                                "ru": "Мы решили <w>поставить</w> палатку у берега реки на ночь.",
                                "pl": "Zdecydowaliśmy się <w>rozbić</w> namiot nad brzegiem rzeki na noc."
                            }
                        },
                        {
                            "text": "They <w>pitched</w> camp in the valley before the sun went down.",
                            "target_lang_translations": {
                                "ru": "Они <w>разбили</w> лагерь в долине до захода солнца.",
                                "pl": "<w>Rozbili</w> obóz w dolinie przed zachodem słońca."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pitch a tent",
                        "pitch camp"
                    ],
                    "target_lang_definitions": {
                        "ru": "Устанавливать или разбивать палатку или лагерь на короткое время.",
                        "pl": "Rozbijać lub stawiać namiot bądź obóz na krótki czas."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разбивать",
                                "target_lang_sense_clarification": "лагерь"
                            },
                            {
                                "target_lang_word": "ставить",
                                "target_lang_sense_clarification": "палатку"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "rozbić",
                                "target_lang_sense_clarification": "namiot lub obóz"
                            },
                            {
                                "target_lang_word": "rozbijać",
                                "target_lang_sense_clarification": "stawiać namiot"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7f35c1be-bdab-333b-8394-3fdacb3bfed8",
                    "sense_definition": "To try to persuade someone to buy something or to support an idea.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "action_persuade",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>pitched</w> her idea for a new app to the board of directors.",
                            "target_lang_translations": {
                                "ru": "Она <w>презентовала</w> свою идею нового приложения совету директоров.",
                                "pl": "<w>Przedstawiła</w> swój pomysł na nową aplikację zarządowi."
                            }
                        },
                        {
                            "text": "Advertisers <w>pitch</w> their products to specific age groups to increase sales.",
                            "target_lang_translations": {
                                "ru": "Рекламодатели <w>продвигают</w> свои продукты для определенных возрастных групп, чтобы увеличить продажи.",
                                "pl": "Reklamodawcy <w>kierują</w> swoje produkty do określonych grup wiekowych, aby zwiększyć sprzedaż."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pitch an idea"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пытаться убедить кого-то купить что-то или поддержать идею.",
                        "pl": "Próbować przekonać kogoś do zakupu czegoś lub do poparcia jakiegoś pomysłu."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "презентовать",
                                "target_lang_sense_clarification": "идею или продукт"
