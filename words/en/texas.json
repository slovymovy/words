            "senses": [
                {
                    "sense_id": "9e43e586-a6ba-35ff-acd3-215d8356e1ee",
                    "sense_definition": "A large state in the south-central region of the United States.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "places",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "My cousin moved to <w>Texas</w> to find a new job in the oil industry.",
                            "target_lang_translations": {
                                "ru": "Мой двоюродный брат переехал в <w>Техас</w>, чтобы найти новую работу в нефтяной промышленности.",
                                "zh": "我表兄搬到了<w>得克萨斯州</w>，想在石油行业找一份新工作。"
                            }
                        },
                        {
                            "text": "The weather in <w>Texas</w> can be extremely hot during the summer months.",
                            "target_lang_translations": {
                                "ru": "Погода в <w>Техасе</w> может быть чрезвычайно жаркой в летние месяцы.",
                                "zh": "<w>得克萨斯州</w>夏季的天气可能会极其炎热。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Lone Star State"
                    ],
                    "common_phrases": [
                        "state of Texas",
                        "deep in the heart of Texas",
                        "everything is bigger in Texas"
                    ],
                    "target_lang_definitions": {
                        "ru": "Крупный штат на юге центральной части США.",
                        "zh": "美国中南部的一个大州（得克萨斯州/德克萨斯州）。"
                    },
