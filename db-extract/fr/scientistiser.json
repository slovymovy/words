                ],
                "senses": [
                    {
                        "sense_id": "3f95c750-db93-3bc2-8ce5-6937dc7b15d0",
                        "entry_id": "033771d3-4d7a-3ae8-9cc0-28ef607cd10a",
                        "glosses": [
                            "Donner un caractère scientiste à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa4a55e0-b06e-42f2-8c5a-bc08eb85bc1f",
                                "sense_id": "3f95c750-db93-3bc2-8ce5-6937dc7b15d0",
                                "text": "La tendance exactement inverse prévaut actuellement, à vouloir universitairement et administrativement scientistiser un domaine par nature hétérogène au scientisme."
                            },
                            {
                                "example_id": "69100e34-cf22-4bb6-b18d-1bb6f86cf587",
                                "sense_id": "3f95c750-db93-3bc2-8ce5-6937dc7b15d0",
                                "text": "C'est ce qui permet de penser-autre, de penser autrement que selon les voies du monde scientiste, scientistisé, qui toutes ramènent à Rome."
                            },
                            {
                                "example_id": "816b8f1a-0319-4a85-895b-9f9f2a92b497",
                                "sense_id": "3f95c750-db93-3bc2-8ce5-6937dc7b15d0",
                                "text": "L’ambiance à l’université a bien changé depuis. Rétrécie d'horizon, comportementalisée, scientistisée, elle a beaucoup travaillé à oublier son ouverture."
                            }
                        ]
                    }
