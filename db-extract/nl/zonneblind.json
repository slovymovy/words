                ],
                "translations": [
                    {
                        "translation_id": "72c16823-0205-485d-8550-4069e8206ac9",
                        "source_entry_id": "5ab995fc-37e1-3552-b7dc-dfa6b77d5f70",
                        "source_sense_id": "bac13f38-7bfb-3ce2-98b5-c02402f42835",
                        "source_sense_description": "vensterluik met horizontale latjes, om de zonnestralen buiten te houden",
                        "target_lang_word": "Jalousie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jalousie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "710042d3-0e70-3321-aff6-dad41d364f55",
                                        "entry_id": "ea9c4c5b-4f7e-35f1-8816-9e2381b33cc0",
                                        "glosses": [
                                            "Sichtschutz bei Fenstern mit Lamellen aus Aluminium, Holz oder Kunststoff"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40324db2-2561-4cae-a6a2-3ea80e2595ec",
                                                "sense_id": "710042d3-0e70-3321-aff6-dad41d364f55",
                                                "text": "Öffne die Jalousie, damit die Sonne hereinscheinen kann!"
                                            },
                                            {
                                                "example_id": "96911abf-ec04-419c-b90a-e0d5eae4a41b",
                                                "sense_id": "710042d3-0e70-3321-aff6-dad41d364f55",
                                                "text": "„Die Jalousien waren nur zum Teil herabgelassen, und eine Kerze beim Bett hüllte das Vorderzimmer in einen milden Lichtschein.“"
                                            },
                                            {
                                                "example_id": "2b7bc389-2878-4dfc-b3ca-c08b2116a3e6",
                                                "sense_id": "710042d3-0e70-3321-aff6-dad41d364f55",
                                                "text": "„Der ließ darauf die Leinwand und die automatischen Jalousien vor der Fensterfront herunter und schaltete den Projektor ein.“"
                                            },
                                            {
                                                "example_id": "12ce4729-515b-4baf-b64f-b8f3881090cc",
                                                "sense_id": "710042d3-0e70-3321-aff6-dad41d364f55",
                                                "text": "„Jalousienen bieten Sonnenschutz für den Innen- und Außenbereich eines Hauses oder einer Wohnung.“"
                                            },
                                            {
                                                "example_id": "5f001b32-5e1f-4abb-98ad-7ef2a570ba1f",
                                                "sense_id": "710042d3-0e70-3321-aff6-dad41d364f55",
                                                "text": "„Wohnräume sollten morgens und abends gut durchlüftet werden und tagsüber die Rollläden oder Jalousienen geschlossen sein.“"
                                            },
                                            {
                                                "example_id": "295218ef-8b99-4c4b-9812-92dca3bf7a44",
                                                "sense_id": "710042d3-0e70-3321-aff6-dad41d364f55",
                                                "text": "„Außen liegende Jalousienen besitzen meist horinzontale Lamellen aus Kunststoff, Holz oder Aluminium.“"
                                            },
                                            {
                                                "example_id": "873cbc50-1328-4803-888a-c5ed621b2e98",
                                                "sense_id": "710042d3-0e70-3321-aff6-dad41d364f55",
                                                "text": "„Die gelbe Fahne eines Paketdienstes hängt an der gläsernen Wand des Kiosks, hinter einer Scheibe lehnt ein Kuvert, die Jalousienen sind heruntergelassen, im Freibereich neben den Ticket-Automaten stehen zwei Stehtische.“"
                                            },
                                            {
                                                "example_id": "2a5f2735-fefc-4ca1-b839-50fcf94a3c2c",
                                                "sense_id": "710042d3-0e70-3321-aff6-dad41d364f55",
                                                "text": "„Die Fenster sind alle mit Jalousienen ausgestattet.“"
                                            },
                                            {
                                                "example_id": "6d2fa02a-144c-4580-af88-7f1b4aba0b2e",
                                                "sense_id": "710042d3-0e70-3321-aff6-dad41d364f55",
                                                "text": "„Die vom Hagel zerschossenen Jalousienen wurden erneuert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
