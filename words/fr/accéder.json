                                "ru": "После нескольких лет усилий ему наконец удалось <w>прийти</w> к власти.",
                                "de": "Nach mehreren Jahren des Strebens gelang es ihm endlich, an die Macht zu <w>gelangen</w>.",
                                "es": "Tras varios años de esfuerzos, logró <w>llegar</w> al poder.",
                                "zh": "经过多年努力，他终于<w>掌权</w>。"
                            }
                        },
                        {
                            "text": "De nombreuses familles souhaitent <w>accéder</w> à la propriété dans cette ville.",
                            "target_lang_translations": {
                                "en": "Many families want to <w>attain</w> home ownership in this city.",
                                "ru": "Многие семьи хотят <w>получить</w> собственное жильё в этом городе.",
                                "de": "Viele Familien möchten in dieser Stadt Wohneigentum <w>erwerben</w>.",
                                "es": "Muchas familias desean <w>acceder</w> a la propiedad de una vivienda en esta ciudad.",
                                "zh": "许多家庭希望在这座城市<w>拥有</w>自己的住房。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "accéder au pouvoir",
                        "accéder à la propriété"
                    ],
                    "target_lang_definitions": {
                        "en": "To reach an important position, function, or social status.",
                        "ru": "Достигать важного положения, должности или социального статуса.",
                        "de": "Eine wichtige Stellung, ein Amt oder einen gesellschaftlichen Status erreichen.",
                        "es": "Alcanzar un estado, una función importante o una posición social.",
                        "zh": "达到重要的职位、权力或社会地位。"
                    },
                    "translations": {
                        "en": [
