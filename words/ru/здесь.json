{
    "word_family": [
        "здешний"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "25d51dd7-6eb3-343a-8fe9-7d510a5b2332",
                    "sense_definition": "В этом месте; там, где находится говорящий или о чём идёт речь.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "— Ты где? — Я — <w>здесь</w>.",
                            "target_lang_translations": {
                                "en": "— Where are you? — I am <w>here</w>.",
                                "zh": "——你在哪儿？——我在<w>这儿</w>。"
                            }
                        },
                        {
                            "text": "Мы живём <w>здесь</w> уже много лет.",
                            "target_lang_translations": {
                                "en": "We have lived <w>here</w> for many years.",
                                "zh": "我们<w>这里</w>已经住了很多年了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "тут"
                    ],
                    "antonyms": [
                        "там"
                    ],
                    "common_phrases": [
                        "я здесь",
                        "здесь и сейчас",
                        "мы здесь",
                        "здесь холодно"
                    ],
                    "target_lang_definitions": {
                        "en": "In this place; where the speaker is located.",
                        "zh": "在说话人所在的地方或所谈论的地方。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "here",
                                "target_lang_sense_clarification": "in this place"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "这里",
                                "target_lang_sense_clarification": "指代说话人所在的位置"
                            },
                            {
                                "target_lang_word": "这儿",
                                "target_lang_sense_clarification": "指代说话人所在的位置，口语常用"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "524ac01e-645c-3626-ac57-7eea2e5c24e0",
                    "sense_definition": "В этом деле, в данной ситуации или при данных обстоятельствах.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Здесь</w> нужно действовать очень осторожно.",
                            "target_lang_translations": {
                                "en": "<w>Here</w> one must act very carefully.",
                                "zh": "<w>在此</w>必须非常谨慎地行事。"
                            }
                        },
                        {
                            "text": "Я не вижу <w>здесь</w> никакой ошибки.",
                            "target_lang_translations": {
                                "en": "I don't see any mistake <w>here</w>.",
                                "zh": "我没看出<w>这一点上</w>有什么错误。"
                            }
                        }
                    ],
                    "synonyms": [
                        "тут"
                    ],
                    "common_phrases": [
                        "здесь есть проблема",
                        "здесь важно понять",
                        "здесь нет смысла"
                    ],
                    "target_lang_definitions": {
                        "en": "In this matter, situation, or context.",
                        "zh": "在这一事项、情况或背景下。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "here",
                                "target_lang_sense_clarification": "in this situation"
                            },
                            {
                                "target_lang_word": "in this case",
                                "target_lang_sense_clarification": "in this specific instance"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "在此",
                                "target_lang_sense_clarification": "在这一情况下，较为正式"
                            },
                            {
                                "target_lang_word": "这一点上",
                                "target_lang_sense_clarification": "在这一具体问题或观点上"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5775b5a7-1cb3-328b-bce4-0059031d2665",
                    "sense_definition": "В это время, в этот момент (обычно используется в книжной речи или повествовании).",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Здесь</w> он надолго замолчал и задумался.",
                            "target_lang_translations": {
                                "en": "<w>Here</w> he fell silent for a long time and became thoughtful.",
                                "zh": "<w>这时</w>他沉默了很久，陷入了沉思。"
                            }
                        },
                        {
                            "text": "<w>Здесь</w> Чичиков закусил губу и не нашёлся, что отвечать.",
                            "target_lang_translations": {
                                "en": "<w>At this point</w> Chichikov bit his lip and did not know what to answer.",
                                "zh": "<w>在此刻</w>，奇奇科夫咬了咬嘴唇，不知道该回答什么。"
                            }
                        }
                    ],
                    "synonyms": [
                        "в этот момент",
                        "тут"
                    ],
                    "antonyms": [
                        "тогда"
                    ],
                    "target_lang_definitions": {
                        "en": "At this time or moment (usually in narration).",
                        "zh": "在叙述过程中，指代某一特定的时间点或阶段。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "at this point",
                                "target_lang_sense_clarification": "at this moment in a story"
                            },
                            {
                                "target_lang_word": "here",
                                "target_lang_sense_clarification": "at this stage of the narrative"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "这时",
                                "target_lang_sense_clarification": "在叙述中指代某一时刻"
                            },
                            {
                                "target_lang_word": "在此刻",
                                "target_lang_sense_clarification": "在故事发展的这一阶段"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}