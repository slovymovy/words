                        ],
                        "form": "arcasses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a430bb0b-4c45-3d2b-851e-b6fcbf3dd077",
                        "entry_id": "2a0666b0-2a65-38b0-bc7e-eb9bb57a4e3b",
                        "glosses": [
                            "Derrière du gaillard ; culasse du navire."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "c8afd5ba-d483-4b86-a185-3ec75119cd31",
                                "sense_id": "a430bb0b-4c45-3d2b-851e-b6fcbf3dd077",
                                "text": "Son oncle faisait pivoter la barque et rentrait les rames jusqu'à ce que l’arcasse racle le sable."
                            },
                            {
                                "example_id": "d58cc712-4622-415b-aeb4-bef0fef1d3bc",
                                "sense_id": "a430bb0b-4c45-3d2b-851e-b6fcbf3dd077",
                                "text": "Les salles du château arrière, jadis transformées en entrepôt dans lequel maître Imbert et son second dormaient sans façon, redevinrent un appartement clair, où le soleil, réverbéré par la mer, entrait par la large ouverture des sabords d’arcasse."
                            }
                        ]
                    },
                    {
                        "sense_id": "98c7345b-9b58-355c-bf4b-5c1afcab0894",
                        "entry_id": "2a0666b0-2a65-38b0-bc7e-eb9bb57a4e3b",
                        "glosses": [
                            "Charpente de l’arrière d’un navire en bois."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "642e083a-417f-3406-b242-afeedf3402c8",
                        "entry_id": "2a0666b0-2a65-38b0-bc7e-eb9bb57a4e3b",
                        "glosses": [
                            "Chacune des deux pièces qui supportent l’axe d’une poulie."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bc42e02c-7405-43f3-a810-12d5feff550f",
                        "source_entry_id": "2a0666b0-2a65-38b0-bc7e-eb9bb57a4e3b",
                        "source_sense_description": "arrière du navire",
                        "target_lang_word": "Heck",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Heck",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d9c6288e-9aff-3e47-9f21-cb9056bcbec8",
                                        "entry_id": "597579e0-7e9e-3a9d-9501-100bb6ae7bb3",
                                        "glosses": [
                                            "hinterer Teil eines Fahrzeugs (bei Autos, Flugzeugen, Schiffen)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1eba729d-106d-4135-b61e-0a769b6f4ff7",
                                                "sense_id": "d9c6288e-9aff-3e47-9f21-cb9056bcbec8",
                                                "text": "Das Heck wurde bei dem Unfall besonders stark beschädigt."
                                            },
                                            {
                                                "example_id": "a85a44c3-e0ae-45f9-a2f3-bf59746d4f8d",
                                                "sense_id": "d9c6288e-9aff-3e47-9f21-cb9056bcbec8",
                                                "text": "„Ich legte das Paddel wieder ins Heck und ging zurück auf meinen Platz.“"
                                            },
                                            {
                                                "example_id": "299a7024-3834-4611-92c9-e07450c218f2",
                                                "sense_id": "d9c6288e-9aff-3e47-9f21-cb9056bcbec8",
                                                "text": "„An einem Sonntag ging ich nach Hause, nachdem ich dem Maat an Bord des Schiffs geholfen hatte, an Bug und Heck die Flaggen zu hissen.“"
                                            },
                                            {
                                                "example_id": "4ee2432c-0e2e-4062-a097-67297d024b45",
                                                "sense_id": "d9c6288e-9aff-3e47-9f21-cb9056bcbec8",
                                                "text": "„Mansfield stand da und blickte übers Heck auf die riesigen Umrisse des Hais im Wasser.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "413981d5-e859-4a12-97b6-b79a072deaab",
                        "source_entry_id": "2a0666b0-2a65-38b0-bc7e-eb9bb57a4e3b",
                        "source_sense_description": "arrière du navire",
                        "target_lang_word": "stern",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
