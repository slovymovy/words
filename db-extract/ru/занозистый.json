                "senses": [
                    {
                        "sense_id": "53119e84-bdd7-3e99-bb40-611723ef2cd2",
                        "entry_id": "33736a94-feff-3a8c-a428-f421b9b10427",
                        "glosses": [
                            "разг. о человеке: надоедливый; язвительный, задиристый"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48b105c4-ac31-4aac-a6f7-c9501586e415",
                                "sense_id": "53119e84-bdd7-3e99-bb40-611723ef2cd2",
                                "text": "Позади меня стояла Наташа с охапкой реек. // — Я тебя двухдюймовых просил, — безжалостно продолжал Семён, — а ты каких принесла? // — А это разве не двухдюймовые? // — Два дюйма — это пять сантиметров. Надо понимать. // — Так бы и сказал, — рассердилась Наташа. — Ты бы ещё на аршин мерил. Как купец при царе. // И пошла обратно. // — Видишь, какая занозистая, — сказал Семён, улыбнувшись."
                            }
                        ]
                    }
