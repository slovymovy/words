        "ru-extract.jsonl": [
            {
                "entry_id": "d49f5a72-94f7-382d-b70a-5c4ee14a4cee",
                "word": "по-зимнему",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9c61909f-913f-35f7-b051-c9770212abe6",
                        "entry_id": "d49f5a72-94f7-382d-b70a-5c4ee14a4cee",
                        "glosses": [
                            "подобно тому, как это происходит зимой"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bf99066a-98fd-4e36-9f44-374593b28d87",
                        "source_entry_id": "d49f5a72-94f7-382d-b70a-5c4ee14a4cee",
                        "source_sense_id": "9c61909f-913f-35f7-b051-c9770212abe6",
                        "target_lang_word": "as",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "as",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aca645ad-4591-3cf2-acc2-921d16e3d2eb",
                                        "entry_id": "45ab0426-4303-38bd-81d6-aee7815eeb46",
                                        "glosses": [
                                            "To such an extent or degree; to the same extent or degree."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f2ca1ef-b91c-4993-9b15-8deef44af60b",
                                                "sense_id": "aca645ad-4591-3cf2-acc2-921d16e3d2eb",
                                                "text": "You’re not as tall as I am, but you are definitely as happy as can be."
                                            },
                                            {
                                                "example_id": "f00fac93-d807-4966-a68e-ca20cad72422",
                                                "sense_id": "aca645ad-4591-3cf2-acc2-921d16e3d2eb",
                                                "text": "It's not as well made, but it's twice as expensive."
                                            },
                                            {
                                                "example_id": "65b04347-baaa-4ea5-8275-823e0686b090",
                                                "sense_id": "aca645ad-4591-3cf2-acc2-921d16e3d2eb",
                                                "text": "In 1939, as in 1914, all of Europe seemed to want war."
                                            },
                                            {
                                                "example_id": "a900acfa-ec9e-4dd7-a089-e5a8d7b054fd",
                                                "sense_id": "aca645ad-4591-3cf2-acc2-921d16e3d2eb",
                                                "text": "“My Continental prominence is improving,” I commented dryly.\n Von Lindowe cut at a furze bush with his silver-mounted rattan.\n “Quite so,” he said as dryly, his hand at his mustache. “I may say if your intentions were known your life would not be worth a curse.”"
                                            },
                                            {
                                                "example_id": "80b546dd-a872-40a2-ba47-fdc7a6963d1c",
                                                "sense_id": "aca645ad-4591-3cf2-acc2-921d16e3d2eb",
                                                "text": "She was like a Beardsley Salome, he had said. And indeed she had the narrow eyes and the high cheekbone of that creature, and as nearly the sinuosity as is compatible with human symmetry. His wooing had been brief but incisive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b47a2b9-4ce6-3c66-aa35-96cbef92a1ea",
                                        "entry_id": "45ab0426-4303-38bd-81d6-aee7815eeb46",
                                        "glosses": [
                                            "Considered to be, in relation to something else; in the relation (specified)."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "006d96b8-a38a-3d94-8b8c-bb6a5d43b467",
                                        "entry_id": "45ab0426-4303-38bd-81d6-aee7815eeb46",
                                        "glosses": [
                                            "For example; for instance. (Compare such as.)"
                                        ],
                                        "tags": [
                                            "dated",
                                            "formal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69b7f448-4434-4cbb-b3c7-68e042af0d6b",
                                                "sense_id": "006d96b8-a38a-3d94-8b8c-bb6a5d43b467",
                                                "text": "Likewise many other indulgences were by virtue hereof granted; as, to have a portatile altar, to receive the Sacrament privately; […]"
                                            },
                                            {
                                                "example_id": "876450f7-5af1-437e-a277-a8d5d2d07298",
                                                "sense_id": "006d96b8-a38a-3d94-8b8c-bb6a5d43b467",
                                                "text": "First; original; indigenous; primitive; native; as, the aboriginal tribes of America."
                                            },
                                            {
                                                "example_id": "2149a270-ce15-4dcd-9964-8618befcbeb7",
                                                "sense_id": "006d96b8-a38a-3d94-8b8c-bb6a5d43b467",
                                                "text": "The floor of the chamber was tesselated, of marble and green tourmaline, and on every square of tourmaline was carven the image of a fish: as the dolphin, the conger, the cat-fish, the salmon, the tunny, the squid, and other wonders of the deep."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "as",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "36404cfc-3cdf-349c-87ae-d5cd8b5a968d",
                                        "entry_id": "a670364f-b5d6-3d2d-b953-5f22ef284d57",
                                        "glosses": [
                                            "In the (same) way or manner that; to the (same) degree that."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd42cd1c-a561-4d44-af1c-65466f130187",
                                                "sense_id": "36404cfc-3cdf-349c-87ae-d5cd8b5a968d",
                                                "text": "Do as I say!"
                                            },
                                            {
                                                "example_id": "af795582-2afd-4909-b0d9-e359a8e45186",
                                                "sense_id": "36404cfc-3cdf-349c-87ae-d5cd8b5a968d",
                                                "text": "I'm under a lot of pressure, as you know."
                                            },
                                            {
                                                "example_id": "23931c9a-3e9d-4c59-91bf-b68cd20485ee",
                                                "sense_id": "36404cfc-3cdf-349c-87ae-d5cd8b5a968d",
                                                "text": "As you wish, my lord!"
                                            },
                                            {
                                                "example_id": "97e6f9d7-d475-43cb-92fb-4d251529c66f",
                                                "sense_id": "36404cfc-3cdf-349c-87ae-d5cd8b5a968d",
                                                "text": "Mom was slim, as were most of her relatives."
                                            },
                                            {
                                                "example_id": "1e453649-70e2-4598-b9bd-14e1a67bb682",
                                                "sense_id": "36404cfc-3cdf-349c-87ae-d5cd8b5a968d",
                                                "text": "The kidnappers released him as (was) agreed."
                                            },
                                            {
                                                "example_id": "b6ff1562-31b2-4c85-8257-b37771197031",
                                                "sense_id": "36404cfc-3cdf-349c-87ae-d5cd8b5a968d",
                                                "text": "A nearby to-infinitive may be a factor for choosing 'in order to', as will emphasis."
                                            },
                                            {
                                                "example_id": "d3759d64-ffe6-4351-8381-2ed97ab68906",
                                                "sense_id": "36404cfc-3cdf-349c-87ae-d5cd8b5a968d",
                                                "text": "\"But he's good as dead, and I ain't about to waste a bullet.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5ff117f-a632-3193-8829-057a81d735b1",
                                        "entry_id": "a670364f-b5d6-3d2d-b953-5f22ef284d57",
                                        "glosses": [
                                            "In the (same) way or manner that; to the (same) degree that.",
                                            "Used after so or as to introduce a comparison."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22ec78e1-c3ab-438d-a4f8-da6c5e09228c",
                                                "sense_id": "d5ff117f-a632-3193-8829-057a81d735b1",
                                                "text": "She's twice as strong as I was two years ago."
                                            },
                                            {
                                                "example_id": "6338866c-d9b6-40c1-89c0-2949d58e4eae",
                                                "sense_id": "d5ff117f-a632-3193-8829-057a81d735b1",
                                                "text": "It's not so complicated as I expected."
                                            },
                                            {
                                                "example_id": "339c7a66-8c49-41a9-9779-2822732eac2f",
                                                "sense_id": "d5ff117f-a632-3193-8829-057a81d735b1",
                                                "text": "It’s as easy to do it right as it is to do it wrong."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a32bbac2-8d08-351f-8bab-ec1d4bd75b02",
                                        "entry_id": "a670364f-b5d6-3d2d-b953-5f22ef284d57",
                                        "glosses": [
                                            "In the (same) way or manner that; to the (same) degree that.",
                                            "Used to introduce a result: with the result that it is; as to"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60e8f9f5-84ea-4930-b230-293335257c74",
                                                "sense_id": "a32bbac2-8d08-351f-8bab-ec1d4bd75b02",
                                                "text": "[...] that the Board of Regents had fallen into disrepute; that intelligent men inquired what the board was; he said that it was a quiet body, and kept out of the newspapers — and so quiet as to lead many to suppose tho board had ceased to exist."
                                            },
                                            {
                                                "example_id": "b2cd8e0b-8cce-43d9-8dff-29b890538512",
                                                "sense_id": "a32bbac2-8d08-351f-8bab-ec1d4bd75b02",
                                                "text": "It was a talent he had developed; he could actually be so quiet as to be practically invisible. In class, he was rarely called upon to answer any questions. In the crowded hallways, he could slip in and out without offending any of the local bullies ..."
                                            },
                                            {
                                                "example_id": "6fcd14fd-9015-4011-9dad-94dcde982ec8",
                                                "sense_id": "a32bbac2-8d08-351f-8bab-ec1d4bd75b02",
                                                "text": "Under most circumstances, it will be possible to draw a distinction sufficiently clear as to allow an unambiguous allocation to one or other category."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "875d8c40-e26a-3f35-bf3f-7eaefb4b4eef",
                                        "entry_id": "a670364f-b5d6-3d2d-b953-5f22ef284d57",
                                        "glosses": [
                                            "In the (same) way or manner that; to the (same) degree that.",
                                            "Expressing concession: though."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9328af1c-313e-47fb-aa14-9d3a06961e5f",
                                                "sense_id": "875d8c40-e26a-3f35-bf3f-7eaefb4b4eef",
                                                "text": "(As) much as I respect your viewpoint, I can’t agree."
                                            },
                                            {
                                                "example_id": "6532d535-1352-4939-bfaf-97db02ad3380",
                                                "sense_id": "875d8c40-e26a-3f35-bf3f-7eaefb4b4eef",
                                                "text": "(As) bravely as they fought, they soon lost the battle."
                                            },
                                            {
                                                "example_id": "ef32d966-a0b2-40dc-aef7-4fce2585dadc",
                                                "sense_id": "875d8c40-e26a-3f35-bf3f-7eaefb4b4eef",
                                                "text": "Try as she might, she could not escape."
                                            },
                                            {
                                                "example_id": "54b13a0b-4431-4d38-8b01-c4d56850bf92",
                                                "sense_id": "875d8c40-e26a-3f35-bf3f-7eaefb4b4eef",
                                                "text": "1843 (first published), Thomas Babington Macaulay, Essays\nWe wish, however, to avail ourselves of the interest, transient as it may be, which this work has excited."
                                            },
                                            {
                                                "example_id": "f3e88d65-accf-4da4-b034-c1dee651b3b1",
                                                "sense_id": "875d8c40-e26a-3f35-bf3f-7eaefb4b4eef",
                                                "text": "If this happens, be patient and, difficult as it may be, try not to take these reactions personally."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea705875-4134-3568-b40d-988757f75cbc",
                                        "entry_id": "a670364f-b5d6-3d2d-b953-5f22ef284d57",
                                        "glosses": [
                                            "At the time that; during the time when:",
                                            "At the same instant or moment that: when."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f6abfdb-d406-47ee-a5e3-c6078478b25c",
                                                "sense_id": "ea705875-4134-3568-b40d-988757f75cbc",
                                                "text": "As I came in, she fled."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07fb6dff-91b2-33f0-ac98-e5eb00d54209",
                                        "entry_id": "a670364f-b5d6-3d2d-b953-5f22ef284d57",
                                        "glosses": [
                                            "At the time that; during the time when:",
                                            "At the same time that, during the same time when: while."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67d80763-3515-4446-bdf9-62ff706d6ad6",
                                                "sense_id": "07fb6dff-91b2-33f0-ac98-e5eb00d54209",
                                                "text": "He sleeps as the rain falls."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40dd1870-064c-3130-82d6-08ef7d69d24e",
                                        "entry_id": "a670364f-b5d6-3d2d-b953-5f22ef284d57",
                                        "glosses": [
                                            "At the time that; during the time when:",
                                            "Varying through time in the same proportion that."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57f2c947-e251-40c0-8c40-99207681fa51",
                                                "sense_id": "40dd1870-064c-3130-82d6-08ef7d69d24e",
                                                "text": "As my fear grew, so did my legs become heavy."
                                            },
                                            {
                                                "example_id": "4ab56090-9fe9-48c0-a940-d900f0ea41ca",
                                                "sense_id": "40dd1870-064c-3130-82d6-08ef7d69d24e",
                                                "text": "As she grew older, she grew wiser."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac71b3c7-c67b-367b-8b23-f4a94a1053ea",
                                        "entry_id": "a670364f-b5d6-3d2d-b953-5f22ef284d57",
                                        "glosses": [
                                            "Being that, considering that, because, since."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f05bd4f-3d6e-4cf4-b460-85923f155387",
                                                "sense_id": "ac71b3c7-c67b-367b-8b23-f4a94a1053ea",
                                                "text": "As it’s too late, I quit."
                                            },
                                            {
                                                "example_id": "61213a9b-45d7-4b8f-9dce-fe634f16e3c2",
                                                "sense_id": "ac71b3c7-c67b-367b-8b23-f4a94a1053ea",
                                                "text": "(As) tired as he was, I decided not to disturb him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31f55a9f-5984-397b-b991-6a0f4825497d",
                                        "entry_id": "a670364f-b5d6-3d2d-b953-5f22ef284d57",
                                        "glosses": [
                                            "Introducing a comparison with a hypothetical state (+ subjunctive, or with the verb elided): as though, as if."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7059b98d-f2c0-4627-bcb7-abffc9e6e285",
                                                "sense_id": "31f55a9f-5984-397b-b991-6a0f4825497d",
                                                "text": "And sodenly there cam a sounde from heven as it had bene the commynge off a myghty wynde […]"
                                            },
                                            {
                                                "example_id": "80390d47-3997-466e-b42a-1b94ef55d4db",
                                                "sense_id": "31f55a9f-5984-397b-b991-6a0f4825497d",
                                                "text": "Oft haue I ſeene the haughty Cardinall,\n More like a Souldier then a man o' th' Church,\n As ſtout and proud as he were Lord of all […]"
                                            },
                                            {
                                                "example_id": "abb93c10-2bbf-424d-a14e-825d966e658e",
                                                "sense_id": "31f55a9f-5984-397b-b991-6a0f4825497d",
                                                "text": "And then he flue on hir as he were wood, / And on hir breeche did hack and foyne a-good."
                                            },
                                            {
                                                "example_id": "059ca174-7e9f-48f2-9b32-69eb309c3606",
                                                "sense_id": "31f55a9f-5984-397b-b991-6a0f4825497d",
                                                "text": "I start as from some dreadful dream."
                                            },
                                            {
                                                "example_id": "a8139ccb-78fa-4f80-a8bf-d5ee7832591a",
                                                "sense_id": "31f55a9f-5984-397b-b991-6a0f4825497d",
                                                "text": "I feel securely fixed on the careering chair, and with the momentum gained I steer myself as on skis to the guard and come to a stop with a happy little flourish."
                                            },
                                            {
                                                "example_id": "80ca0afc-cf3a-4f75-a78f-74a246db7565",
                                                "sense_id": "31f55a9f-5984-397b-b991-6a0f4825497d",
                                                "text": "They think they are romantic, tragic figures, exiled as on Elba. They picture themselves as enlightened barons bringing civilization, opportunity, and kindness to the brown-skinned."
                                            },
                                            {
                                                "example_id": "51222298-1c85-4d67-bb3b-1b00bc9997ac",
                                                "sense_id": "31f55a9f-5984-397b-b991-6a0f4825497d",
                                                "text": "Newspapers and magazines would load their graphics, and you could doodle as on the Sony Reader Daily Edition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "359b65f6-7a50-3727-8c06-024218dbe913",
                                        "entry_id": "a670364f-b5d6-3d2d-b953-5f22ef284d57",
                                        "glosses": [
                                            "used before a preposition to clarify that the prepositional phrase restricts the meaning of the sentence; specifically."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1b9fc0a-d894-4224-9e49-a43cdfe2765f",
                                                "sense_id": "359b65f6-7a50-3727-8c06-024218dbe913",
                                                "text": "The case is dismissed as between Jones and Smith."
                                            },
                                            {
                                                "example_id": "372f44dc-47b3-4964-9cca-4c1c81cd5581",
                                                "sense_id": "359b65f6-7a50-3727-8c06-024218dbe913",
                                                "text": "The case is dismissed as against Smith."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5c120fd-9cdb-3632-b80f-385f07462dd9",
                                        "entry_id": "a670364f-b5d6-3d2d-b953-5f22ef284d57",
                                        "glosses": [
                                            "Functioning as a relative conjunction, and sometimes like a relative pronoun: that, which, who. (See usage notes.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c4518bc-f5fb-4632-b2e6-04a47ccd5e5a",
                                                "sense_id": "c5c120fd-9cdb-3632-b80f-385f07462dd9",
                                                "text": "You strike me as being a very fidgety type of person."
                                            },
                                            {
                                                "example_id": "29e27cee-4cf7-4cbe-baf9-8e317b818178",
                                                "sense_id": "c5c120fd-9cdb-3632-b80f-385f07462dd9",
                                                "text": "He had the same problem as she did getting the lock open."
                                            },
                                            {
                                                "example_id": "80037fd8-c5ba-42bc-947b-fcaba465fbab",
                                                "sense_id": "c5c120fd-9cdb-3632-b80f-385f07462dd9",
                                                "text": "I read this extract as being extremely pessimistic."
                                            },
                                            {
                                                "example_id": "88d26d32-4457-4a46-b4ef-658885a3f0c7",
                                                "sense_id": "c5c120fd-9cdb-3632-b80f-385f07462dd9",
                                                "text": "Now will he sit under a medlar tree,\nAnd wish his mistress were that kind of fruit,\nAs maids call medlars, when they laugh alone."
                                            },
                                            {
                                                "example_id": "7c42a720-8a67-4b69-b0d9-c5da963678f8",
                                                "sense_id": "c5c120fd-9cdb-3632-b80f-385f07462dd9",
                                                "text": "the temper is to be altered and amended, with such things as fortify and strengthen the heart and brain […]"
                                            },
                                            {
                                                "example_id": "19404e87-a434-4b17-9cc0-09a528c2a464",
                                                "sense_id": "c5c120fd-9cdb-3632-b80f-385f07462dd9",
                                                "text": "‘Sissy is not a name,’ said Mr. Gradgrind. ‘Don’t call yourself Sissy. Call yourself Cecilia.’\n‘It’s father as calls me Sissy, sir,’ returned the young girl in a trembling voice, and with another curtsey."
                                            },
                                            {
                                                "example_id": "2d72f581-95da-4678-94f6-1dae6b9e2cdc",
                                                "sense_id": "c5c120fd-9cdb-3632-b80f-385f07462dd9",
                                                "text": "“If I had, if I could hold me head up with the better folk, perhaps I'd think again, but I don't reckon as that's very likely now.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1fb8354a-7747-34c1-bea2-a82d511930f1",
                                        "entry_id": "a670364f-b5d6-3d2d-b953-5f22ef284d57",
                                        "glosses": [
                                            "Than."
                                        ],
                                        "tags": [
                                            "England",
                                            "obsolete",
                                            "possibly",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fed3686d-ef40-432c-8ed1-924077ba7ecb",
                                                "sense_id": "1fb8354a-7747-34c1-bea2-a82d511930f1",
                                                "text": "The king was not more forward to bestow favours on them as they free to deal affronts to others their superiors."
                                            },
                                            {
                                                "example_id": "f0ec59e9-d11a-48d8-8d2c-a286a3b329aa",
                                                "sense_id": "1fb8354a-7747-34c1-bea2-a82d511930f1",
                                                "text": "Darkness itself is no more opposite to light as their actions were diametricall to their words."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "as",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "26d12e32-a2e6-3de0-81af-b8804a8a3242",
                                        "entry_id": "a5b0cfa5-4e88-3de8-bf48-40216c8b982f",
                                        "glosses": [
                                            "Introducing a basis of comparison, with an object in the objective case."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "692fa9f4-18ad-4120-a7bb-c74bcd062ff2",
                                                "sense_id": "26d12e32-a2e6-3de0-81af-b8804a8a3242",
                                                "text": "You are not as tall as my sister."
                                            },
                                            {
                                                "example_id": "afc032fb-c813-4be1-9cb4-11fadb00f8b3",
                                                "sense_id": "26d12e32-a2e6-3de0-81af-b8804a8a3242",
                                                "text": "They are big as houses."
                                            },
                                            {
                                                "example_id": "50063804-5454-46a6-b7b9-a98d15dd6d65",
                                                "sense_id": "26d12e32-a2e6-3de0-81af-b8804a8a3242",
                                                "text": "A great bargain also had been the excellent Axminster carpet which covered the floor; as, again, the arm-chair in which Bunting now sat forward, staring into the dull, small fire."
                                            },
                                            {
                                                "example_id": "a34202ba-3a1e-4fcc-829a-4091f0e52cd8",
                                                "sense_id": "26d12e32-a2e6-3de0-81af-b8804a8a3242",
                                                "text": "She was like a Beardsley Salome, he had said. And indeed she had the narrow eyes and the high cheekbone of that creature, and as nearly the sinuosity as is compatible with human symmetry."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "958b6649-e06a-32af-9d48-422cefe212cb",
                                        "entry_id": "a5b0cfa5-4e88-3de8-bf48-40216c8b982f",
                                        "glosses": [
                                            "In the role of."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f476efd2-9471-49eb-8b9e-c60e1c59be11",
                                                "sense_id": "958b6649-e06a-32af-9d48-422cefe212cb",
                                                "text": "What is your opinion as a parent?"
                                            },
                                            {
                                                "example_id": "87debfd3-200e-478a-bac0-b115effee522",
                                                "sense_id": "958b6649-e06a-32af-9d48-422cefe212cb",
                                                "text": "As your big sis, I must warn. Like our parents, I am worry about your life too."
                                            },
                                            {
                                                "example_id": "d684f7ec-a72b-496c-b8c8-99ad16bfe5df",
                                                "sense_id": "958b6649-e06a-32af-9d48-422cefe212cb",
                                                "text": "He was never seen as the boss, but rather as a friend."
                                            },
                                            {
                                                "example_id": "f17c4966-d258-48e0-a2cc-fa964621d1fc",
                                                "sense_id": "958b6649-e06a-32af-9d48-422cefe212cb",
                                                "text": "Directed by Howard Hawks, Gentlemen Prefer Blondes starred Marilyn Monroe as Lorelei and Jane Russell as Dorothy."
                                            },
                                            {
                                                "example_id": "2a49b16e-f93c-48d0-a4f2-1838d3855a37",
                                                "sense_id": "958b6649-e06a-32af-9d48-422cefe212cb",
                                                "text": "Not long ago, it was difficult to produce photographs of tiny creatures with every part in focus.[…]A photo processing technique called focus stacking has changed that. Developed as a tool to electronically combine the sharpest bits of multiple digital images, focus stacking is a boon to biologists seeking full focus on a micron scale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5e2ff72-0398-31dc-9bef-029d84b39449",
                                        "entry_id": "a5b0cfa5-4e88-3de8-bf48-40216c8b982f",
                                        "glosses": [
                                            "In the form of."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0afc24cd-50f3-449a-89dc-7e2f2332201d",
                                                "sense_id": "a5e2ff72-0398-31dc-9bef-029d84b39449",
                                                "text": "I bought you a new toy as a special treat."
                                            }
                                        ]
                                    }
                                ]
