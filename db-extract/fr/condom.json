                                    {
                                        "sense_id": "f9ec7cc9-1a18-35e4-b8c4-f355588c1696",
                                        "entry_id": "fcbafb18-2890-3d36-9b90-bf16bd7e7be8",
                                        "glosses": [
                                            "A flexible sleeve made of latex or other impermeable material such as polyurethane or sheepskin, worn over an erect penis during sexual intercourse as a contraceptive or as a way to prevent the spread of STIs during PIV, anal, or oral."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abac19e8-c2ef-4390-8ab4-262e02033e55",
                                                "sense_id": "f9ec7cc9-1a18-35e4-b8c4-f355588c1696",
                                                "text": "buy a pack of condoms"
                                            },
                                            {
                                                "example_id": "1f7fc4c6-ca6a-4d8d-b2c1-dbac1709d94a",
                                                "sense_id": "f9ec7cc9-1a18-35e4-b8c4-f355588c1696",
                                                "text": "flavoured condom"
                                            },
                                            {
                                                "example_id": "6af69a9c-9921-49a6-bb61-39713d8efad2",
                                                "sense_id": "f9ec7cc9-1a18-35e4-b8c4-f355588c1696",
                                                "text": "ribbed condoms"
                                            },
                                            {
                                                "example_id": "cf395383-6d98-42ba-aa1c-f455de0c6768",
                                                "sense_id": "f9ec7cc9-1a18-35e4-b8c4-f355588c1696",
                                                "text": "However, substantial proportions of participants preferred the nonlatex condom or reported that they would recommend its use to others."
                                            },
                                            {
                                                "example_id": "41e5125e-6d6b-4f1c-8f59-3a7a56de51da",
                                                "sense_id": "f9ec7cc9-1a18-35e4-b8c4-f355588c1696",
                                                "text": "We're in the small percentage of cases in which condoms are ineffective. Looks as if you have some sort of supersperm. You must be very proud."
                                            },
                                            {
                                                "example_id": "0dc9de6f-61ab-4d92-bc0e-e0a410b7be62",
                                                "sense_id": "f9ec7cc9-1a18-35e4-b8c4-f355588c1696",
                                                "text": "I remember that one time I went to the kiosk next door to buy condoms, it was raining, she appeared."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0fa7cbb4-4800-3468-93cc-02a27a5896c3",
                                        "entry_id": "fcbafb18-2890-3d36-9b90-bf16bd7e7be8",
                                        "glosses": [
                                            "Any of various forms of flexible sleeve or barrier, variously shaped for either penetrative or receptive body parts, made of latex or other impermeable material such as polyurethane or sheepskin, worn (by anyone with ) during sexual activity to prevent pregnancy or the spread of STIs."
                                        ],
