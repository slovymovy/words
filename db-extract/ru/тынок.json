                "senses": [
                    {
                        "sense_id": "c914b475-b66d-38f8-a1f0-2a98663103f6",
                        "entry_id": "6b4e8eb3-12e9-3a2a-b012-1cf8fd2b5876",
                        "glosses": [
                            "уменьш.-ласк. к тын; заборчик, изгородь, плетень"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "aa9b2107-3404-3b5a-8410-90e0183e0a96",
                        "entry_id": "6b4e8eb3-12e9-3a2a-b012-1cf8fd2b5876",
                        "glosses": [
                            "рег. (тверск.) кол, жердь и т. п. для изгороди"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "8556e5ac-6979-333b-a79a-669cb24c20db",
                        "entry_id": "6b4e8eb3-12e9-3a2a-b012-1cf8fd2b5876",
                        "glosses": [
                            "рег. (Кадниковский уезд Вологодской губ.) низкая изгородь под стогом сена для укрепления нижнего пласта"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bdb2ae36-bf97-4a36-a421-0f1623dc8f53",
                                "sense_id": "8556e5ac-6979-333b-a79a-669cb24c20db",
                                "text": "Тынок-от оставили, чтобы оно сразу не разваливалось."
                            }
                        ]
                    },
                    {
                        "sense_id": "2f11ee2d-7c35-3977-b9ab-1ce4f0da123c",
                        "entry_id": "6b4e8eb3-12e9-3a2a-b012-1cf8fd2b5876",
                        "glosses": [
                            "рег. (Холмский р-н Псковской обл., Шимский р-н Новгородской обл., Каргопольский р-н Архангельской обл., Череповецкий р-н Вологодской обл.) часть стены от столба до столба из горизонтально положенных брёвен"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8090f87d-8bc1-48c3-a7d1-9d9f1f93a2b9",
                                "sense_id": "2f11ee2d-7c35-3977-b9ab-1ce4f0da123c",
                                "text": "От угла до ворот место пустое, тынки забирали."
                            }
                        ]
                    },
                    {
                        "sense_id": "e5ff8e56-ab2a-30b0-a482-807f45c9db91",
                        "entry_id": "6b4e8eb3-12e9-3a2a-b012-1cf8fd2b5876",
                        "glosses": [
                            "рег. (Сольвычегодский уезд Вологодской губ.) участок земли, где растут овощи; огород"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9664942c-4b28-4ed3-a361-f5a31fded14b",
                                "sense_id": "e5ff8e56-ab2a-30b0-a482-807f45c9db91",
                                "text": "Сходи в тынок, принеси луку."
                            }
                        ]
                    },
                    {
                        "sense_id": "5b712cc0-4020-3c63-86fc-5f066da8c025",
                        "entry_id": "6b4e8eb3-12e9-3a2a-b012-1cf8fd2b5876",
                        "glosses": [
                            "рег. (Черноярский уезд Астраханской губ.) то же, что сад"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8566b512-981a-4fe8-b8e2-bfe95cd47c1f",
                                "sense_id": "5b712cc0-4020-3c63-86fc-5f066da8c025",
                                "text": "Я пойду в тынок,//Сорву я цветок."
                            }
                        ]
                    },
                    {
                        "sense_id": "01b7c238-8614-3aa6-9155-8c68afbb88b3",
                        "entry_id": "6b4e8eb3-12e9-3a2a-b012-1cf8fd2b5876",
                        "glosses": [
                            "рег. (Красноярский край) ловушка на зверей"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f77f634-ad20-4fc5-b550-187e831fa074",
                                "sense_id": "01b7c238-8614-3aa6-9155-8c68afbb88b3",
                                "text": "Тынки — палка шире, шире, а поперек две доски. Зверей-то много падало в этот тынок."
                            }
                        ]
                    },
                    {
                        "sense_id": "f03158d5-c3b7-3696-9914-0634bc7952de",
                        "entry_id": "6b4e8eb3-12e9-3a2a-b012-1cf8fd2b5876",
                        "glosses": [
                            "рег. (сибирск.) устройство в виде заграждения из кольев для ловли тетеревов"
                        ],
                        "tags": [],
                        "examples": []
                    },
