                "senses": [
                    {
                        "sense_id": "56bbdf02-a3e6-3731-9f58-404cda9e346f",
                        "entry_id": "09a12ca8-a351-32ce-820c-5aeae0008e4c",
                        "glosses": [
                            "taki, który osiągnął odpowiedni stopień rozwoju, dobrze ukształtowany"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82c2052f-2250-473d-b438-b00a77ce3bf5",
                                "sense_id": "56bbdf02-a3e6-3731-9f58-404cda9e346f",
                                "text": "Dzieciak był bardzo rozumny i nad wiek rozwinięty."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "715429f0-b974-3cd3-86c6-c8854479ff33",
                        "entry_id": "09a12ca8-a351-32ce-820c-5aeae0008e4c",
                        "glosses": [
                            "o kwiatach, pączkach: taki, który się rozwinął"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9fb5a6d-d2ec-45d3-a586-f4579053e6df",
                                "sense_id": "715429f0-b974-3cd3-86c6-c8854479ff33",
                                "text": "Gościnną była, uprzejmą i wyglądała jak tylko co rozwinięty kwiat dzikiej róży."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "14de198d-aa63-49ec-848f-b06852351906",
                        "source_entry_id": "09a12ca8-a351-32ce-820c-5aeae0008e4c",
                        "source_sense_id": "56bbdf02-a3e6-3731-9f58-404cda9e346f",
                        "target_lang_word": "developed",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "developed",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5884713e-5263-34ec-8e61-404f451db152",
                                        "entry_id": "5a4d95c8-c0d1-3e1e-8981-d876d2b092cc",
                                        "glosses": [
                                            "wealthy and industrialized; not third-world."
                                        ],
                                        "tags": [
                                            "said of a country"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d582dffb-deda-4f00-a36a-a8539bed8cfc",
                                                "sense_id": "5884713e-5263-34ec-8e61-404f451db152",
                                                "text": "Investors face a quandary. Cash offers a return of virtually zero in many developed countries; government-bond yields may have risen in recent weeks but they are still unattractive. Equities have suffered two big bear markets since 2000 and are wobbling again. It is hardly surprising that pension funds, insurers and endowments are searching for new sources of return."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8be8632-ab9d-3a5a-942d-a68afbc6f91e",
                                        "entry_id": "5a4d95c8-c0d1-3e1e-8981-d876d2b092cc",
                                        "glosses": [
                                            "Mature."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e8429188-3636-3834-a729-c5d5e551ee87",
                                        "entry_id": "5a4d95c8-c0d1-3e1e-8981-d876d2b092cc",
                                        "glosses": [
                                            "Containing man-made structures such as roads, sewers, electric lines, buildings, and so on."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "15675a7e-e190-3a6b-99dd-29bec72c07c6",
                                        "entry_id": "5a4d95c8-c0d1-3e1e-8981-d876d2b092cc",
                                        "glosses": [
                                            "Having useful or necessary infrastructure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cbe88bd8-4743-40b4-a220-c48ff59058ad",
                                                "sense_id": "15675a7e-e190-3a6b-99dd-29bec72c07c6",
                                                "text": "Access to finance is deeper and wider under better institutions (more transparency, better property rights) in more developed financial markets, and in an environment less distorted by taxes, unnecessary regulations, and other avoidable costs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "650fbdf2-7f9b-3cb2-a5ce-2288af820f26",
                                        "entry_id": "5a4d95c8-c0d1-3e1e-8981-d876d2b092cc",
                                        "glosses": [
                                            "Advanced, fully formed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce9d8e61-93a2-45d7-851c-8b07648571ab",
                                                "sense_id": "650fbdf2-7f9b-3cb2-a5ce-2288af820f26",
                                                "text": "We shall, however, obtain a clearer view of the question if we consider the superstitions of those races which have a rudimentary religion, and endeavour to trace these ideas up into a more developed condition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8cca675a-97c9-3dcc-abc2-be2f3d16ab60",
                                        "entry_id": "5a4d95c8-c0d1-3e1e-8981-d876d2b092cc",
                                        "glosses": [
                                            "Processed and fixed; containing a visible negative (or positive for slide film) image"
                                        ],
                                        "tags": [
                                            "of film"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
