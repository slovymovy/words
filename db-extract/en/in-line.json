                                "sense_id": "9fa0c0da-ee99-3499-86fe-b410a52ebd27",
                                "text": "An in-line mathematical formula does not have to be on a line of its own."
                            },
                            {
                                "example_id": "489246b5-8f62-4b9e-92db-c874be7cf738",
                                "sense_id": "9fa0c0da-ee99-3499-86fe-b410a52ebd27",
                                "text": "Parenthetical referencing is a citation style which uses in-line citations enclosed within parentheses."
                            },
                            {
                                "example_id": "5e7682f7-de14-45be-afc6-9987c93fa939",
                                "sense_id": "9fa0c0da-ee99-3499-86fe-b410a52ebd27",
                                "text": "This is an inline (e.g. mid-sentence) template for marking up text as a Wikipedia self-reference."
                            }
                        ]
