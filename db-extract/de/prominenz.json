                "senses": [
                    {
                        "sense_id": "aa4faf5f-b3dc-3f71-b569-60347e3f3b2c",
                        "entry_id": "91c6f4d7-ba1e-31f4-bd46-6a3ab4fea044",
                        "glosses": [
                            "Eigenschaft von Personen, sich aus vielen anderen herauszuheben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9d1a7dc-17ca-4d31-aff8-0d44cae281fa",
                                "sense_id": "aa4faf5f-b3dc-3f71-b569-60347e3f3b2c",
                                "text": "„Die Prominenz der Doktorandin lenkt ab vom wahren Missstand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c06b1439-2b8e-38d8-9f71-7fa35dfcfa8c",
                        "entry_id": "91c6f4d7-ba1e-31f4-bd46-6a3ab4fea044",
                        "glosses": [
                            "diejenigen Personen in ihrer Gesamtheit, die sich aus vielen anderen herausheben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7bc1fa26-4cbb-40b6-9113-c157e97d4c0c",
                                "sense_id": "c06b1439-2b8e-38d8-9f71-7fa35dfcfa8c",
                                "text": "Zu dieser Feier hat sich die örtliche Prominenz nahezu vollzählig eingefunden."
                            },
                            {
                                "example_id": "97cf69c9-3a67-4021-b7f7-4cb45e8ce99e",
                                "sense_id": "c06b1439-2b8e-38d8-9f71-7fa35dfcfa8c",
                                "text": "„Aufgrund vehementer Proteste seitens der akademischen und geadelten Prominenz der Stadt und einer großen Anzahl von Abonnement-Kündigungen erhielt Heino Keller, Verfasser dieses Artikels, von der Verlagsleitung der Regionalzeitung die sofortig wirksame Kündigung.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "881106f8-aff1-3d87-8092-fa08f5c64728",
                        "entry_id": "91c6f4d7-ba1e-31f4-bd46-6a3ab4fea044",
                        "glosses": [
                            "Höhendifferenz eines Gipfels zur verbindenden Gebirgslücke"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c35719c8-d5b5-43c1-a304-96d7c79e55cb",
                                "sense_id": "881106f8-aff1-3d87-8092-fa08f5c64728",
                                "text": "„Ab 2500 Meter zählt dann nur noch die Eigenständigkeit (Dominanz oder Schartentiefe) und die Prominenz einer Erhebung als Kriterium, um einen Gipfel als selbständigen Berg zu klassifizieren.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
