                        "glosses": [
                            "Variante, dans l’orthographe traditionnelle, de déchainement."
                        ],
                        "tags": [
                            "orthographe rectifiée de 1990"
                        ],
                        "examples": [
                            {
                                "example_id": "1dd5f641-832f-4393-b3c0-a9253007ca94",
                                "sense_id": "8c6c0da4-cfc3-3e9c-a59c-baf2bd569f25",
                                "text": "Seuls dans leur véhicule qui représente un espace clos, devant conduire de nombreux groupes qui sont parfois ivres le weekend, les chauffeurs de taxis représentent des cibles presque trop faciles pour le déchaînement de la haine raciste."
                            },
                            {
                                "example_id": "d61ce296-35e9-4a75-8a43-41a013159587",
                                "sense_id": "8c6c0da4-cfc3-3e9c-a59c-baf2bd569f25",
                                "text": "Il ne faut pas trop s’étonner de ce déchaînement de passions : la même effervescence régnait dans le monde chrétien."
                            }
                        ]
                    }
