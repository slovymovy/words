                        "examples": [
                            {
                                "example_id": "4d5293bc-b761-4b36-bea9-15431dfaeaa2",
                                "sense_id": "12abcb8b-31e2-344e-8b80-14e44983e05e",
                                "text": "1958, Ovid, The Metamorphoses, translated by Horace Gregory, New York: Viking, Book XIII, p. 370,\nYour funeral wreath shall be your mother's tears,\nYour tomb the sanded waste of foreign shores."
                            },
                            {
                                "example_id": "dcaff18b-e85b-491f-acf7-405106991809",
                                "sense_id": "12abcb8b-31e2-344e-8b80-14e44983e05e",
                                "text": "The fishes in your imagination were flesh pink, medium sized like dab, and the loaves were white like altar breads, only fatter and spongier. The place where the miracle occurred was green and leafy and not at all the sparse sanded land that you were later to see."
                            }
                        ]
                    }
