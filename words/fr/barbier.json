                    "sense_definition": "Coiffeur pour hommes, indépendamment du fait qu'il rase ou non la barbe.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "metier_coiffure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon grand-père allait toujours chez le même <w>barbier</w> pour se faire couper les cheveux."
                        },
                        {
                            "text": "Le <w>barbier</w> du coin m'a fait une coupe en brosse en dix minutes."
                        }
                    ],
                    "synonyms": [
                        "coiffeur"
                    ],
