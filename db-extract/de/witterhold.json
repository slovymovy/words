                "senses": [
                    {
                        "sense_id": "2367e41e-3649-3f39-a015-e8cb1b94f201",
                        "entry_id": "358eb11c-44be-36ef-8317-eea8f2e49838",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "044742ee-e5f8-4f5f-b919-7991af4641c3",
                                "sense_id": "2367e41e-3649-3f39-a015-e8cb1b94f201",
                                "text": "Frau Witterhold ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "49dd0d18-b79f-4576-9ef2-768cfbb09340",
                                "sense_id": "2367e41e-3649-3f39-a015-e8cb1b94f201",
                                "text": "Herr Witterhold wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "f59a3e78-5f49-4e17-955e-ec73461cd7af",
                                "sense_id": "2367e41e-3649-3f39-a015-e8cb1b94f201",
                                "text": "Die Witterholds fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "7e761044-4f8e-4d09-9bb9-f21e918c71bb",
                                "sense_id": "2367e41e-3649-3f39-a015-e8cb1b94f201",
                                "text": "Der Witterhold trägt nie die Schals, die die Witterhold ihm strickt."
                            },
                            {
                                "example_id": "4b2741c6-bd6b-4d22-b0e1-c7cc074a84bb",
                                "sense_id": "2367e41e-3649-3f39-a015-e8cb1b94f201",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Witterhold kommt, geht der Herr Witterhold.“"
                            },
                            {
                                "example_id": "cdf651fd-e97e-4dcd-bb40-2d37c42fd6d6",
                                "sense_id": "2367e41e-3649-3f39-a015-e8cb1b94f201",
                                "text": "Witterhold kommt und geht."
                            },
                            {
                                "example_id": "80993133-b620-4b7a-8586-16a0e65410a7",
                                "sense_id": "2367e41e-3649-3f39-a015-e8cb1b94f201",
                                "text": "Witterholds kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
