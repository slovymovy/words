                        "entry_id": "be3a68f3-0f2d-3d1e-a1e0-9e2161354066",
                        "glosses": [
                            "Gepäck auch im Falle von Unterbrechungen oder Umsteigen bis zum Zielort zur Beförderung fertig machen"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "564b929a-29ec-4cec-bed9-56f2c3b3a712",
                                "sense_id": "babccf50-c758-3b60-86e4-c50610b478c5",
                                "text": "„Das Gepäck wird nicht bis Köln, Stuttgart und Düsseldorf durchabgefertigt.“"
                            },
                            {
                                "example_id": "b7b6fb73-df3d-4916-9d2f-628142401d2c",
                                "sense_id": "babccf50-c758-3b60-86e4-c50610b478c5",
                                "text": "„Für mich ziehe ich die Konsequenz, nie wieder mein Gepäck durchabfertigen zu lassen, wenn ich beim Umsteigen die Fluggesellschaft wechsele, und schon gar nicht, wenn es in Länder mit weniger ausgeprägtem technischem Standard geht.“"
                            },
                            {
                                "example_id": "93c0cf59-ad58-4dd8-bec8-aa06b6fe31d1",
                                "sense_id": "babccf50-c758-3b60-86e4-c50610b478c5",
                                "text": "Wird sein Gepäck bis zum Endziel durchabgefertigt, sieht er es am Umsteigeort nicht mehr sondern es wird automatisch umgeladen und er kann unbelastet davon zu seinem Anschlussflug gehen (…)."
                            },
                            {
                                "example_id": "109a8521-1b49-4311-a567-df77537122fa",
                                "sense_id": "babccf50-c758-3b60-86e4-c50610b478c5",
                                "text": "Nach dem Aussteigen in Frankfurt wendet sich der Gast mit seinem Gepäck an seine Fluglinie um sich und sein Gepäck dort einzuchecken und bis zum Endziel durchabzufertigen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
