                        "entry_id": "7a12ba5a-60bc-3dfc-9c12-8c0a18b8aa5f",
                        "glosses": [
                            "staat die behoort tot de groep staten die ergens gezamenlijk militair ingrijpen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dfa47091-5fcf-4b69-97f7-77a3bcc73e29",
                                "sense_id": "0933847a-ab3c-39b4-8361-21afc7fa4d48",
                                "text": "Nadat de lijst met militaire doelen in Koeweit is opgesteld, wordt in Qatar bepaald welk coalitieland een doelwit mag aanvallen."
                            },
                            {
                                "example_id": "09891aeb-23a1-42f0-a462-ff65828d000a",
                                "sense_id": "0933847a-ab3c-39b4-8361-21afc7fa4d48",
                                "text": "Daarna vocht het regeringsleger terug, gesteund door vliegtuigen van de coalitielanden."
                            }
                        ]
                    },
                    {
                        "sense_id": "01181aed-6890-38d1-b927-6fc1d849b941",
                        "entry_id": "7a12ba5a-60bc-3dfc-9c12-8c0a18b8aa5f",
                        "glosses": [
                            "staat die na verkiezingen gewoonlijk een regering krijgt doordat een groep partijen gaat samenwerken om zo een meerderheid in het parlement te vormen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13e65db9-c227-472d-8cc3-5402d4e53359",
                                "sense_id": "01181aed-6890-38d1-b927-6fc1d849b941",
                                "text": "Te hopen valt dan ook dat het volgende week bij het debat over de regeringsverklaring, wanneer ook wordt teruggekeken op de formatie, het tot meer komt dan de obligate dooddoener dat het nu eenmaal niet anders kan in een coalitieland. Daarvoor zijn er te veel coalitielanden in de wereld waar wel binnen een redelijke termijn en in minder beslotenheid een regering kan worden gevormd."
                            },
                            {
                                "example_id": "28dcf1a6-5b55-43ea-b1fd-bebce194e0a8",
                                "sense_id": "01181aed-6890-38d1-b927-6fc1d849b941",
                                "text": "Macron staat voor onze aanpak: tegenstellingen niet aanzetten maar overbruggen. Hier gebeurt het binnen zijn eigen partij, maar het lijkt op hoe het in ons coalitieland gaat."
                            }
                        ]
                    }
