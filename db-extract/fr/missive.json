                ],
                "senses": [
                    {
                        "sense_id": "9dd52515-ede1-3748-916b-d3335238b794",
                        "entry_id": "44d9bb30-e04c-32b0-b84d-b18130792a73",
                        "glosses": [
                            "Courrier destiné à être envoyé."
                        ],
                        "tags": [],
                        "note": "Se teinte parfois d’une nuance d’ironie",
                        "examples": [
                            {
                                "example_id": "4d7af1a8-a1e1-4aea-9c55-6d68e5112fbc",
                                "sense_id": "9dd52515-ede1-3748-916b-d3335238b794",
                                "text": "Un steamer en partance emporta la missive du caïd Maclean à Tanger, d'où la légation d'Angleterre la transmit par le télégraphe à Gibraltar et au Foreign Office."
                            },
                            {
                                "example_id": "7bae9476-048e-423e-b780-30df875b938f",
                                "sense_id": "9dd52515-ede1-3748-916b-d3335238b794",
                                "text": "[…] il y aura toujours des gens pour penser que « ondée » est plus joli que « pluie », qui préféreront « opuscule » à « petit livre », « missive » à « lettre », « expliciter » à « expliquer », « pinacothèque » à « musée », « céphalalgie » à « mal de tête » et trouveront plus distingué d’avoir une protubérance qu’une bosse. » — (Robert Beauvais, L’hexagonal tel qu'on le parle, Hachette, 1970)"
                            },
                            {
                                "example_id": "0ae07fdd-1cef-4082-87f3-80acf6c19446",
                                "sense_id": "9dd52515-ede1-3748-916b-d3335238b794",
                                "text": "Je passai les heures qui suivirent à rédiger des missives à ce joueur de golf."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e44937f2-871d-4e7b-97c4-10e0a7ec211a",
                        "source_entry_id": "44d9bb30-e04c-32b0-b84d-b18130792a73",
                        "source_sense_id": "9dd52515-ede1-3748-916b-d3335238b794",
                        "target_lang_word": "missive",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "missive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "08df5c8b-fa89-3e19-b017-d96b5c33ac2c",
                                        "entry_id": "da2def77-d6a7-3ea3-97fd-02bbb5c1663d",
                                        "glosses": [
                                            "A written message; a letter, note or memo."
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ee16fbf-f029-43bd-bc55-6b5415612d31",
                                                "sense_id": "08df5c8b-fa89-3e19-b017-d96b5c33ac2c",
                                                "text": "[Y]ou / Did pocket vp my Letters: and with taunts / Did gibe my Miſive out of audience."
                                            },
                                            {
                                                "example_id": "d80f282a-10fb-4282-a061-7ddb9bfed30b",
                                                "sense_id": "08df5c8b-fa89-3e19-b017-d96b5c33ac2c",
                                                "text": "The juvenile missives from his unmistakably phallic Twitter avatar came days after one of his rockets launched NASA’s first antiasteroid planetary-defense test[…]"
                                            },
                                            {
                                                "example_id": "8a25d38c-8ae7-4bfb-b10b-14871b73596f",
                                                "sense_id": "08df5c8b-fa89-3e19-b017-d96b5c33ac2c",
                                                "text": "The Madonna letters, which are interspersed with more personal missives in this curious epistolary memoir, accumulate into a rap about the downsides of celebrity - the problems of ageing, of invaded privacy, of becoming vain and impetuously adopting children from other continents."
                                            },
                                            {
                                                "example_id": "be00e2e3-b5ee-4385-8d87-1857abf4616b",
                                                "sense_id": "08df5c8b-fa89-3e19-b017-d96b5c33ac2c",
                                                "text": "\"Curses throttle thee!\" yelled Ahab. \"Captain Mayhew, stand by now to receive it\"; and taking the fatal missive from Starbuck's hands, he caught it in the slit of the pole, and reached it over towards the boat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "801e9870-1967-3f72-88cd-3fd952d43651",
                                        "entry_id": "da2def77-d6a7-3ea3-97fd-02bbb5c1663d",
                                        "glosses": [
                                            "Letters sent between two parties in which one makes an offer and the other accepts it."
                                        ],
                                        "tags": [
                                            "in-plural"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f8e7b0e0-3849-337d-a563-13edf55e65d7",
                                        "entry_id": "da2def77-d6a7-3ea3-97fd-02bbb5c1663d",
                                        "glosses": [
                                            "One who is sent; a messenger."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77dc940d-1652-45bf-aa4c-cb248202f7c6",
                                                "sense_id": "f8e7b0e0-3849-337d-a563-13edf55e65d7",
                                                "text": "Whiles I stood rapt in the wonder of it came missives from the King, who all hailed me ‘Thane of Cawdor,’ by which title these Weird Sisters saluted me and referred me to the coming on of time with ‘Hail king that shalt be.’"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "missive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ff0793da-7bac-33fc-9d98-be96323a82ba",
                                        "entry_id": "2b9a9c6d-f7e3-3b2d-ba93-38d7b7a7a55d",
                                        "glosses": [
                                            "Specially sent; intended or prepared to be sent."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd717382-faaf-446f-ba61-9e27ef8037fb",
                                                "sense_id": "ff0793da-7bac-33fc-9d98-be96323a82ba",
                                                "text": "a letter missive"
                                            },
                                            {
                                                "example_id": "045b867b-55cb-48d0-8a96-b07f1377a10b",
                                                "sense_id": "ff0793da-7bac-33fc-9d98-be96323a82ba",
                                                "text": "Delivery of the Letters Missive"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e8820fa-cfcf-30e2-b841-bc52be990323",
                                        "entry_id": "2b9a9c6d-f7e3-3b2d-ba93-38d7b7a7a55d",
                                        "glosses": [
                                            "Serving as a missile; intended to be thrown."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73cc64a6-4538-42a5-b1b2-d0189d7587a9",
                                                "sense_id": "7e8820fa-cfcf-30e2-b841-bc52be990323",
                                                "text": "In vain with Darts a diſtant War they try, / Short, and more ſhort the miſſive weapons fly."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "28915ecb-0456-49ec-b103-9aa181a99fcd",
                        "source_entry_id": "44d9bb30-e04c-32b0-b84d-b18130792a73",
                        "source_sense_id": "9dd52515-ede1-3748-916b-d3335238b794",
                        "target_lang_word": "brief",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brief",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "f63608aa-a963-300e-a018-bf72584eb1c0",
                                        "entry_id": "01420b4e-974b-3afd-a2b5-fef00dde5628",
                                        "glosses": [
                                            "een (traditioneel op papier) geschreven bericht van een persoon naar een ander, meestal in een omslag per post verzonden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3eb954d7-3813-4bee-80ea-ea423abf5472",
                                                "sense_id": "f63608aa-a963-300e-a018-bf72584eb1c0",
                                                "text": "Je moet nog een brief naar Tessa sturen."
                                            },
                                            {
                                                "example_id": "ce954431-2f86-4730-a028-4ae606a7d2e0",
                                                "sense_id": "f63608aa-a963-300e-a018-bf72584eb1c0",
                                                "text": "Er worden steeds minder brieven geschreven sinds er e-mail is."
                                            },
                                            {
                                                "example_id": "20f30b38-13d2-429a-be11-44ba51dbb957",
                                                "sense_id": "f63608aa-a963-300e-a018-bf72584eb1c0",
                                                "text": "'En nou heb ik bij Quick thuis een brief gevonden die is geadresseerd aan een zekere Olive Schloss, een toelatingsbrief voor de Slade School of Art."
                                            },
                                            {
                                                "example_id": "f85134e1-0451-44f8-ac4c-8b64e3c3965e",
                                                "sense_id": "f63608aa-a963-300e-a018-bf72584eb1c0",
                                                "text": "Na veel gepeins besloot ik een lange brief vol ervaringen, waarden en suggesties te schrijven aan mijn kinderen. Allemaal lessen die ik in mijn korte leven had geleerd en die mij hadden geholpen. Wellicht zouden zij er ook wat aan hebben in de toekomst of in ieder geval hun vader beter kunnen begrijpen."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "brief",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "699c5c32-b63f-3bfd-a47d-31b210ecfa61",
