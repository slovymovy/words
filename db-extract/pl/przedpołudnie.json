                "translations": [
                    {
                        "translation_id": "b4205f32-9251-4f32-81ea-195f060aebdd",
                        "source_entry_id": "ee84ec79-ced8-33e6-b821-a37110040a94",
                        "source_sense_id": "cf26c846-729e-3262-a4b0-9f9a0ab69781",
                        "target_lang_word": "morning",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "morning",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dd92cb8b-cff3-3b69-ac29-17f23861162a",
                                        "entry_id": "4bcf6ba3-a13d-35f6-a9e1-5d6918977ee8",
                                        "glosses": [
                                            "The early part of the day, especially from midnight to noon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c850d8af-9c54-4982-bc7b-564feff8ce0c",
                                                "sense_id": "dd92cb8b-cff3-3b69-ac29-17f23861162a",
                                                "text": "I'll see you tomorrow morning."
                                            },
                                            {
                                                "example_id": "86b97609-bb44-440d-9cdd-05893859cd5f",
                                                "sense_id": "dd92cb8b-cff3-3b69-ac29-17f23861162a",
                                                "text": "I'm working in the morning, so let's meet in the afternoon."
                                            },
                                            {
                                                "example_id": "43e573da-1272-44ce-b4b0-c6dbb900f33d",
                                                "sense_id": "dd92cb8b-cff3-3b69-ac29-17f23861162a",
                                                "text": "Towards the following morning, the thermometer fell to 5°; and at daylight, there was not an atom of water to be seen in any direction."
                                            },
                                            {
                                                "example_id": "c1f66408-35a9-4ef5-bcfa-c9a01f63c88e",
                                                "sense_id": "dd92cb8b-cff3-3b69-ac29-17f23861162a",
                                                "text": "One morning I had been driven to the precarious refuge afforded by the steps of the inn, after rejecting offers from the Celebrity to join him in a variety of amusements. But even here I was not free from interruption, for he was seated on a horse-block below me, playing with a fox terrier."
                                            },
                                            {
                                                "example_id": "5016493a-8826-4072-9c80-6744953d78b9",
                                                "sense_id": "dd92cb8b-cff3-3b69-ac29-17f23861162a",
                                                "text": "Sheesh, it's two in the morning. Why do kids always have to feel sick at two in the morning?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e3c8a87-023b-335d-a992-b4f6d19d4fc9",
                                        "entry_id": "4bcf6ba3-a13d-35f6-a9e1-5d6918977ee8",
                                        "glosses": [
                                            "The early part of anything."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "882fb91e-b389-39cf-a083-4c27595a918a",
                                        "entry_id": "4bcf6ba3-a13d-35f6-a9e1-5d6918977ee8",
                                        "glosses": [
                                            "That part of the day from dawn until the main meal (typically in late afternoon)."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b711ad8-913d-4982-bf64-59019160fca3",
                                                "sense_id": "882fb91e-b389-39cf-a083-4c27595a918a",
                                                "text": "Celestina […] retired to her own room, leaving her friend to the pleasing and important occupation of the toilet, in which half of what is now called morning, was usually passed by Matilda."
                                            },
                                            {
                                                "example_id": "228ae513-6433-42aa-9c36-e6c6a3246ed7",
                                                "sense_id": "882fb91e-b389-39cf-a083-4c27595a918a",
                                                "text": "We breakfasted before nine, and do not dine till half-past six on the occasion, so I hope we three shall have a long morning enough."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6a7fe72-0072-3452-8d1b-f7b71dee5b0c",
                                        "entry_id": "4bcf6ba3-a13d-35f6-a9e1-5d6918977ee8",
                                        "glosses": [
                                            "The first alcoholic drink of the day; a morning draught."
                                        ],
                                        "tags": [
                                            "Scotland"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "morning",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "267a677d-1a95-3d25-9e63-9de32afa3ed5",
                                        "entry_id": "33b86618-a0c0-3e4a-a638-3a123eaf9f39",
                                        "glosses": [
                                            "Ellipsis of good morning."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "815883d8-ef0c-41d6-9a36-7ef14cee9419",
                                                "sense_id": "267a677d-1a95-3d25-9e63-9de32afa3ed5",
                                                "text": "Hey, ‘morning, Mario. Have you been to the dining car yet today?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "192215fc-caaf-4060-a9ab-c86fe7c1cbb5",
                        "source_entry_id": "ee84ec79-ced8-33e6-b821-a37110040a94",
