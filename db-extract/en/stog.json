                "senses": [
                    {
                        "sense_id": "ea2ac1ef-8a92-39a4-a4c4-18964fccd71f",
                        "entry_id": "63050ec5-7cca-37f0-b3a7-00e12d5262a3",
                        "glosses": [
                            "To bog down; to cause to be stuck in mud."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "ea428eb8-983f-4c0d-af64-4d6aea7f30a0",
                                "sense_id": "ea2ac1ef-8a92-39a4-a4c4-18964fccd71f",
                                "text": "If any of his party are mad, they'll try it, and be stogged till the day of judgment. There are bogs..twenty feet deep."
                            }
                        ]
                    },
                    {
                        "sense_id": "63d18741-8ce4-32fa-9df3-d87fc59cbf6a",
                        "entry_id": "63050ec5-7cca-37f0-b3a7-00e12d5262a3",
                        "glosses": [
                            "To walk with a heavy or clumsy gait; to plod."
                        ],
                        "tags": [
                            "intransitive",
                            "obsolete"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "b48603cb-122f-32ac-a491-6c470dac3830",
                        "entry_id": "63050ec5-7cca-37f0-b3a7-00e12d5262a3",
                        "glosses": [
                            "To stab; to probe; to thrust"
                        ],
                        "tags": [
                            "Scotland",
                            "dialectal"
                        ],
                        "examples": [
                            {
                                "example_id": "149bcdba-4b52-41a3-a5ea-a4928850a0a9",
                                "sense_id": "b48603cb-122f-32ac-a491-6c470dac3830",
                                "text": "He studied the cold gray rips in the current and dismounted and loosed the girthstraps and undressed and stogged his boots in the legs of his trousers as he'd done before in that long ago […]"
                            }
                        ]
                    },
