                                        "entry_id": "11b1bad7-feb7-3349-98ce-b856cf8f4371",
                                        "glosses": [
                                            "Ajuster à nouveau (quelque chose qui n’était plus ajusté)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a943b98-1b01-47a1-a3c5-51cf69b0820e",
                                                "sense_id": "76cee369-d5e8-3f2a-89be-799fbd89a72e",
                                                "text": "Elle se leva, se leva avec lenteur, fut levée, réajusta une nouvelle fois sa veste."
                                            },
                                            {
                                                "example_id": "4631513b-4ba0-4336-9369-1b48bdf28091",
                                                "sense_id": "76cee369-d5e8-3f2a-89be-799fbd89a72e",
                                                "text": "Le Spandau réajusta son tir."
                                            },
                                            {
                                                "example_id": "ffde9c86-64a2-4706-a55e-5e6da79bd752",
                                                "sense_id": "76cee369-d5e8-3f2a-89be-799fbd89a72e",
                                                "text": "Peut-être avait-il pensé que les choses étaient en train de s'améliorer et qu'il fallait réajuster nos manières et nous découvrir de nouveaux réflexes, une nouvelle mentalité."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
