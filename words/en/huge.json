    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e4338431-3357-32fd-bd9a-a27e92d1290c",
                    "sense_definition": "Extremely large in size, amount, or degree.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They live in a <w>huge</w> house near the beach.",
                            "target_lang_translations": {
                                "ru": "Они живут в <w>огромном</w> доме недалеко от пляжа.",
                                "zh": "他们住在海边一栋<w>巨大</w>的房子里。"
                            }
                        },
                        {
                            "text": "This project will require a <w>huge</w> amount of money.",
                            "target_lang_translations": {
                                "ru": "Этот проект потребует <w>огромного</w> количества денег.",
                                "zh": "这个项目需要<w>庞大</w>的资金。"
                            }
                        },
                        {
                            "text": "There is a <w>huge</w> difference between the two options.",
                            "target_lang_translations": {
                                "ru": "Между этими двумя вариантами есть <w>огромная</w> разница.",
                                "zh": "这两个选项之间存在<w>巨大</w>的差异。"
                            }
                        }
                    ],
                    "synonyms": [
                        "enormous",
                        "massive",
                        "gigantic",
                        "vast",
                        "immense",
                        "colossal",
                        "big",
                        "large"
                    ],
                    "antonyms": [
                        "small",
                        "tiny",
                        "minuscule"
                    ],
                    "common_phrases": [
                        "huge amount",
                        "huge number",
                        "huge success",
                        "huge difference"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно большой по размеру, количеству или степени.",
                        "zh": "在尺寸、数量或程度上极其巨大。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "огро́мный",
                                "target_lang_sense_clarification": "очень большой"
                            },
                            {
                                "target_lang_word": "грома́дный",
                                "target_lang_sense_clarification": "внушительный, необъятный"
                            },
                            {
                                "target_lang_word": "здорове́нный",
                                "target_lang_sense_clarification": "разговорное; очень крупный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "巨大",
                                "target_lang_sense_clarification": "形容体积或规模非常大"
                            },
                            {
                                "target_lang_word": "庞大",
                                "target_lang_sense_clarification": "形容规模、数量或体系非常大"
                            },
                            {
                                "target_lang_word": "巨大",
                                "target_lang_sense_clarification": "形容程度或影响非常深远"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "be18f605-da18-3b06-8a05-8b1cd7541e75",
                    "sense_definition": "Extremely popular, famous, or successful.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The band's next album is going to be <w>huge</w>.",
                            "target_lang_translations": {
                                "ru": "Следующий альбом группы будет <w>грандиозным</w>.",
                                "zh": "这个乐队的下一张专辑一定会<w>大受欢迎</w>。"
                            }
                        },
                        {
                            "text": "That actor is <w>huge</w> in Europe right now.",
                            "target_lang_translations": {
                                "ru": "Этот актер сейчас <w>очень популярен</w> в Европе.",
                                "zh": "那位演员现在在欧洲<w>红极一时</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "big",
                        "massive",
                        "giant"
                    ],
                    "common_phrases": [
                        "going to be huge",
                        "make it huge"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно популярный, известный или успешный.",
                        "zh": "极其受欢迎、著名或成功。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "о́чень популя́рный",
                                "target_lang_sense_clarification": "широко известный"
                            },
                            {
                                "target_lang_word": "грандио́зный",
                                "target_lang_sense_clarification": "имеющий большой успех"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "大受欢迎",
                                "target_lang_sense_clarification": "形容非常流行或成功"
                            },
                            {
                                "target_lang_word": "红极一时",
                                "target_lang_sense_clarification": "形容在某个时期非常出名"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "df94a0a2-df36-3de4-b4c2-0b5c9f6ea90c",
                    "sense_definition": "Used to emphasize that someone is very enthusiastic or dedicated.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am a <w>huge</w> fan of your music.",
                            "target_lang_translations": {
                                "ru": "Я <w>большой</w> фанат вашей музыки.",
                                "zh": "我是你音乐的<w>忠实</w>粉丝。"
                            }
                        },
                        {
                            "text": "Both of my parents are <w>huge</w> supporters of animal rights.",
                            "target_lang_translations": {
                                "ru": "Оба моих родителя — <w>ярые</w> сторонники прав животных.",
                                "zh": "我的父母都是动物权利的<w>热衷</w>支持者。"
                            }
                        }
                    ],
                    "synonyms": [
                        "big",
                        "great",
                        "massive"
                    ],
                    "common_phrases": [
                        "huge fan",
                        "huge supporter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для усиления описания чьего-либо энтузиазма или преданности.",
                        "zh": "用于强调某人非常热衷或投入。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "большо́й",
                                "target_lang_sense_clarification": "о фанате или любителе"
                            },
                            {
                                "target_lang_word": "я́рый",
                                "target_lang_sense_clarification": "страстный, убежденный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "忠实",
                                "target_lang_sense_clarification": "形容粉丝或支持者非常投入"
                            },
                            {
                                "target_lang_word": "热衷",
                                "target_lang_sense_clarification": "形容对某事非常感兴趣"
                            }
                        ]
                    }
                }
            ]
        }
    ]
