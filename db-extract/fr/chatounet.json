                            {
                                "example_id": "8e6db210-76ca-4bb3-b891-51874bc85041",
                                "sense_id": "6c63620b-53fc-34db-90b5-185222735a3f",
                                "text": "Alors, mon petit chatounet ; qu’est-ce que tu en penses ? — J’en pense que ton petit chatounet n’est pas le bon Dieu. Lui fait la pluie et le beau temps, ton petit chatounet, non ! »"
                            }
                        ]
