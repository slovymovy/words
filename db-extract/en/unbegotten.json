                        "glosses": [
                            "Not begotten."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "07d473f3-93d5-46f7-9f16-ee46127f39f8",
                                "sense_id": "da02eec6-ef5f-3848-ad82-884f581bebe7",
                                "text": "If care of our descent perplex us most, / Which must be born to certain woe, devour'd / By Death at last—and miserable it is / To be to others cause of misery, / Our own begotten, and of our loins to bring / Into this cursed world a woeful race, / That after wretched life must be at last / Food for so foul a monster—in thy power / It lies, yet ere conception, to prevent / The race unblest, to being yet unbegot."
                            },
                            {
                                "example_id": "7a56d028-aa1a-493d-97dc-31dde5d94ed4",
                                "sense_id": "da02eec6-ef5f-3848-ad82-884f581bebe7",
                                "text": "Thou knowest not how came ye, hence callest thyself unbegotten; certainly knowest not thy beginning, hence callest thyself unbegun."
                            }
                        ]
                    }
