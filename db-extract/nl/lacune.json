                        "source_sense_id": "ab4e33ba-2a9a-393b-a17b-26cb274bb6ec",
                        "source_sense_description": "iets dat ontbreekt",
                        "target_lang_word": "Lücke",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lücke",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ccac5f93-fd15-3edb-a332-9d90f9259593",
                                        "entry_id": "b4f6e220-4638-3a88-ae39-f261889658e9",
                                        "glosses": [
                                            "Stelle, an der etwas fehlt, das dort sein sollte oder dort hin kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f0c4fd6-89f0-4213-90bc-573b9711c1d8",
                                                "sense_id": "ccac5f93-fd15-3edb-a332-9d90f9259593",
                                                "text": "Schreiben Sie einfach die Wörter, die Sie hören, in die Lücken."
                                            },
                                            {
                                                "example_id": "49f30ed9-1c6d-4deb-a03a-0d0df4bf1b83",
                                                "sense_id": "ccac5f93-fd15-3edb-a332-9d90f9259593",
                                                "text": "„Etablierte Bestseller wie Q5 (2016) und Q7 (bereits 2014) erhalten Nachfolger, Lücken im Q-Programm werden mit neuen Modellen aufgefüllt.“"
                                            },
                                            {
                                                "example_id": "598dd829-43e2-4847-a21f-fe234adf4358",
                                                "sense_id": "ccac5f93-fd15-3edb-a332-9d90f9259593",
                                                "text": "„Als sie grinste, klaffte eine schwarze Lücke im Gebiss.“"
                                            },
                                            {
                                                "example_id": "d96eef36-3a5d-431c-8043-78ae28a7092a",
                                                "sense_id": "ccac5f93-fd15-3edb-a332-9d90f9259593",
                                                "text": "„Er hatte eine Lücke hinterlassen, wie man so sagt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "76cb6c29-02ed-4a61-bc55-23ff7ec37b87",
                        "source_entry_id": "06e1b87e-08b6-3d9d-bbd6-d479e407c3e3",
                        "source_sense_id": "ab4e33ba-2a9a-393b-a17b-26cb274bb6ec",
