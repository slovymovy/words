                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "fad51bab-ebf7-4792-8d7b-fafbd936a0c5",
                                "sense_id": "edeae866-839e-3045-9c37-1568ef3adc81",
                                "text": "In year eight, crouched in a playground cubby, she gave Ryan Glover a gobby. Brief, busy, urgent. Then afterwards, slipping it back into his pants, he said thank you."
                            },
                            {
                                "example_id": "e8165f1a-1f83-4f76-a119-5991e4e79f93",
                                "sense_id": "edeae866-839e-3045-9c37-1568ef3adc81",
                                "text": "He bustles me into a cubicle and locks the door.\n\"I'm not really in the mood for a gobby,\" I slur, and laugh girlishly at my joke as I unzip my fly, \"but if you insist...\""
                            },
                            {
                                "example_id": "eebb9cd2-73bb-4627-be90-8287f1bf8727",
                                "sense_id": "edeae866-839e-3045-9c37-1568ef3adc81",
                                "text": "Have you seen the Colgate Total ad with the female Indian dentist? Would you let her give you a gobby? I would. She has a perdy mouth."
                            }
                        ]
                    }
