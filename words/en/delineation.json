                            },
                            {
                                "target_lang_word": "szkic",
                                "target_lang_sense_clarification": "wstępny rysunek lub plan"
                            },
                            {
                                "target_lang_word": "wyrys",
                                "target_lang_sense_clarification": "graficzne przedstawienie konturów"
                            }
                        ]
