                "translations": [
                    {
                        "translation_id": "1b577c99-be24-4b64-a238-6ac3a7870d91",
                        "source_entry_id": "f0af0ede-f578-3091-88e3-9b7668548ca1",
                        "source_sense_id": "77af3a5b-023d-3b7c-9fd7-7758bb6bb2b7",
                        "target_lang_word": "prejudice",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prejudice",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "889b4cd9-58d1-3bc3-8a04-67083bd58728",
                                        "entry_id": "7f9b607b-25c5-3509-b8f0-ecd06cdb5a56",
                                        "glosses": [
                                            "An adverse judgment or opinion formed beforehand or without knowledge of the facts."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5055d5c2-0b9a-4df5-bd86-b6c7936c64ba",
                                                "sense_id": "889b4cd9-58d1-3bc3-8a04-67083bd58728",
                                                "text": "Though often misled by prejudice and passion, he was emphatically an honest man."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5718e8e4-faeb-3b14-b375-adcf29a8e215",
                                        "entry_id": "7f9b607b-25c5-3509-b8f0-ecd06cdb5a56",
                                        "glosses": [
                                            "A preconception, any preconceived opinion or feeling, whether positive or negative."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c558378-ffe7-44a9-87c9-8065cb8c10aa",
                                                "sense_id": "5718e8e4-faeb-3b14-b375-adcf29a8e215",
                                                "text": "Morality is but a prejudice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43c66e98-e934-3e78-93a8-678a8eabf76e",
                                        "entry_id": "7f9b607b-25c5-3509-b8f0-ecd06cdb5a56",
                                        "glosses": [
                                            "An irrational hostile attitude, fear or hatred towards a particular group, race or religion."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3192da18-1bd2-48ea-9add-2d8bf304bae3",
                                                "sense_id": "43c66e98-e934-3e78-93a8-678a8eabf76e",
                                                "text": "I am free of all prejudices. I hate everyone equally."
                                            },
                                            {
                                                "example_id": "68b0c0bb-828f-4f31-9e3e-9d1e55eb613b",
                                                "sense_id": "43c66e98-e934-3e78-93a8-678a8eabf76e",
                                                "text": "\"I did not thoroughly understand what you were telling your brother,\" cried Emma, \"about your friend Mr. Graham's intending to have a bailiff from Scotland, to look after his new estate. But will it answer? Will not the old prejudice be too strong?\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c567947-7310-3daf-ac65-5d0595bea5ba",
                                        "entry_id": "7f9b607b-25c5-3509-b8f0-ecd06cdb5a56",
                                        "glosses": [
                                            "Knowledge formed in advance; foresight, presaging."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0db73152-4118-42e7-ac06-c785b9daa739",
                                                "sense_id": "0c567947-7310-3daf-ac65-5d0595bea5ba",
                                                "text": "[…] the first did in the forepart sit, / That nought mote hinder his quicke preiudize: / He had a sharpe foresight, and working wit […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ecd4b099-f1f3-39c1-95cc-2544ad5bb4f3",
                                        "entry_id": "7f9b607b-25c5-3509-b8f0-ecd06cdb5a56",
                                        "glosses": [
                                            "Mischief; hurt; damage; injury; detriment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5bdf2377-aaa5-48d8-a80b-3ab595544440",
                                                "sense_id": "ecd4b099-f1f3-39c1-95cc-2544ad5bb4f3",
                                                "text": "England and France might, through their amity, / Breed him some prejudice."
                                            },
                                            {
                                                "example_id": "84c3fbf6-1b34-4e76-b798-f9a0f2a27fa8",
                                                "sense_id": "ecd4b099-f1f3-39c1-95cc-2544ad5bb4f3",
                                                "text": "For Pens, so usefull for Scholars to note the remarkables they read, with an impression easily deleble without prejudice to the Book."
                                            },
                                            {
                                                "example_id": "c0e5a3d4-edfc-4a14-b69b-7341af179b8b",
                                                "sense_id": "ecd4b099-f1f3-39c1-95cc-2544ad5bb4f3",
                                                "text": "for no injury is thereby done to any one, no prejudice to another man's goods"
                                            },
                                            {
                                                "example_id": "1e8b5d88-15e2-4804-91c3-3eda10610725",
                                                "sense_id": "ecd4b099-f1f3-39c1-95cc-2544ad5bb4f3",
                                                "text": "We both of us happen’d to know, as well as the Stationer, that Riddlesden the Attorney, was a very Knave. He had half ruin’d Miss Read’s Father by drawing him in to be bound for him. By his Letter it appear’d, there was a secret Scheme on foot to the Prejudice of Hamilton, (Suppos’d to be then coming over with us,) and that Keith was concern’d in it with Riddlesden. [...]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "prejudice",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dba13d4c-c562-3c76-ace6-ec2118c85e68",
                                        "entry_id": "629a43e1-c82c-35ce-b904-475846311dfd",
                                        "glosses": [
                                            "To have a negative impact on (someone's position, chances etc.)."
