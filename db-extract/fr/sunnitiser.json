                "senses": [
                    {
                        "sense_id": "c5420a1e-29d8-313c-bb9f-a5979fe72a6a",
                        "entry_id": "fa2bf6bb-5ac6-3dee-936d-066700ca8206",
                        "glosses": [
                            "Donner un caractère sunnite à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42bc5660-9adc-4a52-b711-c0b6dd9eaa13",
                                "sense_id": "c5420a1e-29d8-313c-bb9f-a5979fe72a6a",
                                "text": "Au contraire ces initiatives visaient à \"sunnitiser\", à assimiler l’alévisme aux thèses sunnites et surtout à diviser cette communauté."
                            },
                            {
                                "example_id": "f376983b-a75b-47bb-9411-959868eab9a1",
                                "sense_id": "c5420a1e-29d8-313c-bb9f-a5979fe72a6a",
                                "text": "D'autre part, le rêve de l'Arabie séoudite et du Qatar est de \"sunnitiser\" les régimes de tous ces pays...la Syrie fait obstacle...!"
                            },
                            {
                                "example_id": "69da1ce0-89e9-49ab-aa96-3f6537ab1f8b",
                                "sense_id": "c5420a1e-29d8-313c-bb9f-a5979fe72a6a",
                                "text": "Ce que tu veux, c'est \"sunnitiser\" les chiites ou les tuer, les exterminer."
                            }
                        ]
                    }
