                        ],
                        "form": "obstakeltje"
                    },
                    {
                        "form_id": "6f421636-cd4c-4cca-a2aa-3856b8b7d930",
                        "entry_id": "e7bb0300-96d1-305e-b3b0-2ea98fd3427c",
                        "tags": [
                            "diminutive",
                            "plural"
                        ],
                        "form": "obstakeltjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d6f57edb-2cde-31db-b81f-cba919361d31",
                        "entry_id": "e7bb0300-96d1-305e-b3b0-2ea98fd3427c",
                        "glosses": [
                            "iets dat de voortgang van iets anders belemmert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "869f0d70-dfcb-4c64-9716-32f587c7ffae",
                                "sense_id": "d6f57edb-2cde-31db-b81f-cba919361d31",
                                "text": "Doelbewuste obstakels of hindernissen kunnen bijvoorbeeld zijn een muur, hek, heg, sloot of paal."
                            },
                            {
                                "example_id": "df07f16f-6858-4b78-9b72-8ef1bc4ada66",
                                "sense_id": "d6f57edb-2cde-31db-b81f-cba919361d31",
                                "text": "School, stelde hij, is het grootste obstakel om te leren"
                            },
                            {
                                "example_id": "9e3930ce-52c1-41d0-b735-cb90a7383293",
                                "sense_id": "d6f57edb-2cde-31db-b81f-cba919361d31",
                                "text": "Het was alsof ik bij een onverwacht obstakel minder snel ging lopen of ik stopte zelfs helemaal totdat er iemand anders op het pad langskwam."
                            },
                            {
                                "example_id": "34f2026d-4f34-4821-a170-701691786069",
                                "sense_id": "d6f57edb-2cde-31db-b81f-cba919361d31",
                                "text": "Je zult vast obstakels tegenkomen of het eng vinden om daadwerkelijk alleen op reis te gaan, maar dit is met tijd en planning te voorkomen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3c7dd826-7b55-4b40-b44d-49ddb2dc6cf8",
                        "source_entry_id": "e7bb0300-96d1-305e-b3b0-2ea98fd3427c",
                        "source_sense_id": "d6f57edb-2cde-31db-b81f-cba919361d31",
                        "target_lang_word": "Hindernis",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hindernis",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2db4c298-0bac-3902-afab-46e89e348c83",
                                        "entry_id": "de0b59c5-e149-3413-8679-68039921ad67",
                                        "glosses": [
                                            "Gegenstand, der das Weiterkommen verhindert oder behindert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43cde951-f903-48d9-89a6-c2c012b35f94",
                                                "sense_id": "2db4c298-0bac-3902-afab-46e89e348c83",
                                                "text": "„Karl Joswig konnte und wollte er nicht als Hindernis ansehen, da Eddi Sillus es allein übernommen hatte, mit unserem Lieblingswärter fertig zu werden - Eddi, der schon früh den Meistergürtel der nordwestdeutschen Judokas erworben hatte.“"
                                            },
                                            {
                                                "example_id": "2f5a8e41-7239-4f79-b995-ca31e7d1fbbd",
                                                "sense_id": "2db4c298-0bac-3902-afab-46e89e348c83",
                                                "text": "„Es gab noch ein anderes Hindernis auf meinem Schulweg.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f6417861-ff70-3290-8714-c33afe2836fa",
                                        "entry_id": "de0b59c5-e149-3413-8679-68039921ad67",
                                        "glosses": [
                                            "eine Tatsache, die eine Entwicklung verhindert oder behindert"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b6fbe64-f65e-4329-bd57-9f86cd0ad08e",
                                                "sense_id": "f6417861-ff70-3290-8714-c33afe2836fa",
                                                "text": "„Erotik ist Überwindung von Hindernissen. Das verlockendste und populärste Hindernis ist die Moral.“"
                                            },
                                            {
                                                "example_id": "deed5b89-a19a-4b39-90be-f31fe7c9f3f5",
                                                "sense_id": "f6417861-ff70-3290-8714-c33afe2836fa",
                                                "text": "Ich sehe keine Hindernisse, die einem Vertragsabschluss im Wege stehen könnten."
                                            },
                                            {
                                                "example_id": "5dad2b78-4deb-412e-935f-5238812a4417",
                                                "sense_id": "f6417861-ff70-3290-8714-c33afe2836fa",
                                                "text": "„So sollte sich meiner Wahl immer ein Hindernis entgegensetzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "3d8e394e-b530-379b-9028-9316e271b722",
                                        "entry_id": "de0b59c5-e149-3413-8679-68039921ad67",
                                        "glosses": [
                                            "durch Springen zu überwindende Konstruktion, zum Beispiel beim Hindernislauf oder beim Spring- oder Vielseitigkeitsreiten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9184b899-89ee-4feb-b29d-48a4bf143c27",
                                                "sense_id": "3d8e394e-b530-379b-9028-9316e271b722",
                                                "text": "Das nächste Hindernis ist die Mauer, vor der die Stute das letzte Mal scheute."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "68fbc43e-5ef2-3aa3-8bb8-92b33c842d34",
                                        "entry_id": "de0b59c5-e149-3413-8679-68039921ad67",
                                        "glosses": [
                                            "regelkonform zu durchfahrendes Kegelpaar auf einem Parcours"
                                        ],
                                        "tags": [
                                            "Fahrsport"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe397161-ac40-4d79-9cdb-ec8ab17104f5",
                                                "sense_id": "68fbc43e-5ef2-3aa3-8bb8-92b33c842d34",
                                                "text": "Wer stellt heute die Hindernisse auf?"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d3c4702d-021f-4575-a7ad-6e06795a54fb",
                        "source_entry_id": "e7bb0300-96d1-305e-b3b0-2ea98fd3427c",
                        "source_sense_id": "d6f57edb-2cde-31db-b81f-cba919361d31",
                        "target_lang_word": "obstacle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "obstacle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "93b83133-4b03-3702-94d6-2d7786afcf80",
                                        "entry_id": "1179b8c4-3f55-30db-8c9c-3c614c5a5148",
                                        "glosses": [
                                            "Something that impedes, stands in the way of, or holds up progress, either physically or figuratively"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c287241-a1ed-42c6-bb6e-531d416550a3",
                                                "sense_id": "93b83133-4b03-3702-94d6-2d7786afcf80",
                                                "text": "A big obstacle to understanding the manual was that it had been poorly translated from the Japanese."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a31f99da-90bd-4764-b01d-8c0cb1a5d3d3",
                        "source_entry_id": "e7bb0300-96d1-305e-b3b0-2ea98fd3427c",
                        "source_sense_id": "d6f57edb-2cde-31db-b81f-cba919361d31",
                        "target_lang_word": "obstacle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "obstacle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1ca37e80-6ad5-33c2-933d-d9081e8c4e31",
                                        "entry_id": "419dd12a-9ed9-369c-a750-2397723e2959",
                                        "glosses": [
                                            "Ce qui empêche de passer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e857400-c4cb-49d8-a6c8-cda694fbaefa",
                                                "sense_id": "1ca37e80-6ad5-33c2-933d-d9081e8c4e31",
                                                "text": "L’assaillant trouvait un premier obstacle formé d’une barrière de bois couverte d’un appentis."
                                            },
                                            {
                                                "example_id": "f6d0beb9-8894-4e64-894f-0828d72b8c6b",
                                                "sense_id": "1ca37e80-6ad5-33c2-933d-d9081e8c4e31",
                                                "text": "Dans les plaines subatlantiques, les seuls obstacles naturels étaient les cours d’eau."
                                            },
                                            {
                                                "example_id": "acfb3d0b-dfe8-4380-a373-4d01da1db91e",
                                                "sense_id": "1ca37e80-6ad5-33c2-933d-d9081e8c4e31",
                                                "text": "À cause des obstacles de chaque côté de la grand-route, il éprouva des difficultés à faire tourner ses chars et half-tracks pour les lancer à l'attaque."
                                            },
                                            {
                                                "example_id": "f40c92b9-e1c5-4a3c-9f00-3245349e32f1",
                                                "sense_id": "1ca37e80-6ad5-33c2-933d-d9081e8c4e31",
                                                "text": "Cet animal s’oriente dans l’espace par écholocation : il émet des sons de très haute fréquence et utilise l’écho renvoyé par les obstacles ou les proies pour les localiser."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7dbb90c-88d5-3274-ac65-59d66a261820",
                                        "entry_id": "419dd12a-9ed9-369c-a750-2397723e2959",
                                        "glosses": [
                                            "Sorte de barrière que l'on installe sur le parcours de certaines courses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f1cd631-aaea-4684-94a8-cbbd27f57a13",
                                                "sense_id": "c7dbb90c-88d5-3274-ac65-59d66a261820",
                                                "text": "Saut d’obstacles."
                                            },
                                            {
                                                "example_id": "341b6a55-cbb6-47f6-8c8f-c36aa2e14931",
                                                "sense_id": "c7dbb90c-88d5-3274-ac65-59d66a261820",
                                                "text": "Amil Event a donc reçu pour consigne de prévoir une vingtaine d’obstacles simples mais surprenants sur un parcours d’environ cinq kilomètres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a053fdff-b877-3532-83f3-32353c839cb9",
                                        "entry_id": "419dd12a-9ed9-369c-a750-2397723e2959",
                                        "glosses": [
                                            "Ce qui empêche qu’une personne n’arrive à son but, ne parvienne à ses fins ou qu’une chose ne se fasse, ne réussisse."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18574d74-b5cf-4266-8d2e-2f3943d1d249",
                                                "sense_id": "a053fdff-b877-3532-83f3-32353c839cb9",
                                                "text": "Si des obstacles vous barrent la route, ne baissez pas les bras pour autant."
                                            },
                                            {
                                                "example_id": "73d03b67-2d43-4425-9894-30ef949cf3e5",
                                                "sense_id": "a053fdff-b877-3532-83f3-32353c839cb9",
                                                "text": "Vaincre, surmonter un obstacle."
                                            },
                                            {
                                                "example_id": "1e797b36-7eac-4b3f-8686-102af5c471c0",
                                                "sense_id": "a053fdff-b877-3532-83f3-32353c839cb9",
                                                "text": "Triompher d’un obstacle."
                                            },
                                            {
                                                "example_id": "e5e8d292-146e-4613-83c8-57b31a697255",
                                                "sense_id": "a053fdff-b877-3532-83f3-32353c839cb9",
                                                "text": "Faire naître un obstacle, des obstacles."
                                            },
                                            {
                                                "example_id": "cac0c61b-28c0-4936-ac4e-920cdbfcaec4",
                                                "sense_id": "a053fdff-b877-3532-83f3-32353c839cb9",
                                                "text": "Rencontrer un obstacle."
                                            },
                                            {
                                                "example_id": "76e37d51-3734-4f67-9d05-e3364179c923",
                                                "sense_id": "a053fdff-b877-3532-83f3-32353c839cb9",
                                                "text": "Faire obstacle à quelqu’un."
                                            },
                                            {
                                                "example_id": "9c1319ed-bf57-4cde-a451-45a7372829b0",
                                                "sense_id": "a053fdff-b877-3532-83f3-32353c839cb9",
                                                "text": "Mettre obstacle à quelque chose."
                                            },
                                            {
                                                "example_id": "0011cd0b-a6f9-44ab-9eb0-b191ce403c23",
                                                "sense_id": "a053fdff-b877-3532-83f3-32353c839cb9",
                                                "text": "Il n’y a nul obstacle."
                                            },
                                            {
                                                "example_id": "7d043574-4ea9-4668-ac8d-82274b0ec44f",
                                                "sense_id": "a053fdff-b877-3532-83f3-32353c839cb9",
                                                "text": "Il lui a opposé des obstacles insurmontables, invincibles."
                                            },
                                            {
                                                "example_id": "59c04fe2-8f21-49d3-a2e2-b3981fe8afa8",
                                                "sense_id": "a053fdff-b877-3532-83f3-32353c839cb9",
                                                "text": "Aucun obstacle ne l’arrête."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
