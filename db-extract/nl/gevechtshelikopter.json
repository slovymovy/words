                                        "sense_id": "af6a70c3-aabe-3822-afb7-943da14d48cc",
                                        "entry_id": "0a5f53d4-c9a8-3a0e-9e1b-ac66c3b21fcf",
                                        "glosses": [
                                            "A fictitious gender assigned or suggested in quips, used to dismiss non-binary gender identities, and sometimes also transness in general."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "derogatory",
                                            "humorous",
                                            "neologism",
                                            "offensive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b36a4e59-be8f-4e7f-94a1-1cbef564f5a4",
                                                "sense_id": "af6a70c3-aabe-3822-afb7-943da14d48cc",
                                                "text": "[…] but that wasn't “inclusive” enough, so now the gender listing isn't a checkbox with either “male” or “female” — it's a fill-in-the-blank where you can list anything from peanut butter to an attack helicopter as your gender. […]"
                                            },
                                            {
                                                "example_id": "d8cb31d0-40b8-46f2-8200-51e1ea8271ab",
                                                "sense_id": "af6a70c3-aabe-3822-afb7-943da14d48cc",
                                                "text": "'I identify as an attack helicopter' is a regular dismissal of non-binary identities; hearing this can be a weekly occurrence. The support of other non-binary people and bibliotherapy of good non-binary sources can be a remedy to this."
                                            },
                                            {
                                                "example_id": "f5c505f6-371f-4ca2-8602-ba462a919ec2",
                                                "sense_id": "af6a70c3-aabe-3822-afb7-943da14d48cc",
                                                "text": "[…] going to be spending a fair amount of time waiting like a twit in a cosmetic store while your wife / girlfriend / cis-gender / attack helicopter reads every damn label on every damn blusher, or pillar of lipstick, or whatever it is."
                                            }
                                        ]
                                    }
                                ]
