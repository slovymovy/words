{
    "word_family": [
        "responsabilité",
        "responsabiliser",
        "responsabilisation",
        "irresponsable",
        "irresponsabilité"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "08f4aece-5da8-3f80-b0d2-0dc61d0c075a",
                    "sense_definition": "Qui doit répondre de ses actes ou de ceux d'autrui, qui en est la cause ou le garant légal ou moral.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "obligation_morale_ou_legale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chacun doit être <w>responsable</w> de ses propres actes et assumer ses choix."
                        },
                        {
                            "text": "Le conducteur a été jugé entièrement <w>responsable</w> du grave accident de la route."
                        }
                    ],
                    "synonyms": [
                        "garant",
                        "comptable"
                    ],
                    "antonyms": [
                        "irresponsable"
                    ],
                    "common_phrases": [
                        "être responsable de",
                        "se sentir responsable"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7d330c16-7fa8-3a8b-bd7f-92b8548b75bd",
                    "sense_definition": "Personne chargée de diriger, de gérer ou de superviser une activité, un service ou une équipe.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "fonction_ou_charge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai demandé à parler au <w>responsable</w> du magasin afin de régler ce litige."
                        },
                        {
                            "text": "La nouvelle <w>responsable</w> de l'équipe prendra officiellement ses fonctions dès lundi."
                        }
                    ],
                    "synonyms": [
                        "chef",
                        "dirigeant",
                        "gestionnaire",
                        "superviseur"
                    ],
                    "common_phrases": [
                        "responsable de projet",
                        "responsable des ventes"
                    ]
                },
                {
                    "sense_id": "ddbbf757-d819-3d76-a5f3-b8ac3f704624",
                    "sense_definition": "Personne à l'origine d'un fait, d'une faute ou d'un dommage.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "auteur_d_un_acte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les enquêteurs ont fini par identifier les <w>responsables</w> de ces dégradations nocturnes."
                        },
                        {
                            "text": "Il refuse obstinément d'admettre qu'il est le <w>responsable</w> de cet échec."
                        }
                    ],
                    "synonyms": [
                        "auteur",
                        "coupable"
                    ],
                    "common_phrases": [
                        "trouver le responsable",
                        "identifier les responsables"
                    ]
                }
            ]
        }
    ]
}