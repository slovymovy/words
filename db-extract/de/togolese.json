                "senses": [
                    {
                        "sense_id": "253167e7-bb98-3086-a0fb-c87f08558e07",
                        "entry_id": "9c261736-7030-3376-990d-913690449f71",
                        "glosses": [
                            "Staatsbürger von Togo"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41474207-8fac-4023-aa38-231514d0b107",
                                "sense_id": "253167e7-bb98-3086-a0fb-c87f08558e07",
                                "text": "„In Deutschland lebende Togolesen wollen in Berlin gegen die vom Militär unterstützte Machtübernahme Faure Gnassingbes protestieren.“"
                            },
                            {
                                "example_id": "065d59df-198b-459c-9817-97587ae82a1a",
                                "sense_id": "253167e7-bb98-3086-a0fb-c87f08558e07",
                                "text": "„Als die Togolesen im Frühjahr 1960 ihre Unabhängigkeit begingen, war auch ein älterer Herr zugegen, den man dort nicht unbedingt erwartet hätte: Herzog Adolph Friedrich zu Mecklenburg, von 1912 bis 1914 letzter deutscher Gouverneur von Togo.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
