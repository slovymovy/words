                "senses": [
                    {
                        "sense_id": "c712874a-2b0e-3f94-a839-2c4494d3b303",
                        "entry_id": "59a04b69-1c04-3d86-8bab-ef9f4eecf14c",
                        "glosses": [
                            "cecha tego, co praworządne; cecha tych, którzy są praworządni"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f21ccd9-1038-466d-9af1-859a2a4e82bf",
                                "sense_id": "c712874a-2b0e-3f94-a839-2c4494d3b303",
                                "text": "Pan bowiem zapewnia praworządność swojemu ludowi / i lituje się nad swymi sługami"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5b845018-e965-4a92-ac14-3815ad05cbd1",
                        "source_entry_id": "59a04b69-1c04-3d86-8bab-ef9f4eecf14c",
                        "source_sense_id": "c712874a-2b0e-3f94-a839-2c4494d3b303",
                        "target_lang_word": "law and order",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "law and order",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eea447e2-d1cd-36de-9864-5234ad35524d",
                                        "entry_id": "1eaa0ea3-2f6a-372c-997b-b9043994b1b0",
                                        "glosses": [
                                            "The principles under which the world and its components operate."
                                        ],
                                        "tags": [
                                            "dated",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b953162-b6c2-46f1-93b0-d714918c6b29",
                                                "sense_id": "eea447e2-d1cd-36de-9864-5234ad35524d",
                                                "text": "But all evill of punishment ariseth from evill of fault and this evill of fault is from the creature itself, breaking the Law and Order that God hath set to it."
                                            },
                                            {
                                                "example_id": "402f2ce7-76e1-468e-aa35-2319ee71aba0",
                                                "sense_id": "eea447e2-d1cd-36de-9864-5234ad35524d",
                                                "text": "For, as in all Monarchies, it is the Law and Order of God Almighty that Subjects receive from, and not give unto their Soveraigne Lawes"
                                            },
                                            {
                                                "example_id": "857ceab5-a161-4511-a9e8-3c8d12c9c00a",
                                                "sense_id": "eea447e2-d1cd-36de-9864-5234ad35524d",
                                                "text": "Neither do Law and Order agree in the reciprocation of Names only, but also in their Natures. Hence Plato oft useth them promiscuously one for the other, and joins them together as exegetic each of other."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e084191d-1989-3a54-a94a-13ac75ed3fea",
                                        "entry_id": "1eaa0ea3-2f6a-372c-997b-b9043994b1b0",
                                        "glosses": [
                                            "The strict enforcement of law, statutes, and social conventions."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f677816f-6c4f-4551-9dd7-03e6640d7b69",
                                                "sense_id": "e084191d-1989-3a54-a94a-13ac75ed3fea",
                                                "text": "The government’s default approach to labor disputes has been to treat them as a threat to law and order. After a widely reported miners’ strike in the northeastern city of Shuangyashan in 2016, for example, the Public Security Bureau arrested 30 people for what it called serious criminal charges."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "48a09e5b-c83d-44a6-b823-9793008ceb7b",
                        "source_entry_id": "59a04b69-1c04-3d86-8bab-ef9f4eecf14c",
                        "source_sense_id": "c712874a-2b0e-3f94-a839-2c4494d3b303",
                        "target_lang_word": "Rechtsstaatlichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rechtsstaatlichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6952ce64-c506-3e8d-919f-7fdbfe5977c7",
                                        "entry_id": "7ab28e52-7683-3262-b0c5-6f51dfcdff01",
                                        "glosses": [
                                            "abstraktes Prinzip, nach dem staatliche Gewalt nur im Rahmen einer Verfassung und auf Grundlage allgemeiner Gesetzgebung ausgeübt werden darf"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7feabd1a-b149-4c98-9ebb-71a1552204d9",
                                                "sense_id": "6952ce64-c506-3e8d-919f-7fdbfe5977c7",
                                                "text": "„Mit Anhörungen der Terrorverdächtigen und Modernisierungen will Washington den Anschein von Rechtsstaatlichkeit wahren.“"
                                            },
                                            {
                                                "example_id": "25cf474f-2ad9-42da-b052-806a09450cff",
                                                "sense_id": "6952ce64-c506-3e8d-919f-7fdbfe5977c7",
                                                "text": "„Diese Rechtsstaatlichkeit garantierte eine gewisse Gleichbehandlung der Menschen, aber Österreich war natürlich ein absolutistisches Regime.“"
                                            },
                                            {
                                                "example_id": "3fd02b3e-c7a6-4f4a-a42e-e61d956a503c",
                                                "sense_id": "6952ce64-c506-3e8d-919f-7fdbfe5977c7",
                                                "text": "„Es war ein massiver Eingriff in die Rechtsstaatlichkeit und bewog den obersten Richter des Landes, Chief Justice Sir Robert Tredgold, zum Rücktritt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
