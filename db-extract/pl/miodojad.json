                        "source_entry_id": "6869648b-8815-33e9-9d7b-8e8d050f9c0b",
                        "source_sense_id": "01455fb7-0649-3723-8660-b2ae3dd58675",
                        "target_lang_word": "honeyeater",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "honeyeater",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "67fff212-2abb-3739-a791-7cf467d9e4a5",
                                        "entry_id": "48fa6f49-db06-3780-aba6-44fd28fe4ea4",
                                        "glosses": [
                                            "Any of the many Australasian birds of the family Meliphagidae, which have a tongue adapted for obtaining nectar from flowers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8af2be44-b0f5-4715-8987-6c13eb7d0ed3",
                                                "sense_id": "67fff212-2abb-3739-a791-7cf467d9e4a5",
                                                "text": "1985, Hugh A. Ford, David C. Paton, Chapter 12: Habitat Selection in Australian Honeyeaters, with Special Reference to Nectar Productivity, Martin L. Cody (editor), Habitat Selection in Birds, 376,\nFor all honeyeaters combined and White-naped Honeyeaters, the only other common species, there is actually a negative correlation between abundance and nectar productivity […] ."
                                            },
                                            {
                                                "example_id": "f0144322-f17b-4969-9c23-70fba3c5a6ec",
                                                "sense_id": "67fff212-2abb-3739-a791-7cf467d9e4a5",
                                                "text": "The spiny-cheeked honeyeater has a more generalized diet and the gastrointestinal tract is similar structurally and proportionally to other honeyeaters."
                                            },
                                            {
                                                "example_id": "2b038aea-6eb8-4bd6-b2be-23c19dcbe864",
                                                "sense_id": "67fff212-2abb-3739-a791-7cf467d9e4a5",
                                                "text": "The adopted sequence of genera of Australian honeyeaters follows that implied by the phylogeny of Driskell and Christidis (2004)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
