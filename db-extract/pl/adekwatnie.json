                    {
                        "translation_id": "fb17a029-45ad-4f67-98d8-78adca80b5ab",
                        "source_entry_id": "a672a2ac-36e0-3adf-b10a-52e7c052600c",
                        "source_sense_id": "e5b839d2-e165-344c-b91f-beb38b2f2e97",
                        "source_sense_description": "im rechten Verhältnis zu den Anforderungen, Erwartungen, Mühen",
                        "target_lang_word": "angebracht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "angebracht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f278bf48-1010-320b-908c-b217f1be8f0b",
                                        "entry_id": "41196f61-7bbd-3962-a826-9099ff5da4ee",
                                        "glosses": [
                                            "in einem bestimmten Zusammenhang richtig sein, für einen bestimmten Fall genau passend sein, einer bestimmten Situation angemessen sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97f1ff77-6925-4968-9f8b-e874ad4f756c",
                                                "sense_id": "f278bf48-1010-320b-908c-b217f1be8f0b",
                                                "text": "„Bei dieser Politikeraussage ist Skepsis durchaus angebracht.“"
                                            },
                                            {
                                                "example_id": "d7ca7822-77ff-40ae-873f-53e1220f13e8",
                                                "sense_id": "f278bf48-1010-320b-908c-b217f1be8f0b",
                                                "text": "„Deine Bemerkung im Meeting war überhaupt nicht angebracht!“"
                                            },
                                            {
                                                "example_id": "6bf2eba7-da39-4580-8689-1c3822b719cd",
                                                "sense_id": "f278bf48-1010-320b-908c-b217f1be8f0b",
                                                "text": "„Nach unserem hervorragend bewältigten Projekt ist eine Gehaltserhöhung angebracht.“"
                                            },
                                            {
                                                "example_id": "f952331a-1b7c-4485-af94-e898308b7f7b",
                                                "sense_id": "f278bf48-1010-320b-908c-b217f1be8f0b",
                                                "text": "„Statt eine Gehaltserhöhung zu verlangen wäre es angebrachter, auf die momentane wirtschaftliche Situation der Firma zu schauen.“"
                                            },
