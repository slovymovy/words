{
    "word_family": [
        "scuttle"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8d6ab0d8-4eb4-3486-85e5-f7262e0b116e",
                    "sense_definition": "Present participle of <w>scuttle</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mice were <w>scuttling</w> across the kitchen floor in the dark.",
                            "target_lang_translations": {
                                "ru": "Мыши в темноте <w>семенили</w> по полу кухни."
                            }
                        },
                        {
                            "text": "The navy was accused of deliberately <w>scuttling</w> the damaged warship.",
                            "target_lang_translations": {
                                "ru": "Военно-морской флот обвинили в преднамеренном <w>затоплении</w> поврежденного военного корабля."
                            }
                        }
                    ],
                    "common_phrases": [
                        "scuttling across",
                        "scuttling away"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени или герундий от глагола scuttle; быстрое семенение или затопление судна."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "семенящий",
                                "target_lang_sense_clarification": "о быстром беге мелкими шажками"
                            },
                            {
                                "target_lang_word": "суетливо бегущий",
                                "target_lang_sense_clarification": "о торопливом передвижении"
                            },
                            {
                                "target_lang_word": "затапливающий",
                                "target_lang_sense_clarification": "о преднамеренном пускании судна ко дну"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e6aca92c-552b-367f-9afd-e6eed3c51cc6",
                    "sense_definition": "A quick, hurried, scurrying movement or run.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We were startled by the sudden <w>scuttling</w> of tiny feet behind the wall.",
                            "target_lang_translations": {
                                "ru": "Нас испугало внезапное <w>семенение</w> крошечных лапок за стеной."
                            }
                        },
                        {
                            "text": "Constant frantic <w>scuttling</w> in the corridor kept the nervous patient awake.",
                            "target_lang_translations": {
                                "ru": "Постоянная нервная <w>беготня</w> в коридоре не давала уснуть беспокойному пациенту."
                            }
                        }
                    ],
                    "synonyms": [
                        "scurrying"
                    ],
                    "common_phrases": [
                        "faint scuttling",
                        "frantic scuttling"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстрое, торопливое движение короткими шажками; суетливая беготня или семенение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "семенение",
                                "target_lang_sense_clarification": "быстрый бег мелкими шажками"
                            },
                            {
                                "target_lang_word": "суетливая беготня",
                                "target_lang_sense_clarification": "торопливое шуршащее движение"
                            },
                            {
                                "target_lang_word": "перебежки",
                                "target_lang_sense_clarification": "быстрые перемещения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2611f3ad-b007-3907-90bb-f57ce616c118",
                    "sense_definition": "The deliberate act of sinking a vessel, especially one's own ship.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The deliberate <w>scuttling</w> of the fleet prevented the enemy from capturing the ships.",
                            "target_lang_translations": {
                                "ru": "Преднамеренное <w>затопление</w> флота помешало врагу захватить корабли."
                            }
                        },
                        {
                            "text": "Historians documented the secret <w>scuttling</w> of several merchant vessels in the bay.",
                            "target_lang_translations": {
                                "ru": "Историки задокументировали тайное <w>затопление</w> нескольких торговых судов в бухте."
                            }
                        }
                    ],
                    "synonyms": [
                        "sinking"
                    ],
                    "common_phrases": [
                        "deliberate scuttling",
                        "scuttling of the fleet"
                    ],
                    "target_lang_definitions": {
                        "ru": "Преднамеренное затопление судна, особенно собственной командой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "затопление",
                                "target_lang_sense_clarification": "умышленное пускание судна ко дну"
                            },
                            {
                                "target_lang_word": "самозатопление",
                                "target_lang_sense_clarification": "уничтожение собственного корабля путем затопления"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}