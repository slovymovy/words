                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e3ecf10-e351-4acb-9827-b6a99d10e8b7",
                                "sense_id": "dd008940-579a-3b19-8f3c-20e0bc59ee6d",
                                "text": "Elle a manifesté à Paris le 30 novembre et attend un nouveau rendez-vous d’ici une dizaine de jours au ministère de l’Agriculture et de la Souveraineté alimentaire (Masa)."
                            },
                            {
                                "example_id": "8aa4ad00-7b4d-42ce-a0b3-7d295b7c148d",
                                "sense_id": "dd008940-579a-3b19-8f3c-20e0bc59ee6d",
                                "text": "Agroalimentaire : Business France et la Sopexa renouvellent leurs conventions avec le Masa"
                            },
                            {
                                "example_id": "cfa5bde6-3875-436f-8c01-58535dbf030b",
                                "sense_id": "dd008940-579a-3b19-8f3c-20e0bc59ee6d",
                                "text": "Le Masa a appelé la restauration collective à se mobiliser pour atteindre l’objectif de 20 % de produits issus de l’agriculture biologique fixé par la loi Egalim, lors du conseil national de la restauration collective le 7 décembre 2023 : ce taux n’est que de 13 % selon une enquête."
                            }
                        ]
