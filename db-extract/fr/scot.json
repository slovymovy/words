                    {
                        "sense_id": "6c153220-dd6e-3feb-be9c-80213f7a36b8",
                        "entry_id": "92db2e84-b199-3694-a9e2-ec4085cdb008",
                        "glosses": [
                            "Document d’urbanisme définissant les orientations d'aménagement de l'espace urbain, péri-urbain et rural à l'échelle d'une agglomération ou d'un bassin de vie."
                        ],
                        "tags": [
                            "France"
                        ],
                        "examples": [
                            {
                                "example_id": "67e0b512-fa98-41cc-8c7d-8a2b8f0b5a6b",
                                "sense_id": "6c153220-dd6e-3feb-be9c-80213f7a36b8",
                                "text": "Concrètement, lorsqu’il existe un SCoT, la DTA n’est opposable qu’au SCoT et non au PLU, le PLU devant lui-même être compatible avec le SCoT."
                            },
                            {
                                "example_id": "e633cebe-4e38-4e2e-a959-f4b8d802794f",
                                "sense_id": "6c153220-dd6e-3feb-be9c-80213f7a36b8",
                                "text": "L’élaboration de ces plans (en particulier le SCoT) est une étape critique, car elle ouvre une période d’analyse et de débat sur l’occupation des sols dans la zone considérée."
                            }
                        ]
                    }
