                    "sense_definition": "A short verse or anthem chanted at intervals during a religious reading.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The choir sang a beautiful <w>respond</w> after the first reading.",
                            "target_lang_translations": {
                                "ru": "Хор спел красивый <w>респонсорий</w> после первого чтения.",
                                "tr": "Koro, ilk okumadan sonra güzel bir <w>responsorium</w> söyledi."
                            }
