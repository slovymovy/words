                    {
                        "sense_id": "4418222c-4aae-3423-ab57-3c992a5f8d15",
                        "entry_id": "a32e8fc6-b963-3b72-986d-b51df81955cb",
                        "glosses": [
                            "Recht, Werbung an bestimmten Orten in bestimmter Weise anzubringen"
