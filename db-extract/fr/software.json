                    {
                        "sense_id": "97707f9b-072e-349a-8eec-d3a0f3768a19",
                        "entry_id": "3006313f-f883-3926-8030-964b46371a7f",
                        "glosses": [
                            "Logiciel."
                        ],
                        "tags": [
