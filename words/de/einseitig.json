                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Durch das hohe Fenster an der Nordwand wird das gesamte Zimmer nur <w>einseitig</w> belichtet."
                        },
                        {
                            "text": "Wegen der Baustelle war die schmale Brücke für Fahrzeuge mehrere Tage lang nur <w>einseitig</w> befahrbar."
