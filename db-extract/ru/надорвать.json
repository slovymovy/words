                        "entry_id": "33d881b4-4ce3-3bf4-96fc-e5ab9e1d760f",
                        "glosses": [
                            "to overstrain, to overtax, to undermine"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3463ef7f-b12f-4812-ac18-6e264b0e3721",
                                "sense_id": "c50c9be2-6d8a-36c0-83aa-ef8172414612",
                                "text": "надорва́ть свои́ си́лы",
                                "translation": "to overtax one's strength; knock oneself out",
                                "english": "to overtax one's strength; knock oneself out"
                            },
                            {
                                "example_id": "6ffeee8e-ceb5-4e53-9c8a-7bb21feaf8b6",
                                "sense_id": "c50c9be2-6d8a-36c0-83aa-ef8172414612",
                                "text": "надорва́ть себе́ го́лос",
                                "translation": "to overstrain one's voice",
                                "english": "to overstrain one's voice"
                            },
                            {
                                "example_id": "301200e9-47c6-49f9-85d0-5ff5c5c70773",
                                "sense_id": "c50c9be2-6d8a-36c0-83aa-ef8172414612",
                                "text": "надорва́ть душу кому́-либо",
                                "translation": "to rend someone's heart; harrow someone's soul",
                                "english": "to rend someone's heart; harrow someone's soul"
                            },
                            {
                                "example_id": "6b58b6bd-d9f6-4967-b0c1-71f2ffbbd915",
                                "sense_id": "c50c9be2-6d8a-36c0-83aa-ef8172414612",
                                "text": "надорва́ть живо́тики",
                                "translation": "≈ to split one's sides with laughter",
                                "english": "≈ to split one's sides with laughter"
                            }
                        ]
                    }
