                "senses": [
                    {
                        "sense_id": "070fb873-4282-3a2c-ab47-e682ccba4466",
                        "entry_id": "a674ad52-8f1f-30a0-8495-b0531f3434bb",
                        "glosses": [
                            "Képi, coiffure portée par des militaires ou des policiers."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc7b75a7-471b-4397-ba7e-218af797236d",
                                "sense_id": "070fb873-4282-3a2c-ab47-e682ccba4466",
                                "text": "Quand il s’amène tout seul, le griveton, avec son petit kébour, ses molletières et son ceinturon, faut voir la gueule qu’elles font !"
                            },
                            {
                                "example_id": "fb9f3869-cfb3-42bd-8fd7-095b2dd524a0",
                                "sense_id": "070fb873-4282-3a2c-ab47-e682ccba4466",
                                "text": "Les kébours des sergots, la grande boutique déserte, les éclats de magnésium des photographes qui, du fond de l’arrière-boutique, viennent zébrer les glaces de la vitrine, joints aux propos déconnants qu’il recueille, le ramonent à zéro."
                            },
                            {
                                "example_id": "a295d673-64d5-41cd-8cf6-333f10aae655",
                                "sense_id": "070fb873-4282-3a2c-ab47-e682ccba4466",
                                "text": "— T’es complètement cinglé ! commence-t-il, en me tendant mon kébour, ramassé par un passant. Il ne faut jamais partir seul comme cela. C’est beaucoup trop risqué !"
                            }
                        ]
                    },
                    {
                        "sense_id": "124e3274-8ee3-3f7a-80cd-a24c852fdcba",
                        "entry_id": "a674ad52-8f1f-30a0-8495-b0531f3434bb",
                        "glosses": [
                            "Policier ou gendarme en uniforme."
                        ],
                        "tags": [
                            "metonymically",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "1a7cb0ac-1a5d-442a-b860-363cfd00fe40",
                                "sense_id": "124e3274-8ee3-3f7a-80cd-a24c852fdcba",
                                "text": "J’avais jeté mon gardien de lapins comme un malpropre, très sûr qu’il irait aussitôt geindre et porter le deuil auprès de son commandant de corps urbain. Que foutre des peints en bleu. J’avais devant moi son crâne, son tout petit bâton de la soirée. À sa place, au kébour, la honte m’aurait envahi."
                            }
                        ]
                    }
