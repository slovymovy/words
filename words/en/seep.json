                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "abstract_seep",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fear began to <w>seep</w> into the community after the sudden news. ",
                            "target_lang_translations": {
                                "tr": "Ani haberlerin ardından topluluğun içine korku <w>sızmaya</w> başladı.",
                                "ru": "После внезапных новостей страх начал <w>проникать</w> в общество.",
                                "cs": "Po náhlých zprávách začal do komunity <w>pronikat</w> strach."
                            }
                        },
                        {
                            "text": "Doubts started to <w>seep</w> into his mind during the difficult exam.",
                            "target_lang_translations": {
                                "tr": "Zor sınav sırasında zihnine şüpheler <w>nüfuz etmeye</w> başladı.",
                                "ru": "Во время трудного экзамена в его сознание начали <w>прокрадываться</w> сомнения.",
                                "cs": "Během těžké zkoušky se mu do mysli začaly <w>vplížovat</w> pochybnosti."
                            }
