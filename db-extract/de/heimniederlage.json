                "senses": [
                    {
                        "sense_id": "1d601103-7a5e-3d8c-ab1a-d9b5be02a38a",
                        "entry_id": "c8b54c16-dfba-3da8-8def-4a00f0830d9a",
                        "glosses": [
                            "Niederlage der gastgebenden Mannschaft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "373bcd78-8466-408a-a8a7-7376e7eef3db",
                                "sense_id": "1d601103-7a5e-3d8c-ab1a-d9b5be02a38a",
                                "text": "„Nach einer Heimniederlage im Hinspiel kam der BVB in einem europäischen Wettbewerb noch nie weiter.“"
                            },
                            {
                                "example_id": "0cf62847-8e56-4b02-b2e2-d58b03bd4a76",
                                "sense_id": "1d601103-7a5e-3d8c-ab1a-d9b5be02a38a",
                                "text": "„Die Bayern hingegen kassierten die erste Heimniederlage dieser Saison (Bilanz: 18 Siege, drei Remis, eine Niederlage).“"
                            },
                            {
                                "example_id": "0caa47ef-9f10-4e7d-a67b-d2f593b0bd46",
                                "sense_id": "1d601103-7a5e-3d8c-ab1a-d9b5be02a38a",
                                "text": "„Ronaldos drittes Tor machte den höchsten Auswärtssieg der Spanier in der UEFA Champions League perfekt, während es für Galatasaray die höchste Heimniederlage im Europapokal war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
