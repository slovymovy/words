                        "glosses": [
                            "de kortse avond van het jaar (rond 21 juni op het noordelijk halfrond)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a166bc63-de4b-4244-8601-ca730812bed9",
                                "sense_id": "79e8bcf9-34a1-3b28-abbf-ba4115eb5b19",
                                "text": "We vieren midzomeravond bij de ouders van een klasgenootje van Acht, in hun tuin ter grootte van een klein park en aan een lange tafel met veldboeketten."
                            },
                            {
                                "example_id": "57905229-0fc4-4145-aed3-39e37b1c3f25",
                                "sense_id": "79e8bcf9-34a1-3b28-abbf-ba4115eb5b19",
                                "text": "Ter gelegenheid van het 40-jarig bestaan van de jaarlijkse orgelconcertserie in de dorpskerk van Den Ham, werd op 20 juni 2015 eenmalig een orgelconcours gehouden. Het concours was tevens onderdeel van de midzomeravond in Den Ham."
                            },
                            {
                                "example_id": "55fbbdaf-f78d-4d30-8422-c74122cd01b4",
                                "sense_id": "79e8bcf9-34a1-3b28-abbf-ba4115eb5b19",
                                "text": "21 juni is de langste dag van het jaar die overal ter wereld op een unieke manier wordt gevierd. De Zweden dansen tijdens de midzomeravond om de meiboom en in andere landen worden vuren aangestoken om het verleden te verbranden."
                            }
                        ]
                    }
