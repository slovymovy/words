                "senses": [
                    {
                        "sense_id": "4a33c7db-3e93-3a5e-86f5-226f0e22d942",
                        "entry_id": "ea37f23a-9720-38f6-9a18-015b91deb74b",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7616ebeb-3910-48d0-b442-7fc5d2b917aa",
                                "sense_id": "4a33c7db-3e93-3a5e-86f5-226f0e22d942",
                                "text": "Frau Kneißle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "ed9648a4-8fe1-43f2-b2cf-d5df36a1f3cf",
                                "sense_id": "4a33c7db-3e93-3a5e-86f5-226f0e22d942",
                                "text": "Herr Kneißle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "7ca95bf0-7b8a-476d-9495-778ef42b5809",
                                "sense_id": "4a33c7db-3e93-3a5e-86f5-226f0e22d942",
                                "text": "Die Kneißles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "2fbb21d5-6c1d-4fb7-a50e-053a52659956",
                                "sense_id": "4a33c7db-3e93-3a5e-86f5-226f0e22d942",
                                "text": "Der Kneißle trägt nie die Schals, die die Kneißle ihm strickt."
                            },
                            {
                                "example_id": "4252c948-1c61-4ef6-8cf4-713deaac9a18",
                                "sense_id": "4a33c7db-3e93-3a5e-86f5-226f0e22d942",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Kneißle kommt, geht der Herr Kneißle.“"
                            },
                            {
                                "example_id": "1fb9a47c-e753-4668-8f97-f0aad395474d",
                                "sense_id": "4a33c7db-3e93-3a5e-86f5-226f0e22d942",
                                "text": "Kneißle kommt und geht."
                            },
                            {
                                "example_id": "169260c4-5fea-49f4-9983-35c167caa77c",
                                "sense_id": "4a33c7db-3e93-3a5e-86f5-226f0e22d942",
                                "text": "Kneißles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
