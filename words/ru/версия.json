{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "55f6ada1-8b21-37c7-af67-ff154138953c",
                    "sense_definition": "Отдельная редакция компьютерной программы или приложения, отличающаяся от предыдущей.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ты уже скачал новую <w>версию</w> этой игры?",
                            "target_lang_translations": {
                                "en": "Have you already downloaded the new <w>version</w> of this game?",
                                "zh": "你已经下载这个游戏的最新<w>版本</w>了吗？"
                            }
                        },
                        {
                            "text": "Эта <w>версия</w> программы работает намного быстрее старой.",
                            "target_lang_translations": {
                                "en": "This <w>version</w> of the program works much faster than the old one.",
                                "zh": "这个程序的<w>版本</w>比旧的运行速度快得多。"
                            }
                        }
                    ],
                    "synonyms": [
                        "редакция",
                        "вариант",
                        "выпуск",
                        "релиз"
                    ],
                    "common_phrases": [
                        "новая версия",
                        "бета-версия",
                        "обновить версию"
                    ],
                    "target_lang_definitions": {
                        "en": "A specific edition of a computer program or application, differing from the previous one.",
                        "zh": "计算机程序或应用程序的特定版本，与之前的版本有所不同。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "version",
                                "target_lang_sense_clarification": "software update or revision"
                            },
                            {
                                "target_lang_word": "release",
                                "target_lang_sense_clarification": "software distribution"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "版本",
                                "target_lang_sense_clarification": "软件更新或修订"
                            },
                            {
                                "target_lang_word": "发布",
                                "target_lang_sense_clarification": "软件发行"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b9be89ce-375b-3f0d-bd3e-0935c50cbaa2",
                    "sense_definition": "Одно из нескольких изложений или объяснений какого-либо факта или события, отличающееся от других.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "У каждого свидетеля была своя <w>версия</w> случившегося на улице.",
                            "target_lang_translations": {
                                "en": "Each witness had their own <w>version</w> of what happened on the street.",
                                "zh": "每个目击者对街上发生的事情都有自己的<w>说法</w>。"
                            }
                        },
                        {
                            "text": "По официальной <w>версии</w>, пожар начался из-за неисправной проводки.",
                            "target_lang_translations": {
                                "en": "According to the official <w>version</w>, the fire started due to faulty wiring.",
                                "zh": "根据官方<w>说法</w>，火灾是由线路故障引起的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "трактовка",
                        "вариант"
                    ],
                    "common_phrases": [
                        "официальная версия",
                        "по версии следствия",
                        "выдвинуть версию"
                    ],
                    "target_lang_definitions": {
                        "en": "One of several descriptions or explanations of a fact or event, differing from others.",
                        "zh": "对事实或事件的多种描述或解释之一，与其他描述有所不同。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "version",
                                "target_lang_sense_clarification": "account or description of events"
                            },
                            {
                                "target_lang_word": "account",
                                "target_lang_sense_clarification": "story or report"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "说法",
                                "target_lang_sense_clarification": "对事件的陈述或解释"
                            },
                            {
                                "target_lang_word": "版本",
                                "target_lang_sense_clarification": "对事件的描述"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "90047124-d0dc-3d47-8c76-dc9c10e04461",
                    "sense_definition": "Разновидность чего-либо, отличающаяся формой, языком или деталями подачи материала.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В магазине продаётся только русская <w>версия</w> этой книги.",
                            "target_lang_translations": {
                                "en": "The store sells only the Russian <w>version</w> of this book.",
                                "zh": "店里只卖这本书的俄文<w>版本</w>。"
                            }
                        },
                        {
                            "text": "Мы решили посмотреть полную <w>версию</w> фильма в кинотеатре.",
                            "target_lang_translations": {
                                "en": "We decided to watch the full <w>version</w> of the movie at the cinema.",
                                "zh": "我们决定去电影院看这部电影的完整<w>版本</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "вариант"
                    ],
                    "common_phrases": [
                        "английская версия",
                        "полная версия",
                        "печатная версия"
                    ],
                    "target_lang_definitions": {
                        "en": "A form or variant of something, differing in details, language, or format.",
                        "zh": "某事物的变体，在细节、语言或格式上有所不同。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "version",
                                "target_lang_sense_clarification": "specific form or variation"
                            },
                            {
                                "target_lang_word": "edition",
                                "target_lang_sense_clarification": "publication form"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "版本",
                                "target_lang_sense_clarification": "特定的形式或变体"
                            },
                            {
                                "target_lang_word": "版",
                                "target_lang_sense_clarification": "出版形式"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}