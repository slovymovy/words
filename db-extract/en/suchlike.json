                        "source_sense_id": "981f7d53-f729-392e-8de9-f48e6fbfcbe9",
                        "source_sense_description": "of the same or similar kind",
                        "target_lang_word": "dergelijk",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dergelijk",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "2e8ca4bf-47c3-3d1b-914d-666173524908",
                                        "entry_id": "eed2a4df-3503-3126-90e9-291c306ab836",
                                        "glosses": [
                                            "van deze soort, overeenkomstig, zodanig, dusdanig, zulk, zo'n"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd942f39-3a49-4ebd-8d03-855b2013aefb",
                                                "sense_id": "2e8ca4bf-47c3-3d1b-914d-666173524908",
                                                "text": "Dergelijk werk wordt vandaag niet meer vervaardigd."
                                            },
                                            {
                                                "example_id": "fd644ee4-b0c2-4d85-89ba-7fdd0cbc3641",
                                                "sense_id": "2e8ca4bf-47c3-3d1b-914d-666173524908",
                                                "text": "‘Thuis zitten we ook met dergelijke vragen. Mijn kind hoest, die hebben we vandaag thuisgehouden. De school vraagt ouders ook om dat te doen.’"
                                            },
                                            {
                                                "example_id": "40d91008-88c8-47eb-b0e9-398b380018bf",
                                                "sense_id": "2e8ca4bf-47c3-3d1b-914d-666173524908",
                                                "text": "Waarom God hun alle drie een dergelijke gunst had verleend, was onmogelijk te begrijpen, evenmin waarom hij in hun jeugd hun vader en oom tot zich had genomen door hen te laten verdwijnen op zee."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5d247588-4516-4f45-9c03-8badec6ad0a1",
                        "source_entry_id": "3ed7e4eb-72f7-36d3-a52d-9ab77d838fa9",
                        "source_sense_id": "981f7d53-f729-392e-8de9-f48e6fbfcbe9",
                        "source_sense_description": "of the same or similar kind",
                        "target_lang_word": "zulke",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zulke",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "3dad388b-3d58-3945-94bf-94b7a8483329",
                                        "entry_id": "da02483e-aa81-34ca-962e-6b138e0f7d10",
                                        "glosses": [
                                            "verbogen vorm (meervoud) van zulk"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe4af6b0-9244-4441-a5a8-3b1d3cd0c4e5",
                                                "sense_id": "3dad388b-3d58-3945-94bf-94b7a8483329",
                                                "text": "Ik had zulke eenden nog nooit gezien."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "zulke",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "07323e52-471e-35a4-abd8-ce4e23418500",
                                        "entry_id": "574598e1-47dc-3436-9508-19e98f2e96b0",
                                        "glosses": [
                                            "wat een"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7dfaba58-4d60-42aa-b46c-5f25f2ca1c82",
                                                "sense_id": "07323e52-471e-35a4-abd8-ce4e23418500",
                                                "text": "Zulke scherpslijpers! Je zou ze toch!"
                                            },
                                            {
                                                "example_id": "c88beb2c-0b99-433c-8ad3-9da26e06fcfb",
                                                "sense_id": "07323e52-471e-35a4-abd8-ce4e23418500",
                                                "text": "'Is dat niet het grondbeginsel van een instelling als het Skelton! Om zulke dingen te delen?' 'Daar zit wat in."
                                            },
                                            {
                                                "example_id": "acb83a55-f505-4983-84db-e3fe0c0c199d",
                                                "sense_id": "07323e52-471e-35a4-abd8-ce4e23418500",
                                                "text": "Recent onderzoek van Jacco van Sterkenburg laat zien dat zulke raciale stereotypering nog steeds doorwerkt in de hedendaagse voetbalverslaggeving, waarbij het spel van zwarte en witte voetballers wordt vervat in verschillende metaforen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d298f8b7-e358-47b3-8875-ea67464edda1",
                        "source_entry_id": "3ed7e4eb-72f7-36d3-a52d-9ab77d838fa9",
                        "source_sense_id": "981f7d53-f729-392e-8de9-f48e6fbfcbe9",
                        "source_sense_description": "of the same or similar kind",
                        "target_lang_word": "zoiets",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zoiets",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "8db235d7-5e77-3aa4-8cd8-3c3273a62c44",
                                        "entry_id": "d8a5984a-1dd9-3385-a969-3edd3b3d173a",
                                        "glosses": [
                                            "een dergelijke zaak"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a298a3b3-9499-4300-9123-dfddf3ab4cd8",
                                                "sense_id": "8db235d7-5e77-3aa4-8cd8-3c3273a62c44",
                                                "text": "Zoiets is nog nooit vertoond."
                                            },
                                            {
                                                "example_id": "2cd97c7d-c4fa-4ab6-9622-b631b6893843",
                                                "sense_id": "8db235d7-5e77-3aa4-8cd8-3c3273a62c44",
                                                "text": "Wij vonden 25 kilometer per dag al prima, terwijl jullie nu ruim 40 kilometer per dag doorjakkeren. Neem toch de tijd, zoiets maak je maar een keer in je leven mee. Het heeft me nooit losgelaten na al die jaren.’"
                                            },
                                            {
                                                "example_id": "39cdb995-6807-4905-9ba7-2540d0fb385a",
                                                "sense_id": "8db235d7-5e77-3aa4-8cd8-3c3273a62c44",
                                                "text": "Zoiets heeft Jos nog nooit tegen me gezegd."
                                            },
                                            {
                                                "example_id": "6c0ef3c6-1080-4624-8136-33771a4a523c",
                                                "sense_id": "8db235d7-5e77-3aa4-8cd8-3c3273a62c44",
                                                "text": "'Je mag het misschien wel denken, en dóén voor mijn part, maar waarom zou je zoiets aan een collega vertellen?' Jaap haalt zuchtend zijn schouders op."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "44a4908f-db55-418b-8433-768bfd1e4352",
                        "source_entry_id": "3ed7e4eb-72f7-36d3-a52d-9ab77d838fa9",
                        "source_sense_id": "981f7d53-f729-392e-8de9-f48e6fbfcbe9",
