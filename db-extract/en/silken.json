                                "target_senses": [
                                    {
                                        "sense_id": "6ab40b6a-2abb-384b-addd-ab5f4c56f3a3",
                                        "entry_id": "e4493f5e-5a40-3f94-a065-41758bb29ba3",
                                        "glosses": [
                                            "dotyczący jedwabiu, związany z jedwabiem"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "081cc5ad-807f-3a71-938c-6a307b9f4c02",
                                        "entry_id": "e4493f5e-5a40-3f94-a065-41758bb29ba3",
                                        "glosses": [
                                            "zrobiony, wyprodukowany z jedwabiu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2cacd5e7-8912-4b47-96ff-938f4d64588e",
                                                "sense_id": "081cc5ad-807f-3a71-938c-6a307b9f4c02",
                                                "text": "Wieczorem, w granatowym cieniu, wysoki bufetowy w nicianych rękawiczkach wynosi na werandę lampę z jedwabnym abażurem."
                                            }
                                        ],
