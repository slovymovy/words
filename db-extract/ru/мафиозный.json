                                    },
                                    {
                                        "sense_id": "dd798bc8-7d0f-3d31-b760-8454590b1730",
                                        "entry_id": "ffda1c8e-2edc-359f-bf1c-67f79d5a70dd",
                                        "glosses": [
                                            "A crime syndicate."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5e20c66e-99e6-344f-a28c-227349cf998a",
                                        "entry_id": "ffda1c8e-2edc-359f-bf1c-67f79d5a70dd",
                                        "glosses": [
                                            "A trusted group of associates, as of a political leader."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "23d134a1-f92b-3645-970a-78e531d9eec5",
                                        "entry_id": "ffda1c8e-2edc-359f-bf1c-67f79d5a70dd",
                                        "glosses": [
                                            "An entity which attempts to control a specified arena by violence or threats."
                                        ],
                                        "tags": [
                                            "in-compounds"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d06c30e8-8296-4ded-a865-0208d4f75c68",
                                                "sense_id": "23d134a1-f92b-3645-970a-78e531d9eec5",
                                                "text": "moral mafia"
                                            },
                                            {
                                                "example_id": "867ddf6d-cda9-47b3-9c5d-6c2f2a9e5872",
                                                "sense_id": "23d134a1-f92b-3645-970a-78e531d9eec5",
                                                "text": "Worse, it confirms what one always suspected about the 1930s literary mafia, with their graceless posing and relentless self-obsession — what terrible , terrible bores they were."
                                            },
                                            {
                                                "example_id": "3bf49273-11da-4fca-a324-9989469477c5",
                                                "sense_id": "23d134a1-f92b-3645-970a-78e531d9eec5",
                                                "text": "Since the victory of gadgetry is \"inevitable,\" you might as well come along quietly and let us smother you in speed and convenience, says the digital mafia."
                                            },
                                            {
                                                "example_id": "93f52093-4aee-45a8-be97-b0c7bd7e4792",
                                                "sense_id": "23d134a1-f92b-3645-970a-78e531d9eec5",
                                                "text": "I can scarcely leave the apartment without being engulfed by journalists, not to mention the fucking left-wing activists and the multicultural mafia that assailed me with spitting and verbal abuse the last time I ventured out […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
