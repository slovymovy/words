                    {
                        "translation_id": "698e1816-2571-4bac-ae4f-7a4c6ffe3228",
                        "source_entry_id": "87d77b1a-606c-3761-8bd7-baa4e4389be5",
                        "source_sense_id": "c463ceaf-cbca-3618-98be-372d90e00fa1",
                        "target_lang_word": "magus",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "magus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f54a7583-9e37-354f-9a0a-d88a9232a9e4",
                                        "entry_id": "b30be77f-9cd5-30a1-8bbc-63630adc81ba",
                                        "glosses": [
                                            "A magician; (derogatory) a conjurer or sorcerer, especially one who is a charlatan or trickster."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "419f6932-63e4-4e17-8d0e-f9859645e813",
                                                "sense_id": "f54a7583-9e37-354f-9a0a-d88a9232a9e4",
                                                "text": "In the middle of the fifth century, Empedocles testified to the vitality of these maguses, who were capable of commanding the winds and of bringing the dead back from Hades and who presented themselves, not as mortals, but as gods."
                                            },
                                            {
                                                "example_id": "e3f38907-8ead-4849-9d28-e9bb227dc549",
                                                "sense_id": "f54a7583-9e37-354f-9a0a-d88a9232a9e4",
                                                "text": "It’s from our venerable maguses Gominik Halvor and his son. They’ve cast the runes for our enterprise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b198b12-5ec9-345e-85a0-56c954e7ca94",
                                        "entry_id": "b30be77f-9cd5-30a1-8bbc-63630adc81ba",
                                        "glosses": [
                                            "A Zoroastrian priest."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a327cda-7b06-434c-97fd-90a032cc8d21",
                                                "sense_id": "0b198b12-5ec9-345e-85a0-56c954e7ca94",
                                                "text": "Court astrologers, who were drawn from the race of the Magi, were among those that formed the royal court [...]"
                                            },
                                            {
                                                "example_id": "a3de8e76-e063-4a77-8935-d12dad7cd4b3",
                                                "sense_id": "0b198b12-5ec9-345e-85a0-56c954e7ca94",
                                                "text": "Mocenigo / [satisfied at last] / Good! Now, tell me, Prior, / What is Rome’s greatest fear? What gives the Pope / More night-mares than bad sausage? / Prior Gabrielli / Heresy! / The rendering of the seamless robe of truth. / This rabble of mountebanks and maguses / Who shout reform, defile the Eucharist, / Flout all authority, elect false bishops, / Deny the Trinity and saving grace, / Abolish marriage, set their private minds / Against the long tradition of the Faith / And Peter’s dictates and the Holy Writ . . ."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
