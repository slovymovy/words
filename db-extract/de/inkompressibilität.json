                                "example_id": "614972e9-473e-4303-8034-a0d192e29a29",
                                "sense_id": "a451b686-8623-343f-85e4-de089c450a37",
                                "text": "„Für die hier interessierenden flachen Grundwässer kann man von der Inkompressibilität des Wassers ausgehen.“"
                            },
                            {
                                "example_id": "9d704a1d-dde8-44d6-bd21-abbd96f50b50",
                                "sense_id": "a451b686-8623-343f-85e4-de089c450a37",
                                "text": "„Die Inkompressibilität der Elastomere ist Grundlage für die Möglichkeit, Teile mit unterschiedlicher Steifigkeit in den drei Raumrichtungen zu gestalten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
