                "senses": [
                    {
                        "sense_id": "43da3069-a8f8-3b9a-a263-ade633c19139",
                        "entry_id": "d216a2da-58ec-31aa-b575-008c9f89ad98",
                        "glosses": [
                            "plötzlicher Verlust der Ehre, des Respekts oder des Ansehens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6717360-4f23-4c56-9b25-b08985b0485c",
                                "sense_id": "43da3069-a8f8-3b9a-a263-ade633c19139",
                                "text": "Viele Japaner haben Angst vor einem Gesichtsverlust."
                            },
                            {
                                "example_id": "e004a875-f15a-444d-9f55-ce5033dbf15e",
                                "sense_id": "43da3069-a8f8-3b9a-a263-ade633c19139",
                                "text": "„Gesichtsverlust lässt sich dummerweise bei Konflikten kaum vermeiden - eine Seite erwischt es immer.“"
                            },
                            {
                                "example_id": "e45cda55-25a9-4b32-abd8-18f64fd0736c",
                                "sense_id": "43da3069-a8f8-3b9a-a263-ade633c19139",
                                "text": "„Erst durch ihn hatten die Mitgliedstaaten erfahren, dass sie von einem Zusammenschluss tatsächlich greifbare Vorteile hatten, und die Fürsten konnten ihre Macht ohne größeren Gesichtsverlust Stück für Stück abgeben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
