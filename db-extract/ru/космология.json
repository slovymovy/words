                        "form": "космоло́гии"
                    },
                    {
                        "form_id": "96733bf8-7d6c-4c08-802e-078b167304d0",
                        "entry_id": "2546c57e-d632-3e53-87db-b386100cc89c",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "космоло́гиях"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "527e4158-45cb-3e50-b890-e6536fb6852d",
                        "entry_id": "2546c57e-d632-3e53-87db-b386100cc89c",
                        "glosses": [
                            "раздел астрономии, изучающий свойства и эволюцию Вселенной в целом"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "136f3416-52cb-4733-bc52-7a723236a101",
                                "sense_id": "527e4158-45cb-3e50-b890-e6536fb6852d",
                                "text": "Современное естествознание — физика, астрономия, космология, кибернетика, математика, информатика — поставляет все большее количество новых данных, способных пролить свет на природу времени."
                            }
                        ]
                    },
                    {
                        "sense_id": "a9bd930c-2f7f-39d5-adc6-ba987ef4c684",
                        "entry_id": "2546c57e-d632-3e53-87db-b386100cc89c",
                        "glosses": [
                            "совокупность представлений, учение о мироздании"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0bb682a1-a9d0-4a48-98b4-6a6fba7212e7",
                                "sense_id": "a9bd930c-2f7f-39d5-adc6-ba987ef4c684",
                                "text": "Её идеи представляют собой причудливую смесь из иудаизма, разного рода космологий, вегетарианства и уфологии."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aa06b310-4640-4a20-b7b6-eb5149a7a03d",
                        "source_entry_id": "2546c57e-d632-3e53-87db-b386100cc89c",
                        "target_lang_word": "cosmology",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cosmology",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e2899fca-fcfb-3aa0-90da-522501541222",
                                        "entry_id": "9f974fdc-ea43-3953-8609-e99b0798a355",
                                        "glosses": [
                                            "The study of the physical universe, its structure, dynamics, origin and evolution, and fate."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "295dca74-bc2f-49e2-8cdf-584135bbe2a1",
                                                "sense_id": "e2899fca-fcfb-3aa0-90da-522501541222",
                                                "text": "We live our lives in three dimensions for our threescore and ten allotted years. Yet every branch of contemporary science, from statistics to cosmology, alludes to processes that operate on scales outside of human experience: the millisecond and the nanometer, the eon and the light-year."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0bf8f996-0490-3eb0-9880-f8188d1c3cdc",
                                        "entry_id": "9f974fdc-ea43-3953-8609-e99b0798a355",
                                        "glosses": [
                                            "A metaphysical study into the origin and nature of the universe."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "254f0cd1-592c-3d64-8275-e3719af6a3b5",
                                        "entry_id": "9f974fdc-ea43-3953-8609-e99b0798a355",
                                        "glosses": [
                                            "A particular view (cultural or religious) of the structure and origin of the universe."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ebcea706-3471-48e0-b984-bbc4da7fd87f",
                                                "sense_id": "254f0cd1-592c-3d64-8275-e3719af6a3b5",
                                                "text": "Near-synonyms: cosmovision, worldview"
                                            },
                                            {
                                                "example_id": "7245a640-a420-4b6f-bf74-e13b37d08dad",
                                                "sense_id": "254f0cd1-592c-3d64-8275-e3719af6a3b5",
                                                "text": "But the work of Marshack and Leroi-Gourhan enable us to see that these later religions of the civilized period are elaborations of the cosmologies from the universal religion of the Upper Paleolithic."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e029583f-e746-4daf-a51a-811d514d96a9",
                        "source_entry_id": "2546c57e-d632-3e53-87db-b386100cc89c",
                        "target_lang_word": "cosmología",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cosmología",
