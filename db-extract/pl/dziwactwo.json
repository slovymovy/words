                "senses": [
                    {
                        "sense_id": "9fd32759-6772-3d5a-a5ce-e2e6a8eb6e9c",
                        "entry_id": "0fffe062-5fcc-3520-ac86-8c8e6eef4325",
                        "glosses": [
                            "rzecz dziwaczna, coś dziwacznego"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bdf8ef15-75b9-4768-8a6e-71c6c3a20c09",
                                "sense_id": "9fd32759-6772-3d5a-a5ce-e2e6a8eb6e9c",
                                "text": "To pływające dziwactwo o nieokreślonych kształtach to nowy, nieznany dotąd gatunek meduzy"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "d3e3a00e-5179-3195-a1e4-9a451d90060d",
                        "entry_id": "0fffe062-5fcc-3520-ac86-8c8e6eef4325",
                        "glosses": [
                            "czyjeś dziwaczne przyzwyczajenie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03e1bed3-50a5-4d3b-8e63-a2bef14c8406",
                                "sense_id": "d3e3a00e-5179-3195-a1e4-9a451d90060d",
                                "text": "Mam po dziurki w nosie twoich dziwactw."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ab8c161d-8f4b-4c29-b453-bf7ccc1d3906",
                        "source_entry_id": "0fffe062-5fcc-3520-ac86-8c8e6eef4325",
                        "source_sense_id": "d3e3a00e-5179-3195-a1e4-9a451d90060d",
                        "target_lang_word": "peculiarity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "peculiarity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1e7bdcf4-8cd6-3148-89e4-f4eac3bd710c",
                                        "entry_id": "42653976-f717-3c06-bd96-97e391af58d4",
                                        "glosses": [
                                            "The quality or state of being peculiar; individuality; singularity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0bb12eb-65c6-4386-887a-646a360cd813",
                                                "sense_id": "1e7bdcf4-8cd6-3148-89e4-f4eac3bd710c",
                                                "text": "The peculiarity of meeting six people on a usually deserted trail only struck me later on."
                                            },
                                            {
                                                "example_id": "654b88a2-ccc5-44fd-ad41-917a73e521ac",
                                                "sense_id": "1e7bdcf4-8cd6-3148-89e4-f4eac3bd710c",
                                                "text": "“'There is always a moment when the familiar becomes the strange,'” Cora recited, as she stood looking around at the bustling open docking area of Tamayo Point. “'Look at your own hand and you will eventually notice the variation of textures, the growth of nails and the fade of scars, the peculiarity of having five fingers instead of three.'”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "286034df-532e-3e35-bfd1-6200f1ae10d7",
                                        "entry_id": "42653976-f717-3c06-bd96-97e391af58d4",
                                        "glosses": [
                                            "That which is peculiar; a special and distinctive characteristic or habit; particularity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c77b41d7-c494-4aad-a9a9-914e9a743099",
                                                "sense_id": "286034df-532e-3e35-bfd1-6200f1ae10d7",
                                                "text": "I had often heard of Miss Marchmont, and of her peculiarities (she had the character of being very eccentric), but till now had never seen her."
                                            },
                                            {
                                                "example_id": "226f8eef-e171-42ca-adf4-e30e0365b60e",
                                                "sense_id": "286034df-532e-3e35-bfd1-6200f1ae10d7",
                                                "text": "I thought Alice and H. J. P. would have fainted at the full spectacle; but we are fast getting used to the little peculiarities of foreigners and I trust they will forgive us many sins in return."
                                            },
                                            {
                                                "example_id": "f5520c2d-343d-4ad6-97f1-7aaf6a3ce5ec",
                                                "sense_id": "286034df-532e-3e35-bfd1-6200f1ae10d7",
                                                "text": "The peculiarity of this invention consists in a means for varying the angle at which the plaiting-blade is held in the plaiter without varying the position of the entire instrument upon the sewing-machine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "938863ca-cb92-3dad-a0c5-0bfdccbaa01d",
                                        "entry_id": "42653976-f717-3c06-bd96-97e391af58d4",
                                        "glosses": [
                                            "Exclusive possession or right."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "37beb573-9fc7-4ef0-a23f-6ad46c07052b",
                        "source_entry_id": "0fffe062-5fcc-3520-ac86-8c8e6eef4325",
                        "source_sense_id": "d3e3a00e-5179-3195-a1e4-9a451d90060d",
                        "target_lang_word": "foible",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "foible",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4d30a381-4d7a-3499-947d-d7f66132a4f5",
                                        "entry_id": "94deb8f3-4830-38b6-b45c-c982b0ac2a73",
                                        "glosses": [
                                            "A quirk, idiosyncrasy, frailty, or mannerism; an unusual habit that is slightly strange or silly."
                                        ],
                                        "tags": [
                                            "in-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c31bc0fe-309f-4854-9ec7-4a00a330753c",
                                                "sense_id": "4d30a381-4d7a-3499-947d-d7f66132a4f5",
                                                "text": "Try to look past his foibles and see the friendly fellow underneath."
                                            },
                                            {
                                                "example_id": "99b46f34-3bec-477b-ab72-5b9ad508bdcf",
                                                "sense_id": "4d30a381-4d7a-3499-947d-d7f66132a4f5",
                                                "text": "He knew that this was like the sudden impulse of a madman—incongruous even with his habitual foibles."
                                            },
                                            {
                                                "example_id": "cb5dcc11-40a0-449a-bb21-56f76c8e1f90",
                                                "sense_id": "4d30a381-4d7a-3499-947d-d7f66132a4f5",
                                                "text": "Marguerite Blakeney was, above all, a woman, with all a woman’s fascinating foibles, all a woman’s most lovable sins."
                                            },
                                            {
                                                "example_id": "acc94236-640e-452f-941d-5c20a968d60c",
                                                "sense_id": "4d30a381-4d7a-3499-947d-d7f66132a4f5",
                                                "text": "They made up for the respect with which unconsciously they treated him by laughing at his foibles and lamenting his vices."
                                            },
                                            {
                                                "example_id": "b5f49ba0-5907-474f-83b2-e5f8f739b65d",
                                                "sense_id": "4d30a381-4d7a-3499-947d-d7f66132a4f5",
                                                "text": "Final fillip in the Vice-President's study has been a boning up on Premier Khrushchev's favorite foible, proverbs. The bibulous Russian leader likes to throw out homely homilies in his speeches and conversations[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a959a15b-681d-3f03-9f7b-30389f368ecb",
                                        "entry_id": "94deb8f3-4830-38b6-b45c-c982b0ac2a73",
                                        "glosses": [
                                            "A weakness or failing of character."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0338debb-cab8-44a3-abdd-38bfd1069314",
                                                "sense_id": "a959a15b-681d-3f03-9f7b-30389f368ecb",
                                                "text": "Jesus is reverenced as the one man who has lived unspotted by the world, free from human foibles, able to redeem mankind by his example."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "271b12a5-a10a-3e51-b6e4-33d89bc91c71",
                                        "entry_id": "94deb8f3-4830-38b6-b45c-c982b0ac2a73",
                                        "glosses": [
                                            "Part of a sword between the middle and the point, weaker than the forte."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "foible",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1e5ad001-1724-37f3-ad33-371391a61a42",
                                        "entry_id": "b515e309-7efa-3eaa-b65c-a29c7e769919",
                                        "glosses": [
                                            "Weak; feeble."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "513c6ff7-cbae-4862-a2a2-7dc8105f1f0c",
                                                "sense_id": "1e5ad001-1724-37f3-ad33-371391a61a42",
                                                "text": "The good Fencing-maſters, in France eſpecially, when they preſent a Foyle or Fleuret to their Scholars, tell him it hath two Parts, one of which he calleth the Fort or ſtrong, and the other the Foyble or weak […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3c7bcd95-0db9-472c-985c-f2e531094ba4",
                        "source_entry_id": "0fffe062-5fcc-3520-ac86-8c8e6eef4325",
                        "source_sense_id": "9fd32759-6772-3d5a-a5ce-e2e6a8eb6e9c",
