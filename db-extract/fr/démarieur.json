                        "glosses": [
                            "Ouvrier préposé au démariage des betteraves."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "abbd54c0-5fcf-4a72-9ab1-b7b2a7c29286",
                                "sense_id": "ad03dde9-c56a-3008-84c6-2ab99f9774ee",
                                "text": "En plus d'être rares, les démarieurs représentaient un coût difficilement supportable pour les producteurs de betterave."
                            },
                            {
                                "example_id": "503424f5-e9e9-4468-bb67-2a3cb77bbb1a",
                                "sense_id": "ad03dde9-c56a-3008-84c6-2ab99f9774ee",
                                "text": "Cette migration est à vrai dire peu importante aujourd'hui : elle comprend une trentaine de faucheurs et une quinzaine de démarieurs de betteraves."
                            },
                            {
                                "example_id": "77298dc0-c6d0-4d99-95ab-fdc6d7d31e02",
                                "sense_id": "ad03dde9-c56a-3008-84c6-2ab99f9774ee",
                                "text": "— En pratique, l'ouvrier démarieur, travaillant à raison d'une somme déterminée à l'hectare, ne peut avoir les mêmes raisons de bien faire que le fermier employeur qui envisage le résultat final, c'est-à-dire la récolte."
                            }
                        ]
