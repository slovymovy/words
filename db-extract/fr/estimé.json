                                                "example_id": "986b4836-d4ab-4494-92c9-9a6781821a71",
                                                "sense_id": "238dc657-c86d-34d3-9c59-ead6484365de",
                                                "text": "Wenig bekannt ist über das frühe Leben Abatis, der sich zu Lebzeiten einen Ruf als geachteter Dichter erwarb."
                                            },
