                "senses": [
                    {
                        "sense_id": "e1fe7721-8d45-35eb-b0c6-fcdff589fc5a",
                        "entry_id": "1650ada8-7a01-3e6b-85ec-e3f3b631f50c",
                        "glosses": [
                            "Staat, der Teil eines Bundesstaates oder Staatenbundes ist und somit nur über begrenzte Souveränität verfügt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f946b84-2b6f-45df-a6cf-bfb043fb8063",
                                "sense_id": "e1fe7721-8d45-35eb-b0c6-fcdff589fc5a",
                                "text": "„In der nordirischen Versammlung, dem Regionalparlament des britischen Teilstaates, hatte die DUP am Tag vor Inkrafttreten der Gesetzesänderungen versucht, diese zu verhindern, fand dafür aber keine Mehrheit.“"
                            },
                            {
                                "example_id": "5acf7caf-bafd-4070-9921-129c463a34c0",
                                "sense_id": "e1fe7721-8d45-35eb-b0c6-fcdff589fc5a",
                                "text": "„Am Kaukasus gab es Kriege, aber Jelzins Russland ließ die großen Teilstaaten Ukraine, Belarus und Kasachstan einvernehmlich gehen.“"
                            },
                            {
                                "example_id": "c4df5d00-ee15-44ae-9e00-dd4e3f70bb41",
                                "sense_id": "e1fe7721-8d45-35eb-b0c6-fcdff589fc5a",
                                "text": "„Am 7. Oktober wird gewählt in Bosnien-Herzegowina und seinen beiden Teilstaaten: der muslimisch-kroatischen Föderation und der Republika Srpska.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
