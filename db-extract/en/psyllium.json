                    {
                        "translation_id": "5d115c2e-c79e-47a8-b91b-87d506635ec6",
                        "source_entry_id": "474bac1e-c437-31a2-b345-e17b67ec45be",
                        "source_sense_description": "psyllium seed husk, as a dietary supplement",
                        "target_lang_word": "Flohsamen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Flohsamen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9905b586-9cd8-37cb-ae4b-fbac4e99e4ed",
                                        "entry_id": "89ed43b5-2b13-3bcc-b0bd-0c8c6f773041",
                                        "glosses": [
                                            "Samen des Wegerichs, der vorwiegend als Heilmittel verwendet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1350fdd7-97ff-4903-a774-3b110118572e",
                                                "sense_id": "9905b586-9cd8-37cb-ae4b-fbac4e99e4ed",
                                                "text": "„Unter Psyllium wird der indische Flohsamen verstanden.“"
                                            },
                                            {
                                                "example_id": "52fff307-2c02-4026-bfd4-cbc4daeadbe5",
                                                "sense_id": "9905b586-9cd8-37cb-ae4b-fbac4e99e4ed",
                                                "text": "„Aus der Klinik Berlin-Buch bekam ich von der Studienkoordinatorin den Tipp, es mal mit Flohsamen(schalen) zu versuchen.“"
                                            },
                                            {
                                                "example_id": "fc710913-13d8-4906-8fba-99e1b128a737",
                                                "sense_id": "9905b586-9cd8-37cb-ae4b-fbac4e99e4ed",
                                                "text": "„Es konnte gezeigt werden, dass Plantago ovata, der indische Flohsamen, positive Effekte auf Verstopfung, Durchfall und Bauchschmerzen hat und so bei Patienten mit einem Reizdarmsyndrom empfohlen werden kann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6f9ce51d-d0b8-4f36-b1b9-baf8b702813a",
                        "source_entry_id": "474bac1e-c437-31a2-b345-e17b67ec45be",
                        "source_sense_description": "psyllium seed husk, as a dietary supplement",
                        "target_lang_word": "Flohsamenschalen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Flohsamenschalen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2710138a-7078-3d73-9163-0b0dfb8947be",
                                        "entry_id": "314d0760-47b1-342d-a3c3-9460a86d8c0e",
                                        "glosses": [
                                            "Hülsen der Samen des Wegerichs, die vorwiegend als Heilmittel verwendet werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ceeff80a-d2f9-4ba3-bb2a-81707faa8c59",
                                                "sense_id": "2710138a-7078-3d73-9163-0b0dfb8947be",
                                                "text": "„Man muss das Hafermehl nur mit Reismehl oder einem anderen glutenfreien Mehl mischen und etwas Flohsamenschalen hinzufügen, schon kann man fast alle Rezepte glutenfrei gestalten.“"
                                            },
                                            {
                                                "example_id": "cd78b39a-e47f-49b5-b963-57e89bbed585",
                                                "sense_id": "2710138a-7078-3d73-9163-0b0dfb8947be",
                                                "text": "„Flohsamenschalen kennt man bereits seit mehreren Jahrzehnten aus der Apotheke.“"
                                            },
                                            {
                                                "example_id": "0daeeef7-f6db-48b3-aec8-aece2be95f69",
                                                "sense_id": "2710138a-7078-3d73-9163-0b0dfb8947be",
                                                "text": "„Für die Flohsamenschalen als erste Arzneipflanze überhaupt hat die Europäische Arzneimittelbehörde EMEA in London die Wirksamkeit und Sicherheit im Oktober 2006 in Form eines EU Herbal Monograph bescheinigt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
