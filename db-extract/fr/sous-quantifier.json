                "senses": [
                    {
                        "sense_id": "d62e0d3b-6dfa-3abb-b4b0-a1db6aac35e5",
                        "entry_id": "710604b1-d51d-383b-8d1f-ea76f552db99",
                        "glosses": [
                            "Sous-évaluer (une mesure)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3731fefa-9371-4309-a462-88120e1f5969",
                                "sense_id": "d62e0d3b-6dfa-3abb-b4b0-a1db6aac35e5",
                                "text": "Il convient de signaler que le recensement des ordinations de prêtres dans cette publication officielle de l'Église orthodoxe serbe est peu fiable et sensiblement sous-quantifié."
                            },
                            {
                                "example_id": "f4300cfb-5a54-4e53-94b5-1dc633e097a0",
                                "sense_id": "d62e0d3b-6dfa-3abb-b4b0-a1db6aac35e5",
                                "text": "Mais, à trop se focaliser là-dessus, on en viendrait presque à sous-quantifier l’importance d'une bonne industrie."
                            },
                            {
                                "example_id": "7c94ef40-b63d-4d3c-970f-741bb7dbe9e7",
                                "sense_id": "d62e0d3b-6dfa-3abb-b4b0-a1db6aac35e5",
                                "text": "Ils confirment que le risque de ne pas amplifier ou sous-quantifier certaines souches existe toujours, aucune méthode de PCR n'étant parfaite."
                            }
                        ]
                    },
                    {
                        "sense_id": "cb24fb32-132e-3577-9a9b-7d81fafcbc6c",
                        "entry_id": "710604b1-d51d-383b-8d1f-ea76f552db99",
                        "glosses": [
                            "Définition manquante ou à compléter. (Ajouter)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e598eae-0522-44f2-b4a8-b39749c8ee88",
                                "sense_id": "cb24fb32-132e-3577-9a9b-7d81fafcbc6c",
                                "text": "On souhaite sous-quantifier d’un facteur K ce signal, c’est-à-dire diviser par K le nombre de valeurs possibles, de manière à réduire le nombre de bits de codage de log₂K."
                            }
                        ]
                    }
                ],
