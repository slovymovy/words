                                "target_senses": [
                                    {
                                        "sense_id": "8fafcb7e-4de2-3b9e-82d0-e80fc92684d6",
                                        "entry_id": "206795d2-1a03-3ee1-bea3-9d3120e6c647",
                                        "glosses": [
                                            "A long rope with a sliding loop on one end, generally used in ranching to catch cattle and horses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "125c79e0-33f3-4b01-921c-3a147014e608",
                                                "sense_id": "8fafcb7e-4de2-3b9e-82d0-e80fc92684d6",
                                                "text": "He managed to catch the runaway bull with a lasso."
                                            },
                                            {
                                                "example_id": "6b9a7529-f558-4af6-9b53-5f7f1109d9b5",
                                                "sense_id": "8fafcb7e-4de2-3b9e-82d0-e80fc92684d6",
                                                "text": "She threw the lasso skillfully around the post."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a69f239-be6b-3f45-b620-5ca787fd6156",
                                        "entry_id": "206795d2-1a03-3ee1-bea3-9d3120e6c647",
                                        "glosses": [
                                            "An image-editing function allowing the user to capture an irregularly-shaped object by drawing an approximate outline."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "lasso",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e0e1cc67-5122-37b4-a468-f4e7f9aa121d",
                                        "entry_id": "10f4a0a2-61a3-3846-8411-32578146dc9d",
                                        "glosses": [
                                            "To catch with a lasso."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd1c92e8-0eb3-4930-8188-651e03d160b3",
                                                "sense_id": "e0e1cc67-5122-37b4-a468-f4e7f9aa121d",
                                                "text": "He had to lasso the wild horse before it ran off."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "47d9735a-0f3e-441f-9db4-cea64f75cc2e",
                        "source_entry_id": "e4946b77-405c-374a-9d74-94fe864c8508",
                        "source_sense_id": "545e7a49-eac3-3ec8-b2ce-69da9d03563a",
                        "target_lang_word": "lariat",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lariat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "764b35be-1632-345b-a5eb-d5de0b007ff7",
                                        "entry_id": "e933c27d-74c0-31cf-a86d-da46587ad7f7",
                                        "glosses": [
                                            "A lasso."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23b7dc3b-644e-4830-8392-f76af5e5923d",
                                                "sense_id": "764b35be-1632-345b-a5eb-d5de0b007ff7",
                                                "text": "Not so circumscribed in expedient for the reduction of surplus wealth were those lairds of the lariat who had womenfolk to their name."
                                            },
                                            {
                                                "example_id": "19b83740-bb44-430b-a9d7-ef6cb656ce07",
                                                "sense_id": "764b35be-1632-345b-a5eb-d5de0b007ff7",
                                                "text": "I'm putting on my riding hat / Got my boots and my lariat / Ooh hoo I'm dressing up in style"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3fc62175-76d4-3405-8a25-5eac791f2d19",
                                        "entry_id": "e933c27d-74c0-31cf-a86d-da46587ad7f7",
                                        "glosses": [
                                            "A tether."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2e554897-b9ea-3776-936f-b7c9ce360cfc",
                                        "entry_id": "e933c27d-74c0-31cf-a86d-da46587ad7f7",
                                        "glosses": [
                                            "An attack where the wrestler runs towards an opponent, wraps his arm around their upper chest and neck and then forces them to the ground."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "lariat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "15a7ccdd-c850-39a9-8c63-4d7a4d55f611",
                                        "entry_id": "245c043c-2e81-302e-ba89-254e3c52fc53",
                                        "glosses": [
                                            "To lasso."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "400990ae-e3ca-40f3-85fa-477201bce489",
                                                "sense_id": "15a7ccdd-c850-39a9-8c63-4d7a4d55f611",
                                                "text": "Here they dismounted, lariated their horses, in order that they might enjoy the long, green grass growing near the banks of the brook; and bathing their faces in the cool, sparkling water, they partook sparingly of their provisions."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "26be3aaa-43b8-412f-86ab-c07df9d410ee",
                        "source_entry_id": "e4946b77-405c-374a-9d74-94fe864c8508",
                        "source_sense_id": "545e7a49-eac3-3ec8-b2ce-69da9d03563a",
                        "target_lang_word": "riata",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "riata",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6530e401-affa-36e9-9f94-2d360a02dc8b",
                                        "entry_id": "0f932dbf-964d-316b-b929-6717e2dbb487",
                                        "glosses": [
                                            "A lariat or lasso."
                                        ],
                                        "tags": [
                                            "US",
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4eff1415-b4a8-478c-b7ee-5e16ed83fdcf",
                                                "sense_id": "6530e401-affa-36e9-9f94-2d360a02dc8b",
                                                "text": "“You double-crossing devil,” the young man growled. “[…] Hereafter you'll trot ahead of me at the end of a riata, while I keep you on the jump with a four-horse whip. Right now you're scattering my dunnage from hell to breakfast, […]”"
                                            },
                                            {
                                                "example_id": "5b923692-f16e-4281-ab0f-a8d526bea0cb",
                                                "sense_id": "6530e401-affa-36e9-9f94-2d360a02dc8b",
                                                "text": "A few blocks from the capitol we stripped him, cut off everything hanging between his legs, then fixed him with a riata and dragged him up and down Congress."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f934220b-fa8d-4576-9456-9b10a7b852de",
                        "source_entry_id": "e4946b77-405c-374a-9d74-94fe864c8508",
                        "source_sense_id": "545e7a49-eac3-3ec8-b2ce-69da9d03563a",
                        "target_lang_word": "reata",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reata",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "94cfab50-5f59-380d-b0bf-c6a378063036",
                                        "entry_id": "ec0ad88e-0a84-321f-8142-4a0543771669",
                                        "glosses": [
                                            "A lariat or lasso."
                                        ],
                                        "tags": [
                                            "Texas"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e1d8995-568f-40a1-89d8-09e15777af88",
                                                "sense_id": "94cfab50-5f59-380d-b0bf-c6a378063036",
                                                "text": "The riders overtook them laughing and circled the cart at a full gallop until one of them took down his reata and dropped a loop over the mule’s head and brought it to a halt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2112e557-c517-4213-9f79-3ae013e8a0dd",
                        "source_entry_id": "e4946b77-405c-374a-9d74-94fe864c8508",
                        "source_sense_id": "545e7a49-eac3-3ec8-b2ce-69da9d03563a",
                        "target_lang_word": "lasso",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lasso",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "84935cc6-a62f-31fa-ac3c-bb508460d0fc",
                                        "entry_id": "9ccf1f15-d8f1-36d2-a6ec-223931dd115a",
                                        "glosses": [
                                            "Longue lanière en forme de boucle dont se servent les gardiens de troupeaux, comme les cow-boys ou les gardians, pour s’emparer des chevaux, des bœufs sauvages, en la leur lançant autour du corps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e256dee8-c7e2-4f6d-a191-87f018ed00f7",
                                                "sense_id": "84935cc6-a62f-31fa-ac3c-bb508460d0fc",
                                                "text": "Tout en faisant cet aparté entre ses dents, le vaquero déroula le lasso qu’il portait attaché à sa ceinture et se mit à courir dans la direction du cavalier."
                                            },
                                            {
                                                "example_id": "c57e175b-fd59-49d5-9890-3c0aee6677ca",
                                                "sense_id": "84935cc6-a62f-31fa-ac3c-bb508460d0fc",
                                                "text": "Le commandant du dirigeable qui surveillait ce quartier essaya de faire arracher au lasso le drapeau hissé sur Morgan Hall."
                                            },
                                            {
                                                "example_id": "d72813e1-971a-4727-9338-eb8be2fbf5e1",
                                                "sense_id": "84935cc6-a62f-31fa-ac3c-bb508460d0fc",
                                                "text": "Plus loin, un jeune adolescent à cheval, vêtu d'un « poncho » aux brillantes couleurs avec le traditionnel lasso pendu à l'arçon de sa selle, me salua d'un « buenos dias »."
                                            },
                                            {
                                                "example_id": "6e4a02da-03b8-42e1-bf66-d2eee3d2a331",
                                                "sense_id": "84935cc6-a62f-31fa-ac3c-bb508460d0fc",
                                                "text": "Montons sur ce large bureau, allons, mes souvenirs de westerns! Comment attraper un plafonnier au lasso? Oups! Raté!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3c62c87-9237-39ba-a8a6-d8725cc1c96e",
                                        "entry_id": "9ccf1f15-d8f1-36d2-a6ec-223931dd115a",
                                        "glosses": [
                                            "Tout outil concret ou métaphorique permettant la capture matérielle ou la saisie conceptuelle de quelque objet physique ou mental."
                                        ],
