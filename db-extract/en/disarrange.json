                        "entry_id": "c85bf868-d4ce-32b6-bcad-bd9d153b5ae3",
                        "glosses": [
                            "To undo the arrangement of; to disorder; to derange."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26dd0e01-63bb-4f8f-9b34-98ae0893a0c8",
                                "sense_id": "0a7686ef-ce3b-3d69-be8f-67247468a1e5",
                                "text": "Stay, dear, you will disarrange your curls—let me untie your hat."
                            },
                            {
                                "example_id": "72fa1da1-0905-4cf2-8cb1-2e1b9535d081",
                                "sense_id": "0a7686ef-ce3b-3d69-be8f-67247468a1e5",
                                "text": "In his short life Ricky had known two sudden deaths, and that is enough to disarrange any placid outlook on the world."
                            }
                        ]
                    }
                ],
