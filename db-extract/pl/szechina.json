                "senses": [
                    {
                        "sense_id": "60861ebe-7816-3887-b0bb-11f8c52f3d15",
                        "entry_id": "f561891d-8987-37d4-a0f9-d92e19ffb280",
                        "glosses": [
                            "widoczna obecność Boga w świecie, jego immanencja występująca w wierzeniach judaistycznych, czasem personifikowana i rozumiana jako boski pierwiastek żeński lub jedno z wielu imion Boga"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "06ec2dcd-c4cf-46e7-84a7-81fb4c9b8900",
                        "source_entry_id": "f561891d-8987-37d4-a0f9-d92e19ffb280",
                        "source_sense_id": "60861ebe-7816-3887-b0bb-11f8c52f3d15",
                        "target_lang_word": "shekinah",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shekinah",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f98e5db6-2edb-3a85-9355-2c5628f15bfd",
                                        "entry_id": "18dab5ab-72fb-30cd-9da6-c20e0bec72fc",
                                        "glosses": [
                                            "A visible or otherwise perceptible manifestation of the presence of God"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "356fc418-19c9-440b-bc01-c519883cc5a2",
                                                "sense_id": "f98e5db6-2edb-3a85-9355-2c5628f15bfd",
                                                "text": "Some said that the Shekinah, who dwelt with his people on earth, still lived on the Temple Mount, even though the Temple was in ruins."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5c1c1479-3299-4443-b6f8-ae1afb176909",
                        "source_entry_id": "f561891d-8987-37d4-a0f9-d92e19ffb280",
                        "source_sense_id": "60861ebe-7816-3887-b0bb-11f8c52f3d15",
                        "target_lang_word": "Shekhina",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Shekhina",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "25241eb3-bf06-354a-889c-a10d29fa4426",
                                        "entry_id": "cdcead6b-17fe-3b09-abf1-eb1c71a79c48",
                                        "glosses": [
                                            "Présence de Dieu parmi son peuple, le peuple d’Israël, ou immanence divine dans le monde."
                                        ],
                                        "tags": [
                                            "Judaism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "697488d8-9fcd-40d2-8e2d-af2931eddceb",
                                                "sense_id": "25241eb3-bf06-354a-889c-a10d29fa4426",
                                                "text": "Dieu était bien présent, en tant que Shekhina, au milieu des trois hommes en visite chez Abraham, à Mamré, puis tout au long de la route jusqu’aux portes de Sodome. Puis Dieu s’en va, et il ne reste que les deux anges, l’un pour exterminer les villes, l’autre pour sauver Loth et sa famille. Dieu s’en est allé juste avant l’extermination."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d9dbc5fa-0222-41f5-9290-c63739c3e4e9",
                        "source_entry_id": "f561891d-8987-37d4-a0f9-d92e19ffb280",
                        "source_sense_id": "60861ebe-7816-3887-b0bb-11f8c52f3d15",
                        "target_lang_word": "Shekhiná",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Shekhiná",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "4301ca27-d455-311b-9772-0c162a361d52",
                                        "entry_id": "d3be04bf-8f8d-34bc-8bd9-e6e8db2597bc",
                                        "glosses": [
                                            "Utilizada para referir a la gloria, radiancia o presencia del Dios Yahveh."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c833bc95-f6d0-4570-937e-eae03ecffe0a",
                                                "sense_id": "4301ca27-d455-311b-9772-0c162a361d52",
                                                "text": "La Shekiná de Dios expresa cual ánima santa la presencia viva de Dios."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f8b18f6e-a882-4ce9-b293-3b8fb95b5415",
                        "source_entry_id": "f561891d-8987-37d4-a0f9-d92e19ffb280",
                        "source_sense_id": "60861ebe-7816-3887-b0bb-11f8c52f3d15",
