                "senses": [
                    {
                        "sense_id": "f6a420d0-0ae7-3987-8ca2-de95d99de982",
                        "entry_id": "44e9d080-ce75-321b-b03a-cdfc4230bb52",
                        "glosses": [
                            "die Art und Weise, zu reden/sprechen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "530f9bda-cd97-445c-8e10-95459cb43d02",
                                "sense_id": "f6a420d0-0ae7-3987-8ca2-de95d99de982",
                                "text": "„Die entspannte Gewissheit seiner Sprechweise war verstörend; […].“"
                            },
                            {
                                "example_id": "c194dbdf-fb29-4aa0-8b50-d296a660fbaf",
                                "sense_id": "f6a420d0-0ae7-3987-8ca2-de95d99de982",
                                "text": "Den Kindern solle in der Schule eine neue Sprechweise beigebracht werden: \"zwanzigeins\" statt \"einundzwanzig\", \"dreihundertvierzigsieben\" statt \"dreihundertsiebenundvierzig\" […]."
                            },
                            {
                                "example_id": "2908427a-3bb5-47ea-9b79-a1848feb4fb1",
                                "sense_id": "f6a420d0-0ae7-3987-8ca2-de95d99de982",
                                "text": "Eine moralisierende Sprechweise lehnen sie eher ab."
                            },
                            {
                                "example_id": "453a0498-1552-4a12-91e2-f30bdbdd8fe2",
                                "sense_id": "f6a420d0-0ae7-3987-8ca2-de95d99de982",
                                "text": "„Seine Sprechweise wurde hektisch, abgehackt, völlig zusammenhanglos.“"
                            },
                            {
                                "example_id": "65968151-2297-4c35-873c-424b5327f1cf",
                                "sense_id": "f6a420d0-0ae7-3987-8ca2-de95d99de982",
                                "text": "„Wenn sie sprachen, so taten sie es mit hoher Kopfstimme, eine Sprechweise ohne Schwingungen, ohne Echo, eigentlich stimmenlos, aber aus der Nähe vernehmbar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e0bc5fe8-3119-4792-8933-8d37fdfd128a",
