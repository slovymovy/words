                            {
                                "target_word": "kamikaze",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e67c9c8a-2127-3aa9-a8d2-c3061fb4047f",
                                        "entry_id": "892decf5-1944-399d-8a40-76b66ba9e2e9",
                                        "glosses": [
                                            "Suicidal, risking one's own life."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd4dd18f-d236-4df2-b9e2-15fdc82e71a8",
                                                "sense_id": "e67c9c8a-2127-3aa9-a8d2-c3061fb4047f",
                                                "text": "Sheathed in helmets, gloves, and jackets, they look more like manic video game figures than humans. They weave through traffic and around double-decker buses at kamikaze velocity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f67e4a2b-3c17-3887-8b20-4aa3326a71eb",
                                        "entry_id": "892decf5-1944-399d-8a40-76b66ba9e2e9",
                                        "glosses": [
                                            "Having or showing reckless disregard for safety or personal welfare."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c448b0a9-700b-4495-a221-7d47e19156ec",
                        "source_entry_id": "222f2da4-36a8-3f5c-9544-c028eaa0944a",
