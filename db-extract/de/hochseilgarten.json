                ],
                "senses": [
                    {
                        "sense_id": "bc60b6fe-3354-384e-8158-268e24b2ce65",
                        "entry_id": "21b7eab7-65d5-3728-ad83-84012dfd4c3d",
                        "glosses": [
                            "Kletteranlage zwischen mehreren Masten oder Bäumen mit Seilen in größerer Höhe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "055b4eab-bd00-4a14-bb0f-0a5c3dbbcc25",
                                "sense_id": "bc60b6fe-3354-384e-8158-268e24b2ce65",
                                "text": "„Wer mehr Bewegung braucht, kann sich nebenan im Hochseilgarten Upzone auf Höhenangst testen.“"
                            },
                            {
                                "example_id": "4f4046a7-5a46-4b59-9bcf-1d8cca521203",
                                "sense_id": "bc60b6fe-3354-384e-8158-268e24b2ce65",
                                "text": "„Zwischen Joggen und Motorsport liegen unzählige Möglichkeiten für sportliche und sportbegeisterte Besucher: vom Ballon-, Kanu- und Planwagenfahren über Golfen, Skaten und Reiten bis hin zum Klettern im Hochseilgarten.“"
                            },
                            {
                                "example_id": "b0376b27-3bb2-457f-8d3a-6a32063ce149",
                                "sense_id": "bc60b6fe-3354-384e-8158-268e24b2ce65",
                                "text": "„Der Hochseilgarten von Glavani hat sich seit seiner Eröffnung im Jahr 2011 zu einer der Top-Freizeitattraktionen in Istrien entwickelt.“"
                            },
                            {
                                "example_id": "470828f4-875c-4be2-a6f1-bb70faa38921",
                                "sense_id": "bc60b6fe-3354-384e-8158-268e24b2ce65",
                                "text": "„Der Hochseilgarten auf der Aqua Magica verfügt über zahlreiche Parcours (916 Elemente) mit unterschiedlichen Schwierigkeitsgraden und Anforderungen, vom Anfänger bis zum Kletter-Profi.“"
                            },
                            {
                                "example_id": "10ad345c-163f-4e87-a847-a817ea8415e9",
                                "sense_id": "bc60b6fe-3354-384e-8158-268e24b2ce65",
                                "text": "„Knapp außerhalb von Meeschendorf liegt ein Hochseilgarten, in dem in luftiger Höhe Teams oder auch Einzelpersonen über Seile und Balken klettern können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
