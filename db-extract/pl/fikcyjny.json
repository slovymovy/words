                                "target_senses": [
                                    {
                                        "sense_id": "e12c0a6a-616c-3214-9bee-f4b4934d1d4c",
                                        "entry_id": "032d3263-2c06-3cb6-a599-02594bfc83b7",
                                        "glosses": [
                                            "auf einer Fiktion, etwas Erdachtem beruhend; konstruiert, erfunden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7513a06e-fe56-4aa9-b215-9782f0fcf8c0",
                                                "sense_id": "e12c0a6a-616c-3214-9bee-f4b4934d1d4c",
                                                "text": "Sie telefonierte mit einem fiktiven Gesprächspartner."
                                            },
                                            {
                                                "example_id": "76d83c65-24ec-47f9-8313-e1dc14ffaf51",
                                                "sense_id": "e12c0a6a-616c-3214-9bee-f4b4934d1d4c",
                                                "text": "Das ist die fiktive Geschichte eines Präsidentenmörders."
                                            },
                                            {
                                                "example_id": "69faa4db-b110-4d3e-981a-89a8b95b75e7",
                                                "sense_id": "e12c0a6a-616c-3214-9bee-f4b4934d1d4c",
                                                "text": "Science Fiction beschreibt eine fiktive Welt."
                                            },
                                            {
                                                "example_id": "f9c8bf40-2c1c-4bda-a6e3-86e44ecab44b",
                                                "sense_id": "e12c0a6a-616c-3214-9bee-f4b4934d1d4c",
                                                "text": "Da es sich dabei nur um eine modelltheoretische Fiktion handelt, werden diese Größen im folgenden als fiktive Größen bezeichnet."
                                            },
                                            {
                                                "example_id": "75cf8ce4-3163-4282-9a93-18086feac34c",
                                                "sense_id": "e12c0a6a-616c-3214-9bee-f4b4934d1d4c",
                                                "text": "Kalkulatorische Kosten sind rein rechnerische, fiktive Kosten, die im Rahmen der Kosten- und Erlösrechnung bei der Ermittlung der Herstellungsbzw. Selbstkosten eines Produkts (Kalkulation) benötigt werden."
                                            }
                                        ],
