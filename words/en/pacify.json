{
    "word_family": [
        "pacification",
        "pacifier",
        "pacific",
        "pacifism",
        "pacifist"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f6e72d50-81a5-31fb-9c94-f1d64ddae542",
                    "sense_definition": "To bring peace to a place or situation by ending war, fighting, or violence.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "calm_down",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government sent troops to <w>pacify</w> the region after the riots broke out.",
                            "target_lang_translations": {
                                "zh": "骚乱爆发后，政府派遣军队去<w>平定</w>该地区。"
                            }
                        },
                        {
                            "text": "Diplomats worked hard to <w>pacify</w> the <w>conflict</w> between the two neighboring countries.",
                            "target_lang_translations": {
                                "zh": "外交官们努力工作以<w>平息</w>两国之间的冲突。"
                            }
                        }
                    ],
                    "synonyms": [
                        "quell"
                    ],
                    "antonyms": [
                        "agitate"
                    ],
                    "common_phrases": [
                        "pacify conflict",
                        "pacify region"
                    ],
                    "target_lang_definitions": {
                        "zh": "通过结束战争、战斗或暴力，使某个地区或局势恢复和平。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "平定",
                                "target_lang_sense_clarification": "指通过武力或行政手段平息叛乱或动乱。"
                            },
                            {
                                "target_lang_word": "安抚",
                                "target_lang_sense_clarification": "指通过安抚手段使局势稳定。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "528fde9b-018f-3361-bff6-57b4ca31d157",
                    "sense_definition": "To make someone feel less angry or upset.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "calm_down",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mother tried to <w>pacify</w> her crying baby with a soft lullaby.",
                            "target_lang_translations": {
                                "zh": "母亲试图用轻柔的摇篮曲来<w>安抚</w>她哭闹的婴儿。"
                            }
                        },
                        {
                            "text": "He gave her a small gift to <w>pacify</w> her <w>anger</w> after their argument.",
                            "target_lang_translations": {
                                "zh": "争吵过后，他送了她一份小礼物以<w>平息</w>她的怒气。"
                            }
                        }
                    ],
                    "synonyms": [
                        "appease",
                        "mollify",
                        "placate",
                        "soothe"
                    ],
                    "antonyms": [
                        "enrage",
                        "provoke"
                    ],
                    "common_phrases": [
                        "pacify anger"
                    ],
                    "target_lang_definitions": {
                        "zh": "使某人不再生气或心烦，平息其情绪。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "安抚",
                                "target_lang_sense_clarification": "指通过言语或行为使人平静下来。"
                            },
                            {
                                "target_lang_word": "平息",
                                "target_lang_sense_clarification": "指使愤怒或不满的情绪平复。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}