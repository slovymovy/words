                                "target_senses": [
                                    {
                                        "sense_id": "ee32bd48-3e72-3ea6-9806-3cb3ddbf9581",
                                        "entry_id": "3324f517-ce80-373b-9c0e-bc3d174b3c43",
                                        "glosses": [
                                            "A rod or staff of office, e.g. of a verger."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ced99e2f-faa4-39b2-9974-d35f84a829c0",
                                        "entry_id": "3324f517-ce80-373b-9c0e-bc3d174b3c43",
                                        "glosses": [
                                            "A rod or staff of office, e.g. of a verger.",
                                            "The stick or wand with which persons were formerly admitted tenants, by holding it in the hand and swearing fealty to the lord. Such tenants were called tenants by the verge."
                                        ],
                                        "tags": [
                                            "UK",
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fa76cc84-99f9-3546-b684-f944468f2106",
                                        "entry_id": "3324f517-ce80-373b-9c0e-bc3d174b3c43",
                                        "glosses": [
                                            "An edge or border."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f964a6c7-500e-4157-9362-f48a9e77b506",
                                                "sense_id": "fa76cc84-99f9-3546-b684-f944468f2106",
                                                "text": "Even though we go to the extreme verge of possibility to invent a supposition favourable to it, the theory[…]implies an absurdity."
                                            },
                                            {
                                                "example_id": "a51bb43a-5405-43de-aba3-7416129355da",
                                                "sense_id": "fa76cc84-99f9-3546-b684-f944468f2106",
                                                "text": "But on the horizon's verge descried,\n Hangs, touched with light, one snowy sail."
                                            },
                                            {
                                                "example_id": "22d14f72-dafd-4ec6-b043-ba99fb9a7690",
                                                "sense_id": "fa76cc84-99f9-3546-b684-f944468f2106",
                                                "text": "It was not far from the house; but the ground sank into a depression there, and the ridge of it behind shut out everything except just the roof of the tallest hayrick. As one sat on the sward behind the elm, with the back turned on the rick and nothing in front but the tall elms and the oaks in the other hedge, it was quite easy to fancy it the verge of the prairie with the backwoods close by."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31da6e3b-1ce6-3717-8dbd-fe6e98454ff3",
                                        "entry_id": "3324f517-ce80-373b-9c0e-bc3d174b3c43",
                                        "glosses": [
                                            "An edge or border.",
                                            "The grassy area between the footpath and the street; a tree lawn; a grassed strip running alongside either side of an outback road."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "New-Zealand",
                                            "UK",
                                            "Western"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "691ad174-abde-4c8a-94b9-48ce43cdafa4",
                                                "sense_id": "31da6e3b-1ce6-3717-8dbd-fe6e98454ff3",
                                                "text": "The shoulders are graded and the verges cleared well back to lessen the chances of hitting stray stock."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c3d529f-1446-3a11-b071-dccb97297d0e",
                                        "entry_id": "3324f517-ce80-373b-9c0e-bc3d174b3c43",
                                        "glosses": [
                                            "An edge or border.",
                                            "An extreme limit beyond which something specific will happen."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "689b9081-2fc4-42cc-b97b-43a99ecd4031",
                                                "sense_id": "1c3d529f-1446-3a11-b071-dccb97297d0e",
                                                "text": "I was on the verge of tears."
                                            },
                                            {
                                                "example_id": "89d93495-0946-44fd-84cc-a7786919e031",
                                                "sense_id": "1c3d529f-1446-3a11-b071-dccb97297d0e",
                                                "text": "The tremendous tragedy in which he had been involved – it was evident he was a fugitive from Weybridge - had driven him to the very verge of his reason."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f9f496e-5899-374d-acae-b07df5fbb1f8",
                                        "entry_id": "3324f517-ce80-373b-9c0e-bc3d174b3c43",
                                        "glosses": [
                                            "The phallus."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3c8c20cf-7668-345b-9377-bbafc0e2132c",
                                        "entry_id": "3324f517-ce80-373b-9c0e-bc3d174b3c43",
                                        "glosses": [
                                            "The phallus.",
                                            "The external male organ of certain mollusks, worms, etc."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8e6227c7-af15-3ddf-8084-25259a0aed90",
                                        "entry_id": "3324f517-ce80-373b-9c0e-bc3d174b3c43",
                                        "glosses": [
                                            "An old measure of land: a virgate or yardland."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7ee5d50c-1e0b-30c5-a754-4552cd366793",
                                        "entry_id": "3324f517-ce80-373b-9c0e-bc3d174b3c43",
                                        "glosses": [
                                            "A circumference; a circle; a ring."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00648461-901a-44c6-912d-572c3fc79cfc",
                                                "sense_id": "7ee5d50c-1e0b-30c5-a754-4552cd366793",
                                                "text": "The inclusive verge\n Of golden metal that must round my brow."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12a25927-0f3c-3c3a-9d91-b932c3ca4039",
                                        "entry_id": "3324f517-ce80-373b-9c0e-bc3d174b3c43",
                                        "glosses": [
                                            "The shaft of a column, or a small ornamental shaft."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fee9ca42-0d80-35c7-9ec9-b9feb9886087",
                                        "entry_id": "3324f517-ce80-373b-9c0e-bc3d174b3c43",
                                        "glosses": [
                                            "The eaves or edge of the roof that projects over the gable of a roof."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db998cb8-607b-4dca-a5a1-28e1e45a6580",
                                                "sense_id": "fee9ca42-0d80-35c7-9ec9-b9feb9886087",
                                                "text": "The smaller ribs of tiles that run down to the eaves, along the ridges in a hip-roof, or border the verge in a gable-roof , often terminate in some ornamental tile in high-relief ."
                                            }
                                        ]
                                    },
