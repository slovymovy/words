        "fr-extract.jsonl": [
            {
                "entry_id": "895ca1c2-e183-3ca3-8e54-e70734215d82",
                "word": "esquille",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6d69808f-25bc-475c-94e0-9c04beccf253",
                        "entry_id": "895ca1c2-e183-3ca3-8e54-e70734215d82",
                        "tags": [
                            "plural"
                        ],
                        "form": "esquilles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "30bb297d-7d95-3454-b702-89ed68c8d1af",
                        "entry_id": "895ca1c2-e183-3ca3-8e54-e70734215d82",
                        "glosses": [
                            "Petit fragment acéré de bois, de pierre, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2be82426-bee3-447b-8a6c-70b0b1ded41f",
                                "sense_id": "30bb297d-7d95-3454-b702-89ed68c8d1af",
                                "text": "On fit donc grâce à la malheureuse des esquilles de bois enfoncées sous les ongles, […], d’autres tortures encore."
                            },
                            {
                                "example_id": "ad3cda79-2abc-48e3-9ddc-1510409b6fca",
                                "sense_id": "30bb297d-7d95-3454-b702-89ed68c8d1af",
                                "text": "Les glaces s'étant rapprochées, il fallut user des grands moyens pour nous dégager, intervention d'espars, carambolages, chocs violents ; notre soufflage y laissa quelques esquilles."
                            },
                            {
                                "example_id": "3138079b-5b19-43a5-aa7a-d6d6fef222a3",
                                "sense_id": "30bb297d-7d95-3454-b702-89ed68c8d1af",
                                "text": "À leurs pieds, le sol désolé par l’hiver est aride, squelettique et les pierres gelées des balustres se brisent comme des esquilles."
                            }
                        ]
                    },
                    {
                        "sense_id": "c1014c21-0138-37db-85f4-ffe51fd5fc9e",
                        "entry_id": "895ca1c2-e183-3ca3-8e54-e70734215d82",
                        "glosses": [
                            "Petit fragment qui se détache d’un os fracturé ou carié."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "c100cf03-1d9b-41c8-9bed-077916b09bcb",
                                "sense_id": "c1014c21-0138-37db-85f4-ffe51fd5fc9e",
                                "text": "Il est sorti une esquille de la plaie."
                            },
                            {
                                "example_id": "50090b42-375a-4a1c-8bf1-f4863c1d4e70",
                                "sense_id": "c1014c21-0138-37db-85f4-ffe51fd5fc9e",
                                "text": "Le chef shawnee brandit son tomahawk et l'abat sur le crâne luisant de Bournemouth, qui éclate comme une pastèque trop mûre. Rudy s'est reculé – pas assez vite : il reçoit des giclées de sang, d’esquilles et de cervelle."
                            },
                            {
                                "example_id": "1f65160e-d45a-4fd0-96cd-0a42294141c3",
                                "sense_id": "c1014c21-0138-37db-85f4-ffe51fd5fc9e",
                                "text": "Il parcourut les rives du cours d'eau en aval pendant une bonne partie de la matinée avant de découvrir un petit squelette qui recelait plusieurs esquilles d'os suffisamment solides pour être utilisées comme aiguilles."
                            },
                            {
                                "example_id": "0b8b9197-794a-4f0b-b5a6-606dcf78355c",
                                "sense_id": "c1014c21-0138-37db-85f4-ffe51fd5fc9e",
                                "text": "Quand nous revînmes ramasser ce qui restait de lui comme le veut la coutume, c'est à moi qu'elle fît porter l'urne qui contenait ses cendres et quelques esquilles de ses os sur le chemin du retour."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ea7afc56-3432-4e56-a67c-f13e3818d4be",
                        "source_entry_id": "895ca1c2-e183-3ca3-8e54-e70734215d82",
                        "target_lang_word": "Knochensplitter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Knochensplitter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "723eabbd-4945-365f-b3df-b18523bc6822",
                                        "entry_id": "534877b8-f974-395b-9a37-4a50ec0fb41d",
                                        "glosses": [
                                            "kleines Bruchstück eines Knochens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe866661-cabb-40db-b804-834ecab826ae",
                                                "sense_id": "723eabbd-4945-365f-b3df-b18523bc6822",
                                                "text": "„Ein Knochensplitter nach dem andern eiterte heraus.“"
                                            },
                                            {
                                                "example_id": "d24d9c2d-444b-41df-bad4-5daff9dd2efe",
                                                "sense_id": "723eabbd-4945-365f-b3df-b18523bc6822",
                                                "text": "„Die ›Authentizität‹ der einzelnen Knochensplitter mag uns fragwürdig und das Intarsienskelett im Ganzen als Skurrilität erscheinen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
