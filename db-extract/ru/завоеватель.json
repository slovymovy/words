                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a45f33c8-c15d-4ed1-b804-fc1b2a002e88",
                                                "sense_id": "f8554e38-d7a2-3758-9e8d-7e4918a5bb39",
                                                "text": "Alexandre fut un grand conquérant. - Guillaume le Conquérant. - Zénobie fut une illustre conquérante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aee89a8f-86aa-3db5-9187-78a56e65e589",
                                        "entry_id": "15ba7602-3064-3205-ad46-6427fd62ec35",
                                        "glosses": [
                                            "Celui qui a subjugué par le charme."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "464410a5-e89f-408a-8e83-677f15e537f9",
                                                "sense_id": "aee89a8f-86aa-3db5-9187-78a56e65e589",
                                                "text": "Il oublie le reste, la démarche, la grâce, […], ces hanches qui font bouger l’espace, je n’ai pas vraiment vu son visage mais il ne saurait être que celui d’une conquérante, d’une vainqueresse."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "conquérant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9ed12ff8-1a62-334f-99d5-6debd3f3aa99",
                                        "entry_id": "b40d9926-9a5e-3d05-865e-18b340a99e2e",
                                        "glosses": [
                                            "Qui a conquis par les armes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3cae071-7b98-4ee1-abf9-73ae7b662a3d",
                                                "sense_id": "9ed12ff8-1a62-334f-99d5-6debd3f3aa99",
                                                "text": "C'est ce qui permit à une minorité conquérante, politiquement et socialement dominante, de populations surtout chrétiennes, païennes et zoroastriennes, de consolider l'Islam et de soumettre rapidement les mondes sémitiques et iranien."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8010cc5-e12b-33c4-a78b-9f36171878a0",
                                        "entry_id": "b40d9926-9a5e-3d05-865e-18b340a99e2e",
                                        "glosses": [
                                            "Qualifie ce qui appartient à ceux qui ont conquis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7851ea3a-8c51-4e6f-be79-1522f7635e84",
                                                "sense_id": "e8010cc5-e12b-33c4-a78b-9f36171878a0",
                                                "text": "L’aide tient tête à un flot envahissant de jeunes gens résolus, en chapeaux melons et cravates conquérantes, qui brandissent des carnets de notes ou soulèvent des appareils photographiques."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "conquérant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "20f261ce-deea-3b60-8d96-ff2b0a889a99",
                                        "entry_id": "de9f0f19-1469-3873-be1d-0667f2a13d49",
