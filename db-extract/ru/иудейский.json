                ],
                "senses": [
                    {
                        "sense_id": "2c0438b3-2cb8-3632-b217-7312166a2a74",
                        "entry_id": "62567c05-06f5-3879-98c2-e7adce8f862a",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительными иудеи, Иудея"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "17fbc97b-5192-459d-8e52-840a17fe7631",
                        "source_entry_id": "62567c05-06f5-3879-98c2-e7adce8f862a",
                        "source_sense_id": "2c0438b3-2cb8-3632-b217-7312166a2a74",
                        "target_lang_word": "jüdisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jüdisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "24d9a056-cea6-39f7-921e-d030d4b160b7",
                                        "entry_id": "5b681546-7a3a-30fc-aa44-85e4649a16f0",
                                        "glosses": [
                                            "dem Judentum zugehörig, mit jüdischen Merkmalen versehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0e8317c-e46b-4acb-9d8b-5b6818ee53d4",
                                                "sense_id": "24d9a056-cea6-39f7-921e-d030d4b160b7",
                                                "text": "Die jüdische Religion basiert auf den religiösen Überlieferungen des jüdischen Volkes."
                                            },
                                            {
                                                "example_id": "e87a7dc6-bc6f-4590-8560-77c5aa243b26",
                                                "sense_id": "24d9a056-cea6-39f7-921e-d030d4b160b7",
                                                "text": "„Vielen Bereichen der Wirtschaft und Technik, der Wissenschaft und der Kunst in Deutschland gaben jüdische Männer und Frauen das Gepräge.“"
                                            },
                                            {
                                                "example_id": "f40eb41e-cb90-4cc9-a0d1-332e47cbf75a",
                                                "sense_id": "24d9a056-cea6-39f7-921e-d030d4b160b7",
                                                "text": "„Lydia, ein gutbürgerliches, in jüdischer Tradition erzogenes Mädchen, war das einzige Kind einer angesehenen, in Berlin ansässigen Familie gewesen.“"
                                            },
                                            {
                                                "example_id": "ce4254b4-8d2e-4051-8b0d-1b805f4d08fb",
                                                "sense_id": "24d9a056-cea6-39f7-921e-d030d4b160b7",
                                                "text": "„Und wie hätte ich die Augen abwenden können und wohin, in dieser einst jüdischsten Stadt Europas?“"
                                            },
                                            {
                                                "example_id": "24879167-4f88-4ac3-be6d-f6e642cee622",
                                                "sense_id": "24d9a056-cea6-39f7-921e-d030d4b160b7",
                                                "text": "„Der Geist, der immer in ihnen gelebt hatte und der früher oder später doch zum Vorschein gekommen wäre, des mütterlichen Zweiges, Leas Erbe, war nun durch den Druck von außen zutage getreten - die Judaisierung der Brüder Bertini erfolgte über die jüdischste aller Möglichkeiten: die Selbstglossierung!“"
                                            },
                                            {
                                                "example_id": "562f48ab-4795-491d-8071-059388dea808",
                                                "sense_id": "24d9a056-cea6-39f7-921e-d030d4b160b7",
                                                "text": "„Die in der Septuaginta enthaltenen, aber von der jüdischen Gemeinde in den Kanon nicht aufgenommenen Schriften bezeichnet man als Apokryphen, d. h. als verborgene, von der öffentlichen Verbreitung ausgeschlossene Schriften.“"
                                            },
                                            {
                                                "example_id": "dddd8819-8585-4a6e-9657-d5b7b0bb4d42",
                                                "sense_id": "24d9a056-cea6-39f7-921e-d030d4b160b7",
                                                "text": "[Jüdisches Leben in der Weimarer Republik:] „Deutsche mit jüdischem Glauben waren eine kleine, aber bedeutende Minderheit. 1925 lebten etwas 500 000 Juden in Deutschland.“"
                                            },
                                            {
                                                "example_id": "7982a899-c4fc-4ea4-be6f-46dc9f398e42",
                                                "sense_id": "24d9a056-cea6-39f7-921e-d030d4b160b7",
                                                "text": "„Insgesamt gab es in Deutschland 1 600 Synagogen (jüdische Gotteshäuser) und Beträume.“"
                                            },
                                            {
                                                "example_id": "e42442d7-0371-44ff-bed0-c18811f4161d",
                                                "sense_id": "24d9a056-cea6-39f7-921e-d030d4b160b7",
                                                "text": "„Bekannte Fußballclubs wie Bayern München oder Eintracht Frankfurt wurden von jüdischen Fabrikanten finanziell gefördert.“"
                                            },
                                            {
                                                "example_id": "510ed719-9d3c-472b-be66-988f07cbfeab",
                                                "sense_id": "24d9a056-cea6-39f7-921e-d030d4b160b7",
                                                "text": "[Jüdisches Leben in der Weimarer Republik:] „Überdurchschnittlich viele jüdische Schüler besuchten höhere Schulen und studierten.“"
                                            },
                                            {
                                                "example_id": "df96f0b9-ac94-4260-af27-85f674a105b4",
                                                "sense_id": "24d9a056-cea6-39f7-921e-d030d4b160b7",
                                                "text": "[Jüdisches Leben in der Weimarer Republik:] „Populäre Schauspieler, Künstler, Schriftsteller und Komponisten waren oft jüdischer Herkunft.“"
                                            },
                                            {
                                                "example_id": "0e965487-0f19-40c2-9fc4-7923b0646bf5",
                                                "sense_id": "24d9a056-cea6-39f7-921e-d030d4b160b7",
                                                "text": "„In der Forschung leisteten deutsche Juden Besonderes: Zwischen 1921 und 1931 waren fünf der 15 deutschen Nobelpreisträger jüdische Wissenschaftler, z. B. Albert Einstein.“"
                                            },
                                            {
                                                "example_id": "6b5fd674-96bd-4743-966d-49a6e642ee55",
                                                "sense_id": "24d9a056-cea6-39f7-921e-d030d4b160b7",
                                                "text": "„1991 beschloss das wiedervereinigte Deutschland, in großer Zahl jüdische Migrantinnen und Migranten aufzunehmen.“"
                                            },
                                            {
                                                "example_id": "eadf2019-ff37-42fa-84c3-19eae72082fc",
                                                "sense_id": "24d9a056-cea6-39f7-921e-d030d4b160b7",
                                                "text": "„93 Prozent der jüdischen Seniorinnen und Senioren in Deutschland sind auf Grundsicherung angewiesen – im Vergleich zu 2,4 Prozent der deutschen Rentnerinnen und Rentner.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
