                    {
                        "sense_id": "19bfd218-f68d-3ee8-a55f-e80352570d83",
                        "entry_id": "16c20bc8-34ec-3a10-9d9d-0663e5e84a2a",
                        "glosses": [
                            "Person, die bahnbrechende Leistungen für die Entwicklung des Internets erbracht hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d1c444d-b956-43aa-bce6-e775b4449433",
                                "sense_id": "19bfd218-f68d-3ee8-a55f-e80352570d83",
                                "text": "„Seine Berufung fand Milner um die Jahrtausendwende, als er sich selbstständig machte, um zum Internetpionier in Russland zu werden.“"
                            },
                            {
                                "example_id": "8ee9e585-fc7a-426c-a281-11ba7ccfdf83",
                                "sense_id": "19bfd218-f68d-3ee8-a55f-e80352570d83",
                                "text": "„Vor allem eine Ankündigung im Satellitengeschäft weckt große Erwartungen, für den amerikanischen Internetpionier Greg Wyler sollen die Europäer 900 Kleinsatelliten bauen.“"
                            },
                            {
                                "example_id": "34bd83e9-d808-40b9-b745-9c437cf82549",
                                "sense_id": "19bfd218-f68d-3ee8-a55f-e80352570d83",
                                "text": "„Auf die Idee kam der Internetpionier aus privatem Interesse, besitzt er doch einen mit 2000 Flaschen gefüllten Weinkeller.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
