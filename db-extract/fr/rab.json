                "senses": [
                    {
                        "sense_id": "676d418b-75e4-3ffd-8498-07f3f6cba569",
                        "entry_id": "0c247c58-e5bb-36f3-9740-efaae500e27f",
                        "glosses": [
                            "Reste, supplément."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "9bdcd113-38e7-48c5-869e-ff3af7eed067",
                                "sense_id": "676d418b-75e4-3ffd-8498-07f3f6cba569",
                                "text": "Reprends du rab, fiston. On sait c’que c’est qu’la faim."
                            },
                            {
                                "example_id": "744fc110-ae54-42fc-bf83-b8dd08db2678",
                                "sense_id": "676d418b-75e4-3ffd-8498-07f3f6cba569",
                                "text": "Les permissionnaires ne songeaient pas à lambiner ; quant aux retenus, aux privés de vacances, ils pouvaient s’octroyer un modique « rab de pieu »."
                            },
                            {
                                "example_id": "2655a2bd-8b57-4b17-9fc5-4a7834ac5ee8",
                                "sense_id": "676d418b-75e4-3ffd-8498-07f3f6cba569",
                                "text": "Il a rechanté le deuxième acte intégral, je lui ai refilé du rab."
                            },
                            {
                                "example_id": "a5fda1cf-7bef-4060-b08b-b1b23d954ddd",
                                "sense_id": "676d418b-75e4-3ffd-8498-07f3f6cba569",
                                "text": "En rab, en plus, en supplément."
                            },
                            {
                                "example_id": "88aa1928-87ef-468a-89fe-5c194760fb86",
                                "sense_id": "676d418b-75e4-3ffd-8498-07f3f6cba569",
                                "text": "Faire du rab, travailler au-delà du temps normal, en faire plus que prévu."
                            }
                        ]
                    },
                    {
                        "sense_id": "0e95a8ca-74de-3b5f-b48f-a568be37c2b6",
                        "entry_id": "0c247c58-e5bb-36f3-9740-efaae500e27f",
                        "glosses": [
                            "Marge, marge de manœuvre."
                        ],
                        "tags": [
