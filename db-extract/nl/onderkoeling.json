                        "glosses": [
                            "van een vloeistof dat ze hoewel kouder dan het smeltpunt toch nog vloeibaar is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66f5cd5c-d86e-4c4e-a761-3df08047a7d5",
                                "sense_id": "1f8e0c50-3757-3b3b-b23f-62e99f622ddf",
                                "text": "Toen de onderkoelde regen op het wegdek kwam ontstond er direct een dikke ijslaag."
                            }
