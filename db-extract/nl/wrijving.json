                        "form": "wrijvinkje"
                    },
                    {
                        "form_id": "751c2ece-deae-4518-97f5-2c62719e0543",
                        "entry_id": "88c55fb7-eb83-3f12-9c46-5317ecf9cae3",
                        "tags": [
                            "diminutive",
                            "plural"
                        ],
                        "form": "wrijvinkjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f643c758-f5c0-3edc-b2d1-9f4f64b249f6",
                        "entry_id": "88c55fb7-eb83-3f12-9c46-5317ecf9cae3",
                        "glosses": [
                            "is in de natuurkunde het verschijnsel waarbij een weerstandskracht kan ontstaan wanneer twee oppervlakken langs elkaar schuiven, terwijl ze tegen elkaar aan gedrukt worden."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd3c9e2e-a3d9-479c-9152-50e0f05468eb",
                                "sense_id": "f643c758-f5c0-3edc-b2d1-9f4f64b249f6",
                                "text": "Door wrijving ontstaat warmte"
                            },
                            {
                                "example_id": "be2f533c-017c-484d-8e55-6ad5c56b2f3c",
                                "sense_id": "f643c758-f5c0-3edc-b2d1-9f4f64b249f6",
                                "text": "Door het zweet en constante wrijving werd mijn huid tussen mijn dijen en billen bij elke stap opengeschuurd."
                            }
                        ]
                    },
                    {
                        "sense_id": "91cd582f-419e-334a-9c88-64a31622b3f5",
                        "entry_id": "88c55fb7-eb83-3f12-9c46-5317ecf9cae3",
                        "glosses": [
                            "een klein meningsverschil"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "827a3f06-e195-4754-a875-567da1701c13",
                                "sense_id": "91cd582f-419e-334a-9c88-64a31622b3f5",
                                "text": "Ook in het beste huwelijk komen wrijvingen voor die warmte veroorzaken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8ed83333-313b-4c8f-9b2f-8338c05d51e1",
                        "source_entry_id": "88c55fb7-eb83-3f12-9c46-5317ecf9cae3",
                        "target_lang_word": "friction",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "friction",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8f4c7229-1fd5-31a1-a39b-bc48c0aaa115",
                                        "entry_id": "2b187067-c9c8-3049-b2d7-a1db148b972c",
                                        "glosses": [
                                            "The rubbing of one object or surface against another."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14eacb19-8d6b-40de-b196-d770b90f29a0",
                                                "sense_id": "8f4c7229-1fd5-31a1-a39b-bc48c0aaa115",
                                                "text": "Energy has seldom been found where we need it when we want it. Ancient nomads, wishing to ward off the evening chill and enjoy a meal around a campfire, had to collect wood and then spend time and effort coaxing the heat of friction out from between sticks to kindle a flame."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73871f3d-8a24-3199-b231-1e902a27a279",
                                        "entry_id": "2b187067-c9c8-3049-b2d7-a1db148b972c",
                                        "glosses": [
                                            "A force that resists the relative motion or tendency to such motion of two bodies in contact."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28f6a118-2c7a-46a7-bab1-8189b997f218",
                                                "sense_id": "73871f3d-8a24-3199-b231-1e902a27a279",
                                                "text": "Secondly, When a body is once in motion it will continue to move forever, unless something stops it. When a ball is struck on the surface of the earth, the friction of the earth and the resistance of the air soon stop its motion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71dbc22e-652e-3739-ad93-1fd3424e24ba",
                                        "entry_id": "2b187067-c9c8-3049-b2d7-a1db148b972c",
                                        "glosses": [
                                            "Massage of the body to restore circulation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f43a74a6-3e9b-4815-914b-d3757cd273d1",
                                                "sense_id": "71dbc22e-652e-3739-ad93-1fd3424e24ba",
                                                "text": "The frictions should at first be very gentle, and performed with a view to restore heat, and not to force the blood towards the heart, which in drowned persons is already too much distended with it."
                                            },
                                            {
                                                "example_id": "ee3b7256-a9b3-4301-b1bc-c92db1da2742",
                                                "sense_id": "71dbc22e-652e-3739-ad93-1fd3424e24ba",
                                                "text": "The frictions are made at bedtime, on a limited portion of the body, and on one side only—the calf of the leg by preference, or the thigh, groin, or axilla. It is enough to continue rubbing for from three to five minutes at most."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dfe6f639-6405-3be8-9a5d-5996145793fb",
                                        "entry_id": "2b187067-c9c8-3049-b2d7-a1db148b972c",
                                        "glosses": [
                                            "Conflict, as between persons having dissimilar ideas or interests; clash."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05199340-e129-43e5-b62d-32716754dc53",
                                                "sense_id": "dfe6f639-6405-3be8-9a5d-5996145793fb",
                                                "text": "Once finances are stabilised, getting Crossrail finished is Byford's most obvious task. Late and over budget, it is causing unwanted headlines and friction between the London Mayor and the Department for Transport that both sides would rather live without."
                                            },
                                            {
                                                "example_id": "27c25ddc-6fe9-43e1-9d2f-aa895f857cf5",
                                                "sense_id": "dfe6f639-6405-3be8-9a5d-5996145793fb",
                                                "text": "Thais have been watching for signs of friction between the armed forces and the monarchy—the country's two biggest sources of political power—since the death in October of Bhumibol Adulyadej, King Vajiralongkorn's long-reigning father."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4315e42a-87d1-3b02-8f6e-26f872be8b7f",
                                        "entry_id": "2b187067-c9c8-3049-b2d7-a1db148b972c",
                                        "glosses": [
                                            "(Second Sino-Japanese War) Conflict, as between the Communists and non-Hanjian Kuomintang forces."
                                        ],
                                        "tags": [
                                            "China",
                                            "historical",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ff5dfdad-9da2-48ad-a34c-e66bcefcbf65",
                        "source_entry_id": "88c55fb7-eb83-3f12-9c46-5317ecf9cae3",
                        "target_lang_word": "frottement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "frottement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ab691ac5-7ef7-34e6-9b95-64af4ad56360",
                                        "entry_id": "653ce059-2fbe-37c1-addf-a3f3f212460d",
                                        "glosses": [
                                            "Action de frotter ; action de deux choses qui se frottent mutuellement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81ae061b-03c2-4c90-beb6-a558335ed71e",
                                                "sense_id": "ab691ac5-7ef7-34e6-9b95-64af4ad56360",
                                                "text": "Et les éclairs, de même, se produisent selon plusieurs modes ; en effet, c’est par le frottement et le choc des nuages que la configuration du feu propre à produire cet effet, lorsqu’elle s’en échappe, produit l’éclair."
                                            },
                                            {
                                                "example_id": "cd7e0974-7e6d-4294-90ad-23c1f18fe5ba",
                                                "sense_id": "ab691ac5-7ef7-34e6-9b95-64af4ad56360",
                                                "text": "La torsion régularise le diamètre du fil et elle tend à disposer les aspérités des fibres dans le sens transversal; donc plus un fil est tordu, plus le coefficient de frottement est faible."
                                            },
                                            {
                                                "example_id": "c83268f5-7677-45d8-b2b8-8ac49ecd88ad",
                                                "sense_id": "ab691ac5-7ef7-34e6-9b95-64af4ad56360",
                                                "text": "Je ne venais plus sur le pont que pour changer ou épisser les parties du gréement usées par le frottement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63958cdb-bc68-3c21-93ac-0f835c03b00e",
                                        "entry_id": "653ce059-2fbe-37c1-addf-a3f3f212460d",
                                        "glosses": [
                                            "Résistance mécanique au glissement ou au roulement."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "92aa10c6-63e2-3752-8d31-2467a8e150d5",
                                        "entry_id": "653ce059-2fbe-37c1-addf-a3f3f212460d",
                                        "glosses": [
                                            "Commerce, fréquentation."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3d5bdbd-2743-4e37-a072-bf885f3b140c",
                                                "sense_id": "92aa10c6-63e2-3752-8d31-2467a8e150d5",
                                                "text": "Le frottement du monde."
                                            },
                                            {
                                                "example_id": "d2cfb522-41a4-4c6d-af20-d3d05dbfa890",
                                                "sense_id": "92aa10c6-63e2-3752-8d31-2467a8e150d5",
                                                "text": "Avoir du frottement. — Manquer de frottement."
                                            },
                                            {
                                                "example_id": "5c2fa1c7-ac4a-4d80-8338-228dd1dd3972",
                                                "sense_id": "92aa10c6-63e2-3752-8d31-2467a8e150d5",
                                                "text": "Ombrageux, retiré, sociable seulement avec les compagnons de mes habitudes, dans une constante défiance des contacts nouveaux, le plus possible j’évitais ce terrible frottement de la vie parisienne qui polit les caractères et les aplanit jusqu’à l’usure."
                                            },
                                            {
                                                "example_id": "c4a5bcec-0b97-4e26-931b-205bbdbeb7f7",
                                                "sense_id": "92aa10c6-63e2-3752-8d31-2467a8e150d5",
                                                "text": "Avant de s’établir jardinier à son compte « le père » avait travaillé aux pépinières du Jardin des Plantes, et là il s’était trouvé en contact avec des gens de science et d’étude dont le frottement lui avait donné la curiosité de lire et d’apprendre."
                                            },
                                            {
                                                "example_id": "bb790167-ad7f-400e-bc1c-8488d42b6e3d",
                                                "sense_id": "92aa10c6-63e2-3752-8d31-2467a8e150d5",
                                                "text": "Même au point de vue du frottement avec mes pareils, le but qu’on avait cru atteindre était manqué aussi complètement que possible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53bc662f-b29a-3eda-ba4e-664bf1923510",
                                        "entry_id": "653ce059-2fbe-37c1-addf-a3f3f212460d",
                                        "glosses": [
                                            "Situation d'inadéquation ou d'incohérence qui engendre des résistances et des tensions."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "49d29f99-24da-3b2c-8410-742282cc1129",
                                        "entry_id": "653ce059-2fbe-37c1-addf-a3f3f212460d",
                                        "glosses": [
                                            "Ensemble des impôts et taxes fiscales qui réduisent le rendement d’un placement financier, notamment boursier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10b17273-5dd3-479b-b15a-7021b1626f64",
                                                "sense_id": "49d29f99-24da-3b2c-8410-742282cc1129",
                                                "text": "La création d’une holding permet de réduire le frottement fiscal."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
