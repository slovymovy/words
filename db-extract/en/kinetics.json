                        "entry_id": "a8a752ff-128b-3a9d-8f20-523d783e8079",
                        "glosses": [
                            "The branch of chemistry that is concerned with the rates of chemical reactions."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": []
                    }
