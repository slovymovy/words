                "senses": [
                    {
                        "sense_id": "988aa65d-f70d-3de4-a3ed-ed98480e4c41",
                        "entry_id": "21b2ecac-8e97-3565-a75a-ecf9f29822df",
                        "glosses": [
                            "разг. человек, которому во всём сопутствует удача"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7dc54f2e-654e-4669-9806-2f293e6bef56",
                                "sense_id": "988aa65d-f70d-3de4-a3ed-ed98480e4c41",
                                "text": "Как бы ни была расположена // или не расположена // власть, // я уже получил что положено. // Жизнь уже удалась. // Я — удачник! // И хоть никуда не спешил, // весь задачник // решил!"
                            },
                            {
                                "example_id": "cc895348-a373-4d33-81b2-ac731e33a27e",
                                "sense_id": "988aa65d-f70d-3de4-a3ed-ed98480e4c41",
                                "text": "«Я тоже эмигрантка, — сказала Анна, — но я — удачник!»"
                            }
                        ]
                    }
                ],
