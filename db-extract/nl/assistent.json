                    },
                    {
                        "translation_id": "2d95819c-cbc1-472e-a0c8-061802da92f6",
                        "source_entry_id": "f15abc7e-9025-3e5f-991c-f99baa244ee4",
                        "source_sense_id": "5389bf1d-b1ac-3c21-bd46-1163718f561e",
                        "source_sense_description": "een persoon die ondersteunt",
                        "target_lang_word": "Mitarbeiter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mitarbeiter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e8ee882a-891d-3acc-8112-96e7a6a4fe18",
                                        "entry_id": "5f7002dc-e9f7-36c0-8226-2b52fbbea79a",
                                        "glosses": [
                                            "jemand, der zusammen mit anderen im gleichen Betrieb oder in der gleichen Institution arbeitet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81ef27ae-80f7-42b8-971c-1090b68eab1d",
                                                "sense_id": "e8ee882a-891d-3acc-8112-96e7a6a4fe18",
                                                "text": "Die Firma hat zwölf Mitarbeiter."
                                            },
                                            {
                                                "example_id": "157270a3-ef05-45ad-af59-2fd93437ae1c",
                                                "sense_id": "e8ee882a-891d-3acc-8112-96e7a6a4fe18",
                                                "text": "„In einer Firma wurden vier einheimische Mitarbeiter gegen vier billigere Arbeitskräfte aus dem Ausland eingetauscht, aber niemand wusste, dass es sich bei ihnen um Kannibalen handelte.“"
                                            },
                                            {
                                                "example_id": "06aa8f12-a556-476b-8aa9-6c1368dd0ccc",
                                                "sense_id": "e8ee882a-891d-3acc-8112-96e7a6a4fe18",
                                                "text": "„Manche von ihnen, erzählt ein langjähriger ehemaliger Mitarbeiter der Bank, verkaufen während des Wettbewerbs mehr als zehnmal so viele Verträge wie an normalen Tagen.“"
                                            },
                                            {
                                                "example_id": "e616a20f-3631-4351-92b2-0f1a77b4bfe8",
                                                "sense_id": "e8ee882a-891d-3acc-8112-96e7a6a4fe18",
                                                "text": "„Doch er fand nicht die Ruhe zum Lesen, sondern dachte über das bevorstehende Wochenende nach und über die Tatsache, dass er seinem neuen Mitarbeiter Ögmundur zum ersten Mal die Wache anvertrauen musste.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d3d9c846-6561-37b5-9748-50885baba906",
                                        "entry_id": "5f7002dc-e9f7-36c0-8226-2b52fbbea79a",
                                        "glosses": [
                                            "jemand, der in der Gruppe oder Firma einer Person arbeitet, die ihm Weisungen erteilen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dfb6a0f8-2143-4987-a42a-bbaa9cda22c8",
                                                "sense_id": "d3d9c846-6561-37b5-9748-50885baba906",
                                                "text": "Der Chef ermahnte seine Mitarbeiter."
                                            },
                                            {
                                                "example_id": "4ddf7dd9-3eee-42df-87b9-ea76f71bb212",
                                                "sense_id": "d3d9c846-6561-37b5-9748-50885baba906",
                                                "text": "„Organisatorische Fähigkeiten fehlten ihm, so war er auf einen Stab von Mitarbeitern angewiesen, die er wahllos heranzog.“"
                                            },
                                            {
                                                "example_id": "ca0db1cc-8b0e-443a-bf1a-e5c5066bff7e",
                                                "sense_id": "d3d9c846-6561-37b5-9748-50885baba906",
                                                "text": "„Auch bei der Aufstellung seiner Mitarbeiter ließ man ihm freie Hand.“"
                                            },
                                            {
                                                "example_id": "6b956bc5-4d39-44dc-8516-dbb3751af6a0",
                                                "sense_id": "d3d9c846-6561-37b5-9748-50885baba906",
                                                "text": "„Er befahl seinen drei Mitarbeitern, den Pfarrer und Herrn Karlsson im Auge zu behalten, während er sich selbst auf den Weg zur Garage machte, um sich zu erkundigen.“"
                                            },
                                            {
                                                "example_id": "159c92c9-5eb3-49a8-9528-bd12d3b63354",
                                                "sense_id": "d3d9c846-6561-37b5-9748-50885baba906",
                                                "text": "„Auf seinem Schreibtisch liegen allerlei Papierstapel und die Tabelle 22 mit den Jahresumsätzen seiner Mitarbeiter in den einzelnen Bezirken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4e5f214b-72ae-4de3-ae42-b0d788d7b41c",
                        "source_entry_id": "f15abc7e-9025-3e5f-991c-f99baa244ee4",
                        "source_sense_id": "5389bf1d-b1ac-3c21-bd46-1163718f561e",
                        "source_sense_description": "een persoon die ondersteunt",
                        "target_lang_word": "Helfer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Helfer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e9d64fbd-95cd-3d9b-9561-b5ef922983e6",
                                        "entry_id": "1d08b87b-3487-31cd-84ff-5119e1c9a402",
                                        "glosses": [
                                            "Person, die jemanden hilft oder unterstützt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e110886a-8b84-491c-bf2c-b95b6fc43f73",
                                                "sense_id": "e9d64fbd-95cd-3d9b-9561-b5ef922983e6",
                                                "text": "„Das THW hat 15 Spezialisten nach Haiti geschickt. Wie die Helfer arbeiten und mit der Belastung umgehen, erzählt Oliver Hochedez aus dem THW-Leitungsstab.“"
                                            },
                                            {
                                                "example_id": "c9f6a856-985d-4c3a-a77a-d28b993bcb8d",
                                                "sense_id": "e9d64fbd-95cd-3d9b-9561-b5ef922983e6",
                                                "text": "„Nach dem doppelten Terroranschlag in der Moskauer Metro mit 39 Toten fahnden die russischen Ermittler nach den Helfern der beiden Selbstmordattentäterinnen.“"
                                            },
                                            {
                                                "example_id": "24640487-5da3-41c4-9214-4d9eeed138e1",
                                                "sense_id": "e9d64fbd-95cd-3d9b-9561-b5ef922983e6",
                                                "text": "„Das unsichtbare Netz der Helfer wird schon tragen.“"
                                            },
                                            {
                                                "example_id": "344eaba6-d340-4c35-9768-a744286f6947",
                                                "sense_id": "e9d64fbd-95cd-3d9b-9561-b5ef922983e6",
                                                "text": "„Diese Helfer aus dem Ausland banden die ganze Gemeinschaft mit ein, angefangen bei in Dörfern lebenden Schülern, die Ältere dazu ermuntern sollten, über die Vergangenheit zu sprechen und Geschichten zu erzählen.“"
                                            },
                                            {
                                                "example_id": "ed54d74f-6e39-45f7-b9e7-bcca92c649cf",
                                                "sense_id": "e9d64fbd-95cd-3d9b-9561-b5ef922983e6",
                                                "text": "„Der Motor des Schleppflugzeugs wird auf Touren gebracht, ein Helfer hebt den Flügel des Segelflugzeuges an, und nun zieht der Motorflieger an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "565cdf7a-9870-3c83-90c7-5a2e3cc100b9",
                                        "entry_id": "1d08b87b-3487-31cd-84ff-5119e1c9a402",
                                        "glosses": [
                                            "eine Sache, die eine Unterstützung bietet"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2640f4a-1ddf-43f5-a809-6f16b4f32d27",
                                                "sense_id": "565cdf7a-9870-3c83-90c7-5a2e3cc100b9",
                                                "text": "Seit ich mir ein Netbook gekauft habe, habe ich den kleinen Helfer immer dabei."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
