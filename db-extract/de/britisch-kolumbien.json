                                        "sense_id": "a0eb7402-4f9c-346a-9a56-5817db93b22b",
                                        "entry_id": "a6777032-1608-3aff-93eb-4d6d63d5ce9a",
                                        "glosses": [
                                            "A province in western Canada. Capital: Victoria. Largest city: Vancouver."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "075d0059-6aed-4e6f-b0c8-3670a96a2971",
                                                "sense_id": "a0eb7402-4f9c-346a-9a56-5817db93b22b",
                                                "text": "In that year [1871] British Columbia decided to become part of the Dominion of Canada, on condition that a transcontinental railway should be completed without delay."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
