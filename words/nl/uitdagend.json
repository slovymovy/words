                    "frequency": "Middle",
                    "semantic_group_id": "provocerend",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De jongen keek de leraar met een <w>uitdagende</w> blik aan na de berisping.",
                            "target_lang_translations": {
