                    {
                        "translation_id": "a4bcf312-e37b-4d47-b627-f3845dcd68ef",
                        "source_entry_id": "09cf557f-54b3-331a-b112-a9140257b6e4",
                        "source_sense_description": "of or pertaining to the Cambrian geologic period",
                        "target_lang_word": "kambrisch",
