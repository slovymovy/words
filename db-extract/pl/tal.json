                                        "sense_id": "6ba53550-d4a7-3649-a315-92115a9a0739",
                                        "entry_id": "4ca50c95-eed0-3643-9aac-d1bed1143528",
                                        "glosses": [
                                            "Sel de thallium comme le sulfure de thallium utilisé comme poison."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b38bb74c-ecc6-43f0-af8d-270a58b889f1",
                                                "sense_id": "6ba53550-d4a7-3649-a315-92115a9a0739",
                                                "text": "Dans l’hôpital cantonal où il meurt dix jours plus tard, l’autopsie conclut en effet qu’il a été empoisonné au thallium –inodore et insipide– versé dans son apéritif ou son verre de vin."
                                            }
                                        ]
                                    }
