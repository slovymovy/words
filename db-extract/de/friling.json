                        "form": "die Frilinge"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "77272324-3bf6-3f16-8de6-219aa684374d",
                        "entry_id": "93842235-dceb-371a-90d6-d723cec23e01",
                        "glosses": [
                            "Person, die in keinem grundherrschaftlichen Verhältnis stand"
                        ],
                        "tags": [
                            "historical",
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "8ed9180e-d0f8-47ea-a926-52a3ff164d65",
                                "sense_id": "77272324-3bf6-3f16-8de6-219aa684374d",
                                "text": "„Eine tiefe Kluft lag zwischen der Schicht der Edelinge und den darunter stehenden Schichten der Frilinge und Laten […].“"
                            },
                            {
                                "example_id": "43172b5c-e941-4547-b1e2-fde8d7a48c6a",
                                "sense_id": "77272324-3bf6-3f16-8de6-219aa684374d",
                                "text": "„Im Vergleich zu der Masse der Frilinge und Liten war die Zahl der völlig rechtlosen Unfreien vermutlich sehr gering, und sie verminderte sich im Laufe des sozialökonomischen Prozesses noch erheblich, weil diese Unfreien in der Klasse der feudalabhängigen Bauern aufgingen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
