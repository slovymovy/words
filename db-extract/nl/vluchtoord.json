                                    {
                                        "sense_id": "014d961d-3a11-3ee4-ae41-5772afdc5696",
                                        "entry_id": "9670f8cc-6cc4-3f1f-8f10-cb2cd0d323c3",
                                        "glosses": [
                                            "To return to a place of shelter."
