                            "accusative",
                            "singular"
                        ],
                        "form": "die Benennung"
                    },
                    {
                        "form_id": "9c60a5c4-4cf7-47ff-8d3c-e8108705c0c2",
                        "entry_id": "cb0d31e5-621f-3788-b9c4-bcb9c89c3b21",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Benennungen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a625401e-094f-33f1-825f-e3d0a175b65e",
                        "entry_id": "cb0d31e5-621f-3788-b9c4-bcb9c89c3b21",
                        "glosses": [
                            "Wort, sprachlicher Ausdruck für etwas Gemeintes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6280da4-a8d1-4786-872a-a15879b2bd74",
                                "sense_id": "a625401e-094f-33f1-825f-e3d0a175b65e",
                                "text": "„Dies führt oft zur Verwendung movierter und unmovierter Benennungen für das gleiche Denotat […].“"
                            },
                            {
                                "example_id": "eea57daf-ea05-43de-8bb9-6ed0462cd57d",
                                "sense_id": "a625401e-094f-33f1-825f-e3d0a175b65e",
                                "text": "„Manchmal geraten nämlich auch Personen in Benennungen.“"
                            },
                            {
                                "example_id": "894b4c99-49fa-4594-bb74-7088f30ffd00",
                                "sense_id": "a625401e-094f-33f1-825f-e3d0a175b65e",
                                "text": "„Bedenkt man aber, daß diese und andere Sippen, wie etwa der Rhabarber und der Spinat, ja gar nicht in den Gebieten des arabischen Reiches heimisch sein konnten, so stellt sich für den Etymologen die extrem schwierige Frage, woher denn diese arabischen Benennungen bezogen wurden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "cb22828c-a875-3fe5-bbcd-992847a3e9a4",
                        "entry_id": "cb0d31e5-621f-3788-b9c4-bcb9c89c3b21",
                        "glosses": [
                            "das Benennen, die öffentliche Nennung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ddb3f32-196b-4251-a6e0-25a8e1c03b01",
                                "sense_id": "cb22828c-a875-3fe5-bbcd-992847a3e9a4",
                                "text": "„Dass die genaue Benennung eines echten Gründungsjahres so schwierig ist, liegt vor allem daran, dass es keine anerkannte Interpretation gibt, was eine Liga denn eigentlich ausmacht.“"
                            },
                            {
                                "example_id": "11e3b1c7-f754-41c4-8204-dbcd3599a585",
                                "sense_id": "cb22828c-a875-3fe5-bbcd-992847a3e9a4",
                                "text": "Die Benennung der Kandidaten erfolgt durch den Vorstand."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5e3af125-2b25-4e79-bcbc-5644a5d38fd6",
                        "source_entry_id": "cb0d31e5-621f-3788-b9c4-bcb9c89c3b21",
                        "source_sense_id": "a625401e-094f-33f1-825f-e3d0a175b65e",
                        "source_sense_description": "Linguistik: Wort, sprachlicher Ausdruck für etwas Gemeintes",
                        "target_lang_word": "designation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "designation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a42491c1-9577-3b71-8d17-8bd2650589c3",
                                        "entry_id": "a4c99a35-6268-3e97-83ca-a824c60c314b",
                                        "glosses": [
                                            "An act or instance of designating"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0d180cf3-894a-347a-9bbc-2fd7c2f4bdfa",
                                        "entry_id": "a4c99a35-6268-3e97-83ca-a824c60c314b",
                                        "glosses": [
                                            "Selection and appointment for a purpose or office."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c80ed8da-5891-4f1e-ac1f-cb95d950a6ae",
                                                "sense_id": "0d180cf3-894a-347a-9bbc-2fd7c2f4bdfa",
                                                "text": "His designation as chief justice was controversial."
                                            },
                                            {
                                                "example_id": "2c69be43-5f6c-456b-81a2-09898ce79d2e",
                                                "sense_id": "0d180cf3-894a-347a-9bbc-2fd7c2f4bdfa",
                                                "text": "July 2021, Omar Marrero, quoted in CyberNewshttps://web.archive.org/web/20210805184306/https://www.puertoricoheadlinenews.com/15-million-allocated-for-non-profit-organizations/\nThe designation of funds by Governor Pedro Pierluisi will also allow non-profit entities to continue providing services to communities"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "afe74c34-2e18-37be-ae61-fb7e7ce34eb3",
                                        "entry_id": "a4c99a35-6268-3e97-83ca-a824c60c314b",
                                        "glosses": [
                                            "That which designates; a distinguishing mark or name; distinctive title; appellation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3dab41f-fc8e-4f35-ac41-6c386c12172d",
                                                "sense_id": "afe74c34-2e18-37be-ae61-fb7e7ce34eb3",
                                                "text": "The Romans evolved a quite different system of nomenclature, which in its classical form consisted of three names, the praenomen (e.g. Marcus), nomen (e.g. Tullius), and cognomen (e.g. Cicero), and two other designations (the name of the father and of the tribe): […]"
                                            },
                                            {
                                                "example_id": "6be38fd1-3310-45c7-9426-b72428c6e518",
                                                "sense_id": "afe74c34-2e18-37be-ae61-fb7e7ce34eb3",
                                                "text": "Man is the most aggressive animal in the sea (and on the land as well), and all the \"man-eater\" stories in history will not change this designation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b4b10a1-a779-3e29-844c-b61bd0b69a6c",
                                        "entry_id": "a4c99a35-6268-3e97-83ca-a824c60c314b",
                                        "glosses": [
                                            "Signification, meaning, for example of a word or phrase."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cdd78055-476b-4340-a367-c533f75b4c37",
                                                "sense_id": "1b4b10a1-a779-3e29-844c-b61bd0b69a6c",
                                                "text": "It doesn't list all the connotations that the term may have in various contexts: it specifies the designation of the term, or one of the designations of the term."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
