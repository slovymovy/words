                "senses": [
                    {
                        "sense_id": "402a7d09-338b-33ca-9828-1b027244b9a8",
                        "entry_id": "898b19c5-6d09-321c-b7ce-34492ebf074b",
                        "glosses": [
                            "halblange, weit geschnittene Hose, die unter den Knien mit eng anliegendem Bund endet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "512d9dc1-dcc2-47d9-bd12-c27d2df217eb",
                                "sense_id": "402a7d09-338b-33ca-9828-1b027244b9a8",
                                "text": "„Er hatte ein lederfarbenes Gesicht, trug die Hände meist in den Taschen seiner melierten Knickerbockers, und wenn man ihm etwas mitteilte, machte er den Mund langsam ganz weit auf und sagte das »Ach«.“"
                            },
                            {
                                "example_id": "60937cf9-d809-40d2-a7f5-9c4f64efcf56",
                                "sense_id": "402a7d09-338b-33ca-9828-1b027244b9a8",
                                "text": "„Himpel erwartete mich in Hemd und Knickerbockern, an seiner Windjacke putzten die beiden Sekretärinnen herum, rieben da, wischten, reinigten mit Terpentin.“"
                            },
                            {
                                "example_id": "0cf62c2e-6587-4955-a69b-bdd9a691efa6",
                                "sense_id": "402a7d09-338b-33ca-9828-1b027244b9a8",
                                "text": "„Das war ein pikfeiner Junge in Knickerbockern aus Bremen, Kaffeeimport.“"
                            },
                            {
                                "example_id": "0314545c-c240-48c7-a1ef-a8e229fbbac1",
                                "sense_id": "402a7d09-338b-33ca-9828-1b027244b9a8",
                                "text": "„Er trug rotgrün gepunktete Kniestrümpfe, hellgraue Knickerbocker, außerdem eine Weste, Jacke und Schlips.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "611bd4c3-0c7c-477e-9ead-85f25be2adb4",
                        "source_entry_id": "898b19c5-6d09-321c-b7ce-34492ebf074b",
                        "source_sense_id": "402a7d09-338b-33ca-9828-1b027244b9a8",
                        "source_sense_description": "halblange, weit geschnittene Hose, die unter den Knien mit eng anliegendem Bund endet",
                        "target_lang_word": "knickerbockers",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "knickerbockers",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c71448eb-bd9f-33c1-b0b4-a9fc2959d9de",
                                        "entry_id": "542ac43f-154d-39c9-8b39-2c2db295031f",
                                        "glosses": [
                                            "Men's or boys' baggy knee breeches, of a type particularly popular in the early 20th century."
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3c9385a-029b-4f0e-9d85-f72c8074e2bc",
                                                "sense_id": "c71448eb-bd9f-33c1-b0b4-a9fc2959d9de",
                                                "text": "Five men and a woman, two young girls,[…], and a boy […] are at the machines sewing knickerbockers, “knee-pants” in the Ludlow Street dialect."
                                            },
                                            {
                                                "example_id": "3da5dbff-d3d1-43d7-bafe-248652cf81d4",
                                                "sense_id": "c71448eb-bd9f-33c1-b0b4-a9fc2959d9de",
                                                "text": "[…] and some gems that represent the tasseled garment that the leader wears show it in a distinctly religious connection. On a gem from Zakro it [the sistrum] is being being carried by a man who does not wear the loin-cloth, but a baggy kind of knickerbockers like the Moslem trousers of to-day."
                                            },
                                            {
                                                "example_id": "ee841ec7-659b-444a-9496-7356d6e0037e",
                                                "sense_id": "c71448eb-bd9f-33c1-b0b4-a9fc2959d9de",
                                                "text": "And it was early morning, and the world was moist, when the crystal-gazer's husband, a freak in knickerbockers with an open coppish and a sabbath gamp, came over the stones outside his house to meet the holy travellers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
