                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10d84c19-4fad-47fb-b6f5-b4306292f10c",
                                "sense_id": "3c0c499a-a350-38bd-9d2c-6126849fd366",
                                "text": "Een gemeentelijk monument is in Nederland een bouwwerk, archeologische vindplaats of landschappelijke structuur die op grond van een gemeentelijke monumentenverordening bescherming geniet vanwege bijzondere cultuurhistorische of architectonische waarde."
                            },
                            {
                                "example_id": "516969d5-4028-4d9f-9aa8-e5ba65b9b93b",
                                "sense_id": "3c0c499a-a350-38bd-9d2c-6126849fd366",
                                "text": "Op de vindplaats zijn ook speren en resten gevonden uit de bronstijd van 1100 tot 800 voor Christus, aldus het schap dinsdag."
                            }
                        ]
                    }
