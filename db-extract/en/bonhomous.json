                                    },
                                    {
                                        "sense_id": "e168c82d-459f-31d8-8a44-a2ed418cbfd0",
                                        "entry_id": "7c23c401-805d-30e0-a639-5aacc8ba1a74",
                                        "glosses": [
                                            "von einem Tier: einfach zu lenken, folgsam, freundlich; auch: sich viel gefallen lassend"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e393f9ed-40d2-3040-bb65-31b1e4e44334",
                                        "entry_id": "7c23c401-805d-30e0-a639-5aacc8ba1a74",
                                        "glosses": [
                                            "von einer Sache: Fehler verzeihend, leicht lenkbar"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "09980394-15ad-3a5c-84d9-b20596678531",
                                        "entry_id": "7c23c401-805d-30e0-a639-5aacc8ba1a74",
                                        "glosses": [
                                            "No glosses available"
                                        ],
                                        "tags": [
                                            "no-gloss"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bff90516-ade8-43bc-910f-a9c5727669ea",
                                                "sense_id": "09980394-15ad-3a5c-84d9-b20596678531",
                                                "text": "Wenn man zu einem Polizisten in Deutschland freundlich ist, trifft man meist auf gutmütige, nette und hilfsbereite Menschen."
                                            },
                                            {
                                                "example_id": "1e3e28d6-e822-4627-b771-20360f5833db",
                                                "sense_id": "09980394-15ad-3a5c-84d9-b20596678531",
                                                "text": "Die Inhaberin [der Firma Süral], Gülsün Süral ist eine quirlige, gutmütig wirkende 71-jährige in geblümtem T-Shirt und Schirmkäppi."
                                            },
                                            {
                                                "example_id": "d4fbe9ab-1cf5-4477-a77a-34319751cb60",
                                                "sense_id": "09980394-15ad-3a5c-84d9-b20596678531",
                                                "text": "[Molly Weasley verkörpert] eine gutmütige Frau, die auch Harry [Potter] als ihren Sohn ansieht."
                                            },
                                            {
                                                "example_id": "ee4553b7-a4c3-4806-81c6-d3a2e95714c8",
                                                "sense_id": "09980394-15ad-3a5c-84d9-b20596678531",
                                                "text": "[Bill Cosby war] in der Rolle als liebenswürdiger Arzt und gutmütiger Familienvater in seiner „Cosby Show“ einer der beliebtesten TV-Stars [der USA]."
                                            },
                                            {
                                                "example_id": "f35bf641-fd1c-4e7c-be30-14e767a3ec49",
                                                "sense_id": "09980394-15ad-3a5c-84d9-b20596678531",
                                                "text": "[Pan Tau:] Als gutmütiger Herr im Anzug mit Melone zauberte er sich in Millionen Herzen - nicht nur in die von Kindern […]"
                                            },
                                            {
                                                "example_id": "b840939b-b5fb-4161-8963-b25f231d9648",
                                                "sense_id": "09980394-15ad-3a5c-84d9-b20596678531",
                                                "text": "Der Waliser an sich gilt als gutmütig und dickköpfig."
                                            },
                                            {
                                                "example_id": "b9191f9b-1539-41cb-8e07-23b7cec3ee4e",
                                                "sense_id": "09980394-15ad-3a5c-84d9-b20596678531",
                                                "text": "Man muss sich in der Politik durchsetzen können. Wer fleißig ist und gutmütig ist […], aber sich nicht durchsetzen kann, der wird überspielt […]"
                                            },
                                            {
                                                "example_id": "858c7956-2aec-4bd0-8a59-9661bed27a84",
                                                "sense_id": "09980394-15ad-3a5c-84d9-b20596678531",
                                                "text": "Kennen Sie das Problem der Prokrastination? […] Vor fünf Jahren hätte man jemanden, der Dinge immer zu spät erledigt, den eine ziemliche Unordnung umgibt, eben schlicht als einen chaotischen Menschen bezeichnet oder gutmütig auch als einen verrückten Professor, aber nicht als einen Kranken."
                                            },
                                            {
                                                "example_id": "0c1d67ca-571f-4dd2-bc00-6baf3fc34f7b",
                                                "sense_id": "09980394-15ad-3a5c-84d9-b20596678531",
                                                "text": "„Nach über einem halben Jahr gutmütiger und erfolgloser Gespräche mit der Gegenseite haben wir uns im Herbst vergangenen Jahres entschlossen, andere Saiten aufzuziehen.“"
                                            },
                                            {
                                                "example_id": "a0c6c88d-e966-4707-8568-faa37979e698",
                                                "sense_id": "09980394-15ad-3a5c-84d9-b20596678531",
                                                "text": "„Das ist ein so gutmütiger Hund, den kannst du ruhig streicheln.“"
                                            },
                                            {
                                                "example_id": "fae1915c-508a-495c-905d-d40fcf9428a1",
                                                "sense_id": "09980394-15ad-3a5c-84d9-b20596678531",
                                                "text": "Nur die Esel sind verschwunden, diese gutmütigen Tragetiere wurden von Maschinen abgelöst."
                                            },
                                            {
                                                "example_id": "dc10d95a-81cd-4040-9e7e-0d67880dbe23",
                                                "sense_id": "09980394-15ad-3a5c-84d9-b20596678531",
                                                "text": "Maultiere gelten als gutmütig und geradlinig, im Gegensatz zu Pferden auch als weit weniger scheu."
                                            },
                                            {
                                                "example_id": "09c75241-fdee-45e1-bd8f-b31299e61786",
                                                "sense_id": "09980394-15ad-3a5c-84d9-b20596678531",
                                                "text": "[Die Wanderjolle Ixylon] gilt als gutmütiges und vielseitig einsetzbares Boot."
                                            },
                                            {
                                                "example_id": "435d2871-33a4-4631-96b4-914df9250765",
                                                "sense_id": "09980394-15ad-3a5c-84d9-b20596678531",
                                                "text": "Es geht aber auch oft rasend schnell durch ungezählte Kurven bergab: Da sind sicherer Seitenhalt und gutmütiges Kurvenverhalten erwünscht."
                                            },
                                            {
                                                "example_id": "10437879-087c-41ff-a268-daa41b03e22d",
                                                "sense_id": "09980394-15ad-3a5c-84d9-b20596678531",
                                                "text": "Die russische Regierung äußerte Kritik an der laxen rechtlichen Verfolgung der Piraten. Aufgrund von zu gutmütigen Gesetzen in zahlreichen Staaten […] erwartet der Kreml ein Anwachsen der Piraterie am Horn von Afrika."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
