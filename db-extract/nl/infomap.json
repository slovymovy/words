                        "glosses": [
                            "mapje met nuttige inlichtingen over een bepaald onderwerp"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca45893f-8527-4d58-bb49-bace4e22c5e7",
                                "sense_id": "0480aaf2-5a80-3fbe-ab09-776391d1b193",
                                "text": "Het 'Speel op Veilig'-pakket bestaat uit een voorleesboekje, twee informatieve platen, puzzels, inkleurplaten, een spel en een 'Speel-op-Veilig'-lied. Leerkrachten krijgen een infomap met een handleiding en lessuggesties. 'Het is zeker niet de bedoeling de kinderen bang te maken met informatie over zware metalen. We willen hen wel op speelse wijze preventieve tips aanleren."
                            },
                            {
                                "example_id": "ef758bc1-2820-4c08-a945-42426e240a4f",
                                "sense_id": "0480aaf2-5a80-3fbe-ab09-776391d1b193",
                                "text": "Wie ook maar een klein beetje zou overwegen om de overstap te maken, moet beslist de digitale Luier-infomap van de Gentse Milieu Advies Winkel raadplegen."
                            }
                        ]
                    }
