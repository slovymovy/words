                "senses": [
                    {
                        "sense_id": "2c6dfec7-9311-3e09-b4ad-b9bea5cf3b39",
                        "entry_id": "629a70bd-a41d-310b-8b61-6d13bfc54c24",
                        "glosses": [
                            "farbenfrohes und leger geschnittenes, kurzärmeliges Hemd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79313b82-e9ac-4d99-af1a-11aafe10dde7",
                                "sense_id": "2c6dfec7-9311-3e09-b4ad-b9bea5cf3b39",
                                "text": "Nach einem gängigen Klischee werden Hawaiihemden vor allem von dicken Männern getragen."
                            },
                            {
                                "example_id": "6dffcb63-4780-43f9-9946-cef8e39ca391",
                                "sense_id": "2c6dfec7-9311-3e09-b4ad-b9bea5cf3b39",
                                "text": "„Wer sich traut, hat in dieser Saison reiche Auswahl, denn das schrille Hawaiihemd wird in dieser Saison neu entdeckt.“"
                            },
                            {
                                "example_id": "3ffed7cc-2d92-4f33-99f9-ab4696ec45f8",
                                "sense_id": "2c6dfec7-9311-3e09-b4ad-b9bea5cf3b39",
                                "text": "„Zwei Wiesbadener haben das klassische Hawaiihemd neu interpretiert und sich dabei von heimischen Pflanzen inspirieren lassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
