                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2624ac7f-4cc5-41d4-9901-659cc90aa8f7",
                                "sense_id": "213e9e45-1373-32c8-8f95-29ee126b03be",
                                "text": "His senses reeled amid the din and rattle of classes where discipline was unknown and intelligence almost indiscoverable."
                            },
                            {
                                "example_id": "499dc765-8593-44f3-9e55-75f95ab17d4e",
                                "sense_id": "213e9e45-1373-32c8-8f95-29ee126b03be",
                                "text": "Even as he went into the lighted, public place he remained dark and magic, the living silence seemed the body of reality in him, subtle, potent, indiscoverable."
                            }
                        ]
