                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "receive_physical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я очень люблю <получать> подарки на день рождения.",
                            "target_lang_translations": {
                                "en": "I really love <receiving> birthday presents.",
                                "nl": "Ik vind het erg leuk om cadeautjes voor mijn verjaardag te <krijgen>.",
                                "pl": "Bardzo lubię <dostawać> prezenty na urodziny.",
                                "de": "Ich liebe es sehr, zum Geburtstag Geschenke zu <bekommen>.",
                                "fr": "J'adore <recevoir> des cadeaux pour mon anniversaire.",
                                "it": "Amo molto <ricevere> regali per il compleanno.",
                                "cs": "Moc rád <dostávám> dárky k narozeninám.",
                                "tr": "Doğum gününde hediye <almayı> çok severim.",
                                "es": "Me encanta <recibir> regalos por mi cumpleaños.",
                                "zh": "我非常喜欢在生日时<w>收到</w>礼物。"
                            }
                        },
                        {
                            "text": "Мы каждую неделю <получаем> письма от бабушки.",
                            "target_lang_translations": {
                                "en": "We <receive> letters from grandmother every week.",
                                "nl": "Wij <ontvangen> elke week brieven van oma.",
                                "pl": "Co tydzień <otrzymujemy> listy od babci.",
                                "de": "Wir <bekommen> jede Woche Briefe von der Oma.",
                                "fr": "Nous <recevons> des lettres de grand-mère chaque semaine.",
                                "it": "Ogni settimana <riceviamo> lettere dalla nonna.",
                                "cs": "Každý týden <dostáváme> dopisy od babičky.",
                                "tr": "Her hafta büyükannemden mektup <alıyoruz>.",
                                "es": "Cada semana <recibimos> cartas de la abuela.",
                                "zh": "我们每周都能<w>收到</w>奶奶寄来的信。"
                            }
                        }
                    ],
                    "synonyms": [
                        "принимать",
                        "брать"
