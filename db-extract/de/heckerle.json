                "senses": [
                    {
                        "sense_id": "53134c45-d28d-32d8-987e-2f2d03caf73d",
                        "entry_id": "76822a9f-b92f-30ee-8cfd-8d8f61843250",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14dae53d-b47e-4c62-af0a-33a6cf0e5ec4",
                                "sense_id": "53134c45-d28d-32d8-987e-2f2d03caf73d",
                                "text": "Frau Heckerle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "842277e0-9eac-451a-bde3-2bcf9ac3082b",
                                "sense_id": "53134c45-d28d-32d8-987e-2f2d03caf73d",
                                "text": "Herr Heckerle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "1beed474-9e4f-4906-9e3e-d0e69dcbf364",
                                "sense_id": "53134c45-d28d-32d8-987e-2f2d03caf73d",
                                "text": "Die Heckerles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "62ff7c81-f3d9-4c82-9e7d-1dbb6e1f0786",
                                "sense_id": "53134c45-d28d-32d8-987e-2f2d03caf73d",
                                "text": "Der Heckerle trägt nie die Pullover, die die Heckerle ihm strickt."
                            },
                            {
                                "example_id": "4012948d-8d36-46a6-af99-dc0deb631671",
                                "sense_id": "53134c45-d28d-32d8-987e-2f2d03caf73d",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Heckerle kommt, geht der Herr Heckerle.“"
                            },
                            {
                                "example_id": "adb4717a-7d28-458b-9c7c-6100af789275",
                                "sense_id": "53134c45-d28d-32d8-987e-2f2d03caf73d",
                                "text": "Heckerle kommt und geht."
                            },
                            {
                                "example_id": "f2b67bf8-fc54-404f-8f1d-73e0be0511f0",
                                "sense_id": "53134c45-d28d-32d8-987e-2f2d03caf73d",
                                "text": "Heckerles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
