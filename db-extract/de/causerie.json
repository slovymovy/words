                        "examples": [
                            {
                                "example_id": "de183fe3-9ba8-482a-9cb6-01be4e23f1e6",
                                "sense_id": "02aa7232-e98e-3c41-8710-a5cd09273674",
                                "text": "„Mit dieser Frage beendete er, als das Essen vorbei war, die Ordonnanz abgeräumt hatte, unsere Causerien, und dies nicht nur plötzlich, unvermutet, unhöflich, mitten in eine gegenseitige Erörterung unserer privaten Nachkriegspläne hinein – verzweifelt hatte ich schon begonnen, nach Gesprächstthemen zu suchen –, sondern auch mit einem Wechsel der Tonlage, der mich zusammenfahren ließ.“"
                            }
                        ],
