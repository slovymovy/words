                "entry_id": "aeba37d9-5d93-391d-bc1c-71d2ad914c97",
                "word": "pécule",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d0d56ce6-69e0-4df5-b26d-b239e54e539c",
                        "entry_id": "aeba37d9-5d93-391d-bc1c-71d2ad914c97",
                        "tags": [
                            "plural"
                        ],
                        "form": "pécules"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6cd1a620-e85b-3c61-90f9-8ced48bf6461",
                        "entry_id": "aeba37d9-5d93-391d-bc1c-71d2ad914c97",
                        "glosses": [
                            "Ce que donnait, de son vivant, un pater familias romain à l’un de ses descendants pour son installation."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "3c34f300-b5f7-4855-8a0a-e6e085c09016",
                                "sense_id": "6cd1a620-e85b-3c61-90f9-8ced48bf6461",
                                "text": "Le père peut déléguer à un fils la gestion et la jouissance d’une partie de son bien : il peut lui attribuer un pécule, mais c’est à titre de concession bénévole et toujours révocable."
                            }
                        ]
                    },
                    {
                        "sense_id": "a8e45bee-43a4-36d3-8da0-644e10a99a3b",
                        "entry_id": "aeba37d9-5d93-391d-bc1c-71d2ad914c97",
                        "glosses": [
                            "Ce qu’un esclave amassait par ses épargnes et qui lui servait à racheter sa liberté."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f3d0638-361e-42e8-bc89-bfb714d5c060",
                                "sense_id": "a8e45bee-43a4-36d3-8da0-644e10a99a3b",
                                "text": "Cet esclave avait amassé un pécule assez considérable."
                            }
                        ]
                    },
                    {
                        "sense_id": "7aa59538-35bd-353a-aac1-a508915e5d20",
                        "entry_id": "aeba37d9-5d93-391d-bc1c-71d2ad914c97",
                        "glosses": [
                            "Ce qu’une personne en puissance d’autrui acquiert par son industrie, par son travail et par son épargne, et dont il lui est permis de disposer."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "8f100751-f530-3d71-9dd5-09633b6c7059",
                        "entry_id": "aeba37d9-5d93-391d-bc1c-71d2ad914c97",
                        "glosses": [
                            "Désigne encore, d’une manière plus générale, une petite somme d’argent amassée peu à peu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1dc47802-1d04-4a27-b639-b5a9f86d9339",
                                "sense_id": "8f100751-f530-3d71-9dd5-09633b6c7059",
                                "text": "Je ne veux pas toucher à mon petit pécule."
                            },
                            {
                                "example_id": "372fb883-c726-4a8f-acf5-6394233a5ba6",
                                "sense_id": "8f100751-f530-3d71-9dd5-09633b6c7059",
                                "text": "Un perdreau, se disait Eugénie, qui aurai voulu payer un perdreau de tout son pécule."
                            },
                            {
                                "example_id": "fa7fd450-115c-4fad-8403-5965fa8b4bfa",
                                "sense_id": "8f100751-f530-3d71-9dd5-09633b6c7059",
                                "text": "Je voyais avec une immense fierté grossir dans un coin de mon tiroir un petit pécule."
                            },
                            {
                                "example_id": "2e5b8c18-1abc-45a7-98d3-70b37445ebcc",
                                "sense_id": "8f100751-f530-3d71-9dd5-09633b6c7059",
                                "text": "Dutchy, le plus jeune de nous, aimait faire rire et maintenait de la gaieté dans la cabane. Il avait rejoint la ruée vers l’or dans l’espoir d’amasser un petit pécule, mais surtout pour y trouver l’inspiration, car il voulait devenir écrivain."
                            }
                        ]
                    },
                    {
                        "sense_id": "7727aa6b-5d1c-35af-98cf-23bb362c442f",
                        "entry_id": "aeba37d9-5d93-391d-bc1c-71d2ad914c97",
                        "glosses": [
                            "Argent gagné jour par jour et qui n’est remis à un soldat, à un détenu que le jour de sa libération."
                        ],
                        "tags": [
                            "Administration"
                        ],
                        "examples": [
                            {
                                "example_id": "ab4b5495-aa2e-4ec1-bd4a-6151728c0c8f",
                                "sense_id": "7727aa6b-5d1c-35af-98cf-23bb362c442f",
                                "text": "Quelques vêtements roulés en boule, ses papiers, son pécule de quelques centaines de francs, un paquet de Philip Morris et son briquet, un antique Zippo."
                            }
                        ]
                    }
                ],
