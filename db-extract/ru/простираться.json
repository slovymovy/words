                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "8c665622-dc8b-41a2-861b-eac7bf73e11d",
                                "sense_id": "1e112822-27ca-3c60-b4a1-ad1397479d4a",
                                "text": "простира́ться до чего́-либо",
                                "translation": "to reach something; stretch to something",
                                "english": "to reach something; stretch to something"
                            },
                            {
                                "example_id": "a9e300a2-bda7-4a74-bca6-d70932732a2f",
                                "sense_id": "1e112822-27ca-3c60-b4a1-ad1397479d4a",
                                "text": "простира́ться на сто киломе́тров",
                                "translation": "to stretch for a hundred kilometres",
                                "english": "to stretch for a hundred kilometres"
                            },
                            {
                                "example_id": "6addc5fe-ee9c-4954-9a4f-ad40110647a1",
                                "sense_id": "1e112822-27ca-3c60-b4a1-ad1397479d4a",
                                "text": "Вокруг меня простирались печальные пустыни, пересеченные холмами и оврагами.",
                                "translation": "Dreary plains, intercepted by mounds and hollows, stretched around me.",
                                "english": "Dreary plains, intercepted by mounds and hollows, stretched around me."
                            }
                        ]
