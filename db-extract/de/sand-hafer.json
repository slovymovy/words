                        "examples": [
                            {
                                "example_id": "dcf10ccb-1727-41a9-a85f-d44e022ecaf0",
                                "sense_id": "f19ca7b7-6231-3dba-86db-d7090c3a0a66",
                                "text": "„Der Sand-Hafer wurde bis etwa Ende des 19. Jahrhunderts besonders im Westen Europas in Gebieten angebaut, die für den Saat-Hafer nicht mehr geeignet sind. Beispiele sind die Berglandschaften von Wales oder die Inseln im Westen und Norden Schottlands.“"
                            },
                            {
                                "example_id": "9b1b84ed-0720-4d08-aadb-32b3df556755",
                                "sense_id": "f19ca7b7-6231-3dba-86db-d7090c3a0a66",
                                "text": "„Der Sand-Hafer, welcher ebenfalls im Frühlinge ausgesäet wird, gedeiht im schlechtesten Boden, wo er auch als Futterpflanze noch mit Nutzen angebauet werden kann […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
