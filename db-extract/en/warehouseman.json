                    {
                        "translation_id": "4572ed66-f82e-417f-9d10-cadf24e4c580",
                        "source_entry_id": "84659d98-5008-329f-a373-5c915ec7a6fb",
                        "source_sense_description": "person who manages or works in a warehouse",
                        "target_lang_word": "magasinier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "magasinier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "88fa0f66-800b-30e8-82f6-d2298e86ab99",
                                        "entry_id": "a9116849-6b6f-36fc-998d-3b62b190adaa",
                                        "glosses": [
                                            "Celui qui est chargé de la réception, de la garde, du soin des objets renfermés dans un magasin, et de l’organisation de ce dernier."
                                        ],
                                        "tags": [
                                            "Logistique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ffc27b7-85a7-41ad-a7ea-d6d3272e8024",
                                                "sense_id": "88fa0f66-800b-30e8-82f6-d2298e86ab99",
                                                "text": "Ben, je suis magasinier, alors je suis assis toute la journée et puis, quand y’a un ouvrier qui veut un outil ou une pièce quelconque, il me la demande..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d47149f8-7b80-488c-b2d6-872fdecd16cd",
                        "source_entry_id": "84659d98-5008-329f-a373-5c915ec7a6fb",
                        "source_sense_description": "person who manages or works in a warehouse",
                        "target_lang_word": "manutentionnaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "manutentionnaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ee598f2e-1fc4-3dfc-81f0-b5c132116325",
                                        "entry_id": "374d236c-d9fa-3a8b-8bec-246f8ace0bb5",
                                        "glosses": [
                                            "Personne qui s’occupe de manutention, qui charge et décharge les marchandises."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63db56da-1184-40c2-89a0-6ba99db3dc54",
                                                "sense_id": "ee598f2e-1fc4-3dfc-81f0-b5c132116325",
                                                "text": "Le 6 avril 2009, alors qu’il est à la manœuvre avec sa grue, un manutentionnaire du port sec de Rouiba, à trente kilomètres à l’est d'Alger, est intrigué par le poids très important de trois conteneurs frigorifiques censés être vides."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "324de882-ad64-351f-b86b-c8e095c908b2",
                                        "entry_id": "374d236c-d9fa-3a8b-8bec-246f8ace0bb5",
                                        "glosses": [
                                            "Celui qui manipule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b007ae7-0a3e-4554-8eb9-225170eb4154",
                                                "sense_id": "324de882-ad64-351f-b86b-c8e095c908b2",
                                                "text": "Il [Napoléon 1ᵉʳ] conservait des préjugés souvent injustes contre les manutentionnaires de deniers publics, contre les entrepreneurs des services, et en même temps quelque goût pour les expédients qui retardent les payements."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
