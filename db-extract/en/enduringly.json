                        "glosses": [
                            "In an enduring manner or fashion; so as to endure or last."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c61bd668-26a2-4bb8-98f4-ba53c94929b4",
                                "sense_id": "2137f966-87b2-3ac0-bc6e-c9ee82022d99",
                                "text": "The painter's works were enduringly popular."
                            },
                            {
                                "example_id": "bbc2e948-4cc7-4497-9949-d10dcdb20415",
                                "sense_id": "2137f966-87b2-3ac0-bc6e-c9ee82022d99",
                                "text": "Originally written in the era of the Cold War, Clavell's enduringly relevant, extraordinary allegory on the impressionability of the human mind is still read in schools around the globe today, and is a call to every person to keep questioning and keep learning."
                            }
                        ]
                    }
