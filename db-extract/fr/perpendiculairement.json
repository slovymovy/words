                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "42593637-147c-40e0-aa8d-8bf356b54108",
                        "source_entry_id": "d1ffd33f-4adf-369e-b1da-5c26fbe10523",
                        "source_sense_description": "D’une manière perpendiculaire",
                        "target_lang_word": "loodrecht",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "loodrecht",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "d5f27f54-cd21-32d6-9e77-fad797f052b0",
                                        "entry_id": "80fcaac0-c43c-37e5-946f-f6fbb7634038",
                                        "glosses": [
                                            "verticaal, in één lijn met het middelpunt van de aarde, in de richting van een schietlood, haaks op de horizon"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ad511a4-cb84-4b77-a11c-59ff7f71825d",
                                                "sense_id": "d5f27f54-cd21-32d6-9e77-fad797f052b0",
                                                "text": "De raket vloog loodrecht omhoog."
                                            },
                                            {
                                                "example_id": "aeea794c-31de-47bc-9cc8-d51e2c178c8b",
                                                "sense_id": "d5f27f54-cd21-32d6-9e77-fad797f052b0",
                                                "text": "De loodrechte rotswanden die de Steilte van Doek vormden waren zo hoog dat zelfs Schoonheid de bovenste rand niet kon bereiken."
                                            },
                                            {
                                                "example_id": "49223f0e-7b01-4fe4-a962-75545c3ad7ce",
                                                "sense_id": "d5f27f54-cd21-32d6-9e77-fad797f052b0",
                                                "text": "Hoe hoger we kwamen, hoe dichter ik tegen de rotswand ging lopen, doordat het naast me loodrecht naar beneden liep."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58a6ed6b-6b89-358f-85ba-58e47f0288b3",
                                        "entry_id": "80fcaac0-c43c-37e5-946f-f6fbb7634038",
                                        "glosses": [
                                            "in een rechte hoek (90 graden)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6eb11cc0-1f9c-4d7d-8ca9-d079688a0c78",
                        "source_entry_id": "d1ffd33f-4adf-369e-b1da-5c26fbe10523",
                        "source_sense_description": "D’une manière perpendiculaire",
                        "target_lang_word": "haaks",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "haaks",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "2303eb8a-fde2-3e5e-8518-7a015cc666c5",
                                        "entry_id": "03be126e-b97b-3c7f-a1ef-6e469401633b",
                                        "glosses": [
                                            "onder een rechte hoek"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bce49e97-e31d-44d0-82ab-2e6f44adc171",
                                                "sense_id": "2303eb8a-fde2-3e5e-8518-7a015cc666c5",
                                                "text": "Hij stak niet op haakse wijze de straat over en dat is niet aan te bevelen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "087c4e6f-9ee0-3f8f-996a-5aaded82f8db",
                                        "entry_id": "03be126e-b97b-3c7f-a1ef-6e469401633b",
                                        "glosses": [
                                            "op gespannen voet staand met iets anders, sterk afwijkend, rechtstreeks tegen iets anders ingaand"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "809452d7-9bdd-441b-aeb9-7a0fde194acf",
                                                "sense_id": "087c4e6f-9ee0-3f8f-996a-5aaded82f8db",
                                                "text": "Het bestuur vindt dat geen goed voorstel, het staat haaks op het huidige beleid dat breed wordt gesteund."
                                            },
                                            {
                                                "example_id": "f47e91e2-fa20-446b-b978-f8762e72f48d",
                                                "sense_id": "087c4e6f-9ee0-3f8f-996a-5aaded82f8db",
                                                "text": "Dit komt deels door de kwaliteit van de nepvideo, maar vooral door wat erin wordt gezegd. \"Poetin zegt iets dat haaks staat op wat we nu van hem verwachten. Dit geldt ook voor wat Zelensky zegt in de nepvideo.\" Dit is volgens Dobber de belangrijkste reden dat weinig mensen in deze nepvideo's zullen trappen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8d0a02ae-ecde-4eb8-a001-b2ad94ed0587",
