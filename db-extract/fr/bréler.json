                "senses": [
                    {
                        "sense_id": "1af7ffbd-a75e-3730-a3d2-5712d884122d",
                        "entry_id": "5d9276c0-5ba9-3ec7-bb54-8c3b797ae1df",
                        "glosses": [
                            "Effectuer un brêlage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e21bb50b-bbe0-4b95-8919-2d70995c2885",
                                "sense_id": "1af7ffbd-a75e-3730-a3d2-5712d884122d",
                                "text": "Deux hommes de la section brèlent les guindages de la droite du pont, les deux autres brèlent ceux de la gauche."
                            },
                            {
                                "example_id": "dd2d1ca6-df76-4dbd-b725-457d2a38d63f",
                                "sense_id": "1af7ffbd-a75e-3730-a3d2-5712d884122d",
                                "text": "bréler les poutrelles sur les bateaux;"
                            },
                            {
                                "example_id": "10bc85b7-9bc8-49bb-bd7b-491a038c8615",
                                "sense_id": "1af7ffbd-a75e-3730-a3d2-5712d884122d",
                                "text": "Si l’on veut augmenter encore la surface d’appui, on peut bréler deux madriers sous le trépied,"
                            },
                            {
                                "example_id": "9a75fcfa-824f-4a2a-b154-1b7b536e67a4",
                                "sense_id": "1af7ffbd-a75e-3730-a3d2-5712d884122d",
                                "text": "À ce stade, on peut estimer avoir utilisé — mais avec des sécurités énormes — près de 150 m de liens végétaux pour bréler"
                            }
                        ]
                    }
                ],
