                "senses": [
                    {
                        "sense_id": "533ab158-bef1-3ada-817e-1dcbd375676a",
                        "entry_id": "5bec5366-4ac5-3017-8a31-0d07e2361f77",
                        "glosses": [
                            "Fabrik zur Herstellung von Textilien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bfaa190b-d4f8-40b8-a827-a72340601f01",
                                "sense_id": "533ab158-bef1-3ada-817e-1dcbd375676a",
                                "text": "„Fast alle Textilfabriken in Süchteln und Viersen halbierten die wöchentliche Arbeitszeit von 48 auf 24 Stunden - gerade noch drei Achstundenschichten also bei entsprechenden Lohnkürzungen.“"
                            },
                            {
                                "example_id": "075ff1e9-cc61-4399-84c3-90e3549f0e80",
                                "sense_id": "533ab158-bef1-3ada-817e-1dcbd375676a",
                                "text": "„Waisenkinder setzte er dort als Billigarbeitskräfte in seiner Textilfabrik ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
