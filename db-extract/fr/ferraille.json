        "fr-extract.jsonl": [
            {
                "entry_id": "eebee2ad-5e0e-3ca9-9371-b1a486a14de8",
                "word": "ferraille",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "abcbecfc-faf5-42f1-b884-06e9986daf3a",
                        "entry_id": "eebee2ad-5e0e-3ca9-9371-b1a486a14de8",
                        "tags": [
                            "plural"
                        ],
                        "form": "ferrailles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8431eab7-28cc-38c7-984d-3559d2357de1",
                        "entry_id": "eebee2ad-5e0e-3ca9-9371-b1a486a14de8",
                        "glosses": [
                            "Vieux morceaux de fer usés ou rouillés."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f258fc9-80b1-484e-b8f2-323b1130e044",
                                "sense_id": "8431eab7-28cc-38c7-984d-3559d2357de1",
                                "text": "Il entendit le bruit de ferraille causé par les clefs que Manon prenait dans un tiroir, et il lui vit allumer la chandelle d’un grand martinet en cuivre jaune."
                            },
                            {
                                "example_id": "977469b6-5bf4-4acc-ba10-3ae6fbad9af8",
                                "sense_id": "8431eab7-28cc-38c7-984d-3559d2357de1",
                                "text": "Hervé les avait vus distinctement tracasser la grille et un grincement de ferrailles lui apprit qu'ils l’avaient fermé à clé, derrière eux, après l’avoir ouverte en arrivant, et qu'ils étaient en train de la rouvrir pour s’en aller."
                            },
                            {
                                "example_id": "ef312c87-de33-468b-86c5-679871a2ea06",
                                "sense_id": "8431eab7-28cc-38c7-984d-3559d2357de1",
                                "text": "L’acier peut également être obtenu par déferraillage des cendres d’incinération, mais avec une perte liée à l’oxydation pendant la combustion. La production d’acier à partir de ces ferrailles récupérées nécessite deux fois moins d’énergie que la fabrication à partir de minerai (2500 thermies [10 GJ] par tonne, soit 73 MWh [260 GJ ; il y a contradiction], au lieu de 5000), et évite de générer 700 kg de déchets par tonne produite."
                            }
                        ]
                    },
                    {
                        "sense_id": "e23b397d-cdb1-3519-9662-b12376ecbcba",
                        "entry_id": "eebee2ad-5e0e-3ca9-9371-b1a486a14de8",
                        "glosses": [
                            "Menue monnaie."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "0f2e7792-57b3-306a-ba84-f21fe0c6e485",
                        "entry_id": "eebee2ad-5e0e-3ca9-9371-b1a486a14de8",
                        "glosses": [
                            "Vieilles armes."
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f2cec627-7bc3-43c6-9778-4661cb31ffdc",
                        "source_entry_id": "eebee2ad-5e0e-3ca9-9371-b1a486a14de8",
                        "target_lang_word": "Schrott",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schrott",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f428a598-038b-36d4-adc9-f8c60cfd6537",
                                        "entry_id": "322af869-a048-3ebc-8445-c289b797fa98",
                                        "glosses": [
                                            "Abfall, der aus Metallen besteht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d792d1ec-4930-45d4-969a-868d2e8d2574",
                                                "sense_id": "f428a598-038b-36d4-adc9-f8c60cfd6537",
                                                "text": "Schrott kann man einschmelzen und dann das Metall wieder verwerten."
                                            },
                                            {
                                                "example_id": "ed3f39b3-4354-49e5-ae79-0e353c816167",
                                                "sense_id": "f428a598-038b-36d4-adc9-f8c60cfd6537",
                                                "text": "„Inzwischen schmelzen die Polkappen, im Weltraum fliegt nur noch Schrott herum und bei dem Staatsdefizit will wohl auch keiner mehr Amerika entdecken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "de694971-c347-338a-be79-189b5a4b02bb",
                                        "entry_id": "322af869-a048-3ebc-8445-c289b797fa98",
                                        "glosses": [
                                            "abfällige Kritik an Gegenständen, Maßnahmen, Meinungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd001fc2-287e-46cc-8682-512cc95c5902",
                                                "sense_id": "de694971-c347-338a-be79-189b5a4b02bb",
                                                "text": "Was die Leute sich haben einfallen lassen, ist ein einziger Schrott."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
