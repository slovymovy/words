                "senses": [
                    {
                        "sense_id": "c8c41dce-60b4-3035-910c-baa0bd23e4d2",
                        "entry_id": "02158309-e266-3742-a739-3fc66e6575c8",
                        "glosses": [
                            "Donner un caractère globish à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8ac7336-fe97-4cf4-80c1-37f82e3fcf46",
                                "sense_id": "c8c41dce-60b4-3035-910c-baa0bd23e4d2",
                                "text": "Pour ceux qui comprennent la crapulerie je peux leur fournir les coordonnées d'un spécialiste: \"GUY-HOTLINE\" (anciennement Guillotine, mais il faut se \"globishiser\")..."
                            },
                            {
                                "example_id": "97cd9aec-2305-44bd-a07e-7efefb626249",
                                "sense_id": "c8c41dce-60b4-3035-910c-baa0bd23e4d2",
                                "text": "Celles-ci pâtissent effectivement d’un train de retard sur les premières, et se remarquent dès lors moins à cet égard, mais soyez assuré qu’elles mettent le paquet depuis plusieurs années pour se « globishiser » à la hauteur des B.S. (acronyme à l’équivoque cocasse)."
                            }
                        ]
                    }
