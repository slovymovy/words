                    {
                        "form_id": "b6e99b63-9d7f-4f74-ac9a-e86d7358aae4",
                        "entry_id": "0197937e-4682-3cd1-b514-b03f501315c6",
                        "tags": [
                            "accusative",
                            "plural"
