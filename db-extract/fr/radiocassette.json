        "fr-extract.jsonl": [
            {
                "entry_id": "52ac1e22-b202-340e-85bf-11c8ae9a425a",
                "word": "radiocassette",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e61a428b-6400-4a0b-abed-ef7efdec84b0",
                        "entry_id": "52ac1e22-b202-340e-85bf-11c8ae9a425a",
                        "tags": [
                            "plural"
                        ],
                        "form": "radiocassettes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "22a1d088-2867-3202-8914-289450c5246e",
                        "entry_id": "52ac1e22-b202-340e-85bf-11c8ae9a425a",
                        "glosses": [
                            "Appareil électronique permettant d'écouter collectivement la radio et des cassettes de bande magnétique, équipé de haut-parleurs, tout en étant portable."
                        ],
                        "tags": [
                            "Audiovisuel"
                        ],
                        "examples": [
                            {
                                "example_id": "f3326f03-0f12-4415-9baa-3ebbdde2f750",
                                "sense_id": "22a1d088-2867-3202-8914-289450c5246e",
                                "text": "Puis il tendit à Bauer une radiocassette sur laquelle le pilote avait enregistré sa version des faits et surtout les instruction surprenantes de Bauer."
                            },
                            {
                                "example_id": "dd658b44-45b2-4c33-95c8-3dd5ad426853",
                                "sense_id": "22a1d088-2867-3202-8914-289450c5246e",
                                "text": "Qui aurait pu penser que quelque chose d’aussi moderne et contemporain que le radiocassette allait si rapidement et définitivement finir au musée ? Le magnétophone, le walkman, la disquette, les cabines téléphoniques, les répondeurs..."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8eca3db8-e737-4ba2-85f9-d8ad5feb4fb5",
                        "source_entry_id": "52ac1e22-b202-340e-85bf-11c8ae9a425a",
                        "source_sense_id": "22a1d088-2867-3202-8914-289450c5246e",
                        "source_sense_description": "appareil portable pour écouter de la musique",
                        "target_lang_word": "Radiorekorder",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Radiorekorder",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bf243ebe-1cb4-393c-a0b2-98fb9cef29a7",
                                        "entry_id": "ee4b8c49-c06f-3836-8e1f-732549d1f6b7",
                                        "glosses": [
                                            "tragbares Radiogerät mit eingebautem Kassettenrekorder"
                                        ],
                                        "tags": [
                                            "Unterhaltungselektronik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9678d44-92c9-4121-af35-542e29128088",
                                                "sense_id": "bf243ebe-1cb4-393c-a0b2-98fb9cef29a7",
                                                "text": "„Diese Radiorekorder waren in der Jugendkultur bis Ende der 1980er Jahre weit verbreitet.“"
                                            },
                                            {
                                                "example_id": "57ff474a-5194-406c-879f-ef01acbbd79a",
                                                "sense_id": "bf243ebe-1cb4-393c-a0b2-98fb9cef29a7",
                                                "text": "„Angefeuert von Ermächtigungsbeats, die aus einem gelb-schwarzen Radiorekorder dröhnen, springt der Künstler wie ein Regenwaldfrosch über den uralten Holzboden im Atelier, das er günstig von seiner Großtante gemietet hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
