                    }
                ],
                "senses": [
                    {
                        "sense_id": "8f7ef38b-27f9-3f5f-8fe0-c8fd6be0d6b6",
                        "entry_id": "53460298-c284-326f-b5c6-bb28e629eaff",
                        "glosses": [
                            "Lieu de nidification et de reproduction des oiseaux des régions arctiques et antarctiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ea9234f-387c-4bfd-a2e8-a6718fd135d5",
                                "sense_id": "8f7ef38b-27f9-3f5f-8fe0-c8fd6be0d6b6",
                                "text": "La rookerie au moment de la couvaison est plus bruyante que jamais."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e9468efb-564c-4fd7-a4ec-7214e03c3050",
                        "source_entry_id": "53460298-c284-326f-b5c6-bb28e629eaff",
                        "source_sense_id": "8f7ef38b-27f9-3f5f-8fe0-c8fd6be0d6b6",
                        "target_lang_word": "rookery",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rookery",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cc95552e-9507-37a1-820e-5e323e15a096",
                                        "entry_id": "98c87644-2834-37f9-b09e-e056b15b8db3",
                                        "glosses": [
                                            "A colony of breeding birds or other animals."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7018f4bb-6d2c-492e-9ff9-f6218d4b4f1f",
                                                "sense_id": "cc95552e-9507-37a1-820e-5e323e15a096",
                                                "text": "It was a rookery which had never been raided by the hunters, and in consequence the seals were mild-tempered and at the same time unafraid."
                                            },
                                            {
                                                "example_id": "758b2acf-a39b-4aff-9406-019205b638b8",
                                                "sense_id": "cc95552e-9507-37a1-820e-5e323e15a096",
                                                "text": "In winter rooks roost together in large numbers, and the roost may or may not be a rookery, but almost daily the local residents pay visits to the nesting trees, and about this time often begin playing at nest-building."
                                            },
                                            {
                                                "example_id": "956c4074-a03e-44a1-b0bc-53e198e06475",
                                                "sense_id": "cc95552e-9507-37a1-820e-5e323e15a096",
                                                "text": "There are six rookeries either side of Haddiscoe Island, which average 283 nests each."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f48b0d5-cd30-3fee-842d-564b5e6e21ad",
                                        "entry_id": "98c87644-2834-37f9-b09e-e056b15b8db3",
                                        "glosses": [
                                            "A crowded tenement."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62e16c22-9a23-46de-92bf-82db579bec9c",
                                                "sense_id": "3f48b0d5-cd30-3fee-842d-564b5e6e21ad",
                                                "text": "Lord John Roxton and I turned down Vigo Street together and through the dingy portals of the famous aristocratic rookery."
                                            },
                                            {
                                                "example_id": "f8e9921b-9469-4df7-88ab-13fd94def64d",
                                                "sense_id": "3f48b0d5-cd30-3fee-842d-564b5e6e21ad",
                                                "text": "Spying flames vomiting from a Manhattan tenement one night last week, a scavenging junkman named Roderick Good turned in an alarm. In their beds in the five-story rookery lay more than 100 tenants."
                                            },
                                            {
                                                "example_id": "48b56aa8-9846-4b07-931a-22ee931e79dd",
                                                "sense_id": "3f48b0d5-cd30-3fee-842d-564b5e6e21ad",
                                                "text": "The squares near Ladbroke Grove station ... never managed to attract the kind of people for which they were designed and sank rapidly into multiple occupation, becoming almost as bad as the nearby rookeries of north-west Kensington."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be6bae6e-f86f-3628-9824-79cb720f261b",
                                        "entry_id": "98c87644-2834-37f9-b09e-e056b15b8db3",
                                        "glosses": [
                                            "A place where criminals congregate, often an area of a town or city."
                                        ],
                                        "tags": [
                                            "British",
                                            "broadly",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f575d13-2d5f-4818-975c-4ea4b9644e36",
                                                "sense_id": "be6bae6e-f86f-3628-9824-79cb720f261b",
                                                "text": "The Flower and Dean St rookery had been home to many of those who lived at least partly by street crime."
                                            },
                                            {
                                                "example_id": "e0be73e8-3d5d-4e55-bcd3-963746aeb8b5",
                                                "sense_id": "be6bae6e-f86f-3628-9824-79cb720f261b",
                                                "text": "These rookeries sustained criminal social systems that provided schooling in crime for the young and newcomers."
                                            },
                                            {
                                                "example_id": "0ff46f69-7c2a-4b9a-b9f9-f860a68486d6",
                                                "sense_id": "be6bae6e-f86f-3628-9824-79cb720f261b",
                                                "text": "In the Victorian imagination, crime and the criminal class were always associated with rookeries, the dense slum areas in which criminals were said to live."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "265c035f-f598-3721-92f8-a380b098fabb",
                                        "entry_id": "98c87644-2834-37f9-b09e-e056b15b8db3",
                                        "glosses": [
                                            "That part of the barracks occupied by subalterns."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
