                "senses": [
                    {
                        "sense_id": "3e6fd43a-1bc0-3e69-a774-536a3115e047",
                        "entry_id": "6ccfd0f2-c782-34cb-95e5-2703f204dca1",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec3784e8-abb7-45d5-8ba3-ec6716d1e78d",
                                "sense_id": "3e6fd43a-1bc0-3e69-a774-536a3115e047",
                                "text": "Der Fahrenkrog trägt nie die Schals, die die Fahrenkrog ihm strickt."
                            },
                            {
                                "example_id": "7ad25f16-366c-4c30-ab94-9861869890eb",
                                "sense_id": "3e6fd43a-1bc0-3e69-a774-536a3115e047",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Fahrenkrog kommt, geht der Herr Fahrenkrog.“"
                            },
                            {
                                "example_id": "46f196ad-fa48-4892-95bc-d7bf5fac5387",
                                "sense_id": "3e6fd43a-1bc0-3e69-a774-536a3115e047",
                                "text": "Fahrenkrog kommt und geht."
                            },
                            {
                                "example_id": "809f5ecf-bf20-4114-90e2-e72057d22c3c",
                                "sense_id": "3e6fd43a-1bc0-3e69-a774-536a3115e047",
                                "text": "Fahrenkrogs kamen, sahen und siegten."
                            },
                            {
                                "example_id": "d5d7b28f-55df-47a9-b68e-0a592fbfadc0",
                                "sense_id": "3e6fd43a-1bc0-3e69-a774-536a3115e047",
                                "text": "Frau Fahrenkrog ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "31929d8e-7cf6-407b-9f63-ea798af49371",
                                "sense_id": "3e6fd43a-1bc0-3e69-a774-536a3115e047",
                                "text": "Herr Fahrenkrog wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "29cef31f-3efe-4576-82b3-b700df3acfc0",
                                "sense_id": "3e6fd43a-1bc0-3e69-a774-536a3115e047",
                                "text": "Die Fahrenkrogs kommen heute aus Dänemark."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
