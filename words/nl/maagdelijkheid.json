    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "53199150-7a52-31e5-aefe-9d5d7227cbad",
                    "sense_definition": "de toestand van iemand die nog nooit geslachtsgemeenschap heeft gehad",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "seksualiteit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Veel jongeren praten met hun vrienden over het moment waarop ze hun <w>maagdelijkheid</w> verloren.",
                            "target_lang_translations": {
                                "en": "Many young people talk with their friends about the moment they lost their <w>virginity</w>."
                            }
                        },
                        {
                            "text": "In sommige culturen wordt er nog steeds veel waarde gehecht aan de <w>maagdelijkheid</w> voor het huwelijk.",
                            "target_lang_translations": {
                                "en": "In some cultures, great value is still placed on <w>virginity</w> before marriage."
                            }
                        }
                    ],
                    "synonyms": [
                        "virginiteit"
                    ],
                    "common_phrases": [
                        "maagdelijkheid verliezen",
                        "maagdelijkheid bewaren"
                    ],
                    "target_lang_definitions": {
                        "en": "the state of someone who has never had sexual intercourse"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "virginity",
                                "target_lang_sense_clarification": "the state of being a virgin"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5fff9e70-5729-3455-bf14-1163ba54c93d",
                    "sense_definition": "een staat van morele zuiverheid, onschuld of een gebrek aan ervaring",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "karakter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De witte sneeuw op de bergtoppen symboliseerde de <w>maagdelijkheid</w> van de ongerepte natuur.",
                            "target_lang_translations": {
                                "en": "The white snow on the mountain peaks symbolized the <w>purity</w> of the untouched nature."
                            }
                        },
                        {
                            "text": "Door zijn politieke <w>maagdelijkheid</w> te behouden, bleef hij geloofwaardig voor de kritische kiezers.",
                            "target_lang_translations": {
                                "en": "By maintaining his political <w>innocence</w>, he remained credible to the critical voters."
                            }
                        }
                    ],
                    "synonyms": [
                        "onschuld",
                        "onervarenheid",
                        "zuiverheid"
                    ],
                    "common_phrases": [
                        "politieke maagdelijkheid"
                    ],
                    "target_lang_definitions": {
                        "en": "a state of moral purity, innocence, or a lack of experience"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "purity",
                                "target_lang_sense_clarification": "moral or physical cleanliness"
                            },
                            {
                                "target_lang_word": "innocence",
                                "target_lang_sense_clarification": "lack of guile or corruption"
                            },
                            {
                                "target_lang_word": "virginity",
                                "target_lang_sense_clarification": "metaphorical untouched state"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}