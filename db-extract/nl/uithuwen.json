                ],
                "translations": [
                    {
                        "translation_id": "894dfd94-deaf-448d-be45-8370f071464b",
                        "source_entry_id": "361cad0c-549c-33f7-850e-d808c23f9587",
                        "source_sense_id": "dfca1337-4205-37ac-8dce-3534ea8f00ea",
                        "source_sense_description": "een huwelijk arrangeren voor een meisje; een meisje aanbieden om mee te trouwen",
                        "target_lang_word": "give in marriage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "6a9ae57b-cc4f-4656-80c9-7597bf8089d2",
                        "source_entry_id": "361cad0c-549c-33f7-850e-d808c23f9587",
                        "source_sense_id": "dfca1337-4205-37ac-8dce-3534ea8f00ea",
                        "source_sense_description": "een huwelijk arrangeren voor een meisje; een meisje aanbieden om mee te trouwen",
                        "target_lang_word": "give away",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "give away",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "69323abc-da06-3218-91dc-a8dbfb5c2bd3",
                                        "entry_id": "ddb05c8c-081a-3dfe-801a-0b1e6b281e28",
                                        "glosses": [
                                            "To make a gift of (something)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18e452d9-e811-4835-84be-f23debd443a5",
                                                "sense_id": "69323abc-da06-3218-91dc-a8dbfb5c2bd3",
                                                "text": "I didn't like that book, so I gave it away."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24eee7e4-10b1-3e20-baa4-2677a0ad2f09",
                                        "entry_id": "ddb05c8c-081a-3dfe-801a-0b1e6b281e28",
                                        "glosses": [
                                            "To sell very cheaply."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f659d1d2-3511-49af-80a4-c5709ef6e858",
                                                "sense_id": "24eee7e4-10b1-3e20-baa4-2677a0ad2f09",
                                                "text": "This was dramatically illustrated by the market for commercial real estate in New York during 1993, which was said to be \"so bad that they're giving it away\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ce94e13-b024-33f7-ad57-38ebecfd5ac2",
                                        "entry_id": "ddb05c8c-081a-3dfe-801a-0b1e6b281e28",
                                        "glosses": [
                                            "To relinquish control over."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6788b77b-3e07-4a15-8346-5094f3ac1c0e",
                                                "sense_id": "1ce94e13-b024-33f7-ad57-38ebecfd5ac2",
                                                "text": "This issue marks a first of its kind for St. Louis Magazine: We've given away our cover feature.[…] In early summer, our editors[…] posed a collective question: What if we asked some[…] citizens what the future should look like? We'll give each of them[…] 200 words of space in the magazine[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e499f394-b9fc-3f0b-911f-67f7c26ec3d4",
                                        "entry_id": "ddb05c8c-081a-3dfe-801a-0b1e6b281e28",
                                        "glosses": [
                                            "To formally hand over a bride to the bridegroom; often by her father."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "683aa390-1c82-43cd-9541-554ec3042d65",
                                                "sense_id": "e499f394-b9fc-3f0b-911f-67f7c26ec3d4",
                                                "text": "Who giveth away this woman to this man in Holy matrimony?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5cf5c31-133b-360d-ba2d-7825f45c7b18",
                                        "entry_id": "ddb05c8c-081a-3dfe-801a-0b1e6b281e28",
                                        "glosses": [
                                            "To unintentionally reveal a secret or divulge undisclosed information; to betray or expose someone."
                                        ],
                                        "tags": [
                                            "reflexive",
                                            "sometimes",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99c8e0f3-81bc-4154-b648-833c8049fbfd",
                                                "sense_id": "e5cf5c31-133b-360d-ba2d-7825f45c7b18",
                                                "text": "He gave himself away with a stupid lie."
                                            },
                                            {
                                                "example_id": "4c4cb9ae-8f2e-4e12-b55f-6c50feb4211c",
                                                "sense_id": "e5cf5c31-133b-360d-ba2d-7825f45c7b18",
                                                "text": "He gave away his hiding place when he accidentally sneezed."
                                            },
                                            {
                                                "example_id": "708d8e22-6a59-4a0e-a03a-f7bd594d0fa2",
                                                "sense_id": "e5cf5c31-133b-360d-ba2d-7825f45c7b18",
                                                "text": "Hear footsteps creak the floor / The shadows give away / Someone outside the door / Won't let 'em in"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "934a32bf-9df6-3763-a7cd-642688ddd7a8",
                                        "entry_id": "ddb05c8c-081a-3dfe-801a-0b1e6b281e28",
                                        "glosses": [
                                            "To concede an advantage in weight, time, height etc."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43d7a51c-2250-449b-8abc-a7cf384a1761",
                                                "sense_id": "934a32bf-9df6-3763-a7cd-642688ddd7a8",
                                                "text": "Despite giving away twenty pounds in weight, the challenger found a knock-out blow in the second round."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c40372e6-bf13-34d5-b16c-0f28aa1020f9",
                                        "entry_id": "ddb05c8c-081a-3dfe-801a-0b1e6b281e28",
                                        "glosses": [
                                            "To concede."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2742910b-fd7c-4b99-834c-0a11550325b8",
                                                "sense_id": "c40372e6-bf13-34d5-b16c-0f28aa1020f9",
                                                "text": "England gave away six penalties in the first 15 minutes and were lucky to still have 15 men on the pitch, but Kvirikashvili missed two very makeable penalties in quick succession as Georgia were unable to take advantage of significant territorial advantage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
