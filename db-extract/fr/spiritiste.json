                                "target_senses": [
                                    {
                                        "sense_id": "ff894103-1a49-30ae-b466-61889ff7df36",
                                        "entry_id": "7c4b19ca-95aa-3db4-9d9c-bb8bf18bdd77",
                                        "glosses": [
                                            "Spiritualist."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc0ec55e-c735-4c2a-afd6-0cc9850de308",
                                                "sense_id": "ff894103-1a49-30ae-b466-61889ff7df36",
                                                "text": "People [with AIDS] who can afford it go to expensive private clinics. Those with little financial resources consult with bruxos, umbandists, spiritists, or they die at home."
                                            }
                                        ]
                                    },
