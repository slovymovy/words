                "senses": [
                    {
                        "sense_id": "bf9ced3a-e7ac-32fd-a85d-755e3625d5c6",
                        "entry_id": "0e7c5e50-c903-306d-8756-c16ea9fb0ddf",
                        "glosses": [
                            "aus Seide oder Kunstseide gewobener, glänzender Stoff"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09375433-5337-435e-bbe2-7e2e2932f518",
                                "sense_id": "bf9ced3a-e7ac-32fd-a85d-755e3625d5c6",
                                "text": "Sie trug ein Kleid aus schwarzem Taft."
                            },
                            {
                                "example_id": "3fe9bda2-efa0-4d0a-bd1b-5e27ec3ce1af",
                                "sense_id": "bf9ced3a-e7ac-32fd-a85d-755e3625d5c6",
                                "text": "„C. C. trug nur ein kurzes Mieder aus Taft und einen Rock aus dem gleichen Stoff; das war alles, was sie anhatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7ba48863-b37b-4868-876f-a55f5acb13cf",
                        "source_entry_id": "0e7c5e50-c903-306d-8756-c16ea9fb0ddf",
                        "source_sense_id": "bf9ced3a-e7ac-32fd-a85d-755e3625d5c6",
                        "source_sense_description": "aus Seide oder Kunstseide gewobener, glänzender Stoff",
                        "target_lang_word": "taffeta",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "taffeta",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "df15a160-7a16-39cf-88cb-0e460a77e4d9",
                                        "entry_id": "317efbb3-a181-33db-b649-684b0bb905b9",
                                        "glosses": [
                                            "A crisp, smooth woven fabric made from silk or synthetic fibers."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07a8883f-07f1-4e80-9622-de4fee6e2a8d",
                                                "sense_id": "df15a160-7a16-39cf-88cb-0e460a77e4d9",
                                                "text": "Could a Taff'ta ſcarf, a long Eſtridge vvhing, / A ſtiffe Iron Doublet, and a Brazeel Pole / Tempt thee from Cambrick ſheets, fine active Thighs, / From Caudles vvhere the precious Amber ſvvims?"
                                            },
                                            {
                                                "example_id": "a7aa70f4-3def-48fd-bccc-509f20d630b2",
                                                "sense_id": "df15a160-7a16-39cf-88cb-0e460a77e4d9",
                                                "text": "For a festive dinner, the belles pull out the stops. “Pull it tighter,” one urges as her corset is laced. Having unearthed their taffeta gowns from deep storage, they show off pinched waists, bare arms, throats and shoulders."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
