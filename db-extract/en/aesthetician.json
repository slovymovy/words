                    {
                        "translation_id": "0ec92980-ef19-49fa-88ff-32fa31cfd6fe",
                        "source_entry_id": "30ca73f6-4c7e-3555-9ec4-dfe13fef349f",
                        "source_sense_description": "someone who provides beauty treatments",
                        "target_lang_word": "Kosmetikerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kosmetikerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d2f75029-e528-3c9b-b728-aaf704232aad",
                                        "entry_id": "c8a1c39d-bf90-365b-b49e-ff2f15a99695",
                                        "glosses": [
                                            "weibliche Person, die sich [beruflich] mit Kosmetik beschäftigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfeea69d-81a0-43cc-b520-e64394d7309e",
                                                "sense_id": "d2f75029-e528-3c9b-b728-aaf704232aad",
                                                "text": "Die Kosmetikerin ist ein neuer Ausbildungsberuf im dualen System. (Internetbeleg)"
                                            },
                                            {
                                                "example_id": "01685ef6-37b7-43b9-b9cb-5b4e2c480725",
                                                "sense_id": "d2f75029-e528-3c9b-b728-aaf704232aad",
                                                "text": "„Die Kosmetikerin schaltete den Föhn aus und tupfte sich die Stirn trocken.“"
                                            },
                                            {
                                                "example_id": "9aae4c48-88ac-441f-875e-c20bee60050c",
                                                "sense_id": "d2f75029-e528-3c9b-b728-aaf704232aad",
                                                "text": "„Auch dazu habe ich an anderer Stelle eine Nachkriegsvariante erzählt, wo eine Lehrerin in den Fünfzigerjahren ihre Schülerinnen fragt, was sie denn werden wollten, und die alle brav mit den damals typischen Frauenberufen antworteten: Stenotypistin will die eine werden, Näherin die andere, Kosmetikerin die dritte, und schließlich sagt eine, dass sie Prostituierte werden will.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
