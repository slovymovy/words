                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5902e33-d0a3-4b82-93bc-b05926b9cb22",
                                "sense_id": "37dcbd2c-1694-32c9-9a0a-e5c20cd02364",
                                "text": "„Elsa tätschelt seinen Kopf, steckt den Gummipfropfen in den Ausguss und gießt das heiße Wasser in den Spülstein.“"
                            },
                            {
                                "example_id": "d430e296-144e-428e-878e-736f91b6cb71",
                                "sense_id": "37dcbd2c-1694-32c9-9a0a-e5c20cd02364",
                                "text": "„In der Kirche war es sekundenlang still, nur das Tappen der Gummipfropfen unter den Stöcken der Kirchenschweizer war zu hören und ein Murmeln, ein fernes Brausen, leises Brummen wie von einer größeren, weit entfernten Orgel, dem Verkehr um die Mauern des Doms.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
