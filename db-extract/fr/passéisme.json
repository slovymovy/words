                                "example_id": "dd54bd12-1f54-43df-bfc0-222bbc6a9887",
                                "sense_id": "c302ef15-dc07-35d9-94a9-7b071fc43e1f",
                                "text": "La Commune veut tirer un trait sur le passé et bâtir une société nouvelle où chacun serait l’égal de l’autre et où la raison l’emporterait sur la tradition et le passéisme."
                            },
                            {
                                "example_id": "764d6c96-9b50-4113-9e51-783a2b68750c",
                                "sense_id": "c302ef15-dc07-35d9-94a9-7b071fc43e1f",
                                "text": "Par le passéisme moderne et l’individualité du même nom, la philosophie devient philocalie."
                            }
                        ]
                    }
