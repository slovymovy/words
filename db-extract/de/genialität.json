                        "form": "den Genialitäten"
                    },
                    {
                        "form_id": "d4add3b3-27aa-4984-9723-97b1cd19198e",
                        "entry_id": "0c9821dd-1ae7-36d0-8082-3d945aebfd4c",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Genialität"
                    },
                    {
                        "form_id": "448f4359-3c91-42d2-a672-1858f808ad41",
                        "entry_id": "0c9821dd-1ae7-36d0-8082-3d945aebfd4c",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Genialitäten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2568e574-614a-37bc-8bf1-68577dc8bab5",
                        "entry_id": "0c9821dd-1ae7-36d0-8082-3d945aebfd4c",
                        "glosses": [
                            "Eigenschaft, in höchstem Maße begabt zu sein"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "80286b4c-887e-42a4-83df-023d14f99162",
                                "sense_id": "2568e574-614a-37bc-8bf1-68577dc8bab5",
                                "text": "„Sie bewunderte seine Genialität als Komponist und liebte seine Stücke, als wären es Gaben eigens für sie.“"
                            },
                            {
                                "example_id": "d617354e-2428-4802-8122-f26796ece1a7",
                                "sense_id": "2568e574-614a-37bc-8bf1-68577dc8bab5",
                                "text": "„Kein Mobiltelefon, kein Notebook, kein GPS wäre je erfunden worden, wenn nicht Querdenker wie Einstein, Bohr oder Planck ihre Genialität darauf verwendet hätten, jahrhundertealte Vorstellungen über Raum und Zeit umzustürzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9af43c0b-2439-3e12-8e20-c10928de2a5d",
                        "entry_id": "0c9821dd-1ae7-36d0-8082-3d945aebfd4c",
                        "glosses": [
                            "das Sein, die Eigenschaft, der Gedanke, die Handlung, die das Geniale widerspiegelt"
                        ],
                        "tags": [
                            "mit Plural"
                        ],
                        "examples": [
                            {
                                "example_id": "50efe993-5d16-4740-a475-f4929283b01c",
                                "sense_id": "9af43c0b-2439-3e12-8e20-c10928de2a5d",
                                "text": "„Gauss hat gezeigt, daß einzelne Zahlen eigentümliche Genialitäten besitzen, so die 17, die 257. Die große Masse der Zahlen verliert sich bestimmten Anforderungen gegenüber in der Herde, während andere sich auszeichnen.“"
                            },
                            {
                                "example_id": "446a50a6-712d-4888-8f10-c9237aa0145e",
                                "sense_id": "9af43c0b-2439-3e12-8e20-c10928de2a5d",
                                "text": "„Sie nimmt die heftigsten Genialitäten Regers mit in den Kauf, da sie doch immerhin überzeugt ist, daß der Mann viel studiert, seinen Bach im kleinen Finger hat und nur etwas Rechtes, Gerades in der Welt beabsichtigt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1b67c8ff-64fc-497f-a5b1-2530988231e4",
                        "source_entry_id": "0c9821dd-1ae7-36d0-8082-3d945aebfd4c",
                        "source_sense_id": "2568e574-614a-37bc-8bf1-68577dc8bab5",
                        "source_sense_description": "ohne Plural: Eigenschaft, in höchstem Maße begabt zu sein",
                        "target_lang_word": "genius",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "genius",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "781e830d-1d1b-32d4-9270-a8f7002297e8",
                                        "entry_id": "abacdbc8-aa9a-3a47-abea-0134d57d0fce",
                                        "glosses": [
                                            "Someone possessing extraordinary intelligence or skill; especially somebody who has demonstrated this by a creative or original work in science, music, art, etc."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5abbeb92-db64-4f99-a0d2-3a329c451b21",
                                                "sense_id": "781e830d-1d1b-32d4-9270-a8f7002297e8",
                                                "text": "She's a genius; she won a Nobel Prize at fifteen!"
                                            },
                                            {
                                                "example_id": "ce7bbcbe-70b9-4c82-8314-8fec14e3c8a5",
                                                "sense_id": "781e830d-1d1b-32d4-9270-a8f7002297e8",
                                                "text": "Marx stand höher, sah weiter, überblickte mehr und rascher als wir andern alle. Marx war ein Genie, wir andern höchstens Talente."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b37c4d8-a787-3e87-896f-4387837ca0bf",
                                        "entry_id": "abacdbc8-aa9a-3a47-abea-0134d57d0fce",
                                        "glosses": [
                                            "Extraordinary mental capacity."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5eef459c-5396-4530-9e9d-4f48aa4c64d6",
                                                "sense_id": "1b37c4d8-a787-3e87-896f-4387837ca0bf",
                                                "text": "Excuse, therefore, the shortcomings of genius under the sudorific influence of the summer solstice; for be assured that the vertical sun, however it may dulcify and mature cherries, plums, and other fruitful ‘plumpitudes,’ is by no means favorable to the development of intellectual products."
                                            },
                                            {
                                                "example_id": "9f4e2c3e-7c52-4a04-bc04-f7711c9c4e6c",
                                                "sense_id": "1b37c4d8-a787-3e87-896f-4387837ca0bf",
                                                "text": "In the old days, to my commonplace and unobserving mind, he gave no evidences of genius whatsoever. He never read me any of his manuscripts, […], and therefore my lack of detection of his promise may in some degree be pardoned."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a957bdd-c53e-355e-b06e-0215def5e084",
                                        "entry_id": "abacdbc8-aa9a-3a47-abea-0134d57d0fce",
                                        "glosses": [
                                            "Inspiration, a mental leap, an extraordinary creative process."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba412b07-46bc-414e-b491-e67367aa0439",
                                                "sense_id": "7a957bdd-c53e-355e-b06e-0215def5e084",
                                                "text": "a work of genius"
                                            },
                                            {
                                                "example_id": "03fc1f94-6f44-4f8e-a196-87849860ff86",
                                                "sense_id": "7a957bdd-c53e-355e-b06e-0215def5e084",
                                                "text": "to add a dash of cinnamon amid such umami was pure genius"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d96b2e5c-3642-3a98-a82a-eade79051034",
                                        "entry_id": "abacdbc8-aa9a-3a47-abea-0134d57d0fce",
                                        "glosses": [
                                            "The tutelary deity or spirit of a place or person."
                                        ],
                                        "tags": [
                                            "Roman",
                                            "also",
                                            "countable",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0cb9edf1-2b0e-46c6-9b01-b6c2a638f6da",
                                                "sense_id": "d96b2e5c-3642-3a98-a82a-eade79051034",
                                                "text": "and the genius of the place: the growing enthusiasm for codified standards in the Army and Navy"
                                            },
                                            {
                                                "example_id": "6d3ac11f-8994-4c45-9d96-632af89f0059",
                                                "sense_id": "d96b2e5c-3642-3a98-a82a-eade79051034",
                                                "text": "We talk of genius still, but with thought how changed! The genius of Augustus was a tutelary demon, to be sworn by and to receive offerings on an altar as a deity."
                                            },
                                            {
                                                "example_id": "d40ea247-0431-48c1-997c-ac4072e991da",
                                                "sense_id": "d96b2e5c-3642-3a98-a82a-eade79051034",
                                                "text": "An old sinner, in shape of a khansamah, is the genius of the place, and has rarely aught else to tempt the tired traveller with than a “sudden death”—a fowl caught running in the yard, and dished up forthwith; […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "genius",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5fb802cb-fb8e-3d63-9256-9796a0771056",
                                        "entry_id": "f2b4b6d3-17eb-3671-9321-6d36b852c675",
                                        "glosses": [
                                            "Ingenious, brilliant, very clever, or original."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3f1de90-36e5-4672-978f-e4943bb52d16",
                                                "sense_id": "5fb802cb-fb8e-3d63-9256-9796a0771056",
                                                "text": "What a genius idea!"
                                            },
                                            {
                                                "example_id": "b0fb9657-9410-4203-8dd4-3c07ceae311b",
                                                "sense_id": "5fb802cb-fb8e-3d63-9256-9796a0771056",
                                                "text": "Bjarte Birkeland asserts that the reason why Nynorsk writers of fiction have succeeded in coming so close to naked life is not that they are more genius than authors writing in Bokmal, but that they are using their mother tongue"
                                            },
                                            {
                                                "example_id": "3310dbba-d360-4b70-8834-93383e2ff935",
                                                "sense_id": "5fb802cb-fb8e-3d63-9256-9796a0771056",
                                                "text": "We all know how genius “Kamp Krusty,” “A Streetcar Named Marge,” “Homer The Heretic,” “Itchy & Scratchy: The Movie” and “Mr. Plow” are, but even the relatively unheralded episodes offer wall-to-wall laughs and some of the smartest, darkest, and weirdest gags ever Trojan-horsed into a network cartoon with a massive family audience."
                                            },
                                            {
                                                "example_id": "d45e4381-9166-475b-a518-305fe98781ae",
                                                "sense_id": "5fb802cb-fb8e-3d63-9256-9796a0771056",
                                                "text": "But Vahul was more genius than Rishi."
                                            },
                                            {
                                                "example_id": "c22a01b0-0d8b-4cf2-8d09-47b72cb6291f",
                                                "sense_id": "5fb802cb-fb8e-3d63-9256-9796a0771056",
                                                "text": "She said the writing for these products “is very genius” because it's carefully done."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a9cbe224-dd3b-48e3-9460-c5245632a7fa",
                        "source_entry_id": "0c9821dd-1ae7-36d0-8082-3d945aebfd4c",
                        "source_sense_id": "2568e574-614a-37bc-8bf1-68577dc8bab5",
                        "source_sense_description": "ohne Plural: Eigenschaft, in höchstem Maße begabt zu sein",
                        "target_lang_word": "génie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "génie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "767328ae-3d22-38fb-8eb8-8ac51394444a",
                                        "entry_id": "a7a85215-1cf9-3d5c-b6d5-7485c14cb678",
                                        "glosses": [
                                            "Esprit ou démon qui, selon les Romains, présidait à certains lieux, à des villes, etc."
                                        ],
                                        "tags": [],
                                        "note": "Il se dit aussi des gnomes, des sylphes, des ondins et autres personnages fantastiques, qu’on trouve dans les traditions populaires et dans les contes de fées",
                                        "examples": [
                                            {
                                                "example_id": "46ac2314-b916-41f8-b8a2-7ff25f99bfde",
                                                "sense_id": "767328ae-3d22-38fb-8eb8-8ac51394444a",
                                                "text": "Quand les temps sont durs et que la souffrance risque de dépasser ses forces de résistance, le paysan ira rendre visite au génie protecteur du village, petit monstre hilare ou grimaçant et barbouillera prudemment ses lèvres gourmandes des restes d’un pot d’opium ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "def69da5-750a-38ca-b5fd-d9b87fd303be",
                                        "entry_id": "a7a85215-1cf9-3d5c-b6d5-7485c14cb678",
                                        "glosses": [
                                            "Entité magique bonne ou mauvaise ayant une influence sur la destinée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0f20cfb-cdf8-4205-91be-6866fb23dbb1",
                                                "sense_id": "def69da5-750a-38ca-b5fd-d9b87fd303be",
                                                "text": "C’est votre bon génie qui vous a inspiré ce dessein."
                                            },
                                            {
                                                "example_id": "789001fe-bec0-4b69-9dad-7a65d5f4cc7f",
                                                "sense_id": "def69da5-750a-38ca-b5fd-d9b87fd303be",
                                                "text": "Une génie donc, l’ayant aperçue de nuit, et, pour ne vous rien cacher, en liquette, — dont l’on voyait issir ses pieds roses, — en demeura incendiée d’admiration, et fit part de sa découverte à un génie mâle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "269942ae-a0f8-381d-919a-25fe3e519cd7",
                                        "entry_id": "a7a85215-1cf9-3d5c-b6d5-7485c14cb678",
                                        "glosses": [
                                            "Personne qui par ses conseils ou ses exemples influe sur la vie d’une autre."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a11d2eeb-150f-47b0-86b3-0e346d9cd811",
                                                "sense_id": "269942ae-a0f8-381d-919a-25fe3e519cd7",
                                                "text": "Cet homme fut son mauvais génie."
                                            },
                                            {
                                                "example_id": "cde2837e-1b24-48be-88a6-ef2e700963a7",
                                                "sense_id": "269942ae-a0f8-381d-919a-25fe3e519cd7",
                                                "text": "Sa sœur fut son bon génie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc98aa1e-e75f-3fa4-b770-95295f591ea2",
                                        "entry_id": "a7a85215-1cf9-3d5c-b6d5-7485c14cb678",
                                        "glosses": [
                                            "Talent inné et exceptionnel d’une personne."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9887c37e-3f98-4198-a949-25474c2a2c3a",
                                                "sense_id": "dc98aa1e-e75f-3fa4-b770-95295f591ea2",
                                                "text": "Avoir du génie pour les affaires, pour la poésie. Avoir le génie de la peinture, de la musique, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a584372-0782-3ca0-bec2-abc04cbbcd17",
                                        "entry_id": "a7a85215-1cf9-3d5c-b6d5-7485c14cb678",
                                        "glosses": [
                                            "Personne douée d’un talent exceptionnel dans un domaine."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d93800d-66d2-4121-be2c-f22b76a87f6e",
                                                "sense_id": "0a584372-0782-3ca0-bec2-abc04cbbcd17",
                                                "text": "On passe donc du noir et blanc à la couleur et des échanges savoureux entre les deux génies (auxquels Alain Chabat et Laurent Lafitte prêtent leur voix) aux facéties de Nicolas et de ses petits copains."
                                            },
                                            {
                                                "example_id": "c23ba557-13d3-428b-a181-c0a773a437d2",
                                                "sense_id": "0a584372-0782-3ca0-bec2-abc04cbbcd17",
                                                "text": "Le plus rare génie est toujours en rapport avec les lumières de ses contemporains, et l’on doit calculer, à peu près, de combien la pensée d’un homme peut dépasser les connaissances de son temps. Homère a recueilli les traditions qui existaient lorsqu’il a vécu, et l’histoire de tous les événements principaux était alors très poétique en elle-même."
                                            },
                                            {
                                                "example_id": "0363f454-e934-40b1-b6d2-136ce2e89d92",
                                                "sense_id": "0a584372-0782-3ca0-bec2-abc04cbbcd17",
                                                "text": "Voilà le point central : ce que le clergé littéraire ou intellectuel ne supporte pas, dans sa médiocrité « manquant de force et d’haleine », c’est que la perfection aille directement au public, qu’il y ait donc une alliance naturelle entre le génie et le peuple."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1fb0bf8d-ee47-37e6-b19d-dfa01df5355e",
                                        "entry_id": "a7a85215-1cf9-3d5c-b6d5-7485c14cb678",
                                        "glosses": [
                                            "Qualité des esprits supérieurs qui les rend capables de créer, d’inventer, d’entreprendre des choses extraordinaires, etc."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6ac8e15-30fb-4fd3-a113-456d586892ad",
                                                "sense_id": "1fb0bf8d-ee47-37e6-b19d-dfa01df5355e",
                                                "text": "À soixante-douze ans, il avait spéculé sur les cotons, en croyant au génie de Napoléon, sans savoir que le génie est aussi souvent au-dessus qu’au dessous des événements."
                                            },
                                            {
                                                "example_id": "26ec1be8-3e56-4d50-bca5-4adfdb30e11b",
                                                "sense_id": "1fb0bf8d-ee47-37e6-b19d-dfa01df5355e",
                                                "text": "Les hommes qui ont reçu une éducation primaire ont, en général, la superstition du livre, et ils attribuent facilement du génie aux gens qui occupent beaucoup l'attention du monde lettré ; […]."
                                            },
                                            {
                                                "example_id": "559cca68-775b-4f0a-b2b7-f675bf23d5ed",
                                                "sense_id": "1fb0bf8d-ee47-37e6-b19d-dfa01df5355e",
                                                "text": "Le génie de la Résistance, c’est d’avoir su conjoindre, face à une même urgence historique, toutes les forces spirituelles de ce pays."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93cb8519-42db-307f-878e-39dec66b7cba",
                                        "entry_id": "a7a85215-1cf9-3d5c-b6d5-7485c14cb678",
                                        "glosses": [
                                            "Caractère propre et distinctif."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc7b165b-3c00-4f59-9288-66bf2fcda26a",
                                                "sense_id": "93cb8519-42db-307f-878e-39dec66b7cba",
                                                "text": "Rien n’est plus intéressant que de comparer des\ntraductions en vers ; elles révèlent à la fois le\ngénie de la langue traduite et celui des langues\ndont se sont servis les traducteurs."
                                            },
                                            {
                                                "example_id": "db7bb66d-eea1-4d6f-aa03-eaae70c9dffb",
                                                "sense_id": "93cb8519-42db-307f-878e-39dec66b7cba",
                                                "text": "Si tu t’exerces à vivre seulement ce que tu vis, c’est-à-dire le présent, tu pourras vivre tout le temps qui te reste jusqu’à la mort en le passant dans le calme, dans la bienveillance et l’amabilité envers ton génie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79fa3a2f-522e-32ab-b15e-f80cd63f8f2c",
                                        "entry_id": "a7a85215-1cf9-3d5c-b6d5-7485c14cb678",
                                        "glosses": [
                                            "Allégorie, personnification des arts, de la science, de l’industrie, d’une idée abstraite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "676f490c-3ad8-4587-ac1b-7d7c08ea1bd2",
                                                "sense_id": "79fa3a2f-522e-32ab-b15e-f80cd63f8f2c",
                                                "text": "Le génie de la Liberté."
                                            },
                                            {
                                                "example_id": "d0be9a85-4cb0-4d3a-871d-b2f82e74c85e",
                                                "sense_id": "79fa3a2f-522e-32ab-b15e-f80cd63f8f2c",
                                                "text": "Le génie de la Bastille."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73b5018f-3139-3caa-af38-3dbca960e98c",
                                        "entry_id": "a7a85215-1cf9-3d5c-b6d5-7485c14cb678",
                                        "glosses": [
                                            "Art de fortifier, d’attaquer, de défendre une place, un camp, un poste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26581d7c-b22c-45a8-9fcc-c50331c65f8f",
                                                "sense_id": "73b5018f-3139-3caa-af38-3dbca960e98c",
                                                "text": "Le génie militaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da1e6171-478b-3910-b08c-4656b095a353",
                                        "entry_id": "a7a85215-1cf9-3d5c-b6d5-7485c14cb678",
                                        "glosses": [
                                            "Corps des officiers des soldats qui font l’application de cet art."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b29dd122-c970-44d7-b82b-b5cac1c67216",
                                                "sense_id": "da1e6171-478b-3910-b08c-4656b095a353",
                                                "text": "Le génie est représenté dans l’armée marocaine par un petit corps d’ingénieurs (mohendisîn), dont la fonction principale et à peu près unique est de précéder les corps expéditionnaires et de choisir l’emplacement des campements."
                                            },
                                            {
                                                "example_id": "4786c702-583d-46d2-b9a1-2c807c85f633",
                                                "sense_id": "da1e6171-478b-3910-b08c-4656b095a353",
                                                "text": "Le génie veut des fortifications partout, non seulement dans l'Est, où le nécessaire est fait, mais jusque sur les côtes. Pourquoi?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f0b08a6-85d6-3e6c-8bd9-373818949605",
                                        "entry_id": "a7a85215-1cf9-3d5c-b6d5-7485c14cb678",
                                        "glosses": [
                                            "Domaine de connaissance lié à une technique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e17c21bf-46c4-452a-9c6b-331dea21b6a0",
                                                "sense_id": "0f0b08a6-85d6-3e6c-8bd9-373818949605",
                                                "text": "Génie mécanique."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "génie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2d91d257-cee9-34a9-b9c7-f1bd28b1a954",
                                        "entry_id": "bc664112-ae4d-32b3-9a33-bcacb986c5d6",
                                        "glosses": [
                                            "Djinn, esprit bon ou mauvais de la littérature arabe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26e6d740-bd0a-40a8-b021-528d6e088435",
                                                "sense_id": "2d91d257-cee9-34a9-b9c7-f1bd28b1a954",
                                                "text": "Au bout de trois jours, sentant ses forces diminuer, il (Aladin) implora Dieu en joignant les mains et ainsi frotta l’anneau que le magicien avait passé à son doigt. Aussitôt un génie à la figure effroyable lui apparut et dit :\n— Que veux-tu, je suis prêt à t’obéir comme ton esclave et l’esclave de tous ceux qui ont l’anneau au doigt !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c207ea78-f8c2-3fbd-bc72-c1ec5b2a6bbe",
                                        "entry_id": "bc664112-ae4d-32b3-9a33-bcacb986c5d6",
                                        "glosses": [
                                            "Esprit bon ou mauvais de la culture vietnamienne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "022f3a44-8023-4aa0-913d-45c4ad91603c",
                                                "sense_id": "c207ea78-f8c2-3fbd-bc72-c1ec5b2a6bbe",
                                                "text": "Dans l’esprit des H’mông, chaque forêt est gérée par un génie. Le culte consacré au génie de la forêt est lié étroitement à la protection des forêts. De plus, ce culte a pour but de solliciter une météo clémente propice à d’abondantes récoltes.\n Les H’mông pratiquent le culte dédié au génie de la forêt au premier jour du Nouvel an lunaire car ils pensent que c’est le jour le plus approprié de l’année."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
