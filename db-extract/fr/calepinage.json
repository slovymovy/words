                                        "sense_id": "a478afc8-5d58-3200-9b47-66f5dd1d8172",
                                        "entry_id": "4437b200-c85c-3187-aa06-8a25f28ff260",
                                        "glosses": [
                                            "fachgerechte Installation/Anbringung/Montage"
                                        ],
                                        "tags": [
                                            "besonders von Bodenbelägen und Kabeln"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d95fb042-e5a7-4a83-aed1-313c4a40bd99",
                                                "sense_id": "a478afc8-5d58-3200-9b47-66f5dd1d8172",
                                                "text": "„Die Verlegungen von Kabeln und Leitungen in Gebäuden ist durch Normen, insbesondere der DIN VDE 0100-520:2013-06 und der DIN VDE 0298-4:2013-06 geregelt.“"
                                            },
                                            {
                                                "example_id": "d5a5abf2-3447-4694-91c8-6ff1f16314eb",
                                                "sense_id": "a478afc8-5d58-3200-9b47-66f5dd1d8172",
                                                "text": "„Für die Verlegung von Naturstein ist es das Verfahren, das dem heutigen Stand der Technik entspricht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cb7d7521-c918-3649-8978-c06f1152a4ae",
                                        "entry_id": "4437b200-c85c-3187-aa06-8a25f28ff260",
                                        "glosses": [
                                            "Neufestlegung eines Termins"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb70e37b-9233-4503-8fe9-50d0901f30f2",
                                                "sense_id": "cb7d7521-c918-3649-8978-c06f1152a4ae",
                                                "text": "„Die Klassen waren sehr voll, da sehr viel mehr Kinder durch die Verlegung des Stichtages auf den 1. Juli schulpflichtig wurden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a937080f-3e8f-3b0c-92b3-f2c43a418932",
                                        "entry_id": "4437b200-c85c-3187-aa06-8a25f28ff260",
                                        "glosses": [
                                            "Transfer von einem Ort zum anderen"
                                        ],
