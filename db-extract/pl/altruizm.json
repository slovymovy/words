                        ]
                    },
                    {
                        "translation_id": "894f2f6f-d276-431f-81ec-b2f42f84493a",
                        "source_entry_id": "c45c3f8e-c2fc-3a17-8a5f-1d3a1d0bbdd9",
                        "source_sense_id": "4813e6ea-f1f9-3ac7-b9ca-5ebd83bb52c7",
                        "target_lang_word": "Altruismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Altruismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "39f41fe0-ce20-3194-8f6a-5cf7e259ea25",
                                        "entry_id": "56fa5862-eb1f-3ce2-8071-5210a6866d69",
                                        "glosses": [
                                            "Selbstlosigkeit, Menschenliebe, Uneigennützigkeit"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b164fc1-18c2-46f4-953e-0a6e4f7ee039",
                                                "sense_id": "39f41fe0-ce20-3194-8f6a-5cf7e259ea25",
                                                "text": "Altruismus ist eine bewundernswerte Tugend."
                                            },
                                            {
                                                "example_id": "335133a9-d7c2-4818-aa66-1d8d328b2dab",
                                                "sense_id": "39f41fe0-ce20-3194-8f6a-5cf7e259ea25",
                                                "text": "„Doch sich allein auf den Altruismus zu verlassen, kann tödlich sein: So sterben in den USA jährlich 2000 bis 3000 Menschen, bevor ein passender Knochenmarkspender gefunden ist.“"
                                            },
                                            {
                                                "example_id": "2fffc775-f996-480b-966b-b012c171ce18",
                                                "sense_id": "39f41fe0-ce20-3194-8f6a-5cf7e259ea25",
                                                "text": "„Wielands Raffinement ist, dass gerade der Altruismus des Liebhabers den Egoismus des Liebhabers weckt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c5f80ddf-7eeb-460c-acd4-c9f333b4a314",
                        "source_entry_id": "c45c3f8e-c2fc-3a17-8a5f-1d3a1d0bbdd9",
                        "source_sense_id": "4813e6ea-f1f9-3ac7-b9ca-5ebd83bb52c7",
                        "target_lang_word": "альтруизм",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "альтруизм",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "7d11a472-5db4-319f-a436-be9824cc2427",
                                        "entry_id": "3c9baaad-f21f-3d49-81a7-0e4a2a7f0520",
                                        "glosses": [
                                            "бескорыстная забота о благе других людей, готовность жертвовать собственными интересами"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b8ae0f4-54cc-4c5a-80ca-b22fc39fb872",
                                                "sense_id": "7d11a472-5db4-319f-a436-be9824cc2427",
                                                "text": "Влекомый потребностью к альтруизму, человек необдуманно рассыпает свои щедроты, и это приводит только ко злу как для ближних, так и для него самого."
                                            },
                                            {
                                                "example_id": "f9315031-7ea4-4e93-9dcb-407e228bc3c9",
                                                "sense_id": "7d11a472-5db4-319f-a436-be9824cc2427",
                                                "text": "Об альтруизме говорят, когда охладела и омертвела любовь."
                                            },
                                            {
                                                "example_id": "a9a51a92-b377-4972-822a-1868b703ad7b",
                                                "sense_id": "7d11a472-5db4-319f-a436-be9824cc2427",
                                                "text": "— Альтруизм и другие поведенческие отклонения от оси выживаемости суть вынужденные механизмы адаптации, распространённые в симбиотических группах и среди социальных животных. — Вы эгоист? — спросила Софи."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
