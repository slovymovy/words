                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3a11f8c-beb5-44e5-a374-aae6f1df5f54",
                                                "sense_id": "f0f4fea2-344b-3915-837f-416f2313218b",
                                                "text": "Krishna ist ein Avatar des Vishnu."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b84da605-dce3-4497-8409-3a5ca602b5db",
                        "source_entry_id": "4c334884-ef52-3a0a-8316-100ae6308cc5",
                        "source_sense_id": "cd299b1b-e471-3a18-9684-124ef57142fb",
                        "source_sense_description": "(informatica) een kleine afbeelding die een bepaalde gebruiker symboliseert",
                        "target_lang_word": "avatar",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "avatar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "997c159b-ecaf-398f-9e9e-2c7a2d6e272b",
                                        "entry_id": "78cf5462-8953-37b1-8937-244867138be8",
                                        "glosses": [
                                            "An incarnation of a deity, particularly Vishnu."
                                        ],
                                        "tags": [
                                            "Hinduism"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e684d4c4-fec0-38de-970f-54137c615fff",
                                        "entry_id": "78cf5462-8953-37b1-8937-244867138be8",
                                        "glosses": [
                                            "The embodiment of an idea or concept; an instantiation, especially a personification or incarnation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "def1ef50-afe5-429e-a970-2cde2e59e0f1",
                                                "sense_id": "e684d4c4-fec0-38de-970f-54137c615fff",
                                                "text": "...that a new avatar of Mrs. Siddons has appeared at Covent Garden, in the shape of her niece Fanny Kemble..."
                                            },
                                            {
                                                "example_id": "4e326f9c-d86b-4978-9f70-80f32a680669",
                                                "sense_id": "e684d4c4-fec0-38de-970f-54137c615fff",
                                                "text": "And honest Alan, who was a grim fire-eater in his day, has in this new avatar no more desperate purpose than to steal some young gentleman's attention from his Ovid, […] [Contrasting the historical Alan Breac with his incarnation in the novel.]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac23c01f-3a26-3634-b605-3396af2d79a9",
                                        "entry_id": "78cf5462-8953-37b1-8937-244867138be8",
                                        "glosses": [
                                            "A complex and dynamic digital representation of a person or being in the form of a digital model, used online as a simulation or emulation of a person, or as a person's online alter ego, in a virtual world, virtual chat room, or metaverse."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cdcb1a34-4ad8-4b13-adcb-7dc0346f85d3",
                                                "sense_id": "ac23c01f-3a26-3634-b605-3396af2d79a9",
                                                "text": "The people are pieces of software called avatars. They are the audiovisual bodies that people use to communicate with each other in the Metaverse."
                                            },
                                            {
                                                "example_id": "e208b713-e53b-4040-9ac9-2c079c3b1a48",
                                                "sense_id": "ac23c01f-3a26-3634-b605-3396af2d79a9",
                                                "text": "A virtual intelligence is an advanced form of user interface software. VIs use a variety of methods to simulate natural conversation, including an audio interface and an avatar personality to interact with."
                                            },
                                            {
                                                "example_id": "fc88acb6-7814-4786-a2da-922f5f5a64bf",
                                                "sense_id": "ac23c01f-3a26-3634-b605-3396af2d79a9",
                                                "text": "Devices now track and record our every move and, whether we like it or not, each one of us will bequeath to posterity a virtual avatar, a digital being whose calls, messages, transactions, loves and losses will live on in a vast, unregulated cyberspace. The afterlife has arrived, at least for our cyberbeings."
                                            },
                                            {
                                                "example_id": "41b0191b-7557-4722-aeba-acf83a10bc86",
                                                "sense_id": "ac23c01f-3a26-3634-b605-3396af2d79a9",
                                                "text": "Last year, a 14-year-old boy died by suicide after falling in love with a chatbot from Character.AI. The last thing he did was have a conversation with an AI avatar that, possibly failing to recognize the severity of the situation, reportedly encouraged him to go through with his plan to “join her”."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "adfd61db-3e5c-3778-99c4-8495f409412b",
                                        "entry_id": "78cf5462-8953-37b1-8937-244867138be8",
                                        "glosses": [
                                            "A simple and static or nearly static digital representation of a person or being in the form of a small digital object, used online as a simulacrum or token of a person or that person's online alter ego, in any digital environment but especially in nonvirtual, nonmetaversal ones."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e59e4032-222d-4a9f-bd6f-8198a11f5bad",
                        "source_entry_id": "4c334884-ef52-3a0a-8316-100ae6308cc5",
                        "source_sense_id": "cd299b1b-e471-3a18-9684-124ef57142fb",
                        "source_sense_description": "(informatica) een kleine afbeelding die een bepaalde gebruiker symboliseert",
                        "target_lang_word": "avatar",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "avatar",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e04f6b3d-051a-3315-ad0a-0f84281b33bc",
                                        "entry_id": "5d2ca88b-1e40-3e19-8806-5093a4394d4b",
                                        "glosses": [
                                            "Dans la religion hindouiste, chacune des incarnations du dieu Vishnou."
                                        ],
                                        "tags": [
                                            "Hinduism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a50d8ad5-0a66-4fe6-8aa0-ad789c1fe97d",
                                                "sense_id": "e04f6b3d-051a-3315-ad0a-0f84281b33bc",
                                                "text": "Chenguza est beau comme le grand Avatar, (descendant de Bram) et quoique élevé pour le sacerdoce dans les austérités du cloître, il a l'imagination vive, le désir de s'instruire, et un penchant décidé pour la volupté."
                                            },
                                            {
                                                "example_id": "a8aac96d-8832-42b4-9281-5652c20bf542",
                                                "sense_id": "e04f6b3d-051a-3315-ad0a-0f84281b33bc",
                                                "text": "Retiré dans les forêts, placé à la tête de nombreux pasteurs, qui ont dû se plaire à grossir sa renommée, et dont les bras l'ont aidé à renverser le tyran, Crichna évidemment dut sortir des Djangles, où il s'était tenu jusque-là dans le mystère, comme un homme environné d'une sorte d'auréole merveilleuse, qui le fit considérer de bonne heure comme un Avatar (incarnation) de la Divinité, caractère religieux et providentiel que l'Inde a toujours accordé à ses grands hommes"
                                            },
                                            {
                                                "example_id": "b655d817-ef40-49a3-900f-8467fc54b6dc",
                                                "sense_id": "e04f6b3d-051a-3315-ad0a-0f84281b33bc",
                                                "text": "Plusieurs passages des Pouranas peuvent aussi servir à prouver que les eaux ont fait éprouver au globe terrestre une grande révolution, et la plupart des avatars ou métamorphoses et incarnations de Vichenou, paraissent avoir trait à ce cataclysme général."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea06f117-85e6-381b-bbf4-1b9bc6e880be",
                                        "entry_id": "5d2ca88b-1e40-3e19-8806-5093a4394d4b",
                                        "glosses": [
                                            "Métamorphose, transformation d’un objet ou d’un individu qui en a déjà subi plusieurs."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75c36187-0708-4cdc-91cb-080d9a7c5365",
                                                "sense_id": "ea06f117-85e6-381b-bbf4-1b9bc6e880be",
                                                "text": "Que d’avatars dans la vie politique de cet homme d’État !"
                                            },
                                            {
                                                "example_id": "5af082dc-78ff-45d7-8ebd-9e2f501c51f3",
                                                "sense_id": "ea06f117-85e6-381b-bbf4-1b9bc6e880be",
                                                "text": "Batman est l’avatar moderne de Zorro."
                                            },
                                            {
                                                "example_id": "a0bf0297-26b5-457a-a9c0-ada46aedfb03",
                                                "sense_id": "ea06f117-85e6-381b-bbf4-1b9bc6e880be",
                                                "text": "L’espéranto est l’avatar moderne du sanskrit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1afa498d-9e23-36b4-a6d9-72152ce826fa",
                                        "entry_id": "5d2ca88b-1e40-3e19-8806-5093a4394d4b",
                                        "glosses": [
                                            "Mésaventure, malheur."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af556af9-5fca-4b3c-bd69-df639e34bbbb",
                                                "sense_id": "1afa498d-9e23-36b4-a6d9-72152ce826fa",
                                                "text": "Mais la guerre n’en finissait plus et c’est alors que je devins, après bien des démarches, de boulanger, élève-pilote et par la suite pilote aviateur, à ma très grande surprise et sans trop d’avatars."
                                            },
                                            {
                                                "example_id": "c2a92983-2a8e-4907-9e94-dc725dabf76c",
                                                "sense_id": "1afa498d-9e23-36b4-a6d9-72152ce826fa",
                                                "text": "N'avions-nous pas aidé à la constituer, en courant bien des risques et au prix de quelles avatars ! Alors, lui mort, il ne savait plus qu'en faire…."
                                            },
                                            {
                                                "example_id": "1a59dd58-a5fe-4620-892a-971e25bb8543",
                                                "sense_id": "1afa498d-9e23-36b4-a6d9-72152ce826fa",
                                                "text": "Le service social du travail – Avatars d’une fonction, vicissitudes d’un métier"
                                            },
                                            {
                                                "example_id": "9bfe96d6-068d-467e-ae10-e10cca931dcd",
                                                "sense_id": "1afa498d-9e23-36b4-a6d9-72152ce826fa",
                                                "text": "Compte tenu des divers avatars rencontrés ces dernières années (rouille du mélèze, puceron lanigère, tempêtes…), il n'est plus possible de s’intéresser à la seule productivité, […]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "avatar",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9c60e23b-4163-39ff-b38f-2f6e65dc0810",
                                        "entry_id": "b38058fd-c86b-315d-877a-fb62b75e6dff",
                                        "glosses": [
                                            "Apparence que prend une personne dans un environnement graphique informatique (image dans un forum internet ou un clavardoir, objet 3D dans un univers virtuel). Cette image peut illustrer autre chose que l’utilisateur lui-même."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "842735e8-0d41-4b2a-a2e1-ab85e0b371c5",
                                                "sense_id": "9c60e23b-4163-39ff-b38f-2f6e65dc0810",
                                                "text": "« Nous passons tant de temps dans des décors virtuels à piloter nos avatars, que la réalité matérielle n'est plus qu'un pont étroit entre deux 3d. »"
                                            },
                                            {
                                                "example_id": "2cafc187-34a2-43a9-b793-6b84db52b1a3",
                                                "sense_id": "9c60e23b-4163-39ff-b38f-2f6e65dc0810",
                                                "text": "Dans l’univers virtuel de la simulation numérique, l’avatar anthropoïde, c’est moi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12183310-c123-3661-9ebc-cf6e78f39720",
                                        "entry_id": "b38058fd-c86b-315d-877a-fb62b75e6dff",
                                        "glosses": [
                                            "Personnage ou objet de synthèse évoluant dans un décor réel."
                                        ],
                                        "tags": [
                                            "Audiovisuel",
                                            "Infographie"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5a149c2c-75e1-4702-ac44-7e14a74044c1",
                        "source_entry_id": "4c334884-ef52-3a0a-8316-100ae6308cc5",
