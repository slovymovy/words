                        "entry_id": "48d7b6ae-30fb-32d2-a209-cd61a55fbbe6",
                        "glosses": [
                            "A competition where entrants aim to tip (predict) the outcomes of sporting events."
                        ],
                        "tags": [
                            "Australia",
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "d8738926-1b97-4c97-b8bc-727c1d381a19",
                                "sense_id": "8993a2f7-93de-3b83-ba1f-810967206e75",
                                "text": "Cats fan Mr Burke received a handsome trophy from Balmoral Grove for his feat but is no stranger to cleaning up, having won the tipping at The Break three years in a row and also done well at The National Hotel."
                            }
                        ]
                    }
