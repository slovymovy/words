                        "glosses": [
                            "Baguette de pain fabriquée artisanalement à partir de farines commercialisées par un regroupement de meuniers."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cce47590-828f-4c56-b637-b2a5233911e8",
                                "sense_id": "e85bb78d-0b9f-338c-97ee-fdade07d1d50",
                                "text": "Inopinément le contrôleur goûte leurs banettes et s’assure du respect du cahier des charges (farine, fabrication sur place, fournée toute la matinée…)."
                            },
                            {
                                "example_id": "ebc9f7ae-e541-48b7-8e76-92a729d93f9e",
                                "sense_id": "e85bb78d-0b9f-338c-97ee-fdade07d1d50",
                                "text": "Sur le chemin du retour, vous passez par la boulangerie vous acheter une banette."
                            }
                        ]
                    },
                    {
                        "sense_id": "c19fe8dc-cd5c-33e6-86a0-8ba2f9cfb94e",
