                "senses": [
                    {
                        "sense_id": "a9f8dfc1-f6e4-3144-a603-862b3debcca1",
                        "entry_id": "45e9e73c-fa95-3e71-8f81-12f1251b8751",
                        "glosses": [
                            "metallisches Material (Legierung aus Kupfer, Nickel und Zink), das aussieht wie Silber"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f96a075e-942a-48d7-8638-cf1c74dd83e8",
                                "sense_id": "a9f8dfc1-f6e4-3144-a603-862b3debcca1",
                                "text": "„Es war eine Menage, aus Neusilber, verbogen und verrostet, aber dennoch hier auf so lächerliche Weise fehl am Platze, daß sie an einen König erinnerte, der in Lumpen gehüllt ins Exil unter Barbaren verbannt ist, und die Erhabenheit ihres früheren Ranges erwartete sogar in ihrer Erniedrigung noch Achtung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1d8bab56-c7d1-4575-bd81-855c1eb8b55f",
                        "source_entry_id": "45e9e73c-fa95-3e71-8f81-12f1251b8751",
                        "source_sense_id": "a9f8dfc1-f6e4-3144-a603-862b3debcca1",
