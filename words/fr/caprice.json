                        "caprice d'enfant"
                    ]
                },
                {
                    "sense_id": "50f371e0-0dcb-397b-9a9b-9d84cec5ffb5",
                    "sense_definition": "Envie ou volonté soudaine, passagère et irréfléchie.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "comportement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a acheté cette voiture de sport sur un simple <w>caprice</w>."
                        },
                        {
                            "text": "Elle change souvent d'avis au gré de ses <w>caprices</w> du moment."
                        }
                    ],
                    "synonyms": [
