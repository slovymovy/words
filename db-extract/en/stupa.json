                                        "entry_id": "abd7fb1e-6053-3fc7-a8e8-d6ff98272abc",
                                        "glosses": [
                                            "устар. тихая, неторопливая походка, поступь"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
