    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "84b5c5f9-6332-303b-a8c0-acae4945975a",
                "word": "whichever",
                "pos": "det",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c1b0945b-760a-3638-bcc6-615436cbe840",
                        "entry_id": "84b5c5f9-6332-303b-a8c0-acae4945975a",
                        "glosses": [
                            "Which ever; emphatic form of 'which'."
                        ],
                        "tags": [
                            "interrogative"
                        ],
                        "examples": [
                            {
                                "example_id": "859a4f90-cdaf-421a-a841-b60985bcb2ba",
                                "sense_id": "c1b0945b-760a-3638-bcc6-615436cbe840",
                                "text": "Good heavens! Whichever button did you press to make that happen?!"
                            }
                        ]
                    },
                    {
                        "sense_id": "189f4393-ea5f-387d-b1ae-b8c4efc000ad",
                        "entry_id": "84b5c5f9-6332-303b-a8c0-acae4945975a",
                        "glosses": [
                            "Regardless of the ... that; no matter which."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ecfa4145-c4cf-4af8-94ef-e63f922188d4",
                                "sense_id": "189f4393-ea5f-387d-b1ae-b8c4efc000ad",
                                "text": "It won't work, whichever buttons you press."
                            },
                            {
                                "example_id": "c3645073-66f0-40c3-affe-ffb4b64bc36c",
                                "sense_id": "189f4393-ea5f-387d-b1ae-b8c4efc000ad",
                                "text": "Whichever book you borrow, be sure to return it to the library on time."
                            }
                        ]
                    },
                    {
                        "sense_id": "97757984-c0e9-3d4f-8c98-95759b72a803",
                        "entry_id": "84b5c5f9-6332-303b-a8c0-acae4945975a",
                        "glosses": [
                            "Any or either ... that; the ... that."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "942249b9-3187-4b3f-84af-9f86b239acfe",
                                "sense_id": "97757984-c0e9-3d4f-8c98-95759b72a803",
                                "text": "Choose whichever card you like."
                            },
                            {
                                "example_id": "7ffe2c2f-9913-43b4-a8dc-abeaba55d140",
                                "sense_id": "97757984-c0e9-3d4f-8c98-95759b72a803",
                                "text": "Borrow whichever books interest you."
                            },
                            {
                                "example_id": "60a4f112-70d0-4d31-a2b2-f21aceffb98b",
                                "sense_id": "97757984-c0e9-3d4f-8c98-95759b72a803",
                                "text": "I'll buy whichever shirt is cheapest."
                            }
                        ]
                    },
                    {
                        "sense_id": "4a23709c-fc7a-3a04-9540-74f972856bc6",
                        "entry_id": "84b5c5f9-6332-303b-a8c0-acae4945975a",
                        "glosses": [
                            "According to or depending upon which."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "222371b5-44f8-445e-bd5b-3477e4933364",
                                "sense_id": "4a23709c-fc7a-3a04-9540-74f972856bc6",
                                "text": "I'll buy the red shirt or the blue shirt, whichever one is cheaper."
                            },
                            {
                                "example_id": "0aa39e65-f1d2-4cb8-9955-9dc43f45e661",
                                "sense_id": "4a23709c-fc7a-3a04-9540-74f972856bc6",
                                "text": "If the work is of joint authorship, the copyright expires 50 years after the death of the author who first dies, or upon the death of the author who dies last, whichever period is longer."
                            }
                        ]
                    }
                ],
                "translations": [],
