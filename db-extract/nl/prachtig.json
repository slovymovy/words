                                "target_senses": [
                                    {
                                        "sense_id": "d6363a84-6ad2-3c78-885f-824f77e38910",
                                        "entry_id": "9fda9b8f-d809-32b4-b9fb-9e940a10c1d7",
                                        "glosses": [
                                            "очень красивый"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d76db8a-d8d2-4e6e-84a8-90cb424ab338",
                                                "sense_id": "d6363a84-6ad2-3c78-885f-824f77e38910",
                                                "text": "Обер-бургомистра прекрасного города Висбаден зовут Хельмут Мюллер."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ed20e87-7f08-3a8c-8393-50898c23fc17",
                                        "entry_id": "9fda9b8f-d809-32b4-b9fb-9e940a10c1d7",
                                        "glosses": [
                                            "превосходный, очень хороший"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f7e1c12-6451-4af9-870f-30fb81871ca5",
                                                "sense_id": "7ed20e87-7f08-3a8c-8393-50898c23fc17",
                                                "text": "Прекрасная погода."
                                            },
                                            {
                                                "example_id": "019bc66d-d43d-48a7-bc7e-33a1159b2e17",
                                                "sense_id": "7ed20e87-7f08-3a8c-8393-50898c23fc17",
                                                "text": "Прекрасная мысль."
                                            },
                                            {
                                                "example_id": "7e6629f9-ae59-4345-856c-c2cb1aa5ccc5",
                                                "sense_id": "7ed20e87-7f08-3a8c-8393-50898c23fc17",
                                                "text": "Обер-бургомистра прекрасного города Висбаден зовут Хельмут Мюллер. […] Но, конечно же, вовсе не поэтому господин Мюллер считает, что Висбаден создал прекрасные условия для германо-российских консультаций."
                                            }
                                        ]
