                {
                    "sense_id": "2000457e-f04a-3e79-aafd-b899b37ff411",
                    "sense_definition": "Особая форма существования материи, отличающая живые организмы от неживых предметов",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "biological_existence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<Жизнь> на Земле зародилась в воде.",
                            "target_lang_translations": {
                                "en": "<Life> on Earth began in the water.",
                                "zh": "地球上的<w>生命</w>起源于水中。"
                            }
                        },
                        {
                            "text": "Учёные ищут признаки <жизни> на других планетах.",
                            "target_lang_translations": {
                                "en": "Scientists are looking for signs of <life> on other planets.",
                                "zh": "科学家们正在寻找其他星球上存在<w>生命</w>的迹象。"
                            }
                        }
                    ],
                    "synonyms": [
                        "бытие",
                        "существование"
                    ],
                    "antonyms": [
                        "смерть",
                        "небытие"
                    ],
                    "common_phrases": [
                        "зарождение жизни",
                        "древо жизни"
                    ],
                    "target_lang_definitions": {
                        "en": "The state of being alive, distinguishing living organisms from inorganic matter",
                        "zh": "生物区别于非生物的特殊存在形式"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "life",
                                "target_lang_sense_clarification": "biological state"
