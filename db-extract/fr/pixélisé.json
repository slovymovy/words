                        ],
                        "examples": [
                            {
                                "example_id": "bbc85e58-9537-4b8f-8782-817ed4e10e9f",
                                "sense_id": "9d1bb04c-cda2-31ff-bd23-16659dcac2e7",
                                "text": "Elle brandit une photo de ses parents en noir et blanc devant la caméra de l'ordinateur, sa main tremble un peu et la photo flotte devant moi, légèrement pixélisée, comme venue d'un songe."
                            },
                            {
                                "example_id": "9e9f359e-211f-41f5-a893-cb17da0e2998",
                                "sense_id": "9d1bb04c-cda2-31ff-bd23-16659dcac2e7",
                                "text": "Un nouveau cadre était posé sur son bureau face à une photo pixélisée de nous deux échangeant un baiser. Elle avait dû être prise de loin au téléobjectif, car elle était assez floue."
                            }
                        ]
                    }
