                        "form": "dem Ostrazismus"
                    },
                    {
                        "form_id": "4075d92b-d03b-473f-9ba6-7907f509f0a8",
                        "entry_id": "00431519-ff23-360e-9743-44912d6abb2d",
                        "tags": [
                            "accusative",
