                    "semantic_group_id": "general_resurrection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W islamie wiara w <w>zmartwychwstanie</w> w dniu sądu ostatecznego jest zbliżona do wersji chrześcijańskiej.",
