    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "da71caa8-112b-3aa4-9f27-0907d6be286a",
                    "sense_definition": "Engager une somme d'argent ou un enjeu sur l'issue incertaine d'un jeu, d'une compétition ou d'un événement.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "jeu_argent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ils ont décidé de <w>parier</w> vingt euros sur la victoire finale de leur équipe."
                        },
                        {
                            "text": "Mon grand-père aimait <w>parier</w> aux courses de chevaux tous les dimanches."
                        }
                    ],
                    "synonyms": [
                        "gager",
                        "miser"
                    ],
                    "common_phrases": [
                        "parier de l'argent",
                        "parier sur un cheval",
                        "parier aux courses"
                    ]
                },
                {
                    "sense_id": "063d7507-76ba-3444-aacf-ea12d0e972d3",
                    "sense_definition": "Affirmer ou soutenir une prédiction avec une forte conviction, sans nécessairement d'enjeu matériel.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "affirmation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je <w>parie</w> qu'il va encore oublier ses clés sur la table avant de partir."
                        },
                        {
                            "text": "Tu peux <w>parier</w> que cette nouvelle surprendra tout le monde au bureau."
                        }
                    ],
                    "common_phrases": [
                        "parier que"
                    ]
                },
                {
                    "sense_id": "9cf8a0a2-93c3-3058-9e3e-5bf8d12c2a2c",
                    "sense_definition": "Être fort probable, hautement prévisible (s'emploie principalement dans des tournures impersonnelles).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "probabilite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vu le ciel très sombre, il y a fort à <w>parier</w> qu'un orage éclatera bientôt."
                        },
                        {
                            "text": "À cette vitesse, il y a gros à <w>parier</w> que nous arriverons en avance."
                        }
                    ],
                    "common_phrases": [
                        "il y a fort à parier",
                        "il y a gros à parier"
                    ]
                }
            ]
        }
    ]
