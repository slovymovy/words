                    },
                    {
                        "translation_id": "1fa143a5-13fd-4ee6-8852-c5b2aa4aeed2",
                        "source_entry_id": "ae8b6697-76eb-3cb1-a3a6-2e558063315f",
                        "source_sense_id": "f1a747a8-db07-34b2-94aa-b46f40dd808f",
                        "target_lang_word": "sea lion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sea lion",
