                    {
                        "sense_id": "299dd9fa-7633-39c9-9eb6-75161b5a5624",
                        "entry_id": "8106d7ce-b0c3-31bb-9c24-3b6058258ad4",
                        "glosses": [
                            "Genre d’orchidées originaires d’Asie, de l’Inde à Taïwan, cultivées en serre en Europe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cbe19cef-5f9b-4c0c-8eab-adf0a84bea67",
                                "sense_id": "299dd9fa-7633-39c9-9eb6-75161b5a5624",
                                "text": "Une pleione des plus agréable ^([sic : agréables]) et surtout pas fragile de quoi se lancer dans la folie des pleiones qui gagnent de plus en plus d’adeptes."
                            },
                            {
                                "example_id": "e1d02f48-30a7-4f4b-b916-933f899423e3",
                                "sense_id": "299dd9fa-7633-39c9-9eb6-75161b5a5624",
                                "text": "La plupart des Pleiones fleurissent au printemps (mars – avril), poussent de mai à septembre et se reposent en hiver."
                            },
                            {
                                "example_id": "e001b807-e723-47d9-bfa8-cb61345d2b26",
                                "sense_id": "299dd9fa-7633-39c9-9eb6-75161b5a5624",
                                "text": "Les Pleiones sont des orchidées d’extérieur qui sont de plus en plus souvent disponibles en jardinerie au rayon bulbe."
                            }
                        ]
                    }
                ],
