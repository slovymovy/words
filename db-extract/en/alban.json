    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "a8e5fdfb-7611-3a84-9a34-0e2dacfd0ff8",
                "word": "Alban",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ccb8cb96-ba3a-32d2-a691-56a4a75ed29d",
                        "entry_id": "a8e5fdfb-7611-3a84-9a34-0e2dacfd0ff8",
                        "glosses": [
                            "Pertaining to the ancient Latin city of Alba Longa."
                        ],
                        "tags": [
                            "historical",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "21338d0b-a60f-4fba-ba0e-4d3fbcbc05cc",
                                "sense_id": "ccb8cb96-ba3a-32d2-a691-56a4a75ed29d",
                                "text": "But beside this, there existed at Lavinium another tradition, which inverts the order of things by stating that Lavinium was an Alban colony, founded by six hundred Alban families."
                            },
                            {
                                "example_id": "03e80671-6b83-45fb-bb2a-633f6ce5cdac",
                                "sense_id": "ccb8cb96-ba3a-32d2-a691-56a4a75ed29d",
                                "text": "Now the Alban dynasti bore the name of Silvii or Wood, and it can hardly be without significance that in the vision of the historic glories of Rome revealed to Aeneas in the underworld, Virgil, an antiquary as well as a poet, should represent all the line of Silvii as crowned with oak."
                            },
                            {
                                "example_id": "6f51e4f8-13da-49d2-be75-87f34982b33b",
                                "sense_id": "ccb8cb96-ba3a-32d2-a691-56a4a75ed29d",
                                "text": "Reminded of the Alban king’s descent from Silvius, the son of Aeneas, Vergil’s reader must judge the crime of Mettus and his gruesome punishment with greater horror and revulsion."
                            }
                        ]
                    },
                    {
                        "sense_id": "a6ee90a7-8d29-3021-af12-41ef8e8d2b9f",
                        "entry_id": "a8e5fdfb-7611-3a84-9a34-0e2dacfd0ff8",
                        "glosses": [
                            "Pertaining to Alba, or the area now covered by Scotland."
                        ],
                        "tags": [
                            "historical",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "3683de07-4898-47de-8c81-97aa7e066480",
                                "sense_id": "a6ee90a7-8d29-3021-af12-41ef8e8d2b9f",
                                "text": "At some point during the Picto-Gaelic fusion, St Andrew was adopted as patron of the Alban kingdom."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
