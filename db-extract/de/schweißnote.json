                "senses": [
                    {
                        "sense_id": "c8ca2d01-a5e7-3feb-b0d2-1bbac4418061",
                        "entry_id": "ed406199-4cd5-3d79-b314-f5c5738815e4",
                        "glosses": [
                            "charakteristischer Duft nach Sekret, welches beim Schwitzen entsteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba028fc8-5196-4f66-87fd-bc1f3686cb16",
                                "sense_id": "c8ca2d01-a5e7-3feb-b0d2-1bbac4418061",
                                "text": "„Zunächst fettiger Geruch ohne Schweißnote, dann blumige Noten zwischen Iris, Rose und Orangenblüte oscillierend“"
                            },
                            {
                                "example_id": "38981cf1-027a-4867-a131-708580b8bbce",
                                "sense_id": "c8ca2d01-a5e7-3feb-b0d2-1bbac4418061",
                                "text": "„Neben Weihrauch un einer leichten Schweißnote roch ich, dass er vor Kurzem eine Speise mit Knoblauch und Petersilie gegessen hatte…“"
                            },
                            {
                                "example_id": "2e63b741-892d-4a35-b0e1-ebc7ff7e6483",
                                "sense_id": "c8ca2d01-a5e7-3feb-b0d2-1bbac4418061",
                                "text": "„Die Mischung aus der Wolle seines Jacketts, einer ganz leichten herben Schweißnote und seinem Aftershave.“"
                            },
                            {
                                "example_id": "e16ee127-bc42-45af-8356-1645432f142c",
                                "sense_id": "c8ca2d01-a5e7-3feb-b0d2-1bbac4418061",
                                "text": "„Die Riesenfichte dagegen weist eine irritierende leichte Schweißnote auf, als sei es den Nadeln in der Destillerie ein bisschen zu warm geworden.“"
                            },
                            {
                                "example_id": "857bf4de-79fa-4c26-9049-11020175141a",
                                "sense_id": "c8ca2d01-a5e7-3feb-b0d2-1bbac4418061",
                                "text": "„Eher Schweißnote oder Bier-Odeur?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
