                {
                    "sense_id": "44057e13-ff5d-3bda-9cc9-9dad17d63319",
                    "sense_definition": "iets met kracht in de lengte doormidden of open maken",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "splijten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De houthakker probeerde het grote blok hout met een bijl <w>open te splijten</w>.",
                            "target_lang_translations": {
                                "en": "The woodcutter tried to <w>split open</w> the large block of wood with an axe."
                            }
                        },
                        {
                            "text": "Je moet de boomstam voorzichtig <w>opensplijten</w> om het hout niet te beschadigen.",
                            "target_lang_translations": {
                                "en": "You must <w>split</w> the tree trunk <w>open</w> carefully so as not to damage the wood."
                            }
                        }
                    ],
                    "synonyms": [
                        "openkloven",
                        "splijten"
                    ],
                    "common_phrases": [
                        "hout opensplijten",
                        "met een bijl opensplijten"
                    ],
                    "target_lang_definitions": {
                        "en": "To force something open or apart lengthwise, typically using a tool or physical strength."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to split open",
                                "target_lang_sense_clarification": "using force or a tool"
                            },
                            {
                                "target_lang_word": "to cleave open",
                                "target_lang_sense_clarification": "formal or literary use for splitting"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "03b8e4c3-0b4a-3481-9dca-fc886940214d",
                    "sense_definition": "door druk of spanning vanzelf in de lengte openbarsten",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "splijten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Door de extreme hitte begon de droge grond langzaam <w>open te splijten</w>.",
                            "target_lang_translations": {
                                "en": "Due to the extreme heat, the dry ground slowly began to <w>split open</w>."
                            }
                        },
                        {
                            "text": "De rijpe vrucht <w>spleet open</w> zodra hij de harde grond raakte.",
                            "target_lang_translations": {
                                "en": "The ripe fruit <w>split open</w> as soon as it hit the hard ground."
                            }
                        }
                    ],
                    "synonyms": [
                        "openbarsten",
                        "openscheuren"
                    ],
                    "common_phrases": [
                        "door de hitte opensplijten",
                        "vanzelf opensplijten"
                    ],
                    "target_lang_definitions": {
                        "en": "To burst or crack open lengthwise due to internal pressure, tension, or external conditions."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to split open",
                                "target_lang_sense_clarification": "naturally or due to pressure"
                            },
                            {
                                "target_lang_word": "to crack open",
                                "target_lang_sense_clarification": "referring to surfaces like ground or shells"
                            },
                            {
                                "target_lang_word": "to burst open",
