    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "cd8f2f11-65c3-3c41-9dac-25e8d2753cd9",
                "word": "frontage",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "c2ece198-3bbc-4520-b8f7-6589833f178d",
                        "entry_id": "cd8f2f11-65c3-3c41-9dac-25e8d2753cd9",
                        "tags": [
                            "plural"
                        ],
                        "form": "frontages"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b7850370-592e-320a-b2b5-cd687c21c4f0",
                        "entry_id": "cd8f2f11-65c3-3c41-9dac-25e8d2753cd9",
                        "glosses": [
                            "The front part of a property or building that faces the street."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "b01a08ed-943e-41f3-a1d6-8bce2c693a6b",
                                "sense_id": "b7850370-592e-320a-b2b5-cd687c21c4f0",
                                "text": "Put your little reception-room here beside the door, and get the whole width of your house frontage for a square hall, and an easy low-tread staircase running up the sides of it."
                            },
                            {
                                "example_id": "bfc80612-5e98-4a91-adf3-a431c9b79de2",
                                "sense_id": "b7850370-592e-320a-b2b5-cd687c21c4f0",
                                "text": "Hotel Corones, which has risen phoenix-like on the site of the old Norman Hotel, has a frontage of 210 feet[.]"
                            },
                            {
                                "example_id": "79a85154-52c9-4234-ad94-1e5ddabbc8a9",
                                "sense_id": "b7850370-592e-320a-b2b5-cd687c21c4f0",
                                "text": "BishopsCourt appeared sometimes to want to rival the Canon's house. It looked a house-boat despite its guard of whitewashed stones and luxuriant flowers, its wooden fretwork frontage almost wholly immersed in bougainvillaea."
                            }
                        ]
                    },
                    {
                        "sense_id": "1c6af45a-e0f7-3201-ba1f-fd3944c3a697",
                        "entry_id": "cd8f2f11-65c3-3c41-9dac-25e8d2753cd9",
                        "glosses": [
                            "The land between a property and the street."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "ca7e5a8d-e58c-3781-a1fc-3547fbf9b522",
                        "entry_id": "cd8f2f11-65c3-3c41-9dac-25e8d2753cd9",
                        "glosses": [
                            "The length of a property along a street."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "3b4f6169-c78d-3789-89ac-64fb981c5185",
                        "entry_id": "cd8f2f11-65c3-3c41-9dac-25e8d2753cd9",
                        "glosses": [
                            "Property or territory adjacent to a body of water."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "ff50050e-da06-40f1-906d-4893585498dd",
                                "sense_id": "3b4f6169-c78d-3789-89ac-64fb981c5185",
                                "text": "And here he brought up the entire subject of geopolitics in the Baltic, a sea which Germany in wartime must control to be able to assure herself of shipments of Swedish iron ore needed for her war factories, a sea on which Soviet Russia has a frontage of only 75 miles […]"
                            },
                            {
                                "example_id": "6f516168-4b8e-42ab-86d4-c63c520176d4",
                                "sense_id": "3b4f6169-c78d-3789-89ac-64fb981c5185",
                                "text": "It is important to keep municipally owned land, especially lake frontage, in the hands of the municipality."
                            }
                        ]
                    },
                    {
                        "sense_id": "368417c3-9072-33ea-8b7a-bb40cf33b942",
                        "entry_id": "cd8f2f11-65c3-3c41-9dac-25e8d2753cd9",
                        "glosses": [
                            "The front part generally."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "30e6b4e8-16a9-46da-99db-d9dedccbcb48",
                                "sense_id": "368417c3-9072-33ea-8b7a-bb40cf33b942",
                                "text": "[…] to the eyes of his mother and his aunt, who occupied wicker chairs at a little distance, he was almost indistinguishable except for the stiff white shield of his evening frontage."
                            },
                            {
                                "example_id": "f77835bf-334b-4e89-bd29-6875e5de3dd3",
                                "sense_id": "368417c3-9072-33ea-8b7a-bb40cf33b942",
                                "text": "War looks but to the frontage, the appearance."
                            }
                        ]
                    },
                    {
                        "sense_id": "b339577b-2df9-3e66-8cf5-2a5420968b34",
                        "entry_id": "cd8f2f11-65c3-3c41-9dac-25e8d2753cd9",
                        "glosses": [
                            "A woman's breasts."
                        ],
                        "tags": [
                            "countable",
                            "informal",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "1f846acb-0d67-4961-8a67-21459fceb26c",
                                "sense_id": "b339577b-2df9-3e66-8cf5-2a5420968b34",
                                "text": "\"Bes dear,\" said Throttler, patting her breasts. \"Do you think I should get one of those boob-jobs?\"\nBes looked at his hands, at her frontage, at his hands. \"They say that more than a handful is a waste.\""
                            },
                            {
                                "example_id": "787afb79-dce1-4e0d-87b3-d5d906500550",
                                "sense_id": "b339577b-2df9-3e66-8cf5-2a5420968b34",
                                "text": "I'd go running in, pretend-breathless, nuzzle her neck, reach around to cup her frontage."
                            }
                        ]
                    },
                    {
                        "sense_id": "0e4ca677-4e96-384b-9620-c074b1bd730d",
                        "entry_id": "cd8f2f11-65c3-3c41-9dac-25e8d2753cd9",
                        "glosses": [
                            "a front: a public and perhaps false face or façade to some hidden, covert reality."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "0fe9aeef-b1a0-496d-be30-66602869c078",
                                "sense_id": "0e4ca677-4e96-384b-9620-c074b1bd730d",
                                "text": "Promises and oaths were nothing but a rather awkwardly construed frontage with which to cover up, and win time for, an even more inept intrigue contrived towards the breaking of all promises and all oaths."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3105935d-179f-4a54-90d6-9371c581cb64",
                        "source_entry_id": "cd8f2f11-65c3-3c41-9dac-25e8d2753cd9",
