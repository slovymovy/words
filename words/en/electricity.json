{
    "word_family": [
        "electric",
        "electrical",
        "electrician",
        "electrify",
        "electrification"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5ef78d14-1b2d-32e5-869c-c147190933f1",
                    "sense_definition": "A form of energy provided through wires that is used to power machines, lights, and heating.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_energy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to pay the <w>electricity</w> bill before the end of the month.",
                            "target_lang_translations": {
                                "ru": "Нам нужно оплатить счет за <w>электричество</w> до конца месяца.",
                                "zh": "我们需要在月底前付清<w>电费</w>。"
                            }
                        },
                        {
                            "text": "Solar panels can generate enough <w>electricity</w> to power the entire house.",
                            "target_lang_translations": {
                                "ru": "Солнечные панели могут вырабатывать достаточно <w>электроэнергии</w>, чтобы обеспечить питанием весь дом.",
                                "zh": "太阳能电池板可以产生足够的<w>电力</w>来供应整个房子。"
                            }
                        },
                        {
                            "text": "Please turn off the lights when you leave to save <w>electricity</w>.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, выключай свет, когда уходишь, чтобы экономить <w>электричество</w>.",
                                "zh": "离开时请关灯以<w>节约用电</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "power",
                        "energy",
                        "current"
                    ],
                    "common_phrases": [
                        "electricity bill",
                        "generate electricity",
                        "save electricity",
                        "conduct electricity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма энергии, передаваемая по проводам, которая используется для питания машин, освещения и отопления.",
                        "zh": "通过电线传输的能量形式，用于驱动机器、照明和供暖。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "электричество",
                                "target_lang_sense_clarification": "общий термин"
                            },
                            {
                                "target_lang_word": "электроэнергия",
                                "target_lang_sense_clarification": "энергетический ресурс"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "电",
                                "target_lang_sense_clarification": "通用术语"
                            },
                            {
                                "target_lang_word": "电力",
                                "target_lang_sense_clarification": "作为能源或资源"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "024be901-fa8c-330d-adee-6301bc91d8aa",
                    "sense_definition": "A natural phenomenon caused by the movement and interaction of charged subatomic particles.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_energy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children learned about static <w>electricity</w> by rubbing balloons on their hair.",
                            "target_lang_translations": {
                                "ru": "Дети узнали о статическом <w>электричестве</w>, потирая воздушные шарики о волосы.",
                                "zh": "孩子们通过在头发上摩擦气球了解了<w>静电</w>。"
                            }
                        },
                        {
                            "text": "Rubber is a material that does not conduct <w>electricity</w> very well.",
                            "target_lang_translations": {
                                "ru": "Резина — это материал, который очень плохо проводит <w>электричество</w>.",
                                "zh": "橡胶是一种不太容易<w>导电</w>的材料。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "static electricity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Природное явление, вызванное движением и взаимодействием заряженных субатомных частиц.",
                        "zh": "由带电亚原子粒子的运动和相互作用引起的自然现象。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "электричество",
                                "target_lang_sense_clarification": "физическое явление"
                            },
                            {
                                "target_lang_word": "ток",
                                "target_lang_sense_clarification": "направленное движение частиц"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "电学现象",
                                "target_lang_sense_clarification": "物理现象"
                            },
                            {
                                "target_lang_word": "电流",
                                "target_lang_sense_clarification": "粒子的定向流动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8f5d64f1-a85f-3f0d-9811-952ed005b90c",
                    "sense_definition": "A strong feeling of excitement, tension, or energy in a situation or among a group of people.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "figurative_feeling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There was a strange <w>electricity</w> in the air as the two rivals faced each other.",
                            "target_lang_translations": {
                                "ru": "В воздухе витало странное <w>напряжение</w>, когда два соперника встретились лицом к лицу.",
                                "zh": "当两位对手面对面时，空气中弥漫着一种奇怪的<w>紧张气氛</w>。"
                            }
                        },
                        {
                            "text": "The band's performance created a wave of <w>electricity</w> throughout the cheering crowd.",
                            "target_lang_translations": {
                                "ru": "Выступление группы вызвало волну <w>возбуждения</w> в ликующей толпе.",
                                "zh": "乐队的表演在欢呼的人群中激起了一阵<w>兴奋</w>的浪潮。"
                            }
                        }
                    ],
                    "synonyms": [
                        "excitement",
                        "tension",
                        "buzz",
                        "thrill"
                    ],
                    "common_phrases": [
                        "electricity in the air"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильное чувство возбуждения, напряжения или энергии в ситуации или среди группы людей.",
                        "zh": "在特定情境或人群中产生的强烈兴奋、紧张或能量感。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "напряжение",
                                "target_lang_sense_clarification": "эмоциональное состояние"
                            },
                            {
                                "target_lang_word": "возбуждение",
                                "target_lang_sense_clarification": "сильная эмоция"
                            },
                            {
                                "target_lang_word": "накал",
                                "target_lang_sense_clarification": "интенсивность чувств"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "紧张感",
                                "target_lang_sense_clarification": "情绪状态"
                            },
                            {
                                "target_lang_word": "兴奋",
                                "target_lang_sense_clarification": "强烈的情绪"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "30b03b21-9491-3c09-beec-54f863b0c005",
                    "sense_definition": "The branch of science that deals with the study of electric charges and currents.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physical_energy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He decided to specialize in <w>electricity</w> and magnetism during his university studies.",
                            "target_lang_translations": {
                                "ru": "Он решил специализироваться на <w>электричестве</w> и магнетизме во время учебы в университете.",
                                "zh": "他在大学期间决定专攻<w>电磁学</w>。"
                            }
                        },
                        {
                            "text": "The professor wrote a comprehensive textbook on the fundamentals of <w>electricity</w>.",
                            "target_lang_translations": {
                                "ru": "Профессор написал исчерпывающий учебник по основам <w>электричества</w>.",
                                "zh": "教授编写了一本关于<w>电学</w>基础的综合教材。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Раздел науки, занимающийся изучением электрических зарядов и токов.",
                        "zh": "研究电荷和电流的科学分支。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "электричество",
                                "target_lang_sense_clarification": "раздел физики"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "电学",
                                "target_lang_sense_clarification": "物理学分支"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}