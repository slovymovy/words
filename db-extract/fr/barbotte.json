                    {
                        "sense_id": "54615980-d12a-3988-926a-810bfc34be0d",
                        "entry_id": "1ae46341-70ef-300e-acf3-561a75d5ba0b",
                        "glosses": [
                            "Variante de barbote."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "4efa3aa7-17cf-4358-99b4-b65ae824e9e7",
                                "sense_id": "54615980-d12a-3988-926a-810bfc34be0d",
                                "text": "Dans un endroit passablement plus boueux, près de la berge, je suis tombé sur une vieille barbotte brune en balade avec sa progéniture."
                            },
                            {
                                "example_id": "0008bc83-8bbf-43c4-8c1c-5663f6ee696f",
                                "sense_id": "54615980-d12a-3988-926a-810bfc34be0d",
                                "text": "Croyez-le ou non, j'ai pogné une barbotte dans un nid-de-poule sur al rue Notre-Dame."
                            },
                            {
                                "example_id": "a052cbdc-94d5-4b59-893d-5b9e8555a131",
                                "sense_id": "54615980-d12a-3988-926a-810bfc34be0d",
                                "text": "La truite, le goujon, l’ombre-chevalier, le barbeau, la barbotte ou lote, la carpe…"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "4338370b-ebec-36a1-94ac-a6eaf279aac2",
                "word": "barbotte",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a75ec34d-36f1-45fb-873a-0ef0fe010207",
