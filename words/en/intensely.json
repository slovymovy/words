{
    "word_family": [
        "intense",
        "intensity",
        "intensify",
        "intensification"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "2927a96a-667d-3012-ad21-d3321212618d",
                    "sense_definition": "In a way that shows great energy, focus, or strong feeling.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "intensity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The athlete <w>intensely</w> focused on the finish line during the final race.",
                            "target_lang_translations": {
                                "ru": "Во время финального забега спортсмен <w>напряжённо</w> сосредоточился на финишной черте."
                            }
                        },
                        {
                            "text": "They <w>intensely</w> debated the new policy for several hours.",
                            "target_lang_translations": {
                                "ru": "Они <w>яростно</w> обсуждали новую политику в течение нескольких часов."
                            }
                        }
                    ],
                    "synonyms": [
                        "fiercely",
                        "passionately",
                        "earnestly"
                    ],
                    "common_phrases": [
                        "stare intensely",
                        "focus intensely"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способ, выражающий большую энергию, сосредоточенность или сильные чувства."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "напряжённо",
                                "target_lang_sense_clarification": "о сосредоточенности или внимании"
                            },
                            {
                                "target_lang_word": "страстно",
                                "target_lang_sense_clarification": "о сильных чувствах или увлеченности"
                            },
                            {
                                "target_lang_word": "яростно",
                                "target_lang_sense_clarification": "о проявлении большой энергии или напора"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4baeb5d0-c3c6-3a0f-9448-5b230e4b8d98",
                    "sense_definition": "To a very high or extreme degree.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "intensity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The room was <w>intensely</w> hot after the air conditioning broke down.",
                            "target_lang_translations": {
                                "ru": "В комнате стало <w>чрезвычайно</w> жарко после того, как сломался кондиционер."
                            }
                        },
                        {
                            "text": "He is an <w>intensely</w> private person who rarely shares his feelings.",
                            "target_lang_translations": {
                                "ru": "Он <w>крайне</w> скрытный человек, который редко делится своими чувствами."
                            }
                        }
                    ],
                    "synonyms": [
                        "extremely",
                        "highly",
                        "deeply"
                    ],
                    "common_phrases": [
                        "intensely private",
                        "intensely cold",
                        "intensely hot"
                    ],
                    "target_lang_definitions": {
                        "ru": "В очень высокой или крайней степени."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чрезвычайно",
                                "target_lang_sense_clarification": "в очень высокой степени"
                            },
                            {
                                "target_lang_word": "очень",
                                "target_lang_sense_clarification": "усилительное слово для подчеркивания качества"
                            },
                            {
                                "target_lang_word": "крайне",
                                "target_lang_sense_clarification": "предельно, максимально"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}