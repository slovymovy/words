                        "cross_references": [
                            {
                                "target_word": "inévitablement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "88a8d0a2-a8d7-3cbf-b822-58e2613b44c1",
                                        "entry_id": "52127d06-a6f9-3393-a619-d1c678e1c4a5",
                                        "glosses": [
                                            "D’une manière inévitable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d0d284c-0ace-4ca0-8b99-963021b07dc3",
                                                "sense_id": "88a8d0a2-a8d7-3cbf-b822-58e2613b44c1",
                                                "text": "Il s’exposait à être inévitablement défait, si les troupes eussent été droit à lui."
                                            },
                                            {
                                                "example_id": "d8fc9216-53de-4ba1-b6b8-67f4db8e2a7f",
                                                "sense_id": "88a8d0a2-a8d7-3cbf-b822-58e2613b44c1",
                                                "text": "Les sons vifs et légers ne portent-ils pas inévitablement dans notre âme le plaisir gai ?"
                                            },
                                            {
                                                "example_id": "cd38e16d-88f8-4566-8752-b223b8e5e58f",
                                                "sense_id": "88a8d0a2-a8d7-3cbf-b822-58e2613b44c1",
                                                "text": "… l'État entreprend d'autre part une propagande dont le succès aurait inévitablement pour résultat de vider cette contrée garonnaise de ses derniers progéniteurs."
                                            },
                                            {
                                                "example_id": "e500a6be-e82d-43f7-8064-5daafe4afcba",
                                                "sense_id": "88a8d0a2-a8d7-3cbf-b822-58e2613b44c1",
                                                "text": "Octobre 2004 , je vais quitter Renault à la fin du mois, je prépare mon pot de départ. Inévitablement, c’est l’occasion d’un flash-back sur ma carrière professionnelle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c4f406e3-2e5f-4942-a8e9-2271fe6665ed",
                        "source_entry_id": "c9bee190-d78e-3d0a-9fbd-6c73055428ad",
                        "source_sense_id": "29a43f4e-e85b-308b-859f-d0c3de9edd62",
                        "source_sense_description": "in an unavoidable manner",
                        "target_lang_word": "inéluctablement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inéluctablement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7292fb5b-3c3c-360e-9ab4-ed8516bf8f39",
                                        "entry_id": "403365b5-8424-3f32-9ec1-5c477896ac35",
                                        "glosses": [
                                            "D’une manière inéluctable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "922de956-a5aa-4f1a-af8a-797ab25c0489",
                                                "sense_id": "7292fb5b-3c3c-360e-9ab4-ed8516bf8f39",
                                                "text": "La plupart des économistes modernes ont fait, des influences qui règlent le salaire, des lois naturelles qui s'imposent inéluctablement comme celles qui gouvernent les phénomènes physiques."
                                            },
                                            {
                                                "example_id": "57658696-a324-4edb-8c0c-e5c8be793206",
                                                "sense_id": "7292fb5b-3c3c-360e-9ab4-ed8516bf8f39",
                                                "text": "Les gens fabriquent eux-mêmes le mécanisme de leur malheur, ils remontent la clef à bloc et ensuite le mécanisme continue de tourner, inéluctablement, avec quelques ratés, quelques faiblesses lorsque la maladie s’en mêle, mais il continue de tourner jusqu’à la fin, jusqu’à la dernière seconde."
                                            },
                                            {
                                                "example_id": "73c0dcde-6a8c-481e-9fa9-2798a8563146",
                                                "sense_id": "7292fb5b-3c3c-360e-9ab4-ed8516bf8f39",
                                                "text": "Mais la vraie question est de savoir si la réduction de consommation peut rester stable dans le temps ou si, chez les patients alcoolo-dépendants, elle conduit inéluctablement à une réaugmentation de celle-ci."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
