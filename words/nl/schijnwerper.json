    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fbf199ed-186c-30e4-bff4-46b9c876cad1",
                    "sense_definition": "een sterke lamp voorzien van een lenzenstelsel dat een krachtige lichtbundel uitzendt",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "verlichting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er stonden twee <w>schijnwerpers</w> op hem gericht tijdens het optreden.",
                            "target_lang_translations": {
                                "en": "There were two <w>spotlights</w> aimed at him during the performance."
                            }
                        },
                        {
                            "text": "De felle <w>schijnwerper</w> verlichtte het hele voetbalveld in de avond.",
                            "target_lang_translations": {
                                "en": "The bright <w>floodlight</w> illuminated the entire football field in the evening."
                            }
                        }
                    ],
                    "synonyms": [
                        "spot",
                        "projector"
                    ],
                    "common_phrases": [
                        "felle schijnwerper",
                        "schijnwerper op het podium"
                    ],
                    "target_lang_definitions": {
                        "en": "A powerful lamp equipped with a lens system that emits a strong beam of light."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "spotlight",
                                "target_lang_sense_clarification": "a lamp projecting a narrow, intense beam of light"
                            },
                            {
                                "target_lang_word": "floodlight",
                                "target_lang_sense_clarification": "a large, powerful light used to illuminate outdoor areas"
                            },
                            {
                                "target_lang_word": "searchlight",
                                "target_lang_sense_clarification": "a powerful light that can be turned in any direction"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c8b0847a-260d-3c3e-b0b4-3a3e6578b1db",
                    "sense_definition": "een figuurlijke focus of aandacht van het publiek",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "aandacht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De jonge uitvinder werd plotseling in de <w>schijnwerpers</w> gezet door de media.",
                            "target_lang_translations": {
                                "en": "The young inventor was suddenly put in the <w>spotlight</w> by the media."
                            }
                        },
                        {
                            "text": "Zij geniet ervan om in de <w>schijnwerpers</w> te staan tijdens grote evenementen.",
                            "target_lang_translations": {
                                "en": "She enjoys being in the <w>limelight</w> during major events."
                            }
                        }
                    ],
                    "synonyms": [
                        "belangstelling",
                        "aandacht"
                    ],
                    "common_phrases": [
                        "in de schijnwerpers staan",
                        "in de schijnwerpers zetten"
                    ],
                    "target_lang_definitions": {
                        "en": "A figurative focus or public attention."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "limelight",
                                "target_lang_sense_clarification": "the focus of public attention"
                            },
                            {
                                "target_lang_word": "spotlight",
                                "target_lang_sense_clarification": "intense public attention or scrutiny"
                            }
                        ]
                    }
                }
            ]
        }
    ]
