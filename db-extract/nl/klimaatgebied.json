                        "tags": [],
                        "examples": [
                            {
                                "example_id": "caab6d29-1732-47d8-8195-af2a8829c8e5",
                                "sense_id": "39ae5dbc-2f5d-3138-92af-53f588efd66d",
                                "text": "Bomen van gelijke ouderdom in een zelfde klimaatgebied zullen een gelijk opvolgingspatroon van jaarringdikte vertonen."
                            }
                        ]
                    },
                    {
                        "sense_id": "0341d114-1215-3f58-9465-28bec173c9b7",
                        "entry_id": "6202fc1b-eefc-3441-bda9-123775a8c7e3",
                        "glosses": [
                            "het weer over meer jaren bekeken als terrein van wetenschap"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "791f113e-02e4-475f-8486-149dd2a32a63",
                                "sense_id": "0341d114-1215-3f58-9465-28bec173c9b7",
                                "text": "Aan publiciteit heeft de ozongat-problematiek geen gebrek. In kranten, tijdschriften en op de televisie wordt er met grote regelmaat aandacht aan besteed. Dat mag ook wel, want samen met het broeikaseffect is de aantasting van de ozonlaag de meest verontrustende lange-termijn ontwikkeling op klimaatgebied."
                            }
                        ]
                    },
                    {
                        "sense_id": "9256e14d-c910-3812-9e92-77f605c3e5aa",
                        "entry_id": "6202fc1b-eefc-3441-bda9-123775a8c7e3",
                        "glosses": [
                            "maatregelen om opwarming van de atmosfeer tegen te gaan"
                        ],
