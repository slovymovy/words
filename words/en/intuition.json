{
    "word_family": [
        "intuitive",
        "intuit",
        "intuitively"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "07c8134f-4295-3a44-ab12-b1460727b139",
                    "sense_definition": "The ability to understand or know something immediately without needing to think about it or use conscious reasoning.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "cognition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She relied on her <w>intuition</w> to make the right decision during the crisis.",
                            "target_lang_translations": {
                                "tr": "Kriz sırasında doğru kararı vermek için <w>sezgilerine</w> güvendi."
                            }
                        },
                        {
                            "text": "Trusting your <w>intuition</w> can often lead you to the correct answer in difficult situations.",
                            "target_lang_translations": {
                                "tr": "Zor durumlarda <w>sezgilerinize</w> güvenmek sizi çoğunlukla doğru cevaba ulaştırabilir."
                            }
                        }
                    ],
                    "synonyms": [
                        "instinct",
                        "hunch"
                    ],
                    "common_phrases": [
                        "follow your intuition",
                        "trust your intuition"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir şeyi bilinçli bir akıl yürütmeye veya düşünmeye ihtiyaç duymadan doğrudan anlama veya bilme yeteneği."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "sezgi",
                                "target_lang_sense_clarification": "içgüdüsel his veya anlama yetisi"
                            },
                            {
                                "target_lang_word": "sağduyu",
                                "target_lang_sense_clarification": "içsel his ve kavrayış"
                            },
                            {
                                "target_lang_word": "görü",
                                "target_lang_sense_clarification": "felsefi bağlamda dolaysız kavrama"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4c406773-d7dc-3416-86d3-5a157f136d3d",
                    "sense_definition": "A sudden, clear understanding or realization about a specific situation or problem.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "cognition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He had a sudden <w>intuition</w> that the project would fail if they did not change their strategy.",
                            "target_lang_translations": {
                                "tr": "Stratejilerini değiştirmezlerse projenin başarısız olacağına dair aniden <w>içine bir his doğdu</w>."
                            }
                        },
                        {
                            "text": "Her <w>intuition</w> about the hidden motive behind his offer proved to be entirely accurate.",
                            "target_lang_translations": {
                                "tr": "Teklifinin ardındaki gizli amaca dair <w>önsezisi</w> tamamen doğru çıktı."
                            }
                        }
                    ],
                    "synonyms": [
                        "insight",
                        "perception"
                    ],
                    "common_phrases": [
                        "sudden intuition"
                    ],
                    "target_lang_definitions": {
                        "tr": "Belirli bir durum veya sorun hakkında aniden beliren açık bir anlayış ya da farkındalık."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "önsezi",
                                "target_lang_sense_clarification": "içe doğan his veya hissetme"
                            },
                            {
                                "target_lang_word": "içe doğma",
                                "target_lang_sense_clarification": "aniden gelen his veya anlayış"
                            },
                            {
                                "target_lang_word": "sezgi",
                                "target_lang_sense_clarification": "belirli bir durum hakkında duyulan his"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}