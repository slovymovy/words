                        "examples": [
                            {
                                "example_id": "001dbc2d-796a-45ed-bde9-51bdedb6a514",
                                "sense_id": "a463b48e-d685-3db9-81ff-3cd4c134122c",
                                "text": "„Aus seinem Schulterholster zog Raeseng ein nagelneues Henckels-Messer, das er unterwegs im Kaufhaus gekauft hatte.“"
                            },
                            {
                                "example_id": "2a0a3f42-1ce7-4037-847e-aec27a7e4b4b",
                                "sense_id": "a463b48e-d685-3db9-81ff-3cd4c134122c",
                                "text": "„Aus seinem Zimmer holte er das Schulterholster, das an einem Haken an der Tür hing, und zog es sich über.“"
                            },
                            {
                                "example_id": "9c7ab40d-b929-4c86-8bdf-d4d8fa609af9",
                                "sense_id": "a463b48e-d685-3db9-81ff-3cd4c134122c",
                                "text": "„Forbes suchte in der Innentasche seines Jacketts nach einem Taschentuch und Smith sah den großen 10-mm-Browning in seinem Schulterholster.“"
                            }
                        ],
