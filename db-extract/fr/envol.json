                "senses": [
                    {
                        "sense_id": "a92710fe-6b50-3136-9631-e8b371048706",
                        "entry_id": "ae25cf0f-fb54-38ca-9ed5-1d68909e4ee8",
                        "glosses": [
                            "Action de s’envoler."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8797811f-1bb6-4f05-ae04-d3f1828b9b47",
                                "sense_id": "a92710fe-6b50-3136-9631-e8b371048706",
                                "text": "« La vie est partout », elle jaillit même en direct dans un éclosoir où l'on peut voir la métamorphose de la chrysalide en papillon et le premier envol de celui-ci."
                            }
                        ]
                    },
                    {
                        "sense_id": "925ad5ef-1856-3a64-a6ed-f28391b2d162",
                        "entry_id": "ae25cf0f-fb54-38ca-9ed5-1d68909e4ee8",
                        "glosses": [
                            "Montée, élévation d’une construction."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea50aac4-8945-4bad-9fe1-eebd44bdc90f",
                                "sense_id": "925ad5ef-1856-3a64-a6ed-f28391b2d162",
                                "text": "Renata entraîna le garçon vers une table que l’envol de l’escalier dissimulait aux trois quarts."
                            }
                        ]
                    },
                    {
                        "sense_id": "f9894051-0ac1-3ecb-9f18-13dc42b26a92",
                        "entry_id": "ae25cf0f-fb54-38ca-9ed5-1d68909e4ee8",
                        "glosses": [
                            "Fait, pour un son, une mélodie, de s'élever dans l'air."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2dad913c-ff11-46c7-bcd2-589941eab9e3",
                                "sense_id": "f9894051-0ac1-3ecb-9f18-13dc42b26a92",
                                "text": "Des envols de pistons, des gloussements d'ophicléides"
                            }
                        ]
                    }
