{
    "word_family": [
        "reeking"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3acc5afc-d390-3c20-bebb-589751a2c511",
                    "sense_definition": "To have or give off a strong, unpleasant smell.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "smell",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old gym clothes <w>reek</w> of sweat after a long workout.",
                            "target_lang_translations": {
                                "cs": "Staré oblečení z tělocvičny po dlouhém tréninku <w>smrdí</w> potem.",
                                "zh": "长时间锻炼后，旧健身服<w>散发着</w>汗臭味。",
                                "es": "La ropa vieja de gimnasio <w>apesta</w> a sudor después de un largo entrenamiento."
                            }
                        },
                        {
                            "text": "The garbage bins <w>reek</w> in the summer heat.",
                            "target_lang_translations": {
                                "cs": "Popelnice v letním horku <w>páchne</w>.",
                                "zh": "夏日炎炎，垃圾桶<w>发着</w>恶臭。",
                                "es": "Los cubos de basura <w>hieden</w> con el calor del verano."
                            }
                        }
                    ],
                    "synonyms": [
                        "stink",
                        "pong",
                        "niff"
                    ],
                    "antonyms": [
                        "deodorize"
                    ],
                    "common_phrases": [
                        "reek of"
                    ],
                    "target_lang_definitions": {
                        "cs": "Vydávat silný, nepříjemný zápach.",
                        "zh": "散发出强烈、难闻的气味。",
                        "es": "Desprender un olor fuerte y desagradable."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "smrdět",
                                "target_lang_sense_clarification": "obecný výraz pro vydávání nepříjemného zápachu"
                            },
                            {
                                "target_lang_word": "páchnout",
                                "target_lang_sense_clarification": "formálnější nebo neutrálnější vyjádření zápachu"
                            },
                            {
                                "target_lang_word": "čpět",
                                "target_lang_sense_clarification": "knižní výraz pro velmi silný, pronikavý zápach"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "发臭",
                                "target_lang_sense_clarification": "指散发出难闻的气味"
                            },
                            {
                                "target_lang_word": "散发恶臭",
                                "target_lang_sense_clarification": "指散发出非常强烈的难闻气味"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "apestar",
                                "target_lang_sense_clarification": "vía directa para expresar que algo desprende un mal olor"
                            },
                            {
                                "target_lang_word": "oler mal",
                                "target_lang_sense_clarification": "expresión neutra y común para indicar mal olor"
                            },
                            {
                                "target_lang_word": "heder",
                                "target_lang_sense_clarification": "término más formal o literario para un olor repulsivo"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "78769e04-ba61-34f8-92f5-b19a35bc4b49",
                    "sense_definition": "To be evidently associated with something unpleasant.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "smell",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden change in policy <w>reeks</w> of corruption.",
                            "target_lang_translations": {
                                "cs": "Ta náhlá změna politiky <w>smrdí</w> korupcí.",
                                "zh": "政策的突然改变<w>透着</w>腐败的气息。",
                                "es": "El cambio repentino en la política <w>huele</w> a corrupción."
                            }
                        },
                        {
                            "text": "His excuse <w>reeks</w> of dishonesty.",
                            "target_lang_translations": {
                                "cs": "Jeho výmluva <w>zavání</w> nepoctivostí.",
                                "zh": "他的借口<w>带有</w>不诚实的嫌疑。",
                                "es": "Su excusa <w>apesta</w> a deshonestidad."
                            }
                        }
                    ],
                    "common_phrases": [
                        "reeks of"
                    ],
                    "target_lang_definitions": {
                        "cs": "Působit dojmem, že je něco nekalé nebo podezřelé.",
                        "zh": "明显带有某种令人不快或可疑的特征。",
                        "es": "Dar la impresión de ser algo deshonesto, corrupto o sospechoso."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "smrdět",
                                "target_lang_sense_clarification": "hovorově o něčem podezřelém (např. smrdí to korupcí)"
                            },
                            {
                                "target_lang_word": "zavánět",
                                "target_lang_sense_clarification": "přenesený význam pro něco, co vyvolává podezření"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "带有……的嫌疑",
                                "target_lang_sense_clarification": "指某事看起来很可疑"
                            },
                            {
                                "target_lang_word": "透着……的气息",
                                "target_lang_sense_clarification": "指某事明显表现出某种负面特质"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "oler mal",
                                "target_lang_sense_clarification": "usado figuradamente para sospechar de algo malo"
                            },
                            {
                                "target_lang_word": "apestar",
                                "target_lang_sense_clarification": "usado coloquialmente para indicar que algo está corrompido"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0fb35609-a387-3ec5-91a9-de38439c4684",
                    "sense_definition": "To emit smoke or vapour; to steam.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "smoke",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hot springs <w>reek</w> with thick white steam in the cold morning air.",
                            "target_lang_translations": {
                                "cs": "Horké prameny v chladném ranním vzduchu <w>vydávají</w> hustou bílou páru.",
                                "zh": "寒冷的清晨，温泉<w>冒着</w>浓浓的白气。",
                                "es": "Las aguas termales <w>emanan</w> un espeso vapor blanco en el aire frío de la mañana."
                            }
                        },
                        {
                            "text": "The damp ground began to <w>reek</w> as the sun warmed the earth.",
                            "target_lang_translations": {
                                "cs": "Vlhká půda se začala <w>pařit</w>, jak ji slunce zahřívalo.",
                                "zh": "太阳温暖大地时，潮湿的地面开始<w>冒出</w>水汽。",
                                "es": "El suelo húmedo comenzó a <w>desprender vaho</w> a medida que el sol calentaba la tierra."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in a literary or historical context."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Vydávat kouř, páru nebo výpary.",
                        "zh": "冒出烟雾或蒸汽。",
                        "es": "Emitir humo, vapor o emanaciones."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "kouřit se",
                                "target_lang_sense_clarification": "vydávat kouř nebo páru"
                            },
                            {
                                "target_lang_word": "pařit se",
                                "target_lang_sense_clarification": "vydávat horkou páru"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "冒烟",
                                "target_lang_sense_clarification": "指散发出烟雾"
                            },
                            {
                                "target_lang_word": "冒蒸汽",
                                "target_lang_sense_clarification": "指散发出水蒸气"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "emanar",
                                "target_lang_sense_clarification": "desprender vapores o sustancias volátiles"
                            },
                            {
                                "target_lang_word": "desprender vapor",
                                "target_lang_sense_clarification": "acción física de emitir vapor"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b4853c2a-f5df-33a9-a05c-bd133755dd1d",
                    "sense_definition": "A strong unpleasant smell.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "smell",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There was a terrible <w>reek</w> coming from the basement.",
                            "target_lang_translations": {
                                "cs": "Ze sklepa vycházel strašný <w>smrad</w>.",
                                "zh": "地下室里传出一股可怕的<w>恶臭</w>。",
                                "es": "Había un <w>hedor</w> terrible que venía del sótano."
                            }
                        },
                        {
                            "text": "The <w>reek</w> of rotten fish filled the entire room.",
                            "target_lang_translations": {
                                "cs": "Celou místnost naplnil <w>zápach</w> zkažených ryb.",
                                "zh": "腐鱼的<w>臭气</w>弥漫了整个房间。",
                                "es": "La <w>peste</w> a pescado podrido llenó toda la habitación."
                            }
                        }
                    ],
                    "synonyms": [
                        "stink",
                        "pong"
                    ],
                    "target_lang_definitions": {
                        "cs": "Silný, nepříjemný pach.",
                        "zh": "一种强烈且难闻的气味。",
                        "es": "Un olor fuerte y desagradable."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "smrad",
                                "target_lang_sense_clarification": "běžné označení pro nepříjemný zápach"
                            },
                            {
                                "target_lang_word": "zápach",
                                "target_lang_sense_clarification": "neutrální označení pro nepříjemný pach"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "恶臭",
                                "target_lang_sense_clarification": "指非常难闻的气味"
                            },
                            {
                                "target_lang_word": "臭气",
                                "target_lang_sense_clarification": "指难闻的气味"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "hedor",
                                "target_lang_sense_clarification": "olor muy penetrante y repulsivo"
                            },
                            {
                                "target_lang_word": "peste",
                                "target_lang_sense_clarification": "olor desagradable intenso"
                            },
                            {
                                "target_lang_word": "tufo",
                                "target_lang_sense_clarification": "olor fuerte, a menudo referido a emanaciones o gases"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4496148a-d5e2-34f1-bd4e-d8cf40528fec",
                    "sense_definition": "Vapour, steam, smoke, or fume.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "smoke",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The thick <w>reek</w> from the factory chimneys obscured the view.",
                            "target_lang_translations": {
                                "cs": "Hustý <w>dým</w> z továrních komínů zakrýval výhled.",
                                "zh": "工厂烟囱冒出的浓重<w>烟雾</w>遮挡了视线。",
                                "es": "El espeso <w>humo</w> de las chimeneas de la fábrica oscurecía la vista."
                            }
                        },
                        {
                            "text": "A blue <w>reek</w> rose from the campfire into the night sky.",
                            "target_lang_translations": {
                                "cs": "Modravý <w>kouř</w> stoupal od táboráku k noční obloze.",
                                "zh": "蓝色的<w>烟雾</w>从篝火中升起，飘向夜空。",
                                "es": "Una <w>emanación</w> azulada subía de la hoguera hacia el cielo nocturno."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in a literary or historical context."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Výpary, kouř nebo dým.",
                        "zh": "烟雾、蒸汽或挥发物。",
                        "es": "Vapor, humo o emanaciones gaseosas."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "výpary",
                                "target_lang_sense_clarification": "plynné látky unikající z něčeho"
                            },
                            {
                                "target_lang_word": "dým",
                                "target_lang_sense_clarification": "hustý kouř"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "烟雾",
                                "target_lang_sense_clarification": "指空气中弥漫的烟或雾气"
                            },
                            {
                                "target_lang_word": "蒸汽",
                                "target_lang_sense_clarification": "指液体受热后产生的气体"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "vaho",
                                "target_lang_sense_clarification": "vapor que despide un cuerpo o superficie"
                            },
                            {
                                "target_lang_word": "emanación",
                                "target_lang_sense_clarification": "sustancia gaseosa que se desprende de algo"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}