                        "examples": [
                            {
                                "example_id": "20270879-4238-400f-a147-64e5f55bc23d",
                                "sense_id": "a606032f-de5e-36cf-8207-309482c0d398",
                                "text": "\"We gaan bij de restauratie niet de geschiedenis herschrijven.\" Daarna wordt beslist of de koets weer gebruikt gaat worden. Volgens koningshuis-verslaggever Kysia Hekster is het niet gek dat de koning zich er bij deze gelegenheid nog niet over uit laat. \"Normaal wordt zoiets via de Rijksvoorlichtingsdienst bekendgemaakt. Maar het zou goed kunnen dat er na de restauratie voor gekozen wordt om de koets in een museum te zetten.\""
                            },
                            {
                                "example_id": "a09d1c11-705e-4a9a-9805-866994fe91f5",
                                "sense_id": "a606032f-de5e-36cf-8207-309482c0d398",
                                "text": "Nu meldt de Rijksvoorlichtingsdienst dat hij op 9 juli terugtreedt. Volgens de RVD heeft de VVD een goede kandidaat gevonden om hem op te volgen en zal die naam op korte termijn bekend worden gemaakt."
                            }
                        ]
