                                        "entry_id": "890ef874-58ab-3914-9978-0b1d6e1ca5f3",
                                        "glosses": [
                                            "One who or that which divides or separates."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f318c556-e751-4d48-b202-9683b09e05b1",
                                                "sense_id": "2bf25393-0380-3a28-8c65-c7dc765886be",
                                                "text": "I was greatly his inferior, but love is a quick divider of shares: he that gathers much has nothing over, and he that gathers little has no lack."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc555ba2-f715-3e31-82e5-a0585d64dcc3",
                                        "entry_id": "890ef874-58ab-3914-9978-0b1d6e1ca5f3",
                                        "glosses": [
                                            "One who or that which divides or separates.",
                                            "A physical object for dividing up a space."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "efea6f46-a050-4cea-b1be-4f6b5fb199f0",
                                                "sense_id": "cc555ba2-f715-3e31-82e5-a0585d64dcc3",
                                                "text": "It is perfectly possible to separate one area of a room from another, or even to create an entirely new room, with a lightweight room divider that assembles with a minimum of fuss."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "394bb1f3-c099-3737-98d6-7ff3ece1e15c",
                                        "entry_id": "890ef874-58ab-3914-9978-0b1d6e1ca5f3",
