{
    "word_family": [
        "champagneless",
        "champagnery",
        "champagny"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f283d123-5ed5-391e-82ed-f304f3a9c12b",
                    "sense_definition": "A sparkling white wine produced in the Champagne region of France using specific traditional methods.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "sparkling wine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to open a bottle of <w>champagne</w> to celebrate our wedding anniversary.",
                            "target_lang_translations": {
                                "ru": "Мы решили открыть бутылку <w>шампанского</w>, чтобы отпраздновать годовщину свадьбы."
                            }
                        },
                        {
                            "text": "The waiter poured the vintage <w>champagne</w> into tall glass flutes for the guests.",
                            "target_lang_translations": {
                                "ru": "Официант разлил миллезимное <w>шампанское</w> в высокие стеклянные фужеры для гостей."
                            }
                        }
                    ],
                    "synonyms": [
                        "bubbly",
                        "champers",
                        "fizz"
                    ],
                    "common_phrases": [
                        "vintage champagne",
                        "bottle of champagne",
                        "sip champagne",
                        "glass of champagne"
                    ],
                    "target_lang_definitions": {
                        "ru": "Игристое белое вино, произведенное во французском регионе Шампань с использованием традиционных методов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шампанское",
                                "target_lang_sense_clarification": "напиток"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c22e55a2-83b4-3ee8-8e0d-dc670d44f346",
                    "sense_definition": "A single glass or serving of champagne.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sparkling wine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She had a <w>champagne</w> at the bar while waiting for her friends to arrive.",
                            "target_lang_translations": {
                                "ru": "Она выпила <w>бокал шампанского</w> в баре, ожидая прихода друзей."
                            }
                        },
                        {
                            "text": "Would you like another <w>champagne</w> before the dinner service begins?",
                            "target_lang_translations": {
                                "ru": "Хотите еще <w>шампанского</w> перед началом ужина?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "have a champagne",
                        "order a champagne"
                    ],
                    "target_lang_definitions": {
                        "ru": "Один бокал или порция шампанского."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бокал шампанского",
                                "target_lang_sense_clarification": "порция"
                            },
                            {
                                "target_lang_word": "шампанское",
                                "target_lang_sense_clarification": "в значении порции"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4baf3918-0af1-3480-836c-e05100cabcde",
                    "sense_definition": "Any sparkling white wine, regardless of its region of origin.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sparkling wine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many people use the word <w>champagne</w> to describe any wine with bubbles.",
                            "target_lang_translations": {
                                "ru": "Многие люди используют слово <w>шампанское</w> для описания любого вина с пузырьками."
                            }
                        },
                        {
                            "text": "The host served a local <w>champagne</w> that was actually produced in California.",
                            "target_lang_translations": {
                                "ru": "Хозяин подал местное <w>игристое</w>, которое на самом деле было произведено в Калифорнии."
                            }
                        }
                    ],
                    "synonyms": [
                        "bubbly",
                        "fizz"
                    ],
                    "common_phrases": [
                        "cheap champagne",
                        "sparkling champagne"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used loosely for any sparkling wine"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Любое игристое белое вино, независимо от региона его происхождения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "игристое вино",
                                "target_lang_sense_clarification": "общее название"
                            },
                            {
                                "target_lang_word": "шампанское",
                                "target_lang_sense_clarification": "разговорное обобщение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bafd8b3d-f938-3fa1-98f5-2add94ac6151",
                    "sense_definition": "A very pale brownish-gold color, resembling the appearance of the wine.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bride chose a dress in <w>champagne</w> rather than traditional bright white.",
                            "target_lang_translations": {
                                "ru": "Невеста выбрала платье цвета <w>шампань</w> вместо традиционного ярко-белого."
                            }
                        },
                        {
                            "text": "The walls were painted a soft <w>champagne</w> to make the room feel warmer.",
                            "target_lang_translations": {
                                "ru": "Стены были выкрашены в мягкий цвет <w>шампанского</w>, чтобы комната казалась уютнее."
                            }
                        }
                    ],
                    "common_phrases": [
                        "champagne colored",
                        "shade of champagne"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень бледный коричневато-золотистый цвет, напоминающий цвет вина."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "цвет шампанского",
                                "target_lang_sense_clarification": "оттенок"
                            },
                            {
                                "target_lang_word": "шампань",
                                "target_lang_sense_clarification": "название цвета"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c23fdf9e-4feb-350c-a5af-8606b647401f",
                    "sense_definition": "In heraldry, an ordinary occupying the base of a shield.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "heraldry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The coat of arms featured a golden lion standing upon a <w>champagne</w> gules.",
                            "target_lang_translations": {
                                "ru": "На гербе был изображен золотой лев, стоящий на червленой <w>оконечности</w>."
                            }
                        },
                        {
                            "text": "The artist carefully drew the <w>champagne</w> at the bottom of the shield.",
                            "target_lang_translations": {
                                "ru": "Художник тщательно прорисовал <w>оконечность</w> в нижней части щита."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in heraldry"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В геральдике — фигура, занимающая нижнюю часть щита (оконечность)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оконечность",
                                "target_lang_sense_clarification": "геральдический термин"
                            },
                            {
                                "target_lang_word": "подножие",
                                "target_lang_sense_clarification": "в геральдике"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "204210a6-a9ea-329e-818a-f50e132654e3",
                    "sense_definition": "Having a very pale brownish-gold color.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wore a <w>champagne</w> silk blouse that complemented her skin tone perfectly.",
                            "target_lang_translations": {
                                "ru": "На ней была шелковая блузка цвета <w>шампанского</w>, которая идеально подчеркивала тон ее кожи."
                            }
                        },
                        {
                            "text": "The interior of the luxury car was finished in <w>champagne</w> leather.",
                            "target_lang_translations": {
                                "ru": "Интерьер роскошного автомобиля был отделан кожей цвета <w>шампань</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "champagne blonde",
                        "champagne colored"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий очень бледный коричневато-золотистый цвет."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "цвета шампанского",
                                "target_lang_sense_clarification": "о цвете"
                            },
                            {
                                "target_lang_word": "шампань",
                                "target_lang_sense_clarification": "прилагательное"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "2e131111-3f7a-3216-9e4a-e60593aa6a3a",
                    "sense_definition": "A historical province and cultural region in northeastern France known for its sparkling wine.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "We spent our summer vacation touring the vineyards in <w>Champagne</w>.",
                            "target_lang_translations": {
                                "ru": "Летний отпуск мы провели, путешествуя по виноградникам <w>Шампани</w>."
                            }
                        },
                        {
                            "text": "The city of Reims is one of the most famous locations in <w>Champagne</w>.",
                            "target_lang_translations": {
                                "ru": "Город Реймс — одно из самых известных мест в <w>Шампани</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "region of Champagne"
                    ],
                    "target_lang_definitions": {
                        "ru": "Историческая провинция и культурный регион на северо-востоке Франции, известный своим игристым вином."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Шампань",
                                "target_lang_sense_clarification": "регион Франции"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "73536c3c-28af-377e-b029-7a8076726f50",
                    "sense_definition": "A surname of French origin.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The local library was named after the philanthropist Jean <w>Champagne</w>.",
                            "target_lang_translations": {
                                "ru": "Местная библиотека была названа в честь филантропа Жана <w>Шампаня</w>."
                            }
                        },
                        {
                            "text": "Mr. <w>Champagne</w> has been living in this neighborhood for over twenty years.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Шампань</w> живет в этом районе уже более двадцати лет."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия французского происхождения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Шампань",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "032cba99-c11f-3e78-a41c-360e532a2a15",
                    "sense_definition": "To drink champagne, especially in a celebratory or social manner.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "drinking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The socialites spent the entire evening <w>champagning</w> at the gala.",
                            "target_lang_translations": {
                                "ru": "Светские львицы весь вечер <w>пили шампанское</w> на гала-концерте."
                            }
                        },
                        {
                            "text": "They <w>champagned</w> until the early hours of the morning to toast the new year.",
                            "target_lang_translations": {
                                "ru": "Они <w>пили шампанское</w> до раннего утра, провозглашая тосты за новый год."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage as a verb"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Пить шампанское, особенно в праздничной или светской обстановке."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пить шампанское",
                                "target_lang_sense_clarification": "праздновать"
                            },
                            {
                                "target_lang_word": "угощаться шампанским",
                                "target_lang_sense_clarification": "на приеме"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a76f07e2-bd4e-321f-b744-8556903806fb",
                    "sense_definition": "To provide or treat someone with champagne.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "drinking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The host <w>champagned</w> his guests as soon as they walked through the door.",
                            "target_lang_translations": {
                                "ru": "Хозяин <w>угостил шампанским</w> своих гостей, как только они вошли в дверь."
                            }
                        },
                        {
                            "text": "It was a lavish party where the organizers <w>champagned</w> every attendee.",
                            "target_lang_translations": {
                                "ru": "Это была роскошная вечеринка, где организаторы <w>поили шампанским</w> каждого участника."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Предоставлять или угощать кого-либо шампанским."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "угощать шампанским",
                                "target_lang_sense_clarification": "о хозяине"
                            },
                            {
                                "target_lang_word": "поить шампанским",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}