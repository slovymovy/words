                "senses": [
                    {
                        "sense_id": "3b701542-75c9-397d-b1a2-a168c56a84cd",
                        "entry_id": "99d7288d-d68a-39c3-955d-845e55977309",
                        "glosses": [
                            "weibliche Person, die einen Hund zur Haustierhaltung besitzt, die sich einen Hund hält"
                        ],
                        "tags": [
                            "Österr."
                        ],
                        "examples": [
                            {
                                "example_id": "ffdf9432-85af-4ea1-b122-dd9fdacc317f",
                                "sense_id": "3b701542-75c9-397d-b1a2-a168c56a84cd",
                                "text": "„Uneinsichtige Herrln und Frauerln müssen 21 Euro fürs leinenlose Gassigehen bezahlen, acht Euro kostet das Liegenlassen von Trümmerln.“"
                            },
                            {
                                "example_id": "a7b81ccd-392d-43cb-8f96-148764c3b2ac",
                                "sense_id": "3b701542-75c9-397d-b1a2-a168c56a84cd",
                                "text": "„Und so mancher der kranken Gefährten wurde vom Frauerl oder vom Herrl angesteckt, denn viele Viren und Bakterien kennen keine Grenzen zwischen Mensch und Tier, sie springen von einem auf den anderen über.“"
                            },
                            {
                                "example_id": "81b16ced-235a-4ecb-9e0a-e922128c0e10",
                                "sense_id": "3b701542-75c9-397d-b1a2-a168c56a84cd",
                                "text": "„Es gibt auch eigene Designer-Betten für vierbeinige Gäste. Egal ob Zwergpintscher oder Dogge, jeder Hund soll laut Auskunft des Zagreber Tourismusbüros darin den Schlaf des Gerechten finden – sofern er nicht doch lieber im Bett seines Herrls oder Frauerls nächtigt, weil er sich nur dort pudelwohl fühlt.“"
                            },
                            {
                                "example_id": "032286be-eb81-4a14-9da5-6d77572bca2e",
                                "sense_id": "3b701542-75c9-397d-b1a2-a168c56a84cd",
                                "text": "„Ohne auf den Verkehr zu achten, lief das Frauerl dem Hund nach und wurde vom Pkw erfasst und niedergestoßen.“"
                            },
                            {
                                "example_id": "cbf42c6a-07dd-4e6e-ab54-665878c8fa15",
                                "sense_id": "3b701542-75c9-397d-b1a2-a168c56a84cd",
                                "text": "„‚Hunde erlaubt‘ heißt es ausdrücklich am Zeller See. Überall, wo sich ein freies Uferplätzchen findet, dürfen Hund und Frauerl oder Herrl auch gemeinsam schwimmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
