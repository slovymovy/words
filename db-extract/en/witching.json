                            {
                                "example_id": "dde7da0c-740c-4c2c-8036-978d1c7893c9",
                                "sense_id": "df982f5d-d755-3c0e-acc7-2aad6dbd3f6e",
                                "text": "'Tis the witching time of night, / Orbed is the moon and bright, / And the Stars they glisten, glisten, / Seeming with bright eyes to listen."
                            }
                        ]
                    },
                    {
