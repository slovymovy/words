    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0dd7da84-b6e7-3006-a353-812217fd673c",
                    "sense_definition": "Serving to make something stable or firm.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "stabilizing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He offered a <w>steadying</w> hand to help her across the slippery rocks.",
                            "target_lang_translations": {
                                "ru": "Он протянул ей <w>укрепляющую</w> руку, чтобы помочь перейти через скользкие камни."
                            }
                        },
                        {
                            "text": "The coach provided a <w>steadying</w> influence on the young team during the final minutes.",
                            "target_lang_translations": {
                                "ru": "Тренер оказал <w>успокаивающее</w> влияние на молодую команду в последние минуты игры."
                            }
                        }
                    ],
                    "synonyms": [
                        "stabilizing",
                        "calming",
                        "reassuring"
                    ],
                    "antonyms": [
                        "destabilizing"
                    ],
                    "common_phrases": [
                        "steadying influence",
                        "steadying hand"
                    ],
                    "target_lang_definitions": {
                        "ru": "Служащий для придания чему-либо устойчивости или твердости."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "укрепляющий",
                                "target_lang_sense_clarification": "придающий устойчивость физическому объекту"
                            },
                            {
                                "target_lang_word": "успокаивающий",
                                "target_lang_sense_clarification": "оказывающий стабилизирующее влияние на человека или ситуацию"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4743fcf7-7313-3dc6-95d9-c0061b247c72",
                    "sense_definition": "Present participle and gerund of <w>steady</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "stabilizing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She spent the morning <w>steadying</w> the ladder before climbing up to paint.",
                            "target_lang_translations": {
                                "ru": "Она провела утро, <w>укрепляя</w> лестницу, прежде чем залезть наверх, чтобы красить."
                            }
                        },
                        {
                            "text": "He took a deep breath, <w>steadying</w> his nerves before the big presentation.",
                            "target_lang_translations": {
                                "ru": "Он глубоко вздохнул, <w>успокаивая</w> свои нервы перед важной презентацией."
                            }
                        }
                    ],
                    "synonyms": [
                        "stabilizing",
                        "balancing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс придания устойчивости или равновесия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "укрепление",
                                "target_lang_sense_clarification": "процесс фиксации чего-либо"
                            },
                            {
                                "target_lang_word": "успокоение",
                                "target_lang_sense_clarification": "процесс приведения нервов или эмоций в порядок"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "55597f24-a264-351c-8dba-8f0beae2cce9",
                    "sense_definition": "The act or process of making something stable.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "stabilizing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>steadying</w> of the ship was necessary before the cargo could be unloaded.",
                            "target_lang_translations": {
                                "ru": "<w>Стабилизация</w> судна была необходима перед тем, как можно было начать разгрузку."
                            }
                        },
                        {
                            "text": "Careful <w>steadying</w> of the camera is required for a clear long-exposure shot.",
                            "target_lang_translations": {
                                "ru": "Для четкого снимка с длинной выдержкой требуется тщательная <w>фиксация</w> камеры."
                            }
                        }
                    ],
                    "synonyms": [
                        "stabilization"
                    ],
                    "target_lang_definitions": {
