                        "entry_id": "02a76d0f-8b54-32eb-9a9d-998a63b94242",
                        "glosses": [
                            "To bring into commerce from an earlier condition (such as idea alone, experimental prototypes alone, or one-off custom builds only)."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "42ce5c65-2ada-4172-b7b5-cfae622162bd",
                                "sense_id": "97510ae4-a873-37a8-968b-2474fd614196",
                                "text": "Near-synonym: productize"
                            },
                            {
                                "example_id": "19982f0d-2617-4195-a3a7-1af7328ae519",
                                "sense_id": "97510ae4-a873-37a8-968b-2474fd614196",
                                "text": "the work required not only to invent a device but also to commercialize it"
                            }
                        ]
                    },
                    {
                        "sense_id": "e4eefa47-4951-3ffb-8f50-635f3c7409bf",
                        "entry_id": "02a76d0f-8b54-32eb-9a9d-998a63b94242",
                        "glosses": [
                            "To apply business methodology to something in order to profit (such as introducing salability to a resource that comes from, or rightfully belongs to, the commons)."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "87fd868d-9fcf-432b-93b8-e6596bd3d867",
                                "sense_id": "e4eefa47-4951-3ffb-8f50-635f3c7409bf",
                                "text": "finding the right balance in paying for water infrastructure (treatment plants and pipe networks) but not commercializing water to the point of excluding low-income people from adequate access to a basic necessity"
                            }
                        ]
                    },
                    {
                        "sense_id": "e4246394-42da-3ea1-8dce-cb6f745e0823",
                        "entry_id": "02a76d0f-8b54-32eb-9a9d-998a63b94242",
                        "glosses": [
                            "To exploit something for maximum financial gain, sometimes by sacrificing quality."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "f048e888-fd82-47ce-a155-7bfe9785aa32",
                                "sense_id": "e4246394-42da-3ea1-8dce-cb6f745e0823",
                                "text": "a market district formerly served mainly by artisans but increasingly commercialized for mass tourism"
                            }
                        ]
                    }
