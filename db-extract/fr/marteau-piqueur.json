        "fr-extract.jsonl": [
            {
                "entry_id": "86601c76-efbb-30f9-810d-6d1a4e87f32d",
                "word": "marteau-piqueur",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3a3ac178-28cf-41a3-84a5-7aae46a96e2d",
                        "entry_id": "86601c76-efbb-30f9-810d-6d1a4e87f32d",
                        "tags": [
                            "plural"
                        ],
                        "form": "marteaux-piqueurs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "604a2aaf-9dbe-3c21-bb8b-ac69c2f63a75",
                        "entry_id": "86601c76-efbb-30f9-810d-6d1a4e87f32d",
                        "glosses": [
                            "Outil mécanisé permettant de creuser des trous dans la chaussée en la martelant avec un pic."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71be13ad-29b4-4143-8bc9-0b129299f4b1",
                                "sense_id": "604a2aaf-9dbe-3c21-bb8b-ac69c2f63a75",
                                "text": "Dans le silence, notre attention fut brusquement fixée par des trépidations lointaines qui allaient s’amplifiant sous les voûtes. On eût dit d’un marteau-piqueur manié par un ataxique."
                            },
                            {
                                "example_id": "1b6beba5-4b42-4144-b191-1ec8f2bf7dfa",
                                "sense_id": "604a2aaf-9dbe-3c21-bb8b-ac69c2f63a75",
                                "text": "Il se voit le buste courbé sur le marteau-piqueur, les mains serrant la poignée de toutes leurs forces pour maîtriser cette énorme masse de vibrations et de secousses."
                            },
                            {
                                "example_id": "ff1ffb7a-3fbc-4c70-8b22-b3472bf17259",
                                "sense_id": "604a2aaf-9dbe-3c21-bb8b-ac69c2f63a75",
                                "text": "Pendant six ans, il creusa au marteau-piqueur trois cents puits dans les campagnes du Rajasthan."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c779abf3-ca1b-4d36-9424-d86ff2d4493f",
                        "source_entry_id": "86601c76-efbb-30f9-810d-6d1a4e87f32d",
                        "source_sense_id": "604a2aaf-9dbe-3c21-bb8b-ac69c2f63a75",
                        "target_lang_word": "Drucklufthammer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "dac248cc-ab84-4180-ab40-e762ea860dda",
                        "source_entry_id": "86601c76-efbb-30f9-810d-6d1a4e87f32d",
                        "source_sense_id": "604a2aaf-9dbe-3c21-bb8b-ac69c2f63a75",
                        "target_lang_word": "Presslufthammer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Presslufthammer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "520ccd3a-fb2a-30a5-8d95-0cda9cf47ae3",
                                        "entry_id": "8e5cc19b-ddd0-30a7-bbe7-cdfeab9baad8",
                                        "glosses": [
                                            "für Drucklufthammer, Gerät, bei dem über Druckluft ein Meißel betrieben wird und das häufig im Straßenbau eingesetzt wird"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d26b8f07-540e-4e09-9d48-db309f064e3e",
                                                "sense_id": "520ccd3a-fb2a-30a5-8d95-0cda9cf47ae3",
                                                "text": "Wenn die Presslufthämmer schweigen, ist Mittagspause auf der Baustelle."
                                            },
                                            {
                                                "example_id": "d4ffe7c2-1254-4310-a1b3-55949a74fbb4",
                                                "sense_id": "520ccd3a-fb2a-30a5-8d95-0cda9cf47ae3",
                                                "text": "„Mit einem Presslufthammer musste er als Himmlers Sklave zusammen mit seinen Schicksalsgenossen kilometerlange Stollen in den Berg treiben und ausbauen, unter unmenschlichsten Bedingungen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d1d59acb-25c6-44e2-95a3-3bb766ba554b",
                        "source_entry_id": "86601c76-efbb-30f9-810d-6d1a4e87f32d",
                        "source_sense_id": "604a2aaf-9dbe-3c21-bb8b-ac69c2f63a75",
                        "target_lang_word": "jackhammer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jackhammer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ae9cb58b-d07b-3fea-b30b-d85a2819ee75",
                                        "entry_id": "a1475540-6cc1-3acb-9228-815b40e0cb41",
                                        "glosses": [
                                            "A portable percussive power tool that combines a hammer and chisel used to drill or break hard matter, for instance rock or concrete."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3ecd0b89-2196-3fbc-b596-db8283c11a4e",
                                        "entry_id": "a1475540-6cc1-3acb-9228-815b40e0cb41",
                                        "glosses": [
                                            "Something that is very strong but also very rigid."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "766e432e-b730-4892-a3cc-63a97efdacf2",
                                                "sense_id": "3ecd0b89-2196-3fbc-b596-db8283c11a4e",
                                                "text": "A new skiercross pro tour is on the docket, as well as freeskiing. Just like racing, both require strong but supple legs rather than jackhammer quads."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "jackhammer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "310a741b-f633-3587-b342-6de87cb8c876",
                                        "entry_id": "9c6683a1-1b6e-3dcf-916b-10bf86d91885",
                                        "glosses": [
                                            "To use a jackhammer."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aadb0d16-092b-4ccc-8f32-14f3c43e6b64",
                                                "sense_id": "310a741b-f633-3587-b342-6de87cb8c876",
                                                "text": "Early the next day a crew came to fix the street. Vernon was out there at once, watching them jackhammer and haul the asphalt […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43ba0afc-b300-3af7-8002-ec798d911648",
                                        "entry_id": "9c6683a1-1b6e-3dcf-916b-10bf86d91885",
                                        "glosses": [
                                            "To break (something) using a jackhammer."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0e8590e-3576-4907-95d1-699aa14d7f7a",
                                                "sense_id": "43ba0afc-b300-3af7-8002-ec798d911648",
                                                "text": "The foundations for the barrier had been jackhammered away; the piles of broken concrete were just left alongside the road."
                                            },
                                            {
                                                "example_id": "94b18a37-c0c6-48da-9103-df6648690bed",
                                                "sense_id": "43ba0afc-b300-3af7-8002-ec798d911648",
                                                "text": "In the morning, the street is being jackhammered up."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16f4eb82-81bc-3842-98f0-df2343d63fe1",
                                        "entry_id": "9c6683a1-1b6e-3dcf-916b-10bf86d91885",
                                        "glosses": [
                                            "To form (something) using a jackhammer."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b683542-850b-490e-b5d0-f5e0996576a0",
                                                "sense_id": "16f4eb82-81bc-3842-98f0-df2343d63fe1",
                                                "text": "Small ledges had been jackhammered at each end of the crater and timbers bolted into them, forming abutments of the bridge that was to come."
                                            },
                                            {
                                                "example_id": "92b5b12f-5913-4f1e-bd37-45b6367e5f8b",
                                                "sense_id": "16f4eb82-81bc-3842-98f0-df2343d63fe1",
                                                "text": "Richmond already spent tax money on an engineering department whose employees parked their trucks in the street, jackhammered holes in the pavement, and repaired storm sewers […]"
                                            },
                                            {
                                                "example_id": "3716bf14-2aec-45e0-97e1-186dd79ad4fd",
                                                "sense_id": "16f4eb82-81bc-3842-98f0-df2343d63fe1",
                                                "text": "He was standing at a work table he’d jackhammered from a boulder, placidly sculpting a rose on its work surface."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e34e7817-dc07-301f-bd46-d1efbcd39d7a",
                                        "entry_id": "9c6683a1-1b6e-3dcf-916b-10bf86d91885",
                                        "glosses": [
                                            "To move like a jackhammer."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1696778-e47b-4b29-9731-13ab1c14e11a",
                                                "sense_id": "e34e7817-dc07-301f-bd46-d1efbcd39d7a",
                                                "text": "[…] a bolt of lightning jackhammered across the sky, interrupting his dream."
                                            },
                                            {
                                                "example_id": "16a063e9-14a1-4856-86b8-6bebd87a327c",
                                                "sense_id": "e34e7817-dc07-301f-bd46-d1efbcd39d7a",
                                                "text": "When he jackhammered into her, she clutched the bedspread and braced herself for the onslaught."
                                            },
                                            {
                                                "example_id": "826002c9-fa41-40fa-8546-5d7a2695bcdf",
                                                "sense_id": "e34e7817-dc07-301f-bd46-d1efbcd39d7a",
                                                "text": "His left knee jackhammered under the desk, his right hand patted a steady bongo beat on the top."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f194f0c6-0e45-34de-8962-33e78336d5a4",
                                        "entry_id": "9c6683a1-1b6e-3dcf-916b-10bf86d91885",
                                        "glosses": [
                                            "To move like a jackhammer.",
                                            "To beat hard, to pound. (of the heart or pulse)"
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8848eed6-c45f-44c1-b5fc-6d9ef7371012",
                                                "sense_id": "f194f0c6-0e45-34de-8962-33e78336d5a4",
                                                "text": "[…] he lay rigid, his heart jackhammering, telling himself that there was nothing out there, nothing […]"
                                            },
                                            {
                                                "example_id": "b0684faf-bdd0-4982-a3a7-fc9e8f46494d",
                                                "sense_id": "f194f0c6-0e45-34de-8962-33e78336d5a4",
                                                "text": "The paranoia came on pretty damn strong for this early in the morning, his high blood pressure—160 over 90 at twenty-two—jackhammering in his wrists, his thoughts caterwauling beneath the moment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4cb58e1e-30ba-3949-9035-41d3ab79524c",
                                        "entry_id": "9c6683a1-1b6e-3dcf-916b-10bf86d91885",
                                        "glosses": [
                                            "To move (something) like a jackhammer."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cec4ebeb-1a3d-483d-9588-6bfee543a00c",
                                                "sense_id": "4cb58e1e-30ba-3949-9035-41d3ab79524c",
                                                "text": "He […] drew his knees toward his chest as far as the cramped space would allow, and jackhammered his feet into the forward wall of the trunk, which was formed by the backseat of the car."
                                            },
                                            {
                                                "example_id": "649374c8-11f0-4a7f-be61-3094cc5bdd26",
                                                "sense_id": "4cb58e1e-30ba-3949-9035-41d3ab79524c",
                                                "text": "Then, before the lumberjack had a chance to react, Dad grabbed him by the scruff of the neck and jackhammered his head into the bar."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3cd5b7b-ba55-3286-9907-48d9529909a1",
                                        "entry_id": "9c6683a1-1b6e-3dcf-916b-10bf86d91885",
                                        "glosses": [
                                            "To strike (something) repeatedly with force, to pound."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d1850c9-f7c0-47a8-97af-51af96d1651f",
                                                "sense_id": "a3cd5b7b-ba55-3286-9907-48d9529909a1",
                                                "text": "Guam-based B-52 bombers, newly modified to haul 60,000 lbs. of bombs each, jackhammered a Viet Cong radio and communications center 35 miles northeast of Saigon."
                                            },
                                            {
                                                "example_id": "4e942a97-fc99-42ba-9819-6831adf22179",
                                                "sense_id": "a3cd5b7b-ba55-3286-9907-48d9529909a1",
                                                "text": "He didn’t make love to her; he jackhammered her."
                                            },
                                            {
                                                "example_id": "7bbf9e7f-b617-4ed5-a57c-3e0a31c5a73a",
                                                "sense_id": "a3cd5b7b-ba55-3286-9907-48d9529909a1",
                                                "text": "[…] the thought jackhammered his heart and mind."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
