                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technische term in instrumentbouw"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "a wedge-shaped pin in a harpsichord used to pluck the strings"
                    },
                    "translations": {
                        "en": [
