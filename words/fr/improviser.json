                {
                    "sense_id": "8ef1c950-73cd-32e8-9f62-07d9fc0558e5",
                    "sense_definition": "Organiser, fabriquer ou accomplir quelque chose sur-le-champ sans préparation préalable.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Comme les magasins étaient fermés, nous avons dû <w>improviser</w> un repas avec les restes du réfrigérateur."
                        },
                        {
                            "text": "Face à cette situation inattendue, le directeur a dû <w>improviser</w> une solution d'urgence."
                        }
                    ],
                    "synonyms": [
                        "naviguer à vue"
                    ],
                    "common_phrases": [
                        "improviser un repas",
                        "improviser une solution"
                    ]
                },
                {
                    "sense_id": "b011e1fa-da17-367e-8295-8c4de196ef92",
                    "sense_definition": "Composer ou exécuter sur-le-champ et sans texte écrit une œuvre artistique ou un discours.",
