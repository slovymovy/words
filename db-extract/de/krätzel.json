                    {
                        "sense_id": "940b64cd-61b4-3daf-bf31-b3804e4921c7",
                        "entry_id": "82d8805a-5245-3c4e-b909-6e92878f4a20",
                        "glosses": [
                            "Werkzeug, das zur Bearbeitung und zum Zusammenkratzen von lockerem Haufwerk dient"
                        ],
                        "tags": [
                            "vor allem im",
                            "Bergbau"
                        ],
                        "examples": [
                            {
                                "example_id": "10a2a77a-f830-4e06-bd87-bf2fdcd9a8ab",
                                "sense_id": "940b64cd-61b4-3daf-bf31-b3804e4921c7",
                                "text": "„Das sehr aufhältliche Abziehen der Erze vom Herde mit dem Krätzel erfolgt nur noch selten, und dadurch, dass man jetzt möglichst grosse Stücke abhebt, werden die für die Entleerung der Herde nöthigen Betriebspausen ganz wesentlich abgekürzt.“"
                            }
                        ],
