                        ],
                        "form": "die Amtsgerichte"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "05ccfa84-52c7-32e8-843f-1712d851bfc9",
                        "entry_id": "28e7ac72-2ade-388b-a463-cd4a1509a33e",
                        "glosses": [
                            "ein Gericht der ordentlichen Gerichtsbarkeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fdf815f0-8315-4b49-8b1c-51bcab19a3dd",
                                "sense_id": "05ccfa84-52c7-32e8-843f-1712d851bfc9",
                                "text": "Das Amtsgericht wird vor allem in Verfahren des Zivil- und des Strafrechts tätig."
                            },
                            {
                                "example_id": "b00a542a-34e8-45e2-8cec-9f9570d5855f",
                                "sense_id": "05ccfa84-52c7-32e8-843f-1712d851bfc9",
                                "text": "„Sie waren gegen ein Uhr im Amtsgericht.“"
                            },
                            {
                                "example_id": "d7e94858-1364-459d-84dd-6d5a33a5bf04",
                                "sense_id": "05ccfa84-52c7-32e8-843f-1712d851bfc9",
                                "text": "„So sah es das Amtsgericht in Bonn angesichts eines Streitfalles im öffentlichen Nahverkehr.“"
                            },
                            {
                                "example_id": "3604ce53-f3e0-4175-8846-94f38de2c26e",
                                "sense_id": "05ccfa84-52c7-32e8-843f-1712d851bfc9",
                                "text": "„Als sie sich bei ihrem Ausbilder am Amtsgericht meldete, hat der sie gefragt, ob sie als Frau nicht was Besseres wüßte.“"
                            },
                            {
                                "example_id": "4ca0aaf8-8951-4bcb-a37b-a78a5df975fb",
                                "sense_id": "05ccfa84-52c7-32e8-843f-1712d851bfc9",
                                "text": "„Ebenfalls 1542 wurde vor dem Amtsgericht Zwickau ein ›Kettenprozess‹, wie die Rechtshistoriker sagen, gegen mehrere Angeklagte geführt, die sich gegenseitig belasteten, 1546 im Amt Glauchau eine Todesstrafe wegen Zauberei in die Ausweisung umgewandelt, 1549 wegen Zauberei mit Bilsensamen eine Verbrennung vollstreckt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8aa4ac63-9caa-4193-b7b7-ad3867acc201",
                        "source_entry_id": "28e7ac72-2ade-388b-a463-cd4a1509a33e",
                        "source_sense_id": "05ccfa84-52c7-32e8-843f-1712d851bfc9",
