                ],
                "senses": [
                    {
                        "sense_id": "de163772-17ab-3d06-9577-d0ec2a54b329",
                        "entry_id": "282ec9e1-bada-3b08-8120-851c00845e96",
                        "glosses": [
                            "將視頻上載到YouTube上"
                        ],
                        "tags": [
                            "neologism",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "d8634f1b-137d-4f73-8a4e-9ea4cc8c6b87",
                                "sense_id": "de163772-17ab-3d06-9577-d0ec2a54b329",
                                "text": "The revolution will not be televised. It will be YouTubed.",
                                "translation": "这场革命将不会被电视转播。（相反，）它将被上传到 YouTube 上。"
                            }
                        ]
                    },
                    {
                        "sense_id": "8f8a7bcf-b81e-3587-9376-73a503410aa8",
                        "entry_id": "282ec9e1-bada-3b08-8120-851c00845e96",
                        "glosses": [
                            "在YouTube上搜尋及觀看視頻"
                        ],
                        "tags": [
                            "neologism",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "a6cda82a-c6a5-4eb2-a557-f5708e80d84f",
                                "sense_id": "8f8a7bcf-b81e-3587-9376-73a503410aa8",
                                "text": "Inquiry elicited that he was a pop singer. I YouTubed him, revealing another ghastly microphone-gripping, anguished nasal wailer.",
                                "translation": "搜索结果显示，他是一名流行歌手。我上 YouTube 看了他（的一些视频），里面传出的是另一个令人毛骨悚然、感到恐怖至极的痛苦嚎叫。"
                            },
                            {
                                "example_id": "420de856-68c1-4147-9787-965e7c24d8b1",
                                "sense_id": "8f8a7bcf-b81e-3587-9376-73a503410aa8",
                                "text": "If you don't know me, YouTube me, because soon the whole world is going to know me.",
                                "translation": "如果你不认识我，那就上 YouTube 搜我，因为马上全世界都会知道我的名字。"
                            }
                        ]
                    }
                ],
