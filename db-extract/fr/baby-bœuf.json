                "senses": [
                    {
                        "sense_id": "4872bcfd-fe91-39f5-b26e-ad834c5d9618",
                        "entry_id": "0318e653-8b5b-3569-a8d6-62a0be3a85ba",
                        "glosses": [
                            "Taurillon d’embouche."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "55204482-68db-4a5a-a6cc-d9131131be5b",
                                "sense_id": "4872bcfd-fe91-39f5-b26e-ad834c5d9618",
                                "text": "Il s’agit d’un baby bœuf de race normande, d’un an, d’un poids de 510 kgs ayant donné un rendement de viande commerciale de 61 %. Les dégustateurs ont eu les plus grandes difficultés à distinguer la viande de bœuf de celle du baby bœuf."
                            },
                            {
                                "example_id": "3f7480f5-0fda-4dfa-8d28-cefe4fa5968f",
                                "sense_id": "4872bcfd-fe91-39f5-b26e-ad834c5d9618",
                                "text": "Si vous me parlez que ça se mange alors c’est sans doute l’histoire des baby-bœufs dont on a beaucoup parlé récemment, ces pauvres bêtes que l’on engraissait artificiellement rien que pour la boucherie."
                            },
                            {
                                "example_id": "03bc9cfd-6eda-4ac6-bab5-ed935aa7dd24",
                                "sense_id": "4872bcfd-fe91-39f5-b26e-ad834c5d9618",
                                "text": "La Prune aurait bien tenté le baby-bœuf et le veau en batterie. Tout de même ! Tout de même, il a une conscience lui Prunot, un cœur, une humanité."
                            },
                            {
                                "example_id": "fa2720e6-b14a-4723-97ab-71b2651ec843",
                                "sense_id": "4872bcfd-fe91-39f5-b26e-ad834c5d9618",
                                "text": "On eut beau vendre le fumier, multiplier les acquéreurs, on s'aperçut bien vite que le baby-bœuf ne rapportait guère plus que le veau. Ils grossissaient sur des monceaux de litières mais à l’heure de la vente les prix stagnaient."
                            }
                        ]
                    }
