                            {
                                "target_word": "берло́га",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "cc07c93a-e3d7-369a-9ae9-d7f9ec800361",
                                        "entry_id": "bf291b33-fd8f-3ba7-b9a4-32a16be20143",
                                        "glosses": [
                                            "логово медведя"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd8c3bd6-9753-4d63-94c1-f24f3e0d26a9",
                                                "sense_id": "cc07c93a-e3d7-369a-9ae9-d7f9ec800361",
                                                "text": "Местные охотники, русские и инородцы, бьют медведей по большей части случайно, встретившись в лесу, а ещё чаще в берлогах, находимых зимой во время соболеванья."
                                            },
                                            {
                                                "example_id": "59a9a93c-8aa2-41ee-9262-4089b183b879",
                                                "sense_id": "cc07c93a-e3d7-369a-9ae9-d7f9ec800361",
                                                "text": "Гималайский медведь зимой спит не в берлоге, а в дупле большого дерева."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e4a6ad5-7e04-3426-a93d-934bf8e730b6",
                                        "entry_id": "bf291b33-fd8f-3ba7-b9a4-32a16be20143",
                                        "glosses": [
                                            "перен., шутл. жилище"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bcc3dd85-b41a-44f4-9cb0-8b78b09109ed",
                                                "sense_id": "9e4a6ad5-7e04-3426-a93d-934bf8e730b6",
                                                "text": "Митрофан! Вылезай из берлоги… Принимай раненого героя…"
                                            },
                                            {
                                                "example_id": "b1b1d4a7-01ca-4518-ad84-ecbaff01f0e9",
                                                "sense_id": "9e4a6ad5-7e04-3426-a93d-934bf8e730b6",
                                                "text": "Сидит газетчик в своей берлоге и знай себе обманывает да обманывает."
                                            },
                                            {
                                                "example_id": "183a5dda-c4ff-4965-ab71-fd89e9d66b78",
                                                "sense_id": "9e4a6ad5-7e04-3426-a93d-934bf8e730b6",
                                                "text": "Завтра же, с первыми колоколами к заутрене, побежит он без оглядки, поджавши хвост, в свою берлогу."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
