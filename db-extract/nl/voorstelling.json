                "senses": [
                    {
                        "sense_id": "21eb9d32-eecd-3581-aaf7-d74b57866321",
                        "entry_id": "f4b6375e-2d79-3b20-bd86-6adc365f075e",
                        "glosses": [
                            "een uitvoering voor een publiek van toeschouwers"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "24a37a37-9357-37c8-ac7b-5d6fc44eda8f",
                        "entry_id": "f4b6375e-2d79-3b20-bd86-6adc365f075e",
                        "glosses": [
                            "een manier waarop men ergens een beeld van maakt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76ef1cf3-3a98-4264-b2bf-42411ad0faed",
                                "sense_id": "24a37a37-9357-37c8-ac7b-5d6fc44eda8f",
                                "text": "Het beeld van Zadkin is een voorstelling van de verschikking van het bombardement op Rotterdam."
                            },
                            {
                                "example_id": "0c691fba-c9da-41b0-99a6-686fa4cd89de",
                                "sense_id": "24a37a37-9357-37c8-ac7b-5d6fc44eda8f",
                                "text": "Het idee dat de werkkampen voor commerciële doelstelling worden omgebouwd en in eerste instantie geen onderwijzende functie zullen hebben, zou kunnen leiden tot 'pseudo-historische fictie' en 'een valse voorstelling van wat er echt gebeurd is'."
                            }
                        ]
                    },
                    {
                        "sense_id": "e6afe69a-b4d3-34c1-b0a6-c0b643ec2d56",
                        "entry_id": "f4b6375e-2d79-3b20-bd86-6adc365f075e",
                        "glosses": [
                            "een verzameling objecten, matrices of functies die ieder een element van een groep representeren"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0173aa87-c926-4dcb-9c89-305c793d8f67",
                        "source_entry_id": "f4b6375e-2d79-3b20-bd86-6adc365f075e",
                        "source_sense_id": "24a37a37-9357-37c8-ac7b-5d6fc44eda8f",
                        "source_sense_description": "een manier waarop men ergens een beeld van maakt",
                        "target_lang_word": "representation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "representation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9c36a627-18f1-3bdd-b642-b876da22b682",
                                        "entry_id": "f85ccc71-16f3-34ca-8766-70293e3419f7",
                                        "glosses": [
                                            "That which represents something else."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c69a90ef-a069-4b4c-929c-a87d66c794d1",
                                                "sense_id": "9c36a627-18f1-3bdd-b642-b876da22b682",
                                                "text": "The Venus of Willendorf was an early representation of the female body."
                                            },
                                            {
                                                "example_id": "57a8f888-12f4-45b6-97e1-efb45b7ad9fa",
                                                "sense_id": "9c36a627-18f1-3bdd-b642-b876da22b682",
                                                "text": "The second and third quarters of the shield are indecipherable on the stone but clearer in two other representations of the arms, a painted wooden funeral hatchment for Mary Davie[…]"
                                            },
                                            {
                                                "example_id": "c18e1efd-493d-4124-b361-cf8cad3596c9",
                                                "sense_id": "9c36a627-18f1-3bdd-b642-b876da22b682",
                                                "text": "Chinese censors have long targeted representations of Winnie the Pooh - created by British author A.A. Milne - over internet memes that compare the fictional bear to China's president."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3ab74cf-a6b9-37f6-9647-a14a7a7f3d3b",
                                        "entry_id": "f85ccc71-16f3-34ca-8766-70293e3419f7",
                                        "glosses": [
                                            "The act of representing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7fe2ef8-25a2-4bc0-adb4-82e6c023a48e",
                                                "sense_id": "f3ab74cf-a6b9-37f6-9647-a14a7a7f3d3b",
                                                "text": "We are no longer happy with your representation of our company at trade events."
                                            },
                                            {
                                                "example_id": "727d9416-b4f5-4af2-bee7-8a024651b8a4",
                                                "sense_id": "f3ab74cf-a6b9-37f6-9647-a14a7a7f3d3b",
                                                "text": "That's according to a report published in The Guardian on New Year's Eve in which several regional leaders, including Greater Manchester Mayor Andy Burnham and Liverpool City Region Mayor Steve Rotheram, were highly critical of the apparent lack of northern representation in the decision-making process."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b519251-c48d-320e-9e68-8de56c842767",
                                        "entry_id": "f85ccc71-16f3-34ca-8766-70293e3419f7",
                                        "glosses": [
                                            "The appearance(s) of a particular demographic group in a piece of media, particularly in regards to how such appearances are treated."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e2c09aa1-3a76-3f74-98da-4a54d92c6a6d",
                                        "entry_id": "f85ccc71-16f3-34ca-8766-70293e3419f7",
                                        "glosses": [
                                            "The lawyers and staff who argue on behalf of another in court."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f749630b-0e29-4e3a-8975-fb9946c3162e",
                                                "sense_id": "e2c09aa1-3a76-3f74-98da-4a54d92c6a6d",
                                                "text": "People who cannot afford representation are eligible for government assistance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72599b89-3a76-3088-a630-842edff46616",
                                        "entry_id": "f85ccc71-16f3-34ca-8766-70293e3419f7",
                                        "glosses": [
                                            "The ability to elect a representative to speak on one's behalf in government; the role of this representative in government."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a034eca-d3f4-4642-bfea-0788b3c75b54",
                                                "sense_id": "72599b89-3a76-3088-a630-842edff46616",
                                                "text": "The lack of representation in the British parliament was one of the main factors behind the American Revolution."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10510c04-b3b3-3738-91a6-36be4fda6293",
                                        "entry_id": "f85ccc71-16f3-34ca-8766-70293e3419f7",
                                        "glosses": [
                                            "An action of some algebraic structure (typically a group or algebra, particularly a Lie algebra) on a vector space, such that each element acts by a linear endomorphism."
