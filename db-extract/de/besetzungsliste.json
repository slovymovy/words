                "senses": [
                    {
                        "sense_id": "f16e8c3a-6fdf-3a43-97bb-b0c0d1fcfbc6",
                        "entry_id": "01ceea26-22af-3991-9952-57b933091764",
                        "glosses": [
                            "Liste, die die Namen der Darsteller und die ihre Rollen enthält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa682b19-58f2-4d63-a2ba-b560badb0da7",
                                "sense_id": "f16e8c3a-6fdf-3a43-97bb-b0c0d1fcfbc6",
                                "text": "„Nun gibt es also ein Remake mit einer durchaus illustren Besetzungsliste, auf der u. a. Michael Fassbender zu finden ist.“"
                            },
                            {
                                "example_id": "d59b29eb-26f7-4c09-a1ef-81b915ca0bfd",
                                "sense_id": "f16e8c3a-6fdf-3a43-97bb-b0c0d1fcfbc6",
                                "text": "„Unter den mehr als 200 Namen auf der Besetzungsliste finden sich prominente Neuzugänge wie: Laura Dern, Monica Bellucci, Jim Belushi, Jennifer Jason Leigh, Ashley Judd, Balthazar Getty, Chrysta Bell, Naomi Watts, Michael Cera, Tim Roth, Amanda Seyfried, Tom Sizemore und die Musiker Eddie Vedder und Trent Reznor.“"
                            },
                            {
                                "example_id": "ef5d5fe8-6ab4-432e-b170-602b5bc39a34",
                                "sense_id": "f16e8c3a-6fdf-3a43-97bb-b0c0d1fcfbc6",
                                "text": "„Nun steht Kahnwald erstmals auf der Besetzungsliste einer Münchner Inszenierung, auch wenn am späten Mittwochnachmittag noch nicht klar war, ob das Stück überhaupt wie geplant an diesem Donnerstag um 19.30 Uhr in der Kammer 2 Premiere haben wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
