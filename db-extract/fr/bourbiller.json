                "senses": [
                    {
                        "sense_id": "744d59c4-c72e-387f-8e6d-ee5f110f4d7e",
                        "entry_id": "ae15d618-a28e-3365-97c8-5394487ee604",
                        "glosses": [
                            "S’activer dans la boue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dbf0069d-6c95-464d-a34a-37c9cebfc21c",
                                "sense_id": "744d59c4-c72e-387f-8e6d-ee5f110f4d7e",
                                "text": "Qu’on la laissât donc bourbiller si là était son plaisir."
                            },
                            {
                                "example_id": "6b129582-4aac-4afa-b27f-5c22cc54d7ec",
                                "sense_id": "744d59c4-c72e-387f-8e6d-ee5f110f4d7e",
                                "text": "La mère d’Eduardo se lamentait de le voir revenir tout mouillé, les mollets couverts de sang, avec quatre ou cinq crustacés bourbillant dans son mouchoir."
                            }
                        ]
                    },
                    {
                        "sense_id": "b0f5c4b5-e21f-3767-af25-e2caa8045add",
                        "entry_id": "ae15d618-a28e-3365-97c8-5394487ee604",
                        "glosses": [
                            "Être rempli."
                        ],
                        "tags": [
                            "Régionalisme"
                        ],
                        "examples": [
                            {
                                "example_id": "70d0d868-f217-4451-8bbe-6c6d093eda20",
                                "sense_id": "b0f5c4b5-e21f-3767-af25-e2caa8045add",
                                "text": "Les grands fonds soucieux bourbillaient de plongeurs Que le masque futur cherchait comme il me cherche."
                            }
                        ]
                    }
