{
    "word_family": [
        "perjury",
        "perjurer",
        "perjurious"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "772728c1-db3e-372f-a2dc-783cbd6e27d8",
                    "sense_definition": "To knowingly make a false statement while under an oath, especially in a court of law.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "legal_falsehood",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The witness refused to answer because he did not want to <w>perjure</w> himself in court."
                        },
                        {
                            "text": "She was charged with a serious felony after she <w>perjured</w> herself before the grand jury."
                        }
                    ],
                    "synonyms": [
                        "forswear"
                    ],
                    "common_phrases": [
                        "perjure oneself"
                    ]
                },
                {
                    "sense_id": "924edc40-381a-3adb-8225-b7748ab8fdca",
                    "sense_definition": "To cause someone to break a vow or commit perjury; to corrupt.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "corrupt_oath",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Extreme poverty might <w>perjure</w> even the most dedicated and honest citizen."
                        },
                        {
                            "text": "No bribe could ever <w>perjure</w> the faithful guardian from his sacred duty."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "sense rarely used in modern contexts"
                        }
                    ]
                },
                {
                    "sense_id": "7b4c83c5-40c8-36a8-a9eb-a251be24805d",
                    "sense_definition": "To deceive someone by false oaths and promises.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "deceive_by_vow",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He broke his sacred promises and brutally <w>perjured</w> the woman who trusted him."
                        },
                        {
                            "text": "The poem tells of a deceptive knight who <w>perjured</w> his devoted bride."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "archaic transitive sense meaning to deceive by oath"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "803b5eec-8a71-3537-ba53-66e8d641d7b0",
                    "sense_definition": "A person guilty of perjury; a perjurer.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The criminal was publicly denounced as a vile <w>perjure</w> before the assembled crowd."
                        },
                        {
                            "text": "He was branded as a <w>perjure</w> and stripped of his official title."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical usage as a noun synonymous with perjurer"
                        }
                    ]
                }
            ]
        }
    ]
}