                    "semantic_group_id": "weigeren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De uitsmijter besloot de dronken man de <w>toegang</w> <w>te</w> <w>ontzeggen</w>.",
                            "target_lang_translations": {
                                "en": "The bouncer decided to <w>deny</w> the drunk man <w>entry</w>."
                            }
                        },
                        {
                            "text": "Sinds 2009 is het mogelijk om daders van huiselijk geweld tien dagen de <w>toegang</w> <w>tot</w> <w>hun</w> <w>woning</w> <w>te</w> <w>ontzeggen</w>.",
                            "target_lang_translations": {
                                "en": "Since 2009, it has been possible to <w>bar</w> perpetrators of domestic violence from their homes for ten days."
                            }
                        }
                    ],
                    "synonyms": [
                        "weigeren",
                        "ontnemen",
                        "verbieden"
                    ],
                    "antonyms": [
                        "toestaan",
                        "verlenen"
