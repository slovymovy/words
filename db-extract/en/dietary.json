                                "sense_id": "57e81759-897d-3a8f-bfb4-f19effa3307b",
                                "text": "If you have any dietary requirements, please inform the kitchen staff."
                            }
                        ]
                    },
                    {
                        "sense_id": "ff4858b4-20c3-3136-9575-9683fb288bba",
                        "entry_id": "cf188b4e-0364-339d-995b-e82fcb1b8579",
                        "glosses": [
                            "Comprising a food source."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "5f6d50c2-997f-49ab-9e40-84e169cdacc3",
                                "sense_id": "ff4858b4-20c3-3136-9575-9683fb288bba",
                                "text": "For example, the antitumour depsipeptide kahalalide F was isolated from the opisthobranch mollusc Elysia rufescens, and is used by both the mollusc and its dietary alga Bryopsis spp."
                            }
                        ]
