                    {
                        "sense_id": "ac6a4719-ef58-3c8a-903c-7c0d70796a34",
                        "entry_id": "17959acd-6f94-34e8-8159-5d87459a5a53",
                        "glosses": [
                            "antiker zweirädriger Kampf- und Streitwagen, der von vier nebeneinander gehenden Zugtieren, meist Pferden, gezogen wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28f4623b-b8cc-4856-86ae-722782d972e2",
                                "sense_id": "ac6a4719-ef58-3c8a-903c-7c0d70796a34",
                                "text": "Auf dem Brandenburger Tor ist eine Quadriga dargestellt."
                            },
                            {
                                "example_id": "9d8cd1bd-e3a6-40b2-9d9c-93f868619fdc",
                                "sense_id": "ac6a4719-ef58-3c8a-903c-7c0d70796a34",
                                "text": "„Mir fällt noch die Quadriga auf dem Brandenburger Tor ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c8a35c45-dea9-4eac-aea9-b74fc7aaaf84",
                        "source_entry_id": "17959acd-6f94-34e8-8159-5d87459a5a53",
                        "source_sense_id": "ac6a4719-ef58-3c8a-903c-7c0d70796a34",
                        "target_lang_word": "quadriga",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quadriga",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ece20675-92d0-332d-a8f0-25d3e312a34c",
                                        "entry_id": "ee436fb9-63d9-3006-9d33-09eec0413209",
                                        "glosses": [
                                            "A Roman racing chariot drawn by four horses abreast."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8179e13d-586e-47de-80dc-c91be7068ee2",
                                                "sense_id": "ece20675-92d0-332d-a8f0-25d3e312a34c",
                                                "text": "In the Vatican Library is a vase of terra cotta, on whose upper part we see delineated the sun and moon, in a quadriga, which proceeds forward [travels, voyages, fulfils its course] upon a ship. […] Both these deities stand in a quadriga, which indeed is the vehicle proper to the sun, insomuch that the Rhodians every year threw into the sea a quadriga, dedicated to this divinity."
                                            },
                                            {
                                                "example_id": "ff16bd8c-a11b-4cff-8c12-cb53f10c6abd",
                                                "sense_id": "ece20675-92d0-332d-a8f0-25d3e312a34c",
                                                "text": "On another denarius we see Victory holding a wreath and driving a quadriga […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7277daee-4010-3448-9e58-e5abc114fe40",
                                        "entry_id": "ee436fb9-63d9-3006-9d33-09eec0413209",
                                        "glosses": [
                                            "A team of four horses, or sometimes other animals, especially as used in chariot racing."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0b177ddd-bba5-480e-9212-7a0fccbf80b4",
                        "source_entry_id": "17959acd-6f94-34e8-8159-5d87459a5a53",
                        "source_sense_id": "ac6a4719-ef58-3c8a-903c-7c0d70796a34",
                        "target_lang_word": "quadrige",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quadrige",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6784fe46-5fff-3314-92f7-94482fb41174",
                                        "entry_id": "7919c9a1-41a6-3a4f-ada0-193cffcacf54",
                                        "glosses": [
                                            "Char antique à deux roues, attelage de quatre chevaux de front, généralement utilisé pour les courses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93fc44b9-bf8c-47fa-ac11-1027b8f1ed73",
                                                "sense_id": "6784fe46-5fff-3314-92f7-94482fb41174",
                                                "text": "Dans l’Antiquité, les courses de quadriges à Rome se déroulaient principalement au Circus Maximus."
                                            },
                                            {
                                                "example_id": "9d8643f8-c0cb-4bd2-b3aa-faa0d877bd5a",
                                                "sense_id": "6784fe46-5fff-3314-92f7-94482fb41174",
                                                "text": "— Mais vous n’êtes pas obligé, répliqua Blazius, d’entrer triomphalement dans la grande ville, comme un César romain monté sur un char traîné par un quadrige de chevaux blancs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "acb0ef96-97f7-305d-9043-41dff2bc39e4",
                                        "entry_id": "7919c9a1-41a6-3a4f-ada0-193cffcacf54",
                                        "glosses": [
                                            "Statue représentant un quadrige."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4055628-29f0-4bea-9cc2-b0e06f8ac118",
                                                "sense_id": "acb0ef96-97f7-305d-9043-41dff2bc39e4",
                                                "text": "Un arc de triomphe surmonté d’un quadrige."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
