                            "comparative"
                        ],
                        "form": "more impatiently"
                    },
                    {
                        "form_id": "a6b11594-9209-4ab7-9a9e-fd549343f322",
                        "entry_id": "1793b715-fd78-305d-8395-7eecf9307edd",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most impatiently"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8f437e36-f5b6-3dde-ae34-7fd3ff9c21b0",
                        "entry_id": "1793b715-fd78-305d-8395-7eecf9307edd",
                        "glosses": [
                            "In an impatient manner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb1c54a5-40c3-4f05-9135-4bd1d4c8f09d",
                                "sense_id": "8f437e36-f5b6-3dde-ae34-7fd3ff9c21b0",
                                "text": "Stella was waiting impatiently for the delivery to come."
                            },
                            {
                                "example_id": "1ab8fc41-5a1a-4a28-88cb-30fa2dd21f33",
                                "sense_id": "8f437e36-f5b6-3dde-ae34-7fd3ff9c21b0",
                                "text": "He watched his corn impatiently for two days, and, as it did not come up, he thought he would plant it again with beans. He ought to have waited longer."
                            },
                            {
                                "example_id": "ffca710e-4e2d-4821-89fe-01ab95047414",
                                "sense_id": "8f437e36-f5b6-3dde-ae34-7fd3ff9c21b0",
                                "text": "The keys are awaiting\nThy magical touch,\nAnd the strings are impatiently mute."
                            },
                            {
                                "example_id": "14e33cab-fd18-4dae-8d14-92485d7239ac",
                                "sense_id": "8f437e36-f5b6-3dde-ae34-7fd3ff9c21b0",
                                "text": "When the work was almost completed, the Pope impatiently asked when it would be finished. Michelangelo answered, \"When I shall be able\"."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "37bd3e25-32fe-4aa3-a697-542e8c21a6bc",
                        "source_entry_id": "1793b715-fd78-305d-8395-7eecf9307edd",
                        "source_sense_id": "8f437e36-f5b6-3dde-ae34-7fd3ff9c21b0",
                        "source_sense_description": "without patience",
                        "target_lang_word": "ongeduldig",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ongeduldig",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "b573d305-f82a-336e-a586-66ba6af0c59f",
                                        "entry_id": "c51666a5-bdc9-3c0a-b7d2-20541af19c3b",
                                        "glosses": [
                                            "onwillig nog langer te wachten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69e41b44-78a7-46f5-b86a-f4831be1aa13",
                                                "sense_id": "b573d305-f82a-336e-a586-66ba6af0c59f",
                                                "text": "Het was niet makkelijk een hele klas ongeduldige kinderen in toom te houden."
                                            },
                                            {
                                                "example_id": "ec8b1fa8-6989-44a5-a3a6-be04aecf3ae8",
                                                "sense_id": "b573d305-f82a-336e-a586-66ba6af0c59f",
                                                "text": "Ik ben nu eenmaal erg ongeduldig, een eigenschap waar ik niet trots op ben en die moeilijk af te schudden is."
                                            },
                                            {
                                                "example_id": "2ea30854-eba5-4d0a-b56d-b1b39442bfea",
                                                "sense_id": "b573d305-f82a-336e-a586-66ba6af0c59f",
                                                "text": "De ongeduldige man"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c3aa3855-9590-4fc1-bb96-945e9db56bf6",
                        "source_entry_id": "1793b715-fd78-305d-8395-7eecf9307edd",
                        "source_sense_id": "8f437e36-f5b6-3dde-ae34-7fd3ff9c21b0",
