                        ],
                        "form": "карта́вив"
                    },
                    {
                        "form_id": "1f71e3a3-cff0-4f02-9dea-de19710b073d",
                        "entry_id": "b1d157c7-3612-33d4-8553-867602d7d706",
                        "tags": [
                            "future"
                        ],
                        "form": "буду/будешь… карта́вить"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "24b5e7a0-6467-3869-8a21-66cff709e724",
                        "entry_id": "b1d157c7-3612-33d4-8553-867602d7d706",
                        "glosses": [
                            "неправильно, нечисто произносить звуки «р» или «л»"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c7c9e8f-0d0a-4cee-a918-fc782cfeb2b2",
                                "sense_id": "24b5e7a0-6467-3869-8a21-66cff709e724",
                                "text": "Она очень скоро перестала картавить и уже на четвёртом году говорила совершенно чисто."
                            },
                            {
                                "example_id": "b6f3e0ab-da57-4f5c-83db-da9db805c57b",
                                "sense_id": "24b5e7a0-6467-3869-8a21-66cff709e724",
                                "text": "Вообще русские скоро усваивают форму, язык и привычки тех стран и городов, где бывают; я встречал типических господ Ивановых и господ Сидоровых, которые, прожив два месяца в Париже, начинали уже картавить."
                            },
                            {
                                "example_id": "13878faa-0615-4d89-b15b-b4e5ba1a800a",
                                "sense_id": "24b5e7a0-6467-3869-8a21-66cff709e724",
                                "text": "[Лубков] картавил, не выговаривая ни р, ни л, так что, например, слово «сделал» у него выходило так: сдевав."
                            }
                        ]
                    },
                    {
                        "sense_id": "8939f44a-9fba-3053-b9c8-3a9d24636a86",
                        "entry_id": "b1d157c7-3612-33d4-8553-867602d7d706",
                        "glosses": [
                            "перен., устар. фальшить, фальшивить, кривить, не чисто действовать; делать дело лениво, для одного вида"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "876e454e-e8a4-4ece-bfd3-59db889177d9",
                                "sense_id": "8939f44a-9fba-3053-b9c8-3a9d24636a86",
                                "text": "— Служить, так не картавить, а картавить, так не служить, ― слышал я такую старую пословицу, — сурово сказал Устименко."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d78ec8f5-5819-4b30-ad29-e8e4c0173e20",
                        "source_entry_id": "b1d157c7-3612-33d4-8553-867602d7d706",
                        "source_sense_description": "неправильно, нечисто произносить звуки «р» или «л»",
                        "target_lang_word": "ratschen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ratschen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2eee2a8f-6ac9-3550-a9e8-90983a68a21b",
                                        "entry_id": "2d3fd244-1cba-30f0-8ff1-2b5de2ab417b",
                                        "glosses": [
                                            "sich ungezwungen unterhalten"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "219858d9-bcee-4d91-92a1-832f4aebc413",
                                                "sense_id": "2eee2a8f-6ac9-3550-a9e8-90983a68a21b",
                                                "text": "Die Frauen treffen sich nachmittags zum Kaffee trinken und ratschen ein wenig."
                                            },
                                            {
                                                "example_id": "5ae338d9-e993-40ec-bbd8-adce88399f7e",
                                                "sense_id": "2eee2a8f-6ac9-3550-a9e8-90983a68a21b",
                                                "text": "Wir haben noch ein bisschen miteinander geratscht."
                                            },
                                            {
                                                "example_id": "b6e904fc-2660-43d4-b25d-c78d679f3f4d",
                                                "sense_id": "2eee2a8f-6ac9-3550-a9e8-90983a68a21b",
                                                "text": "bairisch: „Mei, und scho ratschn d’Leit: Schaugts an Pfaffinger o, wia der faulenzn ko, […].“ (Ja und schon haben die Leute was zum Reden: Schaut den Pfaffinger an, wie der faulenzen kann […].)"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "11c16a39-d98a-39fb-92b8-9a187125fd6e",
                                        "entry_id": "2d3fd244-1cba-30f0-8ff1-2b5de2ab417b",
                                        "glosses": [
                                            "viel (und häufig) zu viel erzählen, übel nachreden"
                                        ],
                                        "tags": [
                                            "Austrian German",
                                            "South German",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
