                        "entry_id": "aa16cecb-a203-371b-af40-23d06497523f",
                        "glosses": [
                            "Plat traditionnel du Viêt Nam, sorte de beignet frit constitué de farce entourée d’une galette de riz."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0580b64-4448-49db-bc2a-8cd1b5acf6cd",
                                "sense_id": "0deacb15-3707-37ec-9e75-9eb107a9fb94",
                                "text": "La sauce pour accompagner les nems est un mélange de nuoc-mâm et d’eau, avec du sucre et du citron."
                            },
                            {
                                "example_id": "65ab4faf-76dd-42b7-a20e-2281c2912b4b",
                                "sense_id": "0deacb15-3707-37ec-9e75-9eb107a9fb94",
                                "text": "Nous nous querellions toujours pour savoir si les nems se mangent avant ou après la soupe."
                            },
                            {
                                "example_id": "b6182607-a889-4d6a-8706-094ce37dc392",
                                "sense_id": "0deacb15-3707-37ec-9e75-9eb107a9fb94",
                                "text": "Un nems ce mange avec de la salade"
                            }
                        ]
