                ],
                "senses": [
                    {
                        "sense_id": "d1125b99-7b76-3e3a-94a6-431d3909cc48",
                        "entry_id": "0f8bdaae-32e5-3995-a34c-2f8b24450057",
                        "glosses": [
                            "Anhänger (der Politik) von Donald Trump ^(→ WP)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6f0d29e-cf69-464b-b46d-fb0dfdf386b8",
                                "sense_id": "d1125b99-7b76-3e3a-94a6-431d3909cc48",
                                "text": "„Die Trumpisten agieren zunehmend wie eine dritte Partei neben Demokraten und Republikanern.“"
                            },
                            {
                                "example_id": "538c6b92-1e6c-4261-b022-a712c2b08838",
                                "sense_id": "d1125b99-7b76-3e3a-94a6-431d3909cc48",
                                "text": "„Es geht um ihre Wiederwahl in Bundesstaaten, die von Trumpisten beherrscht werden.“"
                            },
                            {
                                "example_id": "c10a0206-de1b-435e-b17b-b49c019caf0a",
                                "sense_id": "d1125b99-7b76-3e3a-94a6-431d3909cc48",
                                "text": "„Grölende Trumpisten brechen ins Kapitol ein, schwenken die Sezessionsflagge, stürmen den hastig geräumten Plenarsaal, posten stolz Selfies aus dem Büro von Nancy Pelosi.“"
                            },
                            {
                                "example_id": "f8eae59e-ceb0-4957-94dc-3161e0138320",
                                "sense_id": "d1125b99-7b76-3e3a-94a6-431d3909cc48",
                                "text": "„Es ist unwahrscheinlich, dass sich Trumpisten mit ihren Sorgen bei demokratischen Politikern und liberaleren Mitbürgern in Therapie begeben wollen, um dort zur Wahrheit und zu Anstand zu finden.“"
                            },
                            {
                                "example_id": "145abae5-a333-4499-a9ea-cbe5512eb770",
                                "sense_id": "d1125b99-7b76-3e3a-94a6-431d3909cc48",
                                "text": "„In den USA wünschen sich nicht nur Trumpisten, sondern auch viele Demokraten wieder mehr gut bezahlte Industriejobs im eigenen Land.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bcd7e30b-8e2b-4b90-a9a3-d861029b0f62",
                        "source_entry_id": "0f8bdaae-32e5-3995-a34c-2f8b24450057",
                        "source_sense_id": "d1125b99-7b76-3e3a-94a6-431d3909cc48",
                        "target_lang_word": "Trumpist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Trumpist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "90fa7899-61aa-36d1-a7b5-9b9fb0b98de2",
                                        "entry_id": "f29d0068-9d03-3871-9a18-c28c6ac9545a",
                                        "glosses": [
                                            "Pertaining to or resembling characteristics of Trumpism. Synonym of Trumpian."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "038e3651-dede-4572-8321-d30946668421",
                                                "sense_id": "90fa7899-61aa-36d1-a7b5-9b9fb0b98de2",
                                                "text": "The centrão secured the firing of the Trumpist foreign minister, Ernesto Araújo, for his failure to buy vaccines;"
                                            },
                                            {
                                                "example_id": "0f9bafbe-9aba-4fad-9d27-b1aaf3ac63c3",
                                                "sense_id": "90fa7899-61aa-36d1-a7b5-9b9fb0b98de2",
                                                "text": "[...] people dressed in Trumpist apparel, waving Trump flags, and chanting Trumpist slogans stormed the Capitol building."
                                            },
                                            {
                                                "example_id": "6a4b627d-167a-4327-a626-ffb652ba601f",
                                                "sense_id": "90fa7899-61aa-36d1-a7b5-9b9fb0b98de2",
                                                "text": "Not every right-wing judge is as blatantly ideological in their decision making as Kacsmaryk, nor is every Republican appointee a Trumpist zealot."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Trumpist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "98db7858-04de-3f11-be5e-c2d5fd914bed",
                                        "entry_id": "2028eda1-3a90-3ac1-a319-07d2c5e1c305",
                                        "glosses": [
                                            "An admirer or fan of Donald Trump."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "37e8c8e2-6f4e-37ed-91c8-b8510ad7fddd",
                                        "entry_id": "2028eda1-3a90-3ac1-a319-07d2c5e1c305",
                                        "glosses": [
                                            "A person exhibiting characteristics of Trumpism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc44b32f-738b-42c8-b305-a78ce37ebda1",
                                                "sense_id": "37e8c8e2-6f4e-37ed-91c8-b8510ad7fddd",
                                                "text": "He [Scott Morrison] remains afraid of the far-right extremist fringe dwellers who make up the bedrock of his personal support and who he cultivates through the avatars of Trumpists and conspiracy theorists like Craig Kelly and George Christensen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "600bef4b-ba72-4e10-9444-da4939c52e9d",
                        "source_entry_id": "0f8bdaae-32e5-3995-a34c-2f8b24450057",
                        "source_sense_id": "d1125b99-7b76-3e3a-94a6-431d3909cc48",
                        "target_lang_word": "Trumpian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Trumpian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "802264f9-52f0-3251-a262-e035886e4f53",
                                        "entry_id": "61e07b91-dc04-30c2-8c84-ed2f1697b3d6",
                                        "glosses": [
                                            "Resembling or pertaining to the philosophy, rhetoric, and style of Donald Trump."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c184b97-28cd-49f1-94b5-534ced83092f",
                                                "sense_id": "802264f9-52f0-3251-a262-e035886e4f53",
                                                "text": "Good times … but then, a couple of weeks ago, Daffy was suddenly sputtering at us again. Such a magnificent Trumpian performance, such an unexpected gift, such bliss. The venue, of course, was “Page Six.”"
                                            },
                                            {
                                                "example_id": "57282a4e-429e-4f3f-991d-8b294d770217",
                                                "sense_id": "802264f9-52f0-3251-a262-e035886e4f53",
                                                "text": "Operating in a command climate of Trumpian instability, the most senior and public White House officials are party to profoundly destabilizing acts."
                                            },
                                            {
                                                "example_id": "77bbdf65-3c24-45f3-b8c2-a5246179f9e9",
                                                "sense_id": "802264f9-52f0-3251-a262-e035886e4f53",
                                                "text": "China is internationally much more accepted as being in the top league and is calling the shots … In Trumpian terms, he’s managed to make China look great again."
                                            },
                                            {
                                                "example_id": "d0f23b22-ed5f-4658-9aec-5dd7de9816ff",
                                                "sense_id": "802264f9-52f0-3251-a262-e035886e4f53",
                                                "text": "The made-up \"bible verses\" were of course in the form of Trumpian tweets."
                                            },
                                            {
                                                "example_id": "6bce6875-88f9-456e-abaa-48df4fd26389",
                                                "sense_id": "802264f9-52f0-3251-a262-e035886e4f53",
                                                "text": "Beyond that, Schumer’s threat was Trumpian—a judge who displeases me will pay a price. His retraction was equally Trumpian: I didn’t threaten anyone. It would be okay if I had because in Brooklyn we threaten people all the time, but those aren’t threats, and anyway I would never, ever do what I just did."
                                            },
                                            {
                                                "example_id": "d2aa9a4f-6d3b-49d5-8ff9-9d7116bb0ddc",
                                                "sense_id": "802264f9-52f0-3251-a262-e035886e4f53",
                                                "text": "Both, in true Trumpian fashion, refused to concede."
                                            },
                                            {
                                                "example_id": "e7cabeaf-14dd-44e6-97fd-c5c112b7f946",
                                                "sense_id": "802264f9-52f0-3251-a262-e035886e4f53",
                                                "text": "And he’s dismayed that Mr. Biden has resorted to what he sees as Trumpian tactics to shut down dissenting voices in his party."
                                            },
                                            {
                                                "example_id": "fc577f99-e6e3-4226-ba69-41ebd0eb8377",
                                                "sense_id": "802264f9-52f0-3251-a262-e035886e4f53",
                                                "text": "There are plenty of reasons, Australians may reason, why our nation might be exempted from the threatened next round of Trumpian tariffs, on stuff like aluminium and pharmaceuticals."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Trumpian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "df368231-945f-3562-b943-262341d34cd6",
                                        "entry_id": "1ef9975b-d082-3892-a694-f698986fe0ad",
                                        "glosses": [
                                            "A political supporter of Donald Trump."
                                        ],
                                        "tags": [
                                            "uncommon"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
