                },
                {
                    "sense_id": "8b3df991-5425-3d61-84ca-1beb83a401bc",
                    "sense_definition": "Mélange épais ou suspension de substances insolubles dans un liquide, notamment utilisé pour des traitements agricoles.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "chimie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jardinier applique de la <w>bouillie</w> bordelaise sur ses plants de tomates pour éviter les maladies."
                        },
                        {
                            "text": "Avant de pulvériser les arbres fruitiers, il faut bien remuer la <w>bouillie</w> pour dissoudre le produit."
