{
    "word_family": [
        "hitcher"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ff708e16-ff20-35d0-8994-c8e5117d8b36",
                    "sense_definition": "A problem, delay, or source of difficulty.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "problem",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The entire event went off without a <w>hitch</w>.",
                            "target_lang_translations": {
                                "cs": "Celá akce proběhla bez jediného <w>háčku</w>."
                            }
                        },
                        {
                            "text": "The project faced a few minor <w>hitches</w> during the first week.",
                            "target_lang_translations": {
                                "cs": "Projekt se během prvního týdne potýkal s několika drobnými <w>nesnázemi</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "without a hitch"
                    ],
                    "target_lang_definitions": {
                        "cs": "Problém, zpoždění nebo komplikace, která brání hladkému průběhu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "háček",
                                "target_lang_sense_clarification": "přenesený význam pro drobný problém či zádrhel"
                            },
                            {
                                "target_lang_word": "nesnáz",
                                "target_lang_sense_clarification": "obecné označení pro potíž nebo komplikaci"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d33b416b-1d86-3ea4-900e-979881646c25",
                    "sense_definition": "A fastener or connection point, often used for attaching a trailer to a vehicle.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "fastener",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The truck was equipped with a heavy-duty <w>hitch</w> for the boat trailer.",
                            "target_lang_translations": {
                                "cs": "Nákladní auto bylo vybaveno odolným <w>tažným zařízením</w> pro přívěs s lodí."
                            }
                        },
                        {
                            "text": "Make sure the trailer is securely locked onto the <w>hitch</w>.",
                            "target_lang_translations": {
                                "cs": "Ujistěte se, že je přívěs bezpečně zajištěn na <w>tažném zařízení</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Spojovací zařízení, často používané k připojení přívěsu k vozidlu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "tažné zařízení",
                                "target_lang_sense_clarification": "technický termín pro zařízení k připojení přívěsu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6e283a6e-c440-3603-adf9-8db7acbc050b",
                    "sense_definition": "A type of knot used to attach a rope to an object.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "knot",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He tied a simple <w>hitch</w> to secure the rope to the post.",
                            "target_lang_translations": {
                                "cs": "Uvázal jednoduchý <w>uzel</w>, aby zajistil lano ke sloupu."
                            }
                        },
                        {
                            "text": "Learning how to tie a clove <w>hitch</w> is essential for camping.",
                            "target_lang_translations": {
                                "cs": "Naučit se vázat lodní <w>uzel</w> je pro kempování nezbytné."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Typ uzlu používaný k připevnění lana k předmětu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "uzel",
                                "target_lang_sense_clarification": "obecné označení pro spojení lana"
                            },
                            {
                                "target_lang_word": "smyčka",
                                "target_lang_sense_clarification": "typ uzlu tvořící uzavřený tvar"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ac6dac81-8bb8-393e-b9f8-b6293f629791",
                    "sense_definition": "To attach, tie, or fasten something to something else.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "attach",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>hitched</w> the trailer to his truck before leaving.",
                            "target_lang_translations": {
                                "cs": "Před odjezdem <w>připojil</w> přívěs ke svému náklaďáku."
                            }
                        },
                        {
                            "text": "She <w>hitched</w> her horse to the wooden fence.",
                            "target_lang_translations": {
                                "cs": "Svého koně <w>přivázala</w> k dřevěnému plotu."
                            }
                        }
                    ],
                    "synonyms": [
                        "attach",
                        "fasten",
                        "connect"
                    ],
                    "target_lang_definitions": {
                        "cs": "Připojit, přivázat nebo upevnit něco k něčemu jinému."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "připojit",
                                "target_lang_sense_clarification": "spojit dvě věci dohromady"
                            },
                            {
                                "target_lang_word": "přivázat",
                                "target_lang_sense_clarification": "upevnit pomocí lana či provazu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0afd65f3-99b1-34ce-a1dd-f4804fed79c7",
                    "sense_definition": "To travel by asking for free rides in passing vehicles.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "travel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They decided to <w>hitch</w> a ride to the next town.",
                            "target_lang_translations": {
                                "cs": "Rozhodli se, že do dalšího města <w>pojedou stopem</w>."
                            }
                        },
                        {
                            "text": "It is safer to travel by bus than to <w>hitch</w> along the highway.",
                            "target_lang_translations": {
                                "cs": "Je bezpečnější cestovat autobusem než <w>stopovat</w> podél dálnice."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hitch a ride"
                    ],
                    "target_lang_definitions": {
                        "cs": "Cestovat stopem, tedy žádat o svezení v projíždějících vozidlech."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "stopovat",
                                "target_lang_sense_clarification": "cestovat jako stopař"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cb54a745-fe37-3898-ba85-e72a651ed180",
                    "sense_definition": "To pull something quickly with a sudden movement.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "pull",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>hitched</w> up her skirt to walk through the shallow water.",
                            "target_lang_translations": {
                                "cs": "Aby mohla projít mělkou vodou, <w>popotáhla</w> si sukni výš."
                            }
                        },
                        {
                            "text": "He <w>hitched</w> his heavy backpack higher onto his shoulders.",
                            "target_lang_translations": {
                                "cs": "Těžký batoh si <w>popotáhl</w> výš na ramena."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Rychle něco popotáhnout nebo vytáhnout prudkým pohybem."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "popotáhnout",
                                "target_lang_sense_clarification": "krátký pohyb směrem nahoru nebo k sobě"
                            },
                            {
                                "target_lang_word": "vytáhnout",
                                "target_lang_sense_clarification": "posunout něco výše"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}