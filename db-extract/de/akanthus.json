                                        "entry_id": "65e19523-58f9-37b0-a3e3-d4eee4339507",
                                        "glosses": [
                                            "Un des ouvrages de sculpture qui font l’ornement du chapiteau corinthien."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
