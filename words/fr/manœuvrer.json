                    ]
                },
                {
                    "sense_id": "950f966f-80b3-31cf-a1ef-322210b94d05",
                    "sense_definition": "Exécuter des mouvements d'ensemble ou des exercices tactiques, en parlant de troupes militaires.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "militaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le régiment s'entraîne régulièrement à <w>manœuvrer</w> sur ce vaste terrain d'exercice."
                        },
                        {
                            "text": "Les officiers observaient les nouvelles recrues <w>manœuvrer</w> en formation serrée."
                        }
                    ],
                    "synonyms": [
                        "évoluer"
                    ],
                    "common_phrases": [
                        "manœuvrer en formation"
                    ]
                }
            ]
        }
    ]
