                        "traité de mythologie"
                    ]
                },
                {
                    "sense_id": "36b49501-dea2-3b20-b71d-eba3d664931b",
                    "sense_definition": "Ensemble des représentations collectives, croyances ou idées idéalisées propres à un groupe.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sociologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le cinéma américain a créé une véritable <w>mythologie</w> moderne autour du cow-boy."
                        },
