                ],
                "senses": [
                    {
                        "sense_id": "79f2ebf8-5f1a-35b7-9821-ee8c93af7c1c",
                        "entry_id": "c29f715f-511c-37bd-a005-9e8a3e5ff355",
                        "glosses": [
                            "Faire s’incrémenter automatiquement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "591c03d6-74e6-446c-b913-02f47d9d1a4d",
                                "sense_id": "79f2ebf8-5f1a-35b7-9821-ee8c93af7c1c",
                                "text": "L’identifiant, généré automatiquement sur le serveur (champ MySQL autoincrémenté), est lu après insertion par une commande SELECT, et stocké dans le champ FCode du singleton."
                            },
                            {
                                "example_id": "c2a908ad-614b-4f05-95e7-3f140a9bbf73",
                                "sense_id": "79f2ebf8-5f1a-35b7-9821-ee8c93af7c1c",
                                "text": "Bonjour a tous, j’aurais voulu savoir s’il était possible d’autoincrémenter une valeur en mysql a partir de zero et non de un ?"
                            },
                            {
                                "example_id": "ccecb667-ba02-483e-9a76-a5953b1b8660",
                                "sense_id": "79f2ebf8-5f1a-35b7-9821-ee8c93af7c1c",
                                "text": "pour tes clés primaires il existe une instruction pour autoincrémenter l’identifiant comme ça t’es pas obligé de le gérer."
                            }
                        ]
                    },
