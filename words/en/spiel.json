{
    "word_family": [
        "spieling",
        "spieled"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ee0b2dcb-b2b3-326f-a372-2d1860b9c2c1",
                    "sense_definition": "A lengthy and extravagant speech or argument, especially one intended to persuade or sell something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The salesman gave us a long <w>spiel</w> about the benefits of the new vacuum cleaner.",
                            "target_lang_translations": {
                                "ru": "Продавец выдал нам длинную <w>тираду</w> о преимуществах нового пылесоса."
                            }
                        },
                        {
                            "text": "I had to listen to his usual sales <w>spiel</w> before I could finally ask about the price.",
                            "target_lang_translations": {
                                "ru": "Мне пришлось выслушать его обычную <w>завлекалочку</w> для продаж, прежде чем я наконец смог спросить о цене."
                            }
                        }
                    ],
                    "synonyms": [
                        "pitch",
                        "patter",
                        "talk"
                    ],
                    "common_phrases": [
                        "sales spiel",
                        "usual spiel",
                        "marketing spiel"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used to describe a practiced or insincere pitch."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Длинная, напыщенная или заученная речь, особенно направленная на то, чтобы убедить в чем-то или продать товар."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "призывная речь",
                                "target_lang_sense_clarification": "рекламная или завлекающая речь"
                            },
                            {
                                "target_lang_word": "красноречивая история",
                                "target_lang_sense_clarification": "длинный рассказ с целью убеждения"
                            },
                            {
                                "target_lang_word": "болтовня",
                                "target_lang_sense_clarification": "заученная тирада или разглагольствование"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e753b824-df25-3bf0-806f-e26ed20b0d5a",
                    "sense_definition": "An early form of spoken-word performance or rap music.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The band incorporated a rhythmic <w>spiel</w> over the drum beats, reminiscent of early hip-hop.",
                            "target_lang_translations": {
                                "ru": "Группа включила ритмичный <w>речитатив</w> поверх барабанных битов, напоминающий ранний хип-хоп."
                            }
                        },
                        {
                            "text": "He delivered a powerful <w>spiel</w> that sounded like a precursor to modern rap music.",
                            "target_lang_translations": {
                                "ru": "Он выдал мощный <w>наговор</w>, который звучал как предвестник современного рэпа."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Refers to historical music styles."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ранняя форма речитативного выступления или рэп-музыки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "речитатив",
                                "target_lang_sense_clarification": "ритмичный наговор под музыку"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e2b3d9dc-7538-3f83-9803-b5d128145cd5",
                    "sense_definition": "A game or match of curling.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "curling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local club organized a curling <w>spiel</w> on the frozen lake last winter.",
                            "target_lang_translations": {
                                "ru": "Прошлой зимой местный клуб организовал <w>матч</w> по кёрлингу на замерзшем озере."
                            }
                        },
                        {
                            "text": "Many teams gathered to compete in the annual <w>spiel</w> despite the freezing weather.",
                            "target_lang_translations": {
                                "ru": "Многие команды собрались, чтобы посоревноваться в ежегодном <w>турнире</w>, несмотря на морозную погоду."
                            }
                        }
                    ],
                    "synonyms": [
                        "bonspiel"
                    ],
                    "common_phrases": [
                        "curling spiel"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Mainly used in Scotland and Canada in the context of curling."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Игра или матч по кёрлингу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "матч по кёрлингу",
                                "target_lang_sense_clarification": "турнир или игра в кёрлинг"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a87c5eb2-e962-36a9-8664-b568701766fa",
                    "sense_definition": "To give a sales pitch or promote something by speaking persuasively.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "persuade",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The street vendors were <w>spieling</w> their wares to anyone who walked past.",
                            "target_lang_translations": {
                                "ru": "Уличные торговцы <w>впаривали</w> свои товары каждому прохожему."
                            }
                        },
                        {
                            "text": "He spent the entire evening trying to <w>spiel</w> his new business idea to potential investors.",
                            "target_lang_translations": {
                                "ru": "Он провел весь вечер, пытаясь <w>презентовать</w> свою новую бизнес-идею потенциальным инвесторам."
                            }
                        }
                    ],
                    "synonyms": [
                        "pitch",
                        "promote",
                        "talk up"
                    ],
                    "common_phrases": [
                        "spiel wares"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used informally to describe pitching or selling."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Рекламировать, навязывать товар или продвигать что-либо с помощью убедительной речи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "впаривать",
                                "target_lang_sense_clarification": "настойчиво рекламировать или продавать"
                            },
                            {
                                "target_lang_word": "зазывать",
                                "target_lang_sense_clarification": "привлекать покупателей речами"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cf0b4860-95dc-38ab-9f29-76575de5bc2c",
                    "sense_definition": "To talk at great length, often in a fast or practiced manner.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "talk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>spieled</w> on for hours about her vacation, barely stopping to take a breath.",
                            "target_lang_translations": {
                                "ru": "Она часами <w>тараторила</w> о своем отпуске, почти не останавливаясь, чтобы перевести дух."
                            }
                        },
                        {
                            "text": "Instead of giving a short answer, he <w>spieled</w> into the microphone about his philosophy.",
                            "target_lang_translations": {
                                "ru": "Вместо короткого ответа он начал <w>разглагольствовать</w> в микрофон о своей философии."
                            }
                        }
                    ],
                    "synonyms": [
                        "chatter",
                        "ramble",
                        "spout"
                    ],
                    "common_phrases": [
                        "spiel on"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal usage."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Долго и без умолку говорить, часто быстро или по заученному шаблону."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разглагольствовать",
                                "target_lang_sense_clarification": "долго и нудно говорить"
                            },
                            {
                                "target_lang_word": "тараторить",
                                "target_lang_sense_clarification": "быстро и без остановки говорить"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}