                        "entry_id": "e21b6da6-4602-3ed4-9afb-bbb8905a80fe",
                        "glosses": [
                            "Cloaque (extrémité du canal intestinal, par où se produit la ponte), notamment de la poule."
                        ],
                        "tags": [
                            "Extrêmement rare"
                        ],
                        "examples": [
                            {
                                "example_id": "eda00d7c-a92f-4034-823b-70f21ed3d5c3",
                                "sense_id": "7fa001fe-e128-354c-98a3-672d4ae1f2a2",
                                "text": "Pontière, s. f. (Gramm.) ouverture de l’intestin par lequel la poule, ou les oiseaux en général, rendent leurs œufs."
                            },
                            {
                                "example_id": "d38266cd-acdc-45ab-b687-927e4c1162bf",
                                "sense_id": "7fa001fe-e128-354c-98a3-672d4ae1f2a2",
                                "text": "… crête simple et droite, robe noire, artichaut relevé en crinoline, avec plumes longues et soyeuses autour du sot-l’y-laisse et de la « pontière », voilà le véritable type de la pondeuse de Saintonge."
                            }
                        ]
                    },
