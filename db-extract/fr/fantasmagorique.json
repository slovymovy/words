                        "form": "fantasmagoriques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "63e2666d-ab2a-3bbc-a9f1-bf5cb16ef157",
                        "entry_id": "283dee64-56b0-3f25-a163-200fe35ec400",
                        "glosses": [
                            "Qui tient de la fantasmagorie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "188b96bf-44dd-46a7-a1f4-66ba966c88f8",
                                "sense_id": "63e2666d-ab2a-3bbc-a9f1-bf5cb16ef157",
                                "text": "[…] ; elle fit jouer un ressort, et disparut avec une rapidité fantasmagorique."
                            },
                            {
                                "example_id": "dc146cda-1d55-4578-91ba-1f18455e8939",
                                "sense_id": "63e2666d-ab2a-3bbc-a9f1-bf5cb16ef157",
                                "text": "Mais leur visage et leurs attitudes\nDevinrent bientôt moins funèbres\nLe ciel et la terre perdirent\nLeur aspect fantasmagorique."
                            },
                            {
                                "example_id": "c3396add-800b-43d4-8f35-433b0a5833f2",
                                "sense_id": "63e2666d-ab2a-3bbc-a9f1-bf5cb16ef157",
                                "text": "[…] Je me réfugie alors dans l’univers fantasmagorique de l’écriture, une correspondance épistolaire tout en légèreté que j’entretiens avec mes deux grands-mères, selon que je réside à Celeyran ou au Bosc."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9bab35af-70e2-4fd7-9f96-e13634229e0f",
                        "source_entry_id": "283dee64-56b0-3f25-a163-200fe35ec400",
                        "source_sense_id": "63e2666d-ab2a-3bbc-a9f1-bf5cb16ef157",
                        "target_lang_word": "phantasmagorical",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "phantasmagorical",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "48ae69a4-03bb-3811-87fb-f2e34ed95b8c",
                                        "entry_id": "9a0e6304-4be4-3dca-808b-6006683b8391",
                                        "glosses": [
                                            "Synonym of phantasmagoric."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58a94ca2-0f6e-4fdb-a98b-9faf88705b6b",
                                                "sense_id": "48ae69a4-03bb-3811-87fb-f2e34ed95b8c",
                                                "text": "Accordingly, Hawthorne selects the Brook Farm episode (or a reflection of it) as affording his drama \"a theatre, a little removed from the highway of ordinary travel, where the creatures of his brain may play their phantasmagorical antics, without exposing them to too close a comparison with the actual events of real lives.\""
                                            },
                                            {
                                                "example_id": "9b22b22f-bdca-4103-bc9b-7f7e20d51b52",
                                                "sense_id": "48ae69a4-03bb-3811-87fb-f2e34ed95b8c",
                                                "text": "\"In my youth,\" he went on after a pause, \"I found myself, quite fortuitously, involved in a series of the most phantasmagorical amorous intrigues.[…]\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
