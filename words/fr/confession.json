                        "sans confession"
                    ]
                },
                {
                    "sense_id": "a975596f-0b14-3a14-846c-66dda7281b1f",
                    "sense_definition": "Récit intime ou autobiographique dans lequel un auteur dévoile publiquement sa vie.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "litterature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce roman prend la forme d'une longue <w>confession</w> intime adressée à un vieil ami."
                        },
                        {
                            "text": "Dans son nouvel ouvrage, l'écrivain livre une poignante <w>confession</w> sur son passé."
                        }
                    ],
                    "synonyms": [
                        "autobiographie",
                        "mémoires"
                    ]
                },
                {
                    "sense_id": "4a40859f-f344-39f6-9785-6b36c1e90979",
                    "sense_definition": "Petite crypte située sous le maître-autel d'une église et renfermant les reliques d'un martyr.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "architecture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les archéologues ont découvert des fresques anciennes dans la <w>confession</w> de la basilique."
                        },
                        {
                            "text": "Les fidèles descendaient dans la <w>confession</w> pour prier devant les reliques du saint."
                        }
                    ],
                    "synonyms": [
                        "martyrium"
                    ]
                }
            ]
        }
    ]
