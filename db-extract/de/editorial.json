                                "target_senses": [
                                    {
                                        "sense_id": "21c15d44-f5fc-3463-9333-ec89f26ac14c",
                                        "entry_id": "4555494f-145e-3ee2-aff5-2f95cbf43400",
                                        "glosses": [
                                            "Of or relating to an editor, editing or an editorial."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b35ef4d-43ba-4e92-8ad6-e497467738dd",
                                                "sense_id": "21c15d44-f5fc-3463-9333-ec89f26ac14c",
                                                "text": "editorial labours; editorial remarks"
                                            },
                                            {
                                                "example_id": "39ee5851-3114-407a-a412-ebdea9480864",
                                                "sense_id": "21c15d44-f5fc-3463-9333-ec89f26ac14c",
                                                "text": "In stark opposition to what CBS editorial leadership told staff on Monday, Redstone said that she did not believe Dokoupil had violated the network’s editorial standards when he grilled Coates over the contents of his new book."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d686e41-d090-3587-99a6-96e833405bb8",
                                        "entry_id": "4555494f-145e-3ee2-aff5-2f95cbf43400",
                                        "glosses": [
                                            "Appropriate for high fashion magazines."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "editorial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ef93a465-00d2-3e67-ab10-d78a06b51f35",
                                        "entry_id": "b4348c3e-7a60-373d-92fc-03cee2035cb5",
                                        "glosses": [
                                            "An article in a publication giving the opinion of its editors on a given topic or current event."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b47bbad-19ac-4c2e-adc4-547f7cfb2445",
                                                "sense_id": "ef93a465-00d2-3e67-ab10-d78a06b51f35",
                                                "text": "Gratifying as it is to read such editorials even in the press which supports Mr. Marples' party—and to learn that the G.N. Line's London suburban electrification is at last being given a cost-benefit analysis of the kind which overwhelmingly justified the L.T. Victoria Line [...] but years later than need have been—[...]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4bf473e2-4381-3d16-b243-7e1aaee61271",
                                        "entry_id": "b4348c3e-7a60-373d-92fc-03cee2035cb5",
                                        "glosses": [
                                            "A similar commentary on radio or television."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "244ca0bd-126f-4fb9-baed-54d850b7941e",
                        "source_entry_id": "d1f57e8a-129a-3d8c-a9ab-d59fb6cfe90a",
                        "source_sense_id": "d1934158-9a61-32ba-bad5-75675b443103",
                        "source_sense_description": "Leitartikel",
                        "target_lang_word": "éditorial",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "éditorial",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fa88fef8-da60-3025-a5ad-ca0682f0ea3d",
                                        "entry_id": "72986fe7-a189-3361-98f7-de126dd49bcd",
                                        "glosses": [
                                            "En rapport avec le contenu d’un journal papier, télévisé, radiophonique, d’un site web."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d4a78bb-a88d-4c07-b8f5-01f5d71fbf34",
                                                "sense_id": "fa88fef8-da60-3025-a5ad-ca0682f0ea3d",
                                                "text": "En matière journalistique, l’éditorial constitue une tribune d’opinions qui reflète la position, les convictions ou l'orientation générale de l’équipe éditoriale, quant aux questions qui y sont traitées."
                                            },
                                            {
                                                "example_id": "6ff5ce54-f7d0-4fa5-8224-81d6e8f34e92",
                                                "sense_id": "fa88fef8-da60-3025-a5ad-ca0682f0ea3d",
                                                "text": "Les mentions légales d’un site Web doivent préciser le responsable éditorial ou directeur de publication dudit site."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "éditorial",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4cb5e18e-e93f-3f2c-9772-41a7fb05800c",
                                        "entry_id": "b7f403cb-ec9d-3982-bb1f-4c6c938616eb",
                                        "glosses": [
                                            "Texte signé par le responsable de contenu d’un journal exprimant une opinion, un courant de pensée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce4c2b19-d6f1-4ab1-82fa-56aa38f0e13c",
                                                "sense_id": "4cb5e18e-e93f-3f2c-9772-41a7fb05800c",
                                                "text": "Il est nécessaire d’aller au cœur des narrations journalistiques (l’éditorial) pour vérifier le méta-journalisme. Nous optons pour l’éditorial plutôt que pour l’article car c’est à travers ce premier qu’il est exprimé l’orientation générale du journal, c’est-à-dire par la ligne éditoriale qui est fondée sur un ensemble de prises de position vis-à-vis des contextes socioculturels, politiques et historiques. L’éditorial est le lieu d’explicitation des options de titres, des jugements portés sur l’actualité"
                                            },
                                            {
                                                "example_id": "ee125af2-a92e-4f3e-a514-1586b67da16f",
                                                "sense_id": "4cb5e18e-e93f-3f2c-9772-41a7fb05800c",
                                                "text": "Camus a écrit des éditoriaux à Soir républicain et à Combat."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
