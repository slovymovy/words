                        "glosses": [
                            "An orthorhombic-pyramidal mineral containing aluminum, barium, calcium, hydrogen, oxygen, and silicon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "440e0808-5bfd-4220-a7d3-fabd78e2da13",
                                "sense_id": "92a1a9b0-ab69-3581-95b6-932cf7a040f5",
                                "text": "Pure armenite is colorless and has well developed prismatic pseudohexagonal crystals with poorly developed terminal faces."
                            },
                            {
                                "example_id": "385acabb-ec79-4001-ad22-38b3203de6b5",
                                "sense_id": "92a1a9b0-ab69-3581-95b6-932cf7a040f5",
                                "text": "All reported armenites are of nearly end-member composition."
                            },
                            {
                                "example_id": "1a18a61e-7043-41b4-b812-6dbf96e8a578",
                                "sense_id": "92a1a9b0-ab69-3581-95b6-932cf7a040f5",
                                "text": "Although armenite contains 10 inequivalent Si-positions, only the topochemically distinct Si sites are resolved in the NMR spectrum."
                            }
                        ]
                    }
