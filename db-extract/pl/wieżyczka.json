                                                "sense_id": "c9023b97-4264-3d0f-938b-4c94019706c3",
                                                "text": "Сухарева башня."
                                            },
                                            {
                                                "example_id": "934f956f-a736-47ff-a9fb-1ca7fb939d40",
                                                "sense_id": "c9023b97-4264-3d0f-938b-4c94019706c3",
                                                "text": "Существующие стены и башни Кремля были возведены в 1485–1516 годах."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "447ab9f5-7a77-3f82-b641-d3e50d18702f",
                                        "entry_id": "f38698e6-7ee8-3471-a41d-6a231b6d6f1b",
                                        "glosses": [
                                            "воен. бронированное возвышение для орудий или пулемётов на судне, танке или бронеавтомобиле"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ec0495b-15c4-476f-b44e-17002a46dbdc",
                                                "sense_id": "447ab9f5-7a77-3f82-b641-d3e50d18702f",
                                                "text": "Обе пушки должны были располагаться во вращающейся башне; кроме того, танк должен был иметь две небольшие башни с пулемётами."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e054896d-faeb-3ace-b72d-3c886f31bc10",
                                        "entry_id": "f38698e6-7ee8-3471-a41d-6a231b6d6f1b",
                                        "glosses": [
                                            "рег. (Москва) многоэтажный, обычно одноподъездный дом"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "918e6571-e3d8-4417-aece-29142b7125cf",
                                                "sense_id": "e054896d-faeb-3ace-b72d-3c886f31bc10",
                                                "text": "Я живу в одной из 14-этажных башен, которые расположены практически напротив «Ашхабада»."
                                            }
                                        ]
                                    }
                                ]
