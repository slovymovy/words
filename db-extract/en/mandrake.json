                    },
                    {
                        "translation_id": "7f1873da-8351-465c-b67f-031e56e66c37",
                        "source_entry_id": "3f5a73aa-2a5b-3df8-ad30-5c1e880c517c",
                        "source_sense_description": "mythology",
                        "target_lang_word": "mandragore",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mandragore",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4c5a3580-173d-310b-845e-661421a62db3",
                                        "entry_id": "0e4c0e8a-fdcf-36cd-96a0-2bfd96daec4d",
                                        "glosses": [
                                            "Plante de la famille des solanées, dont la racine a la forme d’un corps humain, douée de propriétés narcotiques, sédatives, stupéfiantes et aphrodisiaques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8448623-fac6-4d91-9515-48b7e91683cb",
                                                "sense_id": "4c5a3580-173d-310b-845e-661421a62db3",
                                                "text": "On employait autrefois en pareil cas la mandragore, qu’on a abandonnée depuis ; toujours est-il certain que sa racine […] guérit les inflammations et les douleurs des yeux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "607da97e-2f37-3627-9fde-fc4433efb4f3",
                                        "entry_id": "0e4c0e8a-fdcf-36cd-96a0-2bfd96daec4d",
                                        "glosses": [
                                            "Plante de la famille des solanées dite porteuse de vertus magiques."
                                        ],
                                        "tags": [
                                            "Fantastique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a0ae319-fcc8-4650-8204-9557be4e90bd",
                                                "sense_id": "607da97e-2f37-3627-9fde-fc4433efb4f3",
                                                "text": "Ce sentier a ceci de dangereux, qu’il est bordé de Mandragores qui, la nuit, chantent au pied des arbres."
                                            },
                                            {
                                                "example_id": "4193aac7-9985-437d-a78b-2b2d89d82f38",
                                                "sense_id": "607da97e-2f37-3627-9fde-fc4433efb4f3",
                                                "text": "Le Maire. — C’est vrai ce qu’on raconte de la mandragore ?\nLe Droguiste. — Au sujet de la constipation ?\nLe Maire. — Non, au sujet de l’immortalité… Que les enfants conçus au-dessus d’une mandragore par un pendu deviennent des êtres démoniaques, et vivent sans terme ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
