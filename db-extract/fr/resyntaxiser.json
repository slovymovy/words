                ],
                "senses": [
                    {
                        "sense_id": "ddd5b7d0-8ad4-37e8-82e6-5e4baa18043a",
                        "entry_id": "92e4a46f-88c7-3788-b4d4-d4d9bb9dc62a",
                        "glosses": [
                            "Syntaxiser à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "805f52ba-d2ae-49bd-b434-0e7ac8e5712f",
                                "sense_id": "ddd5b7d0-8ad4-37e8-82e6-5e4baa18043a",
                                "text": "Penser, c'est du même coup syntaxiser, sémantiser et pragmatiser, ou resyntaxiser, resémantiser et repragmatiser."
                            },
                            {
                                "example_id": "8411b10b-98f5-4e64-8607-9ea098463ba7",
                                "sense_id": "ddd5b7d0-8ad4-37e8-82e6-5e4baa18043a",
                                "text": "En français contemporain, le verbe suppléant ne peut pas conserver de régime; si on veut suppléer le verbe, malgré tout, il faut resyntaxiser le régime, puisque cette fonction est caduque : on l'intègre à la catégorie du complément de propos: il froisse son foulard comme il ferait à un torchon."
                            }
                        ]
                    }
                ],
