                        "entry_id": "5c33bf52-ac06-3314-bb79-daadc1168748",
                        "glosses": [
                            "Any chromosome other than sex chromosomes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab1981f6-a20d-4d6f-af8a-9bffb6093dfd",
                                "sense_id": "44e19bca-17c3-3011-9c83-0cde48712a51",
                                "text": "Autosoma (or autosome), the usual or non-aberrant chromosomes, called by me previously ordinary chromosomes."
                            },
                            {
                                "example_id": "b949aa5b-7087-4c16-82a6-9fc32f9d6310",
                                "sense_id": "44e19bca-17c3-3011-9c83-0cde48712a51",
                                "text": "It is apparently formed by the arms of the loops becoming twisted around each other, and, as in the Acrididae, each of these arms no doubt represents a univalent autosome."
                            }
                        ]
                    }
                ],
