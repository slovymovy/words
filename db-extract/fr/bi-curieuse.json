            {
                "entry_id": "e17fd36d-f93b-3ba4-b1d6-5063e2367867",
                "word": "bi-curieuse",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "0b90987a-c190-489e-b34a-68cc72dc55c0",
                        "entry_id": "e17fd36d-f93b-3ba4-b1d6-5063e2367867",
                        "tags": [],
                        "form": "bicurieuse"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f728b4d1-5948-3bc3-bf73-28a645115ff0",
                        "entry_id": "e17fd36d-f93b-3ba4-b1d6-5063e2367867",
                        "glosses": [
                            "Se dit d'une femme qui s'identifie habituellement comme hétérosexuelle ou homosexuelle, mais qui manifeste un certain intérêt ou entretient des fantasmes à l’idée d’avoir une expérience sexuelle avec une personne du sexe qu’elle ne favorise pas d’habitude, souvent en n’assumant pas ou en rejetant l’étiquette de bisexuelle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab22db41-600c-4405-909c-e6f4758f9de7",
                                "sense_id": "f728b4d1-5948-3bc3-bf73-28a645115ff0",
                                "text": "D'après mon expérience, il est rare que des femmes homosexuelles fréquentent des femmes bi-curieuses."
                            },
                            {
                                "example_id": "80007d67-380f-43c1-9f42-3cfb78f73b02",
                                "sense_id": "f728b4d1-5948-3bc3-bf73-28a645115ff0",
                                "text": "Elle n'est pas lesbienne, elle est bi-curieuse."
                            },
                            {
                                "example_id": "2d3ff4cd-89ac-4087-a818-204893653cfd",
                                "sense_id": "f728b4d1-5948-3bc3-bf73-28a645115ff0",
                                "text": "Plus on grandit, plus les femmes veulent essayer des rapports avec des femmes… vous êtes vraiment toutes nées bi-curieuses ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "d73979b8-f5fa-3dc8-92da-722457009fc4",
                        "entry_id": "e17fd36d-f93b-3ba4-b1d6-5063e2367867",
                        "glosses": [
                            "Se dit d’un comportement relatif à la bi-curiosité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ceffba3-392f-42be-87a6-c477326e40e0",
                                "sense_id": "d73979b8-f5fa-3dc8-92da-722457009fc4",
                                "text": "Hope dans cet épisode a réveillé mes envies bi-curieuses."
                            },
                            {
                                "example_id": "5db7ee8a-715f-4a81-a5d0-d4b4615bacc3",
                                "sense_id": "d73979b8-f5fa-3dc8-92da-722457009fc4",
                                "text": "On peut avoir des tendances bi-curieuses alors qu’on est littéralement bi."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a586f356-db2f-4005-9004-b787135816f3",
                        "source_entry_id": "e17fd36d-f93b-3ba4-b1d6-5063e2367867",
                        "target_lang_word": "bi-curious",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bi-curious",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a3b2767d-6796-3b05-9f1c-3c15fdb29d0a",
                                        "entry_id": "ee56006d-acba-38a4-a804-f2873913f600",
                                        "glosses": [
                                            "Interested in having relationships with both men and women, curious about one's potential bisexuality; especially, of heterosexual people, considering a first sexual experience with a member of the same sex."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dbef7333-2a84-435b-a0d6-08441ab9c22c",
                                                "sense_id": "a3b2767d-6796-3b05-9f1c-3c15fdb29d0a",
                                                "text": "Bi curious M/F or cpls."
                                            },
                                            {
                                                "example_id": "066798f5-666a-4d08-a6e0-151ac0b3572c",
                                                "sense_id": "a3b2767d-6796-3b05-9f1c-3c15fdb29d0a",
                                                "text": "\"Does this make us bi-curious, or are some dudes just that girly?\""
                                            },
                                            {
                                                "example_id": "7f3481ec-9e2d-47e5-8b15-44ac9d9045ac",
                                                "sense_id": "a3b2767d-6796-3b05-9f1c-3c15fdb29d0a",
                                                "text": "Skirt Club caters to bisexual or bicurious women. No men are allowed, but women with all levels of experience in same-sex sexuality, from bicurious to fully lesbian, are welcomed."
                                            },
                                            {
                                                "example_id": "65cbbec0-12f4-47bf-9db2-e15fc1f2edeb",
                                                "sense_id": "a3b2767d-6796-3b05-9f1c-3c15fdb29d0a",
                                                "text": "Although Katy has admitted to being bi-curious in the past, the reason a lot of fans wanted clarity on her sexuality was to ensure she wasn't queer-baiting and benefiting from a culture she isn't actually part of."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
