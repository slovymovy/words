                        "tags": [],
                        "examples": [
                            {
                                "example_id": "238cb15c-8a14-48fc-a9f2-e8664b54769d",
                                "sense_id": "db9e9eca-50bd-3907-8bde-ed6f3d2e2178",
                                "text": "Les huîtrières, grands réservoirs établis au S.-E. de l’avant-port (pl. F5), sont remplies de centaines de mille d'huitres presque pendant toute l'année."
                            },
                            {
                                "example_id": "bf50efed-d03a-4f79-8fc5-0d9c5562bc1b",
                                "sense_id": "db9e9eca-50bd-3907-8bde-ed6f3d2e2178",
                                "text": "Pour cela il faudra que le bateau soit amené du bassin dans l’avant-port avant la nuit, à cause du pont tournant…"
                            }
                        ]
                    }
                ],
