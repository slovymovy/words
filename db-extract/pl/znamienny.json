                                                "example_id": "e67ba258-2571-4a37-acfb-723b1b910fb7",
                                                "sense_id": "bd17df89-cb11-3ecd-bf26-8e140a7c6430",
                                                "text": "Der typische Leser des Magazins ist unter 30 und Alleinstehender."
                                            }
