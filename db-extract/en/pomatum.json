        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "fce987a9-2fdb-33bc-9125-4a01f7264eec",
                "word": "pomatum",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "e3f66e09-c4b3-406c-a05c-d5aea8f3c115",
                        "entry_id": "fce987a9-2fdb-33bc-9125-4a01f7264eec",
                        "tags": [
                            "plural"
                        ],
                        "form": "pomatums"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b810393a-3795-3545-b4f9-1866aa4b1515",
                        "entry_id": "fce987a9-2fdb-33bc-9125-4a01f7264eec",
                        "glosses": [
                            "Synonym of ointment, particularly thick waxy ointments scented with fruit used to beautify the skin or hair."
                        ],
                        "tags": [
                            "countable",
                            "historical",
                            "uncommon",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "0260713d-d38b-4f55-9364-ad38c0bba060",
                                "sense_id": "b810393a-3795-3545-b4f9-1866aa4b1515",
                                "text": "There is likewise made an ointment with the pulpe of Apples and Swines grease and Rose water, which is vsed to beautifie the face... called in shops Pomatum, of the Apples whereof it is made."
                            },
                            {
                                "example_id": "30d43f02-b539-438e-ae0b-a8c4b4650ddc",
                                "sense_id": "b810393a-3795-3545-b4f9-1866aa4b1515",
                                "text": "Pomatum, which is of much use to soften and supple the roughnesse of the skin."
                            }
                        ]
                    },
                    {
                        "sense_id": "364fe376-1311-308d-a2dc-6e25e6a10be7",
                        "entry_id": "fce987a9-2fdb-33bc-9125-4a01f7264eec",
                        "glosses": [
                            "Synonym of pomade, a kind of thick waxy hair product used as a styling gel."
                        ],
                        "tags": [
                            "countable",
                            "uncommon",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "e99e0e3b-5e64-4e0d-ba49-74f176333d0a",
                                "sense_id": "364fe376-1311-308d-a2dc-6e25e6a10be7",
                                "text": "[W]hen we were to assemble in the morning at breakfast, down came my wife and daughters, drest out in all their former splendour: their hair plaistered up with pomatum, their faces patched to taste, their trains bundled up into an heap behind, and rustling at every motion."
                            },
                            {
                                "example_id": "73e94845-1169-43ca-8a40-dcfad711452b",
                                "sense_id": "364fe376-1311-308d-a2dc-6e25e6a10be7",
                                "text": "On a huge tomb-like table in the middle of the room, lay two pencilled profiles of Mr. Fielding[…]; to these were added a cracked pomatum-pot containing ink, and a scrap of paper, […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "10d5681f-83a3-3e61-a148-9599a37ad07e",
                        "entry_id": "fce987a9-2fdb-33bc-9125-4a01f7264eec",
                        "glosses": [
                            "Synonym of cider, a soft or hard drink made from apples."
                        ],
                        "tags": [
                            "countable",
                            "obsolete",
                            "uncommon",
                            "uncountable"
                        ],
                        "examples": []
                    }
