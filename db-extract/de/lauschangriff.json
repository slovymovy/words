                "senses": [
                    {
                        "sense_id": "2ee4d4f1-6c3b-322c-8fc2-d18d9580a032",
                        "entry_id": "50cd2aa6-7c9a-3577-9e8b-18a45ee5db9f",
                        "glosses": [
                            "heimliches Abhören; politischer Kampfbegriff in der Auseinandersetzung darum, unter welchen Bedingungen Polizei oder Geheimdiensten erlaubt ist, verdächtige Personen gegen ihren Willen abzuhören."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "462bbbc1-233b-4adb-b17f-e59fc6f658dd",
                                "sense_id": "2ee4d4f1-6c3b-322c-8fc2-d18d9580a032",
                                "text": "Die Auseinandersetzung um Lauschangriffe spielt in der Terrorismusdebatte wieder eine große Rolle."
                            },
                            {
                                "example_id": "42d461b7-19ed-4537-a7cd-a5de40c996ac",
                                "sense_id": "2ee4d4f1-6c3b-322c-8fc2-d18d9580a032",
                                "text": "Die FDP setzte 1995 eine Urabstimmung an, bei der mehr als 63 Prozent der Mitglieder für den \"großen Lauschangriff\" votierten."
                            },
                            {
                                "example_id": "a127490b-390f-4e92-8616-51d11dfb419f",
                                "sense_id": "2ee4d4f1-6c3b-322c-8fc2-d18d9580a032",
                                "text": "Trump behauptete, ein solcher Lauschangriff [der Obama-Regierung] habe im Oktober 2016, in der heißen Phase des Wahlkampfs stattgefunden, lieferte allerdings beine Belege für seine Anschuldigung."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
