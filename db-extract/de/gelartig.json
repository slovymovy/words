                ],
                "senses": [
                    {
                        "sense_id": "80491bf1-5363-39ee-94ed-723745a142f7",
                        "entry_id": "f83e235d-faaa-321a-8fd8-776b48d3fe6d",
                        "glosses": [
                            "Gel ähnelnd, in seiner Beschaffenheit an Gel erinnernd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca6265c5-b966-4a43-b8a9-5d442eb3c4a9",
                                "sense_id": "80491bf1-5363-39ee-94ed-723745a142f7",
                                "text": "„Jedes Auge ruhte in etwas, das keinerlei Ähnlichkeit mit einer Augenhöhle hatte, sondern eher eine gelartige Substanz zu sein schien.“"
                            },
                            {
                                "example_id": "44e72a7f-6c41-4dba-b0d5-caa18e9386e3",
                                "sense_id": "80491bf1-5363-39ee-94ed-723745a142f7",
                                "text": "„Als Richtlinien galten die fünf Phasen der Blutgerinnung: Zuerst stockte es. Dann wurde es gelartig, ungefähr neunzig Minuten nach Austritt aus dem Körper.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
