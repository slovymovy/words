                "senses": [
                    {
                        "sense_id": "81688a39-6fa3-3697-a180-eebcfb293d9a",
                        "entry_id": "e8c9efbb-f5b6-3338-812a-f7d7bd421b37",
                        "glosses": [
                            "Entrer brutalement ou en grand nombre dans un endroit ; faire irruption."
                        ],
                        "tags": [
                            "Extrêmement rare"
                        ],
                        "examples": [
                            {
                                "example_id": "d71ff823-b02c-4aea-ae61-f8e7ee92c28c",
                                "sense_id": "81688a39-6fa3-3697-a180-eebcfb293d9a",
                                "text": "A propos de mouvement, une jeune femme irruptionne de derrière un rideau de perles qu'elle traverse dans un cliquetis de verroterie."
                            },
                            {
                                "example_id": "77aacd37-8c3d-4e06-aab1-8357f3d152cf",
                                "sense_id": "81688a39-6fa3-3697-a180-eebcfb293d9a",
                                "text": "Par des voies connues de lui seul, il circule par tout le camp à travers les fils de fer et enceintes, son seau à la main, et irruptionne dans les baraques, hurlant : « Jus tout bouillant, tout sucré »."
                            }
                        ]
                    }
                ],
