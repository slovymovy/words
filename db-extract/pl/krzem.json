                    {
                        "translation_id": "355b1710-61e9-45bb-bfaf-2d6cfffbacd3",
                        "source_entry_id": "0144af2b-87ec-3934-923d-81e7a87bf82e",
                        "source_sense_id": "7a41be5b-f1f0-3024-99c3-22360a0fbf78",
