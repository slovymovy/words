                    "sense_id": "cbadd4d7-d378-3e9f-a826-02c4819071c9",
                    "sense_definition": "Verbogen vorm van <w>klein</w>.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gespannen rende ik naar de enige beschutte plek op de bergtop, een <w>kleine</w> berghut.",
                            "target_lang_translations": {
                                "en": "Tense, I ran to the only sheltered spot on the mountain top, a <w>small</w> mountain hut.",
                                "ru": "В напряжении я побежал к единственному укрытию на вершине горы — <w>маленькой</w> хижине.",
                                "it": "Teso, corsi verso l'unico luogo riparato sulla cima della montagna, una <w>piccola</w> baita."
                            }
                        },
                        {
                            "text": "Het werkt eerder als een <w>kleine</w> rem dan als een blokkade.",
                            "target_lang_translations": {
                                "en": "It acts more like a <w>small</w> brake than a blockade.",
                                "ru": "Это действует скорее как <w>небольшой</w> тормоз, чем как блокада.",
                                "it": "Funziona più come un <w>piccolo</w> freno che come un blocco."
                            }
                        }
                    ],
                    "common_phrases": [
                        "kleine kinderen",
                        "kleine lettertjes",
                        "kleine moeite"
                    ],
