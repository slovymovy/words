                                "example_id": "46b28d9e-3810-46de-b324-d369bd47cf5d",
                                "sense_id": "048e5423-acce-3db2-803f-027c888c22a6",
                                "text": "„Unser Minitrupp war wieder komplett.“"
                            },
                            {
                                "example_id": "f2fb46df-e6f4-4301-94a8-66d786d1ea91",
                                "sense_id": "048e5423-acce-3db2-803f-027c888c22a6",
                                "text": "„Optisch könnten wir wahrscheinlich auch als Minitrupp einer SEK-Einheit durchgehen.“"
                            },
                            {
                                "example_id": "e73ca9ad-4bb2-4432-bd47-112f9e8b23cc",
                                "sense_id": "048e5423-acce-3db2-803f-027c888c22a6",
                                "text": "„Es muß eine Art von Zwangserkrankung sein, die den Minitrupp, der sich für Rouhs und Beisicht noch auf die Straße traut, wie magisch an den Ort der dräuend beschworenen islamischen Invasion zieht.“"
                            }
                        ],
