                "senses": [
                    {
                        "sense_id": "616b401b-93b2-3509-bf65-6cdff60249a9",
                        "entry_id": "57218b85-91b3-3e3d-ada7-e311d6e42d59",
                        "glosses": [
                            "Gegenstand, der ganz oder teilweise durch eine Fälschung entstanden ist, der also nicht das ist, was er zu sein scheint"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5532ffd5-9f71-4b3d-813c-9ee840c97d63",
                                "sense_id": "616b401b-93b2-3509-bf65-6cdff60249a9",
                                "text": "„Ein Goldring unbekannter Herkunft (…) mit älteren Runen in einem Oxforder Museum erwies sich jüngst als Falsifikat […].“"
                            },
                            {
                                "example_id": "9dd34367-a876-43f8-a644-e58ee65fca75",
                                "sense_id": "616b401b-93b2-3509-bf65-6cdff60249a9",
                                "text": "„Als die Masse glutrot kochte, goss er daraus gleich zwei Falsifikate.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
