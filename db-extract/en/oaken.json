                        "entry_id": "82362273-060f-3021-92bf-e3fe7393786c",
                        "glosses": [
                            "Made from the wood of the oak tree. Also in metaphorical uses, suggesting robustness."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "c95caeac-9ce1-4eaa-a277-4c69a41a9bd5",
                                "sense_id": "bebe7000-305e-3373-93d2-6e1adc9c85f9",
                                "text": "Captain Jemmy, taking up three bottles one after another and finding them all empty, ordered up three more, and drew his chair up to the hearth, where he sat kicking the oaken logs viciously with his long legs."
                            }
                        ]
