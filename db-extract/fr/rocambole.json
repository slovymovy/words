                    {
                        "sense_id": "1640dbb9-f984-3a42-8636-54a7910a0e71",
                        "entry_id": "829e162f-848b-33cd-81ef-1c6024a1b0b9",
                        "glosses": [
                            "Allium scorodoprasum, espèce d’ail moins fort que l’ail ordinaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9925737-f26c-4395-81eb-d5bed14522af",
                                "sense_id": "1640dbb9-f984-3a42-8636-54a7910a0e71",
                                "text": "À Paris, on confond souvent la rocambole avec l’échalote, quoique deux plantes très différentes."
                            },
                            {
                                "example_id": "09479d77-7532-4a23-9b10-d22f6872c9c0",
                                "sense_id": "1640dbb9-f984-3a42-8636-54a7910a0e71",
                                "text": "Si vous voulez les mettre en entrée, enveloppez-les de papier, et les servez avec ragoût d'olives, ragoût de montans de cardons, aux navets , aux truffes, ou sauce à la rocambole."
                            }
                        ]
                    },
                    {
                        "sense_id": "5371bad9-661f-3e7d-b3df-032b2b3c7ac8",
                        "entry_id": "829e162f-848b-33cd-81ef-1c6024a1b0b9",
                        "glosses": [
                            "Faribole ; propos en l'air ; plaisanterie usée."
                        ],
                        "tags": [
                            "dated",
                            "familiar",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "f450feee-9bfb-4c63-97c8-54c4e8bc4e55",
                                "sense_id": "5371bad9-661f-3e7d-b3df-032b2b3c7ac8",
                                "text": "Quelle rocambole me contez-vous avec la fin du mois ?"
                            }
                        ]
