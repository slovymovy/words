{
    "word_family": [
        "sober",
        "soberly",
        "soberness"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5440d2cb-d45f-32f1-b590-8fd5a226834a",
                    "sense_definition": "The quality or state of not being intoxicated by alcohol or drugs",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "state of being sober",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After years of struggling with addiction, he finally achieved long-term <w>sobriety</w>.",
                            "target_lang_translations": {
                                "ru": "После многих лет борьбы с зависимостью он, наконец, достиг многолетней <w>трезвости</w>."
                            }
                        },
                        {
                            "text": "The support group helps its members maintain their <w>sobriety</w> through regular meetings.",
                            "target_lang_translations": {
                                "ru": "Группа поддержки помогает своим участникам сохранять <w>трезвость</w> благодаря регулярным встречам."
                            }
                        }
                    ],
                    "synonyms": [
                        "soberness"
                    ],
                    "antonyms": [
                        "drunkenness",
                        "intoxication"
                    ],
                    "common_phrases": [
                        "maintain sobriety",
                        "long-term sobriety",
                        "period of sobriety"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние или качество человека, не находящегося под воздействием алкоголя или наркотиков"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трезвость",
                                "target_lang_sense_clarification": "состояние не в состоянии опьянения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8ae62061-8abd-3879-ab5e-e5fe75bef35d",
                    "sense_definition": "A state of seriousness, moderation, or gravity in one's behavior or attitude",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "seriousness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>sobriety</w> of the occasion was reflected in the quiet and respectful behavior of the guests.",
                            "target_lang_translations": {
                                "ru": "<w>Серьезность</w> момента отражалась в тихом и почтительном поведении гостей."
                            }
                        },
                        {
                            "text": "He spoke with a <w>sobriety</w> that made everyone realize the situation was very serious.",
                            "target_lang_translations": {
                                "ru": "Он говорил с такой <w>серьезностью</w>, что все поняли: ситуация крайне тяжелая."
                            }
                        }
                    ],
                    "common_phrases": [
                        "relative sobriety",
                        "air of sobriety"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние серьезности, умеренности или степенности в поведении или отношении"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "серьезность",
                                "target_lang_sense_clarification": "отсутствие легкомыслия"
                            },
                            {
                                "target_lang_word": "степенность",
                                "target_lang_sense_clarification": "рассудительно-спокойное поведение"
                            },
                            {
                                "target_lang_word": "сдержанность",
                                "target_lang_sense_clarification": "умеренность в проявлении чувств"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c3041ae3-8f34-3718-a60b-7abe9700307e",
                    "sense_definition": "The quality of having sound, sensible, and balanced judgment",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "judgment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The judge was known for the intellectual <w>sobriety</w> he brought to every complex legal case.",
                            "target_lang_translations": {
                                "ru": "Судья был известен интеллектуальной <w>трезвостью</w>, которую он проявлял в каждом сложном судебном деле."
                            }
                        },
                        {
                            "text": "We need a leader who can approach these economic challenges with <w>sobriety</w> and wisdom.",
                            "target_lang_translations": {
                                "ru": "Нам нужен лидер, который сможет подойти к этим экономическим вызовам со <w>здравомыслием</w> и мудростью."
                            }
                        }
                    ],
                    "common_phrases": [
                        "intellectual sobriety"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способность к здравому, разумному и взвешенному суждению"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трезвость",
                                "target_lang_sense_clarification": "здравая рассудительность и отсутствие иллюзий"
                            },
                            {
                                "target_lang_word": "благоразумие",
                                "target_lang_sense_clarification": "способность действовать обдуманно"
                            },
                            {
                                "target_lang_word": "здравомыслие",
                                "target_lang_sense_clarification": "наличие здравого смысла"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "623ed1b6-d94c-3a35-ab9d-57eaec28f880",
                    "sense_definition": "The quality of being plain or subdued in color, style, or appearance",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>sobriety</w> of her dark suit was appropriate for the formal business meeting.",
                            "target_lang_translations": {
                                "ru": "<w>Строгость</w> ее темного костюма была уместна для официальной деловой встречи."
                            }
                        },
                        {
                            "text": "The architect chose a design of remarkable <w>sobriety</w> to match the historic neighborhood.",
                            "target_lang_translations": {
                                "ru": "Архитектор выбрал дизайн, отличающийся удивительной <w>сдержанностью</w>, чтобы он соответствовал историческому району."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sobriety of dress"
                    ],
                    "target_lang_definitions": {
                        "ru": "Качество простоты или неброскости в цвете, стиле или внешнем виде"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "строгость",
                                "target_lang_sense_clarification": "отсутствие лишних украшений в стиле"
                            },
                            {
                                "target_lang_word": "сдержанность",
                                "target_lang_sense_clarification": "неброскость оформления"
                            },
                            {
                                "target_lang_word": "умеренность",
                                "target_lang_sense_clarification": "простота внешнего вида"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}