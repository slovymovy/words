{
    "word_family": [
        "porzucać",
        "porzucenie",
        "odrzucić",
        "zarzucić",
        "rzucić"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "004d0590-3b76-3029-896c-81fe3ae68042",
                    "sense_definition": "zostawić kogoś lub coś, przestać się czymś zajmować bądź zrezygnować z dalszych działań",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "opuszczenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chociaż był dobrym uczniem, <w>porzucił</w> szkołę w wieku trzynastu lat.",
                            "target_lang_translations": {
                                "ru": "Хотя он был хорошим учеником, он <w>бросил</w> школу в возрасте тринадцати лет."
                            }
                        },
                        {
                            "text": "W obliczu zbliżającej się burzy turyści postanowili <w>porzucić</w> plany dalszej wspinaczki.",
                            "target_lang_translations": {
                                "ru": "Перед лицом приближающейся бури туристы решили <w>оставить</w> планы дальнейшего восхождения."
                            }
                        }
                    ],
                    "common_phrases": [
                        "porzucić plany",
                        "porzucić nadzieję",
                        "porzucić szkołę"
                    ],
                    "target_lang_definitions": {
                        "ru": "оставить кого-либо или что-либо, перестать заниматься чем-либо или отказаться от дальнейших действий"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бросить",
                                "target_lang_sense_clarification": "перестать заниматься чем-либо, отказаться от планов или учебы"
                            },
                            {
                                "target_lang_word": "оставить",
                                "target_lang_sense_clarification": "отказаться от намерений или надежд"
                            },
                            {
                                "target_lang_word": "покинуть",
                                "target_lang_sense_clarification": "уйти из школы, прекратить участие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a1c34687-a793-3f32-b078-30c192969c01",
                    "sense_definition": "zakończyć związek z partnerem i odejść od niego",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "relacje",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Marek niespodziewanie <w>porzucił</w> swoją narzeczoną tuż przed planowanym ślubem.",
                            "target_lang_translations": {
                                "ru": "Марек неожиданно <w>бросил</w> свою невесту прямо перед запланированной свадьбой."
                            }
                        },
                        {
                            "text": "Po wielu latach małżeństwa mąż <w>porzucił</w> żonę i wyjechał za granicę.",
                            "target_lang_translations": {
                                "ru": "После многих лет брака муж <w>бросил</w> жену и уехал за границу."
                            }
                        }
                    ],
                    "common_phrases": [
                        "porzucić żonę",
                        "porzucić rodzinę"
                    ],
                    "target_lang_definitions": {
                        "ru": "разорвать отношения с партнером и уйти от него"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бросить",
                                "target_lang_sense_clarification": "разорвать отношения с партнером, уйти от кого-либо"
                            },
                            {
                                "target_lang_word": "покинуть",
                                "target_lang_sense_clarification": "уйти от партнера или из семьи"
                            },
                            {
                                "target_lang_word": "оставить",
                                "target_lang_sense_clarification": "уйти от кого-либо, оставить семью"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "060f90ea-cd24-36b7-8079-79688755af04",
                    "sense_definition": "zrezygnować z zatrudnienia lub przestać wykonywać dotychczasową pracę",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "praca",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Z powodu ciągłego stresu postanowił natychmiast <w>porzucić</w> pracę w korporacji.",
                            "target_lang_translations": {
                                "ru": "Из-за постоянного стресса он решил немедленно <w>бросить</w> работу в корпорации."
                            }
                        },
                        {
                            "text": "Zdecydował się <w>porzucić</w> etat i zacząć prowadzić własną działalność gospodarczą.",
                            "target_lang_translations": {
                                "ru": "Он решил <w>уйти с</w> постоянной работы и начать вести собственный бизнес."
                            }
                        }
                    ],
                    "common_phrases": [
                        "porzucić pracę",
                        "porzucić posadę"
                    ],
                    "target_lang_definitions": {
                        "ru": "уволиться или перестать выполнять прежнюю работу"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бросить",
                                "target_lang_sense_clarification": "уволиться, перестать работать на прежнем месте"
                            },
                            {
                                "target_lang_word": "оставить",
                                "target_lang_sense_clarification": "оставить должность или службу"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}