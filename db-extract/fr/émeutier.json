                                "target_senses": [
                                    {
                                        "sense_id": "b917d19b-c37b-3bc4-aa99-9185b1ee00ff",
                                        "entry_id": "48fc6f37-c03f-340e-8857-0c799e7aeaca",
                                        "glosses": [
                                            "One who riots; part of the unruly violent crowd causing a riot."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e493421-048a-45ff-a042-ec93233d5c53",
                                                "sense_id": "b917d19b-c37b-3bc4-aa99-9185b1ee00ff",
                                                "text": "The rioters had erected a makeshift barricade and were pelting the police with rocks from behind it."
                                            },
                                            {
                                                "example_id": "e5f5b4b7-f561-4d50-9698-3cf2f19b4b02",
                                                "sense_id": "b917d19b-c37b-3bc4-aa99-9185b1ee00ff",
                                                "text": "The rioters overshadowed the message of peaceful protesters on prior days: They had called for justice for Gray, a 25-year-old African-American man who died from spinal injuries after police arrested him this month."
                                            },
                                            {
                                                "example_id": "c73e6cab-b5ad-4607-a916-e8f53719a9d7",
                                                "sense_id": "b917d19b-c37b-3bc4-aa99-9185b1ee00ff",
                                                "text": "High-profile January 6 rioter Guy Reffitt showed up in Washington, DC, on Wednesday to celebrate with his wife and supporters who’d been hoping for his release from federal detention for months."
                                            }
                                        ]
                                    }
                                ]
                            }
