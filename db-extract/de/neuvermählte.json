                        "glosses": [
                            "weibliche Person, die erst seit kurzem verheiratet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9113bc86-2888-4a3b-9706-1a5e1e5e4dac",
                                "sense_id": "96d133a8-5915-345d-a7c7-fdbaa5619b5c",
                                "text": "„Das Gesicht der Neuvermählten verriet deren tiefe Befriedigung; als ich sie dazu hundertmal beglückwünschte, bestätigte sie es mir und sagte, das käme hauptsächlich daher, daß ihr Rosalie in Genua sicherlich eine wahre Freundin sein würde.“"
                            }
                        ],
