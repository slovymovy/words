                    },
                    {
                        "translation_id": "76bb2185-8b3c-45c8-83d7-7a3f421b5ff8",
                        "source_entry_id": "d8de1dde-16f4-3137-b833-de6dec2f841f",
                        "source_sense_id": "2d9430cf-53aa-3712-9dd6-f093fd82749e",
                        "source_sense_description": "person who practices necromancy",
                        "target_lang_word": "nécromant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nécromant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8022f9c8-c86a-36e1-a701-cbd90e8c284a",
                                        "entry_id": "00430891-b909-3fb8-9900-2343c77b8533",
                                        "glosses": [
                                            "Celui qui fait profession de nécromancie."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78e52798-27b1-42a1-ba8d-d2239c6f98b7",
                                                "sense_id": "8022f9c8-c86a-36e1-a701-cbd90e8c284a",
                                                "text": "« Merci ! Nécromant » cria-t-il bientôt, hors d’haleine. Et il giguait toujours."
                                            },
                                            {
                                                "example_id": "e185e882-92d9-4b6b-868f-f216b9a33da9",
                                                "sense_id": "8022f9c8-c86a-36e1-a701-cbd90e8c284a",
                                                "text": "Quoi qu’il en soit, la prédiction du nécromant était restée gravée dans l’imagination de ce pauvre Édouard […]"
                                            },
                                            {
                                                "example_id": "9d877f24-0400-4ec2-a10c-0371a9cbe448",
                                                "sense_id": "8022f9c8-c86a-36e1-a701-cbd90e8c284a",
                                                "text": "Peste ! monsieur l’amiral est donc nécromant, pour savoir ainsi ce qui se fait à trente ou quarante lieues de distance !"
                                            },
                                            {
                                                "example_id": "c3bd442b-e82d-4c90-a197-63d57ceaeec0",
                                                "sense_id": "8022f9c8-c86a-36e1-a701-cbd90e8c284a",
                                                "text": "Une grande simarre de velours noir, (...), servant pour les rôles de pontife ou de nécromant, fit l'office de drap mortuaire avec assez de décence."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3b18d045-e6a8-48fe-b4e0-9fae02615dd0",
