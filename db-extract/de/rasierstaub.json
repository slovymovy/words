                ],
                "senses": [
                    {
                        "sense_id": "9a295c54-d9b8-3f4c-92b7-2b8796dc5c3e",
                        "entry_id": "c35a8f78-7c15-3a5a-a64d-f62a4b9d66f1",
                        "glosses": [
                            "Abfallprodukt der regelmäßigen Rasur mit dem Elektrorasierer, bestehend aus staubfein gehäckselten Haarstoppeln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13a62b19-0f21-43e1-96a2-e13ec6988f09",
                                "sense_id": "9a295c54-d9b8-3f4c-92b7-2b8796dc5c3e",
                                "text": "Man sollte nach jeder Rasur den Rasierstaub aus dem Rasierapparat ausputzen."
                            },
                            {
                                "example_id": "e43091b0-6268-47cc-aad1-2fdcc4c22c8c",
                                "sense_id": "9a295c54-d9b8-3f4c-92b7-2b8796dc5c3e",
                                "text": "Schalten Sie den Rasierer ca. 5–10 Sekunden lang ein, damit der Rasierstaub herausrieseln kann."
                            },
                            {
                                "example_id": "3379f020-63a9-4f64-9234-02195045c200",
                                "sense_id": "9a295c54-d9b8-3f4c-92b7-2b8796dc5c3e",
                                "text": "Blasen Sie die Stoppeln, Rasierstaub gründlich von den Folien und Klingen."
                            },
                            {
                                "example_id": "fdbe55a5-1300-46ee-9d17-bd0e405d702c",
                                "sense_id": "9a295c54-d9b8-3f4c-92b7-2b8796dc5c3e",
                                "text": "Ein weiterer Grund für die verstärkte Geräuschentwicklung (sowohl bei den Mehrfach- als auch bei den Einfachsystemen) kann Rasierstaub sein, der zwischen dem Schwenkrahmen und dem Scherfolienmagazin sitzt."
                            },
                            {
                                "example_id": "874fa9de-3f4e-4e41-bf80-bf2895a979fb",
                                "sense_id": "9a295c54-d9b8-3f4c-92b7-2b8796dc5c3e",
                                "text": "Da je nach Stärke des Bartwuchses etc. und den Rasiergewohnheiten des jeweiligen Benutzers sich während einer vorgegebenen Zeit oder Anzahl von Rasuren unterschiedliche Mengen von Rasierstaub im Scherkopf ansammeln, kann mit derartigen Verfahren der Zeitpunkt für die Notwendigkeit einer Reinigung nur relativ ungenau angegeben werden."
                            },
                            {
                                "example_id": "e4dcbe81-077d-486d-a499-a7d7a7ed7528",
                                "sense_id": "9a295c54-d9b8-3f4c-92b7-2b8796dc5c3e",
                                "text": "[…] und auch dann bleiben die Gleitbedingungen unter dem Einfluss von Rasierstaub und Hautfett über einen längeren Benutzungszeitraum nicht konstant."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
