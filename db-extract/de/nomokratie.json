                "senses": [
                    {
                        "sense_id": "6b595b2c-3212-3608-bda8-24545d5b62d8",
                        "entry_id": "73ecba9f-8e15-3b5e-8d7b-7a3f727ca30c",
                        "glosses": [
                            "staatliche Herrschaft auf der Grundlage von und in Übereinstimmung mit geschriebenem Recht, die ein Recht auf Widerstand ausschließt"
                        ],
                        "tags": [
                            "Rechtswissenschaft",
                            "Politologie"
                        ],
                        "examples": [
                            {
                                "example_id": "7446e4ef-8299-49c6-8e44-5ee6388e241a",
                                "sense_id": "6b595b2c-3212-3608-bda8-24545d5b62d8",
                                "text": "„So mancher Staat beginnt seinem rhetorischen Anspruch nach als Nomokratie und Demokratie, entpuppt sich aber recht früh als Bürokratie und Kleptokratie.“"
                            },
                            {
                                "example_id": "e74c26bd-f87f-49cd-99b6-6e8a71087a51",
                                "sense_id": "6b595b2c-3212-3608-bda8-24545d5b62d8",
                                "text": "Demokratie führt nicht notwendig zu Nomokratie, es kann durchaus sein, dass sich die Mehrheit für besondere Inhalte entscheidet, die nicht auch allgemeingültig sind."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
