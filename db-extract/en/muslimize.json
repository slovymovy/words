                "senses": [
                    {
                        "sense_id": "e5a9de54-c656-3e7d-b7bb-a1e09b5969c6",
                        "entry_id": "878d75fa-f8f4-3501-9bf1-3935b13183f5",
                        "glosses": [
                            "To make Muslim; to increase the Muslim character of."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "94555415-bf76-4edf-8991-cfc14d62edfd",
                                "sense_id": "e5a9de54-c656-3e7d-b7bb-a1e09b5969c6",
                                "text": "These captives are all christians when caught, but are immediately Moslemised."
                            },
                            {
                                "example_id": "0054a994-c813-409f-b9f6-82a6b43f317d",
                                "sense_id": "e5a9de54-c656-3e7d-b7bb-a1e09b5969c6",
                                "text": "In 1878, two years after Gordon had been appointed governor-general of the whole Sudan, Emin Effendi (he had Moslemized himself) was appointed governor of the Equatorial Province, which he found completely disorganized and demoralized, the happy hunting-ground of the slave raider."
                            },
                            {
                                "example_id": "aa64f1c7-cfa0-4d14-bd65-9ee61e9f586e",
                                "sense_id": "e5a9de54-c656-3e7d-b7bb-a1e09b5969c6",
                                "text": "As for the Muslimized Malays, they live mainly in the sourthernmost changwads (provinces) that border on Malaysia, although there are small communities of them in and near Bangkok."
                            }
                        ]
                    }
