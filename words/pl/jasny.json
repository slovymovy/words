                },
                {
                    "sense_id": "37dced4f-a98e-34d1-86bb-48f7e15aed04",
                    "sense_definition": "Mający kolor zbliżony do białego, mało intensywny lub blady (dotyczy przedmiotów, włosów, cery).",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "color_visual",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ona ma piękne, <w>jasne</w> włosy i niebieskie oczy.",
                            "target_lang_translations": {
                                "ru": "У нее красивые <w>светлые</w> волосы и голубые глаза.",
                                "de": "Sie hat wunderschönes, <w>helles</w> Haar und blaue Augen."
                            }
                        },
                        {
                            "text": "Na lato wolę kupować ubrania w <w>jasnych</w> kolorach, bo jest w nich chłodniej.",
                            "target_lang_translations": {
                                "ru": "На лето я предпочитаю покупать одежду <w>светлых</w> тонов, так как в ней прохладнее.",
                                "de": "Im Sommer kaufe ich lieber Kleidung in <w>hellen</w> Farben, weil es darin kühler ist."
                            }
