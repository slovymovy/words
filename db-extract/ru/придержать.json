                "senses": [
                    {
                        "sense_id": "2b566e31-6ac3-33b0-9520-870dd9e04622",
                        "entry_id": "482e4032-a079-3525-bb5f-61084504fccf",
                        "glosses": [
                            "to hold, to hold back"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "449a52c5-e63d-4f06-9c63-6ea5ca7aefa0",
                                "sense_id": "2b566e31-6ac3-33b0-9520-870dd9e04622",
                                "text": "Придержи́те лифт!",
                                "translation": "Hold the elevator!",
                                "english": "Hold the elevator!"
                            },
                            {
                                "example_id": "6410317f-dc51-43f1-b710-d820f7b0ba28",
                                "sense_id": "2b566e31-6ac3-33b0-9520-870dd9e04622",
                                "text": "придержа́ть язы́к",
                                "translation": "to hold one's tongue (a colloquial way to say \"to be quiet\")",
                                "english": "to hold one's tongue (a colloquial way to say \"to be quiet\")"
                            },
                            {
                                "example_id": "ca8575d3-bd6c-4c39-8f48-7e95e6a6711f",
                                "sense_id": "2b566e31-6ac3-33b0-9520-870dd9e04622",
                                "text": "Солодо́вников вбежа́л на крыльцо́, откры́л тяжёлую дверь на пру­жи́не, придержа́л её, чтоб не гро́хнула...",
                                "translation": "Solodovnikov ran up to the porch, pushed open the heavy door on a spring and held it so that it wouldn't bang.",
                                "english": "Solodovnikov ran up to the porch, pushed open the heavy door on a spring and held it so that it wouldn't bang."
                            }
                        ]
                    }
                ],
