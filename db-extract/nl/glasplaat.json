                                    {
                                        "sense_id": "e140e98c-51d6-3be2-b585-aab4fef8ca85",
                                        "entry_id": "9c287ba2-ec27-3ce3-b74d-66534d21caae",
                                        "glosses": [
                                            "A distinct level or stage within a game."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5611c163-d6bb-4a19-a824-b633d9d7abe1",
                                                "sense_id": "e140e98c-51d6-3be2-b585-aab4fef8ca85",
                                                "text": "The gecko moves from left to right and you must catch him when he calls. […] On the second sheet you must stand under the Gecko in the tree and jump, and on the third sheet you must catch the Gecko's friend."
                                            },
                                            {
                                                "example_id": "0b6d897f-6978-4160-ab6a-fb538f197b19",
                                                "sense_id": "e140e98c-51d6-3be2-b585-aab4fef8ca85",
                                                "text": "If you land safely you will gain 30 extra points and move to the next sheet."
                                            },
                                            {
                                                "example_id": "3af93341-72c7-4e6d-84f2-4265bfe34fbb",
                                                "sense_id": "e140e98c-51d6-3be2-b585-aab4fef8ca85",
                                                "text": "What distinguishes Eskimo Eddie from the others is that it has two totally different sheets in the game. […] In the first sheet, Frogger style, you have to rescue Percy penguin from Growler the bear."
                                            }
                                        ]
                                    }
                                ]
                            },
