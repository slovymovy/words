                                "target_senses": [
                                    {
                                        "sense_id": "b73c16bd-72a0-3f51-bb84-917cc7b95568",
                                        "entry_id": "3ce67ac5-cbd6-393f-9e98-856c5335f30e",
                                        "glosses": [
                                            "Of, pertaining to, or characteristic of Minecraft."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a459881-baa1-4ea2-a304-2ec325645506",
                                                "sense_id": "b73c16bd-72a0-3f51-bb84-917cc7b95568",
                                                "text": "Stranded 2 - a fun little game, now available for free. A bit minecrafty."
                                            },
                                            {
                                                "example_id": "7f138a1d-8e4d-4962-8c3e-5b8bd424eb3f",
                                                "sense_id": "b73c16bd-72a0-3f51-bb84-917cc7b95568",
                                                "text": "If you've been living in a massively multiplayer cave for the last few months, it's the pretty Minecrafty prologue to the ambitious Everquest Next, which will let you build and decorate and even alter the terrain of the world/s as you see fit."
                                            },
                                            {
                                                "example_id": "480a166e-1694-4bcb-89b3-11b38017da57",
                                                "sense_id": "b73c16bd-72a0-3f51-bb84-917cc7b95568",
                                                "text": "If you've been busy mining, farming, and doing all the other Minecrafty things that get you established, […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
