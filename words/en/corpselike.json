            "senses": [
                {
                    "sense_id": "dd30b05c-f0bd-3b32-9dd4-366b2292a8eb",
                    "sense_definition": "Resembling or characteristic of a dead body, especially in being pale, cold, or motionless.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient's skin had turned a <w>corpselike</w> shade of gray after days of high fever.",
                            "target_lang_translations": {
                                "ru": "После нескольких дней высокой температуры кожа пациента приобрела <w>мертвенно-серый</w> оттенок."
                            }
                        },
                        {
                            "text": "He lay in the hospital bed in <w>corpselike</w> stillness, barely showing any signs of breathing.",
                            "target_lang_translations": {
                                "ru": "Он лежал на больничной койке в <w>мертвенной</w> неподвижности, едва подавая признаки дыхания."
                            }
                        }
                    ],
                    "synonyms": [
                        "cadaverous",
                        "deathly"
                    ],
                    "antonyms": [
                        "lively",
                        "vibrant"
                    ],
                    "common_phrases": [
                        "corpselike pallor",
                        "corpselike stillness"
                    ],
                    "target_lang_definitions": {
                        "ru": "Напоминающий труп или характерный для него, особенно бледностью, холодом или неподвижностью; мертвенный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мертвенный",
