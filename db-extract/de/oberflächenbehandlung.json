                        "glosses": [
                            "Fertigungsverfahren zur Veränderung der Oberflächeneigenschaften eines Werkstoffs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1bd8d1e-3744-4fad-b527-08238813d282",
                                "sense_id": "91f9897b-8d13-3ef9-a056-d3baccac2a32",
                                "text": "Nitrieren und Borieren sind Verfahren zur Veränderung von Oberflächeneigenschaften eines Metallstückes"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "941708db-4596-3d3b-89c2-c70043084c88",
                        "entry_id": "de003458-b6f0-3757-a602-9225c10e28cf",
                        "glosses": [
                            "Maßnahme zur Instandsetzung von Straßen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37ac3253-11bf-4147-aa86-5a3a98240d7b",
                                "sense_id": "941708db-4596-3d3b-89c2-c70043084c88",
                                "text": "Bei der Oberflächenbehandlung wird die schadhafte Straße zunächst mit einem Bindemittel eingesprüht und anschließend mit Splitt abgestreut und abgewalzt."
                            }
                        ],
                        "sense_index_json": "\"2\""
