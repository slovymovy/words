                "senses": [
                    {
                        "sense_id": "589a3891-c83d-3554-8f2f-ed2b75283373",
                        "entry_id": "9304edd7-6f2d-3117-924b-db22a667398c",
                        "glosses": [
                            "Gruppe der Studenten eines Landes, einer Hochschule"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81d61c0c-418b-4643-b450-39cb8ca19c05",
                                "sense_id": "589a3891-c83d-3554-8f2f-ed2b75283373",
                                "text": "„Kaum eine andere Universität und Studentenschaft einer Stadt in Deutschland war schon so früh von braunem, Menschen-verachtendem Gedankengut durchsetzt.“"
                            },
                            {
                                "example_id": "7bdfc877-9efc-41da-b87a-4e4c2c1f540b",
                                "sense_id": "589a3891-c83d-3554-8f2f-ed2b75283373",
                                "text": "„Darüber hinaus scheint ein zunehmender Teil der Studentenschaft trotz vieler offensichtlicher Widersprüche in der offiziellen Geschichtsversion aus Bequemlichkeit sich selbst eine Abweichung von der Buchinterpretation der Ereignisse zu verbieten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
