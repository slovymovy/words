                        "entry_id": "2157ea5b-774f-3eee-92ab-778643b0bcbf",
                        "glosses": [
                            "Preis, der für einen Flug zu bezahlen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "261ccd1a-5bcb-4320-b8ad-218630cbfed3",
                                "sense_id": "71cd27c5-5ead-3eac-92e2-2054bd64915e",
                                "text": "„Online-Reisevermittler müssen vor dem Vertragsabschluss nicht nur den Flugpreis, sondern auch Extrakosten für die Gepäckaufgabe angeben.“"
                            },
                            {
                                "example_id": "f02afc7c-8c9f-47a1-be5b-a2443251d485",
                                "sense_id": "71cd27c5-5ead-3eac-92e2-2054bd64915e",
                                "text": "„Die Karlsruher Bundesrichter wollten vom Gerichtshof in Luxemburg wissen, ob nach der maßgeblichen EU-Verordnung die Flugpreise in einer bestimmten Währung angegeben werden müssen.“"
                            }
                        ],
