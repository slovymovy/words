                {
                    "sense_id": "7410cfad-ec8d-3c70-86a8-2091d71ed222",
                    "sense_definition": "D'une manière prudente, sensée et avisée.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "discernement_prudence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Devant la tempête qui approchait, ils ont <w>sagement</w> décidé de reporter leur voyage en montagne.",
                            "target_lang_translations": {
                                "en": "Facing the approaching storm, they <w>wisely</w> decided to postpone their mountain trip.",
                                "ru": "Перед надвигающейся бурей они <w>разумно</w> решили отложить поездку в горы.",
                                "de": "Angesichts des heraufziehenden Sturms haben sie <w>klugerweise</w> beschlossen, ihre Bergreise zu verschieben.",
                                "es": "Ante la tormenta que se acercaba, decidieron <w>prudentemente</w> aplazar su viaje a la montaña.",
                                "zh": "面对逼近的暴风雨，他们<w>明智地</w>决定推迟去山区的旅行。"
                            }
                        },
                        {
                            "text": "Il a toujours géré <w>sagement</w> son budget afin d'éviter les mauvaises surprises.",
                            "target_lang_translations": {
                                "en": "He has always managed his budget <w>wisely</w> to avoid nasty surprises.",
                                "ru": "Он всегда <w>разумно</w> вёл свой бюджет, чтобы избежать неприятных сюрпризов.",
                                "de": "Er hat sein Budget stets <w>umsichtig</w> verwaltet, um unangenehme Überraschungen zu vermeiden.",
                                "es": "Siempre ha administrado <w>sensatamente</w> su presupuesto para evitar malas sorpresas.",
                                "zh": "他一直<w>审慎地</w>管理自己的预算，以免遇到糟糕的意外。"
                            }
                        }
                    ],
                    "synonyms": [
                        "judicieusement",
                        "prudemment",
                        "raisonnablement"
