                        "entry_id": "43c2cbee-d097-3a72-8ff8-730ebf647d12",
                        "glosses": [
                            "das Skispringen auf einer Schanze mit einem Konstruktionspunkt von mehr als 145 Metern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "866c8b9c-4f38-4aca-aad4-2623fa6d9aeb",
                                "sense_id": "c8ef0d20-ead8-3d05-908f-a7e2a5944142",
                                "text": "Er belegte den ersten Rang beim Skifliegen."
                            },
                            {
                                "example_id": "7e34702c-fbe2-4471-bab0-e55ddc67d68f",
                                "sense_id": "c8ef0d20-ead8-3d05-908f-a7e2a5944142",
                                "text": "„Skisprung-Olympiasieger Martin Schmitt kann sich beim Skifliegen Weiten von bis zu 300 Meter vorstellen.“"
                            },
                            {
                                "example_id": "d6f9e980-8536-4ba7-ad8a-4faea5653dcc",
                                "sense_id": "c8ef0d20-ead8-3d05-908f-a7e2a5944142",
                                "text": "„Kurz vor Ende der Saison nähert sich der Österreicher Stefan Kraft dem Gesamtsieg - und stellt beim Skifliegen einen Weltrekord auf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
