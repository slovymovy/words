                        "glosses": [
                            "de afsterving en ontbinding van een levend organisme"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b71ee74-8029-493e-8613-6038c6857313",
                                "sense_id": "d4d667f5-b875-3583-9231-29b8b578fd13",
                                "text": "Het koudvuur had een rottingsstank."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1f7b1ee2-9e7e-4a38-882e-8cc2138d7c04",
                        "source_entry_id": "df9bebe9-d03f-331b-9fb3-cedd065da474",
                        "source_sense_id": "d4d667f5-b875-3583-9231-29b8b578fd13",
                        "source_sense_description": "de afsterving en ontbinding van een levend organisme",
                        "target_lang_word": "Gangrän",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gangrän",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "77a612e7-c894-3512-ab79-63a2da0926b8",
                                        "entry_id": "b1515f8b-428a-357f-9978-e97846c1571d",
                                        "glosses": [
                                            "eine Gewebsnekrose, meist infolge von Blutunterversorgung, bei der das betroffene Gewebe durch Verwesung und Autolyse zerfällt und sich als Folge von Hämoglobinabbau verfärbt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f9460d9-9644-435d-b6b3-3f53d3dd0072",
                                                "sense_id": "77a612e7-c894-3512-ab79-63a2da0926b8",
                                                "text": "„Seit das Gangrän in seinem rechten Bein ausgebrochen war, hatte er keine Schmerzen mehr, und mit dem Schmerz war die Panik verschwunden, und jetzt empfand er nur noch eine große Müdigkeit und Wut darüber, dass es aus mit ihm war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "33e5c833-cf56-4e29-9fd7-81f7db1c597b",
                        "source_entry_id": "df9bebe9-d03f-331b-9fb3-cedd065da474",
                        "source_sense_id": "d4d667f5-b875-3583-9231-29b8b578fd13",
                        "source_sense_description": "de afsterving en ontbinding van een levend organisme",
                        "target_lang_word": "Brand",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Brand",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e51b0f60-11f8-35d0-96f8-764dd9535ac6",
                                        "entry_id": "8990442c-5524-3054-97fa-817276956bd8",
                                        "glosses": [
                                            "unkontrolliertes Feuer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08a4b349-96fe-4b52-9427-c9210b213fdf",
                                                "sense_id": "e51b0f60-11f8-35d0-96f8-764dd9535ac6",
                                                "text": "Der Brand verursachte einen großen Schaden."
                                            },
                                            {
                                                "example_id": "59972a50-9bca-4b1a-a1f6-4544d7a32a8f",
                                                "sense_id": "e51b0f60-11f8-35d0-96f8-764dd9535ac6",
                                                "text": "Auf einem Balkon in Wien-Donaustadt geriet eine Kühltruhe in Brand."
                                            },
                                            {
                                                "example_id": "8663e09d-fb62-4169-a70a-50fac5f1f6a7",
                                                "sense_id": "e51b0f60-11f8-35d0-96f8-764dd9535ac6",
                                                "text": "Doch keine Weltstadt ist jemals von einer solchen Doppelkatastrophe heimgesucht worden, wie sie London im Pestjahr 1665 und gleich darauf mit dem großen Londoner Brand von 1666 getroffen hat."
                                            },
                                            {
                                                "example_id": "fbff9327-cc57-4f7f-bdad-85d5a5d4efcc",
                                                "sense_id": "e51b0f60-11f8-35d0-96f8-764dd9535ac6",
                                                "text": "Aus irgend einem Grund ist die Vorstellung beliebt, daß Menschen von selbst in Brand geraten können."
                                            },
                                            {
                                                "example_id": "37987aa5-edee-4704-84c9-b29046d0182a",
                                                "sense_id": "e51b0f60-11f8-35d0-96f8-764dd9535ac6",
                                                "text": "Kaum ist diese ohngeschlachte Dornstauden zu solcher Ehr gelangt, da hat sie sich alsobald übernommen, die Untergebnen mit Feur und Brand verzehrt, auch alles unter sich über sich, d. h. durcheinander, geworfen."
                                            },
                                            {
                                                "example_id": "687d7de6-f350-44d6-b2ae-a83075464160",
                                                "sense_id": "e51b0f60-11f8-35d0-96f8-764dd9535ac6",
                                                "text": "„Brände entstehen, wenn ein brennbarer Stoff auf die Zündtemperatur erwärmt wird und Sauerstoff vorhanden ist.“"
                                            },
                                            {
                                                "example_id": "3c797f81-7e6e-48f6-875d-1f404ff5545d",
                                                "sense_id": "e51b0f60-11f8-35d0-96f8-764dd9535ac6",
                                                "text": "„Besondere Schwierigkeiten bereiten Brände von Benzin, öl oder Fett.“"
                                            },
                                            {
                                                "example_id": "0054a556-1fad-4935-b019-fbabb89f74b9",
                                                "sense_id": "e51b0f60-11f8-35d0-96f8-764dd9535ac6",
                                                "text": "„Ein Brand kann gelöscht werden, indem man den Brennstoff entfernt, die Sauerstoffzufuhr unterbindet oder die Zündtemperatur unterschreitet.“"
                                            },
                                            {
                                                "example_id": "eefac6a0-8a43-426d-b509-c3167897b18b",
                                                "sense_id": "e51b0f60-11f8-35d0-96f8-764dd9535ac6",
                                                "text": "„Die 73 Meter lange „Annika“ war am Freitagmorgen etwa 4,5 Kilometer vor Heiligendamm in Brand geraten.“"
                                            },
                                            {
                                                "example_id": "da8e2a85-209e-4ece-875f-20ff62cc0103",
                                                "sense_id": "e51b0f60-11f8-35d0-96f8-764dd9535ac6",
                                                "text": "„Mehrzweckschiffe und ein Seenotrettungskreuzer kühlten den Tanker mit großen Mengen Wasser und bekämpften den Brand von außen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "92b5f5ea-d830-3676-acf5-f21643f52bdf",
                                        "entry_id": "8990442c-5524-3054-97fa-817276956bd8",
                                        "glosses": [
                                            "großer Durst"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07e52152-bbc2-4dd1-a7e3-e5011eeeeafd",
                                                "sense_id": "92b5f5ea-d830-3676-acf5-f21643f52bdf",
                                                "text": "Ich habe einen riesigen Brand."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "7b400537-a5bb-35eb-83de-5fe175b453f8",
                                        "entry_id": "8990442c-5524-3054-97fa-817276956bd8",
                                        "glosses": [
                                            "das Absterben und Verfaulen von Körperstellen und Körperteilen, normalerweise hervorgerufen durch unzureichende Durchblutung, Infektionen oder Thrombosen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3998500a-ce5e-4219-863c-236ca00bd473",
                                                "sense_id": "7b400537-a5bb-35eb-83de-5fe175b453f8",
                                                "text": "Brand tritt meistens in und an den Extremitäten auf."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "64daf843-6e4a-3d37-b86d-2e2686ee6f07",
                                        "entry_id": "8990442c-5524-3054-97fa-817276956bd8",
                                        "glosses": [
                                            "das Ausbrennen von Keramik"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca6b326b-cd31-498a-bf72-252b1cab271f",
                                                "sense_id": "64daf843-6e4a-3d37-b86d-2e2686ee6f07",
                                                "text": "„Der Brand verleiht Ihrer Arbeit eine wesentlich höhere Überlebenschance, denn der ungebrannte, nur getrocknete Ton ist extrem empfindlich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "7c63c216-1568-3e93-bd66-6e8faf54ebb0",
                                        "entry_id": "8990442c-5524-3054-97fa-817276956bd8",
                                        "glosses": [
                                            "Kurzform für die Pflanzenkrankheiten Feuerbrand oder Bakterienbrand"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb094dc3-0bc1-4648-bde9-662edad2192d",
                                                "sense_id": "7c63c216-1568-3e93-bd66-6e8faf54ebb0",
                                                "text": "„Die Lage ist katastrophal. Der Super-GAU im Obstbau ist eingetreten. Wir haben einen flächendeckenden Brand!”, sagen die Pflanzenschutz-Fachleute der Ostschweiz."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "ae1f3f6a-44b2-31da-a058-7948e13ee542",
                                        "entry_id": "8990442c-5524-3054-97fa-817276956bd8",
                                        "glosses": [
                                            "alkoholisches Getränk (Branntwein) aus vergorenem Obst, Getreide oder Zuckerrohr"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Brand",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d42fda3e-88ab-3185-80a0-dad0138f1bea",
                                        "entry_id": "90836ad1-7051-3233-8f9f-e1d2f463c24c",
                                        "glosses": [
                                            "ein Stadtteil, ein Ortsteil von Aachen, Nordrhein-Westfalen, Deutschland"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47668a22-ecc1-4c31-bc92-5a36bdfabac0",
                                                "sense_id": "d42fda3e-88ab-3185-80a0-dad0138f1bea",
                                                "text": "Ich wohne in Brand."
                                            },
                                            {
                                                "example_id": "564a7797-74c6-472b-bad7-f3715a9bda8e",
                                                "sense_id": "d42fda3e-88ab-3185-80a0-dad0138f1bea",
                                                "text": "„Symbol des Stadtteils Brand ist der Brander Stier, dessen Bronzestatue auf dem Marktplatz steht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9a5c9d2d-a9a3-3cf7-8091-e725160e3bb7",
                                        "entry_id": "90836ad1-7051-3233-8f9f-e1d2f463c24c",
                                        "glosses": [
                                            "bis 1912 eigene Stadt, heute ein Ortsteil von Brand-Erbisdorf, Sachsen, D"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4b7b96b-9d98-4661-a7bd-1181e8c26d04",
                                                "sense_id": "9a5c9d2d-a9a3-3cf7-8091-e725160e3bb7",
                                                "text": "„Zu Beginn des 20. Jahrhunderts endete die lange Tradition des Silberbergbaus um Brand, wo ein Viertel der gesamten Silberausbeute Sachsens gewonnen wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4b34b502-928b-4634-9ca4-be45db2d607e",
                        "source_entry_id": "df9bebe9-d03f-331b-9fb3-cedd065da474",
                        "source_sense_id": "d4d667f5-b875-3583-9231-29b8b578fd13",
                        "source_sense_description": "de afsterving en ontbinding van een levend organisme",
                        "target_lang_word": "gangrene",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gangrene",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "160a37f0-3408-30f4-acde-0ced1bdf4f64",
                                        "entry_id": "cf59500d-0e04-3a68-830c-e6e3fd448f21",
                                        "glosses": [
                                            "The necrosis and rotting of flesh, usually caused by lack of blood supply."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a90c2e84-0226-4ca3-b12d-106376ae9f67",
                                                "sense_id": "160a37f0-3408-30f4-acde-0ced1bdf4f64",
                                                "text": "If gangrene sets in, we may have to amputate the foot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8cf22b52-42f9-34a8-9fd3-5bb5a764f36b",
                                        "entry_id": "cf59500d-0e04-3a68-830c-e6e3fd448f21",
                                        "glosses": [
                                            "A damaging or corrupting influence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "045bd68b-e00e-46ac-899d-e74b03dc1fa2",
                                                "sense_id": "8cf22b52-42f9-34a8-9fd3-5bb5a764f36b",
                                                "text": "Women should earn equal wages with men for equal work done. Child marriages and polygamy are a gangrene on society."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gangrene",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bad9b5ba-0943-32bb-a67b-1dc9a6232294",
                                        "entry_id": "463ee025-bf0f-371b-9bd7-2eaeff53290c",
                                        "glosses": [
                                            "To produce gangrene in."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4784e1d-4a62-432a-b0d3-539bdfe18a28",
                                                "sense_id": "bad9b5ba-0943-32bb-a67b-1dc9a6232294",
                                                "text": "Vulneration or section sometimes procures a Gangrene, when the vital Principle is so debilitated, or enormous by the would, that instead of a good suppuration and vigorous transmutation, a depraved matter is generated, which corrupts and gangrenes the part: and thus a small cut of a finger or Toe hath gangrened, and killed the person: but in greater Wounds, the danger is greater, as more frequently to happen."
                                            },
                                            {
                                                "example_id": "3f3ec4aa-c8a4-49b0-b8b9-7d0897fdd43b",
                                                "sense_id": "bad9b5ba-0943-32bb-a67b-1dc9a6232294",
                                                "text": "An intensely biting frost will gangrene the membrane ; a foggy state of the atmosphere, with low, black, stagnant exhalations, accompanied with sudden, frequent intermissions, interchanges, and oscillations of dryness and moisture, expansion and condensation, will corrupt and putrify both the membrane and the mucous discharge."
                                            },
                                            {
                                                "example_id": "812a7eaa-b181-4f13-8cde-ab3617209586",
                                                "sense_id": "bad9b5ba-0943-32bb-a67b-1dc9a6232294",
                                                "text": "For where it chances to be successful, it is like the copper shot of the Mexicans, which gangrenes the wound."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a141f28-626c-3380-ab23-84dbbf2a5e07",
                                        "entry_id": "463ee025-bf0f-371b-9bd7-2eaeff53290c",
                                        "glosses": [
                                            "To be affected with gangrene."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2f97ea5-9c11-4fc1-a757-c36179b8cc2d",
                                                "sense_id": "9a141f28-626c-3380-ab23-84dbbf2a5e07",
                                                "text": "If a man had a sore leg, and he should go to an honest, judicious chirurgeon, and he should only bid him keep it warm, and anoint it with such an oil, (an oil well known) that would do the cure; haply he would not much regard him, because he knows the medicine, beforehand an ordinary medicine; but if he should go to a surgeon that should tell him, your leg will gangrene within three days, and it must be cut off, and you will die, unless you do something that I could tell you, what listening there would be to this man?"
                                            },
                                            {
                                                "example_id": "2ed63a8c-1377-4f56-b0cb-a9fd6c3aa83f",
                                                "sense_id": "9a141f28-626c-3380-ab23-84dbbf2a5e07",
                                                "text": "The leg will gangrene if the superficial femoral vessels be torn."
                                            },
                                            {
                                                "example_id": "ef502132-a507-457c-afce-9605283470b8",
                                                "sense_id": "9a141f28-626c-3380-ab23-84dbbf2a5e07",
                                                "text": "If not, the toe will gangrene and fall off."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d38a0015-ed22-3e17-add0-973d5fe8af1c",
                                        "entry_id": "463ee025-bf0f-371b-9bd7-2eaeff53290c",
                                        "glosses": [
                                            "To corrupt; To cause to become degenerate."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "075cfc29-e8f7-401f-b087-0495cb0ca63e",
                                                "sense_id": "d38a0015-ed22-3e17-add0-973d5fe8af1c",
                                                "text": "That is true,” replied Almira, “nothing can be performed without labor, and where there is labor there will be discontent, and where there is no labor there will be heart-burning and jealousy about insignificant trifles, such as gangrenes the real pleasures of contemplation within these walls; walls, which would otherwise hold out an asylum, much to be prized by those who have been unfortunate, who have lost all their friends, or who are weary of the world.\""
                                            },
                                            {
                                                "example_id": "a89d4fb2-6f4c-40fc-b9ca-594600498620",
                                                "sense_id": "d38a0015-ed22-3e17-add0-973d5fe8af1c",
                                                "text": "The Stuart Restoration period was a necessary sequence of the Puritan period, and there is a similar cause for the sensualism that gangrenes the heart of our morbidly prudish Society of to-day."
                                            },
                                            {
                                                "example_id": "717a07a5-d082-4ab1-8c34-0d8e4b5cb003",
                                                "sense_id": "d38a0015-ed22-3e17-add0-973d5fe8af1c",
                                                "text": "The same delusion will gangrene England within the lifetime of most men of military age unless she will realize that gold is dross ; that her poets, her artists, and her scholars are her very soul."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
