                                        "entry_id": "d6ea56fb-33a4-3be9-9cbb-ef21d38a1a75",
                                        "glosses": [
                                            "Échantillonnage qui donne une idée de la marchandise proposée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b741881-51a1-4d2e-8c7f-b777800bb52c",
                                                "sense_id": "dd631287-8c49-3751-894c-0aa8166704b5",
                                                "text": "Un album de références."
                                            }
                                        ]
                                    },
