                "senses": [
                    {
                        "sense_id": "95e7dcd6-3e2d-3835-838c-5fe35cc28977",
                        "entry_id": "299ae436-e96a-350a-b0e7-b60446672e23",
                        "glosses": [
                            "een vrouw die in het huwelijk treedt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "745fe56a-676e-443d-874e-35f2502eac72",
                                "sense_id": "95e7dcd6-3e2d-3835-838c-5fe35cc28977",
                                "text": "Ze was een stralende bruid op die prachtige dag."
                            },
                            {
                                "example_id": "ffdbe06d-a37b-442f-8b18-6d102bc6e133",
                                "sense_id": "95e7dcd6-3e2d-3835-838c-5fe35cc28977",
                                "text": "Ze bekijkt Nella met een kille glimlach en laat haar blauwe ogen over de jonge bruid dwalen."
                            },
                            {
                                "example_id": "84aed568-2f96-4d19-81f4-994718c53c89",
                                "sense_id": "95e7dcd6-3e2d-3835-838c-5fe35cc28977",
                                "text": "De kersverse bruid bracht haar huwelijksnacht door in het bed dat ze al jaren met Arabella deelde, met haar voeten naar het hoofdeinde van haar woelende zusje gericht."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9dcacb91-dc22-418a-b8d4-d70838eda152",
                        "source_entry_id": "299ae436-e96a-350a-b0e7-b60446672e23",
                        "source_sense_id": "95e7dcd6-3e2d-3835-838c-5fe35cc28977",
                        "source_sense_description": "vrouw in tijd van de huwelijksplechtigheden",
                        "target_lang_word": "Braut",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Braut",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7301c41c-20ae-389c-bab7-9352c71c5ba9",
                                        "entry_id": "2d14653f-2e55-308c-81c6-d89b9d536c14",
                                        "glosses": [
                                            "eine (meist verlobte) Frau bis zum Tage nach der Hochzeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "692a0f6f-8703-45c8-8e76-694544378d80",
                                                "sense_id": "7301c41c-20ae-389c-bab7-9352c71c5ba9",
                                                "text": "Die Braut geht traditionell in Weiß zur Trauung."
                                            },
                                            {
                                                "example_id": "13a28173-f4ee-4850-b03e-3fad22d0841b",
                                                "sense_id": "7301c41c-20ae-389c-bab7-9352c71c5ba9",
                                                "text": "„Mit Uhr und Pelzmütze geht ein Junge seiner Braut entgegen, die zwar Stirntuch und Ohrringe, aber kein Gesicht trägt.“"
                                            },
                                            {
                                                "example_id": "6c5a7c32-4e22-4e49-89fa-8461676aac10",
                                                "sense_id": "7301c41c-20ae-389c-bab7-9352c71c5ba9",
                                                "text": "„Pierre hielt schweigend die Hand seiner Braut in der seinen und blickte auf ihren auf und nieder wogenden schönen Busen.“"
                                            },
                                            {
                                                "example_id": "59d0860d-6f91-4ea9-a465-8731fffbb7af",
                                                "sense_id": "7301c41c-20ae-389c-bab7-9352c71c5ba9",
                                                "text": "„Ich nahm meine Behauptung zurück, entschuldigte mich, und Don Francesco freute sich, daß die vornehme Blässe seiner Braut Anlaß zu dieser Frage gegeben hatte.“"
                                            },
                                            {
                                                "example_id": "d9259d1c-c121-4955-8ae5-14dc71b3b789",
                                                "sense_id": "7301c41c-20ae-389c-bab7-9352c71c5ba9",
                                                "text": "„Auf diese Weise versucht er, noch unerfahrener zu wirken, als er ist, um seine Braut zu beruhigen.“"
                                            },
                                            {
                                                "example_id": "f2cafe22-561e-4b1b-9673-729364b49c26",
                                                "sense_id": "7301c41c-20ae-389c-bab7-9352c71c5ba9",
                                                "text": "[Traditioneller Spruch am Ende einer Trauung:] »Sie dürfen die Braut jetzt küssen.« ( anhören⁽ᴵⁿᶠᵒ⁾)"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2b1fe498-ef68-38f4-933e-29bd9d98bf40",
                                        "entry_id": "2d14653f-2e55-308c-81c6-d89b9d536c14",
                                        "glosses": [
                                            "für Freundin"
                                        ],
                                        "tags": [
                                            "casual"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32cab270-47db-4f44-bff3-a047939c70be",
                                                "sense_id": "2b1fe498-ef68-38f4-933e-29bd9d98bf40",
                                                "text": "Peter hat eine neue Braut."
                                            },
                                            {
                                                "example_id": "fbb46aec-f136-4227-ba56-7f6e2d9fbd0a",
                                                "sense_id": "2b1fe498-ef68-38f4-933e-29bd9d98bf40",
                                                "text": "„Zwischen den Bräuten der Ringbrüder saß Kanther.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f0fa5c11-59ea-47e0-b763-e679b4f5e8de",
                        "source_entry_id": "299ae436-e96a-350a-b0e7-b60446672e23",
                        "source_sense_id": "95e7dcd6-3e2d-3835-838c-5fe35cc28977",
