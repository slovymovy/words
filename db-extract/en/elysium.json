                "senses": [
                    {
                        "sense_id": "49b41edb-bfd3-3b23-b5cf-c87883b37f42",
                        "entry_id": "ad48f8e2-bbfc-320c-bbe3-3ad12d6c1177",
                        "glosses": [
                            "The home of the blessed after death."
                        ],
                        "tags": [
                            "Greek",
                            "Roman"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "78a4ca3c-4eb8-375a-ab17-72f6ec6724ff",
                        "entry_id": "ad48f8e2-bbfc-320c-bbe3-3ad12d6c1177",
                        "glosses": [
                            "A place or state of ideal happiness; paradise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e50f9eb6-15f6-4bad-944f-a53c9dec3254",
                                "sense_id": "78a4ca3c-4eb8-375a-ab17-72f6ec6724ff",
                                "text": "Joseph seemed sitting in a sort of elysium alone, beside a roaring fire; a quart of ale on the table near him, bristling with large pieces of toasted oat-cake; and his black, short pipe in his mouth."
                            }
                        ]
                    },
                    {
                        "sense_id": "cd5e993a-bb10-39dc-bbd1-c570dfc739a3",
                        "entry_id": "ad48f8e2-bbfc-320c-bbe3-3ad12d6c1177",
                        "glosses": [
                            "A region in the northern hemisphere of Mars."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "84cea398-9a0b-428c-93b4-d1c99585a4af",
                        "source_entry_id": "ad48f8e2-bbfc-320c-bbe3-3ad12d6c1177",
                        "source_sense_description": "home of the blessed after death in Greek and Roman mythology — see also Elysian Fields",
                        "target_lang_word": "Élysée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Élysée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1ea10d10-8ebc-31da-98b8-fe0a0a9a64bc",
                                        "entry_id": "7aacbe16-b844-3654-8432-b183b75e1a84",
                                        "glosses": [
                                            "Champs Élysées, lieu de l’Hadès (le royaume des morts) où les héros et les gens vertueux goûtent le repos après leur mort."
                                        ],
                                        "tags": [
                                            "Mythologie grecque"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0fede81d-99cc-4611-96c1-a5980c79cd64",
                                                "sense_id": "1ea10d10-8ebc-31da-98b8-fe0a0a9a64bc",
                                                "text": "La découverte des Iles Canaries se perd dans la nuit des temps. Homère attribue à Sésostris, roi d’Égypte, connu par ses conquêtes et ses expéditions lointaines au XVᵉ siècle av. J.-C., la colonisation de l’île Ήλσνίος « au delà des colonnes d’Hercule ». La mythologie s’en empara et en fit l’Élysée, le séjour des héros et des hommes vertueux après leur mort."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "853265b7-7177-3748-84a7-88ef06fec51f",
                                        "entry_id": "7aacbe16-b844-3654-8432-b183b75e1a84",
                                        "glosses": [
                                            "Palais de l’Élysée, affecté à la présidence de la République française."
                                        ],
                                        "tags": [
                                            "France"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa8c98a6-61a7-4885-af4c-e646a7f83971",
                                                "sense_id": "853265b7-7177-3748-84a7-88ef06fec51f",
                                                "text": "On suppute le prix d’une colonne, on marchande l’épaisseur des dorures, bientôt il ne sera plus permis d’allumer une rampe au fronton de l’Élysée, sans entendre crier quelque part qu’un mètre de gaz coûte vingt centimes."
                                            },
                                            {
                                                "example_id": "5e1f6db3-eddf-43cb-9575-bb0fac24b288",
                                                "sense_id": "853265b7-7177-3748-84a7-88ef06fec51f",
                                                "text": "Je déjeunais à l’Élysée le surlendemain de la chute du ministère."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1bb760c-7dc1-35ca-bac8-5104bd3952db",
                                        "entry_id": "7aacbe16-b844-3654-8432-b183b75e1a84",
                                        "glosses": [
                                            "Présidence de la République française."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1334ff49-9fb4-4605-984f-c72fd2f78e2b",
                                                "sense_id": "f1bb760c-7dc1-35ca-bac8-5104bd3952db",
                                                "text": "— Vous savez, ce petit Vignon, il ira loin. On dit qu’il rêve l’Élysée. En tout cas, le voilà désigné pour être le chef du prochain cabinet."
                                            },
                                            {
                                                "example_id": "70f61a1a-d275-48ce-8a48-58ca3d54761a",
                                                "sense_id": "f1bb760c-7dc1-35ca-bac8-5104bd3952db",
                                                "text": "Mais ce n’est là qu’une frime. Au fond, Grévy a pris le goût de l’Élysée ; il n’est pas insensible à la gloriole et aux menus avantages matériels de la présidence."
                                            },
                                            {
                                                "example_id": "88b9885c-e63c-4808-8018-d3f6b2f1053e",
                                                "sense_id": "f1bb760c-7dc1-35ca-bac8-5104bd3952db",
                                                "text": "Il [Paul Deschanel] ne pensait au fond qu’à l’Élysée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ce3a50a-cba3-39ae-8b61-f6ba68d47aa0",
                                        "entry_id": "7aacbe16-b844-3654-8432-b183b75e1a84",
                                        "glosses": [
                                            "Administration de cette présidence."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6172f8d8-b5bb-39ff-8f82-45dfcbe8747f",
                                        "entry_id": "7aacbe16-b844-3654-8432-b183b75e1a84",
                                        "glosses": [
                                            "Autre nom du 8ᵉ arrondissement de Paris dans lequel se situe le Palais de l’Élysée."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Élysée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "814c8d18-df0f-3905-b7ad-f2adfd5b587e",
