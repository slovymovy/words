                },
                {
                    "sense_id": "b40cc88e-f54a-3636-a917-b00ca518f7ae",
                    "sense_definition": "Быть опубликованным, напечатанным или представленным публике",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "publication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Новая книга известного писателя <вышла> на прошлой неделе.",
                            "target_lang_translations": {
                                "en": "The famous writer's new book <came out> last week.",
                                "de": "Das neue Buch des bekannten Schriftstellers ist letzte Woche <erschienen>.",
                                "zh": "那位著名作家的书上周<出版>了。"
                            }
                        },
                        {
                            "text": "Этот фильм скоро <выйдет> на экраны кинотеатров.",
                            "target_lang_translations": {
                                "en": "This movie will soon <be released> in theaters.",
                                "de": "Dieser Film wird bald in den Kinos <herauskommen>.",
                                "zh": "这部电影很快就会在影院<上映>。"
                            }
