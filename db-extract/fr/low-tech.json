                    {
                        "sense_id": "53f97c6b-64f0-3fd4-adc2-4e1877e2eb9d",
                        "entry_id": "89cecbd5-a48e-3087-8c0c-5669fe95935e",
                        "glosses": [
                            "Technologie utilisant des moyens techniques simples et accessibles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aca20279-11f1-413e-b221-3b8193d758b2",
                                "sense_id": "53f97c6b-64f0-3fd4-adc2-4e1877e2eb9d",
                                "text": "Partout dans le monde, il y a de super innovations dans le low-tech, éloignées du superflu."
                            },
                            {
                                "example_id": "52d3969d-9a74-4d3f-8af4-e11e2b7bd4b9",
                                "sense_id": "53f97c6b-64f0-3fd4-adc2-4e1877e2eb9d",
                                "text": "La frugalité ne signifie pas zéro technique, mais incite au « low-tech », quand notre culture d’ingénierie est tournée vers le « high-tech »."
                            },
                            {
                                "example_id": "4088549d-9778-4c74-a702-995b00423c42",
                                "sense_id": "53f97c6b-64f0-3fd4-adc2-4e1877e2eb9d",
                                "text": "Désolé pour les partisans de la low-tech qui voient dans le geste manuel un rejet de la singularité technologique, mais les études sont sans appel."
                            }
                        ]
                    }
