                                        "sense_id": "d4170be6-eb27-336d-b276-887811223317",
                                        "entry_id": "66833a70-933e-32a3-a6d2-575c32e868b1",
                                        "glosses": [
                                            "Instrument de musique capable de synthétiser des sons électroacoustiques à l'aide de techniques telles que la synthèse additive, la synthèse soustractive, la synthèse FM, la modélisation physique ou la modulation de phase."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3f01f54-3951-4c40-9bde-b2e04fa1a9d3",
                                                "sense_id": "d4170be6-eb27-336d-b276-887811223317",
                                                "text": "Assise à son synthétiseur, casque sur les oreilles et mains sur le clavier, Camille lui sourit et, par un signe de tête, lui fit comprendre qu’elle n’avait pas terminé."
                                            }
                                        ]
                                    }
                                ]
                            },
