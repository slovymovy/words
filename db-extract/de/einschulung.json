                                "target_senses": [
                                    {
                                        "sense_id": "2bda2d9e-053d-3fec-8749-9c619ca9c091",
                                        "entry_id": "14a601fa-9275-300e-90b4-ca3a762260d9",
                                        "glosses": [
                                            "The act of instructing, teaching, or providing with information or knowledge."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f19e2308-8eff-4686-82ae-ec07d6e3a113",
                                                "sense_id": "2bda2d9e-053d-3fec-8749-9c619ca9c091",
                                                "text": "Students receive instruction in the arts and sciences."
                                            },
                                            {
                                                "example_id": "c86c01d8-86af-4695-aea1-0e25a643c1cf",
                                                "sense_id": "2bda2d9e-053d-3fec-8749-9c619ca9c091",
                                                "text": "Instruction will be provided on how to handle difficult customers."
                                            },
                                            {
                                                "example_id": "5b62af6c-5c82-44e4-b33b-3a50735d5110",
                                                "sense_id": "2bda2d9e-053d-3fec-8749-9c619ca9c091",
                                                "text": "Anstruther laughed good-naturedly. “[…] I shall take out half a dozen intelligent maistries from our Press and get them to give our villagers instruction when they begin work and when they are in the fields.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0633c6d0-59b2-32b8-8769-83fd26ceb30a",
                                        "entry_id": "14a601fa-9275-300e-90b4-ca3a762260d9",
                                        "glosses": [
                                            "An instance of the information or knowledge so furnished."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1ca4972-f762-433d-99af-4a2e5f3697a1",
                                                "sense_id": "0633c6d0-59b2-32b8-8769-83fd26ceb30a",
                                                "text": "If my instructions may be your guide."
                                            }
                                        ]
                                    },
