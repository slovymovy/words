                        "sense_id": "9b8ae9bd-14a8-3c66-98ac-cfd5513d1dd3",
                        "entry_id": "6f12131d-9402-39f3-acf5-6341094d33fb",
                        "glosses": [
                            "Défaut d’élégance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "600a8f07-4495-4d1e-bc8b-079e970cc48e",
                                "sense_id": "9b8ae9bd-14a8-3c66-98ac-cfd5513d1dd3",
                                "text": "L’inélégance de son style."
                            },
                            {
                                "example_id": "0c6aeb4c-95c1-4354-8758-58d15cde1e5b",
                                "sense_id": "9b8ae9bd-14a8-3c66-98ac-cfd5513d1dd3",
                                "text": "Sur cette estrade, derrière cette petite table dont la vétusté et l’inélégance ne se masquent d’aucun tapis, des hommes de grand mérite se sont assis."
                            },
                            {
                                "example_id": "32f98d54-56c3-4d45-8daf-916aa32ba2c9",
                                "sense_id": "9b8ae9bd-14a8-3c66-98ac-cfd5513d1dd3",
                                "text": "Herbert est puceau : l’intrigue pourrait se résumer à l’inélégance de ce mot qui encombre notre héros."
                            }
                        ]
                    }
                ],
