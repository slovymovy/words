                "translations": [
                    {
                        "translation_id": "f0dc33d5-dfeb-4549-860d-bd2661f7d2d4",
                        "source_entry_id": "cc9954f1-8c66-383b-9632-8dc48426e2d4",
                        "source_sense_id": "7e26fb89-2e24-39b5-ae82-467a7c1d10b9",
                        "source_sense_description": "zehnter Monat des Jahres; Oktober",
                        "target_lang_word": "Oktober",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Oktober",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "82ce7f3a-17ff-3a73-9738-ab49e8832acb",
                                        "entry_id": "5886a98b-b2f8-3261-9b9f-9fae1bd41fe8",
                                        "glosses": [
                                            "der zehnte Monat des Kalenderjahres"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d35e020b-13ee-4c2e-b2f7-6140bf1814c1",
                                                "sense_id": "82ce7f3a-17ff-3a73-9738-ab49e8832acb",
                                                "text": "Der Oktober folgt auf den September."
                                            },
                                            {
                                                "example_id": "f3176eba-a463-4297-bd07-c17a463adf7a",
                                                "sense_id": "82ce7f3a-17ff-3a73-9738-ab49e8832acb",
                                                "text": "„Ab Oktober ist er Delegationsmitglied der EU zum arabischen Raum und in dieser Funktion auch mit dem Irak betraut.“"
                                            },
                                            {
                                                "example_id": "b1fce051-3df9-4949-9244-a7805aa58d2e",
                                                "sense_id": "82ce7f3a-17ff-3a73-9738-ab49e8832acb",
                                                "text": "„Die Donnerstage im Oktober waren zu jener Zeit in Rom Tage festlicher Freude.“"
                                            },
                                            {
                                                "example_id": "c0e466d4-b479-45e6-becb-7264859aa327",
                                                "sense_id": "82ce7f3a-17ff-3a73-9738-ab49e8832acb",
                                                "text": "„Jener Oktober war einer der allerschlimmsten Monate des Bürgerkrieges.“"
                                            },
                                            {
                                                "example_id": "ca4e58c4-5c2a-4ac9-99e9-27c92b83ee35",
                                                "sense_id": "82ce7f3a-17ff-3a73-9738-ab49e8832acb",
                                                "text": "„Am 10. Oktober 1933 bezieht Hans Fallada mit Ehefrau und zwei Kindern sein neues Heim in Carwitz.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
