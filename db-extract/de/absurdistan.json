                "senses": [
                    {
                        "sense_id": "cb81e836-6116-37aa-9c4a-e43da6f5b2c4",
                        "entry_id": "9dc5369c-3f6e-3120-9d5b-f3fe44c252f9",
                        "glosses": [
                            "„fiktives Land, in dem absurde Verhältnisse herrschen“ als sinnbildhafte Bezeichnung für „unverständliche (absurde) politische Situationen“, „bestimmte Verhältnisse[, die] nicht nachvollziehbar sind“, für „etwas völlig Absurdes“"
                        ],
                        "tags": [
                            "colloquial",
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "958b74e7-0340-4179-8700-a583958990f6",
                                "sense_id": "cb81e836-6116-37aa-9c4a-e43da6f5b2c4",
                                "text": "Absurdistan sucht man vergeblich auf dem Globus, dennoch ist es vielerorts anzutreffen."
                            },
                            {
                                "example_id": "d3e9fbb0-e01a-4a00-83f1-e3a0ef20f34c",
                                "sense_id": "cb81e836-6116-37aa-9c4a-e43da6f5b2c4",
                                "text": "„Und doch wird in ihnen die Frage nagen, ob sie nicht eine Chance übersehen, ein nicht-militärisches Druckmittel ausgelassen haben, um das balkanische Absurdistan gewaltlos zu befrieden.“"
                            },
                            {
                                "example_id": "10857345-1917-42f7-bb47-f3c68e6b4194",
                                "sense_id": "cb81e836-6116-37aa-9c4a-e43da6f5b2c4",
                                "text": "„‚Absurdistan‘ nennt es Katharina Sperber, wenn Menschen an Marienerscheinungen im Härtelwald glauben und dorthin pilgern.“"
                            },
                            {
                                "example_id": "70ca517b-51a2-49be-afdd-43caed8b1cb9",
                                "sense_id": "cb81e836-6116-37aa-9c4a-e43da6f5b2c4",
                                "text": "„Nein, auch Argumente aus Absurdistan werden die Wehrpflicht nicht halten können.“"
                            },
                            {
                                "example_id": "750d1e38-69b4-4bf1-9e09-0518fb1ea1a9",
                                "sense_id": "cb81e836-6116-37aa-9c4a-e43da6f5b2c4",
                                "text": "„Absurdistan sei überall, denn jedes Land habe seine ganz eigenen Absurditäten.“"
                            },
                            {
                                "example_id": "5de2411b-51cb-4e33-8d10-eb64a7b92cb8",
                                "sense_id": "cb81e836-6116-37aa-9c4a-e43da6f5b2c4",
                                "text": "„Die politischen Verhältnisse im Land und die Geschäftsordnung des Landtags glichen jenen von ‚Absurdistan, einem Land zwischen Schilda und Skurrilistan.‘“"
                            },
                            {
                                "example_id": "53bfb457-6b4c-4226-97a5-6ef5d3a7fb61",
                                "sense_id": "cb81e836-6116-37aa-9c4a-e43da6f5b2c4",
                                "text": "„Das klingt eigentlich mehr nach Absurdistan als nach Bundesrepublik Deutschland, was wir hier vorgeführt bekommen.“"
                            },
                            {
                                "example_id": "fe62644f-61e0-4c36-b825-559f91e51524",
                                "sense_id": "cb81e836-6116-37aa-9c4a-e43da6f5b2c4",
                                "text": "„Ein wenig fühlt man sich nach Absurdistan versetzt.“"
                            },
                            {
                                "example_id": "2fcc3fc2-23fd-412d-b702-cc7d418526c8",
                                "sense_id": "cb81e836-6116-37aa-9c4a-e43da6f5b2c4",
                                "text": "„Wenn er sein Publikum auf die Zeitreise mitnimmt in das Absurdistan des Nonsense-Chansons und das Panikistan des Schlagers.“"
                            },
                            {
                                "example_id": "9c02b90a-e31d-41b7-b0a5-4a0cefb113f4",
                                "sense_id": "cb81e836-6116-37aa-9c4a-e43da6f5b2c4",
                                "text": "„Im Lauf des Abends webt er ein Netz kruder Zusammenhänge, präsentiert die schockierende Komik unseres wirtschaftlichen Absurdistans und zeigt, dass niemand irgendetwas gelernt hat: ‚Immer noch ist es möglich, auf Lebensmittelknappheit zu spekulieren, mit dem Welthunger fett zu werden‘, prangert er an.“"
                            },
                            {
                                "example_id": "8b019170-993a-4e22-af72-9c924a88b321",
                                "sense_id": "cb81e836-6116-37aa-9c4a-e43da6f5b2c4",
                                "text": "„Von politischer Seite wurden auch solche Vorschläge lange mit allen verfügbaren, oft populistischen und inhaltlich mitunter aus Absurdistan hergeholten Argumenten abgewiesen, mit folgenschweren Nachteilen für das Land im weltweiten ‚Kampf um die besten Köpfe‘.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
