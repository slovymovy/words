                        "entry_id": "01afccee-5790-3a09-88c5-57d49701ab80",
                        "glosses": [
                            "физ. положительно заряженная элементарная частица, античастица электрона"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de0b300c-cdef-4566-8e3a-cddf313bf75c",
                                "sense_id": "45e37f77-67f3-3b15-8e43-ec8e0d6f2a57",
                                "text": "При аннигиляции позитрона и электрона, как правило, излучается два гамма-кванта."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9965f396-4c1a-4d42-8ec2-a963475ca2d2",
                        "source_entry_id": "01afccee-5790-3a09-88c5-57d49701ab80",
                        "source_sense_id": "45e37f77-67f3-3b15-8e43-ec8e0d6f2a57",
                        "target_lang_word": "positron",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
