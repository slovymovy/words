                },
                {
                    "sense_id": "62d0f861-ce4f-34df-94dd-05c7f816583f",
                    "sense_definition": "An old unit of weight, synonymous with <w>farasola</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "weights",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The historical document recorded the trade of spices measured by the <w>frail</w>.",
                            "target_lang_translations": {
                                "ru": "В историческом документе зафиксирована торговля специями, измеряемая в <w>фарасолах</w>."
