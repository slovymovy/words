                "senses": [
                    {
                        "sense_id": "9c98e43b-d1d1-33be-b7b2-b81849b3c2fe",
                        "entry_id": "3514bacb-3241-3f0f-a229-a4945f1e0fbc",
                        "glosses": [
                            "Faire perdre son caractère dialectique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f1f3571-943d-48c0-a394-1c3ec23a62ce",
                                "sense_id": "9c98e43b-d1d1-33be-b7b2-b81849b3c2fe",
                                "text": "Je ne veux pas seulement dire que le souvenir qu’on garde de ce texte tend à le dédialectiser."
                            },
                            {
                                "example_id": "6ddef06a-0578-4e8c-a713-564f3f845e41",
                                "sense_id": "9c98e43b-d1d1-33be-b7b2-b81849b3c2fe",
                                "text": "Tout d’abord analyser le mouvement d’une société en termes de gauche et de droite qui ne sont véritablement applicables qu’au champ politique revient à dédialectiser l’analyse."
                            },
                            {
                                "example_id": "c2a1e88a-816f-439b-9b06-432bbf694190",
                                "sense_id": "9c98e43b-d1d1-33be-b7b2-b81849b3c2fe",
                                "text": "Dans la Préface de Critique du rythme, Meschonnic remarque qu’« Il reste à déshégélianiser la philosophie du langage » – ce qui signifie en fait, la dédialectiser."
                            }
                        ]
                    }
                ],
