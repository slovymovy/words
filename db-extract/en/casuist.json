                "senses": [
                    {
                        "sense_id": "a439d9eb-a9bd-3817-8f22-fb857c25a6c8",
                        "entry_id": "72c2a186-0a64-3bed-b962-304ef27062ab",
                        "glosses": [
                            "A person who resolves cases of conscience or moral duty."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "fc367eab-e99e-3d18-93a0-f9edafbaf590",
                        "entry_id": "72c2a186-0a64-3bed-b962-304ef27062ab",
                        "glosses": [
                            "Someone who attempts to specify exact and precise rules for the direction of every circumstance of behaviour."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d825684-c531-4066-84af-30abdedf0449",
                                "sense_id": "fc367eab-e99e-3d18-93a0-f9edafbaf590",
                                "text": "Something, indeed, not unlike the doctrine of the caſuiſts, ſeems to have been attempted by ſeveral philoſophers. There is ſomething of this kind in the third book of Cicero's offices, where he endeavours like a caſuiſt to give rules for our conduct in many nice caſes, in which it is difficult to determine whereabouts the point of propriety may lie."
                            }
                        ]
                    },
                    {
                        "sense_id": "07f3ffa6-41ed-3a9c-b8bb-6c537f266e89",
                        "entry_id": "72c2a186-0a64-3bed-b962-304ef27062ab",
                        "glosses": [
                            "One who is skilled in, or given to, casuistry."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57fea2d4-9160-4efc-8156-3d0ca7af1d88",
                                "sense_id": "07f3ffa6-41ed-3a9c-b8bb-6c537f266e89",
                                "text": "The judgment of any casuist or learned divine concerning the state of a man's soul, is not sufficient to give him confidence."
                            },
                            {
                                "example_id": "fb2ae9c1-8f16-4d25-af73-86b0915fb2dc",
                                "sense_id": "07f3ffa6-41ed-3a9c-b8bb-6c537f266e89",
                                "text": "Leave the two-party farce to those who enjoy it, supporting their efforts when — and only when — they treat others humanely and speak with modesty and responsibility, not as casuists, alarmists, and provocateurs of guilt."
                            }
                        ]
                    }
                ],
