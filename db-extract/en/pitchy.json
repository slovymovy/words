                        "entry_id": "ae205ff1-1299-3255-81ec-f93da504df9b",
                        "glosses": [
                            "Very dark black; pitch-black."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd6658cf-dc36-4e8c-91b0-39d605e5fef5",
                                "sense_id": "4004ab8f-b61f-308e-9125-7359431c52a4",
                                "text": "Mancunium, Manceaster, what we now call Manchester, spins no cotton […] The Creek of the Mersey gurgles, twice in the four-and-twenty hours, with eddying brine, clangorous with sea-fowl; and is a Lither-Pool, a lazy or sullen Pool, no monstrous pitchy City, and Seahaven of the world!"
                            },
                            {
                                "example_id": "253aacab-2f05-47d9-ae83-2d17185b6559",
                                "sense_id": "4004ab8f-b61f-308e-9125-7359431c52a4",
                                "text": "In front of me the road became pitchy black as though it was tarred, and I saw a contorted shape lying across the pathway."
                            },
                            {
                                "example_id": "65029c16-2991-4c6b-aa93-189d5b075163",
                                "sense_id": "4004ab8f-b61f-308e-9125-7359431c52a4",
                                "text": "To make it worse, something went wrong wit the Glow-worm's lighting system, and the room was in pitchy darkness."
                            }
                        ]
                    }
