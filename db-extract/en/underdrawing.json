    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "b036ed26-fee6-3b4b-9fd9-4ef0372a2687",
                "word": "underdrawing",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "28213d61-3278-4ab0-a6c5-1c9776d65f69",
                        "entry_id": "b036ed26-fee6-3b4b-9fd9-4ef0372a2687",
                        "tags": [
                            "plural"
                        ],
                        "form": "underdrawings"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "664caa21-9325-3f40-8776-b3e9d09e20a0",
                        "entry_id": "b036ed26-fee6-3b4b-9fd9-4ef0372a2687",
                        "glosses": [
                            "A sketch done on the ground of a work of art before paint, pastel, ink, or other more permanent medium is applied."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "674873ea-c672-4c43-ad59-652c0860a72d",
                                "sense_id": "664caa21-9325-3f40-8776-b3e9d09e20a0",
                                "text": "Depending on the medium used, underdrawing in embroidery and other decorative techniques may be revealed by radiography where it is relatively radio-absorbent in comparison to other materials used either in the original artefact or in later mounting and conservation methods."
                            },
                            {
                                "example_id": "aa7b8005-2491-4422-904c-a3c56ee38c02",
                                "sense_id": "664caa21-9325-3f40-8776-b3e9d09e20a0",
                                "text": "When subjected to printing or photocopying, the blue underdrawing will disappear, leaving only the ink lines."
                            },
                            {
                                "example_id": "2e54aa14-ed07-4baf-b157-ab8f0ba5ad06",
                                "sense_id": "664caa21-9325-3f40-8776-b3e9d09e20a0",
                                "text": "The 'Aegyptiaca' would thus have removed herself from the embrace in the underdrawing and have turned towards the woman who is just awakening from her dream."
                            }
                        ]
                    },
                    {
                        "sense_id": "4f989dd6-7472-3628-8aa5-c5a79092f51d",
                        "entry_id": "b036ed26-fee6-3b4b-9fd9-4ef0372a2687",
                        "glosses": [
                            "An image of a figure that is slid under the page on which a designer draws a garment, so that the result conforms to the figure's proportions."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b21fcf4-3c19-4c05-8a6e-d34ef837655c",
                                "sense_id": "4f989dd6-7472-3628-8aa5-c5a79092f51d",
                                "text": "You can use a croquis as an underdrawing for fashion drawing"
                            },
                            {
                                "example_id": "932e8288-77d9-40f6-9bf2-e61e80440da6",
                                "sense_id": "4f989dd6-7472-3628-8aa5-c5a79092f51d",
                                "text": "Used as a base or underdrawing, it can be slipped under a page in the sketchbook and worked off of from there."
                            },
                            {
                                "example_id": "e7c80d7f-0ca4-47ee-ba01-800e7999f3c5",
                                "sense_id": "4f989dd6-7472-3628-8aa5-c5a79092f51d",
                                "text": "To ensure that their focus is on the design of the garment, not the proportions of the figure, they may rely on an underdrawing or lay figure—a well-proportioned pose that can be slid under a page and used as a template to help control proportions and the location of garment details."
                            }
                        ]
                    },
                    {
                        "sense_id": "688bcebd-57fe-35d3-a9fa-b83ee6998f5b",
                        "entry_id": "b036ed26-fee6-3b4b-9fd9-4ef0372a2687",
                        "glosses": [
                            "An underdrawn cover or lining of the underside of a floor or roof with plasterwork, boarding, or similar."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d3fa8a4-dc2f-41b2-8f74-7ee466192f79",
                                "sense_id": "688bcebd-57fe-35d3-a9fa-b83ee6998f5b",
                                "text": "He has the whole of the room underdrawn, with the exception of two bays at one end; he admits plenty of air by the windows in the roof into the triangular shaped space formed by the roof and the underdrawing; it is here deprived of its moisture, and passes into the spinning room, where the underdrawing stops short of the length of the room."
                            },
                            {
                                "example_id": "2cfc73e5-4828-4f8e-ba41-745f35e8e864",
                                "sense_id": "688bcebd-57fe-35d3-a9fa-b83ee6998f5b",
                                "text": "Tongued and grooved boards ⅝ in. thick form the underdrawing for the roof."
                            },
                            {
                                "example_id": "a01cadb7-23bd-4e99-a763-23b91911e529",
                                "sense_id": "688bcebd-57fe-35d3-a9fa-b83ee6998f5b",
                                "text": "The amount of uncomfortable drafts and heat loss may increase with the removal of the underdrawing."
                            }
                        ]
                    }
                ],
