{
    "word_family": [
        "consular",
        "consulate",
        "consulship",
        "proconsul"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1f50d2dd-6dbd-35ef-9781-b9f260974c47",
                    "sense_definition": "An official appointed by a government to live in a foreign city and protect its citizens and interests there.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "diplomatic_official",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The British <w>consul</w> helped the stranded travelers obtain emergency passports."
                        },
                        {
                            "text": "She arranged an urgent meeting with the <w>consul</w> general to discuss the new trade rules."
                        }
                    ],
                    "common_phrases": [
                        "consul general",
                        "honorary consul"
                    ]
                },
                {
                    "sense_id": "5a24bf19-d518-36ab-aa26-58e1897e3c13",
                    "sense_definition": "Either of the two annually elected chief magistrates who jointly ruled the ancient Roman Republic.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "historical_magistrate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Julius Caesar served as <w>consul</w> before leading his military campaigns in Gaul."
                        },
                        {
                            "text": "The Roman Senate often debated critical matters directly with each <w>consul</w>."
                        }
                    ],
                    "common_phrases": [
                        "Roman consul"
                    ]
                },
                {
                    "sense_id": "e1917d21-1790-3530-a03d-c74f0ff7470f",
                    "sense_definition": "Any of the three chief magistrates who held executive power in France from 1799 to 1804.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "historical_magistrate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Napoleon Bonaparte assumed absolute executive authority as the First <w>Consul</w> of France."
                        },
                        {
                            "text": "The Constitution established three heads of state, but the first <w>consul</w> held supreme power."
                        }
                    ],
                    "common_phrases": [
                        "first consul"
                    ]
                },
                {
                    "sense_id": "45fc2e2c-1787-3938-8698-d8f7e9673ca4",
                    "sense_definition": "An official in an early modern trading port, chosen by foreign merchants to settle commercial disputes.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "merchant_official",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The merchants elected a trusted <w>consul</w> to arbitrate financial disagreements at the foreign port."
                        },
                        {
                            "text": "Every visiting trader relied on the local <w>consul</w> to negotiate directly with town authorities."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Historical trade usage"
                        }
                    ]
                },
                {
                    "sense_id": "d88856f5-6a90-3e95-b9d7-ce9e448a87ad",
                    "sense_definition": "An officer or governing member of a trading or merchant company in early modern England.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "merchant_official",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He served as a <w>consul</w> for the trading company, supervising maritime accounts in London."
                        },
                        {
                            "text": "The company's governor convened a meeting with each <w>consul</w> to inspect the shipping manifests."
                        }
                    ],
                    "synonyms": [
                        "councillor"
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "No longer used in merchant companies"
                        }
                    ]
                },
                {
                    "sense_id": "2390fa2e-4e9b-3d31-8aef-f523587c8ec9",
                    "sense_definition": "A municipal councillor or city magistrate in early modern southern France or Catalonia.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The newly elected <w>consul</w> took his oath of office before the municipal assembly."
                        },
                        {
                            "text": "Citizens gathered in the square to hear the <w>consul</w> announce the revised city regulations."
                        }
                    ],
                    "synonyms": [
                        "councillor"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Southern France and Catalonia"
                        },
                        {
                            "trait_type": "archaic",
                            "comment": "Early modern civic administration"
                        }
                    ]
                },
                {
                    "sense_id": "243954e7-c545-3100-9637-27c4fa9e269d",
                    "sense_definition": "A count or earl.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The medieval chronicle referred to the wealthy nobleman by his Latin title of <w>consul</w>."
                        },
                        {
                            "text": "In older translations, the rank of earl was occasionally rendered as <w>consul</w>."
                        }
                    ],
                    "synonyms": [
                        "count"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Medieval translation of noble title"
                        }
                    ]
                },
                {
                    "sense_id": "22eda375-a3a9-3517-aa07-e9d5b15f9f2c",
                    "sense_definition": "A high-ranking government counsellor or joint ruler.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sovereign invited each trusted <w>consul</w> to deliver advice on the pending conflict."
                        },
                        {
                            "text": "Historical texts described the king's chief advisor as an eminent <w>consul</w> of the realm."
                        }
                    ],
                    "synonyms": [
                        "counsellor"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Early modern poetic and general usage"
                        }
                    ]
                }
            ]
        }
    ]
}