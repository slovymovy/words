        "fr-extract.jsonl": [
            {
                "entry_id": "29b93eff-4988-3be1-9bb4-75c80c18603f",
                "word": "maladroitement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "775c9e34-333d-3925-a3cf-9777645e5b46",
                        "entry_id": "29b93eff-4988-3be1-9bb4-75c80c18603f",
                        "glosses": [
                            "D’une manière maladroite."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79d54e9f-6676-4781-bbe4-1616ff520d78",
                                "sense_id": "775c9e34-333d-3925-a3cf-9777645e5b46",
                                "text": "Souriante, avec, cependant, une ombre de mélancolie dans le regard, Yasmina écoutait Jacques lui chanter, maladroitement encore, toute sa passion qu’il n'essayait même plus d’enchaîner."
                            },
                            {
                                "example_id": "e235c044-9c4c-4f77-a349-1a4adde03a4f",
                                "sense_id": "775c9e34-333d-3925-a3cf-9777645e5b46",
                                "text": "On jouait aux cartes à une table, un groupe lançait des fléchettes sur une cible peinte représentant des bâtiments silhouettés maladroitement, une usine, ou peut-être une centrale nucléaire."
                            },
                            {
                                "example_id": "445083ba-cdfa-4588-9a5f-54ee354d08ec",
                                "sense_id": "775c9e34-333d-3925-a3cf-9777645e5b46",
                                "text": "Celle-ci a eu un peu le sort des cathédrales gothiques : on a défleuronné, déformé et maladroitement restauré."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2274346f-3bef-42c4-8c51-1208e58c530c",
                        "source_entry_id": "29b93eff-4988-3be1-9bb4-75c80c18603f",
                        "source_sense_id": "775c9e34-333d-3925-a3cf-9777645e5b46",
                        "target_lang_word": "ungeschickt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ungeschickt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "679dd73d-d023-3752-a382-c14bde601981",
