                ],
                "senses": [
                    {
                        "sense_id": "ef6a1929-9021-3d79-9812-43c756f93562",
                        "entry_id": "5e182b1b-e302-3d09-84ae-fb050f585c78",
                        "glosses": [
                            "Klippschulen waren behördlich nicht anerkannte, privat organisierte Schulen, die seit dem frühen 16. Jahrhundert zuerst in den Niederlanden, später auch in Deutschland aufkamen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ee04d97-55c3-4dd0-bf7c-e14bbabbe37b",
                                "sense_id": "ef6a1929-9021-3d79-9812-43c756f93562",
                                "text": "Wenn Fritz in seiner Klippschule saß und um neun Uhr vormittags auch die Arbeitsfrau sich entfernt hatte, dann lag das lange Vorderhaus wie ausgestorben."
                            },
                            {
                                "example_id": "e5b85721-0d57-418a-a1f5-26f0a0fb1f74",
                                "sense_id": "ef6a1929-9021-3d79-9812-43c756f93562",
                                "text": "Und bei solchem Anlaß hat sie's denn auch einmal durchgesetzt, daß das arme Kind aus der Klippschule zum mindesten in die ordentliche Mädchenschule gekommen ist."
                            },
                            {
                                "example_id": "d7b9184d-b174-4bb3-8d95-9034a866ddca",
                                "sense_id": "ef6a1929-9021-3d79-9812-43c756f93562",
                                "text": "Man haßte sie, wie der dumme Schüler der Klippschule den Lehrer."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "bae42bf2-7ad9-3c01-8ed9-e776b530d9d6",
                        "entry_id": "5e182b1b-e302-3d09-84ae-fb050f585c78",
                        "glosses": [
                            "Schule minderer Qualität"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "ce2095a6-822c-40bf-bbc2-3b80ec90c405",
                                "sense_id": "bae42bf2-7ad9-3c01-8ed9-e776b530d9d6",
                                "text": "Das geht hier ja zu, wie in einer Klippschule."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
