                "senses": [
                    {
                        "sense_id": "c5e14977-a628-36d9-a563-85e3f40dd738",
                        "entry_id": "34555a02-081d-3318-adf9-c6ab2b2474f8",
                        "glosses": [
                            "Oberbekleidungsstück, das über die Oberschenkel hinunterreicht, aus den Haaren von Kamelen hergestellt wird und dadurch die typische Farbe zwischen hellbraun, beige und ocker erhält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0bbeb2e6-dac1-4db6-ac6a-13b8530dd14f",
                                "sense_id": "c5e14977-a628-36d9-a563-85e3f40dd738",
                                "text": "„Er wird den eleganten gelben Handkoffer tragen, den hellen Kamelhaarmantel über den Arm geworfen.“"
                            },
                            {
                                "example_id": "9d54dff4-086b-4bcf-a7ec-f69bcb9eefde",
                                "sense_id": "c5e14977-a628-36d9-a563-85e3f40dd738",
                                "text": "„Die Dame trug einen Kamelhaarmantel, dessen Kragen hochgestellt war, und einen Hut von männlicher Fasson, mit breiter Krempe, wie er damals gerade modern war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
