                    }
                ],
                "senses": [
                    {
                        "sense_id": "b0e73ae9-6c41-33c1-9559-24fdc285996e",
                        "entry_id": "13811189-ee37-3c89-b609-eebaced9b632",
                        "glosses": [
                            "moeder van een ouder"
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "eed1d34b-14b1-4867-bf78-59d967490787",
                                "sense_id": "b0e73ae9-6c41-33c1-9559-24fdc285996e",
                                "text": "Een altijd goedgemutste bomma, schat van een mens, maar net zoals mijn andere grootouders afkomstig uit een andere tijd, toen thuiswerkende moeders hun kinderen nog op internaat stuurden omdat ze anders in de weg liepen. Kinderen werden toen nog niet doodgeknuffeld, wellicht dachten de mensen toen dat een warm nest er kasplantjes van zou maken. Ik was wel altijd blij toen ik mijn grootouders zag, maar ik miste ze nauwelijks toen ze doodgingen. Mijn ouders, díé zal ik missen als ze dood zijn."
                            },
                            {
                                "example_id": "fdf25f9f-94b9-405f-903e-d93ce847c0bd",
                                "sense_id": "b0e73ae9-6c41-33c1-9559-24fdc285996e",
                                "text": "U blijft natuurlijk ook ondernemer. Dat ‘koken zoals de bomma’ en ‘met gezond verstand’ waarmee uw nieuwe kookboek weer wordt gepresenteerd, dat is een helder commerciële identiteit. Duidelijk gepositioneerd tegenover de concurrentie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2973380b-379f-4cc6-a28b-e577aa740fbe",
                        "source_entry_id": "13811189-ee37-3c89-b609-eebaced9b632",
                        "source_sense_id": "b0e73ae9-6c41-33c1-9559-24fdc285996e",
                        "target_lang_word": "grandmother",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grandmother",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bef6c8e1-31a2-317d-8ca4-3cb6e9472ebb",
                                        "entry_id": "d9c762a8-0cb8-3ff4-916a-b628a637c5c3",
                                        "glosses": [
                                            "A mother of someone's parent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23566c0c-6436-44a9-8e03-96ae9c11c0ad",
                                                "sense_id": "bef6c8e1-31a2-317d-8ca4-3cb6e9472ebb",
                                                "text": "[…] man may admit that his grandfathers and grandmothers were mon[keys a]nd monkeyesses if he want^([sic]) to; that is his privilege."
                                            },
                                            {
                                                "example_id": "263626f7-4ffb-44e0-ad00-3bca1dbd5482",
                                                "sense_id": "bef6c8e1-31a2-317d-8ca4-3cb6e9472ebb",
                                                "text": "\"It's a nightingale floor,\" our grandmother told us. \"It warns us of thieves in the night.\""
                                            },
                                            {
                                                "example_id": "7aad34a1-fde0-4670-972e-3960ce9baa14",
                                                "sense_id": "bef6c8e1-31a2-317d-8ca4-3cb6e9472ebb",
                                                "text": "“Not only is it showing that the brain of grandmothers is activated with grandparenting, it also shows that the parental brain areas are activated late in life, or perhaps are always activated. Once a mother, always a mother,” Pawluski said."
                                            },
                                            {
                                                "example_id": "bdf5c878-781b-4006-9c9a-e59ed7f9887a",
                                                "sense_id": "bef6c8e1-31a2-317d-8ca4-3cb6e9472ebb",
                                                "text": "Viral YouTuber and grandmother Shirley Curry, better known as ‘Skyrim Grandma’ is finally playing another Bethesda RPG after nine years."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8cd1cfe4-cc9c-3d10-be08-fd6c964e937b",
                                        "entry_id": "d9c762a8-0cb8-3ff4-916a-b628a637c5c3",
                                        "glosses": [
                                            "A female ancestor or progenitor."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "199f4b65-dea2-3914-97e1-fe199b911711",
                                        "entry_id": "d9c762a8-0cb8-3ff4-916a-b628a637c5c3",
                                        "glosses": [
                                            "In Amazonian shamanism and related contexts, a reverential name for the ayahuasca vine or brew, symbolizing its role as a wise, guiding spirit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b806703a-067f-4779-93f7-fa0340780d0e",
                                                "sense_id": "199f4b65-dea2-3914-97e1-fe199b911711",
                                                "text": "\"Enter ayahuasca, the mystical grandmother of the psychedelic family, a beacon of profound spiritual experiences\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5cd6585e-b2e4-420c-b984-85569a861623",
                        "source_entry_id": "13811189-ee37-3c89-b609-eebaced9b632",
                        "source_sense_id": "b0e73ae9-6c41-33c1-9559-24fdc285996e",
                        "target_lang_word": "granny",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "granny",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c6cb92ac-2de6-3243-9cf9-b168f75a24fb",
                                        "entry_id": "90395721-ee37-31bb-9d02-90f9a0ed7c42",
                                        "glosses": [
                                            "A grandmother."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d1e1c06-d2bf-411c-ad9b-507cf789165a",
                                                "sense_id": "c6cb92ac-2de6-3243-9cf9-b168f75a24fb",
                                                "text": "I'm going to be a granny."
                                            },
                                            {
                                                "example_id": "1d9d0091-db53-4a27-9409-7f0e7a7dd284",
                                                "sense_id": "c6cb92ac-2de6-3243-9cf9-b168f75a24fb",
                                                "text": "Good morning, Granny!"
                                            },
                                            {
                                                "example_id": "bf095fc8-240b-4eca-8827-fef6d17846d5",
                                                "sense_id": "c6cb92ac-2de6-3243-9cf9-b168f75a24fb",
                                                "text": "Travelling with their granny, who seems more interested in her crossword puzzle than them, they bicker and fight in a futile bid to get her attention. Oh, the joys of travelling during the school holidays!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb20e6e6-f5b4-3d7e-bf35-b171d78e4104",
                                        "entry_id": "90395721-ee37-31bb-9d02-90f9a0ed7c42",
                                        "glosses": [
                                            "Any elderly woman, regardless of if she has grandchildren."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d8bc64d-13a7-4a2f-9131-82ef3aa1a105",
                                                "sense_id": "eb20e6e6-f5b4-3d7e-bf35-b171d78e4104",
                                                "text": "That granny over there needs your assistance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33457913-7879-3805-be88-1adb25d43b2c",
                                        "entry_id": "90395721-ee37-31bb-9d02-90f9a0ed7c42",
                                        "glosses": [
                                            "An older ewe that may lure a lamb away from its mother."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9665c799-45ff-3029-b6b6-796ca2863ca0",
                                        "entry_id": "90395721-ee37-31bb-9d02-90f9a0ed7c42",
                                        "glosses": [
                                            "Ellipsis of granny knot."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "53fca3e4-841b-407c-baed-0dd1e6a9a528",
                                                "sense_id": "9665c799-45ff-3029-b6b6-796ca2863ca0",
                                                "text": "The suitcase was old. The brown leather was battered and scuffed. Two hanks of clothesline had been wrapped around it and tied in large, clownish grannies."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "granny",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "807df589-acd0-387b-a8e7-324fb42f267c",
                                        "entry_id": "415f038c-bdf8-32dc-922a-6e6eef421299",
                                        "glosses": [
                                            "Typically or stereotypically old-fashioned, especially in clothing and accessories worn by or associated with elderly women."
                                        ],
                                        "tags": [
                                            "informal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18f5bb25-692b-471c-bd35-0d81861e01af",
                                                "sense_id": "807df589-acd0-387b-a8e7-324fb42f267c",
                                                "text": "granny dress; granny glasses"
                                            },
                                            {
                                                "example_id": "bc039fd5-5d7d-46cb-9daa-994b3c0aecda",
                                                "sense_id": "807df589-acd0-387b-a8e7-324fb42f267c",
                                                "text": "1965, Lou Sullivan, personal diary, quoted in 2019, Ellis Martin, Zach Ozma (editors), We Both Laughed In Pleasure\nLong brown fluffy hair, slightly curled on the ends, black coat, gold buttons, belt around the middle, bare legs, no socks, granny heels, also black, shoulder bag, black, transistor radio."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "granny",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ec3db6bd-cb1c-35fa-a9a5-59c84e45050e",
                                        "entry_id": "3524a66d-9a87-339d-94d5-b74c4215d184",
                                        "glosses": [
                                            "To be a grandmother."
