                "senses": [
                    {
                        "sense_id": "ea221f7b-a73a-3b45-b3f8-dff29bd84a67",
                        "entry_id": "68c1d67e-2825-3599-b2df-976065bb0b92",
                        "glosses": [
                            "Eigenschaft, pittoresk zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c701277-68f5-46c4-8e73-ad77201d2d6a",
                                "sense_id": "ea221f7b-a73a-3b45-b3f8-dff29bd84a67",
                                "text": "Sie nehmen es an Pittoreskheit auf mit den Naturwundern der großen Canyons Nord- und Südamerikas."
                            },
                            {
                                "example_id": "ac4b5fc2-199e-497b-a819-7e8b88602a69",
                                "sense_id": "ea221f7b-a73a-3b45-b3f8-dff29bd84a67",
                                "text": "„Noch näher am Ende des Ganges waren Szenen von äußerster Pittoreskheit und Übertreibung an die Wände gepinselt; gegensätzliche Ansichten der Stadt ohne Namen: einerseits in ihrer Verlassenheit und ihrem Verfall, andererseits als das fremdartige neue Paradies, zu dem hinab die Rasse sich ihren Weg durch den Stein gehämmert hatte.“"
                            },
                            {
                                "example_id": "7fc85146-2f53-40ed-9218-10700cf0be17",
                                "sense_id": "ea221f7b-a73a-3b45-b3f8-dff29bd84a67",
                                "text": "Großzügige Boulevards aus der Gründerzeit umrahmen ein Altstadtensemble aus Kuppeln und verwinkelten Stuckschluchten, das in seiner Pittoreskheit selbst Prag- und Krakau-Liebhabern ans Gemüt gehen dürfte."
                            },
                            {
                                "example_id": "3477b589-b3d1-4e8b-8f52-ab346dc61747",
                                "sense_id": "ea221f7b-a73a-3b45-b3f8-dff29bd84a67",
                                "text": "Weil es das pittoreske Original nur einmal gibt, haben gleich mehrere Städte erklärt, diesem Original in Sachen Pittoreskheit kein Jota nachzustehen."
                            },
                            {
                                "example_id": "2a3b9a96-d4b9-4f17-845b-8884029f8156",
                                "sense_id": "ea221f7b-a73a-3b45-b3f8-dff29bd84a67",
                                "text": "Das ist halt die Pittoreskheit unsers Landes."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
