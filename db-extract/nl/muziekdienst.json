                        "examples": [
                            {
                                "example_id": "6c4d5355-3314-4770-8763-393469606804",
                                "sense_id": "65f8bef4-f782-3cc8-ad74-eed482432262",
                                "text": "Hiphoppers van eigen bodem en Ed Sheeran domineren het Nederlandse jaaroverzicht van Spotify. De populaire muziekdienst brengt naar buiten wie de meest gestreamde artiesten van 2017 zijn en welke nummers het vaakst werden gestreamd."
                            },
                            {
                                "example_id": "d730556a-0927-4859-9280-d73f76ea1460",
                                "sense_id": "65f8bef4-f782-3cc8-ad74-eed482432262",
                                "text": "En weer is Nederland een muziekdienst rijker. Kwam eerder dit jaar SoundCloud beschikbaar, nu volgt er een van Nederlandse bodem. Talpa Radio, waar onder meer Sky Radio en 538 bij horen, heeft samen met de Mediamarkt 'Juke' aangekondigd."
                            }
                        ]
