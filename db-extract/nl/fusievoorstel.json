                            {
                                "example_id": "7b34f6d4-f8ab-4955-95e3-2f7159364701",
                                "sense_id": "2e026267-4b0b-3c74-a9db-62d29259622d",
                                "text": "De eerder afgeketste fusie tussen verschillende FNV-bonden lijkt er toch te komen. Op 26 november stemt FNV Bondgenoten opnieuw over het fusievoorstel. Eerder deze maand blokkeerde FNV Bondgenoten de fusie nog."
                            },
                            {
                                "example_id": "9e043d34-19a2-4a01-a92f-8ecf52c09ced",
                                "sense_id": "2e026267-4b0b-3c74-a9db-62d29259622d",
                                "text": "Het mes gaat in de publieke omroep. Minister Van Bijsterveld neemt het fusievoorstel dat de omroepen zelf hebben gemaakt over en bespaart 200 miljoen per jaar. Zo zullen er van de 21 omroepen nog maar 8 overblijven. En dat zullen er nooit meer worden."
                            }
