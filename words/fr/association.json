            "pos": "noun",
            "senses": [
                {
                    "sense_id": "987fb9a0-fa55-3527-b281-64ddb072a34d",
                    "sense_definition": "Groupement de personnes réunies autour d'un projet ou d'un intérêt commun, généralement sans but lucratif.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "organisation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle consacre ses samedis à faire du bénévolat dans une <w>association</w> caritative de son quartier."
                        },
                        {
                            "text": "Les membres de l'<w>association</w> sportive se réunissent chaque mois pour organiser les compétitions."
                        }
                    ],
                    "synonyms": [
                        "amicale"
                    ],
                    "common_phrases": [
                        "association caritative",
                        "association sportive",
                        "association loi 1901"
                    ]
                },
                {
                    "sense_id": "332eeae3-ca6e-3bea-a878-c6243db0ba4e",
                    "sense_definition": "Lien ou combinaison mentale établie entre des idées, des souvenirs ou des images.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "psychologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette odeur provoque chez lui une <w>association</w> immédiate avec ses vacances d'enfance."
                        },
                        {
                            "text": "Pendant la séance, le médecin encourage le patient à pratiquer l'<w>association</w> libre d'idées."
                        }
                    ],
                    "common_phrases": [
                        "association d'idées",
                        "libre association"
                    ]
                },
                {
                    "sense_id": "58b393a7-7378-3d3e-b37a-f74e1805a753",
                    "sense_definition": "Alliance, partenariat ou coopération entre des personnes ou des entités pour mener une action commune.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "partenariat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Leur <w>association</w> professionnelle a permis de lancer une entreprise particulièrement rentable."
                        },
                        {
                            "text": "Ce nouveau festival a été créé en étroite <w>association</w> avec les théâtres de la ville."
                        }
                    ],
