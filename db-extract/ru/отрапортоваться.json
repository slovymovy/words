                        "tags": [],
                        "examples": [
                            {
                                "example_id": "464613ca-dbc8-464f-b208-bf8fefeca07b",
                                "sense_id": "0a728ce2-f672-3734-ad27-73f7d787d3e8",
                                "text": "— Знаете что: я лучше завтра совсем не приду! Отрапорту́юсь больным, и кончено! — решил он наконец."
                            },
                            {
                                "example_id": "4caa5007-65d0-4f59-8067-219bd67b09f1",
                                "sense_id": "0a728ce2-f672-3734-ad27-73f7d787d3e8",
                                "text": "Капитан Татарников — читали? — перестрелял мужиков, отрапортова́лся и тут же себе пулю вляпал."
                            }
                        ]
                    }
