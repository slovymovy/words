                "senses": [
                    {
                        "sense_id": "46ef6d59-5b70-3ecd-9d2d-fc536ea774fc",
                        "entry_id": "004a6461-b7fc-30b5-8cc1-b93ee1ffcc38",
                        "glosses": [
                            "Person, die (meist beruflich) Fotografien nachträglich verändert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b82f275e-3c36-42a5-8bb4-8db7cca6f509",
                                "sense_id": "46ef6d59-5b70-3ecd-9d2d-fc536ea774fc",
                                "text": "„Gern schickten die Verlage ihre Fotografen auch zu den Symbolen für Fortschritt und Wohlstand, den Plattenbausiedlungen. Von oben angeordnet auch die Verfremdung: Retuscheure malten Sommerwolken in die Bilder und löschten Fernsehantennen von den Dächern, vor allem die, die nach Westen zeigten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "11ed5dce-485b-3b8b-8b54-ef839ddfd358",
                        "entry_id": "004a6461-b7fc-30b5-8cc1-b93ee1ffcc38",
                        "glosses": [
                            "Gegenstand, mit dem Steine so bearbeitet werden konnten, dass Werkzeuge daraus entstanden"
                        ],
                        "tags": [
                            "Archäologie"
                        ],
                        "examples": [
                            {
                                "example_id": "cf1083c4-096b-460f-94d9-77098c695faa",
                                "sense_id": "11ed5dce-485b-3b8b-8b54-ef839ddfd358",
                                "text": "„Zudem entdeckten sie einen Retuscheur - einen schmalen Geweihzapfen in einem Lindenast, mit dem man Klingen und Spitzen schärfen konnte.“"
                            },
                            {
                                "example_id": "c511a98c-d935-4486-a7e7-c042a9a57153",
                                "sense_id": "11ed5dce-485b-3b8b-8b54-ef839ddfd358",
                                "text": "„Die Menschen jagten überwiegend Mammut, Wildpferd, Reh und Wollnashorn, konnten Feuer machen und verstanden, aus Stein Faustkeile, Schaber und Klingen zu schlagen, die sie mit einem Retuscheur zu Schärfung nacharbeiteten.“"
                            },
                            {
                                "example_id": "66c9446f-e23c-4468-92d9-50a15be4ac80",
                                "sense_id": "11ed5dce-485b-3b8b-8b54-ef839ddfd358",
                                "text": "„Diese Form der Oberflächenbearbeitung wird mit einem Retuscheur aus Knochen oder Geweih erreicht, der in einen etwa armlangen Holzschaft eingesetzt ist“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
