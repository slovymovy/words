                            },
                            {
                                "target_lang_word": "проездной билет",
                                "target_lang_sense_clarification": "проездной в Лодзи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b9d47650-f88c-3f75-8744-4a4bee4250e2",
                    "sense_definition": "przezroczysta lub półprzezroczysta dodatkowa powieka występująca u niektórych zwierząt",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "biologia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "U ptaków i gadów <w>migawka</w> chroni gałkę oczną przed wysychaniem i urazami mechanicznymi.",
                            "target_lang_translations": {
                                "ru": "У птиц и пресмыкающихся <w>мигательная перепонка</w> защищает глазное яблоко от пересыхания и механических повреждений."
                            }
                        },
                        {
                            "text": "Podczas polowania pod wodą u krokodyla zamyka się przezroczysta <w>migawka</w>.",
                            "target_lang_translations": {
                                "ru": "Во время охоты под водой у крокодила закрывается прозрачное <w>третье веко</w>."
                            }
                        }
                    ],
                    "synonyms": [
