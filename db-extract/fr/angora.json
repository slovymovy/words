                "senses": [
                    {
                        "sense_id": "33ad4e38-973c-337c-aa44-5724db647f67",
                        "entry_id": "18eb0d6a-4605-3def-8946-a1367c3d378b",
                        "glosses": [
                            "Ankara (the capital city of Turkey)"
                        ],
                        "tags": [
                            "feminine",
                            "masculine",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "a987deb4-d1cc-4808-9c7d-62b95c660ab5",
                                "sense_id": "33ad4e38-973c-337c-aa44-5724db647f67",
                                "text": "« Angora est nationaliste, en ce sens qu’elle renonce aux prétensions de l’ancien Empire ottoman et qu’elle veut recréer un foyer turc modeste[…] »",
                                "translation": "“Ankara is nationalist, in the sense that it renounces the pretensions of the old Ottoman Empire and wants to recreate a modest Turkish centre […] ”",
                                "english": "“Ankara is nationalist, in the sense that it renounces the pretensions of the old Ottoman Empire and wants to recreate a modest Turkish centre […] ”"
                            },
                            {
                                "example_id": "a0b0dfd1-31f8-418d-b3a4-a4adb284415b",
                                "sense_id": "33ad4e38-973c-337c-aa44-5724db647f67",
                                "text": "Il y a, dans le vieil Angora, pour celui qui a conservé le goût du passé, pour celui qui veut voir l’image des superpositions de civilisations dans un même lieu, des habitudes séculaires, différentes les unes des autres[…]",
                                "translation": "There is, in the old Ankara, for the one who has preserved a taste for the past, for the one who wants to see an image of many civilizations superimposed in the same place, secular habits, different one from another […]",
                                "english": "There is, in the old Ankara, for the one who has preserved a taste for the past, for the one who wants to see an image of many civilizations superimposed in the same place, secular habits, different one from another […]"
                            },
                            {
                                "example_id": "9341e781-bff2-4fc5-9d22-3fd2cbd25e9a",
                                "sense_id": "33ad4e38-973c-337c-aa44-5724db647f67",
                                "text": "L’offensive est arrêtée. Angora est sauvée. La Turquie patriote, qui a conservé sa foi, a vaincu.",
                                "translation": "The offensive has been stopped. Ankara is saved. Patriotic Turkey, who has kept the faith, has triumphed.",
                                "english": "The offensive has been stopped. Ankara is saved. Patriotic Turkey, who has kept the faith, has triumphed."
                            }
                        ]
                    }
                ],
