                    {
                        "sense_id": "a8c5dc02-1a2f-340c-9205-55f88be53378",
                        "entry_id": "6554c1e3-3aa8-3018-b006-197b1da20e08",
                        "glosses": [
                            "Équipé de deux réacteurs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52112cfb-f14b-475e-812d-f64d2b323ba2",
                                "sense_id": "a8c5dc02-1a2f-340c-9205-55f88be53378",
                                "text": "Un concept de Lockheed Martin pour un avion moyen courrier biréacteur à faible consommation."
                            },
                            {
                                "example_id": "fd05c24a-9429-4fdf-b70e-269f29391343",
                                "sense_id": "a8c5dc02-1a2f-340c-9205-55f88be53378",
                                "text": "Le premier jet d’affaires biréacteur suisse a obtenu jeudi 7 décembre le droit de voler."
                            },
                            {
                                "example_id": "3811d126-9ffa-4c5c-a9e8-dfecffe1bb8d",
                                "sense_id": "a8c5dc02-1a2f-340c-9205-55f88be53378",
                                "text": "En 1995, Boeing fait voler pour la première fois le 777, un long-courrier biréacteur aux dimensions inédites."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5d702fc1-45d0-4aa2-bf44-65a0dfa9e894",
                        "source_entry_id": "6554c1e3-3aa8-3018-b006-197b1da20e08",
                        "source_sense_id": "a8c5dc02-1a2f-340c-9205-55f88be53378",
                        "target_lang_word": "zweistrahlig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zweistrahlig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "57c9569f-f4cd-3e26-acc0-3975fba81d29",
                                        "entry_id": "3359f714-dd1b-3c54-8350-b636e8c9fafe",
                                        "glosses": [
                                            "mit zwei Strahltriebwerken ausgestattet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22a34815-0c9f-460e-83d1-68ad0109d90a",
                                                "sense_id": "57c9569f-f4cd-3e26-acc0-3975fba81d29",
                                                "text": "„Ein Beleg für den Trend weg vom klassischen Jumbojet ist die Bestellung der Lufthansa vom September über 59 zweistrahlige Großraumjets 777-9X sowie A350-900 für 14 Milliarden Euro zu Listenpreisen.“"
                                            },
                                            {
                                                "example_id": "d5b491ab-cce1-4a8c-ac75-9d0dbffc92a5",
                                                "sense_id": "57c9569f-f4cd-3e26-acc0-3975fba81d29",
                                                "text": "„Der zweistrahlige Jet, soll das wieder möglich machen, was seinerzeit nur die Concorde konnte, nämlich wohlbetuchte Kunden von A nach B zu bringen – und das schneller als konventionelle Verkehrsflugzeuge.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
