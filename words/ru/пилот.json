{
    "word_family": [
        "пилотировать",
        "пилотирование",
        "пилотный",
        "автопилот",
        "пилотажный"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "09c5f3da-dfb9-3564-bb9c-de78c03bf0ca",
                    "sense_definition": "Тот, кто управляет летательным аппаратом (самолётом, вертолётом и т. п.)",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "aviation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Опытный <w>пилот</w> гражданской авиации аккуратно посадил лайнер в сильный туман.",
                            "target_lang_translations": {
                                "fr": "Un <w>pilote</w> expérimenté de l'aviation civile a fait atterrir l'avion avec précaution dans un épais brouillard."
                            }
                        },
                        {
                            "text": "Перед взлётом второй <w>пилот</w> внимательно проверил показания всех приборов.",
                            "target_lang_translations": {
                                "fr": "Avant le décollage, le copilote (ou second <w>pilote</w>) a vérifié attentivement les indications de tous les instruments."
                            }
                        }
                    ],
                    "synonyms": [
                        "лётчик"
                    ],
                    "common_phrases": [
                        "первый пилот",
                        "второй пилот",
                        "опытный пилот",
                        "кабина пилота"
                    ],
                    "target_lang_definitions": {
                        "fr": "Personne qui pilote ou conduit un aéronef (avion, hélicoptère, etc.)"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "pilote",
                                "target_lang_sense_clarification": "d'aéronef"
                            },
                            {
                                "target_lang_word": "pilote de ligne",
                                "target_lang_sense_clarification": "aviation civile"
                            },
                            {
                                "target_lang_word": "aviateur",
                                "target_lang_sense_clarification": "plus général ou historique"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fb3b1767-e2c3-3c10-af4c-c81514bc380f",
                    "sense_definition": "Спортсмен, управляющий гоночным автомобилем или другим скоростным средством",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "racing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Молодой <w>пилот</w> Формулы-1 показал отличное время на тренировочном круге.",
                            "target_lang_translations": {
                                "fr": "Le jeune <w>pilote</w> de Formule 1 a réalisé un excellent temps lors du tour d'essais."
                            }
                        },
                        {
                            "text": "Во время крутого поворота <w>пилоты</w> испытывают огромные физические перегрузки.",
                            "target_lang_translations": {
                                "fr": "Dans les virages serrés, les <w>pilotes</w> subissent d'énormes contraintes physiques."
                            }
                        }
                    ],
                    "common_phrases": [
                        "пилот Формулы-1",
                        "пилот болида"
                    ],
                    "target_lang_definitions": {
                        "fr": "Sportif qui conduit un véhicule de course automobile ou un autre engin rapide en compétition"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "pilote",
                                "target_lang_sense_clarification": "de course automobile"
                            },
                            {
                                "target_lang_word": "pilote de course",
                                "target_lang_sense_clarification": "sport mécanique"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1284226c-e840-311d-838d-62d147dd04a0",
                    "sense_definition": "Пробный, пробная или первая серия телесериала, выпуск передачи или проекта",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "media",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Продюсеры посмотрели снятый <w>пилот</w> сериала и сразу одобрили весь сезон.",
                            "target_lang_translations": {
                                "fr": "Les producteurs ont visionné le <w>pilote</w> de la série et ont immédiatement donné leur accord pour toute la saison."
                            }
                        },
                        {
                            "text": "Удачный <w>пилот</w> нового комедийного шоу быстро привлёк внимание широкой аудитории.",
                            "target_lang_translations": {
                                "fr": "Le <w>pilote</w> réussi de la nouvelle émission comique a rapidement attiré l'attention d'un large public."
                            }
                        }
                    ],
                    "synonyms": [
                        "пилотник"
                    ],
                    "common_phrases": [
                        "пилот сериала",
                        "снять пилот",
                        "посмотреть пилот"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "профессиональный жаргон"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Premier épisode d'une série télévisée ou émission test servant à évaluer l'intérêt du public ou des producteurs"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "pilote",
                                "target_lang_sense_clarification": "épisode pilote"
                            },
                            {
                                "target_lang_word": "épisode pilote",
                                "target_lang_sense_clarification": "télévision"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "319952a8-e6c7-36e7-bc34-f83bfb13b2a9",
                    "sense_definition": "Сетевой фильтр, электрический удлинитель с несколькими розетками и выключателем",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Не забудь включить кнопку на <w>пилоте</w>, иначе компьютер не будет работать.",
                            "target_lang_translations": {
                                "fr": "N'oublie pas d'appuyer sur le bouton de la <w>multiprise</w>, sinon l'ordinateur ne fonctionnera pas."
                            }
                        },
                        {
                            "text": "Мы подключили монитор, системный блок и настольную лампу в один <w>пилот</w>.",
                            "target_lang_translations": {
                                "fr": "Nous avons branché l'écran, l'unité centrale et la lampe de bureau sur une seule et même <w>multiprise</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "включить пилот",
                        "выключить пилот"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Rallonge électrique dotée de plusieurs prises de courant et souvent d'un interrupteur ou d'un parasurtenseur"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "multiprise",
                                "target_lang_sense_clarification": "bloc multiprise avec interrupteur"
                            },
                            {
                                "target_lang_word": "bloc multiprise",
                                "target_lang_sense_clarification": "matériel électrique"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "15b9e9b8-a821-336a-bbe8-5e8f03c0d5fe",
                    "sense_definition": "Короткая утеплённая куртка прямого кроя на молнии в стиле формы военных лётчиков",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Осенью он часто носил стильный кожаный <w>пилот</w> с тёплым меховым воротником.",
                            "target_lang_translations": {
                                "fr": "En automne, il portait souvent un élégant <w>blouson aviateur</w> en cuir avec un col en fourrure bien chaud."
                            }
                        },
                        {
                            "text": "В новом магазине продаётся классический <w>пилот</w> из прочной плотной ткани.",
                            "target_lang_translations": {
                                "fr": "Dans ce nouveau magasin, on trouve un <w>bomber</w> classique en tissu épais et résistant."
                            }
                        }
                    ],
                    "synonyms": [
                        "бомбер"
                    ],
                    "common_phrases": [
                        "куртка пилот",
                        "кожаный пилот"
                    ],
                    "target_lang_definitions": {
                        "fr": "Blouson court et chaud inspiré des vestes des pilotes de l'armée, souvent en cuir ou avec un col en fourrure"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "blouson aviateur",
                                "target_lang_sense_clarification": "veste style aviateur"
                            },
                            {
                                "target_lang_word": "bomber",
                                "target_lang_sense_clarification": "blouson court zippé"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9bad22c5-67d8-3a16-bf6f-d6e2ddefe869",
                    "sense_definition": "Морская хищная рыба из семейства ставридовых, часто сопровождающая акул и корабли",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Полосатый <w>пилот</w> плыл в океане рядом с крупной белой акулой.",
                            "target_lang_translations": {
                                "fr": "Le <w>poisson-pilote</w> rayé nageait dans l'océan aux côtés d'un grand requin blanc."
                            }
                        },
                        {
                            "text": "Эта небольшая рыба получила имя <w>пилот</w> за привычку следовать за морскими судами.",
                            "target_lang_translations": {
                                "fr": "Ce petit poisson a reçu le nom de <w>poisson-pilote</w> en raison de son habitude de suivre les navires."
                            }
                        }
                    ],
                    "common_phrases": [
                        "рыба пилот"
                    ],
                    "target_lang_definitions": {
                        "fr": "Poisson de mer prédateur de la famille des carangidés, connu pour accompagner les requins et les navires"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "poisson-pilote",
                                "target_lang_sense_clarification": "espèce de poisson"
                            },
                            {
                                "target_lang_word": "pilote",
                                "target_lang_sense_clarification": "zoologie marine"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a295cc58-da4c-36ce-baba-b7d40154dd4e",
                    "sense_definition": "Специалист по проводке морских или речных судов через опасные участки",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "marine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Старый <w>пилот</w> поднялся на борт корабля, чтобы провести его через опасные рифы.",
                            "target_lang_translations": {
                                "fr": "Le vieux <w>pilote</w> est monté à bord du navire pour le guider à travers les récifs dangereux."
                            }
                        },
                        {
                            "text": "В старинных морских рассказах проводника корабля часто называли словом <w>пилот</w>.",
                            "target_lang_translations": {
                                "fr": "Dans les récits maritimes d'autrefois, le guide du navire était souvent désigné par le mot <w>pilote</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "лоцман"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "устаревшее значение"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Marin expérimenté chargé de guider les navires dans les passages difficiles, à l'entrée d'un port ou sur un fleuve"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "pilote",
                                "target_lang_sense_clarification": "marine"
                            },
                            {
                                "target_lang_word": "lamaneur",
                                "target_lang_sense_clarification": "guidage portuaire"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}