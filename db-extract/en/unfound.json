                        "glosses": [
                            "To disestablish; to undo the founding of."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "6d5c170b-6e61-4679-9536-f7ce3bb5ce9f",
                                "sense_id": "76d123c0-10f3-3925-875e-555bea9443fd",
                                "text": "The Etruscans and Romans practiced destructive rituals to deconsecrate temples and “unfound” cities. Such practices were necessary to remove an old god from his or her temple when rededicating a site to a new deity."
                            }
                        ]
