                                "sense_id": "910f945a-4650-3b4f-b551-ef54eb450277",
                                "text": "The bank rejected the unsigned check."
                            }
                        ]
                    },
                    {
                        "sense_id": "c16e9b70-b95c-34c3-b47b-2a298290c40c",
                        "entry_id": "eb046ef7-d2ed-3a9a-acae-f320132a5b53",
                        "glosses": [
                            "Not signed to an organization such as a sports club or record label."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
