                    {
                        "translation_id": "2fa2d0bd-ae1e-4b74-9811-2788a611482f",
                        "source_entry_id": "e1d01722-977e-37e1-abc4-7cbd511e5261",
                        "source_sense_description": "a genre of folk music and dance native to Andalusia, Spain",
                        "target_lang_word": "flamenco",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
