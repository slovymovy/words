                    {
                        "translation_id": "e73a1dba-4123-4bf7-8a9a-e59617332ae6",
                        "source_entry_id": "98201b4e-6a25-31f4-969c-cc99fcae8000",
                        "source_sense_description": "state of being practical or feasible",
                        "target_lang_word": "Machbarkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
