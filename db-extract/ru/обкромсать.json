                "senses": [
                    {
                        "sense_id": "4a98996b-3552-3fc8-be56-7639a89d94e5",
                        "entry_id": "12f1e5ed-ea42-3016-938c-2b9fdca36f0f",
                        "glosses": [
                            "разг. обрезать неровно, небрежно"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6d64bd6-17c8-49d6-a749-766f2b9e33b9",
                                "sense_id": "4a98996b-3552-3fc8-be56-7639a89d94e5",
                                "text": "Он поточил о печку нож и, смерив оба рукава, решительно обкромсал их."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ea098470-928e-447c-9840-d0c9e8f9cd16",
                        "source_entry_id": "12f1e5ed-ea42-3016-938c-2b9fdca36f0f",
                        "source_sense_id": "4a98996b-3552-3fc8-be56-7639a89d94e5",
                        "target_lang_word": "déchiqueter",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "déchiqueter",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dc4beb50-7984-3713-861b-57697a311cad",
                                        "entry_id": "7932521a-affd-3e1a-a6c3-c402b6e1b3ef",
                                        "glosses": [
                                            "Tailler menu, découper en faisant diverses taillades."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0294e0de-6242-412c-98a4-c8d0ff7846c0",
                                                "sense_id": "dc4beb50-7984-3713-861b-57697a311cad",
                                                "text": "Son pied gauche, dont l'orteil rongeait la chaussette dix fois raccommodée, déchiquetant les mailles et creusant sa trouée, le faisait souffrir cruellement."
                                            },
                                            {
                                                "example_id": "56ebbc0b-761e-4da1-b0ca-91601201ee46",
                                                "sense_id": "dc4beb50-7984-3713-861b-57697a311cad",
                                                "text": "Déchiqueter la peau. - Déchiqueter la chair."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e32e56bd-11ee-3aa3-bde0-7d8f7826a485",
                                        "entry_id": "7932521a-affd-3e1a-a6c3-c402b6e1b3ef",
                                        "glosses": [
                                            "Découper avec maladresse."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6d1e0c9-f771-4e7d-9fa2-892dc02e8557",
                                                "sense_id": "e32e56bd-11ee-3aa3-bde0-7d8f7826a485",
                                                "text": "Il ne découpe pas le poulet, il le déchiquette."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e650a221-de25-35a0-995d-6407f9964d97",
                                        "entry_id": "7932521a-affd-3e1a-a6c3-c402b6e1b3ef",
                                        "glosses": [
                                            "Critiquer très durement."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa4bf661-a53e-4878-a749-1bbd9788787b",
                                                "sense_id": "e650a221-de25-35a0-995d-6407f9964d97",
                                                "text": "Nous affections de parler de lui, certes. Mais notre admiration pour lui se mêlait d’un certain dégoût. Nous le déchiquetions en détail pour le plaisir de nous rencontrer sur une proie commune."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
