                "translations": [
                    {
                        "translation_id": "763833a8-63f4-4ed0-8f1f-e05b085c8f65",
                        "source_entry_id": "4ca8b5cc-f174-3e1c-8cc5-da2dd8bdb5cc",
                        "source_sense_id": "93bab095-c2da-3448-b64d-d3cba53fb357",
                        "target_lang_word": "Eve",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eve",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c906b25e-63d8-36a8-be35-a972928be65c",
                                        "entry_id": "5c2911ed-90b2-320c-af81-764032b5c818",
                                        "glosses": [
                                            "The first woman and mother of the human race; Adam's wife."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6138feda-257e-4ff7-9f78-b0aba2adab8c",
                                                "sense_id": "c906b25e-63d8-36a8-be35-a972928be65c",
                                                "text": "And Adam called his wife's name Eve; because she was the mother of all living."
                                            },
                                            {
                                                "example_id": "2b4f22e6-9b67-4316-9d0c-76360b49758a",
                                                "sense_id": "c906b25e-63d8-36a8-be35-a972928be65c",
                                                "text": "After all these years, I see that I was mistaken about Eve in the beginning; it is better to live outside the Garden with her than inside it without her."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b83f4579-04da-3cac-a0cf-0aeca7ca1e2b",
                                        "entry_id": "5c2911ed-90b2-320c-af81-764032b5c818",
                                        "glosses": [
                                            "An unspecified primordial woman, from whom many or all people are descended."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "867aa83e-4f8a-4b57-831c-60819533ebbb",
                                                "sense_id": "b83f4579-04da-3cac-a0cf-0aeca7ca1e2b",
                                                "text": "The Seven Daughters of Eve; Mitochondrial Eve"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d71e704-1fb4-3e63-82e0-d365a8aad4e1",
                                        "entry_id": "5c2911ed-90b2-320c-af81-764032b5c818",
                                        "glosses": [
                                            "A female given name from Hebrew."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a2846ac-6e13-4dfd-94fe-275c0dcac91b",
                                                "sense_id": "4d71e704-1fb4-3e63-82e0-d365a8aad4e1",
                                                "text": "\"You were always a cynic,\" said Edith tolerantly. \"I'm sure that Eve will want to have a baby - isn't that why we called her Eve?\"\n\"Of course not,\" said Herbert, as if the baby-cult had long been irritating him. \"We called her Eve, or Evelyn, after your grandmother, who was going to leave, and did leave us some money.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18760ebd-1db7-3f70-aaa1-63f7948047ce",
                                        "entry_id": "5c2911ed-90b2-320c-af81-764032b5c818",
                                        "glosses": [
                                            "An unincorporated community in Kentucky, United States."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a713fa16-8091-39a8-8588-a26d9667b6e2",
