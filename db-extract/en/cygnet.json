                                    {
                                        "sense_id": "c33a2ff8-24d6-3786-a458-c917aeb2df59",
                                        "entry_id": "4341a47a-1229-32cb-9b96-932a1623fa97",
                                        "glosses": [
                                            "Petit du cygne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5ce98b3-9991-420d-9afa-40bc17160439",
                                                "sense_id": "c33a2ff8-24d6-3786-a458-c917aeb2df59",
                                                "text": "Par exemple si, en reprenant l’exemple des canards colverts du paragraphe 3.2.1, un cygneau (petit du cygne) se trouve parmi les canetons."
                                            },
                                            {
                                                "example_id": "6d1e5176-3e7e-4ad9-a751-d99dcfac3613",
                                                "sense_id": "c33a2ff8-24d6-3786-a458-c917aeb2df59",
                                                "text": "Un cri de joie s’éleva parmi les cygneaux."
                                            },
                                            {
                                                "example_id": "35e1aa7a-32b0-46e6-b589-748f3adfa615",
                                                "sense_id": "c33a2ff8-24d6-3786-a458-c917aeb2df59",
                                                "text": "Je compte une biche, un cygneau, une grenouille, un ours, un lynx, cinq chiens et trois anguipèdes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
