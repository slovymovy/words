                                                "example_id": "dcc6638b-5e42-4d4c-a1f2-83dac7a15bfa",
                                                "sense_id": "710d9355-029c-3bef-8393-97c2dc847fda",
                                                "text": "Bist du jetzt völlig abgedreht, oder was?"
                                            },
