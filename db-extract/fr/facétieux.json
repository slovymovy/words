                                        "entry_id": "27811514-e8d8-328f-bc4b-b8c309ffb919",
                                        "glosses": [
                                            "mit Spaß, in der Art und Weise eines Spaßes, unterhaltsam, witzig, humorvoll"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eef6bcce-c19f-450b-a411-204de2df0441",
                                                "sense_id": "a0769c98-1ac1-3375-b588-4084e55357c9",
                                                "text": "Irgendwann geht auch der spaßigste Tag zu Ende."
                                            },
                                            {
                                                "example_id": "c6739def-3bfa-459a-bad8-3990a1525328",
                                                "sense_id": "a0769c98-1ac1-3375-b588-4084e55357c9",
                                                "text": "Das ist kein spaßiger Clown, nein, das ist ein Horrorclown."
                                            },
                                            {
                                                "example_id": "3b8f0b00-a35c-4e9d-9b89-ee4943b1221d",
                                                "sense_id": "a0769c98-1ac1-3375-b588-4084e55357c9",
                                                "text": "So, du meinst also, das sei spaßig?"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6cfbc8ca-ccc1-4334-804a-42fa238f6acf",
