                                    },
                                    {
                                        "sense_id": "8f3e047a-cd0b-3eef-af1e-83147b719e0b",
                                        "entry_id": "9ebfc46b-41aa-3d8a-8503-f9289cb1ebcc",
                                        "glosses": [
                                            "Having no prominent or important feature, as of an argument, discourse, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef501523-eb36-487e-8b2b-4f7e8c17c629",
                                                "sense_id": "8f3e047a-cd0b-3eef-af1e-83147b719e0b",
                                                "text": "a pointless remark"
                                            },
                                            {
                                                "example_id": "da7701d6-adab-4071-8983-28a4116b8d41",
                                                "sense_id": "8f3e047a-cd0b-3eef-af1e-83147b719e0b",
                                                "text": "The sequel to the film was even more pointless than the original"
                                            },
                                            {
                                                "example_id": "8daf8566-37db-4e4b-9ec4-e652c4275666",
                                                "sense_id": "8f3e047a-cd0b-3eef-af1e-83147b719e0b",
                                                "text": "Even the numerous drunkards and beggars seemed to be in a hurry, stumbling from one side of the street to the other with pointless resolution or, with businesslike expeditiousness, soliciting money and food from strangers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4357826-b8e8-3140-bf6d-fd3d7aa3b301",
                                        "entry_id": "9ebfc46b-41aa-3d8a-8503-f9289cb1ebcc",
                                        "glosses": [
                                            "Having no purpose; purposeless; unable to effect an aim."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "372b2ce9-b658-40b2-b8b9-4d4a2612f89f",
                                                "sense_id": "b4357826-b8e8-3140-bf6d-fd3d7aa3b301",
                                                "text": "Since the decision has already been made, further discussion seems pointless."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "621ea417-5874-310b-89f4-0628c556202d",
                                        "entry_id": "9ebfc46b-41aa-3d8a-8503-f9289cb1ebcc",
                                        "glosses": [
                                            "Having no points"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34b357c1-d237-4bbe-b2e8-761b46e3c913",
                                                "sense_id": "621ea417-5874-310b-89f4-0628c556202d",
                                                "text": "After four matches and four defeats, United remain pointless at the foot of the table."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17ba42af-9642-3de7-add1-f16ace79f6f0",
                                        "entry_id": "9ebfc46b-41aa-3d8a-8503-f9289cb1ebcc",
