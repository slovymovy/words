                "senses": [
                    {
                        "sense_id": "064cb975-98c1-39cc-a4c1-cb7a912e2731",
                        "entry_id": "ce2cf208-571f-36af-99f4-b2b92205f8f5",
                        "glosses": [
                            "физ. передача электромагнитных сигналов на расстоянии"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9dd38188-49f9-491d-941a-e4851a8cfc43",
                                "sense_id": "064cb975-98c1-39cc-a4c1-cb7a912e2731",
                                "text": "Радио — гениальное изобретение человечества."
                            }
                        ]
                    },
                    {
                        "sense_id": "60dc7710-d2b6-3360-b5ca-9d1a6e1e13c0",
                        "entry_id": "ce2cf208-571f-36af-99f4-b2b92205f8f5",
                        "glosses": [
                            "экон. отрасль техники, связанная с передачей электромагнитных сигналов"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "e4f94b3a-69b0-3685-a926-b5b92548363e",
                        "entry_id": "ce2cf208-571f-36af-99f4-b2b92205f8f5",
                        "glosses": [
                            "разг. то же, что радиоприёмник или репродуктор"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33859dc0-5970-4ef0-87df-2ae75a1cf233",
                                "sense_id": "e4f94b3a-69b0-3685-a926-b5b92548363e",
                                "text": "И вдруг шофёр включил радио и с невероятной определённостью возникла музыка."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f92ddde3-981b-407c-b3f4-46a4c1b91344",
