                ],
                "translations": [
                    {
                        "translation_id": "ca5d1e58-620b-4a33-af21-99f342fb3f73",
                        "source_entry_id": "fe4b441f-2ea1-3837-affe-082cb9fb7c7c",
                        "target_lang_word": "foretell",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "foretell",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7a2e584f-773a-3bb5-bf03-97ec70cf3e73",
                                        "entry_id": "74035b83-a0a8-3700-a403-7e2f31ce4cbc",
                                        "glosses": [
                                            "To predict; to tell (the future) before it occurs; to prophesy."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "677354a8-d721-480a-9304-0f9a50178280",
                                                "sense_id": "7a2e584f-773a-3bb5-bf03-97ec70cf3e73",
                                                "text": "Deeds then undone me faithful tongue foretold."
                                            },
                                            {
                                                "example_id": "bbb9f971-7749-4e9b-be29-aed072ac3b0c",
                                                "sense_id": "7a2e584f-773a-3bb5-bf03-97ec70cf3e73",
                                                "text": "Prodigies, foretelling the future eminence and lustre of his character."
                                            },
                                            {
                                                "example_id": "80ab44f6-1883-4a6e-915d-863e80542296",
                                                "sense_id": "7a2e584f-773a-3bb5-bf03-97ec70cf3e73",
                                                "text": "This was a demise foretold. Fatalistic in the face of a parliamentary impasse, Mr. Bayrou had, even before the debate began, invited his entourage to a “convivial moment,” or farewell soirée, this evening."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7dea0b88-1e0a-3811-9f3e-047314722f91",
                                        "entry_id": "74035b83-a0a8-3700-a403-7e2f31ce4cbc",
                                        "glosses": [
                                            "To tell (a person) of the future."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b2d706b-99c2-4c3c-8bf5-1f14934f7bc4",
                                                "sense_id": "7dea0b88-1e0a-3811-9f3e-047314722f91",
                                                "text": "[…] there came to him a Person named Saul, whom Samuel had never before seen; but God made him know it was the same he had foretold him of."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
