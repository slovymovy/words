{
    "word_family": [
        "kindle",
        "kindler"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e6ae8a7d-a979-3ecf-9bc5-264e15f1f330",
                    "sense_definition": "Small pieces of wood and twigs used to start a fire.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fire_starting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We gathered dry twigs to use as <w>kindling</w> for the campfire.",
                            "target_lang_translations": {
                                "es": "Recogimos ramas secas para usarlas como <w>astillas</w> para la fogata."
                            }
                        },
                        {
                            "text": "She placed the <w>kindling</w> carefully under the logs to help the fire grow.",
                            "target_lang_translations": {
                                "es": "Colocó las <w>astillas</w> cuidadosamente debajo de los troncos para ayudar a que el fuego creciera."
                            }
                        }
                    ],
                    "synonyms": [
                        "tinder"
                    ],
                    "common_phrases": [
                        "dry kindling",
                        "collect kindling"
                    ],
                    "target_lang_definitions": {
                        "es": "Pequeños trozos de madera y ramas secas que se utilizan para encender un fuego."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "astillas",
                                "target_lang_sense_clarification": "Trozos pequeños de madera usados para iniciar el fuego."
                            },
                            {
                                "target_lang_word": "yesca",
                                "target_lang_sense_clarification": "Material seco y fácil de encender para iniciar una hoguera."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8ae7fbeb-5a93-3601-8a5a-302bb068331a",
                    "sense_definition": "The act of starting a fire or igniting a feeling.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fire_starting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>kindling</w> of his passion for music began during his childhood years.",
                            "target_lang_translations": {
                                "es": "El <w>despertar</w> de su pasión por la música comenzó durante sus años de infancia."
                            }
                        },
                        {
                            "text": "The sudden <w>kindling</w> of the torch illuminated the dark cave walls.",
                            "target_lang_translations": {
                                "es": "El repentino <w>encendido</w> de la antorcha iluminó las oscuras paredes de la cueva."
                            }
                        }
                    ],
                    "synonyms": [
                        "ignition",
                        "lighting"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Often used in a metaphorical or literary sense."
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "El acto de encender un fuego o despertar un sentimiento."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "encendido",
                                "target_lang_sense_clarification": "El proceso físico de prender fuego."
                            },
                            {
                                "target_lang_word": "despertar",
                                "target_lang_sense_clarification": "El acto metafórico de avivar una pasión o sentimiento."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "89c7767d-9e8f-32cb-ad8c-d1a6ec859556",
                    "sense_definition": "present participle and gerund of <w>kindle</w>",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "fire_starting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent several minutes <w>kindling</w> the wood in the fireplace.",
                            "target_lang_translations": {
                                "es": "Pasó varios minutos <w>encendiendo</w> la leña en la chimenea."
                            }
                        },
                        {
                            "text": "The process of <w>kindling</w> a fire requires patience and dry materials.",
                            "target_lang_translations": {
                                "es": "El proceso de <w>encender</w> un fuego requiere paciencia y materiales secos."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "This is a grammatical form of the verb kindle."
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Forma verbal (gerundio) de encender o avivar un fuego."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "encendiendo",
                                "target_lang_sense_clarification": "Gerundio del verbo encender."
                            },
                            {
                                "target_lang_word": "avivando",
                                "target_lang_sense_clarification": "Gerundio usado para referirse a hacer que el fuego crezca."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ba91d7bb-bcf9-33a5-8157-ae3722a4e2a3",
                    "sense_definition": "Illuminated or lit up.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>kindling</w> sky signaled the arrival of the early morning sun.",
                            "target_lang_translations": {
                                "es": "El <w>resplandeciente</w> cielo señalaba la llegada del sol de la mañana."
                            }
                        },
                        {
                            "text": "She looked out at the <w>kindling</w> horizon with a sense of hope.",
                            "target_lang_translations": {
                                "es": "Miró hacia el <w>iluminado</w> horizonte con un sentimiento de esperanza."
                            }
                        }
                    ],
                    "synonyms": [
                        "glowing",
                        "bright"
                    ],
                    "antonyms": [
                        "dark"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used primarily in literary or poetic contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Que está iluminado o resplandeciente."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "resplandeciente",
                                "target_lang_sense_clarification": "Que brilla con mucha intensidad."
                            },
                            {
                                "target_lang_word": "iluminado",
                                "target_lang_sense_clarification": "Que recibe luz o está encendido."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}