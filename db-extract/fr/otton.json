                        "sense_id": "58217c3f-f85c-35a4-a107-ffb0ef008b7f",
                        "entry_id": "e7f5ff94-d5be-3b8e-ab74-7d66e850c046",
                        "glosses": [
                            "Grain qui reste attaché, lors du battage, aux glumes, voire à l’épillet."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "4b3b254b-ee99-4323-b802-da768801b08e",
                                "sense_id": "58217c3f-f85c-35a4-a107-ffb0ef008b7f",
                                "text": "[…]; car le grain coupé avant cette époque devient retrait , se bat mal , fait beaucoup de ottons , n'est pas de garde et ne peut servir en semence ; outre cela, la paille revient dans le tas et prend un goût de chanci."
                            },
                            {
                                "example_id": "fe6c713f-684e-4b34-8f32-ea2fd350f076",
                                "sense_id": "58217c3f-f85c-35a4-a107-ffb0ef008b7f",
                                "text": "Jusqu'ici les ottons, pilons, grosses têtes, épis cassés et non battus, etc., tombaient à terre, mélangés avec une certaine proportion de grain, et à la fin de la journée on était obligé de repasser tous ces débris dans le batteur ou sur les secoueurs, pour en obtenir la séparation et le nettoyage."
                            }
                        ]
                    }
