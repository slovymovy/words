{
    "word_family": [
        "smak",
        "smaczny",
        "posmakować",
        "smakosz",
        "smakowity",
        "posmak"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "265f8d6c-2331-399f-b1f8-8360db472d38",
                    "sense_definition": "o potrawach, napojach itp.: być dobrym w smaku, podobać się komuś pod względem smaku",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "byc_smacznym",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Czy obiad ci <w>smakuje</w>?",
                            "target_lang_translations": {
                                "ru": "Тебе <w>нравится</w> обед?",
                                "en": "Do you <w>like</w> the dinner?"
                            }
                        },
                        {
                            "text": "Ta zupa bardzo mi <w>smakuje</w> i chętnie zjem jeszcze jedną porcję.",
                            "target_lang_translations": {
                                "ru": "Этот суп мне очень <w>нравится на вкус</w>, и я с удовольствием съем еще одну порцию.",
                                "en": "This soup <w>tastes very good</w> to me, and I'd gladly have another helping."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bardzo smakować",
                        "smakować komuś"
                    ],
                    "target_lang_definitions": {
                        "ru": "о блюдах, напитках и т. д.: быть приятным на вкус, нравиться кому-либо по вкусу",
                        "en": "of food, drinks, etc.: to taste good, to be liked by someone in terms of flavor"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нравиться",
                                "target_lang_sense_clarification": "о вкусе еды или напитка"
                            },
                            {
                                "target_lang_word": "быть по вкусу",
                                "target_lang_sense_clarification": "приходиться по вкусу"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "taste good",
                                "target_lang_sense_clarification": "to have a pleasant flavor"
                            },
                            {
                                "target_lang_word": "like",
                                "target_lang_sense_clarification": "to enjoy the taste of something"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "97ca5461-1497-38d7-b673-3b1f2f250c8f",
                    "sense_definition": "o potrawach, napojach itp.: mieć określony smak",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "miec_smak",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ta herbata <w>smakuje</w> jak cytryna.",
                            "target_lang_translations": {
                                "ru": "Этот чай <w>на вкус как</w> лимон.",
                                "en": "This tea <w>tastes</w> like lemon."
                            }
                        },
                        {
                            "text": "Czekoladowo-orzechowy budyń Heleny <w>smakował</w> okropnie, ale zjadłam jedną porcję z uprzejmości.",
                            "target_lang_translations": {
                                "ru": "Шоколадно-ореховый пудинг Хелены был <w>ужасен на вкус</w>, но я съела одну порцию из вежливости.",
                                "en": "Helena's chocolate-hazelnut pudding <w>tasted</w> terrible, but I ate one portion out of politeness."
                            }
                        }
                    ],
                    "common_phrases": [
                        "smakować jak",
                        "smakować okropnie"
                    ],
                    "target_lang_definitions": {
                        "ru": "о блюдах, напитках и т. д.: иметь определенный вкус",
                        "en": "of food, drinks, etc.: to have a specific flavor"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "иметь вкус",
                                "target_lang_sense_clarification": "быть на вкус каким-либо"
                            },
                            {
                                "target_lang_word": "быть на вкус как",
                                "target_lang_sense_clarification": "напоминать по вкусу что-либо"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "taste",
                                "target_lang_sense_clarification": "to have a particular flavor"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f2ede00a-6b97-3236-86c3-96e702ae70d6",
                    "sense_definition": "próbować czegoś w celu określenia smaku",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "probowac_smaku",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kucharz powoli <w>smakował</w> sos, aby sprawdzić, czy nie brakuje w nim soli.",
                            "target_lang_translations": {
                                "ru": "Повар медленно <w>пробовал</w> соус, чтобы проверить, хватает ли в нем соли.",
                                "en": "The chef slowly <w>tasted</w> the sauce to check if it needed salt."
                            }
                        },
                        {
                            "text": "Nie muszę być kiperem, by <w>smakować</w> wino.",
                            "target_lang_translations": {
                                "ru": "Мне не нужно быть сомелье, чтобы <w>дегустировать</w> вино.",
                                "en": "I don't have to be a wine taster to <w>taste</w> wine."
                            }
                        }
                    ],
                    "synonyms": [
                        "próbować",
                        "kosztować",
                        "degustować"
                    ],
                    "common_phrases": [
                        "smakować potrawę",
                        "smakować wino"
                    ],
                    "target_lang_definitions": {
                        "ru": "пробовать что-либо с целью определить вкус",
                        "en": "to try something in order to determine its flavor"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пробовать",
                                "target_lang_sense_clarification": "снимать пробу, оценивать вкус"
                            },
                            {
                                "target_lang_word": "отведывать",
                                "target_lang_sense_clarification": "пробовать на вкус еду или напиток"
                            },
                            {
                                "target_lang_word": "дегустировать",
                                "target_lang_sense_clarification": "оценивать качество, смаковать"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "taste",
                                "target_lang_sense_clarification": "to sample the flavor of something"
                            },
                            {
                                "target_lang_word": "try",
                                "target_lang_sense_clarification": "to sample food or drink"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}