                    {
                        "translation_id": "eca11330-cba3-465f-8151-30b88eb45f6c",
                        "source_entry_id": "54fb4866-97a7-3829-89f3-0aeb9d38e3a2",
                        "source_sense_description": "common ancestor language",
                        "target_lang_word": "Ursprache",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
