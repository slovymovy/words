                "senses": [
                    {
                        "sense_id": "3834c097-e6a5-315c-b550-333bbbe3b567",
                        "entry_id": "f269c363-3229-3593-a76c-a1cc0079dbdc",
                        "glosses": [
                            "Schiene für die Straßenbahn"
