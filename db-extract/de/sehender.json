                ],
                "senses": [
                    {
                        "sense_id": "445b6137-d81d-35d7-bc9d-c8cb85b32f64",
                        "entry_id": "a62ea632-6db9-3d82-89c9-7bdb0b951cc5",
                        "glosses": [
                            "Person, die sehen kann; Person mit funktionierendem Sehvermögen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf5955ab-7660-4e80-a620-59557494a33d",
                                "sense_id": "445b6137-d81d-35d7-bc9d-c8cb85b32f64",
                                "text": "„Wir Sehenden glauben gern, blinde Menschen würden einfach nur schwarz ‚sehen‘.“"
                            },
                            {
                                "example_id": "e48cb88d-67fc-4f52-abdf-390d7203faed",
                                "sense_id": "445b6137-d81d-35d7-bc9d-c8cb85b32f64",
                                "text": "„Zu den Exponaten gehören Harry Potter Bücher (für Blinde und Sehende), die Fernsehzeitung Braille TV und andere Zeitschriften in Blindenschrift – in denen man übrigens blättern kann!“"
                            },
                            {
                                "example_id": "d88e025e-7208-4950-9c92-f78887f2af3c",
                                "sense_id": "445b6137-d81d-35d7-bc9d-c8cb85b32f64",
                                "text": "„Der Alltag ohne Lesen ist für uns Sehende fast nicht vorstellbar.“"
                            },
                            {
                                "example_id": "3c34c641-4396-4184-a0e2-4306fe26af42",
                                "sense_id": "445b6137-d81d-35d7-bc9d-c8cb85b32f64",
                                "text": "„Sehende schlüpfen in die Rolle von Blinden, und Blinde sind diejenigen, die die Sehenden im Dunkeln ins Ziel führen.“"
                            },
                            {
                                "example_id": "179375d9-54a0-4b0c-8c81-8388748bc360",
                                "sense_id": "445b6137-d81d-35d7-bc9d-c8cb85b32f64",
                                "text": "„Ich mache heute nahezu alles, was ein Sehender auch tut – nur eben anders.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "72b17e02-e18a-387a-9141-44e9bce0284c",
                        "entry_id": "a62ea632-6db9-3d82-89c9-7bdb0b951cc5",
                        "glosses": [
                            "Person, die die Wahrheit „sehen“ (erfassen, erkennen) kann"
                        ],
                        "tags": [
                            "metaphorisch"
                        ],
                        "examples": [
                            {
                                "example_id": "d32362f2-8496-495b-8339-3c9b28797d0a",
                                "sense_id": "72b17e02-e18a-387a-9141-44e9bce0284c",
                                "text": "„Mag Jesus auch am Ende der Geschichte sagen, dass nicht die Sehenden, sondern die Glaubenden selig sind – viele berührt gerade dieser Thomas, der zunächst einmal sehen will.“"
                            },
                            {
                                "example_id": "4e7d9c0c-4718-4e3c-adfe-987b002c423f",
                                "sense_id": "72b17e02-e18a-387a-9141-44e9bce0284c",
                                "text": "„Jedes Individuum, das dieser Bezeichnung würdig ist, muß selbst ‚wahrer Mensch‘ werden, also ein »Sehender« und »Wissender«.“"
                            },
                            {
                                "example_id": "4f9d4346-14b4-4b77-9c1f-9108de6cbba4",
                                "sense_id": "72b17e02-e18a-387a-9141-44e9bce0284c",
                                "text": "„Werdet zu Sehenden, damit ihr erkennen, aufdecken und der Lüge ebenso entgegentreten könnt. Nur wer in und durch die Wahrheit lebt, kann die Lügen aufdecken und sie bekämpfen.“"
                            },
                            {
                                "example_id": "6444a609-2d40-4234-8e50-7c9355cc8488",
                                "sense_id": "72b17e02-e18a-387a-9141-44e9bce0284c",
                                "text": "„Die Wurzel aller Übel ist das Schweigen der Sehenden zu fragwürdigen Zeitentwicklungen aus purer Feigheit[.]“"
                            },
                            {
                                "example_id": "fb097a90-b9a5-4047-8213-e33384fb5e90",
                                "sense_id": "72b17e02-e18a-387a-9141-44e9bce0284c",
                                "text": "„‚Ich bin’s‘, bekennt er sich nicht nur ‚zur eigenen Identität‘, vielmehr ‚ist seine Identität als Sehender untrennbar mit Jesus verbunden, scheint in seinem schlichten ‚Ich bin’s‘ für die Leser- und Hörerschaft des Evangeliums das ‚Ich bin’s‘ Jesu auf.‘“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
