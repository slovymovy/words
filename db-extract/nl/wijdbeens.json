                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "249dee65-1804-4a7e-bc6b-113f15307219",
                                                "sense_id": "311fc5f8-a041-3e81-9192-e6f4e25ecd4b",
                                                "text": "[…] see that your men reload their muskets the meanwhile, ready for any old woman we may see riding through the air astraddle a broomstick."
                                            },
                                            {
                                                "example_id": "93e24728-366b-4411-8e13-136d5f8c813a",
                                                "sense_id": "311fc5f8-a041-3e81-9192-e6f4e25ecd4b",
                                                "text": "The used-to-be sheriff sat rakishly astraddle his horse."
                                            },
                                            {
                                                "example_id": "049a82ca-a326-4155-896b-f5d2d79a3449",
                                                "sense_id": "311fc5f8-a041-3e81-9192-e6f4e25ecd4b",
                                                "text": "He spies a group of Irish officers astraddle the road, conferring on horseback."
                                            }
