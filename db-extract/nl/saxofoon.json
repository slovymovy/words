                                                "example_id": "f985e236-1aae-47dc-b952-8f45b7a62237",
                                                "sense_id": "fdef53da-8b86-35c8-b10c-308e506286d5",
                                                "text": "Beim Jazz findet das Saxophon sehr häufig Verwendung."
                                            },
                                            {
                                                "example_id": "1064c09d-95c4-40f1-a8fe-bb70dbc5da19",
                                                "sense_id": "fdef53da-8b86-35c8-b10c-308e506286d5",
                                                "text": "„Der Ton entsteht beim Saxophon durch ein einzelnes schwingendes Rohrblatt. Deswegen zählt das Saxophon zu den Holzblasinstrumenten und nicht, wie sich durch das Material des Korpus vermuten ließe, zu den Blechblasinstrumenten.“"
                                            }
                                        ],
