                        "form": "den Knüppeldamm"
                    },
                    {
                        "form_id": "e068524b-1f47-4778-b626-0da469f3b5ab",
                        "entry_id": "16982294-129a-32e5-9f0d-3ffbcc6be4db",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Knüppeldämme"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "73d8632d-90ab-31ed-b0c9-96a344548c7a",
                        "entry_id": "16982294-129a-32e5-9f0d-3ffbcc6be4db",
                        "glosses": [
                            "durch Rundholz oder Bohlen befestigter Weg, der durch ein Moor, ein sumpfiges oder sonstwie schwer befahr- oder begehbares Gebiet mit wenig tragfähigem Grund führt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a31caf55-2880-4109-95e6-ed02c22cb1e9",
                                "sense_id": "73d8632d-90ab-31ed-b0c9-96a344548c7a",
                                "text": "„Wer Lust hat, kann von hier aus einen Besuch auf der polnischen Seite machen oder aber von diesem südlichsten Punkt des Rundweges aus über den alten Knüppeldamm, die Bundesstraße 166, den rund 2,5 km langen Rückweg nach Schwedt antreten.“"
                            },
                            {
                                "example_id": "40281fb1-59de-4531-9e34-a9624c8453d5",
                                "sense_id": "73d8632d-90ab-31ed-b0c9-96a344548c7a",
                                "text": "„Vier Knüppeldämme führten vom Dorf in verschiedene Richtungen und stellten so die Verbindung mit dem Umland her. lhr Ausbau zu befestigten Straßen erfolgte erst im Zuge der Trockenlegung.“"
                            },
                            {
                                "example_id": "81a3c6a5-155c-4bad-a9ac-a2fccfa9600e",
                                "sense_id": "73d8632d-90ab-31ed-b0c9-96a344548c7a",
                                "text": "„Die Arbeitsbataillone hatten einen Knüppeldamm fertiggestellt.“"
                            },
                            {
                                "example_id": "324e9d85-227a-4804-a127-40d4fccd9bde",
                                "sense_id": "73d8632d-90ab-31ed-b0c9-96a344548c7a",
                                "text": "„Die älteste Form der Brücke in germanischer Zeit war ein Knüppeldamm in sumpfigem Gelände.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e05f7f5a-062a-4ec4-aa3d-3eac799b9d86",
                        "source_entry_id": "16982294-129a-32e5-9f0d-3ffbcc6be4db",
