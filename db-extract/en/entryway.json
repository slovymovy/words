                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8a477431-a003-37f2-b66a-ffaef229bab6",
                                        "entry_id": "e525cbf6-7a0d-3bee-ab90-54a9a8ee19bb",
                                        "glosses": [
                                            "Öffnung zum Betreten eines begrenzten Bereiches, zum Beispiel eines Gebäudes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d9685b1-67d9-4a36-9c07-941e360ce2de",
                                                "sense_id": "8a477431-a003-37f2-b66a-ffaef229bab6",
                                                "text": "Der Eingang befindet sich rechts."
                                            },
                                            {
                                                "example_id": "ab40f0ee-eb4b-4f3d-a48e-594bd291d068",
                                                "sense_id": "8a477431-a003-37f2-b66a-ffaef229bab6",
                                                "text": "„Ich stand am Eingang und sah sie an.“"
                                            },
                                            {
                                                "example_id": "6bf3d4dc-9759-4919-8874-4c618b73c520",
                                                "sense_id": "8a477431-a003-37f2-b66a-ffaef229bab6",
                                                "text": "„Die Eingänge zum Goldbacher Stollen wurden 1947 auf Anordnung der französischen Besatzungsbehörden gesprengt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "33269e1f-5740-3688-9fd4-bb5c470de6db",
                                        "entry_id": "e525cbf6-7a0d-3bee-ab90-54a9a8ee19bb",
                                        "glosses": [
                                            "Öffnung eines Organs, durch die etwas hineingelangt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29578b02-4569-4d5d-87fd-bba37fc573f7",
                                                "sense_id": "33269e1f-5740-3688-9fd4-bb5c470de6db",
                                                "text": "Man spricht von Erschlaffungsstörung, wenn der Eingang des Magens sich nicht öffnet."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b1d8bca7-5f09-32d1-aa8e-a49e4bc294f5",
                                        "entry_id": "e525cbf6-7a0d-3bee-ab90-54a9a8ee19bb",
                                        "glosses": [
                                            "Beginn eines Vorgangs oder einer Rede"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0fc0ecf6-5623-4985-8cec-e431352a2731",
                                                "sense_id": "b1d8bca7-5f09-32d1-aa8e-a49e4bc294f5",
                                                "text": "Im Eingang konnte ich seinen Worten noch folgen, aber dann wurde es wirklich abstrus."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "18fc50e0-87fd-3a2b-9b20-7229b0112314",
                                        "entry_id": "e525cbf6-7a0d-3bee-ab90-54a9a8ee19bb",
                                        "glosses": [
                                            "das Eintreffen einer Sendung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08b189a2-a40b-4afc-9d17-96a323d6d969",
                                                "sense_id": "18fc50e0-87fd-3a2b-9b20-7229b0112314",
                                                "text": "Wir bestätigen den Eingang Ihres Schreibens vom Zweiten des Monats."
                                            }
                                        ],
                                        "sense_index_json": "\"4a\""
                                    },
                                    {
                                        "sense_id": "3755c43e-86c1-3b11-8499-6cd484a118eb",
                                        "entry_id": "e525cbf6-7a0d-3bee-ab90-54a9a8ee19bb",
                                        "glosses": [
                                            "die eingetroffene Sendung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f5f73ec-bdf1-4c8d-87c4-d11b1674de52",
                                                "sense_id": "3755c43e-86c1-3b11-8499-6cd484a118eb",
                                                "text": "Den Eingang kannst du vergessen, die haben nur Schrott geliefert."
                                            }
                                        ],
                                        "sense_index_json": "\"4b\""
                                    },
                                    {
                                        "sense_id": "2bb09782-3d54-3dcb-9954-e2237b7f7e87",
                                        "entry_id": "e525cbf6-7a0d-3bee-ab90-54a9a8ee19bb",
                                        "glosses": [
                                            "Aufnahme"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b3fc357-7ab6-4090-aa2a-217be3dd289b",
                                                "sense_id": "2bb09782-3d54-3dcb-9954-e2237b7f7e87",
                                                "text": "Dieses Ereignis wird Eingang in die Annalen der Sportgeschichte finden."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "de183da5-ac67-3192-86cb-8d95fbe2bb3a",
                                        "entry_id": "e525cbf6-7a0d-3bee-ab90-54a9a8ee19bb",
                                        "glosses": [
                                            "Buchse an einem Gerät, an die ein Kabel angeschlossen werden kann, über das Daten geschickt werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0fcbe3c-a69e-4540-baf6-1aa79794efc3",
                                                "sense_id": "de183da5-ac67-3192-86cb-8d95fbe2bb3a",
                                                "text": "An diesem Eingang ist eine kleine Antenne eingestanzt."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            }
