            {
                "entry_id": "5586f60b-c474-394d-a3b9-43eb7c52a547",
                "word": "mot",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "9f2f3f79-c634-4b12-9471-e2cabc59c644",
                        "entry_id": "5586f60b-c474-394d-a3b9-43eb7c52a547",
                        "tags": [
                            "plural"
                        ],
                        "form": "mots"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "174ca771-6e8d-3940-8714-3e3a97b85a1b",
                        "entry_id": "5586f60b-c474-394d-a3b9-43eb7c52a547",
                        "glosses": [
                            "A woman; a wife."
                        ],
                        "tags": [
                            "Ireland",
                            "UK",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "ff4c71a0-85af-40c3-af86-168ac756507e",
                                "sense_id": "174ca771-6e8d-3940-8714-3e3a97b85a1b",
                                "text": "Come wed, my dear, and let's agree, / Then of the booze-ken you'll be free; / No sneer from cully, mot, or froe / Dare then reproach my Bess for Joe; / For he's the kiddy rum and queer, / That all St. Giles's boys do fear."
                            },
                            {
                                "example_id": "554b9c10-f85c-4803-9da6-406f489d3d98",
                                "sense_id": "174ca771-6e8d-3940-8714-3e3a97b85a1b",
                                "text": "And we shall caper a-heel-and-toeing, / A Newgate hornpipe some fine day; / With the mots, their ogles throwing, / Tol lol, &c. / And old Cotton humming his pray.",
                                "translation": "En roulant de vergne en vergne",
                                "english": "En roulant de vergne en vergne"
                            }
                        ]
                    },
                    {
                        "sense_id": "8f47c8bb-642a-37df-9329-f71361117964",
                        "entry_id": "5586f60b-c474-394d-a3b9-43eb7c52a547",
                        "glosses": [
                            "A prostitute."
                        ],
                        "tags": [
                            "Ireland",
                            "UK",
                            "slang"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "13b49c38-a48e-3ff8-8d85-f793a23e85c5",
                        "entry_id": "5586f60b-c474-394d-a3b9-43eb7c52a547",
                        "glosses": [
                            "A landlady."
                        ],
                        "tags": [
                            "Ireland",
                            "UK",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "35953c5a-ee08-4104-918e-15686c2a62ee",
                                "sense_id": "13b49c38-a48e-3ff8-8d85-f793a23e85c5",
                                "text": "After some altercation with the \"mot\" of the \"ken\" (mistress of the lodging-house) about the cleanliness of a knife or fork, my new acquaintance began to arrange \"ground,\" &c., for the night's work."
                            }
                        ]
                    }
                ],
