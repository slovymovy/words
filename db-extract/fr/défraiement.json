                "senses": [
                    {
                        "sense_id": "cbcbca29-e520-3bf2-ab5c-c3ad66469959",
                        "entry_id": "37353648-2053-376a-baea-445240962c5a",
                        "glosses": [
                            "Action de défrayer quelqu’un, c’est-à-dire de le décharger des frais qu’il a engagés."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1fd6c1d-b6b2-4926-92ef-9914aa14b905",
                                "sense_id": "cbcbca29-e520-3bf2-ab5c-c3ad66469959",
                                "text": "Aucun déplacement effectué sans un ordre de mission préalable ne pourra donner lieu à défraiement"
                            },
                            {
                                "example_id": "dd14e72c-896e-45ad-bf02-5727fd164737",
                                "sense_id": "cbcbca29-e520-3bf2-ab5c-c3ad66469959",
                                "text": "Le stagiaire ne recevra pas de rémunération mais pourra prétendre à des indemnités de défraiement s’il est appelé à se déplacer dans le cadre de ses activités."
                            },
                            {
                                "example_id": "b2115574-9500-408b-9f86-bfa93992ccf0",
                                "sense_id": "cbcbca29-e520-3bf2-ab5c-c3ad66469959",
                                "text": "A titre d’exemple, lorsqu’un concert ou un spectacle est décentralisé, le défraiement «repas» représente la différence de coût entre un repas pris chez soi et le même repas pris au restaurant."
                            },
                            {
                                "example_id": "b6f30619-b096-4dbc-abab-3a2816e0415b",
                                "sense_id": "cbcbca29-e520-3bf2-ab5c-c3ad66469959",
                                "text": "Mais je ne pourrai lui donner qu'un défraiement."
                            }
                        ]
                    }
