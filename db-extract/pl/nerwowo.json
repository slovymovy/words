                                    {
                                        "sense_id": "36d2e512-c863-3707-b0dd-b1ad746a19ea",
                                        "entry_id": "bdec9c12-13d8-3db2-ae30-6a5372b1afed",
                                        "glosses": [
                                            "Avec nerf, avec vigueur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "303225db-8e8c-44b9-9312-6e1d744ae1f7",
                                                "sense_id": "36d2e512-c863-3707-b0dd-b1ad746a19ea",
                                                "text": "On ne peut donner trop d’adresse, de délicatesse et de soins pour dignement et nerveusement dresser ce canevas."
                                            },
                                            {
                                                "example_id": "326b28cf-1b46-472f-8060-6d0318245ec8",
                                                "sense_id": "36d2e512-c863-3707-b0dd-b1ad746a19ea",
                                                "text": "Il gratouilla tout aussi nerveusement le reçu de ses objets personnels, que Lenimphe agita dans l’air pour le faire sécher, après l’avoir relu attentivement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7813a60-8dd8-3b4e-9278-d47817230c8b",
                                        "entry_id": "bdec9c12-13d8-3db2-ae30-6a5372b1afed",
                                        "glosses": [
                                            "D’une façon nerveuse, avec nervosité ; sous l’influence d’une affection des nerfs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a2b13fb-4004-4440-9303-3a7a9e24f9b5",
                                                "sense_id": "d7813a60-8dd8-3b4e-9278-d47817230c8b",
                                                "text": "Elle sanglotait nerveusement. — Rire nerveusement."
                                            }
                                        ]
                                    }
