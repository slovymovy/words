                        "examples": [
                            {
                                "example_id": "5eca26d7-690b-4e37-bfab-608ac222405a",
                                "sense_id": "49653042-a509-3dc9-b574-1819b73f5231",
                                "text": "J’ai grand-peur, confie-t-il un jour à des familiers, que cette dame débauchée ne la fasse devenir sujette au vin et aux femmes, et ne la mette sur les dents avant de me la rendre."
                            }
                        ]
                    }
