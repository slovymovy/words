                "senses": [
                    {
                        "sense_id": "db56cda6-7a8f-3d97-b563-f17a2982dd16",
                        "entry_id": "36151ed3-7848-32b8-94bb-0288618ef169",
                        "glosses": [
                            "An alphabetic character; a letter of the alphabet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21a74262-9c88-40ef-b18b-231919b1abf5",
                                "sense_id": "db56cda6-7a8f-3d97-b563-f17a2982dd16",
                                "text": "Upper case alphabetics can be composed of two characters: (1) a shift character; and (2) the desired alphabetic character."
                            },
                            {
                                "example_id": "da8d0aac-de56-4373-bbc4-a7175a59707b",
                                "sense_id": "db56cda6-7a8f-3d97-b563-f17a2982dd16",
                                "text": "The natural sequence of alphabetics is A, B, C, ..., X, Y, Z. For some codes, the binary bit patterns of the alphabetics are in the same relative sequence as the alphabetics."
                            },
                            {
                                "example_id": "772ecea7-02a4-4c1f-a2f5-1a45da3bf9c4",
                                "sense_id": "db56cda6-7a8f-3d97-b563-f17a2982dd16",
                                "text": "Subparagraphs are identified by lower case alphabetics followed by numerics and alphabetics in parentheses and then underlined numerics and alphabetics."
                            }
                        ]
                    }
                ],
