                    {
                        "form_id": "baa947b4-3072-4a26-9f68-87b39cf96ece",
                        "entry_id": "d8d1c85d-c92b-3f0f-bf44-7ec11ea6f25c",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Hohepriester"
                    },
                    {
                        "form_id": "61622b82-1b20-409a-8b29-c5d7219dcb1a",
                        "entry_id": "d8d1c85d-c92b-3f0f-bf44-7ec11ea6f25c",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Hohepriester"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f88998f1-a57b-3f86-9da8-8028b0fb9158",
                        "entry_id": "d8d1c85d-c92b-3f0f-bf44-7ec11ea6f25c",
                        "glosses": [
                            "der Höchste unter den Priestern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5054a179-4d9a-46a1-9b3c-3e77a87ce788",
                                "sense_id": "f88998f1-a57b-3f86-9da8-8028b0fb9158",
                                "text": "„Bracelin hat Gardners' Part als Hohepriester im Bricket Wood Coven übernommen, wenn Gardner selbst abwesend war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4a301e02-fe7f-3723-9be1-658f0738c708",
                        "entry_id": "d8d1c85d-c92b-3f0f-bf44-7ec11ea6f25c",
                        "glosses": [
                            "zur Zeit des Jerusalemer Tempels als religiöser Titel: Kohen Gadol (כֹּהֵן גָּדוֹל (CHA: kōhēn gādōl)^(→ he) ‚Großer Priester‘)"
                        ],
                        "tags": [
                            "Judentum"
                        ],
                        "examples": [
                            {
                                "example_id": "18bb00b6-bc5a-465d-bf1b-848032bc45c3",
                                "sense_id": "4a301e02-fe7f-3723-9be1-658f0738c708",
                                "text": "„Auf ihn legte der Hohepriester die Schaufel mit glühenden Kohlen, hier räucherte er, hier stand der Brandopferaltar, hier floß das Blut der Opfertiere.“"
                            },
                            {
                                "example_id": "2906189c-5d2a-497f-828a-c524bec6ada2",
                                "sense_id": "4a301e02-fe7f-3723-9be1-658f0738c708",
                                "text": "„Denn jeder Hohepriester, der von den Menschen genommen wird, der wird eingesetzt für die Menschen zum Dienst vor Gott, damit er Gaben und Opfer darbringe für die Sünden.“ (Hebr. 5,1)"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "86b0ebd9-6ebd-3897-a252-407c8a353c5a",
                        "entry_id": "d8d1c85d-c92b-3f0f-bf44-7ec11ea6f25c",
                        "glosses": [
                            "übertragen auf Jesus Christus als derjenige, der als höchstes Opfer sich selbst vor Gott darbringt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca9e1545-6cfc-493a-b9bb-449c3e4bf757",
                                "sense_id": "86b0ebd9-6ebd-3897-a252-407c8a353c5a",
                                "text": "„Denn jeder Hohepriester, der von den Menschen genommen wird, der wird eingesetzt für die Menschen zum Dienst vor Gott, damit er Gaben und Opfer darbringe für die Sünden.“ (Hebr. 5,1)"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "a56f63c0-0972-36fe-ae6d-d45fca4531c1",
                        "entry_id": "d8d1c85d-c92b-3f0f-bf44-7ec11ea6f25c",
                        "glosses": [
                            "jemand, der sich für etwas besonders erfolgreich einsetzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81780961-6d23-4858-88ef-184fe15f7df1",
                                "sense_id": "a56f63c0-0972-36fe-ae6d-d45fca4531c1",
                                "text": "„Alain Brumont ist der Hohepriester der Tannat-Traube. Er vinifiziert die Premiumweine seiner beiden Güter, den Montus Prestige und den Bouscassé Vieilles Vignes, fünf Wochen lang, bevor er sie in neue Fässer verbannt.“"
                            }
                        ],
                        "sense_index_json": "\"4\""
                    }
                ],
