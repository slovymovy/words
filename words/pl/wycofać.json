{
    "word_family": [
        "wycofanie",
        "wycofywacz",
        "wycofany"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1034d708-8092-3f5e-adc8-945f76bafe46",
                    "sense_definition": "zabrać coś z powrotem, przestać oferować lub wycofać z obiegu",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "wycofywanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Firma musiała <w>wycofać</w> wadliwy produkt ze sprzedaży.",
                            "target_lang_translations": {
                                "ru": "Фирма была вынуждена <w>изъять</w> бракованный товар из продажи."
                            }
                        },
                        {
                            "text": "Bank zdecydował się <w>wycofać</w> z obiegu stare banknoty.",
                            "target_lang_translations": {
                                "ru": "Банк решил <w>изъять</w> из обращения старые банкноты."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wycofać produkt",
                        "wycofać wniosek"
                    ],
                    "target_lang_definitions": {
                        "ru": "забрать что-либо обратно, прекратить предложение или изъять из обращения"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отозвать",
                                "target_lang_sense_clarification": "о товаре, предложении или заявлении"
                            },
                            {
                                "target_lang_word": "изъять",
                                "target_lang_sense_clarification": "о товаре или деньгах из обращения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1554de59-4c7e-3761-92f4-2e7f009ea942",
                    "sense_definition": "zmienić decyzję i przestać w czymś uczestniczyć",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "wycofywanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Polityk postanowił <w>wycofać</w> swoje poparcie dla tego projektu.",
                            "target_lang_translations": {
                                "ru": "Политик решил <w>отозвать</w> свою поддержку этого проекта."
                            }
                        },
                        {
                            "text": "Musimy <w>wycofać</w> nasze wojska z tego regionu.",
                            "target_lang_translations": {
                                "ru": "Мы должны <w>вывести</w> наши войска из этого региона."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wycofać poparcie",
                        "wycofać wojska"
                    ],
                    "target_lang_definitions": {
                        "ru": "изменить решение и прекратить участие в чем-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отозвать",
                                "target_lang_sense_clarification": "о поддержке или решении"
                            },
                            {
                                "target_lang_word": "вывести",
                                "target_lang_sense_clarification": "о войсках или контингенте"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f7970ef7-a697-3caf-9f74-89ade38f543c",
                    "sense_definition": "zrezygnować z udziału w zawodach lub rywalizacji",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "wycofywanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zawodnik musiał <w>wycofać</w> się z powodu kontuzji.",
                            "target_lang_translations": {
                                "ru": "Спортсмен был вынужден <w>сняться</w> из-за травмы."
                            }
                        },
                        {
                            "text": "Drużyna zdecydowała się <w>wycofać</w> z dalszej rywalizacji.",
                            "target_lang_translations": {
                                "ru": "Команда решила <w>выйти</w> из дальнейшей борьбы."
                            }
                        }
                    ],
                    "synonyms": [
                        "wyautować się"
                    ],
                    "common_phrases": [
                        "wycofać się z zawodów"
                    ],
                    "target_lang_definitions": {
                        "ru": "отказаться от участия в соревнованиях или конкуренции"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сняться",
                                "target_lang_sense_clarification": "с соревнований или турнира"
                            },
                            {
                                "target_lang_word": "выйти",
                                "target_lang_sense_clarification": "из борьбы или состязания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "500fb649-6c2d-39f8-a180-33756710f66f",
                    "sense_definition": "aspekt dokonany od czasownika <w>wycofywać</w>",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "wycofywanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zanim <w>wycofasz</w> pieniądze, sprawdź stan konta.",
                            "target_lang_translations": {
                                "ru": "Прежде чем <w>снять</w> деньги, проверьте состояние счета."
                            }
                        },
                        {
                            "text": "Warto <w>wycofać</w> błędne oświadczenie przed terminem.",
                            "target_lang_translations": {
                                "ru": "Стоит <w>отозвать</w> ошибочное заявление до истечения срока."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "совершенный вид глагола, означающий действие изъятия или отзыва"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "снять",
                                "target_lang_sense_clarification": "о деньгах со счета"
                            },
                            {
                                "target_lang_word": "отозвать",
                                "target_lang_sense_clarification": "о заявлении или документе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cb2efe65-3b9d-39c1-8778-25e5b52ad198",
                    "sense_definition": "aspekt dokonany od czasownika <w>wycofywać</w> się",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "wycofywanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Niestety muszę <w>wycofać</w> się z turnieju w Madrycie.",
                            "target_lang_translations": {
                                "ru": "К сожалению, я должен <w>сняться</w> с турнира в Мадриде."
                            }
                        },
                        {
                            "text": "Lepiej <w>wycofać</w> się w porę niż ryzykować porażkę.",
                            "target_lang_translations": {
                                "ru": "Лучше <w>отступить</w> вовремя, чем рисковать поражением."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "совершенный вид возвратного глагола, означающий отступление или отказ от участия"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отступить",
                                "target_lang_sense_clarification": "в переносном смысле или физически"
                            },
                            {
                                "target_lang_word": "отказаться",
                                "target_lang_sense_clarification": "от участия в чем-либо"
                            }
                        ]
                    }
                }
            ]
        }
