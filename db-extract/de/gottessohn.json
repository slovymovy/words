                ],
                "senses": [
                    {
                        "sense_id": "7fb299a8-dccb-321a-9140-ed83f1ec1cb5",
                        "entry_id": "bc44d274-9a14-3400-8606-07eb675145bd",
                        "glosses": [
                            "Jesus Christus; der einzige Nachfahre Gottes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "811c7105-bd72-4913-978d-dcd40f6cde25",
                                "sense_id": "7fb299a8-dccb-321a-9140-ed83f1ec1cb5",
                                "text": "„Es ging bei den Kontroversen um Grundsatzfragen, um den Kern des Christentums: nämlich um das Wesen Gottes, das Verhältnis des Gottessohnes zum Gottvater und die Möglichkeit der Erlösung.“"
                            },
                            {
                                "example_id": "a5249c4b-abe2-4ed3-86ea-71929d6a44d3",
                                "sense_id": "7fb299a8-dccb-321a-9140-ed83f1ec1cb5",
                                "text": "„Denn er sah keinen Widerspruch zwischen diesen beiden Religionen, die sich so ähnlich seien in ihrem klaren Monotheismus, ohne Erweiterung um einen Gottessohn, auch ohne die Macht der Kirche.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
