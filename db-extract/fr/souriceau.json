                                        "sense_id": "91744980-6bb2-36b3-8df0-2436cb83f10f",
                                        "entry_id": "06465f65-94c5-36ce-9b2f-6389c584016a",
                                        "glosses": [
                                            "To navigate by means of a computer mouse."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76943497-310e-4f73-9c6b-ea3319cf8f2d",
                                                "sense_id": "91744980-6bb2-36b3-8df0-2436cb83f10f",
                                                "text": "I had just moused to the File menu and the pull-down menu repeated the menu bar's hue a dozen shades lighter."
                                            },
                                            {
                                                "example_id": "8cce2752-3aa4-493e-a6f0-fc1781b5b2e2",
                                                "sense_id": "91744980-6bb2-36b3-8df0-2436cb83f10f",
                                                "text": "Unlike the Flamenco work, the Relation Browser allows users to quickly explore a document space using dynamic queries issued by mousing over facet elements in the interface."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "faff9df1-7279-328b-b04a-737de4c89e8b",
                                        "entry_id": "06465f65-94c5-36ce-9b2f-6389c584016a",
                                        "glosses": [
