                ],
                "senses": [
                    {
                        "sense_id": "c642c29e-8eff-3a0c-b6a7-bc3b6a0e66fb",
                        "entry_id": "fc29f923-b867-310e-8cac-c5b2494d3de8",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16642eff-11e3-4888-88bf-f7936c510eb4",
                                "sense_id": "c642c29e-8eff-3a0c-b6a7-bc3b6a0e66fb",
                                "text": "Frau Seyfer ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "7b599c7a-a6b2-409e-8364-526c60ff1c07",
                                "sense_id": "c642c29e-8eff-3a0c-b6a7-bc3b6a0e66fb",
                                "text": "Herr Seyfer wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "0dc2f85b-aa4e-4f89-ae71-8db386a014c7",
                                "sense_id": "c642c29e-8eff-3a0c-b6a7-bc3b6a0e66fb",
                                "text": "Die Seyfers fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "12ffb163-3acd-4f59-b960-58a290335dff",
                                "sense_id": "c642c29e-8eff-3a0c-b6a7-bc3b6a0e66fb",
                                "text": "Der Seyfer trägt nie die Schals, die die Seyfer ihm strickt."
                            },
                            {
                                "example_id": "7dae5300-0641-49bc-9386-b6c91da3357a",
                                "sense_id": "c642c29e-8eff-3a0c-b6a7-bc3b6a0e66fb",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Seyfer kommt, geht der Herr Seyfer.“"
                            },
                            {
                                "example_id": "3e6e10ef-2fab-44d3-b57b-5ad561d4624b",
                                "sense_id": "c642c29e-8eff-3a0c-b6a7-bc3b6a0e66fb",
                                "text": "Seyfer kommt und geht."
                            },
                            {
                                "example_id": "933e9f44-8348-4ed1-8600-bf60b17c1ee8",
                                "sense_id": "c642c29e-8eff-3a0c-b6a7-bc3b6a0e66fb",
                                "text": "Seyfers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
