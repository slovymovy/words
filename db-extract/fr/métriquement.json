        "fr-extract.jsonl": [
            {
                "entry_id": "a7cd246d-f546-3edb-b7ca-155dc1d3b12f",
                "word": "métriquement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0754184e-94e3-32a7-8dee-0e3d915d3bfd",
                        "entry_id": "a7cd246d-f546-3edb-b7ca-155dc1d3b12f",
                        "glosses": [
                            "De façon métrique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14636dcc-4fc0-4caa-bc0c-4eb20a090a64",
                                "sense_id": "0754184e-94e3-32a7-8dee-0e3d915d3bfd",
                                "text": "Enfin il y a certaines lettres, de sujet ou de ton plutôt intimes, que je crois métriques par hasard, ayant été composées à une époque où Cicéron, sans effort, écrivait métriquement."
                            },
                            {
                                "example_id": "9f3c2499-dbee-47d9-aaf2-469b11648f69",
                                "sense_id": "0754184e-94e3-32a7-8dee-0e3d915d3bfd",
                                "text": "Alors, tout déficit sera supporté métriquement par tous les propriétaires habitant ou non la localité."
                            },
                            {
                                "example_id": "4c3df30a-c2b0-45b7-9070-c99ad2a1b282",
                                "sense_id": "0754184e-94e3-32a7-8dee-0e3d915d3bfd",
                                "text": "À cet égard, l’ambigu et inquiétant Clair de lune et le noir et pessimiste Colloque sentimental se répondent aussi bien métriquement que sémantiquement de l’ouverture du recueil à son finale, après les fêtes."
                            }
                        ]
                    }
                ],
