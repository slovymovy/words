                "senses": [
                    {
                        "sense_id": "9394c541-f7af-31cb-9a49-2f2bc7862670",
                        "entry_id": "58c794e3-f22b-3e0f-b290-b1da83a0d61f",
                        "glosses": [
                            "Cesser d’être mouillé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "357ae04b-0257-420e-a4dd-13343e955fc4",
                                "sense_id": "9394c541-f7af-31cb-9a49-2f2bc7862670",
                                "text": "J’préfère encore rester sur l’pont sans démouiller pendant quarante-huit heures que d’faire du jardinage."
                            },
                            {
                                "example_id": "4d3e3456-ebd4-4e14-a2f7-c0f204400404",
                                "sense_id": "9394c541-f7af-31cb-9a49-2f2bc7862670",
                                "text": "Lorsque l’on roule sur une route mouillée, le freinage n’est efficace que si le film d’eau, qui joue le rôle de lubrifiant, a le temps de démouiller en moins d’une milliseconde."
                            }
                        ]
                    }
