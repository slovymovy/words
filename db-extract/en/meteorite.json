                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "meteorit",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "69b53747-98e7-3d19-aac0-ff6c4a967204",
                                        "entry_id": "eb119292-b0f6-3d68-8ddc-2729f6d29611",
                                        "glosses": [
                                            "kovové či kamenné kosmické těleso, které proniklo až na zem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1bd49b3b-6008-48f2-987f-bf50b012e686",
                                                "sense_id": "69b53747-98e7-3d19-aac0-ff6c4a967204",
                                                "text": "Těleso, jež jsme minuli, nebylo nic než meteorit, ovšem rozměrů ohromných, jejž přitažlivost zemská zachytila a v družici proměnila."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bd955bca-cc93-4e57-aae4-c618e1ab0e55",
                        "source_entry_id": "bc774bb5-2d61-3507-a994-744d69b4c2a3",
                        "source_sense_id": "4d0c44d0-85e3-351a-9bcd-f45949943cf4",
                        "source_sense_description": "remains of a meteor",
                        "target_lang_word": "meteoriet",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
