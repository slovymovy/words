                        "examples": [
                            {
                                "example_id": "bf9f943d-20b9-403f-a8a8-66fca5904d89",
                                "sense_id": "8d6f298f-6710-3563-b009-577cff57d81d",
                                "text": "On y mangeait du riz et des boulettes de viande en brochette. Elle appelait cela du chiche-kébab."
                            },
                            {
                                "example_id": "3409eb1f-89da-41aa-9249-99cce5c8af8e",
                                "sense_id": "8d6f298f-6710-3563-b009-577cff57d81d",
                                "text": "Arrivons avant midi sinon la température sera telle que nous serons transformés en chiche-kébab avant d’avoir atteint la flotte."
                            },
                            {
                                "example_id": "6e4240a7-d206-4cc1-97d9-3359ef3b0968",
                                "sense_id": "8d6f298f-6710-3563-b009-577cff57d81d",
                                "text": "Ses petites rues grouillent de marmaille nord-africaine et près des boutiques d’artisans travaillant très tard le soir, poissons et chiche-kébab rôtis en pleine rue embaument le quartier."
                            }
                        ]
                    }
