                    {
                        "translation_id": "1b335c0e-58ca-4261-969c-b42a712ec642",
                        "source_entry_id": "364db2a3-1e58-335a-ab12-b590d7942089",
                        "source_sense_id": "7311ece1-3e89-3820-86b5-587dfb263ebb",
