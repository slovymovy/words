                    "frequency": "Low",
                    "semantic_group_id": "titre_et_designation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Méfie-toi de ce triste <w>sieur</w>, car il a déjà trompé plusieurs personnes dans le village."
