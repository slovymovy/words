                                                "example_id": "46de08b8-101b-4017-abc9-088d1928d229",
                                                "sense_id": "71ee880f-5e99-32b8-aca9-35af1220c944",
                                                "text": "Se acentúan qué, cuál, quién, cómo, dónde, cuándo, cuánto, si tienen valor interrogativo"
                                            }
