                                        "sense_id": "633b4f6e-d172-37b3-9bff-7ce3184c9a03",
                                        "entry_id": "d862682f-3883-3726-b6ee-a1a8e373084f",
                                        "glosses": [
                                            "osoba należąca do gangu"
                                        ],
                                        "tags": [],
                                        "examples": [
