            "pos": "noun",
            "senses": [
                {
                    "sense_id": "daf4eff4-0d4b-36af-b290-4b98c06fc56b",
                    "sense_definition": "Een lastige situatie, moeilijkheid of complicatie (meestal gebruikt in het meervoud).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "moeilijkheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De politieke <w>perikelen</w> rondom de nieuwe wet zorgden voor veel vertraging in het parlement.",
                            "target_lang_translations": {
                                "de": "Die politischen <w>Wirren</w> um das neue Gesetz führten zu großen Verzögerungen im Parlament."
                            }
                        },
                        {
                            "text": "Na alle financiële <w>perikelen</w> kon het bedrijf eindelijk weer winst maken.",
                            "target_lang_translations": {
                                "de": "Nach all den finanziellen <w>Schwierigkeiten</w> konnte das Unternehmen endlich wieder Gewinn machen."
                            }
                        }
                    ],
                    "common_phrases": [
                        "financiële perikelen",
                        "politieke perikelen"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine schwierige Situation, Komplikation oder Querelen (meist im Plural verwendet)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "die Wirren",
                                "target_lang_sense_clarification": "Plural; turbulente Verwicklungen oder Unruhen"
                            },
                            {
                                "target_lang_word": "die Querelen",
                                "target_lang_sense_clarification": "Plural; Streitigkeiten, lästige Probleme"
                            },
                            {
                                "target_lang_word": "die Wechselfälle",
                                "target_lang_sense_clarification": "Plural; schwierige Umstände, Wechselfälle des Lebens"
                            },
                            {
                                "target_lang_word": "die Schwierigkeiten",
                                "target_lang_sense_clarification": "Plural; allgemeine Probleme oder Komplikationen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8d5fce78-b23e-38cf-8864-fdc5081862e7",
                    "sense_definition": "Een dreigend gevaar of risico.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "gevaar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De ontdekkingsreiziger trotseerde met succes alle <w>perikelen</w> van de gevaarlijke tocht door de woestijn.",
                            "target_lang_translations": {
                                "de": "Der Entdecker trotzte erfolgreich allen <w>Fährnissen</w> der gefährlichen Reise durch die Wüste."
                            }
                        },
                        {
                            "text": "Men was zich terdege bewust van het ernstige <w>perikel</w> waarin de expeditie verkeerde.",
                            "target_lang_translations": {
                                "de": "Man war sich der ernsten <w>Gefahr</w>, in der sich die Expedition befand, durchaus bewusst."
                            }
                        }
                    ],
                    "synonyms": [
                        "gevaar",
                        "risico"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine drohende Gefahr oder ein Risiko."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "die Gefahr",
                                "target_lang_sense_clarification": "Bedrohung, Risiko"
                            },
                            {
                                "target_lang_word": "die Fährnis",
                                "target_lang_sense_clarification": "gehoben; Gefahren oder Risiken"
                            },
                            {
                                "target_lang_word": "das Risiko",
                                "target_lang_sense_clarification": "Möglichkeit eines negativen Ausgangs"
                            }
                        ]
                    }
                }
            ]
        }
    ]
