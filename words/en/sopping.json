{
    "word_family": [
        "sop",
        "soppy"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5d830fc7-e858-3d37-923a-625aaf887347",
                    "sense_definition": "Soaked, drenched, or completely wet to the point of dripping.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "wetness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her sneakers were <w>sopping</w> by the time she finished walking through the rain.",
                            "target_lang_translations": {
                                "cs": "Její tenisky byly <w>promáčené</w>, když došla domů v dešti."
                            }
                        },
                        {
                            "text": "The heavy rain left the grass <w>sopping</w> and muddy.",
                            "target_lang_translations": {
                                "cs": "Kvůli silnému dešti byla tráva <w>promáčená</w> a zablácená."
                            }
                        }
                    ],
                    "synonyms": [
                        "drenched",
                        "soaked",
                        "sodden"
                    ],
                    "antonyms": [
                        "dry",
                        "parched"
                    ],
                    "common_phrases": [
                        "sopping wet"
                    ],
                    "target_lang_definitions": {
                        "cs": "Zcela promáčený, nasáklý vodou až do té míry, že z něj kape."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "promáčený",
                                "target_lang_sense_clarification": "zcela nasáklý tekutinou"
                            },
                            {
                                "target_lang_word": "prolitý",
                                "target_lang_sense_clarification": "skrz naskrz mokrý"
                            },
                            {
                                "target_lang_word": "nasáklý",
                                "target_lang_sense_clarification": "plný tekutiny"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "15833f38-6879-3833-b5d9-dc1d3e8dc424",
                    "sense_definition": "The present participle and gerund of <w>sop</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "wetness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was <w>sopping</w> up the spilled milk with a thick paper towel.",
                            "target_lang_translations": {
                                "cs": "Rozlité mléko <w>vytíral</w> silnou papírovou utěrkou."
                            }
                        },
                        {
                            "text": "She spent the morning <w>sopping</w> water from the flooded basement floor.",
                            "target_lang_translations": {
                                "cs": "Celé dopoledne strávila <w>odsáváním</w> vody z podlahy zatopeného sklepa."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Činnost spočívající v odsávání nebo vytírání tekutiny pomocí savého materiálu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "vytírání",
                                "target_lang_sense_clarification": "odstraňování rozlité tekutiny"
                            },
                            {
                                "target_lang_word": "odsávání",
                                "target_lang_sense_clarification": "nasávání tekutiny do savého materiálu"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0b9561b5-3fc9-3ff4-b868-65b648c70c6a",
                    "sense_definition": "The act or state of being soaked.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "wetness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the storm, the ground suffered a complete <w>sopping</w>.",
                            "target_lang_translations": {
                                "cs": "Po bouřce byla půda úplně <w>promáčená</w>."
                            }
                        },
                        {
                            "text": "The fabric required a thorough <w>sopping</w> in the cleaning solution.",
                            "target_lang_translations": {
                                "cs": "Látka vyžadovala důkladné <w>namočení</w> v čisticím roztoku."
                            }
                        }
                    ],
                    "synonyms": [
                        "soaking",
                        "drenching"
                    ],
                    "target_lang_definitions": {
                        "cs": "Stav nebo proces úplného namočení či nasáknutí."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "promáčení",
                                "target_lang_sense_clarification": "stav úplného nasáknutí"
                            },
                            {
                                "target_lang_word": "namáčení",
                                "target_lang_sense_clarification": "proces ponoření do tekutiny"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}