                ],
                "senses": [
                    {
                        "sense_id": "02310ca0-f536-3b9a-a7b2-ffb7ae2fff79",
                        "entry_id": "0c8bf3cc-24e2-31d4-98f4-fa2fb8a1b2cd",
                        "glosses": [
                            "utopische Zukunftsvorstellung einer Idealgesellschaft (im positiven Sinne)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc6354ff-bb39-4624-b5f8-7b4001b5233d",
                                "sense_id": "02310ca0-f536-3b9a-a7b2-ffb7ae2fff79",
                                "text": "„Dabei steht einerseits die Raumutopie in ihren beiden idealtypischen Formen der Sozial- und Arkadienutopie im Mittelpunkt und andererseits der einsetzende Differenzierungsprozeß der Utopie etwa in den Formen der Robinsonade, des Reiseromans oder der Ökonomieutopien.“"
                            },
                            {
                                "example_id": "5fdd843e-3d68-47e1-a913-bea53327179f",
                                "sense_id": "02310ca0-f536-3b9a-a7b2-ffb7ae2fff79",
                                "text": "„Ganz anders dagegen die Arkadienutopie . Sie trennt nicht zwischen der Befreiung des Menschen im engeren ökonomischen und politischen Sinne und der Befreiung seiner Sexualität.“"
                            },
                            {
                                "example_id": "8b60f914-cf38-47f3-a8f1-2ac09b8b621e",
                                "sense_id": "02310ca0-f536-3b9a-a7b2-ffb7ae2fff79",
                                "text": "„Zwei Grundtypen der Raumutopie werden expliziert: die klassische Sozialutopie, eben Morus Utopia, Campanellas La citta del sole und Bacons Atlantis, daneben die Arkadienutopie.“"
                            },
                            {
                                "example_id": "0e12fce7-a60e-4361-b63c-176d41eae0a2",
                                "sense_id": "02310ca0-f536-3b9a-a7b2-ffb7ae2fff79",
                                "text": "„So spricht der Herausgeber von zwei ‚Korrelaten‘, der ‚Arkadienutopie‘ und der ‚Sozialutopie‘, und Helmut J. Schneider bezweifelt die Zusammengehörigkeit der beiden, da für die arkadische Version der Verdacht des Eskapismus gegeben sei.“"
                            },
                            {
                                "example_id": "e8855d08-f8d1-4487-b617-77839180ca7f",
                                "sense_id": "02310ca0-f536-3b9a-a7b2-ffb7ae2fff79",
                                "text": "„So der Arzt Philibert Commerson, der 1769 im ‚Mercure de France‘ den Zauber Tahitis mit den Begriffen der Arkadienutopie schildert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
