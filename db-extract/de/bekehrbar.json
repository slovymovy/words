                    },
                    {
                        "form_id": "727d9690-f09c-4e73-a04d-ac89c32906c2",
                        "entry_id": "5f234c33-a16c-3216-8e46-fcfe9a5edfe3",
                        "tags": [
                            "positive",
                            "predicative",
                            "plural"
                        ],
                        "form": "sie sind bekehrbar"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "64d209a2-9efc-394f-bc95-f540c776ca28",
                        "entry_id": "5f234c33-a16c-3216-8e46-fcfe9a5edfe3",
                        "glosses": [
                            "so, dass es bekehrt werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fbcee131-f8a9-4b4a-ae27-f946257f73a1",
                                "sense_id": "64d209a2-9efc-394f-bc95-f540c776ca28",
                                "text": "„Wenn darauf Giorgio widersprach und die tiefsinnigen Ketzer mit den leichtfertigen gleichermaßen verdammte, ja sogar wünschte, daß Benjamin einer von diesen letzten sein möchte, da sie leichter bekehrbar seien als die ersten, ereiferte sich der Prior nur um so mehr und rief Gott um seine heilsamen Schickungen an, in denen Benjamin sich am ehesten zu einem ganzen Protestanten oder – wenn die Gnade Gottes nicht fehlte – zu einer reuigen Heimkehr aufraffen würde.“"
                            },
                            {
                                "example_id": "d722c198-732b-4b78-b991-c62ed584c968",
                                "sense_id": "64d209a2-9efc-394f-bc95-f540c776ca28",
                                "text": "„Zu jedem Risiko bereit, geschult in der virtuosen Kunst der Täuschung und getragen vom unerschütterlichen Glauben, dass selbst die geizigsten Ökonomen bekehrbar sind, verfolgen sie ihr Ziel.“"
                            },
                            {
                                "example_id": "b1cf54c2-1e7d-4db3-aecc-a607c759746c",
                                "sense_id": "64d209a2-9efc-394f-bc95-f540c776ca28",
                                "text": "„Es scheint aber doch ein allgemein zu beobachtendes Phänomen zu sein, dass Menschen mit ausgeprägtem Sendungsbewusstsein meist schwer belehr- und bekehrbar sind, weil Kurskorrekturen ja das Sendungsbewusstsein eliminieren oder zumindest kräftig torpedieren dürften.“"
                            },
                            {
                                "example_id": "e2f4479e-20c6-4057-9183-65636a51c958",
                                "sense_id": "64d209a2-9efc-394f-bc95-f540c776ca28",
                                "text": "„Nach Schmidts Ansicht sollten wir in unseren Überzeugungen bekehrbar bleiben, wenn wir es mit der Verantwortung ernst meinen wollen.“"
                            },
                            {
                                "example_id": "071ac578-188a-4dfa-a65f-497fb4e0470e",
                                "sense_id": "64d209a2-9efc-394f-bc95-f540c776ca28",
                                "text": "„Um in die Thematik Scientology einzuführen, nannte Ursula Caberta einige Grundsätze, die für die meisten der Zuhörer erschreckend schienen. So gelte laut Gründer Ronald Hubbard die ganze Menschheit - bis auf zwei oder drei Prozent - als bekehrbar. Der kleine Prozentsatz, der resistent ist, sei psychisch krank.“"
                            },
                            {
                                "example_id": "c12ec242-672c-4b80-a212-55807464335d",
                                "sense_id": "64d209a2-9efc-394f-bc95-f540c776ca28",
                                "text": "„Nicht jeder ist bekehrbar, aber jedem kann man mit Respekt begegnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
