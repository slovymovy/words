                            {
                                "target_word": "forearm",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "95edcb24-c342-3abc-a75f-690c44153e47",
                                        "entry_id": "3f0b7cf7-8a65-3e20-922f-94eb7178b07f",
                                        "glosses": [
                                            "To arm in preparation."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "sometimes",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57b54658-19fb-4b3c-878a-9e95c2c6f953",
                                                "sense_id": "95edcb24-c342-3abc-a75f-690c44153e47",
                                                "text": "But in so far as they were able to forearm themselves against the anxieties of bereavement, the loss may have been that much easier to face."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1c26acf9-6be4-417a-8d0b-eba4f57dd6a5",
                        "source_entry_id": "9142fbf5-ca74-398e-9640-be71539ae935",
                        "source_sense_id": "53b486bc-cc17-3a4c-ae16-701d2dc2ca7b",
                        "source_sense_description": "gedeelte van de arm tussen de elleboog en de hand",
                        "target_lang_word": "avant-bras",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "avant-bras",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "11f8a29e-6d13-337e-83ef-9581595c10d2",
                                        "entry_id": "7f4a9444-9e78-3e54-9170-5d85b5e1e5e6",
                                        "glosses": [
                                            "Partie du membre supérieur des humains entre le coude (qui la relie à l'arrière-bras ou bras strict) et le poignet (qui la relie à la main)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0fbc51ce-e275-4dc1-a761-5d6abb8fadc6",
                                                "sense_id": "11f8a29e-6d13-337e-83ef-9581595c10d2",
                                                "text": "S’attendant à la paire de claques, prélude de la raclée, l’avant-bras déjà presque levé pour la parade habituelle, Camus en demeura un instant muet de stupéfaction."
                                            },
                                            {
                                                "example_id": "77833280-4985-4213-89c6-006bd41d6812",
                                                "sense_id": "11f8a29e-6d13-337e-83ef-9581595c10d2",
                                                "text": "Les mouvements de flexion et d’extension de l’avant-bras sont gérés par plusieurs muscles dont le biceps (muscle fléchisseur) et le triceps (muscle extenseur)."
                                            },
                                            {
                                                "example_id": "4d67564f-3af8-49a4-9365-230e5e89f5f5",
                                                "sense_id": "11f8a29e-6d13-337e-83ef-9581595c10d2",
                                                "text": "D’un autre côté, une forte pression sur l’avant-bras peut endolorer les parties, les priver pour le moment de la pronation et de la supination, quoiqu’il n'y ait pas fracture."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6dfec455-c9fb-3332-bd9f-3bdf5900a941",
                                        "entry_id": "7f4a9444-9e78-3e54-9170-5d85b5e1e5e6",
                                        "glosses": [
                                            "Pièce d’armure qui couvre et protège l’avant-bras, articulée avec la cubitière et le gantelet."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
