                                "example_id": "8aa21259-be19-437f-998e-f31294446967",
                                "sense_id": "02e11801-9b54-37f9-9b50-477e05944ad8",
                                "text": "Binnen een maand is hij met een van die dochters getrouwd, gokt Nella zwijgend."
                            },
                            {
                                "example_id": "36f2955c-c638-4bf8-9d9c-74acf7568df6",
                                "sense_id": "02e11801-9b54-37f9-9b50-477e05944ad8",
                                "text": "Clara Sarragon is er, en haar dochters ook."
                            }
                        ]
                    },
                    {
                        "sense_id": "ff06166d-7391-3f9e-8cb6-5eb04a251011",
                        "entry_id": "94bd6065-d2f1-3e4d-bfb9-6b147850652d",
                        "glosses": [
