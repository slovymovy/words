                ],
                "senses": [
                    {
                        "sense_id": "fa9c590d-10e5-3852-95d6-85b1e11beb87",
                        "entry_id": "d26a4b89-1a91-3783-bb2e-38810260ccd8",
                        "glosses": [
                            "weibliche Angehörige des Volks der Kelten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51971c8b-4a5d-43af-9ac2-604155895ac8",
                                "sense_id": "fa9c590d-10e5-3852-95d6-85b1e11beb87",
                                "text": "„Dieses Bild der Keltinnen als große, starke, eigenwillige und mutige beziehungsweise kriegerische Frauen ist weitverbreitet.“"
                            },
                            {
                                "example_id": "ba3707b1-e33b-41f3-8b53-9f0097ea3786",
                                "sense_id": "fa9c590d-10e5-3852-95d6-85b1e11beb87",
                                "text": "„Zur Tracht der Keltinnen gehörten auch Gürtel.“"
                            },
                            {
                                "example_id": "f4187bb3-a7b8-4696-af03-cb4141d25f92",
                                "sense_id": "fa9c590d-10e5-3852-95d6-85b1e11beb87",
                                "text": "„Sie stießen aber auch auf ein Mysterium: Mindestens 150 Jahre lang, bis in römische Zeit, wurde um die Keltin ein Totenkult betrieben.“"
                            },
                            {
                                "example_id": "a8b47aa1-b72a-48b5-b53d-be7bba530ac8",
                                "sense_id": "fa9c590d-10e5-3852-95d6-85b1e11beb87",
                                "text": "„Auffällig ist allerdings, dass über die Jahrhunderte immer wieder von ähnlichen Eigenschaften und Verhaltensweisen der Keltinnen berichtet wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cb6a2d6d-0485-495f-9c42-6e4fb89babdc",
                        "source_entry_id": "d26a4b89-1a91-3783-bb2e-38810260ccd8",
                        "source_sense_id": "fa9c590d-10e5-3852-95d6-85b1e11beb87",
                        "source_sense_description": "weibliche Angehörige des Volks der Kelten",
                        "target_lang_word": "Celt",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Celt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9bf37c79-9b57-3ad0-a2bb-76e3f88f77dd",
                                        "entry_id": "8a7e2222-5e5a-338c-9283-910d7c2fd604",
                                        "glosses": [
                                            "A member of one of the ancient peoples of Western Europe called Celtae by the Romans."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6d41d67c-c4b5-34dd-b0f6-b1a840be15a9",
                                        "entry_id": "8a7e2222-5e5a-338c-9283-910d7c2fd604",
                                        "glosses": [
                                            "A member of any of the (modern, Celtic) peoples who speak Celtic languages."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Celt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "576d124d-2a98-3f74-8b20-d19d227b84bf",
                                        "entry_id": "6dc5c5cc-d029-36c3-b5ee-7688e6916662",
                                        "glosses": [
                                            "Synonym of Celtic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0dbaf09-1bcb-4c19-9a3a-a32d743a4cc7",
                                                "sense_id": "576d124d-2a98-3f74-8b20-d19d227b84bf",
                                                "text": "In the thick of parties we become very Celt, disgusting the dull."
                                            },
                                            {
                                                "example_id": "1b4052ba-f3c8-40a7-ba18-133a1333556e",
                                                "sense_id": "576d124d-2a98-3f74-8b20-d19d227b84bf",
                                                "text": "Like Pris, he took after their mother, more Celt than English, wild and dramatic and mercurially alive."
                                            },
                                            {
                                                "example_id": "d76a8725-4f1b-43e9-bdb4-03f64701a38d",
                                                "sense_id": "576d124d-2a98-3f74-8b20-d19d227b84bf",
                                                "text": "But his bitch queen was Saxon to the bone and her legacy showed in the sons that Vortigern bred off her. Katigern Minor might be young, but he has become what his grandfather never was – more Saxon than Celt."
                                            },
                                            {
                                                "example_id": "396d0744-cf69-41b0-a0c0-251107c92ba9",
                                                "sense_id": "576d124d-2a98-3f74-8b20-d19d227b84bf",
                                                "text": "She answered with a smile and a nod. The woman was more Celt than Arienh had thought, and had clearly been deprived of women too long."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "004d1a3c-fe52-4eb9-9ced-a67501fdd9ac",
                        "source_entry_id": "d26a4b89-1a91-3783-bb2e-38810260ccd8",
                        "source_sense_id": "fa9c590d-10e5-3852-95d6-85b1e11beb87",
                        "source_sense_description": "weibliche Angehörige des Volks der Kelten",
