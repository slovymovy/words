                "senses": [
                    {
                        "sense_id": "611b9050-b655-3296-baae-34647300fcc6",
                        "entry_id": "39888fdc-29e7-3db6-a397-29b1e6e215f6",
                        "glosses": [
                            "The female genitalia; the vulva."
                        ],
                        "tags": [
                            "slang",
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "f6c5fae0-7a12-4e1a-90d2-f5ed406aca99",
                                "sense_id": "611b9050-b655-3296-baae-34647300fcc6",
                                "text": "For one day, when amusing herself with this whim\nThe carrot it snapped, and part stuck in her quim."
                            },
                            {
                                "example_id": "5e6cdb96-5736-4e1b-940c-81fb46976355",
                                "sense_id": "611b9050-b655-3296-baae-34647300fcc6",
                                "text": "Ho! What do I here behold? Were you brushing the cobwebs off a few quims?"
                            },
                            {
                                "example_id": "2a996b19-be39-44fd-8d3b-b8ae84e2bfcb",
                                "sense_id": "611b9050-b655-3296-baae-34647300fcc6",
                                "text": "As for whores—they are sometimes daughters of fine homes peddling their quim and quiff for a thumbnail of cocaine or a tot of rot-gut whiskey."
                            },
                            {
                                "example_id": "655f3c13-a080-47e5-b407-00ed911ec8a5",
                                "sense_id": "611b9050-b655-3296-baae-34647300fcc6",
                                "text": "When she's done he licks the last few drops from his lips. More cling, golden clear, to the glossy hairs of her quim."
                            },
                            {
                                "example_id": "98bee54b-d251-4e7b-8772-29963336e888",
                                "sense_id": "611b9050-b655-3296-baae-34647300fcc6",
                                "text": "Her quim grew wet, ready to welcome it."
                            }
                        ]
                    },
                    {
                        "sense_id": "24e91301-a98f-321a-ae85-fd019ca8c3f9",
                        "entry_id": "39888fdc-29e7-3db6-a397-29b1e6e215f6",
                        "glosses": [
                            "An extremely unpleasant or objectionable person."
                        ],
                        "tags": [
                            "derogatory",
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "ad0e7164-1616-4c6d-a447-7568acf0a120",
                                "sense_id": "24e91301-a98f-321a-ae85-fd019ca8c3f9",
                                "text": "(to Black Widow) In every way, [ Clint Barton ] knows your fear! And then he'll wake…to see his good work…When he screams, I'll split his skull! This is my bargain, you mewling quim!"
                            }
                        ]
                    }
                ],
                "translations": [
