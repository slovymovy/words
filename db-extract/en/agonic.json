                    },
                    {
                        "sense_id": "0781b707-b117-3c66-bc49-30898608013f",
                        "entry_id": "31720cb8-9262-3e11-b258-a55be3a146ff",
                        "glosses": [
                            "Having a magnetic deviation of zero."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "3449276f-c9d4-46df-b8a3-9b745613d74d",
                                "sense_id": "0781b707-b117-3c66-bc49-30898608013f",
                                "text": "There are two lines on the earth's surface which have been called agonic lines, upon which there is no declination; and where, therefore, the needle is directed along the terrestrial meridian."
                            },
                            {
                                "example_id": "ae75486e-a1c3-4fa8-8a0d-ea2a77a7da73",
                                "sense_id": "0781b707-b117-3c66-bc49-30898608013f",
                                "text": "It is contended by some that their [cyclones'] general movement is at right angles to the magnetic meridian. If this should prove to be correct, then in all that part of the United States lying west of the Agonic Line, the general direction whence local rain, hail, and snow-storms come, will be as many degrees north of west as the declination of the needle is east of north; and in all that part of the territory lying east of said Agonic Line, they will come from a direction as many degrees south of west as the declination of the needle is west of north."
                            }
                        ]
                    },
                    {
                        "sense_id": "cab1ea07-3025-358a-a1d3-7a93a1e04671",
