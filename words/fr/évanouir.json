    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fca234b4-bbcd-36cd-b332-bfc656d9d6e4",
                    "sense_definition": "Perdre connaissance temporairement sous l'effet d'un malaise, d'une vive émotion ou de la douleur.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "perte_de_connaissance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "À la vue du sang, le jeune homme s'est soudainement <w>évanoui</w> dans la salle d'attente."
                        },
                        {
                            "text": "Il faisait tellement chaud dans la pièce qu'elle a failli s'<w>évanouir</w> pendant la réunion."
                        }
                    ],
                    "synonyms": [
                        "défaillir"
                    ],
                    "common_phrases": [
                        "faillir s'évanouir"
                    ]
                },
                {
                    "sense_id": "dbfb33e3-5002-3dd1-871c-8624ce8320da",
                    "sense_definition": "Disparaître progressivement sans laisser de traces, en parlant d'une chose concrète ou abstraite.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "disparition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tous nos espoirs de victoire se sont <w>évanouis</w> après cette lourde défaite inattendue."
                        },
                        {
                            "text": "Le voleur a profité de la foule pour s'<w>évanouir</w> dans la nature sans laisser de traces."
                        }
                    ],
                    "synonyms": [
                        "disparaître",
                        "se dissiper"
                    ],
                    "antonyms": [
                        "apparaître"
                    ],
                    "common_phrases": [
                        "s'évanouir dans la nature",
                        "s'évanouir dans les airs"
                    ]
                },
                {
                    "sense_id": "a8942706-3402-343c-9897-3f4c768c4449",
                    "sense_definition": "Faire disparaître, dissiper ou anéantir complètement.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "disparition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le temps et la résignation ont fini par <w>évanouir</w> les souvenirs les plus douloureux."
                        },
                        {
                            "text": "Cette nouvelle rassurante <w>évanouit</w> enfin les craintes qui tourmentaient les villageois depuis des semaines."
