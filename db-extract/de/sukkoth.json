                "senses": [
                    {
                        "sense_id": "92bcee4a-b2eb-3a76-a29c-edf1fd9f965b",
                        "entry_id": "0eb32d13-881d-3cbf-a996-09c630b6e6ed",
                        "glosses": [
                            "alljährliches, fünf Tage nach Jom Kippur begangenes Fest, das sieben Tage, vom 15. bis 21. Tischri, dauert und während dem traditionellerweise in eigens für die Dauer des Festes gebauten Laubhütten (auf Dächern, Terrassen, im Garten, Hof) oder in mit Laub geschmückten Zimmern gegessen (und gewohnt) wird"
                        ],
                        "tags": [
                            "jüdische Religion"
                        ],
                        "examples": [
                            {
                                "example_id": "b9147e13-48bd-40a6-89f2-f3c92a9bf3ec",
                                "sense_id": "92bcee4a-b2eb-3a76-a29c-edf1fd9f965b",
                                "text": "„Heute bei Sonnenuntergang beginnen die Juden das Fest der Laubhütten, Sukkoth.“"
                            },
                            {
                                "example_id": "3f5d4235-16b0-4481-b8fc-4500012eccfc",
                                "sense_id": "92bcee4a-b2eb-3a76-a29c-edf1fd9f965b",
                                "text": "„Es nahte Sukkoth, und man verkaufte Ethrog und Lulaw neben Moische Pufeles Eierladen, und als sie nicht aufpaßten, schnappte sich Paul einen Paradiesapfel und zwei Palmzweige und schlenderte pfeifend, als habe er ein lupenreines Gewissen, heim, zu Anna.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
