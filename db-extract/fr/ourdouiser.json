                "senses": [
                    {
                        "sense_id": "ec2464fe-57bf-377a-941a-efeaa5e01c86",
                        "entry_id": "6cfc7dff-1dce-3799-8e40-68021fd60f02",
                        "glosses": [
                            "Donner un caractère ourdou à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10741da6-e78a-4a1a-92f7-a38011f67928",
                                "sense_id": "ec2464fe-57bf-377a-941a-efeaa5e01c86",
                                "text": "Pendant la période pakistanaise, de 1947 à 1971, le régime reprit la tentative de ces réformateurs islamistes et chercha à ourdouiser le bengali de façon systématique."
                            },
                            {
                                "example_id": "30d112e8-82b0-41e8-986d-d03a38e217d6",
                                "sense_id": "ec2464fe-57bf-377a-941a-efeaa5e01c86",
                                "text": "Berger (1974) note cependant que les mots pour lesquels on peut montrer qu’ils sont venus du persan en bourouchaski sans l’intermédiaire de l’ourdou, comme par exemple samón 'bagage' ont tendance à s’ourdouiser pour donner samán, sous l’influence de l’ourdou sāmān."
                            }
                        ]
                    }
