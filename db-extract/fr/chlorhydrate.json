                ],
                "senses": [
                    {
                        "sense_id": "bdff0c67-80b6-3147-a28d-7c6062725f4b",
                        "entry_id": "e6b27d0e-0a71-3d7e-b18c-72cc4b0a739f",
                        "glosses": [
                            "Sel formé par la combinaison de l’acide chlorhydrique avec certaines bases."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d859f585-7290-4b32-b29d-a5d3d3bab698",
                                "sense_id": "bdff0c67-80b6-3147-a28d-7c6062725f4b",
                                "text": "On retire la morphine de l'extrait d'opium au moyen d’un lait de chaux qui dissout la morphine sous forme de morphinate ; l'addition de chlorhydrate d'ammoniaque précipite la morphine."
                            },
                            {
                                "example_id": "c4d0638d-9739-413f-abe2-dfeaf1a04234",
                                "sense_id": "bdff0c67-80b6-3147-a28d-7c6062725f4b",
                                "text": "Le chlorhydrate est utilisé pour les injections retard (à forme prolongée) contrairement à l'acétate, qui est utilisée aussi pour les injections retard mais à forme semi prolongée."
                            },
                            {
                                "example_id": "08f9e89c-8cd1-4961-b9fe-d5406f1c628c",
                                "sense_id": "bdff0c67-80b6-3147-a28d-7c6062725f4b",
                                "text": "Il espérait pouvoir ainsi utiliser les chlorhydrates de ces dérivés qui seraient forcément hydrosolubles."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
