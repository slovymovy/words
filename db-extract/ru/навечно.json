        "ru-extract.jsonl": [
            {
                "entry_id": "762b4250-5b95-3c76-9276-bcedec479820",
                "word": "навечно",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d857b791-e989-316b-99c3-8a394e3d195d",
                        "entry_id": "762b4250-5b95-3c76-9276-bcedec479820",
                        "glosses": [
                            "на всё будущее, оставшееся время; навсегда"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ecdf7e7b-86e9-4f42-98ae-230d1e96ddaf",
                        "source_entry_id": "762b4250-5b95-3c76-9276-bcedec479820",
                        "source_sense_id": "d857b791-e989-316b-99c3-8a394e3d195d",
                        "target_lang_word": "forever",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "forever",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ae7159a4-56ca-3777-8118-43fdbd72e171",
                                        "entry_id": "1773dd74-964b-3e4d-8d64-91402219b3ba",
                                        "glosses": [
                                            "For all time, for all eternity; for a lifetime; for an infinite amount of time."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0fd58a8b-20e6-419f-a8a7-bb18d6d81d22",
                                                "sense_id": "ae7159a4-56ca-3777-8118-43fdbd72e171",
                                                "text": "I shall love you forever."
                                            },
                                            {
                                                "example_id": "94e9e59e-7930-4962-9134-9c0fff250f94",
                                                "sense_id": "ae7159a4-56ca-3777-8118-43fdbd72e171",
                                                "text": "Secondly, When a body is once in motion it will continue to move forever, unless something stops it. When a ball is struck on the surface of the earth, the friction of the earth and the resistance of the air soon stop its motion."
                                            },
                                            {
                                                "example_id": "f5d96fd6-3c36-4d2c-8031-12eb488dd464",
                                                "sense_id": "ae7159a4-56ca-3777-8118-43fdbd72e171",
                                                "text": "If you want a picture of the future, imagine a boot stamping on a human face — for ever."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4febebd4-6573-3f92-8155-0c5e2993b0de",
                                        "entry_id": "1773dd74-964b-3e4d-8d64-91402219b3ba",
                                        "glosses": [
                                            "For a very long time, a seeming eternity."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "excessive",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89d39b3d-cfa1-4386-b1f8-6a6c0edf52fd",
                                                "sense_id": "4febebd4-6573-3f92-8155-0c5e2993b0de",
                                                "text": "We had to wait forever to get inside."
                                            },
                                            {
                                                "example_id": "a5717684-cca9-464f-a039-deb6e71278e9",
                                                "sense_id": "4febebd4-6573-3f92-8155-0c5e2993b0de",
                                                "text": "That was forever ago."
                                            },
                                            {
                                                "example_id": "40fee6cb-05c5-4fe6-ac53-ed80d53bdede",
                                                "sense_id": "4febebd4-6573-3f92-8155-0c5e2993b0de",
                                                "text": "She and Serena had been friends forever. Or nearly forever: forty-two years, beginning with Miss Kimmel's first grade."
                                            },
                                            {
                                                "example_id": "b7d8cfee-d02d-44f8-95c7-a24e7620cc52",
                                                "sense_id": "4febebd4-6573-3f92-8155-0c5e2993b0de",
                                                "text": "Anything in the world of transport takes forever to do, and costs far too much."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "223093f2-fccc-3089-8461-f206885c5566",
                                        "entry_id": "1773dd74-964b-3e4d-8d64-91402219b3ba",
                                        "glosses": [
                                            "Constantly or frequently."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fdb3893e-ed3d-4843-9324-e0af90fbe665",
                                                "sense_id": "223093f2-fccc-3089-8461-f206885c5566",
                                                "text": "You are forever nagging me."
                                            },
                                            {
                                                "example_id": "e4acd009-5c40-4c2c-882b-4e8a0f845361",
                                                "sense_id": "223093f2-fccc-3089-8461-f206885c5566",
                                                "text": "Early in his boyhood he had learned to form ropes by twisting and tying long grasses together, and with these he was forever tripping Tublat or attempting to hang him from some overhanging branch."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "forever",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "813b0a0c-0b3e-35e9-90b4-7b9aee1f1fc9",
                                        "entry_id": "0ef3f3f7-d841-35cb-976b-fa68e5858f82",
                                        "glosses": [
                                            "An extremely long time."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79c1e8ae-5983-4495-99c8-6dce996827ec",
                                                "sense_id": "813b0a0c-0b3e-35e9-90b4-7b9aee1f1fc9",
                                                "text": "I haven't seen him in forever!"
                                            },
                                            {
                                                "example_id": "b89417ca-93c5-4c09-bfce-c0308603e18f",
                                                "sense_id": "813b0a0c-0b3e-35e9-90b4-7b9aee1f1fc9",
                                                "text": "It took me forever to make up my mind."
                                            },
                                            {
                                                "example_id": "4d0c5b88-5016-42a4-82dc-65d91e5dd51a",
                                                "sense_id": "813b0a0c-0b3e-35e9-90b4-7b9aee1f1fc9",
                                                "text": "Don't spend forever on the phone!"
                                            },
                                            {
                                                "example_id": "99f4827e-6be2-4f21-ba2d-5f3e6da8f064",
                                                "sense_id": "813b0a0c-0b3e-35e9-90b4-7b9aee1f1fc9",
                                                "text": "She should've been here five forevers ago!"
                                            },
                                            {
                                                "example_id": "a70d01cb-b30f-4854-ba49-7551a7d54e60",
                                                "sense_id": "813b0a0c-0b3e-35e9-90b4-7b9aee1f1fc9",
                                                "text": "It's been a fortnight of forevers since the Braves could count on a late-game comeback."
                                            },
                                            {
                                                "example_id": "9cfe283e-5adb-42b2-984e-39a7b8103511",
                                                "sense_id": "813b0a0c-0b3e-35e9-90b4-7b9aee1f1fc9",
                                                "text": "In the airport, holiday lovers kiss, mouth forevers, the usual argot betrays you. Desire makes love dull."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1ed1d6d-6219-3c99-867c-76f093b09ce2",
                                        "entry_id": "0ef3f3f7-d841-35cb-976b-fa68e5858f82",
                                        "glosses": [
                                            "A mythical time in the future that will never come."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "poetic",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c891c739-5e07-47b6-a240-a1d72d5b878c",
                                                "sense_id": "a1ed1d6d-6219-3c99-867c-76f093b09ce2",
                                                "text": "Sure, I'd be happy to meet with you on the 12th of forever."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "forever",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e99d4a73-5843-3548-9f59-c6e2ea65102c",
                                        "entry_id": "60dd6139-fd18-3b85-b07b-40eb2fe3fba5",
                                        "glosses": [
                                            "Permanent, lasting; constant, perpetual."
                                        ],
                                        "tags": [
                                            "informal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "370b5dc8-a681-4335-8243-3281633df92c",
                                                "sense_id": "e99d4a73-5843-3548-9f59-c6e2ea65102c",
                                                "text": "It'd be a peaceful life / With a forever wife / And a kid someday"
                                            },
                                            {
                                                "example_id": "b0d38ca2-3b9a-43a3-b1b2-8c402578a794",
                                                "sense_id": "e99d4a73-5843-3548-9f59-c6e2ea65102c",
                                                "text": "We'll take care of you and help you find a Forever Home."
                                            },
                                            {
                                                "example_id": "f3dc286d-733f-4c79-8450-caed7e9540d0",
                                                "sense_id": "e99d4a73-5843-3548-9f59-c6e2ea65102c",
                                                "text": "He is a forever friend."
                                            },
                                            {
                                                "example_id": "7cb42831-5510-49f3-9b48-57535b975eac",
                                                "sense_id": "e99d4a73-5843-3548-9f59-c6e2ea65102c",
                                                "text": "Danner posits that the United States has been trapped in a \"forever war\" by 9/11, and describes a nation that has been altered in fundamental ways by President Bush's having declared a war of choice and without an exit plan, […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c8f77c69-4584-46cc-84dd-0f7f19690c2d",
                        "source_entry_id": "762b4250-5b95-3c76-9276-bcedec479820",
                        "source_sense_id": "d857b791-e989-316b-99c3-8a394e3d195d",
