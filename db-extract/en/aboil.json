                    }
                ],
                "senses": [
                    {
                        "sense_id": "311dc1aa-cb04-3e51-aad4-0ca610fca479",
                        "entry_id": "194961f6-1634-3245-84f2-f5b1f3be76a4",
                        "glosses": [
                            "In a boil; boiling."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50404ab3-0d07-4896-a2b1-426a21ec308f",
                                "sense_id": "311dc1aa-cb04-3e51-aad4-0ca610fca479",
                                "text": "The cooking, I can tell you, kept her nose to the pot, and even if there was nothing in it, even though there was no pot, she had to keep watching that it came aboil just the same."
                            },
                            {
                                "example_id": "5885c12b-4b4e-4221-8d3b-120a2e9fec91",
                                "sense_id": "311dc1aa-cb04-3e51-aad4-0ca610fca479",
                                "text": "Being a devotee of the Johnny Weismuller school of Tarzaning, no wasp-waisted cartoon character can get my blood aboil."
                            },
                            {
                                "example_id": "f6b2c544-3bbc-4e1f-8229-c8d9d8f63d73",
                                "sense_id": "311dc1aa-cb04-3e51-aad4-0ca610fca479",
                                "text": "The stove is full, with corned beef asimmer in one pot, cabbage aboil in another, and vegetable soup asteam in a third."
                            }
                        ]
                    },
                    {
                        "sense_id": "6b277d74-8dbc-35d1-b566-de92925e74c2",
                        "entry_id": "194961f6-1634-3245-84f2-f5b1f3be76a4",
                        "glosses": [
                            "Heated up; excited."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "93e4ae59-debf-460c-9e4d-f55ad4656c8a",
                                "sense_id": "6b277d74-8dbc-35d1-b566-de92925e74c2",
                                "text": "He plugged on steadily, unmindful of where he was going. He was aboil with perturbation."
                            },
                            {
                                "example_id": "1ddb0e0b-bcc3-4685-9f4c-ed27868cc0d9",
                                "sense_id": "6b277d74-8dbc-35d1-b566-de92925e74c2",
                                "text": "At ten o’clock on the morning of his third visit, Pablo found himself aboil with rage and sweat, glaring into the druggist’s thick horn-rimmed spectacles in an attempt to engage the dead bug eyes behind them."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9cddc24b-a039-4a24-bc94-1aa017c55a4f",
                        "source_entry_id": "194961f6-1634-3245-84f2-f5b1f3be76a4",
