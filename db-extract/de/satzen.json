                ],
                "senses": [
                    {
                        "sense_id": "d7885224-3fd0-3eea-9feb-9b4b5f82f019",
                        "entry_id": "d22204b3-a332-363b-990a-4159651689c5",
                        "glosses": [
                            "erlassen und schriftlich fixieren (im Gegensatz zum Gewohnheitsrecht und/oder Naturrecht)"
                        ],
                        "tags": [
                            "Rechtsnormen"
                        ],
                        "examples": [
                            {
                                "example_id": "b5024290-2f86-47ad-9859-307a73cb45e1",
                                "sense_id": "d7885224-3fd0-3eea-9feb-9b4b5f82f019",
                                "text": "„Das Denkmalamt hatte angeregt, den B-Plan zu splitten, und den Teil des alten Schlosses gesondert zu behandeln und separat zu satzen.“"
                            },
                            {
                                "example_id": "a8ffb791-1dcd-4787-83b6-0a931cf975e1",
                                "sense_id": "d7885224-3fd0-3eea-9feb-9b4b5f82f019",
                                "text": "„Folgende Maßnahmen zur Schließung der Lücken und Schlupflöcher sind vorgesehen: 1. Die Schaffung einer ausdrücklichen Möglichkeit für die Sozialpartner, einen einheitlichen (General-) Kollektivvertrag zu vereinbaren und diesen beim Bundeseinigungsamt satzen zu lassen.“"
                            },
                            {
                                "example_id": "5f490d54-c334-424b-8f55-7e22f9ccd294",
                                "sense_id": "d7885224-3fd0-3eea-9feb-9b4b5f82f019",
                                "text": "„Sollte sich herausstellen, dass ein Bebauungsplan negative Auswirkungen auf die klimatologische Situation und somit die Gesundheit der Menschen in dieser Stadt hat, ist dieser entweder nicht zu satzen oder zumindest so zu verändern, dass der Schaden abgewendet wird.“"
                            },
                            {
                                "example_id": "d930d761-fc54-4c58-8a4e-7cb38d6358e5",
                                "sense_id": "d7885224-3fd0-3eea-9feb-9b4b5f82f019",
                                "text": "„Nach Vollzug des Beschlusses wird im Rahmen einer öffentlichen Stadtratsbekanntgabe mitgeteilt, wenn der Bebauungsplan gesatzt wurde.“"
                            },
                            {
                                "example_id": "599fd0b2-6d8a-471e-b15a-b7bb6e35b69d",
                                "sense_id": "d7885224-3fd0-3eea-9feb-9b4b5f82f019",
                                "text": "„Innerhalb des menschlichen Rechts lässt sich unterscheiden zwischen Gewohnheitsrecht und gesatztem Recht; das Kriterium der Unterscheidung ist die Schriftform.“"
                            },
                            {
                                "example_id": "6da4d766-79e6-4c12-8bb8-331372401609",
                                "sense_id": "d7885224-3fd0-3eea-9feb-9b4b5f82f019",
                                "text": "„Der Herrscher stand somit über dem Recht, insofern er im Sinne konfuzianischer Ethik das vorhandene Recht interpretierte und dadurch erst zum Gesetz machte. Recht existierte demnach nur als Gesetz, als ‚gesatztes Recht‘.“"
                            },
                            {
                                "example_id": "16dd5f6c-1601-4130-8387-693f69a20463",
                                "sense_id": "d7885224-3fd0-3eea-9feb-9b4b5f82f019",
                                "text": "„‚[…] Die Grundnorm ist nicht selbst gesatzt, sondern von der Rechtserkenntnis vorausgesetzt‘; sie ist eine ‚rechtstheoretische Hypothese‘.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
