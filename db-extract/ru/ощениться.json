                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2b\""
                                    },
                                    {
                                        "sense_id": "d4c5287f-651e-37c5-8dd9-b8ce8b784295",
                                        "entry_id": "cd59f3a6-7502-34a1-8aa9-e5c96e33b745",
                                        "glosses": [
                                            "sich verformen, ganz besonders, wenn es sich um Holz oder Papier, auch Tapete oder Stoff, handelt"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ffc38100-2241-40db-9dbc-768af09a05a1",
                                                "sense_id": "d4c5287f-651e-37c5-8dd9-b8ce8b784295",
                                                "text": "Sperrholz wirft sich nicht."
                                            },
                                            {
                                                "example_id": "9860a82e-93e8-4f15-a897-ff1b204f333b",
                                                "sense_id": "d4c5287f-651e-37c5-8dd9-b8ce8b784295",
                                                "text": "Da oben, in der Ecke über der Tür, hat sich die Tapete geworfen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "ab7ba999-80eb-31e9-8494-7064d60d55f5",
                                        "entry_id": "cd59f3a6-7502-34a1-8aa9-e5c96e33b745",
                                        "glosses": [
                                            "erzeugen, verursachen, zu einer neuen Situation führen, zum Beispiel einen Schatten werfen oder Licht auf etwas werfen (siehe auch Redewendungen)"
                                        ],
                                        "tags": [
                                            "bildlich"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d8f71ee-f530-4ebf-95e9-6612eb4a9f4b",
                                                "sense_id": "ab7ba999-80eb-31e9-8494-7064d60d55f5",
                                                "text": "Ihre gebeugte Figur wirft einen unheimlichen Schatten an die Wand."
                                            },
                                            {
                                                "example_id": "a2bd8d96-a95a-4d52-be69-92371c7b53ff",
                                                "sense_id": "ab7ba999-80eb-31e9-8494-7064d60d55f5",
                                                "text": "Diese Aussage wirft ja ein ganz neues Licht auf den Fall."
                                            }
                                        ],
