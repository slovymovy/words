                        "sense_id": "efa9ce97-def2-309e-b1b8-c6f957acf8c6",
                        "entry_id": "a3b3e817-5b52-3d72-833b-846f52ab34a0",
                        "glosses": [
                            "een afvalemmer met een deksel waarbij het deksel wordt bediend met de voet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5bdf9f35-3e57-4464-afa3-29907dfeeacc",
                                "sense_id": "efa9ce97-def2-309e-b1b8-c6f957acf8c6",
                                "text": "'De brievenbus wordt gemakkelijk geopend door de voet op de hendel onderaan te plaatsen. Hetzelfde systeem als bij een pedaalemmer. Dan opent het deksel vanzelf."
                            },
                            {
                                "example_id": "05936a97-3f15-446c-a782-d3348af25ee7",
                                "sense_id": "efa9ce97-def2-309e-b1b8-c6f957acf8c6",
                                "text": "In steeds meer gemeenten moet per leging van de grijze container betaald worden. Wie zijn groente-, fruit- en tuinafval nog gewoon in de reguliere pedaalemmer gooit, en de zak vervolgens in de grijze container deponeert, kan makkelijke winst halen door de gft-container beter te gebruiken."
                            }
                        ]
                    }
