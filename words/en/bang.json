            "senses": [
                {
                    "sense_id": "6dda068e-eeb4-3633-9dc5-00136c2b74cb",
                    "sense_definition": "A sudden, loud, percussive noise.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "noise_impact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The door slammed shut with a loud <w>bang</w>.",
