                    {
                        "translation_id": "15d453e8-40e0-4957-90ec-310b83eedd17",
                        "source_entry_id": "6f2755b4-7b9a-3fab-bbc5-fcc3e10b65c4",
                        "source_sense_id": "2c9b13a1-4644-35a3-88c0-84fbc7f95682",
