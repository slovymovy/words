                        "form": "der Abreibung"
                    },
                    {
                        "form_id": "05e4f1aa-e6bf-40c6-a70e-5367d67140d0",
                        "entry_id": "bc1b0bb1-437a-3940-91b8-c17099c6ebd3",
                        "tags": [
                            "dative",
                            "plural"
                        ],
                        "form": "den Abreibungen"
                    },
                    {
                        "form_id": "3dade0f2-fe01-4864-9346-e67cec54d66a",
                        "entry_id": "bc1b0bb1-437a-3940-91b8-c17099c6ebd3",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Abreibung"
                    },
                    {
                        "form_id": "68efb65a-3dfe-4291-8d81-fd8986541f90",
                        "entry_id": "bc1b0bb1-437a-3940-91b8-c17099c6ebd3",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Abreibungen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3abb4c56-a34d-3311-860c-8e7c7c528b4b",
                        "entry_id": "bc1b0bb1-437a-3940-91b8-c17099c6ebd3",
                        "glosses": [
                            "Handlung, etwas abzureiben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bfdb3a0a-f881-438f-a80f-85d9d3ee31e3",
                                "sense_id": "3abb4c56-a34d-3311-860c-8e7c7c528b4b",
                                "text": "„Nach weiteren Abreibungen mit rauen Schwämmen, warmen Spülungen und einer eiskalten Dusche ist man dann wirklich erfrischt.“"
                            },
                            {
                                "example_id": "f359199d-622d-479c-93aa-cbdf9e1fa6e7",
                                "sense_id": "3abb4c56-a34d-3311-860c-8e7c7c528b4b",
                                "text": "„Die mechanischen Einflüsse können beim Kalkofen nur darin bestehen, daß das Kalkofenfutter durch die niedergehende Gicht (Beschickung) auf Abreibung beansprucht wird; ferner übt die Gicht auf das umschließende Futter einen gewissen Druck aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b782dc22-8291-3737-81f6-4a9109d7a841",
                        "entry_id": "bc1b0bb1-437a-3940-91b8-c17099c6ebd3",
                        "glosses": [
                            "Verabreichung von Prügel/Schlägen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a129968-3dca-4cf5-aa3a-44039b43ff51",
                                "sense_id": "b782dc22-8291-3737-81f6-4a9109d7a841",
                                "text": "Nach der Abreibung hatte er tagelang ein blaues Auge."
                            },
                            {
                                "example_id": "9efe5f48-ba10-4cf1-a523-4343d3b9c97b",
                                "sense_id": "b782dc22-8291-3737-81f6-4a9109d7a841",
                                "text": "„Er hatte eine ordentliche Abreibung verdient, eine Abreibung, die beweisen würde, dass er der Stärkere war und dass man einen Matrosen der Saint-Paul nicht ungestraft demütigte.“"
                            },
                            {
                                "example_id": "5f26abaf-2489-4e54-bf37-bc6809aa5091",
                                "sense_id": "b782dc22-8291-3737-81f6-4a9109d7a841",
                                "text": "„Ich hatte nicht gewußt, daß Volker in der Zwischenzeit von Mama überführt worden war und eine Abreibung bezogen hatte.“"
                            },
                            {
                                "example_id": "1cbdc574-3687-48b6-b77c-899b8a7d4796",
                                "sense_id": "b782dc22-8291-3737-81f6-4a9109d7a841",
                                "text": "„Er blieb beharrlich, las ihnen weiter aus einem Artikel über Kumulonimbus vor, bis ein Schüler aufstand, ihm eine Abreibung verpasste und ihm befahl, sich zum Nordbahnhof zu scheren und in den ersten Zug Richtung Hinterland zu steigen.“"
                            },
                            {
                                "example_id": "ccb6b278-85e2-4b80-a81c-725410adf429",
                                "sense_id": "b782dc22-8291-3737-81f6-4a9109d7a841",
                                "text": "„Bei dem Handgemenge sollen Mainzer Fans Platzwunden und Fingerbrüche durch Fauststöße erlitten haben. Ein Vertreter der Mainzer Ultras sagte vor Gericht aus, der Vorgang sei eine unter Ultras typische „Abreibung“ gewesen.“"
                            },
                            {
                                "example_id": "1aa603f0-49d9-49ab-81ff-4e2752504098",
                                "sense_id": "b782dc22-8291-3737-81f6-4a9109d7a841",
                                "text": "„Als Tonys Provokationen nicht nachlassen, organisiert Carrigan drei Raufbolde seiner Gang, um Tony in der Umkleidekabine eine Abreibung zu verpassen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "689c7800-91a2-4190-b45d-9864bfaa4ba9",
                        "source_entry_id": "bc1b0bb1-437a-3940-91b8-c17099c6ebd3",
                        "source_sense_id": "b782dc22-8291-3737-81f6-4a9109d7a841",
                        "source_sense_description": "Verabreichung von Prügel/Schlägen",
                        "target_lang_word": "dérouillée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dérouillée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "399d7c6d-055a-3710-975a-48e385944f10",
                                        "entry_id": "75b6e45d-4b21-3b21-ac92-43ddff38a7ac",
                                        "glosses": [
                                            "Volée de coups ; dégelée ; flaupée ; raclée ; trempe ; roustée."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd47a9b5-e3aa-4176-a499-89b8838d7e4e",
                                                "sense_id": "399d7c6d-055a-3710-975a-48e385944f10",
                                                "text": "Elle était avec une espèce de raté prénommé Goose — un branchouillard de seconde zone qui, selon elle, lui a flanqué la dérouillée du siècle. Sans compter qu’il l’a escroquée financièrement."
                                            },
                                            {
                                                "example_id": "40193dfc-50d2-4a52-89d0-7872824f0870",
                                                "sense_id": "399d7c6d-055a-3710-975a-48e385944f10",
                                                "text": "C’est là que le chef des Arvernes, Vercingétorix, aurait infligé une fameuse dérouillée à Jules César."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dérouillée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a0b4340d-4b50-3d58-9472-323f3cb7ea88",
                                        "entry_id": "21a584eb-017e-39c9-96df-276c8fb4cb98",
                                        "glosses": [
                                            "Participe passé féminin singulier de dérouiller."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12ebec64-6646-416d-99fc-3cdfc11b1812",
                                                "sense_id": "a0b4340d-4b50-3d58-9472-323f3cb7ea88",
                                                "text": "Je me fais vieille, il me faut de plus en plus de temps pour être dérouillée le matin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
