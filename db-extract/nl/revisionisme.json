                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "7d5b75e1-89ab-4edd-b36f-9c5cc266b545",
                        "source_entry_id": "e122a8cb-561a-3dcb-aeb0-207490e325a4",
                        "source_sense_description": "1-3. streven naar herziening (van het marxisme, de geschiedenis)",
                        "target_lang_word": "revisionism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "revisionism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4ff4e1d2-889c-31bc-aba9-ce141bd31b56",
                                        "entry_id": "83d903d4-4934-381c-9080-2ffe96e0b689",
                                        "glosses": [
                                            "The advocacy of a revision of some accepted theory, doctrine or a view of historical events."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ada0c11f-607d-45be-925f-9c598e267ba8",
                                                "sense_id": "4ff4e1d2-889c-31bc-aba9-ce141bd31b56",
                                                "text": "Tories spent last week boldly whistling their unique brand of the kind of historical revisionism that has played a major part in getting us here."
                                            },
                                            {
                                                "example_id": "23920eeb-9175-4565-b5ae-aa8aab65a018",
                                                "sense_id": "4ff4e1d2-889c-31bc-aba9-ce141bd31b56",
                                                "text": "As for Jones’s performance as Mandy Cohen, it united two leading facets of the funnyman’s repertoire: his fondness for female impersonation, and his passion for historical revisionism."
                                            },
                                            {
                                                "example_id": "19aa9b36-c679-4cee-a702-10f244152274",
                                                "sense_id": "4ff4e1d2-889c-31bc-aba9-ce141bd31b56",
                                                "text": "Meanwhile, Holocaust survivors are dying every day. There are few left to protest the new revisionism."
                                            },
                                            {
                                                "example_id": "832d2320-2571-452f-bc66-2bf43bf2df0a",
                                                "sense_id": "4ff4e1d2-889c-31bc-aba9-ce141bd31b56",
                                                "text": "Katelyn Jetelina is an epidemiologist and the author of the popular newsletter Your Local Epidemiologist. She argues that we’ve entered a new phase of the Covid-19 pandemic: “pandemic revisionism.”"
                                            },
                                            {
                                                "example_id": "952d609c-943a-49c2-9f27-cbff6343bec9",
                                                "sense_id": "4ff4e1d2-889c-31bc-aba9-ce141bd31b56",
                                                "text": "For inspiration, they [Orbán’s fellow anti-liberal counterrevolutionaries] look to the Russia of Vladimir Putin, whose national chauvinism, banning of “gender ideology” and “gay propaganda,” and revisionism against the world order fit well with their agenda."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5fbc9404-dd11-343e-8c08-49a549e0145c",
                                        "entry_id": "83d903d4-4934-381c-9080-2ffe96e0b689",
                                        "glosses": [
                                            "An evolutionary form of Marxism, abandoning some of its original principles."
                                        ],
                                        "tags": [
                                            "Marxism",
                                            "countable",
                                            "derogatory",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e86e74f0-a51b-4ef2-98f3-c366a5855cf6",
                        "source_entry_id": "e122a8cb-561a-3dcb-aeb0-207490e325a4",
                        "source_sense_description": "1-3. streven naar herziening (van het marxisme, de geschiedenis)",
                        "target_lang_word": "révisionnisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "révisionnisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "05603527-d8a4-3ddc-af9b-226be3f9758b",
                                        "entry_id": "5312c2ef-6d42-3212-9cfe-729fd1a023a9",
                                        "glosses": [
                                            "Démarche critique consistant à réviser certaines opinions, doctrines, théories couramment admises."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65225fb0-5a92-45c6-b8de-03326f61c28c",
                                                "sense_id": "05603527-d8a4-3ddc-af9b-226be3f9758b",
                                                "text": "Quelle gêne, le succès du révisionnisme ! Ô désespoir ! le grand courant révisionniste fera-t-il des épaves de nos petites préparations !"
                                            },
                                            {
                                                "example_id": "b99398ba-676d-4bb8-b4bc-42cc25e08087",
                                                "sense_id": "05603527-d8a4-3ddc-af9b-226be3f9758b",
                                                "text": "Citoyens ; il en est temps encore, revenez-en à la théorie de la souveraineté absolue du peuple – et permanente – sans cela le boulangisme tuera le révisionnisme sans profit pour les boulangistes."
                                            },
                                            {
                                                "example_id": "63a50331-d0aa-445d-9102-f7ffe0590722",
                                                "sense_id": "05603527-d8a4-3ddc-af9b-226be3f9758b",
                                                "text": "Le négationnisme vient en parfaite contradiction des événements qui se sont effectivement déroulés, lorsque le révisionnisme essaye de réinterpréter ou de remettre en perspective des faits, en accord avec les données objectives, sans opérer de sélection dans celles-ci."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e65cbfa-0871-3413-b60f-891a8edcc626",
                                        "entry_id": "5312c2ef-6d42-3212-9cfe-729fd1a023a9",
                                        "glosses": [
                                            "Souvent Adaptation du marxisme à la conjoncture économique, sociologique, politique, etc."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08f4ce8b-ae70-4265-96b9-75a261a676c8",
                                                "sense_id": "8e65cbfa-0871-3413-b60f-891a8edcc626",
                                                "text": "Faire preuve de révisionnisme petit-bourgeois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a1b36c9-9f83-3c88-8219-3a2c7fd27664",
                                        "entry_id": "5312c2ef-6d42-3212-9cfe-729fd1a023a9",
                                        "glosses": [
                                            "Mouvement demandant la révision du procès Dreyfus."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
