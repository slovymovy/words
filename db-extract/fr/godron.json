                            {
                                "example_id": "85b9e5b4-2a68-4506-86a2-5cea50810a30",
                                "sense_id": "433701fb-5263-3ac2-b514-a0935e2318a4",
                                "text": "Vaisselle à gros godrons, à petits godrons."
                            }
                        ]
                    },
                    {
                        "sense_id": "a734590f-5544-3bab-b267-438cb99881a0",
                        "entry_id": "66787aa5-f144-33fa-bf15-8c6c54f6e709",
                        "glosses": [
                            "Ornement de même forme qu’on fait aux ouvrages de sculpture et de menuiserie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67fb41a7-6dc3-407b-988e-95c91574d753",
                                "sense_id": "a734590f-5544-3bab-b267-438cb99881a0",
                                "text": "On le verra trop bien quand, sous Louis XV, l’habileté démoniaque de tous les artistes et artisans les entraînera au tarabiscoté, au rondouillard, au godron, à la frisure."
                            },
                            {
                                "example_id": "de66591a-9b0c-4e85-9b2d-8d6bd9757efb",
                                "sense_id": "a734590f-5544-3bab-b267-438cb99881a0",
                                "text": "Ils bordaient son œil d’un godron d’or qui, en éclairant son regard, le remplissait d’ironie et d’énigme."
                            }
                        ]
                    },
                    {
                        "sense_id": "be635e5c-a8c4-3a84-9122-91f1f7bfaaf5",
