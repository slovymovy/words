                {
                    "sense_id": "c8efc621-ca20-3244-8bb4-1e1722513121",
                    "sense_definition": "Tirer un passage, une citation ou des renseignements d'un texte, d'un livre ou d'un registre.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "texte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'auteur a <w>extrait</w> cette citation marquante d'un ancien recueil de poésie.",
                            "target_lang_translations": {
                                "en": "The author <w>extracted</w> this striking quotation from an old poetry collection.",
                                "ru": "Автор <w>выписал</w> эту запоминающуюся цитату из старого сборника стихов.",
                                "de": "Der Autor hat dieses markante Zitat aus einer alten Gedichtsammlung <w>entnommen</w>.",
                                "es": "El autor <w>extrajo</w> esta cita llamativa de una antigua antología de poesía.",
                                "zh": "作者从一部古老的诗集中<w>摘录</w>了这句令人印象深刻的引文。"
                            }
                        },
                        {
                            "text": "Elle a <w>extrait</w> plusieurs passages pertinents de ce long rapport financier.",
                            "target_lang_translations": {
