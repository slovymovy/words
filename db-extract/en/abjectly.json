                "senses": [
                    {
                        "sense_id": "f95d7ed7-f40e-39cd-90e3-5c592f621623",
                        "entry_id": "f0b47a3c-a80f-3c54-bfb4-529d5cff05d5",
                        "glosses": [
                            "In an abject fashion; with great shame; desperately."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca43aae0-a360-4737-a783-9a0cac728626",
                                "sense_id": "f95d7ed7-f40e-39cd-90e3-5c592f621623",
                                "text": "I abjectly apologise for the damage I have done."
                            },
                            {
                                "example_id": "ee967546-e956-40c3-95e2-a45c4db5b034",
                                "sense_id": "f95d7ed7-f40e-39cd-90e3-5c592f621623",
                                "text": "A deceitful man is a wolf in sheep's clothing. He will appear innocent, cheerful, polite, attentive, kind, obliging, and abjectly condescending; but let him once get you into his power and he becomes more ferocious, more cruel, and more destructive than the most savage animals that ever trod in deserts uninhabited by rational beings."
                            },
                            {
                                "example_id": "3c1c3be7-3909-469a-b06f-111c5ed0e6e4",
                                "sense_id": "f95d7ed7-f40e-39cd-90e3-5c592f621623",
                                "text": "So, deprived of one leg, and the strange ship of course being altogether unsupplied with the kindly invention, Ahab now found himself abjectly reduced to a clumsy landsman again; hopelessly eyeing the uncertain changeful height he could hardly hope to attain."
                            }
                        ]
                    },
                    {
                        "sense_id": "bbfcbca8-7f54-3e3c-91b9-794a20a2afab",
                        "entry_id": "f0b47a3c-a80f-3c54-bfb4-529d5cff05d5",
                        "glosses": [
                            "Intensely; to the utmost extreme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c60aeea-bdb1-4cef-9f9a-cc515d13be56",
                                "sense_id": "bbfcbca8-7f54-3e3c-91b9-794a20a2afab",
                                "text": "Never ask a man his opinion of a woman's dress when he is desperately and abjectly in love with the wearer."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
