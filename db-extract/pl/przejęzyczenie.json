                "senses": [
                    {
                        "sense_id": "d1c97486-a85a-3444-89b8-057cbcd5cbf9",
                        "entry_id": "238380c6-8da5-38f8-8681-41b4940a88cd",
                        "glosses": [
                            "mimowolny błąd językowy na poziomie wytwarzania wypowiedzi, np. w wyniku roztargnienia, przez nieuwagę"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74bac086-2290-4ecf-812e-a14514865058",
                                "sense_id": "d1c97486-a85a-3444-89b8-057cbcd5cbf9",
                                "text": "Przejęzyczenie spikera, który podkreślił, że wcale nie było mowy o obecnym prezydencie, nie było zrobione przypadkowo"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c5d111e8-3e9c-4346-a053-cb08e58e1609",
                        "source_entry_id": "238380c6-8da5-38f8-8681-41b4940a88cd",
                        "source_sense_id": "d1c97486-a85a-3444-89b8-057cbcd5cbf9",
                        "target_lang_word": "slip of the tongue",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "slip of the tongue",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9d59cd4f-ce3d-32da-8169-1c01f13a2689",
                                        "entry_id": "59efcd3a-f674-3979-99ab-694566bb8156",
                                        "glosses": [
                                            "A mistake in speech."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce3cf152-fd5f-4699-ac21-27e557c54ad0",
                                                "sense_id": "9d59cd4f-ce3d-32da-8169-1c01f13a2689",
                                                "text": "It was an unfortunate slip of the tongue, and he did not intend it that way."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "135805da-4de9-42bc-9f76-ba2d4fce51f3",
                        "source_entry_id": "238380c6-8da5-38f8-8681-41b4940a88cd",
                        "source_sense_id": "d1c97486-a85a-3444-89b8-057cbcd5cbf9",
                        "target_lang_word": "incartade",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "incartade",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a8ea73ae-6776-3c92-af6f-0212143c5e2f",
                                        "entry_id": "3f3d2e5d-dee1-376f-889f-0de7bea25419",
                                        "glosses": [
                                            "Extravagance, folie que fait une personne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83cb21e3-2c9b-4823-a988-40ecc4e3365d",
                                                "sense_id": "a8ea73ae-6776-3c92-af6f-0212143c5e2f",
                                                "text": "Il a fait mille incartades."
                                            },
                                            {
                                                "example_id": "caa4b1f5-a3ce-4cae-960d-73370a3c5231",
                                                "sense_id": "a8ea73ae-6776-3c92-af6f-0212143c5e2f",
                                                "text": "Il fait chaque jour de nouvelles incartades."
                                            },
                                            {
                                                "example_id": "df259c2e-9077-44da-9a8b-536b8f500129",
                                                "sense_id": "a8ea73ae-6776-3c92-af6f-0212143c5e2f",
                                                "text": "Je ne m’attendais pas à cette nouvelle incartade."
                                            },
                                            {
                                                "example_id": "076f1da1-a13f-4cdc-9c64-1e743eb9af38",
                                                "sense_id": "a8ea73ae-6776-3c92-af6f-0212143c5e2f",
                                                "text": "Aux devoirs oubliés, aux leçons mal sues, aux incartades vulgaires, le pensum suffisait ; mais l’amour-propre offensé parlait chez le maître par sa férule."
                                            },
                                            {
                                                "example_id": "be6cbaa7-f4ac-4fac-a123-314c07063f80",
                                                "sense_id": "a8ea73ae-6776-3c92-af6f-0212143c5e2f",
                                                "text": "– Le général Irénéïef est le plus aimable des compagnons, et je vous donne ma parole que ces petites incartades ne sont rien à côté de la joie que j'éprouve, grâce à vous, à ne plus être seul ici."
                                            },
                                            {
                                                "example_id": "1ebaf838-8846-438f-98fb-833e8ee4c95c",
                                                "sense_id": "a8ea73ae-6776-3c92-af6f-0212143c5e2f",
                                                "text": "Exaspéré, il chercha des prétextes de voyage, et partit plusieurs fois, pendant un jour ou deux, pour une ville éloignée. Comme ces notaires libertins qui prennent le train pour cacher leurs incartades dans de mauvais lieux étrangers, le vétérinaire roulait cent kilomètres pour entrer dans un confessionnal."
                                            },
                                            {
                                                "example_id": "28f9737f-abb0-4fa5-8064-657f40ba182e",
                                                "sense_id": "a8ea73ae-6776-3c92-af6f-0212143c5e2f",
                                                "text": "C’était un nomme d’une exigeante nature. Il lui arrivait de se montrer sévère pour réprimer nos incartades ; plus tard, j’ai compris qu’il forçait sa véritable nature."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e062e67-2813-3fb8-b0ad-467db38aaaae",
                                        "entry_id": "3f3d2e5d-dee1-376f-889f-0de7bea25419",
                                        "glosses": [
                                            "Brusque sortie verbale, inconsidérée et blessante."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6fd0ce3-8333-498c-9b2b-18ba5a0aaada",
                                                "sense_id": "4e062e67-2813-3fb8-b0ad-467db38aaaae",
                                                "text": "Il lui a fait une incartade fort mal à propos."
                                            },
                                            {
                                                "example_id": "4a5e2c4b-f82d-41ac-b700-53825719bd5b",
                                                "sense_id": "4e062e67-2813-3fb8-b0ad-467db38aaaae",
                                                "text": "Tout le peuple écoutait et regardait. Voilà deux jours que son éminence s'évertuait à lécher ces ours flamands pour les rendre un peu plus présentables en public, et l'incartade était rude."
                                            },
                                            {
                                                "example_id": "e2c1e9e5-5e0e-4424-89f0-2ea7d8cc64ce",
                                                "sense_id": "4e062e67-2813-3fb8-b0ad-467db38aaaae",
                                                "text": "D’abord réprimandée, puis suspendue pour cette « impardonnable incartade », Madame Mesley décida de prendre sa retraite l’année suivante."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d48f0305-0bb8-489e-831e-5b6aee9a0e1c",
                        "source_entry_id": "238380c6-8da5-38f8-8681-41b4940a88cd",
