                    }
                ],
                "senses": [
                    {
                        "sense_id": "540ed8f3-a288-3489-8435-58dd34568a9f",
                        "entry_id": "60d4b607-85b1-3946-b4db-9efc4ae51bf1",
                        "glosses": [
                            "разг. подозвать, привлекая чем-нибудь"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "90966ac6-1b43-4e9f-af67-bc80c27d5370",
                        "source_entry_id": "60d4b607-85b1-3946-b4db-9efc4ae51bf1",
                        "source_sense_id": "540ed8f3-a288-3489-8435-58dd34568a9f",
                        "target_lang_word": "attirer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "attirer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a3105c0c-f877-3b7e-8d4a-1bf18a01d111",
                                        "entry_id": "18ff7a32-05f4-3b0f-8b25-ba2d9336b3cf",
                                        "glosses": [
                                            "Tirer à soi, faire venir à soi."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1bfdf767-7dff-46d2-994c-065ef7d64eb6",
                                                "sense_id": "a3105c0c-f877-3b7e-8d4a-1bf18a01d111",
                                                "text": "L’aimant a la vertu d’attirer le fer."
                                            },
                                            {
                                                "example_id": "a2f3dbbb-a696-4365-b2a5-70ce72af8111",
                                                "sense_id": "a3105c0c-f877-3b7e-8d4a-1bf18a01d111",
                                                "text": "L’ambre frotté attire les corps légers non métalliques."
                                            },
                                            {
                                                "example_id": "e0d3767f-b472-490d-93e0-b995b9f7b5e7",
                                                "sense_id": "a3105c0c-f877-3b7e-8d4a-1bf18a01d111",
                                                "text": "Des corps, des particules matérielles qui s’attirent mutuellement."
                                            },
                                            {
                                                "example_id": "09335295-0cc5-4636-86c9-38c5d0117d77",
                                                "sense_id": "a3105c0c-f877-3b7e-8d4a-1bf18a01d111",
                                                "text": "Par mesure de précaution recommandée par l'Administration pour attirer l'attention et éviter des erreurs, la plupart dés raticides scillitiques spécialisés sont conditionnés en vert ou en rouge et portent la mention : « Dangereux »."
                                            },
                                            {
                                                "example_id": "5d3d4072-0b9e-4b57-bc72-587d082fca1c",
                                                "sense_id": "a3105c0c-f877-3b7e-8d4a-1bf18a01d111",
                                                "text": "Seuls, les tripots attiraient encore les joueurs en proie à leur sèche passion."
                                            },
                                            {
                                                "example_id": "d8e07a3a-5755-4aec-97dc-787afad6eed0",
                                                "sense_id": "a3105c0c-f877-3b7e-8d4a-1bf18a01d111",
                                                "text": "De W. était jeune ; il était attiré par les cadavres, comme l'homme de Platon. J'avais et j’eus toujours la sagesse de ne pas regarder ces choses de près."
                                            },
                                            {
                                                "example_id": "131e1e5c-380a-44ab-9e2d-a967c150b656",
                                                "sense_id": "a3105c0c-f877-3b7e-8d4a-1bf18a01d111",
                                                "text": "Soyez radin. La prodigalité attire de nombreux amis sur le court terme mais, plus tard, personne ne vous en remerciera jamais."
                                            },
                                            {
                                                "example_id": "25d943ff-2d03-41e8-bc3a-2eedc56d2155",
                                                "sense_id": "a3105c0c-f877-3b7e-8d4a-1bf18a01d111",
                                                "text": "Au tournant d’une place, […], deux personnes, qui marchent conjointement, attirent, je ne sais pourquoi, mon attention. C’est un couple en costume de voyage."
                                            },
                                            {
                                                "example_id": "ecb6af8b-1f49-4275-b023-e242f3ab5f7c",
                                                "sense_id": "a3105c0c-f877-3b7e-8d4a-1bf18a01d111",
                                                "text": "Mon attention a été attirée par un pantalon de velours côtelé, assez usagé,et qui séchait sur un fil de fer à proximité de la porte de la cuisine, ou plus précisément en face de cette porte."
                                            },
                                            {
                                                "example_id": "c6f000c7-8870-40a5-8b94-d0b54d7c9b4d",
                                                "sense_id": "a3105c0c-f877-3b7e-8d4a-1bf18a01d111",
                                                "text": "Au moment de repartir, notre attention est attirée par une nuée de corbeaux s'agitant au-dessus d'un groupe d’êtres humains."
                                            },
                                            {
                                                "example_id": "731bae98-7488-4113-8910-9a934d4b77d7",
                                                "sense_id": "a3105c0c-f877-3b7e-8d4a-1bf18a01d111",
                                                "text": "Il préférait la musique classique et les chemisettes à carreaux mais, pour attirer les concupiscences, il devait avoir la tenue wesh-wesh, l'allure racaille, la casquette Nike, visière retournée en prime."
                                            },
                                            {
                                                "example_id": "a0d7964b-5792-4fa1-95c0-f0eba2cb958a",
                                                "sense_id": "a3105c0c-f877-3b7e-8d4a-1bf18a01d111",
                                                "text": "Le couple fit construire une maison à la sortie de la petite route périlleuse qui mène à Rosas et y ajouta un mini-golf pour attirer les touristes ainsi qu'une guinguette de plage."
                                            },
                                            {
                                                "example_id": "f28a68b4-1980-4d41-ac0b-04aba6e82f75",
                                                "sense_id": "a3105c0c-f877-3b7e-8d4a-1bf18a01d111",
                                                "text": "Les toxicos t’attirent que des emmerdes. Surtout les PD. Ces chbebs qui t’appellent trois fois par jour, ils s’injectent la coke avec des seringues."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90fa53d6-2d80-3cdf-aa2e-8fe83f21e680",
                                        "entry_id": "18ff7a32-05f4-3b0f-8b25-ba2d9336b3cf",
                                        "glosses": [
                                            "Tirer vers soi, faire venir à soi."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4bd5ab22-3e98-4f78-b14c-3ce18f4eecd3",
                                                "sense_id": "90fa53d6-2d80-3cdf-aa2e-8fe83f21e680",
                                                "text": "Raschi, en se cantonnant dans son rôle de commentateur, s'est attiré, lui, la reconnaissance de tous."
                                            },
                                            {
                                                "example_id": "768d3984-6f7e-465a-bb9c-1007cb5cab10",
                                                "sense_id": "90fa53d6-2d80-3cdf-aa2e-8fe83f21e680",
                                                "text": "S’attirer de méchantes affaires."
                                            },
                                            {
                                                "example_id": "7f72a529-9c22-4b0f-b15d-511f29cdfa74",
                                                "sense_id": "90fa53d6-2d80-3cdf-aa2e-8fe83f21e680",
                                                "text": "S’attirer une querelle."
                                            },
                                            {
                                                "example_id": "efcbcc14-c512-4fbe-9ef2-882b72bf2725",
                                                "sense_id": "90fa53d6-2d80-3cdf-aa2e-8fe83f21e680",
                                                "text": "S’attirer une réprimande."
                                            },
                                            {
                                                "example_id": "b27c12fc-0fa7-4b5d-bd6b-a5642513952e",
                                                "sense_id": "90fa53d6-2d80-3cdf-aa2e-8fe83f21e680",
                                                "text": "Par son extrême sévérité, il s’est attiré beaucoup d’ennemis."
                                            },
                                            {
                                                "example_id": "85748770-fec3-4f9c-82d0-0355ee1c6743",
                                                "sense_id": "90fa53d6-2d80-3cdf-aa2e-8fe83f21e680",
                                                "text": "S’attirer un refus."
                                            },
                                            {
                                                "example_id": "d1a53e9c-e43d-433b-9eb0-cad04a512a00",
                                                "sense_id": "90fa53d6-2d80-3cdf-aa2e-8fe83f21e680",
                                                "text": "S’attirer l’affection, l’estime, l’approbation, le mépris de tout le monde."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "13463522-b919-4b57-ab1d-0d1b4d1cab1e",
                        "source_entry_id": "60d4b607-85b1-3946-b4db-9efc4ae51bf1",
                        "source_sense_id": "540ed8f3-a288-3489-8435-58dd34568a9f",
                        "target_lang_word": "appâter",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "appâter",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bff62cf9-61dd-3b1e-b301-24698b8f1e03",
                                        "entry_id": "03c39b9c-dbf4-3af2-bf1d-ee396cc04bae",
                                        "glosses": [
                                            "Attirer avec un appât."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1fe2048-4429-4244-89cb-b2ee6cb9c135",
                                                "sense_id": "bff62cf9-61dd-3b1e-b301-24698b8f1e03",
                                                "text": "Appâter les oiseaux, les poissons."
                                            },
                                            {
                                                "example_id": "6e89346f-8a1a-44ce-96d7-7263920cd538",
                                                "sense_id": "bff62cf9-61dd-3b1e-b301-24698b8f1e03",
                                                "text": "Au Ghana, les fruits charnus sont utilisés pour appâter les oiseaux dans des pièges."
                                            },
                                            {
                                                "example_id": "b9a8c17d-feda-4409-954a-39be15e114be",
                                                "sense_id": "bff62cf9-61dd-3b1e-b301-24698b8f1e03",
                                                "text": "Il a décidé que nous allions appâter l’ours, qui faisait bien cinq cents livres, et l’attirer dans une combe où nous jouions souvent et qui se trouve dans la forêt."
                                            },
                                            {
                                                "example_id": "74f7afec-5c77-4f91-87a4-1acef1a56c93",
                                                "sense_id": "bff62cf9-61dd-3b1e-b301-24698b8f1e03",
                                                "text": "Je me refuse à m’associer à cette bande de tire-blanchaille qui appâtent avec de véritables drogues et ne songent qu’à ramener, sans aucun discernement, le plus gros paquet de poissons possible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6a6f85e-5909-35b1-84ac-c0548fb9ceba",
                                        "entry_id": "03c39b9c-dbf4-3af2-bf1d-ee396cc04bae",
                                        "glosses": [
                                            "Mettre la pâture dans le bec des petits oiseaux."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c9a4587a-1611-3163-94df-1efe8939f7b9",
                                        "entry_id": "03c39b9c-dbf4-3af2-bf1d-ee396cc04bae",
                                        "glosses": [
                                            "ou Définition manquante ou à compléter. (Ajouter)…"
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively",
                                            "ironic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4182e46-50eb-421d-95a4-d13f08211ab8",
                                                "sense_id": "c9a4587a-1611-3163-94df-1efe8939f7b9",
                                                "text": "C’est Corinne Bouygues, la sœur de Martin, qui organise à ses côtés ces mirifiques voyages où, pour appâter les annonceurs, la chaîne offre, par exemple, d’inoubliables concerts au pied d’une dune marocaine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
