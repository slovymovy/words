        "fr-extract.jsonl": [
            {
                "entry_id": "88f71928-d11d-3f91-be18-9ed7dd4d24d4",
                "word": "tribut",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "592b84d6-9a7a-4f08-b1c6-183a19b56f14",
                        "entry_id": "88f71928-d11d-3f91-be18-9ed7dd4d24d4",
                        "tags": [
                            "plural"
                        ],
                        "form": "tributs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d2743473-1fec-36d4-99c5-ebd70ac76343",
                        "entry_id": "88f71928-d11d-3f91-be18-9ed7dd4d24d4",
                        "glosses": [
                            "Contribution périodique qu’un État impose à un peuple vaincu comme signe de la dépendance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c66f4e70-7d15-40c7-ba6b-0186ef609230",
                                "sense_id": "d2743473-1fec-36d4-99c5-ebd70ac76343",
                                "text": "Il me nomma même trésorier des tributs que l'Arabie Pétrée payait au roi des rois."
                            },
                            {
                                "example_id": "1b7b5f6a-be79-44fa-b873-0fa095916ee7",
                                "sense_id": "d2743473-1fec-36d4-99c5-ebd70ac76343",
                                "text": "À l’apogée de l'empire maritime athénien, un millier de cités lui versaient un tribut."
                            }
                        ]
                    },
                    {
                        "sense_id": "376492d1-d62e-3293-b0e6-b8622aef985b",
                        "entry_id": "88f71928-d11d-3f91-be18-9ed7dd4d24d4",
                        "glosses": [
                            "Ce qu’on est obligé d’accorder, de faire, de supporter."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "909aeefd-1a6d-4902-8a53-952a58cfcbcd",
                                "sense_id": "376492d1-d62e-3293-b0e6-b8622aef985b",
                                "text": "Don Juan — […] je conserve des yeux pour voir le mérite de toutes, et rends à chacune les hommages, et les tributs où la nature nous oblige"
                            },
                            {
                                "example_id": "4c627652-2780-4816-a503-c9b85847a1b5",
                                "sense_id": "376492d1-d62e-3293-b0e6-b8622aef985b",
                                "text": "Depuis lors, les événements sont venus malheureusement confirmer ces prévisions pessimistes, toutes les régions ayant payé un tribut plus ou moins élevé aux maladies cryptogamiques, particulièrement au rot brun et au black-rot."
                            },
                            {
                                "example_id": "99087f6d-7267-49dc-a596-f1645299ff6c",
                                "sense_id": "376492d1-d62e-3293-b0e6-b8622aef985b",
                                "text": "Pas de chance pour lui, voudrait-on dire. Car ce sont bien les femmes qui ont payé le plus lourd tribut."
                            },
                            {
                                "example_id": "c1d1bc33-3bdd-4610-9840-26c5e38178f5",
                                "sense_id": "376492d1-d62e-3293-b0e6-b8622aef985b",
                                "text": "L’estime, le respect est un tribut qu’on doit à la vertu, au mérite."
                            },
                            {
                                "example_id": "1052b6ca-7c81-48ad-984d-5a1bf6e07bcc",
                                "sense_id": "376492d1-d62e-3293-b0e6-b8622aef985b",
                                "text": "Payer un juste tribut d’éloges."
                            },
                            {
                                "example_id": "662ab72b-843f-47f6-9d38-d15b398a7159",
                                "sense_id": "376492d1-d62e-3293-b0e6-b8622aef985b",
                                "text": "Un tribut d’estime et de reconnaissance."
                            },
                            {
                                "example_id": "b133c541-6f45-4671-9eb5-77b1e93bdcc7",
                                "sense_id": "376492d1-d62e-3293-b0e6-b8622aef985b",
                                "text": "Offrir en tribut ses premiers ouvrages."
                            }
                        ]
                    },
                    {
                        "sense_id": "f3f39111-caf1-3121-8871-520212027f49",
                        "entry_id": "88f71928-d11d-3f91-be18-9ed7dd4d24d4",
                        "glosses": [
                            "Ce qui est apporté."
                        ],
                        "tags": [
                            "figuratively",
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "395bcf4c-7a7c-46d1-aa68-7f1d94d4c0fe",
                                "sense_id": "f3f39111-caf1-3121-8871-520212027f49",
                                "text": "Les fleuves portent à la mer le tribut de leurs ondes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bad75f47-8f27-4960-b0e0-5e866018c386",
                        "source_entry_id": "88f71928-d11d-3f91-be18-9ed7dd4d24d4",
                        "target_lang_word": "cost",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cost",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "24ad0534-9ef3-3b85-baf5-e7d03f137a1b",
                                        "entry_id": "2a5c26bf-52d4-3a0f-938e-fd95d1f8daa3",
                                        "glosses": [
                                            "To incur a charge of; to require payment of a (specified) price."
                                        ],
                                        "tags": [
                                            "ditransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d08b9338-05f7-4375-8f23-74159ba84fde",
                                                "sense_id": "24ad0534-9ef3-3b85-baf5-e7d03f137a1b",
                                                "text": "This shirt cost $50, while this was cheaper at only $30."
                                            },
                                            {
                                                "example_id": "564a323a-4391-486d-bb0c-a75c5cfc8a34",
                                                "sense_id": "24ad0534-9ef3-3b85-baf5-e7d03f137a1b",
                                                "text": "It will cost you a lot of money to take a trip around the world."
                                            },
                                            {
                                                "example_id": "346bcdc3-6d94-497a-bc04-05bb1aacb7b9",
                                                "sense_id": "24ad0534-9ef3-3b85-baf5-e7d03f137a1b",
                                                "text": "Thus the red damask curtains which now shut out the fog-laden, drizzling atmosphere of the Marylebone Road, had cost a mere song, and yet they might have been warranted to last another thirty years. A great bargain also had been the excellent Axminster carpet which covered the floor;[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1847e61a-edb6-389c-8e74-a9212a9738de",
                                        "entry_id": "2a5c26bf-52d4-3a0f-938e-fd95d1f8daa3",
                                        "glosses": [
                                            "To cause something to be lost; to cause the expenditure or relinquishment of."
                                        ],
                                        "tags": [
                                            "ditransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04415836-a6df-4c75-a8c2-9d08d3bcd725",
                                                "sense_id": "1847e61a-edb6-389c-8e74-a9212a9738de",
                                                "text": "Trying to rescue the man from the burning building cost them their lives."
                                            },
                                            {
                                                "example_id": "a4d17be4-0696-47fe-ac31-f3210913f418",
                                                "sense_id": "1847e61a-edb6-389c-8e74-a9212a9738de",
                                                "text": "the packaging of home-delivered products now accounts for 30% of the solid rubbish the US generates annually, and the cardboard alone costs 1bn trees."
                                            },
                                            {
                                                "example_id": "af34d7b3-1b59-4fc7-a3dd-df284a739c1b",
                                                "sense_id": "1847e61a-edb6-389c-8e74-a9212a9738de",
                                                "text": "though it cost me ten nights' watchings"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e65837d6-2d69-35ee-9c43-ff0539ef616e",
                                        "entry_id": "2a5c26bf-52d4-3a0f-938e-fd95d1f8daa3",
                                        "glosses": [
                                            "To require to be borne or suffered; to cause."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6ae16be-7296-4d14-8abd-364f56ffa5b1",
                                                "sense_id": "e65837d6-2d69-35ee-9c43-ff0539ef616e",
                                                "text": "to do him wanton rites, which cost them woe"
                                            },
                                            {
                                                "example_id": "c989120c-eb51-4ef1-ae78-236386f23c99",
                                                "sense_id": "e65837d6-2d69-35ee-9c43-ff0539ef616e",
                                                "text": "LUKE: \"That little droid is going to cost me a lot of trouble.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2acc98c8-eeee-368c-a16e-72cfbccee274",
                                        "entry_id": "2a5c26bf-52d4-3a0f-938e-fd95d1f8daa3",
                                        "glosses": [
                                            "To calculate or estimate a price."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e80ca95-cdcd-4f65-a420-5885aef15911",
                                                "sense_id": "2acc98c8-eeee-368c-a16e-72cfbccee274",
                                                "text": "I'd cost the repair work at a few thousand."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b71c0bb3-169e-373d-8084-18d50b6cc650",
                                        "entry_id": "2a5c26bf-52d4-3a0f-938e-fd95d1f8daa3",
                                        "glosses": [
                                            "To cost (a person) a great deal of money or suffering."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4496b768-c2ec-4b5d-91a4-c0161f7757d8",
                                                "sense_id": "b71c0bb3-169e-373d-8084-18d50b6cc650",
                                                "text": "I can give you the names, but it'll cost you."
                                            },
                                            {
                                                "example_id": "1d5de192-f031-430a-a0b8-2d729a5bdbf4",
                                                "sense_id": "b71c0bb3-169e-373d-8084-18d50b6cc650",
                                                "text": "That's going to cost you!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cost",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1a861073-6ded-3a5f-bb82-2bd34666a548",
                                        "entry_id": "576ddeb8-00fe-35d3-b65a-1b525cc74474",
                                        "glosses": [
                                            "Amount of money, time, etc. that is required or used."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62481592-2da1-47ab-b3e0-03f153698c17",
                                                "sense_id": "1a861073-6ded-3a5f-bb82-2bd34666a548",
                                                "text": "The total cost of the new complex was an estimated $1.5 million."
                                            },
                                            {
                                                "example_id": "6e53e887-507a-4ebc-b2a7-579db3080e0c",
                                                "sense_id": "1a861073-6ded-3a5f-bb82-2bd34666a548",
                                                "text": "We have to cut costs if we want to avoid bankruptcy."
                                            },
                                            {
                                                "example_id": "c360b610-d118-443d-806e-f96fbb3713d9",
                                                "sense_id": "1a861073-6ded-3a5f-bb82-2bd34666a548",
                                                "text": "The average cost of a new house is twice as much as it was 20 years ago."
                                            },
                                            {
                                                "example_id": "6e212b15-718b-46bf-92a3-ee13843b89f9",
                                                "sense_id": "1a861073-6ded-3a5f-bb82-2bd34666a548",
                                                "text": "According to this saga of intellectual-property misanthropy, these creatures [patent trolls] roam the business world, buying up patents and then using them to demand extravagant payouts from companies they accuse of infringing them. Often, their victims pay up rather than face the costs of a legal battle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e30ec55-abb1-3f5f-8fca-32cd28ce8878",
                                        "entry_id": "576ddeb8-00fe-35d3-b65a-1b525cc74474",
                                        "glosses": [
                                            "A negative consequence or loss that occurs or is required to occur."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1af738e9-7014-4c8f-814e-c42ba8e5b918",
                                                "sense_id": "6e30ec55-abb1-3f5f-8fca-32cd28ce8878",
                                                "text": "Spending all your time working may earn you a lot of money at the cost of your health."
                                            },
                                            {
                                                "example_id": "380f1a3a-aedd-4267-b654-74c5329c5edb",
                                                "sense_id": "6e30ec55-abb1-3f5f-8fca-32cd28ce8878",
                                                "text": "The army won the battle decisively, but at a cost of many lives."
                                            },
                                            {
                                                "example_id": "7e2a3023-2e2a-4f0d-ae51-6c3935c47d76",
                                                "sense_id": "6e30ec55-abb1-3f5f-8fca-32cd28ce8878",
                                                "text": "We simply do not have the option to return to a lower economic level, at least not a rational option. Peer polity competition drives increased complexity and resource consumption regardless of costs, human or ecological."
                                            }
                                        ]
                                    }
                                ]
                            },
