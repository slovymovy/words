                "senses": [
                    {
                        "sense_id": "e245a94e-15e0-3cfd-ae3d-5fe2befdb3b6",
                        "entry_id": "0b0316b9-e194-3fbb-b524-8eca6d6d79ce",
                        "glosses": [
                            "gelblich bis grün schimmernder, nicht löslicher Feststoff"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f02a9cd-53e9-4dd4-b1bc-a2f66fec92a6",
                                "sense_id": "e245a94e-15e0-3cfd-ae3d-5fe2befdb3b6",
                                "text": "Luminol wird unter anderem von der Spurensicherung der Polizei verwendet, um Blutreste nachzuweisen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fb077ddc-9206-4259-bd89-9befd4e19163",
                        "source_entry_id": "0b0316b9-e194-3fbb-b524-8eca6d6d79ce",
                        "source_sense_id": "e245a94e-15e0-3cfd-ae3d-5fe2befdb3b6",
                        "source_sense_description": "Chemie: gelblich bis grün schimmernder, nicht löslicher Feststoff",
                        "target_lang_word": "luminol",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "luminol",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0bcf3ecf-5f5e-3001-bc16-3039c5009c82",
                                        "entry_id": "44ef242d-c541-3802-b40c-4f6c1df609df",
                                        "glosses": [
                                            "The compound 5-amino-2,3-dihydro-1,4-phthalazinedione, which exhibits blue chemiluminescence when mixed with an appropriate oxidizing agent."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "395d2337-385a-4ee2-9488-f297632e4b9c",
                                                "sense_id": "0bcf3ecf-5f5e-3001-bc16-3039c5009c82",
                                                "text": "The board was fully supportive, Mr. McDevitt said, even when Mr. Wheeler needed to buy a gallon of cow’s blood and a supply of luminol, a blood-detection chemical."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "luminol",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "66a9096d-f785-3c02-8407-5c8bd7698495",
                                        "entry_id": "adf7c85b-6b4f-30a9-b0bf-9e442f3a2507",
                                        "glosses": [
                                            "To test or subject a sample or an individual to a luminol agent in order to locate traces of blood."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d8fbc8c-3bab-4c18-b451-e05a6fa13fdc",
                                                "sense_id": "66a9096d-f785-3c02-8407-5c8bd7698495",
                                                "text": "Luminoling of material can establish unequivocally that no blood is present."
                                            },
                                            {
                                                "example_id": "6d5d826d-f58d-4caf-bc71-e9d99136c5c7",
                                                "sense_id": "66a9096d-f785-3c02-8407-5c8bd7698495",
                                                "text": "For two nights Patterson, Frosch, and Nabors Luminoled the house, checking and re-checking the evidence they found."
                                            },
                                            {
                                                "example_id": "b88d8f81-a8e9-473f-bee2-bfe947f1feb6",
                                                "sense_id": "66a9096d-f785-3c02-8407-5c8bd7698495",
                                                "text": "Perhaps the auto warrant had gone through and the vehicle was being raked and combed and vacuumed and luminoled in some forensic garage."
                                            },
                                            {
                                                "example_id": "dacd0978-5958-4be8-8f4a-42a8035be28f",
                                                "sense_id": "66a9096d-f785-3c02-8407-5c8bd7698495",
                                                "text": "The crime scene unit was all over the apartment, photographing, luminoling, vacuuming, plucking with tweezers."
                                            },
                                            {
                                                "example_id": "f009eb96-28ce-491a-984b-f925f91c71a5",
                                                "sense_id": "66a9096d-f785-3c02-8407-5c8bd7698495",
                                                "text": "Lester brings the hard-shelled golf bag in and Grissom luminols the interior of the case. The whole case fluouresces briefly then immediately fades, indicating the insides were bleached."
                                            },
                                            {
                                                "example_id": "200645ae-2e50-45ff-9e7d-9f708ba258c2",
                                                "sense_id": "66a9096d-f785-3c02-8407-5c8bd7698495",
                                                "text": "\"You may not find it,\" McClure said. He answered Walt's puzzled expression by explaining,\" We luminoled her.\" He picked up a tube light from a workstation. \"Get the lights,\" he said."
                                            },
                                            {
                                                "example_id": "c220dceb-2e2f-4157-b3ba-de90ff46b66a",
                                                "sense_id": "66a9096d-f785-3c02-8407-5c8bd7698495",
                                                "text": "He sighs. \"The cops luminoled everyone at the hospital right after they got there. They all came out clean as a whistle.\""
                                            },
                                            {
                                                "example_id": "3cc95799-3460-4f98-b0aa-b73f9a725e48",
                                                "sense_id": "66a9096d-f785-3c02-8407-5c8bd7698495",
                                                "text": "The Dassey garage was never luminoled or checked for forensic evidence of any type; blood found between the Dassey garage and residence was never tested."
                                            },
                                            {
                                                "example_id": "83fad8ba-82b8-4739-bedd-ec0ba7e2af99",
                                                "sense_id": "66a9096d-f785-3c02-8407-5c8bd7698495",
                                                "text": "The State Police come in later and find this stuff, but you know where they don't find any blood is in Omar Evans's office. They luminoled that whole place, and nothing."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d0d5667d-8f2a-400e-9c1b-de9bc5c5d15a",
                        "source_entry_id": "0b0316b9-e194-3fbb-b524-8eca6d6d79ce",
                        "source_sense_id": "e245a94e-15e0-3cfd-ae3d-5fe2befdb3b6",
                        "source_sense_description": "Chemie: gelblich bis grün schimmernder, nicht löslicher Feststoff",
                        "target_lang_word": "luminol",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "luminol",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "faf021a7-719a-372f-838c-8b0619b1b101",
                                        "entry_id": "fcb2299f-6819-306c-96df-4c4cd861d022",
                                        "glosses": [
                                            "Produit chimique présentant une chimiluminescence, avec un éclat bleu caractéristique, lorsqu'il est mélangé avec un oxydant adéquat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48214fb1-84aa-46ca-8038-457318d4d353",
                                                "sense_id": "faf021a7-719a-372f-838c-8b0619b1b101",
                                                "text": "Le luminol est utilisé par la police scientifique pour détecter des traces de sang sur les scènes de crime."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
