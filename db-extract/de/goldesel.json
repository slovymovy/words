                "senses": [
                    {
                        "sense_id": "913d7b52-d5bd-3fbf-b807-5995ea9c5c74",
                        "entry_id": "8de795fe-529a-3bd2-99de-f981c65c1e52",
                        "glosses": [
                            "Einkommensquelle, die nie versiegt"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "b12c269f-147f-4a59-83e8-aa49a9e429a0",
                                "sense_id": "913d7b52-d5bd-3fbf-b807-5995ea9c5c74",
                                "text": "„Die Fußball-Bundesliga hat einen zuverlässigen Goldesel entdeckt: das Geschäft mit Fan-Artikeln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "debf5004-3fd3-4003-b91b-ade747c4739d",
                        "source_entry_id": "8de795fe-529a-3bd2-99de-f981c65c1e52",
                        "source_sense_id": "913d7b52-d5bd-3fbf-b807-5995ea9c5c74",
                        "source_sense_description": "Einkommensquelle, die nie versiegt",
                        "target_lang_word": "cash cow",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cash cow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a12d96e8-b9a7-3e0e-839e-091b1d77eaae",
                                        "entry_id": "e124689b-a896-365a-83bf-f44bb7b1577d",
                                        "glosses": [
                                            "A product, service, or enterprise that generates ongoing, high net free cash flows."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c3f2c54-4d8f-4f38-b92a-8a565ad6c2f9",
                                                "sense_id": "a12d96e8-b9a7-3e0e-839e-091b1d77eaae",
                                                "text": "The managers of a cash cow are primarily responsible for the generation of cash, and they should in principle be willing to give cash away to those other businesses in the portfolio which need it most."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13226ce0-ca1d-3380-a0f9-f322969b83a6",
                                        "entry_id": "e124689b-a896-365a-83bf-f44bb7b1577d",
                                        "glosses": [
                                            "Someone or something which is a dependable source of appreciable amounts of money."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9a4dc43-7384-4a30-80d2-6683a3647f34",
                                                "sense_id": "13226ce0-ca1d-3380-a0f9-f322969b83a6",
                                                "text": "Hollinger International, the owner of the Daily and Sunday Telegraph, claimed in the 175-page filing that its former chief executive had treated the company as his \"cash cow\"."
                                            },
                                            {
                                                "example_id": "9696e573-ec15-4111-9bdb-2c41fbb5fad9",
                                                "sense_id": "13226ce0-ca1d-3380-a0f9-f322969b83a6",
                                                "text": "Meanwhile, \"Mr Spears is keen on protecting his cash cow, um, wife. Brit's bodyguards have been teaching Kev how to shoot a handgun,\" the New York Post says."
                                            },
                                            {
                                                "example_id": "21d13795-459f-465b-8f05-b02ef8e885e7",
                                                "sense_id": "13226ce0-ca1d-3380-a0f9-f322969b83a6",
                                                "text": "Many of the League Championship Series’ 10 teams are backed by billionaires who also own traditional U.S. sports teams. But the sport has not yet become a cash cow. To get in on League of Legends, teams had to pay Riot $10 million to $13 million."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
