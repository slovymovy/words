                        "Insta"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "common abbreviation"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращение от Instagram.",
                        "tr": "\"Instagram\" adının gayriresmî kısaltması."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Инста",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "İnsta",
                                "target_lang_sense_clarification": "konuşma dilinde"
                            },
                            {
                                "target_lang_word": "Instagram",
                                "target_lang_sense_clarification": "sosyal medya"
                            }
                        ]
                    }
