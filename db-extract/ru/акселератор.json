                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3065991f-e0db-4a91-b578-8e389dab52cd",
                                                "sense_id": "48991391-9534-37e6-9a7e-e04882703729",
                                                "text": "Plus j’approchais de Paris, plus j’appuyais sur l’accélérateur."
