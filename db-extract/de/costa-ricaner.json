                                        "glosses": [
                                            "Of, from, or pertaining to Costa Rica."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55846ef2-5b71-45a3-8cbe-1caee4b26e01",
                                                "sense_id": "31bd1f61-9d75-31aa-bbe1-00c025eddd4d",
                                                "text": "He has a home in the Costa Rican hills."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0dfd6a9b-3b91-38d6-a9bc-dd43eb58837c",
                                        "entry_id": "0c5cf394-6e25-3626-8053-4b4a3ec7fb6a",
                                        "glosses": [
                                            "Of or pertaining to the people, language, or culture of Costa Rica."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7020236f-8518-4595-9b28-ed80ffd81647",
                                                "sense_id": "0dfd6a9b-3b91-38d6-a9bc-dd43eb58837c",
                                                "text": "His dialect was distinctly Costa Rican."
                                            },
                                            {
                                                "example_id": "6840c9c6-9815-45cc-99c1-5a5bf6c2b3d6",
                                                "sense_id": "0dfd6a9b-3b91-38d6-a9bc-dd43eb58837c",
                                                "text": "Marine archaeologists have discovered that two shipwrecks in Costa Rica are the remains of Danish slave ships missing for centuries — a finding that restores the ancestral lineage of an entire Costa Rican community more than 300 years after the vessels’ occupants reached its shores."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9b8013f8-082d-4842-aa08-009b0218899b",
                        "source_entry_id": "df0bcc4f-b64c-3027-80ba-0395f7a69032",
                        "source_sense_id": "fcea5be9-9829-355f-8d36-3b165d7a9fa3",
