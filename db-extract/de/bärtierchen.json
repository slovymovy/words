                        ],
                        "form": "das Bärtierchen"
                    },
                    {
                        "form_id": "5768b6f9-e947-44ff-9c61-050e1fd1c25c",
                        "entry_id": "ece67725-7356-3e39-afa5-fc37e736d685",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Bärtierchen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9b1446d3-b858-32fd-bb2e-224c296839b6",
                        "entry_id": "ece67725-7356-3e39-afa5-fc37e736d685",
                        "glosses": [
                            "Gliedertiere bis zu einem Millimeter Größe, sie besitzen vier Paar Stummelbeine und leben in Moosen, feuchter Erde oder in Wasser"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f70e52d-da3c-4013-956a-a78d512fbcd9",
                                "sense_id": "9b1446d3-b858-32fd-bb2e-224c296839b6",
                                "text": "„Man sie kochen, man kann sie tiefkühlen - Bärtierchen überleben härteste Umweltbedingungen.“"
                            },
                            {
                                "example_id": "f1f899fc-8fa9-4837-b2ae-2795e1af357b",
                                "sense_id": "9b1446d3-b858-32fd-bb2e-224c296839b6",
                                "text": "„Bärtierchen sind erstaunliche Lebewesen, gleichsam die unkaputtbaren Superhelden der Tierwelt: Kaum größer als ein Sandkorn, haben es die achtbeinigen, tonnenförmigen Kreaturen geschafft, in praktisch allen Biotopen der Erde zu gedeihen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4ae29289-46df-4347-a79b-242639df3736",
                        "source_entry_id": "ece67725-7356-3e39-afa5-fc37e736d685",
                        "source_sense_id": "9b1446d3-b858-32fd-bb2e-224c296839b6",
                        "source_sense_description": "Gliedertiere bis zu einem Millimeter Größe, sie besitzen vier Paar Stummelbeine",
                        "target_lang_word": "tardigrade",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tardigrade",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "685239b2-cdf6-32e5-9e18-1c350d34754b",
                                        "entry_id": "0d4cb4ae-011d-3f9b-93bb-1208d19cf59d",
                                        "glosses": [
                                            "Sluggish; moving slowly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0b9fb25-289e-4411-95ed-fbfbe3e1f6d1",
                                                "sense_id": "685239b2-cdf6-32e5-9e18-1c350d34754b",
                                                "text": "Each tendril ending in a perfect claw, / Obeys the whole routine of Nature's law; / Transforms each sinus to a sylvan shade, / Though p'rhaps its force is rather tardigrade."
                                            },
                                            {
                                                "example_id": "61ac13ad-be77-4430-aa90-3786397d7862",
                                                "sense_id": "685239b2-cdf6-32e5-9e18-1c350d34754b",
                                                "text": "He ran on into the piazza, but he quickly heard the tramp of feet behind him, for the other two prisoners had been released, and the soldiers were struggling and fighting their way after them, in such tardigrade fashion as their hoof-shaped shoes would allow—impeded, but not very resolutely attacked, by the people."
                                            },
                                            {
                                                "example_id": "f13a2aba-7e99-4dbf-b9d7-a4f5de179870",
                                                "sense_id": "685239b2-cdf6-32e5-9e18-1c350d34754b",
                                                "text": "In sorrow, its voice is tardigrade but loud, dragging time at a snail's pace before our eyes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tardigrade",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a67513d1-a155-3e77-a439-63fb794875aa",
                                        "entry_id": "c81ee838-93e6-39a3-b21f-f5b387c0e980",
                                        "glosses": [
                                            "A member of the animal phylum Tardigrada."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5dfd981a-0d07-399f-9d6a-991cb61658a2",
                                        "entry_id": "c81ee838-93e6-39a3-b21f-f5b387c0e980",
                                        "glosses": [
                                            "A sloth, a neotropical mammal of suborder Folivora (syn. Tardigrada)."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c1afb961-2d91-4d0e-be37-35126364af95",
                        "source_entry_id": "ece67725-7356-3e39-afa5-fc37e736d685",
