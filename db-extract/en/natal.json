                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dcfe26b1-376b-4502-bd0c-f06366f0a293",
                                "sense_id": "f789ba32-5856-39a9-9bc9-96f2a98e1590",
                                "text": "Sea turtles return to their natal beaches to nest."
                            },
                            {
                                "example_id": "90dc81c7-31be-4632-910a-8db7df5db8db",
                                "sense_id": "f789ba32-5856-39a9-9bc9-96f2a98e1590",
                                "text": "The constituents of the nation are a land and a people: the \"natal\", which is not necessarily innate, and the \"popular,\" which is not necessarily pregiven."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
