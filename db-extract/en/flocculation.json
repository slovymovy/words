                                    {
                                        "sense_id": "596f5ffc-8b38-3788-b2d7-75c439878251",
                                        "entry_id": "550c8fb2-5bf1-394b-b49c-6d5307a5ce60",
                                        "glosses": [
                                            "Dans une solution liquide, fait pour une partie du composé de former des gros flocons."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f84a5ec-4906-4ebc-975d-c62a7998f603",
                                                "sense_id": "596f5ffc-8b38-3788-b2d7-75c439878251",
                                                "text": "La réaction de floculation peut présenter diverses modalités dans le dosage de l’antitoxine diphtérique ."
                                            },
                                            {
                                                "example_id": "f55e6c10-36a1-4867-9a6b-e85e69253ead",
                                                "sense_id": "596f5ffc-8b38-3788-b2d7-75c439878251",
                                                "text": "Un homme à la voix grave, dont il ne voyait pas le visage, déclara souverainement qu’il y avait des problèmes à la sucrerie, que le chaulage n’avait pas produit une bonne floculation, qu’il savait pourquoi, mais que l’ingénieur d’entretien n’avait pas voulu l’écouter…"
                                            }
                                        ]
                                    }
                                ]
                            }
