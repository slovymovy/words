                    {
                        "form_id": "25afbf30-1945-4fce-bca5-ca936344c1f6",
                        "entry_id": "e30b5afd-ea35-36b6-b22c-c2089279abf1",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "узре́вши"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "50803103-864b-3ab9-be9a-001d4f8a23f6",
                        "entry_id": "e30b5afd-ea35-36b6-b22c-c2089279abf1",
                        "glosses": [
                            "устар. или высок., поэт., то же, что увидеть"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c835c71-d69e-48ae-ba22-abee5f474921",
                                "sense_id": "50803103-864b-3ab9-be9a-001d4f8a23f6",
                                "text": "Мы узрели ясно, что шлюпка наша не на мели находилась, но погрязла между двух больших камней и что не было никаких сил для её избавления оттуда невредимо."
                            },
                            {
                                "example_id": "2d14cb93-3e03-480b-8952-d3490a230cfb",
                                "sense_id": "50803103-864b-3ab9-be9a-001d4f8a23f6",
                                "text": "Ничего такого, с чем нужно было бы сражаться не на живот, а на смерть, чтобы, преодолев преграды и оборов противников, наконец пробиться к драгоценному ларцу и узреть чудо."
                            },
                            {
                                "example_id": "32a8eaea-a894-4f41-be47-76bd2a6142ad",
                                "sense_id": "50803103-864b-3ab9-be9a-001d4f8a23f6",
                                "text": "Пространство церкви — то место, где можно узреть Бога и святых, пережить драму их земного существования."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "703f842e-04ec-4960-bdec-c48e6d830426",
                        "source_entry_id": "e30b5afd-ea35-36b6-b22c-c2089279abf1",
                        "source_sense_id": "50803103-864b-3ab9-be9a-001d4f8a23f6",
                        "target_lang_word": "erblicken",
