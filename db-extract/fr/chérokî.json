                                "example_id": "25ffba12-781e-4f34-97aa-750eae7a4f8a",
                                "sense_id": "df64bc50-7a50-3ce9-80b5-ce7b75fbd3bd",
                                "text": "Il n’y a , dans la langue chérokî, que 85 éléments monosyllabiques, dont la combinaison fournit à l’expression de toutes les pensées ; et sur ce nombre total, 20 sont formés sans l’aide d’aucune consonne."
                            },
                            {
                                "example_id": "b2c487be-8822-4ed7-a772-b5a173b3b511",
                                "sense_id": "df64bc50-7a50-3ce9-80b5-ce7b75fbd3bd",
                                "text": "L’écriture chérokie s’utilise pour écrire la langue chérokie."
                            }
                        ]
                    }
