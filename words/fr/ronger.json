            "senses": [
                {
                    "sense_id": "e52695e4-c78e-3eb4-a74d-8646cbd8caa5",
                    "sense_definition": "Entamer, déchiqueter ou user quelque chose avec les dents à coups répétés.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "action_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chien passe tout son après-midi dans le jardin à <w>ronger</w> un os."
                        },
                        {
                            "text": "Il essaie d'arrêter de se <w>ronger</w> les ongles avant son entretien d'embauche."
                        }
                    ],
                    "synonyms": [
                        "grignoter",
                        "mâchonner"
                    ],
                    "common_phrases": [
