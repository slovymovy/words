                ],
                "translations": [
                    {
                        "translation_id": "bfb4539e-eac4-4ac5-926a-61bad6e8323a",
                        "source_entry_id": "14e143aa-6f4e-3952-a996-ca79bc3ee366",
                        "source_sense_id": "63bf8708-6dda-3100-b5b8-8d9b378ff14f",
                        "target_lang_word": "weak",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "weak",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "34aa34a3-cf83-3220-a514-ff967a87a35a",
                                        "entry_id": "24aaee65-5624-3be2-b34a-f0c945ff9537",
                                        "glosses": [
                                            "Lacking in force (usually strength) or ability."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04bece47-01cd-4aed-b120-cdff40597d2b",
                                                "sense_id": "34aa34a3-cf83-3220-a514-ff967a87a35a",
                                                "text": "The child was too weak to move the boulder."
                                            },
                                            {
                                                "example_id": "a742884f-1a9e-4f50-98c8-912945b5249e",
                                                "sense_id": "34aa34a3-cf83-3220-a514-ff967a87a35a",
                                                "text": "They easily guessed his weak computer password."
                                            },
                                            {
                                                "example_id": "84f718dd-8cd0-46c1-be0d-122ae12c24aa",
                                                "sense_id": "34aa34a3-cf83-3220-a514-ff967a87a35a",
                                                "text": "a poor, infirm, weak, and despised old man"
                                            },
                                            {
                                                "example_id": "1aca73da-14cb-46ea-a990-bf73a1a75200",
                                                "sense_id": "34aa34a3-cf83-3220-a514-ff967a87a35a",
                                                "text": "weak with hunger, mad with love"
                                            },
                                            {
                                                "example_id": "0aa30b3c-feec-42d6-803f-78feef4b20f5",
                                                "sense_id": "34aa34a3-cf83-3220-a514-ff967a87a35a",
                                                "text": "The prospects for the global economy as outlined by the IMF are the third weakest since 2001, behind only the 2008 financial crisis and the worst phase of the coronavirus pandemic. Global growth has fallen below 2% just five times since 1970."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e837e0e1-5433-397b-a96f-e0e7bce8ce0f",
                                        "entry_id": "24aaee65-5624-3be2-b34a-f0c945ff9537",
                                        "glosses": [
                                            "Unable to sustain a great weight, pressure, or strain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0cd38eef-4ef4-4efe-8c9d-323e5a48a031",
                                                "sense_id": "e837e0e1-5433-397b-a96f-e0e7bce8ce0f",
                                                "text": "a weak timber; a weak rope"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8220539-f877-3911-93c8-6674e6eeaeda",
                                        "entry_id": "24aaee65-5624-3be2-b34a-f0c945ff9537",
                                        "glosses": [
                                            "Unable to withstand temptation, urgency, persuasion, etc.; easily impressed, moved, or overcome; accessible; vulnerable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "935f6fae-b6f2-44f2-8f51-5b0e4a2944f4",
                                                "sense_id": "c8220539-f877-3911-93c8-6674e6eeaeda",
                                                "text": "weak resolutions; weak virtue"
                                            },
                                            {
                                                "example_id": "d8d95aeb-2903-4dba-bc3e-a8cca6487985",
                                                "sense_id": "c8220539-f877-3911-93c8-6674e6eeaeda",
                                                "text": "Guard thy heart / On this weak side, where most our nature fails."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db0241d9-44e4-3fa3-a210-0bdd1fcc866c",
                                        "entry_id": "24aaee65-5624-3be2-b34a-f0c945ff9537",
                                        "glosses": [
                                            "Having a strong, irrepressible emotional love for someone or (less often) something; sentimentally affected by such love."
                                        ],
                                        "tags": [
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ccd3a6d9-fbb9-4304-9aac-9630be3d670b",
                                                "sense_id": "db0241d9-44e4-3fa3-a210-0bdd1fcc866c",
                                                "text": "'Cause sugar pie, honey bunch\nYou know that I'm weak for you\nCan't help myself\nI love you and nobody else"
                                            },
                                            {
                                                "example_id": "1faaf166-3201-432d-b1ed-5235d3af0dc9",
                                                "sense_id": "db0241d9-44e4-3fa3-a210-0bdd1fcc866c",
                                                "text": "It’s really good to hear your voice\nSayin' my name, it sounds so sweet\nComin' from the lips of an angel\nHearin' those words, it makes me weak"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f6de119-d03d-3f23-a524-a6fdb2bfe5cf",
                                        "entry_id": "24aaee65-5624-3be2-b34a-f0c945ff9537",
                                        "glosses": [
                                            "Dilute, lacking in taste or potency."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01b7a861-e62b-414d-8e51-0aa5ecf12c2c",
                                                "sense_id": "7f6de119-d03d-3f23-a524-a6fdb2bfe5cf",
                                                "text": "That the young Mr. Churchills liked—but they did not like him coming round of an evening and drinking weak whisky-and-water while he held forth on railway debentures and corporation loans. Mr. Barrett, however, by fawning and flattery, seemed to be able to make not only Mrs. Churchill but everyone else do what he desired."
                                            },
                                            {
                                                "example_id": "13362796-0bd6-49cd-b03f-63217c65aa1e",
                                                "sense_id": "7f6de119-d03d-3f23-a524-a6fdb2bfe5cf",
                                                "text": "We were served stale bread and weak tea."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff82b27e-c2ab-3620-97d9-cefb0a0f4e09",
                                        "entry_id": "24aaee65-5624-3be2-b34a-f0c945ff9537",
                                        "glosses": [
                                            "Displaying a particular kind of inflection, including:",
                                            "Regular in inflection, lacking vowel changes and having a past tense with -d- or -t-."
                                        ],
                                        "tags": [
                                            "of verbs"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0d06a4f8-1fca-3c41-b120-0bb45ad20770",
                                        "entry_id": "24aaee65-5624-3be2-b34a-f0c945ff9537",
                                        "glosses": [
                                            "Displaying a particular kind of inflection, including:",
                                            "Showing less distinct grammatical endings."
                                        ],
                                        "tags": [
                                            "of nouns"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "21b99295-5edc-34f7-a621-c98445ea80d1",
                                        "entry_id": "24aaee65-5624-3be2-b34a-f0c945ff9537",
                                        "glosses": [
                                            "Displaying a particular kind of inflection, including:",
                                            "Definite in meaning, often used with a definite article or similar word."
                                        ],
                                        "tags": [
                                            "of adjectives"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3a2a313d-fd97-3f17-b2a5-e7ef52a1c7cf",
                                        "entry_id": "24aaee65-5624-3be2-b34a-f0c945ff9537",
                                        "glosses": [
                                            "That does not ionize completely into anions and cations in a solution."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e7e2f31-b655-4892-acbf-3f07a86f8b7f",
                                                "sense_id": "3a2a313d-fd97-3f17-b2a5-e7ef52a1c7cf",
                                                "text": "a weak acid"
                                            },
                                            {
                                                "example_id": "bcaae148-ee77-458a-b16f-e163525c3a00",
                                                "sense_id": "3a2a313d-fd97-3f17-b2a5-e7ef52a1c7cf",
                                                "text": "a weak base"
                                            },
                                            {
                                                "example_id": "97945104-f211-4efe-b565-7db7ba92d279",
                                                "sense_id": "3a2a313d-fd97-3f17-b2a5-e7ef52a1c7cf",
                                                "text": "When we say that an acid is weak, we refer only to its degree of dissociation, not to its degree of corrosiveness; but it is true that those two traits often correlate, though."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8252e4af-49e4-36ec-bf04-0196aca126f4",
                                        "entry_id": "24aaee65-5624-3be2-b34a-f0c945ff9537",
                                        "glosses": [
                                            "One of the four fundamental forces associated with nuclear decay."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e08c8181-c0ee-3765-8d99-599e47d4b890",
                                        "entry_id": "24aaee65-5624-3be2-b34a-f0c945ff9537",
                                        "glosses": [
                                            "Bad or uncool."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3402527b-fce4-4dc0-ae06-f60bb088c159",
                                                "sense_id": "e08c8181-c0ee-3765-8d99-599e47d4b890",
                                                "text": "This place is weak."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a43ba3e3-cd46-38f8-bb5a-6cb189f7b636",
                                        "entry_id": "24aaee65-5624-3be2-b34a-f0c945ff9537",
                                        "glosses": [
                                            "Having a narrow range of logical consequences; narrowly applicable. (Often contrasted with a strong statement which implies it.)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "68c9344a-e13d-32ef-903f-2c5692414db8",
                                        "entry_id": "24aaee65-5624-3be2-b34a-f0c945ff9537",
                                        "glosses": [
                                            "Resulting from, or indicating, lack of judgment, discernment, or firmness; unwise; hence, foolish."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53c4465f-c79e-4818-a6c2-98ddc6a33dd9",
                                                "sense_id": "68c9344a-e13d-32ef-903f-2c5692414db8",
                                                "text": "If evil thence ensue, / She first his weak indulgence will accuse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56427d3e-964a-339a-8dd1-2345fc488adb",
                                        "entry_id": "24aaee65-5624-3be2-b34a-f0c945ff9537",
                                        "glosses": [
                                            "Not having power to convince; not supported by force of reason or truth; unsustained."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17b66547-d574-49a1-bf78-71f0eea8760a",
                                                "sense_id": "56427d3e-964a-339a-8dd1-2345fc488adb",
                                                "text": "The prosecution advanced a weak case."
                                            },
                                            {
                                                "example_id": "87871747-7501-4fc8-ae26-793877512a4b",
                                                "sense_id": "56427d3e-964a-339a-8dd1-2345fc488adb",
                                                "text": "convinced of his weak arguing"
                                            },
                                            {
                                                "example_id": "4e198c3b-73c8-411d-90af-ad5a6c6229ce",
                                                "sense_id": "56427d3e-964a-339a-8dd1-2345fc488adb",
                                                "text": "There are two fundamental theorems of calculus. Both relate differentiation to integration. In most calculus courses, the Second Fundamental Theorem is usually proved first and then used to prove the First Fundamental Theorem. Unfortunately, this results in a First Fundamental Theorem that is weaker than it could be."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98bb14a6-da36-398f-a318-796f2978a883",
                                        "entry_id": "24aaee65-5624-3be2-b34a-f0c945ff9537",
                                        "glosses": [
                                            "Lacking in vigour or expression."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "140af351-ff8f-42d9-8676-f1ac97489dfa",
                                                "sense_id": "98bb14a6-da36-398f-a318-796f2978a883",
                                                "text": "a weak sentence; a weak style"
                                            },
                                            {
                                                "example_id": "b4e6338a-06d0-419a-921f-949c5f28fb4e",
                                                "sense_id": "98bb14a6-da36-398f-a318-796f2978a883",
                                                "text": "It could turn out that An Unexpected Journey is the weakest of this trilogy, the necessary preamble before less-stultifying action and more engaging character development ensue. But, to paraphrase the sweet and stout-hearted Bilbo himself, this adventure won’t just make you late for dinner. It might make you miss breakfast and lunch, too. Only the most dedicated Middle-earthers will find that the hunger pangs are worth it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4aab421-4694-3581-8709-b76b4a01f647",
                                        "entry_id": "24aaee65-5624-3be2-b34a-f0c945ff9537",
                                        "glosses": [
                                            "Not prevalent or effective, or not felt to be prevalent; not potent; feeble."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "606f203f-a4ec-457f-86a2-9c1e38660960",
                                                "sense_id": "d4aab421-4694-3581-8709-b76b4a01f647",
                                                "text": "Thy threats have no more strength than her weak prayers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3c8373c-c759-33ce-9a2e-2f06129d993e",
                                        "entry_id": "24aaee65-5624-3be2-b34a-f0c945ff9537",
                                        "glosses": [
                                            "Tending towards lower prices."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25b69f77-053b-4953-bf5d-42a6fc19c1c0",
                                                "sense_id": "d3c8373c-c759-33ce-9a2e-2f06129d993e",
                                                "text": "a weak market; wheat is weak at present"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f4e0cb1-385d-37dc-9ca9-5c31a291b02e",
                                        "entry_id": "24aaee65-5624-3be2-b34a-f0c945ff9537",
                                        "glosses": [
                                            "Lacking contrast."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c0647b6-2f62-4ec1-9850-c580c3f8ceb6",
                                                "sense_id": "3f4e0cb1-385d-37dc-9ca9-5c31a291b02e",
                                                "text": "a weak negative"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6b11a485-ff50-4025-ac47-59603299411b",
                        "source_entry_id": "14e143aa-6f4e-3952-a996-ca79bc3ee366",
                        "source_sense_id": "63bf8708-6dda-3100-b5b8-8d9b378ff14f",
                        "target_lang_word": "feeble",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "feeble",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e571a880-ffd0-3138-9efb-1490a9ea3c0c",
                                        "entry_id": "9ac31ab2-f796-3751-9e05-af340e69df9f",
                                        "glosses": [
                                            "Deficient in physical strength."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ccb12503-4974-48e5-95cd-16f47b96825c",
                                                "sense_id": "e571a880-ffd0-3138-9efb-1490a9ea3c0c",
                                                "text": "Though she appeared old and feeble, she could still throw a ball."
                                            },
                                            {
                                                "example_id": "c962de89-294c-45da-97f0-d604f0696e8a",
                                                "sense_id": "e571a880-ffd0-3138-9efb-1490a9ea3c0c",
                                                "text": "Pent up in Utica he vainly forms\nA poor Epitome of Roman Greatneſs,\nAnd, cover’d with Numidian Guards, directs\nA feeble Army, and an empty Senate,\nRemnants of mighty Battels fought in vain."
                                            },
                                            {
                                                "example_id": "19b992b1-b348-4f7f-bc55-b20dcf4ff068",
                                                "sense_id": "e571a880-ffd0-3138-9efb-1490a9ea3c0c",
                                                "text": "You've had your time\nGonna walk that line\nLike a living travesty,\nEndlessly bound to your sins\nI'll hunt you down in time\nYou're just a feeble swine\nHow can I compromise\nWhen all you do is deny"
                                            },
                                            {
                                                "example_id": "5c515a4f-b4f8-4dca-8feb-0692899e003c",
                                                "sense_id": "e571a880-ffd0-3138-9efb-1490a9ea3c0c",
                                                "text": "France were transformed from the feeble, divided unit that had squeaked past Wales in the semi-final, their half-backs finding the corners with beautifully judged kicks from hand, the forwards making yards with every drive and a reorganised Kiwi line-out beginning to malfunction."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d931d768-1026-350c-80d7-017e8561131d",
                                        "entry_id": "9ac31ab2-f796-3751-9e05-af340e69df9f",
                                        "glosses": [
                                            "Lacking force, vigor, or effectiveness in action or expression; faint."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a08cdd9f-3ebe-4be3-9c6b-bc79b4df3b87",
                                                "sense_id": "d931d768-1026-350c-80d7-017e8561131d",
                                                "text": "That was a feeble excuse for an example."
                                            }
                                        ]
                                    }
                                ]
                            },
