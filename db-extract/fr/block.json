                "senses": [
                    {
                        "sense_id": "848a4636-f4d6-3f7e-8c13-ca2ca4a31326",
                        "entry_id": "890176b2-40a1-3b83-92aa-f84465270056",
                        "glosses": [
                            "(chemins de fer) Signalisation destinée à empêcher les collisions par rattrapage ou nez à nez."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2bf7a2de-c112-432e-89fd-537981fd38ba",
                                "sense_id": "848a4636-f4d6-3f7e-8c13-ca2ca4a31326",
                                "text": "Après avoir expérimenté un système américain, il met au point avec un autre ingénieur de la Compagnie du Midi, M. Ducousso, l'un des premiers blocks automatiques, le block « PD »."
                            }
                        ]
                    },
                    {
                        "sense_id": "0b3c4f57-5801-3616-a96d-22a400c4542f",
                        "entry_id": "890176b2-40a1-3b83-92aa-f84465270056",
                        "glosses": [
                            "Autre orthographe de bloc : mouvement défensif qui a pour objectif d’empêcher le ballon de passer dans son camp tout en le faisant tomber dans le terrain adverse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0645d6c1-2b60-441b-9d4a-20b6b1c9b7ee",
                                "sense_id": "0b3c4f57-5801-3616-a96d-22a400c4542f",
                                "text": "Et que, tactiquement, il y avait peut-être un coup à jouer avec la doublette Benjamin Toniutti — Stephen Boyer en cours de match pour perturber le block défense italien."
                            },
                            {
                                "example_id": "9049855d-f4ae-4dca-991e-d647e1e65996",
                                "sense_id": "0b3c4f57-5801-3616-a96d-22a400c4542f",
                                "text": "Le block, la nouvelle arme de l’équipe de France de volley ?"
                            },
                            {
                                "example_id": "47f02143-0f6e-414b-a6aa-4c2f6a9cf4f1",
                                "sense_id": "0b3c4f57-5801-3616-a96d-22a400c4542f",
                                "text": "En défense, il va constituer le block."
                            }
                        ]
                    }
