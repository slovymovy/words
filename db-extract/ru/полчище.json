                "senses": [
                    {
                        "sense_id": "b0c03ddb-8770-3980-8036-5ef34c428a1d",
                        "entry_id": "c3ea6b92-577e-347e-b224-ba4a37226f6e",
                        "glosses": [
                            "огромное (обычно неприятельское) войско"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bca98db7-763d-4c71-bcca-4ca262865ece",
                                "sense_id": "b0c03ddb-8770-3980-8036-5ef34c428a1d",
                                "text": "Леонид, узрев несметные полчища врага, немедленно послал домой гонца — за подкреплением."
                            }
                        ]
                    },
                    {
                        "sense_id": "672754cf-5d6f-3804-9b99-57241a5d4de2",
                        "entry_id": "c3ea6b92-577e-347e-b224-ba4a37226f6e",
                        "glosses": [
                            "перен., разг. несметное количество, множество кого-, чего-либо"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "16c7b866-79ce-49dd-b707-6925fd3e51df",
                        "source_entry_id": "c3ea6b92-577e-347e-b224-ba4a37226f6e",
                        "target_lang_word": "horde",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "horde",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "97b19d86-c6cd-337d-9a49-fe3aba0c0990",
                                        "entry_id": "10b5709a-1e1c-39b8-bf9f-8c012cf75d4c",
                                        "glosses": [
                                            "A wandering troop or gang; especially, a clan or tribe of a nomadic people (originally Tatars) migrating from place to place for the sake of pasturage, plunder, etc.; a predatory multitude."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b5e5f0fb-bde2-3bd7-a652-427626ed7bf6",
                                        "entry_id": "10b5709a-1e1c-39b8-bf9f-8c012cf75d4c",
                                        "glosses": [
                                            "A large number of people or things."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5eb3ff1-7979-41bf-801c-7178bbec43aa",
                                                "sense_id": "b5e5f0fb-bde2-3bd7-a652-427626ed7bf6",
                                                "text": "We were beset by a horde of street vendors who thought we were tourists and would buy their cheap souvenirs."
                                            },
                                            {
                                                "example_id": "ce61f63c-eae2-4681-9552-414353886755",
                                                "sense_id": "b5e5f0fb-bde2-3bd7-a652-427626ed7bf6",
                                                "text": "It is true, the more progressive members of our horde lived in the caves above the river."
                                            },
                                            {
                                                "example_id": "5b163b67-00cb-4007-a0ee-d093505e1778",
                                                "sense_id": "b5e5f0fb-bde2-3bd7-a652-427626ed7bf6",
                                                "text": "And so Tarzan of the Apes dropped lightly to the turf into the midst of the fierce and hideous horde—he had completed the cycle of evolution, and had returned to be once again a brute among brutes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "horde",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f9c41d91-def3-3c7b-846c-fdd66e348159",
                                        "entry_id": "01c7938c-8567-34a4-804b-6c257b7cc5d3",
                                        "glosses": [
                                            "to travel en masse, to flock"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8b4d138-e3fa-4865-b0ba-58dfca2e6c4b",
                                                "sense_id": "f9c41d91-def3-3c7b-846c-fdd66e348159",
                                                "text": "\"What wouldst thou insinuate?\" replied Elmuton, sarcastically; “has he not been watched, and secretly discovered hordeing with Christians?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
