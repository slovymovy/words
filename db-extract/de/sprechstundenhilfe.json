                    {
                        "sense_id": "3a12ef2f-eb74-35d9-9197-d9b26f62b2bd",
                        "entry_id": "16307eda-9c4e-31f4-aceb-9485ef0349d7",
                        "glosses": [
                            "meist weibliche Person, die für medizinische Hilfsleistungen in einer Arztpraxis angestellt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad69609e-bb42-4759-b3db-6957dd72d5da",
                                "sense_id": "3a12ef2f-eb74-35d9-9197-d9b26f62b2bd",
                                "text": "„Die Sprechstundenhilfe steckte mir einen Zitronenbonbon zu.“"
                            },
                            {
                                "example_id": "153c376e-c0e9-4b56-a12c-e67f86ca07ca",
                                "sense_id": "3a12ef2f-eb74-35d9-9197-d9b26f62b2bd",
                                "text": "„Die Sprechstundenhilfe kam ins Zimmer und fragte, wie mit dem Vietnamesen zu verfahren sei.“"
                            },
                            {
                                "example_id": "4c92a873-88cb-428b-9b07-920b5fcea633",
                                "sense_id": "3a12ef2f-eb74-35d9-9197-d9b26f62b2bd",
                                "text": "„Schließlich kam der Psychologe aus seiner Tür und mein Herz schlug schneller und schneller, und dann bat er meine Tante, kurz unter vier Augen mit ihm zu reden, während eine Sprechstundenhilfe auf mich aufpasste.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
