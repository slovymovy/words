                    {
                        "sense_id": "43249b9f-f5bb-3b9b-bdf7-38fdcc906ef6",
                        "entry_id": "9abbd685-d288-3213-b39c-d96beb989000",
                        "glosses": [
                            "Modifier à l’aide d’un signe diacritique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12ca7277-f5ff-47b7-a084-f26c4efb9a53",
                                "sense_id": "43249b9f-f5bb-3b9b-bdf7-38fdcc906ef6",
                                "text": "L’accent grave s’obtient avec les touches Alt-Gr et 7 enfoncées, plus la lettre capitale à diacriter."
                            },
                            {
                                "example_id": "b7aeecb3-c6d8-471f-8c29-883fcc6723b6",
                                "sense_id": "43249b9f-f5bb-3b9b-bdf7-38fdcc906ef6",
                                "text": "Par ailleurs, une particularité graphique individualise ce type d’écriture : le fāʾ est diacrité par un point, sous la lettre, et le qāf l’est au-dessus, mais par un seul point."
                            }
                        ]
