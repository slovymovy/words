                "senses": [
                    {
                        "sense_id": "cf9d5ff8-9f91-3ead-a807-c928de0176b3",
                        "entry_id": "74223c0c-77c3-38e9-b8da-4e8ccabf8f52",
                        "glosses": [
                            "Étape de la dégradation d'une roche, où elle forme une structure plus ou moins friable, avant son érosion complète."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b951255-bfad-4850-ac36-5180b94aef5d",
                                "sense_id": "cf9d5ff8-9f91-3ead-a807-c928de0176b3",
                                "text": "Une altérite de roche granitique."
                            },
                            {
                                "example_id": "1503e7a3-d1fd-4f67-9c41-3d0746cba218",
                                "sense_id": "cf9d5ff8-9f91-3ead-a807-c928de0176b3",
                                "text": "Les colluvions sont des formations superficielles particulières de versants qui résultent de l’accumulation progressive de matériaux pédologiques, d’altérites ou de roches meubles (ou cohérentes désagrégées) arrachés plus haut dans le paysage."
                            }
                        ]
                    },
                    {
                        "sense_id": "3288e6f6-f4dc-3343-83fb-93105961a312",
                        "entry_id": "74223c0c-77c3-38e9-b8da-4e8ccabf8f52",
                        "glosses": [
                            "Ensemble de matériaux hétérogènes recouvrant une roche solide."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc0aa2cb-8cdc-487d-9430-248ba9d65e2a",
                                "sense_id": "3288e6f6-f4dc-3343-83fb-93105961a312",
                                "text": "Le matériel d’accumulation, en ravinement sur les altérites in situ des roches basiques et ultrabasiques, associe une matrice de sable grossier […]."
                            }
                        ]
                    }
                ],
                "translations": [
