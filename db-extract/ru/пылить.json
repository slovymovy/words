                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "44cae3f4-32d9-42e1-9218-33156500d97e",
                        "source_entry_id": "ce5b6928-71de-3c86-a7b8-9ecda132397a",
                        "target_lang_word": "stauben",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stauben",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f1949716-260d-3d81-91bc-3b29083b4de2",
                                        "entry_id": "b4718559-00b7-3b8b-b09e-730c9a97e92d",
                                        "glosses": [
                                            "Staub aufwirbeln, Staub von sich geben"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3407233f-cf44-442f-b27e-b21c46d4ce1e",
                                                "sense_id": "f1949716-260d-3d81-91bc-3b29083b4de2",
                                                "text": "Hier staubt es aber gewaltig."
                                            },
                                            {
                                                "example_id": "d412ad15-7bde-4c76-992b-7f4b392a4e19",
                                                "sense_id": "f1949716-260d-3d81-91bc-3b29083b4de2",
                                                "text": "Der Pulverschnee staubte unter den Kufen des Skiläufers."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f4a9bff0-43d4-3a26-85d5-13a000e1ed3c",
                                        "entry_id": "b4718559-00b7-3b8b-b09e-730c9a97e92d",
                                        "glosses": [
                                            "mit Mehl eindicken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "714a656e-5174-44c1-a9b1-fa6c2f289b59",
                                                "sense_id": "f4a9bff0-43d4-3a26-85d5-13a000e1ed3c",
                                                "text": "„Dann kann man ein helles Einbrenn mit etwas Zwiebeln machen oder auch mit einigen Kochlöffeln voll Mehl die Suppe stauben, je nach Belieben.“"
                                            },
                                            {
                                                "example_id": "0ae0fa34-97cf-4b3b-99b7-dac12264e21f",
                                                "sense_id": "f4a9bff0-43d4-3a26-85d5-13a000e1ed3c",
                                                "text": "„Sobald das Fleisch weich und der Saft klargeworden ist, mit Mehl stauben.“"
                                            },
                                            {
                                                "example_id": "e1260fd9-f941-48d2-b776-0056bd6d0d68",
                                                "sense_id": "f4a9bff0-43d4-3a26-85d5-13a000e1ed3c",
                                                "text": "„Die Zwiebel in wenig Öl glasig anschwitzen, die Gemüse dazugeben und kurz mitrösten, Tomatenmark beigeben, paprizieren und mit Mehl stauben, mit Weißwein ablöschen und mit Gemüsebrühe auffüllen.“"
                                            },
                                            {
                                                "example_id": "57b56528-d4fa-4a6d-87c6-719b14acefed",
                                                "sense_id": "f4a9bff0-43d4-3a26-85d5-13a000e1ed3c",
                                                "text": "„Anschließend vom Herd nehmen und mit wenig Mehl (nur zum Binden des Sauce) stauben und umrühren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e6a5ca83-a403-4cc5-a8b9-396b3bb6d429",
                        "source_entry_id": "ce5b6928-71de-3c86-a7b8-9ecda132397a",
                        "target_lang_word": "Staub aufwirbeln",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Staub aufwirbeln",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ecfda146-ec0a-3445-b55a-d31810021c79",
                                        "entry_id": "79fe09ec-2695-3e41-a712-65e7ee084934",
                                        "glosses": [
                                            "Aufregung verursachen, Unruhe stiften"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0ead35e-cd18-46d9-aef5-1ee33079db36",
                                                "sense_id": "ecfda146-ec0a-3445-b55a-d31810021c79",
                                                "text": "„Die Diskussion wirbelte schließlich so viel Staub auf, dass Bundeskanzler Gerhard Schröder eingreifen musste.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
