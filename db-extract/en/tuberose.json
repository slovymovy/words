                    {
                        "sense_id": "cc867879-ebf1-350d-b8d8-de12f4e04047",
                        "entry_id": "b672376e-2b03-3ad6-b705-708a1d90c821",
                        "glosses": [
                            "Any plant in genera Polianthes or Manfreda (syns. of Agave), now both in Agave subg. Manfreda."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "e5344cfb-7216-30ca-b949-1700f6587022",
                        "entry_id": "b672376e-2b03-3ad6-b705-708a1d90c821",
                        "glosses": [
                            "Any plant in genera Polianthes or Manfreda (syns. of Agave), now both in Agave subg. Manfreda.",
                            "especially Agave amica (syn. Poliantes tuberosa), that has white flowers and grass-like leaves, used in perfumery."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9fcfbe7-1ca8-4535-9bd2-b0d6868ef8ed",
                                "sense_id": "e5344cfb-7216-30ca-b949-1700f6587022",
                                "text": "Only now Mariam saw a basket on the sill. White tuberoses spilled from its sides."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
