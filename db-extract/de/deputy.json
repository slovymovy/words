                "senses": [
                    {
                        "sense_id": "f5771db5-d77d-3ba8-ae7c-04e14e103dea",
                        "entry_id": "d341da81-ea57-34f7-ab5d-ec7d6ca44a95",
                        "glosses": [
                            "Mitarbeiter des Sheriffs in der US-amerikanischen Polizei-Organisation"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fbedf4be-60fd-4d24-9f8e-1762a502d20e",
                                "sense_id": "f5771db5-d77d-3ba8-ae7c-04e14e103dea",
                                "text": "„Da drüben ist es, Sheriff, sagte der Deputy.“"
                            },
                            {
                                "example_id": "cdc1c7a0-f52e-41b5-9aab-d6976d50cb41",
                                "sense_id": "f5771db5-d77d-3ba8-ae7c-04e14e103dea",
                                "text": "„Ein Deputy spricht gerade mit den erschütterten Fahrern, während ein anderer den Verkehr um die Unfallstelle herumleitet.“"
                            },
                            {
                                "example_id": "c6da3089-644f-4ed0-a4f3-f80e8ac55316",
                                "sense_id": "f5771db5-d77d-3ba8-ae7c-04e14e103dea",
                                "text": "„Er zog es vor, die Gesetzeshüter getrennt von Erick und Adam zu treffen, denn er kannte die Gewohnheiten und das Auftreten der hiesigen Deputys nicht und wollte vermeiden, dass sie mit heulenden Sirenen anrauschten und die harten Cops markierten.“"
                            },
                            {
                                "example_id": "723afe29-6981-467b-b47f-6b3d60244726",
                                "sense_id": "f5771db5-d77d-3ba8-ae7c-04e14e103dea",
                                "text": "„Sein Deputy Luther Peacock saß hinter dem Schreibtisch, als er dort ankam.“"
                            },
                            {
                                "example_id": "8e26636a-327d-4192-9e69-e6b810b024fc",
                                "sense_id": "f5771db5-d77d-3ba8-ae7c-04e14e103dea",
                                "text": "„Das Letzte, was er sah, bevor ihn eine Ohnmacht zu Boden beförderte, war sein pflichtbewusster Deputy, wie er eine Kamera zückte, um die ganze Szene festzuhalten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
