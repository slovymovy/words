                            {
                                "example_id": "7825aa9f-8ed2-4657-ab21-b9f773b5f64f",
                                "sense_id": "448ae337-d4cf-318b-925c-41ea8d1584fc",
                                "text": "Гостю все понравилось, особенно одна молодая инженерша, разведённая хозяйка трехкомнатной квартиры."
                            }
                        ]
                    },
