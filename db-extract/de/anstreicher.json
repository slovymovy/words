                "senses": [
                    {
                        "sense_id": "8c5ff0f6-835f-3ec5-b838-79e593f58148",
                        "entry_id": "1de45129-c31b-3c08-8fb4-dbe863afc386",
                        "glosses": [
                            "jemand, der berufsmäßig Wände verputzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ec7d226-fe98-4a30-8916-9a3c645cca0d",
                                "sense_id": "8c5ff0f6-835f-3ec5-b838-79e593f58148",
                                "text": "„Durch die im Folgenden angeführten Belege ist die fachliche Qualifikation zum Antritt des Handwerks der Maler und Anstreicher (§ 94 Z 47 GewO 1994) als erfüllt anzusehen: […]“"
                            },
                            {
                                "example_id": "0067f5d9-7d2b-43c6-b4c4-08e1c9553874",
                                "sense_id": "8c5ff0f6-835f-3ec5-b838-79e593f58148",
                                "text": "„Nach seiner Ausbildung zum Maler und Anstreicher war er zunächst beim Circus Rebernigg und im Winter bei der Wien-Film im Atelier Rosenhügel als Dekorationsmaler beschäftigt, dann bei der Österreichischer Tele Film.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
