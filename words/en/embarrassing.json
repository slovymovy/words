                {
                    "sense_id": "f1b33e73-07aa-3131-a9ef-6db202fc9b44",
                    "sense_definition": "Causing embarrassment; leading to a feeling of uncomfortable shame or self-consciousness.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was an <w>embarrassing</w> moment when I forgot the teacher's name.",
                            "target_lang_translations": {
                                "ru": "Это был <w>неловкий</w> момент, когда я забыл имя учителя.",
                                "de": "Es war ein <w>peinlicher</w> Moment, als ich den Namen des Lehrers vergaß."
                            }
                        },
                        {
                            "text": "He made an <w>embarrassing</w> mistake during his speech.",
                            "target_lang_translations": {
                                "ru": "Он допустил <w>досадную</w> ошибку во время своей речи.",
                                "de": "Er machte während seiner Rede einen <w>peinlichen</w> Fehler."
                            }
                        }
                    ],
                    "synonyms": [
                        "awkward",
                        "humiliating",
                        "uncomfortable"
                    ],
                    "common_phrases": [
                        "embarrassing moment",
                        "embarrassing situation",
                        "embarrassing question",
                        "embarrassing silence"
                    ],
                    "target_lang_definitions": {
