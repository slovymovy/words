                                        "entry_id": "eef4c633-b953-351a-92eb-9c80e19c5670",
                                        "glosses": [
                                            "The seventeenth book of the New Testament of the Bible, the epistle to Titus."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4a75755c-7821-3aa0-85dd-c2025bafc7d3",
                                        "entry_id": "eef4c633-b953-351a-92eb-9c80e19c5670",
                                        "glosses": [
                                            "An early Christian, the addressee of the aforementioned epistle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6bd12e6-26bb-4183-bccf-3fcc020ef6d1",
                                                "sense_id": "4a75755c-7821-3aa0-85dd-c2025bafc7d3",
                                                "text": "I desired Titus, and with him I sent a brother. Did Titus make a gain of you? walked we not in the same spirit? walked we not in the same steps?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d6799d4-b982-3ef8-8c54-ac8afe2fffd7",
                                        "entry_id": "eef4c633-b953-351a-92eb-9c80e19c5670",
                                        "glosses": [
                                            "Titus Caesar Vespasianus, a Roman Emperor who succeeded Vespasian and preceded Domitian."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b8963b48-d7d7-3548-bdbd-6259a57dd82f",
