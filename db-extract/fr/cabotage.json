                    },
                    {
                        "translation_id": "2a11ee86-c1a5-44fd-ba1c-72063478992b",
                        "source_entry_id": "cac02f52-af5c-32e6-b664-7fbdbf6345e3",
                        "target_lang_word": "cabotage",
