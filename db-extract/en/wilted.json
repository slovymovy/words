                    {
                        "translation_id": "839d79cb-419d-48b1-95f6-a749bd5d7f35",
                        "source_entry_id": "35bd9091-11a1-3452-b9bc-65fc2d07f89d",
                        "source_sense_id": "f3f7d050-67f4-3ca0-b472-9a328ad37c37",
                        "source_sense_description": "(of plants) drooping due to lack of water",
                        "target_lang_word": "welk",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "welk",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7e1388c6-4b83-3d8f-ad89-4039b5cb99e5",
                                        "entry_id": "b6fb04a2-1ac3-39c3-b93e-56e3503cf00b",
                                        "glosses": [
                                            "nicht mehr frisch und daher schlaff oder trocken"
                                        ],
                                        "tags": [
                                            "Pflanzen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af93011b-9e95-44f9-bf72-20f04bd5c69f",
                                                "sense_id": "7e1388c6-4b83-3d8f-ad89-4039b5cb99e5",
                                                "text": "Der Wassermangel lässt [das] Laub [der Bäume] oft erst welk, das heißt saftlos und trocken, werden und schließlich vorzeitig abfallen."
                                            },
                                            {
                                                "example_id": "d2bf59d5-ccae-44bd-adbf-283e5644bffa",
                                                "sense_id": "7e1388c6-4b83-3d8f-ad89-4039b5cb99e5",
                                                "text": "Welk und viel zu klein steht der Mais auf den Feldern Niederösterreichs. […] Österreichs Landwirtschaft leidet unter einer historischen Dürre."
                                            },
                                            {
                                                "example_id": "baa406ce-b359-4c9f-9fa4-d73e0d1f0185",
                                                "sense_id": "7e1388c6-4b83-3d8f-ad89-4039b5cb99e5",
                                                "text": "Viele deutsche Supermarktketten […] werfen Kohlrabi schon dann weg, wenn die Blätter etwas welk sind. Dabei zeigten Umfragen, dass die Konsumenten auch dieses Gemüse kaufen würden, solange es gesund und schmackhaft ist."
                                            },
                                            {
                                                "example_id": "5e077329-d637-4aa0-9890-635ae9413a19",
                                                "sense_id": "7e1388c6-4b83-3d8f-ad89-4039b5cb99e5",
                                                "text": "Er [der Schriftsteller Botho Strauß] ist milder gestimmt mit den Jahren. Bald wird er 60 Jahre alt sein. Die Haut, schreibt er, sei welk, doch innerlich fühle er sich jung."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "27fb8118-eabe-3e9b-a69e-7f3bb1a2ae72",
                                        "entry_id": "b6fb04a2-1ac3-39c3-b93e-56e3503cf00b",
                                        "glosses": [
                                            "erschlafft und faltig"
                                        ],
                                        "tags": [
                                            "Körper"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
