                        "examples": [
                            {
                                "example_id": "c2bdb074-2dc3-46c4-9831-9d384bea10ad",
                                "sense_id": "f7a9b3a7-f033-37b9-afd8-a01a90320f8b",
                                "text": "Il n’y avait pas de soleil, je ne me sentais pas du tout comme dans un rêve, l’hyperconscience plutôt des matinées qui suivent les nuits d’insomnie, tout vous rentre dans les yeux et les oreilles mais les mots manquent."
                            },
                            {
                                "example_id": "9740cb40-bfb2-4e94-87cf-102c116a5de6",
                                "sense_id": "f7a9b3a7-f033-37b9-afd8-a01a90320f8b",
                                "text": "Tu as hyperconscience du mouvement de métronome de ton corps, tu exaspères le balancier, on se retourne sur toi, tu provoques, tu fais des vagues."
                            }
                        ]
                    }
