                {
                    "sense_id": "9d51e582-d4f3-3cf5-b8aa-367f26cfb82e",
                    "sense_definition": "Souffrance morale, affliction vive causée par un deuil, un chagrin ou une déception.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "moral",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a éprouvé une immense <w>douleur</w> lors de la disparition de son ami.",
                            "target_lang_translations": {
                                "en": "She felt immense <w>grief</w> at the loss of her friend.",
                                "ru": "Она испытала невыносимое <w>горе</w>, когда умер её друг.",
                                "nl": "Ze voelde een enorm <w>verdriet</w> toen haar vriend overleed.",
                                "de": "Als ihr Freund starb, empfand sie unermessliche <w>Trauer</w>.",
                                "pl": "Gdy zmarł jej przyjaciel, ogarnął ją ogromny <w>ból</w>.",
                                "it": "Alla scomparsa del suo amico ha provato un immenso <w>dolore</w>.",
                                "cs": "Při smrti svého přítele prožila nesmírnou <w>bolest</w>.",
                                "tr": "Arkadaşını kaybettiğinde içinde büyük bir <w>acı</w> hissetti.",
                                "es": "Sintió un inmenso <w>dolor</w> por la pérdida de su amigo.",
                                "zh": "得知好友去世的消息，她心中涌起无尽的<w>悲痛</w>。"
                            }
                        },
                        {
                            "text": "Ses collègues ont essayé de consoler sa grande <w>douleur</w> après cette épreuve.",
                            "target_lang_translations": {
                                "en": "Her colleagues tried to console her deep <w>anguish</w> after that ordeal.",
                                "ru": "После этого тяжёлого испытания коллеги пытались утешить её глубокую <w>душевную боль</w>.",
                                "nl": "Haar collega's probeerden haar diepe <w>verdriet</w> na die zware beproeving te troosten.",
                                "de": "Nach dieser schweren Prüfung versuchten ihre Kollegen, ihren tiefen <w>Kummer</w> zu lindern.",
                                "pl": "Koledzy z pracy starali się ukoić jej wielki <w>ból</w> po tej ciężkiej próbie.",
                                "it": "Dopo quella prova dura, i suoi colleghi hanno cercato di consolarla per il suo grande <w>dolore</w>.",
                                "cs": "Kolegové se po této těžké zkoušce snažili utišit její velký <w>žal</w>.",
                                "tr": "Bu zor deneyimin ardından iş arkadaşları onun büyük <w>acısını</w> hafifletmeye çalıştı.",
                                "es": "Sus compañeros intentaron consolar su gran <w>pena</w> tras aquella dura prueba.",
                                "zh": "经历这场磨难后，同事们想方设法安慰她内心深处的<w>痛苦</w>。"
                            }
                        }
