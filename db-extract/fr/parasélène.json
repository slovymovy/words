                "senses": [
                    {
                        "sense_id": "9abb0736-2e93-3d67-9dc3-1ef2962358b7",
                        "entry_id": "aacc0a16-0317-3392-b424-0ee1e738587f",
                        "glosses": [
                            "Image de la lune réfractée dans un nuage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9748f871-7863-4cd0-9cec-13ca3821f71f",
                                "sense_id": "9abb0736-2e93-3d67-9dc3-1ef2962358b7",
                                "text": "On voit là des soleils de minuit, des aurores boréales accompagnées d'étranges phénomènes météorologiques, des parhélies, images multiples du soleil ; la lune à son tour s'y montre avec son cortège de parasélènes."
                            },
                            {
                                "example_id": "33163b2a-f2e7-4e18-850c-fe4239f412e0",
                                "sense_id": "9abb0736-2e93-3d67-9dc3-1ef2962358b7",
                                "text": "Mais Jasper Hobson le consola en lui promettant avant peu de belles nuits froides, très propices aux observations astronomiques, des aurores boréales, des halos, des parasélènes et autres phénomènes des contrées polaires, dignes de provoquer son admiration."
                            },
                            {
                                "example_id": "1ff1eff0-0327-4e2b-b539-d60a5e8d3d8d",
                                "sense_id": "9abb0736-2e93-3d67-9dc3-1ef2962358b7",
                                "text": "Il existe un phénomène nocturne identique aux parhélies et qui concerne la lune, cela s'appelle parasélène (archives)."
                            }
                        ]
                    }
                ],
