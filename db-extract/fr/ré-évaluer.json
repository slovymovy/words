                "senses": [
                    {
                        "sense_id": "6a9385f0-cbf2-310e-9214-2376b92790aa",
                        "entry_id": "b47bbf94-0a73-3e3c-9de1-b294a2c08832",
                        "glosses": [
                            "Variante orthographique de réévaluer : évaluer à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "348a9fc3-552a-4fad-b85c-f53e6a059bfb",
                                "sense_id": "6a9385f0-cbf2-310e-9214-2376b92790aa",
                                "text": "Par la suite, elle sera réutilisée pour ré-évaluer les progrès de l’enfant et réajuster le programme éducatif individuel."
                            },
                            {
                                "example_id": "2a0ff3bc-a652-4fcc-83a2-881fdb96767f",
                                "sense_id": "6a9385f0-cbf2-310e-9214-2376b92790aa",
                                "text": "Un scélérat meurt dans une demeure que la nation lui a donnée et tout ce que nous savons c’est que les historiens vont évaluer, ré-évaluer, ré-ré-évaluer jusqu’à la fin des temps ses motivations ambiguës, ses façons de faire malhonnêtes."
                            },
                            {
                                "example_id": "459ffa85-74b8-4e40-ab2e-b42c8bc9087d",
                                "sense_id": "6a9385f0-cbf2-310e-9214-2376b92790aa",
                                "text": "Il faudrait alors lire dans cette exposition l’effort pour présenter un modèle auquel se référer pour se refaire, se re-penser, se ré-évaluer et se re-valoriser dans une situation malheureuse d’abandon."
                            }
                        ]
                    }
