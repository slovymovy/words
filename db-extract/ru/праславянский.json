                    },
                    {
                        "translation_id": "8130010f-3c79-489d-86e7-538750164334",
                        "source_entry_id": "d2fca580-4830-34e7-be6c-851db9e563ca",
                        "target_lang_word": "urslawisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "urslawisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "76a95e06-11c0-3e91-8562-e45c80c67b81",
                                        "entry_id": "2fd6030d-ff00-34f3-9315-b017fcc00d0c",
                                        "glosses": [
                                            "sich auf die hypothetische Ursprache der slawischen Sprachen beziehend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6098edb3-33da-4c61-86d9-61229ce86b98",
                                                "sense_id": "76a95e06-11c0-3e91-8562-e45c80c67b81",
                                                "text": "„Als Stammvater der belegten slawischen Sprachen postuliert man eine urslawische Sprache, die sehr ähnlich beschaffen ist wie das Urbaltische.“"
                                            },
                                            {
                                                "example_id": "8473a362-f75e-4540-917c-708f035ff5b3",
                                                "sense_id": "76a95e06-11c0-3e91-8562-e45c80c67b81",
                                                "text": "„Von der Slawistik wird eine urslawische Spracheinheit gefordert, deren Ende die Auswanderungen aus einer Urheimat waren, die dann gesonderte sprachliche Entwicklungen ermöglichen.“"
                                            },
                                            {
                                                "example_id": "1f7256eb-20e5-403e-9ccf-19428cf02817",
                                                "sense_id": "76a95e06-11c0-3e91-8562-e45c80c67b81",
                                                "text": "„Das Wort unterlag also seit dem 6. Jahrhundert allen urslawischen Lautwandlungen und muss daher zu dieser Zeit schon Bestandteil des urslawischen Wortschatzes gewesen sein.“"
                                            },
                                            {
                                                "example_id": "d98ef2f9-0bf9-4f45-aad4-ea816635fa7b",
                                                "sense_id": "76a95e06-11c0-3e91-8562-e45c80c67b81",
                                                "text": "„Die urslawischen Wörter und Formen, wie sie um 600 n. Chr. gelautet haben, zeigen große Ähnlichkeit mit ihren etymologischen Entsprechungen im Baltischen:“"
                                            },
                                            {
                                                "example_id": "e00be97b-5172-4cd5-8135-d52fb4942006",
                                                "sense_id": "76a95e06-11c0-3e91-8562-e45c80c67b81",
                                                "text": "„Der Vergleich bestimmter in mündlicher Tradition wurzelnder einzelsprachlicher slawischer Texte bietet manchen Einblick in den Wortschatz und die Ausdrucksweise der urslawischen Rechts- und urslawischen Dichtersprache […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
