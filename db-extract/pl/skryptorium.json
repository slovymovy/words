                                "example_id": "821fe217-4172-4435-9b80-4afb3707e265",
                                "sense_id": "5f47bfda-6e29-3f5d-adcb-863fe05a9a4e",
                                "text": "Przy skryptorium kopista spędzał kilka godzin dziennie."
