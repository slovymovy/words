    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b99b33e1-ed5c-34b2-8212-d3731e773353",
                    "sense_definition": "Rendre certaine ou définitive une information, une décision ou une réservation.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "certitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "N'oublie pas d'appeler l'hôtel pour <w>confirmer</w> notre réservation avant demain soir."
                        },
                        {
                            "text": "Le directeur a envoyé un courriel pour <w>confirmer</w> la date de la prochaine réunion."
                        }
                    ],
                    "synonyms": [
                        "valider",
                        "certifier"
                    ],
                    "antonyms": [
                        "démentir"
                    ],
                    "common_phrases": [
                        "confirmer une réservation",
                        "confirmer un rendez-vous",
                        "confirmer la nouvelle"
                    ]
                },
                {
                    "sense_id": "d0ea0d25-ef0a-3dd0-95dd-f9fe46d050b3",
                    "sense_definition": "Apporter des éléments ou des preuves qui renforcent une hypothèse ou un fait.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "preuve",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les nouvelles analyses médicales viennent de <w>confirmer</w> le diagnostic initial des médecins."
                        },
                        {
                            "text": "Cette récente observation scientifique permet de <w>confirmer</w> l'hypothèse proposée par l'équipe."
                        }
                    ],
                    "synonyms": [
                        "corroborer",
                        "étayer"
                    ],
                    "antonyms": [
                        "infirmer",
                        "démentir"
                    ],
                    "common_phrases": [
                        "confirmer une hypothèse",
                        "confirmer les résultats"
                    ]
                },
                {
                    "sense_id": "d8adf396-70c0-3f36-9d90-012cb3097dd0",
                    "sense_definition": "Valider ou maintenir officiellement une décision de justice, un acte ou un accord.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "droit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La cour d'appel a décidé de <w>confirmer</w> le premier jugement prononcé contre le prévenu."
                        },
                        {
                            "text": "Les juges ont préféré <w>confirmer</w> la sanction prise par le conseil de discipline."
                        }
                    ],
                    "synonyms": [
                        "entériner",
                        "ratifier"
                    ],
                    "antonyms": [
                        "infirmer"
                    ],
                    "common_phrases": [
                        "confirmer un jugement",
                        "confirmer la sentence"
                    ]
                },
                {
                    "sense_id": "53029e1e-20c1-313e-a513-e7172521eb59",
                    "sense_definition": "Fortifier quelqu'un dans une opinion, une intention ou une croyance.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "persuasion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Son attitude suspecte m'a <w>confirmé</w> dans l'idée qu'il dissimulait un secret important."
                        },
                        {
                            "text": "Ses premiers succès l'ont <w>confirmée</w> dans son choix de devenir avocate."
                        }
                    ],
                    "synonyms": [
                        "affermir",
                        "renforcer"
                    ],
                    "common_phrases": [
                        "confirmer dans son opinion",
                        "confirmer dans sa décision"
                    ]
                },
                {
                    "sense_id": "76959412-ba0a-3e32-bfb1-f2fa7654d0ae",
                    "sense_definition": "Administrer le sacrement chrétien de la confirmation à un fidèle.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'évêque est venu spécialement dans la paroisse pour <w>confirmer</w> les jeunes fidèles."
                        },
                        {
                            "text": "Mon grand-père a été <w>confirmé</w> dans cette même chapelle il y a soixante ans."
                        }
                    ]
                }
            ]
        }
    ]
}