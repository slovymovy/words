                "translations": [
                    {
                        "translation_id": "8e95bf1d-b734-42c6-ae7c-219230659707",
                        "source_entry_id": "a2f4d042-8f4b-3217-9e1c-2805d9e2fa93",
                        "target_lang_word": "Mark",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mark",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5d21dc93-f9c8-31b6-9454-be2299b1e106",
                                        "entry_id": "515707d6-2f1c-3b80-aedc-e8516deb5eb0",
                                        "glosses": [
                                            "historische Gewichts- bzw. Masseneinheit, die ab dem 11. Jahrhundert das Pfund als Edelmetall- und Münzgewicht verdrängte. Die Mark ist traditionell ein halbes Pfund und wurde üblicherweise in 8 Unzen oder 16 Lot eingeteilt"
                                        ],
                                        "tags": [
                                            "Plural 1"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4393ff4d-5a90-4582-bfb3-085124179d05",
                                                "sense_id": "5d21dc93-f9c8-31b6-9454-be2299b1e106",
                                                "text": "Das brachte ihnen zwanzig Mark Silber ein."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bd7fdec4-2106-3a4a-a998-21f50d6be45b",
                                        "entry_id": "515707d6-2f1c-3b80-aedc-e8516deb5eb0",
                                        "glosses": [
                                            "kurz für die historischen Währungsbezeichnungen Reichsmark, Deutsche Mark, Mark der Deutschen Notenbank und DDR-Mark, abgeleitet von ^([1])"
                                        ],
                                        "tags": [
                                            "Plural 1"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "923ef2a6-f14a-478f-abaa-723dc01931b8",
                                                "sense_id": "bd7fdec4-2106-3a4a-a998-21f50d6be45b",
                                                "text": "Haste mal 'ne Mark?"
                                            },
                                            {
                                                "example_id": "72290ce9-b25a-4447-b9a7-3f42d3a372bd",
                                                "sense_id": "bd7fdec4-2106-3a4a-a998-21f50d6be45b",
                                                "text": "„Im Sommer 1923 indes zerstörte die immer raschere Entwertung der Mark die Wirtschaft, es drohten Lebensmittelknappheit und Massenelend, und das Reich stand kurz vor der Auflösung.“"
                                            },
                                            {
                                                "example_id": "66ecf487-2979-4f6d-8cbe-a69e79e24c25",
                                                "sense_id": "bd7fdec4-2106-3a4a-a998-21f50d6be45b",
                                                "text": "„Eine Tasse Kaffee, ein Butterbrot, fünfzig, dreißig, achtzig, neunzig Pfennig“, deklamierte der andere [Kellner]. Fabian legte eine Mark auf den Tisch und ging [aus dem Café]."
                                            },
                                            {
                                                "example_id": "688892f8-1565-4872-b146-4fdaa9375468",
                                                "sense_id": "bd7fdec4-2106-3a4a-a998-21f50d6be45b",
                                                "text": "„Er schob den Briefumschlag unter die Tür, ich stand auf, hob ihn auf und öffnete ihn: es war eine Fahrkarte Zweiter Klasse von Bochum nach Bonn drin, und das Taxigeld war genau abgezählt: sechs Mark und fünfzig Pfennig.“"
                                            },
                                            {
                                                "example_id": "7580714a-7d4e-4b4b-a555-c16f6564ec34",
                                                "sense_id": "bd7fdec4-2106-3a4a-a998-21f50d6be45b",
                                                "text": "„Als am Ende der Inflation im Jahre 1923 die Mark von einer Billion auf vier Mark stabilisiert wurde, hatte er Konkurs anmelden müssen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "3690bc6f-03b5-3114-b456-e79d0bda0135",
                                        "entry_id": "515707d6-2f1c-3b80-aedc-e8516deb5eb0",
                                        "glosses": [
                                            "ein Gebiet an den historischen Grenzen des Frankenreiches oder des Heiligen Römischen Reiches Deutscher Nation (Grenzmark)"
                                        ],
                                        "tags": [
                                            "Plural 2"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b34b25d9-1bfa-49ed-a06e-b2c222007fcd",
                                                "sense_id": "3690bc6f-03b5-3114-b456-e79d0bda0135",
                                                "text": "Es herrsche Krieg in allen Marken des Reichs."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "e69cf4e2-d347-338b-9575-db97ef60068d",
                                        "entry_id": "515707d6-2f1c-3b80-aedc-e8516deb5eb0",
                                        "glosses": [
                                            "vor allem in Norddeutschland früher das freie (Weide-)Land außerhalb der Dörfer, das im gemeinsamen Besitz der Bauern war"
                                        ],
                                        "tags": [
                                            "Plural 2"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b3f59f8-40ab-40c7-ac4c-627f3c6d2aa2",
                                                "sense_id": "e69cf4e2-d347-338b-9575-db97ef60068d",
                                                "text": "Sie ließen ihre Ziege auf der Mark weiden."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Mark",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "01fcbc85-ee1b-384f-bbbc-a16dcb1edcf8",
                                        "entry_id": "c9913a71-1575-35d1-8d27-9da9ef2ac6a6",
                                        "glosses": [
                                            "weiche Substanz im Kern von Knochen, Stängel oder Früchten"
                                        ],
