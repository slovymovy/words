                        },
                        {
                            "text": "Le ministre est arrivé à la conférence accompagné d'une impressionnante <w>cohorte</w> de conseillers."
                        }
                    ],
                    "synonyms": [
                        "foule",
                        "troupe",
                        "multitude"
                    ],
                    "common_phrases": [
