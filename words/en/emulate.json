                    "frequency": "Middle",
                    "semantic_group_id": "technical_imitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Modern consoles can <w>emulate</w> older games so that players can enjoy classic titles."
                        },
                        {
                            "text": "The software is designed to <w>emulate</w> a vintage operating system on a modern computer."
                        }
                    ],
                    "synonyms": [
