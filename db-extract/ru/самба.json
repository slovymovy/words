                    {
                        "sense_id": "1eaacdcf-4859-3f23-b05a-2e61c5309a52",
                        "entry_id": "262e3fa8-6bd0-3f39-9098-983a42e3bce9",
                        "glosses": [
                            "бразильский народный экспрессивный танец с энергичными движениями бёдер и частой сменой позиций танцующих"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "d6a9b346-e318-37fa-80f8-6566ddcc649f",
                        "entry_id": "262e3fa8-6bd0-3f39-9098-983a42e3bce9",
                        "glosses": [
                            "музыкальный стиль, используемый, в частности, для сопровождения такого танца; также произведение, написанное или исполняемое в таком стиле"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c915d995-ccd4-4221-8597-b4d5d11f6465",
                        "source_entry_id": "262e3fa8-6bd0-3f39-9098-983a42e3bce9",
                        "source_sense_description": "танец",
                        "target_lang_word": "samba",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "samba",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "65c1e77a-8575-378b-81cc-9a6b5f65a82d",
                                        "entry_id": "247d2b47-3d03-30c2-a330-0f26d62da844",
                                        "glosses": [
                                            "A Brazilian ballroom dance or dance style."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5efa3489-95c5-30ee-bb4a-8308a8f61c29",
                                        "entry_id": "247d2b47-3d03-30c2-a330-0f26d62da844",
                                        "glosses": [
                                            "A Brazilian musical genre, to which the aforementioned dance is danced, which has its roots in West Africa via the slave trade."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "783e47ec-e146-4111-bd19-3e7a285dd9d1",
                                                "sense_id": "5efa3489-95c5-30ee-bb4a-8308a8f61c29",
                                                "text": "And when the samba played, the sun would set so high / Ring through my ears and sting my eyes, your Spanish lullaby"
                                            },
                                            {
                                                "example_id": "cdf5d331-1601-43ab-acba-9ccb01cf7526",
                                                "sense_id": "5efa3489-95c5-30ee-bb4a-8308a8f61c29",
                                                "text": "They thought of, I don’t know, monkeys and caipirinhas and samba.”"
                                            },
                                            {
                                                "example_id": "17316389-3218-4642-bacb-d4c7e93b1719",
                                                "sense_id": "5efa3489-95c5-30ee-bb4a-8308a8f61c29",
                                                "text": "Slavery was abolished in Brazil in 1888; until then, Bahia had been a major hub of the country’s slave trade. Samba started there for a reason—a fact that Veloso has returned to, obsessively, throughout his career. […] “A samba parade had turned into a brawl,” a reviewer wrote in the Times, adding that the music “suggested a more cool-headed, grown-up epilogue to the shocks of Tropicália.”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "samba",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2d3387e8-8beb-305d-8b41-9e79970c5a57",
                                        "entry_id": "7306006f-dad2-3fdc-a484-b07fd0311b83",
                                        "glosses": [
                                            "To dance the samba."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3fe344c9-5486-4a59-92a1-9d7173c405e3",
                                                "sense_id": "2d3387e8-8beb-305d-8b41-9e79970c5a57",
                                                "text": "In front of an audience, he tends to have a freer conversation with himself. The right conditions turn him into an extrovert. He sambas, in the Santo Amaro style."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4a897120-a6cd-4820-b3b9-cbdb28657d47",
                        "source_entry_id": "262e3fa8-6bd0-3f39-9098-983a42e3bce9",
                        "source_sense_description": "танец",
                        "target_lang_word": "samba",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "samba",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "9f2e95ef-05d0-3d4c-a930-1c10064ba3ee",
                                        "entry_id": "9bc2aafd-2217-39db-adfe-8d7ef7cfa475",
                                        "glosses": [
                                            "Género musical popular de origen brasileño y ascendencia africana, en ritmo de 2/4."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52fdb978-7911-468c-b6a2-83b033adcbe9",
                                                "sense_id": "9f2e95ef-05d0-3d4c-a930-1c10064ba3ee",
                                                "text": "De nuevo volvió la ‘rumbera’, esta vez con una indumentaria diferente, e interpretó a su manera una samba brasilera."
                                            },
                                            {
                                                "example_id": "7a62a159-605a-4f4d-aaca-830ef3248d4a",
                                                "sense_id": "9f2e95ef-05d0-3d4c-a930-1c10064ba3ee",
                                                "text": "Era una samba lo que estaban tocando."
                                            },
                                            {
                                                "example_id": "a40da3c9-4f84-4833-9c6b-93337b2348b4",
                                                "sense_id": "9f2e95ef-05d0-3d4c-a930-1c10064ba3ee",
                                                "text": "Había en el comedor una orquesta que tocaba fados, tangos y sambas, no tan alto que nos molestasen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c8bb58a9-1d2d-398c-8122-a38d99b28fca",
                                        "entry_id": "9bc2aafd-2217-39db-adfe-8d7ef7cfa475",
                                        "glosses": [
                                            "Estilo de baile que se danza al compás de la samba₁."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b19c139-199f-4183-88b8-c056cb9ce8f2",
                                                "sense_id": "c8bb58a9-1d2d-398c-8122-a38d99b28fca",
                                                "text": "Antes escribí contra las fiestas infantiles donde se baila desde la samba negra hasta el tango argentino, pasando por los bailes japoneses y baile de apaches, sin dejar un lugarcito a nuestras cosas, que, ya sabemos, por nuestras no les gustan a los maestros y se tienen por malas."
                                            },
                                            {
                                                "example_id": "0e6e90a1-da82-4442-9f53-317b7102efdd",
                                                "sense_id": "c8bb58a9-1d2d-398c-8122-a38d99b28fca",
                                                "text": "Rodrigo se acercó a Pimpinela y tomó el lugar del periodista, quien ahora bailaba una samba con Charlotte."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a7be7d2a-513f-3996-889a-9e43eb171d13",
                                        "entry_id": "9bc2aafd-2217-39db-adfe-8d7ef7cfa475",
                                        "glosses": [
                                            "En los parques de diversiones, juego que consiste en bailar samba alrededor de un tambor giratorio sin caerse."
                                        ],
                                        "tags": [
                                            "Entretenimiento"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
