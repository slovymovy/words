{
    "word_family": [
        "doctrinal",
        "indoctrinate",
        "indoctrination",
        "doctrinarian",
        "doctrinaire"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1455590b-b135-31da-83bb-e7ece52235bf",
                    "sense_definition": "A specific belief or principle, especially one held by a religious, political, or philosophical group.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "belief_system",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>doctrine</w> of the separation of powers is fundamental to many modern democracies.",
                            "target_lang_translations": {
                                "ru": "<w>Доктрина</w> разделения властей является основополагающей для многих современных демократий."
                            }
                        },
                        {
                            "text": "The Four Noble Truths summarise the main <w>doctrines</w> of Buddhism.",
                            "target_lang_translations": {
                                "ru": "Четыре благородные истины резюмируют основные <w>догматы</w> буддизма."
                            }
                        }
                    ],
                    "synonyms": [
                        "tenet",
                        "principle",
                        "dogma",
                        "creed"
                    ],
                    "common_phrases": [
                        "religious doctrine",
                        "central doctrine",
                        "basic doctrine"
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкретное убеждение или принцип, особенно поддерживаемый религиозной, политической или философской группой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "доктрина",
                                "target_lang_sense_clarification": "руководящий теоретический или политический принцип"
                            },
                            {
                                "target_lang_word": "догмат",
                                "target_lang_sense_clarification": "основное положение вероучения"
                            },
                            {
                                "target_lang_word": "принцип",
                                "target_lang_sense_clarification": "основное убеждение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ced4aa50-6bde-3f22-a64c-f35518fdf51c",
                    "sense_definition": "The entire body of teachings or instructions belonging to an ideology, religion, or organization.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "belief_system",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Scholars spent years studying the complex <w>doctrine</w> of the ancient church.",
                            "target_lang_translations": {
                                "ru": "Ученые потратили годы на изучение сложного <w>учения</w> древней церкви."
                            }
                        },
                        {
                            "text": "What is the understanding of marriage and family in orthodox Marxist <w>doctrine</w>?",
                            "target_lang_translations": {
                                "ru": "Каково понимание брака и семьи в ортодоксальной марксистской <w>доктрине</w>?"
                            }
                        }
                    ],
                    "synonyms": [
                        "teaching",
                        "ideology",
                        "philosophy"
                    ],
                    "common_phrases": [
                        "official doctrine",
                        "orthodox doctrine",
                        "political doctrine"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вся совокупность учений или инструкций, принадлежащих идеологии, религии или организации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "учение",
                                "target_lang_sense_clarification": "система взглядов или совокупность догматов"
                            },
                            {
                                "target_lang_word": "доктрина",
                                "target_lang_sense_clarification": "научная или философская теория, система"
                            },
                            {
                                "target_lang_word": "идеология",
                                "target_lang_sense_clarification": "система идей и взглядов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2690da07-946e-30ef-8798-2d71740d3825",
                    "sense_definition": "A stated principle of government policy, mainly in foreign or military affairs.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "policy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The Monroe <w>Doctrine</w> warned European powers against interfering in the affairs of the Western Hemisphere.",
                            "target_lang_translations": {
                                "ru": "<w>Доктрина</w> Монро предостерегала европейские державы от вмешательства в дела Западного полушария."
                            }
                        },
                        {
                            "text": "The government announced a new military <w>doctrine</w> to address emerging cyber threats.",
                            "target_lang_translations": {
                                "ru": "Правительство объявило о новой военной <w>доктрине</w> для борьбы с возникающими киберугрозами."
                            }
                        }
                    ],
                    "synonyms": [
                        "policy",
                        "strategy"
                    ],
                    "common_phrases": [
                        "foreign policy doctrine",
                        "military doctrine",
                        "strategic doctrine"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заявленный принцип государственной политики, в основном в иностранных или военных делах."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "доктрина",
                                "target_lang_sense_clarification": "официальная политическая или военная установка"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}