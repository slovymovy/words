                        "entry_id": "a9da94fb-2f32-3ecd-8d87-0bfa6941478c",
                        "glosses": [
                            "honorary Aryan (a non-White or Jewish person respected or favoured by the Nazis)"
                        ],
                        "tags": [
                            "historical",
                            "humorous",
