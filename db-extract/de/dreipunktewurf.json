                "senses": [
                    {
                        "sense_id": "e3c77552-4234-3bd4-bf61-3f3b131a52f4",
                        "entry_id": "a951b8f8-a190-3445-8c5f-e127f423a95e",
                        "glosses": [
                            "Wurf, der von einer Position hinter einer bestimmten Linie (Dreipunktelinie) ausgeführt wurde, und drei Punkte zählt"
                        ],
                        "tags": [
                            "Basketball"
                        ],
                        "examples": [
                            {
                                "example_id": "bae6d8d3-5182-45ca-987b-0369de29d717",
                                "sense_id": "e3c77552-4234-3bd4-bf61-3f3b131a52f4",
                                "text": "„Superstar Stephen Curry verfehlte kurz vor der Schlusssirene einen Dreipunktewurf, der den Gastgebern eine Verlängerung ermöglicht hätte.“"
                            },
                            {
                                "example_id": "88982f7e-e6fb-4da6-8c31-785cee147fcb",
                                "sense_id": "e3c77552-4234-3bd4-bf61-3f3b131a52f4",
                                "text": "„Der wertvollste Spieler der vergangenen Saison erzielte 46 Punkte und versenkte zehn Dreipunktewürfe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
