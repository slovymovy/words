                "senses": [
                    {
                        "sense_id": "f05b29bd-c950-3f6d-a905-53936eda572e",
                        "entry_id": "ab704bd4-77b2-331a-b62d-c7643c02a99e",
                        "glosses": [
                            "Lichtsignal als Überquerungshilfe für Fußgänger"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "986ddb34-9888-442e-a602-a456de2d814c",
                                "sense_id": "f05b29bd-c950-3f6d-a905-53936eda572e",
                                "text": "„Ich trage die Einkaufssäcke, Menschen mit Einkaufstaschen sieht man immer seltener, ich gehe über die Kreuzung Zieglergasse- Westbahnstraße, an der seit einiger Zeit eine Fußgeherampel ist.“"
                            },
                            {
                                "example_id": "747edd15-066b-474c-bacf-f3f87b98c282",
                                "sense_id": "f05b29bd-c950-3f6d-a905-53936eda572e",
                                "text": "„In der unter Berufung auf Art137 B-VG am 1. Dezember 1986 erhobenen, gegen das Land Wien gerichteten Klage bringt der Kläger im wesentlichen vor, daß die Bundespolizeidirektion Wien gegen ihn ein Verwaltungsstrafverfahren durchgeführt habe, weil er am 9. Oktober 1983 als Fußgeher eine Fahrbahn überquert habe, obwohl die Fußgeherampel Rotlicht zeigte.“"
                            },
                            {
                                "example_id": "fef76ee5-16a5-4ed8-ae31-69c85476db67",
                                "sense_id": "f05b29bd-c950-3f6d-a905-53936eda572e",
                                "text": "„Mittlerweile war mir aufgefallen, dass in allen Richtungen sogar die Fußgeherampel Rot zeigte.“"
                            },
                            {
                                "example_id": "509afc93-8de6-4bc0-b5f9-12f41048fb68",
                                "sense_id": "f05b29bd-c950-3f6d-a905-53936eda572e",
                                "text": "„Immerhin richtet man den Schwulen- und Lesbenball im Wiener Rathaus aus, die Straßenbahnen werden rund um die alljährliche Regenbogenparade mit Regenbogen-Fähnchen geschmückt und seit dem Song-Contest hat Wien rund 50 Fußgeherampeln, die rote bzw. grüne Ampelpärchen zeigen.“"
                            },
                            {
                                "example_id": "29a873ad-5379-40fc-9237-eec7508ff70c",
                                "sense_id": "f05b29bd-c950-3f6d-a905-53936eda572e",
                                "text": "„Auf Initiative der Grünen gab es schließlich einen Allparteienantrag zur Überprüfung der Grünphasen von Fußgeherampeln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
