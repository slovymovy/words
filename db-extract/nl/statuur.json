                                        "sense_id": "fc5b5bed-fb6c-35d4-94eb-f556d60db42d",
                                        "entry_id": "00c6a2ed-5cba-3e04-ab40-f74132775772",
                                        "glosses": [
                                            "A person or animal's natural height when standing upright."
