                "senses": [
                    {
                        "sense_id": "e853b35a-cf53-32d2-80ac-46b701df513f",
                        "entry_id": "e5e58d74-95d5-3321-bdb8-c8df3f2443dd",
                        "glosses": [
                            "ein pazifistisches Konzept zum Erreichen eines Friedens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b08f452-d449-4539-afc5-fbb6889cea3d",
                                "sense_id": "e853b35a-cf53-32d2-80ac-46b701df513f",
                                "text": "„Es wird der Friedensidee die Geister in Scharen gewinnen. Freilich: die Militärfachleute werden es achselzuckend abtun mit »Übertreibung – Phantasterei – unwahr« – aber die andern werden ergriffen und erschüttert sein, werden fühlen, wie viel Wahres in dem Dichtertraum liegt; werden einsehen, nicht nur, daß der Wahnsinn zu den Krankheiten des modernen Krieges gehört – das ist ja auch beglaubigte Tatsache – sondern daß der Krieg selber ein Wahnsinn ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
