                "senses": [
                    {
                        "sense_id": "d72ddb98-b3ec-3d23-b51a-818c4c978955",
                        "entry_id": "4072d1a4-ea8e-35cb-8fe5-7ea4ddb509a1",
                        "glosses": [
                            "Gruppe von Personen, die sich (auf politischer, gewerkschaftlicher oder betrieblicher Ebene) für die Interessen von Frauen einsetzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a88a8abc-17d2-4198-afa2-6709636be00d",
                                "sense_id": "d72ddb98-b3ec-3d23-b51a-818c4c978955",
                                "text": "„Der Frauenausschuss im Europaparlament will die umstrittene Abgeordnete der Alternative für Deutschland (AFD), Beatrix von Storch, nicht als stellvertretende Vorsitzende akzeptieren.“"
                            },
                            {
                                "example_id": "2aed0624-704a-4d86-8492-0d3532dee674",
                                "sense_id": "d72ddb98-b3ec-3d23-b51a-818c4c978955",
                                "text": "„Die Vorsitzende des Frauenausschusses im israelischen Parlament, Tzipi Hotovely, kritisierte das Gutachten scharf.“"
                            },
                            {
                                "example_id": "a18c6d0b-a22e-409a-9b2c-2da39c52228f",
                                "sense_id": "d72ddb98-b3ec-3d23-b51a-818c4c978955",
                                "text": "„Eine Delegation des Frauenausschusses des Europäischen Parlaments hat die Türkei besucht, um dort die Stellung der Frau in Gesellschaft und Politik zu untersuchen. Ihr Fazit: Es bleibt viel zu verbessern.“"
                            },
                            {
                                "example_id": "7077df86-cdd7-4095-9183-80e99ca60d49",
                                "sense_id": "d72ddb98-b3ec-3d23-b51a-818c4c978955",
                                "text": "„Marielle Franco war 38 Jahre alt, Menschenrechtsaktivistin - und sie leitete den Frauenausschuss des Stadtparlaments.“"
                            },
                            {
                                "example_id": "44309c20-6508-411c-ab17-131e24604a43",
                                "sense_id": "d72ddb98-b3ec-3d23-b51a-818c4c978955",
                                "text": "„Mit nur sieben Stimmen Mehrheit wurde der Vorschlag des Frauenausschusses denkbar knapp angenommen.“"
                            },
                            {
                                "example_id": "9f000a80-69dc-43d7-bc80-808b670ea872",
                                "sense_id": "d72ddb98-b3ec-3d23-b51a-818c4c978955",
                                "text": "„Zwischen der Anhörung im Frauenausschuss am Montag und der Abstimmung am Donnerstag lagen“ […] „nur drei Tage.“"
                            },
                            {
                                "example_id": "937c6c9e-2432-43af-a348-60f6a5d08e4a",
                                "sense_id": "d72ddb98-b3ec-3d23-b51a-818c4c978955",
                                "text": "„Männer an den Wickeltisch: Der Frauenausschuss des Europaparlaments will junge Väter zu einem zweiwöchigen Urlaub nach der Geburt ihres Kindes verpflichten.“"
                            },
                            {
                                "example_id": "95a2d0b8-c30a-4687-b1e9-c5a437a3cd50",
                                "sense_id": "d72ddb98-b3ec-3d23-b51a-818c4c978955",
                                "text": "„Man habe die Forderungen heruntergeschraubt und zuletzt ein Mindestgehalt von nur noch 16'000 Euro statt 20'000 Euro brutto pro Jahr verlangt, sagte die Präsidentin des Frauenausschusses der AFE, Maria Jose Lopez.“"
                            },
                            {
                                "example_id": "0674ca2a-fff9-4c57-8b30-238f9850c4c4",
                                "sense_id": "d72ddb98-b3ec-3d23-b51a-818c4c978955",
                                "text": "„Was war am 9. Dez. 1917? – Anlässlich der Rheinischen Goldankaufswoche ruft der Frauenausschuss zur Abgabe von Schmuck für Kriegszwecke auf.“"
                            },
                            {
                                "example_id": "2c3b43b1-dc95-43ad-b2b3-85efde673350",
                                "sense_id": "d72ddb98-b3ec-3d23-b51a-818c4c978955",
                                "text": "„Nach sowjetischem Vorbild soll der DFD zur Massenorganisation geformt werden. Kleinere unabhängige Frauenausschüsse oder –verbände haben keine Chance, neben dem übermächtigen Frauenbund zu bestehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
