                        "glosses": [
                            "The quality of being capacious."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "3dfe1b9f-7f2b-4731-8fbf-1fc643b0cb65",
                                "sense_id": "8fd7be9a-fd8a-3327-a8cc-5e248be252cb",
                                "text": "Capacity is the abstract of capax, receiving or apt to hold ; it is therefore applied to the contents of hollow bodies : capaciousness is the abstract of capacious and is therefore applied to the plane surface comprehended within a given space. hence we speak of the capacity of a vessel; and the capaciousness of a room."
                            },
                            {
                                "example_id": "ce3daee4-da13-4bc3-9b1e-51bc08eccf76",
                                "sense_id": "8fd7be9a-fd8a-3327-a8cc-5e248be252cb",
                                "text": "The author of the Plays was equipped, beyond every other man of his time, with wisdom, erudition, imagination, capaciousness of mind, grace, and majesty of expression."
                            }
                        ]
                    }
