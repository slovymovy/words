                    {
                        "sense_id": "21d00295-cf53-3a74-8805-c204606cb92a",
                        "entry_id": "46b2b8d3-0fab-32a1-9814-ff58c995901d",
                        "glosses": [
                            "Zielflughafen, Bestimmungsort/Zielort einer Reise"
                        ],
                        "tags": [
                            "Flugwesen"
                        ],
                        "examples": [
                            {
                                "example_id": "1dd53b1e-a1b2-43c4-a897-65c3b0254b99",
                                "sense_id": "21d00295-cf53-3a74-8805-c204606cb92a",
                                "text": "Zu Destinationen innerhalb Deutschlands fuhr er mit dem Auto."
                            },
                            {
                                "example_id": "ab86a7de-6f91-46db-93bc-63a370b62aef",
                                "sense_id": "21d00295-cf53-3a74-8805-c204606cb92a",
                                "text": "Gelingt es, dann die Anzahl der Gäste zu halten, nützt das viel, weil die Destination so die Fixkosten besser aufteilen kann."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b1b8db69-a8a3-3dc8-8171-cf9d2b1bd820",
                        "entry_id": "46b2b8d3-0fab-32a1-9814-ff58c995901d",
                        "glosses": [
                            "Bestimmung, Endzweck"
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "16834d9a-0100-4314-95c3-6633f85cf380",
                                "sense_id": "b1b8db69-a8a3-3dc8-8171-cf9d2b1bd820",
                                "text": "Ihre Destination war es, ihr Kind überlebensfähig zu machen."
                            },
                            {
                                "example_id": "21dc44bb-2d12-4c2a-9000-554a8dd6a7e5",
                                "sense_id": "b1b8db69-a8a3-3dc8-8171-cf9d2b1bd820",
                                "text": "»… Andere für uns handeln lassen, das wäre unsre Destination. …«"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
