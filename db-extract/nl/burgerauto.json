                        "examples": [
                            {
                                "example_id": "ab319a66-91e7-4fb4-9f08-0a1076a6ebd8",
                                "sense_id": "39317ba5-094b-3ec3-a859-2317967cb316",
                                "text": "Agenten hebben gisteren in Zaandam een snorfietser tot stoppen gedwongen door hem hun auto in te trekken. Ze wilden de 19-jarige man aanspreken omdat hij bellend rondreed. Toen hij merkte dat de agenten - in een burgerauto - hem wilden aanspreken, voerde hij zijn snelheid op en ging ervandoor."
                            },
                            {
                                "example_id": "ebe980c2-96a0-437e-a133-d8b14fa683d9",
                                "sense_id": "39317ba5-094b-3ec3-a859-2317967cb316",
                                "text": "Vier agenten in uniform komen vanuit een burgerauto een kijkje nemen. Een andere vrouw, van tegen de vijftig, fietst met haar man langs. \"Op zich is het niet zo'n probleem. Voor mensen die het moeilijk hebben, moet iedereen een steentje bijdragen. Maar ze moeten wel goed gehuisvest worden.\""
                            }
                        ]
                    }
