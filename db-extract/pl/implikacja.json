                ],
                "translations": [
                    {
                        "translation_id": "750708de-3d93-435a-b4d2-7cd8a6242290",
                        "source_entry_id": "ff53ad3d-3017-3140-bec8-bd72dc71fb98",
                        "source_sense_id": "2d7f4922-42a1-318e-8d5e-b8bfb2728aab",
                        "target_lang_word": "ramification",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ramification",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bf08bbbf-fd9c-3168-a73f-83a2382f9291",
                                        "entry_id": "a4245d96-6536-331e-9a89-8adebd1afeee",
                                        "glosses": [
                                            "A branching-out, the act or result of developing branches; specifically the divergence of the stem and limbs of a plant into smaller ones, or of similar developments in blood vessels, anatomical structures etc."
                                        ],
                                        "tags": [
                                            "also",
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40a42dd8-a26d-494d-9014-b56fb699770b",
                                                "sense_id": "bf08bbbf-fd9c-3168-a73f-83a2382f9291",
                                                "text": "The character of trees may be studied to advantage […] in winter, when the forms of the ramification can be seen in the naked boughs […]"
                                            },
                                            {
                                                "example_id": "751e8f2c-2cb5-4366-a564-8980c4f94e97",
                                                "sense_id": "bf08bbbf-fd9c-3168-a73f-83a2382f9291",
                                                "text": "From the left chamber or ventricle of the strong muscular mass, the heart, a large tube arises, called the aorta; and by a continued division or ramification, opens a way for the bright scarlet blood to the very minutest part of the living frame […]"
                                            },
                                            {
                                                "example_id": "528a0127-865b-44f1-bf8e-009940e62758",
                                                "sense_id": "bf08bbbf-fd9c-3168-a73f-83a2382f9291",
                                                "text": "[…]we may be sure that Becky and Briggs looked out those august names in the Peerage, and followed the noble races up through all the ramifications of the family tree."
                                            },
                                            {
                                                "example_id": "1cddaf53-e476-4b69-a05c-d85d9fcfaec8",
                                                "sense_id": "bf08bbbf-fd9c-3168-a73f-83a2382f9291",
                                                "text": "“You live in a different world to me, Mr. Overton—a sweeter and healthier one. My ramifications stretch out into many sections of society, but never, I am happy to say, into amateur sport, which is the best and soundest thing in England.[…]"
                                            },
                                            {
                                                "example_id": "96c0e2c9-a479-42cf-a4c4-81f39bf5fe3c",
                                                "sense_id": "bf08bbbf-fd9c-3168-a73f-83a2382f9291",
                                                "text": "Quite unexpectedly an idea popped into Tarzan's head. In following out the many ramifications of the dictionary definition of God he had come upon the word create—“to cause to come into existence; to form out of nothing.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67132de4-5d45-3d14-8fff-1614e0cba78c",
                                        "entry_id": "a4245d96-6536-331e-9a89-8adebd1afeee",
                                        "glosses": [
                                            "An offshoot of a decision, fact etc.; a consequence or implication, especially one which complicates a situation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "in-plural",
                                            "often",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7521a4b-781b-497e-bdcc-3f8a7620878a",
                                                "sense_id": "67132de4-5d45-3d14-8fff-1614e0cba78c",
                                                "text": "The treachery of some of the Jacobite agents (Rashleigh among the rest), and the arrest of others, had made George the First's Government acquainted with the extensive ramifications of a conspiracy long prepared, and which at last exploded prematurely […]"
                                            },
                                            {
                                                "example_id": "ab4dbfcb-28eb-4089-a5fe-59efbfb61d31",
                                                "sense_id": "67132de4-5d45-3d14-8fff-1614e0cba78c",
                                                "text": "What, then, is my Scheme? It is a very simple one, although in its ramifications and extensions it embraces the whole world."
                                            },
                                            {
                                                "example_id": "79f8ee90-b95e-40fe-b67c-94debbabe1a6",
                                                "sense_id": "67132de4-5d45-3d14-8fff-1614e0cba78c",
                                                "text": "He stirred up a bigger muss than he had anticipated, and even he was astounded at the wide ramifications of the struggle and at the unexpected and incongruous interests that were drawn into it."
                                            },
                                            {
                                                "example_id": "dfff8728-ac01-48ff-811b-90bb5573c4ca",
                                                "sense_id": "67132de4-5d45-3d14-8fff-1614e0cba78c",
                                                "text": "But most often and memorably his work falls into that territory best summed up as speculative fiction, with a particular emphasis on dystopian futures and the existential ramifications of space exploration."
                                            },
                                            {
                                                "example_id": "4d25f50a-f40a-443c-9fa9-4e1551e3a5b2",
                                                "sense_id": "67132de4-5d45-3d14-8fff-1614e0cba78c",
                                                "text": "The advent of COVID passports, so soon after increased check-in bureaucracy post-Brexit, brought major logistical ramifications to St Pancras International, of a kind unseen at any other major station in Britain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11003956-6426-3eff-9924-e1ac56c4399f",
                                        "entry_id": "a4245d96-6536-331e-9a89-8adebd1afeee",
                                        "glosses": [
                                            "An arrangement of branches."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b02c13d2-45ae-43e6-8159-8f3ce0d1a6ef",
                        "source_entry_id": "ff53ad3d-3017-3140-bec8-bd72dc71fb98",
                        "source_sense_id": "2d7f4922-42a1-318e-8d5e-b8bfb2728aab",
                        "target_lang_word": "implication",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "implication",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f40aa216-a141-3232-abfe-499fa216e512",
                                        "entry_id": "d94154e3-fb85-3448-8b36-d0b2a4d3b98d",
                                        "glosses": [
                                            "The act of implicating."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "39ae6e1f-2f75-393c-836e-8ac640579c0a",
                                        "entry_id": "d94154e3-fb85-3448-8b36-d0b2a4d3b98d",
                                        "glosses": [
                                            "The state of being implicated."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "345de53a-84f7-3d43-a34b-f0ef7e5c3827",
                                        "entry_id": "d94154e3-fb85-3448-8b36-d0b2a4d3b98d",
                                        "glosses": [
                                            "A possible effect or result of a decision or action."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29adc30c-d8eb-41a0-99b2-5e72477d9650",
                                                "sense_id": "345de53a-84f7-3d43-a34b-f0ef7e5c3827",
                                                "text": "Dumping waste in the river will have serious implications for the environment."
                                            },
                                            {
                                                "example_id": "e9cda800-5360-4823-ab1f-59c1731c43cb",
                                                "sense_id": "345de53a-84f7-3d43-a34b-f0ef7e5c3827",
                                                "text": "And while that number is expected to shift back slightly into positive territory over this decade, fewer children today establishes an unmistakable implication for tomorrow: fewer adults available as consumers, workers and taxpayers."
                                            },
                                            {
                                                "example_id": "f283a632-aef1-4f39-8159-d2feca712760",
                                                "sense_id": "345de53a-84f7-3d43-a34b-f0ef7e5c3827",
                                                "text": "With his legal maneuverings, Trump is showing that he also understands the implications of this election — one that could give him substantial powers as president to defray or dismiss many of the legal threats that he’s facing and to behave in office without future accountability."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e291a48-5341-3103-96c3-7f24936e0a4d",
                                        "entry_id": "d94154e3-fb85-3448-8b36-d0b2a4d3b98d",
                                        "glosses": [
                                            "An implying, or that which is implied, but not expressed; an inference, or something which may fairly be understood, though not expressed in words."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "584ee984-de21-4130-ba09-84c71a3f2b64",
                                                "sense_id": "6e291a48-5341-3103-96c3-7f24936e0a4d",
                                                "text": "But we can also take a more analytical attitude to these displays, interpreting the movements as no more than approachings, touchings, and departings with no implication that one shape caused the other to move."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "831797b3-415b-31ca-a8f7-3006d3a4218a",
                                        "entry_id": "d94154e3-fb85-3448-8b36-d0b2a4d3b98d",
                                        "glosses": [
                                            "The connective in propositional calculus that, when joining two predicates A and B in that order, has the meaning \\\"if A is true, then B is true\\\"."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "880a7c24-1ca9-3c51-9dea-3f6fb88002ba",
                                        "entry_id": "d94154e3-fb85-3448-8b36-d0b2a4d3b98d",
                                        "glosses": [
                                            "Logical consequence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
