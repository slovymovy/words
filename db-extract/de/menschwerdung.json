                ],
                "senses": [
                    {
                        "sense_id": "a3824722-506e-3cd7-a77d-ed8dc0f60beb",
                        "entry_id": "00d607ee-141d-3d38-9c4a-18c14aeeb9d8",
                        "glosses": [
                            "die Entwicklung zum modernen Menschen homo sapiens im Verlauf der Evolution"
                        ],
                        "tags": [
                            "von der Menschheit insgesamt"
                        ],
                        "examples": [
                            {
                                "example_id": "43e157d7-cacf-4572-bddf-97d7a09a3dab",
                                "sense_id": "a3824722-506e-3cd7-a77d-ed8dc0f60beb",
                                "text": "„Es bestätigte die bereits von Charles Darwin aufgestellte Hypothese, dass der Mensch aus Afrika stamme und leitete ein Umdenken unter den Paläoanthropologen ein, die aufgrund anderer Fossilienfunde in den 1920er-Jahren mehrheitlich der Meinung waren, die Menschwerdung habe in Asien stattgefunden.“"
                            },
                            {
                                "example_id": "90c90e25-9966-45b5-89a6-b1f73ee8f1dc",
                                "sense_id": "a3824722-506e-3cd7-a77d-ed8dc0f60beb",
                                "text": "„Die Ausstellung zur Menschwerdung im zweiten Treppenhaus des Museums gibt einen Einblick in die naturhistorische Entwicklung des Menschen.“"
                            },
                            {
                                "example_id": "13673c87-1aaf-40df-bf45-d2608eef9d17",
                                "sense_id": "a3824722-506e-3cd7-a77d-ed8dc0f60beb",
                                "text": "„Der Erfolg des Menschen begründet sich vor allem auf seine geistigen Fähigkeiten, die sich in Zuge der Menschwerdung zunehmend differenziert und gesteigert haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "cab948a5-76ef-3b61-ab89-62a7b2ee4667",
                        "entry_id": "00d607ee-141d-3d38-9c4a-18c14aeeb9d8",
                        "glosses": [
                            "Initiation, der Übergang zum vollwertigen Erwachsenenstatus"
                        ],
                        "tags": [
                            "Ethnologie",
                            "von einen einzelnen Menschen als Person"
                        ],
                        "examples": [
                            {
                                "example_id": "a797140b-3eea-45bb-a121-edb4014d04f6",
                                "sense_id": "cab948a5-76ef-3b61-ab89-62a7b2ee4667",
                                "text": "„Menschwerdung wurde dabei verstanden als Schlüsselprozess zur Entwicklung des Selbst, des Selbstgefühls, der Eigenliebe und des Selbstwerts. […] [In diesem Aufsatz] soll deutlich werden, dass Menschwerdung ein lebenslanger Prozess ist mit vielen kontinuierlichen und diskontinuierlichen Phasen, mit Krisen und Höhepunkten und mit immer wieder neuen Herausforderungen, die einen dazu einladen, sich ständig weiterzuentwickeln und sich immer wieder neu zu erfinden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "0d0a95a8-088e-3f90-b1dc-44a8e9918785",
                        "entry_id": "00d607ee-141d-3d38-9c4a-18c14aeeb9d8",
                        "glosses": [
                            "der geistig-moralische Fortschritt der Menschen in der Überwindung von Wahn und Gewalt (der mit der Evolution einhergeht; auch religiös gebraucht)"
                        ],
                        "tags": [
                            "von der Menschheitsgeschichte"
                        ],
                        "examples": [
                            {
                                "example_id": "8ca73291-b3de-4422-b8cb-12ea0aa8c4ab",
                                "sense_id": "0d0a95a8-088e-3f90-b1dc-44a8e9918785",
                                "text": "Wie lange gibt es noch solche Kriege und Gräueltaten? Wann werden die Menschen endlich Menschen werden? Wie viele Jahre werden noch bis zu unserer Menschwerdung vergehen?"
                            },
                            {
                                "example_id": "80d12140-080d-4ab1-87b2-20927a5ee835",
                                "sense_id": "0d0a95a8-088e-3f90-b1dc-44a8e9918785",
                                "text": "„Wenn also Jesu Himmelreich-Strategie in der radikalen Verwirklichung der Liebesgebote lag, war seine Heilstaktik in der ‚besseren Gerechtigkeit‘ zu finden, die die Methode liefern sollte, um vorerst alle zwischenmenschlichen Feindseligkeiten aus der Welt zu schaffen. Dieses messianische Programm für die wahre Menschwerdung der Zweifüßler – im Sinne würdiger Träger von Gottes Ebenbild – wird hierauf an Hand der sechs sogenannten ‚Antithesen‘ (Mt 5,21-48) verdeutlicht.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "8db7c0ff-85f0-341f-97ce-86de0764b6eb",
                        "entry_id": "00d607ee-141d-3d38-9c4a-18c14aeeb9d8",
                        "glosses": [
                            "Inkarnation Gottes in Jesus Christus"
                        ],
                        "tags": [
                            "von Gott"
                        ],
                        "examples": [
                            {
                                "example_id": "d710b786-9da9-4edd-8238-e7ff9d654eeb",
                                "sense_id": "8db7c0ff-85f0-341f-97ce-86de0764b6eb",
                                "text": "Christen feiern an Weihnachten die Menschwerdung Gottes – das einmalige Ereignis, dass der ewige Gott Vater sich in die Zerbrechlichkeit eines Kindes begeben hat, um aus Liebe die Menschen zu retten."
                            }
                        ],
                        "sense_index_json": "\"4\""
                    },
                    {
                        "sense_id": "edbdd169-26e5-3336-8123-cc28dfea1df7",
                        "entry_id": "00d607ee-141d-3d38-9c4a-18c14aeeb9d8",
                        "glosses": [
                            "die Reinkarnation (Wiedergeburt) der Menschen"
                        ],
                        "tags": [
                            "Buddhismus",
                            "Hinduismus"
                        ],
                        "examples": [
                            {
                                "example_id": "82f56f39-6edb-4db1-842f-9a507fc91abf",
                                "sense_id": "edbdd169-26e5-3336-8123-cc28dfea1df7",
                                "text": "Der Hinduismus kennt die Menschwerdung in seiner Lehre vom Avatara."
                            }
                        ],
                        "sense_index_json": "\"5\""
                    },
                    {
                        "sense_id": "d16d1d7a-e4df-3158-9e7d-e5467c0baf94",
                        "entry_id": "00d607ee-141d-3d38-9c4a-18c14aeeb9d8",
                        "glosses": [
                            "der Zeitpunkt der Befruchtung, in dem ein Mensch mit all seinen Rechten entsteht"
                        ],
                        "tags": [
                            "Jura"
                        ],
                        "examples": [
                            {
                                "example_id": "a4fb6ca6-2cd1-4f26-a3a3-64def8d6c3db",
                                "sense_id": "d16d1d7a-e4df-3158-9e7d-e5467c0baf94",
                                "text": "Der genaue Zeitpunkt der Menschwerdung ist natürlich in der Abtreibungsdiskussion äußerst relevant."
                            }
                        ],
                        "sense_index_json": "\"6\""
                    }
