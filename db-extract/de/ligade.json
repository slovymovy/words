                "senses": [
                    {
                        "sense_id": "b050de89-ded7-3166-833d-91713a7a9d60",
                        "entry_id": "3decaf22-87b5-35df-8bb6-f1001f411912",
                        "glosses": [
                            "Beiseitedrücken der gegnerischen Klinge"
                        ],
                        "tags": [
                            "Fechtsport"
                        ],
                        "examples": [
                            {
                                "example_id": "277e176d-eec3-41e4-827f-1498e8271a92",
                                "sense_id": "b050de89-ded7-3166-833d-91713a7a9d60",
                                "text": "„Für einen sicheren Beweis, daß es wirklich eine Ligade war, gilt, daß die Klinge zu Boden fällt, und daß man das bei einer Ligade gewöhnliche Streichen vernimmt. Es ist aber auch der Wille des Ligierenden dabei erforderlich.“"
                            },
                            {
                                "example_id": "2019632e-7e6b-46a4-8303-dcef0252c96d",
                                "sense_id": "b050de89-ded7-3166-833d-91713a7a9d60",
                                "text": "„Die Ligade wird als stärkeres Mittel, sich Blöße zu verschaffen, gebraucht, oder um dem Gegner das Rappier ganz aus der Hand zu werfen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
