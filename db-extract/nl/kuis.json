        "nl-extract.jsonl": [
            {
                "entry_id": "9da8c5b8-de14-351a-93fa-66bb7881aa1d",
                "word": "kuis",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "38ccff17-9c3b-3656-86b7-6dd2993b4d82",
                        "entry_id": "9da8c5b8-de14-351a-93fa-66bb7881aa1d",
                        "glosses": [
                            "seksueel ingetogen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "948901e2-795e-4387-8f4f-a13ac151b247",
                                "sense_id": "38ccff17-9c3b-3656-86b7-6dd2993b4d82",
                                "text": "Je bent kuis wanneer je je seksualiteit bewust hebt aangenomen en goed in je persoonlijkheid hebt geïntegreerd."
                            },
                            {
                                "example_id": "c6ead80a-5084-46ed-9de9-cdd0439cec79",
                                "sense_id": "38ccff17-9c3b-3656-86b7-6dd2993b4d82",
                                "text": "Ze wekte de indruk van een soort kuise elegantie, of ze die tactiek nu zelf had gekozen of dat ze wijze raad van haar verdediger had gekregen."
                            }
                        ]
                    },
                    {
                        "sense_id": "67f2d419-4682-3d60-b281-4b64a96c3d2a",
                        "entry_id": "9da8c5b8-de14-351a-93fa-66bb7881aa1d",
                        "glosses": [
                            "rein, schoon, zindelijk, zuiver"
                        ],
                        "tags": [
                            "Vlaams"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1d45cc33-469b-4cd8-929b-aed71d6471b4",
                        "source_entry_id": "9da8c5b8-de14-351a-93fa-66bb7881aa1d",
                        "target_lang_word": "keusch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "keusch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f7d05af3-8516-35cd-b781-5fa09a468a10",
                                        "entry_id": "67ee5ebb-3009-3435-ad52-5691bc596940",
                                        "glosses": [
                                            "sexuell enthaltsam"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f86d06da-d30f-4f22-ac16-9cdeacc9b1a8",
                                                "sense_id": "f7d05af3-8516-35cd-b781-5fa09a468a10",
                                                "text": "Katholische Priester sollen ein keusches Leben führen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "017b45ff-696f-3d17-ba60-6ceb53d2cd75",
                                        "entry_id": "67ee5ebb-3009-3435-ad52-5691bc596940",
                                        "glosses": [
                                            "bestimmten moralischen Bedingungen entsprechend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2ccea35-ad86-4c61-bb47-3ab6f66f8b99",
                                                "sense_id": "017b45ff-696f-3d17-ba60-6ceb53d2cd75",
                                                "text": "„Und Zweifel mich ergriff: - sind das die keuschen, Die blumenkeuschen Lippen von Maria?“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ab6d5c43-becc-4a13-8af8-9eff4e79f491",
                        "source_entry_id": "9da8c5b8-de14-351a-93fa-66bb7881aa1d",
                        "target_lang_word": "chaste",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chaste",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "02390744-10f9-3dea-9552-2249d87cde25",
                                        "entry_id": "c7c87b67-5720-3fa5-ade0-4a986e225b2a",
                                        "glosses": [
                                            "Synonym of pure and virtuous, particularly",
                                            "Sexually pure, abstaining from immoral or unlawful sexual intercourse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "528e41bf-aaf7-46cb-ab5f-603c38f8544d",
                                                "sense_id": "02390744-10f9-3dea-9552-2249d87cde25",
                                                "text": "When we consider the great excellence of chaste wedlock, Venerable Brethren, it appears all the more regrettable that particularly in our day we should witness this divine institution often scorned and on every side degraded."
                                            },
                                            {
                                                "example_id": "3356cff4-aebc-40c4-9d56-ed5b955eb16f",
                                                "sense_id": "02390744-10f9-3dea-9552-2249d87cde25",
                                                "text": "Theirs was a chaste marriage, loving and content."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7de97527-5047-3e34-9313-c3f56653fdb6",
                                        "entry_id": "c7c87b67-5720-3fa5-ade0-4a986e225b2a",
                                        "glosses": [
                                            "Synonym of pure and virtuous, particularly",
                                            "Synonym of celibate, abstaining from any sexual intercourse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30ca2ffb-fc72-4c60-baab-e578ff367962",
                                                "sense_id": "7de97527-5047-3e34-9313-c3f56653fdb6",
                                                "text": "Theirs was a chaste marriage, cold and sexless."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3067bd4f-79d7-330a-8134-2f6ee559d769",
                                        "entry_id": "c7c87b67-5720-3fa5-ade0-4a986e225b2a",
                                        "glosses": [
                                            "Synonym of pure and virtuous, particularly",
                                            "Synonym of virginal, innocent, having or providing no sexual knowledge or experience."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7efb4442-81c5-42ec-a270-224240f0b323",
                                                "sense_id": "3067bd4f-79d7-330a-8134-2f6ee559d769",
                                                "text": "Then way what loſſe your honor may ſuſtaine\n If with too credent eare you liſt his ſongs\n Or looſe your hart, or your chaſt treaſure open\n To his vnmaſtred importunity."
                                            },
                                            {
                                                "example_id": "c2cedfaa-04d6-4741-937d-bbcd9dfce018",
                                                "sense_id": "3067bd4f-79d7-330a-8134-2f6ee559d769",
                                                "text": "Her upbringing had been so chaste that her first experience French kissing ended in a panicked dash to the Piggly Wiggly to buy a home pregnancy test, just in case."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59e4b6d3-5568-3964-8fd9-fbccf01a2ad2",
                                        "entry_id": "c7c87b67-5720-3fa5-ade0-4a986e225b2a",
                                        "glosses": [
                                            "Synonym of pure and virtuous, particularly",
                                            "Synonym of modest, particularly (sexism) in reference to behavior expected of sexually pure women."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "321fec06-d4ce-4d65-a69e-96adebae3cc7",
                                                "sense_id": "59e4b6d3-5568-3964-8fd9-fbccf01a2ad2",
                                                "text": "... but the cars of chaste women have either coverings thrown over them, or white sheets hung over; for instance, on the cars of the female part of the family of the deceased Nawabs Khanduran and Muzaffar Khan, there used generally to be fastened thick dirty white cloths, and in like manner also on their palanquins—although one brother was the chief treasurer, and the other a commander of seven thousand men. And most assuredly this is a requirement of modesty; for one whose palanquin or cart is turned out with much splendour, verily the idea comes to the minds of the sight-seers and common people, that in it there must be some lovely one, bright as the morning, the envy of the fairies. Hence, for the cars or palanquins for women to ride in to be greatly embroidered is, in the opinion of certain men of standing, who are worthy to be trusted, of great infamy."
                                            },
                                            {
                                                "example_id": "cc8eb090-ba7b-4031-9722-a67778ce2cf4",
                                                "sense_id": "59e4b6d3-5568-3964-8fd9-fbccf01a2ad2",
                                                "text": "I ask again what reason could a chaste woman possibly have for being out so late? and in that part of town?\n Your Honor, we repeat our motion that you recuse yourself from this case."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ba78d6f-2c38-3f40-ab4f-5950a56811e6",
                                        "entry_id": "c7c87b67-5720-3fa5-ade0-4a986e225b2a",
                                        "glosses": [
                                            "Synonym of pure and virtuous, particularly",
                                            "Synonym of austere, plain, unextravagant, particularly demure, sexually discreet."
                                        ],
                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2960c9c-78a9-406a-b223-3734c2c63aef",
                                                "sense_id": "6ba78d6f-2c38-3f40-ab4f-5950a56811e6",
                                                "text": "The chaste style of most early modern novels is elegant but intensely boring, particularly for teenagers too inexperienced to effectively read between the lines."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
