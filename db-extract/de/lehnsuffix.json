                "senses": [
                    {
                        "sense_id": "570843e2-cc9a-3f59-b28f-0cc1278f3a68",
                        "entry_id": "76518756-c01f-3cc2-b67c-b92e9501e464",
                        "glosses": [
                            "Suffix, das aus einer anderen Sprache übernommen wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aad21187-e4ad-4835-8c7e-517f5cf4f165",
                                "sense_id": "570843e2-cc9a-3f59-b28f-0cc1278f3a68",
                                "text": "„Neben den Bildungsmitteln muttersprachlicher Herkunft sind eine ganze Reihe von Lehnsuffixen (mit nicht geringer Produktivität) zu nennen: -age, -alie, -enz, -ion, -ismus, -tät, -ur und andere.“"
                            },
                            {
                                "example_id": "0609ba31-412f-4ce9-ba4c-c3b5b6da146a",
                                "sense_id": "570843e2-cc9a-3f59-b28f-0cc1278f3a68",
                                "text": "Zum Suffix -er: „Wann ist dieses wichtigste und älteste Lehnsuffix dem Deutschen gewonnen worden?“"
                            },
                            {
                                "example_id": "23ba0403-fe94-4de3-bc7e-c129cc462020",
                                "sense_id": "570843e2-cc9a-3f59-b28f-0cc1278f3a68",
                                "text": "„Das Suffix {ai} wurde im Mittelhochdeutschen aus dem Französischen (zum Beispiel mittelhochdeutsch profezie) als Lehnsuffix übernommen und gehört für diese Sprachepoche des Deutschen zu den sekundärsprachlichen Formationsmorphemen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
