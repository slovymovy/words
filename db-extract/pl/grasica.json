                    {
                        "translation_id": "a838a3df-dab4-41dd-b253-95d5b811e637",
                        "source_entry_id": "3083820e-95a2-3acc-bf0f-a00db2f7cbdc",
                        "source_sense_id": "b4549ad5-cc35-3196-9bcc-252e478c4111",
                        "target_lang_word": "Bries",
