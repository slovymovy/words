                "senses": [
                    {
                        "sense_id": "e9e2f9ab-0f9b-3d94-a336-a71b1c1034f4",
                        "entry_id": "b2535e4a-4fc1-3253-a915-0088e6c32a71",
                        "glosses": [
                            "vorgezogene Abschlussprüfung, um zum Militär einberufenen Schülern/Studenten einen Abschluss ihrer Ausbildung vor/bald nach Dienstantritt zu ermöglichen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08177174-f591-414d-8d8f-83c475c100fb",
                                "sense_id": "e9e2f9ab-0f9b-3d94-a336-a71b1c1034f4",
                                "text": "„Wir waren Schüler des Lehrerseminars, und für uns hat es kein Notexamen gegeben.“"
                            },
                            {
                                "example_id": "8014ad04-8f73-44ee-bbcf-5b8ec1806401",
                                "sense_id": "e9e2f9ab-0f9b-3d94-a336-a71b1c1034f4",
                                "text": "„Viele Kriegsfreiwilligen melden sich bei den Meldestellen, Schüler und höhere Klassen können Notexamina ablegen.“"
                            },
                            {
                                "example_id": "6c66e4f3-2462-45ae-a375-f04d7b093abe",
                                "sense_id": "e9e2f9ab-0f9b-3d94-a336-a71b1c1034f4",
                                "text": "„Nach der Volksschule besuchte er zunächst das katholische Lehrerseminar, ehe er 1916 nach einem Notexamen als Soldat eingezogen wurde und 1917 an die Westfront kam.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
