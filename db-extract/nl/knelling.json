                        ],
                        "examples": [
                            {
                                "example_id": "3e9ebd7b-eadc-4629-b407-bdbceabebe3a",
                                "sense_id": "27abe64a-00b3-39de-8389-125b754ef549",
                                "text": "Technische beroepen blijven de lijst van knelpuntberoepen domineren. In de top tien lijst van knelpuntberoepen van de VDAB staan negen technische jobs. En bij zo goed als allemaal wordt de ‘knelling’ alleen maar groter."
                            }
                        ]
                    }
