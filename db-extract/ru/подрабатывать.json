                ],
                "senses": [
                    {
                        "sense_id": "1b602635-2da8-3ceb-9605-9808bc52c445",
                        "entry_id": "bb45cc08-dd58-396c-addf-e3592c2dcb91",
                        "glosses": [
                            "разг. зарабатывать деньги вне основного места работы"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7a00549-7e56-4a6b-a7cb-8041e8b3465a",
                                "sense_id": "1b602635-2da8-3ceb-9605-9808bc52c445",
                                "text": "Ирина бы́стро сориентировалась и ста́ла подраба́тывать на сосе́дних да́чах. Виктория Токарева. Своя правда «Новый Мир», № 9, 2002]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "421a3046-3fa7-4769-bfe6-747c39ffd128",
                        "source_entry_id": "bb45cc08-dd58-396c-addf-e3592c2dcb91",
                        "source_sense_id": "1b602635-2da8-3ceb-9605-9808bc52c445",
                        "target_lang_word": "moonlight",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "moonlight",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a76de490-eecb-3451-b0d2-40044e7652bd",
                                        "entry_id": "f5fc65b4-2f06-39e1-b097-6256a1fedeb0",
                                        "glosses": [
                                            "The light reflected from the Moon."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "sometimes",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "407db1cb-4e85-46c9-8242-88e951f77798",
                                                "sense_id": "a76de490-eecb-3451-b0d2-40044e7652bd",
                                                "text": "If you will patiently dance in our round / And see our moonlight revels, go with us; / If not, shun me, and I will spare your haunts."
                                            },
                                            {
                                                "example_id": "f8b77519-66aa-47d3-9826-b31d0322d385",
                                                "sense_id": "a76de490-eecb-3451-b0d2-40044e7652bd",
                                                "text": "How sweet the moonlight sleeps upon this bank! / Here will we sit and let the sounds of music / Creep in our ears: soft stillness and the night / Become the touches of sweet harmony."
                                            },
                                            {
                                                "example_id": "94fc4d7b-0761-4873-a100-54859b192d96",
                                                "sense_id": "a76de490-eecb-3451-b0d2-40044e7652bd",
                                                "text": "[…] the sight of the blade which glistened by moonlight in his face, checked, in some sort, the ardour of his assailant […]"
                                            },
                                            {
                                                "example_id": "4c19a32d-5014-4d7f-b817-2abbded822c7",
                                                "sense_id": "a76de490-eecb-3451-b0d2-40044e7652bd",
                                                "text": "’Tis eight o’clock,—a clear March night, / The moon is up,—the sky is blue, / The owlet, in the moonlight air, / Shouts from nobody knows where;"
                                            },
                                            {
                                                "example_id": "73595654-a3eb-492d-89a9-5d22ab210607",
                                                "sense_id": "a76de490-eecb-3451-b0d2-40044e7652bd",
                                                "text": "It was the pensive oysterman that saw a lovely maid, / Upon a moonlight evening, a-sitting in the shade;"
                                            },
                                            {
                                                "example_id": "6f7d6ead-5f64-4012-aed2-ae8d60b7480e",
                                                "sense_id": "a76de490-eecb-3451-b0d2-40044e7652bd",
                                                "text": "[S]he passed away noiselessly, and the moonlight kissed the wall which her shadow had dimmed."
                                            },
                                            {
                                                "example_id": "50019ceb-f58c-4ac6-a8a3-b1b1a405abd1",
                                                "sense_id": "a76de490-eecb-3451-b0d2-40044e7652bd",
                                                "text": "What say you, gentlemen, shall we have a moonlight hunt?"
                                            },
                                            {
                                                "example_id": "fd2349a0-adfc-456c-8d52-623af1475389",
                                                "sense_id": "a76de490-eecb-3451-b0d2-40044e7652bd",
                                                "text": "The windows were curtainless, and the yellow moonlight, flooding in through the diamond panes, enabled one to see even colours, whilst it softened the wealth of dust which lay over all and disguised in some measure the ravages of time and the moth."
                                            },
                                            {
                                                "example_id": "39420950-82ef-480b-9605-52209da0eafa",
                                                "sense_id": "a76de490-eecb-3451-b0d2-40044e7652bd",
                                                "text": "They were still under the white plum tree and their faces were touching except for a pale thin ray of moonlight between."
                                            },
                                            {
                                                "example_id": "41d29f0b-e5d0-4daa-9b8e-89a313848d0f",
                                                "sense_id": "a76de490-eecb-3451-b0d2-40044e7652bd",
                                                "text": "It [the Arkenstone] was as if a globe had been filled with moonlight and hung before them in a net woven of the glint of frosty stars."
                                            },
                                            {
                                                "example_id": "ae4c4381-13ff-421e-badb-3f77c444fa26",
                                                "sense_id": "a76de490-eecb-3451-b0d2-40044e7652bd",
                                                "text": "1957, Sylvia Dee, “Moonlight Swim” (song recorded by Nick Noble and Elvis Presley),\nLet’s go on a moonlight swim / Far away from the crowd / All alone upon the beach / Our lips and our arms / Close within each other’s reach / Will be on a moonlight swim"
                                            },
                                            {
                                                "example_id": "09041c21-e9c3-437b-ab7c-d695a5a432a7",
                                                "sense_id": "a76de490-eecb-3451-b0d2-40044e7652bd",
                                                "text": "On a moonlight night it would be different. The happy voices of children playing in open fields would then be heard. And perhaps those not so young would be playing in pairs in less open places, and old men and women would remember their youth."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "moonlight",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c6d30623-0f31-37f7-b2bd-69cfa0192b07",
                                        "entry_id": "3e00be22-6403-323f-9b2a-e8e5b66fcddc",
                                        "glosses": [
                                            "To work on the side (at a secondary job), often in the evening or during the night."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "888f310b-3649-4e11-a8fd-91fb9425f59c",
                                                "sense_id": "c6d30623-0f31-37f7-b2bd-69cfa0192b07",
                                                "text": "There are three individual rear seats. They all slide, they all fold, or they can all be removed completely, so that you can moonlight as a van."
                                            },
                                            {
                                                "example_id": "c4a0a75d-c182-4ef9-b97d-6c313025e955",
                                                "sense_id": "c6d30623-0f31-37f7-b2bd-69cfa0192b07",
                                                "text": "Investigators discover that Captain Ospina was forced to take a second job, moonlighting in a bar, in order to make ends meet for his family."
                                            },
                                            {
                                                "example_id": "7080cbc3-55c2-452a-bd33-faef0eb1a836",
                                                "sense_id": "c6d30623-0f31-37f7-b2bd-69cfa0192b07",
                                                "text": "Believing the bones to belong to a cave bear, the quarry owner passed them on to a local schoolteacher, Johann Carl Fuhlrott, who moonlighted as a fossilist."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f7c9330-558b-315a-b77a-1de656f8368d",
                                        "entry_id": "3e00be22-6403-323f-9b2a-e8e5b66fcddc",
                                        "glosses": [
                                            "To engage in an activity other than what one is known for."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d3157f5-82dc-4348-a85c-c5a8d1e0e7fa",
                                                "sense_id": "3f7c9330-558b-315a-b77a-1de656f8368d",
                                                "text": "Mr. Katzenberg, who moonlights as a top Biden official and has worked with Mr. Clooney on philanthropy for decades, reached out to him to see if there was an off-ramp, according to three people familiar with the matter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8934053e-3154-37c0-997d-2aeafb4809e1",
                                        "entry_id": "3e00be22-6403-323f-9b2a-e8e5b66fcddc",
                                        "glosses": [
                                            "To perform a secondary function substantially different from its supposed primary function, as in protein moonlighting."
                                        ],
