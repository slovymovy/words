                        "target_lang_word": "wagenmaker",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wagenmaker",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "6a3f461c-d6f0-3287-9b3f-1eb65e38edb4",
                                        "entry_id": "7fb687c4-522d-37d9-a5c5-f1de5ee6d4c4",
                                        "glosses": [
                                            "persoon die (paarden)wagens maakt"
                                        ],
                                        "tags": [
                                            "beroep"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc6567ae-7269-4044-b8d8-a78d42b00759",
                                                "sense_id": "6a3f461c-d6f0-3287-9b3f-1eb65e38edb4",
                                                "text": "Zeeschuim, gedroogde tongevellen, die als het strand roken, waren bij de voddenkoopman, bij alle drogisten verkrijgbaar en meubel- of wagenmakers gebruikten voor het gladmaken van hout 'haaievel' dat zoo hard was als een rasp."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34fbbc9c-92bd-3f81-95b8-debd9e350089",
                                        "entry_id": "7fb687c4-522d-37d9-a5c5-f1de5ee6d4c4",
                                        "glosses": [
                                            "persoon die (paarden)wagens repareert"
                                        ],
                                        "tags": [
                                            "beroep"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "07c54d4c-7e8e-4547-9c33-c8abc40da456",
                        "source_entry_id": "8b7bbbd9-f9d4-3064-adb7-12438a833e0c",
                        "source_sense_id": "bc4573de-5ba5-3545-8d42-a617a3556696",
                        "source_sense_description": "maker of wagons",
                        "target_lang_word": "Wagner",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wagner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ef83675f-c3ca-3e79-a6e3-03a37ab3adb3",
                                        "entry_id": "6aab5a9c-2f2b-3201-95d6-cf2383a45735",
                                        "glosses": [
                                            "Handwerker, der aus Holz Wagen oder Teile davon fertigt"
                                        ],
                                        "tags": [
                                            "South-German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10145b6c-750b-4fe5-9483-cf38facec036",
                                                "sense_id": "ef83675f-c3ca-3e79-a6e3-03a37ab3adb3",
                                                "text": "Im Zeitalter der Postkutschen war der Beruf des Wagners von großer Bedeutung."
                                            },
                                            {
                                                "example_id": "5779f00a-435c-42c5-956e-eaf10c2f149c",
                                                "sense_id": "ef83675f-c3ca-3e79-a6e3-03a37ab3adb3",
                                                "text": "Er ist mit einem zerbrochenen Rad zum Wagner gegangen."
                                            },
                                            {
                                                "example_id": "d82c4153-1967-45f8-b579-1490fb0ed4f3",
                                                "sense_id": "ef83675f-c3ca-3e79-a6e3-03a37ab3adb3",
                                                "text": "„Daß die Kelten hervorragende Zimmerleute, Schreiner, Drechsler und Wagner waren, läßt sich trotzdem an Werkzeugfunden sowie an bearbeiteten Holzresten nachweisen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2b8fe823-02d9-3dc7-9361-1bbdf381e749",
                                        "entry_id": "6aab5a9c-2f2b-3201-95d6-cf2383a45735",
                                        "glosses": [
                                            "Fuhrmann, Wagenlenker"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb7b02b2-1eaa-4239-8535-c042b2cd1081",
                                                "sense_id": "2b8fe823-02d9-3dc7-9361-1bbdf381e749",
                                                "text": "Der Wagner hielt an."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Wagner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3b3e667f-509b-3cc1-a043-31f159a829ad",
                                        "entry_id": "916bb3bd-db0f-3beb-8c22-e45acb838a3e",
                                        "glosses": [
                                            "deutschsprachiger Nachname, Familienname; belegt derzeit Platz 7 in der Liste der 100 häufigsten Familiennamen in Deutschland."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61dfd260-6e52-43f1-ab9c-050b353f997f",
                                                "sense_id": "3b3e667f-509b-3cc1-a043-31f159a829ad",
                                                "text": "Frau Wagner ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "4858ca82-2a19-4d4a-8e67-51240c18abd9",
                                                "sense_id": "3b3e667f-509b-3cc1-a043-31f159a829ad",
                                                "text": "Herr Wagner wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "00c81f7c-2f8a-4a83-ade8-a14097f8df64",
                                                "sense_id": "3b3e667f-509b-3cc1-a043-31f159a829ad",
                                                "text": "Die Wagners fliegen heute nach Kanada."
                                            },
                                            {
                                                "example_id": "d18846b1-25a5-4708-8398-4cdfa8d6ceaa",
                                                "sense_id": "3b3e667f-509b-3cc1-a043-31f159a829ad",
                                                "text": "Der Wagner trägt nie die Pullover, die die Wagner ihm strickt."
                                            },
                                            {
                                                "example_id": "f4a9343a-8499-4b4b-ad43-2dc9dd8af334",
                                                "sense_id": "3b3e667f-509b-3cc1-a043-31f159a829ad",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Wagner kommt, geht der Herr Wagner.“"
                                            },
                                            {
                                                "example_id": "d7b4499a-c1be-438a-957c-f8a29dfe5a1b",
                                                "sense_id": "3b3e667f-509b-3cc1-a043-31f159a829ad",
                                                "text": "Wagner kommt und geht."
                                            },
                                            {
                                                "example_id": "991e63f0-a3e5-44f5-9a10-32988c490478",
                                                "sense_id": "3b3e667f-509b-3cc1-a043-31f159a829ad",
                                                "text": "Wagners kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "baaca884-a45d-4eae-bc7a-3c15179b2958",
                        "source_entry_id": "8b7bbbd9-f9d4-3064-adb7-12438a833e0c",
                        "source_sense_id": "bc4573de-5ba5-3545-8d42-a617a3556696",
                        "source_sense_description": "maker of wagons",
                        "target_lang_word": "Stellmacher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stellmacher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a1645e60-e65a-32c4-87b3-d8793b1ca48d",
                                        "entry_id": "d6815752-a01b-3d33-a873-d9d5ea80961e",
                                        "glosses": [
                                            "Handwerker, der hölzerne Bauteile für Fahrzeuge (zum Beispiel: Kutschen) herstellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2034d40c-09f5-45fb-b6e6-6d0740e57140",
                                                "sense_id": "a1645e60-e65a-32c4-87b3-d8793b1ca48d",
                                                "text": "„Diesem Wagen zimmert der Stellmacher ein Dachgerüst, über das der Teppich aus der Bibliothek gespannt wird.“"
                                            },
                                            {
                                                "example_id": "ae58b972-4bb0-4b39-8733-c73e038f8f91",
                                                "sense_id": "a1645e60-e65a-32c4-87b3-d8793b1ca48d",
                                                "text": "„Ein Stellmacher erschien, untersuchte meinen Wagen und fand, daß eine Achse gebrochen war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
