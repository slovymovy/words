                    {
                        "translation_id": "ece77690-2b5e-4fa2-8f22-bbeb807e38f1",
                        "source_entry_id": "35714f4d-6bf7-38af-b686-e85be5d29d13",
                        "source_sense_id": "e37a2173-80fe-3a0b-b22a-14896f7efd29",
                        "source_sense_description": "study of the endocrine glands",
                        "target_lang_word": "эндокриноло́гия",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "эндокриноло́гия",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "2848815d-ea7d-3912-804f-55c034778aae",
                                        "entry_id": "582f1406-d762-36e2-a85a-765c7544423d",
                                        "glosses": [
                                            "наука о строении и функции желёз внутренней секреции (эндокринных желез), вырабатываемых ими гормонах, путях их образования и действия на организм животных и человека"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e8e2d17-65d4-49d7-99e8-11db9d7d0ee8",
                                                "sense_id": "2848815d-ea7d-3912-804f-55c034778aae",
                                                "text": ".. в результате работ Кохера и др. над патологией щитовидной железы, перед глазами исследователей открылась обширная группа фактов, положившая основание для новой науки — эндокринологии."
                                            },
                                            {
                                                "example_id": "b0e3d68b-4402-4f7c-93b7-5f766dfba398",
                                                "sense_id": "2848815d-ea7d-3912-804f-55c034778aae",
                                                "text": "Синтез гормонов в лимфоцитах и клетках тимуса многие специалисты рассматривают как доказательство существования связи между эндокринной и иммунной системами. Но это ещё и весьма показательная иллюстрация современного состояния эндокринологии: нельзя сказать, что некий гормон синтезируется там-то и делает то-то. Мест его синтеза может быть много, функций тоже, и часто они зависят именно от места образования гормона."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
