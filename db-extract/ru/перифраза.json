                "senses": [
                    {
                        "sense_id": "c6bb9a8c-7fec-3f8b-a17d-49e6296d91f9",
                        "entry_id": "456ae889-5321-39d8-a7a8-170dc519857e",
                        "glosses": [
                            "филол. выражение, описательно обозначающее объект на основе выделения какого-либо его качества, признака, особенностей"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5f9e77b-beae-494a-8445-bc2d17cede5e",
                                "sense_id": "c6bb9a8c-7fec-3f8b-a17d-49e6296d91f9",
                                "text": "В то же время под перифразированием в таких пособиях обычно понимается только стилистический приём, традиционно обозначаемый как перифраза (парафраза, перифраз)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e0149782-d418-48e6-87a1-6e8951e25bb2",
                        "source_entry_id": "456ae889-5321-39d8-a7a8-170dc519857e",
                        "source_sense_id": "c6bb9a8c-7fec-3f8b-a17d-49e6296d91f9",
                        "target_lang_word": "periphrasis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "periphrasis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9ca98c00-991f-3806-a8ce-a42c3b3d57b5",
                                        "entry_id": "1dcee62b-e6ae-37f0-8466-e6bf29aa862a",
                                        "glosses": [
                                            "The use of a longer expression instead of a shorter one with a similar meaning, for example \\\"I am going to\\\" instead of \\\"I will\\\"."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0b8e585f-44d8-3616-b641-60bc8219685d",
                                        "entry_id": "1dcee62b-e6ae-37f0-8466-e6bf29aa862a",
                                        "glosses": [
                                            "Expressing a grammatical meaning (such as a tense) using a syntactic construction rather than morphological marking."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10dfadb4-b612-4608-b502-d1740f2e4bce",
                                                "sense_id": "0b8e585f-44d8-3616-b641-60bc8219685d",
                                                "text": "Language learners sometimes use periphrases like \"did go\" where a native speaker would use \"went\"."
                                            },
                                            {
                                                "example_id": "c02ed3e1-99df-4e05-b9a2-e0181252cbf7",
                                                "sense_id": "0b8e585f-44d8-3616-b641-60bc8219685d",
                                                "text": "Native speakers use periphrases like \"did not go\" where a language learner might use \"went not\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61c7e3a6-8aef-3595-ac32-71094496e768",
                                        "entry_id": "1dcee62b-e6ae-37f0-8466-e6bf29aa862a",
                                        "glosses": [
                                            "The substitution of a descriptive word or phrase for a proper name (a type of circumlocution)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rhetoric",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "195a7efd-3774-4def-9745-dcf6284910e6",
                                                "sense_id": "61c7e3a6-8aef-3595-ac32-71094496e768",
                                                "text": "Periphrasis a single thought expands,\nAnd uses many words for what but few demands."
                                            },
                                            {
                                                "example_id": "22e1eee4-baba-44fd-99a4-3a6071a9d0ad",
                                                "sense_id": "61c7e3a6-8aef-3595-ac32-71094496e768",
                                                "text": "The \"glen,\" or the \"brake of the lion,\" is Pindar's favourite periphrasis for Nemea."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7559ca9-4ffc-3e85-8b04-a904b1075d5d",
                                        "entry_id": "1dcee62b-e6ae-37f0-8466-e6bf29aa862a",
                                        "glosses": [
                                            "The use of a proper name as a shorthand to stand for qualities associated with it."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rhetoric",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
