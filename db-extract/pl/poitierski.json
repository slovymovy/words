                "senses": [
                    {
                        "sense_id": "6a7901dd-2473-30d0-9614-e9a92b004ec3",
                        "entry_id": "3d107429-5612-3caf-8e5b-2aab405929c2",
                        "glosses": [
                            "związany z Poitiers, dotyczący Poitiers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d651dc6-cc01-4cd0-807e-f963c9091db6",
                                "sense_id": "6a7901dd-2473-30d0-9614-e9a92b004ec3",
                                "text": "Akt poitierski był jednym z najdotkliwszych ciosów dla emigracyjnej prawicy"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e1cd69b4-a7f6-405f-a012-d5f030b2c683",
                        "source_entry_id": "3d107429-5612-3caf-8e5b-2aab405929c2",
                        "source_sense_id": "6a7901dd-2473-30d0-9614-e9a92b004ec3",
                        "target_lang_word": "poitevin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "poitevin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "520a14dd-535b-3f7a-a6d0-642616568ae4",
                                        "entry_id": "4d01fb3b-a92f-38db-a041-1e8292cea6df",
                                        "glosses": [
                                            "Ayant trait au Poitou ou à la ville de Poitiers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98961c60-23b4-43e7-8c23-0b2f10b236ac",
                                                "sense_id": "520a14dd-535b-3f7a-a6d0-642616568ae4",
                                                "text": "Mais croyez bien que chez plusieurs la richesse remplaçait avantageusement l’élégance, du moins aux yeux peu connaisseurs du public poitevin."
                                            },
                                            {
                                                "example_id": "0e91c24f-6eb2-479e-8747-876e30cc1d73",
                                                "sense_id": "520a14dd-535b-3f7a-a6d0-642616568ae4",
                                                "text": "Voilà pourquoi la Haute-Saintonge a toujours attiré des populations venues d’ailleurs, défricheurs poitevins, tâcherons auvergnats, éleveurs vendéens, résiniers landoux ou réfugiés espagnols."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "poitevin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "52a65dcb-64b7-3e48-bf1c-5bb27958d176",
                                        "entry_id": "37a17740-6b69-3348-a2f4-67201bf0103a",
                                        "glosses": [
                                            "Langue d’oïl parlée dans le Poitou et le Bas-Poitou."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "409f1c02-543c-4d75-9c13-1b4d0d210126",
                                                "sense_id": "52a65dcb-64b7-3e48-bf1c-5bb27958d176",
                                                "text": "Ai ou la fausse triphtongue eai, en un seul son, remplace dans les terminaisons le groupe français eau, auquel correspond le bourguignon et le poitevin â, éa, ià."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "poitevin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0d732d78-92bf-347a-b063-df75a996a2e5",
                                        "entry_id": "1161c6e9-8cf2-34f3-9ebf-44aa9eafd751",
                                        "glosses": [
                                            "Race de grand chien courant, originaire du Haut-Poitou en France, à poil court, brillant, tricolore."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
