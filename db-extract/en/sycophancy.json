                                    {
                                        "sense_id": "69970672-8003-38a6-88fd-8dd9742c97b7",
                                        "entry_id": "cf9ed75b-4672-3566-bea4-3900f91bc52f",
                                        "glosses": [
                                            "Vile flatterie."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "very-familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd9e470c-95c6-48da-8876-2f37adb737ec",
                                                "sense_id": "69970672-8003-38a6-88fd-8dd9742c97b7",
                                                "text": "Ayant postulé pour un emploi de facteur à la Poste, nous étions conviés, après la traditionnelle étape de lèche-culterie qu’est la lettre de motivation, à nous rendre à des tests écrits de pré-sélection."
                                            }
                                        ]
