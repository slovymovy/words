                                "sense_id": "d3fc3086-53c7-38b9-be24-4930a4548681",
                                "text": "De transparantie van dit voorwerp is groot."
                            }
                        ]
                    },
                    {
                        "sense_id": "cebe1ead-210f-33b3-bbcb-79166bf64ade",
                        "entry_id": "bb433009-6174-3f5c-9fa6-50843d82032f",
