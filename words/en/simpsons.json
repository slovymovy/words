                {
                    "sense_id": "f987f283-5eb8-3638-9f64-0be347cef66f",
                    "sense_definition": "A common clipping of the famous American animated sitcom The <w>Simpsons</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "media",
                    "name_type": "work_of_art_name",
                    "examples": [
                        {
                            "text": "I love watching the <w>Simpsons</w> on Sunday nights with my family.",
                            "target_lang_translations": {
                                "ru": "Я обожаю смотреть «<w>Симпсонов</w>» по воскресным вечерам со своей семьей."
                            }
                        },
                        {
                            "text": "Do you want to watch <w>Simpsons</w> episodes after we finish our homework?",
                            "target_lang_translations": {
                                "ru": "Хочешь посмотреть серии «<w>Симпсонов</w>» после того, как мы сделаем домашнее задание?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "watch Simpsons episodes",
                        "classic Simpsons humor"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used as a shortened title for the TV show"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Распространенное сокращенное название известного американского мультсериала «Симпсоны»."
                    },
                    "translations": {
                        "ru": [
                            {
