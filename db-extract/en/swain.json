                        "entry_id": "b5409bdd-c074-33d3-b3f0-63b878a120bf",
                        "glosses": [
                            "A young man or boy in service; a servant."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "032a1266-c23d-3175-8763-0dc34b7bc36f",
                        "entry_id": "b5409bdd-c074-33d3-b3f0-63b878a120bf",
                        "glosses": [
                            "A knight's servant; an attendant."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "66f0554f-0642-33ec-8417-699ebf327942",
                        "entry_id": "b5409bdd-c074-33d3-b3f0-63b878a120bf",
                        "glosses": [
                            "A country labourer; a countryman, a rustic."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "703c852b-e58b-48fa-a227-6d0d0241e0e8",
                                "sense_id": "66f0554f-0642-33ec-8417-699ebf327942",
                                "text": "theſe that ſeeme but ſilly country Swaines,\nMay haue the leading of so great an hoſte,\nAs with their waight ſhal make the mountains quake."
                            }
                        ]
                    },
                    {
                        "sense_id": "bece0e15-2c97-3873-a100-e9812efc9fe7",
                        "entry_id": "b5409bdd-c074-33d3-b3f0-63b878a120bf",
                        "glosses": [
                            "A rural lover; a male sweetheart in a pastoral setting."
                        ],
                        "tags": [
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "60435526-fb7c-45c6-89bb-4118a6b38796",
                                "sense_id": "bece0e15-2c97-3873-a100-e9812efc9fe7",
                                "text": "Why thus from the Plain does my Shepherdess rove\nForsaking Her Swain and neglecting his love?"
                            },
                            {
                                "example_id": "346a1f52-8f85-4f69-9c02-8957c49c86a9",
                                "sense_id": "bece0e15-2c97-3873-a100-e9812efc9fe7",
                                "text": "You're the belle of the ball, and these are all your swains, hoping for a glimpse of ankle."
                            }
                        ]
                    }
                ],
                "translations": [
