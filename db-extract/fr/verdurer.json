                "senses": [
                    {
                        "sense_id": "6fe1ab13-d18e-354a-a2c2-5cdfb679485e",
                        "entry_id": "5c683cb6-dee0-3507-a88f-1b449a083d09",
                        "glosses": [
                            "Mettre de la verdure à (un endroit)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6186e20a-bcb6-418f-80a4-c1bf9bdb4c69",
                                "sense_id": "6fe1ab13-d18e-354a-a2c2-5cdfb679485e",
                                "text": "L’utilisation d’espèces végétales prélevées dans le site à verdurer serait certes la solution la meilleure, mais actuellement pour les services publics, seul l’emploi de graines disponibles dans le commerce est possible."
                            },
                            {
                                "example_id": "8979ef3f-9ba0-4460-bbb3-6bc65b4f2464",
                                "sense_id": "6fe1ab13-d18e-354a-a2c2-5cdfb679485e",
                                "text": "On y voit l’heureuse proposition d'une série de zones de verdure à l’intérieur du Pays Noir, pour le « verdurer » et neutraliser les fumées et poussières des deux centres industriels de la vallée."
                            }
                        ]
                    },
                    {
                        "sense_id": "59239d48-d62a-392f-a17e-93a32758a777",
                        "entry_id": "5c683cb6-dee0-3507-a88f-1b449a083d09",
                        "glosses": [
                            "Devenir vert."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "6841602d-cc9f-4ae9-8c47-c9affcd55174",
                                "sense_id": "59239d48-d62a-392f-a17e-93a32758a777",
                                "text": "Les prés avaient l’air de verdir à vue d'œil, ou plutôt de verdurer, comme dit si joliment la langue de chez nous."
                            }
                        ]
                    },
