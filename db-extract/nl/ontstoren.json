                "senses": [
                    {
                        "sense_id": "9f23fbc2-7d87-3206-adad-69bad2352c94",
                        "entry_id": "dd572266-538b-3d14-9498-52594e9824d9",
                        "glosses": [
                            "ontdoen van storing; verwijderen van iets dat hindert of stoort"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd9282bc-666a-48ec-b6c8-e7f43be8dcde",
                                "sense_id": "9f23fbc2-7d87-3206-adad-69bad2352c94",
                                "text": "De boom staat op een punt waar energielijnen samenkomen. Zo'n plek ontstoren had de boom misschien kunnen redden. \"Maar misschien ook niet\", zegt Kragt."
                            },
                            {
                                "example_id": "bb1392c2-8f65-421f-932e-d2039e29d9d8",
                                "sense_id": "9f23fbc2-7d87-3206-adad-69bad2352c94",
                                "text": "Daarnaast kunnen de barstjes in de verf vaak voor weerspiegelingen zorgen als een schilderij wordt gefotografeerd, aldus de Rembrandt-kenner. Die spiegelingen kan je als het ware “ontstoren”."
                            }
                        ]
                    }
