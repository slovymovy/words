                                                "sense_id": "6efa9832-e394-3c3c-ba89-95214303e6f3",
                                                "text": "Einige Attribute dieser Figur üben eine wichtige allegorische Funktion aus."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "12413568-27e5-3c1c-95c6-e86db590c4ab",
                                        "entry_id": "d8ca109f-cb82-34e8-9bd1-994b06321c41",
                                        "glosses": [
