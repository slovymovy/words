                                        "glosses": [
                                            "που έχει σχέση με την επίθεση"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f5464e9-4d3d-4f0f-baf6-26e89ab54280",
                                                "sense_id": "0d46b1f0-e684-3def-ba6c-cc1eaa8421bb",
                                                "text": "Πώς μπορεί ο δάσκαλος να αντιμετωπίζει την επιθετική συμπεριφορά ενός μαθητή;"
                                            },
                                            {
                                                "example_id": "2076be55-9f5c-4c1a-b22a-1283af504a24",
                                                "sense_id": "0d46b1f0-e684-3def-ba6c-cc1eaa8421bb",
                                                "text": "επιθετική διαφήμιση του προϊόντος στην αγορά"
                                            },
                                            {
                                                "example_id": "7813d4b2-8e23-4209-a9cf-46920e2bcdb1",
                                                "sense_id": "0d46b1f0-e684-3def-ba6c-cc1eaa8421bb",
                                                "text": "Ο προπονητής της ομάδας είπε ότι οι παίκτες θα πρέπει να γίνουν πιο επιθετικοί."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ca85302-a951-37d0-a418-257b42a68d25",
                                        "entry_id": "41f05b33-8f91-380c-97c4-14bf189a4f54",
                                        "glosses": [
                                            "που συσχετίζεται με το επίθετο"
                                        ],
                                        "tags": [
                                            "γραμματική"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71bb6945-0f6b-4a1c-9575-b7812e8a8886",
                                                "sense_id": "3ca85302-a951-37d0-a418-257b42a68d25",
                                                "text": "επιθετικός προσδιορισμός, επιθετική μετοχή"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90ac1201-349e-3a86-9e68-0479ec5ab288",
                                        "entry_id": "41f05b33-8f91-380c-97c4-14bf189a4f54",
