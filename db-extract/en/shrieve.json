                    {
                        "sense_id": "f985fdc0-a691-36f3-ba62-4ec62bdbd88a",
                        "entry_id": "a6f6cdfe-d2e6-3535-8248-53e4d992dd65",
                        "glosses": [
                            "Obsolete form of shrive."
                        ],
                        "tags": [
                            "alt-of",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "cf62219e-4a98-4f3b-a4e7-0f2ed80f0ffd",
                                "sense_id": "f985fdc0-a691-36f3-ba62-4ec62bdbd88a",
                                "text": "[…]he ordered [father Jerome] to be called and shrieve the prisoner."
                            },
                            {
                                "example_id": "42272bb6-dd21-4f2c-8ffa-ae47c2bdf85b",
                                "sense_id": "f985fdc0-a691-36f3-ba62-4ec62bdbd88a",
                                "text": "He'll shrieve my soul, he'll wash away\nThe Albatross's blood."
                            },
                            {
                                "example_id": "dc057efd-2d5e-443a-a4e7-0cd3eba81171",
                                "sense_id": "f985fdc0-a691-36f3-ba62-4ec62bdbd88a",
                                "text": "The jealous churl hath deeply swore,\n That, if again he venture o’er,\n He shall shrieve penitent no more."
                            }
                        ]
                    },
                    {
                        "sense_id": "91f4101f-da7d-36f8-aee6-5406dd3796ad",
                        "entry_id": "a6f6cdfe-d2e6-3535-8248-53e4d992dd65",
                        "glosses": [
                            "To question."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "845f2cda-2dc2-4887-92df-d243427da520",
                                "sense_id": "91f4101f-da7d-36f8-aee6-5406dd3796ad",
                                "text": "But afterwards she gan him soft to shrieve,\nAnd wooe with fair intreatie, to disclose\nWhich of the nymphes his heart so sore did mieve:"
                            }
                        ]
                    }
