                        "glosses": [
                            "Apostasier."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "3ca41edf-87c4-4365-a473-5bb0ed2e33a8",
                                "sense_id": "5eb306d4-e517-3aa8-9041-6efcaf1f2a2d",
                                "text": "Si votre Auteur eût été tant soit peu nourri en l’ancienneté de notre Religion, il eût trouvé que ce n’étoit pas apostoliser, mais bien apostatiser, que lui Religieux voulût comme les Apôtres administrer les saints Sacremens même au milieu des Villes, revêtus d’un habillement qui n’a rien de commun avec les autres Moines."
                            }
                        ]
