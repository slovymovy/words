                "senses": [
                    {
                        "sense_id": "369abbbb-fa2f-37d4-85b1-84ea69f9f810",
                        "entry_id": "d14e6649-9851-3dac-81da-60f5dea0a5f0",
                        "glosses": [
                            "Se priver soi-même du droit de protéger quelque chose en le divulguant avant de faire la demande de protection."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1972ea30-9ca8-41f0-babb-9c1a83274530",
                                "sense_id": "369abbbb-fa2f-37d4-85b1-84ea69f9f810",
                                "text": "Dans le domaine des brevets, cela ne fonctionne pas ainsi : on dit que vous vous êtes auto-antériorisés et que vous ne pouvez plus déposer de nouvelles demandes."
                            },
                            {
                                "example_id": "5a5ca8d0-a500-4770-8d56-4d8bf68a8e77",
                                "sense_id": "369abbbb-fa2f-37d4-85b1-84ea69f9f810",
                                "text": "Il est tout à fait possible de s'auto-antériorisé, la preuve."
                            }
                        ]
                    }
