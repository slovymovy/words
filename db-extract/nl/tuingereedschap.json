                        "examples": [
                            {
                                "example_id": "dc5e249e-6b73-4241-93e5-c9e20e3b7bec",
                                "sense_id": "badb8859-c39e-3f74-9926-17231202894b",
                                "text": "Het oog onderscheidde ordeloos rondslingerende gieters en tuingereedschap."
                            },
                            {
                                "example_id": "9ffe1ff4-5b3a-43be-88b2-b92332808d61",
                                "sense_id": "badb8859-c39e-3f74-9926-17231202894b",
                                "text": "Sieraden zijn gedaald van 2 naar 5. De cd en de dvd, tien jaar geleden nog hoog in de top-10, zijn daar nu uit verdwenen. Ervoor in de plaats komen onder andere accessoires voor de mobiele telefoon (hoesje, autohouder, opzetcameraatje), die in 2008 nog niet gevraagd werden. Nieuw is ook gereedschap, waarbij opvalt dat vrouwen overwegend tuingereedschap vragen."
                            }
