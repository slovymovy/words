                                                "text": "Note. Ce sens est désuet, mais persiste dans la locution rayer des contrôles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94b6f1f8-03a8-3fad-b21f-ef53031f130e",
                                        "entry_id": "d0f3c865-65be-39fc-b904-1b2e2f9aeb23",
                                        "glosses": [
                                            "Marque qu’on imprime sur les ouvrages d’or et d’argent, pour faire foi qu’ils ont payé les droits et qu’ils sont au titre fixé par la loi."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba4246d1-e5a6-435b-b1a5-2a2849bd071d",
                                                "sense_id": "94b6f1f8-03a8-3fad-b21f-ef53031f130e",
                                                "text": "Cette pièce de vaisselle est suspecte, elle n’a pas le contrôle."
                                            },
                                            {
                                                "example_id": "0750a2b8-bb0d-463e-a2d5-f79513955244",
                                                "sense_id": "94b6f1f8-03a8-3fad-b21f-ef53031f130e",
                                                "text": "Tous les ouvrages d’orfèvrerie sont soumis au contrôle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7819cc6-5ea4-3935-8d68-cad89330d0a4",
                                        "entry_id": "d0f3c865-65be-39fc-b904-1b2e2f9aeb23",
                                        "glosses": [
                                            "Vérification."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65143549-b32c-46fc-adbc-f06d1825f30d",
                                                "sense_id": "e7819cc6-5ea4-3935-8d68-cad89330d0a4",
                                                "text": "L’étiquetage est utile pour veiller à l’application de la législation, assurer la traçabilité et effectuer des contrôles."
                                            },
                                            {
                                                "example_id": "b0154d69-1564-418c-8f40-117d2adf6d7f",
                                                "sense_id": "e7819cc6-5ea4-3935-8d68-cad89330d0a4",
                                                "text": "Pourquoi certains contrôles techniques sont-ils imposés tyranniquement à certains constructeurs et non à d’autres ?"
                                            },
                                            {
                                                "example_id": "9e18ae20-dfba-4e69-8a07-3eed324b3ef4",
                                                "sense_id": "e7819cc6-5ea4-3935-8d68-cad89330d0a4",
                                                "text": "Être chargé de l’inspection et du contrôle d’une perception, d’une comptabilité, d’une caisse."
                                            },
                                            {
                                                "example_id": "85780b6e-8a5b-4ae0-94a4-ca9f95d0e15a",
                                                "sense_id": "e7819cc6-5ea4-3935-8d68-cad89330d0a4",
                                                "text": "Dans une Europe pleinement intégrée, où les personnes sont libres de circuler sans contrôle frontalier, il est absurde que les compétences juridiques s’arrêtent aux frontières des États membres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c9fd6b1-ad08-3f3e-9324-8292caafa6bb",
                                        "entry_id": "d0f3c865-65be-39fc-b904-1b2e2f9aeb23",
                                        "glosses": [
                                            "Bureau où se tiennent les contrôleurs d’un théâtre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9002956-f2ad-4853-8b99-4c8824ea7d9e",
                                                "sense_id": "1c9fd6b1-ad08-3f3e-9324-8292caafa6bb",
                                                "text": "On refusa son billet au contrôle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9c6c56f-ebac-3df1-8855-972508dcae32",
                                        "entry_id": "d0f3c865-65be-39fc-b904-1b2e2f9aeb23",
                                        "glosses": [
                                            "Examen, surveillance, inspection, supervision."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "babf0589-a30c-4847-ac1b-cad770753640",
                                                "sense_id": "c9c6c56f-ebac-3df1-8855-972508dcae32",
                                                "text": "Sous le contrôle de la censure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f714dd8-c744-3ac8-9f02-d035aa67dc83",
                                        "entry_id": "d0f3c865-65be-39fc-b904-1b2e2f9aeb23",
                                        "glosses": [
                                            "Ensemble des opérations ayant pour but de connaître l’état de fonctionnement d’un réacteur et d’en permettre la commande."
                                        ],
                                        "tags": [
                                            "Nucléaire",
                                            "Exploitation des réacteurs"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4fcae376-1cca-3388-b390-7f8d273d8b3a",
                                        "entry_id": "d0f3c865-65be-39fc-b904-1b2e2f9aeb23",
                                        "glosses": [
                                            "Surveillance ou vérification de l’état d’un système, généralement par la lecture de valeurs de paramètres ou la consultation d’indicateurs."
                                        ],
                                        "tags": [
                                            "Ingénierie des systèmes"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "258e2c21-ae15-35fc-91d2-075bce8d4c37",
                                        "entry_id": "d0f3c865-65be-39fc-b904-1b2e2f9aeb23",
                                        "glosses": [
                                            "Action de mener, diriger, gouverner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9cb8330c-d28e-482c-9c44-71576307b588",
                                                "sense_id": "258e2c21-ae15-35fc-91d2-075bce8d4c37",
                                                "text": "Historiquement, la « tête gouvernante » de l'impérialisme nord-américain prête une attention supérieure au contrôle militaire, tandis que sa « tête privée » se consacre au contrôle économique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5dfe10fe-051e-3730-b9c9-42a78ba1fcca",
                                        "entry_id": "d0f3c865-65be-39fc-b904-1b2e2f9aeb23",
                                        "glosses": [
                                            "Pouvoir de décision."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9971cf9b-1f81-4f30-ae58-a5c1d9b85069",
                                                "sense_id": "5dfe10fe-051e-3730-b9c9-42a78ba1fcca",
                                                "text": "Pendant ce temps, dans la cité géante, le mouvement insurrectionnel échappait à tout contrôle. […]. Au début, la rébellion ne se manifesta que par des vociférations isolées, des harangues sur les places et des excitations dans la presse."
                                            },
                                            {
                                                "example_id": "b66dea48-54a6-43e6-9031-e27fddc7cc79",
                                                "sense_id": "5dfe10fe-051e-3730-b9c9-42a78ba1fcca",
                                                "text": "Il a pris le contrôle de cette société."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63d1ef16-0ba3-31c5-a86d-686a529f2f60",
                                        "entry_id": "d0f3c865-65be-39fc-b904-1b2e2f9aeb23",
                                        "glosses": [
                                            "Maîtrise, domination."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79090407-8d7e-41ee-bde9-cd7451e3bcfd",
                                                "sense_id": "63d1ef16-0ba3-31c5-a86d-686a529f2f60",
                                                "text": "un conducteur perd le contrôle de son véhicule. (un conducteur perd la maîtrise de son véhicule.)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82fd419b-9f2c-3e91-b016-09a95006587b",
                                        "entry_id": "d0f3c865-65be-39fc-b904-1b2e2f9aeb23",
                                        "glosses": [
                                            "Synonyme de widget (élément de base d’une interface graphique)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9712c785-42a2-4109-adb3-55edf31051e1",
                                                "sense_id": "82fd419b-9f2c-3e91-b016-09a95006587b",
                                                "text": "Le contrôle ComboBox est l’association d’un contrôle ListBox et d’un contrôle TextBox."
                                            }
                                        ]
                                    }
                                ]
