{
    "word_family": [
        "foirade",
        "foireux"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f3654fe9-6f86-3641-9f04-503024dcc38a",
                    "sense_definition": "Rater complètement quelque chose, ne pas réussir une tâche ou un projet.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "echec",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai complètement <w>foiré</w> mon examen de mathématiques hier matin."
                        },
                        {
                            "text": "Si tu ne prépares pas cette réunion, tu risques de <w>foirer</w> ta présentation devant toute l'équipe."
                        }
                    ],
                    "synonyms": [
                        "rater",
                        "louper"
                    ],
                    "antonyms": [
                        "réussir"
                    ],
                    "common_phrases": [
                        "foirer un examen",
                        "foirer son coup"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "familier"
                        }
                    ]
                },
                {
                    "sense_id": "fa095f31-644f-34ac-9282-9aa92c936ad9",
                    "sense_definition": "Ne pas fonctionner comme prévu, tourner mal ou aboutir à un échec.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "echec",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Leur plan initial a totalement <w>foiré</w> à cause du mauvais temps."
                        },
                        {
                            "text": "Rien ne fonctionne aujourd'hui, toutes nos démarches <w>foirent</w> lamentablement."
                        }
                    ],
                    "synonyms": [
                        "échouer",
                        "capoter"
                    ],
                    "antonyms": [
                        "marcher",
                        "fonctionner"
                    ],
                    "common_phrases": [
                        "totalement foiré"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "familier"
                        }
                    ]
                },
                {
                    "sense_id": "97235e9c-5b90-3fcc-a12d-c465fbcc2ae0",
                    "sense_definition": "Tourner dans le vide sans serrer, en parlant d'une vis ou d'un boulon dont le filetage est détérioré.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fais bien attention en vissant trop fort, tu risques de faire <w>foirer</w> le pas de vis."
                        },
                        {
                            "text": "Ce vieux boulon métallique <w>foire</w> et n'arrive plus à retenir solidement la charpente."
                        }
                    ],
                    "common_phrases": [
                        "vis qui foire",
                        "faire foirer"
                    ]
                },
                {
                    "sense_id": "f2b83cd3-1b12-3c64-ba8a-3032a656ae2d",
                    "sense_definition": "Faire la fête de façon débridée, s'amuser bruyamment ou faire la noce.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après les examens, ils ont <w>foiré</w> ensemble pendant tout le week-end dans les rues de la ville."
                        },
                        {
                            "text": "Les jeunes du village adorent <w>foirer</w> tard dans les bars le samedi soir."
                        }
                    ],
                    "synonyms": [
                        "festoyer",
                        "faire la fête"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "familier"
                        }
                    ]
                },
                {
                    "sense_id": "c9e82ebb-a446-3032-b579-11b3614dfbb0",
                    "sense_definition": "Avoir la diarrhée, évacuer des selles liquides de façon incontrôlée.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le pauvre animal a été malade toute la nuit et a <w>foiré</w> partout dans la maison."
                        },
                        {
                            "text": "Après avoir bu cette eau polluée, il s'est mis à <w>foirer</w> durant plusieurs jours."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "très familier ou vulgaire"
                        }
                    ]
                },
                {
                    "sense_id": "dd237f67-a871-3ef2-8166-af2ab791f428",
                    "sense_definition": "Éprouver une vive angoisse, défaillir ou céder sous l'effet de la peur.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Au moment d'entrer sur le terrain, le joueur a <w>foiré</w> sous le coup du stress."
                        },
                        {
                            "text": "Dès que les premiers ennuis surgissent, il <w>foire</w> et abandonne tous ses partenaires."
                        }
                    ],
                    "synonyms": [
                        "paniquer",
                        "faiblir"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "familier"
                        }
                    ]
                }
            ]
        }
    ]
