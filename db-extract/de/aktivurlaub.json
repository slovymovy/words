                "senses": [
                    {
                        "sense_id": "d9ba6a54-c26e-3604-bc5b-41eb811a5c73",
                        "entry_id": "4bd270f4-06ce-3f04-a33b-432a0e565941",
                        "glosses": [
                            "Urlaub, bei dem sportliche Betätigung (zum Beispiel Wandern, Radfahren oder Wassersport) im Vordergrund steht, oft in der Natur oder im Freien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "063916e3-4e06-45ce-be43-d5ec94cc5b9b",
                                "sense_id": "d9ba6a54-c26e-3604-bc5b-41eb811a5c73",
                                "text": "„Draußen im Auto wartete Sören. Den hatte sie vor einem halben Jahr bei einem Aktivurlaub in der mongolischen Steppe kennengelernt.“"
                            },
                            {
                                "example_id": "b294903c-fd8e-4e93-af00-60ff08df0d08",
                                "sense_id": "d9ba6a54-c26e-3604-bc5b-41eb811a5c73",
                                "text": "„Rwandas vielfältige und abwechslungsreiche Landschaft ermöglicht verschiedene Urlaubsformen wie Bildungs- oder Erholungsurlaub, Studienreise oder Aktivurlaub mit Bergwandern, Mountainbiking oder Wassersport.“"
                            },
                            {
                                "example_id": "7bcca72a-bfcb-44ef-9700-de2e4dd5e7a0",
                                "sense_id": "d9ba6a54-c26e-3604-bc5b-41eb811a5c73",
                                "text": "„Allerdings wird die Anzahl derer, die einen auf sportliche Betätigung ausgerichteten Aktivurlaub unternehmen, immer größer.“"
                            },
                            {
                                "example_id": "8905ca07-bb1a-4229-a505-9ca89b2be637",
                                "sense_id": "d9ba6a54-c26e-3604-bc5b-41eb811a5c73",
                                "text": "„Mit ihren buchtenreichen, über 8000 km langen Küsten, der weiten, fast menschenleeren Gebirgswelt bis zu alpinen Höhen und zahlreichen Wildwasserflüssen ist die Türkei ein Paradies für den Aktivurlaub.“"
                            },
                            {
                                "example_id": "052231fc-c885-40c2-8743-94f21ce15f8f",
                                "sense_id": "d9ba6a54-c26e-3604-bc5b-41eb811a5c73",
                                "text": "„Pia macht gerne Urlaub am Meer, und Ben liebt Aktivurlaube in den Bergen.“"
                            },
                            {
                                "example_id": "94d2927a-698e-41d6-9d75-fdd330df6fc9",
                                "sense_id": "d9ba6a54-c26e-3604-bc5b-41eb811a5c73",
                                "text": "„Planen Sie Aktivurlaube, bei denen Sie auf Berge steigen oder eine neue Sportart ausprobieren, statt nur am Strand zu liegen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
