                "senses": [
                    {
                        "sense_id": "9f180b17-be40-3f8b-bdf1-c8954d64a2c9",
                        "entry_id": "524fbe46-91cc-302d-ae8c-fcd4a4c7ef2c",
                        "glosses": [
                            "лингв. совокупность черт одного языка, которые перешли в другой язык в результате длительных контактов народов, говорящих на этих языках"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "916f086f-c573-4508-ac8c-b9939f8bfcfc",
                                "sense_id": "9f180b17-be40-3f8b-bdf1-c8954d64a2c9",
                                "text": "Высокий стиль Ломоносова с включением в него церковнославянского языка в парадоксальном качестве греческого адстрата русской словесности из классического переосмысляется в русский («варяго-росский»)."
                            }
                        ]
                    },
