            "senses": [
                {
                    "sense_id": "5b1c7e3c-2618-37c1-a61c-e4a62f917c71",
                    "sense_definition": "Een bedrijf waar kleding en textiel professioneel wordt gewassen en gestreken.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "laundry_facility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>wasserij</w> bezorgt de schone lakens elke week bij het hotel.",
                            "target_lang_translations": {
                                "en": "The <w>laundry</w> delivers the clean sheets to the hotel every week."
                            }
                        },
                        {
                            "text": "Wij brengen onze overhemden naar de <w>wasserij</w> voor een perfect resultaat.",
                            "target_lang_translations": {
                                "en": "We take our shirts to the <w>laundry</w> for a perfect result."
                            }
                        }
                    ],
                    "common_phrases": [
                        "lokale wasserij",
                        "professionele wasserij"
                    ],
                    "target_lang_definitions": {
                        "en": "A business where clothing and textiles are professionally washed and ironed."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "laundry",
                                "target_lang_sense_clarification": "A commercial establishment for washing clothes."
                            },
                            {
                                "target_lang_word": "dry cleaner",
                                "target_lang_sense_clarification": "Often used interchangeably for professional garment cleaning services."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8f66c0bc-3db5-329e-95e9-071f1c4ebe82",
                    "sense_definition": "Een openbare ruimte met zelfbedieningsmachines om kleding te wassen.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "laundry_facility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Studenten gaan vaak naar de <w>wasserij</w> omdat ze zelf geen machine hebben.",
                            "target_lang_translations": {
                                "en": "Students often go to the <w>laundromat</w> because they don't have a machine themselves."
                            }
                        },
                        {
                            "text": "In de <w>wasserij</w> moet je zelf je was in de machine stoppen.",
                            "target_lang_translations": {
                                "en": "At the <w>laundromat</w>, you have to put your laundry in the machine yourself."
                            }
                        }
                    ],
                    "synonyms": [
                        "wasserette",
                        "wassalon"
                    ],
                    "common_phrases": [
