                "senses": [
                    {
                        "sense_id": "0813169b-7f69-3f16-931a-cf492454f312",
                        "entry_id": "32b2de2c-8467-3b0a-a381-118593355def",
                        "glosses": [
                            "Cesser d’attribuer un type à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee1e8b5b-5198-4d28-831b-ac89ef6628a7",
                                "sense_id": "0813169b-7f69-3f16-931a-cf492454f312",
                                "text": "C’est pourquoi le procureur dans son droit de réponse, lui demande de défictionnaliser Fanchette, c’est-à-dire de la détypiser."
                            },
                            {
                                "example_id": "27566700-939d-4964-b09f-bb17bd125e59",
                                "sense_id": "0813169b-7f69-3f16-931a-cf492454f312",
                                "text": "La plupart du temps, son dramatisme s’épuise, au plan de l’acteur, entre une expression de soi sans médiation consistante et l’imitation d’un autre, déjà sous-typé dans l’écriture et encore détypisé par le jeu."
                            }
                        ]
                    }
