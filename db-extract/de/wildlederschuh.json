                ],
                "senses": [
                    {
                        "sense_id": "4aa7fdbf-7c40-3214-9984-5fd0d2b141dc",
                        "entry_id": "18e40ea8-0074-3c50-b0da-beb66dfb1487",
                        "glosses": [
                            "Schuh aus Wildleder"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8800b01-92bb-4c11-a62a-60b682ed3eb5",
                                "sense_id": "4aa7fdbf-7c40-3214-9984-5fd0d2b141dc",
                                "text": "„In seinem Tweedsakko, dem Hemd mit dem offenen Kragen und seinen nagelneuen, eleganten Wildlederschuhen, die er wohl auf einer kürzlich unternommenen Londonreise gekauft hatte, erinnerte er noch mehr als sonst an Dean Martin.“"
                            },
                            {
                                "example_id": "a421b085-6392-4e1c-8e8b-30901b210ddd",
                                "sense_id": "4aa7fdbf-7c40-3214-9984-5fd0d2b141dc",
                                "text": "„Der Boden unter seinen Wildlederschuhen war klebrig vor verklumpenden Blutgerinnsel.“"
                            },
                            {
                                "example_id": "3eeac0b0-abd3-4bb2-b3ba-60c795595637",
                                "sense_id": "4aa7fdbf-7c40-3214-9984-5fd0d2b141dc",
                                "text": "„Nach einer Woche konnte Adam mit Genugtuung feststellen, daß sowohl Johnny Hoop als auch Archie Schwert Captain Stuart-Kerrs Beispiel gefolgt waren, und nach zwei Wochen hatten bereits sämtliche großen Konfektionsgeschäfte in der Regent Street ihre Schaufenster umgebaut, um Platz für eine lange Reihe schwarzer Wildlederschuhe zu schaffen.“"
                            },
                            {
                                "example_id": "9f7e46d0-65a2-46e4-a855-9d18b782c0e2",
                                "sense_id": "4aa7fdbf-7c40-3214-9984-5fd0d2b141dc",
                                "text": "„Ich hängte meinen Mantel auf und zog ein Paar flache Wildlederschuhe an, die ich in der Handtasche mitgebracht hatte, denn genau wie Mama lief ich nicht gern auf Strümpfen herum, wenn ich anderswo zu Besuch war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
