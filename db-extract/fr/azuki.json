                "senses": [
                    {
                        "sense_id": "3d906f85-6150-3618-9886-beb917f77854",
                        "entry_id": "44862e9e-27df-3810-be22-736427be210a",
                        "glosses": [
                            "Plante herbacée de la famille des Fabacées, originaire d’Asie de l’Est, cultivée pour ses graines et dont il existe de nombreux cultivars."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99d4c871-8061-422f-8e69-e60f55b599e7",
                                "sense_id": "3d906f85-6150-3618-9886-beb917f77854",
                                "text": "Je cultive le Natsu azuki , hâtis et rouge ; j’ai renoncé à l’Aki azuki, qui est tardif."
                            }
                        ]
                    },
                    {
                        "sense_id": "44a2dd35-b7c5-3d2c-87d7-d5fa44fbc419",
                        "entry_id": "44862e9e-27df-3810-be22-736427be210a",
                        "glosses": [
                            "Graines comestibles de cette plante."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e90566e-ff60-4f1e-8454-c058b3febc0c",
                                "sense_id": "44a2dd35-b7c5-3d2c-87d7-d5fa44fbc419",
                                "text": "Au menu : quinoa et céréales, lentilles Markal, pâtes complètes, beurre cru, flocons d’azukis et tout ce qui est issu de l’agriculture raisonnée."
                            },
                            {
                                "example_id": "4cc2d4d5-9e4a-45a6-9eeb-edbef869a607",
                                "sense_id": "44a2dd35-b7c5-3d2c-87d7-d5fa44fbc419",
                                "text": "SETSUKO, le visage radieux. Dis-moi, Mariko, pourquoi les monts de Kyoto sont-ils violets ? MARIKO, espiègle. C’est vrai. On dirait du flan d’azuki."
                            }
                        ]
                    }
                ],
