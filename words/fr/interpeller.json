{
    "word_family": [
        "interpellation",
        "interpellateur"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e683fc1d-9dfd-35fd-b9f7-9790d702e09e",
                    "sense_definition": "Adresser la parole à quelqu'un, souvent de manière vive, soudaine ou directe.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "parole",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un inconnu m'<w>interpelle</w> dans la rue pour me demander l'heure.",
                            "target_lang_translations": {
                                "en": "A stranger <w>accosts</w> me in the street to ask me the time.",
                                "ru": "Какой-то незнакомец на улице <w>заговаривает</w> со мной, чтобы спросить время.",
                                "de": "Ein Unbekannter <w>spricht</w> mich auf der Straße <w>an</w>, um mich nach der Uhrzeit zu fragen.",
                                "es": "Un desconocido me <w>aborda</w> en la calle para preguntarme la hora.",
                                "zh": "一个陌生人在街上向我<w>搭话</w>，问我几点了。"
                            }
                        },
                        {
                            "text": "Le commerçant <w>interpelle</w> les clients qui passent devant sa boutique.",
                            "target_lang_translations": {
                                "en": "The shopkeeper <w>hails</w> customers walking past his shop.",
                                "ru": "Торговец <w>окликает</w> покупателей, которые проходят мимо его лавки.",
                                "de": "Der Händler <w>spricht</w> die Kunden <w>an</w>, die an seinem Laden vorbeigehen.",
                                "es": "El comerciante <w>llama</w> a los clientes que pasan delante de su tienda.",
                                "zh": "店主<w>叫住</w>从店门口经过的顾客。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "interpeller un passant"
                    ],
                    "target_lang_definitions": {
                        "en": "To speak to someone directly, often abruptly or boldly, especially in a public place.",
                        "ru": "Обратиться к кому-либо с разговором, часто резко, прямо или неожиданно.",
                        "de": "Jemanden direkt und oft unvermittelt ansprechen.",
                        "es": "Dirigirse a alguien de forma directa, a menudo brusca o repentina.",
                        "zh": "直接向某人开口说话，常常是突然或唐突的。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "accost",
                                "target_lang_sense_clarification": "approach a stranger boldly"
                            },
                            {
                                "target_lang_word": "hail",
                                "target_lang_sense_clarification": "call out to a passerby"
                            },
                            {
                                "target_lang_word": "address",
                                "target_lang_sense_clarification": "speak directly to a person"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "обратиться",
                                "target_lang_sense_clarification": "прямо обратиться к человеку"
                            },
                            {
                                "target_lang_word": "окликнуть",
                                "target_lang_sense_clarification": "громко позвать прохожего"
                            },
                            {
                                "target_lang_word": "заговорить",
                                "target_lang_sense_clarification": "начать разговор с незнакомцем"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "ansprechen",
                                "target_lang_sense_clarification": "Fremde auf der Straße"
                            },
                            {
                                "target_lang_word": "anreden",
                                "target_lang_sense_clarification": "höfliche direkte Anrede"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "abordar",
                                "target_lang_sense_clarification": "acercarse a un desconocido"
                            },
                            {
                                "target_lang_word": "llamar",
                                "target_lang_sense_clarification": "gritar para atraer a alguien"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "搭话",
                                "target_lang_sense_clarification": "主动向陌生人开口"
                            },
                            {
                                "target_lang_word": "叫住",
                                "target_lang_sense_clarification": "出声喊住路人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "32b3d50d-7c2d-3a40-8dd8-e2f34a4d2cc2",
                    "sense_definition": "Contrôler l'identité d'une personne ou l'arrêter dans le cadre d'une enquête policière.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "police",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les forces de l'ordre ont <w>interpellé</w> deux suspects après le vol.",
                            "target_lang_translations": {
                                "en": "The police <w>arrested</w> two suspects after the theft.",
                                "ru": "После кражи полиция <w>задержала</w> двух подозреваемых.",
                                "de": "Die Polizei hat nach dem Diebstahl zwei Verdächtige <w>festgenommen</w>.",
                                "es": "Las fuerzas del orden <w>detuvieron</w> a dos sospechosos tras el robo.",
                                "zh": "盗窃案发生后，警方<w>逮捕</w>了两名嫌疑人。"
                            }
                        },
                        {
                            "text": "Le voleur a été <w>interpellé</w> par la police à la gare.",
                            "target_lang_translations": {
                                "en": "The thief was <w>arrested</w> by the police at the station.",
                                "ru": "Вор был <w>задержан</w> полицией на вокзале.",
                                "de": "Der Dieb wurde am Bahnhof von der Polizei <w>festgenommen</w>.",
                                "es": "El ladrón fue <w>detenido</w> por la policía en la estación.",
                                "zh": "小偷在火车站被警方<w>逮捕</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "appréhender"
                    ],
                    "common_phrases": [
                        "interpeller un suspect",
                        "être interpellé par la police"
                    ],
                    "target_lang_definitions": {
                        "en": "To stop a person, usually to check their identity or detain them during a police investigation.",
                        "ru": "Остановить человека для проверки документов или задержать его в ходе полицейского расследования.",
                        "de": "Eine Person von der Polizei anhalten, um ihre Identität zu prüfen oder sie festzunehmen.",
                        "es": "Detener a una persona, generalmente para comprobar su identidad o retenerla durante una investigación policial.",
                        "zh": "警察拦下某人核查身份，或在侦查中将其逮捕。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "arrest",
                                "target_lang_sense_clarification": "police arrest of suspects"
                            },
                            {
                                "target_lang_word": "apprehend",
                                "target_lang_sense_clarification": "formal police seizure of suspects"
                            },
                            {
                                "target_lang_word": "detain",
                                "target_lang_sense_clarification": "hold for police questioning"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "задержать",
                                "target_lang_sense_clarification": "полиция задерживает подозреваемого"
                            },
                            {
                                "target_lang_word": "остановить",
                                "target_lang_sense_clarification": "остановить для проверки документов"
                            },
                            {
                                "target_lang_word": "арестовать",
                                "target_lang_sense_clarification": "полицейский арест подозреваемого"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "festnehmen",
                                "target_lang_sense_clarification": "Polizei nimmt Verdächtige fest"
                            },
                            {
                                "target_lang_word": "kontrollieren",
                                "target_lang_sense_clarification": "Polizeikontrolle von Personen"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "detener",
                                "target_lang_sense_clarification": "la policía retiene a sospechosos"
                            },
                            {
                                "target_lang_word": "arrestar",
                                "target_lang_sense_clarification": "detención policial de sospechosos"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "逮捕",
                                "target_lang_sense_clarification": "警方依法拘捕嫌疑人"
                            },
                            {
                                "target_lang_word": "盘查",
                                "target_lang_sense_clarification": "拦下查验身份"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "079408b6-72cb-32b1-a5cd-1406fe0dae3c",
                    "sense_definition": "Susciter une réflexion, attirer fortement l'attention ou provoquer une réaction intellectuelle ou morale.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "attention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce documentaire sur le climat <w>interpelle</w> de nombreux spectateurs.",
                            "target_lang_translations": {
                                "en": "This documentary about the climate <w>challenges</w> many viewers.",
                                "ru": "Этот документальный фильм о климате <w>заставляет задуматься</w> многих зрителей.",
                                "de": "Dieser Dokumentarfilm über das Klima <w>rüttelt</w> viele Zuschauer <w>auf</w>.",
                                "es": "Este documental sobre el clima <w>sacude</w> a muchos espectadores.",
                                "zh": "这部关于气候的纪录片<w>触动</w>了许多观众。"
                            }
                        },
                        {
                            "text": "Son attitude étrange lors de la réunion m'a beaucoup <w>interpellé</w>.",
                            "target_lang_translations": {
                                "en": "His strange attitude at the meeting really <w>struck</w> me.",
                                "ru": "Его странное поведение на совещании меня очень <w>поразило</w>.",
                                "de": "Sein seltsames Verhalten bei der Besprechung hat mich sehr <w>beschäftigt</w>.",
                                "es": "Su extraña actitud durante la reunión me <w>impresionó</w> mucho.",
                                "zh": "他在会上那种古怪的态度深深<w>触动</w>了我。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "interpeller l'opinion publique"
                    ],
                    "target_lang_definitions": {
                        "en": "To provoke thought or strongly catch someone's attention, often prompting an intellectual or moral reaction.",
                        "ru": "Вызывать размышления, сильно привлекать внимание или провоцировать интеллектуальную или моральную реакцию.",
                        "de": "Zum Nachdenken anregen oder stark die Aufmerksamkeit auf sich ziehen.",
                        "es": "Provocar reflexión o llamar fuertemente la atención, generando una reacción intelectual o moral.",
                        "zh": "引发人们思考，强烈吸引注意，激起理智或道德上的反应。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "intrigue",
                                "target_lang_sense_clarification": "arouse curiosity about something"
                            },
                            {
                                "target_lang_word": "challenge",
                                "target_lang_sense_clarification": "provoke public debate or reflection"
                            },
                            {
                                "target_lang_word": "strike",
                                "target_lang_sense_clarification": "make a strong impression"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "заинтриговать",
                                "target_lang_sense_clarification": "вызвать любопытство к теме"
                            },
                            {
                                "target_lang_word": "затронуть",
                                "target_lang_sense_clarification": "поднять важный общественный вопрос"
                            },
                            {
                                "target_lang_word": "поразить",
                                "target_lang_sense_clarification": "произвести сильное впечатление"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "aufrütteln",
                                "target_lang_sense_clarification": "Öffentlichkeit zum Handeln bewegen"
                            },
                            {
                                "target_lang_word": "anregen",
                                "target_lang_sense_clarification": "Diskussion anregen"
                            },
                            {
                                "target_lang_word": "berühren",
                                "target_lang_sense_clarification": "emotional tief bewegen"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "sacudir",
                                "target_lang_sense_clarification": "remover conciencias y opiniones"
                            },
                            {
                                "target_lang_word": "conmover",
                                "target_lang_sense_clarification": "afectar la conciencia moral"
                            },
                            {
                                "target_lang_word": "impresionar",
                                "target_lang_sense_clarification": "causar fuerte impresión"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "触动",
                                "target_lang_sense_clarification": "触动情感与良知"
                            },
                            {
                                "target_lang_word": "震撼",
                                "target_lang_sense_clarification": "强烈撼动人心"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c05c6f30-3887-33b3-b0c4-b5034968088c",
                    "sense_definition": "Demander solennellement des explications à un ministre ou au gouvernement sur sa politique.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "politique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le député souhaite <w>interpeller</w> le ministre sur la crise du logement.",
                            "target_lang_translations": {
                                "en": "The MP wants to <w>question</w> the minister about the housing crisis.",
                                "ru": "Депутат хочет <w>выступить с запросом</w> к министру по поводу жилищного кризиса.",
                                "de": "Der Abgeordnete will den Minister zur Wohnungskrise <w>interpellieren</w>.",
                                "es": "El diputado quiere <w>interpelar</w> al ministro sobre la crisis de la vivienda.",
                                "zh": "这位议员想就住房危机<w>质询</w>部长。"
                            }
                        },
                        {
                            "text": "L'opposition a décidé d'<w>interpeller</w> le gouvernement à propos des réformes récentes.",
                            "target_lang_translations": {
                                "en": "The opposition has decided to <w>question</w> the government about the recent reforms.",
                                "ru": "Оппозиция решила <w>выступить с запросом</w> к правительству по поводу недавних реформ.",
                                "de": "Die Opposition hat beschlossen, die Regierung wegen der jüngsten Reformen zu <w>interpellieren</w>.",
                                "es": "La oposición ha decidido <w>interpelar</w> al Gobierno por las recientes reformas.",
                                "zh": "反对党决定就近期的改革<w>质询</w>政府。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "interpeller le gouvernement",
                        "interpeller un ministre"
                    ],
                    "target_lang_definitions": {
                        "en": "To formally demand explanations from a minister or the government about their policies.",
                        "ru": "Официально потребовать объяснений от министра или правительства по поводу их политики.",
                        "de": "Von einem Minister oder der Regierung förmlich Erklärungen zu deren Politik verlangen.",
                        "es": "Pedir formalmente explicaciones a un ministro o al Gobierno sobre su política.",
                        "zh": "就政府或部长的施政正式向其提出质询。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "question",
                                "target_lang_sense_clarification": "parliamentary questioning of ministers"
                            },
                            {
                                "target_lang_word": "interpellate",
                                "target_lang_sense_clarification": "formal legislative questioning of ministers"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "запросить",
                                "target_lang_sense_clarification": "запрос официальных разъяснений"
                            },
                            {
                                "target_lang_word": "выступить с запросом",
                                "target_lang_sense_clarification": "парламентский запрос министру"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "interpellieren",
                                "target_lang_sense_clarification": "parlamentarische Anfrage an Regierung"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "interpelar",
                                "target_lang_sense_clarification": "pedir explicaciones parlamentarias"
                            },
                            {
                                "target_lang_word": "cuestionar",
                                "target_lang_sense_clarification": "criticar la gestión gubernamental"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "质询",
                                "target_lang_sense_clarification": "议会就施政向政府发问"
                            }
                        ]
                    }
                }
            ]
        }
