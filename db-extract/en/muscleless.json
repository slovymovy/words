                        "examples": [
                            {
                                "example_id": "111be6ce-04b9-4402-aa43-2e02755b5c62",
                                "sense_id": "f46bc0db-a6ba-33ec-8323-c2b0155f5fe2",
                                "text": "Many people came there now—masculine women and muscleless men, for the most part."
                            },
                            {
                                "example_id": "2687c227-1431-42b3-bb3e-2917ec692bcc",
                                "sense_id": "f46bc0db-a6ba-33ec-8323-c2b0155f5fe2",
                                "text": "Sometimes she stood them in lines in her room and made them recite arithmetic tables, flogging the inaccurate with as much vigour as her arms would allow, flabby, muscleless arms, broad and loose towards the armpit, and swinging like dead flesh."
                            },
                            {
                                "example_id": "087bb473-c4fe-4ca1-bf94-da7f7549054e",
                                "sense_id": "f46bc0db-a6ba-33ec-8323-c2b0155f5fe2",
                                "text": "In all these studies, the tendons that develop best in muscleless limbs are digital tendons."
                            }
                        ]
                    },
                    {
