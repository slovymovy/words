    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8eb26b71-7d2a-3b96-8987-142eac232fe6",
                    "sense_definition": "Scherp prikkend of stekend, vaak met betrekking tot insecten of scherpe voorwerpen.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "fysiek_prikkend",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij sloeg de <w>stekende</w> wesp snel dood voordat hij gestoken kon worden.",
                            "target_lang_translations": {
                                "en": "He quickly swatted the <w>stinging</w> wasp dead before he could get stung."
                            }
                        },
                        {
                            "text": "De wandelaar voelde een <w>stekende</w> pijn in zijn voet door een scherpe doorn.",
                            "target_lang_translations": {
                                "en": "The hiker felt a <w>stabbing</w> pain in his foot from a sharp thorn."
                            }
                        }
                    ],
                    "common_phrases": [
                        "stekende pijn",
                        "stekende insecten"
                    ],
                    "target_lang_definitions": {
                        "en": "Sharp, stinging, or pricking, often in relation to insects or sharp objects."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stinging",
                                "target_lang_sense_clarification": "capable of inflicting a sting or sharp pain"
                            },
                            {
                                "target_lang_word": "stabbing",
                                "target_lang_sense_clarification": "sudden, sharp, and intense pain"
                            },
                            {
                                "target_lang_word": "sharp",
                                "target_lang_sense_clarification": "piercing or acute physical sensation"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9e12d969-99b2-31fd-8d1e-6bee275cf024",
                    "sense_definition": "Van een opmerking of gedrag dat het kwetsend, scherp of pijnlijk is voor de ander.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "kwetsend",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij maakte weer eens een paar <w>stekende</w> opmerkingen die de sfeer volledig verpestten.",
                            "target_lang_translations": {
                                "en": "Once again, he made a few <w>cutting</w> remarks that completely ruined the atmosphere."
                            }
                        },
                        {
                            "text": "Haar <w>stekende</w> kritiek kwam hard aan bij de jonge kunstenaar.",
                            "target_lang_translations": {
                                "en": "Her <w>stinging</w> criticism hit the young artist hard."
                            }
                        }
                    ],
                    "synonyms": [
                        "pijnlijk",
                        "grievend",
                        "vinnig",
                        "snerpend",
                        "bijtend"
                    ],
                    "common_phrases": [
                        "stekende opmerkingen",
                        "stekende kritiek"
                    ],
                    "target_lang_definitions": {
                        "en": "Of a remark or behavior that is hurtful, sharp, or painful to another person."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cutting",
                                "target_lang_sense_clarification": "hurtful, sharp, or sarcastic criticism"
                            },
                            {
                                "target_lang_word": "stinging",
                                "target_lang_sense_clarification": "precise and emotionally hurtful"
                            },
                            {
                                "target_lang_word": "pungent",
                                "target_lang_sense_clarification": "acerbic or biting in tone"
                            },
                            {
                                "target_lang_word": "biting",
                                "target_lang_sense_clarification": "harsh and deeply critical"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1a713516-be71-31f4-9bf3-283762f0a74b",
                    "sense_definition": "Onvoltooid deelwoord van <w>steken</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De man liep over straat, daarbij steevast zijn duim omhoog <w>stekend</w> naar voorbijgangers.",
                            "target_lang_translations": {
                                "en": "The man walked down the street, invariably <w>sticking</w> his thumb up at passersby."
                            }
                        },
                        {
                            "text": "Een wandelaar struikelde over een uit de grond <w>stekend</w> stuk plastic op het strand.",
                            "target_lang_translations": {
                                "en": "A hiker tripped over a piece of plastic <w>protruding</w> from the ground on the beach."
                            }
                        }
                    ],
                    "common_phrases": [
                        "omhoog stekend",
                        "uitstekend"
                    ],
                    "target_lang_definitions": {
                        "en": "Present participle of the verb 'steken' (to sting, prick, stick, or protrude)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sticking",
                                "target_lang_sense_clarification": "protruding or pointing in a direction"
                            },
                            {
                                "target_lang_word": "protruding",
                                "target_lang_sense_clarification": "sticking out from a surface"
                            }
                        ]
                    }
                }
            ]
        }
    ]
