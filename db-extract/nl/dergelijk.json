                                            "selbstständig"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "acb2f14c-0c09-48c1-9817-42e1fcb94724",
                                                "sense_id": "11682045-f9b1-3e6c-befb-310c67716bb1",
                                                "text": "In unserem Garten wachsen Bohnen, Erbsen, Möhren und dergleichen."
                                            },
                                            {
                                                "example_id": "58d4fe6c-cfd2-43ea-b479-f0f383ae9d9b",
                                                "sense_id": "11682045-f9b1-3e6c-befb-310c67716bb1",
                                                "text": "„So ist es aber sicher nicht gewesen, obwohl verschiedene Autoren dergleichen berichten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9236890e-4fef-3bbc-8cf3-d35de2f17a83",
                                        "entry_id": "5abf1a6e-d3cd-33f7-9e08-7de622dda2a6",
                                        "glosses": [
                                            "so geartet, derartig, solch"
                                        ],
                                        "tags": [
                                            "attributiv"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "529fefcd-155a-43ec-9b5c-deb92ac0ad08",
                                                "sense_id": "9236890e-4fef-3bbc-8cf3-d35de2f17a83",
                                                "text": "Fernsehtürme und dergleichen hohe Gebäude schätzt der unter Höhenangst leidende Xaver gar nicht."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "dergleichen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d8bf3be2-e258-3807-99e7-315422a4de8a",
                                        "entry_id": "ab449ae9-3953-368c-95e6-4a1edcc2361d",
