                "senses": [
                    {
                        "sense_id": "dd41d1ff-a10c-3baf-8010-5e2f6c1d77b5",
                        "entry_id": "8bba2e4b-cd38-34af-8547-7fde03d9bd1b",
                        "glosses": [
                            "Gehalt an Kohlenstoff"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60b7bfee-396a-4cdb-b3c9-cf6fddadfe09",
                                "sense_id": "dd41d1ff-a10c-3baf-8010-5e2f6c1d77b5",
                                "text": "„Der Kohlenstoffgehalt der Steinkohle steigt mit dem geologischen Alter und beträgt 75–96%, der Heizwert liegt bei 32–44 kJ/g.“"
                            },
                            {
                                "example_id": "9be57f2a-a802-42c6-a946-c8efe2e093eb",
                                "sense_id": "dd41d1ff-a10c-3baf-8010-5e2f6c1d77b5",
                                "text": "„Momentan nimmt der atmosphärische Kohlenstoffgehalt um vier Gigatonnen pro Jahr zu, ein Viertel davon geht wiederum auf die Abholzung tropischer Regenwälder zurück – dazu kommen nun noch weitere 0,2 Gigatonnen wegen der Fragmentierung der Ökosysteme.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
