                    {
                        "sense_id": "f5571698-0177-3314-8758-28418f1b835a",
                        "entry_id": "589441d6-d4e5-37c2-88f6-c476cf45b178",
                        "glosses": [
                            "Spielzeug aus zwei Scheiben, die durch einen Steg in der jeweiligen Mitte miteinander verbunden sind, und einer Schnur, die um den Steg gewickelt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf2d9b70-29b4-46da-994a-15a10a98b294",
                                "sense_id": "f5571698-0177-3314-8758-28418f1b835a",
                                "text": "Fast hätte ich die Meisterschaft im Jo-Jo gewonnen!"
                            },
                            {
                                "example_id": "31d4d2f6-5d68-4ed7-84d9-bb9db68c3777",
                                "sense_id": "f5571698-0177-3314-8758-28418f1b835a",
                                "text": "„Das war der monotone Sound der kleinen Holzkugelketten in den Händen der Hafenarbeiter, die damit stundenlang spielten wie mit einem Jo-Jo an zu kurzer Schnur.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "90b10625-8655-4717-8e31-82524f054883",
                        "source_entry_id": "589441d6-d4e5-37c2-88f6-c476cf45b178",
                        "source_sense_id": "f5571698-0177-3314-8758-28418f1b835a",
                        "target_lang_word": "yo-yo",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "yo-yo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "327eacb1-5327-3cad-970f-477ccbe9aeb8",
                                        "entry_id": "b70f4309-a2ea-365b-bb0d-36babf0c0a80",
                                        "glosses": [
                                            "A toy consisting of a spheroidal or cylindrical spindle having a circular groove in which string is wound; it is used by holding the string in the fingers and reeling the spindle up and down by movements of the wrist."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14692bba-0557-4200-a0cf-52b6321436dd",
                                                "sense_id": "327eacb1-5327-3cad-970f-477ccbe9aeb8",
                                                "text": "I bought a yo-yo from the toy store yesterday."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8d18870-babf-312d-afd7-b2278b759ec4",
                                        "entry_id": "b70f4309-a2ea-365b-bb0d-36babf0c0a80",
                                        "glosses": [
                                            "A volatile market that moves up and down."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b4d8b40e-2f86-3552-ae1f-ab47be7ac0cc",
                                        "entry_id": "b70f4309-a2ea-365b-bb0d-36babf0c0a80",
                                        "glosses": [
                                            "Someone who vacillates."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bd86273a-4fae-3c17-8d52-9fcc2491a6dd",
                                        "entry_id": "b70f4309-a2ea-365b-bb0d-36babf0c0a80",
                                        "glosses": [
                                            "A dogfighting maneuver involving the attacker temporarily exchanging altitude for airspeed, or vice versa, in order to rapidly catch up with the defender or to prevent an overshoot."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "eca92d55-5cfc-3bf9-af09-f7a2e0ed0943",
                                        "entry_id": "b70f4309-a2ea-365b-bb0d-36babf0c0a80",
                                        "glosses": [
                                            "A cloth rosette formed by gathering the outside edge of a circle of fabric in toward the centre using a running stitch."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6ede7ec6-1b5c-3af7-9274-d967e3c97813",
                                        "entry_id": "b70f4309-a2ea-365b-bb0d-36babf0c0a80",
                                        "glosses": [
                                            "A foolish, annoying or incompetent person."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da19f74c-de08-4a5e-a5ff-e7d2833579e4",
                                                "sense_id": "6ede7ec6-1b5c-3af7-9274-d967e3c97813",
                                                "text": "It is hard to watch the management for very long and not conclude that the place is run by a bunch of yo-yos."
                                            },
                                            {
                                                "example_id": "dcc7c384-63da-4eda-b22c-4dd082a2d7f9",
                                                "sense_id": "6ede7ec6-1b5c-3af7-9274-d967e3c97813",
                                                "text": "Now look at them yo-yos, that's the way you do it"
                                            },
                                            {
                                                "example_id": "54116cd3-14aa-4957-a6cd-4a6dd7d32644",
                                                "sense_id": "6ede7ec6-1b5c-3af7-9274-d967e3c97813",
                                                "text": "Henry glanced past him at the few other customers currently in attendance. \"Hey! Any of you yo-yos headed up Castle Hill?\""
                                            },
                                            {
                                                "example_id": "d84babeb-1a54-4a28-bf2e-dc3507becc6c",
                                                "sense_id": "6ede7ec6-1b5c-3af7-9274-d967e3c97813",
                                                "text": "When these yo-yos came into the courtroom with their ridiculous testimony... it was a terrible circus."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "yo-yo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "41a9d56a-73c4-3f16-8eea-25c5ca56cd90",
                                        "entry_id": "0e90d0a8-ad09-3996-8347-eeddc8bb3315",
                                        "glosses": [
                                            "To vacillate; to move up and down."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8fdc5d5-d5aa-4fb3-bc7c-b503c0870c79",
                                                "sense_id": "41a9d56a-73c4-3f16-8eea-25c5ca56cd90",
                                                "text": "The yo-yoing stockmarket whizzed back up by around a quarter and then started to fall again."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
