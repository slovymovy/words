                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "94392525-4fd2-3efe-b793-25e398666ad0",
                                        "entry_id": "717de542-d410-31b3-8b85-88a840a073a6",
                                        "glosses": [
                                            "Exploration des propriétés mécaniques des organismes vivants ainsi que l’analyse des principes d’ingéniérie faisant fonctionner les systèmes biologiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6f347f8-4964-4fb9-af25-10bd9ca3b286",
                                                "sense_id": "94392525-4fd2-3efe-b793-25e398666ad0",
                                                "text": "La connaissance de la biomécanique du pied rhumatoïde est essentielle à l’optimalisation des mesures préventives et thérapeutiques."
                                            },
                                            {
                                                "example_id": "1839776f-ab7f-46b1-a081-fd4754f6b1ca",
                                                "sense_id": "94392525-4fd2-3efe-b793-25e398666ad0",
                                                "text": "Coauteur de l'étude, David Martill, de l'Université de Portsmouth au Royaume-Uni, a déclaré dans un communiqué que \"la découverte permet de résoudre beaucoup de questions de biomécanique sur la manière dont ces créatures étaient capables de soutenir leur tête massive (longue de plus de 1,5 mètre) montée sur un cou plus long que celui de la girafe moderne tout en conservant la capacité de voler\"."
                                            },
                                            {
                                                "example_id": "986ee0e4-a88b-4e24-9740-ddb5fd0caab8",
                                                "sense_id": "94392525-4fd2-3efe-b793-25e398666ad0",
                                                "text": "La biomécanique des lésions cérébrales traumatiques."
                                            }
                                        ]
                                    }
                                ]
