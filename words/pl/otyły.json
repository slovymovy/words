                    "sense_id": "3f0ca35d-779b-3036-bb30-591aaf9ff791",
                    "sense_definition": "o człowieku lub zwierzęciu: ważący o wiele za dużo; o dużej nadwadze",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "nadwaga",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Lekarz ostrzegł pacjenta, że jest zbyt <w>otyły</w> i musi zmienić dietę.",
                            "target_lang_translations": {
                                "ru": "Врач предупредил пациента, что он слишком <w>тучный</w> и должен изменить диету."
                            }
                        },
                        {
                            "text": "Właściciel karmił psa zbyt obficie, przez co zwierzak stał się bardzo <w>otyły</w>.",
                            "target_lang_translations": {
                                "ru": "Хозяин кормил собаку слишком обильно, из-за чего животное стало очень <w>тучным</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "gruby",
                        "tłusty",
                        "spasiony",
                        "z nadwagą"
                    ],
                    "common_phrases": [
                        "bardzo otyły",
                        "wyjątkowo otyły"
                    ],
                    "target_lang_definitions": {
                        "ru": "о человеке или животном: имеющий избыточный вес, страдающий ожирением"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тучный",
                                "target_lang_sense_clarification": "упитанный, полный, часто используется для описания значительного избыточного веса"
                            },
                            {
                                "target_lang_word": "толстый",
                                "target_lang_sense_clarification": "общеупотребительное слово для описания человека с лишним весом"
                            }
                        ]
                    }
                }
            ]
        },
