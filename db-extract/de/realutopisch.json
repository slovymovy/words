                    }
                ],
                "senses": [
                    {
                        "sense_id": "63d03342-0a53-37f8-a786-b5f45a8f3d48",
                        "entry_id": "8348f8f2-4528-34e0-9f3b-a15e29d674a9",
                        "glosses": [
                            "in der Art eines utopischen Wunschbildes, das sich verwirklichen lassen kann, realisiert werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7fc715c6-35c5-4038-a636-2bb34de457b1",
                                "sense_id": "63d03342-0a53-37f8-a786-b5f45a8f3d48",
                                "text": "„Die Widersprüche geltender Realität werden im ästhetischen Schein als realutopische Projektion andersmöglicher Realität als scheinbare aufgehoben.“"
                            },
                            {
                                "example_id": "84a32013-986a-486e-8e49-e4b01cc0ef57",
                                "sense_id": "63d03342-0a53-37f8-a786-b5f45a8f3d48",
                                "text": "„Ferner werden Lösungsansätze in Form von ‚realutopischen‘ Perspektiven und Optionen diskutiert.“"
                            },
                            {
                                "example_id": "2c946bc0-1e74-4bd7-839d-5d793e8820f7",
                                "sense_id": "63d03342-0a53-37f8-a786-b5f45a8f3d48",
                                "text": "„Die Lernprozesse der Protagonisten sind der realutopische Fluchtpunkt des Romans.“"
                            },
                            {
                                "example_id": "f34c043a-0c7d-45b4-bbc5-bb84c4ac2149",
                                "sense_id": "63d03342-0a53-37f8-a786-b5f45a8f3d48",
