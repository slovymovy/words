    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "e932b227-ab98-3bbd-aeb1-9feecefb2655",
                "word": "seigniorage",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "7a4a3025-2f22-45b7-97cf-a7df6d3bc034",
                        "entry_id": "e932b227-ab98-3bbd-aeb1-9feecefb2655",
                        "tags": [
                            "plural"
                        ],
                        "form": "seigniorages"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "961e22fe-41dd-32ed-9add-7528d18645dc",
                        "entry_id": "e932b227-ab98-3bbd-aeb1-9feecefb2655",
                        "glosses": [
                            "All the revenue obtained by a feudal lord from his vassals."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "1fb8a54b-25f6-41bd-b689-e0e70951a650",
                                "sense_id": "961e22fe-41dd-32ed-9add-7528d18645dc",
                                "text": "I will tell you. First, he comes regularly to take his rights of seigniorage, his rents, his taxes, his fourths of all the produce of his vineyards and arable lands on our Côte d'Or."
                            }
                        ]
                    },
                    {
                        "sense_id": "53670bda-8ec8-3162-86ab-ae646c8f8a8f",
                        "entry_id": "e932b227-ab98-3bbd-aeb1-9feecefb2655",
                        "glosses": [
                            "The revenue obtained directly by minting coin (difference between face value and cost of metal)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc35c62d-64bd-4446-81a8-18d8567cc86b",
                                "sense_id": "53670bda-8ec8-3162-86ab-ae646c8f8a8f",
                                "text": "If Government, however, throws the expense of coinage, as is reasonable, upon the holder, by making a charge to cover the expense (which is done by giving back rather less in coin than has been received in bullion, and is called levying a seigniorage), the coin will rise, to the extent of the seigniorage, above the value of the bullion."
                            },
                            {
                                "example_id": "62ee3170-3d9d-45ab-8572-40d2b96ed9f6",
                                "sense_id": "53670bda-8ec8-3162-86ab-ae646c8f8a8f",
                                "text": "The old kingly prerogative of altering the coinage was taken away, the unit of the currency was declared definite and unchangeable, and the seigniorage on minting was abolished."
                            },
                            {
                                "example_id": "2fea4786-6ddf-47ca-a050-0a7e20e7f287",
                                "sense_id": "53670bda-8ec8-3162-86ab-ae646c8f8a8f",
                                "text": "As a result of the lower than expected production, the mint has halved the amount it provides to government coffers through seigniorage, which is the difference between the face value of a coin sold to the banks and its cost of production."
                            }
                        ]
                    },
                    {
                        "sense_id": "bfc843ca-1f36-35c9-9e57-7bff7e2193b3",
                        "entry_id": "e932b227-ab98-3bbd-aeb1-9feecefb2655",
                        "glosses": [
                            "The revenue obtained by the difference between interest earned on securities acquired in exchange for bank notes and the costs of producing and distributing those notes."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f8c1a881-d9f0-4c3f-9cbd-b29cc5babba8",
                        "source_entry_id": "e932b227-ab98-3bbd-aeb1-9feecefb2655",
                        "source_sense_description": "revenue from vassals",
                        "target_lang_word": "signoraggio",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
