                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34d62f0c-0e73-414d-9ac8-a673d4221700",
                                "sense_id": "cd8047cf-b9f2-3e2a-8daf-552f273c07ff",
                                "text": "„In Zukunft ist mit einem weiteren Rückgang der Zahl der Erstinskribent/inn/en zu rechnen, da die Studienrichtung Betriebswirtschaft ab dem Wintersemester 1991/ 92 auch an der sozial- und wirtschaftswissenschaftlichen Fakultät der Universität Wien angeboten wird.“"
                            },
                            {
                                "example_id": "019cc626-cbfd-4a86-8431-70dd17ae2d62",
                                "sense_id": "cd8047cf-b9f2-3e2a-8daf-552f273c07ff",
                                "text": "„Lediglich in der Studienrichtung Wirtschaftsingenieurwesen steht keine Münchner Universität in der Spitzengruppe.“"
                            },
                            {
                                "example_id": "4eee9111-e320-47b5-94df-a68e1beca053",
                                "sense_id": "cd8047cf-b9f2-3e2a-8daf-552f273c07ff",
                                "text": "„Die neue Studienrichtung am Departement Design und Kunst ersetzt die Ausbildung Materialdesign, die von 2009 bis 2015 angeboten worden war.“"
                            },
                            {
                                "example_id": "8b5bd99f-8f9d-464e-a9fd-8a5637377243",
                                "sense_id": "cd8047cf-b9f2-3e2a-8daf-552f273c07ff",
                                "text": "„Der Studienzweig Betriebswissenschaften (Wahlplan C) wurde zu einer eigenen Studienrichtung Wirtschaftsingenieurwesen-Maschinenbau aufgewertet, […]“"
                            }
                        ],
