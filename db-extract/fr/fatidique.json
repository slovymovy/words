                    }
                ],
                "senses": [
                    {
                        "sense_id": "ded95a69-3adc-36c9-89ba-c3d64717a0b4",
                        "entry_id": "1515843d-c4b2-3ea4-a1d8-3a20796c9f27",
                        "glosses": [
                            "Qui révèle ce que les destins ont ordonné."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0225f26-1fa3-4a8f-a50f-5500182b004e",
                                "sense_id": "ded95a69-3adc-36c9-89ba-c3d64717a0b4",
                                "text": "Un sixième rayé vient d’apparaître. Mais aucun des matous n’a daigné le toiser en rival. Gras, velouté, candide, il a perdu dès son jeune âge tout souci des jeux de l’amour, et les nuits tragiques de janvier, les clairs de lune de juin ont cessé pour lui, à jamais, d’être fatidiques."
                            },
                            {
                                "example_id": "ae9c7baa-0f61-483b-9458-ad2ae2a80c87",
                                "sense_id": "ded95a69-3adc-36c9-89ba-c3d64717a0b4",
                                "text": "2 août 1914 ! Cette date fatidique dans l’histoire de l’Europe, retentissait comme un coup de tonnerre jusqu’au fond de l’Orient."
                            },
                            {
                                "example_id": "94962064-eb16-42c1-bf9e-1a5a89aed088",
                                "sense_id": "ded95a69-3adc-36c9-89ba-c3d64717a0b4",
                                "text": "Et pour finir par cette débâcle, ce communiqué à la précision faussement médicale, au timing millimétré, alors que Fillon vient de quitter l'hémicycle bruissant déjà de rumeurs et que roulent, fatidiques, les rotatives du Canard Enchaîné."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "750eb0c3-2182-4397-80df-fa03d06e1641",
                        "source_entry_id": "1515843d-c4b2-3ea4-a1d8-3a20796c9f27",
                        "source_sense_id": "ded95a69-3adc-36c9-89ba-c3d64717a0b4",
                        "target_lang_word": "schicksalhaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schicksalhaft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d5d29a59-7782-36de-8863-510d0884ff58",
                                        "entry_id": "b2ddbbef-12e6-3903-b1fd-17fe8ab58b25",
                                        "glosses": [
                                            "von einer höheren Macht (dem Schicksal) bestimmt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5cd682ad-7047-441a-bbcc-702da0faaaa1",
                                                "sense_id": "d5d29a59-7782-36de-8863-510d0884ff58",
                                                "text": "Diese Erkrankung wird nicht selten als schicksalhaft hingenommen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c7c8f927-00f2-3509-8ebf-4984ecbb5277",
                                        "entry_id": "b2ddbbef-12e6-3903-b1fd-17fe8ab58b25",
                                        "glosses": [
                                            "große Auswirkungen auf den weiteren Gang der Geschehnisse habend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f5435f2-2ba6-4a41-af4c-f9b203df5102",
                                                "sense_id": "c7c8f927-00f2-3509-8ebf-4984ecbb5277",
                                                "text": "Hinzu kommt, daß das Grundbedürfnis eines jeden Menschen, ein sinnvolles Leben zu führen dann besonders deutlich wird, wenn durch ein schicksalhaftes Ereignis der bisherige Lebenssinn droht, verloren zu gehen."
                                            },
                                            {
                                                "example_id": "ef784df3-6fa8-4976-bb85-adc4a569157c",
                                                "sense_id": "c7c8f927-00f2-3509-8ebf-4984ecbb5277",
                                                "text": "„Es handelt sich aber um eine schicksalhafte Erkrankung, die vor keinem Alter Halt macht und auch schon Kinder treffen kann», sagte Präsident Johannes Mai am Samstag nach einem gesundheitspolitischen Forum in Potsdam der dpa.“"
                                            },
                                            {
                                                "example_id": "ca7a6cfd-325f-486f-ba13-dc4faf63e424",
                                                "sense_id": "c7c8f927-00f2-3509-8ebf-4984ecbb5277",
                                                "text": "„Die Griechen steuern bei ihrem Referendum zur Schuldenkrise auf eine schicksalhafte Entscheidung zu.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9bd567f6-432a-45db-8615-cc480f2fc414",
                        "source_entry_id": "1515843d-c4b2-3ea4-a1d8-3a20796c9f27",
