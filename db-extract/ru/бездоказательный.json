                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unsubstantiated",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3735fd59-362f-3dad-9e84-20c377fdcd4a",
                                        "entry_id": "4d1388ca-bc8e-3336-b619-62609ca9dbc6",
                                        "glosses": [
                                            "Lacking substantiation; without evidence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f31ce40-5328-4cdd-9e3a-97ffcbc2606f",
                                                "sense_id": "3735fd59-362f-3dad-9e84-20c377fdcd4a",
                                                "text": "Such hedging is necessitated by the lack of in-depth knowledge of the contents, which also gives free rein to the scripting of unsubstantiated factoids concerning the book."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "unsubstantiated",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8b780203-17ff-306f-86e4-e33d3fae2082",
                                        "entry_id": "6effa122-0162-3b77-be36-3744e3b725a9",
                                        "glosses": [
                                            "simple past and past participle of unsubstantiate"
                                        ],
                                        "tags": [
                                            "form-of",
