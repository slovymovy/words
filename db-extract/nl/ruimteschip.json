                "translations": [
                    {
                        "translation_id": "14f8f28d-3d94-41b8-941f-4957ef2ae0ed",
                        "source_entry_id": "bc6b8ac0-e521-30c6-9f36-3dd8e7124bf8",
                        "source_sense_id": "d7835d4f-a8cc-31e2-ae8c-14558b25e671",
                        "source_sense_description": "vaartuig geschikt om zich buiten de aardse atmosfeer te begeven",
                        "target_lang_word": "Raumschiff",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Raumschiff",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8f0901d7-7a92-319f-8287-6d09ddfc7b4b",
                                        "entry_id": "dbe6f77b-56c5-30e7-97dd-65f605b59057",
                                        "glosses": [
                                            "Fahrzeug, das im Weltall Menschen und Güter transportieren kann"
                                        ],
                                        "tags": [
                                            "Raumfahrt"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "438f0509-25ee-47ec-b1ee-8623d70dc59d",
                                                "sense_id": "8f0901d7-7a92-319f-8287-6d09ddfc7b4b",
                                                "text": "Wann werden wohl die ersten Menschen in einem Raumschiff zum Mars fliegen?"
                                            },
                                            {
                                                "example_id": "4899c437-8eb3-42c4-9809-8d1f95e09a5e",
                                                "sense_id": "8f0901d7-7a92-319f-8287-6d09ddfc7b4b",
                                                "text": "„Mit der Geschwindigkeit von 40000 km/Std., die unsere »Raumschiffe« zwischen Erde und Mond derzeit erreichen, würde eine Reise zum rund 4 Lichtjahre entfernten sonnennächsten Fixstern über 100000 Jahre dauern.“"
                                            },
                                            {
                                                "example_id": "99e75b0c-f1e4-4a31-ac13-29e15537b9cc",
                                                "sense_id": "8f0901d7-7a92-319f-8287-6d09ddfc7b4b",
                                                "text": "„Es gebe auch heutzutage noch genug Psychopathen, die behaupteten, von Außerirdischen in deren Raumschiff entführt oder sogar vergewaltigt worden zu sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6328a794-7406-416d-b77b-13c5ba427903",
                        "source_entry_id": "bc6b8ac0-e521-30c6-9f36-3dd8e7124bf8",
                        "source_sense_id": "d7835d4f-a8cc-31e2-ae8c-14558b25e671",
                        "source_sense_description": "vaartuig geschikt om zich buiten de aardse atmosfeer te begeven",
                        "target_lang_word": "Raumfahrzeug",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Raumfahrzeug",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0cb45fb5-46fb-31f3-8b2c-52820b5171ee",
                                        "entry_id": "57202972-0ab0-3252-bfc6-df6a88295a67",
                                        "glosses": [
                                            "Fahrzeug, das im Weltall Menschen und Güter transportieren kann"
                                        ],
                                        "tags": [
                                            "Raumfahrt"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ab2039a-b804-4506-a722-44b98064c305",
                                                "sense_id": "0cb45fb5-46fb-31f3-8b2c-52820b5171ee",
                                                "text": "„Geplant ist eine Art riesiger Beutel, den das Raumfahrzeug einem vorüber ziehenden Asteroiden überstülpt.“"
                                            },
                                            {
                                                "example_id": "1187fac5-ba01-4499-a017-e00a7392904f",
                                                "sense_id": "0cb45fb5-46fb-31f3-8b2c-52820b5171ee",
                                                "text": "„An diesem neuen Wettlauf ins Weltall sind derzeit noch drei Firmen beteiligt - SpaceX, Boeing und Sierra Nevada Corp., deren Entwicklungsarbeit für bemannte Raumfahrzeuge mit jeweils mehreren hundert Millionen Dollar unterstützt wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a2b6f72c-da43-414c-8c0b-29dbaea1877a",
                        "source_entry_id": "bc6b8ac0-e521-30c6-9f36-3dd8e7124bf8",
