    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d96421f2-8a79-3e57-9d80-ccd6b188022d",
                    "sense_definition": "Means and institutions for publishing and broadcasting information.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "mass_communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Social <w>media</w> has completely changed how we communicate with each other.",
                            "target_lang_translations": {
                                "ru": "Социальные <w>медиа</w> полностью изменили то, как мы общаемся друг с другом.",
                                "zh": "社交<w>媒体</w>彻底改变了我们彼此沟通的方式。"
                            }
                        },
                        {
                            "text": "The president held a conference to address the questions from the news <w>media</w>.",
                            "target_lang_translations": {
                                "ru": "Президент провел конференцию, чтобы ответить на вопросы новостных <w>СМИ</w>.",
                                "zh": "总统召开了一场发布会，以回应新闻<w>媒体</w>的提问。"
                            }
                        }
                    ],
                    "synonyms": [
                        "press",
                        "journalism"
                    ],
                    "common_phrases": [
                        "social media",
                        "mass media",
                        "news media",
                        "media coverage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Средства и учреждения для публикации и вещания информации.",
                        "zh": "用于发布和传播信息的手段与机构。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "СМИ",
                                "target_lang_sense_clarification": "аббревиатура: средства массовой информации"
                            },
                            {
                                "target_lang_word": "медиа",
                                "target_lang_sense_clarification": "современный термин, часто в сочетании с \"социальные\""
                            },
                            {
                                "target_lang_word": "средства массовой информации",
                                "target_lang_sense_clarification": "полный официальный термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "媒体",
                                "target_lang_sense_clarification": "大众传播媒介"
                            },
                            {
                                "target_lang_word": "新闻媒体",
                                "target_lang_sense_clarification": "专门报道新闻的机构"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "694cf204-cee5-3357-a57b-1af2e5db556a",
                    "sense_definition": "The journalists and other professionals who comprise the mass communication industry.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "mass_communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The celebrity tried to avoid the <w>media</w> by leaving through the back door.",
                            "target_lang_translations": {
                                "ru": "Знаменитость пыталась избежать <w>СМИ</w>, выйдя через черный ход.",
                                "zh": "那位名人试图从后门离开以避开<w>媒体</w>。"
                            }
                        },
                        {
                            "text": "Members of the <w>media</w> were invited to preview the new exhibition.",
                            "target_lang_translations": {
                                "ru": "Представители <w>СМИ</w> были приглашены на предварительный просмотр новой выставки.",
                                "zh": "<w>媒体</w>代表受邀参加了新展览的预展。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "the media",
                        "local media"
                    ],
                    "target_lang_definitions": {
                        "ru": "Журналисты и другие профессионалы, составляющие индустрию массовых коммуникаций.",
                        "zh": "从事大众传播行业的记者及其他专业人员。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "СМИ",
                                "target_lang_sense_clarification": "собирательное значение: журналисты и репортеры"
                            },
                            {
                                "target_lang_word": "пресса",
                                "target_lang_sense_clarification": "печатные издания и их представители"
                            },
                            {
                                "target_lang_word": "журналисты",
                                "target_lang_sense_clarification": "работники медиасферы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "媒体",
                                "target_lang_sense_clarification": "指代新闻工作者群体"
                            },
                            {
                                "target_lang_word": "新闻界",
                                "target_lang_sense_clarification": "新闻从业人员的统称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4cd6709e-225b-36f9-8478-3daac80434d7",
                    "sense_definition": "The totality of content items (television shows, films, books, photographs, etc.) which are broadcast or published.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mass_communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Parents should monitor the <w>media</w> that their children consume daily.",
                            "target_lang_translations": {
                                "ru": "Родители должны контролировать <w>медиаконтент</w>, который их дети потребляют ежедневно.",
                                "zh": "家长应该监督孩子每天接触的<w>媒体内容</w>。"
                            }
                        },
                        {
                            "text": "The library has a large collection of digital <w>media</w> available for loan.",
                            "target_lang_translations": {
                                "ru": "В библиотеке есть большая коллекция цифровых <w>медиа</w>, доступных для абонемента.",
                                "zh": "图书馆收藏了大量可供借阅的数字<w>媒体</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "digital media",
                        "popular media"
                    ],
                    "target_lang_definitions": {
                        "ru": "Совокупность контента (телепередачи, фильмы, книги, фотографии и т.д.), который транслируется или публикуется.",
                        "zh": "通过广播或出版的全部内容（如电视节目、电影、书籍、照片等）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "медиаконтент",
                                "target_lang_sense_clarification": "содержание информационных ресурсов"
                            },
                            {
                                "target_lang_word": "медиа",
                                "target_lang_sense_clarification": "цифровые материалы"
                            },
                            {
                                "target_lang_word": "медиапродукция",
                                "target_lang_sense_clarification": "произведенный контент"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "媒体内容",
                                "target_lang_sense_clarification": "传播的各类信息产品"
                            },
                            {
                                "target_lang_word": "媒体产品",
                                "target_lang_sense_clarification": "制作完成的传播素材"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7e313c42-f622-32ee-8b07-cdf38a6343b7",
                    "sense_definition": "Files and data comprising material viewable by humans, but usually not plain text; audiovisual material.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should back up your photos and other <w>media</w> to an external drive.",
                            "target_lang_translations": {
                                "ru": "Вам следует создать резервную копию фотографий и других <w>медиафайлов</w> на внешний диск.",
                                "zh": "你应该把照片和其他<w>媒体文件</w>备份到外接硬盘上。"
                            }
                        },
                        {
                            "text": "The website supports various forms of rich <w>media</w> to engage users.",
                            "target_lang_translations": {
                                "ru": "Веб-сайт поддерживает различные формы обогащенных <w>медиа</w> для вовлечения пользователей.",
                                "zh": "该网站支持多种形式的富<w>媒体</w>以吸引用户。"
                            }
                        }
                    ],
                    "synonyms": [
                        "M"
                    ],
                    "common_phrases": [
                        "rich media",
                        "media file"
                    ],
                    "target_lang_definitions": {
                        "ru": "Файлы и данные, содержащие материалы для просмотра (обычно не простой текст); аудиовизуальные материалы.",
                        "zh": "包含人类可查看材料（通常非纯文本）的文件和数据；视听材料。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "медиафайлы",
                                "target_lang_sense_clarification": "файлы с аудио, видео или изображениями"
                            },
                            {
                                "target_lang_word": "мультимедиа",
                                "target_lang_sense_clarification": "комбинированные форматы данных"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "多媒体",
                                "target_lang_sense_clarification": "结合多种形式的数字内容"
                            },
                            {
                                "target_lang_word": "媒体文件",
                                "target_lang_sense_clarification": "音频、视频或图像文件"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d2388771-ca94-382c-afab-1c9f57b46cfb",
                    "sense_definition": "Plural of <w>medium</w> (only in certain senses).",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "plural_forms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Air and water are the physical <w>media</w> through which sound waves travel.",
                            "target_lang_translations": {
                                "ru": "Воздух и вода — это физические <w>среды</w>, через которые распространяются звуковые волны.",
                                "zh": "空气和水是声波传播的物理<w>介质</w>。"
                            }
                        },
                        {
                            "text": "The artist works with mixed <w>media</w> to create unique textures in her paintings.",
                            "target_lang_translations": {
                                "ru": "Художница работает со смешанными <w>материалами</w>, чтобы создать уникальные текстуры на своих картинах.",
                                "zh": "这位艺术家使用混合<w>媒介</w>在画作中创造出独特的质感。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "mixed media"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "plural of medium"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Множественное число от слова medium (среда, средство, носитель).",
                        "zh": "medium 的复数形式（指媒介、介质或手段）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "среды",
                                "target_lang_sense_clarification": "физические субстанции"
                            },
                            {
                                "target_lang_word": "средства",
                                "target_lang_sense_clarification": "способы или материалы (в искусстве)"
                            },
                            {
                                "target_lang_word": "носители",
                                "target_lang_sense_clarification": "физические объекты для передачи чего-либо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "介质",
                                "target_lang_sense_clarification": "物理传播媒介"
                            },
                            {
                                "target_lang_word": "媒介",
                                "target_lang_sense_clarification": "艺术创作或科学实验的手段"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8bfac5f1-7354-300b-ab03-f342f3d49701",
                    "sense_definition": "Plural of <w>medium</w> (“someone who supposedly conveys information from the spirit world”).",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "plural_forms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "During the nineteenth century, many famous <w>media</w> claimed to speak with the dead.",
                            "target_lang_translations": {
                                "ru": "В девятнадцатом веке многие известные <w>медиумы</w> утверждали, что говорят с мертвыми.",
                                "zh": "在十九世纪，许多著名的<w>灵媒</w>声称能与死者对话。"
                            }
                        },
                        {
                            "text": "The researcher studied how these <w>media</w> entered a trance state during the seance.",
                            "target_lang_translations": {
                                "ru": "Исследователь изучал, как эти <w>медиумы</w> входили в состояние транса во время сеанса.",
                                "zh": "研究人员观察了这些<w>灵媒</w>如何在降神会中进入恍惚状态。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "plural of medium"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Множественное число от слова medium (медиум - посредник между миром живых и мертвых).",
                        "zh": "medium 的复数形式（指声称能与灵界沟通的人）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "медиумы",
                                "target_lang_sense_clarification": "люди, общающиеся с духами"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "灵媒",
                                "target_lang_sense_clarification": "声称能与鬼神沟通的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e37ab165-4d1f-344a-869f-a2e018e3410c",
                    "sense_definition": "The middle layer of the wall of a blood vessel or lymph vessel which is composed of connective and muscular tissue.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Damage to the tunica <w>media</w> can weaken the structural integrity of the artery.",
                            "target_lang_translations": {
                                "ru": "Повреждение tunica <w>media</w> может ослабить структурную целостность артерии.",
                                "zh": "动脉<w>中膜</w>受损会削弱动脉的结构完整性。"
                            }
                        },
                        {
                            "text": "The <w>media</w> contains smooth muscle cells that help regulate blood pressure.",
                            "target_lang_translations": {
                                "ru": "<w>Медиа</w> содержит гладкомышечные клетки, которые помогают регулировать кровяное давление.",
                                "zh": "血管<w>中膜</w>含有有助于调节血压的平滑肌细胞。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "tunica media"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "technical anatomy"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Средняя оболочка стенки кровеносного или лимфатического сосуда.",
                        "zh": "血管或淋巴管壁的中间层，由结缔组织和肌肉组织构成。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "медиа",
                                "target_lang_sense_clarification": "анатомический термин"
                            },
                            {
                                "target_lang_word": "средняя оболочка",
                                "target_lang_sense_clarification": "описательный перевод"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "中膜",
                                "target_lang_sense_clarification": "血管壁的解剖学结构"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7199ae36-d945-3645-8813-f5400795dd12",
                    "sense_definition": "A voiced stop consonant.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In Ancient Greek, the <w>media</w> consonants were voiced stops like beta and delta.",
                            "target_lang_translations": {
                                "ru": "В древнегреческом языке согласные <w>медиа</w> были звонкими смычными, как бета и дельта.",
                                "zh": "在古希腊语中，<w>浊音</w>辅音是指像 beta 和 delta 那样的浊塞音。"
                            }
                        },
                        {
                            "text": "The shift from a tenuis to a <w>media</w> is a common phonological process.",
                            "target_lang_translations": {
                                "ru": "Переход от tenuis к <w>media</w> является распространенным фонологическим процессом.",
                                "zh": "从清音到<w>浊音</w>的转变是一种常见的语音演变过程。"
                            }
                        }
                    ],
                    "antonyms": [
                        "tenuis"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "technical linguistics"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Звонкий смычный согласный.",
                        "zh": "一种浊塞音。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "медиа",
                                "target_lang_sense_clarification": "лингвистический термин"
                            },
                            {
                                "target_lang_word": "звонкий смычный",
                                "target_lang_sense_clarification": "описание звука"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "浊音",
                                "target_lang_sense_clarification": "语言学中的浊辅音"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0c22bcb7-8e0b-3119-beaa-62fd63074aa2",
                    "sense_definition": "Clipping of <w>multimedia</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "computing_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I need to install a new <w>media</w> player to watch this video format.",
                            "target_lang_translations": {
                                "ru": "Мне нужно установить новый <w>медиа</w>плеер, чтобы смотреть этот видеоформат.",
                                "zh": "我需要安装一个新的<w>媒体</w>播放器才能观看这种视频格式。"
                            }
                        },
                        {
                            "text": "The laptop has dedicated <w>media</w> keys for controlling volume and playback.",
                            "target_lang_translations": {
                                "ru": "У ноутбука есть специальные <w>медиа</w>-клавиши для управления громкостью и воспроизведением.",
                                "zh": "这台笔记本电脑配有专门的<w>媒体</w>键，用于控制音量和播放。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "media player",
                        "media center",
                        "media file"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращение от \"мультимедийный\".",
                        "zh": "多媒体（multimedia）的缩写。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "медиа-",
                                "target_lang_sense_clarification": "первая часть сложных слов"
                            },
                            {
                                "target_lang_word": "мультимедийный",
                                "target_lang_sense_clarification": "полное прилагательное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "媒体",
                                "target_lang_sense_clarification": "用于复合词中表示多媒体相关"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "d22e7509-51c9-3217-a147-165a219e4693",
                    "sense_definition": "A geographic region and ancient satrapy of the Persian Empire in northwestern Iran, originally inhabited by the Medes.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "history",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "Cyrus the Great conquered <w>Media</w> and incorporated it into the Persian Empire.",
                            "target_lang_translations": {
                                "ru": "Кир Великий завоевал <w>Мидию</w> и включил ее в состав Персидской империи.",
                                "zh": "居鲁士大帝征服了<w>米底</w>，并将其并入波斯帝国。"
                            }
                        },
                        {
                            "text": "The ancient kingdom of <w>Media</w> played a significant role in the history of the Near East.",
                            "target_lang_translations": {
                                "ru": "Древнее царство <w>Мидия</w> сыграло значительную роль в истории Ближнего Востока.",
                                "zh": "古老的<w>米底</w>王国在近东历史上发挥了重要作用。"
                            }
                        }
                    ],
                    "traits": [
