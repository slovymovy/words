                                "example_id": "cf334731-ae31-4582-a68d-641d5d28578f",
                                "sense_id": "e8757219-f24d-3f43-886f-16ca829376fa",
                                "text": "Царь кричит на весь базар: // «Ахти, батюшки, пожар! // Эй, решёточных сзывайте! // Заливайте! заливайте!»"
                            }
                        ]
                    }
                ],
                "translations": [
