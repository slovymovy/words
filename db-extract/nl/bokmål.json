                        "sense_id": "bae7b908-4ad2-338f-a959-bdaa17b308c0",
                        "entry_id": "960455f4-3ddf-3d12-a05c-12c04ccaccf3",
                        "glosses": [
                            "meest gebruikte schrijfwijze van het Noors"
                        ],
                        "tags": [
                            "linguistics",
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "de4f0e36-c51b-4633-8c4d-ae8037379504",
                                "sense_id": "bae7b908-4ad2-338f-a959-bdaa17b308c0",
                                "text": "Ook in Noorwegen is de cultuurtaal vanuit het voormalige culturele centrum (i.c. Denemarken) geïmporteerd, maar onmiddellijk na de onafhankelijkheid zijn er bewuste pogingen gedaan om die erfenis in zekere mate te vernoorsen: minimaal in het Bokmål, maximaal in het Nynorsk."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "30843686-9444-42d3-8958-3f5ab0730d32",
                        "source_entry_id": "960455f4-3ddf-3d12-a05c-12c04ccaccf3",
                        "source_sense_id": "bae7b908-4ad2-338f-a959-bdaa17b308c0",
                        "source_sense_description": "meest gebruikte schrijfwijze van het Noors",
                        "target_lang_word": "Bokmål",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bokmål",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2e243609-5a95-35cf-b8d3-b7398024bcc6",
                                        "entry_id": "7015c611-74fe-3b26-93db-4051ef8d1187",
                                        "glosses": [
                                            "offizielle Sprachvarietät der norwegischen Sprache, die aus dem Dänischen gebildet wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32e319f9-78a0-4a8c-bd60-939e0305b03d",
                                                "sense_id": "2e243609-5a95-35cf-b8d3-b7398024bcc6",
                                                "text": "„Nynorsk hingegen hat mehr Gemeinsamkeiten mit den westskandinavischen Sprachen Färöisch und Isländisch als Bokmål, Dänisch und Schwedisch.“"
                                            },
                                            {
                                                "example_id": "e3619c70-1581-40d5-813a-40e896caa4b0",
                                                "sense_id": "2e243609-5a95-35cf-b8d3-b7398024bcc6",
                                                "text": "„Norwegischkurse für nicht-norwegische Muttersprachler erfolgen zudem auch stets in Bokmål.“"
                                            },
                                            {
                                                "example_id": "f6355666-1b0d-4fd9-ac46-a1cbe373be17",
                                                "sense_id": "2e243609-5a95-35cf-b8d3-b7398024bcc6",
                                                "text": "„Vergleicht man die syntaktischen Verhältnisse im Bokmål mit denen des Nynorsk, ergeben sich nur einige wenige Unterschiede.“"
                                            },
                                            {
                                                "example_id": "64ac30d6-e9f6-44b5-87f6-859590efdc20",
                                                "sense_id": "2e243609-5a95-35cf-b8d3-b7398024bcc6",
                                                "text": "„Bokmål ist heute die Schriftsprache von 85-90% der Norweger und dominiert viele Gesellschaftsbereiche.“"
                                            },
                                            {
                                                "example_id": "23b7d0b7-7c36-47f5-a472-13e76b9b1700",
                                                "sense_id": "2e243609-5a95-35cf-b8d3-b7398024bcc6",
                                                "text": "„Eine Besonderheit seines Schreibens besteht darin, dass er seine Bücher auf Nynorsk verfasste, einer westnorwegischen Sprachvariante, die nicht dem klassischen Buchnorwegisch Bokmål entspricht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "39af84b1-cb07-442f-90d6-1f27395a017b",
                        "source_entry_id": "960455f4-3ddf-3d12-a05c-12c04ccaccf3",
