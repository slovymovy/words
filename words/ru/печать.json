                                "target_lang_word": "tampon",
                                "target_lang_sense_clarification": "outil pour marquer"
                            },
                            {
                                "target_lang_word": "sceau",
                                "target_lang_sense_clarification": "empreinte officielle ou outil officiel"
                            }
                        ]
                    }
