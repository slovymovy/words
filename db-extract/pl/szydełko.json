                    {
                        "translation_id": "72fe71bf-22eb-4854-bf02-86c1c333da56",
                        "source_entry_id": "11dd000a-6892-33e8-8ecc-91a83bacfc5d",
                        "source_sense_id": "6a38be4d-a134-380e-ab7a-7f6178dfd831",
                        "target_lang_word": "крючок",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "крючок",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "efa9a5d8-065d-3967-91a8-9cc7ed14b92c",
                                        "entry_id": "04dcc60f-2004-394a-83c3-fefea425404b",
                                        "glosses": [
                                            "уменьш. от крюк"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a3b85c4-00e0-4539-aed6-a2364e36334f",
                                                "sense_id": "efa9a5d8-065d-3967-91a8-9cc7ed14b92c",
                                                "text": "В передней шубу с меня снимали две бабы, а повесил её на крючок мужик в красной рубахе."
                                            },
                                            {
                                                "example_id": "8520d756-cbf3-480b-ba5c-316e58bc91fb",
                                                "sense_id": "efa9a5d8-065d-3967-91a8-9cc7ed14b92c",
                                                "text": "Телегин тщательно запер двери на все крючки и задвижки."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a650e52-25c8-3bbc-b012-56168b937887",
                                        "entry_id": "04dcc60f-2004-394a-83c3-fefea425404b",
                                        "glosses": [
                                            "инструмент для вязания"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f510786-c6f4-4393-a20e-7dbe66395384",
                                                "sense_id": "4a650e52-25c8-3bbc-b012-56168b937887",
                                                "text": "Он сел на кресло рядом с Шурочкой, которая, быстро мелькая крючком, вязала какое-то кружево."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b49e307-374a-3a95-bac3-4947b879a946",
                                        "entry_id": "04dcc60f-2004-394a-83c3-fefea425404b",
                                        "glosses": [
                                            "элемент застёжки в виде маленького крючка [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c30eeef-1ddb-454d-a99f-80b10c394f01",
                                                "sense_id": "6b49e307-374a-3a95-bac3-4947b879a946",
                                                "text": "Его большое, распухшее, неповоротливое тело было стянуто в длинный сюртук, похожий на кучерской кафтан, с крючками и с петлями вместо пуговиц .."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e135faf8-6a83-30a4-91cb-4714fd7b64f7",
                                        "entry_id": "04dcc60f-2004-394a-83c3-fefea425404b",
                                        "glosses": [
                                            "то же, что рыболовный крючок"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9eebb739-7aa4-4182-8530-7f958e97204d",
                                                "sense_id": "e135faf8-6a83-30a4-91cb-4714fd7b64f7",
                                                "text": "Он забавно изображал, как ходят рыбы вокруг наживки, как бьются, попав на крючок, окуни, голавли, лещи."
                                            },
                                            {
                                                "example_id": "8c4c7d63-53de-4597-b915-89afd1edde7e",
                                                "sense_id": "e135faf8-6a83-30a4-91cb-4714fd7b64f7",
                                                "text": ".. дядя Хрисанф рассказывал о рыбной ловле: крупная рыба у него всегда срывалась с крючка, а домой он приносил костистую мелочь, которую нельзя есть."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7df34047-0c1f-33f8-bcda-e7238938c7cf",
                                        "entry_id": "04dcc60f-2004-394a-83c3-fefea425404b",
                                        "glosses": [
                                            "перен. любой объект подобной формы"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ddd9385b-d672-3ba0-9cab-be49f65e5664",
                                        "entry_id": "04dcc60f-2004-394a-83c3-fefea425404b",
                                        "glosses": [
                                            "перен. неодобр. устар. то же, что крючкотвор, бюрократ и волокитчик"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb9622a8-ce5a-4575-ab82-ae8e2697d2ff",
                                                "sense_id": "ddd9385b-d672-3ba0-9cab-be49f65e5664",
                                                "text": "[Василий Михалыч:] .. такие жадные, канальи, эти крючки подьячие, .. что когда туда [в суд] приедешь, так и обступят .."
                                            },
                                            {
                                                "example_id": "559f3a24-8071-452b-9839-2f2cff0f845e",
                                                "sense_id": "ddd9385b-d672-3ba0-9cab-be49f65e5664",
                                                "text": "Стоит ли мешать судейских крючков в соседские дела?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
