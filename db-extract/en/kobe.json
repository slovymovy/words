                    {
                        "sense_id": "78b8d4f2-41e2-3ad4-a450-5707d714fc79",
                        "entry_id": "7c72dfc9-33d4-36f4-9fdd-0c0469247055",
                        "glosses": [
                            "Exclaimed, while throwing something at a target, as a prediction or acknowledgement of accuracy."
                        ],
                        "tags": [
                            "US",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "35d7b56d-4153-45a8-aee4-bb26a72ccc1a",
                                "sense_id": "78b8d4f2-41e2-3ad4-a450-5707d714fc79",
                                "text": "(throws aforementioned paper cup at Russell Byrd– hits Byrd in the head) KOBE!\n[…]\nDerrick Nix: Are you serious? You threw a crumpled paper cup at his head, hit him, and then yelled “Kobe!”"
                            },
                            {
                                "example_id": "63f286dd-3c9e-4092-9aff-138e97661caf",
                                "sense_id": "78b8d4f2-41e2-3ad4-a450-5707d714fc79",
                                "text": "Miguel: When you write a bad draft of your Signal article, there’s only one thing to do to it — smash it up into a ball, throw it to the nearest recycle bin and scream “KOBE!”"
                            },
                            {
                                "example_id": "1666f11d-ed11-493f-ad9f-61c4de8b48df",
                                "sense_id": "78b8d4f2-41e2-3ad4-a450-5707d714fc79",
                                "text": "As I spend 10 minutes debating what to order, a kid nearby entertains himself by squirting free edamame beans across the restaurant. I try the same, saying “Kobe!” as I shoot one in my mouth at arm’s length on the first try."
                            }
                        ]
                    }
                ],
