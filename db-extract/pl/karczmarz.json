                    {
                        "translation_id": "339d28ff-750e-4611-94ca-587cb8a931ff",
                        "source_entry_id": "2acb697f-e337-3d3f-88c4-a0a6ecb53900",
                        "source_sense_id": "eecdd54e-03df-380c-8d7c-4022ecce3452",
                        "target_lang_word": "Gastwirt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gastwirt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3630f570-8c18-31d6-a880-78372ff2a992",
                                        "entry_id": "33a6b304-f50f-3cc4-a48d-732775249cef",
                                        "glosses": [
                                            "Person, die eigenverantwortlich einen Gastronomiebetrieb leitet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "262cf338-0031-4186-8aed-78fc175ad733",
                                                "sense_id": "3630f570-8c18-31d6-a880-78372ff2a992",
                                                "text": "„Im Jahr der französischen Revolution übernahm der 22-jährige Hofer mit dem Sandhof auch das Erbe der Eltern und konzentrierte sich fortan auf die Tätigkeit als Gastwirt sowie des Pferde- und Branntweinhändlers.“"
                                            },
                                            {
                                                "example_id": "ad8c471e-8b47-4429-bc2d-0b3f555d5d75",
                                                "sense_id": "3630f570-8c18-31d6-a880-78372ff2a992",
                                                "text": "„Gastwirte boten einsamen Okkupanten neben warmen Speisen auch wärmende Germaninnen.“"
                                            },
                                            {
                                                "example_id": "4f397e56-c095-4109-afa2-e4ffed0f2d7a",
                                                "sense_id": "3630f570-8c18-31d6-a880-78372ff2a992",
                                                "text": "„Während meiner Jahre als Gastwirt im Thüringer Wald zahlte sich das natürlich aus, denn in jenen Tagen gehörte die Kleintierhaltung besonders im ländlichen Thüringen zur alltäglichen Praxis.“"
                                            },
                                            {
                                                "example_id": "8d2ca837-2194-4147-a890-534521ac43d4",
                                                "sense_id": "3630f570-8c18-31d6-a880-78372ff2a992",
                                                "text": "„Die Geschäftsleute, Zimmervermieter, Pensionsbetreiber und Gastwirte versuchten, möglichst viel von diesem Geld in ihre Kassen zu leiten und gleichzeitig ihre Töchter von den reichen Herrchen mit den mächtigen Vätern fernzuhalten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "17370475-899c-452a-bece-cff18bf2c7b0",
                        "source_entry_id": "2acb697f-e337-3d3f-88c4-a0a6ecb53900",
                        "source_sense_id": "eecdd54e-03df-380c-8d7c-4022ecce3452",
                        "target_lang_word": "Krüger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Krüger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7b619199-e9cb-3993-a1f9-e44f09cc4817",
                                        "entry_id": "057679aa-88fe-3b3c-a3ab-2235b6cebd78",
                                        "glosses": [
                                            "Inhaber eines Kruges (eines Lokals)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff84318e-c0d1-4015-a0fe-d18dc3d72da5",
                                                "sense_id": "7b619199-e9cb-3993-a1f9-e44f09cc4817",
                                                "text": "„Der nimmt hastig einen Schluck, bestellt noch einen zweistöckigen Schnaps und fragt den Krüger unmotiviert nach dem Wege zum Bahnhof.“"
                                            },
                                            {
                                                "example_id": "faac76ce-a904-4336-9bf9-e5daebd3e0e1",
                                                "sense_id": "7b619199-e9cb-3993-a1f9-e44f09cc4817",
                                                "text": "„Die Bauern waren mit ihrem neuen Krüger zufrieden, zumal es im Blauen Schimmel von Tag zu Tag ungemütlicher wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Krüger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dd57204b-66e7-30b9-83c1-1041fe1a29d2",
                                        "entry_id": "ec12a36f-2ca3-3b0a-a18e-a8a6579ea5bf",
                                        "glosses": [
                                            "deutscher Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82ff11bc-5115-4dca-97d8-8c1aa5715d5d",
                                                "sense_id": "dd57204b-66e7-30b9-83c1-1041fe1a29d2",
                                                "text": "Harald Krüger wurde im Mai 2015 Vorsitzender des Vorstands der BMW AG."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
