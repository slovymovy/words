                ],
                "senses": [
                    {
                        "sense_id": "251038e2-496c-39d4-884f-3b8e4cc3e83f",
                        "entry_id": "9969b523-cfd9-336c-b404-2a9865c43de6",
                        "glosses": [
                            "der Teil einer Liegestatt, an dem die Füße liegen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4fda294-feb2-4972-a2d9-1d4899019888",
                                "sense_id": "251038e2-496c-39d4-884f-3b8e4cc3e83f",
                                "text": "„Er stand auf, legte die Mappe ans Fußende unter das Bett, ging in das kleine Wohnzimmer, sah sich um, entdeckte einen grünen Kachelofen.“"
                            },
                            {
                                "example_id": "142afb57-64dd-498c-bf97-f7ed16c75d19",
                                "sense_id": "251038e2-496c-39d4-884f-3b8e4cc3e83f",
                                "text": "„Einige Tage später war sie auf den Friedhof gegangen und entdeckte ein großes Loch am Fußende von Hjartvards Grab.“"
                            },
                            {
                                "example_id": "db6cf9c6-53a9-482b-aa00-de4fdb2fcaab",
                                "sense_id": "251038e2-496c-39d4-884f-3b8e4cc3e83f",
                                "text": "„Sie lehnten den fix und fertig angezogenen Major an die lange Wand, nicht weit vom Fußende des großen Messingbettes.“"
                            },
                            {
                                "example_id": "64d8d997-8837-4952-9dbb-c9bf9e64e835",
                                "sense_id": "251038e2-496c-39d4-884f-3b8e4cc3e83f",
                                "text": "„Er ließ seine Augen zum Fußende des Bettes schweifen und erfaßte dort den wie ein Wurfgeschoß geformten Behälter, der kopfüber in einem Drahtrahmen hing.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
