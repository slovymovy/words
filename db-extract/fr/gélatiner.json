                        "entry_id": "234db5be-4129-391a-bd0c-9c46b7a67bcc",
                        "glosses": [
                            "Couvrir de gélatine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e85efd6-d8e5-4b2c-a536-8f213dc4bf5f",
                                "sense_id": "eca12285-7b14-36c8-bd89-b7ace4c1053a",
                                "text": "Bonsoir, je me pose une question: est-il intéressant / utile de gélatiner son papier pour réaliser des cyanotypes ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "08424901-e67d-38b3-813f-d9aa26c6375d",
                        "entry_id": "234db5be-4129-391a-bd0c-9c46b7a67bcc",
                        "glosses": [
                            "Couvrir d’une gélatine (disque coloré)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1eea9704-8943-4223-861c-8ded73b68f4c",
                                "sense_id": "08424901-e67d-38b3-813f-d9aa26c6375d",
                                "text": "Merci d'installer, de câbler et de gélatiner les projecteurs avant l'arrivée de la compagnie suivant le plan de feu fournit par notre éclairagiste."
                            }
                        ]
                    },
                    {
                        "sense_id": "a0992410-13a5-3bca-b54a-ac44f6ff1d2f",
                        "entry_id": "234db5be-4129-391a-bd0c-9c46b7a67bcc",
                        "glosses": [
                            "Prendre une consistance gélatineuse."
                        ],
                        "tags": [
