                        "source_sense_id": "efa287dc-452c-3c8f-b25d-5e30029d6c87",
                        "target_lang_word": "hearing",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hearing",
