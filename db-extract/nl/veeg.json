                    {
                        "sense_id": "2512884c-e68c-375c-b75a-1dbab0a2a234",
                        "entry_id": "3e6c5dda-d34b-38e0-9a85-a77fddee9159",
                        "glosses": [
                            "vlek ontstaan door vegen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26223c76-f937-4159-a4ea-1f5da58813e7",
                                "sense_id": "2512884c-e68c-375c-b75a-1dbab0a2a234",
                                "text": "'Hoor je me? Wegwezenl' Nella deinst achteruit, geschokt door de felheid in Marens stem, haar furieuze blik de schokkende veeg bloed op haar wang."
                            },
                            {
                                "example_id": "c9aa5d65-272b-434d-9efd-b7037dd9451a",
                                "sense_id": "2512884c-e68c-375c-b75a-1dbab0a2a234",
                                "text": "En zag opeens een veeg grijs in zijn haar die me eerder nog niet was opgevallen."
                            },
                            {
                                "example_id": "993dd3c2-2b1a-483e-97d9-a68783cac220",
                                "sense_id": "2512884c-e68c-375c-b75a-1dbab0a2a234",
                                "text": "Hoezo? Is er iets mee?' Ze liet haar duim over de hals glijden, een schone veeg door het stof."
                            }
                        ]
                    },
                    {
                        "sense_id": "9a3d302e-2b10-34cc-8c65-809c42ecd665",
                        "entry_id": "3e6c5dda-d34b-38e0-9a85-a77fddee9159",
                        "glosses": [
                            "slag of streek"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "377afcf5-313d-43fb-af65-3824e25ab1c4",
                                "sense_id": "9a3d302e-2b10-34cc-8c65-809c42ecd665",
                                "text": "Die kan wel een veeg lippenstift gebruiken."
                            }
                        ]
                    }
                ],
