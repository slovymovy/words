                        "glosses": [
                            "Perdre son temps."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3678a459-b105-4c42-b6a2-44979f12b1a4",
                                "sense_id": "b86b6a5f-b275-3163-afd5-6b7b67554c12",
                                "text": "Et, avec ça, un travailleur, qui ne perd point son temps à berlauder dans les rues."
                            },
                            {
                                "example_id": "43252281-58ac-4797-af10-6bc26ea21ce9",
                                "sense_id": "b86b6a5f-b275-3163-afd5-6b7b67554c12",
                                "text": "C'est aussi une occasion de discuter, berlauder, parler pour ne rien dire, de ce qui marche ou le plus souvent de ce qui ne va pas dans leurs fermes respectives."
                            }
                        ]
                    }
