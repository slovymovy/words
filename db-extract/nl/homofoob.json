                "translations": [
                    {
                        "translation_id": "3488db91-d28b-4ce4-a933-6b189479f6ff",
                        "source_entry_id": "562ced92-6519-3e1a-b11b-c379de239751",
                        "source_sense_id": "44e59998-fa4b-3953-b7fa-33513f083df5",
                        "target_lang_word": "homophobic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "homophobic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "60e54c97-4740-3f4f-a8b3-7aafcaca3a11",
                                        "entry_id": "c07d9859-2b34-3df7-9e2b-799b85fbf115",
                                        "glosses": [
                                            "Exhibiting homophobia; characteristic of homophobes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef8f715a-ea47-464a-b771-b0ce5247aef6",
                                                "sense_id": "60e54c97-4740-3f4f-a8b3-7aafcaca3a11",
                                                "text": "homophobic abuse"
                                            },
                                            {
                                                "example_id": "f5ea426d-7530-41a0-b18b-cdc19af3c2d5",
                                                "sense_id": "60e54c97-4740-3f4f-a8b3-7aafcaca3a11",
                                                "text": "The nail bomber who killed three people and injured dozens of others in a terrifying campaign last spring told police he was a homophobic Nazi, and that he hoped the explosions would \"set fire to the country and stir up a racial war\", the Old Bailey heard yesterday."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e0caa55-f4fe-38c3-94bd-931ed627f8e5",
                                        "entry_id": "c07d9859-2b34-3df7-9e2b-799b85fbf115",
                                        "glosses": [
                                            "Inconvenient, annoying, irritating."
                                        ],
                                        "tags": [
                                            "excessive",
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5c10938-52ed-4ae9-9d54-601161bb36a8",
                                                "sense_id": "6e0caa55-f4fe-38c3-94bd-931ed627f8e5",
                                                "text": "My bus left right as I got to the station. It's so homophobic of the driver to not wait for me!"
                                            },
                                            {
                                                "example_id": "4168619c-b4fd-40aa-badd-e04d6b3f4314",
                                                "sense_id": "6e0caa55-f4fe-38c3-94bd-931ed627f8e5",
                                                "text": "It's homophobic that I'm not cuddling my girlfriend right now."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "homophobic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b641b398-c260-3c1f-b265-b11f8aa87d08",
                                        "entry_id": "b294ac69-1b92-35b5-a7f7-055b21e32f17",
                                        "glosses": [
                                            "A homophobe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7dab29d0-6214-4d9e-a67a-d0672463bdee",
                                                "sense_id": "b641b398-c260-3c1f-b265-b11f8aa87d08",
                                                "text": "Painful as skid row life is for everyone, it becomes doubly so for the gay segment of the population. If you can for a moment visualize yourself living in a house with hundreds of homophobics you have the idea; and there are few closets where one can hide."
                                            },
                                            {
                                                "example_id": "56a1765d-e696-43cb-8c24-aa51b8b81099",
                                                "sense_id": "b641b398-c260-3c1f-b265-b11f8aa87d08",
                                                "text": "If you say something negative about homosexuals, you will be labelled an intolerant \"homophobic.\""
                                            },
                                            {
                                                "example_id": "b44f9d08-d92c-45ee-9eca-46766a14f2c7",
                                                "sense_id": "b641b398-c260-3c1f-b265-b11f8aa87d08",
                                                "text": "When placed in a situation that threatens to excite their repressed or latent sexual preferences, homophobics tend to react with panic, anger, and hostility as a means to avert or deny the threat (West, 1977)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "26dfdc03-db0f-4f95-a18a-ee32b03a8963",
                        "source_entry_id": "562ced92-6519-3e1a-b11b-c379de239751",
                        "source_sense_id": "44e59998-fa4b-3953-b7fa-33513f083df5",
                        "target_lang_word": "homophobe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "homophobe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c9d13d6a-3510-3726-be89-ff975b944e61",
                                        "entry_id": "e926215e-46fb-358a-b861-806a9c14ce65",
                                        "glosses": [
                                            "Relatif à l’aversion pour l’homosexualité ou à une attitude hostile à l’encontre des homosexuels."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b353ef18-938b-4455-bf9a-8f608343651d",
                                                "sense_id": "c9d13d6a-3510-3726-be89-ff975b944e61",
                                                "text": "Il n'est pas besoin, pour être homophobe, de médire des homos, il suffit de ne pas reconnaître assez haut leur droit à la différence ; on est même hétérosexiste, dès lors qu'on fait semblant d'ignorer l'existence des homosexuels."
                                            },
                                            {
                                                "example_id": "0e89ba01-7187-4528-828a-3e072cf16ffc",
                                                "sense_id": "c9d13d6a-3510-3726-be89-ff975b944e61",
                                                "text": "Bien qu'un certain flou et de profonds désaccords subsistent dans ce domaine, la présente publication entend démontrer qu'une bonne part du droit international vise à protéger les jeunes LGBT contre les brimades homophobes et transphobes."
                                            },
                                            {
                                                "example_id": "7ecdeeb7-b1af-4a8c-8196-6cc9bfab0446",
                                                "sense_id": "c9d13d6a-3510-3726-be89-ff975b944e61",
                                                "text": "« Interdire l’homosexualité n’a rien d’homophobe », selon le président sénégalais Macky Sall."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "homophobe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d1ec3b82-5ce4-3154-83a9-507f6b9ff0c8",
                                        "entry_id": "e79778bc-a871-3615-9676-55477f0baa48",
                                        "glosses": [
                                            "Personne qui éprouve, qui manifeste de l’aversion, de l’hostilité pour l’homosexualité ou envers les personnes homosexuelles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74252454-da95-4cae-9a43-331026c4d59e",
                                                "sense_id": "d1ec3b82-5ce4-3154-83a9-507f6b9ff0c8",
                                                "text": "Le candidat Bush et vous-même avez reçu le soutien de Jerry Falwell un homophobe notoire qui n’a pas hésité à mettre en cause publiquement la sexualité de votre fille."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
