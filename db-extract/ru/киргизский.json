                "senses": [
                    {
                        "sense_id": "4ec92714-371c-3bb5-8949-a43c46d94993",
                        "entry_id": "49e63feb-4fdd-3e84-a6a5-5c677b1e4913",
                        "glosses": [
                            "относящийся к Киргизии или киргизам, а также ранее (до 1925 года) и к казахам, хакасам и каракалпакам"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42ff51c4-b964-41ac-ba4d-eb5a7656dddb",
                                "sense_id": "4ec92714-371c-3bb5-8949-a43c46d94993",
                                "text": "Начало художественному переводу в киргизской литературе, как известно, положил старейший писатель Касымалы Баялинов."
                            }
                        ]
                    },
                    {
                        "sense_id": "2be4403c-7a36-37b5-b60f-d108f019b609",
                        "entry_id": "49e63feb-4fdd-3e84-a6a5-5c677b1e4913",
                        "glosses": [
                            "субстантивир. то же, что киргизский язык"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7271692-d526-4478-9888-9026df98e752",
                                "sense_id": "2be4403c-7a36-37b5-b60f-d108f019b609",
                                "text": "Он знал не только казахский, но и киргизский."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d5406bbf-37ea-40c9-8fbd-07b92a4e1bdb",
                        "source_entry_id": "49e63feb-4fdd-3e84-a6a5-5c677b1e4913",
                        "source_sense_description": "относящийся к Киргизии, киргизам",
                        "target_lang_word": "kirgisisch",
