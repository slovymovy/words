                            {
                                "example_id": "1acc6066-a06e-42a2-86f2-3c3bd8fc54bc",
                                "sense_id": "8330420a-d25a-303f-8ec9-265101579746",
                                "text": "„Retrospektywa prac jednego z najważniejszych malarzy XX wieku, mająca ambicje zmienić postrzeganie jego twórczości. Po obejrzeniu 100 prac Wiasilija Kandinskiego mamy przestać myśleć o nim wyłącznie jako o twórcy abstrakcjonizmu.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
