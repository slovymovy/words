                {
                    "sense_id": "67fe7525-bc1a-3e53-8268-5146cc952105",
                    "sense_definition": "Pièce coudée fixée à l'extrémité d'un axe que l'on fait tourner à la main pour actionner un mécanisme.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mecanisme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il suffit de tourner la <w>manivelle</w> pour remonter le seau d'eau du puits."
                        },
                        {
                            "text": "Le meunier actionne la grande <w>manivelle</w> en fer afin d'ouvrir la vanne du moulin."
                        }
                    ],
                    "common_phrases": [
                        "tourner la manivelle",
                        "coup de manivelle"
                    ]
                },
                {
                    "sense_id": "0d3e7a86-265e-3b3f-bfd0-ade254d01a8a",
                    "sense_definition": "Bras du pédalier d'une bicyclette qui relie l'axe central à la pédale.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mecanisme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le cycliste a tordu la <w>manivelle</w> gauche de son vélo lors d'une chute brutale."
                        },
                        {
                            "text": "Il faut vérifier que la <w>manivelle</w> est solidement vissée sur l'axe du pédalier."
                        }
                    ],
                    "common_phrases": [
