                ],
                "senses": [
                    {
                        "sense_id": "4973f3f6-2ada-3b8e-aa80-6f1c819a4541",
                        "entry_id": "fa1a89d8-b418-385a-a02a-ec315b30d43f",
                        "glosses": [
                            "etwas, das jemand sich wirklichkeitsfremd ausgedacht hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f34c8dd4-9263-4651-94b8-152a81dd0234",
                                "sense_id": "4973f3f6-2ada-3b8e-aa80-6f1c819a4541",
                                "text": "„Wohl fielen die Inschriften auf den Denkmälern den Arabern auf; allein deren Deutungsversuche kamen über sinnlose Phantastereien nicht hinaus.“"
                            },
                            {
                                "example_id": "99e29bd1-873a-41de-b014-5c1c52a9b567",
                                "sense_id": "4973f3f6-2ada-3b8e-aa80-6f1c819a4541",
                                "text": "„Diese Gratwanderung im Grenzgebiet zwischen Phantasterei und wissenschaftlich fundierten Visionen hat seit jeher fasziniert…“"
                            },
                            {
                                "example_id": "665136a7-bde6-4bf7-8a32-4776e9339f62",
                                "sense_id": "4973f3f6-2ada-3b8e-aa80-6f1c819a4541",
                                "text": "„Der ganze Gedanke, hierherzukommen, erscheint mir wie eine Phantasterei.“"
                            },
                            {
                                "example_id": "0cab7568-aa1c-4c11-8ff9-69a205c0c8d0",
                                "sense_id": "4973f3f6-2ada-3b8e-aa80-6f1c819a4541",
                                "text": "„Sehr bald hatte Kant Gelegenheit, seine Vorwürfe gegen Phantasterei auf einen Zeitgenossen zu beziehen, auf einen »Visionär«, der gleichzeitig den Ruf eines exakten Wissenschaftlers genoss, auf Emanuel von Swedenborg.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
