                    {
                        "form_id": "f21ae6d7-3904-4593-a04f-7681e40fe1ec",
                        "entry_id": "84cfde6a-f960-3802-a5ed-b04397b37b1a",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Proportionalität"
                    },
                    {
                        "form_id": "2856bca9-53c3-4eb8-a8a6-b174e33ff1eb",
                        "entry_id": "84cfde6a-f960-3802-a5ed-b04397b37b1a",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Proportionalitäten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "dd33cdf5-a3d1-3941-88a2-abc7708c345b",
                        "entry_id": "84cfde6a-f960-3802-a5ed-b04397b37b1a",
                        "glosses": [
                            "Eigenschaft, sich in einem gegebenen Verhältnis (Proportion) zu einer anderen (genannten) Größe zu befinden (proportional zu sein); paralleles Verändern bei Veränderung einer von zwei Größen zu zeigen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e73c60de-7243-4d43-9e02-1e8e4465582c",
                                "sense_id": "dd33cdf5-a3d1-3941-88a2-abc7708c345b",
                                "text": "„Es tritt also nur dynamo-elektrisches Gleichgewicht ein, wenn der Magnetismus von der Proportionalität mit der Stromstärke abweicht, was in Wirklichkeit stets der Fall ist.“"
                            },
                            {
                                "example_id": "e5a27f83-97c4-4c32-99c7-20a97778a8e1",
                                "sense_id": "dd33cdf5-a3d1-3941-88a2-abc7708c345b",
                                "text": "„Im Gegensatz zur bisher herrschenden Vergeltungstheorie, welche die Proportionalität zwischen Tat und Strafe forderte, sei daher die ‚Proportionalität zwischen Strafe und verbrecherischer Gesinnung des Täters‘ zu fordern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "08f54ee0-3a8b-3d0f-aa34-34fe59d1e89c",
                        "entry_id": "84cfde6a-f960-3802-a5ed-b04397b37b1a",
                        "glosses": [
                            "Eigenschaft, passend und angemessen zu sein (häufig zwischen Aktion und Reaktion)"
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "e08ebea6-ff4d-46e3-8ce4-a6ac9b7b7ef5",
                                "sense_id": "08f54ee0-3a8b-3d0f-aa34-34fe59d1e89c",
                                "text": "„Im Gegensatz zur bisher herrschenden Vergeltungstheorie, welche die Proportionalität zwischen Tat und Strafe forderte, sei daher die ‚Proportionalität zwischen Strafe und verbrecherischer Gesinnung des Täters‘ zu fordern.“"
                            },
                            {
                                "example_id": "ba9e8fb2-16b0-4b17-a162-e3f86577a292",
                                "sense_id": "08f54ee0-3a8b-3d0f-aa34-34fe59d1e89c",
                                "text": "„So lassen die Vergleiche des öfteren Angemessenheit und Proportionalität vermissen; den Ausdrücken und Bildern fehlt das Persönliche und Eigenartige, sie sind abgebraucht, oft geschmacklos und überschwenglich.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c8106b0f-806a-48e6-a143-199af8784cb0",
                        "source_entry_id": "84cfde6a-f960-3802-a5ed-b04397b37b1a",
                        "source_sense_id": "dd33cdf5-a3d1-3941-88a2-abc7708c345b",
                        "target_lang_word": "proportionality",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "proportionality",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ddd199dd-de27-3558-8221-34016d571c9c",
                                        "entry_id": "a3d90429-b655-3a18-8b67-37fd61ae9b4c",
                                        "glosses": [
                                            "the property of being proportional"
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "04dee818-7667-3c32-ad76-8c527ff4cfd6",
                                        "entry_id": "a3d90429-b655-3a18-8b67-37fd61ae9b4c",
                                        "glosses": [
                                            "the principle that government action ought to be proportional to the ends achieved (e.g. the military should not be deployed to stop petty vandalism)"
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "baa57243-5fcb-33bd-a95d-d1598690fb87",
                                        "entry_id": "a3d90429-b655-3a18-8b67-37fd61ae9b4c",
                                        "glosses": [
                                            "the degree to which something is in proportion"
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "53f08041-c8bf-47eb-b822-cf548d12ab67",
                        "source_entry_id": "84cfde6a-f960-3802-a5ed-b04397b37b1a",
                        "source_sense_id": "dd33cdf5-a3d1-3941-88a2-abc7708c345b",
                        "target_lang_word": "proportionnalité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "proportionnalité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "76982aba-8fea-3066-afb7-c0af35f1116f",
                                        "entry_id": "65869337-bce5-3ba5-afd2-7ab9f29caf47",
                                        "glosses": [
                                            "Rapport des quantités qui sont proportionnelles entre elles."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8bc807b6-5eb3-48c9-94d0-9d2081e35e8c",
                                                "sense_id": "76982aba-8fea-3066-afb7-c0af35f1116f",
                                                "text": "On peut aussi dire que cette opération est couramment utilisée dans la vie pratique, même si la notion mathématique de proportionnalité n’est pas explicitement requise : la ménagère qui compare le prix de la boîte de 6 yaourts à celui de la boîte de 8 yaourts utilise, inconsciemment peut-être, la notion de proportionnalité."
                                            },
                                            {
                                                "example_id": "09c497d3-4de6-4b25-bbe9-a34810ecc9a5",
                                                "sense_id": "76982aba-8fea-3066-afb7-c0af35f1116f",
                                                "text": "Il y a un principe de proportionnalité dans les réactions qu'on peut avoir vis-à-vis des délinquants."
                                            },
                                            {
                                                "example_id": "5b315bf2-7774-4464-aef3-4664d91700ac",
                                                "sense_id": "76982aba-8fea-3066-afb7-c0af35f1116f",
                                                "text": "Les proportionnalités précédemment démontrées permettent d’écrire l’égalité des rapports."
                                            },
                                            {
                                                "example_id": "366b7c92-c4cf-4bb3-babb-27cf2da2a18c",
                                                "sense_id": "76982aba-8fea-3066-afb7-c0af35f1116f",
                                                "text": "Il convient que les États membres, et en particulier les États membres voisins, coopèrent et se coordonnent étroitement au niveau de l’UE afin de garantir l’efficacité et la proportionnalité des mesures prises."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90d1a2fb-a6b3-3d9a-841b-cea6a4bb2983",
                                        "entry_id": "65869337-bce5-3ba5-afd2-7ab9f29caf47",
                                        "glosses": [
                                            "Nom donné à un principe selon lequel un combattant ou une armée ayant décidé de mener une action militaire (ayant jugé qu'une action militaire était conforme au « principe de nécessité ») ne doit pas utiliser une arme dont la puissance est supérieure à ce qui est nécessaire pour atteindre l’objectif, l’avantage militaire, souhaité afin d’éviter des dommages collatéraux."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8c046682-1528-4119-a99f-f2d8901644a1",
