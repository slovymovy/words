            {
                "entry_id": "b8f588f9-9d5f-33c9-a193-58a3ccd21150",
                "word": "Selma",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "3645ac65-9514-4e71-88ed-80c66fa73d21",
                        "entry_id": "b8f588f9-9d5f-33c9-a193-58a3ccd21150",
                        "tags": [
                            "plural"
                        ],
                        "form": "Selmas"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f2a9393a-b469-3123-a67e-9441d5f9a64d",
                        "entry_id": "b8f588f9-9d5f-33c9-a193-58a3ccd21150",
                        "glosses": [
                            "A confrontation where authorities brutally repress those wanting civil rights, similar to Bloody Sunday in Selma, Alabama."
                        ],
                        "tags": [
                            "US",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "075c7f1c-a84e-45ee-8f01-e2df0da8c9d0",
                                "sense_id": "f2a9393a-b469-3123-a67e-9441d5f9a64d",
                                "text": "Eventually, our place and response may be viewed as a historic turning point, another Selma for the nation and world."
                            },
                            {
                                "example_id": "33f148b6-6106-4543-8028-77a9f75ede9d",
                                "sense_id": "f2a9393a-b469-3123-a67e-9441d5f9a64d",
                                "text": "Shelby County has become the new Selma."
                            },
                            {
                                "example_id": "57d64046-41e3-4ece-88ff-185d67a0bde4",
                                "sense_id": "f2a9393a-b469-3123-a67e-9441d5f9a64d",
                                "text": "\"I don't know how many Selmas you have in your memory,\" she said. \"I have a lot in mine.\""
                            },
                            {
                                "example_id": "6054ed45-777b-45e4-b283-d22f6f1f1902",
                                "sense_id": "f2a9393a-b469-3123-a67e-9441d5f9a64d",
                                "text": "How Many Selmas? Still another city in the south Is learning the hard way that the Negro will settle for nothing less than first class citizenship."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
