                "senses": [
                    {
                        "sense_id": "067db08a-2332-31aa-a8bf-b82985d31892",
                        "entry_id": "dab85fba-095a-30e0-a5c5-9d4e766cd53e",
                        "glosses": [
                            "(männliche) Person, die sehr lange ohne Nahrung auskommt (historisch als öffentliche Attraktion auch oder unfreiwillig aus der Not heraus)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0634cd8b-ddb1-4bf0-83d4-c2cd787427f4",
                                "sense_id": "067db08a-2332-31aa-a8bf-b82985d31892",
                                "text": "„Und auch in Wien kam es zu einem regelrechten Wettkampf um die Gunst des Publikums, bei dem die Hungerkünstler Nicky, Fred Ellern und Max Michelly sich gegenseitig zu überbieten suchten.“"
                            },
                            {
                                "example_id": "bfe04893-1a6d-46b9-a1a3-f4f51b1d1c4a",
                                "sense_id": "067db08a-2332-31aa-a8bf-b82985d31892",
                                "text": "„Lange Jahre war er [Kurt Mühlenhaupt] ein echter Hungerkünstler, schlug sich als Kartoffelschalen-Sammler, Leierkastenmann, Trödelhändler und Kneipenwirt durch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
