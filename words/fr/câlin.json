                    "frequency": "Low",
                    "semantic_group_id": "personne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce petit garçon est un vrai <w>câlin</w> qui adore se blottir dans nos bras."
                        },
                        {
                            "text": "Ne sois pas timide, viens voir ton grand-père, mon petit <w>câlin</w>."
