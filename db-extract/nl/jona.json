                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1c2ef93-0b7d-4ae0-86fe-d4f843b14ac6",
                                                "sense_id": "4e31c582-ac99-32e5-b151-166071ab85c1",
                                                "text": "'It's Jonah,' Ted says.\nSimmy considers this. 'As in the whale?'\n'Yep.'\n'You know,' Simmy says, 'that people are going to say that to him for ever more?'\n'What? The whale thing?'\n'Yes.'\nTed shrugs again. 'Well. He'll get used to it. All names have got some associations. Anyway, he looks like a Jonah. And I like the name Jonah—'\n'Obviously,' Simmy cuts in, 'since you chose it.'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1438c0b-d3f2-30f5-bfe0-4bcc43adc56c",
                                        "entry_id": "4c9ae9d2-3edb-30c8-bad4-81fde83246fc",
                                        "glosses": [
                                            "A minor prophet who was cast into the sea and swallowed by a great fish."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a4688b5-bc78-441e-a826-36e288c54ed5",
                                                "sense_id": "c1438c0b-d3f2-30f5-bfe0-4bcc43adc56c",
                                                "text": "So they took up Jonah, and cast him forth into the sea: and the sea ceased from her raging."
                                            }
