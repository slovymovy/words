            "senses": [
                {
                    "sense_id": "5d01a8ee-3739-330a-b79d-0abf7b0cf72b",
                    "sense_definition": "niet meer weten waar men is en hoe men moet gaan, de weg kwijt zijn",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "desoriëntatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>verdwaalde</w> toerist keek op zijn kaart om de weg naar het hotel te vinden.",
                            "target_lang_translations": {
                                "en": "The <w>lost</w> tourist looked at his map to find the way to the hotel."
                            }
                        },
                        {
                            "text": "Ik voel me een beetje <w>verdwaald</w> in deze grote, vreemde stad.",
                            "target_lang_translations": {
                                "en": "I feel a bit <w>lost</w> in this big, strange city."
                            }
                        }
                    ],
                    "synonyms": [
                        "verloren",
                        "de weg kwijt"
                    ],
                    "antonyms": [
                        "terecht"
                    ],
                    "common_phrases": [
                        "een verdwaalde toerist",
                        "totaal verdwaald zijn"
                    ],
                    "target_lang_definitions": {
                        "en": "no longer knowing where one is or which way to go; having lost one's way"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lost",
                                "target_lang_sense_clarification": "unable to find one's way"
                            },
                            {
                                "target_lang_word": "stray",
                                "target_lang_sense_clarification": "having wandered away from a group or path"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "262d6767-6cdc-3d21-ae67-e1584a3042ed",
                    "sense_definition": "voltooid deelwoord van <w>verdwalen</w>",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wij zijn gisteren tijdens de wandeling in het bos hopeloos <w>verdwaald</w>.",
                            "target_lang_translations": {
                                "en": "We <w>got</w> hopelessly <w>lost</w> during the walk in the forest yesterday."
                            }
                        },
                        {
                            "text": "Het was erg handig geweest als ik niet zo snel <w>verdwaald</w> was.",
                            "target_lang_translations": {
                                "en": "It would have been very useful if I hadn't <w>gotten lost</w> so quickly."
                            }
                        }
                    ],
                    "common_phrases": [
                        "is verdwaald",
                        "zijn verdwaald"
                    ],
                    "target_lang_definitions": {
