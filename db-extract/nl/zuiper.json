                ],
                "senses": [
                    {
                        "sense_id": "7bf395ac-2db3-3dc8-853b-859b06bb4c7b",
                        "entry_id": "968ac8a1-bc29-3614-9f44-030ebc145348",
                        "glosses": [
                            "iemand die te veel alcohol drinkt"
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "3b6fb708-1293-4479-96dc-6516569fc3db",
                                "sense_id": "7bf395ac-2db3-3dc8-853b-859b06bb4c7b",
                                "text": "Hij vervolgt: „We moeten overigens wel kijken of we selectiever kunnen worden in het type toerist dat we willen aantrekken. Misschien wat minder zuipers en blowers en wat meer mensen die ook geld spenderen in restaurants, bars en het theater. Dat moet je niet doen door toeristenbelasting op budgethotels te verhogen, maar door een betere marketingstrategie.”"
                            },
                            {
                                "example_id": "115da849-e299-4c85-a0c6-6ba789e11558",
                                "sense_id": "7bf395ac-2db3-3dc8-853b-859b06bb4c7b",
                                "text": "Sinds 2006 krijgen jeugdige drinkers die een strafbaar feit begaan met een slok op in verschillende regio's de kans om via Halt de alcoholcursus te doen. Zes uur lang volgen ze dan een cursus over het omgaan met groepsdruk en ze leren 'nee'zeggen als hen alcohol wordt aangeboden. Ook de ouders van de zuipers moeten zich melden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "87fb7fc1-ff19-49ca-b4b9-49876ef155c5",
                        "source_entry_id": "968ac8a1-bc29-3614-9f44-030ebc145348",
                        "source_sense_id": "7bf395ac-2db3-3dc8-853b-859b06bb4c7b",
                        "target_lang_word": "alcoholic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alcoholic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a0b353ed-9c5d-330d-a0e8-b136cb5ed28e",
                                        "entry_id": "b8609848-a226-3d46-a6d7-947c13bc8409",
                                        "glosses": [
                                            "A person who is addicted to alcohol."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce621017-0ea0-4a11-ba73-24f665071ef7",
                                                "sense_id": "a0b353ed-9c5d-330d-a0e8-b136cb5ed28e",
                                                "text": "Don't you know you've got your daddy's eyes\n Daddy was an alcoholic"
                                            },
                                            {
                                                "example_id": "9e420bf9-3d40-42bb-9b82-9a4b9b5082ae",
                                                "sense_id": "a0b353ed-9c5d-330d-a0e8-b136cb5ed28e",
                                                "text": "Seeing the British establishment struggle with the financial sector is like watching an alcoholic who still resists the idea that something drastic needs to happen for him to turn his life around."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81b745d8-8db6-3110-b84c-2f967e497a19",
                                        "entry_id": "b8609848-a226-3d46-a6d7-947c13bc8409",
                                        "glosses": [
                                            "One who abuses alcohol."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "alcoholic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "029d247a-930d-3e59-b1cb-5b71d94baffa",
                                        "entry_id": "2b73471d-57fc-3074-bd79-71eed9566ac9",
                                        "glosses": [
                                            "Of or pertaining to alcohol."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "947d5a48-88a2-322e-9ee6-4abf606f5836",
                                        "entry_id": "2b73471d-57fc-3074-bd79-71eed9566ac9",
                                        "glosses": [
                                            "Having more than a trace amount of alcohol in its contents."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f795ac5-a394-49f8-bae4-eb99b7f156c4",
                                                "sense_id": "947d5a48-88a2-322e-9ee6-4abf606f5836",
                                                "text": "He ordered an alcoholic beverage."
                                            },
                                            {
                                                "example_id": "57cea307-8e8b-4e0f-8abd-c069e3a5d4e2",
                                                "sense_id": "947d5a48-88a2-322e-9ee6-4abf606f5836",
                                                "text": "The oysters were sour, and excessively alcoholic."
                                            },
                                            {
                                                "example_id": "4c6c7850-4e51-4296-bfed-10e6fb65b236",
                                                "sense_id": "947d5a48-88a2-322e-9ee6-4abf606f5836",
                                                "text": "A statement from the official Lao News Agency (KPL) Friday reported that “the consumption of tainted alcoholic beverages” was the suspected cause of the deaths."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52cfe304-2a28-3a97-9a8d-25fedd52459d",
                                        "entry_id": "2b73471d-57fc-3074-bd79-71eed9566ac9",
                                        "glosses": [
                                            "Of, pertaining to, or affected by alcoholism."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e9f9a775-4fbf-4c71-ab2c-4cde06b66e6d",
                        "source_entry_id": "968ac8a1-bc29-3614-9f44-030ebc145348",
                        "source_sense_id": "7bf395ac-2db3-3dc8-853b-859b06bb4c7b",
                        "target_lang_word": "boozer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "boozer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0cf29b47-d765-3c42-896b-953e990d6b79",
                                        "entry_id": "83eca981-4f15-3163-aa3d-53fa0ac36bb8",
                                        "glosses": [
                                            "One who drinks alcohol habitually; a drunkard."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01fa2bcf-f881-408b-9192-e2e3f7e9f7fb",
                                                "sense_id": "0cf29b47-d765-3c42-896b-953e990d6b79",
                                                "text": "“Tess is a fine figure o′ fun, as I said to myself today when I zeed her vamping round parish with the rest,” observed one of the elderly boozers in an undertone."
                                            },
                                            {
                                                "example_id": "9e4d5e5e-bfce-41df-87a2-4b82aeace8f6",
                                                "sense_id": "0cf29b47-d765-3c42-896b-953e990d6b79",
                                                "text": "But they have only one insurance rate for ordinary men — drinkers and non-drinkers, and they compel the man who doesn′t booze to make up for the extra amount that the boozer should pay."
                                            },
                                            {
                                                "example_id": "cb7ac8aa-93b7-4689-9691-699451199dfd",
                                                "sense_id": "0cf29b47-d765-3c42-896b-953e990d6b79",
                                                "text": "\"You were actually taking that old boozer seriously.\""
                                            },
                                            {
                                                "example_id": "2db311e5-0569-4681-91e9-84399b2abe26",
                                                "sense_id": "0cf29b47-d765-3c42-896b-953e990d6b79",
                                                "text": "2009 November, Neville Franks, The Lost Boy of the Ozarks, Backpacker, page 82,\nEvery swig made me more relaxed, and happy, and I was definitely a boozer again, and I wondered why I had ever thought I wasn't a boozer and I took another pull and I was going to clap BC on the back and thank him for being such a good hotel manager, and faithful guide, for being my friend, and then I passed out."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a82c93f1-d97c-3094-8dff-e79e95d549b4",
                                        "entry_id": "83eca981-4f15-3163-aa3d-53fa0ac36bb8",
                                        "glosses": [
                                            "A public house, pub."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "New-Zealand",
                                            "UK",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b7ff51a-336d-4f11-b7a0-2a62c4419d43",
                                                "sense_id": "a82c93f1-d97c-3094-8dff-e79e95d549b4",
                                                "text": "Zoe’s dad went to the same boozer every day, a flat-roofed pub on the edge of the estate, with the cross of St George hanging above the door and a ferocious-looking Rottweiler tied up outside."
                                            },
                                            {
                                                "example_id": "33d8a1ea-5122-4e30-ad1c-08e725181de5",
                                                "sense_id": "a82c93f1-d97c-3094-8dff-e79e95d549b4",
                                                "text": "During the week, the players were just as likely to be spotted out together in a local pub such as the Four in Hand. It was even known for them to frequent the Marksman off Carters Green, one of the town’s roughest boozers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae99aba4-abab-3b16-b412-14ca41c81777",
                                        "entry_id": "83eca981-4f15-3163-aa3d-53fa0ac36bb8",
                                        "glosses": [
                                            "A World War II fighter radar detector, fitted to British bombers."
                                        ],
                                        "tags": [
                                            "UK",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "611f07b3-146c-36d9-a70e-2ff9a6ffd0d9",
                                        "entry_id": "83eca981-4f15-3163-aa3d-53fa0ac36bb8",
                                        "glosses": [
                                            "A vehicle equipped with tanks for supplying water to remote locations."
                                        ],
                                        "tags": [
                                            "Africa"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd0f8523-d867-4212-ad44-075b1a140c94",
                                                "sense_id": "611f07b3-146c-36d9-a70e-2ff9a6ffd0d9",
                                                "text": "2010 June 8, Kenya National Assembly Official Record (Hansard), page 2,\nMr. Mututho: Mr. Speaker, Sir, the Assistant Minister should assure the people of Vihiga that they will get a water boozer because the sick people are not party to this complication. Could he assure the people that he can send a boozer in his capacity even if he cannot supply power or a standby generator, so that they can have a small well?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
