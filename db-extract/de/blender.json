                        "sense_id": "a5042e4a-0e1a-374b-8648-eaaec4578041",
                        "entry_id": "fe69e679-2171-31d7-9089-addf3e651c49",
                        "glosses": [
                            "ein Mensch, der jemanden blendet, also betrügt; Betrüger, Hochstapler"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "03f94c69-0fea-44ac-8dd2-8fcc3330625d",
                                "sense_id": "a5042e4a-0e1a-374b-8648-eaaec4578041",
                                "text": "Diesem Blender traut niemand über den Weg."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "534d7f26-5f66-352a-8fab-ce9aff3e6c07",
                        "entry_id": "fe69e679-2171-31d7-9089-addf3e651c49",
                        "glosses": [
                            "ein Angeber"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "d7785bd6-6810-46ff-acf4-66ba5f70a26f",
                                "sense_id": "534d7f26-5f66-352a-8fab-ce9aff3e6c07",
                                "text": "Andreas ist doch nur ein Blender. Große Worte und nichts dahinter."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "128f763c-043b-3fd3-a783-4a753aea366f",
                        "entry_id": "fe69e679-2171-31d7-9089-addf3e651c49",
                        "glosses": [
                            "ein Pferd mit scheinbar hervorragenden Qualitäten, das jedoch die \\\"blendenden\\\" Leistungen nicht erbringt oder die ausgezeichneten Charaktereigenschaften nicht hat, die man von ihm aufgrund seines Äußeren, erwartet"
                        ],
                        "tags": [
                            "ursprünglich"
                        ],
                        "examples": [],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "356f0da5-f404-4170-b269-66910c3c447e",
                        "source_entry_id": "fe69e679-2171-31d7-9089-addf3e651c49",
                        "source_sense_id": "a5042e4a-0e1a-374b-8648-eaaec4578041",
                        "source_sense_description": "abwertend: ein Mensch, der jemanden blendet, also betrügt; Betrüger, Hochstapler",
                        "target_lang_word": "impostor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "impostor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "66158e51-9e5b-3a34-9a2a-3dfb7fe9c499",
                                        "entry_id": "e38a1110-c824-333a-af54-95fc3b0f5713",
                                        "glosses": [
                                            "Someone who attempts to deceive by using an assumed name or identity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ee1342c-8ad5-44e9-b4be-3d223fba21e7",
                                                "sense_id": "66158e51-9e5b-3a34-9a2a-3dfb7fe9c499",
                                                "text": "\"It were dishonour in me to yield. I will not play the part of an impostor, whom my uncle must despise even while he screens. No; these estates are his right: let him take them; I will not buy them with his daughter's hand.\""
                                            },
                                            {
                                                "example_id": "f8cb048a-6a3f-41d9-9631-a505786dd84d",
                                                "sense_id": "66158e51-9e5b-3a34-9a2a-3dfb7fe9c499",
                                                "text": "Then again these figures take no account of the thousands of beggars who travel free in India. Many of these are religious \"Sadhus\", dressed often in nothing but a loin-cloth, or even less, and their bodies smeared with ashes. A large number of these men are nothing but impostors, but the Hindu railway staff usually are afraid to interfere with them."
                                            },
                                            {
                                                "example_id": "cd9d8e1a-75a0-423b-b29a-733c145b9520",
                                                "sense_id": "66158e51-9e5b-3a34-9a2a-3dfb7fe9c499",
                                                "text": "“I said he had a criminal face.” “He can't help his face.” “He can help being a crook and an impostor. Calls himself a butler, does he? The police could shake that story. He's no more a butler than I am.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5a45e24-026b-3e8a-a9ad-866bc40cb361",
                                        "entry_id": "e38a1110-c824-333a-af54-95fc3b0f5713",
                                        "glosses": [
                                            "A sprite or animation integrated into a three-dimensional scene to look like part of the 3D world."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bba8a441-6ccf-30a9-8957-6925b652835c",
                                        "entry_id": "e38a1110-c824-333a-af54-95fc3b0f5713",
                                        "glosses": [
                                            "A term referenced in an unusual grammatical person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7927f735-0903-414c-8516-31de090ba3aa",
                                                "sense_id": "bba8a441-6ccf-30a9-8957-6925b652835c",
                                                "text": "Interestingly, Wang shows that Chinese allows the appearance of an indexical pronoun alongside the imposter, as in (31)."
                                            },
                                            {
                                                "example_id": "3890c41f-0771-469c-886d-caf9f14e5252",
                                                "sense_id": "bba8a441-6ccf-30a9-8957-6925b652835c",
                                                "text": "One possibility is that mothers of HR [higher-risk] infants frequently use non-pronoun forms in place of pronouns, as in the impostor uses noted above."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c42f323f-c977-4627-b6be-b1bd60aad574",
                        "source_entry_id": "fe69e679-2171-31d7-9089-addf3e651c49",
                        "source_sense_id": "a5042e4a-0e1a-374b-8648-eaaec4578041",
                        "source_sense_description": "abwertend: ein Mensch, der jemanden blendet, also betrügt; Betrüger, Hochstapler",
                        "target_lang_word": "imposter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "imposter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "80a25230-e906-3e6b-a255-cca7584920fb",
                                        "entry_id": "c53227ab-3af7-3709-8bcc-85eb895587a1",
                                        "glosses": [
                                            "Alternative spelling of impostor."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3cf1582a-ae6b-4842-8479-05bd4acf766c",
                                                "sense_id": "80a25230-e906-3e6b-a255-cca7584920fb",
                                                "text": "To get over her imposter syndrome, Caldwell eventually turned to guided meditation to help her \"quiet the voices.\""
                                            },
                                            {
                                                "example_id": "69ef8961-40b1-4ced-ad60-b2d954736a81",
                                                "sense_id": "80a25230-e906-3e6b-a255-cca7584920fb",
                                                "text": "The game requires four to 10 players, who are randomly assigned roles of either a crewmate or imposter. There are always more crew than imposters at the start."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "37ea3f64-a1b0-4758-8ed7-51fc48facb29",
                        "source_entry_id": "fe69e679-2171-31d7-9089-addf3e651c49",
                        "source_sense_id": "a5042e4a-0e1a-374b-8648-eaaec4578041",
                        "source_sense_description": "abwertend: ein Mensch, der jemanden blendet, also betrügt; Betrüger, Hochstapler",
                        "target_lang_word": "очковтиратель",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "очковтиратель",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "42568e47-3c5c-3c5a-956a-d1f8b8484549",
                                        "entry_id": "038151ca-31cf-36cd-a261-6d56e25b93d2",
                                        "glosses": [
                                            "разг. тот, кто занимается очковтирательством"
                                        ],
                                        "tags": [],
