                                            {
                                                "example_id": "e017fe25-91ce-459b-8332-cdecdcbe5797",
                                                "sense_id": "73b1e9a4-8fd7-3655-b15c-ef84259ade31",
                                                "text": "De betekenis van een uitdrukking is meestal een figuurlijke betekenis."
                                            },
                                            {
                                                "example_id": "d73e2181-022d-4ecd-bd86-214850e6a184",
                                                "sense_id": "73b1e9a4-8fd7-3655-b15c-ef84259ade31",
                                                "text": "In de uitdrukking \"De koe bij de horens vatten\" wordt er niet bedoeld dat je dit ook echt zo moet uitvoeren, er is immers vaak geen koe. De figuurlijke betekenis is: \"Een zaak stevig aanpakken\"."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f95ba20d-4b06-4302-bf9f-5f0a21064382",
                        "source_entry_id": "f8226c81-5bec-357b-8f87-1ae2e47be8a3",
                        "source_sense_description": "in a figurative manner",
