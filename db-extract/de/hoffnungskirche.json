                "senses": [
                    {
                        "sense_id": "3bef9aef-3501-30fe-92e9-73bc59343a9a",
                        "entry_id": "f252c3ce-f012-364a-b0c0-694882e83bdb",
                        "glosses": [
                            "Gotteshaus, das nach der göttlichen Tugend ^(→ WP) der Hoffnung benannt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aaacc91e-2904-4db5-a9aa-c3a2eeb2180f",
                                "sense_id": "3bef9aef-3501-30fe-92e9-73bc59343a9a",
                                "text": "„Die Hoffnungskirche war der Ort, an dem ältere Bischöfe und Pastoren, die unter dem Nationalsozialismus zur opponierenden Bekennenden Kirche gehört hatten, ihre Einsichten als ›Zeit‹-Zeugen vortrugen.“"
                            },
                            {
                                "example_id": "48bf4a45-06b1-4c88-babb-846593d59b42",
                                "sense_id": "3bef9aef-3501-30fe-92e9-73bc59343a9a",
                                "text": "„Dort steht die Hoffnungskirche, deren Turm im oberen Teil dem der Lindener Martinskirche stark ähnelt.“"
                            },
                            {
                                "example_id": "17cd08a0-8f29-4bd2-805b-4b91f1a57430",
                                "sense_id": "3bef9aef-3501-30fe-92e9-73bc59343a9a",
                                "text": "„Die 1912/13 nach Entwürfen von Walter Koeppen errichtete Evangelische Hoffnungskirche wurde während eines Umbaues 1964 in ihrem Erscheinungsbild stark verändert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
