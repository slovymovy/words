                ],
                "senses": [
                    {
                        "sense_id": "db3ae149-b63e-3a2a-9e5b-78fbe633f65d",
                        "entry_id": "4af411d5-56d0-347a-9ba7-180543b808b9",
                        "glosses": [
                            "bruin met weinig wit bijmenging, volbruin, kastanjebruin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45c73412-c2bf-4d39-932b-bf1702bc9a48",
                                "sense_id": "db3ae149-b63e-3a2a-9e5b-78fbe633f65d",
                                "text": "Het meisje heeft donkerbruin haar."
                            },
                            {
                                "example_id": "e58d27b2-3a03-4d4c-8dd6-fc1f4d7e14bc",
                                "sense_id": "db3ae149-b63e-3a2a-9e5b-78fbe633f65d",
                                "text": "De natuur veranderde van kleur. Licht- en donkerbruin als voorlopers van het onvermijdelijke kaal."
                            }
                        ]
                    },
                    {
                        "sense_id": "ce544b12-2619-3060-b0f4-6e51fa7c3705",
                        "entry_id": "4af411d5-56d0-347a-9ba7-180543b808b9",
                        "glosses": [
                            "versterking van het volgende begrip"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "824705bc-5a18-4de7-8e15-644c74a92347",
                                "sense_id": "ce544b12-2619-3060-b0f4-6e51fa7c3705",
                                "text": "Ik heb een donkerbruin vermoeden dat hij vreemd gaat."
                            },
                            {
                                "example_id": "2eb3c7dc-ef84-43e4-876f-5bca8fca1774",
                                "sense_id": "ce544b12-2619-3060-b0f4-6e51fa7c3705",
                                "text": "Er was al een donkerbruin vermoeden in Bornerbroek, maar nu weten ze het zeker: de tracékeuze voor de rondweg om Zenderen is vooraf bekokstoofd."
                            }
                        ]
                    }
