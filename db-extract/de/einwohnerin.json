                        "entry_id": "05c06854-7e23-39a6-9d52-52c27d8ace18",
                        "glosses": [
                            "weibliche Person, die in einem bestimmten Ort, Land oder einer bestimmten Gegend wohnt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d47adcc-8e5e-431d-9855-a26aef3277cf",
                                "sense_id": "8b6f2a3b-a5e2-3eca-ab4b-b84e8ff20836",
                                "text": "Kusinnen sind Einwohnerinnen von Kusistan."
                            }
