                        "examples": [
                            {
                                "example_id": "551235b9-23c7-4adb-a9e7-c29cd7b42815",
                                "sense_id": "305f8e3f-c0aa-356f-a5a3-23502fd693e8",
                                "text": "De Chinese huizenmarkt lijkt op instorten te staan. En dat kan grote gevolgen hebben voor de wereldeconomie. Want de Chinese bouwdrift bepaalde de afgelopen jaren de prijzen van grondstoffen op de wereldmarkt."
                            },
                            {
                                "example_id": "ff1e476e-da46-4013-850d-e84c52d64dd7",
                                "sense_id": "305f8e3f-c0aa-356f-a5a3-23502fd693e8",
                                "text": "Na twee decennia bouwdrift is de Chinese huizenmarkt verzadigd. De meeste huishoudens hebben inmiddels een of meerdere huizen."
                            },
                            {
                                "example_id": "db7996bf-dd66-4e33-9100-6201c0a0c34c",
                                "sense_id": "305f8e3f-c0aa-356f-a5a3-23502fd693e8",
                                "text": "Door de bouwdrift zijn veel vliegbases dichter bij bebouwing komen te liggen. Dat heeft tot \"vervuiling van het luchtruim\" geleid."
                            }
                        ]
                    }
