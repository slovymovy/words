                                        "examples": [
                                            {
                                                "example_id": "2fa822d5-0e16-4612-8b83-87d5a572bd3b",
                                                "sense_id": "b594af5e-3f4e-32f8-90cf-701949112c2d",
                                                "text": "Tous les raisonnements paléontologiques et toute la paléogéographie des espèces animales et végétales ont été construits sur l'idée du monotopisme."
                                            },
                                            {
                                                "example_id": "98117c48-7a22-49b6-8d26-c861cd98425f",
                                                "sense_id": "b594af5e-3f4e-32f8-90cf-701949112c2d",
                                                "text": "En 1876, Viollet-Le-Duc publie « Le massif du Mont-Blanc », […]. Se fondant sur quelques observations, il échafaude une paléogéographie du retrait glaciaire des vallées du Bon Nant et de Chamonix."
                                            }
                                        ]
