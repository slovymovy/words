                ],
                "senses": [
                    {
                        "sense_id": "f4d7cdbf-18a2-34c2-ad9a-7fa603916c3a",
                        "entry_id": "46aa0c61-7821-319d-b3d2-8212bc7b2cea",
                        "glosses": [
                            "Aussicht/Blick auf einen See oder das Meer"
                        ],
                        "tags": [
                            "Tourismus",
                            "Plural selten"
                        ],
                        "examples": [
                            {
                                "example_id": "27215d87-9a2f-4160-b057-2fcbbb1dd55a",
                                "sense_id": "f4d7cdbf-18a2-34c2-ad9a-7fa603916c3a",
                                "text": "„Morcote ist ein beliebtes Ausflugsziel mit Kunsthandwerkerläden, Anlegestellen für Ausflugsschiffe, Restaurants mit Seeblick.“"
                            },
                            {
                                "example_id": "eff4db6a-eace-403a-93c0-053af8198243",
                                "sense_id": "f4d7cdbf-18a2-34c2-ad9a-7fa603916c3a",
                                "text": "„Die Greifenwarte Edersee mit Seeblick liegt hoch über der Talsperre.“"
                            },
                            {
                                "example_id": "3741e238-39bc-496c-b4f2-29c0215968f5",
                                "sense_id": "f4d7cdbf-18a2-34c2-ad9a-7fa603916c3a",
                                "text": "„Die Post wurde zu einem gemütlichen Restaurant mit Seeblick und Livemusik umgewandelt.“"
                            },
                            {
                                "example_id": "c740605d-a5c6-460a-8799-288df430ac7b",
                                "sense_id": "f4d7cdbf-18a2-34c2-ad9a-7fa603916c3a",
                                "text": "„Auf der Sommerterrasse mit Seeblick kann man in aller Ruhe die Sonne genießen.“"
                            },
                            {
                                "example_id": "fc225d3b-adde-428a-80bf-b83271f6e5e8",
                                "sense_id": "f4d7cdbf-18a2-34c2-ad9a-7fa603916c3a",
                                "text": "[Campingplatz:] „Seit drei Jahren lebt er hier mit seiner Frau in einem 15 Quadratmeter Wohnwagen. »Mitten in der Natur, Terrasse mit Seeblick inklusive«, schwärmt der Frührentner.“"
                            },
                            {
                                "example_id": "fe6beb25-c7cc-4a85-a2e7-0650848926dc",
                                "sense_id": "f4d7cdbf-18a2-34c2-ad9a-7fa603916c3a",
                                "text": "[Schwarzes Meer:] „Fast alle Hotels sind so angeordnet, dass jedes Zimmer Seeblick hat.“"
                            },
                            {
                                "example_id": "0c56002d-732f-426b-a7c5-47169c936d86",
                                "sense_id": "f4d7cdbf-18a2-34c2-ad9a-7fa603916c3a",
                                "text": "[Schaalsee:] „Kurz vor der Brücke liegt an der Uferpromenade im Schilfgürtel ein Hochstand, der ideal zur Vogelbeobachtung oder für eine kleine Rast mit Seeblick ist.“"
                            },
                            {
                                "example_id": "4034c78d-cf58-4293-91ef-66ce1abc9822",
                                "sense_id": "f4d7cdbf-18a2-34c2-ad9a-7fa603916c3a",
                                "text": "„Vor der Banfebucht findet man an der Kurve noch einen schönen Rastplatz mit Seeblick […].“"
                            },
                            {
                                "example_id": "2daf13e1-af0c-4424-a2fb-7378e975edfe",
                                "sense_id": "f4d7cdbf-18a2-34c2-ad9a-7fa603916c3a",
                                "text": "[Bitterfeld:] „Die große Erfolgsgeschichte der Stadt ist der Goitzsche-See, der aus dem riesigen Erdloch entstanden ist, das der Braunkohle-Tagebau hinterlassen hat. Hier sind eine kleine Marina und schicke Mehrfamilienhäuser mit Seeblick entstanden.“"
                            },
                            {
                                "example_id": "e9d522d3-8faa-4a74-a74d-877314ca1d93",
                                "sense_id": "f4d7cdbf-18a2-34c2-ad9a-7fa603916c3a",
                                "text": "[Tallin:] „»Im Moment steht da noch ein altes Gefängnis am Ufer – ein Gefängnis mit Seeblick!«, lacht Hellrand, […].“"
                            },
                            {
                                "example_id": "26a46723-8808-4e95-9bf5-0d78abab0cec",
                                "sense_id": "f4d7cdbf-18a2-34c2-ad9a-7fa603916c3a",
                                "text": "„Nie hätte sie gedacht, einmal Chefin des bekannten Traditionshotels \"Seeblick\" auf Amrum zu werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
