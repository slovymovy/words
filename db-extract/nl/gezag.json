        "nl-extract.jsonl": [
            {
                "entry_id": "0e9caf4f-1d24-3156-a012-8acb816651d2",
                "word": "gezag",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "738c89b5-3dcc-37fa-bb2b-c45dc6b07260",
                        "entry_id": "0e9caf4f-1d24-3156-a012-8acb816651d2",
                        "glosses": [
                            "bevoegdheid om ergens beslissingen over te nemen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2d3d1fa-5131-4b62-ace0-1ed46298425a",
                                "sense_id": "738c89b5-3dcc-37fa-bb2b-c45dc6b07260",
                                "text": "Hij heeft niet voldoende gezag om dat voorstel aan te nemen."
                            }
                        ]
                    },
                    {
                        "sense_id": "6d05591b-9a66-3a87-854b-95cee3f8626a",
                        "entry_id": "0e9caf4f-1d24-3156-a012-8acb816651d2",
                        "glosses": [
                            "aanzien; voldoende kennis hebben om ergens een gefundeerd oordeel over te hebben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a91549e3-a400-40a0-a45b-93a3e0f19574",
                                "sense_id": "6d05591b-9a66-3a87-854b-95cee3f8626a",
                                "text": "Het gezag van een voetbaltrainer is vaak bepalend voor zijn succes."
                            },
                            {
                                "example_id": "1884a8c0-e16a-4e7e-aa4b-129e73d59c73",
                                "sense_id": "6d05591b-9a66-3a87-854b-95cee3f8626a",
                                "text": "Militaire sabotage van die orde van grootte betekende dat Zweden nu ook bij de oorlog betrokken was, verklaarde Oscar met gezag."
                            }
                        ]
                    },
                    {
                        "sense_id": "f30b2750-35f4-3acd-9016-74654d56bd11",
                        "entry_id": "0e9caf4f-1d24-3156-a012-8acb816651d2",
                        "glosses": [
                            "de overheid; zij die de wettige macht bezitten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3155ada9-8b99-4f4c-9404-47e2a636c46d",
                                "sense_id": "f30b2750-35f4-3acd-9016-74654d56bd11",
                                "text": "\"Criminelen ondermijnen gezag in 34 gemeenten\""
                            },
                            {
                                "example_id": "00c6107c-2cf8-4ff4-806e-b1018b28f533",
                                "sense_id": "f30b2750-35f4-3acd-9016-74654d56bd11",
                                "text": "Die overdreven voorliefde voor het gezag had ze van haar vader, adjunct van het plaatsvervangend afdelingshoofd bij het ministerie van Posterijen, die de hiërarchie binnen zijn ministerie zag als een metafoor voor het universum."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7ecece22-fc76-4338-b00a-72588bd95cd4",
                        "source_entry_id": "0e9caf4f-1d24-3156-a012-8acb816651d2",
                        "source_sense_id": "738c89b5-3dcc-37fa-bb2b-c45dc6b07260",
                        "source_sense_description": "bevoegdheid om ergens beslissingen over te nemen",
                        "target_lang_word": "authority",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "authority",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3b2c80a7-50d6-3a62-ba15-3a9f59425483",
                                        "entry_id": "7b5d12c4-e1c5-3cf9-accb-92c9b645af7d",
                                        "glosses": [
                                            "Power or right to make or enforce rules, give orders, or impose obligation; or a position having such power or right."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "122e035c-f985-4641-85b5-4be46bedaaa5",
                                                "sense_id": "3b2c80a7-50d6-3a62-ba15-3a9f59425483",
                                                "text": "I have the authority to penalise the staff in my department, but not the authority to sack them."
                                            },
                                            {
                                                "example_id": "ac512b06-bbdb-4e6e-8482-149367433433",
                                                "sense_id": "3b2c80a7-50d6-3a62-ba15-3a9f59425483",
                                                "text": "Vigilantes may have the power to nab criminals, but they lack the authority."
                                            },
                                            {
                                                "example_id": "9d15c18e-86e6-441d-bdaa-dc3831650964",
                                                "sense_id": "3b2c80a7-50d6-3a62-ba15-3a9f59425483",
                                                "text": "She lost all respect and authority after turning up drunk at the meeting."
                                            },
                                            {
                                                "example_id": "d5ee1772-4bd8-4f6e-8a54-78a0cdf704a1",
                                                "sense_id": "3b2c80a7-50d6-3a62-ba15-3a9f59425483",
                                                "text": "Respect my authority!"
                                            },
                                            {
                                                "example_id": "5de18f12-9ad1-448e-ad9c-ce284c313e9d",
                                                "sense_id": "3b2c80a7-50d6-3a62-ba15-3a9f59425483",
                                                "text": "SIR PETER. Very well! ma'am very well! so a husband is to have no influence, no authority?\nLADY TEAZLE. Authority! no, to be sure—if you wanted authority over me, you should have adopted me and not married me[:] I am sure you were old enough."
                                            },
                                            {
                                                "example_id": "c0c13936-755b-4d1f-9a07-42c628108815",
                                                "sense_id": "3b2c80a7-50d6-3a62-ba15-3a9f59425483",
                                                "text": "But in the meantime Robin Hood and his band lived quietly in Sherwood Forest, without showing their faces abroad, for Robin knew that it would not be wise for him to be seen in the neighborhood of Nottingham, those in authority being very wroth with him."
                                            },
                                            {
                                                "example_id": "f1e7da73-eafc-4494-8000-d16dad21cd70",
                                                "sense_id": "3b2c80a7-50d6-3a62-ba15-3a9f59425483",
                                                "text": "It was widely seen as an attempt to deflect attention from the Comey controversy and re-establish some authority at the briefing room podium."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f8eb0ab-5b68-3ea8-b4cb-2eaa01f9af7b",
                                        "entry_id": "7b5d12c4-e1c5-3cf9-accb-92c9b645af7d",
                                        "glosses": [
                                            "Persons, regarded collectively, who occupy official positions of power; police or law enforcement."
                                        ],
                                        "tags": [
                                            "countable",
                                            "plural",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4dcc383b-2dd4-49e7-9fd1-667e33e45f00",
                                                "sense_id": "5f8eb0ab-5b68-3ea8-b4cb-2eaa01f9af7b",
                                                "text": "Authorities say the suspect fled on foot."
                                            },
                                            {
                                                "example_id": "d37199d6-3d6d-4fb1-9e40-baa9a3fb504d",
                                                "sense_id": "5f8eb0ab-5b68-3ea8-b4cb-2eaa01f9af7b",
                                                "text": "The case was that of a murder. It had an element of mystery about it, however, which was puzzling the authorities. A turban and loincloth soaked in blood had been found; also a staff."
                                            },
                                            {
                                                "example_id": "35ff4359-2ad6-4af5-a7bb-9baa89a10ccb",
                                                "sense_id": "5f8eb0ab-5b68-3ea8-b4cb-2eaa01f9af7b",
                                                "text": "No sooner has a [synthetic] drug been blacklisted than chemists adjust their recipe and start churning out a subtly different one. These “legal highs” are sold for the few months it takes the authorities to identify and ban them, and then the cycle begins again."
                                            },
                                            {
                                                "example_id": "b9c77408-838d-4110-a500-2df52bce10df",
                                                "sense_id": "5f8eb0ab-5b68-3ea8-b4cb-2eaa01f9af7b",
                                                "text": "In China, authorities said they might soon shoot down an unidentified flying object over waters near the northern city of Rizhao, The South China Morning Post reported."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66d9fed3-9b5a-3314-b0c4-c91486c7490d",
                                        "entry_id": "7b5d12c4-e1c5-3cf9-accb-92c9b645af7d",
                                        "glosses": [
                                            "A reliable, definitive source of information on a subject."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b54ea73c-b27b-42ff-8958-6100c17d89ce",
                                                "sense_id": "66d9fed3-9b5a-3314-b0c4-c91486c7490d",
                                                "text": "the world's foremost authority on orangutans"
                                            },
                                            {
                                                "example_id": "b0c07a43-84ed-44cc-9d7f-4a5c846f9a41",
                                                "sense_id": "66d9fed3-9b5a-3314-b0c4-c91486c7490d",
                                                "text": "My cheap dictionary is not the authority on word derivations."
                                            },
                                            {
                                                "example_id": "66d14ab2-eddc-4125-90a6-072e77f6d5cc",
                                                "sense_id": "66d9fed3-9b5a-3314-b0c4-c91486c7490d",
                                                "text": "To punish me for my contempt of authority, Fate has made me an authority myself."
                                            },
                                            {
                                                "example_id": "56a0fbbd-cc58-4bcb-b553-d77f1a311345",
                                                "sense_id": "66d9fed3-9b5a-3314-b0c4-c91486c7490d",
                                                "text": "The Egyptian crux ansata, common on Egyptian monuments and other memorials, is considered by some authorities as a triple phallus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72046ea2-1aff-3c0c-8c72-2415d404fa81",
                                        "entry_id": "7b5d12c4-e1c5-3cf9-accb-92c9b645af7d",
                                        "glosses": [
                                            "Status as a trustworthy source of information, reputation for mastery or expertise; or claim to such status or reputation."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43fe1cf8-53d6-4da3-99c7-dc72c9b390cc",
                                                "sense_id": "72046ea2-1aff-3c0c-8c72-2415d404fa81",
                                                "text": "Due to being inadequate for the deductive method of reasoning, the argument from authority is considered a logical fallacy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e87c8dcc-0337-3c8d-b71c-0edc3ccda5dc",
                                        "entry_id": "7b5d12c4-e1c5-3cf9-accb-92c9b645af7d",
                                        "glosses": [
                                            "Official permission; authorisation to act in some capacity on behalf of a ruling entity."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db9a7a38-8bed-46cb-bbda-b4dd8cdf03be",
                                                "sense_id": "e87c8dcc-0337-3c8d-b71c-0edc3ccda5dc",
                                                "text": "Authority to construct eight carriages, to test the new design in public service, had already been given; but of course complete working drawings had first to be prepared."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fef03008-1ff5-3c24-a979-673016a1c01d",
                                        "entry_id": "7b5d12c4-e1c5-3cf9-accb-92c9b645af7d",
                                        "glosses": [
                                            "A government-owned agency that runs a revenue-generating activity for public benefit."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44b8e181-3ac2-41fc-95e8-0be4c36b65b6",
                                                "sense_id": "fef03008-1ff5-3c24-a979-673016a1c01d",
                                                "text": "Chicago Transit Authority"
                                            },
                                            {
                                                "example_id": "98a721f7-f842-4706-b1e2-d45fb293cff9",
                                                "sense_id": "fef03008-1ff5-3c24-a979-673016a1c01d",
                                                "text": "New York Port Authority"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4f86a52b-b1ee-4828-8ea8-876cb9c10d02",
                        "source_entry_id": "0e9caf4f-1d24-3156-a012-8acb816651d2",
                        "source_sense_id": "738c89b5-3dcc-37fa-bb2b-c45dc6b07260",
                        "source_sense_description": "bevoegdheid om ergens beslissingen over te nemen",
                        "target_lang_word": "prestige",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prestige",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3debd272-be9c-3f8a-8565-d2e2e44a7c39",
                                        "entry_id": "cdb6a28d-f6eb-3ba5-8037-f482916179db",
                                        "glosses": [
                                            "The quality of how good the reputation of something or someone is, how favourably something or someone is regarded."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80aac3d7-aedd-494b-8163-59b812f15fbb",
                                                "sense_id": "3debd272-be9c-3f8a-8565-d2e2e44a7c39",
                                                "text": "Oxford has a university of very high prestige."
                                            },
                                            {
                                                "example_id": "559b8fd1-bd20-4985-8dda-1c95844989c3",
                                                "sense_id": "3debd272-be9c-3f8a-8565-d2e2e44a7c39",
                                                "text": "But in such an instance a false belief will appear with all the prestige of the latest scientific knowledge supporting it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5b39fcc-01d9-3df8-8787-ad53622dbcd2",
                                        "entry_id": "cdb6a28d-f6eb-3ba5-8037-f482916179db",
                                        "glosses": [
                                            "Delusion; illusion; trick."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5414d939-14a3-43a9-84c4-920e3034b3ec",
                                                "sense_id": "b5b39fcc-01d9-3df8-8787-ad53622dbcd2",
                                                "text": "That faith which, we are told, was founded on a rock, impregnable to the assaults of men and demons; to the sophisms of infidelity, and the prestiges of imposture!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "prestige",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3cc83993-cce9-312c-b124-ff38037d52ea",
                                        "entry_id": "a3254d92-382c-37cc-9eb9-3f5dd8d225eb",
                                        "glosses": [
                                            "Regarded as relatively prestigious; often, considered the standard language or language variety, or a part of such a variety."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "565fe689-19f8-4921-9e08-4e21b6f3c2ea",
                                                "sense_id": "3cc83993-cce9-312c-b124-ff38037d52ea",
                                                "text": "Furthermore there is in each area a well recognized standard, known by a single name, which although often linguistically distinct from local dialects, has served as the prestige form for some time."
                                            },
                                            {
                                                "example_id": "c9d09f2b-6725-452c-afa5-821f2ed9d23c",
                                                "sense_id": "3cc83993-cce9-312c-b124-ff38037d52ea",
                                                "text": "The 3rd person plural -ą ending is phonetically [ow̃] or [om], depending on the dialect. However, [ow̃] is the prestige form."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "prestige",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "76a9b761-b2de-396e-90a3-d09e557ab320",
                                        "entry_id": "4063973f-9ed4-3b4e-80c0-2cecda748b64",
                                        "glosses": [
                                            "To start over at an earlier point in a video game with some type of bonus or reward."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9fe808ed-92b0-4d90-9048-9e6f80e19db6",
                                                "sense_id": "76a9b761-b2de-396e-90a3-d09e557ab320",
                                                "text": "This seriously depends on the prerequisites, but most chars will already have a +1 bow by the time they're thinking of prestiging - or will this stack with the equipment's magic?"
                                            },
                                            {
                                                "example_id": "b39e77b2-2e00-443a-a5fb-89a7307b4b91",
                                                "sense_id": "76a9b761-b2de-396e-90a3-d09e557ab320",
                                                "text": "I'm going to try to stop and move onto a different game once I've prestiged, but the credits/equipment buying arrangement will make prestiging much less of a crippling shock than in previous games, so I may well be stuck playing it for a long time to come."
                                            },
                                            {
                                                "example_id": "8eba79fb-2201-4c2a-9aca-2cc7c35a37a7",
                                                "sense_id": "76a9b761-b2de-396e-90a3-d09e557ab320",
                                                "text": "However, Treyarch crafts a narrative of leveling up when a player attempts to prestige. The player is stripped of most un-lockable game features and must re-earn them with the ability to repeat this process 15 times. Prestiging allows the empty narrative of online multiplayer first person shooters to continue on a much grander scale."
                                            },
                                            {
                                                "example_id": "cf2e2363-9aa7-4220-a540-dccc02af24f4",
                                                "sense_id": "76a9b761-b2de-396e-90a3-d09e557ab320",
                                                "text": "Reached level 50 and prestiged which I have never had the inclination to do in any game before."
                                            },
                                            {
                                                "example_id": "05d8fe49-7126-4f9e-8524-11589c20c785",
                                                "sense_id": "76a9b761-b2de-396e-90a3-d09e557ab320",
                                                "text": "Prestiging itself is a concept popularized by Call of Duty: Modern Warfare, where players can reset their in-game progress after reaching the maximum experience level, and receive a cosmetic token in exchange."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fac3a6b0-4542-44bf-a50a-79b0a72024dc",
                        "source_entry_id": "0e9caf4f-1d24-3156-a012-8acb816651d2",
                        "source_sense_id": "738c89b5-3dcc-37fa-bb2b-c45dc6b07260",
                        "source_sense_description": "bevoegdheid om ergens beslissingen over te nemen",
                        "target_lang_word": "autoridad",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "autoridad",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "18c16fb9-1bd1-392d-902a-306e8ccc1702",
                                        "entry_id": "8f0e472a-2d58-327e-9eb3-31cdaca5f3a9",
                                        "glosses": [
                                            "Carácter o representación de una persona por su empleo, mérito o nacimiento."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88220a84-3f5f-404b-a6b5-cba1e92bae7e",
                                                "sense_id": "18c16fb9-1bd1-392d-902a-306e8ccc1702",
                                                "text": "«El río Yaracuy se convirtió en el principal escenario de la rebelión de Andresote, quien era gran conocedor de esta vía fluvial. En otro encuentro sostenido el 30 de julio de 1731, las autoridades españolas no lograron capturarlo… “solo canoas con mercaderías pudieron capturar, y esto a costa de pérdidas de hombres y materiales de guerra y la pena moral de Arias Altamirano”, y comprendieron que el apoyo de los vecinos y la relación de favores que mantenía con estos, vendiéndoles sus cargas a los holandeses, era el factor que tenían en su contra, además de las condiciones geográficas favorables para quien las conociera, pero no para las autoridades reales»."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0b516693-0869-3ebd-8ec0-e6b7c600676c",
                                        "entry_id": "8f0e472a-2d58-327e-9eb3-31cdaca5f3a9",
                                        "glosses": [
                                            "Potestad, facultad."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "968f9222-9cdf-4383-b0d6-b69f5649a13a",
                                                "sense_id": "0b516693-0869-3ebd-8ec0-e6b7c600676c",
                                                "text": "«También en los banquetes guardaban un protocolo tradicional, un ordenamiento de acuerdo a la jerarquía o al lugar de donde era oriundo, guardando un reglamento social que imponía la autoridad y en el que habían sido educados»."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "de5b61cc-18ea-3cfe-a098-61a4ef6ab872",
                                        "entry_id": "8f0e472a-2d58-327e-9eb3-31cdaca5f3a9",
                                        "glosses": [
                                            "Potestad que en cada pueblo ha establecido su constitución para que le rija y gobierne, ya dictando leyes, ya haciéndolas observar, ya administrando justicia."
                                        ],
                                        "tags": [
                                            "Política"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96c55d36-20b1-4ebc-a6aa-849e49a5c70e",
                                                "sense_id": "de5b61cc-18ea-3cfe-a098-61a4ef6ab872",
                                                "text": "«Segundo Mainar explicaba a Ángel Arbués que la vulgaridad invadía al mundo y a eso había que unir la debilidad y el problema de clases sociales, el paso del tiempo, el envejecimiento paulatino, la histeria colectiva y el sistema de autoridad impuesto, totalitarismo y mala fe, no se podía pedir más, pero eso no era todo porque para colmo había un planteamiento religioso falso, con un canónigo-autoridad, en la villa que decía era el representante de Dios, ¡no me haga usted reír!, ¿de cuál, del suyo o del mío? Todo el mundo conocía que Segundo Mainar no creía en Dios»."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "26d6c42f-f180-393b-b941-19696782d1ef",
                                        "entry_id": "8f0e472a-2d58-327e-9eb3-31cdaca5f3a9",
                                        "glosses": [
                                            "Persona revestida de algún poder, mando o magistratura."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1de38cd1-c945-43c7-975f-0fb8f9c75b02",
                                                "sense_id": "26d6c42f-f180-393b-b941-19696782d1ef",
                                                "text": "«En ese tiempo era común que sea el Prefecto una de las autoridades más representativas del Gobierno y algo como el bastonero social que ofrecía banquetes, agasajos y bailes de gala a los Presidentes»."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "a705ffe6-e204-3c04-8bdf-86677bd7cc2b",
                                        "entry_id": "8f0e472a-2d58-327e-9eb3-31cdaca5f3a9",
                                        "glosses": [
                                            "Crédito y fe que, por su mérito y fama, se da a una persona o cosa en determinada materia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b87d875-c4d1-431b-a930-f5f7faeae443",
                                                "sense_id": "a705ffe6-e204-3c04-8bdf-86677bd7cc2b",
                                                "text": "«—Es el sitio más lindo del mundo, ¿no es verdad, Demi?— dijo Daisy, quien, evidentemente, consideraba a su hermano como una autoridad en todo asunto»."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "ab9d9c9e-ab0a-3192-89a4-0560272e974f",
                                        "entry_id": "8f0e472a-2d58-327e-9eb3-31cdaca5f3a9",
                                        "glosses": [
                                            "Ostentación, fausto, aparato."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "199dc765-34a0-3796-8fb1-1868fce57d21",
                                        "entry_id": "8f0e472a-2d58-327e-9eb3-31cdaca5f3a9",
                                        "glosses": [
                                            "Texto, expresión o conjunto de expresiones de un libro o escrito, que se citan o alegan en apoyo de lo que se dice."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "b1465fdb-3248-3db1-8345-7d72c3be83fb",
                                        "entry_id": "8f0e472a-2d58-327e-9eb3-31cdaca5f3a9",
                                        "glosses": [
                                            "Poder que tiene una persona sobre otra que le está subordinada; como el del padre sobre los hijos, el del tutor sobre el pupilo, el del superior sobre los inferiores."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c510974a-37b9-426c-ac0d-ac721e789160",
                                                "sense_id": "b1465fdb-3248-3db1-8345-7d72c3be83fb",
                                                "text": "«En Haití, las relaciones entre inferiores y superiores (en donde una relación de subordinación existe, o donde predominen grados de poder y autoridad) se expresan en términos paternalistas»."
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    }
                                ]
                            }
                        ]
