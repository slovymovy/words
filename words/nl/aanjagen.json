                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stoke",
                                "target_lang_sense_clarification": "to add fuel or stir a fire"
                            },
                            {
                                "target_lang_word": "fan",
                                "target_lang_sense_clarification": "to blow air on a fire to make it stronger"
                            },
                            {
                                "target_lang_word": "fuel",
                                "target_lang_sense_clarification": "to feed a fire with material"
                            }
                        ]
                    }
                },
