                ],
                "senses": [
                    {
                        "sense_id": "9dff57ca-ec3d-35b4-aedf-b47b2d7978f0",
                        "entry_id": "40e7fcce-ec73-3d96-a1c1-ae22d2527102",
                        "glosses": [
                            "militärischer Angriff Russlands auf die Ukraine beginnend im Jahr 2022"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f097630-8461-4dac-865d-28e92c0a65ac",
                                "sense_id": "9dff57ca-ec3d-35b4-aedf-b47b2d7978f0",
                                "text": "Am 24. Februar 2022 begann der Ukrainekrieg."
                            },
                            {
                                "example_id": "3984f4ca-7105-4f34-997a-5a577d0cba62",
                                "sense_id": "9dff57ca-ec3d-35b4-aedf-b47b2d7978f0",
                                "text": "„Der Ukrainekrieg läuft nicht so, wie es sich die russischen Angreifer erhofft hatten.“"
                            },
                            {
                                "example_id": "80172447-19a7-47f5-bcd5-1d9aaa65811b",
                                "sense_id": "9dff57ca-ec3d-35b4-aedf-b47b2d7978f0",
                                "text": "„Der Ukrainekrieg hat eine lange Vorgeschichte.“"
                            },
                            {
                                "example_id": "e9ea74ee-f022-442b-a549-27039a3bd191",
                                "sense_id": "9dff57ca-ec3d-35b4-aedf-b47b2d7978f0",
                                "text": "[Flechettes-Munition:] „Durch Obduktion von Leichen aus Massengräbern in Butscha wurde der Einsatz im Ukrainekrieg nachgewiesen.“"
                            },
                            {
                                "example_id": "c7b7398e-8a98-47f8-b9be-515c8ad40091",
                                "sense_id": "9dff57ca-ec3d-35b4-aedf-b47b2d7978f0",
                                "text": "„Viele Kinder haben im Ukrainekrieg beide Eltern verloren.“"
                            },
                            {
                                "example_id": "19be0f36-a263-4ca2-9af4-d3f0be270f1b",
                                "sense_id": "9dff57ca-ec3d-35b4-aedf-b47b2d7978f0",
                                "text": "„Im Ukrainekrieg sind mehrere zehntausend bis mehrere hunderttausend ukrainische Minderjährige nach Russland verschleppt worden. Das ist ein Kriegsverbrechen.“"
                            },
                            {
                                "example_id": "fc94c6e2-666e-43de-8e2a-c8f458294113",
                                "sense_id": "9dff57ca-ec3d-35b4-aedf-b47b2d7978f0",
                                "text": "Da über die Brücke eine von insgesamt drei Straßenverbindungen der Krim mit dem Festland der Ukraine führt, hat sie strategische Bedeutung im Ukrainekrieg."
                            },
                            {
                                "example_id": "10a13269-acab-482c-8e91-c7a776ab50da",
                                "sense_id": "9dff57ca-ec3d-35b4-aedf-b47b2d7978f0",
                                "text": "„Oberleutnant Morgachev ist nämlich nicht erst im Ukrainekrieg durch seine Teilnahme an Cyberangriffen aufgefallen.“"
                            },
                            {
                                "example_id": "ee15fec6-782d-4300-a9f5-19cd5cbb2290",
                                "sense_id": "9dff57ca-ec3d-35b4-aedf-b47b2d7978f0",
                                "text": "„Russische Oligarchen haben im Laufe des Ukrainekriegs Zugriff auf Luxusjachten, Immobilien und andere Vermögen im Wert von knapp 10 Milliarden Euro verloren.“"
                            },
                            {
                                "example_id": "fc658176-3f29-4884-8b9e-51928b3ef1f4",
                                "sense_id": "9dff57ca-ec3d-35b4-aedf-b47b2d7978f0",
                                "text": "„In Deutschland gibt es viele Meinungen zum Ukrainekrieg. Empathie gibt es wenig.“"
                            },
                            {
                                "example_id": "72302136-eb11-4362-8b26-e3f4b3f8a129",
                                "sense_id": "9dff57ca-ec3d-35b4-aedf-b47b2d7978f0",
                                "text": "„Putin hatte in der Rede vor allem über den Ukrainekrieg gesprochen, die Invasion verteidigt und einmal mehr dem Westen vorgeworfen, ‚den Krieg losgetreten‘ zu haben.“"
                            },
                            {
                                "example_id": "03737985-9d75-4076-b411-da3a2f7023eb",
                                "sense_id": "9dff57ca-ec3d-35b4-aedf-b47b2d7978f0",
                                "text": "„Wie kann eine neue Friedensordnung nach dem Ukrainekrieg aussehen?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
