                "senses": [
                    {
                        "sense_id": "9fa8e904-2582-3db5-88e2-a57eeb37a3bf",
                        "entry_id": "0066bf49-9227-37f3-b442-5a00b74d5b4d",
                        "glosses": [
                            "feinmaschiges Sieb, das für die Zubereitung von Kaffee verwendet wird, um den Kaffeesatz zu filtern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51b90aab-cc4e-4c1a-9db4-002aad59ff01",
                                "sense_id": "9fa8e904-2582-3db5-88e2-a57eeb37a3bf",
                                "text": "Heute gibt es nur noch selten Kaffeesiebe, viel häufiger werden Kaffeefilter aus Papier benutzt."
                            },
                            {
                                "example_id": "219ec9b3-6ede-4209-902d-c84b1e82ac45",
                                "sense_id": "9fa8e904-2582-3db5-88e2-a57eeb37a3bf",
                                "text": "Kaffeesiebe müssen nach jeder Benutzung gereinigt werden."
                            },
                            {
                                "example_id": "6c622957-14dc-4310-a24b-23e3f57491f4",
                                "sense_id": "9fa8e904-2582-3db5-88e2-a57eeb37a3bf",
                                "text": "Kaffeesiebe sind meist aus Edelstahl, selten aus Plastik."
                            },
                            {
                                "example_id": "3c0f89f1-7828-4232-a0c3-1b18ba13813c",
                                "sense_id": "9fa8e904-2582-3db5-88e2-a57eeb37a3bf",
                                "text": "„Die untere Wasseragarschicht wird dann durch ein gewöhnliches Kaffeesieb gepreßt und dadurch zerkleinert.“"
                            },
                            {
                                "example_id": "ed43afa5-4041-4e65-a67b-e99550b4ee0a",
                                "sense_id": "9fa8e904-2582-3db5-88e2-a57eeb37a3bf",
                                "text": "„Eine moderne Alternative ist der Melior-Kaffeetopf, der aus einem Glaszylinder mit einem als Kolben ausgebildetem Kaffeesieb besteht.“"
                            },
                            {
                                "example_id": "a303a592-16ce-42e3-8895-ca81a3001d07",
                                "sense_id": "9fa8e904-2582-3db5-88e2-a57eeb37a3bf",
                                "text": "„Danach gab sie feingemahlenen Kaffee in das passgenaue Kaffeesieb und verschraubte die Espressokanne in der Mitte.“"
                            },
                            {
                                "example_id": "45943a5b-8183-400a-8ee1-bf55c9d1d618",
                                "sense_id": "9fa8e904-2582-3db5-88e2-a57eeb37a3bf",
                                "text": "„Die nun geronnene Milch wird dann wieder mit einem Löffel gut zerrührt und durch ein feines Kaffeesieb oder Kaffeesack filtrirt; hierauf entsprechend mit Wasser , Hafer- oder Gerstenschleim verdünnt und angesüßt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
