                "senses": [
                    {
                        "sense_id": "ddcb4fe2-e0f5-316f-b900-e9061dae6fe6",
                        "entry_id": "b246d4da-aa7a-3453-bd0a-88b4957a381c",
                        "glosses": [
                            "Aufgabe, die ein Schüler vom Lehrer aufbekommt und die in der Regel zu Hause gemacht werden soll"
                        ],
                        "tags": [
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "ca0f9e46-2fc4-4f4a-8271-b1ec36228fda",
                                "sense_id": "ddcb4fe2-e0f5-316f-b900-e9061dae6fe6",
                                "text": "„Wenn da bloss nicht die Ufzgi wären, die leider Gottes gemacht werden müssen“"
                            },
                            {
                                "example_id": "a455c594-d845-4de3-91d0-963ea1c9eff1",
                                "sense_id": "ddcb4fe2-e0f5-316f-b900-e9061dae6fe6",
                                "text": "„Nicht alle Eltern können bei den Ufzgi helfen oder jemanden für Nachhilfe bezahlen – das schafft unterschiedliche Verhältnisse.“"
                            },
                            {
                                "example_id": "63fdccd9-db94-40fc-99da-19e28cd2f870",
                                "sense_id": "ddcb4fe2-e0f5-316f-b900-e9061dae6fe6",
                                "text": "„Zudem ging es auch um die tägliche Dauer der «Ufzgi».“"
                            },
                            {
                                "example_id": "4f21e67a-9584-45f2-a00d-2e5694f368d9",
                                "sense_id": "ddcb4fe2-e0f5-316f-b900-e9061dae6fe6",
                                "text": "„Die Gemeinde Köniz etwa hat die klassischen «Ufzgis» mit dem neuen Lehrplan abgeschafft.“"
                            },
                            {
                                "example_id": "60e44651-0c18-484b-a313-da27448b05a0",
                                "sense_id": "ddcb4fe2-e0f5-316f-b900-e9061dae6fe6",
                                "text": "„Gehören die «Ufzgi» also bald der Vergangenheit an?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
