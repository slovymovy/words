                        "entry_id": "9f6105f4-3b5b-36b6-a9f1-6a66dbd0005e",
                        "glosses": [
                            "Any globular protein that incorporates a globin fold."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "6c3b5999-2b47-367e-bf49-2a106a5b4f4f",
                        "entry_id": "9f6105f4-3b5b-36b6-a9f1-6a66dbd0005e",
                        "glosses": [
                            "One of several polypeptides that are the protein components of haemoglobin or myoglobin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7030f350-80c1-4464-a082-c35394b19d00",
                                "sense_id": "6c3b5999-2b47-367e-bf49-2a106a5b4f4f",
                                "text": "Injuries and conditions that cause an acid pH environment cause the globin (protein) molecule to separate from the ferrihemate (iron-containing) component of the myoglobin molecule."
                            },
                            {
                                "example_id": "4a8aa030-42e5-4fa9-8ce6-f034fb3393b4",
                                "sense_id": "6c3b5999-2b47-367e-bf49-2a106a5b4f4f",
                                "text": "Globin switches in yolk sac–like primitive and fetal-like definitive red blood cells produced from human embryonic stem cells [title of article]"
                            },
                            {
                                "example_id": "18a93c03-f33c-4bae-8a33-fc1e4c196f2a",
                                "sense_id": "6c3b5999-2b47-367e-bf49-2a106a5b4f4f",
                                "text": "The results showed that the globin expression in the erythroid cells in individual clones changed in a time-dependent manner."
                            }
                        ]
                    }
                ],
