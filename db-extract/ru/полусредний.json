                    },
                    {
                        "sense_id": "cf82487d-a386-3f02-9c0b-177b318b645a",
                        "entry_id": "84b45bce-c17f-3189-98be-39e7ee508185",
                        "glosses": [
                            "спорт. в футболе, гандболе: находящийся между крайним и центральным игроком нападения"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aff94450-5d79-40b8-8341-30d0cb3c75c1",
                                "sense_id": "cf82487d-a386-3f02-9c0b-177b318b645a",
                                "text": "Поэтому я вынужден был сменить амплуа и переквалифицировался в левого полусреднего."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "356842b4-f264-4bca-9ecf-5e4571a9314b",
