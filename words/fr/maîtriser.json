    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e9b53a94-3c76-3406-ae55-fc03d0278662",
                    "sense_definition": "Posséder à fond une compétence, une langue ou un domaine de connaissances.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "savoir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle <w>maîtrise</w> parfaitement la langue après plusieurs années passées dans ce pays."
                        },
                        {
                            "text": "Il faut beaucoup de temps pour <w>maîtriser</w> les bases de ce logiciel complexe."
                        }
                    ],
                    "common_phrases": [
                        "maîtriser une langue",
                        "maîtriser son sujet",
                        "maîtriser les bases"
                    ]
                },
                {
                    "sense_id": "8977ca83-128e-31ff-9194-f4abf6b68c72",
                    "sense_definition": "Garder le contrôle d'une situation difficile, d'un événement ou d'un danger.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "controle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les pompiers ont finalement réussi à <w>maîtriser</w> l'incendie avant le lever du jour."
                        },
                        {
                            "text": "Le directeur a pris la parole pour <w>maîtriser</w> la situation de crise."
                        }
                    ],
                    "synonyms": [
                        "contenir",
                        "contrôler"
                    ],
                    "common_phrases": [
                        "maîtriser la situation",
                        "maîtriser un incendie",
                        "maîtriser les coûts"
                    ]
                },
                {
                    "sense_id": "6c3ff717-ef9b-3bd6-98e9-d638e1129486",
                    "sense_definition": "Réfréner ses sentiments, ses émotions ou ses pulsions pour ne pas les laisser paraître.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "controle_de_soi",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le candidat s'efforçait de <w>maîtriser</w> ses émotions devant les caméras de télévision."
                        },
                        {
                            "text": "Il n'a pas pu <w>maîtriser</w> sa colère face à cette injustice flagrante."
                        }
                    ],
                    "synonyms": [
                        "contenir",
                        "contrôler",
                        "refouler",
                        "retenir",
                        "réprimer",
                        "surmonter"
                    ],
                    "common_phrases": [
                        "maîtriser ses émotions",
                        "maîtriser sa colère",
                        "maîtriser sa peur"
                    ]
                },
                {
                    "sense_id": "458c777a-2fa5-379c-b0cf-1a4a2ce821b3",
                    "sense_definition": "Garder son calme, dompter ses propres réactions ou impulsions.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "controle_de_soi",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En toute circonstance, il est indispensable de savoir se <w>maîtriser</w> au travail."
                        },
                        {
                            "text": "Malgré la vive provocation, le diplomate a su se <w>maîtriser</w> sans hésiter."
                        }
                    ],
                    "synonyms": [
                        "se contenir",
                        "se contrôler",
                        "se dominer",
                        "se retenir"
                    ],
                    "common_phrases": [
                        "savoir se maîtriser",
                        "apprendre à se maîtriser"
                    ]
                },
                {
                    "sense_id": "81c93b8a-36ac-30cb-9465-b1e2e1889318",
                    "sense_definition": "Exercer une autorité absolue et dominatrice sur un groupe, un territoire ou une force.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "domination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "À cette époque glorieuse, la flotte britannique <w>maîtrisait</w> les mers du monde entier."
                        },
                        {
                            "text": "Le dictateur a envoyé l'armée afin de <w>maîtriser</w> les populations révoltées de la région."
                        }
                    ],
                    "synonyms": [
                        "asservir",
                        "assujettir",
                        "dominer",
                        "soumettre"
                    ],
                    "common_phrases": [
                        "maîtriser les mers"
                    ]
                }
            ]
        }
    ]
}