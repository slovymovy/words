                        "examples": [
                            {
                                "example_id": "56140f0e-151b-4eb4-8f1f-74dd27d68526",
                                "sense_id": "d595b3c6-b31d-394f-a90f-3502fdf97ae9",
                                "text": "We zwemmen vrijwel alleen in een felblauwe zee bij Palm Island. De bordjes op het strand maken duidelijk hoe dat kan. Er blijkt hier een exclusief, peperduur resort gevestigd waar rijke Amerikanen vertoeven in prachtige hotelsuites en grote villa's."
                            },
                            {
                                "example_id": "09dcf00d-2dd4-4a89-97d3-3ce096004256",
                                "sense_id": "d595b3c6-b31d-394f-a90f-3502fdf97ae9",
                                "text": "Martijn Garritsen, een knappe, zachtaardige jongen met de uitstraling van een tieneridool, zit op de designbank van de afgehuurde hotelsuite in het vijfsterrenhotel achter de Dam. Ja, hij woont in Amsterdam, en prima ook, in het penthouse van een woontoren met zicht op de Zuidas. Hoog boven alles, ruim, licht, privé, en sinds een jaar van hem. Enthousiast vertelt hij hoe hij er vannacht nog doorhaalde in zijn moderne studio, die twee verdiepingen hoger ligt."
                            }
                        ]
                    }
