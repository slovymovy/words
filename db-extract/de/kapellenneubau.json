                "senses": [
                    {
                        "sense_id": "1d31303a-4622-3cfb-a5d6-281c2de33361",
                        "entry_id": "6799244f-613f-320f-9990-385e098750fc",
                        "glosses": [
                            "die Tätigkeit des Neubauens einer Kapelle"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "0b158457-19f1-459f-acce-ea2a84e27c5c",
                                "sense_id": "1d31303a-4622-3cfb-a5d6-281c2de33361",
                                "text": "„Am 2. Juli 1921 beschließt man, einen Fond für einen späteren Kapellenneubau anzulegen, da die Kapelle feucht, baufällig und zu klein ist.“"
                            },
                            {
                                "example_id": "21b16310-1c49-4512-8b20-6ecd9e9dbbb4",
                                "sense_id": "1d31303a-4622-3cfb-a5d6-281c2de33361",
                                "text": "„In der Zeit von 1972 bis 2006 wurden weit mehr als 1.000 Projekte realisiert - von der Garage bis zum Mehrfamilienhaus, von der Scheune bis zum Stall für über 150 Kühe, von kleineren Produktionsstätten bis zum Hochregallager, von der Kirchensanierung bis zum Kapellenneubau.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2bb59578-198f-3ba6-9ed3-ea8628fafa88",
                        "entry_id": "6799244f-613f-320f-9990-385e098750fc",
                        "glosses": [
                            "ein erst unlängst fertiggestelltes Kapellengebäude"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "667cf52d-22f4-4ce4-a0b2-5fe96e544563",
                                "sense_id": "2bb59578-198f-3ba6-9ed3-ea8628fafa88",
                                "text": "„In der Zeit von 1972 bis 2006 wurden weit mehr als 1.000 Projekte realisiert - von der Garage bis zum Mehrfamilienhaus, von der Scheune bis zum Stall für über 150 Kühe, von kleineren Produktionsstätten bis zum Hochregallager, von der Kirchensanierung bis zum Kapellenneubau.“"
                            },
                            {
                                "example_id": "4329b799-219c-40cb-8c12-5f7175ae5a09",
                                "sense_id": "2bb59578-198f-3ba6-9ed3-ea8628fafa88",
                                "text": "„Die Grundsteinlegung ihres Kapellenneubaus feiert die Pfarrei St. Franziskus in Crimmitschau am Donnerstag, 19. Juli, um 16 Uhr.“"
                            },
                            {
                                "example_id": "317fcd4a-b844-4485-824b-aecdff23816b",
                                "sense_id": "2bb59578-198f-3ba6-9ed3-ea8628fafa88",
                                "text": "„Der Kapellenneubau in der Mitte des Communio-Geländes steht kurz vor seiner Fertigstellung, die Einweihung ist für den Gründungsgedenktag der Communio in Christo am Samstag, 28. November vorgesehen.“"
                            },
                            {
                                "example_id": "2e1138e5-7413-48b8-81b7-720a7b2e591c",
                                "sense_id": "2bb59578-198f-3ba6-9ed3-ea8628fafa88",
                                "text": "„Die Bauleitung bei der Erstellung des Kapellenneubaus lag zwar in der Hand von Architekt Hoffmann aus Westfeld, aber für Organisation und Durchführung sorgten vor Ort die Herren Ferdinand Müller und Anton Gierse-Metten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
