                "translations": [
                    {
                        "translation_id": "69a7890d-3647-4848-9929-c94c24d70916",
                        "source_entry_id": "a15819fb-39dd-33e1-9149-d5a2302b19b6",
                        "source_sense_id": "9018b2f8-9c34-30b9-89f0-627a1e1157ee",
