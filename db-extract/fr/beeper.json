                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9749ec22-35c8-484a-b427-2a0f85bae397",
                                "sense_id": "2af54fbd-e112-314d-a8f4-e570d3c81c81",
                                "text": "Si des gens sont intéressés pour covoiturer et coremorquer (mais pas copuler), qu'ils n'hésitent pas à me beeper ;)"
                            },
                            {
                                "example_id": "bdc4eddf-acd2-4cbe-adee-8e86e1004d6b",
                                "sense_id": "2af54fbd-e112-314d-a8f4-e570d3c81c81",
                                "text": "Dès que tu me vois connecté en même temps que toi, beepe-moi, on verra tout IG."
                            },
                            {
                                "example_id": "6e6bf83c-97a1-45d4-a8e6-0e58de7c0a2b",
                                "sense_id": "2af54fbd-e112-314d-a8f4-e570d3c81c81",
                                "text": "Nan mais Laurine j'suis sérieux essaie de me contacter soon, de quoi te beeper à 3h du mat', ça fait 5 ans que je prépare notre rendez-vous amoureux."
                            }
                        ]
                    }
