                                "target_senses": [
                                    {
                                        "sense_id": "cd151e0d-e703-37aa-ac6a-624545ec271c",
                                        "entry_id": "ada5bb10-93b9-35d4-a416-4e2f4c6e00b2",
                                        "glosses": [
                                            "Vertreter der Pflanzengattung Carex aus der Familie der Sauergräser"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ebbdfba-6156-4b16-88e7-4dc1751c84a7",
                                                "sense_id": "cd151e0d-e703-37aa-ac6a-624545ec271c",
                                                "text": "Seggen sind weltweit verbreitet."
                                            },
                                            {
                                                "example_id": "e95299e6-e5f5-4e22-80c1-506ff605994a",
                                                "sense_id": "cd151e0d-e703-37aa-ac6a-624545ec271c",
                                                "text": "Eine Segge erkennt man an den gewinkelten Blättern."
                                            },
                                            {
                                                "example_id": "e46b1f31-df2b-43ff-99eb-5e4eb8752fde",
                                                "sense_id": "cd151e0d-e703-37aa-ac6a-624545ec271c",
                                                "text": "„Man unterscheidet die flachen meist nährstoffreichen Niedermoore, in denen verschiedene Laubmoose, vor allem aber Seggen und Binsen wachsen, und die nährstoffarmen, in der Mitte uhrglasartig aufgewölbten Hochmoore, auf denen vor allem Torfmoose gedeihen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c82aceb2-2188-483c-be3b-746fbb5bd42b",
                        "source_entry_id": "3165c5f6-5169-348b-979d-f7c804821d04",
                        "source_sense_description": "any plant of the genus Carex",
                        "target_lang_word": "Riedgras",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Riedgras",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "819c27c8-b659-3767-9ecc-057bc02d44b3",
                                        "entry_id": "76eabe49-1f0d-3866-9dc4-2bc29a45f257",
                                        "glosses": [
                                            "auf feuchtem Boden wachsende, grasähnliche Pflanze"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14c11cc1-16ee-4eca-a3ba-6ca2f96a9bef",
                                                "sense_id": "819c27c8-b659-3767-9ecc-057bc02d44b3",
                                                "text": "„Dort fuhr er rückwärts zwischen die hohen Kiefern, mitten ins Riedgras und das dichte Gestrüpp.“"
                                            },
                                            {
                                                "example_id": "bbb9c9f2-8333-45bd-a8ed-86f6da66e0ef",
                                                "sense_id": "819c27c8-b659-3767-9ecc-057bc02d44b3",
                                                "text": "„Eine heiße Stille hing über der Flusslandschaft. Über den schmutzfleckigen und schiefen Schindelhütten, dem öden schotterbedeckten Industriegelände, den Feldern mit drahtfarbenem Riedgras, der verkraterten Steinwüste und den Eisenbahngleisen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
