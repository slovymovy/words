                            {
                                "example_id": "71f6f6db-2e2b-4a11-b040-9da3a8af65c0",
                                "sense_id": "d647727c-8b2a-32df-a756-184bd2e4b454",
                                "text": "На скамье поодаль сидел в шубе и чепане сельский ямщик, Захар."
                            },
                            {
                                "example_id": "a4b01397-e8f2-4e95-8b45-42f6c7253186",
                                "sense_id": "d647727c-8b2a-32df-a756-184bd2e4b454",
                                "text": "— Людей туда!.. Лошадь мне! — говорил батюшка, застёгивая дрожащими руками свой полевой чепан."
                            }
                        ]
                    },
