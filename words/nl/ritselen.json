            "senses": [
                {
                    "sense_id": "ac6e16fa-6e77-3bf2-9308-3bf9d96d47d1",
                    "sense_definition": "een zacht, ruisend of krakend geluid maken, zoals van droge bladeren of papier",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "geluid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De droge bladeren <w>ritselen</w> zachtjes in de koude herfstwind.",
                            "target_lang_translations": {
                                "fr": "Les feuilles sèches <w>bruissent</w> doucement dans le vent froid d'automne."
                            }
                        },
                        {
                            "text": "Ik hoorde een klein dier door het struikgewas <w>ritselen</w>.",
                            "target_lang_translations": {
                                "fr": "J'ai entendu un petit animal <w>faufiler en faisant bruire</w> les broussailles."
                            }
                        }
                    ],
                    "synonyms": [
                        "ruisen"
                    ],
                    "common_phrases": [
                        "bladeren ritselen"
                    ],
                    "target_lang_definitions": {
                        "fr": "Produire un bruit léger et sec, comme des feuilles mortes ou du papier froissé."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "bruire",
                                "target_lang_sense_clarification": "bruit léger et continu"
                            },
                            {
                                "target_lang_word": "froufrouter",
                                "target_lang_sense_clarification": "bruit de tissu ou de feuillage"
                            },
                            {
                                "target_lang_word": "faire un bruit de froissement",
                                "target_lang_sense_clarification": "froissement de feuilles ou de papier"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "78fefaaa-4f1e-3965-905d-9c6ca9d3edcf",
                    "sense_definition": "iets handig, slim of op informele wijze voor elkaar krijgen of regelen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "regelen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij heeft op het laatste moment nog twee kaartjes weten te <w>ritselen</w>.",
                            "target_lang_translations": {
                                "fr": "Il a réussi à <w>dégoter</w> deux billets à la dernière minute."
                            }
                        },
                        {
                            "text": "Maak je geen zorgen over vervoer, dat <w>ritsel</w> ik straks wel even.",
                            "target_lang_translations": {
                                "fr": "Ne t'inquiète pas pour le transport, je <w>gère</w> ça tout à l'heure."
                            }
                        }
                    ],
                    "common_phrases": [
                        "iets ritselen",
                        "kaartjes ritselen"
                    ],
                    "traits": [
                        {
