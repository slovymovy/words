                "senses": [
                    {
                        "sense_id": "b356596a-934d-3aff-a9b4-c9d61a9e22b6",
                        "entry_id": "a3eb7af4-1aad-3392-b2ad-1c2df6fbf7af",
                        "glosses": [
                            "Schule, in der vorwiegend der Koran studiert wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8da619f2-39d8-4d64-9575-c7669cc87a90",
                                "sense_id": "b356596a-934d-3aff-a9b4-c9d61a9e22b6",
                                "text": "„Baba kann weder lesen noch schreiben, er wurde als Muslim erzogen und hat eine Madrassa besucht, eine Koranschule, dort hat man ihm nur Suren eingebläut.“"
                            },
                            {
                                "example_id": "7fa3fb00-dab9-478d-82d1-646117caaa6a",
                                "sense_id": "b356596a-934d-3aff-a9b4-c9d61a9e22b6",
                                "text": "„Um 1550 soll es am Ort mehr als 150 Koranschulen gegeben haben.“"
                            },
                            {
                                "example_id": "b6a87820-3592-4e34-b1c6-f655adcf7414",
                                "sense_id": "b356596a-934d-3aff-a9b4-c9d61a9e22b6",
                                "text": "„Der Regierung dienten die zakat-Fonds unter anderem zur Finanzierung von Koranschulen (madaris) und als Basis für die Vision einer islamischen Wohlfahrtsgesellschaft - ein Ideal, zu dessen Verwirklichung es nie gekommen ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
