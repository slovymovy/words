                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ede68e9-cbc0-424a-aec1-63bd79c7932c",
                                "sense_id": "7a5049cf-9981-3268-9115-81b0453f5a52",
                                "text": "Ik begrijp mijn moeders jaloezie heus wel."
                            },
                            {
                                "example_id": "d97aa948-d922-4f6a-bd8e-c7ba8398fb20",
                                "sense_id": "7a5049cf-9981-3268-9115-81b0453f5a52",
                                "text": "'Maar hoe kom je erbij dat ik mijn moeders problemen oplos?' 'Doe je dat niet dan? Als je met je moeder praat, maak je jezelf helemaal ijl."
                            },
                            {
                                "example_id": "4a526490-d3c8-4789-8164-e541565dd531",
                                "sense_id": "7a5049cf-9981-3268-9115-81b0453f5a52",
                                "text": "In haar eerste schrik dacht Lauren dat er iets was met Marie-Claire, want waarom zou er anders een vreemde man met haar moeders toestel bellen? Marie-Claire bleek niet in staat om aan de telefoon te vertellen dat Casper' was verongelukt op een provinciale weg."
                            }
                        ]
                    }
