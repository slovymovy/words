                    {
                        "sense_id": "407eef37-1701-36d9-9bd4-5795bf1effd8",
                        "entry_id": "2fdcc3bf-a447-3e9d-93df-ca9d2d71f03a",
                        "glosses": [
                            "betrekking hebbend op de grootste zeeën van de wereld"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "286415aa-40bd-408c-9d4c-8aa12a531529",
                                "sense_id": "407eef37-1701-36d9-9bd4-5795bf1effd8",
                                "text": "Het voorbije orkaanseizoen heeft alle records gebroken. Dat zegt het Amerikaans Oceanisch en Atmosferisch Agentschap (NOAA). Het uitzonderlijke orkaanseizoen is het gevolg van het klimatologisch fenomeen El Niño."
                            }
                        ]
                    },
                    {
                        "sense_id": "7696b55b-8aaf-3e74-8ee1-d4da6751b63f",
                        "entry_id": "2fdcc3bf-a447-3e9d-93df-ca9d2d71f03a",
                        "glosses": [
                            "gelegen in een oceaan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aba5998e-5b61-45ab-be49-131d820b3021",
                                "sense_id": "7696b55b-8aaf-3e74-8ee1-d4da6751b63f",
                                "text": "Op de Marianen nam Clinton met een verschil van 20 procent een voorsprong op haar rivaal Bernie Sanders. De Republikeinen stemden ook op Guam, een Oceanisch eiland en onderdeel van de regio Micronesië. Daar kwam Cruz als winnaar uit de bus."
                            }
                        ]
                    },
                    {
                        "sense_id": "9f843b01-1c33-380a-a836-cc2d630a3f38",
                        "entry_id": "2fdcc3bf-a447-3e9d-93df-ca9d2d71f03a",
                        "glosses": [
                            "van zeer grote omvang"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1b5c96a-cf67-4c22-8d08-6643387bde0c",
                                "sense_id": "9f843b01-1c33-380a-a836-cc2d630a3f38",
                                "text": "Het onderwerp is welhaast oceanisch qua breedte en diepte, dus ik kan slechts een paar flarden naar voren halen. Allereerst zou je willen zeggen: we gaan alleen die behandelingen vergoeden die bewezen effectief zijn. Maar hoewel geneeskunde probeert wetenschappelijk te zijn, lukt dat vaak niet. Het griepvaccin, om maar iets te noemen, wordt nog altijd door miljoenen Nederlanders opgehaald bij de huisarts, terwijl het effect vrijwel nihil is."
                            }
                        ]
                    }
