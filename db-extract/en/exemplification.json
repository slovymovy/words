                                "target_senses": [
                                    {
                                        "sense_id": "7fa5e3a2-3089-3981-809c-393b6befb17a",
                                        "entry_id": "368b41ea-3ecf-3426-93b3-61031a8b4457",
                                        "glosses": [
                                            "Illustration par l'exemple."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1efe8a5c-c115-4a26-aafe-80ddca47d929",
                                                "sense_id": "7fa5e3a2-3089-3981-809c-393b6befb17a",
                                                "text": "Rien ne vaut l'exemplification pour expliquer une théorie."
                                            },
                                            {
                                                "example_id": "fe43b0fd-91a6-4f51-9ed7-c7bf844c7953",
                                                "sense_id": "7fa5e3a2-3089-3981-809c-393b6befb17a",
                                                "text": "Avant de donner pour elle-même une théorie de l’expression, il convient de mieux expliciter celle de l’exemplification."
                                            },
                                            {
                                                "example_id": "8a96b0d0-e2f7-4d99-870b-36651ab5b3f4",
                                                "sense_id": "7fa5e3a2-3089-3981-809c-393b6befb17a",
                                                "text": "le totalitarisme n'est, à cet égard, que l'exemplification extrême, monstrueusement privilégiée, de ce qui est vrai pour l'ensemble de l'histoire et pour tous les types de société."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e307dc86-b6d5-4f64-9317-58beca58aea8",
                        "source_entry_id": "91f433da-f910-3f7e-b1aa-680a2742e2d5",
