                "senses": [
                    {
                        "sense_id": "c7b5e56e-9ae2-38d4-b8f5-c51a7bf78537",
                        "entry_id": "9538387a-7ce8-393d-99a0-cc9192a9d4d7",
                        "glosses": [
                            "Relatif à la cigarette."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e51f0247-8a0f-4867-bac1-5104556bc867",
                                "sense_id": "c7b5e56e-9ae2-38d4-b8f5-c51a7bf78537",
                                "text": "Les classant selon leur proximité supposée avec l’industrie cigarettière et en spécifiant le degré d’urgence de les approcher."
                            },
                            {
                                "example_id": "2ea4ba3f-915b-4179-801c-6bf44a930cd1",
                                "sense_id": "c7b5e56e-9ae2-38d4-b8f5-c51a7bf78537",
                                "text": "Des rapports internes des [sociétés] cigarettières, cités dans les requêtes, montrent que l'industrie du tabac est elle-même consciente qu'une cigarette n'est qu'un dispositif servant à administrer une dose de nicotine."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "6102860c-2028-3b32-817b-8cae610b4a46",
                "word": "cigarettier",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "af4de793-9cd3-4acb-a190-de99bea6257d",
                        "entry_id": "6102860c-2028-3b32-817b-8cae610b4a46",
                        "tags": [
