                        ],
                        "examples": [
                            {
                                "example_id": "fa47f6d3-2116-45da-a193-d403c1d1e34c",
                                "sense_id": "1e02d660-ccf5-3bab-bcb9-cd3d22186ff3",
                                "text": "Dieu nous garde, si vous êtes chair et os, et si vous n'êtes pas fantômes, d'héberger en notre pourpris des païennes ou tout au moins des schismatiques!"
                            },
                            {
                                "example_id": "b2f8b963-61d9-4fb0-b74e-85fdc6dbbd72",
                                "sense_id": "1e02d660-ccf5-3bab-bcb9-cd3d22186ff3",
                                "text": "Comment lier en une candide gerbe ces fleurs plaintives que les moines cultivèrent dans les pourpris des cloîtres, alors que l’hagiographie était la sœur de l’art barbare et charmant des enlumineurs et des verriers, de l’ardente et de la chaste peinture des Primitifs ?"
                            }
                        ]
                    }
