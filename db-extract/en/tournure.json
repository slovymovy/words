                            {
                                "example_id": "0c30bae4-e83a-44c2-812a-76872f7e6a58",
                                "sense_id": "5c97cc66-655a-3668-9502-a80622e08e67",
                                "text": "Fortunately, your Parisian tournure will save your vivacity from vulgarity. Though, I must say, not one English girl in a thousand is to be trusted out of the security of insipidity; but you are French enough to be animated without being pert."
                            },
                            {
                                "example_id": "ae2940d6-79bd-4016-a432-e515d2f7c519",
                                "sense_id": "5c97cc66-655a-3668-9502-a80622e08e67",
                                "text": "Winterbourne stood looking after her; and as she moved away, drawing her muslin furbelows over the gravel, said to himself that she had the tournure of a princess."
                            }
                        ]
                    },
                    {
                        "sense_id": "9610a909-0af5-3811-b7ea-544aa053036c",
                        "entry_id": "f79b5dac-572c-3e22-b656-b17f02680127",
                        "glosses": [
                            "Turn; contour; figure."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "4e46c700-5939-47a7-ad61-5b1c8ba22b50",
                                "sense_id": "9610a909-0af5-3811-b7ea-544aa053036c",
                                "text": "[…] the word serpentine does not express the great line which makes the elegant tournure of a statue; for nature does not permit our head, in its ordinary motions, to turn more than a fourth of the circumference either to the right or to the left."
                            }
                        ]
                    },
                    {
                        "sense_id": "7f7ad54a-4422-39d0-bf96-42d53d041eb6",
                        "entry_id": "f79b5dac-572c-3e22-b656-b17f02680127",
                        "glosses": [
                            "Phrasing, turn of phrase."
                        ],
