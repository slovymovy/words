        "fr-extract.jsonl": [
            {
                "entry_id": "422fbb78-cf8e-39ff-96bf-d0a27234afc2",
                "word": "hâle",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1799eec1-7821-4122-b99e-b80350d9d926",
                        "entry_id": "422fbb78-cf8e-39ff-96bf-d0a27234afc2",
                        "tags": [
                            "plural"
                        ],
                        "form": "hâles"
                    },
                    {
                        "form_id": "4c472ab9-8f32-45cc-a9bf-b9c0bedc1c90",
                        "entry_id": "422fbb78-cf8e-39ff-96bf-d0a27234afc2",
                        "tags": [
                            "singular",
                            "plural"
                        ],
                        "form": "^((h aspiré))\\ɑl\\"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "17adb0aa-978f-3000-862d-069d872288b5",
                        "entry_id": "422fbb78-cf8e-39ff-96bf-d0a27234afc2",
                        "glosses": [
                            "Effet produit par la lumière solaire sur la peau, qui, exposée nue à son influence et au grand air, prend une teinte brune et basanée"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41b2db9e-48e6-4400-b604-633f0aba9077",
                                "sense_id": "17adb0aa-978f-3000-862d-069d872288b5",
                                "text": "jusqu’au [ 214 ] coude, le bras était d’un brun doré, comme vêtu de hâle."
                            },
                            {
                                "example_id": "0b68d516-b4bf-4e46-a55c-4f0f16f08087",
                                "sense_id": "17adb0aa-978f-3000-862d-069d872288b5",
                                "text": "[…] mais le soleil du Midi est brûlant ; le hâle ne va qu’aux brunes ; il donne à la peau des blondes certains tons de langouste cuite […]"
                            },
                            {
                                "example_id": "448e7879-e158-48b9-8f4c-a4823926ee56",
                                "sense_id": "17adb0aa-978f-3000-862d-069d872288b5",
                                "text": "… quatre petites filles en robe bleu tendre, les jambes nues, les pieds dans des soquettes et les bras vêtus du seul hâle de l'été ; …."
                            },
                            {
                                "example_id": "4fcd76aa-a5a9-4a8c-8ab1-0da02b26322a",
                                "sense_id": "17adb0aa-978f-3000-862d-069d872288b5",
                                "text": "Une casquette à visière de cuir rabattue cachait en partie son visage brûlé par le soleil et le hâle ruisselant de sueur."
                            }
                        ]
                    },
                    {
                        "sense_id": "0a5e2dd7-901c-385f-9d2b-6e4524066c81",
                        "entry_id": "422fbb78-cf8e-39ff-96bf-d0a27234afc2",
                        "glosses": [
                            "Effet produit par la lumière solaire sur les herbes des champs qui se flétrissent, sur la viande et le pain qui se dessèchent, etc."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "905b36a5-3772-40d7-9502-ff2c3b81f8ca",
                                "sense_id": "0a5e2dd7-901c-385f-9d2b-6e4524066c81",
                                "text": "Dans les champs occupés par les céréales d’hiver, le durcissement de la surface du sol par suite du hâle de mars comprime le collet des racines et s’oppose au développement des pousses latérales; […]."
                            },
                            {
                                "example_id": "08d9dac1-2898-4a37-9540-ac4ae23ba24a",
                                "sense_id": "0a5e2dd7-901c-385f-9d2b-6e4524066c81",
                                "text": "Tout autour les croix de bois, lavées par les pluies, effritées par les hâles, se penchaient dans tous les sens, comme si une tempête avait passé sur ces symboles, les balayant et les éparpillant de son souffle."
                            }
                        ]
                    },
                    {
                        "sense_id": "4c47e4f8-bc69-317a-ae82-35efa0fd055e",
                        "entry_id": "422fbb78-cf8e-39ff-96bf-d0a27234afc2",
                        "glosses": [
                            "Cause qui produit cet effet."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "541661a5-4b94-42cb-854a-8305636edb2b",
                                "sense_id": "4c47e4f8-bc69-317a-ae82-35efa0fd055e",
                                "text": "[…] des traits saillants naturellement forts et puissamment accentués, étaient, sous le hâle d’un soleil tropical, devenus d’un noir d’ébène […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3b2cb238-b296-4550-a17f-94257723157d",
                        "source_entry_id": "422fbb78-cf8e-39ff-96bf-d0a27234afc2",
                        "source_sense_id": "17adb0aa-978f-3000-862d-069d872288b5",
                        "source_sense_description": "Effet sur la peau",
                        "target_lang_word": "zongebruind",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zongebruind",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "25f469f3-3225-3f45-8dc4-e4e5722e0b22",
                                        "entry_id": "2b7a1c01-ba3a-330c-90a8-c03400a417ba",
                                        "glosses": [
                                            "van de huid van mensen: dat deze door de zon is gepigmenteerd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b0fb46c-6ac6-4ef6-877f-a8ddf6e52553",
                                                "sense_id": "25f469f3-3225-3f45-8dc4-e4e5722e0b22",
                                                "text": "Çameron en Donald kunnen ze leren zwemmen en vissen en zeilen, net als John Forbes met ons deed, en dan groeien ze zongebruind en gezond op, weg van de stadsrook.'"
                                            },
                                            {
                                                "example_id": "01d7390a-062a-4dbd-96e0-ed5ac7e129c0",
                                                "sense_id": "25f469f3-3225-3f45-8dc4-e4e5722e0b22",
                                                "text": "Blinkend witte tanden in een donker, zongebruind gezicht. Zijn torso vaak ontbloot. En altijd maar die zonnebril. Tenniscoach Nick Bollettieri (87) is befaamd en dat komt niet alleen door het rijtje grote namen waar hij op zijn tennisacademie in Florida mee werkte."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
