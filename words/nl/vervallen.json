                        "fr": [
                            {
                                "target_lang_word": "être annulé",
                                "target_lang_sense_clarification": "d'un événement, vol ou cours"
                            },
                            {
                                "target_lang_word": "sauter",
                                "target_lang_sense_clarification": "familier, être supprimé d'un planning"
                            },
                            {
                                "target_lang_word": "être supprimé",
                                "target_lang_sense_clarification": "d'un train, d'un vol ou d'une étape"
                            }
                        ]
