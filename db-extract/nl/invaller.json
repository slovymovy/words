                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "298043c2-b849-32de-ada5-c9e6b5fd0a5d",
                                        "entry_id": "6254b6d9-8901-3805-b6c6-971f43517d94",
                                        "glosses": [
                                            "To use in place of something else, with the same function."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0296dbd-c566-4d4e-83ac-e990a9ca0c89",
                                                "sense_id": "298043c2-b849-32de-ada5-c9e6b5fd0a5d",
                                                "text": "I had no shallots so I substituted onion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "163f1c81-fd6e-3b5c-bdd9-412a541da3c9",
                                        "entry_id": "6254b6d9-8901-3805-b6c6-971f43517d94",
                                        "glosses": [
                                            "To use X in place of Y."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "408f12f9-da0f-4ae8-84df-1b43f8fc0369",
                                                "sense_id": "163f1c81-fd6e-3b5c-bdd9-412a541da3c9",
                                                "text": "I had to substitute new parts for the old ones."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3fa0b57b-c0ee-301f-a3d4-d464866ab8ba",
                                        "entry_id": "6254b6d9-8901-3805-b6c6-971f43517d94",
                                        "glosses": [
                                            "To use Y in place of X; to replace X with Y."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f1a2077-57b7-44b8-9eac-2a493958d7ec",
                                                "sense_id": "3fa0b57b-c0ee-301f-a3d4-d464866ab8ba",
                                                "text": "I had to substitute old parts with the new ones."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dfe67648-05ca-3ecd-a758-ef0d1b08be98",
                                        "entry_id": "6254b6d9-8901-3805-b6c6-971f43517d94",
                                        "glosses": [
                                            "To remove (a player) from the field of play and bring on another in his place."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3232c03f-0386-4b5b-9d12-cc9180255a63",
                                                "sense_id": "dfe67648-05ca-3ecd-a758-ef0d1b08be98",
                                                "text": "He was playing poorly and was substituted after twenty minutes"
                                            },
                                            {
                                                "example_id": "44ed6f22-efe4-4225-ba0d-526c3cc2f015",
                                                "sense_id": "dfe67648-05ca-3ecd-a758-ef0d1b08be98",
                                                "text": "Mario Balotelli replaced Tevez but his contribution was so negligible that he suffered the indignity of being substituted himself as time ran out, a development that encapsulated a wretched 90 minutes for City and boss Roberto Mancini."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d09ed6dc-468f-3819-947a-62b845061f8c",
                                        "entry_id": "6254b6d9-8901-3805-b6c6-971f43517d94",
                                        "glosses": [
                                            "To serve as a replacement (for someone or something)."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dbe7ebc2-4e55-4e7f-a513-e77eb0405324",
                                                "sense_id": "d09ed6dc-468f-3819-947a-62b845061f8c",
                                                "text": "Accumulation of wealth by this route may substitute for personal saving."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "substitute",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "887ff48c-8c17-3d8f-afe8-d86ffd680b33",
                                        "entry_id": "13f1509a-7830-36af-9c30-e9b988f5df89",
                                        "glosses": [
                                            "A replacement or stand-in for something that achieves a similar result or purpose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7bbf6f68-321d-4659-b2c7-41354313ca09",
                                                "sense_id": "887ff48c-8c17-3d8f-afe8-d86ffd680b33",
                                                "text": "Ladies [in William Shakespeare's age], again, universally wore masks as the sole substitute known to our ancestors for the modern parasol; a fact, perhaps, not generally known."
                                            },
                                            {
                                                "example_id": "571caae1-258d-490e-89b3-0562ba786135",
                                                "sense_id": "887ff48c-8c17-3d8f-afe8-d86ffd680b33",
                                                "text": "Since you left me, if you see me with another girl / Seeming like I'm having fun / Although she may be cute, she's just a substitute / Because you're the permanent one"
                                            },
                                            {
                                                "example_id": "ab25465e-a6ee-4e3e-9903-cddee0aa4243",
                                                "sense_id": "887ff48c-8c17-3d8f-afe8-d86ffd680b33",
                                                "text": "Here we go. AK-47. The very best there is. When you absolutely, positively got to kill every motherfucker in the room, accept no substitutes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9615f433-6662-3f0d-8c7a-0eb4d1968953",
                                        "entry_id": "13f1509a-7830-36af-9c30-e9b988f5df89",
                                        "glosses": [
                                            "A substitute teacher."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4046c72a-3a1c-3142-9243-c2d8c3b9b71d",
                                        "entry_id": "13f1509a-7830-36af-9c30-e9b988f5df89",
                                        "glosses": [
                                            "A player who is available to replace another if the need arises, and who may or may not actually do so."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d32439e-ec74-4fab-9f0b-a5bbf89c6950",
                                                "sense_id": "4046c72a-3a1c-3142-9243-c2d8c3b9b71d",
                                                "text": "Dean Whitehead opened the scoring shortly after the break with a low finish and substitute Peter Crouch sealed the win with a tap-in."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a37b8883-d79f-3d15-93b6-28b76ebf53f7",
                                        "entry_id": "13f1509a-7830-36af-9c30-e9b988f5df89",
                                        "glosses": [
                                            "One who enlists for military service in the place of a conscript."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "75d1aca0-aeac-3851-b7bf-38d9d47b6896",
                                        "entry_id": "13f1509a-7830-36af-9c30-e9b988f5df89",
                                        "glosses": [
                                            "Abbreviation of substitute good."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b5a12da5-39b1-4d8e-bb2e-a39446fbd45e",
                        "source_entry_id": "1c869e6c-b7ee-3c62-9437-0eb8f2c59438",
                        "source_sense_id": "de143322-3c2c-37fc-9a9b-1c5fa80cbdb8",
                        "target_lang_word": "remplaçant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "remplaçant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "094f6ceb-2e5d-38b6-9b8a-64eb3cd5b2bf",
                                        "entry_id": "915a599a-5844-34a5-8da6-74e24ca4f8b2",
                                        "glosses": [
                                            "Personne qui en remplace une autre dans une fonction, dans une occupation quelconque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "244bb862-b586-43ab-8e17-bb7f47577dad",
                                                "sense_id": "094f6ceb-2e5d-38b6-9b8a-64eb3cd5b2bf",
                                                "text": "C'est dans ce cercle de personnages politiques réservés et non de personnalités politiciennes et paradeuses qu'il convient de rechercher le profil du remplaçant que Paul Biya prépare pour le Cameroun », précise le politologue."
                                            },
                                            {
                                                "example_id": "7084e11a-590c-4b3f-947a-557d2344e3ed",
                                                "sense_id": "094f6ceb-2e5d-38b6-9b8a-64eb3cd5b2bf",
                                                "text": "Cela concerne toute les associations, estime Bernard Cron, bénévole au sein de l’Union Vélocipédique Angérienne. On peine à trouver nos remplaçants, qui pourraient amener du sang neuf."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "970ebad9-a8f8-3014-863b-8d2dde7e9c3f",
                                        "entry_id": "915a599a-5844-34a5-8da6-74e24ca4f8b2",
                                        "glosses": [
                                            "Celui qui remplaçait un jeune homme appelé au service militaire, au temps de la conscription par tirage au sort."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94bf18f1-f7fc-4ce4-b07f-0c98d68b842e",
                                                "sense_id": "970ebad9-a8f8-3014-863b-8d2dde7e9c3f",
                                                "text": "À cette époque, les remplaçants étaient rares ; déjà plusieurs familles riches les retenaient d’avance pour n’en pas manquer au moment du tirage."
                                            },
                                            {
                                                "example_id": "cdff2c9a-06a1-49d6-91a9-437252a5aa8e",
                                                "sense_id": "970ebad9-a8f8-3014-863b-8d2dde7e9c3f",
                                                "text": "Vous êtes solide, reprit-il en s’asseyant sous un berceau de vigne et toisant le vieillard comme un marchand de chair humaine toise un remplaçant."
                                            },
                                            {
                                                "example_id": "986150bc-5e4d-4d77-acfa-9c6b10a0061e",
                                                "sense_id": "970ebad9-a8f8-3014-863b-8d2dde7e9c3f",
                                                "text": "Le service militaire, qui avait été un devoir de la noblesse, était abandonné à ceux qui ne pouvaient faire l'achat d'un remplaçant."
                                            },
                                            {
                                                "example_id": "5f72b88c-0aed-4ffc-bc10-5de8110c8a13",
                                                "sense_id": "970ebad9-a8f8-3014-863b-8d2dde7e9c3f",
                                                "text": "C’est le remplaçant caché dans cette tirelire qui absorbe toutes les petites pièces et les gros sous que d’autres, mes copains, dépensent le dimanche et les jours de foire, en entrées aux baraques, cigares à paille, canons en cuivre."
                                            },
                                            {
                                                "example_id": "38105fee-d1be-41fd-8153-8facba168da6",
                                                "sense_id": "970ebad9-a8f8-3014-863b-8d2dde7e9c3f",
                                                "text": "Et, faisant allusion à la somme qu’il avait touchée comme remplaçant :\n— N’importe ! quinze cents balles, pour ce métier-là, on est rudement volé !… Ce qu’il doit fumer de bonnes pipes, au coin de son feu, le richard à la place de qui je vas me faire casser la gueule !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2047179-230a-3156-a83c-c5934203b306",
                                        "entry_id": "915a599a-5844-34a5-8da6-74e24ca4f8b2",
                                        "glosses": [
                                            "Celui des joueurs d'une équipe sportive, qui peut suppléer un joueur défaillant au cours d’une partie."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d8512d1-1f16-4370-af2b-764b63b91a63",
                                                "sense_id": "f2047179-230a-3156-a83c-c5934203b306",
                                                "text": "— Allez, monte là-dedans. Ton copain n’ira pas loin. Tu seras aussi bien au poste pour l’attendre. Tu vas jouer remplaçant."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "remplaçant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7d5fd2ac-d23b-3530-abda-d77b0675892e",
                                        "entry_id": "4acc891d-45ad-3be2-bbb5-d621b1a22e4b",
                                        "glosses": [
                                            "Participe présent de remplacer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2938a86-3228-4d02-b468-4b4caf801812",
                                                "sense_id": "7d5fd2ac-d23b-3530-abda-d77b0675892e",
                                                "text": "Mac Lean au fond dans sa technique ne modifie que d’une façon minime celle de Bang, remplaçant, pour désalbuminer, le chlorure de potassium par l’hydrate de fer colloïdal."
                                            }
                                        ]
