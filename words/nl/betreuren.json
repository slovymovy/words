                    "frequency": "Middle",
                    "semantic_group_id": "spijt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>betreur</w> het dat ik niet verder heb doorgeleerd toen ik jong was.",
                            "target_lang_translations": {
                                "en": "I <w>regret</w> that I did not continue my education when I was young."
                            }
                        },
                        {
                            "text": "De directie laat weten de beslissing ten zeerste te <w>betreuren</w>.",
                            "target_lang_translations": {
                                "en": "The management makes it known that they deeply <w>deplore</w> the decision."
                            }
                        },
                        {
                            "text": "Het is een besluit dat we nog lang zullen <w>betreuren</w>.",
                            "target_lang_translations": {
                                "en": "It is a decision that we will <w>regret</w> for a long time to come."
                            }
                        }
                    ],
                    "synonyms": [
