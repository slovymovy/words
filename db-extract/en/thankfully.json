                ],
                "senses": [
                    {
                        "sense_id": "26335b40-2eb2-337a-bbd9-36056d0aa6dc",
                        "entry_id": "ff0f265a-4b27-3c3c-a05a-4986b8ae0015",
                        "glosses": [
                            "In a thankful manner; giving thanks."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66ee3ae6-5930-4776-9f7c-d649897dc3f4",
                                "sense_id": "26335b40-2eb2-337a-bbd9-36056d0aa6dc",
                                "text": "Gratiano:\n[…]I owe you much, and, like a wilful youth\nThat which I owe is lost; but if you please\nTo shoot another arrow that self way\nWhich you did shoot the first, I do not doubt,\nAs I will watch the aim, or to find both,\nOr bring your latter hazard back again,\nAnd thankfully rest debtor for the first."
                            },
                            {
                                "example_id": "2d3ae19a-58c4-44e6-873e-c3c57c5a86dc",
                                "sense_id": "26335b40-2eb2-337a-bbd9-36056d0aa6dc",
                                "text": "I immediately offered my assistance to the unhappy person, who thankfully accepted it, and, putting himself under my conduct, begged me to convey him to some tavern, where he might send for a surgeon […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "97913b28-44e0-3898-8d38-aef72ba3163d",
                        "entry_id": "ff0f265a-4b27-3c3c-a05a-4986b8ae0015",
                        "glosses": [
                            "fortunately, gratefully."
                        ],
                        "tags": [
                            "proscribed",
                            "sometimes"
                        ],
                        "examples": [
                            {
                                "example_id": "dd82015e-a5ab-4260-aea1-42068d58f01d",
                                "sense_id": "97913b28-44e0-3898-8d38-aef72ba3163d",
                                "text": "I was almost late for work, but thankfully there wasn't much traffic on the roads."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2fff5f26-d180-4f84-b263-99f098769e74",
                        "source_entry_id": "ff0f265a-4b27-3c3c-a05a-4986b8ae0015",
                        "source_sense_description": "fortunately",
                        "target_lang_word": "gelukkig",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gelukkig",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "31582006-d29c-3963-8023-5eb6c87a3806",
                                        "entry_id": "66ad9c02-6767-34be-960d-99e12c9b436c",
                                        "glosses": [
                                            "in een tevredene toestand zijn, zich goed voelen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c65d37bb-ac64-429e-ab7c-eb69a9ebae64",
                                                "sense_id": "31582006-d29c-3963-8023-5eb6c87a3806",
                                                "text": "\"Veel mensen vergissen zich in wat ze gelukkig maakt\""
                                            },
                                            {
                                                "example_id": "a3f348ed-d11e-42ce-a1e4-6548cc672d9e",
                                                "sense_id": "31582006-d29c-3963-8023-5eb6c87a3806",
                                                "text": "De hemel van de zomer verjaagt het zuur van de stad, zong Charles Trenet al: 'Wij zijn gelukkig, Route Nationale 7.'"
                                            },
                                            {
                                                "example_id": "6b79f476-5411-4d0c-8637-e24708c5eee3",
                                                "sense_id": "31582006-d29c-3963-8023-5eb6c87a3806",
                                                "text": "Dit alles betekende ook dat ik mijn gezin lange tijd niet zou zien. Gelukkig had mijn vrouw daar geen probleem mee omdat ze zelf kort ervoor een lange wandeling naar Santiago de Compostela had gemaakt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "890f2877-b45f-31c8-a15c-2b4d595dbe47",
                                        "entry_id": "66ad9c02-6767-34be-960d-99e12c9b436c",
                                        "glosses": [
                                            "door gunstig toeval, met mazzel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c40ee084-b598-4607-b9eb-c87867484273",
                                                "sense_id": "890f2877-b45f-31c8-a15c-2b4d595dbe47",
                                                "text": "Het elftal van Ernie Brandts mocht in de eerste helft van geluk spreken dat de thuisclub een zestal kansen onbenut liet, voordat Simon Cziommer in de 41ste minuut na een actie van Dembélé met een gelukkig schot de score openbrak."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a5ba3f06-f0f2-4445-aabd-48c30af7414a",
                        "source_entry_id": "ff0f265a-4b27-3c3c-a05a-4986b8ae0015",
                        "source_sense_description": "fortunately",
                        "target_lang_word": "Gott sei Dank",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gott sei Dank",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "58b288df-4585-3a84-96b2-992f526818d5",
                                        "entry_id": "d9548378-8cbf-3ca7-b847-bec18de09d8f",
                                        "glosses": [
                                            "Ausdruck der Erleichterung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01756b52-a9ec-4bed-a53c-4a671ad54c6b",
                                                "sense_id": "58b288df-4585-3a84-96b2-992f526818d5",
                                                "text": "Gott sei Dank wurde bei dem Unfall keiner verletzt."
                                            },
                                            {
                                                "example_id": "7a9da87a-80f1-4a2d-aa2d-38699e875e4a",
                                                "sense_id": "58b288df-4585-3a84-96b2-992f526818d5",
                                                "text": "Er hat nichts bemerkt. — Gott sei Dank!"
                                            },
                                            {
                                                "example_id": "e975468b-5684-497d-9920-cae1c12b4d83",
                                                "sense_id": "58b288df-4585-3a84-96b2-992f526818d5",
                                                "text": "„Nach Generalaussprache sah das hier ja Gott sei Dank nicht mehr aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7a026978-fb5b-40d4-9557-2f2132c3a9da",
                        "source_entry_id": "ff0f265a-4b27-3c3c-a05a-4986b8ae0015",
                        "source_sense_description": "fortunately",
                        "target_lang_word": "glücklich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "glücklich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "35154ff5-754a-3cd3-b9f8-1ea4b9de6fac",
                                        "entry_id": "835c4543-961f-3b63-98b4-f67842beb053",
                                        "glosses": [
                                            "(Zufalls-)Glück oder Erfolg habend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f512a748-549e-4ca8-bb63-6391ad3b9092",
                                                "sense_id": "35154ff5-754a-3cd3-b9f8-1ea4b9de6fac",
                                                "text": "In Erzählungen enden die meisten Abenteuer glücklich."
                                            },
                                            {
                                                "example_id": "5049dd91-8bab-4315-a5e4-6871d3ae5be6",
                                                "sense_id": "35154ff5-754a-3cd3-b9f8-1ea4b9de6fac",
                                                "text": "„Jeder glücklich erreichte Gipfel vermittelt das Bewusstsein, sich ein nicht jedermann zugängliches, dem Bergsteiger wichtiges Stück Bergwelt unseres Globus selbst erarbeitet und damit zu eigen gemacht zu haben.“"
                                            },
                                            {
                                                "example_id": "6ef6656a-eaed-4f59-95a6-e8066b876bcc",
                                                "sense_id": "35154ff5-754a-3cd3-b9f8-1ea4b9de6fac",
                                                "text": "Odysseus kehrte nach Jahren glücklich zu seiner Penelope zurück."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c24172ae-1f3f-30d1-bbc3-8df5c3b1cfa5",
                                        "entry_id": "835c4543-961f-3b63-98b4-f67842beb053",
                                        "glosses": [
                                            "von großer Freude, Zufriedenheit, vom (Wohlfühl-)Glück erfüllt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3805a823-b63a-452f-9092-5e264baddece",
                                                "sense_id": "c24172ae-1f3f-30d1-bbc3-8df5c3b1cfa5",
                                                "text": "„Jeder glücklich erreichte Gipfel vermittelt das Bewusstsein, sich ein nicht jedermann zugängliches, dem Bergsteiger wichtiges Stück Bergwelt unseres Globus selbst erarbeitet und damit zu eigen gemacht zu haben.“"
                                            },
                                            {
                                                "example_id": "bb00e28a-8bfd-42d5-922a-5245c306504b",
                                                "sense_id": "c24172ae-1f3f-30d1-bbc3-8df5c3b1cfa5",
                                                "text": "Odysseus kehrte nach Jahren glücklich zu seiner Penelope zurück."
                                            },
                                            {
                                                "example_id": "6df53a76-569c-41cf-9457-7eabfc6f0963",
                                                "sense_id": "c24172ae-1f3f-30d1-bbc3-8df5c3b1cfa5",
                                                "text": "Sie war so glücklich, als ich sie in meinen Armen hielt."
                                            },
                                            {
                                                "example_id": "03711893-355c-45bf-b49c-cc901712af24",
                                                "sense_id": "c24172ae-1f3f-30d1-bbc3-8df5c3b1cfa5",
                                                "text": "Willst du glücklich sein im Leben, trage bei zu andrer Glück, denn die Freude, die wir geben, kehrt ins eig'ne Herz zurück."
                                            },
                                            {
                                                "example_id": "9c1a176c-7ce0-4c32-b02c-edb404d78c68",
                                                "sense_id": "c24172ae-1f3f-30d1-bbc3-8df5c3b1cfa5",
                                                "text": "„Das Adoptivkaisertum ist vielfach als die glücklichste Zeit der antiken Geschichte bezeichnet worden.“"
                                            },
                                            {
                                                "example_id": "734174fe-97cb-4942-9b55-886dce5594e7",
                                                "sense_id": "c24172ae-1f3f-30d1-bbc3-8df5c3b1cfa5",
                                                "text": "„… ich lief weiter und war glücklich, daß ich endlich rechts und links in der Ferne Mauern sah.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "1eb22e15-fe65-325d-9642-c13a0aa3887d",
                                        "entry_id": "835c4543-961f-3b63-98b4-f67842beb053",
                                        "glosses": [
                                            "vorteilhaft, günstig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7f47ad5-588a-4bfa-84b2-c0575e37fb41",
                                                "sense_id": "1eb22e15-fe65-325d-9642-c13a0aa3887d",
                                                "text": "Nur aufgrund glücklicher Umstände kamen wir mit geringen Verletzungen davon."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "d63c760b-8ec6-323b-8657-b7d6fab8b053",
                                        "entry_id": "835c4543-961f-3b63-98b4-f67842beb053",
                                        "glosses": [
                                            "schließlich, zu guter Letzt"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58c0bdf6-6232-43e0-9aba-1093d1409286",
                                                "sense_id": "d63c760b-8ec6-323b-8657-b7d6fab8b053",
                                                "text": "Nach langen Versuchen hat er das Radio doch noch glücklich zum Laufen gebracht."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
