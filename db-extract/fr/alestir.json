                "senses": [
                    {
                        "sense_id": "da2b88f0-983d-30dd-8995-ea618a653c0f",
                        "entry_id": "38e55892-f582-3ed3-a2cc-fb5c3c43816b",
                        "glosses": [
                            "Se débarrasser de tout ce qui gène, alléger, rendre plus leste."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "de707409-7811-49f6-a039-a56748882348",
                                "sense_id": "da2b88f0-983d-30dd-8995-ea618a653c0f",
                                "text": "Le lendemain on travailla à alestir le vaisseau et à mettre les armes en état."
                            },
                            {
                                "example_id": "bb9cdd31-a975-4e48-8b1f-9c40f40856cb",
                                "sense_id": "da2b88f0-983d-30dd-8995-ea618a653c0f",
                                "text": "Mettre en rade, c'est lorsque le vaisseau sort du port et qu'il ancre dans la rade, pour achever son chargement, prendre ce qui lui est nécessaire, et s'alestir avant de mettre dehors."
                            },
                            {
                                "example_id": "d74298e6-d72c-41ca-9c13-ff1ef979146a",
                                "sense_id": "da2b88f0-983d-30dd-8995-ea618a653c0f",
                                "text": "« Caïcqs et canots à la poste ! Alestissez les barbettes et mettez la galère à la droite! »"
                            }
                        ]
                    }
                ],
