                    },
                    {
                        "translation_id": "488a40a5-023d-44b7-a4d9-ab9e76336327",
                        "source_entry_id": "de6cda33-f405-36fd-930a-4d8b8c72f41f",
                        "source_sense_id": "a204893f-ad15-304f-ac99-119148300b9a",
                        "target_lang_word": "Zielstrebigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zielstrebigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "742b1e32-9888-389f-9308-9fb21ea73915",
                                        "entry_id": "b23a5dcf-7268-313e-9a28-22534b6d7d8f",
                                        "glosses": [
                                            "Entschlossenheit einer Person, etwas zu erreichen"
                                        ],
                                        "tags": [
                                            "Plural selten"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4cacf141-ce1d-4863-a564-02de463791b8",
                                                "sense_id": "742b1e32-9888-389f-9308-9fb21ea73915",
                                                "text": "[Katharina II:] „Mit Ehrgeiz und Zielstrebigkeit erlernte die begabte Vierzehnjährige schnell die russische Sprache und versuchte, sich am Hof zu integrieren.“"
                                            },
                                            {
                                                "example_id": "f7a506a6-13e3-460f-8a3e-62a82dbbae5f",
                                                "sense_id": "742b1e32-9888-389f-9308-9fb21ea73915",
                                                "text": "[Über den Schachspieler Magnus Carlsen und seine Schwester Ellen:] „Aber Magnus besaß eine Zielstrebigkeit, die seine Schwester nicht hatte.“"
                                            },
                                            {
                                                "example_id": "c5a0a8d6-d647-4309-a088-9157eec063db",
                                                "sense_id": "742b1e32-9888-389f-9308-9fb21ea73915",
                                                "text": "[Über den Hitler-Attentäter Georg Elser:] „«Die Zielstrebigkeit, mit der Elser seine Tat völlig auf sich allein gestellt geplant und durchgeführt hat, ist beeindruckend», sagt Benz.“"
                                            },
                                            {
                                                "example_id": "ab28fdc0-8542-4d6e-9158-30c90560a1fd",
                                                "sense_id": "742b1e32-9888-389f-9308-9fb21ea73915",
                                                "text": "„Grace wurde streng erzogen. Disziplin, Ehrgeiz und Zielstrebigkeit galten in der Familie als Tugenden.“"
                                            },
                                            {
                                                "example_id": "c7f8bf03-2b7d-4ec7-9a0d-b49eadc4e9f1",
                                                "sense_id": "742b1e32-9888-389f-9308-9fb21ea73915",
                                                "text": "„Als erfolgreich gilt, wer berufliche Zielstrebigkeit mit Freizeit und Familie in Einklang bringt.“"
                                            },
                                            {
                                                "example_id": "d70abb52-eaa3-48fc-9213-5c331d365d84",
                                                "sense_id": "742b1e32-9888-389f-9308-9fb21ea73915",
                                                "text": "„Mit viel Fleiß, Zielstrebigkeit und Intelligenz schaffte Michelle Obama nach ihrem Schulabschluss den Sprung an die Elite-Universität Princeton.“"
                                            },
                                            {
                                                "example_id": "6e83fe55-cc5b-4a92-84b3-6b8071005f6e",
                                                "sense_id": "742b1e32-9888-389f-9308-9fb21ea73915",
                                                "text": "[Der Bundeskanzler Konrad] „Adenauer war das Idealbild eines starken Parteiführers. Machtwille, Durchsetzungsvermögen und Zielstrebigkeit werden ihm nachgesagt.“"
                                            },
                                            {
                                                "example_id": "b9256167-e168-4b4f-9839-0b7c4b43efe3",
                                                "sense_id": "742b1e32-9888-389f-9308-9fb21ea73915",
                                                "text": "[Fußball:] „Mit Robben ab der 55. Minute wollte Guardiola mehr Tempo und Zielstrebigkeit ins Münchner Spiel bringen - trotz klarer Spielvorteile blieb der Rekordpokalsieger aber weiter vieles schuldig.“"
                                            },
                                            {
                                                "example_id": "6e2bd3f1-4301-41b1-84a6-0242a8b42f8a",
                                                "sense_id": "742b1e32-9888-389f-9308-9fb21ea73915",
                                                "text": "[Fußball:] „In beiden Partien mangelte es zudem lange Zeit an der Genauigkeit und Zielstrebigkeit im Passspiel“ […]."
                                            },
                                            {
                                                "example_id": "3a64eae1-1022-46cf-b113-bca6c9ff487d",
                                                "sense_id": "742b1e32-9888-389f-9308-9fb21ea73915",
                                                "text": "„Fleiß und Zielstrebigkeit und das Bemühen, möglichst gut und umfassend gebildet zu sein, hat den Aramäern über Jahrhunderte hinweg ihr Bestehen gesichert.“"
                                            },
                                            {
                                                "example_id": "8f040a82-7d2d-4a96-90c5-8918ee49796d",
                                                "sense_id": "742b1e32-9888-389f-9308-9fb21ea73915",
                                                "text": "„Immer wieder leiden Spitzenathletinnen und -athleten an Essstörungen. Spezifische Aspekte des Sports, wie extreme Zielstrebigkeit, Perfektionismus oder sozialer Druck bedingen die Erkrankung“ […]."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
