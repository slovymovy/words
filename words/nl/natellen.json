                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Iedere avond moest ik het geld <w>natellen</w> om te zien hoeveel we verdiend hadden.",
                            "target_lang_translations": {
                                "en": "Every evening I had to <w>recount</w> the money to see how much we had earned."
                            }
                        },
                        {
                            "text": "De caissière <w>telde</w> de bankbiljetten zorgvuldig <w>na</w> voordat ze het wisselgeld teruggaf.",
                            "target_lang_translations": {
                                "en": "The cashier carefully <w>recounted</w> the banknotes before handing back the change."
                            }
                        },
                        {
                            "text": "Je kunt op je vingers <w>natellen</w> dat dit plan tot grote problemen gaat leiden.",
                            "target_lang_translations": {
                                "en": "You can <w>figure out</w> that this plan is going to lead to major problems."
                            }
                        }
                    ],
