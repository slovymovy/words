                    {
                        "translation_id": "3815b4eb-a861-4a05-bafe-a3238d503fc1",
                        "source_entry_id": "f125bbd2-4704-33d5-b16d-0e917456c221",
                        "source_sense_description": "Appareil",
                        "target_lang_word": "speaking trumpet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "speaking trumpet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5af0692a-978d-3f68-9c4f-36768d2aef03",
                                        "entry_id": "bca0320f-25f0-3416-b8ff-228355f76f0f",
                                        "glosses": [
                                            "A megaphone (of the older, non-electric kind)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79bcfdd9-53f4-4c07-8381-830cd1b22111",
                                                "sense_id": "5af0692a-978d-3f68-9c4f-36768d2aef03",
                                                "text": "He passed his arm round a rope to steady himself, made a speaking-trumpet of his hands, and suddenly dropped them again without uttering a sound."
                                            },
                                            {
                                                "example_id": "d878ff9a-1674-42e6-8b46-536e084a3827",
                                                "sense_id": "5af0692a-978d-3f68-9c4f-36768d2aef03",
                                                "text": "A short, square-built man, in a rough grey jacket, with a speaking-trumpet in hand, stood in the weather hammock nettings."
                                            },
                                            {
                                                "example_id": "727f99e7-d021-450d-8a14-346ba8d5f9bb",
                                                "sense_id": "5af0692a-978d-3f68-9c4f-36768d2aef03",
                                                "text": "I made a speaking trumpet of my hands and commenced to whoop “Ahoy!” and “Hello!” at the top of my lungs. […] The Colonel woke up, and, after asking what in brimstone was the matter, opened his mouth and roared “Hi!” and “Hello!” like the bull of Bashan."
                                            },
                                            {
                                                "example_id": "802f385a-3c67-4e93-80ca-66597a8da3db",
                                                "sense_id": "5af0692a-978d-3f68-9c4f-36768d2aef03",
                                                "text": "There was a battered brass speaking-trumpet, very discoloured, a tambourine, a musical-box, and a number of smaller objects."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
