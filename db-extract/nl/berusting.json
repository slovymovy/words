                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "résignation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "741f593a-030e-3988-98b1-48d6c1305f9e",
                                        "entry_id": "0fd27cd2-3b86-3e1f-9f8c-71d633a5022f",
                                        "glosses": [
                                            "Abandon en faveur de quelqu’un."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61498ad1-4ab9-4082-b27c-755cf05eaeab",
                                                "sense_id": "741f593a-030e-3988-98b1-48d6c1305f9e",
                                                "text": "Mais fidèle à ses promesses, le césaréwitch assura, d'abord à son frère cadet, le grand-duc Michel, qui était à Varsovie, puis à tout son entourage que ce n'était pas lui, mais bien à son frère Nicolas à monter sur le trône de Russie et montra à tous les documents se rapportant à sa résignation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5bd05d09-b36a-325e-9329-f0a09524a06b",
                                        "entry_id": "0fd27cd2-3b86-3e1f-9f8c-71d633a5022f",
                                        "glosses": [
                                            "Action de résigner un office, une charge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ee578a7-cf77-4b7d-8903-2f36a3027bc7",
                                                "sense_id": "5bd05d09-b36a-325e-9329-f0a09524a06b",
                                                "text": "La résignation d’un archevêché."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8829b0d1-dde2-3c4e-a54c-a977a7f3d2b1",
                                        "entry_id": "0fd27cd2-3b86-3e1f-9f8c-71d633a5022f",
                                        "glosses": [
                                            "Démission d’un bénéfice dans les mains du collateur ou du pape."
                                        ],
                                        "tags": [
                                            "Droit canon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d2c2e63-aa22-4aa6-a3ba-abe9fe314864",
                                                "sense_id": "8829b0d1-dde2-3c4e-a54c-a977a7f3d2b1",
                                                "text": "Résignation pure et simple. Résignation forcée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ff84ef6-cbd6-3bea-889e-6112fad16765",
                                        "entry_id": "0fd27cd2-3b86-3e1f-9f8c-71d633a5022f",
                                        "glosses": [
                                            "Action de se résigner."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e28baea2-1a2c-49d5-9778-0a12a8096f29",
                                                "sense_id": "0ff84ef6-cbd6-3bea-889e-6112fad16765",
                                                "text": "Aussi, devant le danger qu'elles prévoyaient en ce moment, demeurèrent-elles muettes et passives, ne connaissant d'autre défense que la résignation chrétienne."
                                            },
                                            {
                                                "example_id": "95d61364-d420-4628-b0e8-fdd11d9b9b56",
                                                "sense_id": "0ff84ef6-cbd6-3bea-889e-6112fad16765",
                                                "text": "Elle lut sur le visage presque féminin du jeune anglais les pensées profondes, les mélancolies douces, les résignations douloureuses dont elle-même était la victime."
                                            },
                                            {
                                                "example_id": "9efd7e0d-9f72-42be-95eb-79911a973f9f",
                                                "sense_id": "0ff84ef6-cbd6-3bea-889e-6112fad16765",
                                                "text": "Sérieuse et triste comme toujours, enveloppée dans sa résignation et dans son rêve, elle dansait, pour ces hommes dont elle serait la proie dès la fermeture du bouge."
                                            },
                                            {
                                                "example_id": "d3dd3cc4-b4dc-4e45-8ba3-f7da7de4f0f1",
                                                "sense_id": "0ff84ef6-cbd6-3bea-889e-6112fad16765",
                                                "text": "Et la rue retomba dans le demi-silence, la torpeur, la résignation qu'une descente de police laisse toujours derrière elle."
                                            },
                                            {
                                                "example_id": "d5125e40-63e0-4fd9-8038-efba05690c0d",
                                                "sense_id": "0ff84ef6-cbd6-3bea-889e-6112fad16765",
                                                "text": "Il y a une sorte d’habitude du désespoir qui s’appelle résignation et cette résignation vient assez vite."
                                            },
                                            {
                                                "example_id": "5d7424bf-031a-4220-94a5-1e288df91173",
                                                "sense_id": "0ff84ef6-cbd6-3bea-889e-6112fad16765",
                                                "text": "Il sentait couler dans ses veines toute la sanie des rêves impuissants, des appétences infécondes, et sur son échine s'appesantissait le fardeau de la résignation et de la timidité."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
