                "senses": [
                    {
                        "sense_id": "af9074e1-f7e8-37a1-a1ea-855aabb8ced6",
                        "entry_id": "d9399a1b-4a3b-39f1-b76d-bbb9902f0d21",
                        "glosses": [
                            "złośliwy, docinkowy, szczery do bólu, pełen sarkazmu"
