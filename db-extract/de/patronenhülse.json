                                    {
                                        "sense_id": "7b185af7-bc0a-3e40-ab35-dbdedda8502a",
                                        "entry_id": "06ad00b8-baca-336e-829a-2a29e5bb2d29",
                                        "glosses": [
                                            "цилиндр с дном, предназначенный для помещения заряда и соединения частей патрона, снаряда"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3650bfb3-a7f9-45d8-9628-56d31c73394a",
                                                "sense_id": "7b185af7-bc0a-3e40-ab35-dbdedda8502a",
                                                "text": "Для удаления пустых гильз необходимо большим пальцем переместить кнопку фиксатора к спусковой скобе."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a078c46-8ad6-3b1d-bd93-809178be41ad",
                                        "entry_id": "06ad00b8-baca-336e-829a-2a29e5bb2d29",
                                        "glosses": [
                                            "бумажная трубочка, патрон папиросы, сигареты, набиваемый табаком"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac017e33-d1a6-41bf-8927-66243b648fa9",
                                                "sense_id": "6a078c46-8ad6-3b1d-bd93-809178be41ad",
                                                "text": "Студент дунул в гильзу и начал набивать себе папироску"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "814a9f97-83e4-3ad7-84d1-95190cce9c51",
                                        "entry_id": "06ad00b8-baca-336e-829a-2a29e5bb2d29",
                                        "glosses": [
                                            "деталь технического устройства, имеющая форму трубки, цилиндра"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d8ff2f5-9002-45e7-9657-f71dcdd3ac38",
                                                "sense_id": "814a9f97-83e4-3ad7-84d1-95190cce9c51",
                                                "text": "Соединение выполняется путём развальцовки конца трубы и надевания его на фасонную часть, после чего гильза надвигается на конец трубы."
                                            }
                                        ]
                                    }
                                ]
