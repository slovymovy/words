                                            {
                                                "example_id": "ff9898a3-2e4d-4cc6-8697-ceef1a279f1a",
                                                "sense_id": "971e5c3a-fe70-3961-ae98-778b6bacebd1",
                                                "text": "Pour augmenter le merveilleux, l’un des avocats qui conduisent l’interrogatoire a exhibé devant le jury une fiole à demi vide de poison, qui lui avait été envoyée anonymement par la poste."
                                            },
                                            {
                                                "example_id": "1a407a05-b94e-40e4-92ef-3575dc75c489",
                                                "sense_id": "971e5c3a-fe70-3961-ae98-778b6bacebd1",
                                                "text": "Mais ils permettaient aussi de surfer anonymement sur Internet car ils s'appuyaient sur des serveurs proxy qui cryptaient les données. Peter pouvait ainsi se connecter facilement, et seul serait visible son accès au serveur VPN – et non à celui de l'AMRF."
                                            }
                                        ]
                                    }
                                ]
