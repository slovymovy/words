{
    "word_family": [
        "удобство",
        "удобный",
        "неудобство",
        "неудобный"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "a55f857c-b9ba-38a8-902c-a2bab1018c60",
                    "sense_definition": "Комфортно, приятно, создавая ощущение физического покоя и уюта.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "comfort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В этом мягком кресле сидеть очень <w>удобно</w>.",
                            "target_lang_translations": {
                                "en": "It is very <w>comfortable</w> to sit in this soft armchair.",
                                "de": "In diesem weichen Sessel sitzt man sehr <w>bequem</w>."
                            }
                        },
                        {
                            "text": "Мне <w>удобно</w> в этих новых кроссовках, ноги совсем не устают.",
                            "target_lang_translations": {
                                "en": "I am <w>comfortable</w> in these new sneakers, my feet don't get tired at all.",
                                "de": "Ich fühle mich in diesen neuen Turnschuhen sehr <w>wohl</w>, die Füße ermüden überhaupt nicht."
                            }
                        }
                    ],
                    "synonyms": [
                        "комфортно",
                        "уютно"
                    ],
                    "antonyms": [
                        "неудобно",
                        "некомфортно",
                        "неуютно"
                    ],
                    "common_phrases": [
                        "мне удобно",
                        "удобно сидеть",
                        "удобно лежать"
                    ],
                    "target_lang_definitions": {
                        "en": "In a way that provides physical comfort, ease, or relaxation.",
                        "de": "Auf eine Art und Weise, die körperliches Wohlbefinden, Gemütlichkeit und Entspannung bietet."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "comfortable",
                                "target_lang_sense_clarification": "feeling or providing physical ease"
                            },
                            {
                                "target_lang_word": "comfortably",
                                "target_lang_sense_clarification": "in a physically relaxed manner"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "bequem",
                                "target_lang_sense_clarification": "körperlich angenehm oder behaglich"
                            },
                            {
                                "target_lang_word": "gemütlich",
                                "target_lang_sense_clarification": "behaglich und wohnlich"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6d6000a1-10a9-31ab-bc74-7c22c9174ee1",
                    "sense_definition": "Подходящим образом, удачно для использования или выполнения чего-либо.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "convenience",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Этот магазин <w>удобно</w> расположен рядом с моим домом.",
                            "target_lang_translations": {
                                "en": "This shop is <w>conveniently</w> located next to my house.",
                                "de": "Dieses Geschäft ist <w>günstig</w> in der Nähe meines Hauses gelegen."
                            }
                        },
                        {
                            "text": "Нам будет <w>удобно</w> встретиться завтра утром в офисе.",
                            "target_lang_translations": {
                                "en": "It will be <w>convenient</w> for us to meet tomorrow morning at the office.",
                                "de": "Es würde uns gut <w>passen</w>, uns morgen früh im Büro zu treffen."
                            }
                        }
                    ],
                    "synonyms": [
                        "сподручно",
                        "комфортно",
                        "удачно"
                    ],
                    "antonyms": [
                        "неудобно"
                    ],
                    "common_phrases": [
                        "удобно пользоваться",
                        "удобно расположен",
                        "удобно добираться"
                    ],
                    "target_lang_definitions": {
                        "en": "In a way that fits well with plans, needs, or location; practically.",
                        "de": "Auf günstige, praktische oder zweckmäßige Weise."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "conveniently",
                                "target_lang_sense_clarification": "in a practical or accessible way"
                            },
                            {
                                "target_lang_word": "convenient",
                                "target_lang_sense_clarification": "suited to one's needs or plans"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "praktisch",
                                "target_lang_sense_clarification": "zweckmäßig oder leicht zu handhaben"
                            },
                            {
                                "target_lang_word": "günstig",
                                "target_lang_sense_clarification": "vorteilhaft gelegen oder passend"
                            },
                            {
                                "target_lang_word": "bequem",
                                "target_lang_sense_clarification": "mühelos erreichbar oder zu nutzen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5d496bb4-5ab6-3fc9-b54c-d27d60c446cd",
                    "sense_definition": "Уместно, прилично, не нарушая правил этикета или не затрудняя кого-либо.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "propriety",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Звонить коллегам поздно вечером не совсем <w>удобно</w>.",
                            "target_lang_translations": {
                                "en": "It is not quite <w>appropriate</w> to call colleagues late in the evening.",
                                "de": "Es ist nicht ganz <w>angebracht</w>, Kollegen spät am Abend anzurufen."
                            }
                        },
                        {
                            "text": "Если вам <w>удобно</w>, мы можем обсудить этот вопрос сейчас.",
                            "target_lang_translations": {
                                "en": "If it is <w>convenient</w> for you, we can discuss this issue now.",
                                "de": "Wenn es Ihnen <w>recht</w> ist, können wir diese Frage jetzt besprechen."
                            }
                        }
                    ],
                    "synonyms": [
                        "прилично"
                    ],
                    "antonyms": [
                        "неудобно",
                        "неприлично"
                    ],
                    "common_phrases": [
                        "если удобно",
                        "не очень удобно"
                    ],
                    "target_lang_definitions": {
                        "en": "Socially acceptable, polite, or suitable for the situation.",
                        "de": "Den gesellschaftlichen Konventionen oder dem Anstand entsprechend; passend und ungezwungen."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "appropriate",
                                "target_lang_sense_clarification": "socially acceptable or polite"
                            },
                            {
                                "target_lang_word": "convenient",
                                "target_lang_sense_clarification": "fitting for a situation or schedule"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "angebracht",
                                "target_lang_sense_clarification": "den Umständen oder der Höflichkeit entsprechend"
                            },
                            {
                                "target_lang_word": "passend",
                                "target_lang_sense_clarification": "zeitlich oder situativ gelegen"
                            },
                            {
                                "target_lang_word": "recht",
                                "target_lang_sense_clarification": "genehm oder gelegen"
                            }
                        ]
                    }
                }
            ]
        },
        {
