                    },
                    {
                        "translation_id": "160bf801-5a62-4db1-b6f2-22c5e0969049",
                        "source_entry_id": "560f2e77-d620-3274-89b8-1aa75174a0c4",
                        "source_sense_id": "5bce6948-6258-338c-8899-13145c08beee",
                        "target_lang_word": "marvellously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "marvellously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5ed46fdf-d54b-34bc-92bc-1b7348eaf0f6",
                                        "entry_id": "ae034daf-a3f5-3b11-b41b-8472d66b24b0",
                                        "glosses": [
                                            "In a marvellous manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c9a4100-e15f-4ddf-be94-df9073f1c24d",
                                                "sense_id": "5ed46fdf-d54b-34bc-92bc-1b7348eaf0f6",
                                                "text": "The plan worked marvellously, even better than we had expected."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "052e2166-1399-3b18-b4e6-93bd728e1c7d",
                                        "entry_id": "ae034daf-a3f5-3b11-b41b-8472d66b24b0",
                                        "glosses": [
                                            "To a great or impressive degree; very."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3141e0b-5e04-4c22-af49-403be0f41c4a",
                                                "sense_id": "052e2166-1399-3b18-b4e6-93bd728e1c7d",
                                                "text": "[N]eyther hys ſeruantes nor hymſelf ſuffered to gone^([sic – meaning go?]) oute, parceiuyng well ſo greate a thyng without his knowledge not begun for noughte, comparyng this maner preſẽ[n]t with this laſt nightes chere, ĩ[n] ſo few houres ſo gret a chaunge marueylouſlye miſliked."
                                            },
                                            {
                                                "example_id": "1649bebf-b581-4e5a-8de8-55d3ab5eec75",
                                                "sense_id": "052e2166-1399-3b18-b4e6-93bd728e1c7d",
                                                "text": "I groaned with hunger. I had seen a marvellously large penny loaf at a baker's—the largest I could possibly get for the price."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fd2c8ceb-e584-4922-bb59-c432bcf1f02f",
                        "source_entry_id": "560f2e77-d620-3274-89b8-1aa75174a0c4",
                        "source_sense_id": "5bce6948-6258-338c-8899-13145c08beee",
                        "target_lang_word": "splendidly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "splendidly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b162371e-46a3-31f9-be2e-bf4020b58c78",
                                        "entry_id": "8f87de01-fdcc-3a56-a375-0329f5e09398",
                                        "glosses": [
                                            "In a splendid manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83fcce73-54a0-4117-a43d-cdc48913978e",
                                                "sense_id": "b162371e-46a3-31f9-be2e-bf4020b58c78",
                                                "text": "“Well,” I answered, at first with uncertainty, then with inspiration, “he would do splendidly to lead your cotillon, if you think of having one.” ¶ “So you do not dance, Mr. Crocker?” ¶ I was somewhat set back by her perspicuity."
                                            },
                                            {
                                                "example_id": "e0d43273-e41c-49da-a692-142f59cd32c9",
                                                "sense_id": "b162371e-46a3-31f9-be2e-bf4020b58c78",
                                                "text": "\"Despite restrictions I did manage to talk a couple of colleagues into doing a sponsored walk [...]. Due to COVID-19 we had to organise this ourselves, but it went off splendidly and the three of us walked 12 miles along the Basing Canal on the River Wey and Thames. [...].\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eccdca0f-238a-4448-ace4-feac6f7bd437",
                        "source_entry_id": "560f2e77-d620-3274-89b8-1aa75174a0c4",
                        "source_sense_id": "5bce6948-6258-338c-8899-13145c08beee",
                        "target_lang_word": "magnifiquement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "magnifiquement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "04a08ce6-285e-38dd-b7d8-c6ea1f8e21c1",
                                        "entry_id": "78657fed-97b4-399e-ad35-dd49096d04c3",
                                        "glosses": [
                                            "D’une façon magnifique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4145c385-d1ea-4389-baf3-95bcda8b9004",
                                                "sense_id": "04a08ce6-285e-38dd-b7d8-c6ea1f8e21c1",
                                                "text": "Et elle se montre en minaudant, en s’exposant comme un beau fruit magnifiquement dressé dans l’étalage d’un marchand de comestibles."
                                            },
                                            {
                                                "example_id": "b2bdb128-ccd3-4109-82d9-5068c4fc96af",
                                                "sense_id": "04a08ce6-285e-38dd-b7d8-c6ea1f8e21c1",
                                                "text": "C'est dans les palais des rois que se trouvent ceux qui sont vêtus magnifiquement, et qui vivent dans les délices."
                                            },
                                            {
                                                "example_id": "adaf3a81-c904-4a1c-8d8f-2072145ba2f9",
                                                "sense_id": "04a08ce6-285e-38dd-b7d8-c6ea1f8e21c1",
                                                "text": "L'on a trouvé le moyen de distinguer les naissances illustres d’avec les naissances viles et vulgaires […] et par-là vous voyez déjà sa naissance magnifiquement relevée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "544140e6-50eb-316b-907e-01388eeb04e9",
                                        "entry_id": "78657fed-97b4-399e-ad35-dd49096d04c3",
                                        "glosses": [
                                            "En termes magnifiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7bed19d5-b3e5-4d9d-ad54-b385717186ec",
                                                "sense_id": "544140e6-50eb-316b-907e-01388eeb04e9",
                                                "text": "Cette vérité importante [que Dieu veut être servi par des créatures raisonnables] nous est magnifiquement exprimée dans le livre de Josué, où nous voyons […]"
                                            },
                                            {
                                                "example_id": "a9a66c0f-ca42-4ea0-9010-f9a2d9d07d60",
                                                "sense_id": "544140e6-50eb-316b-907e-01388eeb04e9",
                                                "text": "Vous parlez magnifiquement De cinq ou six contes d’enfant."
                                            },
                                            {
                                                "example_id": "ca8047be-8313-4214-8d48-9a74ec9e9572",
                                                "sense_id": "544140e6-50eb-316b-907e-01388eeb04e9",
                                                "text": "Parlant magnifiquement de la vertu et pratiquant mal ce que nous disons."
                                            },
                                            {
                                                "example_id": "3a01d62d-2939-4d6d-a8db-61e53e16df7d",
                                                "sense_id": "544140e6-50eb-316b-907e-01388eeb04e9",
                                                "text": "Platon lui-même parle si magnifiquement de Dieu, qu’on croit souvent entendre un chrétien. — (Etienne Bonnot de Condillac, Historique ancien XV, 7)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "533b2aa6-315f-4e34-a20e-045a1ea4e7c8",
                        "source_entry_id": "560f2e77-d620-3274-89b8-1aa75174a0c4",
                        "source_sense_id": "5bce6948-6258-338c-8899-13145c08beee",
                        "target_lang_word": "merveilleusement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "merveilleusement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2764d67f-2dc5-331e-aa5b-e59175ee205c",
                                        "entry_id": "7c0da8dc-487b-3a51-9f3a-f89c38cdf889",
                                        "glosses": [
                                            "D’une façon merveilleuse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5794f1d0-67af-4e79-8140-bcfc82cbcd74",
                                                "sense_id": "2764d67f-2dc5-331e-aa5b-e59175ee205c",
                                                "text": "Cela ne devrait pas vous nuire : il est prouvé que l’éducation des public-schools développe merveilleusement bien les qualités nécessaires aux grands assassins : méticulosité, flegme et absence totale de sensiblerie…"
                                            },
                                            {
                                                "example_id": "ae004500-97fb-46ca-82a3-893f663aab08",
                                                "sense_id": "2764d67f-2dc5-331e-aa5b-e59175ee205c",
                                                "text": "Il y a merveilleusement à profiter de tout ce que vous dites."
                                            },
                                            {
                                                "example_id": "7432d56f-ec8c-4f09-b18d-70cc7bf0100f",
                                                "sense_id": "2764d67f-2dc5-331e-aa5b-e59175ee205c",
                                                "text": "La beauté est partagée en mille différentes manières ; le sujet le plus propre pour la soutenir c’est une femme ; quand elle a de l’esprit, elle l’anime et la relève merveilleusement."
                                            },
                                            {
                                                "example_id": "b29caed5-ab6b-4aea-b32c-568c36dff731",
                                                "sense_id": "2764d67f-2dc5-331e-aa5b-e59175ee205c",
                                                "text": "Fort heureusement, cette portion de l’Afrique australe semblait se prêter merveilleusement à une opération de ce genre."
                                            },
                                            {
                                                "example_id": "648d19bf-41c4-49e0-aea8-984499c21614",
                                                "sense_id": "2764d67f-2dc5-331e-aa5b-e59175ee205c",
                                                "text": "Par contraste, le côté du lagon était étrangement calme, une eau merveilleusement tranquille, à peine ridée par les alizés, où passaient des poissons aux couleurs éblouissantes."
                                            },
                                            {
                                                "example_id": "02bbd38f-e67c-40b5-915b-2970d2759128",
                                                "sense_id": "2764d67f-2dc5-331e-aa5b-e59175ee205c",
                                                "text": "Ça n'était pas un gros shoot, poursuivit Goñi, une petite dose, mais assez pour se mettre à rêver merveilleusement dans un demi-sommeil. Ce qui est vraiment intéressant, c'est qu'il ne semblait pas être un consommateur régulier."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "085d1f39-dc9d-4860-9021-a7d1a7c1c186",
                        "source_entry_id": "560f2e77-d620-3274-89b8-1aa75174a0c4",
                        "source_sense_id": "5bce6948-6258-338c-8899-13145c08beee",
                        "target_lang_word": "brillamment",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brillamment",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "29ad0520-87e6-333f-ac79-1650088a0273",
                                        "entry_id": "239bcbfd-a5a7-3a40-a6b6-7c3c120d5f1c",
                                        "glosses": [
                                            "D'une manière brillante."
                                        ],
                                        "tags": [],
                                        "note": "Se dit au propre et au figuré",
                                        "examples": [
                                            {
                                                "example_id": "783d357d-b7d5-443b-bc02-f58d92311056",
                                                "sense_id": "29ad0520-87e6-333f-ac79-1650088a0273",
                                                "text": "[…]; la netteté décroit rapidement et les objets brillamment éclairés sont entourés d'une frange colorée où l’on retrouve toutes les couleurs du spectre."
                                            },
                                            {
                                                "example_id": "764027f2-c434-4ad5-9564-e4b2b836fff1",
                                                "sense_id": "29ad0520-87e6-333f-ac79-1650088a0273",
                                                "text": "Sans doute considérait-il qu’un agent secret, ayant brillamment rempli une mission, ne méritait pas qu’on lui témoignât autre chose qu’une solide estime."
                                            },
                                            {
                                                "example_id": "e6cee530-8ee6-4d94-b039-bb7677a67f61",
                                                "sense_id": "29ad0520-87e6-333f-ac79-1650088a0273",
                                                "text": "Servier […] est le premier Français depuis plus d’un quart de siècle à avoir passé brillamment une thèse sur l’ethnologie des Berbères."
                                            },
                                            {
                                                "example_id": "c239e1c7-3ce4-4b5f-9d3e-f01d0bcc7196",
                                                "sense_id": "29ad0520-87e6-333f-ac79-1650088a0273",
                                                "text": "L'ancien ministre de l'Agriculture n'a jamais été perçu aussi nettement, aussi vigoureusement, aussi brillamment comme le plus populaire des « présidentiables » de la majorité."
                                            },
                                            {
                                                "example_id": "96e19dbb-af0f-4774-9827-c27299e198bb",
                                                "sense_id": "29ad0520-87e6-333f-ac79-1650088a0273",
                                                "text": "Quelques jours après avoir brillamment dominé le RC Strasbourg à domicile, le Paris Saint-Germain ouvrait les portes du Parc des Princes au PSV Eindhoven qui débarquait en France avec l’espoir de faire le plein de points après une défaite contre la Juventus et un match nul face au Sporting."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e003cbba-ebde-4e01-94dc-7886682405ab",
                        "source_entry_id": "560f2e77-d620-3274-89b8-1aa75174a0c4",
                        "source_sense_id": "5bce6948-6258-338c-8899-13145c08beee",
