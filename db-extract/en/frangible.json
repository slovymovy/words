                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "7e3116c2-5960-4f8c-a994-e832122b20fb",
                        "entry_id": "3aba2590-383a-37fa-a885-46f1f88ae3e3",
