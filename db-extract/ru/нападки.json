                    {
                        "translation_id": "5e29b5d3-6936-4a3f-a605-8f2a58baab45",
                        "source_entry_id": "14c8f979-0646-3fba-9989-a5d0e15c6713",
                        "source_sense_id": "691c45f1-08af-30be-83a3-3173d515e223",
