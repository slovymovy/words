                                    {
                                        "sense_id": "81ef5cb7-d4be-3ced-a03a-b1acf8bd425d",
                                        "entry_id": "406d6489-c245-3c88-a11d-12ea6017c6ec",
                                        "glosses": [
                                            "Qui mérite d’être préféré ; qui doit être préféré."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c2a5db9-f4a5-4b58-8b63-56a348c8037a",
                                                "sense_id": "81ef5cb7-d4be-3ced-a03a-b1acf8bd425d",
                                                "text": "Quand on emploie l’albumine comme moyen d’émulsionner, on a recours au blanc d’œuf, et plus souvent encore au jaune d’œuf ; ces corps sont même préférables à la gomme, quand il s'agit de diviser une huile épaisse et visqueuse comme celle des ricins ; […]."
                                            },
                                            {
                                                "example_id": "7ee04cc3-5e65-4162-8089-6d01dd03f5e6",
                                                "sense_id": "81ef5cb7-d4be-3ced-a03a-b1acf8bd425d",
                                                "text": "Peu de consommateurs savent que les choux d'York, pain de sucre et cœur de bœuf, sont préférables sous le rapport de la saveur a toutes les autres espèces, quand on les laisse pommer complétement."
                                            },
                                            {
                                                "example_id": "989f7e1e-5529-4112-af8a-5aacac2fb52e",
                                                "sense_id": "81ef5cb7-d4be-3ced-a03a-b1acf8bd425d",
                                                "text": "La reproduction par semis, même sous cloche, est très-difficile et très-lente à notre climat; la propagation par marcottes, et surtout par éclats, est de beaucoup préférable."
                                            },
                                            {
                                                "example_id": "06f4efe8-298c-4c4a-906a-936551e8c626",
                                                "sense_id": "81ef5cb7-d4be-3ced-a03a-b1acf8bd425d",
                                                "text": "Si misérable que soit l’abri dont on dispose, il est encore préférable à la bise glacée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
