        "fr-extract.jsonl": [
            {
                "entry_id": "f060b450-e40f-3a4e-a993-7b0920a91d2f",
                "word": "fureteur",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "dc47b705-bb11-49bc-af45-ec754049c7e4",
                        "entry_id": "f060b450-e40f-3a4e-a993-7b0920a91d2f",
                        "tags": [
                            "plural",
                            "masculine"
                        ],
                        "form": "fureteurs"
                    },
                    {
                        "form_id": "28440a34-930e-460d-b418-3cf5c409cf70",
                        "entry_id": "f060b450-e40f-3a4e-a993-7b0920a91d2f",
                        "tags": [
                            "singular",
                            "feminine"
                        ],
                        "form": "fureteuse"
                    },
                    {
                        "form_id": "8279a4d3-fc5f-4acb-975f-07810f9e2ab8",
                        "entry_id": "f060b450-e40f-3a4e-a993-7b0920a91d2f",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "fureteuses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1f6f1944-53b3-3a60-8a50-b3b467479e27",
                        "entry_id": "f060b450-e40f-3a4e-a993-7b0920a91d2f",
                        "glosses": [
                            "Qui aime à fureter, à fouiner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07b94a0a-ea40-49ad-b1d6-229b4ad29e30",
                                "sense_id": "1f6f1944-53b3-3a60-8a50-b3b467479e27",
                                "text": "Se méfiant des yeux fureteurs de Madame Marmet, elle glissa dans sa poche la lettre à Le Ménil, comptant sur le hasard des promenades pour la couler dans une boîte."
                            },
                            {
                                "example_id": "94f7b21e-5da9-4105-b578-12f5c6eb7c5a",
                                "sense_id": "1f6f1944-53b3-3a60-8a50-b3b467479e27",
                                "text": "Tout ce qui existe de documents, sa piété fureteuse, sa curiosité passionnée l’ont rassemblé."
                            },
                            {
                                "example_id": "7ac63bd3-4b17-4e1f-99fd-07f357d8af95",
                                "sense_id": "1f6f1944-53b3-3a60-8a50-b3b467479e27",
                                "text": "Il aimait les lieux éclairés, emplis d’airs sans importance, où des gens se promènent, nonchalants et fureteurs, parmi des femmes musquées et prêtes, aux toilettes un peu vives."
                            },
                            {
                                "example_id": "51bca7db-055e-4b4d-a414-48f051fced9f",
                                "sense_id": "1f6f1944-53b3-3a60-8a50-b3b467479e27",
                                "text": "Puis il revint à son lit, et d’un pied fureteur il chercha un recoin des draps encore frais."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "95df233e-001e-3a58-b3c9-95a2d50b2d3c",
                "word": "fureteur",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "120b1ba1-6204-4194-becd-48987d6ee511",
                        "entry_id": "95df233e-001e-3a58-b3c9-95a2d50b2d3c",
                        "tags": [
                            "plural"
                        ],
                        "form": "fureteurs"
                    },
                    {
                        "form_id": "5639cd1a-c626-451c-a882-41ab4c88b6ec",
                        "entry_id": "95df233e-001e-3a58-b3c9-95a2d50b2d3c",
                        "tags": [
                            "feminine"
                        ],
                        "form": "fureteuse"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5f65a327-fe00-34cd-8e98-e0b80801b3ac",
                        "entry_id": "95df233e-001e-3a58-b3c9-95a2d50b2d3c",
                        "glosses": [
                            "Celui qui fouille, qui cherche partout."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7aa3a425-7d11-416c-b6bd-97a10aea04c3",
                                "sense_id": "5f65a327-fe00-34cd-8e98-e0b80801b3ac",
                                "text": "Quel ennuyeux fureteur !"
                            }
                        ]
                    },
                    {
                        "sense_id": "517bfdf0-f9e9-3da8-92f1-b1c7aaba94a9",
                        "entry_id": "95df233e-001e-3a58-b3c9-95a2d50b2d3c",
                        "glosses": [
                            "Celui qui est en quête de curiosités, de bibelots, d’estampes anciennes et tout particulièrement de celui, de celle qui fouille dans les vieux papiers, archives, journaux, documents inédits à la recherche de détails inconnus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34b64f1c-f6a2-46c4-9833-1d82dc22949c",
                                "sense_id": "517bfdf0-f9e9-3da8-92f1-b1c7aaba94a9",
                                "text": "La curiosité, le flair, les trouvailles d’un fureteur."
                            }
                        ]
                    },
                    {
                        "sense_id": "66c137e1-dfc7-3b04-ab60-28ff973afc1c",
                        "entry_id": "95df233e-001e-3a58-b3c9-95a2d50b2d3c",
                        "glosses": [
                            "Celui qui s’enquiert de tout, qui cherche à tout savoir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5563d1f3-2b97-4d4a-9c67-0b21176f1d22",
                                "sense_id": "66c137e1-dfc7-3b04-ab60-28ff973afc1c",
                                "text": "Cachez-vous de lui, c’est un fureteur."
                            },
                            {
                                "example_id": "47e37a2f-1164-4f18-8647-92759c92e6d0",
                                "sense_id": "66c137e1-dfc7-3b04-ab60-28ff973afc1c",
                                "text": "Quel indiscret fureteur !"
                            }
                        ]
                    },
                    {
                        "sense_id": "b86ca89e-4685-3e11-ad17-ac3de085e2f7",
                        "entry_id": "95df233e-001e-3a58-b3c9-95a2d50b2d3c",
                        "glosses": [
                            "Chasseur qui chasse avec un furet."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "0465a832-105b-338e-9117-bf9499df0797",
                        "entry_id": "95df233e-001e-3a58-b3c9-95a2d50b2d3c",
                        "glosses": [
                            "Celui qui, dans un espace d’échanges du Web tel qu’un forum ou un blogue, suit les discussions ou consulte les articles sans apporter de contribution."
                        ],
                        "tags": [
                            "Internet"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c07afe64-4514-4acb-a809-d12f4a2add07",
                        "source_entry_id": "95df233e-001e-3a58-b3c9-95a2d50b2d3c",
                        "source_sense_id": "66c137e1-dfc7-3b04-ab60-28ff973afc1c",
                        "target_lang_word": "fuçador",
                        "target_lang_code": "pt",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "a8e0cd0b-5e18-4c1a-a093-1f6317ef89aa",
                        "source_entry_id": "95df233e-001e-3a58-b3c9-95a2d50b2d3c",
                        "source_sense_id": "0465a832-105b-338e-9117-bf9499df0797",
                        "target_lang_word": "lurker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lurker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "27e7f041-11bf-3a68-b20b-1287b7502d90",
                                        "entry_id": "a76ccb67-ab27-3462-8fe2-91050d1450a9",
                                        "glosses": [
                                            "One who lurks."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69eecb0e-0475-44fb-a1de-a2a5e69c84e9",
                                                "sense_id": "27e7f041-11bf-3a68-b20b-1287b7502d90",
                                                "text": "It troubled me that there should have been a lurker on the stairs, on that night of all nights in the year, and I asked the watchman, on the chance of eliciting some hopeful explanation as I handed him a dram at the door, whether he had admitted at his gate any gentleman who had perceptibly been dining out?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22181fab-d876-3127-b6b1-a241207b2115",
                                        "entry_id": "a76ccb67-ab27-3462-8fe2-91050d1450a9",
                                        "glosses": [
                                            "A user who observes a community rather than participating; someone who reads or takes advantage of content on a website, newsgroup, etc. but does not contribute."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78b4b4f4-5fef-4969-92f4-4f2ee83f437b",
                                                "sense_id": "22181fab-d876-3127-b6b1-a241207b2115",
                                                "text": "However, less than half of lurkers went online that often. Those who post also are more likely than lurkers to use the Internet for both work and pleasure. Posters use the Internet to communicate more with others than lurkers do."
                                            },
                                            {
                                                "example_id": "f15842dd-dd45-498c-99e2-bfc5a6316276",
                                                "sense_id": "22181fab-d876-3127-b6b1-a241207b2115",
                                                "text": "It’s not unusual for people to join video calls with their camera off and microphone muted, but such lurkers can at least be called upon to speak."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bbe43063-3c7e-3d60-8040-affd474277dd",
                                        "entry_id": "a76ccb67-ab27-3462-8fe2-91050d1450a9",
                                        "glosses": [
                                            "A small fishing-boat."
                                        ],
                                        "tags": [
                                            "UK",
                                            "archaic",
                                            "dialectal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3d3e874e-e0c1-38bd-9512-267fe4fb5fcd",
                                        "entry_id": "a76ccb67-ab27-3462-8fe2-91050d1450a9",
                                        "glosses": [
                                            "An impostor; a quack."
                                        ],
                                        "tags": [
                                            "UK",
                                            "obsolete",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9908e1b2-b314-479f-a4a6-c6b866d4b575",
                                                "sense_id": "3d3e874e-e0c1-38bd-9512-267fe4fb5fcd",
                                                "text": "In every large town sham official documents, with crests, seals, and signatures, can be got for half-a-crown. Armed with these, the patterer becomes a ‘lurker,’—that is, an impostor; his papers certify any and every ‘ill that flesh is heir to.’"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3fdcebb7-56fa-4600-b9f3-8559b8f9b4c4",
                        "source_entry_id": "95df233e-001e-3a58-b3c9-95a2d50b2d3c",
