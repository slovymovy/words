                                        "sense_id": "0fe2ff55-333f-3f8a-825e-78eaf6f4193e",
                                        "entry_id": "3a46cc06-ad54-3906-a37b-52ff392360fd",
                                        "glosses": [
                                            "höckerloses Kamel aus der Familie der Lamas, das in Südamerika beheimatet ist und als Haustier gehalten wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0942b323-173f-4504-90dc-fd5d96c987fa",
                                                "sense_id": "0fe2ff55-333f-3f8a-825e-78eaf6f4193e",
                                                "text": "Auf dem Weg nach San Pedro fuhren wir an mehreren Alpakas vorbei."
                                            },
                                            {
                                                "example_id": "684c340d-1c5b-49fb-b713-4dc5dcdf2e94",
                                                "sense_id": "0fe2ff55-333f-3f8a-825e-78eaf6f4193e",
                                                "text": "„Alle Tücher wurden extra zu diesem Anlass aus feinster Baumwolle oder der Wolle von Alpakas oder Vikunjas hergestellt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3dee48aa-8af7-3905-98af-a5d284aa8b57",
                                        "entry_id": "3a46cc06-ad54-3906-a37b-52ff392360fd",
                                        "glosses": [
                                            "Wolle des Alpakas"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f997e1f-60b6-4250-9d3c-ce49b55fa018",
                                                "sense_id": "3dee48aa-8af7-3905-98af-a5d284aa8b57",
                                                "text": "Der Poncho besteht aus Alpaka."
                                            },
                                            {
                                                "example_id": "3c48dbf1-e05d-4857-8e9f-80b3815c8e92",
                                                "sense_id": "3dee48aa-8af7-3905-98af-a5d284aa8b57",
                                                "text": "„Die Wolle war eine Mischung aus Alpaka und Seide, glatt und weich, wie Daunen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
