                        "glosses": [
                            "Spécialiste de la théorie des ensembles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03daf13d-b30d-4968-becb-3efd5ed1d133",
                                "sense_id": "14586686-84a6-386a-b620-2b10c4a9c3de",
                                "text": "Un petit ensembliste fit observer qu’à ce compte-là, nous pouvions aussi bien déclarer la guerre aux trois quarts du ghetto, et même à la Chine entière."
                            },
                            {
                                "example_id": "8c97957c-4ad5-4c47-9b35-b250c0c791b7",
                                "sense_id": "14586686-84a6-386a-b620-2b10c4a9c3de",
                                "text": "Là encore, contre un empirisme naïf de la continuité, un ensembliste peut affirmer qu’il y a autant de points dans une droite d’un centimètre que dans une droite de deux centimètres."
                            }
                        ]
                    }
