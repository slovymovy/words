                                        "entry_id": "7ad1c3f6-b70c-312e-97dd-61cbc68cf10f",
                                        "glosses": [
                                            "osoba, która akcentuje swoją oryginalność i niezależność wobec głównego nurtu kultury masowej, odrzuca większość ról i aktywności społecznych, a jednocześnie snobuje się na rzeczy modne"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "313a6145-568a-490b-a82a-23ee519902b7",
                                                "sense_id": "70636c6a-36cb-3d9c-a4d6-2a1112cf0ec9",
                                                "text": "Adam nie jest tajemniczy, to zwykły hipster, niby zawsze w super dżinsach i wyperfumowany, ale jakbyś poskrobał, to wyjdzie wiocha."
                                            }
