                    },
                    {
                        "translation_id": "c30ececc-024d-44c7-a763-0a76fcf12fb1",
                        "source_entry_id": "e4e648a2-44d6-34de-847a-d7704abd3e9c",
                        "source_sense_description": "in photography",
                        "target_lang_word": "überbelichten",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "überbelichten",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "386ce922-53fa-321d-bd17-87c58ef96f3d",
                                        "entry_id": "cb607db0-ff61-31ce-9054-501f2de0d120",
                                        "glosses": [
                                            "bei der Erstellung eines Fotos zu viel Licht auf des lichtempfindliche Fotomaterial lassen (so dass eine sehr helle Aufnahme entsteht)"
                                        ],
                                        "tags": [
                                            "Fotografie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2fa7404c-c038-4e28-8748-bff92496f60b",
                                                "sense_id": "386ce922-53fa-321d-bd17-87c58ef96f3d",
                                                "text": "„Damit der Hintergrund vollständig weiß wird, muss er überbelichtet werden.“"
                                            },
                                            {
                                                "example_id": "808d3d9e-a921-4250-b826-9774d8773a4c",
                                                "sense_id": "386ce922-53fa-321d-bd17-87c58ef96f3d",
                                                "text": "„Dazu versuchte ich, die Fotos einfach zu überbelichten.“"
                                            },
                                            {
                                                "example_id": "a8c9f7a2-14db-4d03-b4e8-21b6a5c98f75",
                                                "sense_id": "386ce922-53fa-321d-bd17-87c58ef96f3d",
                                                "text": "„Verändere nun die Belichtungszeit um etwa zwei Werte hin zu einer längeren Belichtung, um die Aufnahme zu überbelichten.“"
                                            },
                                            {
                                                "example_id": "dae84b05-3852-4ae5-847b-3ffc169cd7fc",
                                                "sense_id": "386ce922-53fa-321d-bd17-87c58ef96f3d",
                                                "text": "„Habe ich bereits eine korrekte Belichtung kann ich kein zusätzliches Licht setzen ohne das Bild zu überbelichten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "überbelichten",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7e7a8a63-8616-38d3-92aa-34d2d91360ef",
                                        "entry_id": "bec41c04-0476-3472-9f4f-101436539b9e",
                                        "glosses": [
                                            "bei der Erstellung eines Fotos zu viel Licht auf des lichtempfindliche Fotomaterial lassen (so dass eine sehr helle Aufnahme entsteht)"
                                        ],
                                        "tags": [
                                            "Fotografie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "256cb8bb-ff6b-4c34-875a-529281c578cb",
                                                "sense_id": "7e7a8a63-8616-38d3-92aa-34d2d91360ef",
                                                "text": "„Wir brauchen jetzt mit einem Male nicht mehr 3- bis 4fach überzubelichten, sondern können knapp und sogar unterbelichten, ohne einen Verlust an Details in den Schatten befürchten zu müssen.“"
                                            },
                                            {
                                                "example_id": "77b12b09-cd5e-4a11-a0d4-4b6b24ca57b1",
                                                "sense_id": "7e7a8a63-8616-38d3-92aa-34d2d91360ef",
                                                "text": "„Belichtet man einen Diafilm über, so ‚frißt‘ er in den Lichtern aus.“"
                                            },
                                            {
                                                "example_id": "d4aa8ca2-0904-4a25-9953-e3c73560b080",
                                                "sense_id": "7e7a8a63-8616-38d3-92aa-34d2d91360ef",
                                                "text": "„Die Belichtungskorrektur macht es möglich, Belichtungszeiten beliebig zu verstellen, um Aufnahmen unterzubelichten (− = dunkler) oder überzubelichten (+ = heller).“"
                                            },
                                            {
                                                "example_id": "76a6eaa0-d7a0-414e-84f2-6002b7144f04",
                                                "sense_id": "7e7a8a63-8616-38d3-92aa-34d2d91360ef",
                                                "text": "„Je weiter du es nach rechts drehst, desto mehr belichtest du das Bild über!“"
                                            },
                                            {
                                                "example_id": "de91eca9-104f-4f4c-9a32-8116505df768",
                                                "sense_id": "7e7a8a63-8616-38d3-92aa-34d2d91360ef",
                                                "text": "„Neben der Auswahl einer anderen Messmethode können Sie die Belichtung auch manuell korrigieren, um das Foto gezielt unter- oder überzubelichten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
