                    },
                    {
                        "form_id": "07986798-46c4-4c3c-815f-f57624c7e955",
                        "entry_id": "57195a18-688d-3d3e-aa1f-2536c5424f76",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Zusatzartikel"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5771688c-88e5-3c00-a5b6-65ed4370fe91",
                        "entry_id": "57195a18-688d-3d3e-aa1f-2536c5424f76",
                        "glosses": [
                            "nach einer vom Kongress und den Bundesstaaten beschlossenen Verfassungsänderung zusätzlich zur bestehenden Verfassung der Vereinigten Staaten hinzugefügter Artikel"
                        ],
                        "tags": [
                            "in den USA"
                        ],
                        "examples": [
                            {
                                "example_id": "b467c203-ab06-4d95-8c33-f3ed6a888157",
                                "sense_id": "5771688c-88e5-3c00-a5b6-65ed4370fe91",
                                "text": "„Der zweite Zusatzartikel der Verfassung aus dem 18. Jahrhundert beschert den US-Amerikanern nach wie vor eines der liberalsten Waffengesetze der Welt.“"
                            },
                            {
                                "example_id": "b1669db8-a4fe-4401-bf76-3c3d7795a1a4",
                                "sense_id": "5771688c-88e5-3c00-a5b6-65ed4370fe91",
                                "text": "„Das 20. Jahrhundert brachte für Frauen erheblich verbesserte Bildungsmöglichkeiten; außerdem wurde im Jahr 1920 durch einen Zusatzartikel zur Verfassung endlich in allen Bundesstaaten das Frauenwahlrecht eingeführt.“"
                            },
                            {
                                "example_id": "3f2db328-52d3-4ea6-8ac1-0886eec151d0",
                                "sense_id": "5771688c-88e5-3c00-a5b6-65ed4370fe91",
                                "text": "„Aus diesen Zusatzartikeln sollte schließlich die Bill of Rights hervorgehen, die die Grundrechte der Bürgerinnen und Bürger gegenüber der Regierung ins Zentrum der politischen Identität Amerikas rückte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "495929ae-a700-4823-bd97-5a3c04f73360",
