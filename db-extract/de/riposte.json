                "translations": [
                    {
                        "translation_id": "7cf3abec-3078-427a-8a55-42b16bde0276",
                        "source_entry_id": "31c554df-2ef0-38aa-8de3-e3a57900e741",
                        "source_sense_id": "10a1b689-c28c-3beb-872e-83618050b576",
                        "source_sense_description": "Fechten, Kampfsport: auf eine Parade folgender Gegenangriff",
                        "target_lang_word": "riposte",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "riposte",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7848e3cb-34fb-3daf-8543-4cebbfffbd8d",
                                        "entry_id": "f2527259-f936-384c-a948-159921f37060",
                                        "glosses": [
                                            "A thrust given in return after parrying an attack."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "22c8f44b-05d2-36e8-9754-d554a7af083a",
                                        "entry_id": "f2527259-f936-384c-a948-159921f37060",
                                        "glosses": [
                                            "A counter-attack in any combat or any sport."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c017e21-2339-4ee7-bf79-25521b25b060",
                                                "sense_id": "22c8f44b-05d2-36e8-9754-d554a7af083a",
                                                "text": "Some context is required. Moldova were weak at the back and blunt up front, and have failed to score in six matches stretching back to last October, with only hints at English complacency offering them glimpses of summoning a riposte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39ef7dbf-7214-37f2-b623-ca8affcf2c6b",
                                        "entry_id": "f2527259-f936-384c-a948-159921f37060",
                                        "glosses": [
                                            "A quick and usually witty response to a taunt."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "308cfb6e-80c4-4ca0-a830-edb1c6e9f1a8",
                                                "sense_id": "39ef7dbf-7214-37f2-b623-ca8affcf2c6b",
                                                "text": "This face-saving reminds us of some American ripostes a few months back when their space rockets seemed disinclined to leave the earth very far behind; after all, they said, the Russians are only chucking heavy machinery at the moon, whereas we're trying to be more sophisticated and get a sewing-machine up there."
                                            },
                                            {
                                                "example_id": "129bd7c3-c2a5-4788-98f0-f59d0fd319aa",
                                                "sense_id": "39ef7dbf-7214-37f2-b623-ca8affcf2c6b",
                                                "text": "Watson’s letter was a riposte to the accusation made on Tuesday by Corbyn’s campaign that he was “peddling conspiracy theories” after he said in a Guardian interview that Labour was at risk from “Trotskyist entryists”."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d846328b-4e1e-3b41-be42-1c29f489e973",
                                        "entry_id": "f2527259-f936-384c-a948-159921f37060",
                                        "glosses": [
                                            "An answer or reply, rapidly uttered, in response to a question or problem."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "riposte",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "732b0c57-78da-3f73-8be1-06d67e7b0ba4",
                                        "entry_id": "a2009775-298e-3359-9044-9d806c40c659",
                                        "glosses": [
                                            "To attempt to hit an opponent after parrying an attack."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "10dc0b7b-a8db-3047-8789-99e4ef6cf7a6",
                                        "entry_id": "a2009775-298e-3359-9044-9d806c40c659",
                                        "glosses": [
                                            "To respond quickly; particularly if the response is humorous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b03d502f-6bc4-4da3-ba6d-f522a0c0854d",
                                                "sense_id": "10dc0b7b-a8db-3047-8789-99e4ef6cf7a6",
                                                "text": "I left him and went to a tavern by the quays where the college bucks were drinking and singing hymns. There was Giles who invited old men back to his college apartments for games. Members of the rowing club riposted, for God's sake, man, clean up your life."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e4b4be08-f8a4-4b9f-a88d-7fc9547595e2",
                        "source_entry_id": "31c554df-2ef0-38aa-8de3-e3a57900e741",
                        "source_sense_id": "10a1b689-c28c-3beb-872e-83618050b576",
                        "source_sense_description": "Fechten, Kampfsport: auf eine Parade folgender Gegenangriff",
                        "target_lang_word": "riposte",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "riposte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cb3fcc4b-2417-3e76-9713-392fb4b67208",
                                        "entry_id": "90856f7c-5b32-3d5c-852c-3a140dd3fd75",
                                        "glosses": [
                                            "Réponse vive faite sur-le-champ, repartie prompte à quelque raillerie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "271b965f-dd8b-4957-858d-b5aa2cb61927",
                                                "sense_id": "cb3fcc4b-2417-3e76-9713-392fb4b67208",
                                                "text": "Avoir la riposte prête, la riposte en main."
                                            },
                                            {
                                                "example_id": "d8d5abaf-9d45-4378-b299-418f75278f8c",
                                                "sense_id": "cb3fcc4b-2417-3e76-9713-392fb4b67208",
                                                "text": "Être prompt, être vif à la riposte."
                                            },
                                            {
                                                "example_id": "676b5cf5-aa32-4fb8-a0ea-26884d1c6d49",
                                                "sense_id": "cb3fcc4b-2417-3e76-9713-392fb4b67208",
                                                "text": "Gare à la riposte!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9cd3ba2-2fd2-3f00-81ff-e2351ce68a05",
                                        "entry_id": "90856f7c-5b32-3d5c-852c-3a140dd3fd75",
                                        "glosses": [
                                            "Ce qui se fait sur-le-champ en réponse à une injure, à un coup, à un acte quelconque."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2fa5d12f-5505-4f16-ab13-be88d1fbca91",
                                                "sense_id": "f9cd3ba2-2fd2-3f00-81ff-e2351ce68a05",
                                                "text": "Il lui donna un démenti ; la riposte fut un soufflet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "414ac599-cf2c-337b-8e2b-3ca72d02cb92",
                                        "entry_id": "90856f7c-5b32-3d5c-852c-3a140dd3fd75",
                                        "glosses": [
                                            "Action de défense par l'attaque."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "914eeedb-636a-4b82-990b-3c21b6e6d47e",
                                                "sense_id": "414ac599-cf2c-337b-8e2b-3ca72d02cb92",
                                                "text": "Mais tous les membres de la coalition des forces antihitlériennes du pays étaient d’accord à ce qu’une ferme riposte soit donnée à tout essai des troupes allemandes d’empêcher la Roumanie de sortir de la guerre hitlérienne."
                                            },
                                            {
                                                "example_id": "b7a2917e-8813-4a24-88ca-0a25de55b6a9",
                                                "sense_id": "414ac599-cf2c-337b-8e2b-3ca72d02cb92",
                                                "text": "Mais, ajoutent-ils, elle ne suffit plus pour assurer aux progressistes les instruments d'une riposte efficace à la reféodalisation du capitalisme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd16bb6b-39de-3d06-9e06-79cd49343777",
                                        "entry_id": "90856f7c-5b32-3d5c-852c-3a140dd3fd75",
                                        "glosses": [
                                            "Botte que l’on porte après avoir paré."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
