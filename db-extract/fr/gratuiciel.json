                    {
                        "sense_id": "1a25e6b6-882f-31cb-9582-8217bd7ad64f",
                        "entry_id": "e7fd3f9b-58b0-38cb-bd74-761838502878",
                        "glosses": [
                            "Logiciel propriétaire distribué gratuitement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a58fad7-f202-4b8c-a085-b2a25f5c28f9",
                                "sense_id": "1a25e6b6-882f-31cb-9582-8217bd7ad64f",
                                "text": "Bien que distribués gratuitement, les gratuiciels sont principalement des logiciels propriétaires qui utilisent des licences de distribution restrictives. Certains logiciels restreignent même votre capacité à les redistribuer."
                            },
                            {
                                "example_id": "21aad4d6-57ff-4777-8298-c93c3e94adca",
                                "sense_id": "1a25e6b6-882f-31cb-9582-8217bd7ad64f",
                                "text": "Sorenson Spark est utilisable sur toutes sortes de plates-formes, en particulier les appareils mobiles. Il est utilisé par beaucoup de logiciels d'encodage – en particulier des gratuiciels."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "89a5abbe-7167-4d51-b0ee-b7c004360f77",
