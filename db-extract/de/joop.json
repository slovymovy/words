                "senses": [
                    {
                        "sense_id": "5cbc7e4f-bfc0-3a1f-b14e-10029965f806",
                        "entry_id": "ae857988-1f82-3946-a8a0-84b161cccf7e",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57de70c5-db4b-4f12-9e88-d4655862da68",
                                "sense_id": "5cbc7e4f-bfc0-3a1f-b14e-10029965f806",
                                "text": "Frau Joop ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "7d91c595-32fb-4eb1-8696-b6af46a77c41",
                                "sense_id": "5cbc7e4f-bfc0-3a1f-b14e-10029965f806",
                                "text": "Herr Joop wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "5b070ee9-9176-420b-927e-7694ea643b1d",
                                "sense_id": "5cbc7e4f-bfc0-3a1f-b14e-10029965f806",
                                "text": "Die Joops fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "fa09eaf7-17eb-43b9-aeee-6b5b29ecfb4a",
                                "sense_id": "5cbc7e4f-bfc0-3a1f-b14e-10029965f806",
                                "text": "Der Joop trägt nie die Schals, die die Joop ihm strickt."
                            },
                            {
                                "example_id": "ee801ae3-0d42-4a65-8726-2ce69cf815af",
                                "sense_id": "5cbc7e4f-bfc0-3a1f-b14e-10029965f806",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Joop kommt, geht der Herr Joop.“"
                            },
                            {
                                "example_id": "11676346-facb-4bc8-9eb5-4c6540a9d0b6",
                                "sense_id": "5cbc7e4f-bfc0-3a1f-b14e-10029965f806",
                                "text": "Joop kommt und geht."
                            },
                            {
                                "example_id": "e58b0634-8909-48cd-992c-f42c0072b578",
                                "sense_id": "5cbc7e4f-bfc0-3a1f-b14e-10029965f806",
                                "text": "Joops kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
