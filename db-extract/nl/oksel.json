                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Achselhöhle",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e77756bd-b9c8-380c-b97d-fb8f16a14f42",
                                        "entry_id": "03667a08-73e0-3bd4-9c28-0931dbc3ed6f",
                                        "glosses": [
                                            "die Grube unter dem Schultergelenk"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1bab2d48-a0b5-4c5b-b48a-44b80dbbdb42",
                                                "sense_id": "e77756bd-b9c8-380c-b97d-fb8f16a14f42",
                                                "text": "„In der Achselhöhle wird häufig die Körpertemperatur mit einem Fieberthermometer gemessen (axillare Temperaturmessung).“"
                                            },
                                            {
                                                "example_id": "0c39150a-c9c1-4469-a22f-5394053b20b8",
                                                "sense_id": "e77756bd-b9c8-380c-b97d-fb8f16a14f42",
                                                "text": "„Er legt ihr seine Hände in die Achselhöhlen und läßt sie abwärts zu den Hüften gleiten.“"
                                            },
                                            {
                                                "example_id": "107351b9-ccfa-41d7-bacc-7e6049b70544",
                                                "sense_id": "e77756bd-b9c8-380c-b97d-fb8f16a14f42",
                                                "text": "„Bobby blieb stecken und Joe musste ihn unter den Achselhöhlen fassen, herausziehen und huckepack nehmen.“"
                                            },
                                            {
                                                "example_id": "20c43ea6-ed7a-4678-badd-c269b40dc54e",
                                                "sense_id": "e77756bd-b9c8-380c-b97d-fb8f16a14f42",
                                                "text": "„Verstohlen schnüffelte Stefan an seinen Achselhöhlen, um sich zu vergewissern, dass da kein muffiger Geruch durch das Deodorant drang.“"
                                            },
                                            {
                                                "example_id": "8cdb16d6-5ecc-47be-a9e8-ed9f4d438a24",
                                                "sense_id": "e77756bd-b9c8-380c-b97d-fb8f16a14f42",
                                                "text": "„Vermutlich werden Dämonen ihre Zigarren in meinen Achselhöhlen ausdrücken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6e8e1ca8-e175-4189-a62d-4358512d734f",
                        "source_entry_id": "a21ffbd0-8ada-3d42-865a-283a014a81a2",
                        "source_sense_id": "39f89ca4-fbcb-3122-bad6-10d0f5efcf82",
