                    ],
                    "common_phrases": [
                        "przejść mimo"
                    ],
                    "target_lang_definitions": {
                        "ru": "предлог, обозначающий движение около кого-либо или чего-либо, минуя этот объект"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мимо",
                                "target_lang_sense_clarification": "минуя кого-либо или что-либо"
                            }
