                "senses": [
                    {
                        "sense_id": "6e518a9e-570e-318c-a551-e58beaa59703",
                        "entry_id": "69944850-3697-3048-b7fd-d99fcbf704ab",
                        "glosses": [
                            "interdyscyplinarna dziedzina nauki zajmująca się tworzeniem i zastosowaniem materiałów oraz urządzeń w skali nanometrycznej (1–100 nm) czyli na poziomie pojedynczych atomów i cząsteczek"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "400aa301-9d51-44f5-b398-e80109e36863",
                        "source_entry_id": "69944850-3697-3048-b7fd-d99fcbf704ab",
                        "source_sense_id": "6e518a9e-570e-318c-a551-e58beaa59703",
                        "target_lang_word": "nanotechnology",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nanotechnology",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "df6124fc-9964-354d-a973-f0e310b223c7",
                                        "entry_id": "b0728e70-ab0d-3ed2-907a-5e75148ced59",
                                        "glosses": [
                                            "The science and technology of creating nanoparticles and of manufacturing machines which have sizes within the range of nanometres (1–100 nm)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5145a55a-25b6-4a55-839d-1d3e9f8dcc12",
                                                "sense_id": "df6124fc-9964-354d-a973-f0e310b223c7",
                                                "text": "The first such review would also include a study of whether it is feasible to create nanoscale devices that can assemble themselves or copies of themselves molecule by molecule -- a subject of fierce debate among nanotechnology experts."
                                            },
                                            {
                                                "example_id": "d6da9c81-d48d-4314-8723-78783cc2c43e",
                                                "sense_id": "df6124fc-9964-354d-a973-f0e310b223c7",
                                                "text": "Nanotechnology, the science of creating functional systems on the scale of molecules or smaller, could enable engineers to combine the functions of memory chips and disk drives on a device the size of a dime."
                                            },
                                            {
                                                "example_id": "c655a234-8cd5-4d59-998b-2ef9550f70c2",
                                                "sense_id": "df6124fc-9964-354d-a973-f0e310b223c7",
                                                "text": "Development of applied nanotechnologies is being pursued by at least 15 research-oriented private companies and 69 manufacturers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "52456e7a-0520-42be-84d1-433a29bbd4eb",
                        "source_entry_id": "69944850-3697-3048-b7fd-d99fcbf704ab",
                        "source_sense_id": "6e518a9e-570e-318c-a551-e58beaa59703",
                        "target_lang_word": "nanotechnologie",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "82a89eea-7bc1-4e44-9b1b-b847daec5e13",
                        "source_entry_id": "69944850-3697-3048-b7fd-d99fcbf704ab",
                        "source_sense_id": "6e518a9e-570e-318c-a551-e58beaa59703",
                        "target_lang_word": "nanotechnologie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nanotechnologie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "86ef8a67-80b4-37ed-9817-1d3c4e7fb26c",
                                        "entry_id": "d58c2069-2f8b-3ffe-b4b3-89d03ae782da",
                                        "glosses": [
                                            "Technologie à l’échelle du nanomètre et en pleine expansion grâce à l’informatique."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35e25e83-18a9-4524-968b-5cc168f66ed5",
                                                "sense_id": "86ef8a67-80b4-37ed-9817-1d3c4e7fb26c",
                                                "text": "Les nanotechnologies étudient et manipulent la matière et le vivant à l’échelle atomique."
                                            },
                                            {
                                                "example_id": "07f29d56-3c76-4ee8-a0a8-d1cf1ab5635d",
                                                "sense_id": "86ef8a67-80b4-37ed-9817-1d3c4e7fb26c",
                                                "text": "Avant de nous plonger dans le cœur du sujet, soulignons qu’il faudra attendre 1974 pour que le terme « nanotechnologie » soit prononcé pour la première fois lors d’une conférence."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bb739cab-b0ca-4732-a18f-c9f03478940e",
