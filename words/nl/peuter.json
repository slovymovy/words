                    "sense_id": "110fe80f-86d5-3cbc-8e6b-dd784fad0a4d",
                    "sense_definition": "Jong kind, meestal in de leeftijd van twee tot vier jaar, dat nog niet naar de basisschool gaat.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "child_stages",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>peuter</w> speelde vrolijk met zijn blokken op de grond.",
                            "target_lang_translations": {
                                "en": "The <w>toddler</w> played happily with his blocks on the floor.",
                                "ru": "<w>Малыш</w> весело играл с кубиками на полу.",
                                "pl": "<w>Maluch</w> bawił się wesoło swoimi klockami na podłodze.",
                                "de": "Das <w>Kleinkind</w> spielte fröhlich mit seinen Bauklötzen auf dem Boden.",
                                "fr": "Le <w>tout-petit</w> jouait joyeusement avec ses cubes sur le sol.",
                                "it": "Il <w>bambino</w> giocava felicemente con i suoi blocchi sul pavimento.",
                                "cs": "<w>Batole</w> si vesele hrálo s kostkami na zemi.",
                                "tr": "<w>Yumurcak</w> yerde bloklarıyla neşeyle oynuyordu.",
                                "es": "El <w>niño pequeño</w> jugaba alegremente con sus bloques en el suelo."
                            }
                        },
                        {
                            "text": "Mijn zusje is nog een <w>peuter</w> en gaat volgend jaar pas naar school.",
                            "target_lang_translations": {
                                "en": "My little sister is still a <w>toddler</w> and won't go to school until next year.",
                                "ru": "Моя сестренка еще <w>малышка</w> и пойдет в школу только в следующем году.",
                                "pl": "Moja siostrzyczka to jeszcze <w>brzdąc</w> i pójdzie do szkoły dopiero w przyszłym roku.",
                                "de": "Meine kleine Schwester ist noch ein <w>Kleinkind</w> und kommt erst nächstes Jahr in die Schule.",
                                "fr": "Ma petite sœur est encore un <w>bambin</w> et n'ira à l'école que l'année prochaine.",
                                "it": "Mia sorella minore è ancora una <w>bambina piccola</w> e andrà a scuola solo l'anno prossimo.",
                                "cs": "Moje sestřička je ještě <w>batole</w> a do školy půjde až příští rok.",
                                "tr": "Kız kardeşim henüz çok <w>küçük</w> ve okula ancak gelecek yıl başlayacak.",
                                "es": "Mi hermana menor es todavía una <w>infante</w> y no irá a la escuela hasta el año que viene."
                            }
                        }
