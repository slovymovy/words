                        "cross_references": [
                            {
                                "target_word": "appetite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0b2f9625-1eeb-3264-be14-f29e543ccd31",
                                        "entry_id": "73d75e24-78e7-3c66-aaaf-0fa215845d58",
                                        "glosses": [
                                            "Desire to eat food or consume drink."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "713dae7c-6ca6-4c37-9939-7b685d1de061",
                                                "sense_id": "0b2f9625-1eeb-3264-be14-f29e543ccd31",
                                                "text": "The most rapid and most seductive transition in all human nature is that which attends the palliation of a ravenous appetite. There is something humiliating about it."
                                            },
                                            {
                                                "example_id": "53dc3eed-4fa1-40ca-a947-fce372f04cd0",
                                                "sense_id": "0b2f9625-1eeb-3264-be14-f29e543ccd31",
                                                "text": "And I return with an excellent appetite. There can be no question, my dear Watson, of the value of exercise before breakfast."
                                            },
                                            {
                                                "example_id": "6aaee191-cee1-4d07-9daf-6a51bceb3ede",
                                                "sense_id": "0b2f9625-1eeb-3264-be14-f29e543ccd31",
                                                "text": "Though the breweries were forced to shut down, the dry spell did little more than whet the public's appetite for beer: Records show that within the first 24 hours after Congress lifted the ban Prohibition] in 1933, Americans guzzled 1 million barrels of the stuff."
                                            },
                                            {
                                                "example_id": "b0b49a88-cf7b-4c81-a9dc-8261e076e043",
                                                "sense_id": "0b2f9625-1eeb-3264-be14-f29e543ccd31",
                                                "text": "Biotics possess extraordinary abilities, but they must live with minor inconveniences. The most obvious issue is getting adequate nutrition. Creating biotic mass effects takes such a toll on metabolism that active biotics develop ravenous appetites. The standard Alliance combat ration for a soldier is 3000 calories per day; biotics are given 4500, as well as a canteen of potent energy drink for quick refreshment after hard combat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24217a58-2a8c-37d8-bb4f-c4dc4d5e80ad",
                                        "entry_id": "73d75e24-78e7-3c66-aaaf-0fa215845d58",
                                        "glosses": [
                                            "Any strong desire; an eagerness or longing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "743721bb-3c02-4c18-91aa-c53af1104956",
                                                "sense_id": "24217a58-2a8c-37d8-bb4f-c4dc4d5e80ad",
                                                "text": "If God had given to eagles an appetite to swim."
                                            },
                                            {
                                                "example_id": "faec1c13-99b8-443a-b590-06f16054473f",
                                                "sense_id": "24217a58-2a8c-37d8-bb4f-c4dc4d5e80ad",
                                                "text": "To gratify the vulgar appetite for the marvellous."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9c34691-b493-3e1b-bb0a-c14e67ed6e6d",
                                        "entry_id": "73d75e24-78e7-3c66-aaaf-0fa215845d58",
                                        "glosses": [
                                            "The desire for some personal gratification, either of the body or of the mind."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "269f6782-9895-4b57-a11c-e47a8f4c24f6",
                                                "sense_id": "e9c34691-b493-3e1b-bb0a-c14e67ed6e6d",
                                                "text": "appetite for reading"
                                            },
                                            {
                                                "example_id": "f66513a5-697e-489f-a008-e25bbd0f5ea6",
                                                "sense_id": "e9c34691-b493-3e1b-bb0a-c14e67ed6e6d",
                                                "text": "The object of appetite is whatsoever sensible good may be wished for; the object of will is that good which reason does lead us to seek."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "63b6521b-4ab3-4e3e-b7ac-e1b97939be95",
                        "source_entry_id": "afc75cd8-a3e2-31d1-8a99-2493d36b0ca8",
                        "source_sense_id": "4fb7df22-22ef-3444-8027-b4e303b840e6",
                        "source_sense_description": "eetlust",
                        "target_lang_word": "appétit",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "appétit",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4b58b1cf-817b-3dcd-afda-e6cad28aa859",
                                        "entry_id": "59c27269-b326-380c-a713-05b8892cb9ce",
                                        "glosses": [
                                            "Désir sélectif pour combler une sensation de faim, en parlant de l’alimentation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03bde631-7ea3-4adc-a39b-9ca8e02e7007",
                                                "sense_id": "4b58b1cf-817b-3dcd-afda-e6cad28aa859",
                                                "text": "C’est bien, répliqua Raoule de la même voix indifférente, je vous souhaite, à tous les deux, le meilleur des appétits !"
                                            },
                                            {
                                                "example_id": "c3e4bcd9-af76-46c5-98e8-9645d1442ade",
                                                "sense_id": "4b58b1cf-817b-3dcd-afda-e6cad28aa859",
                                                "text": "Après l’incubation […], il sort de chaque œuf un mince ver filiforme qui témoigne d’un vif appétit."
                                            },
                                            {
                                                "example_id": "60659dd5-f257-4ead-ae32-f7eaf4770779",
                                                "sense_id": "4b58b1cf-817b-3dcd-afda-e6cad28aa859",
                                                "text": "— On va dîner d’abord, eh ? fit-il, bonhomme. Vous avez dû prendre de l’appétit sur le chemin, et moi, de dire la messe, ça me donne faim sans bon sens."
                                            },
                                            {
                                                "example_id": "5b4c4d21-cd58-45fb-950c-5b9701d7fd31",
                                                "sense_id": "4b58b1cf-817b-3dcd-afda-e6cad28aa859",
                                                "text": "Il mange son assiette avec appétit."
                                            },
                                            {
                                                "example_id": "2622dda3-e3b2-474f-85b9-4eea3fcb46c3",
                                                "sense_id": "4b58b1cf-817b-3dcd-afda-e6cad28aa859",
                                                "text": "J'ai un énorme appétit."
                                            },
                                            {
                                                "example_id": "3cede3e2-6871-4c10-a4e4-f2e6181c464d",
                                                "sense_id": "4b58b1cf-817b-3dcd-afda-e6cad28aa859",
                                                "text": "L’appétit me vient."
                                            },
                                            {
                                                "example_id": "010d15ff-7cd6-49e9-83c3-8bd3a1cad71c",
                                                "sense_id": "4b58b1cf-817b-3dcd-afda-e6cad28aa859",
                                                "text": "Donner de l’appétit."
                                            },
                                            {
                                                "example_id": "ca05553f-e98f-4fdb-b985-abb2be33f96b",
                                                "sense_id": "4b58b1cf-817b-3dcd-afda-e6cad28aa859",
                                                "text": "Exciter, éveiller, aiguiser l’appétit."
                                            },
                                            {
                                                "example_id": "adfec6a4-dd6a-4241-967e-337e115c21d3",
                                                "sense_id": "4b58b1cf-817b-3dcd-afda-e6cad28aa859",
                                                "text": "Être sans appétit."
                                            },
                                            {
                                                "example_id": "8e896e17-a886-4174-844e-af0c21245f2f",
                                                "sense_id": "4b58b1cf-817b-3dcd-afda-e6cad28aa859",
                                                "text": "Rentrer en appétit."
                                            },
                                            {
                                                "example_id": "26e3548f-ccd1-4903-960f-2399fce1e597",
                                                "sense_id": "4b58b1cf-817b-3dcd-afda-e6cad28aa859",
                                                "text": "Ôter, émousser, faire passer, perdre l’appétit."
                                            },
                                            {
                                                "example_id": "926c9379-965c-4ed0-a007-bef594fab399",
                                                "sense_id": "4b58b1cf-817b-3dcd-afda-e6cad28aa859",
                                                "text": "Être en appétit."
                                            },
                                            {
                                                "example_id": "65cd8591-83d7-4f29-90ad-3ccd7c06cf54",
                                                "sense_id": "4b58b1cf-817b-3dcd-afda-e6cad28aa859",
                                                "text": "Manger d’appétit."
                                            },
                                            {
                                                "example_id": "98c26cfc-c1d0-4538-a791-3c7559ec536b",
                                                "sense_id": "4b58b1cf-817b-3dcd-afda-e6cad28aa859",
                                                "text": "Gagner de l’appétit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eae1bdff-38d7-376e-920a-e96e800d01ff",
                                        "entry_id": "59c27269-b326-380c-a713-05b8892cb9ce",
                                        "glosses": [
                                            "Désir d’une chose pour la satisfaction d’un besoin ou d’une envie."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f52ee5fd-bc1a-4547-a8b9-328ad50144b6",
                                                "sense_id": "eae1bdff-38d7-376e-920a-e96e800d01ff",
                                                "text": "La reprise du secteur immobilier a de nouveau éveillé l’appétit des promoteurs."
                                            },
                                            {
                                                "example_id": "11e7df1a-399a-4d5c-824e-4c167d5cbe61",
                                                "sense_id": "eae1bdff-38d7-376e-920a-e96e800d01ff",
                                                "text": "Ici, Piganiol et Pesquidoux se rencontrent : il faudrait qu’une impulsion suprahumaine vînt redonner à ces races blasées l’appétit de vivre, la foi en l’avenir."
                                            },
                                            {
                                                "example_id": "5af783ee-ca5a-4973-b301-67300f731daf",
                                                "sense_id": "eae1bdff-38d7-376e-920a-e96e800d01ff",
                                                "text": "…ils réveillaient en moi d’inavouables appétits."
                                            },
                                            {
                                                "example_id": "ad287147-fe53-4716-a270-3b9fc90a7573",
                                                "sense_id": "eae1bdff-38d7-376e-920a-e96e800d01ff",
                                                "text": "Il l’avait saisie avec une sorte de frénésie, doué de l’appétit brutal de l’homme qui a dû accumuler trop de privations."
                                            },
                                            {
                                                "example_id": "74298c3d-bb07-4042-bff5-5abd73b36f30",
                                                "sense_id": "eae1bdff-38d7-376e-920a-e96e800d01ff",
                                                "text": "Céline Thiébault était alors une jeune fille « bienfaisante », une de ces grandes filles brunes qui paraissent vingt ans au lieu de quinze, […]. Autour de ces créatures, trop vite aoûtées, ce qu’il peut roder d’appétits et combien le péché les guette à la moindre défaillance, je le sais."
                                            },
                                            {
                                                "example_id": "2bb172ae-8e7f-49d3-ba59-de450eec84ca",
                                                "sense_id": "eae1bdff-38d7-376e-920a-e96e800d01ff",
                                                "text": "J’en savais long désormais sur les appétits amoureux de l’Empereur. Je savais qu’il préférait de beaucoup l’irrumation à la fellation, et l’irrumation à la copulation proprement dite."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "appétit",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5fcf5d71-6a46-3eb4-988b-50c29fd3ed81",
                                        "entry_id": "624d3384-8010-335d-a229-313c58fe99be",
                                        "glosses": [
                                            "Bon appétit."
                                        ],
                                        "tags": [
                                            "ellipsis",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c67eeba-1bef-4c21-af9c-b20cf696ce55",
                                                "sense_id": "5fcf5d71-6a46-3eb4-988b-50c29fd3ed81",
                                                "text": "Appétit, tout le monde !"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "appétit",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "54e0a52c-8d89-307f-a69a-513da3dfc83f",
                                        "entry_id": "75f89e90-6b3b-3429-8aa4-a9ff39966005",
                                        "glosses": [
                                            "Ciboulette. (Note : dans ce sens le mot est presque toujours au pluriel) → voir appétits"
                                        ],
                                        "tags": [
                                            "Ouest"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6a3cbe0-5228-4724-8864-b86ec9bc68c0",
                                                "sense_id": "54e0a52c-8d89-307f-a69a-513da3dfc83f",
                                                "text": "La ciboulette est également appelée civette. Selon les régions, on la nomme aussi appétit."
                                            },
                                            {
                                                "example_id": "e47e9bc8-519c-4c77-a5c3-289c39abfcec",
                                                "sense_id": "54e0a52c-8d89-307f-a69a-513da3dfc83f",
                                                "text": "Préparer une omelette aux appétits."
                                            }
                                        ]
                                    }
                                ]
                            },
