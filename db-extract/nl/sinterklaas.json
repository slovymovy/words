                "senses": [
                    {
                        "sense_id": "cd72e523-5421-3343-b393-4087718fe1d4",
                        "entry_id": "1fe9fa36-0877-3ba3-8cb2-50f1b2b40041",
                        "glosses": [
                            "iemand die de rol van Sint-Nicolaas speelt tijdens het sinterklaasfeest, of zo gekleed is"
                        ],
                        "tags": [
                            "cultuur"
                        ],
                        "examples": [
                            {
                                "example_id": "ab8378b4-0c74-40bd-9324-b5b643ce63ae",
                                "sense_id": "cd72e523-5421-3343-b393-4087718fe1d4",
                                "text": "Van de straat kwam eerst een wat afgetrapte sinterklaas, die al in méér cafés was geweest. Men keek niet op van zijn uit kleine beurs gefinancierde vermomming, die meer vindingrijk dan suggestief was."
                            },
                            {
                                "example_id": "a08a9aa0-ff8e-4eef-b22a-7b2f21b014c3",
                                "sense_id": "cd72e523-5421-3343-b393-4087718fe1d4",
                                "text": "De sinterklazen kwamen met z'n allen het podium op. Ze hielden de armen angstvallig in de soutanes verborgen."
                            }
                        ]
                    },
                    {
                        "sense_id": "0706f77f-f438-3b60-ad87-d90e8e492f07",
                        "entry_id": "1fe9fa36-0877-3ba3-8cb2-50f1b2b40041",
                        "glosses": [
                            "viering van het sinterklaasfeest\\nIn deze betekenis wordt het woord als regel in het enkelvoud en zonder bepaald lidwoord gebruikt."
                        ],
                        "tags": [
                            "cultuur"
                        ],
                        "examples": [
                            {
                                "example_id": "b57326e7-fa48-4865-91fc-be3982e99fd2",
                                "sense_id": "0706f77f-f438-3b60-ad87-d90e8e492f07",
                                "text": "Wedden dat ik met sinterklaas weer een paar wollen wanten van mijn moeder krijg?"
                            },
                            {
                                "example_id": "72b6dfa4-370d-4ede-8e5f-bc517841d608",
                                "sense_id": "0706f77f-f438-3b60-ad87-d90e8e492f07",
                                "text": "Wanneer ze vlak voor sinterklaas het prentenboek van haar broer wil inpalmen, verschijnt plots de Sint met zijn zwarte knecht die zijn zak al open houdt. Treesje krijgt de schrik zo te pakken dat ze heilig belooft het nooit weer te doen."
                            }
                        ]
                    }
