                "senses": [
                    {
                        "sense_id": "63fe4dc4-de01-30b2-8f7f-bdfe12ce9178",
                        "entry_id": "1a73b58e-6565-3e75-b30f-5ea582eee460",
                        "glosses": [
                            "Weltraumfahrerin oder Raumfahrerin, die in russischem Auftrag tätig ist beziehungsweise in sowjetischem Auftrag tätig war"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31516967-3798-4a4b-92e8-3ad629c31ea0",
                                "sense_id": "63fe4dc4-de01-30b2-8f7f-bdfe12ce9178",
                                "text": "Im Jahr 1963 startete die erste Kosmonautin ins All."
                            },
                            {
                                "example_id": "5bf5340b-29a4-4194-b485-af22ec4473e9",
                                "sense_id": "63fe4dc4-de01-30b2-8f7f-bdfe12ce9178",
                                "text": "„So ergab sich der erstaunliche Umstand, dass erst jetzt die erste Kosmonautin überhaupt die Raumstation ISS betreten hat, die immerhin schon seit knapp 14 Jahren kontinuierlich besetzt ist.“"
                            }
                        ],
