                                            {
                                                "example_id": "1bf22846-ab5b-4640-a305-5489d5fb422e",
                                                "sense_id": "19aeb9b9-bd2a-3c4a-b250-4348b99d88e2",
                                                "text": "our antagonists in these controversies"
                                            },
                                            {
                                                "example_id": "739fd0db-cd13-46fe-a04c-2bdff7e5328c",
                                                "sense_id": "19aeb9b9-bd2a-3c4a-b250-4348b99d88e2",
                                                "text": "Antagonist of Heav’ns Almightie King"
                                            },
                                            {
                                                "example_id": "e0e21572-2c26-4fe1-800d-44f4a600873d",
                                                "sense_id": "19aeb9b9-bd2a-3c4a-b250-4348b99d88e2",
                                                "text": "[H]is eyes vacant—his face haggard—his head drooping, the spectacle of such an antagonist to the vigorous Edward, moved only pity in the few, and ridicule in the many."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e85be551-5569-369d-8fd6-9a1d0b930e49",
                                        "entry_id": "0481db1b-2173-3ad2-8950-4593798927f5",
                                        "glosses": [
                                            "One who antagonizes or stirs."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "65d441db-f51d-37fb-8eff-6292b0ad9a67",
                                        "entry_id": "0481db1b-2173-3ad2-8950-4593798927f5",
                                        "glosses": [
                                            "A chemical that binds to a receptor but does not produce a physiological response, blocking the action of other agonist chemicals, such as endogenous chemical messengers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24aab1a0-fdbd-4e17-8eb6-9299200df2b7",
                                                "sense_id": "65d441db-f51d-37fb-8eff-6292b0ad9a67",
                                                "text": "2001: The calcium antagonists represent one of the top ten classes of prescription drugs in terms of commercial value, with worldwide sales of nearly $10 billion in 1999. — Leslie Iversen, Drugs: A Very Short Introduction (Oxford 2001, p. 41)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b54352a2-0019-313e-ba34-1810b359bc63",
                                        "entry_id": "0481db1b-2173-3ad2-8950-4593798927f5",
                                        "glosses": [
                                            "The main character or force opposing the protagonist in a literary work or drama."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8b3d7e0-c316-49bf-8e51-b4789a901c3d",
                                                "sense_id": "b54352a2-0019-313e-ba34-1810b359bc63",
                                                "text": "So God forbid I'm seen just as an average human being / I mean, imagine if antagonists lacked any evil scheme"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "462f6398-3913-3dbf-8291-d3f6f4133825",
                                        "entry_id": "0481db1b-2173-3ad2-8950-4593798927f5",
                                        "glosses": [
                                            "A muscle that acts in opposition to another."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69ec1229-5cc4-4245-bf5a-ca0d6ae115e6",
                                                "sense_id": "462f6398-3913-3dbf-8291-d3f6f4133825",
                                                "text": "A flexor, which bends a part, is the antagonist of an extensor, which extends it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
