                "senses": [
                    {
                        "sense_id": "2b5f5e56-5602-3f13-bc21-747c7ddefe86",
                        "entry_id": "f0248833-6f85-37a3-b98b-821e6743d781",
                        "glosses": [
                            "shoe; slipper"
                        ],
                        "tags": [
                            "Ukraine"
                        ],
                        "examples": [
                            {
                                "example_id": "048c2769-dc5b-4549-964d-f78fa9a7926d",
                                "sense_id": "2b5f5e56-5602-3f13-bc21-747c7ddefe86",
                                "text": "Да, — продолжа́ла го́рдо краса́вица, — бу́дьте все вы свиде́тельницы: е́сли кузне́ц Ваку́ла принесёт те са́мые черевики́, кото́рые но́сит цари́ца, то вот моё сло́во, что вы́йду то́т же ча́с за него́ за́муж.",
                                "translation": "Yes, the beauty continued proudly, all of you are my (female) witnesses: if Vakula the blacksmith brings those very shoes that the tsaress wears, then here's my word (I promise), I will marry him right away.",
                                "english": "Yes, the beauty continued proudly, all of you are my (female) witnesses: if Vakula the blacksmith brings those very shoes that the tsaress wears, then here's my word (I promise), I will marry him right away."
                            }
                        ]
                    }
