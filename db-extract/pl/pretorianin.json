                    },
                    {
                        "translation_id": "e0badf62-744b-438c-a2a1-5154a352aa02",
                        "source_entry_id": "4ec95069-6783-3248-b62e-3675cb86b3ba",
                        "source_sense_id": "b3f5991f-f9d3-33d9-9c0c-6a84d00c0c63",
                        "target_lang_word": "prétorien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prétorien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d9867972-8df5-34b6-9ec6-39cba95da47c",
                                        "entry_id": "8ead0cc2-141e-3c2b-8aef-011930e3922a",
                                        "glosses": [
                                            "Qui est propre, qui appartient au préteur."
                                        ],
                                        "tags": [
                                            "Ancient-Roman"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f3740f3-00ba-41ba-b3e1-a2ec95f913b3",
                                                "sense_id": "d9867972-8df5-34b6-9ec6-39cba95da47c",
                                                "text": "La dignité prétorienne."
                                            },
                                            {
                                                "example_id": "cdeb4b90-0ce8-44ac-b87e-f092e277bf97",
                                                "sense_id": "d9867972-8df5-34b6-9ec6-39cba95da47c",
                                                "text": "Provinces prétoriennes, les provinces où l’on envoyait des gouverneurs avec le titre de Préteur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76810c8b-6286-39b6-b84b-eab89b47ac4d",
                                        "entry_id": "8ead0cc2-141e-3c2b-8aef-011930e3922a",
                                        "glosses": [
                                            "Relatif à la garde impériale romaine."
                                        ],
                                        "tags": [
                                            "Ancient-Roman"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad66d144-3cfd-4572-a414-a2d6544bdf03",
                                                "sense_id": "76810c8b-6286-39b6-b84b-eab89b47ac4d",
                                                "text": "La garde prétorienne fut introduite à Rome en même temps que la tyrannie : nous avons vu que César choisit la Xᵉ légion pour en former sa garde prétorienne."
                                            },
                                            {
                                                "example_id": "0ff62d88-8018-4f01-9e61-fd74c093a867",
                                                "sense_id": "76810c8b-6286-39b6-b84b-eab89b47ac4d",
                                                "text": "Pendant les guerres civiles du Triumvirat, Octave et Antoine organisèrent huit mille de leurs plus vieux soldats en cohortes prétoriennes."
                                            },
                                            {
                                                "example_id": "384f34f1-709f-4ada-930a-4e929790fb03",
                                                "sense_id": "76810c8b-6286-39b6-b84b-eab89b47ac4d",
                                                "text": "Je fais partie de la garde prétorienne et je porte un secret d'état."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3e93e8b-058e-30e6-ac72-1259c31ff63e",
                                        "entry_id": "8ead0cc2-141e-3c2b-8aef-011930e3922a",
                                        "glosses": [
                                            "Relatif à des militaires qui se sont emparés du pouvoir politique ou cherchent à le faire."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "120a4994-0f70-47c0-bd47-f4341364da4c",
                                                "sense_id": "b3e93e8b-058e-30e6-ac72-1259c31ff63e",
                                                "text": "Après la formation du nouveau gouvernement malien, majoritairement prétorien, la nomination du premier vice-président du CNSP (dissous depuis), le colonel Malick Diaw, à la tête du Conseil national de la transition (CNT), organe législatif de cette transition, a fini par convaincre les observateurs de la scène politique malienne de la volonté des militaires d’accaparer tous les leviers du pouvoir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "acd6e03d-0c18-361c-aa20-678750fc78a2",
                                        "entry_id": "8ead0cc2-141e-3c2b-8aef-011930e3922a",
                                        "glosses": [
                                            "Qui fait référence aux décisions antérieures des tribunaux, c’est-à-dire à la jurisprudence dite aussi « droit prétorien »."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0274227-7850-41f0-8c35-a66b08a76d82",
                                                "sense_id": "acd6e03d-0c18-361c-aa20-678750fc78a2",
                                                "text": "La Cour de cassation vient de rendre une nouvelle décision sur la réception partielle, création prétorienne de la jurisprudence."
                                            },
                                            {
                                                "example_id": "49fbb109-dd4c-4767-a9af-1b6cce72f4e7",
                                                "sense_id": "acd6e03d-0c18-361c-aa20-678750fc78a2",
                                                "text": "Une solution prétorienne est une solution à un problème de droit apportée par une juridiction."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "prétorien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1882d495-2615-3c3d-9dab-0507a4bc00d6",
                                        "entry_id": "ed135632-83f3-3f98-af76-856269a09929",
                                        "glosses": [
                                            "Qui concerne Prétoria, capitale de l’Afrique du Sud ^([1])."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "prétorien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "69f69a73-ab17-391e-8aa2-7a458fb3e6e3",
                                        "entry_id": "5266f175-cb9c-314a-8643-db99cef01265",
                                        "glosses": [
                                            "Soldat, membre des troupes qui formaient la garde des empereurs romains."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87dc13b9-e96a-4c35-a27b-f8371025d00c",
                                                "sense_id": "69f69a73-ab17-391e-8aa2-7a458fb3e6e3",
                                                "text": "Lou déboucha enfin dans l’arène et flanqua un coup de glaive à un prétorien qui voulait lui barrer la route."
                                            },
                                            {
                                                "example_id": "26283100-8438-4ac7-a648-6dc9312b3818",
                                                "sense_id": "69f69a73-ab17-391e-8aa2-7a458fb3e6e3",
                                                "text": "Les prétoriens, cette milice corrompue et énervée par les délices de la ville, séditieuse à l’excès, tant de fois souillée du sang des empereurs, qui presque jamais n’avait pu souffrir un bon prince, et qui en avait mis en place un si grand nombre de mauvais, s’étaient en dernier lieu attachés et dévoués au service de Maxence."
                                            },
                                            {
                                                "example_id": "b15db33e-6e29-41d9-aa98-d184c3492320",
                                                "sense_id": "69f69a73-ab17-391e-8aa2-7a458fb3e6e3",
                                                "text": "Un sénateur, que les prétoriens voulurent d’abord revêtir de la pourpre, s’enfuit presque nu de sa maison pour échapper à ce périlleux honneur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b8fe286-4fe7-3f03-be92-0293679294e3",
                                        "entry_id": "5266f175-cb9c-314a-8643-db99cef01265",
                                        "glosses": [
                                            "Militaire qui soutient un régime dictatorial, un pouvoir militaire."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c29d7615-12f5-472e-9ab2-0204604a600b",
                                                "sense_id": "9b8fe286-4fe7-3f03-be92-0293679294e3",
                                                "text": "Les vieux prétoriens que Berlin nous renvoie,\nLe visage encor chaud du soufflet allemand,\nPour marcher sur Paris s’enrôlent avec joie,\nEspérant cette fois vaincre facilement."
                                            },
                                            {
                                                "example_id": "4f86e671-d8bc-46e9-bc8c-cded691b72d5",
                                                "sense_id": "9b8fe286-4fe7-3f03-be92-0293679294e3",
                                                "text": "Comme beaucoup de leurs homologues d’Afrique noire, les prétoriens maliens n’ont en effet cessé, au cours des dernières années, de multiplier les promesses solennelles de retour à un régime civil."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
