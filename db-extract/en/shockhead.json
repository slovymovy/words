                        "glosses": [
                            "A head of long, unkempt, rough hair."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1209bcf3-6c50-4450-a258-091aa196ca2d",
                                "sense_id": "31debee8-8ba3-3405-af3f-b7aef0f9bc0d",
                                "text": "She carries it so carelessly, it seems like the profusion of hair on the shockheads of all the village boys, and village dogs: it grows like grass."
                            },
                            {
                                "example_id": "1c1febd7-d547-4788-8e84-47c23dd0f72e",
                                "sense_id": "31debee8-8ba3-3405-af3f-b7aef0f9bc0d",
                                "text": "Parents are at the cabin doors, dressing the hair of ragged children; shock-heads of girls peer out from the black circumference of smoke, and children inconceivably filthy, yell wildly and vociferously as the coach passes by."
                            }
                        ]
                    },
                    {
                        "sense_id": "087a9f98-6afb-34e9-b973-1d0ba3872554",
                        "entry_id": "e5f9666e-3f57-3aa6-baec-8de4eb295a03",
                        "glosses": [
                            "A person having hair of this kind."
                        ],
