                "senses": [
                    {
                        "sense_id": "689e9811-cf6a-394f-8fc0-2300838c72ce",
                        "entry_id": "93d0d660-f62d-3892-b17b-156db3e06a9a",
                        "glosses": [
                            "bei einer unter Asthma leidenden Person aufgrund dieser Krankheit plötzlich auftretende Atemnot (die Luftröhre verengt sich)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ac7591b-71f5-4cce-b7b4-556e504de332",
                                "sense_id": "689e9811-cf6a-394f-8fc0-2300838c72ce",
                                "text": "Während der Vorstellung erlitt ein Theaterbesucher einen Asthmaanfall und musste ärztlich versorgt werden."
                            },
                            {
                                "example_id": "d7502ef5-e8b4-40fe-905d-1fcc0cf98d2e",
                                "sense_id": "689e9811-cf6a-394f-8fc0-2300838c72ce",
                                "text": "Bei einem Asthmaanfall sollte man Ruhe bewahren und bestenfalls ein Asthmaspray besorgen."
                            },
                            {
                                "example_id": "5df649ad-4be6-4152-af3d-eab4b5a82da0",
                                "sense_id": "689e9811-cf6a-394f-8fc0-2300838c72ce",
                                "text": "Asthmaanfälle können durch Stress, körperliche Betätigung oder Allergien auftreten."
                            },
                            {
                                "example_id": "0abda3b4-0ed5-4606-a48d-c06e00af9b78",
                                "sense_id": "689e9811-cf6a-394f-8fc0-2300838c72ce",
                                "text": "„Er hatte nur einen Asthmaanfall.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
