                    }
                ],
                "senses": [
                    {
                        "sense_id": "2944ecc9-4cda-3279-a402-e846ea54048b",
                        "entry_id": "82c20137-d85b-36c7-ac11-c9b90f4dcfaa",
                        "glosses": [
                            "быстро переместиться в другое место"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c446baad-05fa-43cf-9318-373725a1fd8d",
                                "sense_id": "2944ecc9-4cda-3279-a402-e846ea54048b",
                                "text": "Он прыгнул и… перенесся сразу метров на десять вперёд и на два вверх."
                            }
                        ]
                    },
                    {
                        "sense_id": "12ad47a6-da39-33c5-87e4-cbc68b96d195",
                        "entry_id": "82c20137-d85b-36c7-ac11-c9b90f4dcfaa",
                        "glosses": [
                            "быстро переместиться через что-либо, поверх чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dcf49c8f-e22f-4943-bda6-ebf497001938",
                                "sense_id": "12ad47a6-da39-33c5-87e4-cbc68b96d195",
                                "text": "Маргарита же пронзительно свистнула и, оседлав подлетевшую щётку, перенеслась над рекой на противоположный берег."
                            }
                        ]
                    },
                    {
                        "sense_id": "8ddf7aa4-1edf-3743-8ecf-d41592f36a94",
                        "entry_id": "82c20137-d85b-36c7-ac11-c9b90f4dcfaa",
                        "glosses": [
                            "перен. распространиться откуда-либо куда-либо, на что-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ffd17b51-eaf7-4287-b641-cccf19c9df57",
                                "sense_id": "8ddf7aa4-1edf-3743-8ecf-d41592f36a94",
                                "text": "Хотя война перенеслась на территорию Германии, немцы воевали с ожесточением."
                            }
                        ]
                    },
                    {
                        "sense_id": "d3903365-956c-319b-a82c-845225a424e9",
                        "entry_id": "82c20137-d85b-36c7-ac11-c9b90f4dcfaa",
                        "glosses": [
                            "перен. мысленно представить себя в другом месте, в другом положении и т. п."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45c50051-4e79-4f7c-9167-56eb3c77a354",
                                "sense_id": "d3903365-956c-319b-a82c-845225a424e9",
                                "text": "Чтоб довести эту историю уже до самого конца, мне придётся перенестись ещё лет на десять вперёд, значит, в наше время."
                            }
                        ]
                    },
                    {
                        "sense_id": "905f58e2-ae55-3580-b0ea-3a247b235422",
                        "entry_id": "82c20137-d85b-36c7-ac11-c9b90f4dcfaa",
                        "glosses": [
                            "страд. от перенести"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
