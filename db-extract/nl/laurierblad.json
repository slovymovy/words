                        "source_entry_id": "e985f5ea-eaef-3810-8844-dff7b4750dcd",
                        "source_sense_id": "7fb7fa56-04be-3069-8296-f54c1e2334f3",
                        "source_sense_description": "(gedroogde) bladeren van Laurus nobilis",
                        "target_lang_word": "bay leaf",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bay leaf",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fa8fd405-f748-31ce-b7a8-df448d97a281",
                                        "entry_id": "472f4634-585f-39ff-9174-f5608e2c55df",
                                        "glosses": [
                                            "A herb derived from any of certain shrubs of the family Lauraceae and Myrtaceae, especially the bay laurel (Laurus nobilis)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0de8438e-5f62-447e-ba87-5a0356e1d7aa",
                                                "sense_id": "fa8fd405-f748-31ce-b7a8-df448d97a281",
                                                "text": "A piece of marigold or bay leaf was imbedded in the metal, and over it a carbuncle or chrysolite was placed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5aeb777c-f296-46f5-80c0-a01af00c79b6",
                        "source_entry_id": "e985f5ea-eaef-3810-8844-dff7b4750dcd",
                        "source_sense_id": "7fb7fa56-04be-3069-8296-f54c1e2334f3",
                        "source_sense_description": "(gedroogde) bladeren van Laurus nobilis",
                        "target_lang_word": "feuille de laurier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "feuille de laurier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "56a25c4f-30f7-30e4-bc5b-c8432ac622c4",
                                        "entry_id": "482ad799-7a07-335f-837a-3fefa328154d",
                                        "glosses": [
                                            "Condiment utilisé pour parfumer un plat."
                                        ],
                                        "tags": [
                                            "Aromate"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "885644a9-8f12-4ebe-af8b-2eb29494a091",
                                                "sense_id": "56a25c4f-30f7-30e4-bc5b-c8432ac622c4",
                                                "text": "Mettre le beurre dans une petite casserole avec la carotte et l’oignon coupés en petits dés, la feuille de laurier, le thym, le poivre, le persil, le jambon ; faire cuire cela pendant 5 minutes ; ajouter la farine ; mélanger avec la cuillère de bois ; y verser peu à peu le bouillon ou le jus et le Bovril ; tourner sur le feu jusqu’à ébullition faire cuire lentement 15 minutes. Passer dans une autre petite casserole à travers la passoire fine ; ajouter le madère."
                                            },
                                            {
                                                "example_id": "a7ab86c4-3b9f-4afc-b66e-8f249a047c8f",
                                                "sense_id": "56a25c4f-30f7-30e4-bc5b-c8432ac622c4",
                                                "text": "1 rôti de porc de 800 g, 0,800 g d'oignons, 10 cl de vin blanc, 40 g de beurre, feuille de laurier, sel, poivre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95de2937-6728-356a-af0a-433c0d3b9186",
                                        "entry_id": "482ad799-7a07-335f-837a-3fefa328154d",
                                        "glosses": [
                                            "Élément décoratif de frise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "409e7d88-052f-4ffd-b2cc-ebadd7c829a0",
                                                "sense_id": "95de2937-6728-356a-af0a-433c0d3b9186",
                                                "text": "Pour la feuille de Laurier, elle est presque semblable à celle d’Olivier, excepté qu’elle est plus grande & un peu ondée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e427148-084b-3e97-8260-4a50aadbef8f",
                                        "entry_id": "482ad799-7a07-335f-837a-3fefa328154d",
                                        "glosses": [
                                            "Forme particulière de certains coquillages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71344524-26a2-4644-b9b0-862815eb9080",
                                                "sense_id": "5e427148-084b-3e97-8260-4a50aadbef8f",
                                                "text": "Les Conchyliologistes donnent le nom de feuille à plusieurs coquilles bivalves : savoir, la camefeuille ou l’amande, la feuille huitre en crête de coq, & la feuille de laurier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0bb8fc43-a3aa-3660-83a7-9f2457137754",
                                        "entry_id": "482ad799-7a07-335f-837a-3fefa328154d",
                                        "glosses": [
                                            "Feuille du laurier utilisée en tant que talisman protecteur ou outil de sortilège."
                                        ],
                                        "tags": [
                                            "Ésotérisme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d1566b1-4741-492d-b3e1-0efd6587db76",
                                                "sense_id": "0bb8fc43-a3aa-3660-83a7-9f2457137754",
                                                "text": "Théophraste dit que les gens superstitieux, pour se préserver de quelque malheur ou de quelque souillure, gardoient tout le jour, dans leur bouche, une feuille de laurier."
                                            },
                                            {
                                                "example_id": "a06a556c-9f07-4a35-9ccb-269f48b37bc1",
                                                "sense_id": "0bb8fc43-a3aa-3660-83a7-9f2457137754",
                                                "text": "Si on enveloppe un des pieds de la taupe dans une feuille de laurier et qu’on la mette dans la bouche d’un cheval, il prendra aussitôt la fuite, saisi de peur. Si on la met dans le nid de quelque oiseau, les œufs deviennent stériles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cec31f48-c805-3ef3-b644-8020a53ba8e7",
                                        "entry_id": "482ad799-7a07-335f-837a-3fefa328154d",
                                        "glosses": [
                                            "Forme de référence d’un feuillage."
                                        ],
                                        "tags": [
                                            "Phytologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4b51ea1-813d-4fb0-b725-88a5d68b2ca2",
                                                "sense_id": "cec31f48-c805-3ef3-b644-8020a53ba8e7",
                                                "text": "Sur substrat siliceux, le Ciste à feuille de laurier est associé au Ciste ladanifère (Cistus ladanifer)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6a6947c-6d8c-358d-95f1-cac32a9da962",
                                        "entry_id": "482ad799-7a07-335f-837a-3fefa328154d",
                                        "glosses": [
                                            "Outil en pierre taillée façonné en pointe foliacée typique de la période du Solutréen."
                                        ],
                                        "tags": [
                                            "Préhistoire"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9ec0135-9e7f-41ae-97b8-240ed4b25dcd",
                                                "sense_id": "d6a6947c-6d8c-358d-95f1-cac32a9da962",
                                                "text": "Avec le Solutréen (race de Cro-Magnon), l’industrie lithique atteint son apogée : les solutréens furent d’admirables ciseleurs de pierre (pointes à feuille de laurier, pointes à cran, véritables bijoux)."
                                            },
                                            {
                                                "example_id": "1443e0d4-26de-42d2-a60d-7ccd45e85ed0",
                                                "sense_id": "d6a6947c-6d8c-358d-95f1-cac32a9da962",
                                                "text": "Le Solutréen, culture du Paléolithique supérieur il y a 25 000 ans, est surtout connu pour ses emblématiques \"feuilles de laurier\" (figure 1)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f87cbd6-f62f-3ad3-985e-a60f2d4e9662",
                                        "entry_id": "482ad799-7a07-335f-837a-3fefa328154d",
                                        "glosses": [
                                            "Outil à main, dont la lame est en forme de feuille de laurier (Laurus nobilis) et qui sert à lisser le mastic de vitrier lors de la pose de vitre sur une fenêtre. Couteau à mastiquer."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
