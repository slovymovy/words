                            {
                                "example_id": "2ee3b21c-e1f6-4aa7-8334-0b6c0d4b2158",
                                "sense_id": "534b72d5-4432-3e0b-80ed-f9082b270272",
                                "text": "Sans être négatif, le résultat obtenu ne permet pas d’espérer qu’on puisse obtenir ainsi une cellulose blanchissable."
                            },
                            {
                                "example_id": "dfc06280-b677-4aff-8c35-4f4a15998b23",
                                "sense_id": "534b72d5-4432-3e0b-80ed-f9082b270272",
                                "text": "Avec du Bouleau traité dans des conditions semblables à celles de la cuisson 3398, on avait obtenu une pâte blanchissable avec seulement 15 % de chlore."
                            },
                            {
                                "example_id": "5cd5a21a-591d-49c3-a2c8-2522bd5a8452",
                                "sense_id": "534b72d5-4432-3e0b-80ed-f9082b270272",
                                "text": "Autrefois elle [= la laine] apparaissait comme rèche et rude. De plus, elle n’était pas aussi blanchissable que le lin."
                            }
                        ]
                    }
