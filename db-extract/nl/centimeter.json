                                                "example_id": "7cfd54be-7005-4587-bf1b-11d7e2d6fb78",
                                                "sense_id": "661a55cd-889b-36ef-af89-38ae21cb06a0",
                                                "text": "Sie brauchte noch zehn Zentimeter schwarze Schnur."
                                            },
                                            {
                                                "example_id": "a32ddd58-347b-4dc5-9aad-2977f1254417",
                                                "sense_id": "661a55cd-889b-36ef-af89-38ae21cb06a0",
                                                "text": "„Sie war zehn Zentimeter kleiner als ich, schlank und doch kräftig, schulterlanges Haar, so weiß, dass es an Engelsflügel denken ließ.“"
                                            }
