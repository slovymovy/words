                "translations": [
                    {
                        "translation_id": "a19ae83b-7c9f-4eb5-81e9-482080832470",
                        "source_entry_id": "e141d0b3-4124-3f1c-b1b9-53d6f8e21681",
                        "source_sense_id": "2b756744-959e-3895-98ef-8592add6519a",
                        "source_sense_description": "Wissenschaftler, der sich mit Entomologie (Insektenkunde) beschäftigt",
                        "target_lang_word": "entomologist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "entomologist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "704d6bb2-1810-3f21-833b-8414265bea49",
                                        "entry_id": "17c04669-43c0-3ca8-9b61-c594ed6f1f4a",
                                        "glosses": [
                                            "A scientist who studies insects."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74274996-6412-41bb-9909-c2c9d759e357",
                                                "sense_id": "704d6bb2-1810-3f21-833b-8414265bea49",
                                                "text": "DENR entomologists recall that beetle infestation of the agohos is similar to another which killed thousands of pine trees in Benguet in 1981."
                                            },
                                            {
                                                "example_id": "c12ec777-7e90-4311-b049-a9ed57a0e858",
                                                "sense_id": "704d6bb2-1810-3f21-833b-8414265bea49",
                                                "text": "The noted entomologist Charles W. Woodworth suggested the use of Drosophila melanogaster for genetic studies."
                                            },
                                            {
                                                "example_id": "803026db-5f8b-4192-bfc1-f29a0bdfe606",
                                                "sense_id": "704d6bb2-1810-3f21-833b-8414265bea49",
                                                "text": "Colorado stood at the brink of an outbreak that another Forest Service entomologist would dub “Beetlegeddon.”"
                                            },
                                            {
                                                "example_id": "6f1dbb95-1ea7-4c52-8aa7-b2165bf90be8",
                                                "sense_id": "704d6bb2-1810-3f21-833b-8414265bea49",
                                                "text": "An entomologist named a new species of millipede Nannaria swiftae after pop star Taylor Swift."
                                            },
                                            {
                                                "example_id": "ed350c6a-327b-49e7-afa3-8a2a18cf304b",
                                                "sense_id": "704d6bb2-1810-3f21-833b-8414265bea49",
                                                "text": "The team, made up of entomologists and electrical engineers, attached AprilTags, a kind of QR code that is smaller than the nail on your little finger, to the bees using glue."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "82d65ae4-b806-477d-99c4-aecb60ad21e7",
                        "source_entry_id": "e141d0b3-4124-3f1c-b1b9-53d6f8e21681",
                        "source_sense_id": "2b756744-959e-3895-98ef-8592add6519a",
                        "source_sense_description": "Wissenschaftler, der sich mit Entomologie (Insektenkunde) beschäftigt",
                        "target_lang_word": "энтомолог",
