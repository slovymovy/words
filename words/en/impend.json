{
    "word_family": [
        "impendence",
        "impendency",
        "imminent"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e1ca6f4a-e47a-3a97-ba21-8f1d3c5baef2",
                    "sense_definition": "To be imminent or about to happen, especially regarding something threatening or undesirable.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "threaten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A severe economic crisis <w>impends</w> if the government does not take swift action.",
                            "target_lang_translations": {
                                "ru": "Если правительство не примет срочных мер, <w>надвигается</w> тяжелый экономический кризис."
                            }
                        },
                        {
                            "text": "Dark storm clouds gathered quickly on the horizon, signaling that danger <w>impended</w>.",
                            "target_lang_translations": {
                                "ru": "Тёмные грозовые тучи быстро сгущались на горизонте, сигнализируя о том, что <w>надвигается</w> опасность."
                            }
                        }
                    ],
                    "synonyms": [
                        "loom",
                        "approach"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неминуемо приближаться или вот-вот произойти (особенно о чём-то угрожающем или нежелательном)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "надвигаться",
                                "target_lang_sense_clarification": "о надвигающейся опасности или беде"
                            },
                            {
                                "target_lang_word": "предстоять",
                                "target_lang_sense_clarification": "о неизбежных трудностях"
                            },
                            {
                                "target_lang_word": "угрожать",
                                "target_lang_sense_clarification": "быть близким, нависать угрозой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "92534052-fd00-3fc2-b595-ff83aaa5d9d6",
                    "sense_definition": "To hang over someone or something as a hovering threat or danger.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "threaten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A persistent sense of misfortune seemed to <w>impend</w> over the cursed family.",
                            "target_lang_translations": {
                                "ru": "Казалось, постоянное ощущение несчастья <w>нависало</w> над проклятой семьей."
                            }
                        },
                        {
                            "text": "The grim threat of war <w>impended</w> over the entire continent for months.",
                            "target_lang_translations": {
                                "ru": "Мрачная угроза войны месяцами <w>висела</w> над всем континентом."
                            }
                        }
                    ],
                    "synonyms": [
                        "menace",
                        "threaten"
                    ],
                    "common_phrases": [
                        "impend over"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "literary and dated usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Нависать над кем-либо или чем-либо в виде скрытой или явной угрозы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нависать",
                                "target_lang_sense_clarification": "тяготеть над кем-либо, угрожать"
                            },
                            {
                                "target_lang_word": "висеть",
                                "target_lang_sense_clarification": "о нависшей угрозе"
                            },
                            {
                                "target_lang_word": "тяготеть",
                                "target_lang_sense_clarification": "нависать бременем, угрозой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "78a6baaa-1cdb-390d-a1ef-53421ec658f9",
                    "sense_definition": "To hang or be suspended physically over something; to overhang.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Massive jagged rocks <w>impended</w> over the narrow and dangerous mountain path.",
                            "target_lang_translations": {
                                "ru": "Массивные зубчатые скалы <w>нависали</w> над узкой и опасной горной тропой."
                            }
                        },
                        {
                            "text": "The old wooden balcony <w>impends</w> precariously over the busy street below.",
                            "target_lang_translations": {
                                "ru": "Старый деревянный балкон ненадежно <w>нависает</w> над оживленной улицей внизу."
                            }
                        }
                    ],
                    "synonyms": [
                        "overhang"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "archaic in the literal physical sense"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Физически нависать или свисать над чем-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нависать",
                                "target_lang_sense_clarification": "физически нависать над чем-либо"
                            },
                            {
                                "target_lang_word": "свешиваться",
                                "target_lang_sense_clarification": "висеть над чем-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "19319b62-296f-38bd-a130-b8c0e8779c5e",
                    "sense_definition": "To spend or pay out money.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The treasury was forced to <w>impend</w> vast sums of gold to fund the expedition.",
                            "target_lang_translations": {
                                "ru": "Казна была вынуждена <w>израсходовать</w> огромные суммы золота для финансирования экспедиции."
                            }
                        },
                        {
                            "text": "He refused to <w>impend</w> any further funds on such a reckless scheme.",
                            "target_lang_translations": {
                                "ru": "Он отказался дальше <w>тратить</w> средства на столь безрассудную затею."
                            }
                        }
                    ],
                    "synonyms": [
                        "expend",
                        "disburse"
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "obsolete"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тратить или расходовать денежные средства."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расходовать",
                                "target_lang_sense_clarification": "тратить средства"
                            },
                            {
                                "target_lang_word": "тратить",
                                "target_lang_sense_clarification": "издерживать деньги"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}