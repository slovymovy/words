                "translations": [
                    {
                        "translation_id": "1536e49e-5ae2-41c0-a74f-006dabe00e64",
                        "source_entry_id": "e2ce3f59-3467-345b-b6bf-16fda25dd26f",
                        "target_lang_word": "Normalität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Normalität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "546f9128-4b67-37f0-bb5e-c7f635bc30a9",
                                        "entry_id": "bd1fb109-21f8-3b0f-9180-727be095200b",
                                        "glosses": [
                                            "Zustand ohne außergewöhnliche Umstände"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f1510cc-4204-4014-a8f5-735df91f01b1",
                                                "sense_id": "546f9128-4b67-37f0-bb5e-c7f635bc30a9",
                                                "text": "Wir müssen so schnell wie möglich wieder zur Normalität zurückkehren."
                                            },
                                            {
                                                "example_id": "56d19e22-8a3a-4296-93f1-f873958c05b5",
                                                "sense_id": "546f9128-4b67-37f0-bb5e-c7f635bc30a9",
                                                "text": "„Entlang der wichtigsten Verkehrsadern stehen solarbetriebene Straßenlaternen, die zusammen mit neuen gelben Taxen den Eindruck von Normalität vermitteln.“"
                                            },
                                            {
                                                "example_id": "f973399f-c2b9-42df-a05a-305d0dd4815f",
                                                "sense_id": "546f9128-4b67-37f0-bb5e-c7f635bc30a9",
                                                "text": "„Es war genau die Art von Normalität, nach der Val sich verzweifelt gesehnt hatte.“"
                                            },
                                            {
                                                "example_id": "d69041a7-6c99-4346-b243-e8e290fe0a6c",
                                                "sense_id": "546f9128-4b67-37f0-bb5e-c7f635bc30a9",
                                                "text": "„Es fühlte sich an wie ein böser Traum, aus dem Kneifen nicht als Aufwachhilfe nutzte, ein Traum, der sich über unsere Normalität gestülpt hatte und nicht enden wollte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b9aaa923-bdcf-3074-bd9f-b273c9cdf9df",
                                        "entry_id": "bd1fb109-21f8-3b0f-9180-727be095200b",
                                        "glosses": [
                                            "Äquivalentkonzentration"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ad05a14-20a6-4dcd-903c-7dcec22abdcf",
                                                "sense_id": "b9aaa923-bdcf-3074-bd9f-b273c9cdf9df",
                                                "text": "Die Normalität ist definiert als Quotient der Menge an Äquivalenten durch das Volumen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "244507de-731b-4968-8c73-152e849ee8f0",
