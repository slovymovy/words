{
    "word_family": [
        "art",
        "artistic",
        "artist",
        "artistry"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4a626c0b-0adb-3559-b881-988c70f95e1d",
                    "sense_definition": "A skilled manual worker who makes items by hand or using traditional tools.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "craftsperson",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local <w>artisan</w> spent hours carving the intricate wooden chair by hand.",
                            "target_lang_translations": {
                                "zh": "当地的<w>工匠</w>花了几个小时手工雕刻那把复杂的木椅。"
                            }
                        },
                        {
                            "text": "Many skilled <w>artisan</w> workshops are struggling to compete with mass-produced goods.",
                            "target_lang_translations": {
                                "zh": "许多熟练的<w>工匠</w>作坊正努力与大规模生产的商品竞争。"
                            }
                        }
                    ],
                    "synonyms": [
                        "craftsman",
                        "craftsperson"
                    ],
                    "common_phrases": [
                        "skilled artisan",
                        "local artisan"
                    ],
                    "target_lang_definitions": {
                        "zh": "指通过手工或传统工具制作物品的熟练技术工人。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "工匠",
                                "target_lang_sense_clarification": "指从事手工制作的熟练技术人员。"
                            },
                            {
                                "target_lang_word": "手艺人",
                                "target_lang_sense_clarification": "指拥有某种传统手艺的劳动者。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "596b5d3f-78f8-37b0-8c8b-ead51b97f606",
                    "sense_definition": "A person who demonstrates exceptional skill or dexterity in their work.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "craftsperson",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The master watchmaker is a true <w>artisan</w> of his trade.",
                            "target_lang_translations": {
                                "zh": "这位钟表大师是他这一行当里真正的<w>能工巧匠</w>。"
                            }
                        },
                        {
                            "text": "Only a dedicated <w>artisan</w> could achieve such precision in every single detail.",
                            "target_lang_translations": {
                                "zh": "只有专注的<w>大师</w>才能在每一个细节上达到如此精准的程度。"
                            }
                        }
                    ],
                    "synonyms": [
                        "master",
                        "expert"
                    ],
                    "target_lang_definitions": {
                        "zh": "指在工作中展现出卓越技巧或灵巧度的人。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "大师",
                                "target_lang_sense_clarification": "指在某项技艺上达到极高造诣的人。"
                            },
                            {
                                "target_lang_word": "能工巧匠",
                                "target_lang_sense_clarification": "形容技艺高超、心灵手巧的人。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ecf0abd8-7cfe-3896-b25a-b859d9e8d040",
                    "sense_definition": "Made in a traditional or non-mechanized way by a skilled worker.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "craft-related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We bought some fresh <w>artisan</w> bread from the market this morning.",
                            "target_lang_translations": {
                                "zh": "我们今天早上从市场上买了一些新鲜的<w>手工</w>面包。"
                            }
                        },
                        {
                            "text": "The shop specializes in <w>artisan</w> cheeses made on small family farms.",
                            "target_lang_translations": {
                                "zh": "这家店专门经营在小型家庭农场生产的<w>手工</w>奶酪。"
                            }
                        }
                    ],
                    "synonyms": [
                        "artisanal",
                        "handcrafted"
                    ],
                    "antonyms": [
                        "mass-produced"
                    ],
                    "common_phrases": [
                        "artisan bread",
                        "artisan cheese"
                    ],
                    "target_lang_definitions": {
                        "zh": "指由熟练工人以传统或非机械化方式制作的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "手工制作的",
                                "target_lang_sense_clarification": "强调非工业化生产的制作方式。"
                            },
                            {
                                "target_lang_word": "精制的",
                                "target_lang_sense_clarification": "强调产品制作精良且具有传统特色。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}