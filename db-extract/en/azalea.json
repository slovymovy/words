                    },
                    {
                        "translation_id": "95266461-537e-4239-b67b-52dca8c20c33",
                        "source_entry_id": "40cf198c-e6e5-32f7-a690-ec96f82ac516",
                        "source_sense_id": "84157b13-8d60-346a-83b8-aa650c232109",
                        "source_sense_description": "plant — see also rhododendron",
