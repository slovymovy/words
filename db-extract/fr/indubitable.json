                        "form": "indubitables"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9dab6b5c-1e31-3c0b-ba9d-9d492dc6198f",
                        "entry_id": "e9428b30-90bc-3d21-a72d-3e1a8f223f5b",
                        "glosses": [
                            "Dont on ne peut douter, qui est certain, assuré."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7f48a69-899a-4f60-bef7-a7bce227bec5",
                                "sense_id": "9dab6b5c-1e31-3c0b-ba9d-9d492dc6198f",
                                "text": "Il est indubitable que Cadiz affranchie reprendra tout l’avantage que Gibraltar n’a dû lui-même qu’à sa franchise."
                            },
                            {
                                "example_id": "4a97e259-0f25-45b0-98e4-3e6668789803",
                                "sense_id": "9dab6b5c-1e31-3c0b-ba9d-9d492dc6198f",
                                "text": "Car ils ne peuvent ignorer que Barbey d’Aurevilly est un catholique, un indubitable chrétien romain par la tête et par le cœur, par son éducation et par ses doctrines, et voilà ce qui les désole !"
                            },
                            {
                                "example_id": "ad098f15-ab12-4196-ba3b-e95641bc3c6e",
                                "sense_id": "9dab6b5c-1e31-3c0b-ba9d-9d492dc6198f",
                                "text": "À l’endroit où le sentier s’engage dans la montagne, ils trouvèrent, tout plein et garni de sa couche de crème, le pot au lait du musicien, signe indubitable qu’il avait passé par là."
                            },
                            {
                                "example_id": "fc7bf502-02a5-46b7-b8d9-70f11fcb61b0",
                                "sense_id": "9dab6b5c-1e31-3c0b-ba9d-9d492dc6198f",
                                "text": "Car il est indubitable qu’en temps de guerre et en fait de mariage, les Héros de Mars procèdent souvent de manière quelque peu sommaire !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d9ed02d6-b89a-4a45-ba95-b8691f723857",
                        "source_entry_id": "e9428b30-90bc-3d21-a72d-3e1a8f223f5b",
                        "source_sense_id": "9dab6b5c-1e31-3c0b-ba9d-9d492dc6198f",
                        "target_lang_word": "unbestreitbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unbestreitbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5b52d6db-e181-3404-8be9-aff9b4d335ba",
                                        "entry_id": "9ceb03ca-235b-38e8-bb8a-86e57cbfc441",
                                        "glosses": [
                                            "sich nicht bestreiten/leugnen/widerlegen lassend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92e17105-08e1-4f7d-9c92-ca818a2b69d1",
                                                "sense_id": "5b52d6db-e181-3404-8be9-aff9b4d335ba",
                                                "text": "„Für den unbestreitbaren massiven Bevölkerungsschwund machen die Apologeten König Leopolds, damals wie heute, die Schlafkrankheit verantwortlich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8217d87e-0ac8-4e22-ba7d-d0e82fd41284",
                        "source_entry_id": "e9428b30-90bc-3d21-a72d-3e1a8f223f5b",
                        "source_sense_id": "9dab6b5c-1e31-3c0b-ba9d-9d492dc6198f",
                        "target_lang_word": "unzweifelhaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unzweifelhaft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2ebcaa82-0690-3a49-95f6-acdc4c32d5ea",
                                        "entry_id": "0fb4808f-c389-3705-b73d-c722fc8842c6",
                                        "glosses": [
                                            "ohne daran zu rütteln (zu zweifeln); ganz sicher"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37ac3b16-f668-478e-9214-44fa2e8f9d1c",
                                                "sense_id": "2ebcaa82-0690-3a49-95f6-acdc4c32d5ea",
                                                "text": "Das wäre unzweifelhaft legal, aber wäre es auch klug, das jetzt so zu versuchen?"
                                            },
                                            {
                                                "example_id": "01efc733-82f8-4620-a285-f70b0f247747",
                                                "sense_id": "2ebcaa82-0690-3a49-95f6-acdc4c32d5ea",
                                                "text": "Der Verlust des Geldes ist ein unzweifelhafter Fakt, den kannst du nicht schönreden."
                                            },
                                            {
                                                "example_id": "1ce6e579-471b-4a6c-b528-c363cf5f9d2b",
                                                "sense_id": "2ebcaa82-0690-3a49-95f6-acdc4c32d5ea",
                                                "text": "Sie ist eine junge Dame von unzweifelhaftem Ruf."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "234d6c3b-e6fa-4520-941f-78a2e5e4902d",
                        "source_entry_id": "e9428b30-90bc-3d21-a72d-3e1a8f223f5b",
                        "source_sense_id": "9dab6b5c-1e31-3c0b-ba9d-9d492dc6198f",
                        "target_lang_word": "sicher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sicher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0cec2c3a-a8f4-3032-a2a4-11a273680459",
                                        "entry_id": "6ae7e153-ecee-35d8-89fa-203287fee3ff",
                                        "glosses": [
                                            "vor Gefahren geschützt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57db07ed-359e-4c8e-9c3a-509d7bc79a2d",
                                                "sense_id": "0cec2c3a-a8f4-3032-a2a4-11a273680459",
                                                "text": "„Drachenfliegen ist heute mindestens ebenso sicher wie Segelfliegen – dank enormer technischer Entwicklungen.“"
                                            },
                                            {
                                                "example_id": "7f563aae-e6f8-4b18-ae17-47fc367bdfc8",
                                                "sense_id": "0cec2c3a-a8f4-3032-a2a4-11a273680459",
                                                "text": "Sie verstauten das Geld an einem sicheren Ort."
                                            },
                                            {
                                                "example_id": "cd7e9d94-84d1-4c83-bc17-87b20c82ff2b",
                                                "sense_id": "0cec2c3a-a8f4-3032-a2a4-11a273680459",
                                                "text": "„Fliegen war noch niemals so sicher, wie heute“, behaupten die Luftverkehrsunternehmen."
                                            },
                                            {
                                                "example_id": "314ec59f-9b0d-4e14-be57-7f054f3f0524",
                                                "sense_id": "0cec2c3a-a8f4-3032-a2a4-11a273680459",
                                                "text": "„12.3.2011 angesichts der Fukushima-Katastrophe: ‘An so einem Tag darf man sicher nicht sagen, unsere Kernkraftwerke sind sicher. (Pause) Sie sind sicher.‘ “"
                                            },
                                            {
                                                "example_id": "8dd7849a-9d03-479f-9214-171684c21c1a",
                                                "sense_id": "0cec2c3a-a8f4-3032-a2a4-11a273680459",
                                                "text": "„Und es gilt auch der Satz, zum Mitschreiben: Die Rente ist sicher!“ (Dr. Norbert Blüm, CDU, Bundesminister für Arbeit und Sozialordnung, Rede vor dem Deutschen Bundestag, 10. Oktober 1997)"
                                            },
                                            {
                                                "example_id": "3473209a-d922-4e99-a0d9-d7cdfa5e5f12",
                                                "sense_id": "0cec2c3a-a8f4-3032-a2a4-11a273680459",
                                                "text": "„Der Schiläufer, der ein steiles Gelände sicher hinabfahren will, muss Schutzreflexe abbauen. […] Er muss das Schutzstreben in die Rücklage aufgeben und mutig die Vorlage suchen, um seine Schier sicher führen zu können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8bc96e97-7b73-3596-9c38-42e4bb2e1caa",
                                        "entry_id": "6ae7e153-ecee-35d8-89fa-203287fee3ff",
                                        "glosses": [
                                            "mit sehr hoher Wahrscheinlichkeit eintreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e63b2537-2a86-436e-9b30-545c34728cff",
                                                "sense_id": "8bc96e97-7b73-3596-9c38-42e4bb2e1caa",
                                                "text": "Das ist ein sicherer Gewinn."
                                            },
                                            {
                                                "example_id": "4b6933d0-450e-46a3-876b-6330750d7f1f",
                                                "sense_id": "8bc96e97-7b73-3596-9c38-42e4bb2e1caa",
                                                "text": "Die Anzahl hochrangiger Banker auf dem Weltwirtschaftsforum in Davos ist enorm. Das ist eine gute Gelegenheit, mit ihnen darüber zu diskutieren, ob die Finanzmärkte seit der Krise [in 2008] sicherer geworden sind."
                                            },
                                            {
                                                "example_id": "41f77e1c-0e6b-408f-8f4d-a9f5b7ed0e50",
                                                "sense_id": "8bc96e97-7b73-3596-9c38-42e4bb2e1caa",
                                                "text": "Wieviel Orang-Utans noch in freier Wildbahn leben, ist nicht sicher, die Schätzungen liegen zwischen 70.000 und 150.000 Exemplaren."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "4a5ad3ee-ce6d-319c-b485-370bcfcaec53",
                                        "entry_id": "6ae7e153-ecee-35d8-89fa-203287fee3ff",
                                        "glosses": [
                                            "selbstbewusst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8384a64-ae64-448c-9c9f-c47f2a71d889",
                                                "sense_id": "4a5ad3ee-ce6d-319c-b485-370bcfcaec53",
                                                "text": "„Der Schiläufer, der ein steiles Gelände sicher hinabfahren will, muss Schutzreflexe abbauen. […] Er muss das Schutzstreben in die Rücklage aufgeben und mutig die Vorlage suchen, um seine Schier sicher führen zu können.“"
                                            },
                                            {
                                                "example_id": "da8f8127-eb09-48db-a296-ed131c60b941",
                                                "sense_id": "4a5ad3ee-ce6d-319c-b485-370bcfcaec53",
                                                "text": "Der Redner hatte ein sehr sicheres Auftreten."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "9732cbc0-23b3-3099-a352-c051dcd1924d",
                                        "entry_id": "6ae7e153-ecee-35d8-89fa-203287fee3ff",
                                        "glosses": [
                                            "bestimmt, gewiss, unzweifelhaft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95153832-cbeb-4d62-88d9-a2eb200a4863",
                                                "sense_id": "9732cbc0-23b3-3099-a352-c051dcd1924d",
                                                "text": "Sicher, das können wir so machen. Dann treffen wir uns in einer halben Stunde."
                                            },
                                            {
                                                "example_id": "3eeb883a-87de-476e-a27b-f52ac6ce3a0f",
                                                "sense_id": "9732cbc0-23b3-3099-a352-c051dcd1924d",
                                                "text": "Ich bin mir sicher, dass Frau Gärtner noch anruft."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            },
                            {
                                "target_word": "sicher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fcdbaba9-56c2-37df-9938-35ecbb355a1a",
