{
    "word_family": [
        "пирог",
        "пирожковая",
        "пирожковый",
        "пирожочек"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f22bec3b-42c6-389d-a90f-b115b487a3c9",
                    "sense_definition": "Небольшое кулинарное изделие из печёного или жареного теста с различной начинкой.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "culinary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Бабушка испекла горячий <w>пирожок</w> с капустой и положила его на тарелку.",
                            "target_lang_translations": {
                                "de": "Die Oma backte eine heiße <w>Teigtasche</w> mit Krautfüllung und legte sie auf den Teller."
                            }
                        },
                        {
                            "text": "На вокзале мы быстро купили свежие вкусные <w>пирожки</w> и чай.",
                            "target_lang_translations": {
                                "de": "Am Bahnhof kauften wir schnell frische, leckere <w>Piroschki</w> und Tee."
                            }
                        }
                    ],
                    "common_phrases": [
                        "горячие пирожки",
                        "печь пирожки",
                        "пирожок с капустой",
                        "пирожок с мясом"
                    ],
                    "target_lang_definitions": {
                        "de": "Kleines Gebäck aus Hefeteig oder Mürbeteig, gebacken oder gebraten, gefüllt mit Fleisch, Gemüse, Pilzen oder süßen Füllungen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Piroschok",
                                "target_lang_sense_clarification": "gefüllte Teigtasche (meist im Plural: Piroschki)"
                            },
                            {
                                "target_lang_word": "Teigtasche",
                                "target_lang_sense_clarification": "gefülltes Teiggericht"
                            },
                            {
                                "target_lang_word": "Pastetchen",
                                "target_lang_sense_clarification": "kleine Pastete mit Füllung"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2b3960b9-5be7-3c8a-bc33-037de9e4a3f1",
                    "sense_definition": "Уменьшительно-ласкательное к <w>пирог</w>.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "culinary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мама сделала для ребёнка маленький сладкий <w>пирожок</w> из остатков теста.",
                            "target_lang_translations": {
                                "de": "Die Mutter machte aus den Teigresten ein kleines süßes <w>Küchlein</w> für das Kind."
                            }
                        },
                        {
                            "text": "Этот аккуратный <w>пирожок</w> выглядел очень аппетитно на праздничном столе.",
                            "target_lang_translations": {
                                "de": "Dieses ordentliche kleine <w>Pastetchen</w> sah auf der Festtafel sehr appetitlich aus."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Verkleinerungsform von Kuchen oder Pastete (пирог)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Küchlein",
                                "target_lang_sense_clarification": "kleiner Kuchen"
                            },
                            {
                                "target_lang_word": "Pastetchen",
                                "target_lang_sense_clarification": "kleine herzhafte oder süße Pastete"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "76c809a4-0b56-3cb6-9ae8-00287c3aca78",
                    "sense_definition": "Жанр сетевой поэзии: юмористическое нерифмованное четверостишие, написанное четырёхстопным ямбом без знаков препинания.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "internet_humor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Друг опубликовал на своей странице остроумный <w>пирожок</w>, который сразу собрал много лайков.",
                            "target_lang_translations": {
                                "de": "Ein Freund veröffentlichte auf seiner Seite ein witziges <w>Piroschok-Gedicht</w>, das sofort viele Likes bekam."
                            }
                        },
                        {
                            "text": "В сети существует целое сообщество авторов, сочиняющих забавные <w>пирожки</w>.",
                            "target_lang_translations": {
                                "de": "Im Netz gibt es eine ganze Gemeinschaft von Autoren, die lustige <w>Piroschok-Verse</w> verfassen."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "интернет-сленг"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein russisches Internet-Gedicht-Genre: ungereimter vierzeiliger Jambus ohne Satzzeichen und Großschreibung, meist humorvoll oder satirisch."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Piroschok-Gedicht",
                                "target_lang_sense_clarification": "Gedichtform im russischen Internet"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "37a40333-94f3-30cd-8f22-5b1fecf41a1d",
                    "sense_definition": "Малолитражный грузопассажирский автомобиль с закрытым кузовом-фургоном.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "vehicle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Старый <w>пирожок</w> подъехал к небольшому магазину и выгрузил коробки с товаром.",
                            "target_lang_translations": {
                                "de": "Der alte <w>Kastenwagen</w> fuhr an ein kleines Geschäft heran und lud Kisten mit Ware ab."
                            }
                        },
                        {
                            "text": "Сосед купил подержанный советский <w>пирожок</w> для перевозки стройматериалов на дачу.",
                            "target_lang_translations": {
                                "de": "Der Nachbar kaufte einen gebrauchten sowjetischen <w>Lieferwagen</w>, um Baumaterialien zur Datscha zu transportieren."
                            }
                        }
                    ],
                    "synonyms": [
                        "каблук",
                        "пирожковоз"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное"
                        },
                        {
                            "trait_type": "regional",
                            "comment": "региональное"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Umgangssprachliche Bezeichnung für einen kleinen sowjetischen/russischen Lieferwagen bzw. Kastenwagen (z. B. IZh-2715)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Kastenwagen",
                                "target_lang_sense_clarification": "umgangssprachlich für kleine Lieferwagen"
                            },
                            {
                                "target_lang_word": "Lieferwagen",
                                "target_lang_sense_clarification": "umgangssprachlich"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "69bf7480-c211-325b-b62b-5cdd2c420e22",
                    "sense_definition": "Мужской головной убор без полей с продольной складкой или вмятиной наверху.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Пожилой профессор носил тёплый каракулевый <w>пирожок</w> даже в не очень холодную погоду.",
                            "target_lang_translations": {
                                "de": "Der ältere Professor trug selbst bei nicht allzu kaltem Wetter eine warme Astrachan-<w>Schiffchenmütze</w>."
                            }
                        },
                        {
                            "text": "На старых фотографиях многие партийные чиновники запечатлены в одинаковых шапках <w>пирожках</w>.",
                            "target_lang_translations": {
                                "de": "Auf alten Fotos sind viele Parteifunktionäre in identischen <w>Pelzschiffchen</w> abgebildet."
                            }
                        }
                    ],
                    "common_phrases": [
                        "шапка пирожок"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "устаревающее"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Herrenmütze ohne Krempe mit einer Längsfalte auf der Oberseite, typisch für die sowjetische Nomenklatura."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Schiffchenmütze",
                                "target_lang_sense_clarification": "Pelzmütze in Schiffchenform"
                            },
                            {
                                "target_lang_word": "Pelzschiffchen",
                                "target_lang_sense_clarification": "Gogol-Mütze / Nomenklatura-Pelzmütze"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0b5b318a-484b-30bf-aea5-6882622f6f79",
                    "sense_definition": "Женские наружные половые органы.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "anatomy_slang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В неформальной грубой речи это слово иногда употребляется для обозначения женских половых органов.",
                            "target_lang_translations": {
                                "de": "In der derben Umgangssprache wird dieses Wort manchmal für die weiblichen Geschlechtsorgane verwendet."
                            }
                        },
                        {
                            "text": "Герой романа употребил слово <w>пирожок</w> в неприличном контексте во время спора.",
                            "target_lang_translations": {
                                "de": "Die Romanfigur verwendete während des Streits das Wort <w>Muschi</w> in einem unanständigen Kontext."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "вульгарный сленг"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Vulgärer Ausdruck für das weibliche Genital."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Muschi",
                                "target_lang_sense_clarification": "vulgär/umgangssprachlich für Vulva"
                            }
                        ]
                    }
                }
            ]
        }
    ]
