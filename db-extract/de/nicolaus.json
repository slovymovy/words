                                "sense_id": "016d6955-809c-3f87-94b5-1abc26a3e026",
                                "text": "Das ist Nicolaus’ Mantel."
                            },
                            {
                                "example_id": "78e6a304-19c3-448f-968d-3cd9aedfc37f",
                                "sense_id": "016d6955-809c-3f87-94b5-1abc26a3e026",
                                "text": "He, Nicolaus, komm mal her!"
                            },
                            {
                                "example_id": "ba2efb1a-6113-427b-b509-41d59836f9b8",
                                "sense_id": "016d6955-809c-3f87-94b5-1abc26a3e026",
                                "text": "Du kannst mit Nicolaus darüber sprechen."
                            },
                            {
                                "example_id": "3a95eebd-4328-4807-91f9-c0daaf2cb373",
                                "sense_id": "016d6955-809c-3f87-94b5-1abc26a3e026",
                                "text": "Ohne Nicolaus einen Ausflug zu machen, ist nur halb so spaßig."
