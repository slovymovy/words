{
    "word_family": [
        "whimpery"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d7138f5b-d2f5-3511-abf1-48d7b4908bc5",
                    "sense_definition": "To cry or sob softly and intermittently.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "crying",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lonely puppy began to <w>whimper</w> as soon as we left the room.",
                            "target_lang_translations": {
                                "pl": "Samotny szczeniak zaczął <w>skomleć</w>, gdy tylko wyszliśmy z pokoju."
                            }
                        },
                        {
                            "text": "The child started to <w>whimper</w> when the lights went out.",
                            "target_lang_translations": {
                                "pl": "Dziecko zaczęło <w>kwilić</w>, gdy zgasły światła."
                            }
                        }
                    ],
                    "synonyms": [
                        "mewl"
                    ],
                    "common_phrases": [
                        "softly whimper"
                    ],
                    "target_lang_definitions": {
                        "pl": "Płakać lub szlochać cicho i z przerwami."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "skomleć",
                                "target_lang_sense_clarification": "o zwierzętach wydających żałosne dźwięki"
                            },
                            {
                                "target_lang_word": "kwilić",
                                "target_lang_sense_clarification": "o niemowlętach lub cichym płaczu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f11f3fae-1bba-35b9-9370-e38b89ed4082",
                    "sense_definition": "To complain or whine in a low, broken voice.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "crying",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Do not <w>whimper</w> about the rules when you agreed to them earlier.",
                            "target_lang_translations": {
                                "pl": "Nie <w>skoml</w> o zasady, skoro zgodziłeś się na nie wcześniej."
                            }
                        },
                        {
                            "text": "He continued to <w>whimper</w> about his unfair treatment by the manager.",
                            "target_lang_translations": {
                                "pl": "Wciąż <w>skomlał</w> o swoim niesprawiedliwym traktowaniu przez kierownika."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Narzekać lub skarżyć się cichym, łamiącym się głosem."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "skomleć",
                                "target_lang_sense_clarification": "żałośnie prosić lub narzekać"
                            },
                            {
                                "target_lang_word": "kwilić",
                                "target_lang_sense_clarification": "skarżyć się w sposób cichy i żałosny"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d7ae76da-4bd6-3178-9861-338c5bdbe496",
                    "sense_definition": "To say something in a weak, fearful, or complaining manner.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "crying",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Master please do not punish me he <w>whimpered</w>.",
                            "target_lang_translations": {
                                "pl": "Panie, proszę, nie karz mnie – <w>skomlał</w>."
                            }
                        },
                        {
                            "text": "I do not want to die she <w>whimpers</w> while looking at the door.",
                            "target_lang_translations": {
                                "pl": "Nie chcę umierać – <w>kwili</w>, patrząc na drzwi."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Mówić coś w słaby, pełen strachu lub narzekający sposób."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "skomleć",
                                "target_lang_sense_clarification": "wyrażać strach lub uległość"
                            },
                            {
                                "target_lang_word": "jęczeć",
                                "target_lang_sense_clarification": "mówić w sposób pełen bólu lub narzekania"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c5aff1be-4c15-32f2-a269-25c9844b2efd",
                    "sense_definition": "A low, soft, and intermittent sound of crying or sobbing.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "crying",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I heard a faint <w>whimper</w> coming from the dark corner of the room.",
                            "target_lang_translations": {
                                "pl": "Usłyszałem ciche <w>skomlenie</w> dobiegające z ciemnego kąta pokoju."
                            }
                        },
                        {
                            "text": "The dog gave a small <w>whimper</w> when it saw the vet.",
                            "target_lang_translations": {
                                "pl": "Pies wydał z siebie ciche <w>skomlenie</w>, gdy zobaczył weterynarza."
                            }
                        }
                    ],
                    "common_phrases": [
                        "faint whimper"
                    ],
                    "target_lang_definitions": {
                        "pl": "Cichy, miękki i przerywany dźwięk płaczu lub szlochu."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "skomlenie",
                                "target_lang_sense_clarification": "dźwięk wydawany przez zwierzę lub osobę"
                            },
                            {
                                "target_lang_word": "kwilenie",
                                "target_lang_sense_clarification": "cichy, piskliwy dźwięk"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}