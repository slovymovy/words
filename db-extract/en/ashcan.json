                        "target_lang_word": "asbak",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "asbak",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "acf06be8-443f-3116-939f-1d4d809bc7c0",
                                        "entry_id": "dc231ca3-4747-34e3-9f71-692f4afa5fc4",
                                        "glosses": [
                                            "opvangbak voor as en peuken van sigaretten en sigaren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1df6c0e-dfda-47c4-b5fb-ccd1c2635e0d",
                                                "sense_id": "acf06be8-443f-3116-939f-1d4d809bc7c0",
                                                "text": "Vroeger waren er in de treinen en bussen asbakken aanwezig want in trein en bus mocht je gewoon roken."
                                            },
                                            {
                                                "example_id": "1f628adf-fe62-43b0-9b0b-c1e6960f0d8a",
                                                "sense_id": "acf06be8-443f-3116-939f-1d4d809bc7c0",
                                                "text": "Hockney houdt zijn sigaret omhoog, de askegel valt op de grond. ‘Heeft iemand een asbak voor David?’"
                                            },
                                            {
                                                "example_id": "5f3d7c1c-58cb-4044-8446-627df8708baa",
                                                "sense_id": "acf06be8-443f-3116-939f-1d4d809bc7c0",
                                                "text": "Ik drukte mijn sigaret uit in de bloempot die ons tot asbak had gediend. Hij deed hetzelfde en sprong overeind om zich over mijn bagage te ontfermen."
                                            },
                                            {
                                                "example_id": "d3c52f71-4515-4b48-9729-9806812b2376",
                                                "sense_id": "acf06be8-443f-3116-939f-1d4d809bc7c0",
                                                "text": "Daar staat de tafel waarop hij al zijn materialen heeft uitgestald: de monografieën, een asbak, een pakje sigaretten en de laptop."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "559c74b6-0d7f-4b3b-ab5e-aad7f2d2c0a4",
                        "source_entry_id": "8873502a-32e8-3d05-a532-b90b568a843c",
