                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "66c81514-bd8c-4e69-8c1e-d9ffb780e1d5",
                        "entry_id": "9eb88d12-b9b1-3247-92d9-5ab9fd3bc2a6",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
