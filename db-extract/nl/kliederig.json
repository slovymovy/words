                        "sense_id": "b290f3d4-4114-3a29-acf7-92f4022ad64c",
                        "entry_id": "d8c42062-cd19-367b-83ef-5092b7ffe14a",
                        "glosses": [
                            "heel slordig met een hoop bijkomende rotzooi"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e04008ac-b5f6-46b0-bcee-f4cf542637df",
                                "sense_id": "b290f3d4-4114-3a29-acf7-92f4022ad64c",
                                "text": "De kliederige schilderingen van de kinderen worden door de grootouders luidruchtig bewonderd, maar de moeder was nog dagen bezig om de vlekken uit het tapijt te krijgen."
                            },
                            {
                                "example_id": "d8f2b0fb-d693-489f-bc0b-e55efde6306c",
                                "sense_id": "b290f3d4-4114-3a29-acf7-92f4022ad64c",
                                "text": "Ondanks de transformatie van cabaret-act naar een serieuzere, meer tekstgerichte theatergroep heeft de groep zijn unieke signatuur behouden: smerig, luidruchtig, gewelddadig en kliederig. Als eresaluut hergebruikt Anna Schoen een Chaplin-achtige scène uit de eerste voorstelling: ze slaat koffiebonen op de vloer fijn met een hamer, zuigt ze op met een stofzuiger en zet koffie met de volle stofzuigerzak als filter."
                            }
                        ]
                    }
