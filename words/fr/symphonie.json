    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "278e6b1b-b3d4-3e86-8b95-9a6b9347a26c",
                    "sense_definition": "Grande composition musicale pour orchestre, généralement structurée en plusieurs mouvements.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "musique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'orchestre a joué la neuvième <w>symphonie</w> de Beethoven lors du concert d'hier soir."
                        },
                        {
                            "text": "Ce compositeur est célèbre pour avoir écrit sa première <w>symphonie</w> à dix-huit ans."
                        }
                    ],
                    "common_phrases": [
                        "mouvement d'une symphonie"
                    ]
                },
                {
                    "sense_id": "f65f9e10-5503-39f3-a8de-e61f48d1cb0d",
                    "sense_definition": "Ensemble harmonieux d'éléments divers produisant une vive impression sensorielle ou esthétique.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "harmonie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jardin en automne offrait aux promeneurs une véritable <w>symphonie</w> de couleurs chaudes."
                        },
                        {
                            "text": "Les chants des oiseaux au petit matin créaient une douce <w>symphonie</w> dans la forêt."
                        }
                    ],
                    "synonyms": [
                        "harmonie",
                        "accord"
                    ],
                    "antonyms": [
                        "cacophonie",
                        "dissonance"
                    ],
                    "common_phrases": [
                        "symphonie de couleurs"
                    ]
                },
                {
                    "sense_id": "a4afa092-4d12-3eac-bf0d-5c7eb0d848da",
                    "sense_definition": "Concert ou harmonie produite par plusieurs instruments jouant ensemble.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "musique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans ce salon ancien, une brillante <w>symphonie</w> d'instruments à cordes charmait les invités."
                        },
                        {
                            "text": "Le roi demanda une <w>symphonie</w> de flûtes et de violons pour accompagner le festin."
                        }
                    ],
                    "synonyms": [
                        "concert"
                    ],
                    "traits": [
