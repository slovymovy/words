                                    {
                                        "sense_id": "98a82aae-3472-34b1-9e1d-30d919db2fb2",
                                        "entry_id": "8e03e459-0069-3cdb-9ac9-fdfc85b83098",
                                        "glosses": [
                                            "het continent ten zuiden van Europa, tussen de Indische en de Atlantische Oceaan"
                                        ],
                                        "tags": [
                                            "toponymic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69690697-4935-40cf-b0a3-98a74a20bb42",
                                                "sense_id": "98a82aae-3472-34b1-9e1d-30d919db2fb2",
                                                "text": "Olive moest rillen van het bericht, maar ze troostte zich met de gedachte dat Isaac nog in de buurt was en het ook hoorde."
                                            },
                                            {
                                                "example_id": "e3dd2c6a-539d-42bf-af0e-201536abedfe",
                                                "sense_id": "98a82aae-3472-34b1-9e1d-30d919db2fb2",
                                                "text": "Zijn broer Oscar had op miraculeuze wijze, zo het al geen goddelijke voorzienigheid was, een aanzienlijk vermogen in Afrika verworven."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8578f281-a560-46eb-90a1-bb47c727a7d9",
                        "source_entry_id": "10da6af4-ce37-3ca2-912b-2f4953ec0d0f",
                        "source_sense_description": "continent",
                        "target_lang_word": "l’Afrique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
