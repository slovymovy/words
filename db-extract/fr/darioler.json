                "senses": [
                    {
                        "sense_id": "7a96089d-db58-325f-9503-03ef63f1266f",
                        "entry_id": "b3ee9424-4bce-3fa3-aa68-762eab4bdedc",
                        "glosses": [
                            "Chanter pour accompagner les bœufs qui marchent (pour les labours, par exemple)."
                        ],
                        "tags": [
                            "Vendée"
                        ],
                        "examples": [
                            {
                                "example_id": "90001a99-205b-4e6e-81c9-1fb3405f94a8",
                                "sense_id": "7a96089d-db58-325f-9503-03ef63f1266f",
                                "text": "Dochâgne dariolait étrangement comme, parfois, avec une sorte de colère."
                            },
                            {
                                "example_id": "585a4c7b-bbd0-42eb-bab3-65e9e21645b6",
                                "sense_id": "7a96089d-db58-325f-9503-03ef63f1266f",
                                "text": "On entendait partout les bouviers darioler"
                            },
                            {
                                "example_id": "f7139ea8-2405-4b8f-a2eb-47de42f8150f",
                                "sense_id": "7a96089d-db58-325f-9503-03ef63f1266f",
                                "text": "Ils sont une trentaine encore en Vendée à savoir « darioler »."
                            },
                            {
                                "example_id": "9a85a4c5-d2d5-47f8-8815-96ed39ae470c",
                                "sense_id": "7a96089d-db58-325f-9503-03ef63f1266f",
                                "text": "On entendait la mélopée lointaine des toucheurs de bœufs qui dariolaient au creux de leur interminable sillon de peine ..."
                            }
                        ]
                    }
                ],
