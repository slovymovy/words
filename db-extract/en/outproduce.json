                    {
                        "sense_id": "743054ce-98fd-38cd-a389-bfc6e72d4d50",
                        "entry_id": "17104922-a227-3a0c-ab19-be4d0babd079",
                        "glosses": [
                            "mehr als andere produzieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2253d64-70ab-44ea-9c62-fe2b6f52fde4",
                                "sense_id": "743054ce-98fd-38cd-a389-bfc6e72d4d50",
                                "text": "„If Americans spend their time meditating, energetic societies will outproduce and even \"bury\" us.“",
                                "translation": "Wenn die Amerikaner ihre Zeit meditierend verbringe, werden energetische Gesellschaft mehr produzieren und uns auch \"begraben\"."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "731ab7e2-aa84-420c-861a-6c6b28a76456",
                        "source_entry_id": "17104922-a227-3a0c-ab19-be4d0babd079",
                        "source_sense_id": "743054ce-98fd-38cd-a389-bfc6e72d4d50",
                        "source_sense_description": "mehr als andere produzieren",
                        "target_lang_word": "produzieren",
