                        "sense_id": "2bf3fb66-0de1-3d12-a55a-38859a6a4207",
                        "entry_id": "f30988a9-82f1-3e17-8dcf-55c3d50d4e0f",
                        "glosses": [
                            "Money in the form of coins made from precious metal that has an intrinsic value; coinage."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "cf9a4fd8-f86d-4ba3-b9be-74b8cc020b98",
                                "sense_id": "2bf3fb66-0de1-3d12-a55a-38859a6a4207",
                                "text": "I received one month's pay in specie while on the march to Virginia, in the year 1781, and except that, I never received any pay worth the name while I belonged to the army."
                            },
                            {
                                "example_id": "4f3f497d-7ff0-477c-8127-7436274f00ad",
                                "sense_id": "2bf3fb66-0de1-3d12-a55a-38859a6a4207",
                                "text": "‘It was not money or specie he thought himself hunting!’"
                            },
                            {
                                "example_id": "4163edd6-c6c2-45f4-b848-380c0f34860f",
                                "sense_id": "2bf3fb66-0de1-3d12-a55a-38859a6a4207",
                                "text": "“Dick” Counterfly had absquatulated swiftly into the night, leaving his son with only a pocketful of specie and the tender admonition, “Got to ‘scram,’ kid — write if you get work.”"
                            }
                        ]
                    }
