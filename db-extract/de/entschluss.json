                        "entry_id": "a9ea1a61-a1e4-3cc5-8263-e254544c6e94",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Entschluss"
                    },
                    {
                        "form_id": "3a03ade0-d985-4a91-90a9-060f97fd2914",
                        "entry_id": "a9ea1a61-a1e4-3cc5-8263-e254544c6e94",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Entschlüsse"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "eb73f8b8-004f-3332-9f5f-0d24153374da",
                        "entry_id": "a9ea1a61-a1e4-3cc5-8263-e254544c6e94",
                        "glosses": [
                            "eine Wahl aus mehreren Möglichkeiten; Entscheidung, der eine Überlegung vorausging"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "571caa88-c0ac-4a22-8bf1-1b02b536ed6d",
                                "sense_id": "eb73f8b8-004f-3332-9f5f-0d24153374da",
                                "text": "Ich kam zu dem Entschluss, doch kein neues Auto zu kaufen."
                            },
                            {
                                "example_id": "45a28e6f-6ba3-4223-b06d-de7fa8c9fbf0",
                                "sense_id": "eb73f8b8-004f-3332-9f5f-0d24153374da",
                                "text": "„Schließlich fasste ich einen Entschluss, den Entschluss wegzugehen.“"
                            },
                            {
                                "example_id": "68000db2-2782-4a12-828d-f99c4be607dc",
                                "sense_id": "eb73f8b8-004f-3332-9f5f-0d24153374da",
                                "text": "„Die ganze Nacht lag sie wach in ihrem Bett, warf sich hin und her und dachte über ihren Entschluss nach.“"
                            },
                            {
                                "example_id": "987b4fc9-865d-4c15-96a8-46b0be7f3cf7",
                                "sense_id": "eb73f8b8-004f-3332-9f5f-0d24153374da",
                                "text": "„Er wollte zu einem Entschluss kommen, aber er fühlte mit Schrecken, dass ihn in diesem Falle die Entschlussfähigkeit verlassen hatte, die er doch sonst an sich kannte und die auch tatsächlich in ihm steckte.“"
                            },
                            {
                                "example_id": "a78eab8c-36be-4be9-83d6-e174d316245d",
                                "sense_id": "eb73f8b8-004f-3332-9f5f-0d24153374da",
                                "text": "„»Für mich ist mit dieser Bundestagswahl eine rote Linie überschritten, und mein Entschluss steht fest: Ich werde Deutschland verlassen.«“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dd2c24ed-f7e9-417d-a85c-2448463f37be",
                        "source_entry_id": "a9ea1a61-a1e4-3cc5-8263-e254544c6e94",
                        "source_sense_id": "eb73f8b8-004f-3332-9f5f-0d24153374da",
                        "source_sense_description": "eine Wahl aus mehreren Möglichkeiten; Entscheidung, der eine Überlegung vorausging",
                        "target_lang_word": "decision",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "decision",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f9e981f7-f077-3dbf-94a0-ae01741f73a7",
                                        "entry_id": "3e2720f8-5d31-3350-b9bc-67546c699e68",
                                        "glosses": [
                                            "The act of deciding."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "88a0e303-7bb9-3320-9598-6deb65ca2e13",
                                        "entry_id": "3e2720f8-5d31-3350-b9bc-67546c699e68",
                                        "glosses": [
                                            "A choice or judgement."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3b131f4-a52a-450d-b9cd-37e271496237",
                                                "sense_id": "88a0e303-7bb9-3320-9598-6deb65ca2e13",
                                                "text": "It is the decision of the court that movies are protected as free speech."
                                            },
                                            {
                                                "example_id": "5ae22cf8-46e9-4d0c-ac99-b8484cd3d21a",
                                                "sense_id": "88a0e303-7bb9-3320-9598-6deb65ca2e13",
                                                "text": "His life has always been filled with big decisions."
                                            },
                                            {
                                                "example_id": "08807696-8667-41f3-ab04-bc0a3aeec550",
                                                "sense_id": "88a0e303-7bb9-3320-9598-6deb65ca2e13",
                                                "text": "It's a tough decision, but I'll take vanilla."
                                            },
                                            {
                                                "example_id": "80aa94fd-f5a0-4358-b6f1-71d1ed87cd02",
                                                "sense_id": "88a0e303-7bb9-3320-9598-6deb65ca2e13",
                                                "text": "I told him about my decision to leave forever."
                                            },
                                            {
                                                "example_id": "0d5bbd8e-9aa9-4ecb-97ce-d4a2a4ed965f",
                                                "sense_id": "88a0e303-7bb9-3320-9598-6deb65ca2e13",
                                                "text": "The US supreme court has ruled unanimously that natural human genes cannot be patented, a decision that scientists and civil rights campaigners said removed a major barrier to patient care and medical innovation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06b97490-7ed0-3af5-aab9-fe6c46cdd5d3",
                                        "entry_id": "3e2720f8-5d31-3350-b9bc-67546c699e68",
                                        "glosses": [
                                            "Firmness of conviction."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2179d8a-1b7a-4de9-ab59-ef7510214f4e",
                                                "sense_id": "06b97490-7ed0-3af5-aab9-fe6c46cdd5d3",
                                                "text": "After agonizing deliberations, they finally proceeded with decision."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "007f6e73-60ad-346d-81ec-969e562c26cd",
                                        "entry_id": "3e2720f8-5d31-3350-b9bc-67546c699e68",
                                        "glosses": [
                                            "A result arrived at by the judges when there is no clear winner at the end of the contest."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94e7897c-a241-4dd0-a184-60077e142231",
                                                "sense_id": "007f6e73-60ad-346d-81ec-969e562c26cd",
                                                "text": "He has won twice by knockout, once by decision."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2820979-6cc1-3cf9-9885-d273a0c16bfc",
                                        "entry_id": "3e2720f8-5d31-3350-b9bc-67546c699e68",
                                        "glosses": [
                                            "A win or a loss awarded to a pitcher."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
