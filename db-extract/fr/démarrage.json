                                "example_id": "cf08c6ca-75de-4c7b-9423-7a6f8dc22895",
                                "sense_id": "e365b5fb-e06f-30d3-9a1d-091a262047cc",
                                "text": "Cet ordinateur est lent au démarrage."
                            }
                        ]
                    }
