    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4eed703f-f0bf-3b54-9337-fc2dc31daf0b",
                    "sense_definition": "Ходить пешком на свежем воздухе ради отдыха или удовольствия.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "movement_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В хорошую погоду мы любим <гулять> в городском парке.",
                            "target_lang_translations": {
                                "en": "In good weather, we like to <walk> in the city park.",
                                "nl": "Bij mooi weer houden we ervan om in het stadspark te <wandelen>."
                            }
                        },
                        {
                            "text": "По вечерам соседи выходят <гулять> со своими собаками.",
                            "target_lang_translations": {
                                "en": "In the evenings, neighbors go out to <walk> their dogs.",
                                "nl": "’s Avonds gaan de buren <wandelen> met hun honden."
                            }
                        }
                    ],
                    "antonyms": [
                        "стоять",
                        "лежать"
                    ],
                    "common_phrases": [
                        "пойти гулять",
                        "гулять с собакой",
                        "гулять в парке",
                        "гулять пешком"
                    ],
                    "target_lang_definitions": {
                        "en": "To walk outdoors for leisure or pleasure.",
                        "nl": "Lopend naar buiten gaan voor ontspanning of plezier."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "walk",
                                "target_lang_sense_clarification": "general movement on foot"
                            },
                            {
                                "target_lang_word": "stroll",
                                "target_lang_sense_clarification": "walking in a leisurely way"
                            },
                            {
                                "target_lang_word": "go for a walk",
                                "target_lang_sense_clarification": "common phrase for the activity"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "wandelen",
                                "target_lang_sense_clarification": "algemene beweging te voet"
                            },
                            {
                                "target_lang_word": "gaan wandelen",
                                "target_lang_sense_clarification": "gebruikelijke uitdrukking voor de activiteit"
                            },
                            {
                                "target_lang_word": "een blokje om gaan",
                                "target_lang_sense_clarification": "een korte wandeling maken"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b9c4e97-47ae-33ce-ac50-6cbca41504e0",
                    "sense_definition": "Веселиться, развлекаться, отмечать праздник (часто с употреблением алкоголя).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "leisure_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Вся деревня три дня <гуляла> на шумной свадьбе.",
                            "target_lang_translations": {
                                "en": "The whole village <partied> at the noisy wedding for three days.",
                                "nl": "Het hele dorp heeft drie dagen lang <gefeest> op de luidruchtige bruiloft."
                            }
                        },
                        {
                            "text": "Студенты сдали последнюю сессию и <гуляли> до самого утра.",
                            "target_lang_translations": {
                                "en": "The students passed their last session and <partied> until the very morning.",
                                "nl": "De studenten hadden hun laatste examen gehaald en <feestten> tot in de vroege ochtend."
                            }
                        }
                    ],
                    "synonyms": [
                        "веселиться",
                        "развлекаться",
                        "кутить"
                    ],
                    "common_phrases": [
                        "гулять на свадьбе",
                        "гулять всю ночь",
                        "гулять на все"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To party, celebrate, or have a good time (often involving alcohol).",
                        "nl": "Feesten, vieren of een goede tijd hebben (vaak met alcohol)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "party",
                                "target_lang_sense_clarification": "to celebrate socially, often noisily"
                            },
                            {
                                "target_lang_word": "celebrate",
                                "target_lang_sense_clarification": "to observe a notable occasion"
                            },
                            {
                                "target_lang_word": "carouse",
                                "target_lang_sense_clarification": "to drink and enjoy oneself with others"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "feesten",
                                "target_lang_sense_clarification": "sociaal vieren, vaak luidruchtig"
                            },
                            {
                                "target_lang_word": "vieren",
                                "target_lang_sense_clarification": "een bijzondere gelegenheid observeren"
                            },
                            {
                                "target_lang_word": "doorzakken",
                                "target_lang_sense_clarification": "langdurig drinken en plezier maken"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "79635a60-cc3a-3a1d-91b5-d961a77128de",
                    "sense_definition": "Быть свободным от работы или учёбы, иметь выходной день.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "leisure_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Праздник пришёлся на четверг, так что мы <гуляем> четыре дня подряд.",
                            "target_lang_translations": {
                                "en": "The holiday fell on a Thursday, so we <are off> for four days in a row.",
                                "nl": "De feestdag viel op een donderdag, dus we <zijn> vier dagen achter elkaar <vrij>."
                            }
                        },
                        {
                            "text": "Начальник подписал отпуск, и теперь я <гуляю> целый месяц.",
                            "target_lang_translations": {
                                "en": "The boss signed the vacation request, and now I <am off> for a whole month.",
                                "nl": "De baas heeft mijn vakantieaanvraag getekend en nu <ben> ik een hele maand <vrij>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "завтра гуляем",
                        "гулять два дня"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To be free from work or study; to have time off.",
                        "nl": "Vrij zijn van werk of studie; vakantie of een vrije dag hebben."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "be off",
                                "target_lang_sense_clarification": "to not be at work"
                            },
                            {
                                "target_lang_word": "have time off",
                                "target_lang_sense_clarification": "to have a break from duties"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "vrij zijn",
                                "target_lang_sense_clarification": "niet aan het werk zijn"
                            },
                            {
                                "target_lang_word": "vrij hebben",
                                "target_lang_sense_clarification": "een pauze hebben van verplichtingen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d88c1efe-f719-349d-a1ce-228c7cdba7c9",
                    "sense_definition": "Встречаться с кем-либо, иметь романтические отношения.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "relationships_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Она <гуляла> с этим парнем ещё в старших классах школы.",
                            "target_lang_translations": {
                                "en": "She <dated> this guy back in high school.",
                                "nl": "Ze <date>de met die jongen al op de middelbare school."
                            }
                        },
                        {
                            "text": "Родители строго запрещали дочери <гулять> допоздна.",
                            "target_lang_translations": {
                                "en": "Parents strictly forbade their daughter to <go out> late.",
                                "nl": "Ouders verboden hun dochter streng om tot laat <uit te gaan>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "гулять с парнем",
                        "гулять с девушкой"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To meet with someone romantically; to be in a relationship.",
                        "nl": "Romantisch met iemand afspreken; een relatie hebben."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "date",
                                "target_lang_sense_clarification": "to go on dates or be in a relationship"
                            },
                            {
                                "target_lang_word": "go out",
                                "target_lang_sense_clarification": "to have a romantic relationship with someone"
                            },
                            {
                                "target_lang_word": "see",
                                "target_lang_sense_clarification": "to be dating someone"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "daten",
                                "target_lang_sense_clarification": "op dates gaan of een relatie hebben"
                            },
                            {
                                "target_lang_word": "verkering hebben",
                                "target_lang_sense_clarification": "een romantische relatie hebben"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "654c9e57-dfe7-38b9-8e15-d02578725961",
                    "sense_definition": "Изменять супругу или постоянному партнёру, иметь связи на стороне.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "relationships_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Все соседи знали, что её муж давно <гуляет>.",
                            "target_lang_translations": {
                                "en": "All the neighbors knew that her husband had been <cheating> for a long time.",
                                "nl": "Alle buren wisten dat haar man al lang <vreemdging>."
                            }
                        },
                        {
                            "text": "Он был примерным семьянином и никогда не <гулял> от жены.",
                            "target_lang_translations": {
                                "en": "He was a model family man and never <cheated> on his wife.",
                                "nl": "Hij was een voorbeeldige huisvader en <ging> nooit <vreemd> buiten zijn vrouw om."
                            }
                        }
                    ],
                    "common_phrases": [
                        "муж гуляет",
                        "гулять от жены",
                        "гулять налево"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To cheat on a spouse or partner; to have an affair.",
                        "nl": "Vreemdgaan; een buitenechtelijke relatie hebben."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cheat",
                                "target_lang_sense_clarification": "to be sexually unfaithful"
                            },
                            {
                                "target_lang_word": "have an affair",
                                "target_lang_sense_clarification": "to have a sexual relationship outside marriage"
                            },
                            {
                                "target_lang_word": "sleep around",
                                "target_lang_sense_clarification": "to have many sexual partners"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "vreemdgaan",
                                "target_lang_sense_clarification": "seksueel ontrouw zijn"
                            },
                            {
                                "target_lang_word": "een affaire hebben",
                                "target_lang_sense_clarification": "een seksuele relatie buiten het huwelijk"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fac5b09e-2fce-3247-ab16-112f4c875d21",
                    "sense_definition": "Свободно перемещаться в разных направлениях (о ветре, сквозняке, волнах).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В старом деревянном доме по полу постоянно <гуляли> сквозняки.",
                            "target_lang_translations": {
                                "en": "Drafts constantly <blew> along the floor in the old wooden house.",
                                "nl": "In het oude houten huis <tochtte> het constant over de vloer."
                            }
                        },
                        {
                            "text": "Холодный ветер свободно <гулял> по пустому полю.",
                            "target_lang_translations": {
                                "en": "A cold wind <roamed> freely across the empty field.",
                                "nl": "Een koude wind <waaide> vrij over het lege veld."
                            }
                        }
                    ],
                    "antonyms": [
                        "застыть"
                    ],
                    "common_phrases": [
                        "ветер гуляет",
                        "сквозняк гуляет",
                        "волны гуляют"
                    ],
                    "target_lang_definitions": {
                        "en": "To move freely in different directions (of wind, drafts, or waves).",
                        "nl": "Vrij bewegen in verschillende richtingen (van wind, tocht of golven)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "blow",
                                "target_lang_sense_clarification": "movement of air"
                            },
                            {
                                "target_lang_word": "roam",
                                "target_lang_sense_clarification": "to move about without a fixed destination"
                            },
                            {
                                "target_lang_word": "wander",
                                "target_lang_sense_clarification": "to move casually through a space"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "waaien",
                                "target_lang_sense_clarification": "beweging van lucht"
                            },
                            {
                                "target_lang_word": "tochten",
                                "target_lang_sense_clarification": "luchtstroom in een ruimte"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "55c2efc9-315d-32cd-bfd4-86f44a8525c7",
                    "sense_definition": "Находиться в бездействии, не использоваться (о механизмах, земле или помещении).",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Дорогой станок <гуляет> без работы уже целую неделю.",
                            "target_lang_translations": {
                                "en": "The expensive machine has been <sitting idle> without work for a whole week.",
                                "nl": "De dure machine <staat> al een hele week <stil> zonder werk."
                            }
                        },
                        {
                            "text": "Плодородная земля не должна <гулять> без обработки.",
                            "target_lang_translations": {
                                "en": "Fertile land should not <lie idle> without cultivation.",
                                "nl": "Vruchtbare grond mag niet onbewerkt <blijven liggen>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "земля гуляет",
                        "станок гуляет"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To be idle or unused (of mechanisms, land, or spaces).",
                        "nl": "Niet in gebruik zijn of stilstaan (van machines, land of ruimtes)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lie idle",
                                "target_lang_sense_clarification": "to remain unused"
                            },
                            {
                                "target_lang_word": "sit idle",
                                "target_lang_sense_clarification": "to not be in operation"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "stilstaan",
                                "target_lang_sense_clarification": "niet in bedrijf zijn"
                            },
                            {
                                "target_lang_word": "ongebruikt blijven",
                                "target_lang_sense_clarification": "niet benut worden"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bd1020a7-ccb0-372d-8604-59c31dff71ae",
                    "sense_definition": "Не спать, бодрствовать в то время, когда положено спать (обычно о маленьких детях).",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Маленький ребёнок ночью долго <гулял> и не давал родителям спать.",
                            "target_lang_translations": {
                                "en": "The small child <stayed awake> for a long time at night and didn't let the parents sleep.",
                                "nl": "Het kleine kind <bleef> 's nachts lang <wakker> en liet de ouders niet slapen."
                            }
                        },
                        {
                            "text": "Если младенец выспится днём, то ночью он будет <гулять>.",
                            "target_lang_translations": {
                                "en": "If the baby sleeps enough during the day, then at night he will <be awake>.",
                                "nl": "Als de baby overdag genoeg slaapt, zal hij 's nachts <wakker zijn>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To stay awake when one should be sleeping (usually of small children).",
                        "nl": "Wakker blijven wanneer men zou moeten slapen (meestal van kleine kinderen)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stay awake",
                                "target_lang_sense_clarification": "to remain conscious"
                            },
                            {
                                "target_lang_word": "be up",
                                "target_lang_sense_clarification": "to not be in bed sleeping"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "wakker zijn",
                                "target_lang_sense_clarification": "niet slapen"
                            },
                            {
                                "target_lang_word": "op zijn",
                                "target_lang_sense_clarification": "niet in bed liggen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
