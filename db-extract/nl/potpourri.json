                                        "sense_id": "e9288f05-a18f-3849-821f-96654b2d1dbb",
                                        "entry_id": "da19b054-133c-3894-b7ac-66538ed0d313",
                                        "glosses": [
                                            "Combat, fighting; a battle."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80ce10a2-1df1-485e-ad34-db47535b7c8f",
                                                "sense_id": "e9288f05-a18f-3849-821f-96654b2d1dbb",
                                                "text": "Thenne came the kyng of Irland and the kynge of the stryete marches to rescowe syre Tristram and sire Palomydes / There beganne a grete medle / & many knyghtes were smyten doune on bothe partyes / and alweyes sir launcelot spared sir Tristram / and he spared hym"
                                            },
                                            {
                                                "example_id": "d619dd41-ae51-4c62-81b5-586a6383a373",
                                                "sense_id": "e9288f05-a18f-3849-821f-96654b2d1dbb",
                                                "text": "For greater shields they have, than that they can either doe or see ought, and being raunged by hundreds no doubt they will hinder one another in the medley, except some very few"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bcdb60e6-918c-300b-b4b9-774c3cf31155",
                                        "entry_id": "da19b054-133c-3894-b7ac-66538ed0d313",
                                        "glosses": [
                                            "A collection or mixture of miscellaneous things."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b05c7ba-8ea9-475c-854f-f73e241871a7",
                                                "sense_id": "bcdb60e6-918c-300b-b4b9-774c3cf31155",
                                                "text": "a fruit medley"
                                            },
                                            {
                                                "example_id": "4ac8abb1-f997-4890-a90a-50f03e9a5241",
                                                "sense_id": "bcdb60e6-918c-300b-b4b9-774c3cf31155",
                                                "text": "this medley of philosophy and war"
                                            },
                                            {
                                                "example_id": "78882b93-9780-46bd-8bca-bfabb4bee1c5",
                                                "sense_id": "bcdb60e6-918c-300b-b4b9-774c3cf31155",
                                                "text": "Love is a medley of endearments, jars, / Suspicions, reconcilements, wars."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "200c5543-7b08-3b46-b9f3-6084e946aeff",
                                        "entry_id": "da19b054-133c-3894-b7ac-66538ed0d313",
                                        "glosses": [
                                            "A collection of related songs played or mixed together as a single piece."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9f6135e-3994-4fdc-bfd8-76f2d81a826d",
                                                "sense_id": "200c5543-7b08-3b46-b9f3-6084e946aeff",
                                                "text": "They played a medley of favorite folk songs as an encore."
                                            }
                                        ]
