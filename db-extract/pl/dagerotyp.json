                    {
                        "translation_id": "c90a415f-fd8e-45a2-b569-b1d448cc561d",
                        "source_entry_id": "96b25e6e-b1d8-3fba-90df-d515699a7f6d",
                        "source_sense_id": "b2705293-2b4a-3331-899e-ad5fe7b74e24",
                        "target_lang_word": "Daguerreotypie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Daguerreotypie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f8e715dd-84c4-3d0b-bc47-4b68e91e4b0c",
                                        "entry_id": "c2a0eb3e-d85b-33b9-8794-218f5185d054",
                                        "glosses": [
                                            "fotografisches Positiv-Verfahren des 19. Jahrhunderts"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66f97c30-b4b7-42f6-a8df-0f594bde3739",
                                                "sense_id": "f8e715dd-84c4-3d0b-bc47-4b68e91e4b0c",
                                                "text": "Claudia beschäftigt sich seit einiger Zeit mit der Daguerreotypie."
                                            },
                                            {
                                                "example_id": "f2dc1f78-1de9-4a71-b09e-77674d71f3e3",
                                                "sense_id": "f8e715dd-84c4-3d0b-bc47-4b68e91e4b0c",
                                                "text": "„Erstellt wurde das Bild in der frühen Fotografietechnik der Daguerreotypie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ef67ef60-ac18-356f-8203-7f620aff25fc",
                                        "entry_id": "c2a0eb3e-d85b-33b9-8794-218f5185d054",
                                        "glosses": [
                                            "mit dem Verfahren von [1] hergestelltes Foto"
                                        ],
                                        "tags": [
                                            "Fototechnik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5eb380a-3af4-472c-a388-c1412778cf39",
                                                "sense_id": "ef67ef60-ac18-356f-8203-7f620aff25fc",
                                                "text": "Für die Herstellung einer Daguerreotypie werden Silberplatten oder versilberte Kupferplatten verwendet."
                                            },
                                            {
                                                "example_id": "db815d7f-937b-4561-a194-02a3ce8fec60",
                                                "sense_id": "ef67ef60-ac18-356f-8203-7f620aff25fc",
                                                "text": "„Da sich von der Daguerreotypie keine weiteren Abzüge machen ließen, wurde sie in den 1870er Jahren durch das in England erfundene Negativ-Positiv-Verfahren verdrängt.“"
                                            },
                                            {
                                                "example_id": "f813c112-256f-4bd5-b0dd-437816c293f3",
                                                "sense_id": "ef67ef60-ac18-356f-8203-7f620aff25fc",
                                                "text": "„Sie ging oft in seinem Arbeitszimmer auf und ab und setzte sich an seinen Schreibtisch, auf dem eine Daguerreotypie von ihm stand.“"
                                            },
                                            {
                                                "example_id": "dec7780c-0996-42ee-836a-485c87a19219",
                                                "sense_id": "ef67ef60-ac18-356f-8203-7f620aff25fc",
                                                "text": "„Die einzige Daguerreotypie, die es von ihm gibt, stammt aus dieser letzten Zeit und zeigt einen hohlwangigen, depressiven Kranken.“"
                                            },
                                            {
                                                "example_id": "04027078-9459-4422-946d-eb99a8dc90e9",
                                                "sense_id": "ef67ef60-ac18-356f-8203-7f620aff25fc",
                                                "text": "„August schenkte ihm eine Daguerreotypie von Guddas Grab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e4098274-c6a6-45bc-9b04-77c45a3f5e7f",
                        "source_entry_id": "96b25e6e-b1d8-3fba-90df-d515699a7f6d",
                        "source_sense_id": "b2705293-2b4a-3331-899e-ad5fe7b74e24",
                        "target_lang_word": "дагероти́п",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "дагероти́п",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "c33696c1-17c7-3adc-b06d-8dfa1bd2ef17",
                                        "entry_id": "7be69a7c-7f49-3a57-a285-faf72038a6a9",
                                        "glosses": [
                                            "фотогр. то же, что дагерротип, снимок, сделанный методом дагерротипии"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0c462a8-9fdf-4c65-91f5-aebddb2b7610",
                                                "sense_id": "c33696c1-17c7-3adc-b06d-8dfa1bd2ef17",
                                                "text": "В гостиной, где стояла белая мебель, и на скатерти стола, расшитой розами, лежали тома старых журналов, желтый паркет выливался из наклонного зеркала в овальной раме, и дагеротипы на стенах слушали, как оживало и пело белое пианино."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "10213cbd-f9d2-4dfd-831b-3c0ddc1bc30b",
                        "source_entry_id": "96b25e6e-b1d8-3fba-90df-d515699a7f6d",
                        "source_sense_id": "b2705293-2b4a-3331-899e-ad5fe7b74e24",
                        "target_lang_word": "дагерроти́п",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "дагерроти́п",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "4ec45517-96b8-3dbe-87df-102815b6e526",
                                        "entry_id": "b71d357d-2685-3041-9713-d8af2f10eac6",
                                        "glosses": [
                                            "фотогр. снимок, сделанный способом дагерротипии"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb50a924-659e-4d16-8df1-ef1b50ac86a9",
                                                "sense_id": "4ec45517-96b8-3dbe-87df-102815b6e526",
                                                "text": "Дагерротип моей старинной приятельницы, перенося меня на тридцать лет назад, оживляет для меня то незабвенное время."
                                            },
                                            {
                                                "example_id": "899ab31d-360c-4f9d-8089-ef70418ec7c1",
                                                "sense_id": "4ec45517-96b8-3dbe-87df-102815b6e526",
                                                "text": "Дагерротип с артистического семейства и о том, как приятно проводить время в таких семействах"
                                            },
                                            {
                                                "example_id": "ebfdcc00-d3ce-481b-9c26-aeeb41555fde",
                                                "sense_id": "4ec45517-96b8-3dbe-87df-102815b6e526",
                                                "text": "Теперь минувшее его уже не мучило: сны помнятся недолго, и лишь два случая из тех дней запечатлелись в сознании четко, словно дагерротип."
                                            },
                                            {
                                                "example_id": "c466f5b8-65fd-4883-8ae6-274e6f8731a9",
                                                "sense_id": "4ec45517-96b8-3dbe-87df-102815b6e526",
                                                "text": "Нынешние фото выполнены «под дагерротип» — как в прошлом веке снимались все подряд, но выглядят гораздо более парадно, чем камерные и небольшие портреты из музейного собрания."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
