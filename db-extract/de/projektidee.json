                "senses": [
                    {
                        "sense_id": "6a2cd8c2-ba61-3ff5-83dd-4fc5861a451c",
                        "entry_id": "01e5376e-b3c3-323a-9221-22cc1c14e378",
                        "glosses": [
                            "Idee zur Durchführung eines Projekts"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea9d318d-d9fb-423b-8c71-ba01f25c476e",
                                "sense_id": "6a2cd8c2-ba61-3ff5-83dd-4fc5861a451c",
                                "text": "„Vor einem Monat hat er mit einer Projektidee zu weichen Skulpturen einen Wettbewerb gewonnen und darf bei der Internationalen Biennale in Norwegen ausstellen.“"
                            },
                            {
                                "example_id": "c1995e31-1575-49ec-91c5-74a240061376",
                                "sense_id": "6a2cd8c2-ba61-3ff5-83dd-4fc5861a451c",
                                "text": "„Am Ende sollen neue, mutige Projektideen entstehen, die von großer gesellschaftlicher Relevanz sind.“"
                            },
                            {
                                "example_id": "f214fea6-b930-4a03-a381-18e71a6624d9",
                                "sense_id": "6a2cd8c2-ba61-3ff5-83dd-4fc5861a451c",
                                "text": "„Eine Projektidee war die schiffbare Verbindung zwischen dem Altdöberner und dem Großräschener See, die aufgrund der geologischen Voraussetzungen schwer umsetzbar ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
