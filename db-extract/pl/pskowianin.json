                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a8686b0-e9cf-42ce-861a-9b455e24e720",
                                "sense_id": "36a3eb5a-c9de-3dc2-a698-ba668b419a17",
                                "text": "W lutym 1217 roku nowogrodzianie i pskowianie ścigając rabujących Litwinów dotarli do Estonii, gdzie doszło do starć z Niemcami, w wyniku których zawarto rozejm z mistrzem Volquinem"
                            }
                        ],
