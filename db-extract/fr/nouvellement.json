        "fr-extract.jsonl": [
            {
                "entry_id": "448611ec-2ef3-34df-89f3-aa4a0a4c8e8b",
                "word": "nouvellement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5511e6bc-fe39-3fca-9e73-93b54302c128",
                        "entry_id": "448611ec-2ef3-34df-89f3-aa4a0a4c8e8b",
                        "glosses": [
                            "Depuis peu de temps."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63980336-ffe7-46e2-9979-5e7ef41ab9e2",
                                "sense_id": "5511e6bc-fe39-3fca-9e73-93b54302c128",
                                "text": "Elles s’attendrissaient surtout à la vue de la mère Agnès de Saint-Paul, qu’on enlevait ainsi à l’âge de soixante-treize ans, accablée d’infirmités, et qui avait eu tout nouvellement trois attaques d’apoplexie."
                            },
                            {
                                "example_id": "0526872b-0645-4acc-8d1b-5d73fd1d30c7",
                                "sense_id": "5511e6bc-fe39-3fca-9e73-93b54302c128",
                                "text": "M. Frédéric Moreau, nouvellement reçu bachelier, s’en retournait à Nogent-sur-Seine, où il devait languir pendant deux mois, avant d’aller faire son droit."
                            },
                            {
                                "example_id": "aca1459c-6395-4759-b40d-c5167558d01f",
                                "sense_id": "5511e6bc-fe39-3fca-9e73-93b54302c128",
                                "text": "Son fils ainé Claude de Rochebaron abandonna le château de Montarcher devenu ruineux, pour la maison-forte nouvellement construite de Marandière, à Estivareilles, où se voient ses armes et la date de 1468."
                            },
                            {
                                "example_id": "96dda1f2-9a50-4e5c-a7cb-fa3c612f7124",
                                "sense_id": "5511e6bc-fe39-3fca-9e73-93b54302c128",
                                "text": "Jullouville, en tant que commune, n'existe que depuis 1972, date à laquelle la cité nouvellement créée incluait Bouillon, Saint-Michel-des-Loups, Carolles et Saint-Pair. Cette dernière ville devait d'ailleurs s'en retirer dès 1978."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "59fa1277-762d-4d89-8b3e-38be9361fb16",
                        "source_entry_id": "448611ec-2ef3-34df-89f3-aa4a0a4c8e8b",
                        "source_sense_id": "5511e6bc-fe39-3fca-9e73-93b54302c128",
                        "target_lang_word": "neulich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "neulich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ebf55754-4e5d-34f0-85dc-bad677b654e3",
                                        "entry_id": "c184383e-c409-3eff-bfd7-280dc32c57f7",
                                        "glosses": [
                                            "vor nicht langer Zeit; vor Kurzem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "317b17ec-ddc0-4e33-83f8-dcae3aa39f04",
                                                "sense_id": "ebf55754-4e5d-34f0-85dc-bad677b654e3",
                                                "text": "Neulich traf ich doch mal wieder Peter im Schwimmbad!"
                                            },
                                            {
                                                "example_id": "a069e890-d491-4758-874a-40617f9a9777",
                                                "sense_id": "ebf55754-4e5d-34f0-85dc-bad677b654e3",
                                                "text": "„Neulich bei einem Abendessen hinter bodentiefen Fenstern mokierte sich eine Bekannte über all jene, die mit der EU nichts anfangen können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "748281d3-8679-490b-b016-5c71dce51852",
                        "source_entry_id": "448611ec-2ef3-34df-89f3-aa4a0a4c8e8b",
                        "source_sense_id": "5511e6bc-fe39-3fca-9e73-93b54302c128",
                        "target_lang_word": "kürzlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kürzlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5c0e8afb-771f-31b8-8be5-d3bb64ef3d00",
                                        "entry_id": "fe806816-7fde-380b-9df3-c55e26610838",
                                        "glosses": [
                                            "vor kurzem, vor Kurzem, vor nicht langer Zeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9798e141-4e52-483a-a88e-615373b72961",
                                                "sense_id": "5c0e8afb-771f-31b8-8be5-d3bb64ef3d00",
                                                "text": "Das Buch ist kürzlich erschienen."
                                            },
                                            {
                                                "example_id": "db967591-cdf4-4dc4-b95f-a38c05b24275",
                                                "sense_id": "5c0e8afb-771f-31b8-8be5-d3bb64ef3d00",
                                                "text": "„Vor dem Hintergrund des kürzlich großangelegten Konzernumbaus sollen 11.600 Stellen gestrichen werden, um die Kosten um eine Milliarde zu senken.\""
                                            },
                                            {
                                                "example_id": "80265ff5-63bd-4210-9555-fff05b4e8265",
                                                "sense_id": "5c0e8afb-771f-31b8-8be5-d3bb64ef3d00",
                                                "text": "„Zudem wird ihn Extremkletterer Stefan Glowacz, kürzlich Gast beim Nationalteam, gewarnt haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "kürzlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "287a2ed8-2874-3c7e-9da1-0166a2f3d6bb",
                                        "entry_id": "5887f37c-e711-3070-b629-d4e83dd4828f",
                                        "glosses": [
                                            "vor Kurzem, vor nicht langer Zeit erfolgt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b43484b4-d4f8-4824-b7b0-d8934af3ea75",
                                                "sense_id": "287a2ed8-2874-3c7e-9da1-0166a2f3d6bb",
                                                "text": "„Als Ursache für diese IgM-Antikörper bei klinisch unauffälligen schwangeren Frauen kommen uncharakteristische kürzliche akute bzw. länger zurückliegende Infektionen, kürzliche bzw. länger zurückliegende Impfungen, Reinfektionen nach früherer Impfung und langpersistierende IgM-Antikörper nach früherer Infektion oder Impfung bzw. kreuzreagierende IgM-Antikörper in Betracht.“"
                                            },
                                            {
                                                "example_id": "4aeba35d-2e63-4184-b495-3b62d561b386",
                                                "sense_id": "287a2ed8-2874-3c7e-9da1-0166a2f3d6bb",
                                                "text": "„In anderen Fächergruppen, wie Pädagogik, Gesundheit und Sozialwesen sowie Geisteswissenschaften und Künste, nimmt der Anteil der Frauen zwischen Master- und Promotionsbildungsgängen zwar ab, dennoch bilden Frauen immer noch die Mehrzahl der kürzlichen Absolventen von Promotionsbildungsgängen.“"
                                            },
                                            {
                                                "example_id": "7d6f2811-2479-432f-8db6-590616d780f2",
                                                "sense_id": "287a2ed8-2874-3c7e-9da1-0166a2f3d6bb",
                                                "text": "„Falls kürzlicher Krankheitsbeginn, sollte zur Verlaufskontrolle eine weitere Blutprobe untersucht werden.“"
                                            },
                                            {
                                                "example_id": "69475a3b-3ccb-4839-a247-3cdbbd0b6e02",
                                                "sense_id": "287a2ed8-2874-3c7e-9da1-0166a2f3d6bb",
                                                "text": "„Nun ist aber das Trennungs-Gesetz für die Kirche unannehmbar, und es ist klar, daß Herrn Briand’s kürzliches Rundschreiben ebenso wie seine beiden früheren Zirkulare sich nicht auf öffentlichen Gottesdienst beziehen können; […]“"
                                            },
                                            {
                                                "example_id": "bac9249d-fe08-4f4a-8221-17f476f62f60",
                                                "sense_id": "287a2ed8-2874-3c7e-9da1-0166a2f3d6bb",
                                                "text": "„Man warf ihm vor, er schlage Kapital aus Landrys kürzlichem Tod, und lachte nur über die Versicherungen tiefster Zuneigung zu Landry, die Somés Sprecher an seiner statt abgab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "57ff3698-dcaf-4eac-8fec-ad8ad61436b0",
                        "source_entry_id": "448611ec-2ef3-34df-89f3-aa4a0a4c8e8b",
                        "source_sense_id": "5511e6bc-fe39-3fca-9e73-93b54302c128",
                        "target_lang_word": "unlängst",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unlängst",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "75df4963-0c7d-3c7c-90ed-e1a4d9302c7b",
                                        "entry_id": "7e83ef3c-e338-35c8-82fe-5206b85997d7",
                                        "glosses": [
                                            "vor nicht allzu langer Zeit"
                                        ],
                                        "tags": [
                                            "gehoben"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07dce771-eebe-45c4-8692-a2497b0b47f2",
                                                "sense_id": "75df4963-0c7d-3c7c-90ed-e1a4d9302c7b",
                                                "text": "„Da ist zum Beispiel der Fall, mit dem sich unlängst das Bundesverfassungsgericht beschäftigen musste. Es erklärte ein Bußgeld gegen Eltern für rechtmäßig, nachdem sie ihre Kinder wiederholt nicht zur Schule geschickt hatten.“"
                                            },
                                            {
                                                "example_id": "022a6d4d-c779-4337-bdf5-cd28ceb61688",
                                                "sense_id": "75df4963-0c7d-3c7c-90ed-e1a4d9302c7b",
                                                "text": "„Die vielen Windräder seiner ostfriesischen Heimat vermisse er, bekannte er unlängst.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "43e05264-ae30-46e4-a988-5d718fd8d540",
                        "source_entry_id": "448611ec-2ef3-34df-89f3-aa4a0a4c8e8b",
                        "source_sense_id": "5511e6bc-fe39-3fca-9e73-93b54302c128",
