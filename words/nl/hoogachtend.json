{
    "word_family": [
        "hoogachten",
        "hoogachting",
        "achten",
        "achting"
    ],
    "entries": [
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "a33f003f-01f9-38cf-9ad0-209582de9573",
                    "sense_definition": "een formele afsluiting van een brief of e-mail, gevolgd door de handtekening",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "briefafsluiting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik verblijf met de meeste hoogachting, <w>hoogachtend</w>, Jan de Vries.",
                            "target_lang_translations": {
                                "en": "I remain with the highest regard, <w>yours faithfully</w>, Jan de Vries."
                            }
                        },
                        {
                            "text": "In een officiële brief aan de gemeente eindig je meestal met <w>hoogachtend</w>.",
                            "target_lang_translations": {
                                "en": "In an official letter to the municipality, you usually end with <w>yours sincerely</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "met vriendelijke groet"
                    ],
                    "common_phrases": [
                        "hoogachtend de uwe"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "gebruikt in formele correspondentie"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "a formal closing for a letter or email, followed by a signature"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Yours faithfully",
                                "target_lang_sense_clarification": "formal closing when the recipient is unknown"
                            },
                            {
                                "target_lang_word": "Yours sincerely",
                                "target_lang_sense_clarification": "formal closing when the recipient is known"
                            },
                            {
                                "target_lang_word": "Respectfully yours",
                                "target_lang_sense_clarification": "very formal closing"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "138aab33-7571-3e58-8f0e-b030b3ffd836",
                    "sense_definition": "met veel respect of waardering voor iemand",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "respect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De leerling sprak op een <w>hoogachtende</w> manier over zijn oude leraar.",
                            "target_lang_translations": {
                                "en": "The student spoke in a <w>respectful</w> manner about his old teacher."
                            }
                        },
                        {
                            "text": "Zij koestert <w>hoogachtende</w> gevoelens voor de prestaties van haar collega.",
                            "target_lang_translations": {
                                "en": "She cherishes <w>reverent</w> feelings for her colleague's achievements."
                            }
                        }
                    ],
                    "synonyms": [
                        "respectvol",
                        "eerbiedig"
                    ],
                    "antonyms": [
                        "minachtend"
                    ],
                    "target_lang_definitions": {
                        "en": "with a lot of respect or appreciation for someone"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "respectful",
                                "target_lang_sense_clarification": "showing politeness and honor"
                            },
                            {
                                "target_lang_word": "reverent",
                                "target_lang_sense_clarification": "showing deep and solemn respect"
                            },
                            {
                                "target_lang_word": "deferential",
                                "target_lang_sense_clarification": "showing respect and humble submission"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "80e941e8-0b74-3539-8b3e-b5d8e21e9ad4",
                    "sense_definition": "onvoltooid deelwoord van <w>hoogachten</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De directeur, zijn personeel zeer <w>hoogachtend</w>, gaf iedereen een extra bonus.",
                            "target_lang_translations": {
                                "en": "The director, <w>esteeming</w> his staff very highly, gave everyone an extra bonus."
                            }
                        },
                        {
                            "text": "Al <w>hoogachtend</w> keek hij naar het indrukwekkende kunstwerk in de galerij.",
                            "target_lang_translations": {
                                "en": "While <w>respecting</w> it, he looked at the impressive artwork in the gallery."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "present participle of 'to highly esteem' or 'to respect'"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "esteeming",
                                "target_lang_sense_clarification": "holding in high regard"
                            },
                            {
                                "target_lang_word": "respecting",
                                "target_lang_sense_clarification": "having a high opinion of someone"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}