{
    "word_family": [
        "commitment",
        "committal",
        "committee",
        "committer",
        "noncommittal",
        "recommit"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9a5a48b1-fcee-3cf8-9048-cc6c8d488588",
                    "sense_definition": "To do something illegal, immoral, or harmful.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "wrongdoing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police are investigating the man who decided to <w>commit</w> a serious crime last night.",
                            "target_lang_translations": {
                                "ru": "Полиция расследует дело человека, который решил <w>совершить</w> тяжкое преступление прошлой ночью.",
                                "zh": "警方正在调查昨晚决定<w>犯</w>下重罪的那名男子。"
                            }
                        },
                        {
                            "text": "It is a tragedy when someone feels so hopeless that they choose to <w>commit</w> suicide.",
                            "target_lang_translations": {
                                "ru": "Это трагедия, когда кто-то чувствует себя настолько безнадежным, что решает <w>совершить</w> самоубийство.",
                                "zh": "当一个人感到如此绝望而选择<w>自杀</w>时，这真是一场悲剧。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "commit a crime",
                        "commit murder",
                        "commit suicide",
                        "commit adultery"
                    ],
                    "target_lang_definitions": {
                        "ru": "Совершить что-либо незаконное, аморальное или вредное.",
                        "zh": "指做出违法、不道德或有害的行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "совершать",
                                "target_lang_sense_clarification": "преступление или ошибку"
                            },
                            {
                                "target_lang_word": "совершить",
                                "target_lang_sense_clarification": "законченное действие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "犯",
                                "target_lang_sense_clarification": "指犯罪或错误"
                            },
                            {
                                "target_lang_word": "做",
                                "target_lang_sense_clarification": "指坏事"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eb409cdc-19ab-31eb-a34d-541908ba97d9",
                    "sense_definition": "To make a firm decision or promise to do something, or to dedicate oneself to a person or cause.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "pledge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Before you start the project, you must <w>commit</w> to a certain action to ensure its success.",
                            "target_lang_translations": {
                                "ru": "Прежде чем начать проект, вы должны <w>взять на себя обязательство</w> выполнить определенное действие, чтобы гарантировать его успех.",
                                "zh": "在开始项目之前，你必须<w>承诺</w>采取某种行动以确保其成功。"
                            }
                        },
                        {
                            "text": "He was a perennial bachelor who was always afraid to <w>commit</w> to a relationship.",
                            "target_lang_translations": {
                                "ru": "Он был вечным холостяком, который всегда боялся <w>связывать себя обязательствами</w> в отношениях.",
                                "zh": "他是个老光棍，总是害怕<w>投入</w>一段感情。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "commit to a relationship",
                        "commit oneself to",
                        "fully commit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Принять твердое решение или дать обещание сделать что-либо, либо посвятить себя человеку или делу.",
                        "zh": "做出坚定的决定或承诺，或全身心投入到某人或某事中。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обязываться",
                                "target_lang_sense_clarification": "брать на себя обязательство"
                            },
                            {
                                "target_lang_word": "связывать себя обязательством",
                                "target_lang_sense_clarification": "в отношениях или деле"
                            },
                            {
                                "target_lang_word": "посвящать себя",
                                "target_lang_sense_clarification": "цели или человеку"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "承诺",
                                "target_lang_sense_clarification": "做出保证"
                            },
                            {
                                "target_lang_word": "投入",
                                "target_lang_sense_clarification": "指全身心致力于某事"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8947aa88-c1f4-3298-94fa-effb67d580b0",
                    "sense_definition": "To give something over to the care or possession of another; to entrust.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "entrust",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dying man decided to <w>commit</w> his soul to the Lord during his final prayer.",
                            "target_lang_translations": {
                                "ru": "Умирающий решил <w>вверить</w> свою душу Господу во время своей последней молитвы.",
                                "zh": "那位垂死的老人在临终祈祷时决定将灵魂<w>托付</w>给主。"
                            }
                        },
                        {
                            "text": "If the book contains only illusions, you should <w>commit</w> it to the flames immediately.",
                            "target_lang_translations": {
                                "ru": "Если в книге одни лишь иллюзии, вам следует немедленно <w>предать</w> её огню.",
                                "zh": "如果这本书里全是幻象，你应该立即将其<w>付</w>之一炬。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "commit to memory",
                        "commit to paper",
                        "commit to the flames"
                    ],
                    "target_lang_definitions": {
                        "ru": "Передать что-либо под опеку или во владение другому; доверить.",
                        "zh": "将某物托付给他人照管或保管；委托。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вверять",
                                "target_lang_sense_clarification": "поручать что-то ценное"
                            },
                            {
                                "target_lang_word": "предавать",
                                "target_lang_sense_clarification": "например, огню или земле"
                            },
                            {
                                "target_lang_word": "запечатлеть",
                                "target_lang_sense_clarification": "в памяти или на бумаге"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "托付",
                                "target_lang_sense_clarification": "委托给他人"
                            },
                            {
                                "target_lang_word": "交付",
                                "target_lang_sense_clarification": "交给某人处理"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "302dbf18-babc-357a-b169-972bdd499429",
                    "sense_definition": "To make a set of data changes permanent in a database or version control system.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Once the SQL statements are successful, the transaction is <w>committed</w> to the database permanently.",
                            "target_lang_translations": {
                                "ru": "Как только SQL-запросы выполнены успешно, транзакция окончательно <w>фиксируется</w> в базе данных.",
                                "zh": "一旦SQL语句执行成功，该事务就会被永久<w>提交</w>到数据库中。"
                            }
                        },
                        {
                            "text": "You should <w>commit</w> changes frequently to avoid losing any of your hard work.",
                            "target_lang_translations": {
                                "ru": "Вам следует часто <w>фиксировать</w> изменения, чтобы не потерять результаты своего упорного труда.",
                                "zh": "你应该频繁地<w>提交</w>更改，以免丢失辛苦完成的工作。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "commit changes",
                        "commit a transaction"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделать набор изменений данных постоянным в базе данных или системе контроля версий.",
                        "zh": "在数据库或版本控制系统中使一组数据更改永久生效。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фиксировать",
                                "target_lang_sense_clarification": "изменения в БД"
                            },
                            {
                                "target_lang_word": "коммитить",
                                "target_lang_sense_clarification": "профессиональный жаргон"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "提交",
                                "target_lang_sense_clarification": "数据库事务提交"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "09a5bb42-101d-31c9-93bd-446541a3e01a",
                    "sense_definition": "To forcibly send someone to a medical facility for treatment, especially for mental health issues.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "confinement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The family had no choice but to <w>commit</w> him to a psychiatric hospital for his own safety.",
                            "target_lang_translations": {
                                "ru": "У семьи не было другого выбора, кроме как <w>поместить</w> его в психиатрическую больницу ради его собственной безопасности.",
                                "zh": "为了他自己的安全，家人别无选择，只能将他<w>强制送入</w>精神病院。"
                            }
                        },
                        {
                            "text": "After the breakdown, the doctors decided to <w>commit</w> the patient for further evaluation.",
                            "target_lang_translations": {
                                "ru": "После нервного срыва врачи решили <w>направить</w> пациента на дальнейшее обследование.",
                                "zh": "在精神崩溃后，医生决定将该患者<w>收治</w>入院以进行进一步评估。"
                            }
                        }
                    ],
                    "synonyms": [
                        "5150",
                        "section"
                    ],
                    "common_phrases": [
                        "commit to a hospital",
                        "be committed"
                    ],
                    "target_lang_definitions": {
                        "ru": "Принудительно отправить кого-либо в медицинское учреждение для лечения, особенно психического.",
                        "zh": "强制将某人送往医疗机构接受治疗，尤指精神健康问题。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "помещать",
                                "target_lang_sense_clarification": "в лечебное учреждение"
                            },
                            {
                                "target_lang_word": "направлять на принудительное лечение",
                                "target_lang_sense_clarification": "официально"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "强制送医",
                                "target_lang_sense_clarification": "指精神病院"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5682ad53-73f0-3864-b9d8-26b68da7fb5a",
                    "sense_definition": "To officially send someone to prison or jail.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "confinement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The judge ordered the court to <w>commit</w> the conspirators to the castle for their crimes.",
                            "target_lang_translations": {
                                "ru": "Судья приказал суду <w>заключить</w> заговорщиков в замок за их преступления.",
                                "zh": "法官下令法院因阴谋者的罪行将其<w>监禁</w>在城堡中。"
                            }
                        },
                        {
                            "text": "He was <w>committed</w> to prison to await his trial next month.",
                            "target_lang_translations": {
                                "ru": "Он был <w>заключен</w> в тюрьму в ожидании суда в следующем месяце.",
                                "zh": "他被<w>关进</w>监狱，等待下个月的审判。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "commit to prison",
                        "commit to jail"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официально отправить кого-либо в тюрьму.",
                        "zh": "正式将某人送入监狱。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заключать под стражу",
                                "target_lang_sense_clarification": "официальный арест"
                            },
                            {
                                "target_lang_word": "сажать",
                                "target_lang_sense_clarification": "в тюрьму"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "监禁",
                                "target_lang_sense_clarification": "正式入狱"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b6be70b7-3447-3cdd-bfc3-9a559032f179",
                    "sense_definition": "To upload new code revisions to a master version of a file in a repository.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The developer needs to <w>commit</w> the new code to the repository before the deadline.",
                            "target_lang_translations": {
                                "ru": "Разработчику необходимо <w>закоммитить</w> новый код в репозиторий до дедлайна.",
                                "zh": "开发人员需要在截止日期前将新代码<w>提交</w>到存储库。"
                            }
                        },
                        {
                            "text": "Make sure you check in your work and <w>commit</w> the latest revisions today.",
                            "target_lang_translations": {
                                "ru": "Обязательно проверьте свою работу и <w>зафиксируйте</w> последние изменения сегодня.",
                                "zh": "确保你今天签入工作并<w>提交</w>最新的修订版本。"
                            }
                        }
                    ],
                    "synonyms": [
                        "check in"
                    ],
                    "common_phrases": [
                        "commit code",
                        "commit to repository"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Загрузить новые версии кода в основную версию файла в репозитории.",
                        "zh": "将新的代码修订版本上传到存储库中的主版本。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "коммитить",
                                "target_lang_sense_clarification": "отправлять код"
                            },
                            {
                                "target_lang_word": "фиксировать",
                                "target_lang_sense_clarification": "версию кода"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "提交",
                                "target_lang_sense_clarification": "代码提交"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b8c176ed-40fa-3eb3-92fe-4e1ef3bb6e6a",
                    "sense_definition": "The act of making a permanent change to a database or a specific recorded change in version control.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "computing_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Every Git <w>commit</w> represents a single, atomic changeset compared to the previous state.",
                            "target_lang_translations": {
                                "ru": "Каждый <w>коммит</w> в Git представляет собой единое атомарное изменение по сравнению с предыдущим состоянием.",
                                "zh": "每一个Git<w>提交</w>都代表了与先前状态相比的一个单一的原子变更集。"
                            }
                        },
                        {
                            "text": "The server provides objects to manage synchronization independently of transaction <w>commits</w>.",
                            "target_lang_translations": {
                                "ru": "Сервер предоставляет объекты для управления синхронизацией независимо от <w>фиксаций</w> транзакций.",
                                "zh": "服务器提供对象来管理同步，而无需依赖事务<w>提交</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "git commit",
                        "database commit"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт внесения постоянного изменения в базу данных или конкретное записанное изменение в системе контроля версий.",
                        "zh": "在数据库中进行永久更改的行为，或版本控制中记录的特定更改。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фиксация",
                                "target_lang_sense_clarification": "изменений"
                            },
                            {
                                "target_lang_word": "коммит",
                                "target_lang_sense_clarification": "в программировании"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "提交",
                                "target_lang_sense_clarification": "指一次提交操作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "da36a502-bd2e-30bb-89c4-7b79db6ea140",
                    "sense_definition": "The submission of source code or material to a repository.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "computing_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team lead reviewed every <w>commit</w> made to the project over the weekend.",
                            "target_lang_translations": {
                                "ru": "Тимлид проверил каждый <w>коммит</w>, сделанный в проекте за выходные.",
                                "zh": "团队负责人审查了周末期间对项目所做的每一次<w>提交</w>。"
                            }
                        },
                        {
                            "text": "A frequent <w>commit</w> is better than one giant update at the end of the week.",
                            "target_lang_translations": {
                                "ru": "Частая <w>фиксация</w> изменений лучше, чем одно гигантское обновление в конце недели.",
                                "zh": "频繁的<w>提交</w>比周末一次性的大规模更新要好。"
                            }
                        }
                    ],
                    "synonyms": [
                        "check-in"
                    ],
                    "common_phrases": [
                        "source code commit"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отправка исходного кода или материалов в репозиторий.",
                        "zh": "向存储库提交源代码或材料。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "коммит",
                                "target_lang_sense_clarification": "набор изменений"
                            },
                            {
                                "target_lang_word": "отправка",
                                "target_lang_sense_clarification": "кода в репозиторий"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "提交",
                                "target_lang_sense_clarification": "指提交的代码内容"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c39c9ad0-463c-363a-ac86-5a146f5b245b",
                    "sense_definition": "A person, typically an athlete, who has pledged to attend a specific college or university.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The university is excited about their latest <w>commit</w>, a star quarterback from Texas.",
                            "target_lang_translations": {
                                "ru": "Университет в восторге от своего последнего <w>новичка</w>, звездного квотербека из Техаса.",
                                "zh": "大学对他们最新的<w>签约运动员</w>——一位来自德克萨斯州的明星四分卫——感到非常兴奋。"
                            }
                        },
                        {
                            "text": "As a high school <w>commit</w>, she already knows which campus she will call home next year.",
                            "target_lang_translations": {
                                "ru": "Как <w>абитуриентка, давшая согласие</w>, она уже знает, какой кампус станет её домом в следующем году.",
                                "zh": "作为一名已<w>签约</w>的高中生，她已经知道明年哪个校区将成为她的家。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "college commit",
                        "verbal commit"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "US"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, обычно спортсмен, который обязался поступить в определенный колледж или университет.",
                        "zh": "指已承诺进入特定大学或学院的人，通常指运动员。"
                    },
                    "translations": {
