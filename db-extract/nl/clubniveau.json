                        "examples": [
                            {
                                "example_id": "9939bcf2-432b-484d-b767-ae8678ab3921",
                                "sense_id": "f517ae2e-eab3-3056-89d2-f585cbca7359",
                                "text": "\"Natuurlijk zou het Marcel Brands kunnen worden. Hij heeft in elk geval op hoog clubniveau gewerkt. Zeker is dat het een bepalende rol is, met het oog op het benoemen van een bondscoach. Ik weet alleen niet of Brands het zelf zou willen.\""
                            },
                            {
                                "example_id": "9ea9f9a8-62e2-487b-9c79-e999e1f4eb0a",
                                "sense_id": "f517ae2e-eab3-3056-89d2-f585cbca7359",
                                "text": "Lukaku is niet alleen op clubniveau een veelbesproken naam, ook bij het nationale elftal maakt hij indruk. Met 64 doelpunten staat de voetballer op eenzame hoogte op de topscorerslijst aller tijden. Eden Hazard volgt met 32 doelpunten voor de Rode Duivels. Op het laatste EK maakte Lukaku vier doelpunten."
                            }
                        ]
