                                            {
                                                "example_id": "1ceb72fc-9af8-4153-a3b7-0203eee4228e",
                                                "sense_id": "b5116ed0-72d6-3545-a53e-257277e67ebe",
                                                "text": "It augered into the water and vanishedunder the surface only to float up again, its keel pointing skyward."
                                            },
                                            {
                                                "example_id": "e934d746-d4d7-4fb5-9eba-25bc7b5bd9ec",
                                                "sense_id": "b5116ed0-72d6-3545-a53e-257277e67ebe",
                                                "text": "There was no way to measure progress inside the sphere, to know whether it spun or leapt or wobbled like a top as it augered through the years."
                                            },
                                            {
                                                "example_id": "29e383ea-09c3-4cf8-9b39-240ef5b88ab4",
                                                "sense_id": "b5116ed0-72d6-3545-a53e-257277e67ebe",
                                                "text": "It augers down again behind him to gyre like a mindless deadly battling top."
                                            }
                                        ]
