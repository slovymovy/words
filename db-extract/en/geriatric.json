                ],
                "translations": [
                    {
                        "translation_id": "cffff89b-9d8c-4c23-a24a-eeb99bd805e9",
                        "source_entry_id": "626f221f-3b4a-3e5d-85ae-8f3d8fe9a7fd",
                        "source_sense_id": "76bfbe59-69cd-322c-b2fa-50203c2fcc5c",
                        "source_sense_description": "slang: old person",
                        "target_lang_word": "Greis",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Greis",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7ecf5733-bca9-315f-a114-c6a63b7598b7",
                                        "entry_id": "cd94d810-f2e0-3e85-9291-b4c6a3f4e2ef",
                                        "glosses": [
                                            "sehr alter Mensch, meist Mann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ae4e08c-2c27-472e-9624-2fa77a8f4756",
                                                "sense_id": "7ecf5733-bca9-315f-a114-c6a63b7598b7",
                                                "text": "Nachdem ich Ludwig 1922 aus den Augen verloren hatte, traf ich ihn erst 72 Jahre später wieder, als er schon ein Greis war."
                                            },
                                            {
                                                "example_id": "839b7f90-1f50-4a1e-81d0-75b42ef31d47",
                                                "sense_id": "7ecf5733-bca9-315f-a114-c6a63b7598b7",
                                                "text": "„Heute amüsiert man sich königlich darüber, wenn man liest, daß etwa der große deutsche Philosoph Immanuel Kant in der Laudatio der Königsberger Universität zu seinem 50. (!) Geburtstag mit ‚Ehrwürdiger Greis‘ angesprochen wurde.“"
                                            },
                                            {
                                                "example_id": "054474f5-09c8-4294-98b4-71596c447ecc",
                                                "sense_id": "7ecf5733-bca9-315f-a114-c6a63b7598b7",
                                                "text": "„Den mümmelnden Greis gibt es nicht mehr. Er trägt Implantate.“"
                                            },
                                            {
                                                "example_id": "05854b98-65ed-4bb7-b9f9-567248b8fd4c",
                                                "sense_id": "7ecf5733-bca9-315f-a114-c6a63b7598b7",
                                                "text": "„Der parfümierte Greis schwang sich rittlings auf einen Stuhl und blieb uns zugekehrt, als ich Lena aufzuknöpfen begann.“"
                                            },
                                            {
                                                "example_id": "0e500622-8f5c-4d9d-ab4c-ba36b23808f8",
                                                "sense_id": "7ecf5733-bca9-315f-a114-c6a63b7598b7",
                                                "text": "„Pierre war auf den Korridor gegangen und sah den halb wahnsinnigen Greis mitleidig und angeekelt zugleich an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
