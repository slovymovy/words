                "senses": [
                    {
                        "sense_id": "30dd3a97-9944-37eb-ab6c-fd0a5a447017",
                        "entry_id": "4cdb1472-1105-3c70-b105-32c48d92037f",
                        "glosses": [
                            "Donner un caractère misérable à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89a8b479-fb8a-4204-afe3-2a42735e0334",
                                "sense_id": "30dd3a97-9944-37eb-ab6c-fd0a5a447017",
                                "text": "Je vais pas vous misérabiliser ma bluette, soyez sans crainte."
                            },
                            {
                                "example_id": "b5dae115-ccdb-4e93-b8c0-eeacb44e9b2d",
                                "sense_id": "30dd3a97-9944-37eb-ab6c-fd0a5a447017",
                                "text": "A quoi bon misérabiliser nos cultures pour l’étalage de richesses de quelques fonctionnaires défiscalisés, recyclés dans l’art de ne rien faire, de ne rien décider, dans l’art de ne contrarier personne."
                            },
                            {
                                "example_id": "bc10a141-1899-4df4-a102-23af37d86498",
                                "sense_id": "30dd3a97-9944-37eb-ab6c-fd0a5a447017",
                                "text": "Arrêtons de misérabiliser le rugby si l'on veut que les jeunes viennent à ce sport."
                            }
                        ]
                    }
