        "fr-extract.jsonl": [
            {
                "entry_id": "6409cf12-090b-3511-a3fb-4bf8b3c93769",
                "word": "Martini",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "566be149-ecf6-3a9f-a1f4-c4ae13fcac20",
                        "entry_id": "6409cf12-090b-3511-a3fb-4bf8b3c93769",
                        "glosses": [
                            "Nom de famille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7a6f100-44e6-46ae-875d-9811ee02a831",
                                "sense_id": "566be149-ecf6-3a9f-a1f4-c4ae13fcac20",
                                "text": "Ce qui est recherché, c’est l’abolition du contrôle, et donc de la résistance, résume Hervé Martini, médecin addictologue et président de l’association Addictions France."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "f808c7bb-3cd5-3f86-a119-bd1abb121d46",
                "word": "Martini",
                "pos": "name",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "bdf34c98-9c50-487a-b2f7-d5426c5fcbb4",
                        "entry_id": "f808c7bb-3cd5-3f86-a119-bd1abb121d46",
