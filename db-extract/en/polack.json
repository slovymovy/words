                    {
                        "sense_id": "e0277e7e-a9d0-3131-8197-b72057ce77bb",
                        "entry_id": "c4301c44-24c1-393f-a40c-bf37630d7230",
                        "glosses": [
                            "Polák; Pšonek"
                        ],
                        "tags": [
