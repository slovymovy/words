                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "094618e6-5421-4ddc-a992-265e14c548d4",
                                                "sense_id": "a31ecb5a-6a76-3140-ad28-a21efc05f4ef",
                                                "text": "In zijn rede maakte hij gewag van grote vorderingen in zijn onderzoek."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f5cdb8b-d7af-3903-b114-2fe58d9e866a",
                                        "entry_id": "46c05467-48ea-3ea9-8eec-563092b759cd",
                                        "glosses": [
                                            "een ankerplaats buitengaats"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fb429d7-ba31-489c-abb8-e3cd11d7cb9d",
                                                "sense_id": "6f5cdb8b-d7af-3903-b114-2fe58d9e866a",
                                                "text": "Goeree is genoemd naar de goede rede die er te vinden was."
                                            },
                                            {
                                                "example_id": "8867550b-48db-478d-9b25-d4ff25bdde2b",
                                                "sense_id": "6f5cdb8b-d7af-3903-b114-2fe58d9e866a",
                                                "text": "Het duurde lang en was lastig omdat het schip slechts een paar uur aan de kade kon aanmeren en zich daarna terug moest trekken en voor anker moest gaan liggen op de rede."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
