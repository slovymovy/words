                ],
                "senses": [
                    {
                        "sense_id": "e9110789-6f5f-3fd9-96ee-9632fdbbdfac",
                        "entry_id": "e31acb54-0e50-3a46-bc62-71d014f567e2",
                        "glosses": [
                            "мед. свойственный коме, характерный для комы, либо имеющий к этому состоянию организма иное непосредственное отношение"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "762c9323-04d2-449e-b0bf-5d41a1e38a70",
                                "sense_id": "e9110789-6f5f-3fd9-96ee-9632fdbbdfac",
                                "text": "Коматозный мозг отреагировал на внешние раздражители."
                            },
                            {
                                "example_id": "10db5b53-f569-4a7c-b53c-6af73b7bfd19",
                                "sense_id": "e9110789-6f5f-3fd9-96ee-9632fdbbdfac",
                                "text": "К коматозным методам относят инсулинокоматозную, атропинокоматозную и электросудорожную терапию."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "18cb94c6-9c8f-4006-a5d8-ae2d0f5e20b5",
                        "source_entry_id": "e31acb54-0e50-3a46-bc62-71d014f567e2",
                        "source_sense_id": "e9110789-6f5f-3fd9-96ee-9632fdbbdfac",
                        "target_lang_word": "comatose",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "comatose",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "56caea77-d541-3092-8a82-26b1abdfd8c5",
                                        "entry_id": "7d90226c-7603-3301-9817-ca1169cedfe9",
                                        "glosses": [
                                            "In a coma: unconscious."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26ab0a27-8b95-4b35-9dec-fd2fd94a0448",
                                                "sense_id": "56caea77-d541-3092-8a82-26b1abdfd8c5",
                                                "text": "the patient was comatose for 2 weeks before finally passing away."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "193629c9-71ee-305c-8468-e55c15f32f7e",
                                        "entry_id": "7d90226c-7603-3301-9817-ca1169cedfe9",
                                        "glosses": [
                                            "Drowsy or lethargic."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e69dba92-aec4-4c69-99b7-93cf9757721d",
                                                "sense_id": "193629c9-71ee-305c-8468-e55c15f32f7e",
                                                "text": "Weary of big Sunday dinners that leave you feeling comatose (and result in your having to spend Sunday evening scrubbing the kitchen)?"
                                            },
                                            {
                                                "example_id": "426144bd-1a4e-4569-8ac9-2b00d6683827",
                                                "sense_id": "193629c9-71ee-305c-8468-e55c15f32f7e",
                                                "text": "The thought of food snapped her out of her comatose demeanor."
                                            },
                                            {
                                                "example_id": "6423d65b-dd22-4014-a0e8-1c9974cea94f",
                                                "sense_id": "193629c9-71ee-305c-8468-e55c15f32f7e",
                                                "text": "I felt comatose, passing time instead of living as passions went unfulfilled."
                                            },
                                            {
                                                "example_id": "7cc8bf3b-21ef-486b-9ee2-dbaab732fdd8",
                                                "sense_id": "193629c9-71ee-305c-8468-e55c15f32f7e",
                                                "text": "But most of all I'm sick of feeling comatose, like I'm walking through a fog."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8fd67571-e058-3054-b3b5-c3493bfa1982",
                                        "entry_id": "7d90226c-7603-3301-9817-ca1169cedfe9",
                                        "glosses": [
                                            "Fast asleep."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "979fa793-4fcb-4e69-b8eb-fe6261265b01",
                                                "sense_id": "8fd67571-e058-3054-b3b5-c3493bfa1982",
                                                "text": "She was lying comatose on the sofa."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "comatose",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d7a4a90b-659a-3575-8f36-812e270945ed",
                                        "entry_id": "d87124bf-e9fb-3f56-92e1-9e39cd6416fb",
                                        "glosses": [
                                            "To make comatose; to send into, or as if into, a coma."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "nonstandard",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52424742-4284-4739-95c4-a171b9205aa0",
                                                "sense_id": "d7a4a90b-659a-3575-8f36-812e270945ed",
                                                "text": "killing everybody is a stupid idea, and comatosing everybody is equally so."
                                            },
                                            {
                                                "example_id": "43629503-674d-4439-8c1a-7d6396cd0553",
                                                "sense_id": "d7a4a90b-659a-3575-8f36-812e270945ed",
                                                "text": "[Liverpool is] #1 in the league for murdering and comatosing fans of othe rclubs."
                                            },
                                            {
                                                "example_id": "b15e3085-ad9e-4653-ade1-1053c699c725",
                                                "sense_id": "d7a4a90b-659a-3575-8f36-812e270945ed",
                                                "text": "Then slipping on my silky dernier and tights, g-strings sculpted my voluptuous cheeks, brassiere comatosing my wobbly knockers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
