                "senses": [
                    {
                        "sense_id": "b4358dc5-aa66-3fae-8821-0d7ff06440c1",
                        "entry_id": "9abe6f4e-3ddf-3ec4-b86d-610211722fa4",
                        "glosses": [
                            "(generally in the plural) round facial cheeklet with a fresh rosy complexion"
                        ],
                        "tags": [
                            "humorous",
                            "informal",
                            "neuter",
