                        ],
                        "examples": [
                            {
                                "example_id": "afe86325-1fbf-4e5f-9eec-dad382f1852e",
                                "sense_id": "e2313d52-eb11-3ccc-833f-722c8d6baa27",
                                "text": "Het rapen van de eieren van de kievit is een traditie in Friesland."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "43f36cb8-55db-4405-9711-e2e3f7c0b1b4",
                        "source_entry_id": "4f3e0fd4-8e81-3efe-a70b-e5e7ea73ce9c",
                        "source_sense_id": "e2313d52-eb11-3ccc-833f-722c8d6baa27",
                        "target_lang_word": "Kiebitz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kiebitz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c5fdbecd-721c-33bc-8878-84d50129de79",
                                        "entry_id": "4898d284-84ba-3984-a792-8813b51175fb",
                                        "glosses": [
                                            "Regenpfeifer aus der Gattung Vanellus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74297010-b339-4aab-bf25-196bd51fa2da",
                                                "sense_id": "c5fdbecd-721c-33bc-8878-84d50129de79",
                                                "text": "Der Steppenkiebitz ist einer der seltensten Kiebitze der Welt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "672f19d9-8782-34a1-be2f-79757add7320",
                                        "entry_id": "4898d284-84ba-3984-a792-8813b51175fb",
                                        "glosses": [
                                            "der heimische , ein Vogel mit aufrichtbarer schwarzer Federhaube"
                                        ],
                                        "tags": [
                                            "special"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba78f262-babc-4ba1-a3d2-23cab64fc565",
                                                "sense_id": "672f19d9-8782-34a1-be2f-79757add7320",
                                                "text": "Der Kiebitz ist bei den Strandwanderern sehr beliebt."
                                            },
                                            {
                                                "example_id": "d270dc32-a8b1-413c-b7b2-e17317ede723",
                                                "sense_id": "672f19d9-8782-34a1-be2f-79757add7320",
                                                "text": "Der Kiebitz war der Vogel des Jahres 1996; 2001 wurde er auf die Rote Liste gefährdeter Arten gesetzt."
                                            },
                                            {
                                                "example_id": "cbcc72e6-0998-42bb-9aa8-97b2af26b00a",
                                                "sense_id": "672f19d9-8782-34a1-be2f-79757add7320",
                                                "text": "„Kiebitze hatten sich längst aus der Sperrzone verzogen, ebenso waren die Fasane ausgewandert und die wilden, auf Stille angewiesenen Kaninchen.“"
                                            },
                                            {
                                                "example_id": "367804c2-578e-436b-9c04-4a4578b05df4",
                                                "sense_id": "672f19d9-8782-34a1-be2f-79757add7320",
                                                "text": "„In einem goldenen Schild ein, auf einem grünen Ast mit daran hängender grüner Weintraube sitzender naturfarbener Kiebitz.“"
                                            },
                                            {
                                                "example_id": "b8cab2f0-71d5-4f1e-af29-764cc95b4687",
                                                "sense_id": "672f19d9-8782-34a1-be2f-79757add7320",
                                                "text": "„Die Schatten schreckten die Kiebitze in ihren Nestern auf, sodass die Jungs mit etwas Glück die zurückgelassenen Eier finden konnten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Kiebitz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7f0dc763-e4ba-33c4-83a1-59fd1072f335",
                                        "entry_id": "d6c4a8ba-fa15-30a2-949b-fe637ca6326e",
                                        "glosses": [
                                            "Zuschauer beim Kartenspiel, störender Zuschauer und Ratgeber beim Schachspiel"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71167343-2e7d-4d6a-ba8b-f163e4b67878",
                                                "sense_id": "7f0dc763-e4ba-33c4-83a1-59fd1072f335",
                                                "text": "„Quetschke war ein Genie, er war Hellseher. Wenn er in der Friedenszeit beim Skatspiel als Kiebitz riet: »August, riskier’s,« und August riskierte es, gewann er das Spiel oft wider Erwarten; wenn Quetschke aber abriet: »August, lasse die Hand davon,« und August wagte das Spiel dennoch, dann kam er ins Minus.“"
                                            },
                                            {
                                                "example_id": "c29484ab-aeb1-4d91-8c6c-f0fc43a6a766",
                                                "sense_id": "7f0dc763-e4ba-33c4-83a1-59fd1072f335",
                                                "text": "„Er sah, daß dem Kiebitz beide Füße fehlten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ad710822-33dc-4b7e-9608-ecd8cf2db121",
                        "source_entry_id": "4f3e0fd4-8e81-3efe-a70b-e5e7ea73ce9c",
                        "source_sense_id": "e2313d52-eb11-3ccc-833f-722c8d6baa27",
                        "target_lang_word": "lapwing",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lapwing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eb135a1d-e3b9-38c1-8edb-53f0f357bb78",
                                        "entry_id": "71cd9f5d-d1f3-3196-9a85-db970c5cfc90",
                                        "glosses": [
                                            "Any of several medium-sized wading birds belonging to the subfamily Vanellinae, within family Charadriidae."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ac01722-3583-4c5b-96ec-5cf59f722021",
                                                "sense_id": "eb135a1d-e3b9-38c1-8edb-53f0f357bb78",
                                                "text": "Plovers and lapwings are a large, virtually worldwide family that differs from sandpipers in, among other things, having a shorter, thicker, pigeonlike bill and more robust proportions."
                                            },
                                            {
                                                "example_id": "be746146-5b92-488e-ac82-0d571d4192f7",
                                                "sense_id": "eb135a1d-e3b9-38c1-8edb-53f0f357bb78",
                                                "text": "The resident tropical plovers have much less pointed wings, and most of the lapwings have fairly rounded wing-tips, a wing shape apparently more adapted to aerial manoeuvrability than to long-distance migration."
                                            },
                                            {
                                                "example_id": "cdd60c97-3fcd-4fd9-86db-8c63fbf7299d",
                                                "sense_id": "eb135a1d-e3b9-38c1-8edb-53f0f357bb78",
                                                "text": "Lapwings are abundant winter visitors to the area but, like the Golden Plovers, vary greatly in number between years."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95805823-772f-3e1c-94bb-d3047ae779aa",
                                        "entry_id": "71cd9f5d-d1f3-3196-9a85-db970c5cfc90",
                                        "glosses": [
                                            "Any of several medium-sized wading birds belonging to the subfamily Vanellinae, within family Charadriidae.",
                                            "The northern lapwing (Vanellus vanellus)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d769b315-98db-36ef-bccd-081dd9606dd4",
                                        "entry_id": "71cd9f5d-d1f3-3196-9a85-db970c5cfc90",
                                        "glosses": [
                                            "A silly man."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9b2086b-9745-46cc-8a5c-4784a08edfdb",
                                                "sense_id": "d769b315-98db-36ef-bccd-081dd9606dd4",
                                                "text": "This lapwing runs away with the shell on his head."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d0d5844f-d1f8-4671-a64b-aaa737b1f8e3",
