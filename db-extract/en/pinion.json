                                                "example_id": "34064ae5-4cf9-40a3-821d-72d0621eacd1",
                                                "sense_id": "e8e3f648-93c6-3471-8999-7a54160ed668",
                                                "text": "Die Gefangenen werden gefesselt."
                                            },
                                            {
                                                "example_id": "7b1d4ae1-4cc5-4d0e-8c08-10ad2d7f1799",
                                                "sense_id": "e8e3f648-93c6-3471-8999-7a54160ed668",
                                                "text": "Das vergewaltigte Opfer wurde verängstigt sowie an Händen und Füßen an ein Bett gefesselt von der Polizei aufgefunden."
                                            },
                                            {
                                                "example_id": "e0a2c44d-5eea-49a8-bb33-9a145738595e",
                                                "sense_id": "e8e3f648-93c6-3471-8999-7a54160ed668",
                                                "text": "Werden Menschen zu stark gefesselt, so können sie alleine dadurch gefoltert werden."
                                            },
                                            {
                                                "example_id": "0ad0bb5a-8a0c-4259-b0b4-b43247f4bcb2",
                                                "sense_id": "e8e3f648-93c6-3471-8999-7a54160ed668",
                                                "text": "Mit Handschellen gefesselt wurde die verurteilte Person aus dem Gerichtsgebäude herausgeführt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
