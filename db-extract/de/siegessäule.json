                ],
                "senses": [
                    {
                        "sense_id": "4208afe8-edf3-378f-b8cd-92653e5b4ff3",
                        "entry_id": "3a060874-7348-3dcd-afdc-cd9e56979abd",
                        "glosses": [
                            "ein Denkmal in Form einer Säule zum Andenken an einen errungenen Sieg"
                        ],
                        "tags": [
                            "Bildende Kunst"
                        ],
                        "examples": [
                            {
                                "example_id": "ea652caf-e0b7-4955-833f-3c1873749f4d",
                                "sense_id": "4208afe8-edf3-378f-b8cd-92653e5b4ff3",
                                "text": "Viele Berliner bezeichnen die Victoria-Figur auf der Siegessäule liebevoll als Ihre „Goldelse“."
                            },
                            {
                                "example_id": "0226081c-2b21-4ceb-a70c-8d2fc0b48e07",
                                "sense_id": "4208afe8-edf3-378f-b8cd-92653e5b4ff3",
                                "text": "Die Siegessäule muss mal wieder restauriert werden."
                            },
                            {
                                "example_id": "4d8d6f39-9751-4b2b-b5f6-d1287b227f36",
                                "sense_id": "4208afe8-edf3-378f-b8cd-92653e5b4ff3",
                                "text": "„Dann kamen wir an der Siegessäule vorbei und umrundeten sie mehrmals, und der Stadtführer erklärte, dass auf der großen Säule eine Siegesgöttin mit Schuhgröße 96 stehe, die für eine Siegesgöttin etwas zu korpulent ausgefallen sei.“"
                            },
                            {
                                "example_id": "f65a330e-b994-40b4-bcc6-daaeb00216ae",
                                "sense_id": "4208afe8-edf3-378f-b8cd-92653e5b4ff3",
                                "text": "„Von der heutigen Straße des 17. Juni, wo zwischen Brandenburger Tor und Siegessäule eine Landebahn angelegt war, startete Speer mitten in der Nacht in Richtung Westen.“"
                            },
                            {
                                "example_id": "106ff6f6-70fd-4b07-828c-fdd58f24c2c9",
                                "sense_id": "4208afe8-edf3-378f-b8cd-92653e5b4ff3",
                                "text": "„Monumente und Gebäude sind angestrahlt, Fackeln leuchten, als Hitler und Speer am Vorabend die neue Teilstrecke der Ost-West-Achse befahren, am Großen Stern vorbei, wo jetzt die um siebeneinhalb Meter erhöhte Siegessäule steht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
