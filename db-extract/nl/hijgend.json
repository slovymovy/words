                        "examples": [
                            {
                                "example_id": "eb45bccc-7b4c-48ce-8107-a014f7fcdeac",
                                "sense_id": "3879ea08-adbe-326e-b44d-25c16b8091d6",
                                "text": "Bauke Mollema heeft een goed gevoel overgehouden aan de eerste serieuze afspraak van de klassementsrenners in de Tour de France. De kopman van Trek-Segafredo handhaafde zich van voren op de Mûr-de-Bretagne en kwam als zevende over de streep, een paar seconden na de Ierse winnaar Dan Martin. \"Meer zat er niet in\", zei Mollema hijgend aan de finish."
                            },
                            {
                                "example_id": "01be6cb3-02b1-46b6-b463-f54554f057a8",
                                "sense_id": "3879ea08-adbe-326e-b44d-25c16b8091d6",
                                "text": "Zwaar hijgend sleur ik mezelf door het water."
                            }
                        ]
                    }
