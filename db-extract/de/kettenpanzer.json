                "senses": [
                    {
                        "sense_id": "64668df7-1c4e-32e4-be99-f7a4f712e50e",
                        "entry_id": "3f118eab-51d0-315e-b694-f13ae0ebed5a",
                        "glosses": [
                            "Teil der Bewaffnung, bestehend aus einer hemdartigen Rüstung aus Ketten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ac68efc-5904-492b-82be-7801ee2da8a6",
                                "sense_id": "64668df7-1c4e-32e4-be99-f7a4f712e50e",
                                "text": "„Da diese aber in der Herstellung sehr aufwendig waren, konnten sich nur wohlhabende Heerführer und Krieger einen solchen Kettenpanzer leisten.“"
                            },
                            {
                                "example_id": "6a2435c8-9c91-4804-b1f9-a800fd7aae6a",
                                "sense_id": "64668df7-1c4e-32e4-be99-f7a4f712e50e",
                                "text": "„Immerhin: Der Kettenpanzer war luftdurchlässig, zudem leicht zusammenzulegen und damit problemlos zu transportieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d60fc3f2-4d8b-3693-af5a-225f7d4da550",
                        "entry_id": "3f118eab-51d0-315e-b694-f13ae0ebed5a",
                        "glosses": [
                            "Panzerfahrzeug, das sich mithilfe von Ketten (statt Rädern) fortbewegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d982397-00be-4675-b647-8e6065ef1f7c",
                                "sense_id": "d60fc3f2-4d8b-3693-af5a-225f7d4da550",
                                "text": "„6000 Zuschauer aus der Umgebung zahlten den für polnische Verhältnisse horrenden Eintrittspreis von umgerechnet vier Mark, um 200 Radfahrzeuge und 15 Kettenpanzer in Aktion zu sehen.“"
                            },
                            {
                                "example_id": "f9d215cb-56e1-4c53-9041-f11df402f921",
                                "sense_id": "d60fc3f2-4d8b-3693-af5a-225f7d4da550",
                                "text": "„Weil die Taliban im Raum Kundus ihre Taktik geändert und eine Offensive gegen die internationale Schutztruppe Isaf, aber auch gegen die afghanische Armee gestartet haben, setzen die deutschen Kommandeure jetzt alles ein, was ihnen zur Verfügung steht – nicht nur die wuchtigen Kettenpanzer, sondern auch eigene Mörser und Kampfflugzeuge ihrer Verbündeten.“"
                            },
                            {
                                "example_id": "cf742c44-cb74-4272-af9d-1c5ef0b494d3",
                                "sense_id": "d60fc3f2-4d8b-3693-af5a-225f7d4da550",
                                "text": "„Der ‚Gepard‘ ist ein knapp 46 Tonnen schwerer Kettenpanzer, der mit seinen zwei 35-Millimeter-Flugabwehrkanonen tief fliegende Luftziele bekämpfen und so andere Panzer schützen soll.“"
                            },
                            {
                                "example_id": "0c49facb-f0a5-4f98-8978-246603db5af4",
                                "sense_id": "d60fc3f2-4d8b-3693-af5a-225f7d4da550",
                                "text": "„Der Kettenpanzer ‚Osorio‘ fährt mit Triebwerken der brasilianischen Tochter der Motorenwerke Mannheim (MWM) und kann auf Wunsch – falls eine Endverbleibsgenehmigung vorliegt – auch mit MTU-Motoren ausgestattet werden.“"
                            },
                            {
                                "example_id": "2b7a253e-0842-4bb0-b3ea-f5712c2c9913",
                                "sense_id": "d60fc3f2-4d8b-3693-af5a-225f7d4da550",
                                "text": "„Ein Kettenpanzer besitzt beidseitig nur je ein Antriebsrad, wogegen beim mehrachsigen Radpanzer sämtliche Achsen und Räder angetrieben sind.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
