                ],
                "senses": [
                    {
                        "sense_id": "fe4552c2-a1ac-32a9-9d29-dcb0b2876f42",
                        "entry_id": "5b841da2-0838-36a8-95ed-009a2234a81b",
                        "glosses": [
                            "zuverlässiges Wissen über ein bestimmtes Spiel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "649c3122-a6f7-472c-95e6-450fd17871fd",
                                "sense_id": "fe4552c2-a1ac-32a9-9d29-dcb0b2876f42",
                                "text": "„Und bei der ersten Runde - Julius gewann Stich auf Stich, denn er hatte bald herausgefunden, daß es mit Elis Spielkenntnissen nicht weit her war - kam das Mädchen und brachte Mürbekuchen für den alten Herrn Gebert.“"
                            },
                            {
                                "example_id": "cc9859cc-88bf-4c23-a09d-13b041d6057a",
                                "sense_id": "fe4552c2-a1ac-32a9-9d29-dcb0b2876f42",
                                "text": "„In erster Linie gilt es also, die Klasse überhaupt am Spiel zu halten und auch die Spielkenntnisse und –fähigkeiten der Kinder so zu steigern, daß sie sich in diesem Medium wohlfühlen und dem Vergnügen hingeben können.“"
                            },
                            {
                                "example_id": "0d66f640-b27f-49c0-b71e-99811f4f20a4",
                                "sense_id": "fe4552c2-a1ac-32a9-9d29-dcb0b2876f42",
                                "text": "„Weitere bedeutsame positive Korrelationen zwischen der Stärke der Inhaltsregeln und der Spielkenntnis der Eltern […] sowie den familiären Gesprächen über die Bildschirmerlebnisse […] offenbaren, dass wenn Eltern strenge Regeln für die Spielauswahl festlegen, sie sich auch besser mit den zu Hause genutzten Spielen auskennen[…]."
                            },
                            {
                                "example_id": "8bb321f6-7828-4d2c-9d98-426cd8111360",
                                "sense_id": "fe4552c2-a1ac-32a9-9d29-dcb0b2876f42",
                                "text": "„Pokerturniere oder Roulette-Seminare gehören zum regelmäßigen Angebot für Firmen, für Vereine und Hobbygruppen, die sich einige unterhaltsame Stunden machen und gleichzeitig ihre Spielkenntnis verbessern möchten.“"
                            },
                            {
                                "example_id": "3db11a79-a5a8-4946-b730-2bd0e7a6b76b",
                                "sense_id": "fe4552c2-a1ac-32a9-9d29-dcb0b2876f42",
                                "text": "„Es stellte sich heraus, dass sehr viele Menschen die Schachregeln gut kennen und gerne bereit waren, die Spielkenntnisse aufzufrischen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
