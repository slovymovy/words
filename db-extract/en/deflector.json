                ],
                "senses": [
                    {
                        "sense_id": "cbace73f-8c4c-3911-b144-100814eeb1ad",
                        "entry_id": "c02dd369-44c8-34fc-9ceb-065fa481bf46",
                        "glosses": [
                            "Something which deflects something else, especially a stream of fluid or particles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0e76c46-b8e9-411f-994e-c894882c1fe8",
                                "sense_id": "cbace73f-8c4c-3911-b144-100814eeb1ad",
                                "text": "1992 Nasa Patents Available for Licensing from the George C. Marshall Space Flight Center\nThe deflector assembly contains a plurality of vanes which change the direction of the solar energy to the vertical, while constantly keeping the same side of the deflector facing the sun."
                            }
                        ]
                    },
                    {
                        "sense_id": "f305e3ed-de76-364a-a54f-b02336dba584",
                        "entry_id": "c02dd369-44c8-34fc-9ceb-065fa481bf46",
                        "glosses": [
                            "A diaphragm in a lamp, stove, etc. by which the flame and gases are brought together to improve combustion."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "5825761a-1bc7-3c60-8be0-3e35c2a22f95",
                        "entry_id": "c02dd369-44c8-34fc-9ceb-065fa481bf46",
                        "glosses": [
                            "A force field; an invisible barrier used as a protective shield."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5bc52da-5bfe-4c88-ab26-636cab662330",
                                "sense_id": "5825761a-1bc7-3c60-8be0-3e35c2a22f95",
                                "text": "The blasters are those beams of ravening destruction which take care of recalcitrant meteorites in a spaceship's course when the deflectors can't handle them."
                            },
                            {
                                "example_id": "88eac809-95f3-4b8f-99b3-69f0c42f2b52",
                                "sense_id": "5825761a-1bc7-3c60-8be0-3e35c2a22f95",
                                "text": "Deflectors say there's something there, sensors say there isn't. Density negative. Radiation negative. Energy negative."
                            },
                            {
                                "example_id": "cf5812f9-5fc2-413f-b0f3-60a34d0faf99",
                                "sense_id": "5825761a-1bc7-3c60-8be0-3e35c2a22f95",
                                "text": "PICARD: If the Romulans have returned to this sector we should know about that. Mister Worf, any further activity?\nWORF: Negative, sir.\nPICARD: Slow to half impulse.\nLAFORGE: Going to one half impulse. ... Now entering quadrant nine-zero-seven, mark three.\nPICARD: Shields and deflectors up. Go to Yellow Alert."
                            }
                        ]
                    }
                ],
