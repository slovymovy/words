                                    {
                                        "sense_id": "078a003a-db28-31dc-88e9-b103451a3a2e",
                                        "entry_id": "332f261e-8c78-3c0b-b4b2-92cd7906af44",
                                        "glosses": [
                                            "Gesamtheit der Vorstellungen und Folgen der Regierung Adolf Hitlers"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "273f671f-fd54-452c-9285-5869e348109a",
                                                "sense_id": "078a003a-db28-31dc-88e9-b103451a3a2e",
                                                "text": "„Heinrich Mann, Feuchtwanger, Brecht und Ludwig Marcuse neigten dazu, den Hitlerismus als vorübergehende Erscheinung zu betrachten und standen Deutschland im Prinzip positiv gegenüber, während Thomas Mann zu einer Versöhnung anscheinend noch nicht bereit war.“"
                                            }
