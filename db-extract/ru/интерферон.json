                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d83fa9c2-20e5-3651-9e02-1bac53897d70",
                                        "entry_id": "df3a87dc-e774-3cf0-b629-efaf338bab80",
                                        "glosses": [
                                            "Any of a group of glycoproteins, produced by the immune system, that prevent viral replication in infected cells."
                                        ],
