                    },
                    {
                        "sense_id": "99a2d74a-a32b-32cc-89e7-6a5b35c876c1",
                        "entry_id": "b721c667-348b-30cc-b5ed-cba2548a3efe",
                        "glosses": [
                            "hyponiem dat de kenmerkende eigenschap van het hyperoniem extra benadrukt"
