            "senses": [
                {
                    "sense_id": "89c6b64f-670e-3c0e-9cc1-85ab155ccc63",
                    "sense_definition": "An informal term for a prenuptial agreement, a legal contract signed before marriage regarding property and financial rights.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "legal agreement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Before getting married, the couple decided to sign a <w>prenup</w> to protect their personal assets.",
                            "target_lang_translations": {
                                "ru": "Перед вступлением в брак пара решила подписать <w>брачный контракт</w>, чтобы защитить личные активы."
                            }
                        },
                        {
                            "text": "His lawyer advised him to draw up a strict <w>prenup</w> due to his family's wealth.",
                            "target_lang_translations": {
                                "ru": "Адвокат посоветовал ему составить строгий <w>брачный договор</w> из-за богатого состояния его семьи."
                            }
                        }
                    ],
                    "synonyms": [
                        "antenuptial agreement",
                        "premarital agreement"
                    ],
                    "common_phrases": [
                        "sign a prenup"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "short for prenuptial agreement"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Разговорное сокращение от «брачный договор/контракт» — соглашение, заключаемое до брака и определяющее имущественные права супругов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "брачный контракт",
                                "target_lang_sense_clarification": "официальное или обиходное наименование соглашения"
                            },
                            {
                                "target_lang_word": "брачный договор",
                                "target_lang_sense_clarification": "юридический термин"
                            },
                            {
                                "target_lang_word": "брачник",
                                "target_lang_sense_clarification": "разговорное сокращение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "00efc60a-00e1-3590-89fc-3064f081e6a6",
                    "sense_definition": "A photography session that takes place prior to a wedding day.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "wedding photography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They scheduled a destination <w>prenup</w> by the coast to get memorable photos for their invitations.",
                            "target_lang_translations": {
                                "ru": "Они запланировали выездную <w>предсвадебную фотосессию</w> на побережье, чтобы сделать памятные снимки для пригласительных."
                            }
                        },
                        {
                            "text": "The photographer suggested doing the outdoor <w>prenup</w> during the golden hour before sunset.",
                            "target_lang_translations": {
                                "ru": "Фотограф предложил провести уличную <w>предсвадебную съёмку</w> в «золотой час» перед закатом."
                            }
                        }
                    ],
                    "common_phrases": [
