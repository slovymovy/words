    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [],
        "ru-extract.jsonl": [],
        "nl-extract.jsonl": [
            {
                "entry_id": "838b2aef-a11a-3c06-9fd2-bae12081ff0f",
                "word": "uitschreeuwen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b20f7d67-bcfc-3ec1-9983-896289f820cb",
                        "entry_id": "838b2aef-a11a-3c06-9fd2-bae12081ff0f",
                        "glosses": [
                            "met zeer luide, boze stem iets mededelen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9ad56c6-ad94-47ca-87cc-882fcbe107dc",
                                "sense_id": "b20f7d67-bcfc-3ec1-9983-896289f820cb",
                                "text": "Maar denkt de schrijfster dan echt dat Lucas wel in volzinnen spreekt als hij in grote agonie afrekent met zijn ouders die hij achttien jaar niet heeft gezien, de pijn van zijn jeugd uitschreeuwend?"
                            },
                            {
                                "example_id": "bdd2bdd9-e605-40c1-9f64-65fa081dd081",
                                "sense_id": "b20f7d67-bcfc-3ec1-9983-896289f820cb",
                                "text": "Als volwassenen niet in staat zijn normaal te doen, niet in staat zijn naar elkaar te luisteren en slechts met de vingers in hun oren heel hard hun eigen gelijk uitschreeuwen, zit er maar een ding op: lokale overheden moeten in het belang van de openbare orde voortaan geen demonstraties meer toestaan bij sinterklaasintochten."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8bd79557-f627-4062-8092-5f5884697463",
                        "source_entry_id": "838b2aef-a11a-3c06-9fd2-bae12081ff0f",
                        "source_sense_id": "b20f7d67-bcfc-3ec1-9983-896289f820cb",
                        "target_lang_word": "shout out loud",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "3e11da99-94a8-480c-9b7f-7ebdfd1a541b",
                        "source_entry_id": "838b2aef-a11a-3c06-9fd2-bae12081ff0f",
                        "source_sense_id": "b20f7d67-bcfc-3ec1-9983-896289f820cb",
                        "target_lang_word": "scream",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scream",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3abed995-d403-325d-9d2a-35b0bc61347f",
                                        "entry_id": "d1ebfecd-03df-387f-9977-e20e43e6506f",
                                        "glosses": [
                                            "A loud, emphatic, exclamation of extreme emotion, especially horror, fear, excitement, or anger; it may comprise a word or a sustained, high-pitched vowel sound."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "87fb65ba-968e-31dd-bd12-56ec8f536448",
                                        "entry_id": "d1ebfecd-03df-387f-9977-e20e43e6506f",
                                        "glosses": [
                                            "A loud vocalisation of many animals, especially in response to pain or fear."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf7bb615-b961-4627-be71-9eb123410e93",
                                                "sense_id": "87fb65ba-968e-31dd-bd12-56ec8f536448",
                                                "text": "I am tender-hearted by nature, and have found my eyes moist many a time over the scream of a wounded hare."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3cc68307-b43d-3ab1-84db-d03e2828f3ad",
                                        "entry_id": "d1ebfecd-03df-387f-9977-e20e43e6506f",
                                        "glosses": [
                                            "A form of singing associated with the metal and screamo styles of music. It is a loud, rough, distorted version of the voice; rather than the normal voice of the singer."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "99288eba-cde7-3df8-a609-7d84598a9d25",
                                        "entry_id": "d1ebfecd-03df-387f-9977-e20e43e6506f",
                                        "glosses": [
                                            "Used as an intensifier."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d2bb81a-27da-40bd-94e5-7cf2af796ba1",
                                                "sense_id": "99288eba-cde7-3df8-a609-7d84598a9d25",
                                                "text": "We had a real scream of a time at the beach."
                                            },
                                            {
                                                "example_id": "98ba3699-72ba-40ee-abe3-d20929a13300",
                                                "sense_id": "99288eba-cde7-3df8-a609-7d84598a9d25",
                                                "text": "Amman, though not exactly your world cultural centre, is a scream of a city; all the roads have different names from their official ones, so that maps are useless"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c17e53ac-e738-33c4-9e50-727eaca91376",
                                        "entry_id": "d1ebfecd-03df-387f-9977-e20e43e6506f",
                                        "glosses": [
                                            "An exclamation mark."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "scream",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cb7d2e52-a4a9-36b3-a654-ce2afe5562a7",
                                        "entry_id": "ee95155d-dc8f-3505-8760-6a0ba4c36dae",
                                        "glosses": [
                                            "To cry out with a shrill voice; to utter a sudden, sharp outcry, or shrill, loud cry, as in fright or extreme pain; to screech, to shriek."
                                        ],
                                        "tags": [
                                            "also",
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50ec77db-8cbd-47e3-89c0-11440ca21ad5",
                                                "sense_id": "cb7d2e52-a4a9-36b3-a654-ce2afe5562a7",
                                                "text": "I heard the owl scream and the crickets cry."
                                            },
                                            {
                                                "example_id": "5fec0fe5-df21-4709-8434-c512f1bddfea",
                                                "sense_id": "cb7d2e52-a4a9-36b3-a654-ce2afe5562a7",
                                                "text": "When we crossed the river, I heard a terrible cry, and I blessed the child again, the others said it was only the loon, which screamed for bad weather.\" \"Yes, that would have been sufficient, if there was nothing else but the loon,\" said Gubjor; \"when it screams at a new-born babe, that child is bewitched.\""
                                            },
                                            {
                                                "example_id": "86b74cb0-07bf-4f3c-a0c4-2353092185e1",
                                                "sense_id": "cb7d2e52-a4a9-36b3-a654-ce2afe5562a7",
                                                "text": "Well, I waited and I waited / For some word from down below / And then ol' Harley started screaming / \"Run, my God, now, Carter, go man go!\""
                                            },
                                            {
                                                "example_id": "ce60f10e-34c5-4eb5-a3ab-f665a341df63",
                                                "sense_id": "cb7d2e52-a4a9-36b3-a654-ce2afe5562a7",
                                                "text": "Meanwhile, the authoritarianism, which has turned left-liberalism into a movement for sneaks and prudes, was always going to play into the hands of the right. Free citizens have stopped listening to those who respond to the challenge of argument by screaming for the police to arrest the politically incorrect or for universities to ban speakers who depart from leftish orthodoxy."
                                            },
                                            {
                                                "example_id": "769a1da9-a90f-419b-a894-b1a98a1b6966",
                                                "sense_id": "cb7d2e52-a4a9-36b3-a654-ce2afe5562a7",
                                                "text": "I'm having wicked dreams of leaving Tennessee\nHear Santa Monica, I swear it's calling me\nWon't make my mama proud, it's gonna cause a scene\nShe sees her baby girl, I know she's gonna scream"
                                            },
                                            {
                                                "example_id": "f9d17c41-7696-4613-9b08-af9e0164bccd",
                                                "sense_id": "cb7d2e52-a4a9-36b3-a654-ce2afe5562a7",
                                                "text": "One hit high on Farenholt snipped off the radar antenna rather neatly and sent splinters down into the torpedo launcher below, one of which blew out the air flask of a torpedo, which immediately launched itself straight out of the tube, and, rather unhelpfully, since the torpedo launcher was currently positioned pointing forward, wedged itself, motor screaming, in the forefunnel. Luckily, unlike Buchanan's weapon, this one was faulty; the motor ran out, but the automatic destruct function failed to work."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3dfac3c-2b24-3bfb-b756-6a128d1ba1d5",
                                        "entry_id": "ee95155d-dc8f-3505-8760-6a0ba4c36dae",
                                        "glosses": [
                                            "To move quickly; to race."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c04e27ef-017b-406b-b695-f315b782a56f",
                                                "sense_id": "f3dfac3c-2b24-3bfb-b756-6a128d1ba1d5",
                                                "text": "He almost hit a pole, the way he came screaming down the hill."
                                            },
                                            {
                                                "example_id": "b6efba17-a302-4097-82ba-324dae8e220d",
                                                "sense_id": "f3dfac3c-2b24-3bfb-b756-6a128d1ba1d5",
                                                "text": "Things had improved a little bit compared to the Eastern Solomons, and three dozen F4F Wildcats on combat air patrol were vectored onto the oncoming hostiles, but once that initial task was accomplished, things began to collapse back into the cacophony and chaos that was all too familiar to those aboard the Enterprise, meaning that the end result was round about the same, the Japanese aircraft screaming into their attack runs on Hornet about the same time as most of the Wildcats managed to sort themselves out to begin their own attacks on the incoming."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bcb3e877-9eb7-3fa1-a696-435bb2b761f9",
                                        "entry_id": "ee95155d-dc8f-3505-8760-6a0ba4c36dae",
                                        "glosses": [
                                            "To be very indicative of; clearly having the characteristics of."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "informal",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86504eea-ca26-4cda-ae5d-464d39ffb091",
                                                "sense_id": "bcb3e877-9eb7-3fa1-a696-435bb2b761f9",
                                                "text": "Do you know what screams \"I’m obnoxious\"? People who feel the need to comment on every little thing they notice."
                                            },
                                            {
                                                "example_id": "f066a293-f6f4-4a26-ba1b-cf5a73ce23cc",
                                                "sense_id": "bcb3e877-9eb7-3fa1-a696-435bb2b761f9",
                                                "text": "Nothing screams fall like corduroy! I'm loving this deep seafoam green shacket—made of the thick, ribbed material—that'll give a fab pop of color to a muted ensemble."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0af665d6-b753-4bff-b67f-9b624f0c9eda",
                        "source_entry_id": "838b2aef-a11a-3c06-9fd2-bae12081ff0f",
                        "source_sense_id": "b20f7d67-bcfc-3ec1-9983-896289f820cb",
                        "target_lang_word": "shriek",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shriek",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a63cb9b5-9da5-364f-8416-da6621e6be76",
                                        "entry_id": "2356d0e7-0cb7-358c-b88e-7ade782ea9db",
                                        "glosses": [
                                            "A sharp, shrill outcry or scream; a shrill wild cry caused by sudden or extreme terror, pain, or the like."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7df6e328-dd6c-45b0-92b3-73a5d18a60c7",
                                                "sense_id": "a63cb9b5-9da5-364f-8416-da6621e6be76",
                                                "text": "Shrieks, clamours, murmurs, fill the frighted town."
                                            },
                                            {
                                                "example_id": "bf5c82d4-443e-47ed-ab93-8cad67eda5ce",
                                                "sense_id": "a63cb9b5-9da5-364f-8416-da6621e6be76",
                                                "text": "Sabor, the lioness, was a wise hunter. To one less wise the wild alarm of her fierce cry as she sprang would have seemed a foolish thing, for could she not more surely have fallen upon her victims had she but quietly leaped without that loud shriek?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a393e61-b300-3b88-8454-6eb575d47fec",
                                        "entry_id": "2356d0e7-0cb7-358c-b88e-7ade782ea9db",
                                        "glosses": [
                                            "An exclamation mark."
                                        ],
                                        "tags": [
                                            "UK",
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "shriek",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "be1957a3-f8af-3d50-8777-309265f177a7",
                                        "entry_id": "f666e9aa-f851-3d63-8201-38400e4052d5",
                                        "glosses": [
                                            "To utter a loud, sharp, shrill sound or cry, as do some birds and beasts; to scream, as in a sudden fright, in horror or anguish."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "017cab0d-8931-4309-a92f-ef98ca59f5a1",
                                                "sense_id": "be1957a3-f8af-3d50-8777-309265f177a7",
                                                "text": "Feebly ſhe ſhriekt, but ſo feebly indeed / That Britomart heard not the ſhrilling ſound."
                                            },
                                            {
                                                "example_id": "1ab7d796-6d7c-4906-991f-aa749894d1d7",
                                                "sense_id": "be1957a3-f8af-3d50-8777-309265f177a7",
                                                "text": "It was the owl that shrieked."
                                            },
                                            {
                                                "example_id": "7730c0ee-541b-4f11-b836-f66642ae1929",
                                                "sense_id": "be1957a3-f8af-3d50-8777-309265f177a7",
                                                "text": "At this she shriek'd aloud; the mournful train / Echoed her grief."
                                            },
                                            {
                                                "example_id": "d18b0721-804e-4f91-af71-f4cbf8e75413",
                                                "sense_id": "be1957a3-f8af-3d50-8777-309265f177a7",
                                                "text": "\"[O]h, yes! the loon does shriek dreadfully - particularly when there's fine rain[.]\""
                                            },
                                            {
                                                "example_id": "82af6886-a91c-4032-88c7-fd5805bb9c8b",
                                                "sense_id": "be1957a3-f8af-3d50-8777-309265f177a7",
                                                "text": "In winter the place was deserted and, with cold damp wind from the sea shrieking in the telegraph wires, the general feeling could be one of desolation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b96bad5f-63b4-364a-aa6e-26e8bd2322ef",
                                        "entry_id": "f666e9aa-f851-3d63-8201-38400e4052d5",
                                        "glosses": [
                                            "To utter sharply and shrilly; to utter in or with a shriek or shrieks."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61da02be-1d27-4920-acde-8e0fbca007e4",
                                                "sense_id": "b96bad5f-63b4-364a-aa6e-26e8bd2322ef",
                                                "text": "The ghostly owl, shrieking his baleful note."
                                            },
                                            {
                                                "example_id": "1ca6ef24-1a08-4d6e-96ee-6bef385ab89c",
                                                "sense_id": "b96bad5f-63b4-364a-aa6e-26e8bd2322ef",
                                                "text": "She shrieked his name to the dark woods."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
