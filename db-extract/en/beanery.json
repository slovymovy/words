                        "glosses": [
                            "An inexpensive restaurant or cafe; a bistro."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "53f2e8f9-371a-4df5-a938-582a7253935d",
                                "sense_id": "149e821a-14fb-3e5f-b120-e8b30edaee6d",
                                "text": "Do not make the excuse that you cannot get the right foods at the beaneries. The beaneries are going to serve just what the customers demand and when enough of you fellows get to demanding vitalized foods you are going to get them."
                            },
                            {
                                "example_id": "a1b15fae-5896-4d47-b252-b36683f900a7",
                                "sense_id": "149e821a-14fb-3e5f-b120-e8b30edaee6d",
                                "text": "I had nothing to lose but the chains, and I hoped to find down the county roads Ma in her beanery and Pap over his barbecue pit, both still serving slow food from the same place they did thirty years ago. Where-you-from-buddy restaurants."
                            }
                        ]
                    }
