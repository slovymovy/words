                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "sur son trente-et-un",
                                "target_lang_sense_clarification": "très bien habillé, sur son dimanche"
                            },
                            {
                                "target_lang_word": "comme un dimanche",
                                "target_lang_sense_clarification": "endimanché, vêtu de ses plus beaux habits"
                            }
                        ]
                    }
                }
            ]
        },
