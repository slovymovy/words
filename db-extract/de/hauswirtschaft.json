                "senses": [
                    {
                        "sense_id": "cad6f3bf-c208-3528-88d7-2bea639f0307",
                        "entry_id": "dc1ee123-df9a-3944-9093-f85089e4a501",
                        "glosses": [
                            "Betrachtung der ökonomischen Aspekte und Tätigkeiten eines Privathaushaltes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e092fd6a-aa97-4a3b-9c33-32e8dff70aab",
                                "sense_id": "cad6f3bf-c208-3528-88d7-2bea639f0307",
                                "text": "„In allen Kulturen ging das Handwerk aus der geschlossenen Hauswirtschaft hervor.“"
                            },
                            {
                                "example_id": "f0f09dea-2723-4f1d-9484-2fd46920dd53",
                                "sense_id": "cad6f3bf-c208-3528-88d7-2bea639f0307",
                                "text": "„Über seine Ehe mit »Mischa« ist viel gekrittelt worden, doch das brave Mädchen in der Schürze war gleichzeitig prosaisch und großherzig genug, auch glücklose Umstände zu ertragen und hatte trotz ihrer intellektuellen Einfachheit doch Geist genug, ihrem Mann niemals mit Suaden über die Hauswirtschaft, ein geordnetes Leben, die schöne Karriere, die Gründung einer kinderreichen Familie und den Butterpreis lästig zu fallen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
