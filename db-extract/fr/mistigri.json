                                "target_senses": [
                                    {
                                        "sense_id": "624a6e68-fd9a-31d9-bde1-edc7fccbef5d",
                                        "entry_id": "fb7669cd-de8e-3977-a837-03b958b04c85",
                                        "glosses": [
                                            "bis (niedliche) Katze"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c05af69-a41f-45b6-8853-557bef1c916a",
                                                "sense_id": "624a6e68-fd9a-31d9-bde1-edc7fccbef5d",
                                                "text": "Hast du schon diese schwarze Mieze dort gesehen, Mama?"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3490ca93-4a15-33a6-b0d1-e8ff8466c28a",
                                        "entry_id": "fb7669cd-de8e-3977-a837-03b958b04c85",
                                        "glosses": [
                                            "salopp bis junge Frau"
                                        ],
                                        "tags": [
                                            "figurative",
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a572b20-15f3-4617-be0a-92235b8444af",
                                                "sense_id": "3490ca93-4a15-33a6-b0d1-e8ff8466c28a",
                                                "text": "Auf der Party morgen werden sicher viele niedliche Miezen erscheinen."
                                            },
                                            {
                                                "example_id": "0a846395-727c-47a7-ada8-9012434ae81b",
                                                "sense_id": "3490ca93-4a15-33a6-b0d1-e8ff8466c28a",
                                                "text": "„Er nannte sie immer Miezen, nie Weiber oder Huren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "85ac9e41-6d8d-4bf4-836c-6150d41ebaa7",
                        "source_entry_id": "7453580d-f7c0-36bd-a985-0cdd4c53f270",
