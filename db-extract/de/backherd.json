                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd43de21-4957-421a-818e-fd4120c7e444",
                                "sense_id": "d3c1805c-3e35-389c-b564-c61c9e984b4b",
                                "text": "„Er zündete den Backherd an, dann las er die Gebrauchsanweisung auf den Fernseh-Packungen und schob die Gerichte in die Röhre.“"
                            },
                            {
                                "example_id": "5bdb989c-c628-4ffa-80d7-a80a49bc9f37",
                                "sense_id": "d3c1805c-3e35-389c-b564-c61c9e984b4b",
                                "text": "„Danach ist das Brot gargebacken (Kruste muss leicht bräunlich und gut fest sein; jeder Backherd ist verschieden).“"
                            }
                        ],
