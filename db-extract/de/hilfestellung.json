                ],
                "senses": [
                    {
                        "sense_id": "4c4e0bf2-0f90-3d28-8c7d-ee7acd2341d0",
                        "entry_id": "342bb31f-99a1-39de-8313-90748c02b952",
                        "glosses": [
                            "aktive Hilfe, Unterstützung von jemandem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34e467fc-ef7d-43fd-a883-fe85efb9e3aa",
                                "sense_id": "4c4e0bf2-0f90-3d28-8c7d-ee7acd2341d0",
                                "text": "„Die Aufgabe 3 wurde bereits in der Schule – also mit Hilfestellung der Lehrerin – begonnen.“"
                            },
                            {
                                "example_id": "d0ed42fd-f5eb-441b-8c9d-29b8c4d22d12",
                                "sense_id": "4c4e0bf2-0f90-3d28-8c7d-ee7acd2341d0",
                                "text": "„Sie soll nun ‚blind‘ über die Bank balancieren, wobei sie die sehende Partnerin begleitet und ihr Hilfestellung gibt.“"
                            },
                            {
                                "example_id": "28cea554-ffbd-4c72-b8fd-fd4db38e168e",
                                "sense_id": "4c4e0bf2-0f90-3d28-8c7d-ee7acd2341d0",
                                "text": "„Dieses Buch ist als praktische Hilfestellung für all jene gedacht, die sich als Entwickler, Manager oder Studierende mit der Fragestellung des effizienten Testens von Software auseinandersetzen.“"
                            },
                            {
                                "example_id": "4464f4e3-05e6-489b-92b9-bcd68276bcc7",
                                "sense_id": "4c4e0bf2-0f90-3d28-8c7d-ee7acd2341d0",
                                "text": "„Hier erhalten Sie konkrete Hilfestellung bei der Planung Ihres Gartens und der Wahl der für Sie und Ihr Stück Land passenden Pflanzen.“"
                            },
                            {
                                "example_id": "58e75a55-bc49-4d38-82b0-4ab272ea7090",
                                "sense_id": "4c4e0bf2-0f90-3d28-8c7d-ee7acd2341d0",
                                "text": "„Gerade bei jüngeren Kindern bis zu 10 Jahren geben Mütter vergleichsweise viel Hilfestellung und ignorieren kindliche Ansprüche selten.“"
                            },
                            {
                                "example_id": "1f553bbb-6b8d-4988-8565-e3f0ce3a8dca",
                                "sense_id": "4c4e0bf2-0f90-3d28-8c7d-ee7acd2341d0",
                                "text": "„Nur durch eine gute Aufklärung und eine Hilfestellung kommt es zum nachhaltigen Erfolg.“"
                            },
                            {
                                "example_id": "c7107c64-03e4-4180-b15b-828385e9e1c2",
                                "sense_id": "4c4e0bf2-0f90-3d28-8c7d-ee7acd2341d0",
                                "text": "„Die Hilfsperson stellt sich nun hinter den Patienten und gibt ihm Hilfestellung während des Hochstemmens in den aufrechten Stand.“"
                            }
                        ],
