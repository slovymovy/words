                        "glosses": [
                            "Relatif à la Médie, aux Mèdes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c7b22f8-6673-4a79-950a-01197878da08",
                                "sense_id": "fea6526a-7a0f-34a5-9f0e-6d1f9b476030",
                                "text": "Il manque pour cette période des documents en langue parthe, mède, scythique, bactrienne, sogdienne, chorasmienne."
                            }
                        ]
                    }
