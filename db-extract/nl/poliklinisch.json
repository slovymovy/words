                    {
                        "sense_id": "7d372858-737c-3963-b2da-c5ab69817d05",
                        "entry_id": "b787bfd9-d884-3306-ac2e-7f106ddc5363",
                        "glosses": [
                            "met betrekking tot een polikliniek (van een behandeling in een ziekenhuis dat opname niet nodig is)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c079558-92ba-44d4-bbba-e59470dc6af1",
                                "sense_id": "7d372858-737c-3963-b2da-c5ab69817d05",
                                "text": "De Nederlandse Prinses Beatrix is geopereerd aan staar aan haar linkeroog. De operatie is donderdag uitgevoerd in Londen. Na de poliklinische ingreep kon Beatrix het ziekenhuis weer verlaten. Dat heeft de Rijksvoorlichtingsdienst vrijdag laten weten."
                            },
                            {
                                "example_id": "531ce6ed-ec69-43a0-9bd3-2b63a6dfb784",
                                "sense_id": "7d372858-737c-3963-b2da-c5ab69817d05",
                                "text": "In 2015 bevielen 166.733 vrouwen van 169.267 kinderen. Van alle vrouwen beviel 71 procent onder verantwoordelijkheid van een gynaecoloog, 29 procent deed dat onder verantwoordelijkheid van een verloskundige of huisarts. Van die laatste groep beviel 13 procent poliklinisch in het ziekenhuis. De overige 13 procent beviel thuis, 2,4 procent in een geboortecentrum."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cc99c4cb-7df8-4c3d-ac2d-1d7337df3f23",
                        "source_entry_id": "b787bfd9-d884-3306-ac2e-7f106ddc5363",
                        "source_sense_id": "7d372858-737c-3963-b2da-c5ab69817d05",
                        "source_sense_description": "van een behandeling in een ziekenhuis dat opname niet nodig is",
                        "target_lang_word": "outpatient",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "outpatient",
