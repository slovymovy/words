{
    "word_family": [
        "bed",
        "bedding",
        "inbedding"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "41b50931-1130-369b-8c55-ad0a24f0d971",
                    "sense_definition": "Een vaste of permanente plaats geven binnen een groter geheel.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "integreren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is belangrijk om deze nieuwe regels goed <w>in</w> te <w>bedden</w> in de bestaande organisatie.",
                            "target_lang_translations": {
                                "en": "It is important to <w>embed</w> these new rules properly within the existing organization."
                            }
                        },
                        {
                            "text": "De school probeert gezonde gewoontes stevig <w>in</w> te <w>bedden</w> in het dagelijkse lesprogramma.",
                            "target_lang_translations": {
                                "en": "The school is trying to firmly <w>integrate</w> healthy habits into the daily curriculum."
                            }
                        }
                    ],
                    "synonyms": [
                        "integreren",
                        "verankeren",
                        "opnemen"
                    ],
                    "antonyms": [
                        "buitensluiten",
                        "isoleren"
                    ],
                    "common_phrases": [
                        "stevig inbedden",
                        "in de cultuur inbedden"
                    ],
                    "target_lang_definitions": {
                        "en": "To give a fixed or permanent place within a larger whole."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "embed",
                                "target_lang_sense_clarification": "to integrate firmly into a system or structure"
                            },
                            {
                                "target_lang_word": "integrate",
                                "target_lang_sense_clarification": "to combine with another thing so that they become a whole"
                            },
                            {
                                "target_lang_word": "anchor",
                                "target_lang_sense_clarification": "to secure firmly in a context or culture"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "324650e4-60b8-32cd-af87-0f52ac9b2a0c",
                    "sense_definition": "Iets of iemand een goed beschermde, zachte of comfortabele plaats geven.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "beschermen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kwetsbare kristallen werden zorgvuldig <w>ingebed</w> in een dikke laag schuimrubber.",
                            "target_lang_translations": {
                                "en": "The fragile crystals were carefully <w>embedded</w> in a thick layer of foam rubber."
                            }
                        },
                        {
                            "text": "Zij <w>bedde</w> de baby warm <w>in</w> tussen de zachte kussens van de wieg.",
                            "target_lang_translations": {
                                "en": "She <w>tucked</w> the baby <w>in</w> warmly between the soft cushions of the cradle."
                            }
                        }
                    ],
                    "synonyms": [
                        "toedekken",
                        "nestelen",
                        "omhullen"
                    ],
                    "antonyms": [
                        "blootstellen"
                    ],
                    "common_phrases": [
                        "warm inbedden",
                        "zorgvuldig inbedden"
                    ],
                    "target_lang_definitions": {
                        "en": "To give something or someone a well-protected, soft, or comfortable place."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "embed",
                                "target_lang_sense_clarification": "to surround tightly or cushion in a protective substance"
                            },
                            {
                                "target_lang_word": "nestle",
                                "target_lang_sense_clarification": "to settle or lie comfortably within something soft"
                            },
                            {
                                "target_lang_word": "tuck in",
                                "target_lang_sense_clarification": "to cover someone snugly in bed or with blankets"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}