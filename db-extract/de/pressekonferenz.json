                                        "entry_id": "f36929b6-84e1-3ee9-8667-308fb6504440",
                                        "glosses": [
                                            "A question-and-answer session with members of television, print and other media."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4327c42a-b5b2-41b6-8be1-6f5c94909034",
                                                "sense_id": "63130182-f31e-31da-8422-6f9010b37972",
                                                "text": "Pitarch went just days after the coach, Cesare Prandelli. A little before Christmas, Prandelli had held a press conference in which he had declined to answer questions and instead delivered a speech one minute 57 seconds long in which he accused his players of being unprofessional."
                                            }
                                        ]
