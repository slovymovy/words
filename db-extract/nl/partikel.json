                    },
                    {
                        "sense_id": "8cff85b1-cd40-3f57-b2f0-aa31ae62f1d2",
                        "entry_id": "283744f9-4603-3dc1-9b84-96c78c0160eb",
                        "glosses": [
                            "een klein onverbogen woord waarmee een bepaalde grammaticale categorie wordt aangeduid."
                        ],
                        "tags": [],
