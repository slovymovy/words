                    },
                    {
                        "translation_id": "b78c9ade-f678-4068-95d4-4b1ee48974f8",
                        "source_entry_id": "56100958-8723-34b4-8266-fcccee82a9c5",
                        "source_sense_id": "f9e1d45d-f376-35a0-9991-a3c0ed5673c2",
