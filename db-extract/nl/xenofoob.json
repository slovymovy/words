                    {
                        "sense_id": "6f3c3172-a626-3574-8c51-5f05af629956",
                        "entry_id": "cad9ea94-a23e-3d04-a18a-dc8d343dab38",
                        "glosses": [
                            "iemand die een sterke angst voor vreemdelingen heeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "855fe4e9-c252-46cf-a5ee-0419d198daef",
                                "sense_id": "6f3c3172-a626-3574-8c51-5f05af629956",
                                "text": "De xenofoob hield niet van vreemdelingen."
                            },
                            {
                                "example_id": "0f6d82ed-422d-4e8a-8925-7340241d3aad",
                                "sense_id": "6f3c3172-a626-3574-8c51-5f05af629956",
                                "text": "Drijvende kracht is niet zelden de angst voor massale migratie naar Europa, de vrees overlopen te worden door hordes zwarte mensen die het einde van het Avondland inluiden. Het heeft een xenofobe, om niet te zeggen racistische ondertoon."
                            }
                        ]
                    }
