                        "glosses": [
                            "Donner un caractère bicéphale à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3628bd5f-526d-476c-a173-67df2f9b978c",
                                "sense_id": "976d0982-0322-367c-9409-32836459f0df",
                                "text": "En faisant cela, votre intention première est de « bicéphaliser » ma personnalité politique : un côté du visage à l'opposition, un autre au CNDD-FDD."
                            },
                            {
                                "example_id": "d13e9821-cdfc-4516-9720-8537d364ebd1",
                                "sense_id": "976d0982-0322-367c-9409-32836459f0df",
                                "text": "Ce qui aura pour conséquence de bicéphaliser le système en fusionnant les deux sphères que sont le politique et l'économique."
                            },
                            {
                                "example_id": "d4813f4d-d0b0-4013-a137-22b27dbe00f7",
                                "sense_id": "976d0982-0322-367c-9409-32836459f0df",
                                "text": "Pourquoi je serais obligé de me bicéphaliser pour avoir le dragon, et pourquoi le dragon et pas le phénix ou autre zoan Mythique?"
                            }
                        ]
                    }
