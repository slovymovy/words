                        ],
                        "examples": [
                            {
                                "example_id": "ca090074-5bbb-4455-b1b3-8338f6a8b77b",
                                "sense_id": "c5f2286a-3bef-3595-a5ca-7e6b4468adcd",
                                "text": "„Ich ging hinunter, um mir ein großes Messer aus der Küche zu holen, stapelte Scheite in die Holzwiege, nahm auch die Kognakflasche und einen Schwenker und ging wieder hoch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8ce50ca3-91d4-38b9-bab7-6c6c389d5d25",
                        "entry_id": "3d35969a-1b37-383d-8b1f-944d384253fb",
                        "glosses": [
                            "Schwenkgrill"
                        ],
                        "tags": [
                            "saarländisch"
                        ],
                        "examples": [
                            {
                                "example_id": "395b355b-9514-4f1e-9409-25dcbcba37b9",
                                "sense_id": "8ce50ca3-91d4-38b9-bab7-6c6c389d5d25",
                                "text": "„Der Schwenker schwenkt den Schwenker auf dem Schwenker.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "5ccaf8c3-352d-3e09-9763-e021f8a8f157",
                        "entry_id": "3d35969a-1b37-383d-8b1f-944d384253fb",
                        "glosses": [
                            "Fleisch, das auf dem Schwenkgrill zubereitet wird, Schwenkbraten"
                        ],
                        "tags": [
