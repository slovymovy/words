                ],
                "senses": [
                    {
                        "sense_id": "3531765a-a9d1-3eb6-8ae0-ed8341f3c512",
                        "entry_id": "8d75f365-17c2-35e1-a1e6-4f8f57fc5b89",
                        "glosses": [
                            "die Nationalflagge der Vereinigten Staaten von Amerika mit (heute) 50 Sternen für die Bundesstaaten und 13 Streifen (rot und weiß) für die 13 Gründungsstaaten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45565d1f-3e66-4d18-a1db-f3855dbd1bda",
                                "sense_id": "3531765a-a9d1-3eb6-8ae0-ed8341f3c512",
                                "text": "Unter dem Sternenbanner wurden die erfolgreichen amerikanischen Olympiateilnehmer ausgiebig gefeiert."
                            },
                            {
                                "example_id": "26815db6-fc0e-4d5e-8b2d-e2fe2fe5c728",
                                "sense_id": "3531765a-a9d1-3eb6-8ae0-ed8341f3c512",
                                "text": "„Das gesamte Dach des Wagens wurde von einem mittelgroßen Sternenbanner verdeckt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "12e2bc59-5b8c-42a0-9827-787474531474",
                        "source_entry_id": "8d75f365-17c2-35e1-a1e6-4f8f57fc5b89",
