{
    "word_family": [
        "предупреждение",
        "предупреждать",
        "предупредительность"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7a3edc2b-c308-3b6e-ae8d-bb81c0a75450",
                    "sense_definition": "Любезный, внимательный и услужливый по отношению к другим людям.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "courtesy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он был очень <w>предупредителен</w> со всеми гостями на вечере.",
                            "target_lang_translations": {
                                "tr": "Davetteki tüm misafirlere karşı çok <w>nazikti</w>."
                            }
                        },
                        {
                            "text": "Его <w>предупредительное</w> поведение помогло быстро решить конфликт.",
                            "target_lang_translations": {
                                "tr": "Onun <w>yardımsever</w> tavrı, çatışmanın hızlıca çözülmesine yardımcı oldu."
                            }
                        }
                    ],
                    "synonyms": [
                        "любезный",
                        "услужливый",
                        "внимательный"
                    ],
                    "antonyms": [
                        "непредупредительный"
                    ],
                    "common_phrases": [
                        "предупредительное поведение",
                        "предупредительный человек"
                    ],
                    "target_lang_definitions": {
                        "tr": "Başkalarına karşı nazik, düşünceli ve yardımsever olan."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "nazik",
                                "target_lang_sense_clarification": "Kişiler arası ilişkilerde kibar ve düşünceli olma durumu."
                            },
                            {
                                "target_lang_word": "yardımsever",
                                "target_lang_sense_clarification": "Başkalarına yardım etmeye istekli ve hizmet etmeye hazır olma."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3ea72446-9334-3784-b3fa-d84064279c81",
                    "sense_definition": "Содержащий в себе сигнал или информацию о возможной опасности или событии.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "warning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Водитель увидел <w>предупредительный</w> знак на дороге и сбавил скорость.",
                            "target_lang_translations": {
                                "tr": "Sürücü yoldaki <w>uyarıcı</w> levhayı gördü ve hızını düşürdü."
                            }
                        },
                        {
                            "text": "Раздался громкий <w>предупредительный</w> сигнал перед началом работы оборудования.",
                            "target_lang_translations": {
                                "tr": "Ekipman çalışmaya başlamadan önce yüksek bir <w>ikaz</w> sinyali duyuldu."
                            }
                        }
                    ],
                    "synonyms": [
                        "сигнальный"
                    ],
                    "common_phrases": [
                        "предупредительный знак",
                        "предупредительный сигнал"
                    ],
                    "target_lang_definitions": {
                        "tr": "Olası bir tehlike veya olay hakkında sinyal veya bilgi içeren."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "uyarıcı",
                                "target_lang_sense_clarification": "Bir tehlikeye karşı dikkat çeken veya ikaz eden."
                            },
                            {
                                "target_lang_word": "ikaz",
                                "target_lang_sense_clarification": "Bir durumu bildiren veya uyaran (genellikle sıfat tamlamalarında)."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5e2233eb-fdc0-38d7-8c1c-0474a8562dc1",
                    "sense_definition": "Направленный на предотвращение чего-либо нежелательного.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "prevention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Врачи назначили <w>предупредительные</w> меры для укрепления иммунитета.",
                            "target_lang_translations": {
                                "tr": "Doktorlar bağışıklığı güçlendirmek için <w>önleyici</w> tedbirler önerdi."
                            }
                        },
                        {
                            "text": "Были приняты <w>предупредительные</w> действия, чтобы избежать аварии на заводе.",
                            "target_lang_translations": {
                                "tr": "Fabrikadaki kazayı önlemek için <w>koruyucu</w> adımlar atıldı."
                            }
                        }
                    ],
                    "synonyms": [
                        "профилактический"
                    ],
                    "common_phrases": [
                        "предупредительные меры",
                        "предупредительные действия"
                    ],
                    "target_lang_definitions": {
                        "tr": "İstenmeyen bir durumu önlemeye yönelik olan."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "önleyici",
                                "target_lang_sense_clarification": "Bir olumsuzluğu veya tehlikeyi meydana gelmeden engellemeye yönelik."
                            },
                            {
                                "target_lang_word": "koruyucu",
                                "target_lang_sense_clarification": "Zarar görmeyi engellemek için alınan tedbirler bağlamında."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}