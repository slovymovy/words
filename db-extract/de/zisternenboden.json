                ],
                "senses": [
                    {
                        "sense_id": "09fc8f73-b28d-3442-9b33-d2f34b714efe",
                        "entry_id": "b072c21e-4469-3450-a84b-4cea41ddf8cc",
                        "glosses": [
                            "der Boden einer Zisterne"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4babb52d-f676-49d2-806f-0211587f97d1",
                                "sense_id": "09fc8f73-b28d-3442-9b33-d2f34b714efe",
                                "text": "„Die entsprechenden Umstände ergeben sich, wenn die Sedimentschicht am Zisternenboden – also die Schicht, als die sich absinkende organische Einträge absetzen – zu dick wird.“"
                            },
                            {
                                "example_id": "f52ce2c1-6e4c-404f-add1-7a14848f3c91",
                                "sense_id": "09fc8f73-b28d-3442-9b33-d2f34b714efe",
                                "text": "„Denn die Bildung einer Sedimentschicht am Zisternenboden ist nicht vermeidbar.“"
                            },
                            {
                                "example_id": "15479b78-cf9f-41b4-956d-5e54e3f282d2",
                                "sense_id": "09fc8f73-b28d-3442-9b33-d2f34b714efe",
                                "text": "„Dass der Eintritt am Zisternenboden positioniert ist, hat die Bewandtnis, dass dadurch Sauerstoff in den unteren Teil des Wasserreservoirs infiltriert wird.“"
                            },
                            {
                                "example_id": "2810eee7-c613-4b90-8fa2-fc69a8fae614",
                                "sense_id": "09fc8f73-b28d-3442-9b33-d2f34b714efe",
                                "text": "„Der Zisternenboden erhielt einen in den Elbsandstein getriebenen Trichter von 0,78 m Tiefe mit einem oberen Durchmesser von 2,40 m.“"
                            },
                            {
                                "example_id": "8573852f-799c-4c8a-9b66-8e1bf506fae2",
                                "sense_id": "09fc8f73-b28d-3442-9b33-d2f34b714efe",
                                "text": "„Die Sedimentschicht am Zisternenboden ist sogar nützlich, weil die Bakterien, die sich dort bilden, das Regenwasser reinigen. Erst wenn die Schicht ca. 5 cm hoch ist, ist eine Reinigung der Zisterne angeraten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
