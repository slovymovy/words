                                ]
                            },
                            {
                                "target_word": "Andrea",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c019f6ab-612f-33b9-8341-b66f90591301",
                                        "entry_id": "7bcb1dd8-9c18-337d-bc7e-c2423c2796ce",
                                        "glosses": [
                                            "männlicher Vorname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "643c3539-44ae-4720-88d1-37454fb03904",
                                                "sense_id": "c019f6ab-612f-33b9-8341-b66f90591301",
                                                "text": "„Ein nettes Mädchen um die Zwanzig fragte ihn, was er wünsche. ›Ich würde gern mit Signor Andrea Sorrentino sprechen.‹“"
                                            },
                                            {
                                                "example_id": "ea750e6c-388a-492c-985d-ef6e4758138c",
                                                "sense_id": "c019f6ab-612f-33b9-8341-b66f90591301",
                                                "text": "„Es wird am Tor geklopft. Virginia geht in den Vorraum. Der Mönch öffnet. Es ist Andrea Sarti. Er ist jetzt ein Mann in den mittleren Jahren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
