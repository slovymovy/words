                        "source_entry_id": "1fabb88c-7198-335e-8833-1b3ac3213886",
                        "source_sense_description": "(grammar, of a phrase or compound word) fulfilling the same grammatical role as one of its constituents",
                        "target_lang_word": "endocentrique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
