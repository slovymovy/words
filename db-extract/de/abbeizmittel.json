                                "target_senses": [
                                    {
                                        "sense_id": "ecf3a5b1-6130-3930-a55d-a843bed85a52",
                                        "entry_id": "84c5d8d1-5c59-3604-9691-7591bc12daf8",
                                        "glosses": [
                                            "Produit dont le rôle est de décaper une surface."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "914ca1e5-0570-4e6c-b397-e7f2b629fccd",
                                                "sense_id": "ecf3a5b1-6130-3930-a55d-a843bed85a52",
                                                "text": "Rien de tel que le vieux pain de savon Sunlight au citron, un décapant qui peut aussi ravoir les taches de cambouis sur les pantalons."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "décapant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0e9e7ce7-88cf-3738-87c9-ad8a3b43b644",
                                        "entry_id": "2def4a23-f892-37d4-942d-76ecb277ff1d",
                                        "glosses": [
                                            "Qui a la propriété de décaper."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a446e3a-9010-4ed8-9a23-1683b8e5b32d",
                                                "sense_id": "0e9e7ce7-88cf-3738-87c9-ad8a3b43b644",
                                                "text": "L’écoulement turbulent déplacera non seulement presque toute la boue circulable, mais détruira aussi les couches tendres de cake par une action décapante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23d6a357-a21d-3191-8a54-46666135d15f",
                                        "entry_id": "2def4a23-f892-37d4-942d-76ecb277ff1d",
                                        "glosses": [
                                            "Qui conteste les vieilles habitudes, les idées reçues."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3e8ceac-bb3f-4a24-ab9e-9e5a71d55606",
                                                "sense_id": "23d6a357-a21d-3191-8a54-46666135d15f",
                                                "text": "Cette réinterprétation décapante ne prend pas par hasard le contre-pied d’une historiographie plus prompte à accuser le contraste entre l’agitation anarchique des Lumières et l’ordre absolutiste."
                                            },
                                            {
                                                "example_id": "1e894e4f-ae17-427f-8ebd-240d4a1623d4",
                                                "sense_id": "23d6a357-a21d-3191-8a54-46666135d15f",
                                                "text": "C’est un trompe-l’œil de Leandro Erlich, l’une des installations décapantes et immenses de la Foire foraine d’art contemporain, qui régalera petits et grands, au Centquatre (19ᵉ)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8daaebc0-038e-381c-9844-1f8e6259db6e",
                                        "entry_id": "2def4a23-f892-37d4-942d-76ecb277ff1d",
                                        "glosses": [
                                            "Qui est d'une ironie féroce."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": []
                                    }
                                ]
