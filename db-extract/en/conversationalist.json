    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "4e35defc-4b19-3e5f-b755-4624aae21cad",
                "word": "conversationalist",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "2430c841-fa8f-45f1-9df6-45bccf074722",
                        "entry_id": "4e35defc-4b19-3e5f-b755-4624aae21cad",
                        "tags": [
                            "plural"
                        ],
                        "form": "conversationalists"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "df8b11c9-7509-3e8f-b025-e2b3250094d3",
                        "entry_id": "4e35defc-4b19-3e5f-b755-4624aae21cad",
                        "glosses": [
                            "A person who participates in a conversation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2bf407f8-6d39-441f-a4cc-121f89b03feb",
                                "sense_id": "df8b11c9-7509-3e8f-b025-e2b3250094d3",
                                "text": "If you can just ask questions about a person and nod sagely then they will leave thinking you are a brilliant conversationalist."
                            }
                        ]
                    },
                    {
                        "sense_id": "98fb9ded-c33a-3266-8a66-04d4cc1987d7",
                        "entry_id": "4e35defc-4b19-3e5f-b755-4624aae21cad",
                        "glosses": [
                            "A person skilled in general conversation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3ec1a22-18ec-4e19-b044-0e5a78cee137",
                                "sense_id": "98fb9ded-c33a-3266-8a66-04d4cc1987d7",
                                "text": "But Shulgin, while a nimble conversationalist, can have trouble with names — of people and places, never chemicals."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6e353191-75c9-42e2-8217-11be37d54dbd",
                        "source_entry_id": "4e35defc-4b19-3e5f-b755-4624aae21cad",
                        "source_sense_description": "one who participates in a conversation",
                        "target_lang_word": "Gesprächspartner",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gesprächspartner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4b43217a-2844-3444-916d-b7ee9b3d5f76",
                                        "entry_id": "22ec73af-564f-32df-a171-db57f9135886",
                                        "glosses": [
                                            "eine Person, die sich mit (einer) anderen im Gespräch befindet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5af19116-cb26-4368-a939-5ef931d36cfb",
                                                "sense_id": "4b43217a-2844-3444-916d-b7ee9b3d5f76",
                                                "text": "„Es gibt tatsächlich auch Leute, die ihren Gesprächspartner im Eifer am Anzugsknopf festhalten und so lange damit spielen, bis er abgedreht ist.“"
                                            },
                                            {
                                                "example_id": "71d08d04-23ab-4d03-8160-abd76d752224",
                                                "sense_id": "4b43217a-2844-3444-916d-b7ee9b3d5f76",
                                                "text": "„In acht Gruppen bearbeiteten die Jugendlichen verschiedene Fragen, etwa wie türkisch-deutsche Familien ihre Mehrsprachigkeit erleben oder wie die eigene Sprache auf den Gesprächspartner wirkt.“"
                                            },
                                            {
                                                "example_id": "34c155e5-25c7-4c72-9c1e-2c2e12aa2466",
                                                "sense_id": "4b43217a-2844-3444-916d-b7ee9b3d5f76",
                                                "text": "„Es kommt vor, dass er das letzte Wort des Gesprächspartners wie ein Echo wiederholt, als Ausdruck von Höflichkeit, und um die Rede des anderen nicht ohne Antwort zu lassen.“"
                                            },
                                            {
                                                "example_id": "664254a1-2754-4fea-a4fd-a7fe1ad87984",
                                                "sense_id": "4b43217a-2844-3444-916d-b7ee9b3d5f76",
                                                "text": "„Da es in der Stadt keine Gelehrtenzirkel und Salons gab, lernte Schlegel nur wenige anregende Gesprächspartner kennen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "28171867-e024-49cf-b7a1-6f47a771c39f",
                        "source_entry_id": "4e35defc-4b19-3e5f-b755-4624aae21cad",
                        "source_sense_description": "one who participates in a conversation",
                        "target_lang_word": "Plauderer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Plauderer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "eed820fb-b435-3f88-aff2-19c9753650d6",
                                        "entry_id": "e1701a2c-6c04-3e66-8988-96549578301a",
                                        "glosses": [
                                            "jemand, der sich ungezwungen, angenehm unterhalten kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "113eb0ff-a4c4-4b1b-93ba-9ac3950e89dd",
                                                "sense_id": "eed820fb-b435-3f88-aff2-19c9753650d6",
                                                "text": "Tom ist ein netter Plauderer, der kann zu jedem Thema etwas dazu beitragen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4504537d-9a4b-3e08-b4e0-6193e19ab8e1",
                                        "entry_id": "e1701a2c-6c04-3e66-8988-96549578301a",
                                        "glosses": [
                                            "jemand, der häufig etwas ausplaudert, Geheimnisse verrät"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "150404ee-0afe-4813-b3a3-a3266746fb5d",
                                                "sense_id": "4504537d-9a4b-3e08-b4e0-6193e19ab8e1",
                                                "text": "Ich frage mich, welcher Plauderer da wieder seinen Mund nicht halten konnte."
                                            },
                                            {
                                                "example_id": "5b3b4ff9-661d-4c8c-972e-2e73794db054",
                                                "sense_id": "4504537d-9a4b-3e08-b4e0-6193e19ab8e1",
                                                "text": "Es sind recht markige Worte, die Manager der Deutschen Telekom von ihren Vorgesetzten zu hören bekommen: „Wir werden die undichten Stellen schon ausfindig machen. Wenn nicht wir, wer sollte es dann schaffen?“ Oder: „Die kriegen wir schon, diese Plauderer. Wäre ja gelacht, wenn wir das nicht schaffen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
