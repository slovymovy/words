                            }
                        ]
                    },
                    {
                        "translation_id": "ad9c5cfa-b359-4050-bc54-6f39769b57be",
                        "source_entry_id": "edd2d077-c9cd-37a5-a001-a01e11b67c95",
                        "source_sense_id": "7691b566-68a5-3c89-87cc-2c09aad0ffbc",
                        "target_lang_word": "Feminismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Feminismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "45fc1888-31f3-3828-804c-a6800df1bc71",
                                        "entry_id": "73b0d8c1-7625-3826-bf92-74d6576ba426",
                                        "glosses": [
                                            "Teil der Frauenbewegung, der vorsieht, dass die Rollenverteilung nicht geschlechtsabhängig ist"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bdf041d5-37a2-4e26-ace8-1b3d86840410",
                                                "sense_id": "45fc1888-31f3-3828-804c-a6800df1bc71",
                                                "text": "In der heutigen Zeit halten manche Leute den Feminismus für übertrieben."
                                            },
                                            {
                                                "example_id": "ac66d1e7-4736-40ff-bf83-164002e82432",
                                                "sense_id": "45fc1888-31f3-3828-804c-a6800df1bc71",
                                                "text": "„Als wir einmal über Amerika sprachen, regte sie sich über den westlichen Feminismus auf.“"
                                            },
                                            {
                                                "example_id": "a565beb1-bc0e-4eff-9a03-d55712cc2b89",
                                                "sense_id": "45fc1888-31f3-3828-804c-a6800df1bc71",
                                                "text": "„Ich zog meine Schuhe aus, ohne mich darum zu kümmern, was die Hohepriesterin des deutschen Feminismus von mir denken mochte.“"
                                            },
                                            {
                                                "example_id": "275652ba-56e1-4fa8-a37c-6bf007a62faa",
                                                "sense_id": "45fc1888-31f3-3828-804c-a6800df1bc71",
                                                "text": "„In einem Punkt war Woolf in ihrem Essay ihrer Zeit noch weiter voraus, als der Feminismus es sich hat erträumen können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "32e8040e-6729-3d24-9964-d1651a46f202",
