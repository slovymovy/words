                    }
                ],
                "senses": [
                    {
                        "sense_id": "8a7a99b5-da7a-306c-bd7b-4777b476a3c2",
                        "entry_id": "e71f6aa4-d11e-3547-a4a8-6394e5161de9",
                        "glosses": [
                            "разг., усилит. пойти, двинуться, устремиться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b23b591-2c73-46fd-9c85-687d34babeb6",
                                "sense_id": "8a7a99b5-da7a-306c-bd7b-4777b476a3c2",
                                "text": "Наладились мы с ним и попёрли в Питер."
                            },
                            {
                                "example_id": "98ad050d-1681-462f-914f-38abca95b0fd",
                                "sense_id": "8a7a99b5-da7a-306c-bd7b-4777b476a3c2",
                                "text": "Чёрт его знает, — подумал наш герой, — опять пришёл этот Чухолка: опять на меня из него всякая попрёт гадость"
                            }
                        ]
                    },
                    {
                        "sense_id": "73e225e5-0468-3d63-9a85-8ddeb690160b",
                        "entry_id": "e71f6aa4-d11e-3547-a4a8-6394e5161de9",
                        "glosses": [
                            "безл., , повезти; прийти (об удаче)"
                        ],
                        "tags": [
                            "neuter",
                            "past"
                        ],
                        "examples": [
                            {
                                "example_id": "f091664e-65b4-4347-b00d-8949e37afa13",
                                "sense_id": "73e225e5-0468-3d63-9a85-8ddeb690160b",
                                "text": "Мне вот повезло, и я покатил в гору, а ты хоть и талантлив, и знаешь сцену, как никто, а тебе не попёрло."
                            },
                            {
                                "example_id": "75060c5a-1676-4808-b801-dfb63e1e6109",
                                "sense_id": "73e225e5-0468-3d63-9a85-8ddeb690160b",
                                "text": "Небольшой дом в два этажа, четыре комнаты — купленный в начале двухтысячных, когда у него вдруг в работе попёрло: проекты, знакомства, деньги."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
