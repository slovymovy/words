                    },
                    {
                        "translation_id": "e6dbddc2-915f-4fe4-a149-c57e6266e87b",
                        "source_entry_id": "bc695003-672d-36dc-8b3d-1f5c54f09834",
                        "source_sense_id": "c6aaae66-5031-3275-9529-c6cd72e7cea8",
                        "source_sense_description": "Cercle d’amis",
