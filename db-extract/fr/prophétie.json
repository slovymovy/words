                                            "ο λόγος ενός προφήτη που μαντεύει το μέλλον"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1b2f17a3-c527-4c5d-b247-c65e932fac70",
                        "source_entry_id": "0d10b50e-b505-3de7-b56c-935b49c4baf1",
                        "target_lang_word": "пророчество",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "пророчество",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "53128bec-c501-373a-a93c-bf79726aeda4",
                                        "entry_id": "85d0adc5-186e-3486-88b3-a3d3c7f0628d",
                                        "glosses": [
                                            "предсказание будущего"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "820e11a0-edda-48fb-a98d-4f7eac21f3b6",
                                                "sense_id": "53128bec-c501-373a-a93c-bf79726aeda4",
                                                "text": "Сам король, исторгнувший из своего сердца зловещее пророчество Кассандры, бывшее как бы заключительным аккордом обличительных проповедей ксендза Скарги, знаменитого тогда церковного бичевателя нравов, этот самый король беззаботно смеялся уже на другой день, когда стал просто \"Господином Снопковским\"."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e444bb18-8837-47a6-8d8c-77f217bd0a67",
                        "source_entry_id": "0d10b50e-b505-3de7-b56c-935b49c4baf1",
                        "source_sense_id": "4958367d-e8e6-3a45-b0c8-67a276660b4e",
                        "source_sense_description": "Prédiction des choses futures par inspiration divine.",
                        "target_lang_word": "Prophezeiung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Prophezeiung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d9fbfa0e-a391-3f66-afbe-438cb9f7096b",
                                        "entry_id": "13c56be1-68ec-3aa7-9d46-37c18618dc15",
                                        "glosses": [
                                            "der Vorgang des Vorhersagens oder dessen Inhalt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ddc3aaa-fcbd-462a-bc0d-8e9dc30696ab",
                                                "sense_id": "d9fbfa0e-a391-3f66-afbe-438cb9f7096b",
                                                "text": "Diese Prophezeiung ist falsch."
                                            },
                                            {
                                                "example_id": "9e2680d1-7b0b-4181-ba0e-da133e9d27ce",
                                                "sense_id": "d9fbfa0e-a391-3f66-afbe-438cb9f7096b",
                                                "text": "„Ludwig tat die Prophezeiung mit überlegener Handbewegung ab.“"
                                            },
                                            {
                                                "example_id": "f143bfee-a0c8-446f-8ea1-5a01a29a85cf",
                                                "sense_id": "d9fbfa0e-a391-3f66-afbe-438cb9f7096b",
                                                "text": "„Er hatte schon Weiße gesehen, daher erwies sich diese Prophezeiung als zutreffend, und offensichtlich warnte er seine Anhänger davor, den neuen Menschen zu sehr zu vertrauen.\""
                                            },
                                            {
                                                "example_id": "4fe4602e-0432-4bf5-852d-40d3ce63aa86",
                                                "sense_id": "d9fbfa0e-a391-3f66-afbe-438cb9f7096b",
                                                "text": "„Die Prophezeiungen meiner Großmutter hatten mich in eine unschuldige Art von Erregung versetzt.“"
                                            },
                                            {
                                                "example_id": "630a8842-db02-4c04-a83d-b3b40b593627",
                                                "sense_id": "d9fbfa0e-a391-3f66-afbe-438cb9f7096b",
                                                "text": "„Über solche Prophezeiungen konnten die Soldaten nur lachen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
