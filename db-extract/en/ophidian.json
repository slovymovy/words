    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "d010b73d-9c7f-3bae-bb0a-fb744665fd23",
                "word": "ophidian",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "80388b63-696d-4eac-a365-4f25c9fab857",
                        "entry_id": "d010b73d-9c7f-3bae-bb0a-fb744665fd23",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more ophidian"
                    },
                    {
                        "form_id": "f3812451-afdb-4a6d-b2da-e3bd9c56b50c",
                        "entry_id": "d010b73d-9c7f-3bae-bb0a-fb744665fd23",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most ophidian"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "69ab7e48-3b88-3232-a855-ed87dc479536",
                        "entry_id": "d010b73d-9c7f-3bae-bb0a-fb744665fd23",
                        "glosses": [
                            "Of or pertaining to the suborder Serpentes; of, related to, or characteristic of a snake or serpent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "302b77fa-cd31-4fb2-9161-3f39d9485cd0",
                                "sense_id": "69ab7e48-3b88-3232-a855-ed87dc479536",
                                "text": "The ophidian beast began to glow eerily, and Aaron could discern a fine webwork of veins and capillaries running throughout the creature's body."
                            },
                            {
                                "example_id": "f8707b22-2b3b-454f-809d-f391f9b56e14",
                                "sense_id": "69ab7e48-3b88-3232-a855-ed87dc479536",
                                "text": "A less obvious asset of snakes is their very light and supple jaws, which arose in the course of ophidian evolution to permit the ingestion of extraordinarily large meals (at maximum, more than 100% of their body mass)."
                            },
                            {
                                "example_id": "19a7a373-a627-4c6d-b836-8b74abf7a2b1",
                                "sense_id": "69ab7e48-3b88-3232-a855-ed87dc479536",
                                "text": "Another ophidian deity recognizable in Classic reliefs is the Feathered Serpent, known to the Maya as Kukulcán (and to the Toltecs and Aztecs as Quetzalcóatl)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "477d9017-3b73-446e-972c-e361bae72659",
                        "source_entry_id": "d010b73d-9c7f-3bae-bb0a-fb744665fd23",
                        "source_sense_id": "69ab7e48-3b88-3232-a855-ed87dc479536",
                        "source_sense_description": "of or pertaining to Serpentes",
                        "target_lang_word": "ophidien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ophidien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3ddf9eb5-75d9-34a2-85f2-21adc735b63c",
                                        "entry_id": "232e5f5c-7c09-3c86-8b38-8e212626ff67",
                                        "glosses": [
                                            "Qui est de la nature du serpent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fce4f5e0-cc88-40e4-88e1-9f4d0703749d",
                                                "sense_id": "3ddf9eb5-75d9-34a2-85f2-21adc735b63c",
                                                "text": "Les êtres du château restaient figés, de la surprise dans leurs yeux ophidiens."
                                            },
                                            {
                                                "example_id": "162fd474-cefd-456f-9f28-21f67ec42ce1",
                                                "sense_id": "3ddf9eb5-75d9-34a2-85f2-21adc735b63c",
                                                "text": "Puis il se retourna. Il était temps. La meute entière, quadrupèdes, bipèdes, oiseaux, ophidiens, se ruait sur lui avec ensemble."
                                            },
                                            {
                                                "example_id": "3ef62c61-d444-4580-9a56-753fdcd52d9b",
                                                "sense_id": "3ddf9eb5-75d9-34a2-85f2-21adc735b63c",
                                                "text": "Le silence que j'affectais quand j'étais irrité, ou, plus exactement, la froideur ophidienne de mon silence irrité, plongeait Valeria dans une frayeur insane autrefois."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ophidien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "01a410ea-bd74-33e3-9bb9-fe8c5601c213",
                                        "entry_id": "d2f11dfd-744e-349b-af03-21730ae71569",
                                        "glosses": [
                                            "Synonyme de reptile, serpent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa7a4df2-5b29-48e3-b421-cd6715008944",
                                                "sense_id": "01a410ea-bd74-33e3-9bb9-fe8c5601c213",
                                                "text": "Déjà l'ophidien géant l'entoure de ses anneaux mortels."
                                            },
                                            {
                                                "example_id": "912dbf99-b970-449e-873b-f545d07ab2c0",
                                                "sense_id": "01a410ea-bd74-33e3-9bb9-fe8c5601c213",
                                                "text": "Oh ! mes amis ! venez voir l’intéressant ophidien !"
                                            },
                                            {
                                                "example_id": "046b3d8f-b8fc-4a82-8b5a-f12d55011579",
                                                "sense_id": "01a410ea-bd74-33e3-9bb9-fe8c5601c213",
                                                "text": "Le maniement des ophidiens est plus délicat : ne s’improvise pas charmeur de serpents qui veut! Les Indiens et les Marocains excellent dans cet exercice délicat qui impressionne les touristes."
                                            },
                                            {
                                                "example_id": "f7b1904a-b9dc-4376-bef5-5fa4463fd3a5",
                                                "sense_id": "01a410ea-bd74-33e3-9bb9-fe8c5601c213",
                                                "text": "Aux côtés des nombreux restes de poissons littoraux, les tétrapodes sont représentés par des chéloniens, crocodiliens, ophidiens, plésiosaures, ptérosaures et dinosaures."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f20d5a93-1f39-46bc-91cc-bcd02e3b152b",
