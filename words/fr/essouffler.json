                    "frequency": "Middle",
                    "semantic_group_id": "affaiblissement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La contestation populaire semble s'<w>essouffler</w> après des semaines de mobilisation continue."
                        },
                        {
                            "text": "Le marché immobilier commence à s'<w>essouffler</w> face à la hausse des taux bancaires."
                        }
                    ],
                    "synonyms": [
