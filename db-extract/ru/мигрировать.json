                        "form_id": "b1355838-7c91-4445-9b31-25ad45b289fb",
                        "entry_id": "4eecfefb-4fd5-3bc6-add0-c6e7afc75f9a",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "мигри́ровавши"
                    },
                    {
                        "form_id": "9f2f8699-786f-4c8a-822e-8668dfc1ecaf",
                        "entry_id": "4eecfefb-4fd5-3bc6-add0-c6e7afc75f9a",
