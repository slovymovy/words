                    }
                ],
                "senses": [
                    {
                        "sense_id": "f2bed62c-3c1f-36d6-8dd8-c8c3c528e688",
                        "entry_id": "8f2fc6c1-ec64-3175-a305-a9298366f950",
                        "glosses": [
                            "Ausübung der Herrschaft einer höheren Instanz/Person auf Abhängige/Untergeordnete, zum Beispiel: Bestreben des Staates, seine Bürger zu bevormunden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e4c34e7-c5d4-4c74-8052-272d0d48bc33",
                                "sense_id": "f2bed62c-3c1f-36d6-8dd8-c8c3c528e688",
                                "text": "„Ein Bauer hatte innerhalb der Gemeinde kein Eigentumsrecht, sondern nur ein Nutzungsrecht, dessen Umfang die Gemeinde festlegte; sein Recht, aus der Gemeinde auszuscheiden, war beschränkt; ein System eines staatlichen Paternalismus diente nicht zuletzt dazu, das System Steuern einzutreiben wirksam zu erhalten.“"
                            },
                            {
                                "example_id": "0f35c56b-66e8-43df-8580-4b71bdb60d2d",
                                "sense_id": "f2bed62c-3c1f-36d6-8dd8-c8c3c528e688",
                                "text": "„Und so wird in den letzten, von Mitleid und Paternalismus geprägten Stunden der Konferenz auch noch der Alkohol zum Thema.“"
                            },
                            {
                                "example_id": "f9c5d8cd-1642-4e67-a93e-057e397a2bf6",
                                "sense_id": "f2bed62c-3c1f-36d6-8dd8-c8c3c528e688",
                                "text": "„Der Rebbe und die beiden Väter vollstrecken das Gesetz des Paternalismus, und weder Sender noch seine Frau haben hier Entscheidungsfreiheit.“"
                            },
                            {
                                "example_id": "3a934535-9aaa-4efb-b097-81c013c96505",
                                "sense_id": "f2bed62c-3c1f-36d6-8dd8-c8c3c528e688",
                                "text": "„Gefragt seien weder Paternalismus noch Almosen.“"
                            },
                            {
                                "example_id": "d64fb19f-4adf-4032-94a9-56561e23bb5b",
                                "sense_id": "f2bed62c-3c1f-36d6-8dd8-c8c3c528e688",
                                "text": "„Der christliche Einfluss war in Fort Hare sehr ausgeprägt, die meisten Professoren, unter ihnen einige Amerikaner, pflegten einen wohlwollenden Paternalismus gegenüber den schwarzen Studenten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e41941cf-28b5-470a-ba93-9bd53583da3a",
                        "source_entry_id": "8f2fc6c1-ec64-3175-a305-a9298366f950",
                        "source_sense_id": "f2bed62c-3c1f-36d6-8dd8-c8c3c528e688",
                        "target_lang_word": "paternalism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paternalism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "30807ffc-0ec7-3914-bb8f-b3f513c44ee7",
                                        "entry_id": "ecf880e4-c3ad-3922-a4b9-0390c6b1ec87",
                                        "glosses": [
                                            "The treatment of people in a fatherly manner, especially by caring for them and sometimes being stern with them."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1d4a69f-a675-4ac8-9540-e3546d637217",
                                                "sense_id": "30807ffc-0ec7-3914-bb8f-b3f513c44ee7",
                                                "text": "Libertarian paternalism is the view that, because the way options are presented to citizens affects what they choose, society should present options in a way that “nudges” our intuitive selves to make choices that are more consistent with what our more deliberative selves would have chosen if they were in control."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b48b0adc-cae8-308c-b763-5f7763f7a957",
                                        "entry_id": "ecf880e4-c3ad-3922-a4b9-0390c6b1ec87",
                                        "glosses": [
                                            "The guiding of people in a manner that limits their autonomy in the name of their own well-being."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a1844e65-b37f-472f-8b13-a0296e565224",
                        "source_entry_id": "8f2fc6c1-ec64-3175-a305-a9298366f950",
                        "source_sense_id": "f2bed62c-3c1f-36d6-8dd8-c8c3c528e688",
                        "target_lang_word": "paternalisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paternalisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b589228d-b2fe-362b-b37f-7bce1303df86",
                                        "entry_id": "3e4f1073-6831-35a6-8aa2-3800ae102825",
                                        "glosses": [
                                            "Attitude, volontaire ou involontaire, consciente ou non, qui consiste à se conduire comme un père envers d’autres adultes sur lesquels on exerce ou tente d’exercer une autorité d’un ordre parental."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2d6cc0d-8565-43f2-993e-620ad8b98a06",
                                                "sense_id": "b589228d-b2fe-362b-b37f-7bce1303df86",
                                                "text": "Plusieurs entreprises aux XIXᵉ et XXᵉ siècles ont développé un paternalisme qui, bien souvent, apportait aux ouvriers un certain nombre d’avantages sociaux en plus de leur offrir un emploi comme l’éducation, le logement, les soins médicaux, etc., avantages bien peu répandus alors."
                                            },
                                            {
                                                "example_id": "0fd18f8d-0b2e-4fc2-80f7-153786062e0a",
                                                "sense_id": "b589228d-b2fe-362b-b37f-7bce1303df86",
                                                "text": "Mais la palme du paternalisme revient à cet homme qui a rejeté leur projet sous prétexte que, deux ans plus tard, elles auraient envie d’un enfant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
