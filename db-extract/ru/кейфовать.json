                                                "sense_id": "bcadd6c3-8ceb-36c6-896a-ccb379a2ca2a",
                                                "text": "to relax a rope or cord"
                                            },
                                            {
                                                "example_id": "8a4ec461-352d-4136-afe6-d8c9298ec95b",
                                                "sense_id": "bcadd6c3-8ceb-36c6-896a-ccb379a2ca2a",
                                                "text": "to relax the muscles or sinews"
                                            },
                                            {
                                                "example_id": "dd396a75-7c4a-4493-9cf1-bea4a895e3ba",
                                                "sense_id": "bcadd6c3-8ceb-36c6-896a-ccb379a2ca2a",
                                                "text": "Horror […] all his joynts relax'd."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a862a2c-9d6c-3226-bd06-c0071289fe76",
                                        "entry_id": "f777d50a-e382-36ce-a404-941feebf697f",
                                        "glosses": [
                                            "To make something loose.",
                                            "To relieve from constipation; to loosen; to open."
                                        ],
                                        "tags": [
                                            "dated",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "498db0d5-2690-4a60-ad45-be38a9ecd020",
                                                "sense_id": "5a862a2c-9d6c-3226-bd06-c0071289fe76",
                                                "text": "An aperient relaxes the bowels."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74dd168c-eca5-3c02-b69f-eece6c37dfad",
                                        "entry_id": "f777d50a-e382-36ce-a404-941feebf697f",
                                        "glosses": [
                                            "To become loose."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "12cadd28-36fd-3251-875d-b941a5c96fcc",
                                        "entry_id": "f777d50a-e382-36ce-a404-941feebf697f",
                                        "glosses": [
                                            "To relieve (someone or someone's mind) of stress; to enable to rest; to calm down."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "350aaeb0-4e80-40ba-bc55-8a15e1e112f7",
                                                "sense_id": "12cadd28-36fd-3251-875d-b941a5c96fcc",
                                                "text": "Amusement relaxes the mind."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9fcdf417-e9c6-3d74-82e7-32212f6ab5d9",
                                        "entry_id": "f777d50a-e382-36ce-a404-941feebf697f",
                                        "glosses": [
                                            "To rest and become relieved of stress."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ca8837e-0168-49c0-a487-ef490c0c75dc",
                                                "sense_id": "9fcdf417-e9c6-3d74-82e7-32212f6ab5d9",
                                                "text": "I like to relax by listening to music."
                                            },
                                            {
                                                "example_id": "79956fda-873e-4e60-8156-a9c2a45f1afe",
                                                "sense_id": "9fcdf417-e9c6-3d74-82e7-32212f6ab5d9",
                                                "text": "I relax in the living room."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3024674e-ebf8-3ab6-b2e3-811f32e0bfd9",
                                        "entry_id": "f777d50a-e382-36ce-a404-941feebf697f",
                                        "glosses": [
                                            "To make something less severe or tense."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7bb8877c-8e7b-4297-9806-86642bdf16f5",
                                                "sense_id": "3024674e-ebf8-3ab6-b2e3-811f32e0bfd9",
                                                "text": "to relax discipline"
                                            },
                                            {
                                                "example_id": "46631e1c-c4b9-4e92-bcbe-8078e156eda3",
                                                "sense_id": "3024674e-ebf8-3ab6-b2e3-811f32e0bfd9",
                                                "text": "to relax one's attention or endeavours"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca057a86-85da-3c65-b1e3-0d6cf886b148",
                                        "entry_id": "f777d50a-e382-36ce-a404-941feebf697f",
                                        "glosses": [
                                            "To become less severe or tense."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee1fed7c-e076-418b-9c0b-a94cfee76a20",
                                                "sense_id": "ca057a86-85da-3c65-b1e3-0d6cf886b148",
                                                "text": "Tensions between the two countries have relaxed somewhat in recent weeks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "918aabfd-4622-3a96-b87e-9bbc1b749325",
                                        "entry_id": "f777d50a-e382-36ce-a404-941feebf697f",
                                        "glosses": [
                                            "To make something (such as codes and regulations) more lenient."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8258f8b-a030-41cd-9fea-f43cb667bdf8",
                                                "sense_id": "918aabfd-4622-3a96-b87e-9bbc1b749325",
                                                "text": "The statute of mortmain[…] was at several times relaxed by the legislature."
                                            },
                                            {
                                                "example_id": "9be1b398-d772-4de6-bc11-c3a9abbe7823",
                                                "sense_id": "918aabfd-4622-3a96-b87e-9bbc1b749325",
                                                "text": "The Court rejected the contention that the doctrine of sovereign immunity should be relaxed as inapplicable to suits for specific relief as distinguished from damage suits, saying: \"The Government, as representative of the community as a whole, cannot be stopped in its tracks by any plaintiff who presents a disputed question of property or contract right.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8a5cd79-173e-3930-9fc6-3ff00c639efb",
                                        "entry_id": "f777d50a-e382-36ce-a404-941feebf697f",
                                        "glosses": [
                                            "To become more lenient."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
