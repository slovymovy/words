                                "target_senses": [
                                    {
                                        "sense_id": "f93c2838-5a53-3517-9ae3-a1853e0786ee",
                                        "entry_id": "93e43ee3-d35a-38e0-8a57-f38644618b27",
                                        "glosses": [
                                            "potentiell Allergien auslösend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da8aff4a-28f6-43ee-bc6e-d14c19ae37f7",
                                                "sense_id": "f93c2838-5a53-3517-9ae3-a1853e0786ee",
                                                "text": "Ab Dezember müssen Wirte über allergene Lebensmittel in ihren Speisen informieren."
                                            },
                                            {
                                                "example_id": "00b0946d-2a98-49da-ac15-758d3cea88af",
                                                "sense_id": "f93c2838-5a53-3517-9ae3-a1853e0786ee",
                                                "text": "Die Europäische Behörde für Lebensmittelsicherheit (EFSA) hat eine Liste potentiell allergener Stoffe erarbeitet (\"Allergenverzeichnis\")."
                                            },
                                            {
                                                "example_id": "fe3c893c-e4e3-42dd-bd8d-7b5dc1fb6d68",
                                                "sense_id": "f93c2838-5a53-3517-9ae3-a1853e0786ee",
                                                "text": "Eine Kennzeichnung im Zutatenverzeichnis ist nicht erforderlich, wenn die Sachbezeichnung eines Lebensmittels bereits einen deutlichen Hinweis auf die allergene Zutat enthält (z.B. Sachbezeichnung \"Erdnussbutter\", \"Weizenbier\", \"Butterkekse\", Weizenmehl\", \"Milchpulver\")."
                                            },
                                            {
                                                "example_id": "55958343-b0a6-42ad-b007-6eca718cf2eb",
                                                "sense_id": "f93c2838-5a53-3517-9ae3-a1853e0786ee",
                                                "text": "Das Hühnerei enthält im Eiklar und im Eigelb verschiedene allergene Eiweiße, die sowohl im rohen als auch im erhitzten Ei gefunden werden."
                                            },
                                            {
                                                "example_id": "bdf76a05-9838-49d6-b862-08bcec669618",
                                                "sense_id": "f93c2838-5a53-3517-9ae3-a1853e0786ee",
                                                "text": "Viele dieser in Früchten gefundenen Allergene verlieren ihre allergene Wirkung, wenn sie gekocht oder gefroren werden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
