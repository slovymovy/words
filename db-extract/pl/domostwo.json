        "pl-extract.jsonl": [
            {
                "entry_id": "61d2039d-51f9-3102-9ffe-3e4a636671c4",
                "word": "domostwo",
                "pos": "noun",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f8278e8a-f9a6-37ee-83b0-f2b8aa9094ac",
                        "entry_id": "61d2039d-51f9-3102-9ffe-3e4a636671c4",
                        "glosses": [
                            "dom mieszkalny wraz z towarzyszącymi zabudowaniami"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfc28429-1af0-456d-a8a7-25665e9d77b2",
                                "sense_id": "f8278e8a-f9a6-37ee-83b0-f2b8aa9094ac",
                                "text": "W małych drzwiach wybitych w bocznej ścianie domostwa ukazywała się czasem służba w barwie książęcej – i z wiadrami lub cebrami na powerkach biegła po wodę do studzien"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "8be9f1f4-ecd5-391a-80b2-cbd0679fb37c",
                        "entry_id": "61d2039d-51f9-3102-9ffe-3e4a636671c4",
                        "glosses": [
                            "duży budynek mieszkalny"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "352f0d2a-f190-4318-99d8-ce1d7eafc2df",
                        "source_entry_id": "61d2039d-51f9-3102-9ffe-3e4a636671c4",
                        "source_sense_id": "f8278e8a-f9a6-37ee-83b0-f2b8aa9094ac",
                        "target_lang_word": "habitation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "habitation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "352341b9-9bc1-387e-9b21-8862e686711c",
                                        "entry_id": "63be3ddc-136d-35f6-9671-5851d3f16c44",
                                        "glosses": [
                                            "The act of inhabiting; state of inhabiting or dwelling, or of being inhabited; occupancy."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "883deaf3-071c-4954-b4bb-b57e753e662d",
                                                "sense_id": "352341b9-9bc1-387e-9b21-8862e686711c",
                                                "text": "And there have been Common-wealths that having no more Territory, than hath served them for habitation, have neverthelesse, not onely maintained, but also encreased their Power, partly by the labour of trading from one place to another, and partly by selling the Manifactures, whereof the Materials were brought in from other places."
                                            },
                                            {
                                                "example_id": "d319c600-e96a-4b52-b7b6-05376528eb5b",
                                                "sense_id": "352341b9-9bc1-387e-9b21-8862e686711c",
                                                "text": "Witness this new-made world, another Heaven\nFrom Heaven-gate not far, founded in view\nOn the clear hyaline, the glassy sea;\nOf amplitude almost immense, with stars\nNumerous, and every star perhaps a world\nOf destined habitation […]"
                                            },
                                            {
                                                "example_id": "a835d01e-26c1-49d4-a0e7-9205860c0699",
                                                "sense_id": "352341b9-9bc1-387e-9b21-8862e686711c",
                                                "text": "The few miserable hovels that shewed some marks of human habitation, were now of still rarer occurrence; and, at length, as we began to ascend a huge and uninterrupted swell of moorland, they totally disappeared."
                                            },
                                            {
                                                "example_id": "cc43046c-c35d-43c7-a687-a2e4985eed22",
                                                "sense_id": "352341b9-9bc1-387e-9b21-8862e686711c",
                                                "text": "Now, however, the windows in the houses began one by one to be lit up, giving a greater sense of habitation and humanity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e68671e7-bb42-353e-8779-4e40357653ef",
                                        "entry_id": "63be3ddc-136d-35f6-9671-5851d3f16c44",
                                        "glosses": [
                                            "A place of abode; settled dwelling; residence; house."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa48580b-5f0a-454b-9b2c-ec882906b219",
                                                "sense_id": "e68671e7-bb42-353e-8779-4e40357653ef",
                                                "text": "And as imagination bodies forth\nThe forms of things unknown, the poet’s pen\nTurns them to shapes and gives to airy nothing\nA local habitation and a name."
                                            },
                                            {
                                                "example_id": "cc428e69-f5a4-4f0e-a5a9-6956e2610fa2",
                                                "sense_id": "e68671e7-bb42-353e-8779-4e40357653ef",
                                                "text": "Ye shall kindle no fire throughout your habitations upon the sabbath day."
                                            },
                                            {
                                                "example_id": "b734e1ba-3e56-4d73-ad71-8a584f4c0090",
                                                "sense_id": "e68671e7-bb42-353e-8779-4e40357653ef",
                                                "text": "Mrs Deborah, having disposed of the child according to the will of her master, now prepared to visit those habitations which were supposed to conceal its mother."
                                            },
                                            {
                                                "example_id": "85c20edc-1cf5-4a29-828f-7aa8e1e6d38f",
                                                "sense_id": "e68671e7-bb42-353e-8779-4e40357653ef",
                                                "text": "How gay the Habitations that adorn\nThis fertile Valley! Not a House but seems\nTo give assurance of content within;"
                                            },
                                            {
                                                "example_id": "2db8a66a-4721-412e-9a9c-63045f4dc5e3",
                                                "sense_id": "e68671e7-bb42-353e-8779-4e40357653ef",
                                                "text": "And this is Shanty Town, my friend. ¶ Even here the children laugh in the narrow lanes that run between these tragic habitations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03afbcef-02cf-319b-832e-67efabd14f8c",
                                        "entry_id": "63be3ddc-136d-35f6-9671-5851d3f16c44",
                                        "glosses": [
                                            "A group, lodge, or company, as of the Primrose League."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "habitation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6507fad8-d1ce-3f6c-8ca7-d17d5220b293",
                                        "entry_id": "444cbee4-38d2-3867-b9f4-2729c7270065",
                                        "glosses": [
                                            "A farm, ranch or plantation."
                                        ],
                                        "tags": [
                                            "Louisiana"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "06fb5724-f7e9-4fc6-bada-f278f17f729c",
                        "source_entry_id": "61d2039d-51f9-3102-9ffe-3e4a636671c4",
                        "source_sense_id": "f8278e8a-f9a6-37ee-83b0-f2b8aa9094ac",
                        "target_lang_word": "homestead",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "homestead",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a3964455-084b-3bf4-b70c-660661d75574",
                                        "entry_id": "2e2a11fb-4444-36f8-a022-45fcf358d8d8",
                                        "glosses": [
                                            "A house together with surrounding land and buildings, especially on a farm; the property comprising these."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0674fdf3-a062-4dfb-99d0-812daa734e33",
                                                "sense_id": "a3964455-084b-3bf4-b70c-660661d75574",
                                                "text": "A Yard she had with Pales enclos’d about, / Some high, some low, and a dry Ditch without. / Within this Homestead, liv’d without a Peer, / For crowing loud, the noble Chanticleer:"
                                            },
                                            {
                                                "example_id": "d9f533d6-5648-4c61-949b-5fd42ac38354",
                                                "sense_id": "a3964455-084b-3bf4-b70c-660661d75574",
                                                "text": "[…] no sooner has a hen disburdened herself, than she rushes forth with a clamorous kind of joy, which the cock and the rest of his mistresses immediately adopt. The tumult is not confined to the family concerned, but catches from yard to yard, and spreads to every homestead within hearing, till at last the whole village is in an uproar."
                                            },
                                            {
                                                "example_id": "6d775a0d-f46d-41d6-8a24-d7cea3452681",
                                                "sense_id": "a3964455-084b-3bf4-b70c-660661d75574",
                                                "text": "It was an important-looking village, with a fine old church and large churchyard in the heart of it, and two or three large brick-and-stone homesteads, with well-walled orchards and ornamental weathercocks, standing close upon the road […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "103aac9f-6d10-313d-81df-de8ea0346960",
                                        "entry_id": "2e2a11fb-4444-36f8-a022-45fcf358d8d8",
                                        "glosses": [
                                            "A house together with surrounding land and buildings, especially on a farm; the property comprising these.",
                                            "A parcel of land in the interior of North America, usually 160 acres, that was distributed to settlers from Europe or eastern North America under the Dominion Lands Act of 1870 in Canada or the Homestead Act of 1862 in the United States."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28f60ef7-297c-40e4-9d85-e4fc08e9c361",
                                                "sense_id": "103aac9f-6d10-313d-81df-de8ea0346960",
                                                "text": "He owned exactly six hundred and forty acres of what stretched outside his door; his own original homestead and timber claim, making three hundred and twenty acres, and the half-section adjoining, the homestead of a younger brother who had given up the fight, gone back to Chicago to work in a fancy bakery […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "722390e5-4b82-3c29-a9de-cae4f4e49ae4",
                                        "entry_id": "2e2a11fb-4444-36f8-a022-45fcf358d8d8",
                                        "glosses": [
                                            "The place that is one's home."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "313e5d5c-2fd3-4ff4-83b2-be3f52860a89",
                                                "sense_id": "722390e5-4b82-3c29-a9de-cae4f4e49ae4",
                                                "text": "Grief from yeer to yeer / Rents my poor Heart, and makes his Home-stead there:"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84a10c86-4039-39a8-806d-963956b113a8",
                                        "entry_id": "2e2a11fb-4444-36f8-a022-45fcf358d8d8",
                                        "glosses": [
                                            "A cluster of several houses occupied by an extended family."
                                        ],
                                        "tags": [
                                            "South-Africa"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "de5dcd9e-a9d3-3bfa-bb5c-fc948510bab7",
                                        "entry_id": "2e2a11fb-4444-36f8-a022-45fcf358d8d8",
                                        "glosses": [
                                            "The home or seat of a family; place of origin."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05803103-07bf-433f-9eb3-6224feffbab7",
                                                "sense_id": "de5dcd9e-a9d3-3bfa-bb5c-fc948510bab7",
                                                "text": "Where then wast thou tempted, O Blessed Jesu? or whither wentest thou to meet with our great Adversary? I do not see thee led into the marketplace, or any other part of the City, or thy home-stead of Nazareth, but into the vast Wilderness, the habitation of beasts;"
                                            },
                                            {
                                                "example_id": "1f727030-5a87-40a6-90e2-16c9c92a7446",
                                                "sense_id": "de5dcd9e-a9d3-3bfa-bb5c-fc948510bab7",
                                                "text": "The PETSCHENEGRANS, as they are called in the russian and polish year-books, name themselves Kangar or Kangli, and were a powerful nomadic nation, which we can trace back to a homestead on the rivers Volga and Ural."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "homestead",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "58c2668b-cc48-367f-b0b5-95d3f6330154",
                                        "entry_id": "4c4d321b-5bef-3256-af99-c3160bd1867b",
                                        "glosses": [
                                            "To acquire or settle on land as a homestead."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf934e10-7ac1-4d30-a86e-34531237b440",
                                                "sense_id": "58c2668b-cc48-367f-b0b5-95d3f6330154",
                                                "text": "When Samuel and Liza came to the Salinas Valley all the level land was taken, the rich bottoms, the little fertile creases in the hills, the forests, but there was still marginal land to be homesteaded, and in the barren hills, to the east of what is now King City, Samuel Hamilton homesteaded."
                                            },
                                            {
                                                "example_id": "f3a7115e-468f-422f-95d1-065d4714b279",
                                                "sense_id": "58c2668b-cc48-367f-b0b5-95d3f6330154",
                                                "text": "He's an old man, Bandy...he homesteaded here. He lives with his grandson...he said he would like to talk to you."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07c13f24-d5ec-38fc-a3fa-e1878a5ea8d1",
                                        "entry_id": "4c4d321b-5bef-3256-af99-c3160bd1867b",
                                        "glosses": [
                                            "To appropriate an unowned, scarce means, and thereby gain ownership of it."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cf0f0886-efca-4444-9607-61122ba11455",
                        "source_entry_id": "61d2039d-51f9-3102-9ffe-3e4a636671c4",
                        "source_sense_id": "f8278e8a-f9a6-37ee-83b0-f2b8aa9094ac",
                        "target_lang_word": "toft",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "toft",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e2d58845-0d0e-350d-9cc4-e50cb30a1f4c",
                                        "entry_id": "49644be5-42c3-3e44-a79a-f7bda6d62254",
                                        "glosses": [
                                            "A hillock."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "22bbf8fc-6ed9-3dbf-8b69-3dd3aafaed73",
                                        "entry_id": "49644be5-42c3-3e44-a79a-f7bda6d62254",
                                        "glosses": [
                                            "A homestead, especially one on a hill."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2454b44-147d-4a2a-a2a9-ed5ec2348f17",
                                                "sense_id": "22bbf8fc-6ed9-3dbf-8b69-3dd3aafaed73",
                                                "text": "Rendering therefore annually to me and my heirs one halfpenny on the day of the nativity of St. John the Baptist for all suits services and demands and I the said Alice and my heirs the aforesaid toft and land with all their appurtenances as is before named to the said William and his heirs[…]."
                                            },
                                            {
                                                "example_id": "dc12ee75-c45d-4306-9e2e-3d1146a8a004",
                                                "sense_id": "22bbf8fc-6ed9-3dbf-8b69-3dd3aafaed73",
                                                "text": "2003, C. S. Knighton (editor), Calendar of Inquisitions Miscellaneous (Chancery): Preserved in the Public Record Office, Volume VIII: 1422—1485, page 73,\nWynnemerus Preston lately held 2 cottages wasted of which the tofts are worth 2d. net yearly and another cottage wasted of which the toft is worth 6d. net yearly."
                                            },
                                            {
                                                "example_id": "7bbc3f1a-ec4a-4dfe-83fd-891025ca0de1",
                                                "sense_id": "22bbf8fc-6ed9-3dbf-8b69-3dd3aafaed73",
                                                "text": "[…]the lands of Peter de Sourdeuall in Esk, Brandesburton and Routh[…]namely, half the capital messuage with the enclosure (ofuenam) as it is bounded and fenced, and a bovate of land which belonged to John, son of Emmot, and a toft which Henry, son of Walter, held, and a toft which Roger the carpenter (le carpentre) held,[…]."
