                    "frequency": "High",
                    "semantic_group_id": "vermutung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Morgen wird es <w>wahrscheinlich</w> den ganzen Tag regnen.",
                            "target_lang_translations": {
                                "en": "Tomorrow it will <w>probably</w> rain all day.",
                                "ru": "Завтра, <w>вероятно</w>, весь день будет идти дождь.",
                                "nl": "Morgen gaat het <w>waarschijnlijk</w> de hele dag regenen.",
                                "pl": "Jutro będzie <w>prawdopodobnie</w> padać przez cały dzień.",
                                "fr": "Demain, il va <w>probablement</w> pleuvoir toute la journée.",
                                "it": "Domani <w>probabilmente</w> pioverà tutto il giorno.",
                                "cs": "Zítra bude <w>pravděpodobně</w> pršet celý den.",
                                "tr": "Yarın <w>muhtemelen</w> bütün gün yağmur yağacak.",
                                "es": "Mañana <w>probablemente</w> lloverá todo el día.",
                                "zh": "明天<w>很可能</w>会下一整天的雨。"
                            }
                        },
                        {
                            "text": "Wir werden <w>wahrscheinlich</w> erst am späten Nachmittag in Berlin ankommen.",
                            "target_lang_translations": {
                                "en": "We will <w>probably</w> not arrive in Berlin until late afternoon.",
                                "ru": "Мы, <w>скорее всего</w>, прибудем в Берлин только ближе к вечеру.",
                                "nl": "We zullen <w>waarschijnlijk</w> pas laat in de middag in Berlijn aankomen.",
                                "pl": "Do Berlina dotrzemy <w>prawdopodobnie</w> dopiero późnym popołudniem.",
                                "fr": "Nous n'arriverons <w>probablement</w> à Berlin qu'en fin d'après-midi.",
                                "it": "<w>Probabilmente</w> arriveremo a Berlino solo nel tardo pomeriggio.",
                                "cs": "Do Berlína dorazíme <w>pravděpodobně</w> až v pozdním odpoledni.",
                                "tr": "Berlin'e <w>büyük ihtimalle</w> ancak ikindiden sonra geç saatlerde varacağız.",
                                "es": "<w>Probablemente</w> no lleguemos a Berlín hasta última hora de la tarde.",
                                "zh": "我们<w>大概</w>要到傍晚才能到达柏林。"
                            }
                        }
