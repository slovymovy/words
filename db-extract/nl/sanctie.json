                                "target_senses": [
                                    {
                                        "sense_id": "fac5cd43-ae40-3f21-a59c-a9b881b25939",
                                        "entry_id": "19bcef1d-a949-3051-a05b-2b8d45ca3471",
                                        "glosses": [
                                            "Bestätigung, Rechtfertigung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25b984e9-e389-4f2d-b158-b4fb63ff30d7",
                                                "sense_id": "fac5cd43-ae40-3f21-a59c-a9b881b25939",
                                                "text": "Die Sanktion der Beschlüsse ist Voraussetzung dafür, dass sie in Kraft treten können."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "66ae144b-31ed-3cd0-8e41-8a7a52db85d8",
                                        "entry_id": "19bcef1d-a949-3051-a05b-2b8d45ca3471",
                                        "glosses": [
                                            "missbilligende Reaktion auf nicht geduldetes Verhalten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "826ce52d-6349-44ed-adde-ed808028161c",
                                                "sense_id": "66ae144b-31ed-3cd0-8e41-8a7a52db85d8",
                                                "text": "Die Sanktion für sein unflätiges Verhalten folgte auf dem Fuße."
                                            },
                                            {
                                                "example_id": "31b91dc4-a1c4-4165-985e-c67e08b88635",
                                                "sense_id": "66ae144b-31ed-3cd0-8e41-8a7a52db85d8",
                                                "text": "„Am selben Tag verhängte der noch amtierende Präsident Barack Obama neue Sanktionen gegen Russland.“"
                                            },
                                            {
                                                "example_id": "cac3de4e-9f48-4508-beac-d61b7b90ec51",
                                                "sense_id": "66ae144b-31ed-3cd0-8e41-8a7a52db85d8",
                                                "text": "[Russischer Angriffskrieg auf die Ukraine:] „Obwohl der Westen die russische Rüstungsindustrie mit schweren Sanktionen belegt hat, laufen die Maschinen auf Hochtouren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "acfe17e6-30d7-33fc-8b81-8d1315f9925a",
                                        "entry_id": "19bcef1d-a949-3051-a05b-2b8d45ca3471",
                                        "glosses": [
                                            "Bestrafung für Vergehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f48b08a6-5455-4d22-aadc-45c5ae6c335a",
                                                "sense_id": "acfe17e6-30d7-33fc-8b81-8d1315f9925a",
                                                "text": "Für diese Vergehen gelten schwerwiegende Sanktionen."
                                            },
                                            {
                                                "example_id": "b0efdc87-3526-4f22-866f-dbf68c46f6ec",
                                                "sense_id": "acfe17e6-30d7-33fc-8b81-8d1315f9925a",
                                                "text": "„Die Gemeinsame Geschäftsordnung der Bundesministerien sieht zwar vor, dass Gesetzentwürfe »grundsätzlich« dem Redaktionsstab Rechtssprache zur Prüfung vorzulegen sind, doch Sanktionen für die Nichtbeachtung dieser Vorschrift gibt es nicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "839d1174-5823-4689-81d1-f5c7db402f83",
                        "source_entry_id": "0f75a8a8-eb26-37e8-bd54-1502ff418d48",
                        "source_sense_id": "b7ed999b-a2db-317a-b484-b6c60ace0c81",
