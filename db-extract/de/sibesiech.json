                "senses": [
                    {
                        "sense_id": "f9005175-e513-3a34-bfa4-99e6c56266d1",
                        "entry_id": "b228c0d8-1366-3ccb-ba68-aec2368b2d64",
                        "glosses": [
                            "vielseitig begabter Mensch, ein Multitalent, Alleskönner; oft mit leicht kritischer Note"
                        ],
                        "tags": [
                            "Swiss Standard German",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "cc562805-0132-45cf-837f-8d89e4548444",
                                "sense_id": "f9005175-e513-3a34-bfa4-99e6c56266d1",
                                "text": "„Man denkt unweigerlich an Axel Cäsar Springer. Der 1985 verstorbene Hanseat mit dem römischen Herrschertitel im Namen war ein Sibesiech, der Frauen im Plural liebte und einen starken Hang zum Mystizismus hatte.“"
                            },
                            {
                                "example_id": "109378ff-e310-4b95-957e-16e170bc8c5f",
                                "sense_id": "f9005175-e513-3a34-bfa4-99e6c56266d1",
                                "text": "„Ein Sibesiech ist einer, der manches zustande bringt, dabei aber auch immer ein bisschen zum Blenden und Prahlen neigt.“"
                            },
                            {
                                "example_id": "864dc29e-6f6b-44fe-8ea6-a71460e971c2",
                                "sense_id": "f9005175-e513-3a34-bfa4-99e6c56266d1",
                                "text": "„Ich brauchte keine Publicity. Ich muss nicht der ganzen Welt mitteilen, was für ein Sibesiech ich bin.“"
                            },
                            {
                                "example_id": "44007b7e-17b4-4a0c-be29-823227adb262",
                                "sense_id": "f9005175-e513-3a34-bfa4-99e6c56266d1",
                                "text": "„Während die Deutschen einen, der viele Talente hat und einfach immer und überall reüssiert, einen Tausendsassa nennen, beschränken wir uns auf den Sibesiech.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6c5ba332-6eea-3128-8c68-61c54dfe8440",
                        "entry_id": "b228c0d8-1366-3ccb-ba68-aec2368b2d64",
                        "glosses": [
                            "Schimpfwort für einen Menschen"
                        ],
                        "tags": [
                            "Swiss Standard German",
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "9acf3008-0e93-41cb-9a41-760792e5d1dd",
                                "sense_id": "6c5ba332-6eea-3128-8c68-61c54dfe8440",
                                "text": "„Dër, wo-miᶜʰ veʳchlagt hed, ist känn Siech, aber en Sibeⁿs[iech] ist er!“"
                            },
                            {
                                "example_id": "2b58ed3b-1664-484a-82a4-e7f94b785cdb",
                                "sense_id": "6c5ba332-6eea-3128-8c68-61c54dfe8440",
                                "text": "„Iᶜʰ haⁿ-se fërn oᶜʰ dinneⁿ [Erdflöhe im Flachs] g’haⁿ, di Ssackermënteⁿ, die Ssibeⁿsiecheⁿ, die tūsigs Disen und Äineⁿ.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
