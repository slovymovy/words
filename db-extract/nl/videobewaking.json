                "entry_id": "d571c954-86ed-3609-a1e0-b39c2d05d6b4",
                "word": "videobewaking",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "1f21f4fb-84aa-4d49-b86f-9bd5377e7d95",
                        "entry_id": "d571c954-86ed-3609-a1e0-b39c2d05d6b4",
                        "tags": [
