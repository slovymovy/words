                ],
                "senses": [
                    {
                        "sense_id": "45d63486-c360-32cc-84c4-94ebc5c8aa85",
                        "entry_id": "5760ec52-47d8-34f6-8764-d6e558818c07",
                        "glosses": [
                            "Müll, der besonders in reichen Konsum- und Wegwerfgesellschaften aufgrund der dort herrschenden speziellen Wegwerf- und Konsummentalität entsteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ce3cd24-8225-42d0-aa69-e05bfda7384e",
                                "sense_id": "45d63486-c360-32cc-84c4-94ebc5c8aa85",
                                "text": "„Der giftige Wirbel im Ozean lässt in hoher Konzentration Partikel von Einkaufstüten, CD-Hüllen, Zahnbürsten, Flaschen, Joghurtbechern, Legosteinen, Turnschuhen und Feuerzeugen zirkulieren. Längst ist der Wohlstandsmüll auch in den Mägen von Fischen gelandet und damit, guten Appetit, in der Nahrungskette. Zugleich werden Öl und manche Metalle schon sehr knapp.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0b1710b4-3498-3e5b-a428-5dc189888441",
                        "entry_id": "5760ec52-47d8-34f6-8764-d6e558818c07",
                        "glosses": [
                            "Menschen, die nicht willens oder nicht in der Lage sind, zu arbeiten"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "38d3b512-cc5b-402e-b94e-7dce881dd883",
                                "sense_id": "0b1710b4-3498-3e5b-a428-5dc189888441",
                                "text": "„Unsere Arbeitslosen werden relativ gut bezahlt. Und wir wissen, daß mit Prosperität auch - und das ist ein hartes Wort - ein gewisser ‚Wohlstandsmüll‘ entsteht: Leute, die saufen, Drogen nehmen, sich abgemeldet haben. Für Menschen die wirklich arbeiten wollen, gibt es immer noch Arbeit.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
