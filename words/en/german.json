                },
                {
                    "sense_id": "47e6367f-8a55-30c6-a865-370109c5346b",
                    "sense_definition": "Closely related by blood; primarily used to describe a first cousin.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "group_genealogy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is my cousin <w>german</w>.",
                            "target_lang_translations": {
                                "ru": "Он мой <w>двоюродный</w> брат.",
                                "zh": "他是我的<w>嫡亲</w>表亲。"
                            }
                        },
                        {
                            "text": "In older laws, marriage between cousins <w>german</w> was often restricted.",
                            "target_lang_translations": {
                                "ru": "В старых законах брак между <w>двоюродными</w> братом и сестрой часто ограничивался.",
                                "zh": "在旧时法律中，<w>嫡亲</w>表亲之间的婚姻往往受到限制。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "cousin-german",
                        "brother-german"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "legal or literary usage"
                        },
                        {
                            "trait_type": "form",
                            "comment": "usually lowercase"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Близкий по крови; обычно используется для обозначения двоюродных братьев и сестер (в сочетании cousin-german).",
                        "zh": "血缘关系很近的；古语中主要用于指嫡亲表亲，即第一代表亲。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "двоюродный",
                                "target_lang_sense_clarification": "в сочетании 'cousin german'"
                            },
                            {
                                "target_lang_word": "родной",
                                "target_lang_sense_clarification": "устаревшее значение (полнокровный)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "嫡亲的",
                                "target_lang_sense_clarification": "古语，指血缘很近的，尤指第一代表亲"
                            }
                        ]
                    }
