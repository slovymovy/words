                ],
                "senses": [
                    {
                        "sense_id": "9f76b3b6-ae3e-33eb-b107-e7485ea97463",
                        "entry_id": "af71305c-63f1-39a6-b1a0-fba2b25e60aa",
                        "glosses": [
                            "Weiler der Stadt Erkelenz in Nordrhein-Westfalen, Deutschland, der seit Oktober 2022 nicht mehr bewohnt ist und ab Januar 2023 im Zuge der Ausdehnung des Tagebaus Garzweiler abgerissen werden soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99df07f3-df30-4937-b4e6-52de7d2d633e",
                                "sense_id": "9f76b3b6-ae3e-33eb-b107-e7485ea97463",
                                "text": "„Im Anschluss an eine Versammlung und ein Konzert im Braunkohleort Lützerath (NRW) am Tagebau Garzweiler ist es zu Übergriffen gekommen.“"
                            },
                            {
                                "example_id": "f47edd5b-7fbc-4084-b16c-f6d77e6127cb",
                                "sense_id": "9f76b3b6-ae3e-33eb-b107-e7485ea97463",
                                "text": "„Bei der Räumung des Braunkohledorfs Lützerath haben alle Akteure auch in den nächsten Tagen absehbar mit ungemütlichem Wetter zu kämpfen.“"
                            },
                            {
                                "example_id": "04c767a2-9007-4ffa-bc0b-474d2ec36b23",
                                "sense_id": "9f76b3b6-ae3e-33eb-b107-e7485ea97463",
                                "text": "„Der Energiekonzern RWE hat vor der am Mittwoch erwarteten Räumung des Dorfes Lützerath für den Braunkohle-Abbau die Besetzer zur Gewaltlosigkeit aufgerufen.“"
                            },
                            {
                                "example_id": "eb7705ec-aadc-4336-8283-f442ef18eac3",
                                "sense_id": "9f76b3b6-ae3e-33eb-b107-e7485ea97463",
                                "text": "„Um die Menschen von Lützerath geht es jedenfalls schon lange nicht mehr, denn die sind längst weggezogen, gegen gutes Geld von RWE für schöne neue Häuser, die garantiert klimaverträglicher sind als ihre alten Kaschemmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
