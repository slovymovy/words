                        "examples": [
                            {
                                "example_id": "c0b88873-413e-4106-aa81-783946464669",
                                "sense_id": "c629913b-cfdc-3228-87fa-511f4ee8203f",
                                "text": "Er trug sein Lieblingshemd, woran ich ihn sofort erkannte."
                            },
                            {
                                "example_id": "62549803-3673-4fed-87b1-c099c00828f6",
                                "sense_id": "c629913b-cfdc-3228-87fa-511f4ee8203f",
                                "text": "Es ist ein einziges Elend, woran ich einfach noch mal erinnern wollte."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
