                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "42121a55-d46f-3840-8246-45b5a2ec4e5d",
                                        "entry_id": "4a28c56d-0e6d-339e-ba6c-0a96bc42101a",
                                        "glosses": [
                                            "schädliches Programm, das zusammen mit einem nützlichen Programm oder unter dessen Namen auf einem Computer installiert wird, Daten sammelt, verändert und weitergibt"
                                        ],
                                        "tags": [
                                            "Computersicherheit"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a31ffa2-39b0-4015-876b-778ebc0146f1",
                                                "sense_id": "42121a55-d46f-3840-8246-45b5a2ec4e5d",
                                                "text": "Hilfe! Mein Computer hat einen Trojaner!"
                                            },
                                            {
                                                "example_id": "66f76fa6-c8f4-440d-8cf0-30f38b2c4358",
                                                "sense_id": "42121a55-d46f-3840-8246-45b5a2ec4e5d",
                                                "text": "„Trojaner, die Daten des Opfers mittels Verschlüsselung sperren und anschließend Geld für die Freigabe erpressen wollen, erfreuen sich unter Cyberkriminellen steigender Beliebtheit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
