                {
                    "sense_id": "f844bc29-3eee-367c-ba37-0c294f793050",
                    "sense_definition": "In a short amount of time; soon.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The situation will <w>hastily</w> change if we do not act now.",
                            "target_lang_translations": {
                                "cs": "Situace se <w>brzy</w> změní, pokud nyní nebudeme jednat.",
                                "tr": "Şimdi harekete geçmezsek durum <w>yakında</w> değişecektir.",
                                "nl": "De situatie zal <w>spoedig</w> veranderen als we nu niet ingrijpen.",
                                "ru": "Ситуация <w>вскоре</w> изменится, если мы не начнем действовать прямо сейчас.",
                                "pl": "Sytuacja <w>wkrótce</w> ulegnie zmianie, jeśli nie podejmiemy działań teraz.",
                                "de": "Die Lage wird sich <w>bald</w> ändern, wenn wir jetzt nicht handeln.",
                                "fr": "La situation va changer <w>promptement</w> si nous n'agissons pas maintenant.",
                                "it": "La situazione cambierà <w>presto</w> se non agiamo subito.",
                                "es": "La situación cambiará <w>pronto</w> si no actuamos ahora.",
                                "zh": "如果我们现在不采取行动，局势将<w>很快</w>发生改变。",
                                "ja": "今行動を起こさなければ、状況は<w>間もなく</w>変わるでしょう。",
                                "pt": "A situação vai mudar <w>em breve</w> se não agirmos agora."
                            }
                        },
                        {
                            "text": "Do not expect the results to appear <w>hastily</w> after the experiment begins.",
                            "target_lang_translations": {
                                "cs": "Neočekávejte, že se výsledky objeví <w>záhy</w> po zahájení experimentu.",
                                "tr": "Deney başladıktan sonra sonuçların <w>tez zamanda</w> ortaya çıkmasını beklemeyin.",
                                "nl": "Verwacht niet dat de resultaten <w>al te snel</w> verschijnen nadat het experiment begint.",
                                "ru": "Не рассчитывайте, что результаты появятся слишком <w>быстро</w> после начала эксперимента.",
                                "pl": "Nie oczekuj, że wyniki pojawią się <w>rychło</w> po rozpoczęciu eksperymentu.",
                                "de": "Erwarten Sie nicht, dass die Ergebnisse <w>allzu rasch</w> nach Beginn des Experiments vorliegen.",
                                "fr": "Ne vous attendez pas à ce que les résultats apparaissent <w>aussitôt</w> après le début de l'expérience.",
                                "it": "Non aspettarti che i risultati compaiano <w>rapidamente</w> una volta iniziato l'esperimento.",
                                "es": "No esperes que los resultados aparezcan <w>rápidamente</w> después de que comience el experimento.",
                                "zh": "不要指望实验一开始结果就会<w>迅速</w>显现。",
                                "ja": "実験を始めて<w>間もなく</w>結果が出るとは期待しないでください。",
                                "pt": "Não se espere que os resultados apareçam <w>dentro em pouco</w> depois do início da experiência."
                            }
                        }
