    "entries": [
        {
            "pos": "numeral",
            "senses": [
                {
                    "sense_id": "8e46191a-ea83-3360-b03f-c6beef4c5aed",
                    "sense_definition": "Число 1; количество, равное единице.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "number_val",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "У меня есть только <w>один</w> вопрос к тебе.",
                            "target_lang_translations": {
                                "en": "I have only <w>one</w> question for you.",
                                "zh": "我只有<w>一个</w>问题要问你。"
                            }
                        },
                        {
                            "text": "На столе лежит <w>одна</w> интересная книга.",
                            "target_lang_translations": {
                                "en": "There is <w>one</w> interesting book on the table.",
                                "zh": "桌子上放着<w>一</w>本有趣的书。"
                            }
                        },
                        {
                            "text": "В нашем классе двадцать <w>один</w> ученик.",
                            "target_lang_translations": {
                                "en": "There are twenty-<w>one</w> students in our class.",
                                "zh": "我们班有二十<w>一</w>名学生。"
                            }
                        }
                    ],
                    "synonyms": [
                        "едини́ца",
                        "раз"
                    ],
                    "common_phrases": [
                        "один раз",
                        "номер один",
                        "один из нас",
                        "ни один"
                    ],
                    "target_lang_definitions": {
                        "en": "The number 1; a single unit or quantity.",
                        "zh": "数字1；表示单一的数量或单位。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "one",
                                "target_lang_sense_clarification": "number"
                            },
                            {
                                "target_lang_word": "single",
                                "target_lang_sense_clarification": "emphasis on quantity"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "一",
                                "target_lang_sense_clarification": "数字1"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "dd7abea6-bc37-3895-856c-9e465079bb7f",
                    "sense_definition": "Без других людей, в отдельности от других; в одиночестве.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "solitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он живёт совсем <w>один</w> в большом доме.",
                            "target_lang_translations": {
                                "en": "He lives all <w>alone</w> in a big house.",
                                "zh": "他<w>独自</w>住在一栋大房子里。"
                            }
                        },
                        {
                            "text": "Я не люблю гулять <w>одна</w> по вечерам.",
                            "target_lang_translations": {
                                "en": "I don't like walking <w>alone</w> in the evenings.",
                                "zh": "我不喜欢晚上<w>独自</w>散步。"
                            }
                        },
                        {
                            "text": "Мы оставили детей <w>одних</w> в комнате.",
                            "target_lang_translations": {
                                "en": "We left the children <w>alone</w> in the room.",
                                "zh": "我们把孩子们<w>独自</w>留在房间里了。"
                            }
                        }
                    ],
                    "antonyms": [
                        "вместе"
                    ],
                    "common_phrases": [
                        "совсем один",
                        "один дома",
                        "все мы одни"
                    ],
                    "target_lang_definitions": {
                        "en": "Without other people; solitary or separate from others.",
                        "zh": "没有其他人在场；独自一人。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "alone",
                                "target_lang_sense_clarification": "solitary"
                            },
                            {
                                "target_lang_word": "by oneself",
                                "target_lang_sense_clarification": "without help or company"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "独自",
                                "target_lang_sense_clarification": "独自一人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7ed802b0-cd2f-32ad-a001-4e6724196084",
                    "sense_definition": "Какой-то, некий (указывает на неопределённое лицо или предмет).",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "indefinite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мне звонил <w>один</w> человек и спрашивал тебя.",
                            "target_lang_translations": {
                                "en": "<w>One</w> man called and asked for you.",
                                "zh": "<w>一个</w>人打电话找你。"
                            }
                        },
                        {
                            "text": "В <w>один</w> прекрасный день мы поедем на море.",
                            "target_lang_translations": {
                                "en": "<w>One</w> fine day we will go to the sea.",
                                "zh": "在<w>一个</w>美好的日子里，我们会去海边。"
                            }
                        },
                        {
                            "text": "Я прочитал эту историю в <w>одной</w> старой книге.",
                            "target_lang_translations": {
                                "en": "I read this story in <w>one</w> old book.",
                                "zh": "我在<w>一</w>本旧书里读到了这个故事。"
                            }
                        }
                    ],
                    "synonyms": [
                        "какой-то",
                        "некий",
                        "некоторый"
                    ],
                    "common_phrases": [
                        "один день",
                        "один знакомый",
                        "в один момент"
                    ],
                    "target_lang_definitions": {
                        "en": "A certain person or thing (unspecified or indefinite).",
                        "zh": "指代某一个不特定的人或事物。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "one",
                                "target_lang_sense_clarification": "a certain (e.g., one day)"
                            },
                            {
                                "target_lang_word": "a certain",
                                "target_lang_sense_clarification": "specific but unnamed"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "一个",
                                "target_lang_sense_clarification": "某一个"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "24bf1d60-e842-3c1b-a859-e600dd14d873",
                    "sense_definition": "Только, исключительно; ничего кроме (часто с негативным оттенком).",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "restriction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В холодильнике остались <w>одни</w> консервы и больше ничего.",
                            "target_lang_translations": {
                                "en": "There was <w>nothing but</w> canned food left in the fridge.",
                                "zh": "冰箱里<w>只有</w>罐头，别的什么都没有。"
                            }
                        },
                        {
                            "text": "Вокруг нас были <w>одни</w> только высокие горы.",
                            "target_lang_translations": {
                                "en": "There were <w>only</w> high mountains around us.",
                                "zh": "我们周围<w>全是</w>高山。"
                            }
                        },
                        {
                            "text": "От этого человека <w>одни</w> проблемы и неприятности.",
                            "target_lang_translations": {
                                "en": "This person causes <w>nothing but</w> problems and trouble.",
                                "zh": "这个人带来的<w>尽是</w>麻烦和不快。"
                            }
                        }
                    ],
                    "synonyms": [
                        "единственный"
                    ],
                    "common_phrases": [
                        "одни только",
                        "одни проблемы",
                        "одни убытки"
                    ],
                    "target_lang_definitions": {
                        "en": "Nothing but; exclusively (often used to emphasize a large amount of something negative).",
                        "zh": "仅仅，只有；强调数量多且通常带有负面评价。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "only",
                                "target_lang_sense_clarification": "exclusively"
                            },
                            {
                                "target_lang_word": "nothing but",
                                "target_lang_sense_clarification": "merely"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "只有",
                                "target_lang_sense_clarification": "仅有"
                            },
                            {
                                "target_lang_word": "全是",
                                "target_lang_sense_clarification": "全部都是"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b194a89a-647f-37fa-9aa6-bc2583e86cb1",
                    "sense_definition": "Тот же самый, тождественный; одинаковый.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "identity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы ходим в <w>один</w> и тот же магазин каждый день.",
                            "target_lang_translations": {
                                "en": "We go to <w>the same</w> shop every day.",
                                "zh": "我们每天都去<w>同一个</w>商店。"
                            }
                        },
                        {
                            "text": "Эти сёстры похожи как две капли воды, просто <w>одно</w> лицо.",
                            "target_lang_translations": {
                                "en": "These sisters are like two peas in a pod, just <w>the same</w> face.",
                                "zh": "这对姐妹长得一模一样，简直是<w>同一个</w>人。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "одно и то же",
                        "на одно лицо",
                        "в один голос"
                    ],
                    "target_lang_definitions": {
                        "en": "The very same; identical.",
                        "zh": "指同一个，完全相同。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "the same",
                                "target_lang_sense_clarification": "identical"
                            },
                            {
                                "target_lang_word": "one and the same",
                                "target_lang_sense_clarification": "emphatic"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "同一个",
                                "target_lang_sense_clarification": "完全相同"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d6fec26c-c617-3aa6-ad78-4e1463fabde4",
                    "sense_definition": "Употребляется во множественном числе для противопоставления одной группы другой (одни... другие).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "correlation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Одни</w> люди любят зиму, а другие предпочитают лето.",
                            "target_lang_translations": {
                                "en": "<w>Some</w> people like winter, while others prefer summer.",
                                "zh": "<w>有的</w>人喜欢冬天，而另一些人更喜欢夏天。"
                            }
                        },
                        {
                            "text": "<w>Одни</w> пришли вовремя, а другие сильно опоздали.",
                            "target_lang_translations": {
                                "en": "<w>Some</w> arrived on time, while others were very late.",
                                "zh": "<w>有的</w>人准时到了，而另一些人迟到了很久。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "одни говорят",
                        "одни считают"
                    ],
                    "target_lang_definitions": {
                        "en": "Some (used in plural to contrast one group with another).",
                        "zh": "用于复数，表示一部分人或事物与另一部分相对照。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "some",
                                "target_lang_sense_clarification": "part of a group"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "有的",
                                "target_lang_sense_clarification": "指代部分群体"
                            }
                        ]
                    }
                }
            ]
        },
