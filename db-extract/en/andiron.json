                    },
                    {
                        "translation_id": "efd06303-40be-4ad5-9fe8-cfa6db884b42",
                        "source_entry_id": "498da370-6aaf-3484-b2eb-a2702a1c299c",
                        "source_sense_id": "c9e23392-558d-3f36-8f65-d74b4bcc5dcb",
                        "source_sense_description": "a utensil for supporting wood while burning",
                        "target_lang_word": "chenet",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chenet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b622dbfa-61df-3933-8674-68adbb4f54ff",
                                        "entry_id": "eeaf9566-81ce-32ae-af77-77ecc9aac20a",
                                        "glosses": [
                                            "Ustensile, au nombre de deux par cheminée, servant à maintenir le bois en hauteur dans le foyer pour en activer la combustion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fc1e834-3c58-4847-8b5e-57098d125774",
                                                "sense_id": "b622dbfa-61df-3933-8674-68adbb4f54ff",
                                                "text": "Le garde-cendre, les chenets, les pelles, les pincettes, tout était du plus grand prix."
                                            },
                                            {
                                                "example_id": "5369afae-5145-4e29-908d-6fd9cfb9846e",
                                                "sense_id": "b622dbfa-61df-3933-8674-68adbb4f54ff",
                                                "text": "De gros monticules de cendres encombraient la cheminée et portaient le brasier à un empan plus haut que la tête des chenets."
                                            },
                                            {
                                                "example_id": "fd2a6d21-71dd-4b55-a1c2-fd605e4e09e0",
                                                "sense_id": "b622dbfa-61df-3933-8674-68adbb4f54ff",
                                                "text": "Les chenets en terre cuite zoomorphes sont particulièrement nombreux dans toute la vallée de la Loire, d’Orléans à Nantes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d85706f-2144-38aa-93f6-9ba3e52bf9bb",
                                        "entry_id": "eeaf9566-81ce-32ae-af77-77ecc9aac20a",
                                        "glosses": [
                                            "Machine de fer qui sert à donner le pli aux bordages que l’on chauffe."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f3bb2f5d-23ea-48e4-ad42-516e2aa2b448",
                        "source_entry_id": "498da370-6aaf-3484-b2eb-a2702a1c299c",
