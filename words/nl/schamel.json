{
    "word_family": [
        "schamelheid"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "877149af-76e9-3e47-bec2-67c902a55eb8",
                    "sense_definition": "zeer gering in hoeveelheid, omvang of betekenis; ontoereikend",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "weinig_armoedig",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij werkt lange dagen voor een <w>schamel</w> loon waar hij nauwelijks van kan rondkomen.",
                            "target_lang_translations": {
                                "de": "Er arbeitet lange Tage für einen <w>dürftigen</w> Lohn, von dem er kaum über die Runden kommt."
                            }
                        },
                        {
                            "text": "Na jarenlang sparen had hij slechts een <w>schamel</w> bedrag over op zijn rekening.",
                            "target_lang_translations": {
                                "de": "Nach jahrelangem Sparen hatte er nur noch einen <w>kargen</w> Betrag auf seinem Konto übrig."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een schamel loon",
                        "een schamel bedrag"
                    ],
                    "target_lang_definitions": {
                        "de": "sehr gering an Menge, Umfang oder Wert; unzureichend oder spärlich"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "dürftig",
                                "target_lang_sense_clarification": "unzureichend, sehr gering"
                            },
                            {
                                "target_lang_word": "karg",
                                "target_lang_sense_clarification": "knapp bemessen"
                            },
                            {
                                "target_lang_word": "mager",
                                "target_lang_sense_clarification": "in Bezug auf Ertrag oder Menge gering"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6dc354f4-36e0-3be1-9a38-63270117f853",
                    "sense_definition": "getuigend van grote armoede of gebrek; pover en kaal",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "weinig_armoedig",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De vluchtelingen moesten de koude winter overleven in <w>schamele</w> hutten van hout en zeil.",
                            "target_lang_translations": {
                                "de": "Die Flüchtlinge mussten den kalten Winter in <w>ärmlichen</w> Hütten aus Holz und Plane überleben."
                            }
                        },
                        {
                            "text": "Hij droeg slechts <w>schamele</w> kleren die vol zaten met gaten en scheuren.",
                            "target_lang_translations": {
                                "de": "Er trug nur <w>armselige</w> Kleidung voller Löcher und Risse."
                            }
                        }
                    ],
                    "synonyms": [
                        "armoedig"
                    ],
                    "common_phrases": [
                        "schamele kleding"
                    ],
                    "target_lang_definitions": {
                        "de": "von großer Armut, Mangel oder Verwahrlosung zeugend; ärmlich und abgetragen"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "ärmlich",
                                "target_lang_sense_clarification": "materiell arm, bescheiden"
                            },
                            {
                                "target_lang_word": "dürftig",
                                "target_lang_sense_clarification": "von materieller Not zeugend"
                            },
                            {
                                "target_lang_word": "armselig",
                                "target_lang_sense_clarification": "mitleiderregend arm oder unzulänglich"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ec1f05d5-4790-3195-aefe-f1728328aaf7",
                    "sense_definition": "teleurstellend en beschamend slecht; beklagenswaardig",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "beschaamd",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het elftal verloor kansloos en zette daarmee een <w>schamele</w> vertoning neer voor het eigen publiek.",
                            "target_lang_translations": {
                                "de": "Die Mannschaft verlor chancenlos und lieferte damit eine <w>klägliche</w> Vorstellung vor dem eigenen Publikum ab."
                            }
                        },
                        {
                            "text": "Het resultaat van het lange onderzoek bleek een bijzonder <w>schamel</w> rapport te zijn.",
                            "target_lang_translations": {
                                "de": "Das Ergebnis der langen Untersuchung erwies sich als ein ausgesprochen <w>dürftiger</w> Bericht."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een schamele vertoning"
                    ],
                    "target_lang_definitions": {
                        "de": "enttäuschend, beschämend schlecht oder ungenügend; kläglich"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "kläglich",
                                "target_lang_sense_clarification": "beschämend schwach oder mangelhaft"
                            },
                            {
                                "target_lang_word": "dürftig",
                                "target_lang_sense_clarification": "mangelhaft, unzureichend"
                            },
                            {
                                "target_lang_word": "beschämend",
                                "target_lang_sense_clarification": "peinlich schlecht"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}