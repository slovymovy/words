                },
                {
                    "sense_id": "9bb4517a-50d4-3977-936b-0c7ea139ccc9",
                    "sense_definition": "mały podgląd obrazu lub filmu na ekranie komputera bądź telefonu",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "computer_thumbnail",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kliknij na <w>miniaturę</w>, aby otworzyć zdjęcie w pełnym rozmiarze.",
                            "target_lang_translations": {
                                "ru": "Нажмите на <w>миниатюру</w>, чтобы открыть фотографию в полном размере."
                            }
                        },
                        {
                            "text": "Autor filmu zmienił <w>miniaturę</w>, aby przyciągnąć więcej widzów.",
                            "target_lang_translations": {
                                "ru": "Автор видео изменил <w>превью</w>, чтобы привлечь больше зрителей."
                            }
                        }
