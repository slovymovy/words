                "senses": [
                    {
                        "sense_id": "e55260fa-126e-3a65-9e9b-8920d03a0a4e",
                        "entry_id": "6e170662-56b6-387c-8d9b-9ab83fc8ef5b",
                        "glosses": [
                            "Titelfigur des gleichnamigen Romans von Mary Shelley ^(→ WP), dem es gelingt, einen künstlichen Menschen zu erschaffen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8871a488-4fee-4811-bf13-2644ac486c92",
                                "sense_id": "e55260fa-126e-3a65-9e9b-8920d03a0a4e",
                                "text": "„Haben wir in dieser beschissenen Stadt nicht schon Morde genug, dass du dich wie der verdammte Frankenstein auf den Friedhof schleichen und Leichen ausbuddeln musst?“"
                            },
                            {
                                "example_id": "f2bfa429-b8a5-4232-b961-d8e139cc4196",
                                "sense_id": "e55260fa-126e-3a65-9e9b-8920d03a0a4e",
                                "text": "„In einer dieser Regennächte mit Blitz und Donner über dem Genfer See hatte die achtzehnjährige Mary Godwin den Traum, der zur Geschichte von Frankenstein werden sollte.“"
                            },
                            {
                                "example_id": "382e5e7f-0105-4861-94cc-9314be39b301",
                                "sense_id": "e55260fa-126e-3a65-9e9b-8920d03a0a4e",
                                "text": "„Es ist riesig. Zweimal so groß wie alle, die er je gesehen hat. Als hätte Doktor Frankenstein ein paar tote Bodybuilder zu einem zusammengesetzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "efff5ae8-d48a-499c-be19-aa2f0309149a",
                        "source_entry_id": "6e170662-56b6-387c-8d9b-9ab83fc8ef5b",
                        "source_sense_id": "e55260fa-126e-3a65-9e9b-8920d03a0a4e",
                        "source_sense_description": "Titelfigur des gleichnamigen Romans",
                        "target_lang_word": "Frankenstein",
