                        "examples": [
                            {
                                "example_id": "37366fd9-c69b-4264-ba81-45599ddf518a",
                                "sense_id": "bbc707c0-6523-3309-a1ab-7e453bd2171d",
                                "text": "Over nieuwe regels wordt al jaren gepraat en uiteindelijk kwam het kabinet twee jaar geleden met een wetsvoorstel. Vandaag heeft de Tweede Kamer over alle wijzigingen uit de Kamer gestemd. Donderdag is de eindstemming over de hele wet, maar het is duidelijk dat een meerderheid voor is."
                            },
                            {
                                "example_id": "eec79507-2d85-4345-9728-d6b876004937",
                                "sense_id": "bbc707c0-6523-3309-a1ab-7e453bd2171d",
                                "text": "Omdat er zo veel amendementen waren, wordt nu eerst bekeken wat de wijzigingen wetstechnisch precies betekenen. De eindstemming over de wet in de Tweede Kamer is over een week."
                            }
