                        "entry_id": "d72526b7-e428-3d84-ba3c-164d930d0f4a",
                        "tags": [
                            "positive",
                            "predicative",
                            "plural"
                        ],
                        "form": "sie sind blutverkrustet"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5f240986-743d-3d19-8cf0-08ab0190ddd6",
                        "entry_id": "d72526b7-e428-3d84-ba3c-164d930d0f4a",
                        "glosses": [
                            "mit Blut verkrustet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0063d775-db41-48ce-8677-3d5843bbfa1e",
                                "sense_id": "5f240986-743d-3d19-8cf0-08ab0190ddd6",
                                "text": "„Man hatte ihm die Zunge herausgerissen, er hatte nur noch einen blutverkrusteten Stumpf im Mund.“"
                            },
                            {
                                "example_id": "e67f3eb7-19b2-425b-a2b6-28903bdbe825",
                                "sense_id": "5f240986-743d-3d19-8cf0-08ab0190ddd6",
                                "text": "„Aus glühenden Augenhöhlen und mit scharfen, blutverkrusteten Reißzähnen starrte es mich voll verdorbenem Hohn an, denn es wusste um mein unausweichliches Ende.“"
                            },
                            {
                                "example_id": "7bf8a9d5-4353-46da-8867-b7810d3df152",
                                "sense_id": "5f240986-743d-3d19-8cf0-08ab0190ddd6",
                                "text": "„Ich versuchte, meine blutverkrusteten Beine unter dem zerfetzten Hosenstoff zu bewegen, und stellte fest, dass ich laufen konnte; leider wusste ich nicht, wohin ich meine Schritte lenken sollte.“"
                            },
                            {
                                "example_id": "278e1958-2814-4142-b7c0-89d936c0d940",
                                "sense_id": "5f240986-743d-3d19-8cf0-08ab0190ddd6",
                                "text": "„Sein Daumen ist blutverkrustet, und der Nagel fehlt.“"
                            },
                            {
                                "example_id": "68800012-fbc4-4810-b51a-f5c046016e52",
                                "sense_id": "5f240986-743d-3d19-8cf0-08ab0190ddd6",
                                "text": "„Ich konnte mich nicht hinsetzen – ich mischte mich unter die Glaubensanhänger, versuchte, ein vertrautes Gesicht zu finden, Gloria oder Naman, und, ja, da war ein bekanntes Gesicht, obwohl es zur Hälfte zugeschwollen und blutverkrustet war.“"
                            },
                            {
                                "example_id": "7021eccc-7ce6-4e0c-90b3-284c493332c0",
                                "sense_id": "5f240986-743d-3d19-8cf0-08ab0190ddd6",
                                "text": "„Ein großer, blutverkrusteter Stein lag neben ihr.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
