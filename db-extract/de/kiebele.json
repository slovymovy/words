                ],
                "senses": [
                    {
                        "sense_id": "452c045f-713c-397c-9bef-224d52f3438e",
                        "entry_id": "58527a26-2295-39ad-8498-c22f204b4090",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93fa5e9b-b01e-4d7f-a3d8-9c9350500b69",
                                "sense_id": "452c045f-713c-397c-9bef-224d52f3438e",
                                "text": "Frau Kiebele ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "9c9a0e0f-c6a7-44cc-a973-fb94ab9fb4e9",
                                "sense_id": "452c045f-713c-397c-9bef-224d52f3438e",
                                "text": "Herr Kiebele wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "86e2b8b0-1c08-4c3e-be15-43476e838c99",
                                "sense_id": "452c045f-713c-397c-9bef-224d52f3438e",
                                "text": "Die Kiebeles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "3c4d61a7-22eb-48d6-b6c6-a3a6aba2f961",
                                "sense_id": "452c045f-713c-397c-9bef-224d52f3438e",
                                "text": "Der Kiebele trägt nie die Schals, die die Kiebele ihm strickt."
                            },
                            {
                                "example_id": "4ec175fe-e6b6-4875-b749-5e64f9ed988e",
                                "sense_id": "452c045f-713c-397c-9bef-224d52f3438e",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Kiebele kommt, geht der Herr Kiebele.“"
                            },
                            {
                                "example_id": "9db730b1-c73e-413b-aa7f-aa3478869139",
                                "sense_id": "452c045f-713c-397c-9bef-224d52f3438e",
                                "text": "Kiebele kommt und geht."
                            },
                            {
                                "example_id": "1e1a6425-a293-4f1a-97e6-cd13b16662b9",
                                "sense_id": "452c045f-713c-397c-9bef-224d52f3438e",
                                "text": "Kiebeles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
