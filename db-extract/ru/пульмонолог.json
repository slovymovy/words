                    {
                        "translation_id": "749c1f2e-57e2-40b5-b7ba-6da8aadadcaf",
                        "source_entry_id": "a38bd48e-c040-3f87-8d4b-5106ce9694af",
                        "source_sense_id": "3a3d5c87-2ac5-3b22-bf76-91519ad0402c",
                        "target_lang_word": "pneumologue",
