                "senses": [
                    {
                        "sense_id": "083712ca-8f5b-32e9-8fb2-27d8f522ae09",
                        "entry_id": "c718e5be-44fd-389f-8157-37f53a1da570",
                        "glosses": [
                            "eine mathematische Funktion der Trigonometrie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08e679de-4b0a-4272-9c71-14fb27af025d",
                                "sense_id": "083712ca-8f5b-32e9-8fb2-27d8f522ae09",
                                "text": "Im rechtwinkligen Dreieck ist der Tangens eines Winkels das Verhältnis seiner Gegenkathete zur Ankathete."
                            },
                            {
                                "example_id": "10675e78-fb48-4117-991d-c8c2ebe1db94",
                                "sense_id": "083712ca-8f5b-32e9-8fb2-27d8f522ae09",
                                "text": "Der Tangens des 45-Grad-Winkels ist 1."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c47f775c-2d62-4b3b-a3d7-6e57dc0f2134",
                        "source_entry_id": "c718e5be-44fd-389f-8157-37f53a1da570",
                        "source_sense_id": "083712ca-8f5b-32e9-8fb2-27d8f522ae09",
                        "source_sense_description": "Mathematik: eine mathematische Funktion der Trigonometrie",
                        "target_lang_word": "tangent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tangent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "65fac2b6-5f65-38b4-bb09-e803d09b4d10",
                                        "entry_id": "83576cfc-cab0-3ba8-b06f-cc495592d47f",
                                        "glosses": [
                                            "A straight line touching a curve at a single point without crossing it there."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34e8820b-6b24-4c8f-b47e-a4588dfbdcaf",
                                                "sense_id": "65fac2b6-5f65-38b4-bb09-e803d09b4d10",
                                                "text": "One feature of the body, which is constructed of pressed-steel members, is the contour of the sides. They are in the form of a continuous radius from the bottom side to the cant rail, and to enable flat glass windows to be fitted the side panels are pressed around the window opening, forming a tangent to the curved bodyside."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e041260b-d1d1-3fc3-9647-405e45a75805",
                                        "entry_id": "83576cfc-cab0-3ba8-b06f-cc495592d47f",
                                        "glosses": [
                                            "A function of an angle that gives the ratio of the sine to the cosine, in either the real or complex numbers. Symbols: tan, tg."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "997a7994-3cab-3eb9-81d9-c02f389bd430",
                                        "entry_id": "83576cfc-cab0-3ba8-b06f-cc495592d47f",
                                        "glosses": [
                                            "A topic nearly unrelated to the main topic, but having a point in common with it."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93fd3b14-d57a-474a-8825-353a0bdd54ef",
                                                "sense_id": "997a7994-3cab-3eb9-81d9-c02f389bd430",
                                                "text": "I believe we went off onto a tangent when we started talking about monkeys on unicycles at his retirement party."
                                            },
                                            {
                                                "example_id": "277b606a-6d6d-4353-917f-6b7f2bbed7e2",
                                                "sense_id": "997a7994-3cab-3eb9-81d9-c02f389bd430",
                                                "text": "“Uncle Barnaby was always father and mother to me,” Benson broke in; then after a pause his mind flew off at a tangent. “Is old Hannah all right—in the will, I mean?”"
                                            },
                                            {
                                                "example_id": "c489a203-675d-4e5f-8b4c-f3d2b45b2fcb",
                                                "sense_id": "997a7994-3cab-3eb9-81d9-c02f389bd430",
                                                "text": "Jon & Kate Plus 8 is a show based on two facts: (1) Jon and Kate Gosselin have eight children, and (2) the word ‘Kate’ rhymes with the word ‘eight’. One suspects that if Kate were ever to have another child, a shady network executive would urge her to put it in a binbag with a brick and drop it down a well. But this is just a horrifying tangent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c53476b7-abb2-30aa-8129-b8b3604c6889",
                                        "entry_id": "83576cfc-cab0-3ba8-b06f-cc495592d47f",
                                        "glosses": [
                                            "A visual interaction between two or more lines or edges that creates a perceived relationship between them, often in a way that the artist did not intend."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f48248e0-a2c5-37c9-a02b-707b29a00d05",
                                        "entry_id": "83576cfc-cab0-3ba8-b06f-cc495592d47f",
                                        "glosses": [
                                            "A small metal blade in a clavichord that strikes the strings to produce sound."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
