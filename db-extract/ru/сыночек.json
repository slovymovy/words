                        "translation_id": "537d2399-3f11-4fce-8a3c-5a48cdff3237",
                        "source_entry_id": "87b96f7f-84ea-318e-8b77-c7d4ee295d85",
                        "source_sense_id": "bdfe0603-f881-3c53-b885-d86025d87661",
                        "target_lang_word": "gosse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gosse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8af10851-fba8-30f3-9cbd-4a764ab1d242",
                                        "entry_id": "dd25cc6b-c079-3939-a5ec-cd72ceae2bee",
                                        "glosses": [
                                            "Enfant, garçon ou fille."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c25111de-891c-4084-891c-1dfc2c9923a4",
                                                "sense_id": "8af10851-fba8-30f3-9cbd-4a764ab1d242",
                                                "text": "Bientôt, en effet, les six gosses arrivés devant les roseaux de la rive et écarquillant les yeux, ne virent que l’eau ensoleillée, mais point de rainettes."
                                            },
                                            {
                                                "example_id": "ec4ba693-3e57-48ac-aa96-44c33e037349",
                                                "sense_id": "8af10851-fba8-30f3-9cbd-4a764ab1d242",
                                                "text": "Le gosse séché et réconforté remonta sur le pont avec une superbe casquette de yachtman juchée sur le capuchon de son anorak."
                                            },
                                            {
                                                "example_id": "4a3fdf56-6054-437b-9d4b-984866692642",
                                                "sense_id": "8af10851-fba8-30f3-9cbd-4a764ab1d242",
                                                "text": "Ça m’abrutissait à tel point que je butai sur un gosse qui tenait un sac : « Tu peux pas faire attention, saligaude ! » hurla-t-il."
                                            },
                                            {
                                                "example_id": "4cbfc48b-aec1-48b3-8372-e5062e0a0ee7",
                                                "sense_id": "8af10851-fba8-30f3-9cbd-4a764ab1d242",
                                                "text": "Personne ne veut revivre le confinement de mars 2020 avec des gosses livrés à eux-mêmes dans des familles défavorisées, sans ordinateur pour travailler."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gosse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7bdf4206-62d6-3373-b796-2de5629db5fa",
                                        "entry_id": "ab507edc-3f79-377f-949b-aa6efd0e7baa",
                                        "glosses": [
                                            "Testicule."
                                        ],
                                        "tags": [
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e86af0a-34c6-4696-b7ea-b8ceb4b823b1",
                                                "sense_id": "7bdf4206-62d6-3373-b796-2de5629db5fa",
                                                "text": "À la suite de la décision de sa copine de pratiquer l’abstinence, François se retrouve avec des gosses gonflées comme des melons d’eau."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gosse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "005c887d-268c-3bb8-90e5-9b9263f71059",
                                        "entry_id": "9fa869e7-c90c-3d27-9ded-9b34c23dcd9c",
                                        "glosses": [
                                            "Anneau de métal garni de petites cordes, afin que les grosses cordes destinées à passer au travers ne s’abîment pas sur le métal"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
