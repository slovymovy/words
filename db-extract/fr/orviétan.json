                "senses": [
                    {
                        "sense_id": "ff3bd7e6-5e9e-3461-89c7-101282c250f1",
                        "entry_id": "f6fc1644-a8c4-31e8-9278-ce3b13b17c92",
                        "glosses": [
                            "Sorte d’électuaire auquel on attribuait autrefois toutes sortes de vertus, et dont la composition était proche de la thériaque."
                        ],
                        "tags": [
                            "Médecine historique"
                        ],
                        "examples": [
                            {
                                "example_id": "03e04dbe-00e2-4439-a7cb-85e9c0a97646",
                                "sense_id": "ff3bd7e6-5e9e-3461-89c7-101282c250f1",
                                "text": "C’est ce qui a mis en grand honneur l’anis, le corail rouge, le bouillon de vipère dont parle Mme de Sévigné, l’orviétan, le bézoard, la thériaque, la corne de cerf ou l’œil d’écrevisse réduits en poudre, etc."
                            },
                            {
                                "example_id": "cccae5ab-33b9-46ed-a1fc-2526b072cbd2",
                                "sense_id": "ff3bd7e6-5e9e-3461-89c7-101282c250f1",
                                "text": "Il vendait son orviétan au hasard des foires, juché sur un corbillard peint en bleu avec des lisérés d'or."
                            },
                            {
                                "example_id": "9aa9d121-3d0c-43f0-b90c-f36ee74b411a",
                                "sense_id": "ff3bd7e6-5e9e-3461-89c7-101282c250f1",
                                "text": "— Elle honnit le carton-pâte et l’ornement en staff, l’orviétan des charlatans littéraires, le tarabiscotage des épithètes, qui sont trop souvent l’essentiel d’un livre consacré aux splendeurs factices d’un climat africain."
                            }
                        ]
                    }
