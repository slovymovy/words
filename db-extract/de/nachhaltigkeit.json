                                "sense_id": "d24b5a0d-9e98-3567-a331-473278530c6e",
                                "text": "Nachhaltigkeit betrifft die Nutzung der Ressourcen.",
                                "translation": "Le développement durable concerne l'utilisation des ressources."
                            }
                        ]
                    }
