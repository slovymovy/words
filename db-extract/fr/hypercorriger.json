                ],
                "senses": [
                    {
                        "sense_id": "777931d9-bef3-39f5-b684-572e894d946b",
                        "entry_id": "4c8b59a7-b646-384d-ad50-3b98ff1b3b20",
                        "glosses": [
                            "Corriger au-delà de la normale."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "94fe54c1-0097-4cd6-a36e-9d9bc069ef2f",
                                "sense_id": "777931d9-bef3-39f5-b684-572e894d946b",
                                "text": "Il faudra toujours hypercorriger de quelques millimètres pour pallier un certain degré de rétraction cicatricielle secondaire."
                            },
                            {
                                "example_id": "8d27e9e2-696d-48ce-b522-b99a29309ce8",
                                "sense_id": "777931d9-bef3-39f5-b684-572e894d946b",
                                "text": "Faut-il hypercorriger le varum seulement ou aussi le valgum ?"
                            },
                            {
                                "example_id": "c244b5ba-40ad-4b57-8201-da637ed61299",
                                "sense_id": "777931d9-bef3-39f5-b684-572e894d946b",
                                "text": "Il s’agit d’idéaliser leur position le plus rapidement possible et non d’hypercorriger leur axe pour résister aux mouvements."
                            }
                        ]
                    }
                ],
