                    "sense_id": "323da71e-2af2-3a1d-b3ff-a2512c1520af",
                    "sense_definition": "A person who lacks common sense, intelligence, or is easily deceived.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "intelligence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The stranger was obviously a <w>simpleton</w> who did not understand the gravity of the situation.",
                            "target_lang_translations": {
                                "ru": "Незнакомец явно был <w>простаком</w>, который не понимал всей серьезности ситуации."
                            }
                        },
                        {
                            "text": "He was often dismissed as a pompous <w>simpleton</w> by those who knew his true character.",
                            "target_lang_translations": {
                                "ru": "Те, кто знал его истинный характер, часто считали его напыщенным <w>простофилей</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "halfwit",
                        "fool",
                        "ninny",
                        "dunce"
                    ],
                    "antonyms": [
                        "intellectual",
                        "genius",
                        "sage"
                    ],
                    "common_phrases": [
                        "pompous simpleton",
                        "utter simpleton",
                        "harmless simpleton"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, которому не хватает здравого смысла, ума или которого легко обмануть."
                    },
