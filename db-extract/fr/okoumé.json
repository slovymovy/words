                    {
                        "sense_id": "47d6827c-67b0-368e-8314-808d314a8ae3",
                        "entry_id": "f4731501-7d25-3085-9577-b0a2d20dd5ab",
                        "glosses": [
                            "Arbre de la famille des Burséracées originaire d’Afrique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac22f229-9e92-4f67-87de-46d11230bdd4",
                                "sense_id": "47d6827c-67b0-368e-8314-808d314a8ae3",
                                "text": "Parcours de découverte de majestueux okoumés hauts de 40 mètres et chemin dans la canopée y seront bientôt proposés, en particulier aux écoliers de la ville."
                            },
                            {
                                "example_id": "3f7bdaa2-b6c3-4087-a251-6624c90c3260",
                                "sense_id": "47d6827c-67b0-368e-8314-808d314a8ae3",
                                "text": "L’okoumé, dont on fait le contreplaqué, reste une importante source de devises."
                            },
                            {
                                "example_id": "0c0e19e1-d829-4935-a266-00905c476ee1",
                                "sense_id": "47d6827c-67b0-368e-8314-808d314a8ae3",
                                "text": "Il aurait, dans l'ivresse de cet accueil triomphal, bâti une église en planches d’okoumé."
                            }
                        ]
                    },
                    {
                        "sense_id": "3712c273-b657-3dc3-8a02-2fb6724b5f19",
