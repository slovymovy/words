                "senses": [
                    {
                        "sense_id": "ce64e452-6b8a-39be-a1ec-bffb160c618e",
                        "entry_id": "46bc5034-6e48-3bcc-97fe-830c2136c2f2",
                        "glosses": [
                            "met betrekking tot of gelegen in het Westen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06e38947-7296-4c27-8da9-c1a7369c1a7c",
                                "sense_id": "ce64e452-6b8a-39be-a1ec-bffb160c618e",
                                "text": "In de Tweede Wereldoorlog kwam Japan in conflict met de westerse mogendheden."
                            },
                            {
                                "example_id": "89e883f6-8690-417e-863e-5862d4242292",
                                "sense_id": "ce64e452-6b8a-39be-a1ec-bffb160c618e",
                                "text": "Zijn beide ouders komen uit een westers land."
                            },
                            {
                                "example_id": "3318fea3-7773-493a-8e48-3e8c56ae77e4",
                                "sense_id": "ce64e452-6b8a-39be-a1ec-bffb160c618e",
                                "text": "We zijn in de westerse maatschappij een beetje doorgeslagen in onze verslaving aan spullen en schulden."
                            }
                        ]
                    },
                    {
                        "sense_id": "18492bb6-bd7b-3e02-b77c-3a4eef5f02c8",
                        "entry_id": "46bc5034-6e48-3bcc-97fe-830c2136c2f2",
                        "glosses": [
                            "met een blank of Europees uiterlijk"
                        ],
                        "tags": [
                            "euphemistic",
                            "figuratively"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "51ec85ee-6843-3453-8729-332b76e249c0",
                        "entry_id": "46bc5034-6e48-3bcc-97fe-830c2136c2f2",
                        "glosses": [
                            "westelijk"
                        ],
